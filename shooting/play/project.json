{
  "name": "@semio-tech/shooting-play",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "shooting/play",
        "command": "bun ./script.ts dev",
        "env": {
          "SHOOTING_PLAY_PORT": "6019",
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "shooting/play",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "shooting/play",
        "command": "bun ./script.ts test",
        "env": {
          "SHOOTING_PLAY_PORT": "6032"
        },
        "forwardAllArgs": true
      }
    },
    "dev-base-icon": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "shooting/play",
        "command": "bun ./script.ts dev fixture base-icon",
        "env": {
          "SHOOTING_PLAY_PORT": "6019",
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      }
    },
    "build-base-icon": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "shooting/play",
        "command": "bun ./script.ts build fixture base-icon",
        "forwardAllArgs": true
      }
    }
  }
}
