{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "name": "@semio/vscode",
  "displayName": "semio",
  "description": "semio devtools for VS Code 🧑‍💻",
  "version": "0.0.1",
  "publisher": "usalu",
  "engines": {
    "vscode": "^1.106.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "js/vscode"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "workspaceContains:**/repo.tsx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "semio.analyze",
        "title": "semio: Analyze Codebase"
      },
      {
        "command": "semio.analyzeFile",
        "title": "semio: Analyze Current File"
      },
      {
        "command": "semio.fix",
        "title": "semio: Fix Codebase Problems"
      },
      {
        "command": "semio.fixFile",
        "title": "semio: Fix Current File Problems"
      },
      {
        "command": "semio.policyList",
        "title": "semio: List Policies"
      },
      {
        "command": "semio.policyRun",
        "title": "semio: Run Policy"
      },
      {
        "command": "semio.ticketCreate",
        "title": "semio: Create Ticket"
      },
      {
        "command": "semio.ticketList",
        "title": "semio: List Tickets"
      },
      {
        "command": "semio.ticketIterateStart",
        "title": "semio: Start Ticket Iteration"
      },
      {
        "command": "semio.ticketIterateEnd",
        "title": "semio: End Ticket Iteration"
      },
      {
        "command": "semio.ticketFinish",
        "title": "semio: Finish Ticket"
      },
      {
        "command": "semio.ticketRead",
        "title": "semio: Read Ticket"
      },
      {
        "command": "semio.projectList",
        "title": "semio: List Projects"
      },
      {
        "command": "semio.projectTree",
        "title": "semio: Show Project Tree"
      },
      {
        "command": "semio.folderTree",
        "title": "semio: Show Folder Tree"
      },
      {
        "command": "semio.folderCreate",
        "title": "semio: Create Folder"
      },
      {
        "command": "semio.folderMove",
        "title": "semio: Move Folder"
      },
      {
        "command": "semio.folderDelete",
        "title": "semio: Delete Folder"
      },
      {
        "command": "semio.folderList",
        "title": "semio: List Folders"
      },
      {
        "command": "semio.fileCreate",
        "title": "semio: Create File"
      },
      {
        "command": "semio.fileMove",
        "title": "semio: Move File"
      },
      {
        "command": "semio.fileDelete",
        "title": "semio: Delete File"
      },
      {
        "command": "semio.fileList",
        "title": "semio: List Files"
      },
      {
        "command": "semio.fileTree",
        "title": "semio: Show File Tree"
      },
      {
        "command": "semio.sectionTree",
        "title": "semio: Show Section Tree"
      },
      {
        "command": "semio.sectionCreate",
        "title": "semio: Create Section"
      },
      {
        "command": "semio.sectionMove",
        "title": "semio: Move Section"
      },
      {
        "command": "semio.sectionDelete",
        "title": "semio: Delete Section"
      },
      {
        "command": "semio.sectionList",
        "title": "semio: List Sections"
      },
      {
        "command": "semio.definitionList",
        "title": "semio: List Definitions"
      },
      {
        "command": "semio.definitionTree",
        "title": "semio: Show Definition Tree"
      },
      {
        "command": "semio.toolRun",
        "title": "semio: Run Tool"
      },
      {
        "command": "semio.refreshDiagnostics",
        "title": "semio: Refresh Diagnostics"
      }
    ]
  },
  "scripts": {
    "build": "vite build && vite build --config vite.test.config.ts",
    "dev": "vite build --watch",
    "test": "vscode-test",
    "vscode:prepublish": "npm run build",
    "preflight": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.1",
    "@types/node": "^24.10.1",
    "@types/mocha": "^10.0.10",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@semio/js": "*",
    "jsonc-parser": "^3.3.1"
  },
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "license": "AGPL-3.0-or-later"
}