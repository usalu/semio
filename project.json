{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": ".",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun setup.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun lint.ts"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun format.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun test.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun build.ts"
      }
    },
    "dev-mcp": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun dev.mcp.ts"
      }
    },
    "dev-mcp-engine": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun dev.mcp.engine.ts"
      }
    },
    "dev-mcp-repo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun dev.mcp.repo.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun typecheck.ts"
      }
    }
  }
}
