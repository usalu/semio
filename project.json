{
  "name": "workspace",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": ".",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./setup.script.ts"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./start.script.ts"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./dev.script.ts",
        "forwardAllArgs": true
      }
    },
    "dev-storybook": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./dev.script.ts storybook",
        "forwardAllArgs": true,
        "env": {
          "STORYBOOK_PORT": "6010"
        }
      }
    },
    "dev-mcp": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./dev.script.ts mcp",
        "forwardAllArgs": true
      }
    },
    "dev-mcp-engine": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./dev.script.ts mcp engine",
        "forwardAllArgs": true
      }
    },
    "dev-mcp-repo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./dev.script.ts mcp repo",
        "forwardAllArgs": true
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./generate.script.ts",
        "forwardAllArgs": true
      }
    },
    "generate-neo4j": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./generate.neo4j.script.ts",
        "forwardAllArgs": true
      }
    },
    "generate-neo4j-migrate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./.repo/🎫/26/05/15/NEO4J-MIGRATIONS-HANDWRITTEN/migrate.neo4j.script.ts",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun ./lint.script.ts",
        "forwardAllArgs": true
      }
    },
    "lint-repo": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun ./lint.script.ts repo"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./format.script.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun ./test.script.ts",
        "forwardAllArgs": true
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun ./test.script.ts storybook",
        "forwardAllArgs": true,
        "env": {
          "STORYBOOK_PORT": "6010"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun ./build.script.ts",
        "forwardAllArgs": true
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "bun ./build.script.ts storybook",
        "forwardAllArgs": true,
        "env": {
          "STORYBOOK_PORT": "6010"
        }
      }
    },
    "setup-storybook": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bunx playwright install --with-deps chromium",
        "env": {
          "PLAYWRIGHT_BROWSERS_PATH": "node_modules/.cache/ms-playwright"
        }
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./publish.script.ts",
        "forwardAllArgs": true
      }
    },
    "purge": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./purge.script.ts",
        "forwardAllArgs": true
      }
    }
  }
}
