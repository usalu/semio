{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "name": "@semio/ui",
  "version": "0.1.0",
  "description": "semio · ui",
  "type": "module",
  "exports": {
    ".": "./index.tsx",
    "./globals.css": "./globals.css",
    "./tailwind.config": "./tailwind.config.ts",
    "./postcss.config": "./postcss.config.ts"
  },
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=1 storybook dev -p 6008 --exact-port --host 0.0.0.0 --no-open --debug",
    "build": "storybook build",
    "lint": "eslint --max-warnings 0 --config eslint.config.ts .",
    "test": "vitest run --passWithNoTests --config ../../elements/ui/vitest.config.ts"
  },
  "targets": {
    "lint": {
      "command": "npm run lint",
      "cwd": "semio/ui"
    }
  },
  "dependencies": {
    "@elements/ui": "*",
    "@modelcontextprotocol/ext-apps": "^1.3.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@semio/js": "*",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "^10.1.11",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.0.17"
  },
