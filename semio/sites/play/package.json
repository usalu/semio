{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "type": "module",
  "name": "@semio/play",
  "version": "0.1.0",
  "description": "semio ⋅ playground",
  "scripts": {
    "dev": "node -e \"const h=process.env.DEVCONTAINER==='true'?'0.0.0.0':'127.0.0.1';require('child_process').spawn('npx',['vite','--strictPort','--port','4000','--host',h],{stdio:'inherit',shell:true,env:Object.assign({},process.env,{CHOKIDAR_USEPOLLING:'1'})}).on('exit',c=>process.exit(c||0))\"",
    "build": "vite build",
    "publish": "vite build && npm publish"
  },
  "dependencies": {
    "@elements/ui": "*",
    "@semio/js": "*",
    "@semio/sketchpad": "*"
  },
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "js/play"
  },
  "bundleKind": "site"
}