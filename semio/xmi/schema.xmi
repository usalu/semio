          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Connector_direction_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Connector_direction_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Connector_port" name="port" type="cls_Port">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Connector_port_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Connector_port_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Connector_compatiblePorts" name="compatiblePorts" type="cls_Port" isOrdered="true">
