          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Connector_compatiblePorts_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Connector_typeOwner" name="typeOwner" type="cls_Type">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Connector_typeOwner_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Connector_typeOwner_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Connector_props" name="props" type="cls_Prop" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Connector_props_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Connector_props_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Connector_attributes" name="attributes" type="cls_Attribute" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Connector_attributes_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Connector_attributes_upper" value="*"/>
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Connector_TRange" name="TRange">
          <constrainedElement xmi:idref="cls_Connector"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Connector_TRange_spec">
            <language>OCL</language>
            <body>self.t &gt;= 0.0 and self.t &lt; 1.0</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Connector_DirectionNonZero" name="DirectionNonZero">
          <constrainedElement xmi:idref="cls_Connector"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Connector_DirectionNonZero_spec">
            <language>OCL</language>
            <body>(self.direction.x*self.direction.x + self.direction.y*self.direction.y + self.direction.z*self.direction.z) &gt; 0.0</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Connector_PortBelongsToOwningKit" name="PortBelongsToOwningKit">
          <constrainedElement xmi:idref="cls_Connector"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Connector_PortBelongsToOwningKit_spec">
            <language>OCL</language>
            <body>self.port.oclIsUndefined() or self.typeOwner.kit.ports-&gt;includes(self.port)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Connector_CompatiblePortsBelongToOwningKit" name="CompatiblePortsBelongToOwningKit">
          <constrainedElement xmi:idref="cls_Connector"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Connector_CompatiblePortsBelongToOwningKit_spec">
            <language>OCL</language>
            <body>self.compatiblePorts-&gt;forAll(p | self.typeOwner.kit.ports-&gt;includes(p))</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Connector_CompatiblePortsDistinct" name="CompatiblePortsDistinct">
          <constrainedElement xmi:idref="cls_Connector"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Connector_CompatiblePortsDistinct_spec">
            <language>OCL</language>
            <body>self.compatiblePorts-&gt;isUnique(guid)</body>
          </specification>
        </ownedRule>
