          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Stat_designOwner_upper" value="1"/>
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Stat_RangeConsistent" name="RangeConsistent">
          <constrainedElement xmi:idref="cls_Stat"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Stat_RangeConsistent_spec">
            <language>OCL</language>
            <body>self.min.oclIsUndefined() or self.max.oclIsUndefined() or self.min &lt; self.max or (self.min = self.max and not (self.minExcluded or self.maxExcluded))</body>
          </specification>
        </ownedRule>
      </packagedElement>
