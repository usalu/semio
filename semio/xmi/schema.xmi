<?xml version="1.0" encoding="utf-8"?>
<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmi:version="20131001">
  <uml:Model xmi:id="model_semio" name="Semio" visibility="public">
    <ownedComment xmi:id="comment_model_scope" body="Conceptual UML/XMI model for the semio domain. Primary source: semio specification in AGENTS.md; explicit field limits and validation rules were folded in from the Python, Go, and C# implementations. This file encodes the semio conceptual schema plus OCL invariants for the constraints that fit naturally in UML/XMI. It is not intended to be a byte-for-byte export of any single runtime implementation."/>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_primitives" name="PrimitiveTypes">
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_String" name="String"/>
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_Integer" name="Integer"/>
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_Real" name="Real"/>
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_Boolean" name="Boolean"/>
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_DateTime" name="DateTime"/>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_geometry" name="Geometry">
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_Coord" name="Coord">
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Coord_u" name="u" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Coord_u_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Coord_u_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Coord_v" name="v" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Coord_v_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Coord_v_upper" value="1"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_Point" name="Point">
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Point_x" name="x" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Point_x_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Point_x_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Point_y" name="y" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Point_y_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Point_y_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Point_z" name="z" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Point_z_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Point_z_upper" value="1"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_Vector" name="Vector">
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Vector_x" name="x" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Vector_x_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Vector_x_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Vector_y" name="y" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Vector_y_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Vector_y_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Vector_z" name="z" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Vector_z_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Vector_z_upper" value="1"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_Plane" name="Plane">
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Plane_origin" name="origin" type="dt_Point">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Plane_origin_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Plane_origin_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Plane_xAxis" name="xAxis" type="dt_Vector">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Plane_xAxis_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Plane_xAxis_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Plane_yAxis" name="yAxis" type="dt_Vector">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Plane_yAxis_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Plane_yAxis_upper" value="1"/>
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="dt_Plane_AxesNonZero" name="AxesNonZero">
          <constrainedElement xmi:idref="dt_Plane"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="dt_Plane_AxesNonZero_spec">
            <language>OCL</language>
            <body>let xl : Real = self.xAxis.x*self.xAxis.x + self.xAxis.y*self.xAxis.y + self.xAxis.z*self.xAxis.z in
let yl : Real = self.yAxis.x*self.yAxis.x + self.yAxis.y*self.yAxis.y + self.yAxis.z*self.yAxis.z in
xl &gt; 0.0 and yl &gt; 0.0</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="dt_Plane_AxesNotCollinear" name="AxesNotCollinear">
          <constrainedElement xmi:idref="dt_Plane"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="dt_Plane_AxesNotCollinear_spec">
            <language>OCL</language>
            <body>let cx : Real = self.xAxis.y*self.yAxis.z - self.xAxis.z*self.yAxis.y in
let cy : Real = self.xAxis.z*self.yAxis.x - self.xAxis.x*self.yAxis.z in
let cz : Real = self.xAxis.x*self.yAxis.y - self.xAxis.y*self.yAxis.x in
(cx*cx + cy*cy + cz*cz) &gt; 0.0</body>
          </specification>
        </ownedRule>
      </packagedElement>
      <packagedElement xmi:type="uml:DataType" xmi:id="dt_Location" name="Location">
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Location_longitude" name="longitude" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Location_longitude_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Location_longitude_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Location_latitude" name="latitude" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Location_latitude_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Location_latitude_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="dt_Location_altitude" name="altitude" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="dt_Location_altitude_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="dt_Location_altitude_upper" value="1"/>
        </ownedAttribute>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_core" name="Core">
      <packagedElement xmi:type="uml:Enumeration" xmi:id="enum_QualityKind" name="QualityKind">
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="enum_QualityKind_General" name="General"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="enum_QualityKind_Design" name="Design"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="enum_QualityKind_Type" name="Type"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="enum_QualityKind_Piece" name="Piece"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="enum_QualityKind_Connection" name="Connection"/>
        <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="enum_QualityKind_Connector" name="Connector"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_Attribute" name="Attribute">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Attribute_guid" name="guid" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_guid_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_guid_upper" value="1"/>
          <ownedComment xmi:id="cls_Attribute_guid_comment" body="Runtime/persistence GUID; implementations typically cap this at 128 chars.">
            <annotatedElement xmi:idref="cls_Attribute_guid"/>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Attribute_key" name="key" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_key_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_key_upper" value="1"/>
          <ownedComment xmi:id="cls_Attribute_key_comment" body="Kebab/dot style metadata key.">
            <annotatedElement xmi:idref="cls_Attribute_key"/>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Attribute_value" name="value" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_value_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_value_upper" value="1"/>
          <ownedComment xmi:id="cls_Attribute_value_comment" body="Optional; semantic absence means boolean true.">
            <annotatedElement xmi:idref="cls_Attribute_value"/>
          </ownedComment>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Attribute_unit" name="unit" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_unit_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_unit_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Attribute_definition" name="definition" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_definition_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Attribute_definition_upper" value="1"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_Tag" name="Tag">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Tag_guid" name="guid" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Tag_guid_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Tag_guid_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Tag_name" name="name" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Tag_name_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Tag_name_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Tag_description" name="description" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Tag_description_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Tag_description_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Tag_icon" name="icon" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Tag_icon_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Tag_icon_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Tag_attributes" name="attributes" type="cls_Attribute" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Tag_attributes_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Tag_attributes_upper" value="*"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_Concept" name="Concept">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Concept_guid" name="guid" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Concept_guid_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Concept_guid_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Concept_name" name="name" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Concept_name_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Concept_name_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Concept_description" name="description" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Concept_description_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Concept_description_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Concept_icon" name="icon" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Concept_icon_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Concept_icon_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Concept_attributes" name="attributes" type="cls_Attribute" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Concept_attributes_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Concept_attributes_upper" value="*"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_Author" name="Author">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Author_guid" name="guid" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Author_guid_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Author_guid_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Author_name" name="name" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Author_name_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Author_name_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Author_email" name="email" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Author_email_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Author_email_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Author_attributes" name="attributes" type="cls_Attribute" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Author_attributes_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Author_attributes_upper" value="*"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_Folder" name="Folder">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Folder_guid" name="guid" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_guid_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_guid_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Folder_name" name="name" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_name_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_name_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Folder_description" name="description" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_description_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_description_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Folder_parent" name="parent" type="cls_Folder">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_parent_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_parent_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Folder_kit" name="kit" type="cls_Kit">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_kit_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_kit_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Folder_attributes" name="attributes" type="cls_Attribute" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Folder_attributes_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Folder_attributes_upper" value="*"/>
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Folder_ParentInSameKit" name="ParentInSameKit">
          <constrainedElement xmi:idref="cls_Folder"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Folder_ParentInSameKit_spec">
            <language>OCL</language>
            <body>self.parent.oclIsUndefined() or self.parent.kit = self.kit</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Folder_NotSelfParent" name="NotSelfParent">
          <constrainedElement xmi:idref="cls_Folder"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Folder_NotSelfParent_spec">
            <language>OCL</language>
            <body>self.parent.oclIsUndefined() or self.parent &lt;&gt; self</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Folder_AcyclicParentChain" name="AcyclicParentChain">
          <constrainedElement xmi:idref="cls_Folder"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Folder_AcyclicParentChain_spec">
            <language>OCL</language>
            <body>self.parent.oclIsUndefined() or self.parent-&gt;closure(parent)-&gt;excludes(self)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Folder_SiblingNameUnique" name="SiblingNameUnique">
          <constrainedElement xmi:idref="cls_Folder"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Folder_SiblingNameUnique_spec">
            <language>OCL</language>
            <body>self.kit.folders-&gt;select(f | f.parent = self.parent)-&gt;isUnique(name)</body>
          </specification>
        </ownedRule>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_File" name="File">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_File_guid" name="guid" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_guid_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_guid_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_File_name" name="name" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_name_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_name_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_File_path" name="path" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_path_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_path_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_File_remoteUrl" name="remoteUrl" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_remoteUrl_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_remoteUrl_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_File_description" name="description" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_description_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_description_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_File_folder" name="folder" type="cls_Folder">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_folder_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_folder_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_File_kit" name="kit" type="cls_Kit">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_kit_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_kit_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_File_attributes" name="attributes" type="cls_Attribute" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_File_attributes_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_File_attributes_upper" value="*"/>
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_File_FolderInSameKit" name="FolderInSameKit">
          <constrainedElement xmi:idref="cls_File"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_File_FolderInSameKit_spec">
            <language>OCL</language>
            <body>self.folder.oclIsUndefined() or self.folder.kit = self.kit</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_File_FileNameUniqueInKit" name="FileNameUniqueInKit">
          <constrainedElement xmi:idref="cls_File"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_File_FileNameUniqueInKit_spec">
            <language>OCL</language>
            <body>self.kit.files-&gt;isUnique(name)</body>
          </specification>
        </ownedRule>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_Benchmark" name="Benchmark">
