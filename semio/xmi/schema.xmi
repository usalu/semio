        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_icon" name="icon" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_icon_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_icon_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_image" name="image" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_image_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_image_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_description" name="description" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_description_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_description_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_createdAt" name="createdAt" type="pt_DateTime">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_createdAt_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_createdAt_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_updatedAt" name="updatedAt" type="pt_DateTime">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_updatedAt_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_updatedAt_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_folder" name="folder" type="cls_Folder">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_folder_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_folder_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_activeLayer" name="activeLayer" type="cls_Layer">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_activeLayer_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_activeLayer_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_kit" name="kit" type="cls_Kit">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_kit_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_kit_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_authors" name="authors" type="cls_Author" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_authors_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Design_authors_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_concepts" name="concepts" type="cls_Concept" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_concepts_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Design_concepts_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_pieces" name="pieces" type="cls_Piece" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_pieces_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Design_pieces_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_connections" name="connections" type="cls_Connection" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_connections_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Design_connections_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_stats" name="stats" type="cls_Stat" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_stats_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Design_stats_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_props" name="props" type="cls_Prop" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_props_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Design_props_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_layers" name="layers" type="cls_Layer" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_layers_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Design_layers_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_groups" name="groups" type="cls_Group" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_groups_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Design_groups_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Design_attributes" name="attributes" type="cls_Attribute" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Design_attributes_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Design_attributes_upper" value="*"/>
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_FolderInKit" name="FolderInKit">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_FolderInKit_spec">
            <language>OCL</language>
            <body>self.folder.oclIsUndefined() or self.folder.kit = self.kit</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_ActiveLayerInDesign" name="ActiveLayerInDesign">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_ActiveLayerInDesign_spec">
            <language>OCL</language>
            <body>self.activeLayer.oclIsUndefined() or self.layers-&gt;includes(self.activeLayer)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_AuthorsInKit" name="AuthorsInKit">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_AuthorsInKit_spec">
            <language>OCL</language>
            <body>self.authors-&gt;forAll(a | self.kit.authors-&gt;includes(a))</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_ConceptsInKit" name="ConceptsInKit">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_ConceptsInKit_spec">
            <language>OCL</language>
            <body>self.concepts-&gt;forAll(c | self.kit.concepts-&gt;includes(c))</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_SiblingNameUnique" name="SiblingNameUnique">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_SiblingNameUnique_spec">
            <language>OCL</language>
            <body>self.kit.designs-&gt;select(d | d.parent = self.parent)-&gt;isUnique(name)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_ParentInSameKit" name="ParentInSameKit">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_ParentInSameKit_spec">
            <language>OCL</language>
            <body>self.parent.oclIsUndefined() or self.parent.kit = self.kit</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_NotSelfParent" name="NotSelfParent">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_NotSelfParent_spec">
            <language>OCL</language>
            <body>self.parent.oclIsUndefined() or self.parent &lt;&gt; self</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_AcyclicParentChain" name="AcyclicParentChain">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_AcyclicParentChain_spec">
            <language>OCL</language>
            <body>self.parent.oclIsUndefined() or self.parent-&gt;closure(parent)-&gt;excludes(self)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_PieceIdsUnique" name="PieceIdsUnique">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_PieceIdsUnique_spec">
            <language>OCL</language>
            <body>self.pieces-&gt;isUnique(id)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_PieceNamesUniqueWhenPresent" name="PieceNamesUniqueWhenPresent">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_PieceNamesUniqueWhenPresent_spec">
            <language>OCL</language>
            <body>self.pieces-&gt;select(not name.oclIsUndefined() and name &lt;&gt; "")-&gt;isUnique(name)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_GroupPiecesContained" name="GroupPiecesContained">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_GroupPiecesContained_spec">
            <language>OCL</language>
            <body>self.groups-&gt;forAll(g | g.pieces-&gt;forAll(p | self.pieces-&gt;includes(p)))</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_ConnectionsReferenceContainedPieces" name="ConnectionsReferenceContainedPieces">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_ConnectionsReferenceContainedPieces_spec">
            <language>OCL</language>
            <body>self.connections-&gt;forAll(c | self.pieces-&gt;includes(c.connected.piece) and self.pieces-&gt;includes(c.connecting.piece))</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_EveryPieceFixedOrLinked" name="EveryPieceFixedOrLinked">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_EveryPieceFixedOrLinked_spec">
            <language>OCL</language>
            <body>self.pieces-&gt;forAll(p | (not p.plane.oclIsUndefined()) xor self.connections-&gt;exists(c | c.connected.piece = p or c.connecting.piece = p))</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Design_NoSameFamilyDesignPieces" name="NoSameFamilyDesignPieces">
          <constrainedElement xmi:idref="cls_Design"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Design_NoSameFamilyDesignPieces_spec">
            <language>OCL</language>
            <body>self.pieces-&gt;select(not designRef.oclIsUndefined())-&gt;forAll(p |
  Set{self}-&gt;closure(parent)-&gt;intersection(Set{p.designRef}-&gt;closure(parent))-&gt;isEmpty()
)</body>
          </specification>
        </ownedRule>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="cls_Kit" name="Kit">
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_guid" name="guid" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_guid_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_guid_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_uri" name="uri" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_uri_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_uri_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_name" name="name" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_name_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_name_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_version" name="version" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_version_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_version_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_remoteUrl" name="remoteUrl" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_remoteUrl_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_remoteUrl_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_homepageUrl" name="homepageUrl" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_homepageUrl_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_homepageUrl_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_license" name="license" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_license_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_license_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_icon" name="icon" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_icon_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_icon_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_image" name="image" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_image_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_image_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_preview" name="preview" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_preview_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_preview_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_description" name="description" type="pt_String">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_description_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_description_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_createdAt" name="createdAt" type="pt_DateTime">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_createdAt_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_createdAt_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_updatedAt" name="updatedAt" type="pt_DateTime">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_updatedAt_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_updatedAt_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_tags" name="tags" type="cls_Tag" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_tags_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_tags_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_concepts" name="concepts" type="cls_Concept" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_concepts_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_concepts_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_authors" name="authors" type="cls_Author" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_authors_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_authors_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_folders" name="folders" type="cls_Folder" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_folders_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_folders_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_files" name="files" type="cls_File" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_files_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_files_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_ports" name="ports" type="cls_Port" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_ports_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_ports_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_qualities" name="qualities" type="cls_Quality" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_qualities_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_qualities_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_types" name="types" type="cls_Type" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_types_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_types_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_designs" name="designs" type="cls_Design" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_designs_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_designs_upper" value="*"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Kit_attributes" name="attributes" type="cls_Attribute" aggregation="composite" isOrdered="true">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Kit_attributes_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Kit_attributes_upper" value="*"/>
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Kit_UriNotBlank" name="UriNotBlank">
          <constrainedElement xmi:idref="cls_Kit"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Kit_UriNotBlank_spec">
            <language>OCL</language>
            <body>self.uri.size() &gt; 0</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Kit_NameNotBlank" name="NameNotBlank">
          <constrainedElement xmi:idref="cls_Kit"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Kit_NameNotBlank_spec">
            <language>OCL</language>
            <body>self.name.size() &gt; 0</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Kit_UniqueGuidsInValidationScope" name="UniqueGuidsInValidationScope">
          <constrainedElement xmi:idref="cls_Kit"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Kit_UniqueGuidsInValidationScope_spec">
            <language>OCL</language>
            <body>let gs : Bag(String) =
  Bag{self.guid}
    -&gt;union(self.types-&gt;collect(t | t.guid))
    -&gt;union(self.types-&gt;collect(t | t.models-&gt;collect(m | m.guid))-&gt;flatten())
    -&gt;union(self.types-&gt;collect(t | t.connectors-&gt;collect(c | c.guid))-&gt;flatten())
    -&gt;union(self.designs-&gt;collect(d | d.guid))
    -&gt;union(self.designs-&gt;collect(d | d.pieces-&gt;collect(p | p.guid))-&gt;flatten())
    -&gt;union(self.designs-&gt;collect(d | d.connections-&gt;collect(c | c.guid))-&gt;flatten())
    -&gt;union(self.designs-&gt;collect(d | d.stats-&gt;collect(s | s.guid))-&gt;flatten())
    -&gt;union(self.qualities-&gt;collect(q | q.guid))
    -&gt;union(self.files-&gt;collect(f | f.guid))
    -&gt;union(self.folders-&gt;collect(f | f.guid))
    -&gt;union(self.ports-&gt;collect(p | p.guid))
in gs-&gt;asSet()-&gt;size() = gs-&gt;size()</body>
          </specification>
        </ownedRule>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_notes" name="Notes">
      <packagedElement xmi:type="uml:Comment" xmi:id="note_compatibility" body="Connector compatibility in semio is one-sided: it is enough for one connector to list the other connector's port as compatible. This XMI stores the underlying Port references but leaves the dynamic compatibility predicate to consuming tools."/>
      <packagedElement xmi:type="uml:Comment" xmi:id="note_hierarchy" body="Design hierarchy, fixed/linked placement, shortest-distance root levels, and breadth-first parent selection are defined semantically in the specification. They are derivable operations and are documented here rather than modeled as executable behavior in XMI."/>
      <packagedElement xmi:type="uml:Comment" xmi:id="note_lengths" body="String length limits come primarily from the Python implementation: NAME 64, ID 128, URL 1024, URI 2048, DESCRIPTION 512, FORMULA 4096. UML/XMI does not have a portable built-in maxLength facet on primitive String, so these limits are captured in comments and OCL where practical."/>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
