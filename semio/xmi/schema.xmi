        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Stat_max" name="max" type="pt_Real">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Stat_max_lower" value="0"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Stat_max_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Stat_maxExcluded" name="maxExcluded" type="pt_Boolean">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="cls_Stat_maxExcluded_lower" value="1"/>
          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Stat_maxExcluded_upper" value="1"/>
