          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_ModelNamesUnique_spec">
            <language>OCL</language>
            <body>self.models-&gt;select(not name.oclIsUndefined() and name &lt;&gt; "")-&gt;isUnique(name)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_AvailableCountNonNegative" name="AvailableCountNonNegative">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_AvailableCountNonNegative_spec">
            <language>OCL</language>
            <body>self.availableCount.oclIsUndefined() or self.availableCount &gt;= 0.0</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_FolderInKit" name="FolderInKit">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_FolderInKit_spec">
            <language>OCL</language>
            <body>self.folder.oclIsUndefined() or self.folder.kit = self.kit</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_AuthorsInKit" name="AuthorsInKit">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_AuthorsInKit_spec">
            <language>OCL</language>
            <body>self.authors-&gt;forAll(a | self.kit.authors-&gt;includes(a))</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_ConceptsInKit" name="ConceptsInKit">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_ConceptsInKit_spec">
            <language>OCL</language>
            <body>self.concepts-&gt;forAll(c | self.kit.concepts-&gt;includes(c))</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_SiblingNameUnique" name="SiblingNameUnique">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_SiblingNameUnique_spec">
            <language>OCL</language>
            <body>self.kit.types-&gt;select(t | t.parent = self.parent)-&gt;isUnique(name)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_ConnectorIdsUnique" name="ConnectorIdsUnique">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_ConnectorIdsUnique_spec">
            <language>OCL</language>
            <body>self.connectors-&gt;isUnique(id)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_ConnectorLabelsUniqueWhenPresent" name="ConnectorLabelsUniqueWhenPresent">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_ConnectorLabelsUniqueWhenPresent_spec">
            <language>OCL</language>
            <body>self.connectors-&gt;select(not name.oclIsUndefined() and name &lt;&gt; "")-&gt;isUnique(name)</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_ParentInSameKit" name="ParentInSameKit">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_ParentInSameKit_spec">
            <language>OCL</language>
            <body>self.parent.oclIsUndefined() or self.parent.kit = self.kit</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_NotSelfParent" name="NotSelfParent">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_NotSelfParent_spec">
            <language>OCL</language>
            <body>self.parent.oclIsUndefined() or self.parent &lt;&gt; self</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Type_AcyclicParentChain" name="AcyclicParentChain">
          <constrainedElement xmi:idref="cls_Type"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Type_AcyclicParentChain_spec">
            <language>OCL</language>
            <body>self.parent.oclIsUndefined() or self.parent-&gt;closure(parent)-&gt;excludes(self)</body>
          </specification>
        </ownedRule>
