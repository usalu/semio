          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="cls_Connection_attributes_upper" value="*"/>
        </ownedAttribute>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Connection_AngleRanges" name="AngleRanges">
          <constrainedElement xmi:idref="cls_Connection"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Connection_AngleRanges_spec">
            <language>OCL</language>
            <body>self.rotation &gt;= 0.0 and self.rotation &lt; 360.0 and self.turn &gt;= 0.0 and self.turn &lt; 360.0 and self.tilt &gt;= 0.0 and self.tilt &lt; 360.0</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Connection_SidesBelongToOwningDesign" name="SidesBelongToOwningDesign">
          <constrainedElement xmi:idref="cls_Connection"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Connection_SidesBelongToOwningDesign_spec">
            <language>OCL</language>
            <body>self.connected.piece.designOwner = self.designOwner and self.connecting.piece.designOwner = self.designOwner</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Connection_ConnectedConnectorOwnedByPieceType" name="ConnectedConnectorOwnedByPieceType">
          <constrainedElement xmi:idref="cls_Connection"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Connection_ConnectedConnectorOwnedByPieceType_spec">
            <language>OCL</language>
            <body>self.connected.piece.typeRef.oclIsUndefined() or self.connected.connector.typeOwner = self.connected.piece.typeRef</body>
          </specification>
        </ownedRule>
        <ownedRule xmi:type="uml:Constraint" xmi:id="cls_Connection_ConnectingConnectorOwnedByPieceType" name="ConnectingConnectorOwnedByPieceType">
          <constrainedElement xmi:idref="cls_Connection"/>
          <specification xmi:type="uml:OpaqueExpression" xmi:id="cls_Connection_ConnectingConnectorOwnedByPieceType_spec">
            <language>OCL</language>
            <body>self.connecting.piece.typeRef.oclIsUndefined() or self.connecting.connector.typeOwner = self.connecting.piece.typeRef</body>
          </specification>
        </ownedRule>
      </packagedElement>
