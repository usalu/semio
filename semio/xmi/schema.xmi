          <upperValue xmi:type="uml:LiteralInteger" xmi:id="cls_Connection_description_upper" value="1"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="cls_Connection_designOwner" name="designOwner" type="cls_Design">
