{
  "extends": "../js/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@semio/sketchpad": ["."],
      "@semio/sketchpad/*": ["./*"],
      "@semio/js": ["../js"],
      "@semio/js/*": ["../js/*"],
      "@semio/ui": ["../ui"],
      "@semio/ui/*": ["../ui/*"],
      "@semio/assets": ["../assets"],
      "@semio/assets/*": ["../assets/*"]
    },
    "types": ["react", "react-dom", "vite/client"]
  }
}
