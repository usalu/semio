{
  "name": "@semio/py",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/py",
        "command": "uv build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/py",
        "command": "uv run pytest",
        "forwardAllArgs": true
      }
    }
  }
}
