{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "incremental": false,
    "noEmit": true,
    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@semio/algorithms": ["./index.ts"],
      "@semio/algorithms/*": ["./*"],
      "@semio/ui": ["../ui/index.tsx"],
      "@semio/ui/*": ["../ui/*"]
    }
  },
  "exclude": ["node_modules", "storybook-static"]
}
