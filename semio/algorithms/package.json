    "build": "storybook build",
    "lint": "eslint --max-warnings 0 --config eslint.config.ts .",
    "test": "vitest run --passWithNoTests --config ../../elements/ui/vitest.config.ts"
  },
  "targets": {
    "lint": {
      "command": "npm run lint",
      "cwd": "semio/algorithms"
    }
  },
