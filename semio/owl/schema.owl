  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/semio#FixedPiece">
    <rdfs:label>FixedPiece</rdfs:label>
    <rdfs:comment>Piece with a plane.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Piece"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N3be7a266b0b143f9abddac43ab3709b9">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/semio#Piece"/>
          <owl:Restriction rdf:nodeID="Nad0f2958e9ff4a1d989d70311cf789b4">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://example.org/semio#hasPlane">
                <rdfs:label>hasPlane</rdfs:label>
                <rdfs:domain rdf:resource="https://example.org/semio#Piece"/>
                <rdfs:range rdf:resource="https://example.org/semio#Plane"/>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:someValuesFrom rdf:resource="https://example.org/semio#Plane"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <owl:disjointWith rdf:resource="https://example.org/semio#LinkedPiece"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Connection">
    <rdfs:label>Connection</rdfs:label>
    <rdfs:comment>3D link between two pieces with translation and rotation parameters.</rdfs:comment>
    <rdfs:comment>The two pieces are called connected and connecting, but the specification states there is no semantic difference between them.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N49244017154144ca8c0010e879487d09">
        <owl:onProperty rdf:resource="https://example.org/semio#connectedPiece"/>
        <owl:someValuesFrom rdf:resource="https://example.org/semio#Piece"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N5be9d934cfe04bdba90ca593a0ab42d7">
        <owl:onProperty rdf:resource="https://example.org/semio#connectingPiece"/>
        <owl:someValuesFrom rdf:resource="https://example.org/semio#Piece"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Nf6b06a435df040fdaf7144b2518af165">
        <owl:onProperty rdf:resource="https://example.org/semio#connectedConnector"/>
        <owl:someValuesFrom rdf:resource="https://example.org/semio#Connector"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="Na724ccace7e543e691984f569b9c7e23">
        <owl:onProperty rdf:resource="https://example.org/semio#connectingConnector"/>
        <owl:someValuesFrom rdf:resource="https://example.org/semio#Connector"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#DynamicKit">
    <rdfs:label>DynamicKit</rdfs:label>
    <rdfs:comment>A dynamic kit bound to a runtime.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Kit"/>
  </owl:Class>
