  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Port">
    <rdfs:label>Port</rdfs:label>
    <rdfs:comment>Named connector port used for explicit compatibility control.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Attribute">
    <rdfs:label>Attribute</rdfs:label>
    <rdfs:comment>Metadata key with optional value and definition.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Benchmark">
