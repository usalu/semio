    <rdfs:domain rdf:resource="https://example.org/semio#Design"/>
    <rdfs:range rdf:resource="https://example.org/semio#Design"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/semio#hasChildDesign"/>
      <rdf:Description rdf:about="https://example.org/semio#hasChildDesign"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
