>
  <owl:Class rdf:about="https://example.org/semio#HiddenPiece">
    <rdfs:label>HiddenPiece</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Piece"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="Na3136df7986446b490e80502dd8ae081">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/semio#Piece"/>
          <owl:Restriction rdf:nodeID="Nd6c7714a143d4eaab7c90fb4eed596c3">
            <owl:onProperty>
              <owl:DatatypeProperty rdf:about="https://example.org/semio#isHidden">
                <rdfs:label>isHidden</rdfs:label>
                <rdfs:domain>
                  <owl:Class rdf:nodeID="N57940030dd9c4ae9a2dc632a8fb3442e">
                    <owl:unionOf rdf:parseType="Collection">
                      <rdf:Description rdf:about="https://example.org/semio#Piece"/>
                      <rdf:Description rdf:about="https://example.org/semio#Layer"/>
                    </owl:unionOf>
                  </owl:Class>
                </rdfs:domain>
                <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
              </owl:DatatypeProperty>
            </owl:onProperty>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#FlatDesign">
    <rdfs:label>FlatDesign</rdfs:label>
    <rdfs:comment>Design with no connections and only fixed pieces.</rdfs:comment>
    <rdfs:comment>The flat design definition is represented as a sufficient and necessary condition: no connections and only fixed pieces.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Design"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N709680e99a0d456d8c4eed1ad67b77a7">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/semio#Design"/>
          <owl:Class rdf:nodeID="N4611ff7c86f3472e81e4f350ea5ad302">
            <owl:complementOf>
              <owl:Restriction rdf:nodeID="N21c3bc4d51cb489a8709e9dc548708c5">
                <owl:onProperty rdf:resource="https://example.org/semio#hasConnection"/>
                <owl:someValuesFrom rdf:resource="https://example.org/semio#Connection"/>
              </owl:Restriction>
            </owl:complementOf>
          </owl:Class>
          <owl:Restriction rdf:nodeID="N8885a0debd594d0a98c404ca1c463a7f">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://example.org/semio#hasPiece">
                <rdfs:label>hasPiece</rdfs:label>
                <rdfs:domain rdf:resource="https://example.org/semio#Design"/>
                <rdfs:range rdf:resource="https://example.org/semio#Piece"/>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:allValuesFrom rdf:resource="https://example.org/semio#FixedPiece"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/semio#isQualityInKit">
    <rdfs:label>isQualityInKit</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/semio#Quality"/>
    <rdfs:range rdf:resource="https://example.org/semio#Kit"/>
