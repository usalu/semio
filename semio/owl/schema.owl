  <owl:ObjectProperty rdf:about="https://example.org/semio#pieceConnectedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label>pieceConnectedTo</rdfs:label>
    <rdfs:comment>Direct piece-to-piece connectivity induced by a connection instance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/semio#Piece"/>
    <rdfs:range rdf:resource="https://example.org/semio#Piece"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://example.org/semio#pieceReachableFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>pieceReachableFrom</rdfs:label>
        <rdfs:comment>Transitive reachability approximation over pieceConnectedTo.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/semio#Piece"/>
        <rdfs:range rdf:resource="https://example.org/semio#Piece"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="N21fd5767a71b4741b9eb705d792b2cdc">
        <owl:inverseOf>
          <owl:ObjectProperty rdf:about="https://example.org/semio#connectedPiece">
            <rdfs:label>connectedPiece</rdfs:label>
            <rdfs:comment>One endpoint piece of a connection.</rdfs:comment>
            <rdfs:domain rdf:resource="https://example.org/semio#Connection"/>
            <rdfs:range rdf:resource="https://example.org/semio#Piece"/>
            <rdfs:subPropertyOf rdf:resource="https://example.org/semio#hasIncidentPiece"/>
          </owl:ObjectProperty>
        </owl:inverseOf>
      </rdf:Description>
      <rdf:Description rdf:about="https://example.org/semio#connectingPiece"/>
    </owl:propertyChainAxiom>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="N8fc04641857e4c89956d958c3fd747e9">
        <owl:inverseOf>
          <owl:ObjectProperty rdf:about="https://example.org/semio#connectingPiece">
            <rdfs:label>connectingPiece</rdfs:label>
            <rdfs:comment>Other endpoint piece of a connection. The specification states no semantic difference from connectedPiece.</rdfs:comment>
            <rdfs:domain rdf:resource="https://example.org/semio#Connection"/>
            <rdfs:range rdf:resource="https://example.org/semio#Piece"/>
            <rdfs:subPropertyOf rdf:resource="https://example.org/semio#hasIncidentPiece"/>
          </owl:ObjectProperty>
        </owl:inverseOf>
      </rdf:Description>
      <rdf:Description rdf:about="https://example.org/semio#connectedPiece"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
