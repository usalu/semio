  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Type">
    <rdfs:label>Type</rdfs:label>
    <rdfs:comment>Reusable component with models, connectors, attributes, concepts, and authors.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Artifact"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#SelectedPiece">
    <rdfs:label>SelectedPiece</rdfs:label>
    <rdfs:comment>Workflow/UI selection state used by the dragging algorithm.</rdfs:comment>
    <rdfs:comment>Selection is not part of the persistent Semio schema; it is introduced here to formalize the dragging algorithm discussed in the conversation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Piece"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="Nd387daaeadf44a08a4814a363652e86a">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/semio#Piece"/>
          <owl:Restriction rdf:nodeID="N6c5c794a976745cdbfb3ca299ab6dc1b">
            <owl:onProperty rdf:resource="https://example.org/semio#isSelected"/>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/semio#hasChildPiece">
    <rdfs:label>hasChildPiece</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/semio#Piece"/>
    <rdfs:range rdf:resource="https://example.org/semio#Piece"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://example.org/semio#hasParentPiece">
        <rdfs:label>hasParentPiece</rdfs:label>
        <rdfs:domain rdf:resource="https://example.org/semio#Piece"/>
        <rdfs:range rdf:resource="https://example.org/semio#Piece"/>
        <rdfs:subPropertyOf rdf:resource="https://example.org/semio#hasAncestorPiece"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
    <rdfs:subPropertyOf rdf:resource="https://example.org/semio#hasDescendantPiece"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/semio#Connector">
    <rdfs:label>Connector</rdfs:label>
    <rdfs:comment>Conceptual connection point with point, direction, optional port, compatibility, and metadata.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Layer">
    <rdfs:label>Layer</rdfs:label>
    <rdfs:comment>Organizational grouping within a design.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Tag">
    <rdfs:label>Tag</rdfs:label>
    <rdfs:comment>Kebab-cased name used to tag models.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#QualityKind">
    <rdfs:label>QualityKind</rdfs:label>
    <rdfs:comment>Enumeration of quality applicability kinds.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="Nbcf27802dad5403b868408e06562754a">
        <owl:oneOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/semio#GeneralKind"/>
          <rdf:Description rdf:about="https://example.org/semio#DesignKind"/>
          <rdf:Description rdf:about="https://example.org/semio#TypeKind"/>
          <rdf:Description rdf:about="https://example.org/semio#PieceKind"/>
          <rdf:Description rdf:about="https://example.org/semio#ConnectionKind"/>
          <rdf:Description rdf:about="https://example.org/semio#ConnectorKind"/>
        </owl:oneOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/semio#hasAncestorDesign">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>hasAncestorDesign</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/semio#Design"/>
    <rdfs:range rdf:resource="https://example.org/semio#Design"/>
    <owl:inverseOf rdf:resource="https://example.org/semio#hasDescendantDesign"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/semio#hasIncidentConnector">
    <rdfs:label>hasIncidentConnector</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/semio#Connection"/>
    <rdfs:range rdf:resource="https://example.org/semio#Connector"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/semio#Model">
    <rdfs:label>Model</rdfs:label>
    <rdfs:comment>Tagged URL to a resource.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Stat">
    <rdfs:label>Stat</rdfs:label>
    <rdfs:comment>Statistical measurement on a design referencing a quality.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#FileResource">
    <rdfs:label>FileResource</rdfs:label>
    <rdfs:comment>Local or remote file resource referenced by models or kits.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Author">
    <rdfs:label>Author</rdfs:label>
    <rdfs:comment>Named contributor with email.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Artifact">
    <rdfs:label>Artifact</rdfs:label>
    <rdfs:comment>Reusable or authored artifact such as a Kit, Type, or Design.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Prop">
    <rdfs:label>Prop</rdfs:label>
    <rdfs:comment>Key-value pair referencing a quality with an optional unit.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#TypeInstancePiece">
    <rdfs:label>TypeInstancePiece</rdfs:label>
    <rdfs:comment>Piece instantiating a Type.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Piece"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N8d88fec85788490aa84bb428346eb37b">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/semio#Piece"/>
          <owl:Restriction rdf:nodeID="Nc4ddd06967d445f991444c3c3e1e0e69">
            <owl:onProperty rdf:resource="https://example.org/semio#instanceOfType"/>
            <owl:someValuesFrom rdf:resource="https://example.org/semio#Type"/>
          </owl:Restriction>
          <owl:Class rdf:nodeID="N99fbd67ed74e42a2a8def19e2aa4ecb2">
            <owl:complementOf>
              <owl:Restriction rdf:nodeID="N955b57043fcc49eeb2b97843148d08f8">
                <owl:onProperty rdf:resource="https://example.org/semio#instanceOfDesign"/>
                <owl:someValuesFrom rdf:resource="https://example.org/semio#Design"/>
              </owl:Restriction>
            </owl:complementOf>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <owl:disjointWith rdf:resource="https://example.org/semio#DesignInstancePiece"/>
  </owl:Class>
</rdf:RDF>
