  <owl:ObjectProperty rdf:about="https://example.org/semio#compatibleWithConnector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label>compatibleWithConnector</rdfs:label>
    <rdfs:comment>Explicit or derived connector compatibility.</rdfs:comment>
    <rdfs:comment>The specification's default rule 'no compatible ports means compatible with all' is a closed-world convention; under OWL's open-world semantics it is best treated as an application-level default unless fully asserted.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/semio#Connector"/>
    <rdfs:range rdf:resource="https://example.org/semio#Connector"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/semio#hasPort"/>
      <rdf:Description rdf:nodeID="N3f16fc2ed3a64c538a06ea0bd9ac96d3">
        <owl:inverseOf>
          <owl:ObjectProperty rdf:about="https://example.org/semio#compatibleWithPort">
            <rdfs:label>compatibleWithPort</rdfs:label>
            <rdfs:comment>Explicit compatible ports. Missing statements denote universal compatibility in the application semantics.</rdfs:comment>
            <rdfs:domain rdf:resource="https://example.org/semio#Connector"/>
            <rdfs:range rdf:resource="https://example.org/semio#Port"/>
          </owl:ObjectProperty>
        </owl:inverseOf>
      </rdf:Description>
    </owl:propertyChainAxiom>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/semio#compatibleWithPort"/>
      <rdf:Description rdf:nodeID="N4e6e903f48bb46b5bf6aa5d7068aa9c0">
        <owl:inverseOf>
          <owl:ObjectProperty rdf:about="https://example.org/semio#hasPort">
            <rdfs:label>hasPort</rdfs:label>
            <rdfs:comment>Connector's explicit port. Missing port denotes the default port under application semantics.</rdfs:comment>
            <rdfs:domain rdf:resource="https://example.org/semio#Connector"/>
            <rdfs:range rdf:resource="https://example.org/semio#Port"/>
          </owl:ObjectProperty>
        </owl:inverseOf>
      </rdf:Description>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/semio#directionZ">
