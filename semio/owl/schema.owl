    <rdfs:label>Plane</rdfs:label>
    <rdfs:comment>3D plane with origin, x-axis, and y-axis.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#LinkedPiece">
    <rdfs:label>LinkedPiece</rdfs:label>
    <rdfs:comment>Piece participating in at least one connection.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Piece"/>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N2852d98d20314199a973c722041ea4f8">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/semio#Piece"/>
          <owl:Restriction rdf:nodeID="N2a7ae65a59474820a5d48a047591655c">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://example.org/semio#participatesInConnection">
                <rdfs:label>participatesInConnection</rdfs:label>
                <rdfs:domain rdf:resource="https://example.org/semio#Piece"/>
                <rdfs:range rdf:resource="https://example.org/semio#Connection"/>
                <owl:inverseOf rdf:resource="https://example.org/semio#hasIncidentPiece"/>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:someValuesFrom rdf:resource="https://example.org/semio#Connection"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/semio#Component">
    <rdfs:label>Component</rdfs:label>
    <rdfs:comment>Connected component of pieces. Membership is typically asserted or computed externally.</rdfs:comment>
    <rdfs:comment>OWL can capture component membership as an asserted relation and approximate graph reachability via pieceReachableFrom, but exact connected-component partitioning usually requires external computation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/semio#Entity"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/semio#hasAncestorType">
