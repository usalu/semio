{
  "$schema": "../../node_modules/nx/schemas/technology-schema.json",
  "projectType": "application",
  "name": "@semio/vscode",
  "displayName": "semio",
  "description": "semio sketchpad for VS Code ✏️",
  "icon": "semio.png",
  "version": "0.0.1",
  "publisher": "usalu",
  "engines": {
    "vscode": "^1.104.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "semio/vscode"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "semio.kitEditor",
        "displayName": "Semio Kit Editor",
        "selector": [
          {
            "filenamePattern": "*.kit.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "vite build && vite build --mode webview",
    "dev": "sh -c 'vite build --watch & vite build --watch --mode webview & wait'",
    "test": "echo 'no tests yet'"
  },
  "dependencies": {
    "@semio/sketchpad": "*",
    "@semio/studio": "*",
    "@semio/js": "*",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/vscode": "^1.104.0",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "vite-plugin-wasm": "^3.5.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "license": "AGPL-3.0-or-later",
  "bundleKind": "ui"
}