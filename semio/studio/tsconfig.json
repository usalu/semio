{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "strict": true,
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@semio/js": ["../js"],
            "@semio/js/*": ["../js/*"]
        }
    },
    "include": [
        "studio.ts"
    ]
}