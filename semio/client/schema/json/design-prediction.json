                    "default": "",
                    "maxLength": 512,
                    "title": "Description",
                    "type": "string"
                },
                "gap": {
                    "default": 0,
                    "title": "Gap",
                    "type": "number"
                },
                "shift": {
                    "default": 0,
                    "title": "Shift",
                    "type": "number"
                },
                "rise": {
                    "default": 0,
                    "title": "Rise",
                    "type": "number"
                },
                "rotation": {
                    "default": 0,
                    "exclusiveMaximum": 360,
                    "minimum": 0,
                    "title": "Rotation",
                    "type": "number"
                },
                "turn": {
                    "default": 0,
                    "exclusiveMaximum": 360,
                    "minimum": 0,
                    "title": "Turn",
                    "type": "number"
                },
                "tilt": {
                    "default": 0,
                    "exclusiveMaximum": 360,
                    "minimum": 0,
                    "title": "Tilt",
                    "type": "number"
                },
                "u": {
                    "default": 0,
                    "title": "U",
