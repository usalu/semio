                "designPiece": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/DesignId"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null
                }
            },
            "title": "Piece",
            "type": "object"
        },
        "Side": {
            "description": "\ud83d\udd16Prediction fields for LLM-based side inference.",
