                "id_": {
                    "default": "",
                    "maxLength": 128,
                    "title": "Id",
                    "type": "string"
                }
            },
            "title": "PieceId",
            "type": "object"
        },
        "Piece": {
            "description": "\ud83d\udd16Prediction fields for LLM-based piece inference.",
