{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@semio/sketchpad": [
        "../sketchpad"
      ],
      "@semio/sketchpad/*": [
        "../sketchpad/*"
      ],
      "@semio/js": [
        "../js"
      ],
      "@semio/js/*": [
        "../js/*"
      ],
      "@ui/react": [
        "../../../ui/react"
      ],
      "@ui/react/*": [
        "../../../ui/react/*"
      ],
      "@semio/asset": [
        "../asset"
      ],
      "@semio/asset/*": [
        "../asset/*"
      ]
    },
    "types": [
      "node",
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "extension.ts",
    "webview.tsx"
  ]
}