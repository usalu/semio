{
  "name": "@semio/grasshopper",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build-gh": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/ui/gh/Semio.Grasshopper",
        "command": "bun ./build.script.ts",
        "forwardAllArgs": true
      }
    },
    "build-yak": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-gh"],
      "options": {
        "cwd": "semio/client/ui/gh/Semio.Grasshopper",
        "command": "bun ./yak/build.script.ts",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-gh", "build-yak"],
      "options": {
        "cwd": "semio/client/ui/gh/Semio.Grasshopper",
        "command": "bun -e \"process.exit(0)\"",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/ui/gh/Semio.Grasshopper",
        "command": "bun scripts/run-tests.script.ts",
        "forwardAllArgs": true
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/ui/gh/Semio.Grasshopper",
        "command": "bun ./yak/publish.script.ts",
        "forwardAllArgs": true
      }
    }
  }
}
