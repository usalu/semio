{
  "name": "@semio/grasshopper",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/ui/gh/Semio.Grasshopper",
        "commands": ["bun ./build.script.ts", "bun ./yak/build.script.ts"],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/ui/gh/Semio.Grasshopper",
        "command": "bun scripts/run-tests.script.ts",
        "forwardAllArgs": true
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/ui/gh/Semio.Grasshopper",
        "command": "bun ./yak/publish.script.ts",
        "forwardAllArgs": true
      }
    }
  }
}
