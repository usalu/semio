{
  "name": "@semio/sketchpad",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "semio/client/lib/sketchpad/js",
        "command": "bun ./script.ts setup"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio/rs:wasm"],
      "options": {
        "cwd": "semio/client/lib/sketchpad/js",
        "command": "bun ./script.ts dev",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio/rs:wasm"],
      "options": {
        "cwd": "semio/client/lib/sketchpad/js",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio/rs:wasm"],
      "options": {
        "cwd": "semio/client/lib/sketchpad/js",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "semio/client/lib/sketchpad/js",
        "command": "bun publish"
      }
    }
  }
}
