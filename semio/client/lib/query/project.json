{
  "name": "@semio/architect",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "rustup target add wasm32-unknown-unknown",
          "cargo fetch --manifest-path Cargo.toml"
        ],
        "parallel": false,
        "cwd": "semio/client/lib/query"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/lib.rs",
        "{projectRoot}/scripts/build-wasm.script.mjs",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock"
      ],
      "outputs": ["{projectRoot}/pkg"],
      "options": {
        "cwd": "semio/client/lib/query",
        "commands": [
          "bun scripts/build-wasm.script.mjs",
          "cargo build --release"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/query",
        "command": "cargo test",
        "forwardAllArgs": true
      }
    }
  }
}
