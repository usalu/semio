{
  "name": "@semio/rs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "rustup target add wasm32-unknown-unknown",
          "cargo fetch --manifest-path Cargo.toml"
        ],
        "parallel": false
      }
    },
    "wasm": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock",
        "{projectRoot}/lib.rs",
        "{projectRoot}/package.json",
        "{projectRoot}/.cargo/**/*",
        "{projectRoot}/script.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock"
      ],
      "outputs": ["{projectRoot}/pkg"],
      "options": {
        "cwd": "semio/client/lib/rs",
        "command": "bun script.ts wasm"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["wasm"],
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock",
        "{projectRoot}/lib.rs",
        "{projectRoot}/package.json",
        "{projectRoot}/.cargo/**/*",
        "{projectRoot}/script.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock"
      ],
      "outputs": ["{projectRoot}/pkg"],
      "options": {
        "cwd": "semio/client/lib/rs",
        "command": "bun script.ts build",
        "env": {
          "SEMIO_RS_SKIP_WASM": "1"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/rs",
        "command": "cargo test",
        "forwardAllArgs": true
      }
    }
  }
}
