{
  "name": "@semio/rs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "rustup target add wasm32-unknown-unknown",
          "cargo fetch --manifest-path Cargo.toml"
        ],
        "parallel": false
      }
    },
    "build-wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/rs",
        "command": "bun scripts/build-wasm.script.mjs",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/rs",
        "command": "cargo build --release",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/rs",
        "command": "cargo test",
        "forwardAllArgs": true
      }
    }
  }
}
