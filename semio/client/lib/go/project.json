{
  "name": "@semio/go",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/go",
        "command": "go build ./...",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/go",
        "command": "go test -v ./...",
        "forwardAllArgs": true
      }
    }
  }
}
