{
  "name": "@semio/ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/ui",
        "command": "bun ./dev.script.ts",
        "env": {
          "STORYBOOK_PORT": "6008",
          "CHOKIDAR_USEPOLLING": "1"
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/ui",
        "command": "bunx storybook build",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/ui",
        "command": "bunx eslint --max-warnings 0 --config eslint.config.ts .",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semio/client/lib/ui",
        "command": "bunx vitest run --passWithNoTests --config vitest.config.ts",
        "forwardAllArgs": true
      }
    }
  }
}
