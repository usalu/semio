{
  "name": "@semio/react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio/rs:build-wasm"],
      "options": {
        "cwd": "semio/client/lib/react",
        "command": "bunx tsc --noEmit",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio/rs:build-wasm"],
      "options": {
        "cwd": "semio/client/lib/react",
        "command": "bunx vitest run --config vite.config.ts index.tsx",
        "forwardAllArgs": true,
        "env": {
          "SEMIO_REACT_RUN_EMBEDDED_TESTS": "1",
          "SEMIO_JS_RUN_EMBEDDED_TESTS": "0"
        }
      }
    }
  }
}
