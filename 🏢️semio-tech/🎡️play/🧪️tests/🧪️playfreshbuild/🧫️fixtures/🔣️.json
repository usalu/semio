{
  "version": 1,
  "target": "@semio-tech/semio-tech-play:build",
  "catalogAdmission": "refuse",
  "retiredLaunchFiles": [
    ".vscode/🧩️launch.seed.jsonc",
    ".vscode/launch.json"
  ],
  "dashboard": {
    "registryProject": "📋️project.json",
    "playBuildProject": "🏢️semio-tech/🎡️play/📋️project.json",
    "parameter": "generation",
    "value": "fresh",
    "ship": {
      "buildMode": "build-mode",
      "buildModeValue": "ship",
      "cache": "cache",
      "cacheValue": "skip-all"
    }
  },
  "buildMachine": {
    "cpus": 10,
    "memoryGiB": 32
  },
  "environment": {
    "SEMIO_BUILD_MODE": "release",
    "SEMIO_NATIVE_BUILD_GENERATION": "fresh",
    "SEMIO_BUILD_TERMINAL": "false"
  },
  "driver": {
    "target": "release",
    "command": "bun ./📜️script.ts release",
    "generationEnvironment": "SEMIO_NATIVE_BUILD_GENERATION",
    "generationPrefix": "f",
    "owner": "buildReleasePipelineV1",
    "ownerModule": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🏗️build/🧩️driver-stages/🟦️.ts",
    "ownerArguments": [
      "network",
      "control"
    ],
    "callers": [
      "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🎛️commands/🚀️release/🟦️.ts",
      "🏢️semio-tech/🎡️play/🔨️modules/📦️site/🟦️.ts"
    ],
    "bypass": "runNativeBuildDriverV1",
    "stores": {
      "target": "t",
      "build": "b",
      "report": "r",
      "logs": "l",
      "jobserver": "j"
    }
  },
  "vite": {
    "config": "🏢️semio-tech/🎡️play/🏗️builder/🌐️vite/🟦️.ts",
    "owner": "viteCacheDirectory",
    "workspaceArgument": "repoRoot",
    "module": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🌐️vite/🟦️.ts",
    "budgetModule": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/💾️storage/🔒️enforcement/📦️budget/🟦️.ts",
    "issued": [
      "m",
      "vite",
      "release",
      "semio-tech-play",
      "state"
    ],
    "modes": [
      "prototype",
      "release"
    ],
    "unissued": "original bounded compiler cache"
  },
  "parallelRows": [
    {
      "cpus": 10,
      "memoryGiB": 32,
      "parallel": 8
    },
    {
      "cpus": 16,
      "memoryGiB": 64,
      "parallel": 16
    },
    {
      "cpus": 8,
      "memoryGiB": 16,
      "parallel": 2
    },
    {
      "cpus": 4,
      "memoryGiB": 8,
      "parallel": 1
    },
    {
      "cpus": 2,
      "memoryGiB": 3,
      "parallel": 1
    }
  ],
  "release": {
    "target": "build",
    "command": "bun ./🔨️modules/📦️site/📜️script.ts build",
    "removedTargets": [
      "catalog-release",
      "prepare-release"
    ],
    "prerequisites": [
      "workspace:deps-wasm-opt",
      "@semio-tech/plugin-registry:generate",
      "@semio-tech/assets:build"
    ],
    "bundleAfter": [
      "job:flow-wasm",
      "job:surface-wasm",
      "job:editor-wasm",
      "job:graph-wasm",
      "job:puzzle-wasm",
      "job:map-tiles"
    ],
    "pagesAfter": [
      "job:bundle",
      "job:support",
      "job:canvas-runtime-assets",
      "components:complete"
    ],
    "laneJobs": [
      "flow-wasm",
      "surface-wasm",
      "editor-wasm",
      "graph-wasm",
      "puzzle-wasm"
    ],
    "verifyTarget": "release-verify",
    "verifyCommand": "bun ./🔨️modules/📦️site/📜️script.ts verify"
  },
  "arguments": [
    "run",
    "@semio-tech/semio-tech-play:build",
    "--skip-cache",
    "--skip-remote-cache",
    "--parallel=8",
    "--output=stream"
  ],
  "invocationPidEnvironment": "SEMIO_BUILD_INVOCATION_PID",
  "invocationPidSchema": {
    "type": "string",
    "pattern": "^[1-9][0-9]*$"
  },
  "invocationPidRows": [
    {
      "value": "42",
      "expected": 42
    },
    {
      "value": "9007199254740991",
      "expected": 9007199254740991
    },
    {
      "value": null,
      "expected": null
    },
    {
      "value": "0",
      "expected": null
    },
    {
      "value": "-1",
      "expected": null
    },
    {
      "value": "1.5",
      "expected": null
    },
    {
      "value": "042",
      "expected": null
    },
    {
      "value": "9007199254740992",
      "expected": null
    },
    {
      "value": "4x",
      "expected": null
    }
  ],
  "developmentProjects": [
    "🏢️semio-tech/🎡️play/📋️project.json",
    "🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/📦️packages/🟦️typescript/📋️project.json"
  ]
}
