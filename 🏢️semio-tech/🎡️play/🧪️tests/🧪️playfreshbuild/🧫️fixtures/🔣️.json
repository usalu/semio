{
  "version": 1,
  "target": "@semio-tech/semio-tech-play:build",
  "catalogAdmission": "refuse",
  "launch": {
    "name": "📦️build🏢️semio-tech🎡️play🆕️fresh",
    "files": [
      ".vscode/🧩️launch.seed.jsonc",
      ".vscode/launch.json"
    ],
    "runner": "bun nx"
  },
  "buildMachine": {
    "cpus": 10,
    "memoryGiB": 32
  },
  "environment": {
    "SEMIO_BUILD_MODE": "release",
    "SEMIO_NATIVE_BUILD_GENERATION": "fresh",
    "NX_DAEMON": "false",
    "NX_SKIP_NX_CACHE": "true",
    "NX_SKIP_REMOTE_CACHE": "true",
    "NX_TUI": "false"
  },
  "driver": {
    "target": "release",
    "command": "bun ./📜️script.ts release",
    "generationEnvironment": "SEMIO_NATIVE_BUILD_GENERATION",
    "generationPrefix": "f",
    "stores": {
      "target": "t",
      "build": "b",
      "report": "r",
      "logs": "l",
      "jobserver": "j"
    }
  },
  "viteStorage": "vite/semio-tech-play",
  "parallelRows": [
    {
      "cpus": 10,
      "memoryGiB": 32,
      "parallel": 8
    },
    {
      "cpus": 16,
      "memoryGiB": 64,
      "parallel": 16
    },
    {
      "cpus": 8,
      "memoryGiB": 16,
      "parallel": 2
    },
    {
      "cpus": 4,
      "memoryGiB": 8,
      "parallel": 1
    },
    {
      "cpus": 2,
      "memoryGiB": 3,
      "parallel": 1
    }
  ],
  "release": {
    "target": "build",
    "command": "bun ./🔨️modules/📦️site/📜️script.ts build",
    "removedTargets": [
      "catalog-release",
      "prepare-release"
    ],
    "prerequisites": [
      "workspace:deps-wasm-opt",
      "@semio-tech/plugin-registry:generate"
    ],
    "bundleAfter": [
      "job:flow-wasm",
      "job:surface-wasm",
      "job:puzzle-wasm",
      "job:map-tiles"
    ],
    "pagesAfter": [
      "job:bundle",
      "job:support",
      "components:publish"
    ],
    "laneJobs": [
      "flow-wasm",
      "surface-wasm",
      "puzzle-wasm"
    ],
    "verifyTarget": "release-verify",
    "verifyCommand": "bun ./🔨️modules/📦️site/📜️script.ts verify"
  }
}
