{
  "version": 1,
  "target": "@semio-tech/semio-tech-play:build",
  "catalogAdmission": "refuse",
  "launch": {
    "name": "📦️build🏢️semio-tech🎡️play🆕️fresh",
    "files": [
      ".vscode/🧩️launch.seed.jsonc",
      ".vscode/launch.json"
    ],
    "runner": "bun repo"
  },
  "buildMachine": {
    "cpus": 10,
    "memoryGiB": 32
  },
  "environment": {
    "SEMIO_BUILD_MODE": "release",
    "SEMIO_NATIVE_BUILD_GENERATION": "fresh",
    "SEMIO_BUILD_TERMINAL": "false"
  },
  "driver": {
    "target": "release",
    "command": "bun ./📜️script.ts release",
    "generationEnvironment": "SEMIO_NATIVE_BUILD_GENERATION",
    "generationPrefix": "f",
    "owner": "buildReleasePipelineV1",
    "ownerModule": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🏗️build/🧩️driver-stages/🟦️.ts",
    "ownerArguments": ["network", "control"],
    "callers": ["📜️script.ts", "🏢️semio-tech/🎡️play/🔨️modules/📦️site/📜️script.ts"],
    "bypass": "runNativeBuildDriverV1",
    "freshLaunch": "📦️build🦑️workspace🚀️release🆕️fresh",
    "stores": {
      "target": "t",
      "build": "b",
      "report": "r",
      "logs": "l",
      "jobserver": "j"
    }
  },
  "viteStorage": "vite/semio-tech-play",
  "parallelRows": [
    {
      "cpus": 10,
      "memoryGiB": 32,
      "parallel": 8
    },
    {
      "cpus": 16,
      "memoryGiB": 64,
      "parallel": 16
    },
    {
      "cpus": 8,
      "memoryGiB": 16,
      "parallel": 2
    },
    {
      "cpus": 4,
      "memoryGiB": 8,
      "parallel": 1
    },
    {
      "cpus": 2,
      "memoryGiB": 3,
      "parallel": 1
    }
  ],
  "release": {
    "target": "build",
    "command": "bun ./🔨️modules/📦️site/📜️script.ts build",
    "removedTargets": [
      "catalog-release",
      "prepare-release"
    ],
    "prerequisites": [
      "workspace:deps-wasm-opt",
      "@semio-tech/plugin-registry:generate"
    ],
    "bundleAfter": [
      "job:flow-wasm",
      "job:surface-wasm",
      "job:puzzle-wasm",
      "job:map-tiles"
    ],
    "pagesAfter": [
      "job:bundle",
      "job:support",
      "components:publish"
    ],
    "laneJobs": [
      "flow-wasm",
      "surface-wasm",
      "puzzle-wasm"
    ],
    "verifyTarget": "release-verify",
    "verifyCommand": "bun ./🔨️modules/📦️site/📜️script.ts verify"
  },
  "arguments": [
    "run",
    "@semio-tech/semio-tech-play:build",
    "--skip-cache",
    "--skip-remote-cache",
    "--parallel=8",
    "--output=stream"
  ],
  "invocationPidEnvironment": "SEMIO_BUILD_INVOCATION_PID",
  "invocationPidSchema": {
    "type": "string",
    "pattern": "^[1-9][0-9]*$"
  },
  "invocationPidRows": [
    {
      "value": "42",
      "expected": 42
    },
    {
      "value": "9007199254740991",
      "expected": 9007199254740991
    },
    {
      "value": null,
      "expected": null
    },
    {
      "value": "0",
      "expected": null
    },
    {
      "value": "-1",
      "expected": null
    },
    {
      "value": "1.5",
      "expected": null
    },
    {
      "value": "042",
      "expected": null
    },
    {
      "value": "9007199254740992",
      "expected": null
    },
    {
      "value": "4x",
      "expected": null
    }
  ],
  "developmentProjects": [
    "🏢️semio-tech/🎡️play/📋️project.json",
    "🧰️framework/🛍️products/🐾️pets/🎯️targets/⚛️react/📦️packages/🟦️typescript/📋️project.json"
  ]
}
