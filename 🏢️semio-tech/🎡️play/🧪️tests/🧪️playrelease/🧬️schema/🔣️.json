{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paths",
    "origins",
    "files",
    "requests"
  ],
  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "file"
        ],
        "properties": {
          "request": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "expected"
        ],
        "properties": {
          "request": {
            "type": "string"
          },
          "expected": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "path",
          "body"
        ],
        "properties": {
          "page": {
            "enum": [
              "play",
              "map",
              "media",
              "modules"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "path",
          "status",
          "mime",
          "cors",
          "cacheControl"
        ],
        "properties": {
          "page": {
            "enum": [
              "play",
              "map",
              "media",
              "modules"
            ]
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "mime": {
            "type": "string"
          },
          "cors": {
            "type": [
              "string",
              "null"
            ]
          },
          "cacheControl": {
            "enum": [
              "no-cache",
              "no-store"
            ]
          }
        }
      }
    }
  }
}
