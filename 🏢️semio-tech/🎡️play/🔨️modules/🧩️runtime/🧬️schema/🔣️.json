{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/semio-tech/play/runtime/schema.json",
  "title": "PlayRuntimeCatalog",
  "description": "Grouped panes, the host runtime variant and the deployment host of semio-tech play.",
  "$ref": "#/$defs/PlayRuntimeCatalog",
  "$defs": {
    "PlayRuntimeCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "host", "hostVariant", "excludedBrandPrefix", "groups"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "host": { "type": "string", "minLength": 1 },
        "hostVariant": { "$ref": "#/$defs/PlayVariant" },
        "excludedBrandPrefix": { "type": "string", "minLength": 1 },
        "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/PlayGroup" } }
      }
    },
    "PlayGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "panes"],
      "properties": {
        "id": { "$ref": "#/$defs/PlayVariant" },
        "label": { "type": "string", "minLength": 1 },
        "panes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/PlayPane" } }
      }
    },
    "PlayPane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "label", "tagline", "description", "icon"],
      "properties": {
        "variant": { "$ref": "#/$defs/PlayVariant" },
        "label": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "example": { "$ref": "#/$defs/PlayExampleId" }
      }
    },
    "PlayVariant": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "PlayExampleId": {
      "description": "The curated example this pane boots on, as the owning app's plugin manifest declares it; absent when the app declares no example for its dialect.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
