{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Protocol": {
      "const": {
        "families": [
          "play",
          "map",
          "media",
          "modules"
        ],
        "manifest": "🧾️page.json",
        "cohort": "🔣️cohort.json",
        "scratchOwner": "play/pages-assembly",
        "cohortOwner": "play:pages:cohort"
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "family",
        "files"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "prototype",
            "release"
          ]
        },
        "family": {
          "enum": [
            "play",
            "map",
            "media",
            "modules"
          ]
        },
        "files": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "Cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "pages"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "prototype",
            "release"
          ]
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "manifestSha256"
            ],
            "properties": {
              "family": {
                "enum": [
                  "play",
                  "map",
                  "media",
                  "modules"
                ]
              },
              "manifestSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
