{
  "name": "@semio-tech/semios-play",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio-tech/compose-rs:wasm"],
      "options": {
        "cwd": "semios/play",
        "command": "bun ./script.ts dev",
        "env": {
          "SEMIOS_PLAY_PORT": "6066",
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semios/play",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "semios/play",
        "command": "bun ./script.ts test",
        "env": {
          "SEMIOS_PLAY_PORT": "6067"
        },
        "forwardAllArgs": true
      }
    }
  }
}
