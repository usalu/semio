{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.hub.gis-native-provider-selection/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packageVersion", "codecCount", "cases"],
  "properties": {
    "schema": { "const": "semio.hub.gis-native-provider-selection/v1" },
    "packageVersion": { "const": "0.1.0" },
    "codecCount": { "const": 2 },
    "cases": {
      "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "pluginId", "packageId", "version", "cancelled", "nowMs", "deadlineMs", "accepted"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "pluginId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "packageId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "version": { "type": "string", "minLength": 1, "maxLength": 32 },
          "cancelled": { "type": "boolean" },
          "nowMs": { "type": "integer", "minimum": 0, "maximum": 1001 },
          "deadlineMs": { "const": 1000 },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
