{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/artifact-authority/creation/schema.json",
  "$ref": "#/$defs/ArtifactCreationPhaseV1",
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ArtifactCreationPhaseV1": {
      "x-semio-formats": [
        "🔣️jsonschema"
      ],
      "enum": [
        "accepted",
        "preparing",
        "ready",
        "indeterminate",
        "failed",
        "cancelled"
      ]
    },
    "ArtifactCreationFactKindV1": {
      "x-semio-formats": [
        "🔣️jsonschema"
      ],
      "enum": [
        "accepted",
        "prepared",
        "committed",
        "cancelled",
        "failed"
      ]
    },
    "ArtifactCreationHttpLimitsV1": {
      "x-semio-formats": [
        "🔣️jsonschema"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bodyBytes",
        "liveOperations",
        "lifetimeMs"
      ],
      "properties": {
        "bodyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "liveOperations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "lifetimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      }
    },
    "ArtifactCreationHttpRouteV1": {
      "x-semio-formats": [
        "🔣️jsonschema"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "path",
        "accepted"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identity"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^/_semio/hub/"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "ArtifactCreationHttpResponseV1": {
      "x-semio-formats": [
        "🔣️jsonschema"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/ArtifactCreationPhaseV1"
        },
        "status": {
          "enum": [
            200,
            202
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "phase"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "accepted",
                  "preparing"
                ]
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "status": {
                "const": 202
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "status": {
                "const": 200
              }
            },
            "type": "object"
          }
        }
      ]
    }
  }
}
