          "const": 0
        },
        "terminal": {
          "const": "failed"
        },
        "facts": {
          "const": 2
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "recoveryCandidates",
        "terminal",
        "facts"
      ],
      "properties": {
        "kind": {
          "const": "expired"
        },
        "recoveryCandidates": {
          "const": 1
        },
