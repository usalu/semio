{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/artifact-authority/trusted-catalog/schema.json",
  "$ref": "#/$defs/TrustedBundleV1",
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:.*\\S)?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonzeroDigest": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
    "requestId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!.*\\\\)(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "publicationRevision": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    },

    "TrustedCatalogRelativePathV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![\\s\\S]*[\\\\\\u0000])(?!/)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+){0,63}$"
    },

    "TrustedBundleIdentityV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "version"],
      "properties": {
        "pluginId": { "$ref": "#/$defs/identity" },
        "packageId": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/identity" }
      }
    },

    "TrustedBundleCodecV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "artifactSchema", "packSchemaHash"],
      "properties": {
        "artifactKind": { "$ref": "#/$defs/identity" },
        "artifactSchema": { "$ref": "#/$defs/identity" },
        "packSchemaHash": { "$ref": "#/$defs/nonzeroDigest" }
      }
    },

    "TrustedBundleParentDialectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "standard", "subset"],
      "properties": {
        "artifactKind": { "$ref": "#/$defs/identity" },
        "standard": { "$ref": "#/$defs/identity" },
        "subset": { "$ref": "#/$defs/identity" }
      }
    },

    "TrustedBundleGrantV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "observe"],
      "properties": { "read": { "type": "boolean" }, "write": { "type": "boolean" }, "observe": { "type": "boolean" } }
    },

    "TrustedBundleOpenTargetV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "artifactSchema", "packSchemaHash", "surfaceId", "appId", "windowKindId", "role", "rendererTarget", "parentDialect", "grant"],
      "properties": {
        "artifactKind": { "$ref": "#/$defs/identity" },
        "artifactSchema": { "$ref": "#/$defs/identity" },
        "packSchemaHash": { "$ref": "#/$defs/nonzeroDigest" },
        "surfaceId": { "$ref": "#/$defs/identity" },
        "appId": { "$ref": "#/$defs/identity" },
        "windowKindId": { "$ref": "#/$defs/identity" },
        "role": { "enum": ["viewer", "editor"] },
        "rendererTarget": { "enum": ["react", "wgpu", "wasm"] },
        "parentDialect": { "$ref": "#/$defs/TrustedBundleParentDialectV1" },
        "grant": { "$ref": "#/$defs/TrustedBundleGrantV1" }
      }
    },

    "TrustedDescriptorOpenTargetV1": {
      "description": "One document-open surface a verified descriptor declares for one of its artifact kinds, before a codec binds its pack fingerprint: an editor or viewer app opens a kind it declares itself, or a plugin-level kind its own dialect names, in its first window kind. TrustedBundleOpenTargetV1 without packSchemaHash.",
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "artifactSchema", "surfaceId", "appId", "windowKindId", "role", "rendererTarget", "parentDialect", "grant"],
      "properties": {
        "artifactKind": { "$ref": "#/$defs/identity" },
        "artifactSchema": { "$ref": "#/$defs/identity" },
        "surfaceId": { "$ref": "#/$defs/identity" },
        "appId": { "$ref": "#/$defs/identity" },
        "windowKindId": { "$ref": "#/$defs/identity" },
        "role": { "enum": ["viewer", "editor"] },
        "rendererTarget": { "enum": ["react", "wgpu", "wasm"] },
        "parentDialect": { "$ref": "#/$defs/TrustedBundleParentDialectV1" },
        "grant": { "$ref": "#/$defs/TrustedBundleGrantV1" }
      }
    },

    "TrustedCatalogDescriptorOpenTargetsV1": {
      "description": "What `os-hub trusted-catalog open-targets` answers for one package descriptor read from stdin: every surface the hub's own pairing rule admits, in descriptor app order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "targets"],
      "properties": {
        "schema": { "const": "semio.hub.trusted-catalog-descriptor-open-targets/v1" },
        "targets": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/TrustedDescriptorOpenTargetV1" } }
      }
    },

    "TrustedBundleFileV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },

    "TrustedBundleComponentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256", "blake3"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/digest" },
        "blake3": { "$ref": "#/$defs/digest" }
      }
    },

    "TrustedBundleExecutionProtocolV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appChannelVersion"],
      "properties": { "appChannelVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 } }
    },

    "TrustedBundleBrowserActorV1": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "none" } } },
        {
          "allOf": [
            { "$ref": "https://json.schemas.assets.semio-tech.com/os/directory/component.json#/$defs/DocumentBrowserActorIdentity" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "byteLength"],
              "properties": {
                "kind": {},
                "schema": {},
                "codegenPolicy": {},
                "sha256": {},
                "sourceComponentSha256": {},
                "sourceDescriptorByteSha256": {},
                "policySha256": {},
                "importInterfaces": {},
                "path": { "$ref": "#/$defs/relativePath" },
                "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 }
              }
            }
          ]
        }
      ]
    },

    "TrustedPluginModulePathV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:(?!\\.{1,2}/)[^/\\\\\\u0000-\\u001f\\u007f?#%]+/){0,15}(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f?#%]+$"
    },

    "TrustedPluginModuleFileV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256", "blake3"],
      "properties": {
        "path": { "$ref": "#/$defs/TrustedPluginModulePathV1" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/digest" },
        "blake3": { "$ref": "#/$defs/digest" }
      }
    },

    "TrustedPluginModuleBundleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "pluginId", "packageId", "version", "sourceComponentSha256", "sourceDescriptorByteSha256", "moduleDirectory", "entry", "files"],
      "properties": {
        "schema": { "const": "semio.hub.trusted-plugin-module/v1" },
        "pluginId": { "$ref": "#/$defs/identity" },
        "packageId": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/identity" },
        "sourceComponentSha256": { "$ref": "#/$defs/digest" },
        "sourceDescriptorByteSha256": { "$ref": "#/$defs/digest" },
        "moduleDirectory": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f?#%]+$" },
        "entry": { "$ref": "#/$defs/TrustedPluginModulePathV1" },
        "files": { "type": "array", "minItems": 3, "maxItems": 256, "items": { "$ref": "#/$defs/TrustedPluginModuleFileV1" } }
      }
    },

    "TrustedBundlePluginModuleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256", "blake3"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "sha256": { "$ref": "#/$defs/digest" },
        "blake3": { "$ref": "#/$defs/digest" }
      }
    },

    "TrustedBundlePackageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "version", "role", "dependencies", "component", "descriptor", "executionProtocol", "browserActor", "pluginModule", "nativeCodecs", "openTargets"],
      "properties": {
        "pluginId": { "$ref": "#/$defs/identity" },
        "packageId": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/identity" },
        "role": { "enum": ["plugin", "extension"] },
        "dependencies": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/TrustedBundleIdentityV1" } },
        "executionProtocol": { "$ref": "#/$defs/TrustedBundleExecutionProtocolV1" },
        "component": { "$ref": "#/$defs/TrustedBundleComponentV1" },
        "descriptor": { "$ref": "#/$defs/TrustedBundleFileV1" },
        "browserActor": { "$ref": "#/$defs/TrustedBundleBrowserActorV1" },
        "pluginModule": { "$ref": "#/$defs/TrustedBundlePluginModuleV1" },
        "nativeCodecs": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/TrustedBundleCodecV1" } },
        "openTargets": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/TrustedBundleOpenTargetV1" } }
      }
    },

    "TrustedBundleProfileOpenTargetV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "target"],
      "properties": {
        "package": { "$ref": "#/$defs/TrustedBundleIdentityV1" },
        "target": { "$ref": "#/$defs/TrustedBundleOpenTargetV1" }
      }
    },

    "TrustedBundleProfileV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selectedClosure", "selectedClosureSha256", "openTargets", "generationId"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "selectedClosure": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/TrustedBundleIdentityV1" } },
        "selectedClosureSha256": { "$ref": "#/$defs/nonzeroDigest" },
        "openTargets": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/TrustedBundleProfileOpenTargetV1" } },
        "generationId": { "$ref": "#/$defs/nonzeroDigest" }
      }
    },

    "TrustedBundleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "profiles", "packages"],
      "properties": {
        "schemaVersion": { "const": 3 },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/TrustedBundleProfileV1" } },
        "packages": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/TrustedBundlePackageV1" } }
      }
    },

    "TrustedCatalogCurrentPointerV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "generationId", "bundleSha256", "publicationRevision"],
      "properties": {
        "profileId": { "$ref": "#/$defs/identity" },
        "generationId": { "$ref": "#/$defs/digest" },
        "bundleSha256": { "$ref": "#/$defs/digest" },
        "publicationRevision": { "$ref": "#/$defs/publicationRevision" }
      }
    },

    "TrustedCatalogPublicationCommandV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId", "profileId", "generationId", "bundleSha256", "expectedCurrentSha256"],
      "properties": {
        "schema": { "const": "semio.hub.trusted-catalog-publication/v1" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "profileId": { "$ref": "#/$defs/identity" },
        "generationId": { "$ref": "#/$defs/digest" },
        "bundleSha256": { "$ref": "#/$defs/digest" },
        "expectedCurrentSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
      }
    },

    "TrustedCatalogPublicationReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId", "profileId", "generationId", "bundleSha256", "publicationRevision", "currentSha256", "outcome"],
      "properties": {
        "schema": { "const": "semio.hub.trusted-catalog-publication-receipt/v1" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "profileId": { "$ref": "#/$defs/identity" },
        "generationId": { "$ref": "#/$defs/digest" },
        "bundleSha256": { "$ref": "#/$defs/digest" },
        "publicationRevision": { "$ref": "#/$defs/publicationRevision" },
        "currentSha256": { "$ref": "#/$defs/digest" },
        "outcome": { "enum": ["durable", "replaced-unconfirmed"] }
      }
    },

    "TrustedPluginModuleIndexEntryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "version", "componentSha256", "descriptorByteSha256", "dependencies", "dialectArtifactKinds", "extendsPluginId", "bundleSha256", "bundleByteLength", "entry"],
      "properties": {
        "pluginId": { "$ref": "#/$defs/identity" },
        "packageId": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/identity" },
        "componentSha256": { "$ref": "#/$defs/digest" },
        "descriptorByteSha256": { "$ref": "#/$defs/digest" },
        "dependencies": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } },
        "dialectArtifactKinds": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } },
        "extendsPluginId": { "description": "The plugin an extension package extends (one of its dependencies); null for a plugin.", "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }] },
        "bundleSha256": { "$ref": "#/$defs/digest" },
        "bundleByteLength": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "entry": { "$ref": "#/$defs/TrustedPluginModulePathV1" }
      }
    },

    "TrustedPluginModuleIndexV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "generationId", "modules"],
      "properties": {
        "schema": { "const": "semio.hub.trusted-plugin-module-index/v1" },
        "generationId": { "$ref": "#/$defs/digest" },
        "modules": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/TrustedPluginModuleIndexEntryV1" } }
      }
    },

    "TrustedCatalogGuestResidencyV1": {
      "description": "How much compiled guest code one hub keeps resident, which guests stay, and how many guests a catalog load verifies at once. Every compiled guest is charged its component's byte length against the operator's budget (`OS_HUB_GUEST_RESIDENCY_BYTES`, default 256 MiB). A newly compiled guest that fits stays resident. One that does not fit stays only when it has been used more often than every guest it would release — the least recently used guests no call holds, taken in that order — and otherwise serves the calls that hold it without staying resident. Access counts are capped and all halve together after a declared number of accesses per registered guest, so a round-robin over more guests than fit keeps a stable resident set instead of recompiling every guest on every use, while a workload that moved on displaces the guests it left. Nothing is released for having been idle, and a released guest compiles again from its re-verified bytes on its next use.",
      "type": "object",
      "additionalProperties": false,
      "required": ["residentComponentBytes", "concurrentVerifications", "accessCountCeiling", "accessCountAgingPerGuest"],
      "properties": {
        "residentComponentBytes": { "type": "integer", "minimum": 0, "maximum": 17179869184, "default": 268435456, "description": "Most component bytes whose compiled guests stay resident beyond the ones running calls hold; configured by `OS_HUB_GUEST_RESIDENCY_BYTES` (decimal bytes, default 256 MiB, at most 16 GiB). `0` keeps nothing resident: every call compiles its guest." },
        "concurrentVerifications": { "const": 4, "description": "Most codec rows a catalog load interprets at once to verify their pack-schema hashes, each on its own instance; rows of one package share that package's one compile, dropped with its last row, and the largest components start first. The hub uses the smaller of this and half its available cores, at least one." },
        "accessCountCeiling": { "const": 15, "description": "The highest access count admission compares; a guest used more often counts as this many, so a once-hot guest cannot outlast a new workload for long." },
        "accessCountAgingPerGuest": { "const": 16, "description": "Every guest's access count halves after this many accesses per registered guest." }
      }
    },

    "TrustedCatalogGuestResidencyStateV1": {
      "description": "What one hub's compiled-guest residency holds now and has done since the hub started, as its admin observability route reports it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["budgetBytes", "registeredGuests", "residentGuests", "residentBytes", "hits", "compiles", "admitted", "bypassed", "released", "compileMicros"],
      "properties": {
        "budgetBytes": { "type": "integer", "minimum": 0, "maximum": 17179869184, "description": "The configured `residentComponentBytes`." },
        "registeredGuests": { "type": "integer", "minimum": 0, "description": "Guest-codec packages of the loaded catalog." },
        "residentGuests": { "type": "integer", "minimum": 0, "description": "Compiled guests resident now, counting ones a call is compiling or holding." },
        "residentBytes": { "type": "integer", "minimum": 0, "description": "The component bytes the resident guests are charged." },
        "hits": { "type": "integer", "minimum": 0, "description": "Codec calls served by a compiled guest that was already resident or held." },
        "compiles": { "type": "integer", "minimum": 0, "description": "Codec calls that compiled their guest." },
        "admitted": { "type": "integer", "minimum": 0, "description": "Compiles whose guest stayed resident." },
        "bypassed": { "type": "integer", "minimum": 0, "description": "Compiles whose guest served only the calls that held it, because it had been used less often than the guests it would have released." },
        "released": { "type": "integer", "minimum": 0, "description": "Resident guests released to make room." },
        "compileMicros": { "type": "integer", "minimum": 0, "description": "Wall time spent compiling guests, in microseconds." }
      }
    },

    "TrustedCatalogPackagePhaseV1": {
      "description": "Where one selected package stands: `pending` (not read yet), `reading` (its component, descriptor, browser actor and plugin module are read and their digests checked), `staged` (every file verified; codec rows no memory pinned wait for their component's answer), `verifying` (its component is interpreting those rows now), `ready` (every codec row pinned), `refused` (its component answered a row differently from the trust record, or could not be compiled: every codec call of the package is refused).",
      "enum": ["pending", "reading", "staged", "verifying", "ready", "refused"]
    },

    "TrustedCatalogPackageProgressV1": {
      "description": "One selected package's place in its catalog's load and verification.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "componentBytes", "phase", "rows", "rowsPinned", "rowsVerified"],
      "properties": {
        "pluginId": { "$ref": "#/$defs/identity" },
        "componentBytes": { "type": "integer", "minimum": 0 },
        "phase": { "$ref": "#/$defs/TrustedCatalogPackagePhaseV1" },
        "rows": { "type": "integer", "minimum": 0, "description": "Codec rows the package declares." },
        "rowsPinned": { "type": "integer", "minimum": 0, "description": "Rows pinned without interpreting the component: a linked native codec answers them, or this engine remembered verifying them." },
        "rowsVerified": { "type": "integer", "minimum": 0, "description": "Rows pinned by interpreting the component's own `pack-schema-hash`." }
      }
    },

    "TrustedCatalogLoadProgressV1": {
      "description": "How far a hub's trusted catalog has come: the load (files read and digests checked, until the hub serves) and the verification of codec rows no memory pinned, which runs in the background once the hub serves and before the first codec call of each package. Counts only — no estimate of the time left.",
      "type": "object",
      "additionalProperties": false,
      "required": ["packages", "packagesTotal", "packagesReady", "packagesRefused", "componentBytesTotal", "componentBytesRead", "rowsTotal", "rowsPinned", "rowsVerified"],
      "properties": {
        "packages": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/TrustedCatalogPackageProgressV1" } },
        "packagesTotal": { "type": "integer", "minimum": 0 },
        "packagesReady": { "type": "integer", "minimum": 0 },
        "packagesRefused": { "type": "integer", "minimum": 0 },
        "componentBytesTotal": { "type": "integer", "minimum": 0 },
        "componentBytesRead": { "type": "integer", "minimum": 0 },
        "rowsTotal": { "type": "integer", "minimum": 0 },
        "rowsPinned": { "type": "integer", "minimum": 0 },
        "rowsVerified": { "type": "integer", "minimum": 0 }
      }
    },

    "GuestCodecVerificationV1": {
      "description": "One remembered guest codec verification: the pack-schema hash the hub's own interpreter observed for one artifact schema of one component. It is content-addressed — stored under the SHA-256 of its canonical key (component SHA-256, artifact schema, engine) — and read back only when all three match again, so a warm boot skips interpreting a component it already verified while a changed component, schema or engine verifies afresh. Records live under `trusted-catalog/guest-codec-verifications/` and travel with a copied catalog.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "componentSha256", "artifactSchema", "engine", "packSchemaHash"],
      "properties": {
        "schema": { "const": "semio.hub.guest-codec-verification/v1" },
        "componentSha256": { "$ref": "#/$defs/nonzeroDigest" },
        "artifactSchema": { "$ref": "#/$defs/identity" },
        "engine": { "type": "string", "minLength": 1, "maxLength": 256, "description": "What verified it: the owned engine's semantic identity (a digest of the interpreter and owned host adapter sources) and the codec fuel ceiling, so any build of the same engine — copied, re-signed or cross-compiled — reuses the record and a changed engine verifies afresh." },
        "packSchemaHash": { "$ref": "#/$defs/nonzeroDigest" }
      }
    }
  }
}
