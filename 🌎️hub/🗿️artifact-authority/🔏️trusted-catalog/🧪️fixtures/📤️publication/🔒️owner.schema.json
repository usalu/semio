{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "before",
    "after",
    "nonce",
    "lock",
    "replacement",
    "process",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.hub.trusted-publication-owner/v1"
    },
    "before": {
      "const": "previous-selection\n"
    },
    "after": {
      "const": "next-selection\n"
    },
    "nonce": {
      "const": "0123456789abcdef0123456789abcdef"
    },
    "lock": {
      "const": {
        "first": "acquired",
        "competing": "contended",
        "afterDrop": "acquired"
      }
    },
    "replacement": {
      "const": {
        "selected": "next-selection\n",
        "foreignRoot": "foreign-selection\n"
      }
    },
    "process": {
      "const": { "holder": "acquired", "competing": "contended", "afterCrash": "acquired", "current": "unchanged" }
    },
    "cases": {
      "const": [
        "same-directory-replace",
        "cancel-before-replace",
        "duplicate-nonce-refused",
        "root-replacement-isolated",
        "lock-link-refused",
        "lock-directory-refused",
        "process-crash-releases-lock"
      ]
    }
  }
}
