{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.hub.trusted-catalog-publication/v1",
  "title": "Trusted Catalog Publication Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requestId", "profileId", "generationId", "bundleSha256", "expectedCurrentSha256"],
  "properties": {
    "schema": { "const": "semio.hub.trusted-catalog-publication/v1" },
    "requestId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "profileId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "generationId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bundleSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expectedCurrentSha256": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] }
  }
}
