{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "maximumSourceBytes", "maximumTotalBytes", "cases"],
  "properties": {
    "schema": { "const": "semio.hub.codec-source.v1" },
    "maximumSourceBytes": { "const": 65536 },
    "maximumTotalBytes": { "const": 131072 },
    "cases": {
      "type": "array", "minItems": 15, "maxItems": 15,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["change", "accepted", "schemaAccepted"],
        "properties": {
          "change": { "enum": ["none", "permuted", "replaced-source", "invalid-hash", "zero-hash", "duplicate-stdio", "duplicate-gis", "unknown-root", "unknown-row", "foreign-package", "crossed-gis-schema", "foreign-version", "invalid-utf8", "oversize", "cancelled"] },
          "accepted": { "type": "boolean" },
          "schemaAccepted": { "type": "boolean" }
        }
      }
    }
  }
}
