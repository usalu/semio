{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "componentHex", "descriptors", "executionProtocol", "cases"],
  "properties": {
    "schema": { "const": "semio.hub.generation-stage.v1" },
    "componentHex": { "const": "616263" },
    "descriptors": { "const": {
      "gis": { "packageId": "semio:gis", "manifest": { "pluginId": "gis", "version": "0.1.0", "dependencies": [{ "pluginId": "stdio", "version": "=0.1.0" }] }, "executionProtocol": { "appChannelVersion": 14 } },
      "stdio": { "packageId": "semio:stdio", "manifest": { "pluginId": "stdio", "version": "0.1.0", "dependencies": [] }, "executionProtocol": { "appChannelVersion": 14 } }
    } },
    "executionProtocol": { "const": { "appChannelVersion": 14 } },
    "cases": {
      "const": [
        { "change": "none", "accepted": true },
        { "change": "component", "accepted": false },
        { "change": "descriptor", "accepted": false },
        { "change": "bundle", "accepted": false },
        { "change": "extra-file", "accepted": false },
        { "change": "missing-file", "accepted": false },
        { "change": "symlink-file", "accepted": false },
        { "change": "symlink-directory", "accepted": false },
        { "change": "post-read-component", "accepted": false },
        { "change": "oversize-component", "accepted": false },
        { "change": "cancelled", "accepted": false },
        { "change": "receipt-path", "accepted": true },
        { "change": "actor", "accepted": false },
        { "change": "actor-source", "accepted": false },
        { "change": "actor-path", "accepted": false },
        { "change": "missing-actor", "accepted": false },
        { "change": "oversize-actor", "accepted": false },
        { "change": "post-read-actor", "accepted": false },
        { "change": "actor-symlink", "accepted": false },
        { "change": "missing-protocol", "accepted": false },
        { "change": "unsupported-protocol", "accepted": false },
        { "change": "receipt-protocol", "accepted": false },
        { "change": "missing-dependency", "accepted": false },
        { "change": "receipt-dependency", "accepted": false },
        { "change": "bundle-dependency", "accepted": false },
        { "change": "wrong-package", "accepted": false },
        { "change": "nonexact-dependency", "accepted": false },
        { "change": "duplicate-dependency", "accepted": false }
      ]
    }
  }
}
