{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/hub/artifact-chunk-cas-v1.fixture.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "spaceId", "chunkBytes", "maximumRawBytes", "maximumChunkCount", "maximumManifestBytes", "vectors", "largePair", "retentionLedger", "sweepContinuation", "deleteBarrier"],
  "properties": {
    "version": { "const": 1 },
    "spaceId": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "chunkBytes": { "const": 262144 },
    "maximumRawBytes": { "const": 67108864 },
    "maximumChunkCount": { "const": 256 },
    "maximumManifestBytes": { "const": 65536 },
    "vectors": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/vector" }
    },
    "largePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "spr", "totalLength"],
      "properties": {
        "pack": { "$ref": "#/$defs/vector" },
        "spr": { "$ref": "#/$defs/vector" },
        "totalLength": { "const": 67108864 }
      }
    },
    "retentionLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservationMaximumTtlMs", "reservationGraceMs", "sweepPageMaximum", "sweepObjectMaximum", "events", "snapshots"],
      "properties": {
        "reservationMaximumTtlMs": { "const": 300000 },
        "reservationGraceMs": { "const": 60000 },
        "sweepPageMaximum": { "const": 16 },
        "sweepObjectMaximum": { "const": 4096 },
        "events": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/ledgerEvent" }
        },
        "snapshots": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/ledgerSnapshot" }
        }
      }
    },
    "sweepContinuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "tokenPayloadBytes", "tokenAuthenticationBytes", "cursorExposesObjectIdentity", "invalidAfterGenerationChange", "invalidAfterRestart", "ledgerGeneration", "pageLedgerEvents", "planObjectCounts", "totalObjects", "requestMaximumObjects", "expectedExaminedPerRequest", "expectedFirstCursor"],
      "properties": {
        "formatVersion": { "const": 1 },
        "tokenPayloadBytes": { "const": 21 },
        "tokenAuthenticationBytes": { "const": 32 },
        "cursorExposesObjectIdentity": { "const": false },
        "invalidAfterGenerationChange": { "const": true },
        "invalidAfterRestart": { "const": true },
        "ledgerGeneration": { "const": 17 },
        "pageLedgerEvents": { "const": 16 },
        "planObjectCounts": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": { "const": 258 }
        },
        "totalObjects": { "const": 4386 },
        "requestMaximumObjects": { "const": 4096 },
        "expectedExaminedPerRequest": {
          "type": "array",
          "prefixItems": [{ "const": 4096 }, { "const": 290 }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "expectedFirstCursor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observedGeneration", "afterGeneration", "objectOffset"],
          "properties": {
            "observedGeneration": { "const": 17 },
            "afterGeneration": { "const": 0 },
            "objectOffset": { "const": 4096 }
          }
        }
      }
    },
    "deleteBarrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "coordinatorId", "spaceId", "objectBytesHex", "initialPhysicalEpoch", "deleteLeaseEpoch", "successorReservationEpoch", "leaseMaximumMs", "dryRunAdvancesEpoch", "orders"],
      "properties": {
        "formatVersion": { "const": 1 },
        "coordinatorId": { "$ref": "#/$defs/hash" },
        "spaceId": { "const": "barrier-race-space" },
        "objectBytesHex": { "type": "string", "pattern": "^[0-9a-f]+$" },
        "initialPhysicalEpoch": { "const": 1 },
        "deleteLeaseEpoch": { "const": 2 },
        "successorReservationEpoch": { "const": 3 },
        "leaseMaximumMs": { "const": 5000 },
        "dryRunAdvancesEpoch": { "const": false },
        "orders": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/deleteFirstOrder" },
            { "$ref": "#/$defs/successorFirstOrder" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "objectToken": { "type": "string", "pattern": "^(chunk|manifest):[0-9a-f]{64}$" },
    "deleteFirstOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actions", "oldDeleteOutcome", "publishedReadOutcome"],
      "properties": {
        "id": { "const": "delete-first" },
        "actions": {
          "type": "array",
          "prefixItems": [
            { "const": "lease:2" }, { "const": "cas-advance:2" }, { "const": "validate:2" }, { "const": "delete:2" },
            { "const": "reserve:3" }, { "const": "cas-advance:3" }, { "const": "stage" }, { "const": "publish" }, { "const": "read" }
          ],
          "items": false,
          "minItems": 9,
          "maxItems": 9
        },
        "oldDeleteOutcome": { "const": "deleted-before-successor-stage" },
        "publishedReadOutcome": { "const": "exact" }
      }
    },
    "successorFirstOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actions", "oldDeleteOutcome", "publishedReadOutcome"],
      "properties": {
        "id": { "const": "successor-first" },
        "actions": {
          "type": "array",
          "prefixItems": [
            { "const": "lease:2" }, { "const": "cas-advance:2" }, { "const": "lease-expire" }, { "const": "reserve:3" },
            { "const": "cas-advance:3" }, { "const": "stage" }, { "const": "publish" }, { "const": "delete:2" }, { "const": "read" }
          ],
          "items": false,
          "minItems": 9,
          "maxItems": 9
        },
        "oldDeleteOutcome": { "const": "stale-fence-rejected" },
        "publishedReadOutcome": { "const": "exact" }
      }
    },
    "ledgerEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "operation", "checkpointId", "expiresAtMs", "objects"],
          "properties": {
            "generation": { "type": "integer", "minimum": 1, "maximum": 7 },
            "operation": { "const": "reserve" },
            "checkpointId": { "$ref": "#/$defs/hash" },
            "expiresAtMs": { "type": "integer", "minimum": 1 },
            "objects": { "type": "array", "minItems": 1, "maxItems": 258, "uniqueItems": true, "items": { "$ref": "#/$defs/objectToken" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "operation", "checkpointId"],
          "properties": {
            "generation": { "type": "integer", "minimum": 1, "maximum": 7 },
            "operation": { "enum": ["publish", "retention"] },
            "checkpointId": { "$ref": "#/$defs/hash" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "operation"],
          "properties": {
            "generation": { "type": "integer", "minimum": 1, "maximum": 7 },
            "operation": { "const": "space-delete" }
          }
        }
      ]
    },
    "ledgerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["throughGeneration", "nowMs", "protected", "eligible"],
      "properties": {
        "throughGeneration": { "type": "integer", "minimum": 1, "maximum": 7 },
        "nowMs": { "type": "integer", "minimum": 0 },
        "protected": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/objectToken" } },
        "eligible": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/objectToken" } }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "rawSha256", "chunkCount", "manifestBytes", "manifestId", "firstChunkId", "lastChunkId"],
      "properties": {
        "length": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "rawSha256": { "$ref": "#/$defs/hash" },
        "chunkCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "manifestBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "manifestId": { "$ref": "#/$defs/hash" },
        "firstChunkId": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "lastChunkId": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    }
  }
}
