{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/hub/trusted-catalog-bundle-v1.json",
  "title": "Hub Trusted Catalog Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/profile" }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:.*\\S)?$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!.*\\\\)(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonzeroDigest": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "version"],
      "properties": {
        "pluginId": { "$ref": "#/$defs/identity" },
        "packageId": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/identity" }
      }
    },
    "codec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "artifactSchema", "packSchemaHash"],
      "properties": {
        "artifactKind": { "$ref": "#/$defs/identity" },
        "artifactSchema": { "$ref": "#/$defs/identity" },
        "packSchemaHash": { "$ref": "#/$defs/nonzeroDigest" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256", "blake3"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/digest" },
        "blake3": { "$ref": "#/$defs/digest" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "version", "role", "dependencies", "component", "descriptor", "nativeCodecs"],
      "properties": {
        "pluginId": { "$ref": "#/$defs/identity" },
        "packageId": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/identity" },
        "role": { "enum": ["plugin", "extension"] },
        "dependencies": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/dependency" } },
        "component": { "$ref": "#/$defs/component" },
        "descriptor": { "$ref": "#/$defs/file" },
        "nativeCodecs": { "type": "array", "maxItems": 16384, "items": { "$ref": "#/$defs/codec" } }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "version"],
      "properties": {
        "pluginId": { "$ref": "#/$defs/identity" },
        "packageId": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/identity" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "roots"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "roots": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/root" } }
      }
    }
  }
}
