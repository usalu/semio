{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/local-bootstrap/schema.json",
  "$ref": "#/$defs/LocalBootstrapPipeV1",
  "$defs": {
    "hex16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundedId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "clientClass": {
      "enum": [
        "native",
        "mcp",
        "react-relay",
        "admin-relay"
      ]
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "readyComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "🧭️ Why this gate is closed, as a stable kebab-case code. Present only when ready is false, so an operator or launcher waiting on /readyz reads the blocking condition instead of polling a silent boolean."
        }
      }
    },
    "closedReadinessGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "reason"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "startupProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "completedUnits",
        "totalUnits"
      ],
      "description": "📈️ How far a booting hub's startup work has come: the stage its trusted-catalog load last reported and that stage's units. Present only while the hub starts, when every component gate is closed with `hub-starting` and the artifact authority with `trusted-catalog-loading`.",
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$",
          "maxLength": 64
        },
        "completedUnits": {
          "type": "integer",
          "minimum": 0
        },
        "totalUnits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authenticated": {
      "type": "object",
      "required": [
        "schema",
        "runId",
        "sequence",
        "exchangeId",
        "issuedAt",
        "expiresAt",
        "proof"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-bootstrap/v1"
        },
        "runId": {
          "$ref": "#/$defs/hex16"
        },
        "sequence": {
          "$ref": "#/$defs/generation"
        },
        "exchangeId": {
          "$ref": "#/$defs/hex16"
        },
        "issuedAt": {
          "$ref": "#/$defs/safeInteger"
        },
        "expiresAt": {
          "$ref": "#/$defs/generation"
        },
        "proof": {
          "$ref": "#/$defs/hex32"
        }
      }
    },
    "LocalBootstrapProfileV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "subject",
        "displayName",
        "allowedClientClasses"
      ],
      "properties": {
        "profileId": {
          "$ref": "#/$defs/boundedId"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "allowedClientClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/clientClass"
          }
        }
      }
    },
    "LocalBootstrapPipeInitializeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "runId",
        "channelKey",
        "profiles"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-bootstrap/v1"
        },
        "kind": {
          "const": "initialize"
        },
        "runId": {
          "$ref": "#/$defs/hex16"
        },
        "channelKey": {
          "$ref": "#/$defs/hex32"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/LocalBootstrapProfileV1"
          }
        }
      }
    },
    "LocalBootstrapPipeHelloV1": {
      "allOf": [
        {
          "$ref": "#/$defs/authenticated"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "kind",
            "runId",
            "sequence",
            "exchangeId",
            "issuedAt",
            "expiresAt",
            "launcherNonce",
            "proof"
          ],
          "properties": {
            "schema": {},
            "kind": {
              "const": "hello"
            },
            "runId": {},
            "sequence": {},
            "exchangeId": {},
            "issuedAt": {},
            "expiresAt": {},
            "launcherNonce": {
              "$ref": "#/$defs/hex32"
            },
            "proof": {}
          }
        }
      ]
    },
    "LocalBootstrapPipeHelloAcceptedV1": {
      "allOf": [
        {
          "$ref": "#/$defs/authenticated"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "kind",
            "runId",
            "sequence",
            "exchangeId",
            "issuedAt",
            "expiresAt",
            "hubNonce",
            "proof"
          ],
          "properties": {
            "schema": {},
            "kind": {
              "const": "hello-accepted"
            },
            "runId": {},
            "sequence": {},
            "exchangeId": {},
            "issuedAt": {},
            "expiresAt": {},
            "hubNonce": {
              "$ref": "#/$defs/hex32"
            },
            "proof": {}
          }
        }
      ]
    },
    "LocalBootstrapPipeIssueV1": {
      "allOf": [
        {
          "$ref": "#/$defs/authenticated"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "kind",
            "runId",
            "sequence",
            "exchangeId",
            "issuedAt",
            "expiresAt",
            "profileId",
            "deviceInstanceId",
            "clientClass",
            "proof"
          ],
          "properties": {
            "schema": {},
            "kind": {
              "const": "issue"
            },
            "runId": {},
            "sequence": {},
            "exchangeId": {},
            "issuedAt": {},
            "expiresAt": {},
            "profileId": {
              "$ref": "#/$defs/boundedId"
            },
            "deviceInstanceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "clientClass": {
              "$ref": "#/$defs/clientClass"
            },
            "proof": {}
          }
        }
      ]
    },
    "LocalBootstrapPipeRejectV1": {
      "allOf": [
        {
          "$ref": "#/$defs/authenticated"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "kind",
            "runId",
            "sequence",
            "exchangeId",
            "issuedAt",
            "expiresAt",
            "code",
            "proof"
          ],
          "properties": {
            "schema": {},
            "kind": {
              "const": "reject"
            },
            "runId": {},
            "sequence": {},
            "exchangeId": {},
            "issuedAt": {},
            "expiresAt": {},
            "code": {
              "enum": [
                "cancelled",
                "denied",
                "expired",
                "resource-limit",
                "unavailable"
              ]
            },
            "proof": {}
          }
        }
      ]
    },
    "LocalBootstrapPipeCancelV1": {
      "allOf": [
        {
          "$ref": "#/$defs/authenticated"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "kind",
            "runId",
            "sequence",
            "exchangeId",
            "issuedAt",
            "expiresAt",
            "proof"
          ],
          "properties": {
            "schema": {},
            "kind": {
              "const": "cancel"
            },
            "runId": {},
            "sequence": {},
            "exchangeId": {},
            "issuedAt": {},
            "expiresAt": {},
            "proof": {}
          }
        }
      ]
    },
    "LocalBootstrapPipeShutdownV1": {
      "allOf": [
        {
          "$ref": "#/$defs/authenticated"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "kind",
            "runId",
            "sequence",
            "exchangeId",
            "issuedAt",
            "expiresAt",
            "proof"
          ],
          "properties": {
            "schema": {},
            "kind": {
              "const": "shutdown"
            },
            "runId": {},
            "sequence": {},
            "exchangeId": {},
            "issuedAt": {},
            "expiresAt": {},
            "proof": {}
          }
        }
      ]
    },
    "LocalBootstrapPipeV1": {
      "oneOf": [
        {
          "$ref": "#/$defs/LocalBootstrapPipeInitializeV1"
        },
        {
          "$ref": "#/$defs/LocalBootstrapPipeHelloV1"
        },
        {
          "$ref": "#/$defs/LocalBootstrapPipeHelloAcceptedV1"
        },
        {
          "$ref": "#/$defs/LocalBootstrapPipeIssueV1"
        },
        {
          "$ref": "#/$defs/LocalBootstrapPipeRejectV1"
        },
        {
          "$ref": "#/$defs/LocalBootstrapPipeCancelV1"
        },
        {
          "$ref": "#/$defs/LocalBootstrapPipeShutdownV1"
        }
      ]
    },
    "LocalBootstrapCredentialEnvelopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "runId",
        "sequence",
        "exchangeId",
        "issuedAt",
        "expiresAt",
        "profileId",
        "clientClass",
        "sessionId",
        "sessionKind",
        "authorizationGeneration",
        "capability",
        "proof"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-credential-envelope/v1"
        },
        "runId": {
          "$ref": "#/$defs/hex16"
        },
        "sequence": {
          "$ref": "#/$defs/generation"
        },
        "exchangeId": {
          "$ref": "#/$defs/hex16"
        },
        "issuedAt": {
          "$ref": "#/$defs/safeInteger"
        },
        "expiresAt": {
          "$ref": "#/$defs/generation"
        },
        "profileId": {
          "$ref": "#/$defs/boundedId"
        },
        "clientClass": {
          "$ref": "#/$defs/clientClass"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sessionKind": {
          "const": "development-local"
        },
        "authorizationGeneration": {
          "$ref": "#/$defs/generation"
        },
        "capability": {
          "type": "string",
          "maxLength": 108,
          "pattern": "^session\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
        },
        "proof": {
          "$ref": "#/$defs/hex32"
        }
      }
    },
    "LocalBootstrapReadinessV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "runId",
        "mode",
        "bindScope",
        "authentication",
        "directory",
        "storage",
        "artifactCasBarrier",
        "artifactPublication",
        "artifactCasSweeper",
        "artifactAuthority",
        "adminAssets",
        "features"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.readiness/v1"
        },
        "status": {
          "enum": [
            "ready",
            "not-ready"
          ]
        },
        "runId": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(?:[0-9a-f]{32}|production)$"
        },
        "mode": {
          "enum": [
            "development",
            "production"
          ]
        },
        "bindScope": {
          "enum": [
            "loopback",
            "network"
          ],
          "description": "🌐️ Where the hub's socket is bound: loopback, or a network interface (production mode only, behind a TLS-terminating proxy)."
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bootstrapReady",
            "publicSessionIssuance"
          ],
          "properties": {
            "kind": {
              "enum": [
                "local-bootstrap-pipe-v1",
                "identity-assertion-verifier"
              ]
            },
            "bootstrapReady": {
              "type": "boolean"
            },
            "publicSessionIssuance": {
              "type": "boolean",
              "description": "🎫️ Whether this hub also mints sessions from public credentials (POST /auth/sessions). A development hub issues through the pipe alone by default and reports false; an operator who sets OS_HUB_CREDENTIAL_SIGN_IN reports true, and a local run that did not ask for that must still refuse it — see localHubReadinessAdmitted, which compares this against the run's own expectation rather than against a constant."
            }
          }
        },
        "directory": {
          "$ref": "#/$defs/readyComponent"
        },
        "storage": {
          "$ref": "#/$defs/readyComponent"
        },
        "artifactCasBarrier": {
          "$ref": "#/$defs/readyComponent"
        },
        "artifactPublication": {
          "$ref": "#/$defs/readyComponent"
        },
        "artifactCasSweeper": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready",
            "execute",
            "defaultMode"
          ],
          "properties": {
            "ready": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "execute": {
              "type": "boolean",
              "description": "🧹️ Whether swept chunks are deleted (OS_HUB_ARTIFACT_CAS_SWEEP_EXECUTE) rather than only reported."
            },
            "defaultMode": {
              "const": "dry-run"
            }
          }
        },
        "artifactAuthority": {
          "$ref": "#/$defs/readyComponent"
        },
        "adminAssets": {
          "$ref": "#/$defs/readyComponent"
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openPlan",
            "openPlanExchange",
            "rebootstrap",
            "mcpWorkspace",
            "inferenceServices"
          ],
          "properties": {
            "openPlan": {
              "type": "boolean"
            },
            "openPlanExchange": {
              "type": "boolean"
            },
            "rebootstrap": {
              "type": "boolean"
            },
            "mcpWorkspace": {
              "type": "boolean"
            },
            "inferenceServices": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "serviceId",
                  "route"
                ],
                "properties": {
                  "serviceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "route": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "blockedBy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/closedReadinessGate"
          }
        },
        "startup": {
          "$ref": "#/$defs/startupProgress"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          },
          "then": {
            "type": "object",
            "not": {
              "required": [
                "blockedBy"
              ],
              "properties": {
                "blockedBy": true
              }
            },
            "properties": {
              "authentication": {
                "type": "object",
                "properties": {
                  "bootstrapReady": {
                    "const": true
                  }
                }
              },
              "directory": {
                "type": "object",
                "properties": {
                  "ready": {
                    "const": true
                  }
                }
              },
              "storage": {
                "type": "object",
                "properties": {
                  "ready": {
                    "const": true
                  }
                }
              },
              "artifactAuthority": {
                "type": "object",
                "properties": {
                  "ready": {
                    "const": true
                  }
                }
              },
              "adminAssets": {
                "type": "object",
                "properties": {
                  "ready": {
                    "const": true
                  }
                }
              },
              "blockedBy": false,
              "startup": false
            }
          },
          "else": {
            "type": "object",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "authentication": {
                    "type": "object",
                    "properties": {
                      "bootstrapReady": {
                        "const": false
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "directory": {
                    "type": "object",
                    "properties": {
                      "ready": {
                        "const": false
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "storage": {
                    "type": "object",
                    "properties": {
                      "ready": {
                        "const": false
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "artifactAuthority": {
                    "type": "object",
                    "properties": {
                      "ready": {
                        "const": false
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "adminAssets": {
                    "type": "object",
                    "properties": {
                      "ready": {
                        "const": false
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "LocalBootstrapIdleAdmissionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "exchangeDeadlineMs",
        "idleBeforeAdmissionMs",
        "frameHex",
        "payloadHex"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-bootstrap-idle-admission/v1"
        },
        "exchangeDeadlineMs": {
          "const": 15000
        },
        "idleBeforeAdmissionMs": {
          "type": "integer",
          "minimum": 15001,
          "maximum": 60000
        },
        "frameHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{10,32768}$"
        },
        "payloadHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{2,32760}$"
        }
      }
    },
    "LocalSessionBrokerRecordV1": {
      "description": "🎫️ The local session broker record the owner of a loopback development hub writes 0600 into its data root.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "hubOrigin",
        "runId",
        "port",
        "secret",
        "profiles"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-session-broker/v1"
        },
        "hubOrigin": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}$"
        },
        "runId": {
          "$ref": "#/$defs/hex16"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "secret": {
          "$ref": "#/$defs/hex32"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/boundedId"
          }
        }
      }
    },
    "LocalSessionRequestV1": {
      "description": "🎫️ One loopback request for a fresh react-relay session of a declared local profile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-session-request/v1"
        },
        "profileId": {
          "$ref": "#/$defs/boundedId"
        }
      }
    },
    "LocalSessionV1": {
      "description": "🎫️ One issued development session: the react-relay capability and the user it resolves to.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId",
        "token",
        "userId"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.local-session/v1"
        },
        "profileId": {
          "$ref": "#/$defs/boundedId"
        },
        "token": {
          "type": "string",
          "pattern": "^session\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
