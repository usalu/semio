{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/hub/local-credential-envelope-v1.json",
  "title": "LocalCredentialEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "sequence", "exchangeId", "issuedAt", "expiresAt", "profileId", "clientClass", "sessionId", "sessionKind", "authorizationGeneration", "capability", "proof"],
  "properties": {
    "schema": { "const": "semio.hub.local-credential-envelope/v1" },
    "runId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "exchangeId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "issuedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expiresAt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "profileId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" },
    "clientClass": { "enum": ["native", "mcp", "react-relay", "admin-relay"] },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sessionKind": { "const": "development-local" },
    "authorizationGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "capability": { "type": "string", "pattern": "^session\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$", "maxLength": 108 },
    "proof": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
