{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/bootstrap/provenance/cargo/schema.json",
  "$ref": "#/$defs/Seed",
  "$defs": {
    "Seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profileId",
        "generationId",
        "documentId",
        "package",
        "artifact",
        "surfaceId",
        "payload"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.check-in-process-seed/v1"
        },
        "profileId": {
          "const": "gis-map-integration-fixtures"
        },
        "generationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pluginId",
            "packageId",
            "version",
            "componentSha256"
          ],
          "properties": {
            "pluginId": {
              "const": "gis"
            },
            "packageId": {
              "const": "semio:gis"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "componentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "schema",
            "packSchemaHash"
          ],
          "properties": {
            "kind": {
              "const": "s.gis.gismap"
            },
            "schema": {
              "const": "gis.map"
            },
            "packSchemaHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "surfaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "envelopes"
          ],
          "properties": {
            "envelopes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "count",
                "sha256"
              ],
              "properties": {
                "path": {
                  "const": "payload/envelopes.json"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "Envelopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mutationId",
          "dependencies",
          "diffSchema",
          "diff",
          "inverseSchema",
          "inverse"
        ],
        "properties": {
          "mutationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "dependencies": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "diffSchema": {
            "const": "gis.map"
          },
          "diff": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$",
            "maxLength": 1048576
          },
          "inverseSchema": {
            "const": "gis.map"
          },
          "inverse": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$",
            "maxLength": 1048576
          }
        }
      }
    },
    "Policy": {
      "const": {
        "maximumEntries": 8192,
        "maximumDepth": 32,
        "maximumBytes": 67108864,
        "maximumMetadataBytes": 1048576,
        "maximumObservedBytes": 209715200,
        "maximumWork": 524288
      }
    },
    "Use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "enum": [
            "runtime",
            "publication"
          ]
        }
      }
    }
  }
}
