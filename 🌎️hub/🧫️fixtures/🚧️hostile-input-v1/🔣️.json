{
  "schema": "semio.hub.hostile-input/v1",
  "description": "Every hub HTTP/WS route, one concrete request each, and the hostile vectors every route is sent. A route answers every vector with a typed, signed refusal (`x-semio-refusal` + `HubRefusalV1` body when it has none of its own) — a 4xx, or a typed 503 for a subsystem this hub was not configured with — never a 500 and never a dropped connection. `public` routes answer without a credential: a `credential-ignored` route (liveness, readiness, static assets) never reads one, so it may succeed whatever the request carries; a `credential-optional` route serves the anonymous view to a request without one and refuses a forged one `401`, never downgrading it to the anonymous view.",
  "vectors": [
    {
      "name": "unauthenticated",
      "description": "The request with no credential at all."
    },
    {
      "name": "forged-bearer",
      "description": "A syntactically plausible bearer the hub never issued; refused `401` on every route, public ones included, never downgraded to the anonymous view."
    },
    {
      "name": "malformed-json",
      "description": "A body that is not JSON, declared as JSON."
    },
    {
      "name": "wrong-schema",
      "description": "Valid JSON that is not the route's schema."
    },
    {
      "name": "wrong-content-type",
      "description": "The route's body under a content type it does not accept."
    },
    {
      "name": "oversized",
      "description": "A body one mebibyte larger than the largest body any hub route admits (axum's 2 MiB default)."
    },
    {
      "name": "hostile-path",
      "description": "Path segments with traversal, NUL-escape and oversized identifiers."
    },
    {
      "name": "wrong-method",
      "description": "A method the route does not serve."
    }
  ],
