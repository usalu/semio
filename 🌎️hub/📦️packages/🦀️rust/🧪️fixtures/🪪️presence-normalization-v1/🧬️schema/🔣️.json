{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "maximumEntryBytes",
    "vectors"
  ],
  "properties": {
    "schema": {
      "const": "semio.hub.presence-normalization/v1"
    },
    "maximumEntryBytes": {
      "const": 4096
    },
    "vectors": {
      "type": "array",
      "minItems": 12,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "admission",
          "rawPeerHex",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "admission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "actor",
              "connectedAtMs",
              "userId",
              "label",
              "role",
              "color",
              "surface"
            ],
            "properties": {
              "actor": {
                "type": "string",
                "maxLength": 1025
              },
              "connectedAtMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "userId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1025
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1025
              },
              "role": {
                "enum": [
                  "author",
                  "spectator",
                  null
                ]
              },
              "color": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "surface": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1025
              }
            }
          },
          "rawPeerHex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$",
            "maxLength": 16384
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accepted",
              "normalizedPeerHex",
              "durableWrites"
            ],
            "properties": {
              "accepted": {
                "type": "boolean"
              },
              "normalizedPeerHex": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^(?:[0-9a-f]{2})*$",
                "maxLength": 16384
              },
              "durableWrites": {
                "const": 0
              }
            }
          }
        }
      }
    }
  }
}
