{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "vectors", "shortActions", "bindings"],
  "properties": {
    "schema": {
      "const": "semio.hub.admin-directory-authority/v1"
    },
    "vectors": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "transition", "first", "state", "mutated"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "command": {
            "enum": ["create", "rename"]
          },
          "transition": {
            "enum": ["session", "demotion"]
          },
          "first": {
            "enum": ["transition", "command"]
          },
          "state": {
            "enum": ["succeeded", "cancelled"]
          },
          "mutated": {
            "type": "boolean"
          }
        }
      }
    },
    "shortActions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "action", "first", "state", "effect", "secret", "keys"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "action": {
            "enum": ["issue-share", "revoke-share", "revoke-user", "kick"]
          },
          "first": {
            "enum": ["transition", "action"]
          },
          "state": {
            "enum": ["succeeded", "cancelled"]
          },
          "effect": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "keys": {
            "enum": [2, 3, 4]
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "intentJson", "keys"],
        "properties": {
          "name": {
            "enum": ["create", "rename", "visibility", "archive", "delete", "upsert", "remove", "create-invite", "revoke-invite", "issue-share", "revoke-share", "revoke-user", "self-revoke", "kick", "rebuild"]
          },
          "intentJson": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "keys": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(user|session|space|membership|share):.+$"
                }
              }
            ]
          }
        }
      }
    }
  }
}
