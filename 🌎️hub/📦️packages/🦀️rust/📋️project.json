{
  "name": "os-hub",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "namedInputs": {
    "default": ["{workspaceRoot}/🌎️hub/**/*.rs", "{projectRoot}/**/*"]
  },
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts setup"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": ["os-hub-admin"] }],
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "artifact-cas-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts artifact-cas-check",
        "forwardAllArgs": true
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": ["os-hub-admin"] }],
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts dev"
      }
    },
    "secure-local-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": ["os-hub-admin"] }],
      "cache": false,
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts secure-local-smoke"
      }
    }
  }
}
