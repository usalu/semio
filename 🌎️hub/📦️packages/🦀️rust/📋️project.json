{
  "name": "os-hub",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "namedInputs": {
    "default": ["{workspaceRoot}/🌎️hub/**/*.rs", "{projectRoot}/**/*"]
  },
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts setup"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": ["os-hub-admin"] }],
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
