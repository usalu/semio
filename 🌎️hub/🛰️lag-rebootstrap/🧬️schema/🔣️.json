{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/hub/lag-rebootstrap/schema.json",
  "$ref": "#/$defs/CanonicalCheckpointPairSelectionV1",
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scopeText": { "type": "string", "minLength": 1, "maxLength": 256 },
    "safeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },

    "CanonicalCheckpointPairBaselineV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "headEditOrdinal", "headEditId", "lastCommitSeq", "chainHash"],
      "properties": {
        "documentId": { "$ref": "#/$defs/scopeText" },
        "headEditOrdinal": { "$ref": "#/$defs/safeInteger" },
        "headEditId": { "type": "string", "maxLength": 256 },
        "lastCommitSeq": { "$ref": "#/$defs/safeInteger" },
        "chainHash": { "$ref": "#/$defs/hash" }
      }
    },

    "CanonicalCheckpointPairBlobV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "sha256"],
      "properties": {
        "length": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },

    "CanonicalCheckpointPairSelectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId", "documentId", "descriptorDigest", "checkpointId", "baseline"],
      "properties": {
        "spaceId": { "$ref": "#/$defs/scopeText" },
        "documentId": { "$ref": "#/$defs/scopeText" },
        "descriptorDigest": { "$ref": "#/$defs/hash" },
        "checkpointId": { "$ref": "#/$defs/hash" },
        "baseline": { "$ref": "#/$defs/CanonicalCheckpointPairBaselineV1" }
      }
    },

    "CanonicalCheckpointPairLimitsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairBytes", "headerBytes", "recordBytes", "records", "deadlineMs"],
      "properties": {
        "pairBytes": { "const": 67108864 },
        "headerBytes": { "const": 16384 },
        "recordBytes": { "const": 4096 },
        "records": { "const": 16384 },
        "deadlineMs": { "const": 15000 }
      }
    },

    "CanonicalPairPartV1": { "enum": [1, 2] },
    "CanonicalPairTerminalV1": { "enum": [0, 1, 2, 3, 4] },

    "RebootstrapTransferLimitsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closeCode", "closeReason", "scopeMaximumBytes", "inlineMaximumBytes", "chunkMaximumBytes", "totalMaximumBytes", "chunkMaximumCount"],
      "properties": {
        "closeCode": { "const": 1013 },
        "closeReason": { "const": "rebootstrap-required" },
        "scopeMaximumBytes": { "const": 256 },
        "inlineMaximumBytes": { "const": 4096 },
        "chunkMaximumBytes": { "const": 4096 },
        "totalMaximumBytes": { "const": 67108864 },
        "chunkMaximumCount": { "const": 16384 }
      }
    }
  }
}
