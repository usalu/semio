{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "html", "manifest", "entry", "laws"],
  "properties": {
    "version": { "const": 1 },
    "html": { "type": "string", "minLength": 1 },
    "manifest": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "pattern": "^\\./.+\\.tsx$" },
    "laws": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "html-module-entry-exists",
          "package-export-matches-html",
          "entry-contained-by-package",
          "single-canonical-entry"
        ]
      }
    }
  }
}
