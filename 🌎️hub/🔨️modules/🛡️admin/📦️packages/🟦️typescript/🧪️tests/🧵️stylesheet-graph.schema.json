{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stylesheet", "imports", "sources", "shared", "laws"],
  "properties": {
    "version": { "const": 1 },
    "stylesheet": { "type": "string", "const": "🎨️.css" },
    "imports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.\\./" }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "export", "canonical"],
      "properties": {
        "manifest": { "type": "string", "minLength": 1 },
        "export": { "type": "string", "const": "./🎨️.css" },
        "canonical": { "type": "string", "minLength": 1 }
      }
    },
    "laws": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "imports-before-tailwind-sources",
          "repository-imports-resolve",
          "repository-imports-contained",
          "shared-export-is-canonical",
          "no-compatibility-duplicate"
        ]
      }
    }
  }
}
