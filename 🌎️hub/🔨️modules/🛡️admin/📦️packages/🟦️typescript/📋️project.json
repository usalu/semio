{
  "name": "os-hub-admin",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🌎️hub/🔨️modules/🛡️admin/🏗️builder/🌐️vite/🟦️.ts",
      "{workspaceRoot}/🌎️hub/🔨️modules/🛡️admin/🧬️schema/**/*",
      "{workspaceRoot}/🌎️hub/🔨️modules/🛡️admin/🧱️elements/**/*"
    , "{workspaceRoot}/🌎️hub/🔨️modules/🛡️admin/🧪️tests/🎚️config/🟦️.ts"]
  },
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🌎️hub/🔨️modules/🛡️admin/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts dev",
        "forwardAllArgs": true
      },
      "cache": false,
      "continuous": true
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🌎️hub/🔨️modules/🛡️admin/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/📤️dist"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🌎️hub/🔨️modules/🛡️admin/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
