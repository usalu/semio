{
  "name": "os-hub-admin",
  "$schema": "../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "application",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🌎️hub/🔨️modules/🛡️admin/🏗️builder/🌐️vite/🟦️.ts",
      "{workspaceRoot}/🌎️hub/🔨️modules/🛡️admin/🧬️schema/**/*",
      "{workspaceRoot}/🌎️hub/🔨️modules/🛡️admin/🧱️elements/**/*",
      "{workspaceRoot}/🌎️hub/🔨️modules/🛡️admin/🧪️tests/🎚️config/🟦️.ts"
    ]
  },
  "targets": {
    "dev": {
      "metadata": {
        "semio": {
          "dashboard": {
            "ready": {
              "port": 8790,
              "portEnv": "OS_HUB_ADMIN_DEV_PORT"
            },
            "requires": [
              "os-hub:dev"
            ]
          }
        }
      },
      "executor": "repo:script",
      "dependsOn": [],
      "options": {
        "cwd": "🌎️hub/🔨️modules/🛡️admin/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts dev",
        "forwardAllArgs": true
      },
      "cache": false,
      "continuous": true
    },
    "build": {
      "executor": "repo:script",
      "dependsOn": [],
      "options": {
        "cwd": "🌎️hub/🔨️modules/🛡️admin/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/📤️dist/{options.env.SEMIO_BUILD_MODE}"
      ]
    },
    "test": {
      "executor": "repo:script",
      "dependsOn": [],
      "options": {
        "cwd": "🌎️hub/🔨️modules/🛡️admin/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
