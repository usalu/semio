{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/hub/admin/schema.json",
  "$ref": "#/$defs/AdminEntryGraphV1",
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 512 },

    "AdminEntryGraphV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "html", "manifest", "entry", "laws"],
      "properties": {
        "version": { "const": 1 },
        "html": { "$ref": "#/$defs/relativePath" },
        "manifest": { "$ref": "#/$defs/relativePath" },
        "entry": { "type": "string", "maxLength": 512, "pattern": "^\\./.+\\.tsx$" },
        "laws": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "html-module-entry-exists",
              "package-export-matches-html",
              "entry-contained-by-package",
              "single-canonical-entry"
            ]
          }
        }
      }
    },

    "AdminStylesheetGraphV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "stylesheet", "imports", "sources", "shared", "laws"],
      "properties": {
        "version": { "const": 1 },
        "stylesheet": { "const": "🎨️.css" },
        "imports": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "maxLength": 512, "pattern": "^\\.\\./" } },
        "sources": { "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "shared": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "export", "canonical"],
          "properties": {
            "manifest": { "$ref": "#/$defs/relativePath" },
            "export": { "const": "./🧵️.css" },
            "canonical": { "$ref": "#/$defs/relativePath" }
          }
        },
        "laws": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "imports-before-tailwind-sources",
              "repository-imports-resolve",
              "repository-imports-contained",
              "shared-export-is-canonical",
              "no-compatibility-duplicate"
            ]
          }
        }
      }
    }
  }
}
