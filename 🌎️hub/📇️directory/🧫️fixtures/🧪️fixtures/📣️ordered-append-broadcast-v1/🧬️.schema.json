{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maximumEventsPerDecision", "cases"],
  "properties": {
    "schema": { "const": "semio.hub.directory.ordered-append-broadcast/v1" },
    "maximumEventsPerDecision": { "const": 2 },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "persistedSequences", "appendSucceeds", "expectedBroadcastSequences"],
        "properties": {
          "id": {
            "enum": [
              "concurrent-single-events",
              "paired-user-member-events",
              "append-failure",
              "empty-idempotent-decision"
            ]
          },
          "persistedSequences": {
            "type": "array",
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          },
          "appendSucceeds": { "type": "boolean" },
          "expectedBroadcastSequences": {
            "type": "array",
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      }
    }
  }
}
