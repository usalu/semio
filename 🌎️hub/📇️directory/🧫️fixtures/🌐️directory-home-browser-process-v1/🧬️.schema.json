{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.hub.directory-home-browser-process-fixture/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "limits", "profiles", "home", "pages", "traces", "hostile"],
  "properties": {
    "schema": { "const": "semio.hub.directory-home-browser-process-fixture/v1" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journeyMs", "stepMs", "responseBytes", "appliedEvents"],
      "properties": {
        "journeyMs": { "type": "integer", "minimum": 30000, "maximum": 180000 },
        "stepMs": { "type": "integer", "minimum": 1000, "maximum": 15000 },
        "responseBytes": { "const": 65536 },
        "appliedEvents": { "type": "integer", "minimum": 8, "maximum": 512 }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b"],
      "properties": {
        "a": { "$ref": "#/$defs/profile" },
        "b": { "$ref": "#/$defs/profile" }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "appId", "actionId", "moduleDirectory"],
      "properties": {
        "pluginId": { "const": "s" },
        "appId": { "const": "s.home@1/*#editor" },
        "actionId": { "const": "applyDirectoryEventPage" },
        "moduleDirectory": { "const": "🪐️s" }
      }
    },
    "pages": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": { "$ref": "#/$defs/page" }
    },
    "traces": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/trace" }
    },
    "hostile": {
      "type": "array",
      "minItems": 8,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mutation"],
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "mutation": { "enum": ["epoch", "binding", "generation", "through", "receipt", "duplicate-event", "socket-before-ack", "late-after-close"] }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safe": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "subject", "displayName"],
      "properties": {
        "profileId": { "$ref": "#/$defs/text" },
        "subject": { "$ref": "#/$defs/text" },
        "displayName": { "$ref": "#/$defs/text" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "binding", "generation", "after", "through", "hasMore", "receipt", "eventIds"],
      "properties": {
        "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "binding": { "$ref": "#/$defs/digest" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "after": { "$ref": "#/$defs/safe" },
        "through": { "$ref": "#/$defs/safe" },
        "hasMore": { "type": "boolean" },
        "receipt": { "$ref": "#/$defs/digest" },
        "eventIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "step": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "page"], "properties": { "kind": { "const": "present" }, "page": { "$ref": "#/$defs/text" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "page"], "properties": { "kind": { "const": "ack" }, "page": { "$ref": "#/$defs/text" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "page"], "properties": { "kind": { "const": "reject" }, "page": { "$ref": "#/$defs/text" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["wake", "close"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "since"], "properties": { "kind": { "const": "dial" }, "since": { "$ref": "#/$defs/safe" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "epoch"], "properties": { "kind": { "const": "rebootstrap" }, "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } } }
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps", "expected"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/step" } },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["epoch", "frontier", "phase", "appliedEventIds", "dials", "retries", "denials"],
          "properties": {
            "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "frontier": { "$ref": "#/$defs/safe" },
            "phase": { "enum": ["fetching", "awaiting-ack", "live", "closed"] },
            "appliedEventIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
            "dials": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/safe" } },
            "retries": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/safe" } },
            "denials": { "type": "integer", "minimum": 0, "maximum": 16 }
          }
        }
      }
    }
  }
}
