{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "bindings", "capacity", "inviteScopes"],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revocation", "events", "status", "appended"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revocation": {
            "enum": ["demote", "remove", "session"]
          },
          "events": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": ["authorize", "revoke", "fence"]
            }
          },
          "status": {
            "enum": [202, 401, 403]
          },
          "appended": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "audience", "user", "space", "invalidated"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "enum": ["document", "scoped", "global"]
          },
          "user": {
            "enum": ["author", "owner"]
          },
          "space": {
            "enum": ["changed", "other"]
          },
          "invalidated": {
            "type": "boolean"
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjects", "subjectLimit", "ledgerLimit", "accepted"],
      "properties": {
        "subjects": {
          "const": 65
        },
        "subjectLimit": {
          "const": 64
        },
        "ledgerLimit": {
          "const": 4096
        },
        "accepted": {
          "const": 65
        }
      }
    },
    "inviteScopes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "commandSpace", "inviteSpace", "status", "revoked", "accepted"],
        "properties": {
          "id": {
            "enum": ["foreign-invite", "foreign-accepted-invite", "owned-invite", "owned-accepted-invite"]
          },
          "commandSpace": {
            "enum": ["owned", "foreign"]
          },
          "inviteSpace": {
            "const": "foreign"
          },
          "status": {
            "enum": [404, 202, 409]
          },
          "revoked": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
