{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/hub/local-bootstrap-pipe-v1.json",
  "title": "LocalBootstrapPipeV1",
  "oneOf": [
    { "$ref": "#/$defs/Initialize" },
    { "$ref": "#/$defs/Hello" },
    { "$ref": "#/$defs/HelloAccepted" },
    { "$ref": "#/$defs/Issue" },
    { "$ref": "#/$defs/Reject" },
    { "$ref": "#/$defs/Cancel" },
    { "$ref": "#/$defs/Shutdown" }
  ],
  "$defs": {
    "Hex16": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "Hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "BoundedId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" },
    "ClientClass": { "enum": ["native", "mcp", "react-relay", "admin-relay"] },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "subject", "displayName", "allowedClientClasses"],
      "properties": {
        "profileId": { "$ref": "#/$defs/BoundedId" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "allowedClientClasses": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/ClientClass" } }
      }
    },
    "Initialize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "runId", "channelKey", "profiles"],
      "properties": {
        "schema": { "const": "semio.hub.local-bootstrap/v1" },
        "kind": { "const": "initialize" },
        "runId": { "$ref": "#/$defs/Hex16" },
        "channelKey": { "$ref": "#/$defs/Hex32" },
        "profiles": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/Profile" } }
      }
    },
    "Authenticated": {
      "type": "object",
      "required": ["schema", "runId", "sequence", "exchangeId", "issuedAt", "expiresAt", "proof"],
      "properties": {
        "schema": { "const": "semio.hub.local-bootstrap/v1" },
        "runId": { "$ref": "#/$defs/Hex16" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "exchangeId": { "$ref": "#/$defs/Hex16" },
        "issuedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expiresAt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "proof": { "$ref": "#/$defs/Hex32" }
      }
    },
    "Hello": {
      "allOf": [
        { "$ref": "#/$defs/Authenticated" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "kind", "runId", "sequence", "exchangeId", "issuedAt", "expiresAt", "launcherNonce", "proof"],
          "properties": {
            "schema": {}, "kind": { "const": "hello" }, "runId": {}, "sequence": {}, "exchangeId": {}, "issuedAt": {}, "expiresAt": {},
            "launcherNonce": { "$ref": "#/$defs/Hex32" }, "proof": {}
          }
        }
      ]
    },
    "HelloAccepted": {
      "allOf": [
        { "$ref": "#/$defs/Authenticated" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "kind", "runId", "sequence", "exchangeId", "issuedAt", "expiresAt", "hubNonce", "proof"],
          "properties": {
            "schema": {}, "kind": { "const": "hello-accepted" }, "runId": {}, "sequence": {}, "exchangeId": {}, "issuedAt": {}, "expiresAt": {},
            "hubNonce": { "$ref": "#/$defs/Hex32" }, "proof": {}
          }
        }
      ]
    },
    "Issue": {
      "allOf": [
        { "$ref": "#/$defs/Authenticated" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "kind", "runId", "sequence", "exchangeId", "issuedAt", "expiresAt", "profileId", "deviceInstanceId", "clientClass", "proof"],
          "properties": {
            "schema": {}, "kind": { "const": "issue" }, "runId": {}, "sequence": {}, "exchangeId": {}, "issuedAt": {}, "expiresAt": {},
            "profileId": { "$ref": "#/$defs/BoundedId" },
            "deviceInstanceId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "clientClass": { "$ref": "#/$defs/ClientClass" }, "proof": {}
          }
        }
      ]
    },
    "Reject": {
      "allOf": [
        { "$ref": "#/$defs/Authenticated" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "kind", "runId", "sequence", "exchangeId", "issuedAt", "expiresAt", "code", "proof"],
          "properties": {
            "schema": {}, "kind": { "const": "reject" }, "runId": {}, "sequence": {}, "exchangeId": {}, "issuedAt": {}, "expiresAt": {},
            "code": { "enum": ["cancelled", "denied", "expired", "resource-limit", "unavailable"] }, "proof": {}
          }
        }
      ]
    },
    "Cancel": {
      "allOf": [
        { "$ref": "#/$defs/Authenticated" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "kind", "runId", "sequence", "exchangeId", "issuedAt", "expiresAt", "proof"],
          "properties": { "schema": {}, "kind": { "const": "cancel" }, "runId": {}, "sequence": {}, "exchangeId": {}, "issuedAt": {}, "expiresAt": {}, "proof": {} }
        }
      ]
    },
    "Shutdown": {
      "allOf": [
        { "$ref": "#/$defs/Authenticated" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "kind", "runId", "sequence", "exchangeId", "issuedAt", "expiresAt", "proof"],
          "properties": { "schema": {}, "kind": { "const": "shutdown" }, "runId": {}, "sequence": {}, "exchangeId": {}, "issuedAt": {}, "expiresAt": {}, "proof": {} }
        }
      ]
    }
  }
}
