{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/compositions/gis/schema.json",
  "$defs": {
    "GisInferenceControlFeatures": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    "GisComponentColdMapPatchPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lon",
        "lat"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "GisNativeCodecsReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factoryId",
        "kind",
        "schema",
        "extension",
        "capability",
        "packRecord",
        "protocolPath",
        "protocolBytes",
        "protocolSha256",
        "packSchemaHash"
      ],
      "properties": {
        "factoryId": {
          "enum": [
            "gis.gismap.v1",
            "gis.gisterrain.v1"
          ]
        },
        "kind": {
          "enum": [
            "s.gis.gismap",
            "s.gis.gisterrain"
          ]
        },
        "schema": {
          "enum": [
            "gis.map",
            "gis.terrain"
          ]
        },
        "extension": {
          "enum": [
            "gismap",
            "gisterrain"
          ]
        },
        "capability": {
          "enum": [
            "s.gis.gismap.codec.document",
            "s.gis.gisterrain.codec.document"
          ]
        },
        "packRecord": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keyword",
            "fields"
          ],
          "properties": {
            "keyword": {
              "enum": [
                "gismap",
                "gisterrain"
              ]
            },
            "fields": {
              "type": "array",
              "minItems": 3,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/GisNativeCodecsField"
              }
            }
          }
        },
        "protocolPath": {
          "enum": [
            "✏️s/🔌️plugins/🌍️gis/🗿️artifacts/🗺️gismap/🏅️standards/🔖️1/🪆️subsets/✳️any/🚪️io/💾️binary/📸️snapshot/📡️.protocol.semio",
            "✏️s/🔌️plugins/🌍️gis/🗿️artifacts/🏔️gisterrain/🏅️standards/🔖️1/🪆️subsets/✳️any/🚪️io/💾️binary/📸️snapshot/📡️.protocol.semio"
          ]
        },
        "protocolBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "protocolSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packSchemaHash": {
          "type": "string",
          "pattern": "^(?!0{64}$)[a-f0-9]{64}$",
          "description": "🧬️ The codec's structural pack-schema fingerprint (`os_pack::schema_hash`), generated from the live Rust receipt by the gis `native-codec-projection` verb; the trusted-catalog bootstrap reads it verbatim."
        }
      }
    },
    "GisNativeCodecsField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "optional"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "key": {
          "enum": [
            "positions",
            "routes",
            "regions",
            "drawing",
            "image",
            "value",
            "exaggeration",
            "importedFeaturesJson",
            "mesh"
          ]
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "GisNativeCodecManifestV1": {
      "type": "object",
      "additionalProperties": false,
      "title": "GisNativeCodecs",
      "description": "🌍️ The native-openable codec receipt projection GIS publishes to the hub: provider identity plus one receipt per artifact codec.",
      "required": [
        "schema",
        "pluginId",
        "packageId",
        "packageVersion",
        "receipts"
      ],
      "properties": {
        "schema": {
          "const": "semio.gis.native-codec-receipts/v1"
        },
        "pluginId": {
          "const": "gis"
        },
        "packageId": {
          "const": "semio:gis"
        },
        "packageVersion": {
          "const": "0.1.0"
        },
        "receipts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/GisNativeCodecsReceipt"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/GisNativeCodecManifestV1"
}
