{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "core",
    "host",
    "hub",
    "owner",
    "lowerRust",
    "lowerTypescript",
    "examples",
    "originalInputs",
    "modified",
    "retired",
    "nativeProjects",
    "transformations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number"
    },
    "core": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "hub": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "lowerRust": {
      "type": "string"
    },
    "lowerTypescript": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "package",
          "library",
          "snapshot",
          "owner",
          "example",
          "exampleSha256",
          "asset",
          "assetSha256",
          "assetBytes",
          "expected",
          "format",
          "codec"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "library": {
            "type": "string"
          },
          "snapshot": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "example": {
            "type": "string"
          },
          "exampleSha256": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "assetSha256": {
            "type": "string"
          },
          "assetBytes": {
            "type": "number"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "id"
            ],
            "properties": {
              "schema": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            }
          },
          "format": {
            "type": "string"
          },
          "codec": {
            "type": "string"
          }
        }
      }
    },
    "originalInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "modified": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "original"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "original": {
            "type": "string"
          }
        }
      }
    },
    "retired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nativeProjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "previous",
          "current"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "previous": {
            "type": "string"
          },
          "current": {
            "type": "string"
          }
        }
      }
    }
  }
}
