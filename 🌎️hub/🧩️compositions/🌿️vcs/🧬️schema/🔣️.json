{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/compositions/vcs/schema.json",
  "$defs": {
    "VcsNativeOpenableIdentityAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "packageId",
        "artifactKind",
        "artifactSchema",
        "dialectKind",
        "standard",
        "subset",
        "viewerApp",
        "editorApp",
        "execution",
        "viewerWindowKindId",
        "rendererTarget"
      ],
      "properties": {
        "pluginId": {
          "const": "vcs"
        },
        "packageId": {
          "const": "semio:vcs"
        },
        "artifactKind": {
          "const": "s.vcs.vcs"
        },
        "artifactSchema": {
          "const": "vcs.vcs"
        },
        "dialectKind": {
          "const": "s.vcs.vcs"
        },
        "standard": {
          "const": "1"
        },
        "subset": {
          "const": "*"
        },
        "viewerApp": {
          "const": "s.vcs.vcs@1/*#viewer"
        },
        "editorApp": {
          "const": "s.vcs.vcs@1/*#editor"
        },
        "viewerWindowKindId": {
          "const": "framework.window.tree"
        },
        "rendererTarget": {
          "const": "wasm"
        },
        "execution": {
          "const": "isolated"
        }
      }
    },
    "VcsNativeCodecsReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factoryId",
        "kind",
        "schema",
        "extension",
        "capability",
        "protocolPath",
        "protocolBytes",
        "protocolSha256"
      ],
      "properties": {
        "factoryId": {
          "const": "vcs.vcs.v1"
        },
        "kind": {
          "const": "s.vcs.vcs"
        },
        "schema": {
          "const": "vcs.vcs"
        },
        "extension": {
          "const": "vcs"
        },
        "capability": {
          "const": "s.vcs.vcs.codec.document"
        },
        "protocolPath": {
          "const": "✏️s/🔌️plugins/🌿️vcs/🗿️artifacts/🌿️vcs/🏅️standards/🔖️1/🪆️subsets/✳️any/🚪️io/💾️binary/📸️snapshot/📡️.protocol.semio"
        },
        "protocolBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "protocolSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "VcsNativeCodecManifestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "pluginId",
        "packageId",
        "packageVersion",
        "receipts"
      ],
      "properties": {
        "schema": {
          "const": "semio.vcs.native-codec-receipts/v1"
        },
        "pluginId": {
          "const": "vcs"
        },
        "packageId": {
          "const": "semio:vcs"
        },
        "packageVersion": {
          "const": "0.1.0"
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/VcsNativeCodecsReceipt"
          }
        }
      },
      "title": "VcsNativeCodecManifestV1",
      "description": "🌿️ The native-openable codec receipt projection VCS publishes to the hub: provider identity plus one receipt per artifact codec."
    }
  },
  "$ref": "#/$defs/VcsNativeCodecManifestV1"
}
