{
  "name": "@semio-tech/hub-compositions",
  "$schema": "../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "targets": {
    "ownership": {
      "executor": "repo:script",
      "options": {
        "cwd": "🌎️hub/🧩️compositions",
        "command": "repo ./📜️script.ts ownership"
      },
      "cache": true,
      "outputs": []
    },
    "native": {
      "executor": "repo:script",
      "options": {
        "cwd": "🌎️hub/🧩️compositions",
        "command": "repo ./📜️script.ts native",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "rustWorkspace"
      ]
    },
    "typescript": {
      "executor": "repo:script",
      "options": {
        "cwd": "🌎️hub/🧩️compositions",
        "command": "repo ./📜️script.ts typescript"
      },
      "cache": true,
      "outputs": []
    }
  },
  "namedInputs": {
    "rustWorkspace": [
      "sharedGlobals",
      "{workspaceRoot}/**/*.rs",
      "{workspaceRoot}/**/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      {
        "env": "RUSTUP_TOOLCHAIN"
      },
      {
        "env": "RUSTFLAGS"
      },
      {
        "env": "CARGO_ENCODED_RUSTFLAGS"
      },
      {
        "env": "CARGO_BUILD_TARGET"
      },
      {
        "env": "SEMIO_TEST_LEVEL"
      },
      {
        "env": "SEMIO_TEST_BUDGET_MS"
      },
      {
        "env": "SEMIO_BUILD_BUDGET_MS"
      }
    ]
  }
}
