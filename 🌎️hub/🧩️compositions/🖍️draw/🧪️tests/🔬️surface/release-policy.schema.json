{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maximumExportBytes",
    "vectors"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "callerBytes",
          "requestedBytes",
          "admitted"
        ],
        "properties": {
          "phase": {
            "enum": [
              "close",
              "maintenance",
              "preparation"
            ]
          },
          "admitted": {
            "type": "boolean"
          },
          "callerBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "requestedBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        }
      }
    },
    "maximumExportBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    }
  }
}
