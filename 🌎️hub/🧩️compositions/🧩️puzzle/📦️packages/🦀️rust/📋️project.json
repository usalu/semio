{
  "name": "@semio-tech/puzzle-plugin",
  "$schema": "../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🌎️hub/🧩️compositions/🧩️puzzle/**/*.rs",
      "{projectRoot}/**/*",
      "nativeAssets"
    ],
    "nativeAssets": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/🌱️metabolism/🔣️icons/**/*.svg",
      "!{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/🌱️metabolism/🔣️icons/🤖️generated/**/*.svg"
    ],
    "nativeSources": [
      "nativeAssets",
      "{workspaceRoot}/🌎️hub/🧩️compositions/🧩️puzzle/🧩️component/**/*"
    ],
    "nativeTestSources": [
      "nativeAssets"
    ]
  },
  "targets": {
    "wasm": {
      "executor": "repo:script",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts wasm"
      },
      "outputs": [
        "{projectRoot}/pkg"
      ],
      "cache": true
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "fixtures-lint": {
      "executor": "repo:script",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts fixtures lint",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "canonical-architecture": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts canonical-architecture"
      }
    }
  }
}
