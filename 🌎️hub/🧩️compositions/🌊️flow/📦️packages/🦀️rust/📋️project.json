{
  "name": "@semio-tech/flow-plugin",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🌎️hub/🧩️compositions/🌊️flow/**/*.rs",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "add-widget-retained-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts add-widget-retained-check",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "child-edit-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts child-edit-check",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "child-identity-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts child-identity-check",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "test-source": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-source",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "graph-generate"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "graph-generate"
      ]
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "graph-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts graph-generate"
      },
      "inputs": [
        "{workspaceRoot}/✏️s/🔌️plugins/🌊️flow/**/*manifest.json",
        "{workspaceRoot}/🧰️framework/🔨️modules/🕸️graph/🛂️manifest/**/*",
        "{projectRoot}/../../🛂️manifest/📇️outputs.json",
        "{projectRoot}/📜️script.ts",
        "{projectRoot}/📋️project.json",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔍️discovery/🟦️.ts",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔣️taxonomy.json"
      ],
      "outputs": [
        "{projectRoot}/../../🤖️generated"
      ]
    },
    "graph-wire-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "graph-generate"
      ],
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🌊️flow/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts graph-wire-check"
      },
      "outputs": []
    }
  }
}
