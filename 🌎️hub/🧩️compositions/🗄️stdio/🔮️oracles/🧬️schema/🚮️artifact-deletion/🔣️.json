{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/stdio/oracles/deletion/schema.json",
  "$ref": "#/$defs/DeletionContract",
  "$defs": {
    "Path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "Vector": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "retainedOwner", "adapter", "removedOwner", "requiredScenarios", "role", "implementation", "execution", "features"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "retainedOwner": { "$ref": "#/$defs/Path" }, "adapter": { "$ref": "#/$defs/Path" }, "removedOwner": { "$ref": "#/$defs/Path" },
        "requiredScenarios": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "role": { "const": "oracle" }, "implementation": { "const": "rust" }, "execution": { "const": "all-original-scenarios" }, "features": { "const": ["oracles"] }
      }
    },
    "Plugin": {
      "type": "object", "additionalProperties": false, "required": ["owner", "manifest", "removedOwner", "testTargets", "nativeRequired"],
      "properties": { "owner": { "$ref": "#/$defs/Path" }, "manifest": { "$ref": "#/$defs/Path" }, "removedOwner": { "$ref": "#/$defs/Path" }, "testTargets": { "const": ["lib", "authored_assembly"] }, "nativeRequired": { "const": true } }
    },
    "DeletionContract": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "vectors", "lowerPlugin"],
      "properties": { "schemaVersion": { "const": 1 }, "vectors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Vector" } }, "lowerPlugin": { "$ref": "#/$defs/Plugin" } }
    }
  }
}
