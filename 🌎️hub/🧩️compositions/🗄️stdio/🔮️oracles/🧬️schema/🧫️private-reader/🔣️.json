{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/test/private-reader-caller-preservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "helper",
          "helperSha256",
          "originalSource",
          "originalRegion",
          "currentRegion",
          "importAnchor",
          "originalImport",
          "frozenCallerSha256",
          "inputs",
          "vectors"
        ],
        "properties": {
          "id": {
            "const": "home-editor-transient-vectors"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "helper": {
            "type": "string",
            "minLength": 1
          },
          "helperSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "originalSource": {
            "type": "string",
            "minLength": 1
          },
          "originalRegion": {
            "type": "string",
            "minLength": 1
          },
          "currentRegion": {
            "type": "string",
            "minLength": 1
          },
          "importAnchor": {
            "type": "string",
            "minLength": 1
          },
          "originalImport": {
            "type": "string",
            "minLength": 1
          },
          "frozenCallerSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "inputs": {
            "type": "array",
            "minItems": 15,
            "maxItems": 15,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "include",
                "path",
                "currentSha256"
              ],
              "properties": {
                "include": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "currentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "vectors": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "observable"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "observable": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
