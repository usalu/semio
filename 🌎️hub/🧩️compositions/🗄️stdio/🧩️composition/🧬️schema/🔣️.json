{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/compositions/stdio/composition/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owners"
  ],
  "properties": {
    "schema": {
      "const": "semio.stdio.composition-owners/v1"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "root",
          "enum",
          "label",
          "main",
          "shards"
        ],
        "if": {
          "properties": { "main": { "const": true } }
        },
        "then": {
          "required": ["appLibraries"],
          "properties": { "shards": { "maxItems": 0 } }
        },
        "else": {
          "not": { "required": ["appLibraries"] }
        },
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "root": {
            "type": "string",
            "pattern": "^[^./][^\\\\]*\\/🦀️\\.rs$"
          },
          "enum": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "main": {
            "type": "boolean"
          },
          "appLibraries": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/appPartition" }
          },
          "shards": {
            "type": "array",
            "items": { "$ref": "#/definitions/appPartition" }
          }
        }
      }
    }
  },
  "definitions": {
    "appPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "enum", "variants"],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^[^./][^\\\\]*\\/🦀️\\.rs$"
        },
        "enum": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    }
  }
}
