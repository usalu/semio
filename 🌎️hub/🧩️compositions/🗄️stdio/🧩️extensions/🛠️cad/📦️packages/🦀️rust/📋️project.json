{
  "name": "@semio-tech/stdio-cad-plugin",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🌎️hub/🧩️compositions/🗄️stdio/🧩️extensions/🛠️cad/**/*.rs",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🗄️stdio/🧩️extensions/🛠️cad/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🗄️stdio/🧩️extensions/🛠️cad/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🗄️stdio/🧩️extensions/🛠️cad/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🌎️hub/🧩️compositions/🗄️stdio/🧩️extensions/🛠️cad/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      }
    }
  }
}
