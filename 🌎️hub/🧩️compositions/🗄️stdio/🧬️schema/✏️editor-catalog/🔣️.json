{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.stdio.editor-catalog.acceptance.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "editorCount",
    "formatCount",
    "detailsWindow",
    "actions",
    "rejectedActions",
    "snapshotEdits",
    "editorApps",
    "deployedComponents"
  ],
  "properties": {
    "formatCount": {
      "type": "integer",
      "minimum": 1
    },
    "editorCount": {
      "type": "integer",
      "minimum": 1
    },
    "detailsWindow": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "arguments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          }
        }
      }
    },
    "rejectedActions": {
      "$ref": "#/properties/actions"
    },
    "snapshotEdits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        }
      }
    },
    "editorApps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^s\\.stdio\\..+#editor$"
      }
    },
    "deployedComponents": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "path",
          "role",
          "componentKind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^stdio(?:-[a-z]+)?$"
          },
          "package": {
            "type": "string",
            "pattern": "^semio-hub-stdio(?:-[a-z]+)?$"
          },
          "path": {
            "type": "string",
            "pattern": "^🌎️hub/🧩️compositions/🗄️stdio/.+Cargo\\.toml$"
          },
          "role": {
            "const": "hub"
          },
          "componentKind": {
            "const": "plugin"
          }
        }
      }
    }
  }
}
