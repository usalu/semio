{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/schema.json",
  "$defs": {
    "StdioDwgArtifactOwnership": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^✏️s/🔌️plugins/[^/]+/🗿️artifacts/🖊️dwg(?:/|$)"
        },
        {
          "pattern": "^✏️s/🔌️plugins/[^/]+/🗿️artifacts/[^/]+(?:/[^/]+)*/🚪️io(?:/|$)"
        }
      ],
      "title": "StdioDwgArtifactOwnership"
    },
    "StdioArtifactPackagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "StdioArtifactPackageIdentity": {
      "type": "string",
      "pattern": "^s\\.stdio\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "StdioArtifactPackageRust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargoName",
        "nxName",
        "manifest"
      ],
      "properties": {
        "cargoName": {
          "type": "string",
          "pattern": "^semio-s-artifact-stdio-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "nxName": {
          "type": "string",
          "pattern": "^@semio-tech/stdio-[a-z0-9]+(?:-[a-z0-9]+)*-rs$"
        },
        "manifest": {
          "$ref": "#/$defs/StdioArtifactPackagePath"
        }
      }
    },
    "StdioArtifactPackageTypescript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "nxName",
        "manifest",
        "entry"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^@semio-tech/stdio-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "nxName": {
          "type": "string",
          "pattern": "^@semio-tech/stdio-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "manifest": {
          "$ref": "#/$defs/StdioArtifactPackagePath"
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "types",
            "import"
          ],
          "properties": {
            "types": {
              "const": "./dist/🟦️.d.ts"
            },
            "import": {
              "const": "./dist/🟦️.js"
            }
          }
        }
      }
    },
    "StdioArtifactPackagePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "directory",
        "identity",
        "source",
        "dependencies",
        "rust",
        "typescript"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "directory": {
          "type": "string",
          "minLength": 2,
          "pattern": "^[^/\\\\]+$"
        },
        "identity": {
          "$ref": "#/$defs/StdioArtifactPackageIdentity"
        },
        "source": {
          "$ref": "#/$defs/StdioArtifactPackagePath"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/StdioArtifactPackageIdentity"
          }
        },
        "rust": {
          "$ref": "#/$defs/StdioArtifactPackageRust"
        },
        "typescript": {
          "$ref": "#/$defs/StdioArtifactPackageTypescript"
        }
      }
    },
    "StdioArtifactPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packages"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/StdioArtifactPackagePackage"
          }
        }
      },
      "title": "StdioArtifactPackage",
      "description": "🗄️ One stdio artifact package definition row: identity, directory, Rust package, nx project and declared dependencies."
    }
  }
}
