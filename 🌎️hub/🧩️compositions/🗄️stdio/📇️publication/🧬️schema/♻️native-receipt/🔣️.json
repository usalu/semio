{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "artifactSchema",
    "factoryId",
    "extension",
    "packSchemaHash",
    "protocolSourceSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactKind": {
      "type": "string",
      "minLength": 1
    },
    "artifactSchema": {
      "type": "string",
      "minLength": 1
    },
    "factoryId": {
      "type": "string",
      "minLength": 1
    },
    "extension": {
      "type": "string",
      "minLength": 1
    },
    "packSchemaHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocolSourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
