{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://plugin-catalog/trusted-stdio-catalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "expectedPublication",
    "expectedHubBundle",
    "hostile",
    "structuralCodec",
    "multipleStandards",
    "selections"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "expectedPublication": {
      "const": "committed"
    },
    "expectedHubBundle": {
      "const": "withheld"
    },
    "hostile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digestMismatch",
        "missingProtocol",
        "identityMismatch",
        "missingDefinition"
      ],
      "properties": {
        "digestMismatch": {
          "type": "string",
          "minLength": 1
        },
        "missingProtocol": {
          "type": "string",
          "minLength": 1
        },
        "identityMismatch": {
          "type": "string",
          "minLength": 1
        },
        "missingDefinition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "structuralCodec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "packSchemaHash",
        "protocolSourceSha256"
      ],
      "properties": {
        "artifactKind": {
          "const": "s.stdio.las"
        },
        "packSchemaHash": {
          "$ref": "#/$defs/digest"
        },
        "protocolSourceSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "multipleStandards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "artifactSchemas",
        "factoryIds"
      ],
      "properties": {
        "artifactKind": {
          "type": "string"
        },
        "artifactSchemas": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "factoryIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "selections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "excludedKinds",
          "expectedOpenTargetCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "excludedKinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedCodecCount": {
            "type": "integer",
            "minimum": 0
          },
          "expectedOpenTargetCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "codec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "artifactSchema",
        "packSchemaHash",
        "factoryId",
        "extension",
        "protocolSourceSha256"
      ],
      "properties": {
        "artifactKind": {
          "$ref": "#/$defs/identity"
        },
        "artifactSchema": {
          "$ref": "#/$defs/identity"
        },
        "packSchemaHash": {
          "$ref": "#/$defs/digest"
        },
        "factoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "extension": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9]+$"
        },
        "protocolSourceSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "openTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "artifactSchema",
        "packSchemaHash",
        "role",
        "surfaceId",
        "factoryId",
        "extension",
        "protocolSourceSha256"
      ],
      "properties": {
        "artifactKind": {
          "$ref": "#/$defs/identity"
        },
        "artifactSchema": {
          "$ref": "#/$defs/identity"
        },
        "packSchemaHash": {
          "$ref": "#/$defs/digest"
        },
        "role": {
          "const": "editor"
        },
        "surfaceId": {
          "$ref": "#/$defs/identity"
        },
        "factoryId": {
          "$ref": "#/$defs/identity"
        },
        "extension": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z0-9]+$"
        },
        "protocolSourceSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "componentAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "limitBytes"
      ],
      "properties": {
        "status": {
          "enum": [
            "admitted",
            "exceeds-limit",
            "absent"
          ]
        },
        "limitBytes": {
          "type": "integer",
          "minimum": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "TrustedStdioCatalogV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "pluginId",
        "packageId",
        "version",
        "nativeCodecs",
        "openTargets",
        "publication",
        "hubBundle",
        "componentAdmission"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "pluginId": {
          "const": "stdio"
        },
        "packageId": {
          "const": "semio:stdio"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "nativeCodecs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/codec"
          }
        },
        "openTargets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/openTarget"
          }
        },
        "publication": {
          "enum": [
            "committed",
            "withheld",
            "failed"
          ]
        },
        "hubBundle": {
          "const": "withheld"
        },
        "componentAdmission": {
          "$ref": "#/$defs/componentAdmission"
        }
      }
    }
  }
}
