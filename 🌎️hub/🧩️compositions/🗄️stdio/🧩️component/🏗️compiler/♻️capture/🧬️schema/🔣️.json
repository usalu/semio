{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/compositions/stdio/component/compiler/capture/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "original",
    "replacement",
    "leaseSuffix",
    "phaseOrder",
    "denials"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "profile": {
      "const": "release"
    },
    "original": {
      "type": "string",
      "pattern": "^[0-9a-f]+$"
    },
    "replacement": {
      "type": "string",
      "pattern": "^[0-9a-f]+$"
    },
    "leaseSuffix": {
      "const": ".cache/framework/leases"
    },
    "phaseOrder": {
      "const": [
        "admit",
        "link",
        "capture",
        "release",
        "transform"
      ]
    },
    "denials": {
      "const": [
        "cancelled",
        "capture-refused"
      ]
    }
  }
}
