{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/hub/inference/relay.json",
  "$ref": "#/$defs/InferenceRelayRouteV1",
  "$defs": {
    "InferenceRelayRouteV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "method": {
              "const": "POST"
            },
            "path": {
              "type": "string",
              "pattern": "^/_semio/hub/spaces/(?!\\.{1,2}/)(?:[A-Za-z0-9._-]|%3A){1,96}/documents/(?!\\.{1,2}/)(?:[A-Za-z0-9._-]|%3A){1,96}/inference/gis-map/(?:jobs|jobs/reconcile|jobs/[0-9a-f]{32}/(?:cancel|approval)|approval-undos)$"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "GET"
            },
            "path": {
              "type": "string",
              "pattern": "^/_semio/hub/spaces/(?!\\.{1,2}/)(?:[A-Za-z0-9._-]|%3A){1,96}/documents/(?!\\.{1,2}/)(?:[A-Za-z0-9._-]|%3A){1,96}/inference/gis-map/jobs/[0-9a-f]{32}/events\\?after=(?:[0-9]|1[0-6])$"
            }
          }
        }
      ]
    }
  }
}
