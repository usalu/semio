{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/hub/inference/schema.json",
  "$ref": "#/$defs/InferenceRequestV1",
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "serverId": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9._:-]+$" },
    "safeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "hexBytes": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },

    "InferenceServerIdV1": { "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"], "$ref": "#/$defs/serverId" },

    "InferenceDocumentScopeV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId", "documentId"],
      "properties": { "spaceId": { "$ref": "#/$defs/serverId" }, "documentId": { "$ref": "#/$defs/serverId" } }
    },

    "InferenceRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "requestId", "serviceId", "policyVersion", "lifetimeMs"],
      "properties": {
        "schema": { "const": "semio.hub.inference-request/v1" },
        "version": { "const": 1 },
        "requestId": { "$ref": "#/$defs/id" },
        "serviceId": { "const": "s.gis.gismap.inference" },
        "policyVersion": { "const": 1 },
        "lifetimeMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },

    "InferenceParentDialectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "standard", "subset"],
      "properties": { "artifactKind": { "const": "s.gis.gismap" }, "standard": { "const": "1" }, "subset": { "const": "*" } }
    },

    "InferenceBindingIdentityV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "catalogGenerationId", "packageId", "packageVersion", "componentSha256", "componentBlake3", "artifactKind", "documentSchema", "parentDialect", "surfaceId", "grantedMode", "serviceId", "serviceVersion", "algorithmVersion"],
      "properties": {
        "digest": { "$ref": "#/$defs/hash" },
        "catalogGenerationId": { "$ref": "#/$defs/hash" },
        "packageId": { "const": "semio:gis" },
        "packageVersion": { "$ref": "#/$defs/serverId" },
        "componentSha256": { "$ref": "#/$defs/hash" },
        "componentBlake3": { "$ref": "#/$defs/hash" },
        "artifactKind": { "const": "s.gis.gismap" },
        "documentSchema": { "const": "gis.map" },
        "parentDialect": { "$ref": "#/$defs/InferenceParentDialectV1" },
        "surfaceId": { "const": "s.gis.gismap@1/*#editor" },
        "grantedMode": { "const": "read-write-observe" },
        "serviceId": { "const": "s.gis.gismap.inference" },
        "serviceVersion": { "const": 1 },
        "algorithmVersion": { "const": 1 }
      }
    },

    "InferenceIdentityV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "userId", "sessionId", "authorizationGeneration", "spaceId", "documentId", "descriptorDigest", "binding", "headOrdinal", "headEditId", "lastCommitSeq", "chainHash", "inputHash"],
      "properties": {
        "request": { "$ref": "#/$defs/InferenceRequestV1" },
        "userId": { "$ref": "#/$defs/serverId" },
        "sessionId": { "$ref": "#/$defs/serverId" },
        "spaceId": { "$ref": "#/$defs/serverId" },
        "documentId": { "$ref": "#/$defs/serverId" },
        "authorizationGeneration": { "$ref": "#/$defs/generation" },
        "descriptorDigest": { "$ref": "#/$defs/hash" },
        "binding": { "$ref": "#/$defs/InferenceBindingIdentityV1" },
        "chainHash": { "$ref": "#/$defs/hash" },
        "inputHash": { "$ref": "#/$defs/hash" },
        "headOrdinal": { "$ref": "#/$defs/safeInteger" },
        "headEditId": { "type": "string", "maxLength": 96, "pattern": "^[A-Za-z0-9._:-]*$" },
        "lastCommitSeq": { "$ref": "#/$defs/safeInteger" }
      },
      "anyOf": [
        { "properties": { "headEditId": { "$ref": "#/$defs/serverId" } } },
        { "properties": { "headEditId": { "const": "" }, "headOrdinal": { "const": 0 } } }
      ]
    },

    "InferenceJobStateV1": { "enum": ["accepted", "running", "succeeded", "failed", "cancelled"] },
    "InferenceProposalStateV1": { "enum": ["none", "offered", "approved", "stale", "cancelled"] },
    "InferenceLifecycleKindV1": { "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"], "enum": ["accepted", "running", "succeeded", "failed", "cancelled", "cancel-requested", "proposal-cancelled", "proposal-stale", "approval-prepared", "approved"] },

    "InferenceLimitsV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["requestMaxBytes", "inputMaxBytes", "resultMaxBytes", "proposalMaxBytes", "commandMaxBytes", "identityJsonMaxBytes", "jobCapacity", "operationCapacity", "documentGateCapacity", "progressMaxCursor", "eventPageMaxItems", "claimLeaseMaxMs", "jobMaxLifetimeMs", "workUnitLimit", "recursionDepth", "allocationBytes", "approvalMaxRecords"],
      "properties": {
        "requestMaxBytes": { "const": 1024 },
        "inputMaxBytes": { "const": 65536 },
        "resultMaxBytes": { "const": 16384 },
        "proposalMaxBytes": { "const": 4096 },
        "commandMaxBytes": { "const": 8192 },
        "identityJsonMaxBytes": { "const": 8192 },
        "jobCapacity": { "const": 128 },
        "operationCapacity": { "const": 32 },
        "documentGateCapacity": { "const": 64 },
        "progressMaxCursor": { "const": 16 },
        "eventPageMaxItems": { "const": 8 },
        "claimLeaseMaxMs": { "const": 30000 },
        "jobMaxLifetimeMs": { "const": 120000 },
        "workUnitLimit": { "const": 4096 },
        "recursionDepth": { "const": 32 },
        "allocationBytes": { "const": 1048576 },
        "approvalMaxRecords": { "const": 8 }
      }
    },

    "InferenceApprovalRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "jobId", "proposalHash"],
      "properties": {
        "schema": { "const": "semio.hub.inference-approval/v1" },
        "version": { "const": 1 },
        "jobId": { "$ref": "#/$defs/id" },
        "proposalHash": { "$ref": "#/$defs/hash" }
      }
    },

    "InferenceApprovalReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "jobId", "mutationId", "commandHash", "proposalHash", "applied", "undo"],
      "properties": {
        "schema": { "const": "semio.hub.inference-approval-receipt/v1" },
        "jobId": { "$ref": "#/$defs/id" },
        "mutationId": { "$ref": "#/$defs/id" },
        "commandHash": { "$ref": "#/$defs/hash" },
        "proposalHash": { "$ref": "#/$defs/hash" },
        "applied": { "type": "boolean" },
        "undo": { "$ref": "#/$defs/GisMapApprovalUndoHandleV1" }
      }
    },

    "InferenceApprovalOutboxV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal", "commandHex", "jobId", "proposalHash", "commandHash", "mutationId", "preparedCount", "reconciledCount"],
      "properties": {
        "proposal": { "const": "ledger-only-proposal" },
        "commandHex": { "allOf": [{ "$ref": "#/$defs/hexBytes" }, { "type": "string", "minLength": 2, "maxLength": 16384 }] },
        "jobId": { "$ref": "#/$defs/id" },
        "mutationId": { "$ref": "#/$defs/id" },
        "proposalHash": { "$ref": "#/$defs/hash" },
        "commandHash": { "$ref": "#/$defs/hash" },
        "preparedCount": { "const": 1 },
        "reconciledCount": { "const": 1 }
      }
    },

    "GisMapDocumentFrontierV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "headEditOrdinal", "headEditId", "lastCommitSeq", "chainSha256"],
      "properties": {
        "documentId": { "$ref": "#/$defs/serverId" },
        "headEditOrdinal": { "$ref": "#/$defs/safeInteger" },
        "headEditId": { "type": "string", "maxLength": 96, "pattern": "^[A-Za-z0-9._:-]*$" },
        "lastCommitSeq": { "$ref": "#/$defs/safeInteger" },
        "chainSha256": { "$ref": "#/$defs/hash" }
      }
    },

    "GisMapApprovalUndoHandleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "expectedCurrent"],
      "properties": { "targetId": { "$ref": "#/$defs/id" }, "expectedCurrent": { "$ref": "#/$defs/GisMapDocumentFrontierV1" } }
    },

    "GisMapApprovalUndoRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "targetId", "idempotencyKey", "expectedCurrent"],
      "properties": {
        "schema": { "const": "semio.hub.gis-map-approval-undo/v1" },
        "version": { "const": 1 },
        "targetId": { "$ref": "#/$defs/id" },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "expectedCurrent": { "$ref": "#/$defs/GisMapDocumentFrontierV1" }
      }
    },

    "GisMapApprovalUndoReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "targetId", "originalJobId", "mutationId", "commandHash", "applied", "replayed", "frontier"],
      "properties": {
        "schema": { "const": "semio.hub.gis-map-approval-undo-receipt/v1" },
        "targetId": { "$ref": "#/$defs/id" },
        "originalJobId": { "$ref": "#/$defs/id" },
        "mutationId": { "$ref": "#/$defs/id" },
        "commandHash": { "$ref": "#/$defs/hash" },
        "applied": { "type": "boolean" },
        "replayed": { "type": "boolean" },
        "frontier": { "$ref": "#/$defs/GisMapDocumentFrontierV1" }
      }
    },

    "GisMapApprovalUndoTargetV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "targetId", "scope", "originalJobId", "originalMutationId", "originalCommandHash", "proposalHash", "committedWitnessDigest", "beforeFrontier", "afterFrontier", "ownerUserId", "ownerSessionId", "authorizationGeneration"],
      "properties": {
        "schema": { "const": "semio.hub.gis-map-approval-undo-target/v1" },
        "targetId": { "$ref": "#/$defs/id" },
        "scope": { "$ref": "#/$defs/InferenceDocumentScopeV1" },
        "originalJobId": { "$ref": "#/$defs/id" },
        "originalMutationId": { "$ref": "#/$defs/id" },
        "originalCommandHash": { "$ref": "#/$defs/hash" },
        "proposalHash": { "$ref": "#/$defs/hash" },
        "committedWitnessDigest": { "$ref": "#/$defs/hash" },
        "beforeFrontier": { "$ref": "#/$defs/GisMapDocumentFrontierV1" },
        "afterFrontier": { "$ref": "#/$defs/GisMapDocumentFrontierV1" },
        "ownerUserId": { "$ref": "#/$defs/serverId" },
        "ownerSessionId": { "$ref": "#/$defs/serverId" },
        "authorizationGeneration": { "$ref": "#/$defs/generation" }
      }
    },

    "GisInferenceCheckpointControlFrameV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "sequence", "kind", "jobId"],
      "properties": {
        "schema": { "const": "semio.hub.gis-inference-checkpoint-control/v1" },
        "version": { "const": 1 },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2 },
        "kind": { "enum": ["entered", "release"] },
        "jobId": { "$ref": "#/$defs/id" }
      }
    },

    "GisInferenceCheckpointControlDirectionV1": { "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"], "enum": ["hub-to-runner", "runner-to-hub"] },

    "GisMapInferencePreviewV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "jobId", "proposalHash", "regionId", "ring"],
      "properties": {
        "schema": { "const": "semio.hub.gis-map-inference-preview/v1" },
        "jobId": { "$ref": "#/$defs/id" },
        "proposalHash": { "$ref": "#/$defs/hash" },
        "regionId": { "type": "string", "pattern": "^inference-[0-9a-f]{32}$" },
        "ring": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": -180, "maximum": 180 } }
        }
      }
    },

    "InferenceMapBoundsV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["lonMin", "lonMax", "latMin", "latMax"],
      "properties": {
        "lonMin": { "type": "number", "minimum": -180, "maximum": 180 },
        "lonMax": { "type": "number", "minimum": -180, "maximum": 180 },
        "latMin": { "type": "number", "minimum": -90, "maximum": 90 },
        "latMax": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },

    "InferenceMapSummaryV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["positionCount", "routeCount", "regionCount", "bounds"],
      "properties": {
        "positionCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "routeCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "regionCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "bounds": { "$ref": "#/$defs/InferenceMapBoundsV1" }
      }
    },

    "InferenceProgressV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "runEpoch", "completed", "total", "atMs"],
      "properties": {
        "cursor": { "$ref": "#/$defs/safeInteger" },
        "runEpoch": { "$ref": "#/$defs/safeInteger" },
        "completed": { "$ref": "#/$defs/safeInteger" },
        "total": { "$ref": "#/$defs/safeInteger" },
        "atMs": { "$ref": "#/$defs/safeInteger" }
      }
    },

    "InferenceEventV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "atMs"],
      "properties": { "ordinal": { "$ref": "#/$defs/safeInteger" }, "kind": { "$ref": "#/$defs/InferenceLifecycleKindV1" }, "atMs": { "$ref": "#/$defs/safeInteger" } }
    },

    "InferenceJobReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "jobId", "state", "proposalState", "proposalHash", "cursor", "expiresAtMs"],
      "properties": {
        "schema": { "const": "semio.hub.inference-job-receipt/v1" },
        "jobId": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/InferenceJobStateV1" },
        "proposalState": { "$ref": "#/$defs/InferenceProposalStateV1" },
        "proposalHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "cursor": { "$ref": "#/$defs/safeInteger" },
        "expiresAtMs": { "$ref": "#/$defs/safeInteger" }
      }
    },

    "InferenceEventPageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "jobId", "state", "proposalState", "cancelRequested", "stale", "proposalHash", "events", "progress", "nextCursor"],
      "properties": {
        "schema": { "const": "semio.hub.inference-job-events/v1" },
        "jobId": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/InferenceJobStateV1" },
        "proposalState": { "$ref": "#/$defs/InferenceProposalStateV1" },
        "cancelRequested": { "type": "boolean" },
        "stale": { "type": "boolean" },
        "proposalHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "preview": { "$ref": "#/$defs/GisMapInferencePreviewV1" },
        "events": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/InferenceEventV1" } },
        "progress": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/InferenceProgressV1" } },
        "nextCursor": { "$ref": "#/$defs/safeInteger" }
      }
    },

    "InferenceHybridLogicalTimestampV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "physicalMs", "logical"],
      "properties": { "actor": { "$ref": "#/$defs/safeInteger" }, "physicalMs": { "$ref": "#/$defs/safeInteger" }, "logical": { "$ref": "#/$defs/safeInteger" } }
    },

    "InferenceCommandPayloadV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "payloadHex"],
      "properties": { "schema": { "const": "gis.map" }, "payloadHex": { "allOf": [{ "$ref": "#/$defs/hexBytes" }, { "type": "string", "maxLength": 4096 }] } }
    },

    "InferenceCommandV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationId", "documentId", "actor", "dependencies", "diff", "inverse", "timestamp"],
      "properties": {
        "mutationId": { "$ref": "#/$defs/id" },
        "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "actor": { "type": "string", "minLength": 1, "maxLength": 256 },
        "dependencies": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id" } },
        "diff": { "$ref": "#/$defs/InferenceCommandPayloadV1" },
        "inverse": { "$ref": "#/$defs/InferenceCommandPayloadV1" },
        "timestamp": { "$ref": "#/$defs/InferenceHybridLogicalTimestampV1" }
      }
    },

    "InferenceCommandLimitsV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["commandBytes", "textBytes", "dependencyCount", "payloadBytes", "integerMaximum"],
      "properties": {
        "commandBytes": { "const": 8192 },
        "textBytes": { "const": 256 },
        "dependencyCount": { "const": 64 },
        "payloadBytes": { "const": 4096 },
        "integerMaximum": { "const": 9007199254740991 }
      }
    },

    "InferenceWalChainPolicyV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["hashAlgorithm", "requiredFlags", "recordDigest", "commitDigest"],
      "properties": {
        "hashAlgorithm": { "const": "blake3-256" },
        "requiredFlags": { "const": 1 },
        "recordDigest": { "const": "full-frame-including-length-crc-and-back-length" },
        "commitDigest": { "const": "previous-chain-hash-followed-by-ordered-record-digests" }
      }
    },

    "InferenceWalTargetV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "documentKey", "generation", "jobId", "proposalHash", "maximumRecords"],
      "properties": {
        "scope": { "$ref": "#/$defs/InferenceDocumentScopeV1" },
        "documentKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "generation": { "$ref": "#/$defs/generation" },
        "jobId": { "$ref": "#/$defs/id" },
        "proposalHash": { "$ref": "#/$defs/hash" },
        "maximumRecords": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },

    "InferenceCatalogOwnerV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "version", "packageHash"],
      "properties": { "pluginId": { "const": "gis" }, "packageId": { "const": "semio:gis" }, "version": { "const": "1.0.0" }, "packageHash": { "$ref": "#/$defs/hash" } }
    },

    "InferenceCatalogFrontierV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["headSeq", "commitSeq", "epoch"],
      "properties": { "headSeq": { "const": 0 }, "commitSeq": { "const": 0 }, "epoch": { "const": 0 } }
    },

    "InferenceCatalogDescriptorV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId", "documentId", "artifactKind", "artifactSchema", "owner", "packSchemaHash", "bootstrapVersion", "bootstrapFrontier", "bootstrapSnapshotHash"],
      "properties": {
        "spaceId": { "$ref": "#/$defs/id" },
        "documentId": { "$ref": "#/$defs/id" },
        "artifactKind": { "const": "s.gis.gismap" },
        "artifactSchema": { "const": "gis.map" },
        "owner": { "$ref": "#/$defs/InferenceCatalogOwnerV1" },
        "packSchemaHash": { "$ref": "#/$defs/hash" },
        "bootstrapVersion": { "const": 1 },
        "bootstrapFrontier": { "$ref": "#/$defs/InferenceCatalogFrontierV1" },
        "bootstrapSnapshotHash": { "$ref": "#/$defs/hash" }
      }
    },

    "InferenceCatalogPackageV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "version", "componentSha256"],
      "properties": { "pluginId": { "const": "gis" }, "packageId": { "const": "semio:gis" }, "version": { "const": "1.0.0" }, "componentSha256": { "$ref": "#/$defs/hash" } }
    },

    "InferenceCatalogServiceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "contributor", "artifactKind", "artifactSchema", "artifactSchemaVersion", "documentSchema", "documentSchemaVersion", "inferenceSchema", "inferenceSchemaVersion", "algorithmVersion", "policyVersion", "dependsOn"],
      "properties": {
        "owner": { "const": "gis" },
        "contributor": { "const": "gis" },
        "artifactKind": { "const": "s.gis.gismap" },
        "artifactSchema": { "const": "s.gis.gismap" },
        "artifactSchemaVersion": { "const": 1 },
        "documentSchema": { "const": "gis.map" },
        "documentSchemaVersion": { "const": 1 },
        "inferenceSchema": { "const": "s.gis.gismap.inference" },
        "inferenceSchemaVersion": { "const": 1 },
        "algorithmVersion": { "const": 1 },
        "policyVersion": { "const": 1 },
        "dependsOn": { "type": "array", "maxItems": 0 }
      }
    },

    "InferenceCatalogSelectionV1": {
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"],
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "descriptor", "package", "services"],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spaceId", "documentId"],
          "properties": { "spaceId": { "$ref": "#/$defs/id" }, "documentId": { "$ref": "#/$defs/id" } }
        },
        "descriptor": { "$ref": "#/$defs/InferenceCatalogDescriptorV1" },
        "package": { "$ref": "#/$defs/InferenceCatalogPackageV1" },
        "services": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/InferenceCatalogServiceV1" } }
      }
    },

    "GisMapFrozenExecutionProtocolV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appChannelVersion"],
      "properties": { "appChannelVersion": { "const": 14 } }
    },

    "GisMapFrozenPackageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "version", "componentSha256", "componentBlake3", "descriptorByteSha256", "executionProtocol"],
      "properties": {
        "pluginId": { "const": "gis" },
        "packageId": { "const": "semio:gis" },
        "version": { "const": "0.1.0" },
        "componentSha256": { "$ref": "#/$defs/hash" },
        "componentBlake3": { "$ref": "#/$defs/hash" },
        "descriptorByteSha256": { "$ref": "#/$defs/hash" },
        "executionProtocol": { "$ref": "#/$defs/GisMapFrozenExecutionProtocolV1" }
      }
    },

    "GisMapFrozenArtifactV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "packSchemaHash"],
      "properties": { "kind": { "const": "s.gis.gismap" }, "schema": { "const": "gis.map" }, "packSchemaHash": { "$ref": "#/$defs/hash" } }
    },

    "GisMapFrozenSurfaceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "appId", "windowKindId", "role", "rendererTarget"],
      "properties": {
        "surfaceId": { "const": "s.gis.gismap@1/*#editor" },
        "appId": { "const": "s.gis.gismap@1/*#editor" },
        "windowKindId": { "const": "gis2d-main" },
        "role": { "const": "editor" },
        "rendererTarget": { "const": "wasm" }
      }
    },

    "GisMapFrozenGrantV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "observe"],
      "properties": { "read": { "const": true }, "write": { "const": true }, "observe": { "const": true } }
    },

    "GisMapFrozenBindingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogGenerationId", "package", "artifact", "parentDialect", "surface", "grant", "service", "nativeExecutable"],
      "properties": {
        "catalogGenerationId": { "$ref": "#/$defs/hash" },
        "package": { "$ref": "#/$defs/GisMapFrozenPackageV1" },
        "artifact": { "$ref": "#/$defs/GisMapFrozenArtifactV1" },
        "parentDialect": { "$ref": "#/$defs/InferenceParentDialectV1" },
        "surface": { "$ref": "#/$defs/GisMapFrozenSurfaceV1" },
        "grant": { "$ref": "#/$defs/GisMapFrozenGrantV1" },
        "service": { "$ref": "#/$defs/InferenceCatalogServiceV1" },
        "nativeExecutable": { "const": "semio_s_plugin_gis::gis_map_inference_service" }
      }
    }
  }
}
