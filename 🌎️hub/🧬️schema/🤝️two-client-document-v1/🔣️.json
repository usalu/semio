{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/two-client-document/schema.json",
  "title": "TwoClientDocumentScenarioV1",
  "$defs": {
    "TwoClientDocumentScenarioV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "authors",
        "artifactKindId",
        "surfaceId",
        "spaceName",
        "command",
        "growth",
        "presence",
        "agent",
        "shutdown",
        "steps",
        "expectations"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.two-client-document-scenario/v1"
        },
        "version": {
          "const": 1
        },
        "authors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "artifactKindId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "surfaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "spaceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "diffSchema",
            "diffValue",
            "inverseValue",
            "batchId",
            "mutationIdPrefix"
          ],
          "properties": {
            "diffSchema": {
              "const": "db.pathmap.v1"
            },
            "diffValue": {
              "type": "object"
            },
            "inverseValue": {
              "type": "object"
            },
            "batchId": {
              "type": "integer",
              "minimum": 1
            },
            "mutationIdPrefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          }
        },
        "growth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "editsBeforeRestart",
            "editsAfterRestart",
            "payloadBytes",
            "distinctPaths",
            "batchIdBase",
            "mutationIdPrefix"
          ],
          "properties": {
            "editsBeforeRestart": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "editsAfterRestart": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "payloadBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "distinctPaths": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "x-semio-note": "a pathmap document retains at most 64 distinct paths (RETAINED_STATE_ENTRIES)"
            },
            "batchIdBase": {
              "type": "integer",
              "minimum": 1
            },
            "mutationIdPrefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "presence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lane",
            "labelA",
            "leaseTtlMs",
            "hoveredPath"
          ],
          "properties": {
            "lane": {
              "const": "preview"
            },
            "labelA": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "leaseTtlMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 120000
            },
            "hoveredPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agentLabel",
            "audience",
            "ttlSecs",
            "agentInstanceId",
            "revocationWithinMs",
            "closeCode",
            "refusedStatus",
            "reexchangeStatus",
            "reexchangeError"
          ],
          "x-semio-note": "a delegated agent on the same document: revoking its delegation closes its open socket, drops it from the other client's roster and refuses its next request (401), all within revocationWithinMs; the revoked delegation itself is refused 403 delegation-revoked, the cause a holder of its secret is entitled to know",
          "properties": {
            "agentLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "audience": {
              "enum": [
                "read",
                "edit"
              ]
            },
            "ttlSecs": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            },
            "agentInstanceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "revocationWithinMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000
            },
            "closeCode": {
              "const": 4401
            },
            "refusedStatus": {
              "const": 401
            },
            "reexchangeStatus": {
              "const": 403
            },
            "reexchangeError": {
              "const": "delegation-revoked"
            }
          }
        },
        "shutdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "closeCode",
            "gracefulExitWithinMs",
            "restartWithinMs",
            "reopenWithinMs",
            "crashReleaseSlackMs",
            "databaseClosedMarker",
            "liveWriterProbe"
          ],
          "properties": {
            "closeCode": {
              "const": 1012
            },
            "gracefulExitWithinMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 120000
            },
            "crashReleaseSlackMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 120000
            },
            "databaseClosedMarker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "liveWriterProbe": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "postgres",
                "neo4j"
              ],
              "properties": {
                "postgres": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "neo4j": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            "restartWithinMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "reopenWithinMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 120000,
              "x-semio-note": "a restarted hub welcomes the first socket of a grown document within this bound (the document's WAL replays on that open)"
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string"
          }
        },
        "expectations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bReceivesCommandsEnvelope",
            "ackStagesIncludeApplied",
            "frontierDocumentIdIsPlainArtifactId",
            "presencePeerActorMatchesA",
            "presenceJoinReplayShowsA",
            "reconnectDeliversMissedOrRebootstrap",
            "restartPreservesArtifactAndFrontier",
            "lateJoinerCatchesUp",
            "presenceLeaveDropsPeer",
            "presenceLeaseExpiryStripsA",
            "gracefulShutdownClosesSocketsAndReleasesWriters",
            "crashReleasesWritersPerBackendContract",
            "revocationEndsAgentSession"
          ],
          "properties": {
            "bReceivesCommandsEnvelope": {
              "type": "boolean"
            },
            "ackStagesIncludeApplied": {
              "type": "boolean"
            },
            "frontierDocumentIdIsPlainArtifactId": {
              "type": "boolean"
            },
            "presencePeerActorMatchesA": {
              "type": "boolean"
            },
            "reconnectDeliversMissedOrRebootstrap": {
              "type": "boolean"
            },
            "restartPreservesArtifactAndFrontier": {
              "type": "boolean"
            },
            "presenceJoinReplayShowsA": {
              "type": "boolean"
            },
            "lateJoinerCatchesUp": {
              "type": "boolean"
            },
            "presenceLeaveDropsPeer": {
              "type": "boolean"
            },
            "presenceLeaseExpiryStripsA": {
              "type": "boolean"
            },
            "gracefulShutdownClosesSocketsAndReleasesWriters": {
              "type": "boolean"
            },
            "crashReleasesWritersPerBackendContract": {
              "type": "boolean"
            },
            "revocationEndsAgentSession": {
              "type": "boolean"
            }
          }
        },
        "nonclaims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
