{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/hub/foundation-source/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owners", "contexts", "route", "limits", "sourceBoundary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owners": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "declarations", "imports", "rootImports", "contextChain"],
        "properties": {
          "path": { "type": "string", "pattern": "^🌎️hub/.+/🟦️\\.ts$" },
          "declarations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "imports": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^🌎️hub/.+/🟦️\\.ts$" } },
          "rootImports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "contextChain": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^hub-" } }
        }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directoryName", "parentKindId", "kindId"],
        "properties": {
          "directoryName": { "type": "string", "minLength": 2 },
          "parentKindId": { "type": "string", "minLength": 1 },
          "kindId": { "type": "string", "pattern": "^hub-" }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "target", "launchName", "launchCommand", "launchGroup", "launchOrder", "inputs"],
      "properties": {
        "command": { "const": "foundation-source-check" },
        "target": { "const": "foundation-source-check" },
        "launchName": { "const": "⚖️gate🧱️hub-foundations📐️source" },
        "launchCommand": { "const": "bun nx run os-hub:foundation-source-check" },
        "launchGroup": { "const": "4_gate" },
        "launchOrder": { "const": 411.10755 },
        "inputs": { "type": "array", "minItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localFrameBytes", "gisControlFrameBytes", "profiles", "outstandingReads", "cargoBuildStack", "cargoNativeStack"],
      "properties": {
        "localFrameBytes": { "const": 16384 },
        "gisControlFrameBytes": { "const": 256 },
        "profiles": { "const": 8 },
        "outstandingReads": { "const": 8 },
        "cargoBuildStack": { "const": "33554432" },
        "cargoNativeStack": { "const": "268435456" }
      }
    },
    "sourceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typescript", "rust"],
      "properties": {
        "typescript": { "$ref": "#/$defs/sourceBoundaryCase" },
        "rust": { "$ref": "#/$defs/sourceBoundaryCase" }
      }
    }
  },
  "$defs": {
    "sourceBoundaryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "definition", "expectedBodies", "expectedCalls"],
      "properties": {
        "source": { "type": "string", "minLength": 32 },
        "definition": { "type": "string", "minLength": 1 },
        "expectedBodies": { "type": "integer", "minimum": 1, "maximum": 4 },
        "expectedCalls": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } }
      }
    }
  }
}
