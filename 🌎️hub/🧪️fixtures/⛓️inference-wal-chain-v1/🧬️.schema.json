{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semio:hub:inference-wal-chain-fixture:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "hashAlgorithm", "requiredFlags", "recordDigest", "commitDigest", "cases", "hashingOwnership", "retainedBoundaries"],
  "properties": {
    "schema": { "const": "semio.hub.inference-wal-chain-fixture/v1" },
    "hashAlgorithm": { "const": "blake3-256" },
    "requiredFlags": { "const": 1 },
    "recordDigest": { "const": "full-frame-including-length-crc-and-back-length" },
    "commitDigest": { "const": "previous-chain-hash-followed-by-ordered-record-digests" },
    "hashingOwnership": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["interrupt", "expected", "heldActive", "releasedActive", "stoppedProgress", "hashingSteps"],
        "properties": {
          "interrupt": { "enum": ["drop", "cancel", "deadline"] }, "expected": { "enum": ["cancelled", "expired"] },
          "heldActive": { "const": 1 }, "releasedActive": { "const": 0 }, "stoppedProgress": { "const": 0 }, "hashingSteps": { "const": 1 }
        }
      }
    },
    "retainedBoundaries": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mutation", "replayAccepted", "genesisProofAccepted"],
        "properties": {
          "mutation": { "enum": ["none", "wrong-prior-tip"] }, "replayAccepted": { "const": true }, "genesisProofAccepted": { "const": false }
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "segments", "mutation", "accepted"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "segments": { "enum": [1, 2] },
          "mutation": { "enum": ["none", "record-crc-repaired", "commit-hash-crc-repaired", "commit-count-crc-repaired", "commit-length-crc-repaired", "commit-sequence-crc-repaired", "commit-offset-crc-repaired", "missing-required-chain", "wrong-prior-tip", "wrong-segment-document", "skipped-segment-index", "noncritical-commit-crc-repaired", "commit-reserved-crc-repaired"] },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
