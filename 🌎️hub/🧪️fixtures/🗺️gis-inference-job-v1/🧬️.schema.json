{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semio:hub:gis-inference-ledger-fixture:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "nowMs", "identityDigest", "identity", "input", "expectedInference", "traces", "hostileRequests", "hostileIdentities", "outbox", "sqliteIntegers"],
  "properties": {
    "schema": { "const": "semio.hub.gis-inference-ledger-fixture/v1" },
    "version": { "const": 1 },
    "nowMs": { "const": 1000 },
    "identityDigest": { "$ref": "urn:semio:hub:inference-job:v1#/$defs/hash" },
    "identity": { "$ref": "urn:semio:hub:inference-job:v1#/$defs/identity" },
    "input": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "expectedInference": {
      "type": "object", "additionalProperties": false,
      "required": ["positionCount", "routeCount", "regionCount", "bounds"],
      "properties": {
        "positionCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "routeCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "regionCount": { "type": "integer", "minimum": 0, "maximum": 65536 },
        "bounds": {
          "type": "object", "additionalProperties": false,
          "required": ["lonMin", "lonMax", "latMin", "latMax"],
          "properties": { "lonMin": { "type": "number" }, "lonMax": { "type": "number" }, "latMin": { "type": "number" }, "latMax": { "type": "number" } }
        }
      }
    },
    "traces": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "operations", "state", "proposalState", "eventCount", "hasResult"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "operations": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "enum": ["start", "succeed", "cancel"] } },
          "state": { "$ref": "urn:semio:hub:inference-job:v1#/$defs/jobState" },
          "proposalState": { "$ref": "urn:semio:hub:inference-job:v1#/$defs/proposalState" },
          "eventCount": { "type": "integer", "minimum": 1, "maximum": 5 },
          "hasResult": { "type": "boolean" }
        }
      }
    },
    "outbox": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal", "commandHex", "jobId", "proposalHash", "commandHash", "mutationId", "preparedCount", "reconciledCount"],
      "properties": {
        "proposal": { "const": "ledger-only-proposal" },
        "commandHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$", "maxLength": 16384 },
        "jobId": { "$ref": "urn:semio:hub:inference-job:v1#/$defs/id" },
        "mutationId": { "$ref": "urn:semio:hub:inference-job:v1#/$defs/id" },
        "proposalHash": { "$ref": "urn:semio:hub:inference-job:v1#/$defs/hash" },
        "commandHash": { "$ref": "urn:semio:hub:inference-job:v1#/$defs/hash" },
        "preparedCount": { "const": 1 },
        "reconciledCount": { "const": 1 }
      }
    },
    "sqliteIntegers": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["decimal", "accepted"],
        "properties": { "decimal": { "type": "string", "pattern": "^-?[0-9]{1,20}$" }, "accepted": { "type": "boolean" } }
      }
    },
    "hostileRequests": {
      "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "field", "value"],
        "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 64 }, "field": { "type": "string", "minLength": 1, "maxLength": 64 }, "value": {} }
      }
    },
    "hostileIdentities": {
      "type": "array", "minItems": 17, "maxItems": 17,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "path", "value"], "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "path": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "value": {}
      } }
    }
  }
}
