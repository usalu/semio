{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semio:hub:inference-wal-proof-fixture:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "scope", "documentKey", "generation", "jobId", "proposalHash", "bindingMismatches", "maximumRecords", "command", "encodedHex", "commandHash", "payloadAuthority", "ownership", "traces"],
  "properties": {
    "schema": { "const": "semio.hub.inference-wal-proof-fixture/v1" },
    "scope": { "type": "object", "additionalProperties": false, "required": ["spaceId", "documentId"], "properties": { "spaceId": { "$ref": "#/$defs/id" }, "documentId": { "$ref": "#/$defs/id" } } },
    "documentKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "generation": { "$ref": "#/$defs/generation" },
    "jobId": { "$ref": "#/$defs/id" },
    "proposalHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bindingMismatches": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["jobId", "proposalHash"], "properties": { "jobId": { "$ref": "#/$defs/id" }, "proposalHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
    "maximumRecords": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["mutationId", "documentId", "actor", "dependencies", "diff", "inverse", "timestamp"],
      "properties": {
        "mutationId": { "$ref": "#/$defs/id" },
        "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "actor": { "type": "string", "minLength": 1, "maxLength": 256 },
        "dependencies": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id" } },
        "diff": { "$ref": "#/$defs/payload" }, "inverse": { "$ref": "#/$defs/payload" },
        "timestamp": { "type": "object", "additionalProperties": false, "required": ["actor", "physicalMs", "logical"], "properties": { "actor": { "$ref": "#/$defs/uint" }, "physicalMs": { "$ref": "#/$defs/uint" }, "logical": { "$ref": "#/$defs/uint" } } }
      }
    },
    "encodedHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})+$", "maxLength": 16384 },
    "commandHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "payloadAuthority": { "const": "protocol-envelope-only-not-an-executable-gis-mutation" },
    "ownership": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "object", "additionalProperties": false, "required": ["interrupt", "expected", "heldActive", "releasedActive", "stoppedProgress"], "properties": {
        "interrupt": { "enum": ["drop", "cancel", "deadline"] }, "expected": { "enum": ["cancelled", "expired"] },
        "heldActive": { "const": 1 }, "releasedActive": { "const": 0 }, "stoppedProgress": { "const": 1 }
      } }
    },
    "traces": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "records", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "spaceId": { "$ref": "#/$defs/id" },
          "observedGeneration": { "$ref": "#/$defs/generation" },
          "reusableAfterInvalidation": { "const": false },
          "maximumRecords": { "type": "integer", "minimum": 1, "maximum": 65536 },
          "cancelAfterRecords": { "type": "integer", "minimum": 0, "maximum": 32 },
          "flushed": { "type": "boolean" }, "tornTail": { "type": "boolean" },
          "records": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/record" } },
          "expected": { "enum": ["verified", "absent", "invalid", "stale", "cancelled", "bounds"] }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "uint": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "payload": { "type": "object", "additionalProperties": false, "required": ["schema", "payloadHex"], "properties": { "schema": { "const": "gis.map" }, "payloadHex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$", "maxLength": 4096 } } },
    "record": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "txId"], "properties": { "kind": { "enum": ["begin", "abort"] }, "txId": { "$ref": "#/$defs/generation" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "bytes"], "properties": { "kind": { "const": "command" }, "bytes": { "enum": ["target", "different", "altered-target"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "txId", "recordCount"], "properties": { "kind": { "const": "commit" }, "txId": { "$ref": "#/$defs/generation" }, "recordCount": { "type": "integer", "minimum": 0, "maximum": 64 } } }
      ]
    }
  }
}
