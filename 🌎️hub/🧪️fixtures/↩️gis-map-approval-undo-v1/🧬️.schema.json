{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.hub.gis-map-approval-undo-fixture/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "request", "genesisFirstUndo", "traces", "historyMembers", "sourceHostiles"],
  "$defs": {
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9._:-]+$" },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "headEditOrdinal", "headEditId", "lastCommitSeq", "chainSha256"],
      "properties": {
        "documentId": { "$ref": "#/$defs/id" },
        "headEditOrdinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "headEditId": { "type": "string", "maxLength": 96 },
        "lastCommitSeq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "chainSha256": { "$ref": "#/$defs/hex64" }
      }
    }
  },
  "properties": {
    "schema": { "const": "semio.hub.gis-map-approval-undo-fixture/v1" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "targetId", "scope", "originalJobId", "originalMutationId", "originalCommandHash", "proposalHash", "committedWitnessDigest", "beforeFrontier", "afterFrontier", "ownerUserId", "ownerSessionId", "authorizationGeneration"],
      "properties": {
        "schema": { "const": "semio.hub.gis-map-approval-undo-target/v1" },
        "targetId": { "$ref": "#/$defs/hex32" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spaceId", "documentId"],
          "properties": { "spaceId": { "$ref": "#/$defs/id" }, "documentId": { "$ref": "#/$defs/id" } }
        },
        "originalJobId": { "$ref": "#/$defs/hex32" },
        "originalMutationId": { "$ref": "#/$defs/hex32" },
        "originalCommandHash": { "$ref": "#/$defs/hex64" },
        "proposalHash": { "$ref": "#/$defs/hex64" },
        "committedWitnessDigest": { "$ref": "#/$defs/hex64" },
        "beforeFrontier": { "$ref": "#/$defs/frontier" },
        "afterFrontier": { "$ref": "#/$defs/frontier" },
        "ownerUserId": { "$ref": "#/$defs/id" },
        "ownerSessionId": { "$ref": "#/$defs/id" },
        "authorizationGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "targetId", "idempotencyKey", "expectedCurrent"],
      "properties": {
        "schema": { "const": "semio.hub.gis-map-approval-undo/v1" },
        "version": { "const": 1 },
        "targetId": { "$ref": "#/$defs/hex32" },
        "idempotencyKey": { "$ref": "#/$defs/hex32" },
        "expectedCurrent": { "$ref": "#/$defs/frontier" }
      }
    },
    "genesisFirstUndo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialShape", "firstCommandOrdinalDelta", "undoCommandOrdinalDelta", "restoresExactInitialSnapshot", "restoresGenesisFrontier", "syntheticGenesisEdit"],
      "properties": {
        "initialShape": { "const": "scope-bound-zero-frontier" },
        "firstCommandOrdinalDelta": { "const": 1 },
        "undoCommandOrdinalDelta": { "const": 1 },
        "restoresExactInitialSnapshot": { "const": true },
        "restoresGenesisFrontier": { "const": false },
        "syntheticGenesisEdit": { "const": false }
      }
    },
    "traces": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "actor", "current", "idempotency", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "actor": { "enum": ["owner", "foreign", "replacement-session"] },
          "current": { "enum": ["after", "peer-edit", "undone"] },
          "idempotency": { "enum": ["fresh", "same"] },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "walEvents", "publications", "replayed"],
            "properties": {
              "outcome": { "enum": ["applied", "denied", "conflict"] },
              "walEvents": { "type": "integer", "minimum": 0, "maximum": 1 },
              "publications": { "type": "integer", "minimum": 0, "maximum": 1 },
              "replayed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "historyMembers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "instance", "transactionId", "dispatch"],
          "properties": {
            "tag": { "const": "localGuestTransaction" },
            "instance": { "type": "integer", "minimum": 1 },
            "transactionId": { "$ref": "#/$defs/id" },
            "dispatch": { "const": "plugin-channel" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "hubOrigin", "spaceId", "documentId", "targetId", "idempotencyKey", "dispatch"],
          "properties": {
            "tag": { "const": "hubGisMapApproval" },
            "hubOrigin": { "type": "string", "pattern": "^https://" },
            "spaceId": { "$ref": "#/$defs/id" },
            "documentId": { "$ref": "#/$defs/id" },
            "targetId": { "$ref": "#/$defs/hex32" },
            "idempotencyKey": { "$ref": "#/$defs/hex32" },
            "dispatch": { "const": "history-undo-port" }
          }
        }
      ]
    },
    "sourceHostiles": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
