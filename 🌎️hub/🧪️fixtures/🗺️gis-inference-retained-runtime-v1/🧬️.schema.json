{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "limits", "traces", "sourceHostiles"],
  "properties": {
    "schema": { "const": "semio.hub.gis-inference-retained-runtime/v1" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "workUnits", "claimLeaseMs", "jobLifetimeMs", "closeMs"],
      "properties": {
        "operations": { "const": 32 },
        "workUnits": { "const": 4096 },
        "claimLeaseMs": { "const": 30000 },
        "jobLifetimeMs": { "const": 120000 },
        "closeMs": { "const": 5000 }
      }
    },
    "traces": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "steps", "expected"],
        "properties": {
          "name": {
            "enum": [
              "accepted-running-before-release",
              "owner-cancel-during-checkpoint",
              "revocation-before-terminal-recheck",
              "same-request-one-owner",
              "late-result-after-cancel",
              "claim-heartbeat-no-steal",
              "admission-or-spawn-refusal",
              "runtime-close-drains-worker",
              "foreign-cancel-inert"
            ]
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
              "enum": [
                "submit",
                "response-drop",
                "compute-enter",
                "compute-release",
                "cancel",
                "checkpoint",
                "revoke-author",
                "duplicate-submit",
                "claim-heartbeat",
                "spawn-refused",
                "close",
                "foreign-cancel",
                "terminal"
              ]
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["response", "events", "retainedAtResponse", "retainedAtTerminal", "offers", "executions"],
            "properties": {
              "response": { "enum": ["running", "capacity"] },
              "events": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": { "enum": ["accepted", "running", "cancel-requested", "cancelled", "succeeded", "failed"] }
              },
              "retainedAtResponse": { "type": "integer", "minimum": 0, "maximum": 1 },
              "retainedAtTerminal": { "const": 0 },
              "offers": { "type": "integer", "minimum": 0, "maximum": 1 },
              "executions": { "type": "integer", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "sourceHostiles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inline-compute",
          "detached-blocking",
          "request-drop-cancel",
          "release-before-join",
          "publish-without-author-recheck",
          "duplicate-owner",
          "request-clock-heartbeat",
          "unrenewed-claim",
          "close-abort",
          "foreign-cancel"
        ]
      }
    }
  }
}
