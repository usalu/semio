{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/hub/directory/document-execution-target-lease-v1.json",
  "title": "DocumentExecutionTargetLeaseCorpusV1",
  "description": "Language-neutral corpus for the browser/native document execution-target lease: one positive verified GIS Map viewer vector with exact component and raw descriptor bytes, and the complete hostile matrix that must leave zero publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "nowMs",
    "hubOrigin",
    "intent",
    "plan",
    "manifest",
    "socketGrant",
    "componentHex",
    "descriptorHex",
    "expected",
    "hostile"
  ],
  "properties": {
    "schema": {
      "const": "semio.os.document-execution-target-lease-corpus/v1"
    },
    "version": {
      "const": 1
    },
    "nowMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "hubOrigin": {
      "type": "string",
      "pattern": "^https?://[^/]+$"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "scope",
        "requestedSurfaceId",
        "clientInstanceId"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.document-open-intent/v1"
        },
        "version": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "requestedSurfaceId": {
          "$ref": "#/$defs/id"
        },
        "clientInstanceId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "receipt",
        "expiresAtUnixMs",
        "scope",
        "descriptorDigestV1",
        "catalog",
        "package",
        "artifact",
        "parentDialect",
        "surface",
        "grant",
        "checkpoint",
        "revalidation"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.document-open-plan/v1"
        },
        "version": {
          "const": 1
        },
        "receipt": {
          "type": "string",
          "pattern": "^open\\.v1\\.[A-Za-z0-9_-]{43}$"
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "descriptorDigestV1": {
          "$ref": "#/$defs/hash"
        },
        "catalog": {
          "$ref": "#/$defs/catalog"
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "parentDialect": {
          "$ref": "#/$defs/parentDialect"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "revalidation": {
          "$ref": "#/$defs/revalidation"
        }
      }
    },
    "manifest": {
      "$ref": "#/$defs/leaseFields"
    },
    "socketGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "protocol",
        "grant",
        "actorId",
        "expiresAtMs"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.socket-grant/v1"
        },
        "protocol": {
          "const": "semio.socket.v1"
        },
        "grant": {
          "type": "string",
          "pattern": "^socket\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
        },
        "actorId": {
          "type": "string",
          "pattern": "^hub\\.v1\\.[0-9a-f]{64}$"
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "componentHex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})+$"
    },
    "descriptorHex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})+$"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetPaths",
        "assetMethod",
        "assetBody",
        "openPlanPath",
        "socketGrantPath",
        "componentMaxBytes",
        "descriptorMaxBytes",
        "manifestMaxBytes",
        "progressUnitBytes",
        "progressStages",
        "rendererState",
        "rendererClaims",
        "viewerWriteRejectedLocally",
        "forbiddenStatusFragments",
        "status",
        "statusRoles",
        "rotation"
      ],
      "properties": {
        "assetPaths": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^/spaces/[^/]+/documents/[^/]+/execution-target/(?:manifest|component|descriptor)$"
          }
        },
        "assetMethod": {
          "const": "POST"
        },
        "assetBody": {
          "const": "semio.hub.document-open-intent/v1"
        },
        "openPlanPath": {
          "type": "string",
          "minLength": 1
        },
        "socketGrantPath": {
          "type": "string",
          "minLength": 1
        },
        "componentMaxBytes": {
          "const": 67108864
        },
        "descriptorMaxBytes": {
          "const": 4194304
        },
        "manifestMaxBytes": {
          "const": 8192
        },
        "progressUnitBytes": {
          "const": 65536
        },
        "progressStages": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "enum": [
              "manifest",
              "component",
              "descriptor",
              "verify"
            ]
          }
        },
        "rendererState": {
          "const": "renderer-unavailable"
        },
        "rendererClaims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loadPluginModule",
            "activationRegistry",
            "wgpuScanner",
            "attachBackbone"
          ],
          "properties": {
            "loadPluginModule": {
              "const": false
            },
            "activationRegistry": {
              "const": false
            },
            "wgpuScanner": {
              "const": false
            },
            "attachBackbone": {
              "const": false
            }
          }
        },
        "viewerWriteRejectedLocally": {
          "const": true
        },
        "forbiddenStatusFragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verifying",
            "integrity-failed",
            "stale",
            "cancelled",
            "renderer-unavailable"
          ],
          "properties": {
            "verifying": {
              "$ref": "#/$defs/localizedText"
            },
            "integrity-failed": {
              "$ref": "#/$defs/localizedText"
            },
            "stale": {
              "$ref": "#/$defs/localizedText"
            },
            "cancelled": {
              "$ref": "#/$defs/localizedText"
            },
            "renderer-unavailable": {
              "$ref": "#/$defs/localizedText"
            }
          }
        },
        "statusRoles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verifying",
            "integrity-failed",
            "stale",
            "cancelled",
            "renderer-unavailable"
          ],
          "properties": {
            "verifying": {
              "enum": [
                "status",
                "alert"
              ]
            },
            "integrity-failed": {
              "enum": [
                "status",
                "alert"
              ]
            },
            "stale": {
              "enum": [
                "status",
                "alert"
              ]
            },
            "cancelled": {
              "enum": [
                "status",
                "alert"
              ]
            },
            "renderer-unavailable": {
              "enum": [
                "status",
                "alert"
              ]
            }
          }
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generationA",
            "generationB"
          ],
          "properties": {
            "generationA": {
              "$ref": "#/$defs/hash"
            },
            "generationB": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      }
    },
    "hostile": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "stage",
          "kind",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "manifest",
              "component",
              "descriptor",
              "verify",
              "exchange",
              "publication",
              "asset-request"
            ]
          },
          "kind": {
            "enum": [
              "manifest-field",
              "component-bytes",
              "component-truncated",
              "component-extra-byte",
              "component-max-plus-one",
              "descriptor-bytes",
              "descriptor-trailing-byte",
              "descriptor-noncanonical",
              "descriptor-self-hash",
              "descriptor-max-plus-one",
              "missing-body",
              "mixed-generation",
              "stale-plan",
              "cancel",
              "deadline",
              "reconnect-after-invalidation",
              "viewer-write",
              "caller-url",
              "caller-path",
              "caller-module"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "expected": {
            "const": "unpublished"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "hash": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId"
      ],
      "properties": {
        "spaceId": {
          "$ref": "#/$defs/id"
        },
        "documentId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generationId"
      ],
      "properties": {
        "generationId": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "packageId",
        "version",
        "componentSha256",
        "componentBlake3",
        "descriptorByteSha256"
      ],
      "properties": {
        "pluginId": {
          "$ref": "#/$defs/id"
        },
        "packageId": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/id"
        },
        "componentSha256": {
          "$ref": "#/$defs/hash"
        },
        "componentBlake3": {
          "$ref": "#/$defs/hash"
        },
        "descriptorByteSha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "packSchemaHash"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/id"
        },
        "schema": {
          "$ref": "#/$defs/id"
        },
        "packSchemaHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "parentDialect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "$ref": "#/$defs/id"
        },
        "standard": {
          "$ref": "#/$defs/id"
        },
        "subset": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceId",
        "appId",
        "windowKindId",
        "role",
        "rendererTarget"
      ],
      "properties": {
        "surfaceId": {
          "$ref": "#/$defs/id"
        },
        "appId": {
          "$ref": "#/$defs/id"
        },
        "windowKindId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "viewer",
            "editor"
          ]
        },
        "rendererTarget": {
          "enum": [
            "react",
            "wgpu",
            "wasm"
          ]
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "observe"
      ],
      "properties": {
        "read": {
          "const": true
        },
        "write": {
          "type": "boolean"
        },
        "observe": {
          "const": true
        }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "headEditOrdinal",
        "headEditId",
        "lastCommitSeq",
        "chainHash"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/id"
        },
        "headEditOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "headEditId": {
          "$ref": "#/$defs/id"
        },
        "lastCommitSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chainHash": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointId",
        "descriptorDigestV1",
        "baselineFrontier",
        "aggregateSha256"
      ],
      "properties": {
        "checkpointId": {
          "$ref": "#/$defs/hash"
        },
        "descriptorDigestV1": {
          "$ref": "#/$defs/hash"
        },
        "baselineFrontier": {
          "$ref": "#/$defs/frontier"
        },
        "aggregateSha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "revalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directoryRevision",
        "membershipGeneration"
      ],
      "properties": {
        "directoryRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "membershipGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sessionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "shareGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "leaseFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "scope",
        "descriptorDigestV1",
        "catalog",
        "package",
        "component",
        "descriptor",
        "artifact",
        "parentDialect",
        "surface",
        "grant",
        "checkpoint",
        "revalidation"
      ],
      "properties": {
        "schema": {
          "const": "semio.os.document-execution-target-lease/v1"
        },
        "version": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "descriptorDigestV1": {
          "$ref": "#/$defs/hash"
        },
        "catalog": {
          "$ref": "#/$defs/catalog"
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "blake3",
            "byteLength"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/hash"
            },
            "blake3": {
              "$ref": "#/$defs/hash"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        },
        "descriptor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "byteLength"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/hash"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            }
          }
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "parentDialect": {
          "$ref": "#/$defs/parentDialect"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "grant": {
          "$ref": "#/$defs/grant"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "revalidation": {
          "$ref": "#/$defs/revalidation"
        }
      }
    }
  }
}
