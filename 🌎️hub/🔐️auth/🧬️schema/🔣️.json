{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/hub/auth/schema.json",
  "$ref": "#/$defs/AuthCapabilityVectorsV1",
  "$defs": {
    "lowerHex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "lowerHex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "InviteCapabilityV1": {
      "type": "string",
      "minLength": 107,
      "maxLength": 107,
      "pattern": "^invite\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
    },
    "SessionCapabilityV1": {
      "type": "string",
      "minLength": 108,
      "maxLength": 108,
      "pattern": "^session\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
    },
    "ShareCapabilityV1": {
      "type": "string",
      "minLength": 106,
      "maxLength": 106,
      "pattern": "^share\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
    },
    "SocketGrantCapabilityV1": {
      "type": "string",
      "minLength": 107,
      "maxLength": 107,
      "pattern": "^socket\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
    },
    "CredentialHashV1": {
      "type": "string",
      "minLength": 32,
      "maxLength": 192,
      "pattern": "^pbkdf2-sha256\\$[1-9][0-9]{3,8}\\$[0-9a-f]{32}\\$[0-9a-f]{64}$"
    },
    "AuthErrorCodeV1": {
      "enum": [
        "malformed-request",
        "invalid-credentials",
        "credential-sign-in-disabled",
        "rate-limited",
        "directory-unavailable"
      ]
    },
    "AuthClientClassV1": {
      "enum": [
        "browser",
        "native",
        "cli"
      ]
    },
    "CredentialSignInRequestV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "email",
        "password",
        "deviceInstanceId",
        "clientClass"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.auth.credential-sign-in/v1"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "pattern": "^[^\\u0000-\\u0020@\\u007f]+@[^\\u0000-\\u0020@\\u007f]+$"
        },
        "password": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "deviceInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "clientClass": {
          "$ref": "#/$defs/AuthClientClassV1"
        }
      }
    },
    "CredentialChangeRequestV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "currentPassword",
        "newPassword"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.auth.credential-change/v1"
        },
        "currentPassword": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "newPassword": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        }
      }
    },
    "SessionMintResponseV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "user_id"
      ],
      "properties": {
        "token": {
          "$ref": "#/$defs/SessionCapabilityV1"
        },
        "user_id": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "AuthErrorV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.auth.error/v1"
        },
        "error": {
          "$ref": "#/$defs/AuthErrorCodeV1"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "AuthRateLimitClassV1": {
      "enum": [
        "auth",
        "directory-command",
        "invite-redemption",
        "socket-grant"
      ]
    },
    "AuthRateLimitPolicyV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "burst",
        "costMs"
      ],
      "properties": {
        "class": {
          "$ref": "#/$defs/AuthRateLimitClassV1"
        },
        "burst": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "costMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      }
    },
    "AuthDurableEventKindV1": {
      "enum": [
        "session-issued",
        "session-revoked",
        "credential-sign-in",
        "credential-changed",
        "agent-delegated",
        "agent-delegation-revoked",
        "agent-session-issued"
      ]
    },
    "AgentDelegationCapabilityV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "string",
      "pattern": "^delegation\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$",
      "description": "The one-time delegation token. Shown exactly once, at creation; never stored, never re-readable, never accepted anywhere a session or share is."
    },
    "AgentAudienceV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "enum": [
        "read",
        "edit"
      ],
      "description": "The closed capability audience a delegation is scoped to. `read` admits the agent as a spectator, `edit` as an author; there is no administrative audience."
    },
    "AgentErrorCodeV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "enum": [
        "malformed-request",
        "invalid-delegation",
        "delegation-revoked",
        "delegation-expired",
        "forbidden",
        "rate-limited",
        "directory-unavailable"
      ]
    },
    "AgentErrorV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "error"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.auth.agent-error/v1"
        },
        "error": {
          "$ref": "#/$defs/AgentErrorCodeV1"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CreateAgentDelegationRequestV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "spaceId",
        "agentLabel",
        "audience",
        "ttlSecs"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.auth.agent-delegation-create/v1"
        },
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "agentLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "audience": {
          "$ref": "#/$defs/AgentAudienceV1"
        },
        "ttlSecs": {
          "type": "integer",
          "minimum": 60,
          "maximum": 7776000
        }
      }
    },
    "AgentDelegationReceiptV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "delegationId",
        "agentPrincipalId",
        "agentLabel",
        "spaceId",
        "audience",
        "expiresAtMs",
        "token"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.auth.agent-delegation-receipt/v1"
        },
        "delegationId": {
          "$ref": "#/$defs/boundedText"
        },
        "agentPrincipalId": {
          "type": "string",
          "pattern": "^agent:.+$"
        },
        "agentLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "spaceId": {
          "$ref": "#/$defs/boundedText"
        },
        "audience": {
          "$ref": "#/$defs/AgentAudienceV1"
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "token": {
          "$ref": "#/$defs/AgentDelegationCapabilityV1"
        }
      }
    },
    "AgentDelegationSummaryV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegationId",
        "agentPrincipalId",
        "agentLabel",
        "spaceId",
        "audience",
        "createdAtMs",
        "expiresAtMs",
        "revoked",
        "lastUsedAtMs"
      ],
      "properties": {
        "delegationId": {
          "$ref": "#/$defs/boundedText"
        },
        "agentPrincipalId": {
          "type": "string",
          "pattern": "^agent:.+$"
        },
        "agentLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "spaceId": {
          "$ref": "#/$defs/boundedText"
        },
        "audience": {
          "$ref": "#/$defs/AgentAudienceV1"
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "revoked": {
          "type": "boolean"
        },
        "lastUsedAtMs": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      },
      "description": "A listing row. The selector, the secret digest and the token are structurally absent, not redacted later. `lastUsedAtMs` is derived from the agent sessions this delegation minted; null means it has never been exchanged."
    },
    "AgentDelegationListV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "delegations"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.auth.agent-delegation-list/v1"
        },
        "delegations": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/AgentDelegationSummaryV1"
          }
        }
      }
    },
    "AgentSessionRequestV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "audience",
        "agentInstanceId"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.auth.agent-session/v1"
        },
        "audience": {
          "$ref": "#/$defs/AgentAudienceV1"
        },
        "agentInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "description": "The delegation capability is the Authorization bearer, never a body field: it is a capability, and it travels where capabilities travel."
    },
    "AgentSessionMintResponseV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "token",
        "agentPrincipalId",
        "agentLabel",
        "spaceId",
        "audience",
        "expiresAtMs"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.auth.agent-session/v1"
        },
        "token": {
          "$ref": "#/$defs/SessionCapabilityV1"
        },
        "agentPrincipalId": {
          "type": "string",
          "pattern": "^agent:.+$"
        },
        "agentLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "spaceId": {
          "$ref": "#/$defs/boundedText"
        },
        "audience": {
          "$ref": "#/$defs/AgentAudienceV1"
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AgentCredentialFileV1": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "hubOrigin",
        "spaceId",
        "audience",
        "token"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.agent-credential/v1"
        },
        "hubOrigin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "spaceId": {
          "$ref": "#/$defs/boundedText"
        },
        "audience": {
          "$ref": "#/$defs/AgentAudienceV1"
        },
        "token": {
          "$ref": "#/$defs/AgentDelegationCapabilityV1"
        }
      },
      "description": "The 0600 file `semio-os-mcp --hub --credential-file <path>` reads. Mode, size (<=16 KiB), schema, audience, token shape and origin/space agreement are all checked before the first tool call."
    },
    "SocketGrantReceiptV1": {
      "x-semio-formats": [
        "🔣️jsonschema"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "protocol",
        "grant",
        "actorId",
        "expiresAtMs"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.socket-grant/v1"
        },
        "protocol": {
          "const": "semio.socket.v1"
        },
        "grant": {
          "$ref": "#/$defs/SocketGrantCapabilityV1"
        },
        "actorId": {
          "type": "string",
          "pattern": "^hub\\.v1\\.[0-9a-f]{64}$"
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "capabilityVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capability",
        "selector",
        "secretHex",
        "digestHex"
      ],
      "properties": {
        "kind": {
          "enum": [
            "session",
            "share",
            "invite"
          ]
        },
        "capability": {
          "type": "string",
          "minLength": 106,
          "maxLength": 108
        },
        "selector": {
          "$ref": "#/$defs/lowerHex32"
        },
        "secretHex": {
          "$ref": "#/$defs/lowerHex64"
        },
        "digestHex": {
          "$ref": "#/$defs/lowerHex64"
        }
      }
    },
    "socketGrantVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capability",
        "selector",
        "secretHex",
        "digestHex",
        "receipt",
        "rejectedCapabilities"
      ],
      "properties": {
        "kind": {
          "const": "socket"
        },
        "capability": {
          "$ref": "#/$defs/SocketGrantCapabilityV1"
        },
        "selector": {
          "$ref": "#/$defs/lowerHex32"
        },
        "secretHex": {
          "$ref": "#/$defs/lowerHex64"
        },
        "digestHex": {
          "$ref": "#/$defs/lowerHex64"
        },
        "receipt": {
          "$ref": "#/$defs/SocketGrantReceiptV1"
        },
        "rejectedCapabilities": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "identityVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "subject",
        "digestHex"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/boundedText"
        },
        "subject": {
          "$ref": "#/$defs/boundedText"
        },
        "digestHex": {
          "$ref": "#/$defs/lowerHex64"
        }
      }
    },
    "revocationVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "previousGeneration",
        "nextGeneration",
        "revokedAt",
        "reason"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/boundedText"
        },
        "previousGeneration": {
          "const": 1
        },
        "nextGeneration": {
          "const": 2
        },
        "revokedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "auditVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventKind",
        "authSessionId",
        "targetUserId",
        "provider",
        "outcomeCode",
        "reasonCode",
        "correlationId",
        "peerClass"
      ],
      "properties": {
        "eventKind": {
          "const": "session-revoked"
        },
        "authSessionId": {
          "$ref": "#/$defs/boundedText"
        },
        "targetUserId": {
          "$ref": "#/$defs/boundedText"
        },
        "provider": {
          "$ref": "#/$defs/boundedText"
        },
        "outcomeCode": {
          "const": "success"
        },
        "reasonCode": {
          "$ref": "#/$defs/boundedText"
        },
        "correlationId": {
          "$ref": "#/$defs/boundedText"
        },
        "peerClass": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "AuthLimitsV1": {
      "x-semio-formats": [
        "🔣️jsonschema"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectorBytes",
        "secretBytes",
        "ttlSecondsMax",
        "deviceIdentityBytesMax",
        "assertionBytesMax"
      ],
      "properties": {
        "selectorBytes": {
          "const": 16
        },
        "secretBytes": {
          "const": 32
        },
        "ttlSecondsMax": {
          "const": 31536000
        },
        "deviceIdentityBytesMax": {
          "const": 128
        },
        "assertionBytesMax": {
          "const": 16384
        }
      }
    },
    "AuthCapabilityVectorsV1": {
      "x-semio-formats": [
        "🔣️jsonschema"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "share",
        "invite",
        "socket",
        "identity",
        "revocation",
        "audit",
        "limits"
      ],
      "properties": {
        "session": {
          "$ref": "#/$defs/capabilityVector"
        },
        "share": {
          "$ref": "#/$defs/capabilityVector"
        },
        "invite": {
          "$ref": "#/$defs/capabilityVector"
        },
        "socket": {
          "$ref": "#/$defs/socketGrantVector"
        },
        "identity": {
          "$ref": "#/$defs/identityVector"
        },
        "revocation": {
          "$ref": "#/$defs/revocationVector"
        },
        "audit": {
          "$ref": "#/$defs/auditVector"
        },
        "limits": {
          "$ref": "#/$defs/AuthLimitsV1"
        }
      },
      "allOf": [
        {
          "type": "object",
          "properties": {
            "session": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "session"
                },
                "capability": {
                  "$ref": "#/$defs/SessionCapabilityV1"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "share": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "share"
                },
                "capability": {
                  "$ref": "#/$defs/ShareCapabilityV1"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "invite": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "invite"
                },
                "capability": {
                  "$ref": "#/$defs/InviteCapabilityV1"
                }
              }
            }
          }
        }
      ]
    }
  }
}
