{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/mit-bestand/bericht/documents/schema.json",
  "title": "ReportDocumentCatalog",
  "description": "Every report document owned by the mit-bestand report product.",
  "$ref": "#/$defs/ReportDocumentCatalog",
  "$defs": {
    "ReportDocumentCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "documents"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ReportDocumentEntry"
          }
        }
      }
    },
    "ReportDocumentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "texPath",
        "sources",
        "actorNetwork"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "texPath": {
          "type": "string",
          "pattern": "^[^/\\\\]+/[^/\\\\]+\\.tex$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actorNetwork": {
          "type": "boolean"
        }
      }
    }
  }
}
