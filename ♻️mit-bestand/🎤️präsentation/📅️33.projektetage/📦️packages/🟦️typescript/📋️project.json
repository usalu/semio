{
  "name": "@semio-tech/mit-bestand-praesentation-projektetage",
  "$schema": "../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎨️styling/🏗️builder/🌐️vite/🟦️.ts",
      "{workspaceRoot}/♻️mit-bestand/🎤️präsentation/📅️33.projektetage/🏗️builder/🌐️vite/🟦️.ts",
      "{workspaceRoot}/♻️mit-bestand/🎤️präsentation/📅️33.projektetage/slide/**/*.ts",
      "{workspaceRoot}/♻️mit-bestand/🎤️präsentation/📅️33.projektetage/🌐️public/**/*",
      "{workspaceRoot}/♻️mit-bestand/🎤️präsentation/📅️33.projektetage/🧪️tests/🎚️config/🟦️.ts"
    ]
  },
  "targets": {
    "dev": {
      "metadata": {
        "semio": {
          "dashboard": {
            "ready": {
              "port": 6050,
              "portEnv": "PRAESENTATION_PROJEKTETAGE_PORT"
            }
          }
        }
      },
      "executor": "repo:script",
      "dependsOn": [],
      "options": {
        "cwd": "♻️mit-bestand/🎤️präsentation/📅️33.projektetage/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts dev",
        "env": {
          "PRAESENTATION_PROJEKTETAGE_PORT": "6050",
          "NODE_OPTIONS": "",
          "SEMIO_BUILD_DYNAMIC_OUTPUT": "false",
          "SEMIO_BUILD_TERMINAL": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      },
      "cache": false,
      "continuous": true
    },
    "build": {
      "executor": "repo:script",
      "dependsOn": [],
      "options": {
        "cwd": "♻️mit-bestand/🎤️präsentation/📅️33.projektetage/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/{options.env.SEMIO_BUILD_MODE}"
      ]
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "♻️mit-bestand/🎤️präsentation/📅️33.projektetage/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "canonical-architecture": {
      "executor": "repo:script",
      "options": {
        "cwd": "♻️mit-bestand/🎤️präsentation/📅️33.projektetage/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test long \"../../🧪️tests/🎞️react-deck/🟦️.tsx\"",
        "forwardAllArgs": true
      }
    }
  }
}
