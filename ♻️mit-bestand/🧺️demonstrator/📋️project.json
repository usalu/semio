{
  "name": "@semio-tech/mit-bestand-demonstrator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "prepare-dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "@semio-tech/framework-os-dev:prepare-aggregator-react-dev",
        "@semio-tech/framework-os-dev:prepare-aussuchen-react-dev",
        "@semio-tech/framework-os-dev:prepare-bearbeiten-react-dev",
        "@semio-tech/framework-os-dev:prepare-generation3d-react-dev",
        "@semio-tech/framework-os-dev:prepare-generator-react-dev",
        "@semio-tech/framework-os-dev:prepare-koordinator-react-dev",
        "@semio-tech/framework-os-dev:prepare-verfolgen-react-dev"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts prepare dev",
        "forwardAllArgs": false
      }
    },
    "prepare-release": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "@semio-tech/framework-os-dev:prepare-aggregator-react-release",
        "@semio-tech/framework-os-dev:prepare-aussuchen-react-release",
        "@semio-tech/framework-os-dev:prepare-bearbeiten-react-release",
        "@semio-tech/framework-os-dev:prepare-generation3d-react-release",
        "@semio-tech/framework-os-dev:prepare-generator-react-release",
        "@semio-tech/framework-os-dev:prepare-koordinator-react-release",
        "@semio-tech/framework-os-dev:prepare-verfolgen-react-release"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts prepare release",
        "forwardAllArgs": false
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "activate-dev"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts serve",
        "env": {
          "MIT_BESTAND_DEMONSTRATOR_PORT": "6029",
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": false
      },
      "cache": false,
      "continuous": true,
      "outputs": []
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prepare-release"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/📦️site/📜️script.ts build",
        "forwardAllArgs": false
      },
      "cache": false,
      "outputs": [
        "{projectRoot}/dist/site"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "activate-dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "prepare-dev",
        "@semio-tech/framework-os-dev:activate-generator-react-dev"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts activate",
        "forwardAllArgs": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts serve",
        "forwardAllArgs": false
      },
      "cache": false,
      "continuous": true,
      "outputs": [],
      "dependsOn": [
        "activate-dev"
      ]
    },
    "prepare-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "activate-dev",
        "workspace:deps-browsers"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts prepare-test",
        "forwardAllArgs": false
      }
    },
    "serve-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "prepare-e2e"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts serve-test",
        "forwardAllArgs": false
      },
      "continuous": true,
      "metadata": {
        "semio": {
          "continuousSharing": false
        }
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "serve-e2e"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧪️e2e/📜️script.ts test",
        "forwardAllArgs": false
      }
    }
  }
}
