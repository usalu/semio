{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "message",
          "significant"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          },
          "significant": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
