{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objectId",
    "name",
    "availability",
    "steps",
    "revisit"
  ],
  "properties": {
    "objectId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "availability": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "count"
        ],
        "properties": {
          "action": {
            "enum": [
              "increment",
              "undo",
              "redo",
              "keyboardIncrement",
              "remove"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "revisit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viaPane",
        "offscreenMs",
        "afterRedoCount",
        "afterUndoCount"
      ],
      "properties": {
        "viaPane": {
          "const": "bearbeiten"
        },
        "offscreenMs": {
          "type": "integer",
          "minimum": 30001
        },
        "afterRedoCount": {
          "type": "integer",
          "minimum": 0
        },
        "afterUndoCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
