{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "origin",
    "mount",
    "files",
    "cases",
    "workerBases",
    "owners"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "mount": {
      "type": "string",
      "pattern": "^/.*/$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "documentBase",
          "input",
          "output",
          "oracle",
          "serve"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "documentBase": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "oracle": {
            "type": "boolean"
          },
          "serve": {
            "type": "boolean"
          }
        }
      }
    },
    "workerBases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "moduleUrl",
          "production",
          "base"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "moduleUrl": {
            "type": "string",
            "minLength": 1
          },
          "production": {
            "type": "boolean"
          },
          "base": {
            "type": "string",
            "pattern": "^/.*/$|^/$"
          }
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentBase",
        "shardWorker",
        "packageAsset",
        "brandLogo"
      ],
      "properties": {
        "documentBase": {
          "type": "string"
        },
        "shardWorker": {
          "type": "string"
        },
        "packageAsset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        },
        "brandLogo": {
          "type": "string"
        }
      }
    }
  }
}
