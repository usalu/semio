{
  "version": 1,
  "catalog": "♻️mit-bestand/🧺️demonstrator/🔨️modules/🌐️locale/🔣️.json",
  "schema": "♻️mit-bestand/🧺️demonstrator/🔨️modules/🌐️locale/🧬️schema/🔣️.json",
  "html": "♻️mit-bestand/🧺️demonstrator/🌐️.html",
  "componentSources": [
    "♻️mit-bestand/🧺️demonstrator/🟦️.tsx",
    "♻️mit-bestand/🧺️demonstrator/⚛️demonstrator-card.tsx",
