{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DemonstratorExampleContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "catalogueRows"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paneId",
          "brand",
          "exampleId",
          "source"
        ],
        "properties": {
          "paneId": {
            "type": "string",
            "minLength": 1
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "exampleId": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "catalogueRows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paneId",
          "editsKey",
          "rowId",
          "kind",
          "needle",
          "source"
        ],
        "properties": {
          "paneId": {
            "type": "string",
            "minLength": 1
          },
          "editsKey": {
            "type": "string",
            "minLength": 1
          },
          "rowId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "dsl-object-id",
              "cad-typology"
            ]
          },
          "needle": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
