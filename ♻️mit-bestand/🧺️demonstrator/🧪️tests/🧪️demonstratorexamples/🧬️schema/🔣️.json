{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DemonstratorExampleContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paneId",
          "brand",
          "exampleId",
          "source"
        ],
        "properties": {
          "paneId": {
            "type": "string",
            "minLength": 1
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "exampleId": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
