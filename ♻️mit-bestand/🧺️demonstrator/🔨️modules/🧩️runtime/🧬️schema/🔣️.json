{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/mit-bestand/demonstrator/runtime/schema.json",
  "title": "DemonstratorRuntimeCatalog",
  "description": "Panes, runtime variants and the build pipeline the mit-bestand demonstrator boots.",
  "$ref": "#/$defs/DemonstratorRuntimeCatalog",
  "$defs": {
    "DemonstratorRuntimeCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "host",
        "assetsDirectory",
        "panes"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "assetsDirectory": {
          "type": "string",
          "minLength": 1
        },
        "panes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/DemonstratorRuntimePane"
          }
        }
      }
    },
    "DemonstratorRuntimePane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "runtimeVariant"
      ],
      "properties": {
        "variant": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "runtimeVariant": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "DemonstratorPipelineContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profiles",
        "variants",
        "preparationProject",
        "wasmTargets",
        "primaryVariant",
        "command",
        "forbiddenCommandImports",
        "forbiddenOrchestration",
        "site",
        "development",
        "e2e"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "profiles": {
          "const": [
            "prototype",
            "release"
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "preparationProject": {
          "type": "string",
          "minLength": 1
        },
        "wasmTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^:]+:wasm$"
          }
        },
        "primaryVariant": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "pattern": "📜️script\\.ts$"
        },
        "forbiddenCommandImports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenOrchestration": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "site": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "output",
            "owner",
            "profile",
            "artifactTargets"
          ],
          "properties": {
            "command": {
              "type": "string",
              "pattern": "📜️script\\.ts$"
            },
            "output": {
              "const": "dist/release/site"
            },
            "owner": {
              "const": "demonstrator:site"
            },
            "profile": {
              "const": "release"
            },
            "artifactTargets": {
              "const": [
                "semio-framework-os-flow-browser-package:wasm",
                "semio-framework-canvas:stage-runtime-assets"
              ]
            }
          }
        },
        "development": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activationTarget",
            "watchTarget",
            "port"
          ],
          "properties": {
            "activationTarget": {
              "type": "string",
              "minLength": 1
            },
            "watchTarget": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "e2e": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "directory",
            "testCommand",
            "browserTarget"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "directory": {
              "type": "string",
              "minLength": 1
            },
            "testCommand": {
              "type": "string",
              "minLength": 1
            },
            "browserTarget": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "DemonstratorRuntimeTestContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "target",
        "executionVersion",
        "executionKind",
        "observation",
        "command",
        "route",
        "runtimeSourceEntries",
        "dependsOn",
        "runtimeImports"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "target": {
          "const": "test-runtime-catalog"
        },
        "executionVersion": {
          "const": 1
        },
        "executionKind": {
          "const": "source"
        },
        "observation": {
          "const": "freshness"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "runtimeSourceEntries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\{projectRoot\\}/.+\\.ts$"
          }
        },
        "dependsOn": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "@semio-tech/s-dev-composition:generate"
          }
        },
        "runtimeImports": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.\\./.+\\.ts$"
          }
        }
      }
    }
  }
}
