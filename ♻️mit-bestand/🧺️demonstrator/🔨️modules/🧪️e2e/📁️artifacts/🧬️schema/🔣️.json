{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/mit-bestand/demonstrator/e2e/artifacts.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maxPathChars",
    "reservedSuffixChars",
    "maxTitleChars",
    "maxCases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "maxPathChars": {
      "const": 256
    },
    "reservedSuffixChars": {
      "const": 103
    },
    "maxTitleChars": {
      "const": 24
    },
    "maxCases": {
      "const": 32
    }
  },
  "$defs": {
    "Cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sessionId",
        "sessionDirectory",
        "projects",
        "retries",
        "titles",
        "directFiles",
        "invalidSessionIds",
        "workerFiles",
        "platformRoots"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "sessionDirectory": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "retries": {
          "const": 2
        },
        "titles": {
          "type": "array",
          "minItems": 15,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[a-z][a-z -]*$"
          }
        },
        "directFiles": {
          "const": [
            "trace.zip",
            "error-context.md",
            "p.png"
          ]
        },
        "invalidSessionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "workerFiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 102
          }
        },
        "projects": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "locale",
              "texts"
            ],
            "properties": {
              "name": {
                "enum": [
                  "en",
                  "de"
                ]
              },
              "locale": {
                "enum": [
                  "en-US",
                  "de-DE"
                ]
              },
              "texts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "noSelection",
                  "remove",
                  "noRun",
                  "play",
                  "enabled",
                  "caption",
                  "finalized",
                  "aborted",
                  "finalStep",
                  "acceptedResult",
                  "noResult"
                ],
                "properties": {
                  "noSelection": {
                    "type": "string",
                    "minLength": 1
                  },
                  "remove": {
                    "type": "string",
                    "minLength": 1
                  },
                  "noRun": {
                    "type": "string",
                    "minLength": 1
                  },
                  "play": {
                    "type": "string",
                    "minLength": 1
                  },
                  "enabled": {
                    "type": "string",
                    "minLength": 1
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1
                  },
                  "finalized": {
                    "type": "string",
                    "minLength": 1
                  },
                  "aborted": {
                    "type": "string",
                    "minLength": 1
                  },
                  "finalStep": {
                    "type": "string",
                    "minLength": 1
                  },
                  "acceptedResult": {
                    "type": "string",
                    "minLength": 1
                  },
                  "noResult": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "platformRoots": {
          "const": [
            {
              "platform": "macos-linux",
              "ticketRootChars": 105,
              "outputRootChars": 151
            },
            {
              "platform": "windows",
              "ticketRootChars": 107,
              "outputRootChars": 153
            }
          ]
        }
      }
    }
  }
}
