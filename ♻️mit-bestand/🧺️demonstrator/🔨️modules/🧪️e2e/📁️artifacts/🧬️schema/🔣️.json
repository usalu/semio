{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/mit-bestand/demonstrator/e2e/artifacts.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maxPathChars",
    "reservedSuffixChars",
    "maxTitleChars",
    "namespace",
    "maxCases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "maxPathChars": {
      "const": 256
    },
    "reservedSuffixChars": {
      "const": 102
    },
    "maxTitleChars": {
      "const": 24
    },
    "namespace": {
      "const": "e"
    },
    "maxCases": {
      "const": 32
    }
  },
  "$defs": {
    "Cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sessionId",
        "sessionDirectory",
        "project",
        "retries",
        "titles",
        "directFiles",
        "invalidSessionIds",
        "workerFiles"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "sessionDirectory": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "project": {
          "const": "chromium"
        },
        "retries": {
          "const": 2
        },
        "titles": {
          "type": "array",
          "minItems": 15,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "^[a-z][a-z -]*$"
          }
        },
        "directFiles": {
          "const": [
            "trace.zip",
            "error-context.md",
            "p.png"
          ]
        },
        "invalidSessionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "workerFiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 101
          }
        }
      }
    }
  }
}
