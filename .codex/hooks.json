{
  "hooks": {
    "agent.ended": "./semio-repo/cli/cli hook agent.ended codex",
    "agent.starting": "./semio-repo/cli/cli hook agent.starting codex",
    "code.edited": "./semio-repo/cli/cli hook code.edited codex --file \"$FILE\"",
    "code.reading": "./semio-repo/cli/cli hook code.reading codex --file \"$FILE\"",
    "compacting": "./semio-repo/cli/cli hook compacting codex",
    "notification": "./semio-repo/cli/cli hook notification codex",
    "prompt.submit": "./semio-repo/cli/cli hook prompt.submit codex",
    "tool.calling": "./semio-repo/cli/cli hook tool.calling codex --tool-name \"$TOOL\" --tool-args \"$ARGS\"",
    "tool.ended": "./semio-repo/cli/cli hook tool.ended codex --tool-name \"$TOOL\""
  }
}