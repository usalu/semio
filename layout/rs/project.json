{
  "name": "@semio-tech/layout-rs",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "layout/rs",
        "command": "bun ./script.ts wasm"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "layout/rs",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
