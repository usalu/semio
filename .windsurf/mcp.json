{
  "mcpServers": {
    "playwright-test": {
      "command": "npx",
      "args": [
        "playwright",
        "run-test-mcp-server"
      ],
      "disabled": false
    },
    "repo": {
      "command": "./repo/cli/cli",
      "args": [
        "mcp"
      ],
      "disabled": false
    },
    "semio": {
      "command": "uv",
      "args": [
        "--directory",
        "semio/engine",
        "run",
        "main.py",
        "--mcp-stdio"
      ],
      "disabled": false
    },
    "coda": {
      "command": "uv",
      "args": [
        "--directory",
        "coda/engine",
        "run",
        "coda.py",
        "--mcp-stdio"
      ],
      "disabled": false
    }
  }
}