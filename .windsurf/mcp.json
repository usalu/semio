{
  "mcpServers": {
    "repo": {
      "type": "stdio",
      "command": "go",
      "args": [
        "run",
        "./repo/mcp"
      ],
      "disabled": false
    },
    "neo4j-semio": {
      "type": "stdio",
      "command": "bun",
      "args": ["dev.neo4j.mcp.script.ts", "semio"],
      "disabled": false
    },
    "neo4j-elements": {
      "type": "stdio",
      "command": "bun",
      "args": ["dev.neo4j.mcp.script.ts", "elements"],
      "disabled": false
    },
    "neo4j-coda": {
      "type": "stdio",
      "command": "bun",
      "args": ["dev.neo4j.mcp.script.ts", "coda"],
      "disabled": false
    },
    "neo4j-reuse": {
      "type": "stdio",
      "command": "bun",
      "args": ["dev.neo4j.mcp.script.ts", "reuse"],
      "disabled": false
    }
  }
}
