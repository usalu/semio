{
  "mcpServers": {
    "repo": {
      "type": "stdio",
      "command": "go",
      "args": [
        "run",
        "./repo/mcp"
      ],
      "disabled": false
    },
    "neo4j-semio": {
      "type": "stdio",
      "command": "bash",
      "args": ["./.devcontainer/neo4j-mcp-run.sh", "semio"],
      "disabled": false
    },
    "neo4j-elements": {
      "type": "stdio",
      "command": "bash",
      "args": ["./.devcontainer/neo4j-mcp-run.sh", "elements"],
      "disabled": false
    },
    "neo4j-coda": {
      "type": "stdio",
      "command": "bash",
      "args": ["./.devcontainer/neo4j-mcp-run.sh", "coda"],
      "disabled": false
    },
    "neo4j-reuse": {
      "type": "stdio",
      "command": "bash",
      "args": ["./.devcontainer/neo4j-mcp-run.sh", "reuse"],
      "disabled": false
    }
  }
}
