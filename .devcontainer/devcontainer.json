{
  "name": "semio",
  "dockerComposeFile": "docker-compose.yml",
  "service": "semio",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26"
    },
    "ghcr.io/devcontainers-community/npm-features/prettier:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    },
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {
      "version": "0.11.6"
    },
    "ghcr.io/jsburckhardt/devcontainer-features/ruff:1": {
      "version": "0.15.10"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0",
      "additionalVersions": "9.0 10.0"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "none"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "2.53"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/warrenbuckley/codespace-features/sqlite:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "workspaceFolder": "/workspaces/semio",
  "onCreateCommand": ["sudo", "chown", "vscode:vscode", "/workspaces/semio/node_modules", "/workspaces/semio/.🧬semio/🦑️repo/⚡️cache", "/workspaces/semio/.cache"],
  "postCreateCommand": ["bun", "repo", "run", "workspace:setup"],
  "postStartCommand": ["repo", "run", "workspace:setup-devcontainer-start"],
  "postAttachCommand": ["repo", "run", "workspace:setup-devcontainer-attach"],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "128gb"
  },
  "forwardPorts": [8787, 6070, 6072, 6073, 6066, 6067, 6068, 6010, 6274, 6277],
  "portsAttributes": {
    "8787": {
      "label": "os-hub",
      "onAutoForward": "notify"
    },
    "6070": {
      "label": "s React",
      "onAutoForward": "notify"
    },
    "6072": {
      "label": "s React user 1",
      "onAutoForward": "silent"
    },
    "6073": {
      "label": "s React user 2",
      "onAutoForward": "silent"
    },
    "6066": {
      "label": "s wgpu",
      "onAutoForward": "notify"
    },
    "6067": {
      "label": "s wgpu user 1",
      "onAutoForward": "silent"
    },
    "6068": {
      "label": "s wgpu user 2",
      "onAutoForward": "silent"
    },
    "6010": {
      "label": "Storybook",
      "onAutoForward": "notify"
    },
    "6274": {
      "label": "MCP Inspector",
      "onAutoForward": "notify"
    },
    "6277": {
      "label": "MCP Inspector Proxy",
      "onAutoForward": "silent"
    }
  },
  "mounts": [
    "source=semio-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-claude,target=/home/vscode/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-codex,target=/home/vscode/.codex,type=volume",
    "source=${localWorkspaceFolderBasename}-config-gh,target=/home/vscode/.config/gh,type=volume",
    "source=${localWorkspaceFolderBasename}-config-openai,target=/home/vscode/.config/openai,type=volume",
    "source=${localWorkspaceFolderBasename}-gitkraken-desktop,target=/home/vscode/.gitkraken,type=volume",
    "source=${localWorkspaceFolderBasename}-gitkraken-cli,target=/home/vscode/.local/share/GitKrakenCLI,type=volume",
    "source=${localWorkspaceFolderBasename}-gitkraken-workspaces,target=/home/vscode/.local/share/gk,type=volume",
    "source=${localWorkspaceFolderBasename}-f3d,target=/home/vscode/.config/F3D,type=volume",
    "source=semio-cache-${devcontainerId},target=${containerWorkspaceFolder}/.🧬semio/🦑️repo/⚡️cache,type=volume",
    "source=semio-native-cache-${devcontainerId},target=${containerWorkspaceFolder}/.cache,type=volume"
  ],
  "remoteUser": "vscode",
  "containerEnv": {
    "DEVCONTAINER": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "PLAYWRIGHT_BROWSERS_PATH": "${containerWorkspaceFolder}/.🧬semio/🦑️repo/⚡️cache/tools/ms-playwright",
    "SEMIO_GITKRAKEN_WORKSPACE_NAME": "semio",
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "LC_CTYPE": "en_US.UTF-8",
    "DISPLAY": ":99",
    "ELECTRON_DISABLE_SANDBOX": "1"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}",
    "PLAYWRIGHT_BROWSERS_PATH": "${containerWorkspaceFolder}/.🧬semio/🦑️repo/⚡️cache/tools/ms-playwright",
    "SSH_AUTH_SOCK": "/home/vscode/.ssh/semio-ssh-agent.sock"
  }
}
