      "lines": [
        "//! A leaf never writes `&mut` into a snapshot, never calls `.apply(` nor `between(`, never clones base.",
        "use protocol::{ApplyCapability, MutationDiff};",
        "pub fn diff(payload: &P, base: &S) -> protocol::MutationOutcome<D> {",
        "    let mut rows = Vec::new();",
        "    let owned = payload.clone();",
        "    let label = \"base.clone() and .apply( and &mut inside a string\";",
        "    rows.push(owned);",
        "    protocol::MutationOutcome::new(D::from_rows(rows))",
        "}",
        "pub fn inverse(payload: &P, base: &S) -> Result<Vec<M>, E> {",
        "    Ok(vec![M::set_name(base.name.clone())])",
        "}",
        "impl MutationDiff<S> for D {",
        "    fn apply(&self, base: &S, capability: ApplyCapability) -> R { self.inner.apply(base, capability) }",
        "    fn inverse(&self, base: &S) -> Self { Self::between(base, base) }",
        "    fn between(base: &S, other: &S) -> Self { D::default() }",
        "}",
        "#[cfg(test)]",
        "mod tests {",
        "    fn law() { let mut next = base.clone(); D::between(&a, &b).apply(&a, c); }",
        "}"
      ],
