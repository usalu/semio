{
	"servers": {
		"playwright-test": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"playwright",
				"run-test-mcp-server"
			]
		},
		"semio-repo": {
			"type": "stdio",
			"command": "./semio-repo/cli/cli",
			"args": [
				"mcp"
			]
		},
		"semio": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"--directory",
				"semio/engine",
				"run",
				"engine.py",
				"--mcp-stdio"
			]
		},
		"coda": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"--directory",
				"semio-coda/py",
				"run",
				"coda.py",
				"--mcp-stdio"
			]
		}
	},
	"inputs": []
}
