{
	"inputs": [],
	"servers": {
		"repo": {
			"type": "stdio",
			"command": "go",
			"args": [
				"run",
				"./repo/cli",
				"mcp"
			]
		},
		"semio": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"--directory",
				"semio/engine",
				"run",
				"main.py",
				"--mcp-stdio"
			]
		},
		"coda": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"--directory",
				"coda/engine",
				"run",
				"coda.py",
				"--mcp-stdio"
			]
		}
	}
}
