{
	"inputs": [],
	"servers": {
		"repo": {
			"type": "stdio",
			"command": "./repo/cli/cli",
			"args": [
				"mcp"
			]
		},
		"semio": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"--directory",
				"semio/engine",
				"run",
				"engine.py",
				"--mcp-stdio"
			]
		},
		"coda": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"--directory",
				"coda/py",
				"run",
				"coda.py",
				"--mcp-stdio"
			]
		}
	}
}