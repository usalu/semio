    // ========================================
    {
      "label": "dev",
      "type": "shell",
      "command": "npx nx run-many -t dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting debugpy for semio engine",
          "endsPattern": "Waiting for debugger to attach to semio engine"
        }
      },
      "group": "none"
    },
