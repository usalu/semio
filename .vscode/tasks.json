{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📚 Storybook Dev",
      "type": "shell",
      "command": "bun run dev:storybook",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "STORYBOOK_PORT": "6010"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "none"
    },
    {
      "label": "📚 Storybook Build",
      "type": "shell",
      "command": "bun run build:storybook",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "STORYBOOK_PORT": "6010"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "📚 Storybook Static Serve",
      "type": "shell",
      "command": "bun ./dev.script.ts storybook-static",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "STORYBOOK_PORT": "6010"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "none"
    },
    {
      "label": "📚 Storybook Playwright",
      "type": "shell",
      "command": "bun run test:storybook",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "STORYBOOK_PORT": "6010",
          "PLAYWRIGHT_BROWSERS_PATH": "${workspaceFolder}/node_modules/.cache/ms-playwright"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    }
  ]
}
