          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*building",
          "endsPattern": ".*built in.*"
        }
      },
      "isBackground": true,
      "presentation": {
