{
  "playwright.reuseBrowser": false,
  "playwright.showTrace": true,
  "playwright.useTestServer": false,
  "playwright.runOptions": {
    "headless": true
  },
  "playwright.env": {
    "PWDEBUG": "console"
  },
  "eslint.useFlatConfig": true,
  "eslint.packageManager": "npm",
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": [
    {
      "directory": "elements/ui",
      "changeProcessCWD": true
    },
    {
      "directory": "repo/vscode",
      "changeProcessCWD": true
    }
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "workbench.externalBrowser": "chrome",
  "workbench.trustedDomains": [
    "*"
  ],
  "remote.autoForwardPorts": true,
  "remote.portsAttributes": {
    "6274": {
      "label": "MCP Inspector UI",
      "onAutoForward": "openBrowser"
    },
    "6277": {
      "label": "MCP Inspector Proxy",
      "onAutoForward": "silent"
    }
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.configPath": ".prettierrc.json",
  "prettier.ignorePath": ".prettierignore",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "python.analysis.typeCheckingMode": "off",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "--rootdir=${workspaceFolder}",
    "semio/py",
    "semio/engine"
  ],
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.analysis.languageServerMode": "full",
  "sqltools.useNodeRuntime": true,
  "sqltools.connections": [
    {
      "name": "metabolism",
      "database": "./examples/metabolism/.semio/kit.db",
      "driver": "SQLite",
      "previewLimit": 50
    }
  ],
  "dotnet.defaultSolution": "Monorepo.sln",
  "chat.agent.maxRequests": 5000,
  "editor.minimap.enabled": true,
  "[svg]": {
    "editor.defaultFormatter": "jock.svg"
  },
  "rust-analyzer.linkedProjects": [
    "semio/rs/Cargo.toml"
  ],
  "rust-analyzer.testExplorer": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".agents/skills/committing.SKILL.md"
    }
  ],
  "chat.subagents.allowInvocationsFromSubagents": false,
  "python.terminal.activateEnvironment": false,
  "kiroAgent.configureMCP": "Disabled"
}
