{
  "git.enabled": false,
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.decorations.enabled": false,
  "git.timeline.showUncommitted": false,
  "extensions.showRecommendationsOnlyOnDemand": false,
  "playwright.reuseBrowser": false,
  "playwright.showTrace": true,
  "playwright.useTestServer": false,
  "playwright.runOptions": {
    "headless": true
  },
  "playwright.env": {
    "PWDEBUG": "console"
  },
  "eslint.useFlatConfig": true,
  "eslint.packageManager": "bun",
  "eslint.options": {
    "overrideConfigFile": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🧹️lint/📐️source-policy/🟨️.mjs"
  },
  "terminal.integrated.env.windows": {
    "NX_VERBOSE_LOGGING": "false",
    "NX_PERF_LOGGING": "false",
    "NX_NATIVE_LOGGING": "nx=warn",
    "NX_WORKSPACE_DATA_DIRECTORY": "${workspaceFolder}/.nx/workspace-data"
  },
  "terminal.integrated.env.linux": {
    "NX_VERBOSE_LOGGING": "false",
    "NX_PERF_LOGGING": "false",
    "NX_NATIVE_LOGGING": "nx=warn",
    "NX_WORKSPACE_DATA_DIRECTORY": "${workspaceFolder}/.nx/workspace-data"
  },
  "terminal.integrated.env.osx": {
    "NX_VERBOSE_LOGGING": "false",
    "NX_PERF_LOGGING": "false",
    "NX_NATIVE_LOGGING": "nx=warn",
    "NX_WORKSPACE_DATA_DIRECTORY": "${workspaceFolder}/.nx/workspace-data"
  },
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.workingDirectories": [
    {
      "directory": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🧩️vscode/📦️packages/🟦️typescript",
      "changeProcessCWD": true
    }
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "always"
  },
  "workbench.externalBrowser": "chrome",
  "workbench.trustedDomains": ["*"],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.configPath": ".prettierrc.json",
  "prettier.ignorePath": ".prettierignore",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "python.analysis.typeCheckingMode": "off",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["--rootdir=${workspaceFolder}"],
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.analysis.languageServerMode": "full",
  "dotnet.defaultSolution": "Monorepo.sln",
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "cmake.buildDirectory": "${workspaceFolder}/.🧬semio/🦑️repo/⚡️cache/cmake/${presetName}",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "chat.agent.maxRequests": 5000,
  "editor.minimap.enabled": true,
  "[svg]": {
    "editor.defaultFormatter": "jock.svg"
  },
  "rust-analyzer.linkedProjects": ["Cargo.toml"],
  "rust-analyzer.testExplorer": true,
  "vitest.enable": true,
  "vitest.configSearchPatternInclude": "**/🧪️tests/🎚️config/🟦️.ts",
  "tailwindCSS.experimental.configFile": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/💨️tailwind/🟦️.ts",
  "terminal.integrated.defaultProfile.linux": "bash",
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".agents/skills/commit/SKILL.md"
    }
  ],
  "chat.subagents.allowInvocationsFromSubagents": false,
  "python.terminal.activateEnvironment": false,
  "kiroAgent.configureMCP": "Disabled",
  "diffEditor.renderIndicators": false,
  "diffEditor.renderGutterMenu": false,
  "diffEditor.experimental.showEmptyDecorations": false,
  "diffEditor.renderMarginRevertIcon": false,
  "diffEditor.renderSideBySide": false,
  "chat.editing.autoAcceptDelay": 0,
  "chat.editing.confirmEditRequestRetry": false,
  "chat.editing.confirmEditRequestRemoval": false,
  "inlineChat.showDiff": false,
  "inlineChat.accessibleDiffView": "off",
  "cursor.composer.shouldAutoAcceptDiffs": true,
  "cursor.diffs.useCharacterLevelDiffs": false,
  "latex-workshop.latex.recipe.default": "semio-dashboard",
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.search.rootFiles.include": ["♻️mit-bestand/📋️bericht/**/*.tex", "🧰️framework/🛍️products/📓️print/🧾️template/**/*.tex"],
  "latex-workshop.latex.tools": [
    {
      "name": "semio-dashboard",
      "command": "bun",
      "args": ["run", "--cwd", "%WORKSPACE_FOLDER%", "dashboard", "run", "@semio-tech/mit-bestand-bericht:build"]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "semio-dashboard",
      "tools": ["semio-dashboard"]
    }
  ],
  "latex-workshop.intellisense.package.env": {
    "TEXINPUTS": "${workspaceFolder}/🧰️framework/🛍️products/📓️print/🖋️latex//:"
  },
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop"
  }
}
