{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀gitkraken",
      "type": "node-terminal",
      "request": "launch",
      "command": "/usr/bin/gitkraken --path \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🚀f3d",
      "type": "node-terminal",
      "request": "launch",
      "command": "if [ -z \"$DISPLAY\" ]; then echo '⚠️ F3D requires a display. Please run in a GUI environment or use X11 forwarding.'; else /usr/bin/f3d; fi",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🚀mcpinspector",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "mcp:inspector"
      ],
      "env": {
        "HOST": "0.0.0.0",
        "CLIENT_PORT": "6274",
        "SERVER_PORT": "6277"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio-elements📚ui📖storybook",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "@semio-elements/ui"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:6006)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio📚js✏️sketchpad",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev:sketchpad",
        "@semio/js"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5173)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🖱️3dm",
      "preLaunchTask": "semio/3dm ui dev",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "dev",
        "@semio/3dm-ui"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5174)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🌐sitesplay",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "semio/sites/play"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:4000)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🌐docs",
      "preLaunchTask": "semio/sites/docs dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "semio/sites/docs"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:4321)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "semio/desktop"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🛠️dev👤semio🖱️sketchpad",
      "preLaunchTask": "semio/sketchpad dev",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "semio/sketchpad"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5173)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev🧰semiorepo⌨️vscode",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/semio-repo/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/semio-repo/vscode/out/**/*.js"
      ],
      "preLaunchTask": "semio-repo/vscode dev"
    },
    {
      "name": "🛠️dev🧰semiorepo🤖mcp",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "mcp:inspector"
      ],
      "env": {
        "MCP_AUTO_OPEN_ENABLED": "false",
        "MCP_PROXY_AUTH_TOKEN": "semio-repo-mcp-debug-token"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=./semio-repo/cli/cli&serverArgs=mcp&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "🛠️dev🔬coda🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "@semio/coda-desktop"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🛠️dev🔬coda🤖mcp",
      "preLaunchTask": "inspector mcp",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "semio-coda/py",
        "run",
        "coda.py",
        "--mcp-stdio"
      ],
      "env": {
        "MCP_AUTO_OPEN_ENABLED": "false",
        "MCP_PROXY_AUTH_TOKEN": "semio-repo-mcp-debug-token"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=./semio-repo/cli/cli&serverArgs=mcp&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "📦build👤semio📚engine",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "build",
        "semio/engine"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build👤semio🌐sites",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "build",
        "semio/sites"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build👤semio🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "build",
        "semio/desktop"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build👤semio🖱️3dm",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "build",
        "@semio/3dm"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build👤semio🏪assets",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "build",
        "semio/assets"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build🧰semiorepo⌨️cli",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "build",
        "semio-repo/cli"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build🧰semiorepo⌨️server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
