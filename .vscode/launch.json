{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀gitkraken",
      "type": "node-terminal",
      "request": "launch",
      "command": "/usr/bin/gitkraken --path \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🚀mcpinspector",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "mcp:inspector"
      ],
      "env": {
        "HOST": "0.0.0.0",
        "CLIENT_PORT": "6274",
        "SERVER_PORT": "6277"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio⌨️engine",
      "preLaunchTask": "semio/engine dev",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/semio/engine",
          "remoteRoot": "."
        }
      ]
    },
    {
      "name": "🛠️dev👤semio📚js",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "@semio/js"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:6006)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio📚js📖storybook",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev:storybook",
        "@semio/js"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:6006)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio📚js✏️sketchpad",
