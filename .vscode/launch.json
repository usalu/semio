        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio⚙️engine🤖mcp",
      "preLaunchTask": "inspector mcp",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "semio/engine",
        "run",
        "engine.py",
        "--mcp-stdio"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🛠️dev🧰semiorepo⌨️cli",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/semio-repo/cli",
      "cwd": "${workspaceFolder}",
      "args": [
        "help"
      ]
    },
    {
      "name": "🛠️dev🧰semiorepo⌨️server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/semio-repo/server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🛠️dev🧰semiorepo⌨️vscode",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/semio-repo/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/semio-repo/vscode/out/**/*.js"
      ],
      "preLaunchTask": "semio-repo/vscode dev"
    },
    {
      "name": "🛠️dev🧰semiorepo🤖mcp",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "mcp:inspector"
      ],
      "env": {
        "MCP_AUTO_OPEN_ENABLED": "false",
        "MCP_PROXY_AUTH_TOKEN": "semio-repo-mcp-debug-token"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=./semio-repo/cli/cli&serverArgs=mcp&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "🛠️dev🔬coda🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
