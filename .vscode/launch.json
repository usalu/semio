      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5173)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio📚3dm",
      "preLaunchTask": "semio/3dm ui dev",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "dev",
        "@semio/3dm-ui"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5174)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🌐docs",
