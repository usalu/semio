    {
      "name": "🛠️dev🏘️compose📐3dm",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev @semio-tech/compose-3dm-ui",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "http://localhost:5174/"
        }
      },
      "presentation": {
        "group": "3_dev",
        "order": 50,
        "reveal": "always",
        "panel": "dedicated"
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5174)",
