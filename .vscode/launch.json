        "nx",
        "build",
        "semio/sketchpad"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    // ========================================
    // PUBLISH:TEST
    // ========================================
    {
      "name": "publish:test",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "publish:test"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    // ========================================
    // PUBLISH
    // ========================================
    {
      "name": "publish",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "publish"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "semio/docs publish",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "publish",
        "semio/docs"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "semio/play publish",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "publish",
        "semio/play"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "semio/desktop publish",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "publish",
        "semio/desktop"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "semio/sketchpad publish",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "publish",
        "semio/sketchpad"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    // ========================================
    // DEV
    // ========================================
    {
      "name": "dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "run-many",
        "-t",
        "dev"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "semio-repo/cli dev",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/semio-repo/cli",
      "cwd": "${workspaceFolder}",
      "args": [
        "help"
      ]
    },
    {
      "name": "semio-repo/server dev",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/semio-repo/server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "semio-repo/vscode dev",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/semio-repo/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/semio-repo/vscode/out/**/*.js"
      ],
      "preLaunchTask": "semio-repo/vscode dev"
    },
    {
      "name": "semio/engine dev",
      "preLaunchTask": "semio/engine dev",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/py/engine",
          "remoteRoot": "."
        }
      ]
    },
    {
      "name": "semio/js dev",
      "preLaunchTask": "semio/js dev",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "@semio/js"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:6006)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "semio/js dev:storybook",
      "preLaunchTask": "semio/js dev:storybook",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev:storybook",
        "@semio/js"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:6006)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "semio/js dev:sketchpad",
      "preLaunchTask": "semio/js dev:sketchpad",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev:sketchpad",
        "@semio/js"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5173)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "semio/docs dev",
      "preLaunchTask": "semio/docs dev",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "@semio/docs"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:4321)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "semio/play dev",
      "preLaunchTask": "semio/play dev",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "@semio/play"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:4000)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "semio/desktop dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "semio/desktop"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "semio/logo dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "@semio/logo"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "semio/sketchpad dev",
      "preLaunchTask": "semio/sketchpad dev",
      "type": "chrome",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "dev",
        "semio/sketchpad"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5173)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "mcp dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "mcp:inspector"
      ],
      "env": {
        "HOST": "0.0.0.0",
        "CLIENT_PORT": "6274",
        "SERVER_PORT": "6277"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Go dev",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${file}",
      "cwd": "${fileDirname}"
    },
    {
      "name": "Python dev",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
