      "env": {
        "CAD_JS_RENDERER_PLAY_PORT": "6020"
      },
      "presentation": {
        "group": "3_dev",
        "order": 10
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://(?:127\\.0\\.0\\.1|localhost|0\\.0\\.0\\.0):6020)",
        "uriFormat": "%s"
      }
    },
    {
