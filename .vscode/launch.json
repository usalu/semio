{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    // #region 🚀 Programs
    {
      "name": "⌨️gemini",
      "type": "node-terminal",
      "request": "launch",
      "command": "gemini --yolo",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⌨️kiro",
      "type": "node-terminal",
      "request": "launch",
      "command": "kiro-cli chat --trust-all-tools",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🖱️f3d",
      "type": "node-terminal",
      "request": "launch",
      "command": "f3d",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🖱️gitkraken",
      "type": "node-terminal",
      "request": "launch",
      "command": "gitkraken --path \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🖱️mcpinspector",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "mcp:inspector"],
      "env": {
        "CLIENT_PORT": "6274",
        "SERVER_PORT": "6277"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🚀benchmark",
      "type": "node-terminal",
      "request": "launch",
      "command": "go run ./repo/cli benchmark",
      "cwd": "${workspaceFolder}"
    },
    // #endregion
    // #region 🛠️ Dev
    {
      "name": "🛠️dev👤semio📚hub",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run -p semio-hub",
      "env": {
        "DATABASE_URL": "postgres://semio:semio@localhost:5432/semio",
        "RUST_LOG": "info",
        "PORT": "8080"
      },
      "cwd": "${workspaceFolder}",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "name": "🛠️dev👤elements📚ui📖storybook",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:elements:ui:storybook"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:6006)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🖱️3dm",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev @semio/3dm-ui",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "http://localhost:5174/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5174)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🧮algorithms📖storybook",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:algorithms"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:6007)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:desktop"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🛠️dev👤semio📚engine🤖mcp",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run workspace:mcp-inspector",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting MCP",
          "endsPattern": ":6274"
        }
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🌐sites🎛️play",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:sites:play"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:4000)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🏪store📊graphiql",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run -p semio-store",
      "env": {
        "RUST_LOG": "info",
        "SEMIO_STORE_PORT": "4010"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://127\\.0\\.0\\.1:4010/graphiql)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🖱️sketchpad",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev @semio/sketchpad",
      "env": {
        "NX_WORKSPACE_DATA_DIRECTORY": "${workspaceFolder}/.nx/workspace-data-terminal"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "http://localhost:5173/"
        }
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5173)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio📚ui📖storybook",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:ui"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:6008)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio⌨️vscode",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/semio/vscode"],
      "outFiles": ["${workspaceFolder}/semio/vscode/out/**/*.js"]
    },
    {
      "name": "🛠️dev👤semio⌨️vscode (integrated)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev @semio/vscode",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^\\s].*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*building",
          "endsPattern": ".*built in.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🛠️dev🔬coda🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:coda-desktop"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "🛠️dev🔬coda🤖mcp",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "coda/assistant", "run", "main.py", "--mcp-stdio"],
      "env": {
        "MCP_AUTO_OPEN_ENABLED": "false",
        "MCP_PROXY_AUTH_TOKEN": "repo-mcp-debug-token"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=uv&serverArgs=--directory&serverArgs=coda/assistant&serverArgs=run&serverArgs=main.py&serverArgs=--mcp-stdio&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "🛠️dev🔬coda🤖mcp (with inspector)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run workspace:mcp-inspector",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MCP_AUTO_OPEN_ENABLED": "false",
          "MCP_PROXY_AUTH_TOKEN": "repo-mcp-debug-token"
        }
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting MCP Inspector",
          "endsPattern": ":6274"
        }
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=uv&serverArgs=--directory&serverArgs=coda/assistant&serverArgs=run&serverArgs=main.py&serverArgs=--mcp-stdio&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "🛠️dev🧰repo🤖mcp",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "mcp:inspector"],
      "env": {
        "MCP_AUTO_OPEN_ENABLED": "false",
        "MCP_PROXY_AUTH_TOKEN": "repo-mcp-debug-token"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=go&serverArgs=run&serverArgs=./repo/mcp&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "🛠️dev🧰repo⌨️vscode",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/repo/vscode"],
      "outFiles": ["${workspaceFolder}/repo/vscode/out/**/*.js"]
    },
    {
      "name": "🛠️dev🧰repo⌨️vscode (integrated)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev repo",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^\\s].*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*building",
          "endsPattern": ".*built in.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "cwd": "${workspaceFolder}"
    },
    // #endregion
    // #region 📦 Build
    {
      "name": "📦build👤semio🖱️3dm",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:3dm"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build👤semio🏪assets",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:assets"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build👤semio🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:desktop"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build👤semio📚engine",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:engine"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build👤semio🔗graphql",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run semio/graphql:build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build👤semio🌐sites",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:sites"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build🔬coda🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:coda-desktop"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build🧰repo⌨️client",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:repo-cli"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build🧰repo⌨️server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:repo-server"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "📦build🧰repo🖱️vscode",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:repo-vscode"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    // #endregion
    // #region ⬆️ Publish
    {
      "name": "⬆️publish👤semio🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "publish:desktop"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⬆️publish👤semio🌐play",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "publish:play"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⬆️publish👤semio🌐sketchpad",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "publish:sketchpad"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⬆️publish👤semio🌐sites📖docs",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "publish:docs"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "⬆️publish🔬coda🖱️desktop",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "publish:coda-desktop"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
    // #endregion
  ]
}
