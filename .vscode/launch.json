{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    // #region ⌨️ Keyboard
    {
      "name": "⌨️gemini",
      "type": "node-terminal",
      "request": "launch",
      "command": "gemini --yolo",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⌨️kiro",
      "type": "node-terminal",
      "request": "launch",
      "command": "kiro-cli chat --trust-all-tools",
      "cwd": "${workspaceFolder}"
    },
    // #endregion
    // #region 🖱️ Mouse
    {
      "name": "🖱️f3d",
      "type": "node-terminal",
      "request": "launch",
      "command": "f3d",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🖱️gitkraken",
      "type": "node-terminal",
      "request": "launch",
      "command": "gitkraken --path \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🖱️mcpinspector",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev -- mcp",
      "env": {
        "CLIENT_PORT": "6274",
        "SERVER_PORT": "6277"
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274)",
        "uriFormat": "%s"
      }
    },
    // #endregion
    // #region 🛠️ Dev
    {
      "name": "🛠️dev📚storybook",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev:storybook",
      "cwd": "${workspaceFolder}",
      "env": {
        "STORYBOOK_PORT": "6010"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://(?:127\\.0\\.0\\.1|localhost|0\\.0\\.0\\.0):6010)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev📚storybook📖static",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./script.ts dev storybook-static",
      "cwd": "${workspaceFolder}",
      "env": {
        "STORYBOOK_PORT": "6010"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "storybook-static listening on (http://[^\\s]+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio📚hub",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run -p semio-hub",
      "env": {
        "DATABASE_URL": "postgres://semio:semio@localhost:5432/semio",
        "RUST_LOG": "info",
        "PORT": "8080"
      },
      "cwd": "${workspaceFolder}",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "name": "🛠️dev👤semio🖱️3dm",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev @semio/3dm-ui",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "http://localhost:5174/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5174)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🖱️desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🛠️dev👤semio📚engine🤖mcp",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./script.ts dev mcp engine",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting MCP",
          "endsPattern": ":6274"
        }
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🌐sites🎛️play",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run @semio/play:dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:4000)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🏪store📊graphiql",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run -p semio-store",
      "env": {
        "RUST_LOG": "info",
        "SEMIO_STORE_PORT": "4010"
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://127\\.0\\.0\\.1:4010/graphiql)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio🖱️sketchpad",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev @semio/sketchpad",
      "env": {
        "NX_WORKSPACE_DATA_DIRECTORY": "${workspaceFolder}/.nx/workspace-data-terminal"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "http://localhost:5173/"
        }
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5173)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev👤semio⌨️vscode",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/semio/vscode"],
      "outFiles": ["${workspaceFolder}/semio/vscode/out/**/*.js"]
    },
    {
      "name": "🛠️dev👤semio⌨️vscode integrated",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev @semio/vscode",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^\\s].*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*building",
          "endsPattern": ".*built in.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🛠️dev🔬coda🖱️desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run @coda/desktop:dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🛠️dev🔬coda🤖mcp",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "coda/assistant", "run", "main.py", "--mcp-stdio"],
      "env": {
        "MCP_AUTO_OPEN_ENABLED": "false",
        "MCP_PROXY_AUTH_TOKEN": "repo-mcp-token"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=uv&serverArgs=--directory&serverArgs=coda/assistant&serverArgs=run&serverArgs=main.py&serverArgs=--mcp-stdio&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "🛠️dev🔬coda🤖mcp inspector",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./script.ts dev mcp",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "MCP_AUTO_OPEN_ENABLED": "false",
          "MCP_PROXY_AUTH_TOKEN": "repo-mcp-token"
        }
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting MCP Inspector",
          "endsPattern": ":6274"
        }
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=uv&serverArgs=--directory&serverArgs=coda/assistant&serverArgs=run&serverArgs=main.py&serverArgs=--mcp-stdio&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "🛠️dev🧰repo🤖mcp",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev -- mcp repo",
      "env": {
        "MCP_AUTO_OPEN_ENABLED": "false",
        "MCP_PROXY_AUTH_TOKEN": "repo-mcp-token"
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=go&serverArgs=run&serverArgs=./repo/client/mcp&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "🛠️dev🧰repo⌨️vscode",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/repo/vscode"],
      "outFiles": ["${workspaceFolder}/repo/vscode/out/**/*.js"]
    },
    {
      "name": "🛠️dev🧰repo⌨️vscode integrated",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev repo",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^\\s].*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*building",
          "endsPattern": ".*built in.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🛠️dev🖱️elements📋board",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run @elements/board:dev",
      "cwd": "${workspaceFolder}",
      "env": {
        "BOARD_PLAY_PORT": "6012"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://(?:127\\.0\\.0\\.1|localhost):6012)",
        "uriFormat": "%s"
      }
    },
    // #endregion
    // #region 📦 Build
    {
      "name": "📦build📚storybook",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build:storybook",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build👤semio🖱️3dm",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build -- 3dm",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build👤semio🏪assets",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build -- assets",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build👤semio🖱️desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build -- desktop",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build👤semio📚engine",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build -- engine",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build👤semio🔗graphql",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run semio/graphql:build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build👤semio🌐sites",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build -- sites",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build🔬coda🖱️desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build -- coda-desktop",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build🧰repo⌨️client",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build -- repo-cli",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build🧰repo⌨️server",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build -- repo-server",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📦build🧰repo🖱️vscode",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run build -- repo-vscode",
      "cwd": "${workspaceFolder}"
    },
    // #endregion
    // #region ⬆️ Publish
    {
      "name": "⬆️publish👤semio🖱️desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run publish -- desktop",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⬆️publish👤semio🌐play",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run publish -- play",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⬆️publish👤semio🌐sketchpad",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run publish -- sketchpad",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⬆️publish👤semio🌐sites📖docs",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run publish -- docs",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⬆️publish🔬coda🖱️desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run publish -- coda-desktop",
      "cwd": "${workspaceFolder}"
    }
    // #endregion
  ]
}
