        "nx",
        "build",
        "@semio/net"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "semio/logo build",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "nx",
        "build",
        "@semio/logo"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "semio/icons build",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
