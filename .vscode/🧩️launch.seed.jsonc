{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    // #region ⌨️ Keyboard
    {
      "name": "⌨️gemini",
      "type": "node-terminal",
      "request": "launch",
      "command": "gemini --yolo",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "1_keyboard",
        "order": 10
      }
    },
    {
      "name": "⌨️kiro",
      "type": "node-terminal",
      "request": "launch",
      "command": "kiro-cli chat --trust-all-tools",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "1_keyboard",
        "order": 20
      }
    },
    {
      "name": "🖱️f3d",
      "type": "node-terminal",
      "request": "launch",
      "command": "f3d",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "2_mouse",
        "order": 10
      }
    },
    {
      "name": "🖱️gitkraken",
      "type": "node-terminal",
      "request": "launch",
      "command": "gitkraken --path \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "2_mouse",
        "order": 20
      }
    },
    {
      "name": "🖱️mcpinspector",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev -- mcp",
      "env": {
        "CLIENT_PORT": "6274",
        "SERVER_PORT": "6277"
      },
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "2_mouse",
        "order": 30
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev🎛️dashboard",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./🧰️framework/🛍️products/🦑️repo/🔨️modules/⌨️cli/⚡️implementations/🦀️rust/📜️script.ts run",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 1
      }
    },
    "@generated:cad:react",
    "@generated:cad:wgpu",
    {
      "name": "🛠️dev📐️cad🧊️wgpu🖥️native",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./🧰️framework/🛍️products/💻️os/🔨️modules/📺️renderer/🧑️‍🎨️engine/📦️packages/🦀️rust/🎯️targets/🧊️wgpu/📜️script.ts native cad",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 10.2
      }
    },
    {
      "name": "🛠️dev📐️cad🧩️concrete🌲️forest⚛️react",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./📜️script.ts dev cad fixture concrete",
      "cwd": "${workspaceFolder}",
      "env": {
        "CAD_JS_RENDERER_PLAY_PORT": "6020",
        "SEMIO_RENDERER": "react"
      },
      "presentation": {
        "group": "3_dev",
        "order": 20
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://(?:127\\.0\\.0\\.1|localhost|0\\.0\\.0\\.0):6020)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev📐️cad🧩️concrete🌲️forest🧊️wgpu🌐️wasm",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./📜️script.ts dev cad fixture concrete",
      "cwd": "${workspaceFolder}",
      "env": {
        "CAD_JS_RENDERER_PLAY_PORT": "6120",
        "SEMIO_RENDERER": "wgpu"
      },
      "presentation": {
        "group": "3_dev",
        "order": 20.1
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://(?:127\\.0\\.0\\.1|localhost|0\\.0\\.0\\.0):6120)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev📐️cad🧩️concrete🌲️forest🧊️wgpu🖥️native",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./🧰️framework/🛍️products/💻️os/🔨️modules/📺️renderer/🧑️‍🎨️engine/📦️packages/🦀️rust/🎯️targets/🧊️wgpu/📜️script.ts native cad",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 20.2
      }
    },
    {
      "name": "🛠️dev🔬️coda🖱️desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run @semio-tech/coda-desktop:dev",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 30
      }
    },
    {
      "name": "🛠️dev🔬️coda🤖️mcp",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv --directory coda/assistant run main.py --mcp-stdio",
      "env": {
        "MCP_AUTO_OPEN_ENABLED": "false",
        "MCP_PROXY_AUTH_TOKEN": "repo-mcp-token"
      },
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 40
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274/\\?MCP_PROXY_AUTH_TOKEN=[^\\s]+)",
        "uriFormat": "%s&transport=stdio&serverCommand=uv&serverArgs=--directory&serverArgs=coda/assistant&serverArgs=run&serverArgs=main.py&serverArgs=--mcp-stdio&MCP_PROXY_FULL_ADDRESS=http://127.0.0.1:6277"
      }
    },
    {
      "name": "🛠️dev🏘️compose📐️3dm",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev @semio-tech/compose-3dm-ui",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "http://localhost:5174/"
        }
      },
      "presentation": {
        "group": "3_dev",
        "order": 50,
        "reveal": "always",
        "panel": "dedicated"
      },
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:5174)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev🏘️compose🖱️desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 60
      }
    },
    {
      "name": "🛠️dev🏘️compose⚙️engine🤖️mcp",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./📜️script.ts dev mcp engine",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting MCP",
          "endsPattern": ":6274"
        }
      },
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 70
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://[^\\s]+:6274)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev🏘️compose🌐️hub",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run -p compose-hub",
      "env": {
        "DATABASE_URL": "postgres://compose:compose@localhost:5432/compose",
        "RUST_LOG": "info",
        "PORT": "8080"
      },
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 80,
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "name": "🛠️dev🏘️compose🧮️query🦀️build",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run @semio-tech/compose-query:build",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 90
      }
    },
    {
      "name": "🛠️dev🏘️compose🧮️query🌐️wasm",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun ./📜️script.ts query wasm",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 100
      }
    },
    {
      "name": "🛠️dev🏘️compose✍️sketchpad",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx dev @semio-tech/compose-sketchpad",
      "env": {
        "NX_WORKSPACE_DATA_DIRECTORY": "${workspaceFolder}/.nx/workspace-data-terminal"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "http://(localhost|127\\.0\\.0\\.1):5173/"
        }
      },
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 110
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "http://(localhost|127\\.0\\.0\\.1):5173",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev🏘️compose✍️sketchpad🎛️play",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run @semio-tech/compose-sketchpad-play:dev",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 120
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://localhost:4000)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "🛠️dev🏘️compose📊️gql",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun nx run @semio-tech/compose-gql:dev",
      "env": {
        "RUST_LOG": "info",
        "COMPOSE_GQL_PORT": "4010"
      },
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "3_dev",
        "order": 130
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(http://127\\.0\\.0\\.1:4010/graphiql)",
        "uriFormat": "%s"
      }
    },
