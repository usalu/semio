{
  "mcpServers": {
    "repo": {
      "type": "stdio",
      "command": "repo",
      "args": [
        "mcp"
      ],
      "env": {
        "SEMIO_REPO_MCP_CLIENT": "client"
      }
    },
    "semio": {
      "type": "stdio",
      "command": "repo",
      "args": [
        "dev",
        "mcp",
        "stdio",
        "os",
        "--folder",
        ".🧬semio/🔗space/os-mcp",
        "--scopes",
        "workspace.read,artifact.write,inference.execute,ui.observe,ui.control,conversation.write"
      ]
    }
  }
}
