{
  "mcpServers": {
    "repo": {
      "type": "stdio",
      "command": "bun",
      "args": ["dev.mcp.repo.script.ts", "client"]
    },
    "neo4j-semio": {
      "type": "stdio",
      "command": "bun",
      "args": ["dev.mcp.neo4j.script.ts", "semio"],
      "env": {
        "NEO4J_DATABASE": "semio"
      }
    },
    "neo4j-elements": {
      "type": "stdio",
      "command": "bun",
      "args": ["dev.mcp.neo4j.script.ts", "elements"],
      "env": {
        "NEO4J_DATABASE": "elements"
      }
    },
    "neo4j-coda": {
      "type": "stdio",
      "command": "bun",
      "args": ["dev.mcp.neo4j.script.ts", "coda"],
      "env": {
        "NEO4J_DATABASE": "coda"
      }
    },
    "neo4j-reuse": {
      "type": "stdio",
      "command": "bun",
      "args": ["dev.mcp.neo4j.script.ts", "reuse"],
      "env": {
        "NEO4J_DATABASE": "reuse"
      }
    }
  }
}
