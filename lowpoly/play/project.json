{
	"name": "@semio-tech/lowpoly-play",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "lowpoly/play",
				"command": "bun ./script.ts dev",
				"env": {
					"LOWPOLY_PLAY_PORT": "6078"
				},
				"forwardAllArgs": true
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "lowpoly/play",
				"command": "bun ./script.ts build",
				"forwardAllArgs": true
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "lowpoly/play",
				"command": "bun ./script.ts test",
				"forwardAllArgs": true
			}
		},
		"validate": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "lowpoly/play",
				"command": "bun ./script.ts validate",
				"forwardAllArgs": true
			}
		}
	}
}
