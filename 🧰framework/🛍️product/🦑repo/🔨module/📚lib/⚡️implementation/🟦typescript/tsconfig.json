{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["*.ts", "bin/**/*.ts"],
  "exclude": ["*.test.ts", "📜script.ts"]
}
