{
  "name": "@semio-tech/semio-logo",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰framework/🔨module/🖼️asset/⚡️implementation/🟦typescript/🪧logo",
        "command": "bun --watch ./script.ts generate",
        "forwardAllArgs": true
