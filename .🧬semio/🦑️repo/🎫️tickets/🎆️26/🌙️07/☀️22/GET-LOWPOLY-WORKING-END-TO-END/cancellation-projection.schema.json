{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policy",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "policy": {
      "const": "PerOperation"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "surface",
          "proof",
          "initial",
          "outcome",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "enum": [
              "app",
              "window"
            ]
          },
          "proof": {
            "enum": [
              "exact",
              "absent-unrelated",
              "wrong-owner",
              "wrong-schema",
              "duplicate",
              "missing-migrated"
            ]
          },
          "initial": {
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "projected",
              "unchanged",
              "refused"
            ]
          },
          "expected": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}
