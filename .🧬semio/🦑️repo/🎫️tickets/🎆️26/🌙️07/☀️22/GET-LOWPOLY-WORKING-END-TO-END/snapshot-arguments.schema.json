{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "controller",
    "actions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "controller": {
      "const": "s.lowpoly.lowpoly@1/*#editor"
    },
    "actions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inPalette",
          "args"
        ],
        "properties": {
          "id": {
            "enum": [
              "importSnapshotJson",
              "replaceSnapshotJson"
            ]
          },
          "inPalette": {
            "const": true
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "required",
                "label"
              ],
              "properties": {
                "id": {
                  "const": "json"
                },
                "kind": {
                  "const": "string"
                },
                "required": {
                  "const": true
                },
                "label": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "en",
                    "de"
                  ],
                  "properties": {
                    "en": {
                      "const": "Snapshot JSON"
                    },
                    "de": {
                      "const": "Snapshot-JSON"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
