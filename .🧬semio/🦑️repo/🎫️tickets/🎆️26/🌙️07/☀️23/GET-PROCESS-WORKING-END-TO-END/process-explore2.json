[
 {
  "name": "wait",
  "js": "(async()=>{const h=window.__h;return 'w'})()",
  "until": "(async()=>String(document.querySelectorAll('canvas').length>=1&&!/Loading document/.test(document.body.innerText)&&!!document.querySelector('[role=combobox]')))()",
  "timeoutMs": 420000,
  "settleMs": 2000
 },
 {
  "name": "dump Artifact",
  "js": "(async()=>{const h=window.__h;h.click('Artifact');await h.wait(2000);const chrome=new Set(['Artifact','Catalogue','Workshop','Inspection','Chat','Fullscreen','Editor|⌘️⌥️E','Viewer|⌘️⌥️V','Display','Remote: detached','Command','Settings','Marketplace','History','Tasks','Workpiece','Projection','Window Options','Search','Utilities','⋯','Close','Example']);const el=[...document.querySelectorAll('button,input,select,textarea,[role=switch],[role=checkbox],[role=combobox],[role=slider],[role=option],[role=menuitem]')].map(e=>(e.tagName[0]+(e.getAttribute('role')?'/'+e.getAttribute('role'):'')+(e.type&&e.tagName=='INPUT'?'/'+e.type:'')+':'+(e.getAttribute('aria-label')||'')+'~'+(e.value!==undefined&&e.tagName!='BUTTON'?'='+e.value+'~':'')+e.innerText.trim().replace(/\\n/g,'/'))).filter(s=>!chrome.has(s.split(':')[1]?.split('~').pop()));return document.body.innerText.split('Tasks').pop().replace(/\\n/g,'|').slice(0,2500)+'\\n@@'+el.join(' ; ')})()",
  "settleMs": 300
 },
 {
  "name": "close Artifact",
  "js": "(async()=>{const h=window.__h;h.click('Artifact');await h.wait(500);return 'c'})()",
  "settleMs": 300
 },
