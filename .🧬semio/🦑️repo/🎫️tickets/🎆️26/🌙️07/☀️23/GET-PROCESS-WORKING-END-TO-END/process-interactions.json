[
 {
  "name": "open example select",
  "js": "(async()=>'o')()",
  "pointer": "(async()=>{const e=document.querySelector('[role=combobox]');const r=e.getBoundingClientRect();return JSON.stringify([r.x+r.width/2,r.y+r.height/2])})()",
  "settleMs": 1000
 },
 {
  "name": "switch example to No example",
  "js": "(async()=>'p')()",
  "pointer": "(async()=>{const e=[...document.querySelectorAll('[role=option]')].find(e=>e.innerText.trim()==='No example');const r=e.getBoundingClientRect();return JSON.stringify([r.x+r.width/2,r.y+r.height/2])})()",
  "settleMs": 40000
 },
 {
  "name": "example state none",
  "js": "(async()=>JSON.stringify([document.querySelector('[role=combobox]').innerText,document.querySelectorAll('canvas').length]))()",
  "settleMs": 500
 },
 {
