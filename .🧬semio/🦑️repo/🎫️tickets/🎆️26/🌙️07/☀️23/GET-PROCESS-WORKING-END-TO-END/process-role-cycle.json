[
 {
  "name": "wait for the initial document",
  "js": "(async()=>'w')()",
  "until": "(async()=>String(document.querySelectorAll('canvas').length>=1&&!/Loading document/.test(document.body.innerText)&&!!document.querySelector('[role=combobox]')))()",
  "timeoutMs": 420000,
  "settleMs": 2000
 },
 {
  "name": "probe pre",
  "js": "(async()=>JSON.stringify([document.querySelectorAll('canvas').length,(document.body.innerText.match(/(Loading|Opening|Restor)[^\\n]*/)||[''])[0],document.querySelector('[role=combobox]')?.innerText,[...document.querySelectorAll('button')].filter(b=>b.getAttribute('aria-pressed')==='true'||b.getAttribute('aria-selected')==='true').map(b=>b.innerText.slice(0,10))]))()",
  "settleMs": 500
 },
 {
  "name": "switch to Viewer",
  "js": "(async()=>{[...document.querySelectorAll('button,[role=tab]')].find(b=>(b.getAttribute('aria-label')||b.innerText).trim().startsWith(\"Viewer\")).click();return \"v\"})()",
  "settleMs": 3000
 },
