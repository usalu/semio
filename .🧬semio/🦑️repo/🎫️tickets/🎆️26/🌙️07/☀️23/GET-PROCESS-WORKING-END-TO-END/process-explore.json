[
 {
  "name": "wait",
  "js": "(async()=>{const h=window.__h;return 'w'})()",
  "until": "(async()=>String(document.querySelectorAll('canvas').length>=1&&!/Loading document/.test(document.body.innerText)&&!!document.querySelector('[role=combobox]')))()",
  "timeoutMs": 420000,
  "settleMs": 2000
 },
 {
  "name": "dump Artifact",
  "js": "(async()=>{const h=window.__h;h.click('Artifact');await h.wait(2500);return document.body.innerText.replace(/\\n/g,'|').slice(0,1800)})()",
  "settleMs": 500
 },
 {
  "name": "html Artifact",
  "js": "(async()=>{const h=window.__h;const els=[...document.querySelectorAll('[data-slot]')].map(e=>e.getAttribute('data-slot')).filter((v,i,a)=>a.indexOf(v)===i);return els.join(',')})()",
  "settleMs": 300
 },
 {
  "name": "close Artifact",
  "js": "(async()=>{const h=window.__h;h.click('Artifact');await h.wait(800);return 'c'})()",
  "settleMs": 300
 },
