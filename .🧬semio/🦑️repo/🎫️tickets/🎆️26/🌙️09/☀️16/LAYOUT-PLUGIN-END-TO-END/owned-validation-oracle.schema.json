{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turns",
    "summaries"
  ],
  "properties": {
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ordinal",
          "op",
          "demand",
          "grant",
          "progress",
          "heap",
          "denied",
          "done"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "op": {
            "enum": [
              "birth",
              "occupied",
              "advance",
              "close"
            ]
          },
          "demand": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "grant": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "progress": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "heap": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "denied": {
            "type": "boolean"
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "completed",
          "valid",
          "closed",
          "order",
          "relocated",
          "birthDenied",
          "closeDenied",
          "identity",
          "capacity",
          "released",
          "sourceReleased",
          "turnCount",
          "programBirths",
          "relocations",
          "identityChecks",
          "readsAfterClose"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "completed": {
            "type": "boolean"
          },
          "valid": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "closed": {
            "type": "boolean"
          },
          "order": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "relocated": {
            "type": "boolean"
          },
          "birthDenied": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "closeDenied": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "identity": {
            "type": "boolean"
          },
          "capacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "released": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sourceReleased": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "turnCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "programBirths": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "relocations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "identityChecks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "readsAfterClose": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
