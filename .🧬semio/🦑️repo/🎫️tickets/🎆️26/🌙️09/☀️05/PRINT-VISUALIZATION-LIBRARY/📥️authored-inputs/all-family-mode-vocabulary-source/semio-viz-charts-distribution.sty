%region 🔖️Frame
% 🔑 Frame keys every chart family of the namespace shares, `semio / viz / family / common`.
% data   (table, default `demo-distribution`) source table
% value  (column, default `value`)            column holding the observations
% group  (column, default `grp`)              column splitting the observations into series
% label  (column, default empty)              column carrying the item labels; empty draws none
% width  (mm, default 60)                     drawing width
% height (mm, default 40)                     drawing height
% pad    (mm, default 3)                      inner padding on all four sides
\tl_new:N \l_semio_viz_cb_data_tl
\tl_new:N \l_semio_viz_cb_value_tl
\tl_new:N \l_semio_viz_cb_group_tl
\tl_new:N \l_semio_viz_cb_label_tl
\tl_new:N \l_semio_viz_cb_points_tl
\fp_new:N \l_semio_viz_cb_width_fp
\fp_new:N \l_semio_viz_cb_height_fp
\fp_new:N \l_semio_viz_cb_pad_fp
\fp_new:N \l_semio_viz_cb_xa_fp
\fp_new:N \l_semio_viz_cb_xb_fp
\fp_new:N \l_semio_viz_cb_ya_fp
\fp_new:N \l_semio_viz_cb_yb_fp
\fp_new:N \l_semio_viz_cb_a_fp
\fp_new:N \l_semio_viz_cb_b_fp
\fp_new:N \l_semio_viz_cb_c_fp
\fp_new:N \l_semio_viz_cb_h_fp
\fp_new:N \l_semio_viz_cb_t_fp
\fp_new:N \l_semio_viz_cb_u_fp
\fp_new:N \l_semio_viz_cb_w_fp
\int_new:N \l_semio_viz_cb_i_int
\int_new:N \l_semio_viz_cb_j_int
\int_new:N \l_semio_viz_cb_series_int

\keys_define:nn { semio / viz / family / common } {
  data    .tl_set:N = \l_semio_viz_cb_data_tl,
  value   .tl_set:N = \l_semio_viz_cb_value_tl,
  group   .tl_set:N = \l_semio_viz_cb_group_tl,
  label   .tl_set:N = \l_semio_viz_cb_label_tl,
  width   .fp_set:N = \l_semio_viz_cb_width_fp,
  height  .fp_set:N = \l_semio_viz_cb_height_fp,
  pad     .fp_set:N = \l_semio_viz_cb_pad_fp,
  unknown .code:n = { },
}

% 🔄 Restores the shared frame state before a family reads its option list.
\cs_new_protected:Npn \semio_viz_cb_reset: {
  \tl_set:Nn \l_semio_viz_cb_data_tl { demo-distribution }
  \tl_set:Nn \l_semio_viz_cb_value_tl { value }
  \tl_set:Nn \l_semio_viz_cb_group_tl { grp }
  \tl_clear:N \l_semio_viz_cb_label_tl
  \tl_clear:N \l_semio_viz_cb_points_tl
  \fp_set:Nn \l_semio_viz_cb_width_fp { 60 }
  \fp_set:Nn \l_semio_viz_cb_height_fp { 40 }
  \fp_set:Nn \l_semio_viz_cb_pad_fp { 3 }
  \tl_clear:N \l_semio_viz_family_variant_tl
}

% 🖼️ Fixes the plot area: the drawing size less the padding on all four sides, in millimetres of
% the `semio viz picture` canvas, y growing upwards.
\cs_new_protected:Npn \semio_viz_cb_frame: {
  \fp_set_eq:NN \l_semio_viz_cb_xa_fp \l_semio_viz_cb_pad_fp
  \fp_set_eq:NN \l_semio_viz_cb_ya_fp \l_semio_viz_cb_pad_fp
  \fp_set:Nn \l_semio_viz_cb_xb_fp { \l_semio_viz_cb_width_fp - \l_semio_viz_cb_pad_fp }
  \fp_set:Nn \l_semio_viz_cb_yb_fp { \l_semio_viz_cb_height_fp - \l_semio_viz_cb_pad_fp }
}

% 🎨 Colour of the one-based categorical slot #1 of the active theme palette, expandable so a
% family names it straight inside a TikZ option list.
\cs_new:Npn \semio_viz_palette:n #1 { \semio_viz_theme_color:n { (#1) - 1 } }
%endregion 🔖️Frame

%region 🔖️Primitives
% ✏️ The mark set every family of the namespace draws with. Each primitive first emits its
% `geometry/<kind>` probe record (active only after \SemioVizProbeOn) and then draws, unless
% \SemioVizChartsDryRun asked for the computation alone. Angles are d3-shape's: radians, zero at
% twelve o'clock, clockwise. https://d3js.org/d3-shape/arc
\tl_new:N \l_semio_viz_g_path_tl
\tl_new:N \l_semio_viz_g_values_tl
\seq_new:N \l_semio_viz_g_items_seq
\int_new:N \l_semio_viz_g_i_int
\fp_new:N \l_semio_viz_g_cx_fp
\fp_new:N \l_semio_viz_g_cy_fp
\fp_new:N \l_semio_viz_g_inner_fp
\fp_new:N \l_semio_viz_g_outer_fp
\fp_new:N \l_semio_viz_g_start_fp
\fp_new:N \l_semio_viz_g_end_fp

% 🖌️ One TikZ path with the options #1 along the path specification #2.
\cs_new_protected:Npn \semio_viz_g_draw:nn #1#2 { \path [ #1 ] #2 ; }
\cs_generate_variant:Nn \semio_viz_g_draw:nn { nx , nV }

% ▭ Rectangle with its lower left corner at (#1,#2), #3 wide and #4 tall, TikZ options #5.
\cs_new_protected:Npn \semio_viz_g_rect:nnnnn #1#2#3#4#5 {
  \semio_viz_probe_geometry:nx { rect }
    { \fp_eval:n {#1} , \fp_eval:n {#2} , \fp_eval:n {#3} , \fp_eval:n {#4} }
  \bool_if:NF \g_semio_viz_charts_dry_bool
    {
      \semio_viz_g_draw:nx {#5}
        {
          ( \fp_eval:n {#1} , \fp_eval:n {#2} ) rectangle
          ( \fp_eval:n { (#1) + (#3) } , \fp_eval:n { (#2) + (#4) } )
        }
    }
}

% ⚪ Circle of radius #3 around (#1,#2), TikZ options #4.
\cs_new_protected:Npn \semio_viz_g_circle:nnnn #1#2#3#4 {
  \semio_viz_probe_geometry:nx { circle } { \fp_eval:n {#1} , \fp_eval:n {#2} , \fp_eval:n {#3} }
  \bool_if:NF \g_semio_viz_charts_dry_bool
    {
      \semio_viz_g_draw:nx {#4}
        { ( \fp_eval:n {#1} , \fp_eval:n {#2} ) circle [ radius = \fp_eval:n {#3} ] }
    }
}

% ➖ Straight segment from (#1,#2) to (#3,#4), TikZ options #5.
\cs_new_protected:Npn \semio_viz_g_line:nnnnn #1#2#3#4#5 {
  \semio_viz_probe_geometry:nx { line }
    { \fp_eval:n {#1} , \fp_eval:n {#2} , \fp_eval:n {#3} , \fp_eval:n {#4} }
  \bool_if:NF \g_semio_viz_charts_dry_bool
    {
      \semio_viz_g_draw:nx {#5}
        { ( \fp_eval:n {#1} , \fp_eval:n {#2} ) -- ( \fp_eval:n {#3} , \fp_eval:n {#4} ) }
    }
}

% 📍 Reads the flat coordinate list `x1,y1,x2,y2,…` #1 into the probe values and the TikZ path.
\cs_new_protected:Npn \semio_viz_g_points:n #1 {
  \seq_set_from_clist:Nn \l_semio_viz_g_items_seq {#1}
  \tl_clear:N \l_semio_viz_g_path_tl
  \tl_clear:N \l_semio_viz_g_values_tl
  \int_zero:N \l_semio_viz_g_i_int
  \seq_map_inline:Nn \l_semio_viz_g_items_seq {
    \int_incr:N \l_semio_viz_g_i_int
    \tl_put_right:Nx \l_semio_viz_g_values_tl
      { \int_compare:nNnF { \l_semio_viz_g_i_int } = { 1 } { , } \fp_eval:n {##1} }
    \int_if_odd:nTF { \l_semio_viz_g_i_int }
      {
        \tl_put_right:Nx \l_semio_viz_g_path_tl
          { \int_compare:nNnF { \l_semio_viz_g_i_int } = { 1 } { -- } ( \fp_eval:n {##1} , }
      }
      { \tl_put_right:Nx \l_semio_viz_g_path_tl { \fp_eval:n {##1} ) } }
  }
}

% 〰️ Open polyline through the flat coordinate list #1, TikZ options #2.
\cs_new_protected:Npn \semio_viz_g_polyline:nn #1#2 {
  \semio_viz_g_points:n {#1}
  \semio_viz_probe_geometry:nx { polyline } { \l_semio_viz_g_values_tl }
  \bool_lazy_and:nnT
    { ! \g_semio_viz_charts_dry_bool }
    { \int_compare_p:nNn { \l_semio_viz_g_i_int } > { 3 } }
    { \semio_viz_g_draw:nV {#2} \l_semio_viz_g_path_tl }
}
\cs_generate_variant:Nn \semio_viz_g_polyline:nn { xn , Vn }

% 🔷 Closed polygon through the flat coordinate list #1, TikZ options #2.
\cs_new_protected:Npn \semio_viz_g_polygon:nn #1#2 {
  \semio_viz_g_points:n {#1}
  \semio_viz_probe_geometry:nx { polygon } { \l_semio_viz_g_values_tl }
  \bool_lazy_and:nnT
    { ! \g_semio_viz_charts_dry_bool }
    { \int_compare_p:nNn { \l_semio_viz_g_i_int } > { 3 } }
    {
      \tl_put_right:Nn \l_semio_viz_g_path_tl { -- cycle }
      \semio_viz_g_draw:nV {#2} \l_semio_viz_g_path_tl
    }
}
\cs_generate_variant:Nn \semio_viz_g_polygon:nn { xn , Vn }

% 🌗 Annular sector around (#1,#2) between the radii #3 and #4 from angle #5 to angle #6, TikZ
% options #7; an inner radius of zero closes the sector at the centre like a pie slice.
\cs_new_protected:Npn \semio_viz_g_arc:nnnnnnn #1#2#3#4#5#6#7 {
  \fp_set:Nn \l_semio_viz_g_cx_fp {#1}
  \fp_set:Nn \l_semio_viz_g_cy_fp {#2}
  \fp_set:Nn \l_semio_viz_g_inner_fp {#3}
  \fp_set:Nn \l_semio_viz_g_outer_fp {#4}
  \fp_set:Nn \l_semio_viz_g_start_fp {#5}
  \fp_set:Nn \l_semio_viz_g_end_fp {#6}
  \semio_viz_probe_geometry:nx { arc }
    {
      \fp_eval:n { \l_semio_viz_g_cx_fp } , \fp_eval:n { \l_semio_viz_g_cy_fp } ,
      \fp_eval:n { \l_semio_viz_g_inner_fp } , \fp_eval:n { \l_semio_viz_g_outer_fp } ,
      \fp_eval:n { \l_semio_viz_g_start_fp } , \fp_eval:n { \l_semio_viz_g_end_fp }
    }
  \bool_if:NF \g_semio_viz_charts_dry_bool
    {
      \semio_viz_g_draw:nx {#7}
        {
          (
            \fp_eval:n { \l_semio_viz_g_cx_fp + \l_semio_viz_g_outer_fp * sin ( \l_semio_viz_g_start_fp ) } ,
            \fp_eval:n { \l_semio_viz_g_cy_fp + \l_semio_viz_g_outer_fp * cos ( \l_semio_viz_g_start_fp ) }
          )
          arc [
            start~angle = \fp_eval:n { 90 - \l_semio_viz_g_start_fp * 180 / pi } ,
            end~angle = \fp_eval:n { 90 - \l_semio_viz_g_end_fp * 180 / pi } ,
            radius = \fp_eval:n { \l_semio_viz_g_outer_fp }
          ]
          \fp_compare:nNnTF { \l_semio_viz_g_inner_fp } > { 0 }
            {
              -- (
                \fp_eval:n { \l_semio_viz_g_cx_fp + \l_semio_viz_g_inner_fp * sin ( \l_semio_viz_g_end_fp ) } ,
                \fp_eval:n { \l_semio_viz_g_cy_fp + \l_semio_viz_g_inner_fp * cos ( \l_semio_viz_g_end_fp ) }
              )
              arc [
                start~angle = \fp_eval:n { 90 - \l_semio_viz_g_end_fp * 180 / pi } ,
                end~angle = \fp_eval:n { 90 - \l_semio_viz_g_start_fp * 180 / pi } ,
                radius = \fp_eval:n { \l_semio_viz_g_inner_fp }
              ]
            }
            { -- ( \fp_eval:n { \l_semio_viz_g_cx_fp } , \fp_eval:n { \l_semio_viz_g_cy_fp } ) }
          -- cycle
        }
    }
}

% 🔤 Label #4 anchored at (#1,#2) by its TikZ anchor #3, in the theme's label face.
\cs_new_protected:Npn \semio_viz_g_text:nnnn #1#2#3#4 {
  \semio_viz_probe_geometry:nx { text } { \fp_eval:n {#1} , \fp_eval:n {#2} }
  \bool_if:NF \g_semio_viz_charts_dry_bool
    {
      \exp_args:Nx \semio_viz_g_node:nnn
        { ( \fp_eval:n {#1} , \fp_eval:n {#2} ) } {#3} {#4}
    }
}

% 🔤 The node behind \semio_viz_g_text:nnnn, at the already evaluated coordinate #1.
\cs_new_protected:Npn \semio_viz_g_node:nnn #1#2#3 {
  \node [ anchor = #2 , inner~sep = 0.4pt , text = semio-chrome-foreground ,
          font = \c_semio_viz_theme_font_label_tl ] at #1 {#3} ;
}
%endregion 🔖️Primitives

%region 🔖️Keys
% 🔑 Histogram keys, `semio / viz / family / histogram`.
% bins          (int, default 10)      threshold count handed to d3's bin
% thresholds    (clist, default empty) explicit bin edges; overrides `bins`
% mode          (choice `single|overlaid|stacked|grouped`, default single) how the groups share the bins
% cumulative    (bool, default false)  accumulate the bin heights
% density       (bool, default false)  normalise the counts to a density
% relative      (bool, default false)  show relative frequencies instead of counts
% variablewidth (bool, default false)  equal-count bins whose width follows the data
% coordinate    (choice `cartesian|circular`, default cartesian)
% gap           (mm, default 0.4)      gap between adjacent bars
\int_new:N \l_semio_viz_hist_bins_int
\clist_new:N \l_semio_viz_hist_thresholds_clist
\tl_new:N \l_semio_viz_hist_mode_tl
\bool_new:N \l_semio_viz_hist_cumulative_bool
\bool_new:N \l_semio_viz_hist_density_bool
\bool_new:N \l_semio_viz_hist_relative_bool
\bool_new:N \l_semio_viz_hist_variablewidth_bool
\tl_new:N \l_semio_viz_hist_coordinate_tl
\fp_new:N \l_semio_viz_hist_gap_fp

\keys_define:nn { semio / viz / family / histogram } {
  bins          .int_set:N = \l_semio_viz_hist_bins_int,
  thresholds    .clist_set:N = \l_semio_viz_hist_thresholds_clist,
  mode          .tl_set:N = \l_semio_viz_hist_mode_tl,
  cumulative    .bool_set:N = \l_semio_viz_hist_cumulative_bool,
  density       .bool_set:N = \l_semio_viz_hist_density_bool,
  relative      .bool_set:N = \l_semio_viz_hist_relative_bool,
  variablewidth .bool_set:N = \l_semio_viz_hist_variablewidth_bool,
  coordinate    .tl_set:N = \l_semio_viz_hist_coordinate_tl,
  gap           .fp_set:N = \l_semio_viz_hist_gap_fp,
  unknown       .code:n = { },
}

% 🔑 Density keys, `semio / viz / family / density`.
% bandwidth  (fp, default 0)       kernel bandwidth; 0 selects Silverman's rule
% samples    (int, default 40)     grid points the estimate is evaluated at
% kernel     (choice `gaussian|epanechnikov`, default gaussian)
% filled     (bool, default false) fill the area under each curve
% cumulative (bool, default false) integrate the estimate into a distribution function
% multiple   (bool, default false) one overlaid curve per group
% ridgeline  (bool, default false) one curve per group, stacked on its own baseline
% offset     (mm, default 6)       baseline distance between ridgeline rows
\fp_new:N \l_semio_viz_dens_bandwidth_fp
\int_new:N \l_semio_viz_dens_samples_int
\tl_new:N \l_semio_viz_dens_kernel_tl
\bool_new:N \l_semio_viz_dens_filled_bool
\bool_new:N \l_semio_viz_dens_cumulative_bool
\bool_new:N \l_semio_viz_dens_multiple_bool
\bool_new:N \l_semio_viz_dens_ridgeline_bool
\fp_new:N \l_semio_viz_dens_offset_fp

\keys_define:nn { semio / viz / family / density } {
  bandwidth  .fp_set:N = \l_semio_viz_dens_bandwidth_fp,
  samples    .int_set:N = \l_semio_viz_dens_samples_int,
  kernel     .tl_set:N = \l_semio_viz_dens_kernel_tl,
  filled     .bool_set:N = \l_semio_viz_dens_filled_bool,
  cumulative .bool_set:N = \l_semio_viz_dens_cumulative_bool,
  multiple   .bool_set:N = \l_semio_viz_dens_multiple_bool,
  ridgeline  .bool_set:N = \l_semio_viz_dens_ridgeline_bool,
  offset     .fp_set:N = \l_semio_viz_dens_offset_fp,
  unknown    .code:n = { },
}

% 🔑 ECDF keys, `semio / viz / family / ecdf`.
% step          (bool, default true)  draw the function as a staircase rather than a polygon
% complementary (bool, default false) draw the survival function 1 - F(x)
% points        (bool, default false) mark every observation on the curve
\bool_new:N \l_semio_viz_ecdf_step_bool
\bool_new:N \l_semio_viz_ecdf_complementary_bool
\bool_new:N \l_semio_viz_ecdf_points_bool

\keys_define:nn { semio / viz / family / ecdf } {
  step          .bool_set:N = \l_semio_viz_ecdf_step_bool,
  complementary .bool_set:N = \l_semio_viz_ecdf_complementary_bool,
  points        .bool_set:N = \l_semio_viz_ecdf_points_bool,
  unknown       .code:n = { },
}

