\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-fonts}[2026/08/04 v0.2.0 semio font stacks]

\RequirePackage{fontspec}
\RequirePackage{semio-tokens}

% 🔤️ Font files are found by bare name through the engine search path that
% print's build seeds with every `asset/font/<family>` directory; a document may
% live anywhere in the workspace, so no relative `Path=` holds for all of them.
\newfontfamily\SemioSans{Anta-Regular.ttf}
\newfontfamily\SemioSerif{Anta-Regular.ttf}
\newfontfamily\SemioMono{ShareTechMono-Regular.ttf}
\newfontfamily\SemioEmoji{NotoEmoji-Regular.ttf}
\newfontfamily\SemioCJK{NotoSansCJKsc-Regular.otf}

% 🌏️ XeTeX restores the surrounding font after each tracked CJK run.
\newXeTeXintercharclass\semio@cjk@class
\ExplSyntaxOn
\clist_map_inline:nn
  { 1100/11FF,2E80/303F,3040/31FF,3400/4DBF,4E00/9FFF,A960/A97F,AC00/D7FF,F900/FAFF,FE30/FE4F,FF00/FFEF,20000/2FA1F,30000/323AF }
  {
    \seq_set_split:Nnn \l_tmpa_seq { / } { #1 }
    \int_step_inline:nnn { "\seq_item:Nn \l_tmpa_seq {1} }
      { "\seq_item:Nn \l_tmpa_seq {2} }
      { \XeTeXcharclass ##1 = \semio@cjk@class }
  }
\ExplSyntaxOff
\XeTeXinterchartoks 0 \semio@cjk@class = {\begingroup\SemioCJK}
\XeTeXinterchartoks 4095 \semio@cjk@class = {\begingroup\SemioCJK}
\XeTeXinterchartoks \semio@cjk@class 0 = {\endgroup}
\XeTeXinterchartoks \semio@cjk@class 4095 = {\endgroup}
\XeTeXinterchartokenstate=1

\newcommand{\semio@set@main@fonts}{%
  \setmainfont{Anta-Regular.ttf}%
  \setsansfont{Anta-Regular.ttf}%
  \setmonofont{ShareTechMono-Regular.ttf}%
}
