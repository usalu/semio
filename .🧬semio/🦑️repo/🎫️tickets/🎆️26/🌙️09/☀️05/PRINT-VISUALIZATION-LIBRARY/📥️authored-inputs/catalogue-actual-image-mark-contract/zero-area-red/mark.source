\cs_new_protected:Npn \semio_viz_mark_image: {
  \semio_viz_mark_local:
  \fp_set:Nn \l_semio_viz_sym_x_fp { sqrt( \l_semio_viz_mark_size_fp * \l_semio_viz_mark_aspect_fp ) }
  \fp_set:Nn \l_semio_viz_sym_y_fp { \l_semio_viz_mark_size_fp / \l_semio_viz_sym_x_fp }
  \semio_viz_path_rect:nnnn { - \l_semio_viz_sym_x_fp / 2 } { - \l_semio_viz_sym_y_fp / 2 }
    { \l_semio_viz_sym_x_fp } { \l_semio_viz_sym_y_fp }
  \tl_if_empty:NT \l_semio_viz_mark_file_tl {
    \semio_viz_path_move_to:nn { - \l_semio_viz_sym_x_fp / 2 } { - \l_semio_viz_sym_y_fp / 2 }
    \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp / 2 } { \l_semio_viz_sym_y_fp / 2 }
    \semio_viz_path_move_to:nn { - \l_semio_viz_sym_x_fp / 2 } { \l_semio_viz_sym_y_fp / 2 }
    \semio_viz_path_line_to:nn { \l_semio_viz_sym_x_fp / 2 } { - \l_semio_viz_sym_y_fp / 2 }
  }
  \semio_viz_mark_emit:n { mark/image-mark }
  \tl_if_empty:NF \l_semio_viz_mark_file_tl {
    \node [ inner~sep=0pt , outer~sep=0pt , rotate=\fp_to_decimal:N \l_semio_viz_mark_rotate_fp ,
      opacity=\fp_to_decimal:N \l_semio_viz_mark_opacity_fp ]
      at ( \fp_to_decimal:N \l_semio_viz_mx_fp mm , \fp_to_decimal:N \l_semio_viz_my_fp mm )
      { \includegraphics [ width= \fp_to_decimal:N \l_semio_viz_sym_x_fp mm ,
          height= \fp_to_decimal:N \l_semio_viz_sym_y_fp mm ] { \l_semio_viz_mark_file_tl } } ;
  }
}