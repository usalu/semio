  \seq_if_in:NnF \g_semio_viz_table_names_seq { demo-state-series } {
    \semio_viz_table_new:nn { demo-state-series } { t, value }
    \semio_viz_table_row:nn { demo-state-series } { 0, 3 }
    \semio_viz_table_row:nn { demo-state-series } { 1, 5 }
    \semio_viz_table_row:nn { demo-state-series } { 2, 4 }
    \semio_viz_table_row:nn { demo-state-series } { 3, 7 }
    \semio_viz_table_row:nn { demo-state-series } { 4, 6 }
    \semio_viz_table_row:nn { demo-state-series } { 5, 9 }
    \semio_viz_table_row:nn { demo-state-series } { 6, 8 }
    \semio_viz_table_row:nn { demo-state-series } { 7, 11 }
    \semio_viz_table_row:nn { demo-state-series } { 8, 7 }
    \semio_viz_table_row:nn { demo-state-series } { 9, 6 }
