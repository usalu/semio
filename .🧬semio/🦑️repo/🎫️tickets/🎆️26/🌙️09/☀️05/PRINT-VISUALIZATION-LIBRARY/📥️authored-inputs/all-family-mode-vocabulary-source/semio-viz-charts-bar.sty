%region 🔖️Palette
% 🌈 Colour of the 1-based series index #1: the theme's categorical palette, which counts from
% zero, so the index is shifted once here instead of at every call site.
\cs_new_protected:Npn \semio_viz_cart_color:nN #1#2
  { \semio_viz_theme_color:nN { \int_eval:n { (#1) - 1 } } #2 }
\cs_generate_variant:Nn \semio_viz_cart_color:nN { VN, xN }

% 🌡️ Sequential shade of one hue, straight from the theme.
\cs_new_eq:NN \semio_viz_cart_shade:nnN \semio_viz_theme_shade:nnN
\cs_new_eq:NN \semio_viz_cart_shade:VnN \semio_viz_theme_shade:VnN
\cs_new_eq:NN \semio_viz_cart_shade:VxN \semio_viz_theme_shade:VxN
\cs_new_eq:NN \semio_viz_cart_shade:nxN \semio_viz_theme_shade:nxN
%endregion 🔖️Palette

%region 🔖️Frame
% 📐 The cartesian plot frame every family of this namespace draws into: canvas millimetres,
% an inset plot rectangle, and the named scales `cart-band` / `cart-x` / `cart-y` registered
% with semio-viz-scale, so the geometry stays the kernel's and not the family's.
\fp_new:N \l_semio_viz_cart_w_fp
\fp_new:N \l_semio_viz_cart_h_fp
\fp_new:N \l_semio_viz_cart_xlo_fp
\fp_new:N \l_semio_viz_cart_ylo_fp
\fp_new:N \l_semio_viz_cart_xhi_fp
\fp_new:N \l_semio_viz_cart_yhi_fp
\fp_new:N \l_semio_viz_cart_pad_l_fp
\fp_new:N \l_semio_viz_cart_pad_r_fp
\fp_new:N \l_semio_viz_cart_pad_t_fp
\fp_new:N \l_semio_viz_cart_pad_b_fp
\fp_new:N \l_semio_viz_cart_ymin_fp
\fp_new:N \l_semio_viz_cart_ymax_fp
\fp_new:N \l_semio_viz_cart_xmin_fp
\fp_new:N \l_semio_viz_cart_xmax_fp
\fp_new:N \l_semio_viz_cart_a_fp
\fp_new:N \l_semio_viz_cart_b_fp
\fp_new:N \l_semio_viz_cart_c_fp
\fp_new:N \l_semio_viz_cart_d_fp
\fp_new:N \l_semio_viz_cart_e_fp
\fp_new:N \l_semio_viz_cart_v_fp
\fp_new:N \l_semio_viz_cart_corner_fp
\fp_new:N \l_semio_viz_cart_prev_x_fp
\fp_new:N \l_semio_viz_cart_prev_y_fp
\int_new:N \l_semio_viz_cart_nrows_int
\int_new:N \l_semio_viz_cart_i_int
\int_new:N \l_semio_viz_cart_j_int
\int_new:N \l_semio_viz_cart_n_int
\bool_new:N \l_semio_viz_cart_step_first_bool
\tl_new:N \l_semio_viz_cart_cell_tl
\tl_new:N \l_semio_viz_cart_cell_b_tl
\tl_new:N \l_semio_viz_cart_fill_tl
\tl_new:N \l_semio_viz_cart_stroke_tl
\tl_new:N \l_semio_viz_cart_curve_tl
\tl_new:N \l_semio_viz_cart_coords_tl
\seq_new:N \l_semio_viz_cart_cats_seq
\seq_new:N \l_semio_viz_cart_groups_seq
\seq_new:N \l_semio_viz_cart_pts_seq
\seq_new:N \l_semio_viz_cart_pts_b_seq
\seq_new:N \l_semio_viz_cart_scratch_seq
\prop_new:N \l_semio_viz_cart_acc_prop
\prop_new:N \l_semio_viz_cart_neg_prop
\prop_new:N \l_semio_viz_cart_total_prop

\tl_new:N \l_semio_viz_cart_data_tl
\tl_new:N \l_semio_viz_cart_x_tl
\tl_new:N \l_semio_viz_cart_y_tl
\tl_new:N \l_semio_viz_cart_yb_tl
\tl_new:N \l_semio_viz_cart_group_tl
\tl_new:N \l_semio_viz_cart_label_tl
\tl_new:N \l_semio_viz_cart_grid_tl
\tl_new:N \l_semio_viz_cart_labels_tl
\tl_new:N \l_semio_viz_cart_sort_tl
\bool_new:N \l_semio_viz_cart_axes_bool
\bool_new:N \l_semio_viz_cart_ymin_user_bool
\bool_new:N \l_semio_viz_cart_ymax_user_bool

\cs_generate_variant:Nn \semio_viz_scale_band_edges:nnNN { nVNN, VnNN }
\cs_generate_variant:Nn \prop_put:Nnn { NVx }

% 📏 Canvas size: the enclosing VizFigure's millimetres when there is one, the default otherwise.
\cs_new_protected:Npn \semio_viz_cart_canvas: {
  \cs_if_exist:NTF \l_semio_viz_width_fp
    { \fp_set_eq:NN \l_semio_viz_cart_w_fp \l_semio_viz_width_fp }
    { \fp_set:Nn \l_semio_viz_cart_w_fp { 80 } }
  \cs_if_exist:NTF \l_semio_viz_height_fp
    { \fp_set_eq:NN \l_semio_viz_cart_h_fp \l_semio_viz_height_fp }
    { \fp_set:Nn \l_semio_viz_cart_h_fp { 40 } }
  \fp_compare:nNnT { \l_semio_viz_cart_w_fp } < { 4 } { \fp_set:Nn \l_semio_viz_cart_w_fp { 80 } }
  \fp_compare:nNnT { \l_semio_viz_cart_h_fp } < { 4 } { \fp_set:Nn \l_semio_viz_cart_h_fp { 40 } }
}

% 🔲 Plot rectangle from the canvas and the four padding keys.
\cs_new_protected:Npn \semio_viz_cart_rect_compute: {
  \semio_viz_cart_canvas:
  \fp_set_eq:NN \l_semio_viz_cart_xlo_fp \l_semio_viz_cart_pad_l_fp
  \fp_set_eq:NN \l_semio_viz_cart_ylo_fp \l_semio_viz_cart_pad_b_fp
  \fp_set:Nn \l_semio_viz_cart_xhi_fp { \l_semio_viz_cart_w_fp - \l_semio_viz_cart_pad_r_fp }
  \fp_set:Nn \l_semio_viz_cart_yhi_fp { \l_semio_viz_cart_h_fp - \l_semio_viz_cart_pad_t_fp }
}

% 🗂️ Distinct values of a column in first-appearance order. The loop lives in a parameterless
% runner because an inline map inside a function with arguments would capture that function's #1.
\tl_new:N \l_semio_viz_cart_arg_table_tl
\tl_new:N \l_semio_viz_cart_arg_col_tl
\tl_new:N \l_semio_viz_cart_arg_colb_tl
\tl_new:N \l_semio_viz_cart_arg_name_tl
\seq_new:N \l_semio_viz_cart_map_seq
\seq_new:N \l_semio_viz_cart_map_b_seq
\seq_new:N \l_semio_viz_cart_out_seq
\prop_new:N \l_semio_viz_cart_out_prop

\cs_new_protected:Npn \semio_viz_cart_cats_run: {
  \seq_clear:N \l_semio_viz_cart_out_seq
  \semio_viz_table_nrows:VN \l_semio_viz_cart_arg_table_tl \l_semio_viz_cart_nrows_int
  \int_step_inline:nn { \l_semio_viz_cart_nrows_int } {
    \semio_viz_table_cell:nnVN { \l_semio_viz_cart_arg_table_tl } {##1}
      \l_semio_viz_cart_arg_col_tl \l_semio_viz_cart_cell_tl
    \seq_if_in:NVF \l_semio_viz_cart_out_seq \l_semio_viz_cart_cell_tl
      { \seq_put_right:NV \l_semio_viz_cart_out_seq \l_semio_viz_cart_cell_tl }
  }
}

% 🗂️ The distinct values of column #2 of table #1 into #3, in the order the table lists them.
\cs_new_protected:Npn \semio_viz_cart_cats:nnN #1#2#3 {
  \tl_set:Nn \l_semio_viz_cart_arg_table_tl {#1}
  \tl_set:Nn \l_semio_viz_cart_arg_col_tl {#2}
  \semio_viz_cart_cats_run:
  \seq_set_eq:NN #3 \l_semio_viz_cart_out_seq
}
\cs_generate_variant:Nn \semio_viz_cart_cats:nnN { VVN, VnN, nVN }

% 🔢 Band scale across the plot's x range, and the same across its y range (top to bottom).
\cs_new_protected:Npn \semio_viz_cart_scale_band:Nn #1#2 {
  \use:x {
    \exp_not:N \semio_viz_scale_define:nnnn {#2} { band }
      { \seq_use:Nn #1 { , } }
      { \fp_eval:n { \l_semio_viz_cart_xlo_fp } , \fp_eval:n { \l_semio_viz_cart_xhi_fp } }
  }
}
% 🔢 The same band scale down the plot's y range, so the first level sits at the top.
\cs_new_protected:Npn \semio_viz_cart_scale_bandy:Nn #1#2 {
  \use:x {
    \exp_not:N \semio_viz_scale_define:nnnn {#2} { band }
      { \seq_use:Nn #1 { , } }
      { \fp_eval:n { \l_semio_viz_cart_yhi_fp } , \fp_eval:n { \l_semio_viz_cart_ylo_fp } }
  }
}

% 📊 The value scale `cart-y`; `#1` is the scale kind, `#2` the axis it runs along (v or h).
% `#3` carries the kernel scale options, so a pow axis can state its own exponent.
\tl_new:N \l_semio_viz_cart_scale_opts_tl

\cs_new_protected:Npn \semio_viz_cart_scale_value:nn #1#2 {
  \str_if_eq:nnTF {#2} { h }
    {
      \semio_viz_scale_define:nnxxV { cart-y } {#1}
        { \fp_eval:n { \l_semio_viz_cart_ymin_fp } , \fp_eval:n { \l_semio_viz_cart_ymax_fp } }
        { \fp_eval:n { \l_semio_viz_cart_xlo_fp } , \fp_eval:n { \l_semio_viz_cart_xhi_fp } }
        \l_semio_viz_cart_scale_opts_tl
    }
    {
      \semio_viz_scale_define:nnxxV { cart-y } {#1}
        { \fp_eval:n { \l_semio_viz_cart_ymin_fp } , \fp_eval:n { \l_semio_viz_cart_ymax_fp } }
        { \fp_eval:n { \l_semio_viz_cart_ylo_fp } , \fp_eval:n { \l_semio_viz_cart_yhi_fp } }
        \l_semio_viz_cart_scale_opts_tl
    }
}
\cs_generate_variant:Nn \semio_viz_cart_scale_value:nn { Vn }

% 📈 A continuous independent scale `cart-x` across the plot's x range.
\cs_new_protected:Npn \semio_viz_cart_scale_x:n #1 {
  \semio_viz_scale_define:nnxx { cart-x } {#1}
    { \fp_eval:n { \l_semio_viz_cart_xmin_fp } , \fp_eval:n { \l_semio_viz_cart_xmax_fp } }
    { \fp_eval:n { \l_semio_viz_cart_xlo_fp } , \fp_eval:n { \l_semio_viz_cart_xhi_fp } }
}

% 🎯 Value → canvas millimetre through the registered scales.
\cs_new_protected:Npn \semio_viz_cart_ymap:nN #1#2 { \semio_viz_scale_map:nnN { cart-y } {#1} #2 }
% 🎯 The same through the independent scale.
\cs_new_protected:Npn \semio_viz_cart_xmap:nN #1#2 { \semio_viz_scale_map:nnN { cart-x } {#1} #2 }
\cs_generate_variant:Nn \semio_viz_cart_ymap:nN { VN, xN }
\cs_generate_variant:Nn \semio_viz_cart_xmap:nN { VN, xN }

% 🎨 The paint of the primitive just drawn; a kind that differs only in colour or in corner
% radius still differs in its probe projection, which is what makes the catalogue's distinctness
% claim measurable rather than a matter of looking at two pictures.
\cs_new_protected:Npn \semio_viz_cart_probe_paint:n #1 {
  \semio_viz_probe_geometry:nx { paint } { #1 }
  \fp_compare:nNnT { \l_semio_viz_cart_corner_fp } > { 0 }
    { \semio_viz_probe_geometry:nx { corner }
        { \fp_eval:n { round( \l_semio_viz_cart_corner_fp , 4 ) } } }
}

% 🧱 One rectangle: fill, hairline border, optional corner radius, probe record.
\cs_new_protected:Npn \semio_viz_cart_draw_rect:nnnn #1#2#3#4 {
  \draw [ draw=\l_semio_viz_cart_emphasis_tl , fill=\l_semio_viz_cart_fill_tl ,
          line~width=\semio@stroke@hairline ,
          rounded~corners=\fp_eval:n { \l_semio_viz_cart_corner_fp } mm ]
    ( \fp_eval:n {#1} , \fp_eval:n {#2} )
    rectangle ( \fp_eval:n { (#1) + (#3) } , \fp_eval:n { (#2) + (#4) } ) ;
  \semio_viz_probe_geometry:nx { rect }
    { \fp_eval:n { round(#1,4) } , \fp_eval:n { round(#2,4) } ,
      \fp_eval:n { round(#3,4) } , \fp_eval:n { round(#4,4) } }
  \semio_viz_cart_probe_paint:n { \l_semio_viz_cart_fill_tl }
}

% ⚫ One filled circle with a probe record.
\cs_new_protected:Npn \semio_viz_cart_draw_dot:nnn #1#2#3 {
  \fill [ \l_semio_viz_cart_fill_tl ]
    ( \fp_eval:n {#1} , \fp_eval:n {#2} ) circle [ radius=\fp_eval:n {#3} mm ] ;
  \semio_viz_probe_geometry:nx { point }
    { \fp_eval:n { round(#1,4) } , \fp_eval:n { round(#2,4) } , \fp_eval:n { round(#3,4) } }
  \semio_viz_cart_probe_paint:n { \l_semio_viz_cart_fill_tl }
}

% 🖊️ One straight segment with a probe record.
\cs_new_protected:Npn \semio_viz_cart_draw_seg:nnnn #1#2#3#4 {
  \draw [ \l_semio_viz_cart_stroke_tl , line~width=\semio@stroke@default ]
    ( \fp_eval:n {#1} , \fp_eval:n {#2} ) -- ( \fp_eval:n {#3} , \fp_eval:n {#4} ) ;
  \semio_viz_probe_geometry:nx { segment }
    { \fp_eval:n { round(#1,4) } , \fp_eval:n { round(#2,4) } ,
      \fp_eval:n { round(#3,4) } , \fp_eval:n { round(#4,4) } }
  \semio_viz_cart_probe_paint:n { \l_semio_viz_cart_stroke_tl }
}

% 🪶 A thin hairline segment (guides, whiskers) with a probe record.
\cs_new_protected:Npn \semio_viz_cart_draw_hair:nnnn #1#2#3#4 {
  \draw [ \l_semio_viz_cart_stroke_tl , line~width=\semio@stroke@hairline ]
    ( \fp_eval:n {#1} , \fp_eval:n {#2} ) -- ( \fp_eval:n {#3} , \fp_eval:n {#4} ) ;
  \semio_viz_probe_geometry:nx { hair }
    { \fp_eval:n { round(#1,4) } , \fp_eval:n { round(#2,4) } ,
      \fp_eval:n { round(#3,4) } , \fp_eval:n { round(#4,4) } }
}

% 〰️ Curve interpolation: the TikZ plot options standing for the named interpolator.
\cs_new_protected:Npn \semio_viz_cart_plot_opts:N #1 {
  \str_case:VnF \l_semio_viz_cart_curve_tl {
    { basis } { \tl_set:Nn #1 { smooth , tension=0.2 } }
    { cardinal } { \tl_set:Nn #1 { smooth , tension=0.9 } }
    { catmull-rom } { \tl_set:Nn #1 { smooth , tension=0.7 } }
    { monotone-x } { \tl_set:Nn #1 { smooth , tension=0.55 } }
    { natural } { \tl_set:Nn #1 { smooth , tension=0.5 } }
    { bezier } { \tl_set:Nn #1 { smooth , tension=1 } }
  } { \tl_set:Nn #1 { } }
}

% ⤵️ Inserts the extra vertex a step interpolation needs before the current point.
\cs_new_protected:Npn \semio_viz_cart_coords_step:nn #1#2 {
  \bool_if:NT \l_semio_viz_cart_step_first_bool {
    \str_if_eq:nnTF {#2} { before }
      {
        \tl_put_right:Nx \l_semio_viz_cart_coords_tl
          { ( \fp_use:N \l_semio_viz_cart_prev_x_fp , \clist_item:nn {#1} { 2 } ) }
        \seq_put_right:Nx \l_semio_viz_cart_vertex_seq
          { \fp_use:N \l_semio_viz_cart_prev_x_fp , \clist_item:nn {#1} { 2 } }
      }
      {
        \tl_put_right:Nx \l_semio_viz_cart_coords_tl
          { ( \clist_item:nn {#1} { 1 } , \fp_use:N \l_semio_viz_cart_prev_y_fp ) }
        \seq_put_right:Nx \l_semio_viz_cart_vertex_seq
          { \clist_item:nn {#1} { 1 } , \fp_use:N \l_semio_viz_cart_prev_y_fp }
      }
  }
  \tl_put_right:Nx \l_semio_viz_cart_coords_tl
    { ( \clist_item:nn {#1} { 1 } , \clist_item:nn {#1} { 2 } ) }
  \seq_put_right:Nn \l_semio_viz_cart_vertex_seq {#1}
  \bool_set_true:N \l_semio_viz_cart_step_first_bool
  \fp_set:Nn \l_semio_viz_cart_prev_x_fp { \clist_item:nn {#1} { 1 } }
  \fp_set:Nn \l_semio_viz_cart_prev_y_fp { \clist_item:nn {#1} { 2 } }
}

\seq_new:N \l_semio_viz_cart_vertex_seq

% 📐 Builds the TikZ coordinate list of the mapped point sequence, inserting the riser vertices
% when the `curve` is one of the step forms.
\cs_new_protected:Npn \semio_viz_cart_coords_run: {
  \tl_clear:N \l_semio_viz_cart_coords_tl
  \seq_clear:N \l_semio_viz_cart_vertex_seq
  \bool_set_false:N \l_semio_viz_cart_step_first_bool
  \seq_map_inline:Nn \l_semio_viz_cart_map_seq {
    \str_case:VnF \l_semio_viz_cart_curve_tl {
      { step-before } { \semio_viz_cart_coords_step:nn {##1} { before } }
      { step } { \semio_viz_cart_coords_step:nn {##1} { after } }
      { step-after } { \semio_viz_cart_coords_step:nn {##1} { after } }
    } {
      \tl_put_right:Nx \l_semio_viz_cart_coords_tl
        { ( \clist_item:nn {##1} { 1 } , \clist_item:nn {##1} { 2 } ) }
      \seq_put_right:Nn \l_semio_viz_cart_vertex_seq {##1}
    }
  }
}

% 📐 The same for the point sequence #1.
\cs_new_protected:Npn \semio_viz_cart_coords_build:N #1 {
  \seq_set_eq:NN \l_semio_viz_cart_map_seq #1
  \semio_viz_cart_coords_run:
}

% 🧭 Mirrors the mapped point sequence into the probe stream, rounded so the record is stable.
\cs_new_protected:Npn \semio_viz_cart_probe_run: {
  \seq_clear:N \l_semio_viz_cart_scratch_seq
  \seq_map_inline:Nn \l_semio_viz_cart_map_seq {
    \seq_put_right:Nx \l_semio_viz_cart_scratch_seq
      { \fp_eval:n { round( \clist_item:nn {##1} { 1 } , 4 ) } }
    \seq_put_right:Nx \l_semio_viz_cart_scratch_seq
      { \fp_eval:n { round( \clist_item:nn {##1} { 2 } , 4 ) } }
  }
  \semio_viz_probe_geometry:nx { path } { \seq_use:Nn \l_semio_viz_cart_scratch_seq { , } }
}

% 🧭 The same for the point sequence #1.
\cs_new_protected:Npn \semio_viz_cart_probe_points:N #1 {
  \seq_set_eq:NN \l_semio_viz_cart_map_seq #1
  \semio_viz_cart_probe_run:
}

% 📈 Strokes the point sequence #1 as one path, smoothed when the `curve` asks for it, and probes it.
\cs_new_protected:Npn \semio_viz_cart_draw_path:N #1 {
  \seq_if_empty:NF #1 {
    \semio_viz_cart_coords_build:N #1
    \semio_viz_cart_plot_opts:N \l_semio_viz_cart_cell_b_tl
    \tl_if_empty:NTF \l_semio_viz_cart_cell_b_tl
      {
        \use:x { \exp_not:N \draw [ \l_semio_viz_cart_stroke_tl , line~width=\semio@stroke@default ]
          plot~coordinates { \l_semio_viz_cart_coords_tl } ; }
      }
      {
        \use:x { \exp_not:N \draw [ \l_semio_viz_cart_stroke_tl , line~width=\semio@stroke@default ]
          plot [ \l_semio_viz_cart_cell_b_tl ] coordinates { \l_semio_viz_cart_coords_tl } ; }
      }
    \semio_viz_probe_geometry:nx { curve } { \l_semio_viz_cart_curve_tl }
    \semio_viz_probe_geometry:nx { paint } { \l_semio_viz_cart_stroke_tl }
    \semio_viz_cart_probe_points:N \l_semio_viz_cart_vertex_seq
  }
}

% 🟦 A filled band between an upper and a lower point sequence.
\cs_new_protected:Npn \semio_viz_cart_band_run: {
  \tl_clear:N \l_semio_viz_cart_coords_tl
  \seq_map_inline:Nn \l_semio_viz_cart_map_seq {
    \tl_put_right:Nx \l_semio_viz_cart_coords_tl
      { ( \clist_item:nn {##1} { 1 } , \clist_item:nn {##1} { 2 } ) -- }
  }
  \seq_map_inline:Nn \l_semio_viz_cart_map_b_seq {
    \tl_put_left:Nx \l_semio_viz_cart_coords_tl
      { ( \clist_item:nn {##1} { 1 } , \clist_item:nn {##1} { 2 } ) -- }
  }
  \use:x { \exp_not:N \fill [ \l_semio_viz_cart_fill_tl , fill~opacity=0.45 ]
    \l_semio_viz_cart_coords_tl cycle ; }
  \semio_viz_probe_geometry:nx { paint } { \l_semio_viz_cart_fill_tl }
}

