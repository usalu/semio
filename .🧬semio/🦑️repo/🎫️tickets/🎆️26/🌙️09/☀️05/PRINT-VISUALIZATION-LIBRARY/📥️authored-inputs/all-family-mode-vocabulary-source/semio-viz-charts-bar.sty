% 🏆 Podium order puts the winner in the middle; top-n keeps the plain descending order.
\cs_new_protected:Npn \semio_viz_rank_podium_order: {
  \seq_clear:N \l_semio_viz_cart_scratch_seq
  \int_set:Nn \l_semio_viz_cart_n_int { \seq_count:N \l_semio_viz_cart_cats_seq }
  \int_compare:nNnTF { \l_semio_viz_cart_n_int } > { 2 }
    {
      \seq_put_right:Nx \l_semio_viz_cart_scratch_seq { \seq_item:Nn \l_semio_viz_cart_cats_seq { 2 } }
      \seq_put_right:Nx \l_semio_viz_cart_scratch_seq { \seq_item:Nn \l_semio_viz_cart_cats_seq { 1 } }
      \int_step_inline:nnn { 3 } { \l_semio_viz_cart_n_int }
        { \seq_put_right:Nx \l_semio_viz_cart_scratch_seq
            { \seq_item:Nn \l_semio_viz_cart_cats_seq {##1} } }
    }
    { \seq_set_eq:NN \l_semio_viz_cart_scratch_seq \l_semio_viz_cart_cats_seq }
  \seq_set_eq:NN \l_semio_viz_cart_cats_seq \l_semio_viz_cart_scratch_seq
}

% 🏆 The podium and top-n forms: the series sorted by their last value, the first `n` of them shown.
\cs_new_protected:Npn \semio_viz_rank_ranked: {
  \semio_viz_cart_totals:VVVN \l_semio_viz_cart_data_tl \l_semio_viz_cart_group_tl
    \l_semio_viz_cart_y_tl \l_semio_viz_cart_total_prop
  \seq_set_eq:NN \l_semio_viz_cart_cats_seq \l_semio_viz_cart_groups_seq
  \seq_sort:Nn \l_semio_viz_cart_cats_seq { \semio_viz_cart_sort_cmp:nnn {##1} {##2} { < } }
  \seq_clear:N \l_semio_viz_cart_scratch_seq
