\fp_new:N \l_semio_viz_bar_left_fp
\fp_new:N \l_semio_viz_bar_zero_fp
\int_new:N \l_semio_viz_bar_m_int
\int_new:N \l_semio_viz_bar_gi_int

\cs_new_protected:Npn \semio_viz_bar_keys_reset: {
  \semio_viz_cart_keys_reset:
