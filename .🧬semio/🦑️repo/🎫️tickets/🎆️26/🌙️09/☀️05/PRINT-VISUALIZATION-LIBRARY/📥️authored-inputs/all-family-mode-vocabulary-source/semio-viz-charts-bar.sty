\cs_new_protected:Npn \semio_viz_unit_glyph:nn #1#2 {
  \fp_set:Nn \l_semio_viz_cart_a_fp { \l_semio_viz_cart_xlo_fp + (#1) * \l_semio_viz_unit_cell_fp }
  \fp_set:Nn \l_semio_viz_cart_b_fp
    { \l_semio_viz_cart_yhi_fp - ( (#2) + 1 ) * \l_semio_viz_unit_cell_fp }
  \str_case:VnF \l_semio_viz_unit_glyph_tl {
    { dot } {
      \semio_viz_cart_draw_dot:nnn
        { \fp_eval:n { \l_semio_viz_cart_a_fp + \l_semio_viz_unit_cell_fp / 2 } }
        { \fp_eval:n { \l_semio_viz_cart_b_fp + \l_semio_viz_unit_cell_fp / 2 } }
        { \fp_eval:n { ( \l_semio_viz_unit_cell_fp - \l_semio_viz_unit_gap_fp ) / 2 } }
    }
    { triangle } {
      \fill [ \l_semio_viz_cart_fill_tl ]
        ( \fp_eval:n { \l_semio_viz_cart_a_fp + \l_semio_viz_unit_cell_fp / 2 } ,
          \fp_eval:n { \l_semio_viz_cart_b_fp + \l_semio_viz_unit_cell_fp - \l_semio_viz_unit_gap_fp } )
        -- ( \fp_eval:n { \l_semio_viz_cart_a_fp } , \fp_eval:n { \l_semio_viz_cart_b_fp } )
        -- ( \fp_eval:n { \l_semio_viz_cart_a_fp + \l_semio_viz_unit_cell_fp
             - \l_semio_viz_unit_gap_fp } , \fp_eval:n { \l_semio_viz_cart_b_fp } ) -- cycle ;
      \semio_viz_probe_geometry:nx { glyph }
        { \fp_eval:n { round( \l_semio_viz_cart_a_fp , 4 ) } ,
          \fp_eval:n { round( \l_semio_viz_cart_b_fp , 4 ) } }
    }
    { person } {
      \semio_viz_cart_draw_dot:nnn
        { \fp_eval:n { \l_semio_viz_cart_a_fp + \l_semio_viz_unit_cell_fp / 2 } }
        { \fp_eval:n { \l_semio_viz_cart_b_fp + \l_semio_viz_unit_cell_fp * 0.78 } }
        { \fp_eval:n { \l_semio_viz_unit_cell_fp * 0.18 } }
      \semio_viz_cart_draw_rect:nnnn
        { \fp_eval:n { \l_semio_viz_cart_a_fp + \l_semio_viz_unit_cell_fp * 0.28 } }
        { \fp_eval:n { \l_semio_viz_cart_b_fp } }
        { \fp_eval:n { \l_semio_viz_unit_cell_fp * 0.44 } }
        { \fp_eval:n { \l_semio_viz_unit_cell_fp * 0.55 } }
    }
  } {
    \semio_viz_cart_draw_rect:nnnn
      { \fp_eval:n { \l_semio_viz_cart_a_fp } } { \fp_eval:n { \l_semio_viz_cart_b_fp } }
      { \fp_eval:n { \l_semio_viz_unit_cell_fp - \l_semio_viz_unit_gap_fp } }
      { \fp_eval:n { \l_semio_viz_unit_cell_fp - \l_semio_viz_unit_gap_fp } }
  }
}

% 🧮 One row of glyphs per category: `value / unitValue` glyphs, wrapped into `columns` per line.
\cs_new_protected:Npn \semio_viz_unit_rows: {
  \seq_map_indexed_inline:Nn \l_semio_viz_cart_cats_seq {
    \int_set:Nn \l_semio_viz_bar_gi_int {##1}
    \tl_set:Nn \l_semio_viz_bar_cat_tl {##2}
    \tl_clear:N \l_semio_viz_bar_grp_tl
    \semio_viz_bar_cell_value:
    \semio_viz_cart_color:VN \l_semio_viz_bar_gi_int \l_semio_viz_cart_fill_tl
    \int_set:Nn \l_semio_viz_unit_total_int
      { \fp_to_int:n { ceil( \l_semio_viz_bar_va_fp / \l_semio_viz_unit_value_fp ) } }
    \int_step_inline:nn { \l_semio_viz_unit_total_int } {
      \semio_viz_unit_glyph:nn
        { \int_mod:nn { ####1 - 1 } { \l_semio_viz_unit_columns_int } }
        { \l_semio_viz_bar_gi_int - 1 }
    }
  }
}

% 🧇 The waffle form: one square grid whose cells are shared out between the categories by value.
\cs_new_protected:Npn \semio_viz_unit_waffle: {
  \semio_viz_cart_totals:VVVN \l_semio_viz_cart_data_tl \l_semio_viz_cart_x_tl
    \l_semio_viz_cart_y_tl \l_semio_viz_cart_total_prop
  \fp_zero:N \l_semio_viz_cart_v_fp
  \prop_map_inline:Nn \l_semio_viz_cart_total_prop { \fp_add:Nn \l_semio_viz_cart_v_fp {##2} }
  \int_zero:N \l_semio_viz_unit_k_int
  \seq_map_indexed_inline:Nn \l_semio_viz_cart_cats_seq {
    \int_set:Nn \l_semio_viz_bar_gi_int {##1}
    \semio_viz_cart_color:VN \l_semio_viz_bar_gi_int \l_semio_viz_cart_fill_tl
    \prop_get:NnNF \l_semio_viz_cart_total_prop {##2} \l_tmpb_tl { \tl_set:Nn \l_tmpb_tl { 0 } }
    \int_set:Nn \l_semio_viz_unit_total_int
      { \fp_to_int:n { round( 100 * \l_tmpb_tl / \l_semio_viz_cart_v_fp ) } }
    \int_step_inline:nn { \l_semio_viz_unit_total_int } {
      \semio_viz_unit_glyph:nn
        { \int_mod:nn { \l_semio_viz_unit_k_int } { \l_semio_viz_unit_columns_int } }
        { \int_div_truncate:nn { \l_semio_viz_unit_k_int } { \l_semio_viz_unit_columns_int } }
      \int_incr:N \l_semio_viz_unit_k_int
    }
  }
}

% ▶️ The whole family run: defaults, the option list #1, then the glyph rows or the waffle grid.
\cs_new_protected:Npn \semio_viz_unit_render:n #1 {
  \semio_viz_frame_require:n { SemioVizRunFamily }
  \semio_viz_unit_keys_reset:
  \keys_set:nn { semio / viz / family / unit } {#1}
  \semio_viz_cart_rect_compute:
  \semio_viz_cart_cats:VVN \l_semio_viz_cart_data_tl \l_semio_viz_cart_x_tl \l_semio_viz_cart_cats_seq
  \fp_set:Nn \l_semio_viz_unit_cell_fp
    { ( \l_semio_viz_cart_xhi_fp - \l_semio_viz_cart_xlo_fp ) / \l_semio_viz_unit_columns_int }
  \fp_set:Nn \l_semio_viz_unit_gap_fp { \l_semio_viz_unit_cell_fp * 0.22 }
  \str_case:VnTF \l_semio_viz_unit_mode_tl { { waffle } { \semio_viz_unit_waffle: } }
    { } { \semio_viz_unit_rows: }
}

% 🧇 §1: pictograms, icon arrays, unit charts, isotypes and waffles — counting instead of measuring.
\SemioVizFamily { unit } { \semio_viz_unit_render:n {#1} }
%endregion 🔖️Families

