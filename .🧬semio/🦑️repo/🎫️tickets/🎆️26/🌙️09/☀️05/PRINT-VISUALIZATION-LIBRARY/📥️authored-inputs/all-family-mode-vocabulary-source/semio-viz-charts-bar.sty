    y         .tl_set:N = \l_semio_viz_cart_y_tl,
    y2        .tl_set:N = \l_semio_viz_cart_yb_tl,
    group     .tl_set:N = \l_semio_viz_cart_group_tl,
    series    .tl_set:N = \l_semio_viz_cart_group_tl,
    label     .tl_set:N = \l_semio_viz_cart_label_tl,
    padLeft   .fp_set:N = \l_semio_viz_cart_pad_l_fp,
    padRight  .fp_set:N = \l_semio_viz_cart_pad_r_fp,
    padTop    .fp_set:N = \l_semio_viz_cart_pad_t_fp,
    padBottom .fp_set:N = \l_semio_viz_cart_pad_b_fp,
    yMin      .code:n = { \fp_set:Nn \l_semio_viz_cart_ymin_fp {##1}
                          \bool_set_true:N \l_semio_viz_cart_ymin_user_bool },
    yMax      .code:n = { \fp_set:Nn \l_semio_viz_cart_ymax_fp {##1}
                          \bool_set_true:N \l_semio_viz_cart_ymax_user_bool },
    axes      .bool_set:N = \l_semio_viz_cart_axes_bool,
    grid      .tl_set:N = \l_semio_viz_cart_grid_tl,
    gridLines .int_set:N = \l_semio_viz_cart_gridlines_int,
    ticks     .int_set:N = \l_semio_viz_cart_ticks_int,
    labels    .tl_set:N = \l_semio_viz_cart_labels_tl,
    sort      .tl_set:N = \l_semio_viz_cart_sort_tl,
    curve     .tl_set:N = \l_semio_viz_cart_curve_tl,
  }
}

% 🧩 Declares one family module: the shared vocabulary first, the family's own keys after.
