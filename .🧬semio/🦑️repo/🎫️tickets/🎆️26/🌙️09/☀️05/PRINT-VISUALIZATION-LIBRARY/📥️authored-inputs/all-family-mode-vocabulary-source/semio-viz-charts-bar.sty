  \bool_set_false:N \l_semio_viz_bar_lollipop_bool
  \bool_set_false:N \l_semio_viz_bar_mirror_bool
  \bool_set_false:N \l_semio_viz_bar_paired_bool
}

% 📐 The value axis of a span chart: wide enough to hold both the low and the high column.
\cs_new_protected:Npn \semio_viz_bar_domain_span: {
  \semio_viz_cart_extent:VVNN \l_semio_viz_cart_data_tl \l_semio_viz_cart_y_tl
    \l_semio_viz_cart_a_fp \l_semio_viz_cart_b_fp
  \semio_viz_cart_extent:VVNN \l_semio_viz_cart_data_tl \l_semio_viz_cart_yb_tl
    \l_semio_viz_cart_c_fp \l_semio_viz_cart_d_fp
  \bool_if:NF \l_semio_viz_cart_ymin_user_bool
    { \fp_set:Nn \l_semio_viz_cart_ymin_fp { min( \l_semio_viz_cart_a_fp , \l_semio_viz_cart_c_fp ) } }
  \bool_if:NF \l_semio_viz_cart_ymax_user_bool
    { \fp_set:Nn \l_semio_viz_cart_ymax_fp { max( \l_semio_viz_cart_b_fp , \l_semio_viz_cart_d_fp ) } }
}

% 📐 The value axis the `mode` needs: stacked totals, the unit interval of a percentage stack, a
% symmetric range for a diverging chart, the span of a range chart, or the plain value extent.
\cs_new_protected:Npn \semio_viz_bar_domain: {
  \str_case:VnTF \l_semio_viz_bar_mode_tl {
    { stacked } { \semio_viz_cart_domain_stacked: }
    { waterfall } { \semio_viz_cart_domain_stacked: }
    { percent } {
      \bool_if:NF \l_semio_viz_cart_ymin_user_bool { \fp_zero:N \l_semio_viz_cart_ymin_fp }
      \bool_if:NF \l_semio_viz_cart_ymax_user_bool { \fp_set:Nn \l_semio_viz_cart_ymax_fp { 100 } }
    }
    { diverging } {
      \semio_viz_cart_domain_stacked:
      \bool_if:NF \l_semio_viz_cart_ymin_user_bool
        { \fp_set:Nn \l_semio_viz_cart_ymin_fp { - \l_semio_viz_cart_ymax_fp / 2 } }
      \bool_if:NF \l_semio_viz_cart_ymax_user_bool
        { \fp_set:Nn \l_semio_viz_cart_ymax_fp { \l_semio_viz_cart_ymax_fp / 2 } }
    }
    { floating } { \semio_viz_bar_domain_span: }
    { range } { \semio_viz_bar_domain_span: }
  } { } { \semio_viz_cart_domain_plain: }
  \bool_if:NT \l_semio_viz_bar_mirror_bool {
    \bool_if:NF \l_semio_viz_cart_ymin_user_bool
      { \fp_set:Nn \l_semio_viz_cart_ymin_fp { - \l_semio_viz_cart_ymax_fp } }
  }
}

% 🎚️ The two edges of category #1's band on the categorical scale.
\cs_new_protected:Npn \semio_viz_bar_band:n #1 {
  \semio_viz_scale_band_edges:nnNN { cart-band } {#1}
    \l_semio_viz_bar_band_lo_fp \l_semio_viz_bar_band_hi_fp
}
\cs_generate_variant:Nn \semio_viz_bar_band:n { V }

% 📏 Slot `#1` of `#2` inside the current band, honouring padding and the barWidth override.
\cs_new_protected:Npn \semio_viz_bar_slot:nn #1#2 {
  \fp_set:Nn \l_semio_viz_bar_inner_fp
    { abs( \l_semio_viz_bar_band_hi_fp - \l_semio_viz_bar_band_lo_fp )
      * ( 1 - \l_semio_viz_bar_padding_fp ) }
  \fp_set:Nn \l_semio_viz_bar_slot_fp { \l_semio_viz_bar_inner_fp / (#2) }
  \fp_set:Nn \l_semio_viz_bar_left_fp {
    ( \l_semio_viz_bar_band_lo_fp + \l_semio_viz_bar_band_hi_fp ) / 2
      - \l_semio_viz_bar_inner_fp / 2 + ( (#1) - 1 ) * \l_semio_viz_bar_slot_fp
  }
  \fp_compare:nNnT { \l_semio_viz_bar_width_fp } > { 0 } {
    \fp_set:Nn \l_semio_viz_bar_left_fp
      { \l_semio_viz_bar_left_fp + ( \l_semio_viz_bar_slot_fp - \l_semio_viz_bar_width_fp ) / 2 }
    \fp_set_eq:NN \l_semio_viz_bar_slot_fp \l_semio_viz_bar_width_fp
  }
}

% 📏 The slot the current series gets inside the band, under the `mode`: side by side, overlapping
% by a fixed step, nested one inside the next, or the full band for a stack.
\cs_new_protected:Npn \semio_viz_bar_slot_for_mode: {
  \str_case:VnF \l_semio_viz_bar_mode_tl {
    { overlapping } {
      \semio_viz_bar_slot:nn { 1 } { 1 }
      \fp_set:Nn \l_semio_viz_bar_slot_fp
        { \l_semio_viz_bar_inner_fp * ( 1 - 0.18 * ( \l_semio_viz_bar_gi_int - 1 ) ) }
      \fp_set:Nn \l_semio_viz_bar_left_fp
        { ( \l_semio_viz_bar_band_lo_fp + \l_semio_viz_bar_band_hi_fp ) / 2
          - \l_semio_viz_bar_slot_fp / 2
          + 0.12 * \l_semio_viz_bar_inner_fp * ( \l_semio_viz_bar_gi_int - 1 ) }
    }
    { nested } {
      \semio_viz_bar_slot:nn { 1 } { 1 }
      \fp_set:Nn \l_semio_viz_bar_slot_fp
        { \l_semio_viz_bar_inner_fp * ( \l_semio_viz_bar_m_int - \l_semio_viz_bar_gi_int + 1 )
          / \l_semio_viz_bar_m_int }
      \fp_set:Nn \l_semio_viz_bar_left_fp
        { ( \l_semio_viz_bar_band_lo_fp + \l_semio_viz_bar_band_hi_fp ) / 2
          - \l_semio_viz_bar_slot_fp / 2 }
    }
  } {
    \semio_viz_bar_slot:nn { \l_semio_viz_bar_gi_int } { \l_semio_viz_bar_m_int }
    \bool_if:NT \l_semio_viz_bar_paired_bool {
      \fp_set:Nn \l_semio_viz_bar_slot_fp { \l_semio_viz_bar_slot_fp * 0.82 }
      \int_compare:nNnTF { 2 * \l_semio_viz_bar_gi_int } > { \l_semio_viz_bar_m_int }
        { \fp_add:Nn \l_semio_viz_bar_left_fp { \l_semio_viz_bar_inner_fp * 0.09 } }
        { \fp_sub:Nn \l_semio_viz_bar_left_fp { \l_semio_viz_bar_inner_fp * 0.09 } }
    }
  }
}

% 🍭 The lollipop form of one bar: a stem down the middle of the slot with a dot on its end.
\cs_new_protected:Npn \semio_viz_bar_emit_lollipop:nnnn #1#2#3#4 {
  \tl_set_eq:NN \l_semio_viz_cart_stroke_tl \l_semio_viz_cart_fill_tl
  \str_if_eq:VnTF \l_semio_viz_bar_orient_tl { horizontal }
    {
      \semio_viz_cart_draw_seg:nnnn {#2} { (#1) + (#3) / 2 } { (#2) + (#4) } { (#1) + (#3) / 2 }
      \semio_viz_cart_draw_dot:nnn { (#2) + (#4) } { (#1) + (#3) / 2 } { (#3) / 2.2 }
    }
    {
      \semio_viz_cart_draw_seg:nnnn { (#1) + (#3) / 2 } {#2} { (#1) + (#3) / 2 } { (#2) + (#4) }
      \semio_viz_cart_draw_dot:nnn { (#1) + (#3) / 2 } { (#2) + (#4) } { (#3) / 2.2 }
    }
}

% 🧱 One bar given band offset, value origin, thickness and length, in the family's orientation.
\cs_new_protected:Npn \semio_viz_bar_emit:nnnn #1#2#3#4 {
  \bool_if:NTF \l_semio_viz_bar_lollipop_bool
    { \semio_viz_bar_emit_lollipop:nnnn {#1} {#2} {#3} {#4} }
    {
      \str_if_eq:VnTF \l_semio_viz_bar_orient_tl { horizontal }
        { \semio_viz_cart_draw_rect:nnnn {#2} {#1} {#4} {#3} }
        { \semio_viz_cart_draw_rect:nnnn {#1} {#2} {#3} {#4} }
    }
  \str_if_eq:VnT \l_semio_viz_cart_labels_tl { value } {
    \str_if_eq:VnTF \l_semio_viz_bar_orient_tl { horizontal }
      { \semio_viz_cart_text:nnnn { (#2) + (#4) + 1 } { (#1) + (#3) / 2 } { west }
          { \fp_eval:n { round( \l_semio_viz_bar_va_fp , 2 ) } } }
      { \semio_viz_cart_text:nnnn { (#1) + (#3) / 2 } { (#2) + (#4) + 1 } { south }
          { \fp_eval:n { round( \l_semio_viz_bar_va_fp , 2 ) } } }
  }
}

% 📏 The two scales of the chart, in the `orient` the family was given: the categorical one across
% the bands, the value one along the bars.
\cs_new_protected:Npn \semio_viz_bar_scales: {
  \str_if_eq:VnTF \l_semio_viz_bar_orient_tl { horizontal }
    {
      \semio_viz_cart_scale_bandy:Nn \l_semio_viz_cart_cats_seq { cart-band }
      \semio_viz_cart_scale_value:nn { linear } { h }
    }
    {
      \semio_viz_cart_scale_band:Nn \l_semio_viz_cart_cats_seq { cart-band }
      \semio_viz_cart_scale_value:nn { linear } { v }
    }
}

% 📊 The grouped, overlapping, nested and paired modes: one bar per category and series, each in
% its own slot of the category's band.
\cs_new_protected:Npn \semio_viz_bar_rows_grouped: {
  \seq_map_indexed_inline:Nn \l_semio_viz_cart_cats_seq {
    \tl_set:Nn \l_semio_viz_bar_cat_tl {##2}
    \semio_viz_bar_band:V \l_semio_viz_bar_cat_tl
    \seq_map_indexed_inline:Nn \l_semio_viz_cart_groups_seq {
      \int_set:Nn \l_semio_viz_bar_gi_int {####1}
      \tl_set:Nn \l_semio_viz_bar_grp_tl {####2}
      \semio_viz_bar_cell_value:
      \bool_if:NT \l_semio_viz_bar_found_bool {
        \semio_viz_bar_slot_for_mode:
        \semio_viz_cart_color:VN \l_semio_viz_bar_gi_int \l_semio_viz_cart_fill_tl
        \semio_viz_cart_ymap:VN \l_semio_viz_bar_va_fp \l_semio_viz_cart_v_fp
        \semio_viz_bar_emit:nnnn
          { \fp_eval:n { \l_semio_viz_bar_left_fp } }
          { \fp_eval:n { \l_semio_viz_bar_zero_fp } }
          { \fp_eval:n { \l_semio_viz_bar_slot_fp } }
          { \fp_eval:n { \l_semio_viz_cart_v_fp - \l_semio_viz_bar_zero_fp } }
        \bool_if:NT \l_semio_viz_bar_mirror_bool {
          \semio_viz_bar_emit:nnnn
            { \fp_eval:n { \l_semio_viz_bar_left_fp } }
            { \fp_eval:n { \l_semio_viz_bar_zero_fp } }
            { \fp_eval:n { \l_semio_viz_bar_slot_fp } }
            { \fp_eval:n { \l_semio_viz_bar_zero_fp - \l_semio_viz_cart_v_fp } }
        }
      }
    }
  }
}

\bool_new:N \l_semio_viz_bar_percent_bool

% 🥞 The stacked and percentage modes: the whole band per category, the series piled inside it.
\cs_new_protected:Npn \semio_viz_bar_rows_stacked: {
  \bool_if:NT \l_semio_viz_bar_percent_bool
    { \semio_viz_cart_totals:VVVN \l_semio_viz_cart_data_tl \l_semio_viz_cart_x_tl
        \l_semio_viz_cart_y_tl \l_semio_viz_cart_total_prop }
  \seq_map_indexed_inline:Nn \l_semio_viz_cart_cats_seq {
    \tl_set:Nn \l_semio_viz_bar_cat_tl {##2}
    \semio_viz_bar_band:V \l_semio_viz_bar_cat_tl
    \semio_viz_bar_slot:nn { 1 } { 1 }
    \seq_map_indexed_inline:Nn \l_semio_viz_cart_groups_seq {
      \int_set:Nn \l_semio_viz_bar_gi_int {####1}
      \tl_set:Nn \l_semio_viz_bar_grp_tl {####2}
      \semio_viz_bar_cell_value:
      \bool_if:NT \l_semio_viz_bar_found_bool { \semio_viz_bar_stack_one: }
    }
  }
}

% 🧱 One segment of a stack: from the category's running total to that total plus this value,
% the value first turned into a percentage when the mode asks for it.
\cs_new_protected:Npn \semio_viz_bar_stack_one: {
  \bool_if:NT \l_semio_viz_bar_percent_bool {
    \prop_get:NVNT \l_semio_viz_cart_total_prop \l_semio_viz_bar_cat_tl \l_tmpb_tl
      { \fp_set:Nn \l_semio_viz_bar_va_fp { 100 * \l_semio_viz_bar_va_fp / \l_tmpb_tl } }
  }
  \semio_viz_cart_acc_get:NVN \l_semio_viz_cart_acc_prop \l_semio_viz_bar_cat_tl \l_semio_viz_cart_a_fp
  \fp_set:Nn \l_semio_viz_cart_b_fp { \l_semio_viz_cart_a_fp + \l_semio_viz_bar_va_fp }
  \prop_put:NVx \l_semio_viz_cart_acc_prop \l_semio_viz_bar_cat_tl
    { \fp_eval:n { \l_semio_viz_cart_b_fp } }
  \semio_viz_cart_color:VN \l_semio_viz_bar_gi_int \l_semio_viz_cart_fill_tl
  \semio_viz_cart_ymap:VN \l_semio_viz_cart_a_fp \l_semio_viz_cart_c_fp
  \semio_viz_cart_ymap:VN \l_semio_viz_cart_b_fp \l_semio_viz_cart_d_fp
  \semio_viz_bar_emit:nnnn
    { \fp_eval:n { \l_semio_viz_bar_left_fp } }
    { \fp_eval:n { \l_semio_viz_cart_c_fp } }
    { \fp_eval:n { \l_semio_viz_bar_slot_fp } }
    { \fp_eval:n { \l_semio_viz_cart_d_fp - \l_semio_viz_cart_c_fp } }
}

% ↔️ One segment of a diverging stack: it grows in the direction #2 from the accumulator #1, so the
% two halves of the series pile away from the baseline instead of onto each other.
\cs_new_protected:Npn \semio_viz_bar_diverge_side:Nn #1#2 {
  \semio_viz_cart_acc_get:NVN #1 \l_semio_viz_bar_cat_tl \l_semio_viz_cart_a_fp
  \fp_set:Nn \l_semio_viz_cart_b_fp { \l_semio_viz_cart_a_fp + (#2) * abs( \l_semio_viz_bar_va_fp ) }
  \prop_put:NVx #1 \l_semio_viz_bar_cat_tl { \fp_eval:n { \l_semio_viz_cart_b_fp } }
  \semio_viz_cart_color:VN \l_semio_viz_bar_gi_int \l_semio_viz_cart_fill_tl
  \semio_viz_cart_ymap:VN \l_semio_viz_cart_a_fp \l_semio_viz_cart_c_fp
  \semio_viz_cart_ymap:VN \l_semio_viz_cart_b_fp \l_semio_viz_cart_d_fp
  \semio_viz_bar_emit:nnnn
    { \fp_eval:n { \l_semio_viz_bar_left_fp } }
    { \fp_eval:n { \l_semio_viz_cart_c_fp } }
    { \fp_eval:n { \l_semio_viz_bar_slot_fp } }
    { \fp_eval:n { \l_semio_viz_cart_d_fp - \l_semio_viz_cart_c_fp } }
}

% ↔️ The diverging mode: the first half of the series to one side of the baseline, the rest to the other.
\cs_new_protected:Npn \semio_viz_bar_rows_diverging: {
  \seq_map_indexed_inline:Nn \l_semio_viz_cart_cats_seq {
    \tl_set:Nn \l_semio_viz_bar_cat_tl {##2}
    \semio_viz_bar_band:V \l_semio_viz_bar_cat_tl
    \semio_viz_bar_slot:nn { 1 } { 1 }
    \seq_map_indexed_inline:Nn \l_semio_viz_cart_groups_seq {
      \int_set:Nn \l_semio_viz_bar_gi_int {####1}
      \tl_set:Nn \l_semio_viz_bar_grp_tl {####2}
      \semio_viz_bar_cell_value:
      \bool_if:NT \l_semio_viz_bar_found_bool {
        \int_compare:nNnTF { 2 * \l_semio_viz_bar_gi_int } > { \l_semio_viz_bar_m_int }
          { \semio_viz_bar_diverge_side:Nn \l_semio_viz_cart_acc_prop { 1 } }
          { \semio_viz_bar_diverge_side:Nn \l_semio_viz_cart_neg_prop { -1 } }
      }
    }
  }
}

% 🧾 The waterfall mode: each category's bar starts where the previous one ended, coloured by its
% own direction.
\cs_new_protected:Npn \semio_viz_bar_rows_waterfall: {
  \fp_zero:N \l_semio_viz_cart_e_fp
  \seq_map_indexed_inline:Nn \l_semio_viz_cart_cats_seq {
    \tl_set:Nn \l_semio_viz_bar_cat_tl {##2}
    \tl_clear:N \l_semio_viz_bar_grp_tl
    \semio_viz_bar_band:V \l_semio_viz_bar_cat_tl
    \semio_viz_bar_slot:nn { 1 } { 1 }
    \semio_viz_bar_cell_value:
    \bool_if:NT \l_semio_viz_bar_found_bool {
      \fp_set:Nn \l_semio_viz_cart_b_fp { \l_semio_viz_cart_e_fp + \l_semio_viz_bar_va_fp }
      \fp_compare:nNnTF { \l_semio_viz_bar_va_fp } < { 0 }
        { \tl_set:Nn \l_semio_viz_cart_fill_tl { \semio_viz_theme_semantic:n { negative } } }
        { \tl_set:Nn \l_semio_viz_cart_fill_tl { \semio_viz_theme_semantic:n { positive } } }
      \semio_viz_cart_ymap:VN \l_semio_viz_cart_e_fp \l_semio_viz_cart_c_fp
      \semio_viz_cart_ymap:VN \l_semio_viz_cart_b_fp \l_semio_viz_cart_d_fp
      \semio_viz_bar_emit:nnnn
        { \fp_eval:n { \l_semio_viz_bar_left_fp } }
        { \fp_eval:n { \l_semio_viz_cart_c_fp } }
        { \fp_eval:n { \l_semio_viz_bar_slot_fp } }
        { \fp_eval:n { \l_semio_viz_cart_d_fp - \l_semio_viz_cart_c_fp } }
      \fp_set_eq:NN \l_semio_viz_cart_e_fp \l_semio_viz_cart_b_fp
    }
  }
}

% ↕️ One span: a floating bar between the low and high column, or the barbell of the `range` mode.
\cs_new_protected:Npn \semio_viz_bar_span_one: {
  \semio_viz_cart_color:nN { 1 } \l_semio_viz_cart_fill_tl
  \semio_viz_cart_ymap:VN \l_semio_viz_bar_va_fp \l_semio_viz_cart_c_fp
  \semio_viz_cart_ymap:VN \l_semio_viz_bar_vb_fp \l_semio_viz_cart_d_fp
  \str_if_eq:VnTF \l_semio_viz_bar_mode_tl { range }
    {
      \tl_set_eq:NN \l_semio_viz_cart_stroke_tl \l_semio_viz_cart_fill_tl
      \semio_viz_cart_draw_seg:nnnn
        { \fp_eval:n { \l_semio_viz_bar_left_fp + \l_semio_viz_bar_slot_fp / 2 } }
        { \fp_eval:n { \l_semio_viz_cart_c_fp } }
        { \fp_eval:n { \l_semio_viz_bar_left_fp + \l_semio_viz_bar_slot_fp / 2 } }
        { \fp_eval:n { \l_semio_viz_cart_d_fp } }
      \semio_viz_cart_draw_dot:nnn
        { \fp_eval:n { \l_semio_viz_bar_left_fp + \l_semio_viz_bar_slot_fp / 2 } }
        { \fp_eval:n { \l_semio_viz_cart_c_fp } } { 1 }
      \semio_viz_cart_draw_dot:nnn
        { \fp_eval:n { \l_semio_viz_bar_left_fp + \l_semio_viz_bar_slot_fp / 2 } }
        { \fp_eval:n { \l_semio_viz_cart_d_fp } } { 1 }
    }
    {
      \semio_viz_bar_emit:nnnn
        { \fp_eval:n { \l_semio_viz_bar_left_fp } }
        { \fp_eval:n { \l_semio_viz_cart_c_fp } }
        { \fp_eval:n { \l_semio_viz_bar_slot_fp } }
        { \fp_eval:n { \l_semio_viz_cart_d_fp - \l_semio_viz_cart_c_fp } }
    }
}

% ↕️ The span and range modes: one floating bar per category between its two value columns.
\cs_new_protected:Npn \semio_viz_bar_rows_span: {
  \seq_map_indexed_inline:Nn \l_semio_viz_cart_cats_seq {
    \tl_set:Nn \l_semio_viz_bar_cat_tl {##2}
    \tl_clear:N \l_semio_viz_bar_grp_tl
    \semio_viz_bar_band:V \l_semio_viz_bar_cat_tl
    \semio_viz_bar_slot:nn { 1 } { 1 }
    \semio_viz_bar_cell_value:
    \bool_if:NT \l_semio_viz_bar_found_bool { \semio_viz_bar_span_one: }
  }
}

% ▶️ The whole family run: defaults, the option list #1, the frame, categories and series, the
% value axis, the scales and grid, then the rows the `mode` asks for, with axes and legend.
\cs_new_protected:Npn \semio_viz_bar_render:n #1 {
  \semio_viz_frame_require:n { SemioVizRunFamily }
  \semio_viz_bar_keys_reset:
  \keys_set:nn { semio / viz / family / bar } {#1}
  \semio_viz_cart_prepare:
  \semio_viz_bar_domain:
  \semio_viz_bar_scales:
  \semio_viz_cart_grid_y:
  \semio_viz_cart_axis_frame:
  \int_set:Nn \l_semio_viz_bar_m_int { \seq_count:N \l_semio_viz_cart_groups_seq }
  \semio_viz_cart_ymap:xN { \fp_eval:n { \l_semio_viz_bar_baseline_fp } } \l_semio_viz_bar_zero_fp
  \prop_clear:N \l_semio_viz_cart_acc_prop
  \prop_clear:N \l_semio_viz_cart_neg_prop
  \bool_set_false:N \l_semio_viz_bar_percent_bool
  \str_case:VnF \l_semio_viz_bar_mode_tl {
    { stacked } { \semio_viz_bar_rows_stacked: }
    { percent } { \bool_set_true:N \l_semio_viz_bar_percent_bool \semio_viz_bar_rows_stacked: }
    { diverging } { \semio_viz_bar_rows_diverging: }
    { waterfall } { \semio_viz_bar_rows_waterfall: }
    { floating } { \semio_viz_bar_rows_span: }
    { range } { \semio_viz_bar_rows_span: }
  } { \semio_viz_bar_rows_grouped: }
  \str_if_eq:VnTF \l_semio_viz_bar_orient_tl { horizontal }
    {
      \semio_viz_cart_axis_labels_bandy:Nn \l_semio_viz_cart_cats_seq { cart-band }
      \semio_viz_cart_axis_ticks:n { h }
    }
    {
      \semio_viz_cart_axis_labels_band:Nn \l_semio_viz_cart_cats_seq { cart-band }
      \semio_viz_cart_axis_ticks:n { v }
    }
