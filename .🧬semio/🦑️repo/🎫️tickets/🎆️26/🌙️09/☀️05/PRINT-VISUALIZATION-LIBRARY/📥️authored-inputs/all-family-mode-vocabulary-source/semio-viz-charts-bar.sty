%region 🔖️Preparation
% 🧭 Shared preparation: categories, series and the sort order of a category-based family.
\cs_new_protected:Npn \semio_viz_cart_prepare: {
  \semio_viz_cart_rect_compute:
  \semio_viz_cart_cats:VVN \l_semio_viz_cart_data_tl \l_semio_viz_cart_x_tl \l_semio_viz_cart_cats_seq
  \tl_if_empty:NTF \l_semio_viz_cart_group_tl
    {
      \seq_clear:N \l_semio_viz_cart_groups_seq
      \seq_put_right:Nn \l_semio_viz_cart_groups_seq { }
    }
    { \semio_viz_cart_cats:VVN \l_semio_viz_cart_data_tl \l_semio_viz_cart_group_tl
        \l_semio_viz_cart_groups_seq }
  \semio_viz_cart_sort_apply:
}

% ⚖️ Compares two categories by their totals under the relation #3, for the category sort.
\cs_new_protected:Npn \semio_viz_cart_sort_cmp:nnn #1#2#3 {
  \prop_get:NnNF \l_semio_viz_cart_total_prop {#1} \l_tmpa_tl { \tl_set:Nn \l_tmpa_tl { 0 } }
  \prop_get:NnNF \l_semio_viz_cart_total_prop {#2} \l_tmpb_tl { \tl_set:Nn \l_tmpb_tl { 0 } }
  \fp_compare:nNnTF { \l_tmpa_tl } #3 { \l_tmpb_tl } { \sort_return_swapped: } { \sort_return_same: }
}

% 🔃 Re-orders the categories by their totals when `sort` asks for it; `none` keeps the data order.
\cs_new_protected:Npn \semio_viz_cart_sort_apply: {
  \str_case:VnT \l_semio_viz_cart_sort_tl { { ascending } { } { descending } { } } {
    \semio_viz_cart_totals:VVVN \l_semio_viz_cart_data_tl \l_semio_viz_cart_x_tl
      \l_semio_viz_cart_y_tl \l_semio_viz_cart_total_prop
    \str_if_eq:VnTF \l_semio_viz_cart_sort_tl { ascending }
      { \seq_sort:Nn \l_semio_viz_cart_cats_seq { \semio_viz_cart_sort_cmp:nnn {##1} {##2} { > } } }
      { \seq_sort:Nn \l_semio_viz_cart_cats_seq { \semio_viz_cart_sort_cmp:nnn {##1} {##2} { < } } }
  }
}

% 📐 Value domain of a plain value column, widened to contain the baseline.
\cs_new_protected:Npn \semio_viz_cart_domain_plain: {
  \semio_viz_cart_extent:VVNN \l_semio_viz_cart_data_tl \l_semio_viz_cart_y_tl
    \l_semio_viz_cart_a_fp \l_semio_viz_cart_b_fp
  \bool_if:NF \l_semio_viz_cart_ymin_user_bool
    { \fp_set:Nn \l_semio_viz_cart_ymin_fp
        { min( \l_semio_viz_cart_a_fp , \l_semio_viz_bar_baseline_fp ) } }
  \bool_if:NF \l_semio_viz_cart_ymax_user_bool
    { \fp_set:Nn \l_semio_viz_cart_ymax_fp
        { max( \l_semio_viz_cart_b_fp , \l_semio_viz_bar_baseline_fp ) } }
  \fp_compare:nNnT { \l_semio_viz_cart_ymax_fp } = { \l_semio_viz_cart_ymin_fp }
    { \fp_add:Nn \l_semio_viz_cart_ymax_fp { 1 } }
}

% 📐 Value domain of a stack: the largest per-category total.
\cs_new_protected:Npn \semio_viz_cart_domain_stacked: {
  \semio_viz_cart_totals:VVVN \l_semio_viz_cart_data_tl \l_semio_viz_cart_x_tl
    \l_semio_viz_cart_y_tl \l_semio_viz_cart_total_prop
  \fp_zero:N \l_semio_viz_cart_b_fp
  \prop_map_inline:Nn \l_semio_viz_cart_total_prop
    { \fp_set:Nn \l_semio_viz_cart_b_fp { max( \l_semio_viz_cart_b_fp , ##2 ) } }
  \bool_if:NF \l_semio_viz_cart_ymin_user_bool { \fp_zero:N \l_semio_viz_cart_ymin_fp }
  \bool_if:NF \l_semio_viz_cart_ymax_user_bool
    { \fp_set_eq:NN \l_semio_viz_cart_ymax_fp \l_semio_viz_cart_b_fp }
  \fp_compare:nNnT { \l_semio_viz_cart_ymax_fp } = { \l_semio_viz_cart_ymin_fp }
    { \fp_add:Nn \l_semio_viz_cart_ymax_fp { 1 } }
}
%endregion 🔖️Preparation

%region 🔖️CellAccess
% 🔍 Value of the current (category, group) cell; `found` stays false when the pair has no row.
\bool_new:N \l_semio_viz_bar_found_bool
\fp_new:N \l_semio_viz_bar_va_fp
\fp_new:N \l_semio_viz_bar_vb_fp
\tl_new:N \l_semio_viz_bar_cat_tl
\tl_new:N \l_semio_viz_bar_grp_tl
\tl_new:N \l_semio_viz_bar_val_tl
\tl_new:N \l_semio_viz_bar_lbl_tl

\cs_new_protected:Npn \semio_viz_bar_cell_take:n #1 {
  \semio_viz_table_cell:nnVN { \l_semio_viz_cart_data_tl } {#1} \l_semio_viz_cart_y_tl
    \l_semio_viz_bar_val_tl
  \fp_set:Nn \l_semio_viz_bar_va_fp { \l_semio_viz_bar_val_tl }
  \tl_if_empty:NF \l_semio_viz_cart_yb_tl {
    \semio_viz_table_cell:nnVN { \l_semio_viz_cart_data_tl } {#1} \l_semio_viz_cart_yb_tl
      \l_semio_viz_bar_val_tl
    \fp_set:Nn \l_semio_viz_bar_vb_fp { \l_semio_viz_bar_val_tl }
  }
  \tl_if_empty:NTF \l_semio_viz_cart_label_tl
    { \tl_set_eq:NN \l_semio_viz_bar_lbl_tl \l_semio_viz_bar_cat_tl }
    { \semio_viz_table_cell:nnVN { \l_semio_viz_cart_data_tl } {#1} \l_semio_viz_cart_label_tl
        \l_semio_viz_bar_lbl_tl }
  \bool_set_true:N \l_semio_viz_bar_found_bool
}

% 🔎 Takes data row #1 only when it belongs to the series being drawn; an ungrouped chart takes every row.
\cs_new_protected:Npn \semio_viz_bar_cell_group_match:n #1 {
  \tl_if_empty:NTF \l_semio_viz_cart_group_tl
    { \semio_viz_bar_cell_take:n {#1} }
    {
      \semio_viz_table_cell:nnVN { \l_semio_viz_cart_data_tl } {#1} \l_semio_viz_cart_group_tl
        \l_semio_viz_cart_cell_b_tl
      \tl_if_eq:NNT \l_semio_viz_cart_cell_b_tl \l_semio_viz_bar_grp_tl
        { \semio_viz_bar_cell_take:n {#1} }
    }
}

% 🔎 Finds the cell of the current category and series, leaving `found` false when the data has none.
\cs_new_protected:Npn \semio_viz_bar_cell_value: {
  \bool_set_false:N \l_semio_viz_bar_found_bool
  \fp_zero:N \l_semio_viz_bar_va_fp
  \fp_zero:N \l_semio_viz_bar_vb_fp
  \semio_viz_table_nrows:VN \l_semio_viz_cart_data_tl \l_semio_viz_cart_nrows_int
  \int_step_inline:nn { \l_semio_viz_cart_nrows_int } {
    \semio_viz_table_cell:nnVN { \l_semio_viz_cart_data_tl } {##1} \l_semio_viz_cart_x_tl
      \l_semio_viz_cart_cell_tl
    \tl_if_eq:NNT \l_semio_viz_cart_cell_tl \l_semio_viz_bar_cat_tl
      { \semio_viz_bar_cell_group_match:n {##1} }
  }
}
%endregion 🔖️CellAccess

%region 🔖️Families
% 📊 bar — every rectangular categorical comparison of taxonomy §1, driven by `mode` and `orient`.
\fp_new:N \l_semio_viz_bar_band_lo_fp
\fp_new:N \l_semio_viz_bar_band_hi_fp
\fp_new:N \l_semio_viz_bar_slot_fp
