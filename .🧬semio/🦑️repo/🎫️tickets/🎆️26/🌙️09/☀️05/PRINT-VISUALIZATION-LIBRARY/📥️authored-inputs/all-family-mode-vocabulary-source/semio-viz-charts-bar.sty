%region 🔖️CartesianStatistics
% 🧮 Column extent, per-category totals, stack offsets, regression and moving windows.
\cs_new_protected:Npn \semio_viz_cart_extent:nnNN #1#2#3#4 {
  \semio_viz_table_col_min:nnN {#1} {#2} #3
  \semio_viz_table_col_max:nnN {#1} {#2} #4
  \fp_compare:nNnT {#3} = {#4} { \fp_add:Nn #4 { 1 } }
}
\cs_generate_variant:Nn \semio_viz_cart_extent:nnNN { VVNN, VnNN, nVNN }

% ➕ The absolute total per category, which is what a percentage stack normalises against.
\cs_new_protected:Npn \semio_viz_cart_totals_run: {
  \prop_clear:N \l_semio_viz_cart_out_prop
  \semio_viz_table_nrows:VN \l_semio_viz_cart_arg_table_tl \l_semio_viz_cart_nrows_int
  \int_step_inline:nn { \l_semio_viz_cart_nrows_int } {
    \semio_viz_table_cell:nnVN { \l_semio_viz_cart_arg_table_tl } {##1}
      \l_semio_viz_cart_arg_col_tl \l_semio_viz_cart_cell_tl
    \semio_viz_table_cell:nnVN { \l_semio_viz_cart_arg_table_tl } {##1}
      \l_semio_viz_cart_arg_colb_tl \l_semio_viz_cart_cell_b_tl
    \prop_get:NVNTF \l_semio_viz_cart_out_prop \l_semio_viz_cart_cell_tl \l_tmpb_tl
      { \prop_put:NVx \l_semio_viz_cart_out_prop \l_semio_viz_cart_cell_tl
          { \fp_eval:n { \l_tmpb_tl + abs( \l_semio_viz_cart_cell_b_tl ) } } }
      { \prop_put:NVx \l_semio_viz_cart_out_prop \l_semio_viz_cart_cell_tl
          { \fp_eval:n { abs( \l_semio_viz_cart_cell_b_tl ) } } }
  }
}

% ➕ The same totals of table #1 over its category column #2 and value column #3, into #4.
\cs_new_protected:Npn \semio_viz_cart_totals:nnnN #1#2#3#4 {
  \tl_set:Nn \l_semio_viz_cart_arg_table_tl {#1}
  \tl_set:Nn \l_semio_viz_cart_arg_col_tl {#2}
  \tl_set:Nn \l_semio_viz_cart_arg_colb_tl {#3}
  \semio_viz_cart_totals_run:
  \prop_set_eq:NN #4 \l_semio_viz_cart_out_prop
}
\cs_generate_variant:Nn \semio_viz_cart_totals:nnnN { VVVN, nVVN }

% ➕ Running stack offset of one key; zero when the key has not been seen yet.
\cs_new_protected:Npn \semio_viz_cart_acc_get:NnN #1#2#3 {
  \prop_get:NnNTF #1 {#2} \l_tmpb_tl { \fp_set:Nn #3 { \l_tmpb_tl } } { \fp_zero:N #3 }
}
\cs_generate_variant:Nn \semio_viz_cart_acc_get:NnN { NVN }

% 📈 Ordinary least squares over the map sequence; slope and intercept land in the result fps.
\fp_new:N \l_semio_viz_cart_slope_fp
\fp_new:N \l_semio_viz_cart_intercept_fp
\int_new:N \l_semio_viz_cart_k_int

\cs_new_protected:Npn \semio_viz_cart_regression_run: {
  \fp_zero:N \l_semio_viz_cart_a_fp
  \fp_zero:N \l_semio_viz_cart_b_fp
  \fp_zero:N \l_semio_viz_cart_c_fp
  \fp_zero:N \l_semio_viz_cart_d_fp
  \int_set:Nn \l_semio_viz_cart_n_int { \seq_count:N \l_semio_viz_cart_map_seq }
  \seq_map_inline:Nn \l_semio_viz_cart_map_seq {
    \fp_add:Nn \l_semio_viz_cart_a_fp { \clist_item:nn {##1} { 1 } }
    \fp_add:Nn \l_semio_viz_cart_b_fp { \clist_item:nn {##1} { 2 } }
    \fp_add:Nn \l_semio_viz_cart_c_fp
      { ( \clist_item:nn {##1} { 1 } ) * ( \clist_item:nn {##1} { 2 } ) }
    \fp_add:Nn \l_semio_viz_cart_d_fp { ( \clist_item:nn {##1} { 1 } ) ^ 2 }
  }
  \fp_set:Nn \l_semio_viz_cart_slope_fp {
    ( \l_semio_viz_cart_n_int * \l_semio_viz_cart_c_fp
      - \l_semio_viz_cart_a_fp * \l_semio_viz_cart_b_fp )
    / ( \l_semio_viz_cart_n_int * \l_semio_viz_cart_d_fp - ( \l_semio_viz_cart_a_fp ) ^ 2 )
  }
  \fp_set:Nn \l_semio_viz_cart_intercept_fp
    { ( \l_semio_viz_cart_b_fp - \l_semio_viz_cart_slope_fp * \l_semio_viz_cart_a_fp )
      / \l_semio_viz_cart_n_int }
}

% 📉 The least-squares line through the point sequence #1, into the slope and intercept registers.
\cs_new_protected:Npn \semio_viz_cart_regression:N #1 {
  \seq_set_eq:NN \l_semio_viz_cart_map_seq #1
  \semio_viz_cart_regression_run:
}

% 🪟 Trailing moving average of the map sequence into the out sequence.
\int_new:N \l_semio_viz_cart_window_int

\cs_new_protected:Npn \semio_viz_cart_window_run: {
  \seq_clear:N \l_semio_viz_cart_out_seq
  \int_set:Nn \l_semio_viz_cart_n_int { \seq_count:N \l_semio_viz_cart_map_seq }
  \int_step_variable:nNn { \l_semio_viz_cart_n_int } \l_semio_viz_cart_i_int {
    \fp_zero:N \l_semio_viz_cart_v_fp
    \int_set:Nn \l_semio_viz_cart_j_int
      { \int_max:nn { 1 } { \l_semio_viz_cart_i_int - \l_semio_viz_cart_window_int + 1 } }
    \int_step_variable:nnNn { \l_semio_viz_cart_j_int } { \l_semio_viz_cart_i_int }
      \l_semio_viz_cart_k_int
      { \fp_add:Nn \l_semio_viz_cart_v_fp
          { \seq_item:Nn \l_semio_viz_cart_map_seq { \l_semio_viz_cart_k_int } } }
    \seq_put_right:Nx \l_semio_viz_cart_out_seq { \fp_eval:n
      { \l_semio_viz_cart_v_fp / ( \l_semio_viz_cart_i_int - \l_semio_viz_cart_j_int + 1 ) } }
  }
}

% 🪟 The trailing mean of the sequence #1 over a window of #2, into the out sequence.
\cs_new_protected:Npn \semio_viz_cart_window_mean:Nn #1#2 {
  \seq_set_eq:NN \l_semio_viz_cart_map_seq #1
  \int_set:Nn \l_semio_viz_cart_window_int {#2}
  \semio_viz_cart_window_run:
}
%endregion 🔖️CartesianStatistics

%region 🔖️ProbeCanvas
