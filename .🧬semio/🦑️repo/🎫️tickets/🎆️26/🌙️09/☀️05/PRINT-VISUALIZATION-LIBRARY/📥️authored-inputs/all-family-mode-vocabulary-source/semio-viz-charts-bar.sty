  \seq_map_inline:Nn \l_semio_viz_cart_cats_seq {
    \int_incr:N \l_semio_viz_cart_i_int
    \int_compare:nNnT { \l_semio_viz_cart_i_int } < { \l_semio_viz_rank_n_int + 1 }
      { \seq_put_right:Nn \l_semio_viz_cart_scratch_seq {##1} }
  }
  \seq_set_eq:NN \l_semio_viz_cart_cats_seq \l_semio_viz_cart_scratch_seq
  \bool_if:NT \l_semio_viz_rank_podium_bool { \semio_viz_rank_podium_order: }
  \fp_zero:N \l_semio_viz_cart_ymin_fp
  \fp_set:Nn \l_semio_viz_cart_ymax_fp { 1 }
  \prop_map_inline:Nn \l_semio_viz_cart_total_prop
    { \fp_set:Nn \l_semio_viz_cart_ymax_fp { max( \l_semio_viz_cart_ymax_fp , ##2 ) } }
  \semio_viz_cart_scale_band:Nn \l_semio_viz_cart_cats_seq { cart-band }
  \semio_viz_cart_scale_value:nn { linear } { v }
  \semio_viz_cart_axis_frame:
  \semio_viz_cart_ymap:nN { 0 } \l_semio_viz_bar_zero_fp
  \fp_set:Nn \l_semio_viz_bar_padding_fp { 0.25 }
  \fp_zero:N \l_semio_viz_bar_width_fp
  \seq_map_indexed_inline:Nn \l_semio_viz_cart_cats_seq {
    \int_set:Nn \l_semio_viz_bar_gi_int {##1}
    \semio_viz_bar_band:n {##2}
    \semio_viz_bar_slot:nn { 1 } { 1 }
    \prop_get:NnNF \l_semio_viz_cart_total_prop {##2} \l_tmpb_tl { \tl_set:Nn \l_tmpb_tl { 0 } }
    \semio_viz_cart_ymap:nN { \l_tmpb_tl } \l_semio_viz_cart_d_fp
    \semio_viz_cart_color:VN \l_semio_viz_bar_gi_int \l_semio_viz_cart_fill_tl
    \semio_viz_cart_draw_rect:nnnn
      { \fp_eval:n { \l_semio_viz_bar_left_fp } } { \fp_eval:n { \l_semio_viz_bar_zero_fp } }
      { \fp_eval:n { \l_semio_viz_bar_slot_fp } }
      { \fp_eval:n { \l_semio_viz_cart_d_fp - \l_semio_viz_bar_zero_fp } }
  }
  \semio_viz_cart_axis_labels_band:Nn \l_semio_viz_cart_cats_seq { cart-band }
  \semio_viz_cart_axis_ticks:n { v }
}

