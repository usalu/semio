    \cs_if_exist:NT \l_semio_viz_width_fp { \fp_set:Nn \l_semio_viz_width_fp {#1} }
    \cs_if_exist:NT \l_semio_viz_height_fp { \fp_set:Nn \l_semio_viz_height_fp {#2} }
    \fp_set:Nn \l_semio_viz_cart_w_fp {#1}
    \fp_set:Nn \l_semio_viz_cart_h_fp {#2}
    \useasboundingbox ( 0 , 0 ) rectangle ( #1 , #2 ) ;
  }
  { \bool_set_false:N \l_semio_viz_in_figure_bool \end{tikzpicture} }
