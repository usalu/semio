    \semio_viz_sci_enter:nnn { sci-seqlogo }
      {
        alphabetSize=4 , columnWidth=6 , height=26 , axes=false , grid=false ,
        columns={
          A:20+C:2+G:1+T:1 , A:3+C:1+G:19+T:1 , A:1+C:1+G:1+T:21 , A:6+C:6+G:6+T:6 ,
          A:2+C:18+G:2+T:2 , A:1+C:1+G:21+T:1 , A:5+C:4+G:9+T:6
        }
      }
      {#1}
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_bio_columns_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_bio_logo_column:n {##1}
      }
  }
% 📏 Totals the counts of column #1, derives its Shannon entropy and information content, then stacks its letters.
\cs_new_protected:Npn \semio_viz_bio_logo_column:n #1
  {
    \seq_set_split:Nnn \l_tmpa_seq { + } {#1}
    \fp_zero:N \l_semio_viz_sci_e_fp
    \seq_map_inline:Nn \l_tmpa_seq
      {
        \semio_viz_sci_split_colon:Nn \l_tmpb_seq {##1}
        \fp_add:Nn \l_semio_viz_sci_e_fp { \seq_item:Nn \l_tmpb_seq { 2 } }
      }
    \fp_zero:N \l_semio_viz_sci_f_fp
    \seq_map_inline:Nn \l_tmpa_seq
      {
        \semio_viz_sci_split_colon:Nn \l_tmpb_seq {##1}
        \fp_compare:nNnT { \seq_item:Nn \l_tmpb_seq { 2 } } > { 0 }
          {
            \fp_sub:Nn \l_semio_viz_sci_f_fp
              {
                \seq_item:Nn \l_tmpb_seq { 2 } / \l_semio_viz_sci_e_fp
                * ln ( \seq_item:Nn \l_tmpb_seq { 2 } / \l_semio_viz_sci_e_fp ) / ln (2)
              }
          }
      }
    \fp_set:Nn \l_semio_viz_sci_g_fp
      { ln ( \l_semio_viz_bio_alphabet_int ) / ln (2) - \l_semio_viz_sci_f_fp }
    \fp_zero:N \l_semio_viz_sci_re_fp
    \seq_map_inline:Nn \l_tmpa_seq { \semio_viz_bio_logo_letter:n {##1} }
    \semio_viz_sci_report_values:nn { seqlogo/information }
      { \int_use:N \l_tmpa_int , \fp_to_decimal:N \l_semio_viz_sci_g_fp }
  }
% 🅰️ Scales the letter of entry #1 to its share of the column's information content and stacks it on the ones below.
\cs_new_protected:Npn \semio_viz_bio_logo_letter:n #1
  {
    \semio_viz_sci_split_colon:Nn \l_tmpb_seq {#1}
    \fp_set:Nn \l_semio_viz_sci_im_fp
      {
        \l_semio_viz_sci_h_fp * \l_semio_viz_sci_g_fp
        / ( ln ( \l_semio_viz_bio_alphabet_int ) / ln (2) )
        * \seq_item:Nn \l_tmpb_seq { 2 } / \l_semio_viz_sci_e_fp
      }
    \tl_set:Nx \l_semio_viz_bio_key_tl { \seq_item:Nn \l_tmpb_seq { 1 } }
    \int_set:Nn \l_semio_viz_bio_letter_int
      { \str_case:Vn \l_semio_viz_bio_key_tl { { A } { 1 } { C } { 2 } { G } { 3 } { T } { 4 } } }
    \fp_compare:nNnT { \l_semio_viz_sci_im_fp } > { 0.4 }
      {
        \node
          [
            font=\c_semio_viz_theme_font_title_tl ,
            text=\semio_viz_sci_hue:n { \l_semio_viz_bio_letter_int } ,
            anchor=south , inner~sep=0pt ,
            yscale=\fp_eval:n { \l_semio_viz_sci_im_fp / 2.2 } , xscale=1.4
          ]
          at ( \fp_eval:n { ( \l_tmpa_int - 0.5 ) * \l_semio_viz_bio_colw_fp } ,
               \fp_eval:n { \l_semio_viz_sci_re_fp } )
          { \seq_item:Nn \l_tmpb_seq { 1 } } ;
        \fp_add:Nn \l_semio_viz_sci_re_fp { \l_semio_viz_sci_im_fp }
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-contact-map` (§21 contact matrices):
%    bins (int, 24): matrix size. expr (l3fp over \SemioX,\SemioY as bin indices): the contact frequency.
%    cell (fp, 2): cell size in millimetres. logScale (bool, true): colour by the log of the value.
\bool_new:N \l_semio_viz_bio_log_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-contact-map }
% 🕸️ Binds the `sci-contact-map` keys to the bin count, the contact expression, the cell size and the log-scale switch.
\keys_define:nn { semio / viz / family / sci-contact-map }
  {
    bins     .int_set:N  = \l_semio_viz_bio_samples_int ,
    expr     .tl_set:N   = \l_semio_viz_bio_key_tl ,
    cell     .fp_set:N   = \l_semio_viz_bio_cell_fp ,
    logScale .bool_set:N = \l_semio_viz_bio_log_bool ,
  }

% 🧬 §21 Hi-C contact map: a symmetric matrix whose value is evaluated per cell, coloured on a sequential ramp.
\SemioVizFamily { sci-contact-map }
  {
    \semio_viz_sci_enter:nnn { sci-contact-map }
      {
        bins=24 , cell=2 , logScale=true , axes=false , grid=false ,
        expr={ 1 / ( 1 + abs ( \SemioX - \SemioY ) ) + 0.55 * exp ( - ( ( \SemioX - 6 ) ^ 2 + ( \SemioY - 18 ) ^ 2 ) / 12 )
               + 0.55 * exp ( - ( ( \SemioX - 18 ) ^ 2 + ( \SemioY - 6 ) ^ 2 ) / 12 ) }
      }
      {#1}
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_bio_samples_int - 1 }
      {
        \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_bio_samples_int - 1 }
          { \semio_viz_bio_contact_cell:nn {##1} {####1} }
      }
  }
% 🟦 Evaluates the contact expression at bin pair (#1,#2), optionally takes its log and fills the cell on the ramp.
\cs_new_protected:Npn \semio_viz_bio_contact_cell:nn #1#2
  {
    \fp_set:Nn \SemioX {#1}
    \fp_set:Nn \SemioY {#2}
    \fp_set:Nn \l_semio_viz_sci_g_fp { \l_semio_viz_bio_key_tl }
    \bool_if:NT \l_semio_viz_bio_log_bool
      {
        \fp_set:Nn \l_semio_viz_sci_g_fp
          { max ( 0 , 1 + ln ( max ( 1e-3 , \l_semio_viz_sci_g_fp ) ) / ln (10) / 2 ) }
      }
    \fill [ fill=\semio_viz_sci_ramp:n { \l_semio_viz_sci_g_fp } ]
      ( \fp_eval:n { #1 * \l_semio_viz_bio_cell_fp } , \fp_eval:n { - #2 * \l_semio_viz_bio_cell_fp } )
      rectangle
      ( \fp_eval:n { ( #1 + 1 ) * \l_semio_viz_bio_cell_fp } ,
        \fp_eval:n { - ( #2 + 1 ) * \l_semio_viz_bio_cell_fp } ) ;
  }

%region 🔖️Keys
