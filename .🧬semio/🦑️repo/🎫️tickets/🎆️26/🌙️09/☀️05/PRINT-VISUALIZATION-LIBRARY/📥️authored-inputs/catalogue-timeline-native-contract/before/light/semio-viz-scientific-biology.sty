% 📊 Plots each feature's mean expression against its log fold change around the zero line.
\cs_new_protected:Npn \semio_viz_bio_ma:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \clist_map_inline:Nn \l_semio_viz_bio_features_clist
