% ⚕️ §22 growth chart: the reference percentile curves evaluated over age, with the individual's own measurements on them.
\SemioVizFamily { sci-growth-chart }
  {
    \semio_viz_sci_enter:nnn { sci-growth-chart }
      {
        samples=120 , domain={0,18} , range={0,190} ,
        percentiles={ P3/168/0.14/1.4 , P25/176/0.15/1.35 , P50/181/0.155/1.32 ,
                      P75/187/0.16/1.3 , P97/195/0.17/1.28 } ,
        subject={ 1/76 , 3/96 , 5/112 , 8/130 , 11/146 , 14/167 , 17/179 }
      }
      {#1}
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_bio_percentiles_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_bio_record:n {##1}
        \semio_viz_bio_percentile:
      }
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \clist_map_inline:Nn \l_semio_viz_bio_subject_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \semio_viz_bio_field:n { 1 } } { \semio_viz_bio_field:n { 2 } }
      }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      { \semio_viz_sci_dot:nnn { \semio_viz_points_x:n {##1} } { \semio_viz_points_y:n {##1} } { semio-primary } }
  }
% 🪴 Samples one reference percentile curve across the age axis and names it at its right end.
\cs_new_protected:Npn \semio_viz_bio_percentile:
  {
    \seq_clear:N \l_semio_viz_sci_pts_b_seq
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_bio_samples_int }
      {
        \fp_set:Nn \SemioX
          {
            \l_semio_viz_sci_dxmin_fp
            + ( \l_semio_viz_sci_dxmax_fp - \l_semio_viz_sci_dxmin_fp ) * ##1 / \l_semio_viz_bio_samples_int
          }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq { \SemioX }
          {
            \semio_viz_bio_field:n { 2 }
            * ( 1 - exp ( - \semio_viz_bio_field:n { 3 } * ( \SemioX + 1.2 ) ) ) ^ \semio_viz_bio_field:n { 4 }
          }
      }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq
      { semio~sci~aux , draw=\semio_viz_sci_hue:n { \l_tmpa_int } }
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=west ]
      at ( \fp_eval:n { \l_semio_viz_sci_w_fp + 1 } ,
           \semio_viz_sci_my:n { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_b_seq { -1 } } } )
      { \semio_viz_bio_field:n { 1 } } ;
  }

