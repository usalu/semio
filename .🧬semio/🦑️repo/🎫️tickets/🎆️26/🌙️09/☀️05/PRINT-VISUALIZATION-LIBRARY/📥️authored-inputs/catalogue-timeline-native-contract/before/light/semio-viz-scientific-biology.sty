% 🎚️ Registers one scale's origin and unit for the isopleth, then draws its axis, its title and its ticks.
\cs_new_protected:Npn \semio_viz_bio_scale_draw:
  {
    \prop_put:Nxx \l_semio_viz_bio_nx_prop { \semio_viz_bio_field:n { 1 } }
      { \semio_viz_bio_field:n { 2 } }
    \prop_put:Nxx \l_semio_viz_bio_ny_prop { \semio_viz_bio_field:n { 1 } } { 0 }
    \prop_put:Nxx \l_semio_viz_bio_start_prop { \semio_viz_bio_field:n { 1 } }
      { \semio_viz_bio_field:n { 3 } }
    \prop_put:Nxx \l_semio_viz_bio_scale_prop { \semio_viz_bio_field:n { 1 } }
      {
        \fp_to_decimal:n
          { 1 / ( \semio_viz_bio_field:n { 4 } - \semio_viz_bio_field:n { 3 } ) }
      }
    \draw [ semio~sci~axis ]
      ( \semio_viz_bio_field:n { 2 } , 0 ) --
      ( \semio_viz_bio_field:n { 2 } , \fp_eval:n { \l_semio_viz_sci_h_fp } ) ;
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=south ]
      at ( \semio_viz_bio_field:n { 2 } , \fp_eval:n { \l_semio_viz_sci_h_fp + 1 } )
      { \semio_viz_bio_field:n { 1 } } ;
    \int_step_inline:nnnn { 0 } { 1 } { \semio_viz_bio_field:n { 5 } }
      { \semio_viz_bio_scale_tick:n {##1} }
  }
% 🎯 Draws tick #1 of the current scale and prints the interpolated value it stands for beside it.
\cs_new_protected:Npn \semio_viz_bio_scale_tick:n #1
  {
    \fp_set:Nn \l_semio_viz_sci_g_fp
      { \l_semio_viz_sci_h_fp * (#1) / \semio_viz_bio_field:n { 5 } }
    \draw [ semio~sci~thin ]
      ( \fp_eval:n { \semio_viz_bio_field:n { 2 } - 1.4 } , \fp_eval:n { \l_semio_viz_sci_g_fp } ) --
      ( \fp_eval:n { \semio_viz_bio_field:n { 2 } + 1.4 } , \fp_eval:n { \l_semio_viz_sci_g_fp } ) ;
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=east ]
      at ( \fp_eval:n { \semio_viz_bio_field:n { 2 } - 1.8 } , \fp_eval:n { \l_semio_viz_sci_g_fp } )
      {
        \semio_viz_sci_num:nn
          {
            \semio_viz_bio_field:n { 3 }
            + ( \semio_viz_bio_field:n { 4 } - \semio_viz_bio_field:n { 3 } )
              * (#1) / \semio_viz_bio_field:n { 5 }
          }
          { 0 }
      } ;
  }

%region 🔖️Keys
% 🔑 Keys of `sci-schematic` (§22/§34 labelled schematics):
%    shapes (clist of `kind/x/y/w/h/label`): kinds ellipse, rect, rounded, blob.
%    leaders (clist of `x1/y1/x2/y2/label`): the label leaders drawn from a part to its caption.
%    outline (clist of `x/y`): an enclosing membrane drawn behind the parts.
\clist_new:N \l_semio_viz_bio_shapes_clist
\clist_new:N \l_semio_viz_bio_leaders_clist
\clist_new:N \l_semio_viz_bio_outline_clist
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-schematic }
% 🖇️ Binds the `sci-schematic` keys to the part shapes, the label leaders and the enclosing outline.
\keys_define:nn { semio / viz / family / sci-schematic }
  {
    shapes  .clist_set:N = \l_semio_viz_bio_shapes_clist ,
    leaders .clist_set:N = \l_semio_viz_bio_leaders_clist ,
    outline .clist_set:N = \l_semio_viz_bio_outline_clist ,
  }

% 🧫 §22/§34 labelled schematic: an outline membrane, the parts inside it and the leaders that name them.
\SemioVizFamily { sci-schematic }
  {
    \semio_viz_sci_enter:nnn { sci-schematic }
      {
        axes=false , grid=false ,
        outline={ 2/16 , 10/30 , 28/34 , 44/26 , 46/12 , 34/2 , 14/3 } ,
        shapes={ ellipse/22/18/12/9/nucleus , ellipse/12/10/6/4/mito ,
                 ellipse/34/22/7/4/golgi , rounded/32/9/8/4/ER } ,
        leaders={ 22/18/52/30/nucleus , 12/10/52/20/mitochondrion , 34/22/52/10/Golgi }
      }
      {#1}
    \int_compare:nNnT { \clist_count:N \l_semio_viz_bio_outline_clist } > { 2 }
      { \semio_viz_bio_membrane: }
    \clist_map_inline:Nn \l_semio_viz_bio_shapes_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_bio_shape:
      }
    \clist_map_inline:Nn \l_semio_viz_bio_leaders_clist
      {
        \semio_viz_bio_record:n {##1}
        \draw [ semio~sci~thin , draw=semio-chrome-border-normal ]
          ( \semio_viz_bio_field:n { 1 } , \semio_viz_bio_field:n { 2 } ) --
          ( \semio_viz_bio_field:n { 3 } , \semio_viz_bio_field:n { 4 } ) ;
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=west ]
          at ( \fp_eval:n { \semio_viz_bio_field:n { 3 } + 1 } , \semio_viz_bio_field:n { 4 } )
          { \semio_viz_bio_field:n { 5 } } ;
      }
  }
% 🫧 Builds the closed outline path from the recorded points and fills it as a rounded translucent membrane.
\cs_new_protected:Npn \semio_viz_bio_membrane:
  {
    \tl_clear:N \l_semio_viz_sci_path_tl
    \clist_map_inline:Nn \l_semio_viz_bio_outline_clist
      {
        \semio_viz_bio_record:n {##1}
        \tl_if_empty:NF \l_semio_viz_sci_path_tl { \tl_put_right:Nn \l_semio_viz_sci_path_tl { -- } }
        \tl_put_right:Nx \l_semio_viz_sci_path_tl
          { ( \semio_viz_bio_field:n { 1 } , \semio_viz_bio_field:n { 2 } ) }
      }
    \use:x
      {
        \exp_not:N \draw [ semio~sci~thin , fill=semio-secondary , fill~opacity=0.12 , rounded~corners=3mm ]
          \exp_not:V \l_semio_viz_sci_path_tl ~ -- ~ cycle ;
      }
  }
% 🥚 Draws one part at its centre and size as a rectangle, a rounded rectangle or, by default, an ellipse.
\cs_new_protected:Npn \semio_viz_bio_shape:
  {
    \tl_set:Nx \l_semio_viz_bio_key_tl { \semio_viz_bio_field:n { 1 } }
    \str_case:VnF \l_semio_viz_bio_key_tl
      {
        { rect }
          {
            \draw [ semio~sci~glyph ]
              ( \fp_eval:n { \semio_viz_bio_field:n { 2 } - \semio_viz_bio_field:n { 4 } / 2 } ,
                \fp_eval:n { \semio_viz_bio_field:n { 3 } - \semio_viz_bio_field:n { 5 } / 2 } )
              rectangle
              ( \fp_eval:n { \semio_viz_bio_field:n { 2 } + \semio_viz_bio_field:n { 4 } / 2 } ,
                \fp_eval:n { \semio_viz_bio_field:n { 3 } + \semio_viz_bio_field:n { 5 } / 2 } ) ;
          }
        { rounded }
          {
            \draw [ semio~sci~glyph , rounded~corners=1.2mm ]
              ( \fp_eval:n { \semio_viz_bio_field:n { 2 } - \semio_viz_bio_field:n { 4 } / 2 } ,
                \fp_eval:n { \semio_viz_bio_field:n { 3 } - \semio_viz_bio_field:n { 5 } / 2 } )
              rectangle
              ( \fp_eval:n { \semio_viz_bio_field:n { 2 } + \semio_viz_bio_field:n { 4 } / 2 } ,
                \fp_eval:n { \semio_viz_bio_field:n { 3 } + \semio_viz_bio_field:n { 5 } / 2 } ) ;
          }
      }
      {
        \draw [ semio~sci~glyph ]
          ( \semio_viz_bio_field:n { 2 } , \semio_viz_bio_field:n { 3 } )
          ellipse [ x~radius=\fp_eval:n { \semio_viz_bio_field:n { 4 } / 2 } ,
                    y~radius=\fp_eval:n { \semio_viz_bio_field:n { 5 } / 2 } ] ;
      }
    \semio_viz_sci_report_values:nn { schematic/shape }
      { \semio_viz_bio_field:n { 2 } , \semio_viz_bio_field:n { 3 } }
  }
%endregion 🔖️Families


\ExplSyntaxOff
