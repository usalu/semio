    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \prop_item:Ne \l_semio_viz_bio_nx_prop { \semio_viz_bio_field:n { 1 } } }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \prop_item:Ne \l_semio_viz_bio_ny_prop { \semio_viz_bio_field:n { 1 } } }
    \fp_set:Nn \l_semio_viz_sci_c_fp
      { \prop_item:Ne \l_semio_viz_bio_nx_prop { \semio_viz_bio_field:n { 2 } } }
    \draw [ semio~sci~thin ]
      ( \fp_eval:n { \l_semio_viz_sci_a_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
      ( \fp_eval:n { \l_semio_viz_sci_c_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) ;
    \fp_set:Nn \l_semio_viz_sci_d_fp { ( \l_semio_viz_sci_a_fp + \l_semio_viz_sci_c_fp ) / 2 }
    \draw [ semio~sci~thin ]
      ( \fp_eval:n { \l_semio_viz_sci_d_fp } , \fp_eval:n { \l_semio_viz_sci_b_fp } ) --
      ( \fp_eval:n { \l_semio_viz_sci_d_fp } ,
        \fp_eval:n { \l_semio_viz_sci_b_fp - \l_semio_viz_bio_gengap_fp / 2 } ) ;
    \seq_set_split:Nnx \l_tmpa_seq { + } { \semio_viz_bio_field:n { 3 } }
    \seq_map_inline:Nn \l_tmpa_seq
      {
