  {
    scales   .clist_set:N = \l_semio_viz_bio_scales_clist ,
    isopleth .clist_set:N = \l_semio_viz_bio_isopleth_clist ,
  }

% ⚕️ §22 nomogram: parallel scales with their own ticks and the isopleth that reads one value off the others.
\SemioVizFamily { sci-nomogram }
  {
    \semio_viz_sci_enter:nnn { sci-nomogram }
      {
        height=44 , axes=false , grid=false ,
        scales={ age/0/20/80/7 , risk/24/0/40/5 , points/48/0/100/6 } ,
        isopleth={ age/58 , points/72 }
      }
      {#1}
    \prop_clear:N \l_semio_viz_bio_nx_prop
    \prop_clear:N \l_semio_viz_bio_ny_prop
    \clist_map_inline:Nn \l_semio_viz_bio_scales_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_bio_scale_draw:
      }
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \clist_map_inline:Nn \l_semio_viz_bio_isopleth_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \prop_item:Ne \l_semio_viz_bio_nx_prop { \semio_viz_bio_field:n { 1 } } }
          {
            \prop_item:Ne \l_semio_viz_bio_ny_prop { \semio_viz_bio_field:n { 1 } }
            + \l_semio_viz_sci_h_fp * ( \semio_viz_bio_field:n { 2 }
              - \prop_item:Ne \l_semio_viz_bio_start_prop { \semio_viz_bio_field:n { 1 } } )
              * \prop_item:Ne \l_semio_viz_bio_scale_prop { \semio_viz_bio_field:n { 1 } }
          }
      }
    \int_compare:nNnT { \seq_count:N \l_semio_viz_sci_pts_seq } > { 1 }
      {
        \draw [ semio~sci~aux , draw=semio-primary ]
          ( \fp_eval:n { \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { 1 } } } ,
            \fp_eval:n { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { 1 } } } ) --
          ( \fp_eval:n { \semio_viz_points_x:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { -1 } } } ,
            \fp_eval:n { \semio_viz_points_y:n { \seq_item:Nn \l_semio_viz_sci_pts_seq { -1 } } } ) ;
      }
