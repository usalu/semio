\clist_new:N \l_semio_viz_bio_parenta_clist
\clist_new:N \l_semio_viz_bio_parentb_clist
\clist_new:N \l_semio_viz_bio_highlight_clist
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-punnett }
% 🌾 Binds the `sci-punnett` keys to the two gamete lists, the cell size and the genotypes to shade.
\keys_define:nn { semio / viz / family / sci-punnett }
  {
    parentA   .clist_set:N = \l_semio_viz_bio_parenta_clist ,
    parentB   .clist_set:N = \l_semio_viz_bio_parentb_clist ,
    cell      .fp_set:N    = \l_semio_viz_bio_cell_fp ,
    highlight .clist_set:N = \l_semio_viz_bio_highlight_clist ,
  }

% 🌱 §34 Punnett square: the cross table of the two gamete lists, each cell the concatenated genotype.
\SemioVizFamily { sci-punnett }
  {
    \semio_viz_sci_enter:nnn { sci-punnett }
      {
        parentA={ A , a } , parentB={ A , a } , cell=9 , highlight={ AA } , axes=false , grid=false
      }
      {#1}
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_bio_parenta_clist
      {
        \int_incr:N \l_tmpa_int
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal ]
          at ( \fp_eval:n { ( \l_tmpa_int - 0.5 ) * \l_semio_viz_bio_cell_fp } ,
               \fp_eval:n { 0.5 * \l_semio_viz_bio_cell_fp } ) {##1} ;
        \int_zero:N \l_tmpb_int
        \clist_map_inline:Nn \l_semio_viz_bio_parentb_clist
          { \int_incr:N \l_tmpb_int \semio_viz_bio_punnett_cell:nn {##1} {####1} }
      }
    \int_zero:N \l_tmpb_int
    \clist_map_inline:Nn \l_semio_viz_bio_parentb_clist
      {
        \int_incr:N \l_tmpb_int
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal ]
          at ( \fp_eval:n { -0.5 * \l_semio_viz_bio_cell_fp } ,
               \fp_eval:n { - ( \l_tmpb_int - 0.5 ) * \l_semio_viz_bio_cell_fp } ) {##1} ;
      }
  }
% 🔳 Draws the cell crossing gametes #1 and #2 and prints their genotype, shaded when it is in the highlight list.
\cs_new_protected:Npn \semio_viz_bio_punnett_cell:nn #1#2
  {
    \tl_set:Nn \l_semio_viz_bio_key_tl { #1 #2 }
    \clist_if_in:NVTF \l_semio_viz_bio_highlight_clist \l_semio_viz_bio_key_tl
      {
        \fill [ fill=semio-primary , fill~opacity=0.2 ]
          ( \fp_eval:n { ( \l_tmpa_int - 1 ) * \l_semio_viz_bio_cell_fp } ,
            \fp_eval:n { - \l_tmpb_int * \l_semio_viz_bio_cell_fp } ) rectangle
          ( \fp_eval:n { \l_tmpa_int * \l_semio_viz_bio_cell_fp } ,
            \fp_eval:n { ( 1 - \l_tmpb_int ) * \l_semio_viz_bio_cell_fp } ) ;
      }
      { }
    \draw [ semio~sci~box , fill=none ]
      ( \fp_eval:n { ( \l_tmpa_int - 1 ) * \l_semio_viz_bio_cell_fp } ,
        \fp_eval:n { - \l_tmpb_int * \l_semio_viz_bio_cell_fp } ) rectangle
      ( \fp_eval:n { \l_tmpa_int * \l_semio_viz_bio_cell_fp } ,
        \fp_eval:n { ( 1 - \l_tmpb_int ) * \l_semio_viz_bio_cell_fp } ) ;
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground ]
      at ( \fp_eval:n { ( \l_tmpa_int - 0.5 ) * \l_semio_viz_bio_cell_fp } ,
           \fp_eval:n { ( 0.5 - \l_tmpb_int ) * \l_semio_viz_bio_cell_fp } )
      { \tl_use:N \l_semio_viz_bio_key_tl } ;
  }

%region 🔖️Keys
% 🔑 Keys of `sci-lifecycle` (§34 cyclic processes):
%    stages (clist of `label`): the stages, placed evenly around the ring.
%    radius (fp, 22): ring radius in millimetres. arrows (bool, true): draw the arcs between stages.
\clist_new:N \l_semio_viz_bio_stages_clist
\fp_new:N \l_semio_viz_bio_radius_fp
\bool_new:N \l_semio_viz_bio_arrows_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-lifecycle }
% ♻️ Binds the `sci-lifecycle` keys to the stage names, the ring radius and the connecting-arc switch.
\keys_define:nn { semio / viz / family / sci-lifecycle }
  {
    stages .clist_set:N = \l_semio_viz_bio_stages_clist ,
    radius .fp_set:N    = \l_semio_viz_bio_radius_fp ,
    arrows .bool_set:N  = \l_semio_viz_bio_arrows_bool ,
  }

% 🔄 §34 life cycle: the stages on a ring, joined by arcs that run round it.
\SemioVizFamily { sci-lifecycle }
  {
    \semio_viz_sci_enter:nnn { sci-lifecycle }
      {
        stages={ egg , larva , pupa , adult } , radius=22 , arrows=true , axes=false , grid=false
      }
      {#1}
    \int_set:Nn \l_tmpb_int { \clist_count:N \l_semio_viz_bio_stages_clist }
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_bio_stages_clist
      {
        \int_incr:N \l_tmpa_int
        \bool_if:NT \l_semio_viz_bio_arrows_bool
          {
            \draw [ semio~sci~arrow ]
              ( \fp_eval:n { \l_semio_viz_bio_radius_fp * cosd ( 90 - 360 * ( \l_tmpa_int - 0.72 ) / \l_tmpb_int ) } ,
                \fp_eval:n { \l_semio_viz_bio_radius_fp * sind ( 90 - 360 * ( \l_tmpa_int - 0.72 ) / \l_tmpb_int ) } )
              arc [ start~angle=\fp_eval:n { 90 - 360 * ( \l_tmpa_int - 0.72 ) / \l_tmpb_int } ,
                    end~angle=\fp_eval:n { 90 - 360 * ( \l_tmpa_int - 0.28 ) / \l_tmpb_int } ,
                    radius=\fp_eval:n { \l_semio_viz_bio_radius_fp } ] ;
          }
        \node [ semio~sci~box , inner~sep=1mm , rounded~corners=0.6mm ,
                font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground ]
          at ( \fp_eval:n { \l_semio_viz_bio_radius_fp * cosd ( 90 - 360 * ( \l_tmpa_int - 1 ) / \l_tmpb_int ) } ,
               \fp_eval:n { \l_semio_viz_bio_radius_fp * sind ( 90 - 360 * ( \l_tmpa_int - 1 ) / \l_tmpb_int ) } )
          {##1} ;
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-circos` (§21 circular genomes):
%    segments (clist of `id/length/label`): the chromosomes, drawn as arcs proportional to their length.
%    tracks (clist of `segment/start/end/value/track`): the ring data; track 1 is the outermost ring.
%    links (clist of `segA/posA/segB/posB/weight`): the chords inside the ring.
%    radius (fp, 26), ringWidth (fp, 3.4), gap (fp, 2): the ring geometry in millimetres and degrees.
\clist_new:N \l_semio_viz_bio_segments_clist
\clist_new:N \l_semio_viz_bio_tracks_clist
\clist_new:N \l_semio_viz_bio_links_clist
\fp_new:N \l_semio_viz_bio_ring_fp
\fp_new:N \l_semio_viz_bio_gap_fp
\fp_new:N \l_semio_viz_bio_total_fp
\prop_new:N \l_semio_viz_bio_start_prop
\prop_new:N \l_semio_viz_bio_scale_prop
\bool_new:N \l_semio_viz_bio_tracks_bool
\bool_new:N \l_semio_viz_bio_links_bool
\bool_new:N \l_semio_viz_bio_bands_bool
\bool_new:N \l_semio_viz_bio_marks_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-circos }
% 🎡 Binds the `sci-circos` keys to the segments, tracks and links and to the ring radius, width and gap.
\keys_define:nn { semio / viz / family / sci-circos }
  {
    segments  .clist_set:N = \l_semio_viz_bio_segments_clist ,
    tracks    .clist_set:N = \l_semio_viz_bio_tracks_clist ,
    links     .clist_set:N = \l_semio_viz_bio_links_clist ,
    radius    .fp_set:N    = \l_semio_viz_bio_radius_fp ,
    ringWidth .fp_set:N    = \l_semio_viz_bio_ring_fp ,
    gap       .fp_set:N    = \l_semio_viz_bio_gap_fp ,
    showTracks .bool_set:N = \l_semio_viz_bio_tracks_bool ,
    showLinks  .bool_set:N = \l_semio_viz_bio_links_bool ,
  }

% 🧬 §21 circular genome: each segment gets the share of the circle its own length earns, then its tracks and links.
\SemioVizFamily { sci-circos }
  {
    \semio_viz_sci_enter:nnn { sci-circos }
      {
        radius=26 , ringWidth=3.4 , gap=2 , showTracks=true , showLinks=true , axes=false , grid=false ,
        segments={ c1/249/1 , c2/243/2 , c3/198/3 , c4/191/4 , c5/181/5 , c6/171/6 } ,
        tracks={ c1/10/60/0.8/1 , c1/90/180/0.4/1 , c2/20/120/0.9/1 , c3/30/150/0.55/1 ,
                 c4/10/90/0.7/2 , c5/40/160/0.3/2 , c6/20/140/0.85/2 } ,
        links={ c1/40/c4/60/1 , c2/100/c5/80/1 , c3/120/c6/40/1 }
      }
      {#1}
    \semio_viz_bio_circos_scale:
    \clist_map_inline:Nn \l_semio_viz_bio_segments_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_bio_circos_segment:
      }
    \bool_if:NT \l_semio_viz_bio_tracks_bool
      {
        \clist_map_inline:Nn \l_semio_viz_bio_tracks_clist
          {
            \semio_viz_bio_record:n {##1}
            \semio_viz_bio_circos_track:
          }
      }
    \bool_if:NT \l_semio_viz_bio_links_bool
      {
        \clist_map_inline:Nn \l_semio_viz_bio_links_clist
          {
            \semio_viz_bio_record:n {##1}
            \semio_viz_bio_circos_link:
          }
      }
  }
% 🧮 Shares the circle among the segments by length, storing each one's start angle and its degrees-per-unit scale.
\cs_new_protected:Npn \semio_viz_bio_circos_scale:
  {
    \fp_zero:N \l_semio_viz_bio_total_fp
    \clist_map_inline:Nn \l_semio_viz_bio_segments_clist
      {
        \semio_viz_bio_record:n {##1}
        \fp_add:Nn \l_semio_viz_bio_total_fp { \semio_viz_bio_field:n { 2 } }
      }
    \prop_clear:N \l_semio_viz_bio_start_prop
    \prop_clear:N \l_semio_viz_bio_scale_prop
    \fp_zero:N \l_semio_viz_sci_g_fp
    \clist_map_inline:Nn \l_semio_viz_bio_segments_clist
      {
        \semio_viz_bio_record:n {##1}
        \prop_put:Nxx \l_semio_viz_bio_start_prop { \semio_viz_bio_field:n { 1 } }
          { \fp_to_decimal:N \l_semio_viz_sci_g_fp }
        \prop_put:Nxx \l_semio_viz_bio_scale_prop { \semio_viz_bio_field:n { 1 } }
          {
            \fp_to_decimal:n
              {
                ( 360 - \l_semio_viz_bio_gap_fp * \clist_count:N \l_semio_viz_bio_segments_clist )
                / \l_semio_viz_bio_total_fp
              }
          }
        \fp_add:Nn \l_semio_viz_sci_g_fp
          {
            \semio_viz_bio_field:n { 2 }
            * ( 360 - \l_semio_viz_bio_gap_fp * \clist_count:N \l_semio_viz_bio_segments_clist )
              / \l_semio_viz_bio_total_fp
            + \l_semio_viz_bio_gap_fp
          }
      }
  }
% 🧭 Converts position #2 on segment #1 into its absolute angle on the ring.
\cs_new:Npn \semio_viz_bio_angle:nn #1#2
  {
    \prop_item:Ne \l_semio_viz_bio_start_prop {#1}
    + ( #2 ) * \prop_item:Ne \l_semio_viz_bio_scale_prop {#1}
  }
% 🌈 Draws one chromosome as a hued arc spanning its share of the circle, labelled just outside it.
\cs_new_protected:Npn \semio_viz_bio_circos_segment:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \semio_viz_bio_angle:nn { \semio_viz_bio_field:n { 1 } } { 0 } }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \semio_viz_bio_angle:nn { \semio_viz_bio_field:n { 1 } } { \semio_viz_bio_field:n { 2 } } }
    \draw [ line~width=2.2pt , draw=\semio_viz_sci_hue:n { \semio_viz_bio_field:n { 3 } } ]
      ( \fp_eval:n { \l_semio_viz_bio_radius_fp * cosd ( \l_semio_viz_sci_a_fp ) } ,
        \fp_eval:n { \l_semio_viz_bio_radius_fp * sind ( \l_semio_viz_sci_a_fp ) } )
      arc [ start~angle=\fp_eval:n { \l_semio_viz_sci_a_fp } ,
            end~angle=\fp_eval:n { \l_semio_viz_sci_b_fp } ,
            radius=\fp_eval:n { \l_semio_viz_bio_radius_fp } ] ;
    \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal ]
      at ( \fp_eval:n { ( \l_semio_viz_bio_radius_fp + 4 )
             * cosd ( ( \l_semio_viz_sci_a_fp + \l_semio_viz_sci_b_fp ) / 2 ) } ,
           \fp_eval:n { ( \l_semio_viz_bio_radius_fp + 4 )
             * sind ( ( \l_semio_viz_sci_a_fp + \l_semio_viz_sci_b_fp ) / 2 ) } )
      { \semio_viz_bio_field:n { 3 } } ;
    \semio_viz_sci_report_values:nn { circos/segment }
      { \fp_to_decimal:N \l_semio_viz_sci_a_fp , \fp_to_decimal:N \l_semio_viz_sci_b_fp }
  }
% 📿 Draws one track datum as an arc on the ring of its track index, its width and colour taken from its value.
\cs_new_protected:Npn \semio_viz_bio_circos_track:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \semio_viz_bio_angle:nn { \semio_viz_bio_field:n { 1 } } { \semio_viz_bio_field:n { 2 } } }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \semio_viz_bio_angle:nn { \semio_viz_bio_field:n { 1 } } { \semio_viz_bio_field:n { 3 } } }
    \fp_set:Nn \l_semio_viz_sci_c_fp
      {
        \l_semio_viz_bio_radius_fp
        - \semio_viz_bio_field:n { 5 } * ( \l_semio_viz_bio_ring_fp + 1 )
      }
    \draw
      [ line~width=\fp_eval:n { 0.4 + 2.4 * \semio_viz_bio_field:n { 4 } } pt ,
        draw=\semio_viz_sci_ramp:n { \semio_viz_bio_field:n { 4 } } ]
      ( \fp_eval:n { \l_semio_viz_sci_c_fp * cosd ( \l_semio_viz_sci_a_fp ) } ,
        \fp_eval:n { \l_semio_viz_sci_c_fp * sind ( \l_semio_viz_sci_a_fp ) } )
      arc [ start~angle=\fp_eval:n { \l_semio_viz_sci_a_fp } ,
            end~angle=\fp_eval:n { \l_semio_viz_sci_b_fp } ,
            radius=\fp_eval:n { \l_semio_viz_sci_c_fp } ] ;
  }
% 🪢 Draws one chord between two segment positions, bending it through the centre of the ring.
\cs_new_protected:Npn \semio_viz_bio_circos_link:
  {
    \fp_set:Nn \l_semio_viz_sci_a_fp
      { \semio_viz_bio_angle:nn { \semio_viz_bio_field:n { 1 } } { \semio_viz_bio_field:n { 2 } } }
    \fp_set:Nn \l_semio_viz_sci_b_fp
      { \semio_viz_bio_angle:nn { \semio_viz_bio_field:n { 3 } } { \semio_viz_bio_field:n { 4 } } }
    \fp_set:Nn \l_semio_viz_sci_c_fp { \l_semio_viz_bio_radius_fp - 2 * \l_semio_viz_bio_ring_fp - 3 }
    \draw [ semio~sci~thin , draw=semio-primary , opacity=0.65 ]
      ( \fp_eval:n { \l_semio_viz_sci_c_fp * cosd ( \l_semio_viz_sci_a_fp ) } ,
        \fp_eval:n { \l_semio_viz_sci_c_fp * sind ( \l_semio_viz_sci_a_fp ) } )
      .. controls ( 0 , 0 ) ..
      ( \fp_eval:n { \l_semio_viz_sci_c_fp * cosd ( \l_semio_viz_sci_b_fp ) } ,
        \fp_eval:n { \l_semio_viz_sci_c_fp * sind ( \l_semio_viz_sci_b_fp ) } ) ;
  }

%region 🔖️Keys
% 🔑 Keys of `sci-ideogram` (§21 chromosome maps):
%    chromosomes (clist of `id/length/centromere`): lengths and centromere positions in the same unit.
%    bands (clist of `chromosome/start/end/stain`): stains gneg, gpos25, gpos50, gpos75, gpos100, acen.
%    marks (clist of `chromosome/position/label`): loci to annotate.
%    columnGap (fp, 9), scale (fp, 0.16): millimetres between chromosomes and per length unit.
\clist_new:N \l_semio_viz_bio_chrom_clist
\clist_new:N \l_semio_viz_bio_bands_clist
\clist_new:N \l_semio_viz_bio_marks_clist
