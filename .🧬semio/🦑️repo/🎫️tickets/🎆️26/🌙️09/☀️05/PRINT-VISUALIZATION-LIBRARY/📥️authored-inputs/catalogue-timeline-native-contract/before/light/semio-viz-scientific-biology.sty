% ⚕️ §22 patient timeline: point events and intervals placed on named lanes along one shared time axis.
\SemioVizFamily { sci-clinical-timeline }
  {
    \semio_viz_sci_enter:nnn { sci-clinical-timeline }
      {
        laneHeight=7 , domain={0,180} , range={} , grid=false ,
        lanes={ therapy , imaging , labs , events } ,
        events={ 0/1/interval-start/induction , 42/1/interval-end/ , 60/1/interval-start/maintenance ,
                 150/1/interval-end/ , 12/2/point/CT , 70/2/point/MRI , 140/2/point/CT ,
                 5/3/point/CBC , 40/3/point/CBC , 95/3/point/CBC , 30/4/marker/relapse }
      }
      {#1}
    \semio_viz_sci_window:nnnn
      { \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } }
      { \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 } }
      { \fp_eval:n { - \clist_count:N \l_semio_viz_bio_lanes_clist - 0.5 } } { -0.2 }
    \semio_viz_sci_frame:
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_bio_lanes_clist
      {
        \int_incr:N \l_tmpa_int
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-text-normal , anchor=east ]
          at ( -1 , \semio_viz_sci_my:n { - \l_tmpa_int } ) {##1} ;
      }
    \fp_set:Nn \l_semio_viz_sci_g_fp { -1 }
    \clist_map_inline:Nn \l_semio_viz_bio_events_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_bio_clinical_event:
      }
