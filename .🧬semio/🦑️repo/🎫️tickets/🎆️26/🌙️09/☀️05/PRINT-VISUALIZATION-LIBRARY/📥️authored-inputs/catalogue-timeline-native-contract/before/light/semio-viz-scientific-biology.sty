% 🩺 Draws one timeline entry — an interval bar, a full-height marker or a lane dot — and its optional label.
\cs_new_protected:Npn \semio_viz_bio_clinical_event:
  {
    \tl_set:Nx \l_semio_viz_bio_key_tl { \semio_viz_bio_field:n { 3 } }
    \str_case:VnF \l_semio_viz_bio_key_tl
      {
        { interval-start }
          { \fp_set:Nn \l_semio_viz_sci_g_fp { \semio_viz_bio_field:n { 1 } } }
        { interval-end }
          {
            \fill [ fill=semio-primary , fill~opacity=0.35 ]
              ( \semio_viz_sci_mx:n { \l_semio_viz_sci_g_fp } ,
                \fp_eval:n { \semio_viz_sci_my:n { - \semio_viz_bio_field:n { 2 } } - 2 } )
              rectangle
              ( \semio_viz_sci_mx:n { \semio_viz_bio_field:n { 1 } } ,
                \fp_eval:n { \semio_viz_sci_my:n { - \semio_viz_bio_field:n { 2 } } + 2 } ) ;
          }
        { marker }
          {
            \draw [ semio~sci~aux , draw=semio-danger ]
              ( \semio_viz_sci_mx:n { \semio_viz_bio_field:n { 1 } } , 0 ) --
              ( \semio_viz_sci_mx:n { \semio_viz_bio_field:n { 1 } } , \fp_eval:n { \l_semio_viz_sci_h_fp } ) ;
          }
      }
      {
        \semio_viz_sci_dot:nnn { \semio_viz_bio_field:n { 1 } } { - \semio_viz_bio_field:n { 2 } }
          { semio-primary }
      }
    \tl_set:Nx \l_tmpa_tl { \semio_viz_bio_field:n { 4 } }
    \tl_if_empty:NF \l_tmpa_tl
      {
        \node [ font=\c_semio_viz_theme_font_label_tl , text=semio-chrome-foreground , anchor=south , inner~sep=0.8mm ]
          at ( \semio_viz_sci_mx:n { \semio_viz_bio_field:n { 1 } } ,
               \semio_viz_sci_my:n { - \semio_viz_bio_field:n { 2 } } )
          { \tl_use:N \l_tmpa_tl } ;
      }
  }
