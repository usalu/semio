% 🦌 §34 population dynamics: logistic growth, the Lotka–Volterra system integrated with RK4, and the community curves.
\SemioVizFamily { sci-population }
  {
    \semio_viz_sci_enter:nnn { sci-population }
      {
        mode=growth , r=0.6 , capacity=100 , alpha=0.9 , beta=0.04 , gamma=0.5 , delta=0.01 ,
        prey=40 , predator=9 , steps=600 , step=0.02 , domain={0,12} , range={} ,
        counts={ 48 , 31 , 22 , 15 , 11 , 8 , 6 , 4 , 3 , 2 , 2 , 1 , 1 , 1 }
      }
      {#1}
    \str_case:VnF \l_semio_viz_bio_mode_tl
      {
        { predator-prey } { \semio_viz_bio_lotka:n { time } }
        { phase }         { \semio_viz_bio_lotka:n { phase } }
        { abundance }     { \semio_viz_bio_abundance: }
        { rarefaction }   { \semio_viz_bio_rarefaction: }
        { niche }         { \semio_viz_bio_niche: }
      }
      { \semio_viz_bio_logistic: }
  }
% 📈 Evaluates the closed-form logistic solution over the time domain and draws it under its capacity line.
\cs_new_protected:Npn \semio_viz_bio_logistic:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { 160 }
      {
        \fp_set:Nn \SemioT
          {
            \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 }
            + ( \clist_item:Nn \l_semio_viz_sci_domain_clist { 2 }
                - \clist_item:Nn \l_semio_viz_sci_domain_clist { 1 } ) * ##1 / 160
          }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \SemioT }
          {
            \l_semio_viz_bio_capacity_fp
            / ( 1 + ( \l_semio_viz_bio_capacity_fp / \l_semio_viz_bio_prey_fp - 1 )
                * exp ( - \l_semio_viz_bio_r_fp * \SemioT ) )
          }
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.06 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \draw [ semio~sci~aux , draw=semio-secondary ]
      ( 0 , \semio_viz_sci_my:n { \l_semio_viz_bio_capacity_fp } ) --
      ( \fp_eval:n { \l_semio_viz_sci_w_fp } , \semio_viz_sci_my:n { \l_semio_viz_bio_capacity_fp } ) ;
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
  }
% 🦌 Lotka–Volterra integrated by the shared RK4 stepper; `time` draws both series, `phase` the orbit.
\cs_new_protected:Npn \semio_viz_bio_lotka:n #1
  {
    \semio_viz_sci_rkfour:nnnnnnN
      { \l_semio_viz_bio_alpha_fp * \SemioX - \l_semio_viz_bio_beta_fp * \SemioX * \SemioY }
      { \l_semio_viz_bio_delta_fp * \SemioX * \SemioY - \l_semio_viz_bio_gamma_fp * \SemioY }
      { \l_semio_viz_bio_prey_fp } { \l_semio_viz_bio_predator_fp }
      { \l_semio_viz_bio_step_fp } { \l_semio_viz_bio_steps_int } \l_semio_viz_sci_pts_seq
    \str_if_eq:nnTF {#1} { phase }
      {
        \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.1 }
        \semio_viz_sci_window_keys:
        \semio_viz_sci_frame:
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
        \semio_viz_sci_dot:nnn { \l_semio_viz_bio_gamma_fp / \l_semio_viz_bio_delta_fp }
          { \l_semio_viz_bio_alpha_fp / \l_semio_viz_bio_beta_fp } { semio-tertiary }
      }
      {
        \seq_clear:N \l_semio_viz_sci_pts_b_seq
        \seq_clear:N \l_semio_viz_sci_pts_c_seq
        \int_zero:N \l_tmpa_int
        \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
          {
            \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq
              { \l_tmpa_int * \l_semio_viz_bio_step_fp } { \semio_viz_points_x:n {##1} }
            \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_c_seq
              { \l_tmpa_int * \l_semio_viz_bio_step_fp } { \semio_viz_points_y:n {##1} }
            \int_incr:N \l_tmpa_int
          }
        \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_b_seq { 0.06 }
        \semio_viz_sci_window_keys:
        \semio_viz_sci_frame:
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq { semio~sci~curve }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_c_seq { semio~sci~curve~alt }
      }
  }
% 🪶 Draws the rank–abundance stems on a decadic log scale, joined by a thin rank curve.
\cs_new_protected:Npn \semio_viz_bio_abundance:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_bio_counts_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \l_tmpa_int }
          { ln ( max ( 1 , ##1 ) ) / ln (10) }
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.08 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      {
        \draw [ semio~sci~curve ]
          ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { 0 } ) --
          ( \semio_viz_sci_mx:n { \semio_viz_points_x:n {##1} } , \semio_viz_sci_my:n { \semio_viz_points_y:n {##1} } ) ;
      }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~thin , draw=semio-secondary }
  }
% 🦌 Rarefaction: the expected species count at every sample size, from the hypergeometric expectation over the abundance vector.
\cs_new_protected:Npn \semio_viz_bio_rarefaction:
  {
    \fp_zero:N \l_semio_viz_sci_e_fp
    \clist_map_inline:Nn \l_semio_viz_bio_counts_clist { \fp_add:Nn \l_semio_viz_sci_e_fp {##1} }
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 4 } { \fp_to_int:n { \l_semio_viz_sci_e_fp } }
      { \semio_viz_bio_rarefaction_point:n {##1} }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.06 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
  }
% 🎣 Adds the expected species richness at sample size #1, summing the hypergeometric detection probability of every species.
\cs_new_protected:Npn \semio_viz_bio_rarefaction_point:n #1
  {
    \fp_zero:N \l_semio_viz_sci_f_fp
    \clist_map_inline:Nn \l_semio_viz_bio_counts_clist
      {
        \fp_compare:nNnTF { \l_semio_viz_sci_e_fp - ##1 - #1 } < { 0 }
          { \fp_add:Nn \l_semio_viz_sci_f_fp { 1 } }
          {
            \fp_add:Nn \l_semio_viz_sci_f_fp
              {
                1 - exp (
                  \semio_viz_tr_dist_lgamma:n { \l_semio_viz_sci_e_fp - ##1 + 1 }
                  - \semio_viz_tr_dist_lgamma:n { \l_semio_viz_sci_e_fp - ##1 - #1 + 1 }
                  - \semio_viz_tr_dist_lgamma:n { \l_semio_viz_sci_e_fp + 1 }
                  + \semio_viz_tr_dist_lgamma:n { \l_semio_viz_sci_e_fp - #1 + 1 } )
              }
          }
      }
    \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq {#1} { \l_semio_viz_sci_f_fp }
  }
% 🏞️ Draws three Gaussian resource-utilisation curves of growing centre and width as overlapping filled niches.
\cs_new_protected:Npn \semio_viz_bio_niche:
  {
    \semio_viz_sci_window:nnnn { 0 } { 10 } { 0 } { 1 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \int_step_inline:nnnn { 1 } { 1 } { 3 }
      {
        \seq_clear:N \l_semio_viz_sci_pts_seq
        \int_step_inline:nnnn { 0 } { 1 } { 80 }
          {
            \fp_set:Nn \SemioX { 10 * ####1 / 80 }
            \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \SemioX }
              { exp ( - ( \SemioX - 2.4 * ##1 ) ^ 2 / ( 2 * ( 0.7 + 0.25 * ##1 ) ^ 2 ) ) }
          }
        \semio_viz_sci_polyarea:Nnn \l_semio_viz_sci_pts_seq
          { fill=\semio_viz_sci_hue:n {##1} , fill~opacity=0.2 } { 0 }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq
          { semio~sci~curve , draw=\semio_viz_sci_hue:n {##1} }
      }
  }

