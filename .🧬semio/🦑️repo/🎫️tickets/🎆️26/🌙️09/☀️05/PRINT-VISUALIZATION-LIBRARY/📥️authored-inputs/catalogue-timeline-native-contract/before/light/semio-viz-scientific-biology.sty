\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-scientific-biology}[2026/09/05 v0.2.0 semio viz namespace scientific-biology, genomics and medicine families]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-scientific-field}

\ExplSyntaxOn

%region 🔖️Parsing
\cs_generate_variant:Nn \seq_set_split:Nnn { Nnx }
\cs_generate_variant:Nn \prop_put:Nnn { Nxx }
\cs_generate_variant:Nn \prop_item:Nn { Ne }
\tl_new:N \l_semio_viz_bio_key_tl
\seq_new:N \l_semio_viz_bio_rec_seq
% 🧾 Splits a slash-separated record into the scratch sequence every renderer below reads its fields from.
\cs_new_protected:Npn \semio_viz_bio_record:n #1
  { \seq_set_split:Nnx \l_semio_viz_bio_rec_seq { / } {#1} }
% 🔢 Returns field #1 of the record most recently split by \semio_viz_bio_record:n.
\cs_new:Npn \semio_viz_bio_field:n #1
  { \seq_item:Nn \l_semio_viz_bio_rec_seq {#1} }
\tl_new:N \l_semio_viz_bio_mode_tl
\clist_new:N \l_semio_viz_bio_nodes_clist
\clist_new:N \l_semio_viz_bio_edges_clist
\prop_new:N \l_semio_viz_bio_nx_prop
\prop_new:N \l_semio_viz_bio_ny_prop
\int_new:N \l_semio_viz_bio_samples_int
\fp_new:N \l_semio_viz_bio_unit_fp
\fp_new:N \l_semio_viz_bio_cell_fp

% 🧬 Reads a node table `id/x/y/label` into the position lookup shared by every graph-shaped family below.
\cs_new_protected:Npn \semio_viz_bio_nodes_read:N #1
  {
    \prop_clear:N \l_semio_viz_bio_nx_prop
    \prop_clear:N \l_semio_viz_bio_ny_prop
    \clist_map_inline:Nn #1
      {
        \semio_viz_bio_record:n {##1}
        \prop_put:Nxx \l_semio_viz_bio_nx_prop
          { \semio_viz_bio_field:n { 1 } } { \semio_viz_bio_field:n { 2 } }
        \prop_put:Nxx \l_semio_viz_bio_ny_prop
          { \semio_viz_bio_field:n { 1 } } { \semio_viz_bio_field:n { 3 } }
      }
  }
%endregion 🔖️Parsing

%region 🔖️Families

%region 🔖️Keys
% 🔑 Keys of `sci-survival` (§22 time-to-event):
%    mode (kaplan-meier|cumulative-hazard, kaplan-meier).
%    groups (clist of `label/events`) where events is a `+`-joined list of `time:status`
%    records, status 1 for an event and 0 for a censored observation.
%    confidence (bool, true): draw the Greenwood pointwise band. censorMarks (bool, true): tick the censored times.
\clist_new:N \l_semio_viz_bio_groups_clist
\bool_new:N \l_semio_viz_bio_conf_bool
\bool_new:N \l_semio_viz_bio_censor_bool
\seq_new:N \l_semio_viz_bio_time_seq
\seq_new:N \l_semio_viz_bio_status_seq
\fp_new:N \l_semio_viz_bio_surv_fp
\fp_new:N \l_semio_viz_bio_var_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-survival }
% ⏳ Binds the `sci-survival` keys to the event groups, the confidence band and the censor-mark switch.
\keys_define:nn { semio / viz / family / sci-survival }
  {
    mode        .tl_set:N    = \l_semio_viz_bio_mode_tl ,
    groups      .clist_set:N = \l_semio_viz_bio_groups_clist ,
    confidence  .bool_set:N  = \l_semio_viz_bio_conf_bool ,
    censorMarks .bool_set:N  = \l_semio_viz_bio_censor_bool ,
  }

% ⚕️ §22 Kaplan–Meier: the product-limit estimator with Greenwood variance, computed from the event records themselves.
\SemioVizFamily { sci-survival }
  {
    \semio_viz_sci_enter:nnn { sci-survival }
      {
        mode=kaplan-meier , confidence=true , censorMarks=true , domain={0,24} , range={0,1} ,
        groups={
          treatment/2:1+4:1+5:0+7:1+11:1+12:0+15:1+18:0+21:1+24:0 ,
          control/1:1+2:1+3:1+5:1+6:1+8:1+9:0+12:1+14:1+17:1
        }
      }
      {#1}
    \semio_viz_sci_window_keys:
    \str_if_eq:VnT \l_semio_viz_bio_mode_tl { cumulative-hazard }
      { \semio_viz_sci_window:nnnn { \l_semio_viz_sci_dxmin_fp } { \l_semio_viz_sci_dxmax_fp } { 0 } { 2 } }
    \semio_viz_sci_frame:
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_semio_viz_bio_groups_clist
      {
        \int_incr:N \l_tmpa_int
        \semio_viz_bio_record:n {##1}
        \semio_viz_bio_km:
      }
  }
% ⚕️ One group: the product-limit steps, its Greenwood band and its censoring ticks.
\cs_new_protected:Npn \semio_viz_bio_km:
  {
    \seq_set_split:Nnx \l_semio_viz_bio_time_seq { + } { \semio_viz_bio_field:n { 2 } }
    \int_set:Nn \l_tmpb_int { \seq_count:N \l_semio_viz_bio_time_seq }
    \fp_set:Nn \l_semio_viz_bio_surv_fp { 1 }
    \fp_zero:N \l_semio_viz_bio_var_fp
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \seq_clear:N \l_semio_viz_sci_pts_b_seq
    \seq_clear:N \l_semio_viz_sci_pts_c_seq
    \fp_zero:N \l_semio_viz_sci_g_fp
    \semio_viz_bio_km_point:
    \int_step_inline:nnnn { 1 } { 1 } { \l_tmpb_int } { \semio_viz_bio_km_step:n {##1} }
    \bool_if:NT \l_semio_viz_bio_conf_bool
      {
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_b_seq
          { semio~sci~aux , draw=\semio_viz_sci_hue:n { \l_tmpa_int } }
        \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_c_seq
          { semio~sci~aux , draw=\semio_viz_sci_hue:n { \l_tmpa_int } }
      }
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq
      { semio~sci~curve , draw=\semio_viz_sci_hue:n { \l_tmpa_int } }
    \semio_viz_sci_report_values:nn { survival/final }
      { \fp_to_decimal:N \l_semio_viz_bio_surv_fp }
  }
% 🪜 Handles observation #1: an event drops the product-limit estimate and grows the Greenwood variance, a censoring draws a tick.
\cs_new_protected:Npn \semio_viz_bio_km_step:n #1
  {
    \semio_viz_sci_split_colon:Nn \l_tmpb_seq { \seq_item:Nn \l_semio_viz_bio_time_seq {#1} }
    \fp_set:Nn \l_semio_viz_sci_g_fp { \seq_item:Nn \l_tmpb_seq { 1 } }
    \int_compare:nNnTF { \seq_item:Nn \l_tmpb_seq { 2 } } = { 1 }
      {
        \semio_viz_bio_km_point:
        \fp_set:Nn \l_semio_viz_bio_surv_fp
          { \l_semio_viz_bio_surv_fp * ( 1 - 1 / ( \l_tmpb_int - #1 + 1 ) ) }
        \fp_add:Nn \l_semio_viz_bio_var_fp
          { 1 / ( ( \l_tmpb_int - #1 + 1 ) * max ( 1 , \l_tmpb_int - #1 ) ) }
        \semio_viz_bio_km_point:
        \semio_viz_bio_km_band:
      }
      {
        \bool_if:NT \l_semio_viz_bio_censor_bool
          {
            \draw [ semio~sci~thin , draw=\semio_viz_sci_hue:n { \l_tmpa_int } ]
              ( \semio_viz_sci_mx:n { \l_semio_viz_sci_g_fp } ,
                \fp_eval:n { \semio_viz_sci_my:n { \l_semio_viz_bio_surv_fp } - 1 } ) --
              ( \semio_viz_sci_mx:n { \l_semio_viz_sci_g_fp } ,
                \fp_eval:n { \semio_viz_sci_my:n { \l_semio_viz_bio_surv_fp } + 1 } ) ;
          }
      }
  }
% ⚕️ One step of the drawn curve: the survival estimate itself, or its negative logarithm in the hazard mode.
\cs_new_protected:Npn \semio_viz_bio_km_point:
  {
    \str_if_eq:VnTF \l_semio_viz_bio_mode_tl { cumulative-hazard }
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \l_semio_viz_sci_g_fp } { - ln ( max ( 1e-6 , \l_semio_viz_bio_surv_fp ) ) }
      }
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \l_semio_viz_sci_g_fp } { \l_semio_viz_bio_surv_fp }
      }
  }
% 🎗️ Appends the upper and lower Greenwood 95 % bounds at the current time to the two band sequences.
\cs_new_protected:Npn \semio_viz_bio_km_band:
  {
    \fp_set:Nn \l_semio_viz_sci_e_fp
      { 1.96 * \l_semio_viz_bio_surv_fp * sqrt ( \l_semio_viz_bio_var_fp ) }
    \str_if_eq:VnTF \l_semio_viz_bio_mode_tl { cumulative-hazard }
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq { \l_semio_viz_sci_g_fp }
          { - ln ( max ( 1e-6 , \l_semio_viz_bio_surv_fp + \l_semio_viz_sci_e_fp ) ) }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_c_seq { \l_semio_viz_sci_g_fp }
          { - ln ( max ( 1e-6 , \l_semio_viz_bio_surv_fp - \l_semio_viz_sci_e_fp ) ) }
      }
      {
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_b_seq { \l_semio_viz_sci_g_fp }
          { min ( 1 , \l_semio_viz_bio_surv_fp + \l_semio_viz_sci_e_fp ) }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_c_seq { \l_semio_viz_sci_g_fp }
          { max ( 0 , \l_semio_viz_bio_surv_fp - \l_semio_viz_sci_e_fp ) }
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-dose-response` (§22 pharmacology):
%    bottom, top, ec50, hill (fp, 0/100/1/1): the four-parameter logistic curve.
%    points (clist of `dose/response`): the measured data, doses on a decadic log axis.
%    decades (clist of 2, `-2,2`): the log dose sweep. samples (int, 160): curve resolution.
%    markEC (bool, true): mark the EC50 on the curve.
\fp_new:N \l_semio_viz_bio_bottom_fp
\fp_new:N \l_semio_viz_bio_top_fp
\fp_new:N \l_semio_viz_bio_ecfifty_fp
\fp_new:N \l_semio_viz_bio_hill_fp
\clist_new:N \l_semio_viz_bio_points_clist
\clist_new:N \l_semio_viz_bio_decades_clist
\bool_new:N \l_semio_viz_bio_markec_bool
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-dose-response }
% 💉 Binds the `sci-dose-response` keys to the four logistic parameters, the measured points and the decade sweep.
\keys_define:nn { semio / viz / family / sci-dose-response }
  {
    bottom  .fp_set:N    = \l_semio_viz_bio_bottom_fp ,
    top     .fp_set:N    = \l_semio_viz_bio_top_fp ,
    ec50    .fp_set:N    = \l_semio_viz_bio_ecfifty_fp ,
    hill    .fp_set:N    = \l_semio_viz_bio_hill_fp ,
    points  .clist_set:N = \l_semio_viz_bio_points_clist ,
    decades .clist_set:N = \l_semio_viz_bio_decades_clist ,
    samples .int_set:N   = \l_semio_viz_bio_samples_int ,
    markEC  .bool_set:N  = \l_semio_viz_bio_markec_bool ,
  }

% 💊 §22 dose–response: the four-parameter logistic curve evaluated over the log dose axis, with the measured points on top.
\SemioVizFamily { sci-dose-response }
  {
    \semio_viz_sci_enter:nnn { sci-dose-response }
      {
        bottom=2 , top=98 , ec50=0.4 , hill=1.3 , samples=160 , markEC=true , decades={ -2 , 2 } ,
        points={ 0.01/4 , 0.03/7 , 0.1/19 , 0.3/44 , 1/72 , 3/88 , 10/95 , 30/97 } , range={0,105}
      }
      {#1}
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \int_step_inline:nnnn { 0 } { 1 } { \l_semio_viz_bio_samples_int }
      {
        \fp_set:Nn \SemioX
          {
            \clist_item:Nn \l_semio_viz_bio_decades_clist { 1 }
            + ( \clist_item:Nn \l_semio_viz_bio_decades_clist { 2 }
                - \clist_item:Nn \l_semio_viz_bio_decades_clist { 1 } )
              * ##1 / \l_semio_viz_bio_samples_int
          }
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq { \SemioX }
          {
            \l_semio_viz_bio_bottom_fp
            + ( \l_semio_viz_bio_top_fp - \l_semio_viz_bio_bottom_fp )
              / ( 1 + ( \l_semio_viz_bio_ecfifty_fp / ( 10 ^ \SemioX ) ) ^ \l_semio_viz_bio_hill_fp )
          }
      }
    \semio_viz_sci_window:nnnn
      { \clist_item:Nn \l_semio_viz_bio_decades_clist { 1 } }
      { \clist_item:Nn \l_semio_viz_bio_decades_clist { 2 } } { 0 } { 105 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \semio_viz_sci_polyline:Nn \l_semio_viz_sci_pts_seq { semio~sci~curve }
    \clist_map_inline:Nn \l_semio_viz_bio_points_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_sci_dot:nnn
          { ln ( \semio_viz_bio_field:n { 1 } ) / ln (10) } { \semio_viz_bio_field:n { 2 } }
          { semio-primary }
      }
    \bool_if:NT \l_semio_viz_bio_markec_bool
      {
        \draw [ semio~sci~aux , draw=semio-secondary ]
          ( \semio_viz_sci_mx:n { ln ( \l_semio_viz_bio_ecfifty_fp ) / ln (10) } , 0 ) --
          ( \semio_viz_sci_mx:n { ln ( \l_semio_viz_bio_ecfifty_fp ) / ln (10) } ,
            \semio_viz_sci_my:n
              { ( \l_semio_viz_bio_bottom_fp + \l_semio_viz_bio_top_fp ) / 2 } ) ;
        \semio_viz_sci_report_values:nn { dose/ec }
          { \fp_to_decimal:n { ln ( \l_semio_viz_bio_ecfifty_fp ) / ln (10) } }
      }
  }

%region 🔖️Keys
% 🔑 Keys of `sci-scatter-diagnostic` (§22 measurement and expression diagnostics):
%    mode (bland-altman|volcano|ma, bland-altman).
%    pairs (clist of `a/b/label`): the two measurements of a Bland–Altman plot.
%    features (clist of `logfc/pvalue/mean/label`): the differential-expression table.
%    threshold (fp, 0.05), effect (fp, 1): the significance and effect-size cut-offs.
\clist_new:N \l_semio_viz_bio_pairs_clist
\clist_new:N \l_semio_viz_bio_features_clist
\fp_new:N \l_semio_viz_bio_threshold_fp
\fp_new:N \l_semio_viz_bio_effect_fp
%endregion 🔖️Keys

\semio_viz_sci_keys_canvas:n { sci-scatter-diagnostic }
% 🔬 Binds the `sci-scatter-diagnostic` keys to the measurement pairs, the feature table and the two cut-offs.
\keys_define:nn { semio / viz / family / sci-scatter-diagnostic }
  {
    mode      .tl_set:N    = \l_semio_viz_bio_mode_tl ,
    pairs     .clist_set:N = \l_semio_viz_bio_pairs_clist ,
    features  .clist_set:N = \l_semio_viz_bio_features_clist ,
    threshold .fp_set:N    = \l_semio_viz_bio_threshold_fp ,
    effect    .fp_set:N    = \l_semio_viz_bio_effect_fp ,
  }

% ⚕️ §22 diagnostics: the Bland–Altman agreement plot with its computed limits, and the volcano and MA plots of an expression table.
\SemioVizFamily { sci-scatter-diagnostic }
  {
    \semio_viz_sci_enter:nnn { sci-scatter-diagnostic }
      {
        mode=bland-altman , threshold=0.05 , effect=1 , domain={} , range={} ,
        pairs={ 12/13/ , 18/17/ , 24/26/ , 31/29/ , 37/40/ , 44/43/ , 52/56/ , 58/57/ ,
                63/68/ , 71/69/ , 78/82/ , 84/83/ } ,
        features={ -2.4/0.0004/6.2/g1 , -1.2/0.02/7.4/g2 , 0.3/0.6/8.1/g3 , 1.8/0.001/5.9/g4 ,
                   2.6/0.00002/6.8/g5 , 0.9/0.2/7.7/g6 , -0.4/0.8/9.0/g7 , 3.1/0.000004/5.1/g8 }
      }
      {#1}
    \str_case:VnF \l_semio_viz_bio_mode_tl
      {
        { volcano } { \semio_viz_bio_volcano: }
        { ma }      { \semio_viz_bio_ma: }
      }
      { \semio_viz_bio_bland: }
  }
% 📉 Plots every pair as mean against difference and derives the bias and standard deviation behind the limits.
\cs_new_protected:Npn \semio_viz_bio_bland:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \fp_zero:N \l_semio_viz_sci_e_fp
    \fp_zero:N \l_semio_viz_sci_f_fp
    \clist_map_inline:Nn \l_semio_viz_bio_pairs_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { ( \semio_viz_bio_field:n { 1 } + \semio_viz_bio_field:n { 2 } ) / 2 }
          { \semio_viz_bio_field:n { 2 } - \semio_viz_bio_field:n { 1 } }
        \fp_add:Nn \l_semio_viz_sci_e_fp
          { \semio_viz_bio_field:n { 2 } - \semio_viz_bio_field:n { 1 } }
        \fp_add:Nn \l_semio_viz_sci_f_fp
          { ( \semio_viz_bio_field:n { 2 } - \semio_viz_bio_field:n { 1 } ) ^ 2 }
      }
    \int_set:Nn \l_tmpa_int { \clist_count:N \l_semio_viz_bio_pairs_clist }
    \fp_set:Nn \l_semio_viz_sci_e_fp { \l_semio_viz_sci_e_fp / \l_tmpa_int }
    \fp_set:Nn \l_semio_viz_sci_f_fp
      {
        sqrt ( max ( 0 , \l_semio_viz_sci_f_fp / \l_tmpa_int - \l_semio_viz_sci_e_fp ^ 2 )
          * \l_tmpa_int / ( \l_tmpa_int - 1 ) )
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.16 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \int_step_inline:nnnn { -1 } { 1 } { 1 } { \semio_viz_bio_bland_limit:n {##1} }
    \seq_map_inline:Nn \l_semio_viz_sci_pts_seq
      { \semio_viz_sci_dot:nnn { \semio_viz_points_x:n {##1} } { \semio_viz_points_y:n {##1} } { semio-primary } }
    \semio_viz_sci_report_values:nn { bland/limits }
      { \fp_to_decimal:N \l_semio_viz_sci_e_fp , \fp_to_decimal:N \l_semio_viz_sci_f_fp }
  }
% ⚕️ One Bland–Altman reference line: the bias at offset 0, the 95 % limits of agreement at ±1.
\cs_new_protected:Npn \semio_viz_bio_bland_limit:n #1
  {
    \tl_set:Nx \l_semio_viz_bio_key_tl
      { \int_compare:nNnTF {#1} = { 0 } { semio-primary } { semio-secondary } }
    \use:x
      {
        \exp_not:N \draw [ semio~sci~aux , draw=\l_semio_viz_bio_key_tl ]
          ( 0 , \semio_viz_sci_my:n { \l_semio_viz_sci_e_fp + #1 * 1.96 * \l_semio_viz_sci_f_fp } ) --
          ( \fp_to_decimal:N \l_semio_viz_sci_w_fp ,
            \semio_viz_sci_my:n { \l_semio_viz_sci_e_fp + #1 * 1.96 * \l_semio_viz_sci_f_fp } ) ;
      }
  }
% 🌋 Plots each feature's log fold change against its −log10 p, under the drawn significance threshold.
\cs_new_protected:Npn \semio_viz_bio_volcano:
  {
    \seq_clear:N \l_semio_viz_sci_pts_seq
    \clist_map_inline:Nn \l_semio_viz_bio_features_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_points_put:Nnn \l_semio_viz_sci_pts_seq
          { \semio_viz_bio_field:n { 1 } }
          { - ln ( \semio_viz_bio_field:n { 2 } ) / ln (10) }
      }
    \semio_viz_sci_window_from:Nn \l_semio_viz_sci_pts_seq { 0.14 }
    \semio_viz_sci_window_keys:
    \semio_viz_sci_frame:
    \draw [ semio~sci~aux , draw=semio-secondary ]
      ( 0 , \semio_viz_sci_my:n { - ln ( \l_semio_viz_bio_threshold_fp ) / ln (10) } ) --
      ( \fp_eval:n { \l_semio_viz_sci_w_fp } ,
        \semio_viz_sci_my:n { - ln ( \l_semio_viz_bio_threshold_fp ) / ln (10) } ) ;
    \clist_map_inline:Nn \l_semio_viz_bio_features_clist
      {
        \semio_viz_bio_record:n {##1}
        \semio_viz_bio_feature_dot:nn
          { \semio_viz_bio_field:n { 1 } } { - ln ( \semio_viz_bio_field:n { 2 } ) / ln (10) }
      }
