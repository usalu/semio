%region 🔖️Diagnostics
\msg_new:nnn { semio-viz } { unknown-chart }
  { Unknown~viz~chart~kind~'#1'. }
\msg_new:nnn { semio-viz } { unknown-demo }
  { Unknown~viz~demo~'#1'~(not~a~mark~or~chart~kind). }
\msg_new:nnn { semio-viz } { unit-in-number }
  { Viz~key~'#1'~takes~a~plain~millimetre~number,~got~'#2'. }
%endregion 🔖️Diagnostics

%region 🔖️StyleVocabulary
\tikzset{
  semio~viz~picture/.style={
    x=1mm, y=1mm,
    every~node/.append~style={ outer~sep=0pt, font=\SemioSans },
  },
  % 📏 The hairline that separates two VizSection bands, in the theme's own chrome weight.
  semio~viz~rule/.style={
    draw=semio-chrome-border-normal,
    line~width=\semio_viz_theme_stroke:n { hairline },
  },
}
%endregion 🔖️StyleVocabulary

%region 🔖️Keys
\tl_new:N \l_semio_viz_title_tl
\tl_new:N \l_semio_viz_window_tl
\tl_new:N \l_semio_viz_width_tl
\tl_new:N \l_semio_viz_height_tl

% 🚫 Rejects a millimetre key that carries a unit: every viz number is a bare millimetre count.
\cs_new_protected:Npn \semio_viz_number_check:nn #1#2 {
  \regex_match:nnT { [a-zA-Z] } {#2}
    { \msg_error:nnnn { semio-viz } { unit-in-number } {#1} {#2} }
}

% ⚙️ Vocabulary of a VizFigure window.
%   title  text     default empty   caption of the figure window
%   window keyval   default empty   options passed straight to the Figure environment
%   width  number   default 80      canvas width in millimetres
%   height number   default 40      canvas height in millimetres; omitting it lets content grow
\keys_define:nn { semio / viz / figure } {
  title  .tl_set:N = \l_semio_viz_title_tl,
  window .tl_set:N = \l_semio_viz_window_tl,
  width  .code:n = {
    \semio_viz_number_check:nn { width } {#1}
    \tl_set:Nn \l_semio_viz_width_tl {#1}
  },
  height .code:n = {
    \semio_viz_number_check:nn { height } {#1}
    \tl_set:Nn \l_semio_viz_height_tl {#1}
    \bool_set_false:N \l_semio_viz_height_auto_bool
  },
}

\bool_new:N \l_semio_viz_height_auto_bool
% 🧹 Restores every figure key to the documented default before a new VizFigure reads its options.
\cs_new_protected:Npn \semio_viz_figure_keys_reset: {
  \tl_clear:N \l_semio_viz_title_tl
  \tl_clear:N \l_semio_viz_window_tl
  \tl_set:Nn \l_semio_viz_width_tl { \c_semio_viz_frame_width_tl }
  \tl_set:Nn \l_semio_viz_height_tl { \c_semio_viz_frame_height_tl }
  \bool_set_true:N \l_semio_viz_height_auto_bool
}
%endregion 🔖️Keys

%region 🔖️Figure
% 🪟 Opens the Figure window and the millimetre TikZ canvas, and pins the bounding box: an
% explicit height fixes it, an automatic one lets pgf grow it from whatever the body draws.
% 🪢 A bare \path pins the horizontal extent only, so an automatic height is whatever the
% VizSection and VizColumn bodies actually draw -- a label wrapping to three lines pushes the
% rest of the figure down with nobody measuring it.
\cs_new_protected:Npn \semio_viz_figure_open:n #1 {
  \begin{Figure}[#1]
  \begin{tikzpicture}[ semio~viz~picture ]
  \tl_gclear:N \g_semio_viz_section_prev_tl
  \fp_set:Nn \l_semio_viz_width_fp { \l_semio_viz_width_tl }
  \bool_if:NTF \l_semio_viz_height_auto_bool
    {
      \use:x { \exp_not:N \path (0,0) -- ( \l_semio_viz_width_tl , 0 ) ; }
      \fp_set:Nn \l_semio_viz_height_fp { \l_semio_viz_width_fp }
    }
    {
      \useasboundingbox (0,0) rectangle ( \l_semio_viz_width_tl , \l_semio_viz_height_tl ) ;
      \fp_set:Nn \l_semio_viz_height_fp { \l_semio_viz_height_tl }
    }
}

% 🎬 Starts a VizFigure: reads the keys, opens the window, loads the demo tables and the
% default x/y scales every mark falls back on.
\cs_new_protected:Npn \semio_viz_figure_begin:n #1 {
  \semio_viz_figure_keys_reset:
  \keys_set:nn { semio / viz / figure } {#1}
  \tl_set:Nx \l_tmpa_tl {
    title = { \exp_not:V \l_semio_viz_title_tl } ,
    break = false ,
    \exp_not:V \l_semio_viz_window_tl
  }
  \exp_args:NV \semio_viz_figure_open:n \l_tmpa_tl
  \bool_set_true:N \l_semio_viz_in_figure_bool
  \semio_viz_data_demo:
  \semio_viz_figure_scales:
}

% 📏 Declares the figure's three fallback scales -- a categorical x band, a linear y and a
% logarithmic y -- spanning the canvas the keys just fixed.
\cs_new_protected:Npn \semio_viz_figure_scales: {
  \use:x {
    \exp_not:N \semio_viz_scale_define:nnnn { x } { band } { A, B, C, D, E }
      { \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_width_fp - 2 } }
    \exp_not:N \semio_viz_scale_define:nnnn { y } { linear } { 0, 10 }
      { \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_height_fp - 2 } }
    \exp_not:N \semio_viz_scale_define:nnnn { y-log } { log } { 1, 100 }
      { \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_height_fp - 2 } }
  }
}

% 🏁 Closes the canvas and the Figure window, and marks the figure scope as left.
\cs_new_protected:Npn \semio_viz_figure_end: {
  \bool_set_false:N \l_semio_viz_in_figure_bool
  \end{tikzpicture}
  \end{Figure}
}

% 🖼️ Figure window wrapping a millimetre TikZ canvas for viz recipes.
\NewDocumentEnvironment { VizFigure } { O{} }
  { \semio_viz_figure_begin:n {#1} }
  { \semio_viz_figure_end: }
%endregion 🔖️Figure

%region 🔖️Sections
% 🪜 VizSection/VizColumn replace a stacked-panel figure's hand-placed
% section origins (skalierung.tex's eight hardcoded Y separators) the same
% way semio-tree.sty replaces a hand-placed hierarchy: no y-accumulator, no
% measured line heights. Each section is a `local bounding box` scope --
% pgf computes it from what was actually drawn inside -- shifted to sit on
% the PREVIOUS section's own measured `.south west`. A three-line label
% pushes every section below it down with nobody counting lines. The gaps
% and the gutter are semio-viz-guide's frame metrics.

\tl_new:N \l_semio_viz_section_title_tl
\tl_new:N \l_semio_viz_section_aside_tl
\bool_new:N \l_semio_viz_section_rule_bool
\tl_new:N \g_semio_viz_section_prev_tl
\tl_new:N \l_semio_viz_section_name_tl
\int_new:N \g_semio_viz_section_int
\fp_new:N \g_semio_viz_column_cursor_fp
\fp_new:N \l_semio_viz_saved_width_fp

% ⚙️ Vocabulary of one VizSection band.
%   title text     default empty   heading drawn at the band's north west
%   aside text     default empty   right-aligned annotation on the heading line
%   rule  boolean  default true    draw the hairline that separates the band from the one above
\keys_define:nn { semio / viz / section } {
  title .tl_set:N = \l_semio_viz_section_title_tl,
  aside .tl_set:N = \l_semio_viz_section_aside_tl,
  rule  .bool_set:N = \l_semio_viz_section_rule_bool,
}

% 🧹 Restores the section keys to their documented defaults before a new band reads its options.
\cs_new_protected:Npn \semio_viz_section_keys_reset: {
  \tl_clear:N \l_semio_viz_section_title_tl
  \tl_clear:N \l_semio_viz_section_aside_tl
  \bool_set_true:N \l_semio_viz_section_rule_bool
}

% 🏷️ Draws a band's own furniture: the separating rule, the title and the right-hand aside.
\cs_new_protected:Npn \semio_viz_section_chrome: {
  \bool_if:NT \l_semio_viz_section_rule_bool {
    \use:x { \exp_not:N \draw [ semio~viz~rule ] ( 0 , 0 ) -- ( \fp_eval:n { \l_semio_viz_width_fp } , 0 ) ; }
  }
  \tl_if_empty:NF \l_semio_viz_section_title_tl {
    \node [ font=\c_semio_viz_theme_font_title_tl, text=semio-chrome-foreground, anchor=north~west ]
      at ( 0 , -1.4 ) { \exp_not:V \l_semio_viz_section_title_tl } ;
  }
  \tl_if_empty:NF \l_semio_viz_section_aside_tl {
    \node [ font=\c_semio_viz_theme_font_label_tl, text=semio-chrome-text-normal, anchor=north~east ]
      at ( \fp_eval:n { \l_semio_viz_width_fp } , -1.4 ) { \exp_not:V \l_semio_viz_section_aside_tl } ;
  }
}

% 📐 Opens a band: names its bounding box, anchors it under the previous band and draws the chrome.
\cs_new_protected:Npn \semio_viz_section_open:n #1 {
  \semio_viz_frame_require:n { VizSection }
  \semio_viz_section_keys_reset:
  \keys_set:nn { semio / viz / section } {#1}
  \int_gincr:N \g_semio_viz_section_int
  \tl_set:Nx \l_semio_viz_section_name_tl { vizsectionbox \int_use:N \g_semio_viz_section_int }
  \fp_gzero:N \g_semio_viz_column_cursor_fp
  \tl_if_empty:NTF \g_semio_viz_section_prev_tl
    { \begin{scope} }
    {
      \begin{scope}[
        shift={([yshift=-\c_semio_viz_section_gap_tl]\g_semio_viz_section_prev_tl)}
      ]
    }
  \begin{scope}[ local~bounding~box=\l_semio_viz_section_name_tl ]
  \semio_viz_section_chrome:
  \begin{scope}[ yshift=-\c_semio_viz_section_content_gap_tl ]
}

% 📏 Closes a band and records its measured south-west corner as the anchor of the next one.
\cs_new_protected:Npn \semio_viz_section_close: {
  \end{scope}
  \end{scope}
  \end{scope}
  \use:x {
    \exp_not:N \path
      ( \exp_not:V \l_semio_viz_section_name_tl .south~west )
      coordinate ( \exp_not:V \l_semio_viz_section_name_tl anchor ) ;
  }
  \tl_set:Nx \l_tmpa_tl { \l_semio_viz_section_name_tl anchor }
  \tl_gset_eq:NN \g_semio_viz_section_prev_tl \l_tmpa_tl
}

% 📐 One horizontal band of the Systemkarte: a title/rule and everything the
% body draws, auto-stacked below the previous VizSection.
\NewDocumentEnvironment { VizSection } { O{} }
  { \semio_viz_section_open:n {#1} }
  { \semio_viz_section_close: }

\fp_new:N \l_semio_viz_column_width_fp
\tl_new:N \l_semio_viz_column_title_tl
\tl_new:N \l_semio_viz_column_note_tl

% ⚙️ Vocabulary of one VizColumn slot.
%   width number  default the section width   slot width in millimetres
%   title text    default empty              heading above the slot
%   note  text    default empty              caption-weight paragraph under the heading
\keys_define:nn { semio / viz / column } {
  width .fp_set:N = \l_semio_viz_column_width_fp,
  title .tl_set:N = \l_semio_viz_column_title_tl,
  note  .tl_set:N = \l_semio_viz_column_note_tl,
}

% 📝 A note draws below any title, in the caption weight already used
% throughout (\c_semio_viz_theme_font_label_tl), and reserves its own gap before content starts --
% the mechanism-level replacement for skalierung.tex's H1/H2 caption lines,
% which used to be a bare \node followed by a hand-tuned \begin{scope}[yshift=
% -4mm] compensating for the caption's own height. text width is the column's
% own real width, not a number copied from the call site.
\cs_new_protected:Npn \semio_viz_column_note_draw: {
  \node [ font=\c_semio_viz_theme_font_label_tl, text=semio-chrome-text-normal,
          anchor=north~west, align=left, text~width=\fp_eval:n{\l_semio_viz_width_fp}mm ]
    at ( 0 , 0 ) { \exp_not:V \l_semio_viz_column_note_tl } ;
}

% 🏛️ Opens a slot at the section's running cursor and narrows the figure width to the slot.
\cs_new_protected:Npn \semio_viz_column_open:n #1 {
  \semio_viz_frame_require:n { VizColumn }
  \fp_set_eq:NN \l_semio_viz_column_width_fp \l_semio_viz_width_fp
  \tl_clear:N \l_semio_viz_column_title_tl
  \tl_clear:N \l_semio_viz_column_note_tl
  \keys_set:nn { semio / viz / column } {#1}
  \fp_set_eq:NN \l_semio_viz_saved_width_fp \l_semio_viz_width_fp
  \begin{scope}[ shift={(\fp_eval:n{\g_semio_viz_column_cursor_fp},0)} ]
  \fp_set_eq:NN \l_semio_viz_width_fp \l_semio_viz_column_width_fp
  \tl_if_empty:NTF \l_semio_viz_column_title_tl
    { \begin{scope} }
    {
      \node [ font=\c_semio_viz_theme_font_title_tl, text=semio-chrome-foreground, anchor=north~west ]
        at ( 0 , 0 ) { \exp_not:V \l_semio_viz_column_title_tl } ;
      \begin{scope}[ yshift=-\c_semio_viz_section_content_gap_tl ]
    }
  \tl_if_empty:NTF \l_semio_viz_column_note_tl
    { \begin{scope} }
    {
      \semio_viz_column_note_draw:
      \begin{scope}[ yshift=-\c_semio_viz_section_note_gap_tl ]
    }
}

% 🧾 Closes a slot, advances the cursor by its width plus the gutter and restores the figure width.
\cs_new_protected:Npn \semio_viz_column_close: {
  \end{scope}
  \end{scope}
  \end{scope}
  \fp_gset:Nn \g_semio_viz_column_cursor_fp
    { \fp_eval:n { \g_semio_viz_column_cursor_fp + \l_semio_viz_column_width_fp + \c_semio_viz_column_gutter_tl } }
  \fp_set_eq:NN \l_semio_viz_width_fp \l_semio_viz_saved_width_fp
}

% 🏛️ One vertical slot of a VizSection, siblings placed left to right by
% their own declared width -- no `x=77` literal for what sits beside what.
\NewDocumentEnvironment { VizColumn } { O{} }
  { \semio_viz_column_open:n {#1} }
  { \semio_viz_column_close: }

% 🪧 Caption-weight text below a captured anchor (see \SemioVizLayout's
% anchor= key) -- the mechanism-level replacement for a hand-guessed
% \node at (0,-N) after a variable-height layout, e.g. a note under a heat
% matrix: the position tracks the data instead of needing manual retuning
% whenever a row is added or removed.
\cs_new_protected:Npn \semio_viz_note_below:nnn #1#2#3 {
  \node [ font=\c_semio_viz_theme_font_label_tl, text=semio-chrome-text-normal,
          anchor=north~west, align=left, text~width=\fp_eval:n{#2}mm ]
    at ( [ yshift=-\c_semio_viz_section_note_gap_tl ] #1 ) { \exp_not:n {#3} } ;
}
% 🪧 Places caption text below a \SemioVizLayout anchor= coordinate.
\NewDocumentCommand \SemioVizNoteBelow { m m m } { \semio_viz_note_below:nnn {#1}{#2}{#3} }
%endregion 🔖️Sections

%region 🔖️Demo
% 🧪 The five-point polyline every section 0 mark is shown on: a mark reads it through
% its `points` key, a path primitive is the polyline itself.
\tl_const:Nn \c_semio_viz_demo_points_tl { 8,8; 22,28; 40,12; 58,30; 72,16 }

% 🧪 Gallery helper: draws a mark primitive or, for a catalogue slug, its chart kind on the entry's demo data.
\cs_new_protected:Npn \semio_viz_demo:n #1 {
  \semio_viz_frame_require:n { SemioVizDemo }
  \seq_if_in:NnTF \g_semio_viz_mark_kinds_seq {#1}
    {
      \use:x
        {
          \exp_not:N \semio_viz_mark_draw:nnn {#1}
            { points = { \exp_not:V \c_semio_viz_demo_points_tl } } { 40 , 20 }
        }
    }
    { \semio_viz_kind_run:nn {#1} { } }
}

% 🧪 \SemioVizDemo{name}: mark primitive or catalogue chart kind on its own demo table.
\NewDocumentCommand \SemioVizDemo { m } { \semio_viz_demo:n {#1} }
%endregion 🔖️Demo

\ExplSyntaxOff

