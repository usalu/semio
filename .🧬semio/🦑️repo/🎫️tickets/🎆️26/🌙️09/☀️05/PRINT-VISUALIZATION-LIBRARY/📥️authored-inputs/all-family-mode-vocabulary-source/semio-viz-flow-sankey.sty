\ExplSyntaxOn

%region 🔖️Keys
% 🔑 semio / viz / family / sankey — d3-sankey's node rectangles and link ribbons (taxonomy §9).
%   data        (table, default demo-flow)   flow table; `weight` names the value column
%   weight      (column, default value)      per-call binding override
%   nodeWidth   (mm, default 4)              width of a node rectangle
%   nodePadding (mm, default 2.4)            vertical gap between the nodes of one column
%   nodeAlign   (left|right|center|justify, default justify)
%   nodeSort    (auto|none, default auto)    auto keeps d3's "sort each column by y0"
%   linkSort    (auto|none, default auto)
%   iterations  (integer, default 6)         relaxation passes
%   curvature   (number, default 0.5)        horizontal control-point fraction of a link ribbon
%   labels      (boolean, default true)      node captions
%   labelWidth  (mm, default 11)             room reserved left and right for the captions
%   colorBy     (source|target|group|none, default source)   ribbon hue
%   padding     (mm, default 3)
\fp_new:N \l_semio_viz_snk_width_fp
\fp_new:N \l_semio_viz_snk_padding_fp
\fp_new:N \l_semio_viz_snk_curv_fp
\fp_new:N \l_semio_viz_snk_label_w_fp
\int_new:N \l_semio_viz_snk_iterations_int
\int_new:N \l_semio_viz_snk_rows_int
\tl_new:N \l_semio_viz_snk_align_tl
\tl_new:N \l_semio_viz_snk_node_sort_tl
\tl_new:N \l_semio_viz_snk_link_sort_tl
\tl_new:N \l_semio_viz_snk_kind_tl
\tl_new:N \l_semio_viz_snk_i_tl
\tl_new:N \l_semio_viz_snk_j_tl
\tl_new:N \l_semio_viz_snk_x_tl
\tl_new:N \l_semio_viz_snk_y_tl
\tl_new:N \l_semio_viz_snk_xb_tl
\tl_new:N \l_semio_viz_snk_yb_tl
\tl_new:N \l_semio_viz_snk_w_tl
\tl_new:N \l_semio_viz_snk_id_tl

\cs_new_protected:Npn \semio_viz_snk_keys_add:n #1 {
  \semio_viz_net_keys_add:n {#1}
  \keys_define:nn {#1} {
    nodeWidth   .fp_set:N = \l_semio_viz_snk_width_fp,
    nodePadding .fp_set:N = \l_semio_viz_snk_padding_fp,
    nodeAlign   .tl_set:N = \l_semio_viz_snk_align_tl,
    nodeSort    .tl_set:N = \l_semio_viz_snk_node_sort_tl,
    linkSort    .tl_set:N = \l_semio_viz_snk_link_sort_tl,
    labelWidth  .fp_set:N = \l_semio_viz_snk_label_w_fp,
  }
}
% ♻️ Puts every flow key back to its documented default, on top of the network kernel's own reset.
\cs_new_protected:Npn \semio_viz_snk_keys_reset: {
  \semio_viz_net_keys_reset:
  \tl_set:Nn \l_semio_viz_net_data_tl { demo-flow }
  \tl_set:Nn \l_semio_viz_net_weight_tl { value }
  \fp_set:Nn \l_semio_viz_snk_width_fp { 4 }
  \fp_set:Nn \l_semio_viz_snk_padding_fp { 2.4 }
  \fp_set:Nn \l_semio_viz_snk_curv_fp { 0.5 }
  \fp_set:Nn \l_semio_viz_snk_label_w_fp { 11 }
  \int_set:Nn \l_semio_viz_snk_iterations_int { 6 }
  \tl_set:Nn \l_semio_viz_snk_align_tl { justify }
  \tl_set:Nn \l_semio_viz_snk_node_sort_tl { auto }
  \tl_set:Nn \l_semio_viz_snk_link_sort_tl { auto }
  \tl_set:Nn \l_semio_viz_net_colorby_tl { source }
  \bool_set_true:N \l_semio_viz_net_labels_bool
  \fp_set:Nn \l_semio_viz_net_curvature_fp { 0.5 }
}
%endregion 🔖️Keys

%region 🔖️Sankey
% 💧 One node rectangle of the layout output, with its caption on the side the flow leaves it.
\cs_new_protected:Npn \semio_viz_snk_node_draw:n #1 {
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { i } \l_semio_viz_snk_i_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { x0 } \l_semio_viz_snk_x_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { y0 } \l_semio_viz_snk_y_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { x1 } \l_semio_viz_snk_xb_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { y1 } \l_semio_viz_snk_yb_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { id } \l_semio_viz_snk_id_tl
  \semio_viz_snk_fill:n { \l_semio_viz_snk_i_tl }
  \semio_viz_net_draw_poly:xx
    {
      ( \fp_to_decimal:n { \semio_viz_snk_x:n { \l_semio_viz_snk_x_tl } } ,
        \fp_to_decimal:n { \semio_viz_snk_y:n { \l_semio_viz_snk_y_tl } } ) --
      ( \fp_to_decimal:n { \semio_viz_snk_x:n { \l_semio_viz_snk_xb_tl } } ,
        \fp_to_decimal:n { \semio_viz_snk_y:n { \l_semio_viz_snk_y_tl } } ) --
      ( \fp_to_decimal:n { \semio_viz_snk_x:n { \l_semio_viz_snk_xb_tl } } ,
        \fp_to_decimal:n { \semio_viz_snk_y:n { \l_semio_viz_snk_yb_tl } } ) --
      ( \fp_to_decimal:n { \semio_viz_snk_x:n { \l_semio_viz_snk_x_tl } } ,
        \fp_to_decimal:n { \semio_viz_snk_y:n { \l_semio_viz_snk_yb_tl } } )
    }
    {
      \fp_eval:n { round( \semio_viz_snk_x:n { \l_semio_viz_snk_x_tl } , 4 ) } ,
      \fp_eval:n { round( \semio_viz_snk_y:n { \l_semio_viz_snk_yb_tl } , 4 ) } ,
      \fp_eval:n { round( ( \semio_viz_snk_x:n { \l_semio_viz_snk_xb_tl } )
        - ( \semio_viz_snk_x:n { \l_semio_viz_snk_x_tl } ) , 4 ) } ,
      \fp_eval:n { round( ( \semio_viz_snk_y:n { \l_semio_viz_snk_y_tl } )
        - ( \semio_viz_snk_y:n { \l_semio_viz_snk_yb_tl } ) , 4 ) }
    }

}

\seq_new:N \l_semio_viz_snk_caption_rows_seq
\prop_new:N \l_semio_viz_snk_caption_counts_prop
\prop_new:N \l_semio_viz_snk_caption_positions_prop
\tl_new:N \l_semio_viz_snk_caption_column_tl
\tl_new:N \l_semio_viz_snk_caption_previous_tl
\fp_new:N \l_semio_viz_snk_caption_gap_fp
\fp_new:N \l_semio_viz_snk_caption_y_fp
\fp_new:N \l_semio_viz_snk_caption_previous_fp
\fp_new:N \l_semio_viz_snk_caption_neighbor_fp
\fp_new:N \l_semio_viz_snk_caption_width_fp
\fp_new:N \l_semio_viz_snk_caption_scale_fp
\box_new:N \l_semio_viz_snk_caption_box
% 🔠 Orders captions by column and vertical stratum.
\cs_new_protected:Npn \semio_viz_snk_caption_sort:nn #1#2 {
  \semio_viz_table_cell:nnnN {semio-net-flow}{#1}{x0}\l_tmpa_tl
  \semio_viz_table_cell:nnnN {semio-net-flow}{#2}{x0}\l_tmpb_tl
  \fp_compare:nNnT {\l_tmpa_tl} = {\l_tmpb_tl} {
    \semio_viz_table_cell:nnnN {semio-net-flow}{#1}{y0}\l_tmpa_tl
    \semio_viz_table_cell:nnnN {semio-net-flow}{#2}{y0}\l_tmpb_tl
  }
  \fp_compare:nNnTF {\l_tmpa_tl} > {\l_tmpb_tl} {\sort_return_swapped:}{\sort_return_same:}
}
% 🔠 Reads the available spacing and mapped centre of a stratum.
\cs_new_protected:Npn \semio_viz_snk_caption_read:n #1 {
  \semio_viz_table_cell:nnnN {semio-net-flow}{#1}{x0}\l_semio_viz_snk_caption_column_tl
  \prop_get:NVN \l_semio_viz_snk_caption_counts_prop \l_semio_viz_snk_caption_column_tl \l_tmpa_tl
  \fp_set:Nn \l_semio_viz_snk_caption_gap_fp {min(2.8,(\l_semio_viz_net_yhi_fp-\l_semio_viz_net_ylo_fp)/\l_tmpa_tl)}
  \semio_viz_table_cell:nnnN {semio-net-flow}{#1}{y0}\l_semio_viz_snk_y_tl
  \semio_viz_table_cell:nnnN {semio-net-flow}{#1}{y1}\l_semio_viz_snk_yb_tl
  \fp_set:Nn \l_semio_viz_snk_caption_y_fp {(\semio_viz_snk_y:n{\l_semio_viz_snk_y_tl}+\semio_viz_snk_y:n{\l_semio_viz_snk_yb_tl})/2}
}
% 🔠 Spreads crowded captions within their column and retains each stratum through a leader.
\cs_new_protected:Npn \semio_viz_snk_captions: {
  \seq_clear:N \l_semio_viz_snk_caption_rows_seq
  \prop_clear:N \l_semio_viz_snk_caption_counts_prop
  \prop_clear:N \l_semio_viz_snk_caption_positions_prop
  \int_step_inline:nn {\l_semio_viz_snk_rows_int} {
    \semio_viz_table_cell:nnnN {semio-net-flow}{##1}{kind}\l_semio_viz_snk_kind_tl
    \str_if_eq:VnT \l_semio_viz_snk_kind_tl {node} {
      \seq_put_right:Nn \l_semio_viz_snk_caption_rows_seq {##1}
      \semio_viz_table_cell:nnnN {semio-net-flow}{##1}{x0}\l_semio_viz_snk_caption_column_tl
      \prop_get:NVNTF \l_semio_viz_snk_caption_counts_prop \l_semio_viz_snk_caption_column_tl \l_tmpa_tl
        {\prop_put:NVx \l_semio_viz_snk_caption_counts_prop \l_semio_viz_snk_caption_column_tl {\int_eval:n{\l_tmpa_tl+1}}}
        {\prop_put:NVn \l_semio_viz_snk_caption_counts_prop \l_semio_viz_snk_caption_column_tl {1}}
    }
  }
  \seq_sort:Nn \l_semio_viz_snk_caption_rows_seq {\semio_viz_snk_caption_sort:nn{##1}{##2}}
  \tl_clear:N \l_semio_viz_snk_caption_previous_tl
  \seq_map_inline:Nn \l_semio_viz_snk_caption_rows_seq {
    \semio_viz_snk_caption_read:n {##1}
    \tl_if_eq:NNF \l_semio_viz_snk_caption_column_tl \l_semio_viz_snk_caption_previous_tl {
      \fp_set:Nn \l_semio_viz_snk_caption_previous_fp {\l_semio_viz_net_yhi_fp+\l_semio_viz_snk_caption_gap_fp/2}
      \tl_set_eq:NN \l_semio_viz_snk_caption_previous_tl \l_semio_viz_snk_caption_column_tl
    }
    \fp_set:Nn \l_semio_viz_snk_caption_y_fp {min(\l_semio_viz_snk_caption_y_fp,\l_semio_viz_snk_caption_previous_fp-\l_semio_viz_snk_caption_gap_fp)}
    \prop_put:Nnx \l_semio_viz_snk_caption_positions_prop {##1}{\fp_to_decimal:N\l_semio_viz_snk_caption_y_fp}
    \fp_set_eq:NN \l_semio_viz_snk_caption_previous_fp \l_semio_viz_snk_caption_y_fp
  }
  \seq_reverse:N \l_semio_viz_snk_caption_rows_seq
  \tl_clear:N \l_semio_viz_snk_caption_previous_tl
  \seq_map_inline:Nn \l_semio_viz_snk_caption_rows_seq {
    \semio_viz_snk_caption_read:n {##1}
    \tl_if_eq:NNF \l_semio_viz_snk_caption_column_tl \l_semio_viz_snk_caption_previous_tl {
      \fp_set:Nn \l_semio_viz_snk_caption_previous_fp {\l_semio_viz_net_ylo_fp-\l_semio_viz_snk_caption_gap_fp/2}
      \tl_set_eq:NN \l_semio_viz_snk_caption_previous_tl \l_semio_viz_snk_caption_column_tl
    }
    \prop_get:NnN \l_semio_viz_snk_caption_positions_prop {##1}\l_tmpa_tl
    \fp_set:Nn \l_semio_viz_snk_caption_previous_fp {max(\l_tmpa_tl,\l_semio_viz_snk_caption_previous_fp+\l_semio_viz_snk_caption_gap_fp)}
    \prop_put:Nnx \l_semio_viz_snk_caption_positions_prop {##1}{\fp_to_decimal:N\l_semio_viz_snk_caption_previous_fp}
  }
  \seq_map_inline:Nn \l_semio_viz_snk_caption_rows_seq {\semio_viz_snk_caption_draw:n{##1}}
}
% 🔠 Fits caption glyphs to the reserved gutter and measured vertical clearance.
\cs_new_protected:Npn \semio_viz_snk_caption_draw:n #1 {
  \semio_viz_snk_caption_read:n {#1}
  \prop_get:NnN \l_semio_viz_snk_caption_positions_prop {#1}\l_tmpa_tl
  \fp_set:Nn \l_semio_viz_snk_caption_previous_fp {\l_tmpa_tl}
  \semio_viz_table_cell:nnnN {semio-net-flow}{#1}{i}\l_semio_viz_snk_i_tl
  \semio_viz_table_cell:nnnN {semio-net-flow}{#1}{x0}\l_semio_viz_snk_x_tl
  \semio_viz_table_cell:nnnN {semio-net-flow}{#1}{x1}\l_semio_viz_snk_xb_tl
  \semio_viz_table_cell:nnnN {semio-net-flow}{#1}{id}\l_semio_viz_snk_id_tl
  \hbox_set:Nn \l_semio_viz_snk_caption_box {\pgfinterruptpicture\c_semio_viz_theme_font_label_tl\l_semio_viz_snk_id_tl\endpgfinterruptpicture}

  \seq_if_empty:cTF {l_semio_viz_network_slink_\int_eval:n{\l_semio_viz_snk_i_tl}_seq} {
    \fp_set:Nn \l_tmpa_fp {\semio_viz_snk_x:n{\l_semio_viz_snk_x_tl}}
    \tl_set:Nn \l_tmpa_tl {east}
    \fp_set:Nn \l_tmpb_fp {\l_tmpa_fp-.9}
  } {
    \fp_set:Nn \l_tmpa_fp {\semio_viz_snk_x:n{\l_semio_viz_snk_xb_tl}}
    \tl_set:Nn \l_tmpa_tl {west}
    \fp_set:Nn \l_tmpb_fp {\l_tmpa_fp+.9}
  }
  \fp_set:Nn \l_semio_viz_snk_caption_width_fp {max(.1,\l_semio_viz_snk_label_w_fp-1.3)}
  \seq_map_inline:Nn \l_semio_viz_snk_caption_rows_seq {
    \str_if_eq:VnTF \l_tmpa_tl {west} {
      \semio_viz_table_cell:nnnN {semio-net-flow}{##1}{x0}\l_tmpb_tl
      \fp_set:Nn \l_semio_viz_snk_caption_neighbor_fp {(\semio_viz_snk_x:n{\l_tmpb_tl})-\l_tmpa_fp}
    } {
      \semio_viz_table_cell:nnnN {semio-net-flow}{##1}{x1}\l_tmpb_tl
      \fp_set:Nn \l_semio_viz_snk_caption_neighbor_fp {\l_tmpa_fp-(\semio_viz_snk_x:n{\l_tmpb_tl})}
    }
    \fp_compare:nNnT {\l_semio_viz_snk_caption_neighbor_fp} > {0} {\fp_set:Nn \l_semio_viz_snk_caption_width_fp {min(\l_semio_viz_snk_caption_width_fp,max(.1,(\l_semio_viz_snk_caption_neighbor_fp-2.8)/2))}}
  }
  \fp_set:Nn \l_semio_viz_snk_caption_scale_fp {min(1,\l_semio_viz_snk_caption_width_fp/max(.01,\dim_to_fp:n{\box_wd:N\l_semio_viz_snk_caption_box}/\dim_to_fp:n{1mm}),max(.1,\l_semio_viz_snk_caption_gap_fp-.6)/max(.01,\dim_to_fp:n{\box_ht:N\l_semio_viz_snk_caption_box+\box_dp:N\l_semio_viz_snk_caption_box}/\dim_to_fp:n{1mm}))}
  \draw[semio-chrome-foreground,line~width=.15mm] (\fp_to_decimal:N\l_tmpa_fp,\fp_to_decimal:N\l_semio_viz_snk_caption_y_fp) -- (\fp_to_decimal:N\l_tmpb_fp,\fp_to_decimal:N\l_semio_viz_snk_caption_previous_fp);
  \node[anchor=\l_tmpa_tl,text=semio-chrome-foreground,fill=semio-chrome-base,inner~sep=.2mm] at (\fp_to_decimal:N\l_tmpb_fp,\fp_to_decimal:N\l_semio_viz_snk_caption_previous_fp) {\scalebox{\fp_to_decimal:N\l_semio_viz_snk_caption_scale_fp}{\box_use:N\l_semio_viz_snk_caption_box}};
  \semio_viz_probe_geometry:nx {flow-label}{#1,\fp_to_decimal:N\l_tmpb_fp,\fp_to_decimal:N\l_semio_viz_snk_caption_previous_fp,\fp_to_decimal:N\l_semio_viz_snk_caption_y_fp,\fp_to_decimal:N\l_semio_viz_snk_caption_scale_fp}
}
% 💧 One link ribbon: two cubic curves with horizontal control points, exactly d3's sankeyLinkHorizontal.
\cs_new_protected:Npn \semio_viz_snk_link_draw:n #1 {
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { i } \l_semio_viz_snk_i_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { j } \l_semio_viz_snk_j_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { x0 } \l_semio_viz_snk_x_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { y0 } \l_semio_viz_snk_y_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { x1 } \l_semio_viz_snk_xb_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { y1 } \l_semio_viz_snk_yb_tl
  \semio_viz_table_cell:nnnN { semio-net-flow } {#1} { width } \l_semio_viz_snk_w_tl
  \str_if_eq:VnTF \l_semio_viz_net_colorby_tl { target }
    { \semio_viz_snk_fill:n { \l_semio_viz_snk_j_tl } }
    { \semio_viz_snk_fill:n { \l_semio_viz_snk_i_tl } }
  \use:x {
    \exp_not:N \fill [ \l_semio_viz_net_fill_tl , opacity=0.5 ]
      ( \fp_to_decimal:n { \semio_viz_snk_x:n { \l_semio_viz_snk_x_tl } } ,
        \fp_to_decimal:n { \semio_viz_snk_y:n
          { \l_semio_viz_snk_y_tl - \l_semio_viz_snk_w_tl / 2 } } )
      .. controls
        ( \fp_to_decimal:n { \semio_viz_snk_cx: } ,
          \fp_to_decimal:n { \semio_viz_snk_y:n
            { \l_semio_viz_snk_y_tl - \l_semio_viz_snk_w_tl / 2 } } )
        and ( \fp_to_decimal:n { \semio_viz_snk_dx: } ,
          \fp_to_decimal:n { \semio_viz_snk_y:n
            { \l_semio_viz_snk_yb_tl - \l_semio_viz_snk_w_tl / 2 } } ) ..
      ( \fp_to_decimal:n { \semio_viz_snk_x:n { \l_semio_viz_snk_xb_tl } } ,
        \fp_to_decimal:n { \semio_viz_snk_y:n
          { \l_semio_viz_snk_yb_tl - \l_semio_viz_snk_w_tl / 2 } } )
      -- ( \fp_to_decimal:n { \semio_viz_snk_x:n { \l_semio_viz_snk_xb_tl } } ,
        \fp_to_decimal:n { \semio_viz_snk_y:n
          { \l_semio_viz_snk_yb_tl + \l_semio_viz_snk_w_tl / 2 } } )
      .. controls
        ( \fp_to_decimal:n { \semio_viz_snk_dx: } ,
          \fp_to_decimal:n { \semio_viz_snk_y:n
            { \l_semio_viz_snk_yb_tl + \l_semio_viz_snk_w_tl / 2 } } )
        and ( \fp_to_decimal:n { \semio_viz_snk_cx: } ,
          \fp_to_decimal:n { \semio_viz_snk_y:n
            { \l_semio_viz_snk_y_tl + \l_semio_viz_snk_w_tl / 2 } } ) ..
      ( \fp_to_decimal:n { \semio_viz_snk_x:n { \l_semio_viz_snk_x_tl } } ,
        \fp_to_decimal:n { \semio_viz_snk_y:n
          { \l_semio_viz_snk_y_tl + \l_semio_viz_snk_w_tl / 2 } } )
      -- cycle ;
  }
  \semio_viz_probe_geometry:nx { flow-link }
    {
      \l_semio_viz_snk_i_tl , \l_semio_viz_snk_j_tl ,
      \fp_eval:n { round( ( \semio_viz_snk_y:n { \l_semio_viz_snk_y_tl } ) , 4 ) } ,
      \fp_eval:n { round( \semio_viz_snk_y:n { \l_semio_viz_snk_yb_tl } , 4 ) } ,
      \fp_eval:n { round( \l_semio_viz_snk_w_tl * \l_semio_viz_snk_k_fp , 4 ) }
    }
}
% 〰️ First Bézier control abscissa of a link ribbon: `curvature` of the way to the target column.
\cs_new:Npn \semio_viz_snk_cx:
  {
    ( \semio_viz_snk_x:n { \l_semio_viz_snk_x_tl } )
    + \l_semio_viz_snk_curv_fp * ( ( \semio_viz_snk_x:n { \l_semio_viz_snk_xb_tl } )
      - ( \semio_viz_snk_x:n { \l_semio_viz_snk_x_tl } ) )
  }
% 〰️ Second Bézier control abscissa of a link ribbon, the mirror of the first at the target end.
\cs_new:Npn \semio_viz_snk_dx:
  {
    ( \semio_viz_snk_x:n { \l_semio_viz_snk_xb_tl } )
    - \l_semio_viz_snk_curv_fp * ( ( \semio_viz_snk_x:n { \l_semio_viz_snk_xb_tl } )
      - ( \semio_viz_snk_x:n { \l_semio_viz_snk_x_tl } ) )
  }

% 💧 Layout space is the unit-height extent the kernel was given; these map it into the drawing rectangle.
\fp_new:N \l_semio_viz_snk_k_fp
\cs_new:Npn \semio_viz_snk_x:n #1 { \l_semio_viz_snk_ox_fp + (#1) * \l_semio_viz_snk_k_fp }
% 💧 Drawing-space ordinate of a layout ordinate; the y axis is flipped on the way.
\cs_new:Npn \semio_viz_snk_y:n #1 { \l_semio_viz_snk_oy_fp - (#1) * \l_semio_viz_snk_k_fp }
\fp_new:N \l_semio_viz_snk_ox_fp
\fp_new:N \l_semio_viz_snk_oy_fp

% 🎨 Fill of the node or link #1 under the `colorby` rule: one colour, the group's, or its own.
\cs_new_protected:Npn \semio_viz_snk_fill:n #1 {
  \str_case:VnF \l_semio_viz_net_colorby_tl
    {
      { none } { \tl_set:Nn \l_semio_viz_net_fill_tl { \semio_viz_theme_color:n { 0 } } }
      { group }
        {
          \semio_viz_net_group_pos:n {#1}
          \semio_viz_net_color:VN \l_semio_viz_net_k_int \l_semio_viz_net_fill_tl
        }
    }
    { \semio_viz_net_color:nN {#1} \l_semio_viz_net_fill_tl }
}

% 💧 Walks the layout output: link ribbons first so the node rectangles sit on top.
\cs_new_protected:Npn \semio_viz_snk_draw: {
  \semio_viz_table_nrows:nN { semio-net-flow } \l_semio_viz_snk_rows_int
  \int_step_inline:nn { \l_semio_viz_snk_rows_int } { \semio_viz_snk_row:nn { link } {##1} }
  \int_step_inline:nn { \l_semio_viz_snk_rows_int } { \semio_viz_snk_row:nn { node } {##1} }
  \bool_if:NT \l_semio_viz_net_labels_bool {\semio_viz_snk_captions:}
}
% 💧 Draws the layout row #2 when it is of kind #1, so one pass over the output draws one layer.
\cs_new_protected:Npn \semio_viz_snk_row:nn #1#2 {
  \semio_viz_table_cell:nnnN { semio-net-flow } {#2} { kind } \l_semio_viz_snk_kind_tl
  \str_if_eq:VnT \l_semio_viz_snk_kind_tl {#1} {
    \str_if_eq:nnTF {#1} { node }
      { \semio_viz_snk_node_draw:n {#2} } { \semio_viz_snk_link_draw:n {#2} }
  }
}

% 💧 The shared render of the three flow families: run the kernel layout, map, draw.
\cs_new_protected:Npn \semio_viz_snk_render:nnn #1#2#3 {
  \semio_viz_frame_require:n { SemioVizRunFamily }
  \semio_viz_snk_keys_reset:
  \str_if_eq:nnT {#2} { parallel-sets } { \fp_zero:N \l_semio_viz_snk_padding_fp }
  \keys_set:nn { semio / viz / family / #1 } {#3}
  \semio_viz_net_bind_build:
  \semio_viz_net_canvas:
  \fp_set:Nn \l_semio_viz_snk_ox_fp
    {
      \l_semio_viz_net_xlo_fp
      + \bool_if:NTF \l_semio_viz_net_labels_bool { \l_semio_viz_snk_label_w_fp } { 0 }
    }
  \fp_set:Nn \l_semio_viz_snk_oy_fp { \l_semio_viz_net_yhi_fp }
  \fp_set:Nn \l_semio_viz_snk_k_fp { \l_semio_viz_net_yhi_fp - \l_semio_viz_net_ylo_fp }
  \tl_set:Nx \l_semio_viz_net_layopts_tl
    {
      \l_semio_viz_net_bind_tl
      node-width = \fp_eval:n { \l_semio_viz_snk_width_fp / \l_semio_viz_snk_k_fp } ,
      node-padding = \fp_eval:n { \l_semio_viz_snk_padding_fp / \l_semio_viz_snk_k_fp } ,
      node-align = \l_semio_viz_snk_align_tl ,
      node-sort = \l_semio_viz_snk_node_sort_tl ,
      link-sort = \l_semio_viz_snk_link_sort_tl ,
      iterations = \int_use:N \l_semio_viz_snk_iterations_int ,
      x0 = 0 , y0 = 0 , y1 = 1 ,
      x1 = \fp_eval:n
        {
          ( \l_semio_viz_net_xhi_fp - \l_semio_viz_snk_ox_fp
            - \bool_if:NTF \l_semio_viz_net_labels_bool { \l_semio_viz_snk_label_w_fp } { 0 } )
          / \l_semio_viz_snk_k_fp
        }
    }
  \semio_viz_layout_structure:nVnV {#2} \l_semio_viz_net_data_tl { semio-net-flow } \l_semio_viz_net_layopts_tl
  \semio_viz_net_groups_build:
  \semio_viz_snk_draw:
}

\semio_viz_snk_keys_add:n { semio / viz / family / sankey }
% 🔑 The sankey's own keys on top of the shared flow keys: relaxation passes and ribbon curvature.
\keys_define:nn { semio / viz / family / sankey } {
  iterations .int_set:N = \l_semio_viz_snk_iterations_int,
  curvature  .fp_set:N = \l_semio_viz_snk_curv_fp,
}
% 💧 §22: the sankey diagram, laid out by the `sankey` layout algorithm of the flow kernel.
\SemioVizFamily { sankey } { \semio_viz_snk_render:nnn { sankey } { sankey } {#1} }
%endregion 🔖️Sankey

\ExplSyntaxOff
