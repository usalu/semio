% ✏️ The annotation the `mode` names, drawn at the `at` position and the `value` it refers to.
\cs_new_protected:Npn \semio_viz_anno_mark: {
  \semio_viz_cart_xmap:VN \l_semio_viz_anno_at_fp \l_semio_viz_cart_c_fp
  \semio_viz_cart_ymap:VN \l_semio_viz_anno_value_fp \l_semio_viz_cart_d_fp
  \tl_set:Nn \l_semio_viz_cart_stroke_tl { \semio_viz_theme_color:n { 0 } }
  \tl_set:Nn \l_semio_viz_cart_fill_tl { \semio_viz_theme_color:n { 0 } }
  \str_case:VnF \l_semio_viz_anno_mode_tl {
    { threshold } {
      \fill [ \semio_viz_theme_color:n { 0 } , fill~opacity=0.1 ]
        ( \fp_eval:n { \l_semio_viz_cart_xlo_fp } , \fp_eval:n { \l_semio_viz_cart_d_fp } )
        rectangle ( \fp_eval:n { \l_semio_viz_cart_xhi_fp } , \fp_eval:n { \l_semio_viz_cart_yhi_fp } ) ;
      \semio_viz_probe_geometry:nx { region }
        { \fp_eval:n { round( \l_semio_viz_cart_d_fp , 4 ) } ,
          \fp_eval:n { round( \l_semio_viz_cart_yhi_fp , 4 ) } }
      \semio_viz_anno_rule:
    }
    { reference-line } { \semio_viz_anno_rule: }
    { reference-band } {
      \fill [ \semio_viz_theme_color:n { 0 } , fill~opacity=0.16 ]
        ( \fp_eval:n { \l_semio_viz_cart_xlo_fp } , \fp_eval:n { \l_semio_viz_cart_d_fp - 3 } )
        rectangle ( \fp_eval:n { \l_semio_viz_cart_xhi_fp } ,
                    \fp_eval:n { \l_semio_viz_cart_d_fp + 3 } ) ;
      \semio_viz_probe_geometry:nx { band }
        { \fp_eval:n { round( \l_semio_viz_cart_d_fp - 3 , 4 ) } ,
          \fp_eval:n { round( \l_semio_viz_cart_d_fp + 3 , 4 ) } }
    }
    { highlight } {
      \fill [ \semio_viz_theme_semantic:n { caution } , fill~opacity=0.2 ]
        ( \fp_eval:n { \l_semio_viz_cart_c_fp - 5 } , \fp_eval:n { \l_semio_viz_cart_ylo_fp } )
        rectangle ( \fp_eval:n { \l_semio_viz_cart_c_fp + 5 } ,
                    \fp_eval:n { \l_semio_viz_cart_yhi_fp } ) ;
      \semio_viz_probe_geometry:nx { region }
        { \fp_eval:n { round( \l_semio_viz_cart_c_fp - 5 , 4 ) } ,
          \fp_eval:n { round( \l_semio_viz_cart_c_fp + 5 , 4 ) } }
    }
    { label-rich } { \semio_viz_anno_labels_all: }
    { direct-label } { \semio_viz_anno_label_end: }
    { event-marker } {
      \semio_viz_cart_draw_hair:nnnn { \fp_eval:n { \l_semio_viz_cart_c_fp } }
        { \fp_eval:n { \l_semio_viz_cart_ylo_fp } } { \fp_eval:n { \l_semio_viz_cart_c_fp } }
        { \fp_eval:n { \l_semio_viz_cart_yhi_fp } }
      \semio_viz_cart_draw_dot:nnn { \fp_eval:n { \l_semio_viz_cart_c_fp } }
        { \fp_eval:n { \l_semio_viz_cart_yhi_fp } } { 1.2 }
    }
  } { \semio_viz_anno_callout: }
}

