\ExplSyntaxOn

%region 🔖️SeriesGeometry
% 📈 The row scan every line-shaped family shares: one series' points in row order, mapped through
% `cart-x` and `cart-y`, with the index/normalize transform applied before mapping.
\fp_new:N \l_semio_viz_line_first_fp
\fp_new:N \l_semio_viz_line_base_fp
\bool_new:N \l_semio_viz_line_first_seen_bool
\tl_new:N \l_semio_viz_line_xcell_tl
\tl_new:N \l_semio_viz_line_ycell_tl
\tl_new:N \l_semio_viz_line_gcell_tl
\tl_new:N \l_semio_viz_line_mode_tl
\tl_new:N \l_semio_viz_line_highlight_tl
\tl_new:N \l_semio_viz_line_lo_tl
\tl_new:N \l_semio_viz_line_hi_tl
\bool_new:N \l_semio_viz_line_markers_bool
\bool_new:N \l_semio_viz_line_conf_bool
\bool_new:N \l_semio_viz_line_area_bool

% 🔁 Fills the point sequence of the current series; `#1` selects the value column to read.
\cs_new_protected:Npn \semio_viz_line_scan:n #1 {
  \seq_clear:N \l_semio_viz_cart_pts_seq
  \bool_set_false:N \l_semio_viz_line_first_seen_bool
  \semio_viz_table_nrows:VN \l_semio_viz_cart_data_tl \l_semio_viz_cart_nrows_int
  \tl_set:Nn \l_semio_viz_cart_arg_col_tl {#1}
  \semio_viz_line_scan_run:
}

% 🔎 The scan itself: every data row, skipping the rows that belong to another series.
\cs_new_protected:Npn \semio_viz_line_scan_run: {
  \int_step_inline:nn { \l_semio_viz_cart_nrows_int } {
    \bool_set_true:N \l_semio_viz_line_row_bool
    \tl_if_empty:NF \l_semio_viz_cart_group_tl {
      \semio_viz_table_cell:nnVN { \l_semio_viz_cart_data_tl } {##1} \l_semio_viz_cart_group_tl
        \l_semio_viz_line_gcell_tl
      \tl_if_eq:NNF \l_semio_viz_line_gcell_tl \l_semio_viz_bar_grp_tl
        { \bool_set_false:N \l_semio_viz_line_row_bool }
    }
    \bool_if:NT \l_semio_viz_line_row_bool { \semio_viz_line_row_take:n {##1} }
  }
}
\bool_new:N \l_semio_viz_line_row_bool

% 📈 Takes data row #1 into the point sequence, after the transformation the `mode` asks for —
% raw value, index against the first, cumulative sum, or difference from the previous row.
\cs_new_protected:Npn \semio_viz_line_row_take:n #1 {
  \semio_viz_table_cell:nnVN { \l_semio_viz_cart_data_tl } {#1} \l_semio_viz_cart_x_tl
    \l_semio_viz_line_xcell_tl
  \semio_viz_table_cell:nnVN { \l_semio_viz_cart_data_tl } {#1} \l_semio_viz_cart_arg_col_tl
    \l_semio_viz_line_ycell_tl
  \fp_set:Nn \l_semio_viz_cart_v_fp { \l_semio_viz_line_ycell_tl }
  \bool_if:NF \l_semio_viz_line_first_seen_bool {
    \fp_set_eq:NN \l_semio_viz_line_first_fp \l_semio_viz_cart_v_fp
    \bool_set_true:N \l_semio_viz_line_first_seen_bool
  }
  \str_case:VnT \l_semio_viz_line_mode_tl {
    { indexed } { \fp_set:Nn \l_semio_viz_cart_v_fp
      { 100 * \l_semio_viz_cart_v_fp / \l_semio_viz_line_first_fp } }
    { normalized } { \fp_set:Nn \l_semio_viz_cart_v_fp
      { \l_semio_viz_cart_v_fp / \l_semio_viz_line_first_fp } }
  } { }
  \semio_viz_cart_xmap:VN \l_semio_viz_line_xcell_tl \l_semio_viz_cart_c_fp
  \semio_viz_cart_ymap:VN \l_semio_viz_cart_v_fp \l_semio_viz_cart_d_fp
  \seq_put_right:Nx \l_semio_viz_cart_pts_seq
    { \fp_eval:n { \l_semio_viz_cart_c_fp } , \fp_eval:n { \l_semio_viz_cart_d_fp } }
}

% 🧵 Series list of a line-shaped family; an empty group column means one unnamed series.
\cs_new_protected:Npn \semio_viz_line_groups: {
  \tl_if_empty:NTF \l_semio_viz_cart_group_tl
    {
      \seq_clear:N \l_semio_viz_cart_groups_seq
      \seq_put_right:Nn \l_semio_viz_cart_groups_seq { }
    }
    { \semio_viz_cart_cats:VVN \l_semio_viz_cart_data_tl \l_semio_viz_cart_group_tl
        \l_semio_viz_cart_groups_seq }
}

% 📐 Value domain of a line family, taking the index/normalize transform into account.
\cs_new_protected:Npn \semio_viz_line_domain: {
  \str_case:VnTF \l_semio_viz_line_mode_tl {
    { indexed } {
      \bool_if:NF \l_semio_viz_cart_ymin_user_bool { \fp_set:Nn \l_semio_viz_cart_ymin_fp { 0 } }
      \bool_if:NF \l_semio_viz_cart_ymax_user_bool { \fp_set:Nn \l_semio_viz_cart_ymax_fp { 260 } }
    }
    { normalized } {
      \bool_if:NF \l_semio_viz_cart_ymin_user_bool { \fp_set:Nn \l_semio_viz_cart_ymin_fp { 0 } }
      \bool_if:NF \l_semio_viz_cart_ymax_user_bool { \fp_set:Nn \l_semio_viz_cart_ymax_fp { 3 } }
    }
  } { } { \semio_viz_cart_domain_plain: }
}

% 🧭 The independent axis of a line family: a linear scale over the x column's extent.
\cs_new_protected:Npn \semio_viz_line_axis_x: {
  \semio_viz_cart_extent:VVNN \l_semio_viz_cart_data_tl \l_semio_viz_cart_x_tl
    \l_semio_viz_cart_xmin_fp \l_semio_viz_cart_xmax_fp
  \semio_viz_cart_scale_x:n { linear }
}

% 🎨 Series colour, honouring the highlight option.
\cs_new_protected:Npn \semio_viz_line_series_color: {
  \tl_if_empty:NTF \l_semio_viz_line_highlight_tl
    { \semio_viz_cart_color:VN \l_semio_viz_bar_gi_int \l_semio_viz_cart_stroke_tl }
    {
      \tl_if_eq:NNTF \l_semio_viz_bar_grp_tl \l_semio_viz_line_highlight_tl
        { \tl_set:Nn \l_semio_viz_cart_stroke_tl { \semio_viz_theme_color:n { 0 } } }
        { \tl_set:Nn \l_semio_viz_cart_stroke_tl { semio-chrome-border-normal } }
    }
  \tl_set_eq:NN \l_semio_viz_cart_fill_tl \l_semio_viz_cart_stroke_tl
}
%endregion 🔖️SeriesGeometry

%region 🔖️Keys
% 🔑 semio / viz / family / line — taxonomy §2 line charts.
%   mode       (plain|indexed|normalized|connected, default plain)  value transform before mapping
%   curve      (linear|step|step-before|step-after|basis|cardinal|catmull-rom|monotone-x|natural|
%               bezier, default linear)                             interpolation between points
%   markers    (boolean, default false)                             dots on every data point
%   highlight  (series value, default empty)                        one series in the accent colour
%   confidence (boolean, default false)                             draw the lo/hi band behind
%   lo / hi    (columns, default lo / hi)                           the confidence band columns
\keys_define:nn { semio / viz / family / line } { }
\semio_viz_cart_family_keys:n { semio / viz / family / line }
% 🔑 The line chart's own keys, on top of the cartesian family keys inherited above.
\keys_define:nn { semio / viz / family / line } {
  mode       .tl_set:N = \l_semio_viz_line_mode_tl,
  markers    .bool_set:N = \l_semio_viz_line_markers_bool,
  highlight  .tl_set:N = \l_semio_viz_line_highlight_tl,
  confidence .bool_set:N = \l_semio_viz_line_conf_bool,
  lo         .tl_set:N = \l_semio_viz_line_lo_tl,
  hi         .tl_set:N = \l_semio_viz_line_hi_tl,
}

% 🔑 semio / viz / family / spark — the word-sized charts of taxonomy §2.
%   mode (line|area|bar, default line)   the spark form
%   band (boolean, default false)        min/max reference band behind the spark
\tl_new:N \l_semio_viz_spark_mode_tl
\bool_new:N \l_semio_viz_spark_band_bool
\semio_viz_cart_family_keys:n { semio / viz / family / spark }
% 🔑 The sparkline's own keys, on top of the cartesian family keys inherited above.
\keys_define:nn { semio / viz / family / spark } {
  mode .tl_set:N = \l_semio_viz_spark_mode_tl,
  band .bool_set:N = \l_semio_viz_spark_band_bool,
}

% 🔑 semio / viz / family / slope — the before/after comparisons of taxonomy §2.
%   mode    (slope|before-after|change|delta, default slope)
%   markers (boolean, default true)   dots at both ends
%   labels  (none|value|category, inherited)
\tl_new:N \l_semio_viz_slope_mode_tl
\bool_new:N \l_semio_viz_slope_markers_bool
\semio_viz_cart_family_keys:n { semio / viz / family / slope }
% 🔑 The slope chart's own keys, on top of the cartesian family keys inherited above.
\keys_define:nn { semio / viz / family / slope } {
  mode    .tl_set:N = \l_semio_viz_slope_mode_tl,
  markers .bool_set:N = \l_semio_viz_slope_markers_bool,
}

% 🔑 semio / viz / family / annotated — the annotation-driven types of taxonomy §50.
%   mode  (callout|highlight|threshold|reference-line|reference-band|event-marker|label-rich|
%          direct-label|story|explainer, default callout)
%   at    (number, default 3)     the x position the annotation attaches to
%   value (number, default 6)     the threshold / reference value
%   note  (text, default empty)   the annotation text; empty picks the localized default
\tl_new:N \l_semio_viz_anno_mode_tl
\tl_new:N \l_semio_viz_anno_note_tl
\fp_new:N \l_semio_viz_anno_at_fp
\fp_new:N \l_semio_viz_anno_value_fp
\semio_viz_cart_family_keys:n { semio / viz / family / annotated }
% 🔑 The annotated chart's own keys, on top of the cartesian family keys inherited above.
\keys_define:nn { semio / viz / family / annotated } {
  mode  .tl_set:N = \l_semio_viz_anno_mode_tl,
  at    .fp_set:N = \l_semio_viz_anno_at_fp,
  value .fp_set:N = \l_semio_viz_anno_value_fp,
  note  .tl_set:N = \l_semio_viz_anno_note_tl,
}

% 🔑 semio / viz / family / axisplot — the axis-specialised plots of taxonomy §51.
%   scale     (linear|log|symlog|pow|sqrt|reciprocal|probability|time|categorical, default linear)
%   mode      (single|broken|discontinuous|mirrored|dual|multiple, default single)
%   breakAt   (number, default 5)   where a broken/discontinuous axis is interrupted
\tl_new:N \l_semio_viz_axisplot_scale_tl
\tl_new:N \l_semio_viz_axisplot_mode_tl
\fp_new:N \l_semio_viz_axisplot_break_fp
\tl_new:N \l_semio_viz_axisplot_kind_tl
\semio_viz_cart_family_keys:n { semio / viz / family / axisplot }
% 🔑 The axis plot's own keys, on top of the cartesian family keys inherited above.
\keys_define:nn { semio / viz / family / axisplot } {
  scale   .tl_set:N = \l_semio_viz_axisplot_scale_tl,
  mode    .tl_set:N = \l_semio_viz_axisplot_mode_tl,
  breakAt .fp_set:N = \l_semio_viz_axisplot_break_fp,
}
%endregion 🔖️Keys

%region 🔖️Families
% 📈 line — every line chart of taxonomy §2, plus the multi-series forms of §62 and §65.
\cs_new_protected:Npn \semio_viz_line_keys_reset: {
  \semio_viz_cart_keys_reset:
  \tl_set:Nn \l_semio_viz_cart_data_tl { demo-multiseries }
  \tl_set:Nn \l_semio_viz_cart_x_tl { t }
  \tl_set:Nn \l_semio_viz_cart_y_tl { val }
  \tl_set:Nn \l_semio_viz_cart_group_tl { series }
  \tl_set:Nn \l_semio_viz_line_mode_tl { plain }
  \tl_clear:N \l_semio_viz_line_highlight_tl
  \tl_set:Nn \l_semio_viz_line_lo_tl { lo }
  \tl_set:Nn \l_semio_viz_line_hi_tl { hi }
  \bool_set_false:N \l_semio_viz_line_markers_bool
  \bool_set_false:N \l_semio_viz_line_conf_bool
  \fp_zero:N \l_semio_viz_bar_baseline_fp
}

% ⚫ The series' data-point dots, drawn only when `markers` asks for them.
\cs_new_protected:Npn \semio_viz_line_markers_draw: {
  \bool_if:NT \l_semio_viz_line_markers_bool {
    \seq_set_eq:NN \l_semio_viz_cart_map_b_seq \l_semio_viz_cart_pts_seq
    \semio_viz_line_markers_run:
  }
}

% 🔁 One dot per point of the sequence being marked.
\cs_new_protected:Npn \semio_viz_line_markers_run: {
  \seq_map_inline:Nn \l_semio_viz_cart_map_b_seq {
    \semio_viz_cart_draw_dot:nnn { \clist_item:nn {##1} { 1 } } { \clist_item:nn {##1} { 2 } } { 1 }
  }
}

% 📈 One series: its confidence band first, so the line and its markers sit on top of it.
\cs_new_protected:Npn \semio_viz_line_series_draw: {
  \bool_if:NT \l_semio_viz_line_conf_bool {
    \tl_set_eq:NN \l_semio_viz_cart_arg_colb_tl \l_semio_viz_cart_y_tl
    \exp_args:NV \semio_viz_line_scan:n \l_semio_viz_line_hi_tl
    \seq_set_eq:NN \l_semio_viz_cart_pts_b_seq \l_semio_viz_cart_pts_seq
    \exp_args:NV \semio_viz_line_scan:n \l_semio_viz_line_lo_tl
    \semio_viz_cart_draw_band:NN \l_semio_viz_cart_pts_b_seq \l_semio_viz_cart_pts_seq
  }
  \exp_args:NV \semio_viz_line_scan:n \l_semio_viz_cart_y_tl
  \semio_viz_cart_draw_path:N \l_semio_viz_cart_pts_seq
  \semio_viz_line_markers_draw:
}

% ▶️ The whole family run: defaults, the option list #1, the frame, scales and grid, one pass per
% series, then the axes and the legend.
\cs_new_protected:Npn \semio_viz_line_render:n #1 {
  \semio_viz_frame_require:n { SemioVizRunFamily }
  \semio_viz_line_keys_reset:
  \keys_set:nn { semio / viz / family / line } {#1}
  \semio_viz_cart_rect_compute:
  \semio_viz_line_groups:
  \semio_viz_line_domain:
  \semio_viz_line_axis_x:
  \semio_viz_cart_scale_value:nn { linear } { v }
  \semio_viz_cart_grid_y:
  \semio_viz_cart_grid_x:
  \semio_viz_cart_axis_frame:
  \seq_map_indexed_inline:Nn \l_semio_viz_cart_groups_seq {
    \int_set:Nn \l_semio_viz_bar_gi_int {##1}
    \tl_set:Nn \l_semio_viz_bar_grp_tl {##2}
    \semio_viz_line_series_color:
    \semio_viz_line_series_draw:
  }
  \semio_viz_cart_axis_ticks:n { v }
  \semio_viz_cart_legend:N \l_semio_viz_cart_groups_seq
}

% 📈 §2, §62 and §65: every line chart, from a single series to indexed and cumulative multi-series.
\SemioVizFamily { line } { \semio_viz_line_render:n {#1} }

% ✨ spark — sparkline, spark area and spark bar of taxonomy §2, drawn without chrome.
\cs_new_protected:Npn \semio_viz_spark_keys_reset: {
  \semio_viz_line_keys_reset:
  \tl_clear:N \l_semio_viz_cart_group_tl
  \tl_set:Nn \l_semio_viz_cart_data_tl { demo }
  \tl_set:Nn \l_semio_viz_cart_x_tl { t }
  \tl_set:Nn \l_semio_viz_cart_y_tl { val }
  \tl_set:Nn \l_semio_viz_spark_mode_tl { line }
  \bool_set_false:N \l_semio_viz_spark_band_bool
  \bool_set_false:N \l_semio_viz_cart_axes_bool
  \fp_set:Nn \l_semio_viz_cart_pad_l_fp { 1 }
  \fp_set:Nn \l_semio_viz_cart_pad_r_fp { 1 }
  \fp_set:Nn \l_semio_viz_cart_pad_t_fp { 1 }
  \fp_set:Nn \l_semio_viz_cart_pad_b_fp { 1 }
}

% 📊 The spark bar form: one bar per point, sized so the whole series fits the word-sized frame.
\cs_new_protected:Npn \semio_viz_spark_bars: {
  \int_set:Nn \l_semio_viz_cart_n_int { \seq_count:N \l_semio_viz_cart_pts_seq }
  \fp_set:Nn \l_semio_viz_cart_a_fp
    { ( \l_semio_viz_cart_xhi_fp - \l_semio_viz_cart_xlo_fp ) / \l_semio_viz_cart_n_int * 0.7 }
  \seq_set_eq:NN \l_semio_viz_cart_map_b_seq \l_semio_viz_cart_pts_seq
  \semio_viz_spark_bars_run:
}

% 🔁 One bar per point, from the plot floor up to the point.
\cs_new_protected:Npn \semio_viz_spark_bars_run: {
  \seq_map_inline:Nn \l_semio_viz_cart_map_b_seq {
    \semio_viz_cart_draw_rect:nnnn
      { \clist_item:nn {##1} { 1 } - \l_semio_viz_cart_a_fp / 2 }
      { \fp_eval:n { \l_semio_viz_cart_ylo_fp } }
      { \fp_eval:n { \l_semio_viz_cart_a_fp } }
      { \clist_item:nn {##1} { 2 } - \l_semio_viz_cart_ylo_fp }
  }
}

% ▶️ The whole family run: defaults, the option list #1, the bare frame — no axes, no legend, no
% grid, because a spark has to sit inside a line of text — then the form the `mode` names.
\cs_new_protected:Npn \semio_viz_spark_render:n #1 {
  \semio_viz_frame_require:n { SemioVizRunFamily }
  \semio_viz_spark_keys_reset:
  \keys_set:nn { semio / viz / family / spark } {#1}
  \semio_viz_cart_rect_compute:
  \semio_viz_line_domain:
  \semio_viz_line_axis_x:
  \semio_viz_cart_scale_value:nn { linear } { v }
  \bool_if:NT \l_semio_viz_spark_band_bool {
    \fill [ semio-chrome-panel , fill~opacity=0.5 ]
      ( \fp_eval:n { \l_semio_viz_cart_xlo_fp } , \fp_eval:n { \l_semio_viz_cart_ylo_fp } )
      rectangle ( \fp_eval:n { \l_semio_viz_cart_xhi_fp } , \fp_eval:n { \l_semio_viz_cart_yhi_fp } ) ;
  }
  \tl_clear:N \l_semio_viz_bar_grp_tl
  \semio_viz_cart_color:nN { 1 } \l_semio_viz_cart_stroke_tl
  \tl_set_eq:NN \l_semio_viz_cart_fill_tl \l_semio_viz_cart_stroke_tl
  \exp_args:NV \semio_viz_line_scan:n \l_semio_viz_cart_y_tl
  \str_case:VnF \l_semio_viz_spark_mode_tl {
    { bar } { \semio_viz_spark_bars: }
    { area } {
      \seq_set_eq:NN \l_semio_viz_cart_pts_b_seq \l_semio_viz_cart_pts_seq
      \semio_viz_spark_floor:
      \semio_viz_cart_draw_band:NN \l_semio_viz_cart_pts_b_seq \l_semio_viz_cart_pts_seq
      \seq_set_eq:NN \l_semio_viz_cart_pts_seq \l_semio_viz_cart_pts_b_seq
      \semio_viz_cart_draw_path:N \l_semio_viz_cart_pts_seq
    }
  } { \semio_viz_cart_draw_path:N \l_semio_viz_cart_pts_seq }
}

% ⬇️ Replaces the point sequence by its own projection onto the plot floor.
\cs_new_protected:Npn \semio_viz_spark_floor: {
  \seq_set_eq:NN \l_semio_viz_cart_map_b_seq \l_semio_viz_cart_pts_seq
  \seq_clear:N \l_semio_viz_cart_pts_seq
  \semio_viz_spark_floor_run:
}

% 🔁 The projection itself: every point's abscissa taken down to the plot floor.
\cs_new_protected:Npn \semio_viz_spark_floor_run: {
  \seq_map_inline:Nn \l_semio_viz_cart_map_b_seq {
    \seq_put_right:Nx \l_semio_viz_cart_pts_seq
      { \clist_item:nn {##1} { 1 } , \fp_eval:n { \l_semio_viz_cart_ylo_fp } }
  }
}

% ✨ §2: the word-sized charts — sparkline, spark area and spark bar.
\SemioVizFamily { spark } { \semio_viz_spark_render:n {#1} }

% ↗️ slope — slope charts, slopegraphs and change/delta comparisons of taxonomy §2.
\cs_new_protected:Npn \semio_viz_slope_keys_reset: {
  \semio_viz_line_keys_reset:
  \tl_set:Nn \l_semio_viz_slope_mode_tl { slope }
  \bool_set_true:N \l_semio_viz_slope_markers_bool
}

\clist_new:N \l_semio_viz_slope_first_clist
\clist_new:N \l_semio_viz_slope_last_clist

% ↗️ One series reduced to its two ends, then drawn in the form the `mode` names.
\cs_new_protected:Npn \semio_viz_slope_series: {
  \exp_args:NV \semio_viz_line_scan:n \l_semio_viz_cart_y_tl
  \int_set:Nn \l_semio_viz_cart_n_int { \seq_count:N \l_semio_viz_cart_pts_seq }
  \int_compare:nNnT { \l_semio_viz_cart_n_int } > { 1 } {
    \clist_set:Nx \l_semio_viz_slope_first_clist { \seq_item:Nn \l_semio_viz_cart_pts_seq { 1 } }
    \clist_set:Nx \l_semio_viz_slope_last_clist
      { \seq_item:Nn \l_semio_viz_cart_pts_seq { \l_semio_viz_cart_n_int } }
    \fp_set:Nn \l_semio_viz_cart_a_fp { \clist_item:Nn \l_semio_viz_slope_first_clist { 2 } }
    \fp_set:Nn \l_semio_viz_cart_b_fp { \clist_item:Nn \l_semio_viz_slope_last_clist { 2 } }
    \str_case:VnF \l_semio_viz_slope_mode_tl {
      { change } { \fp_set:Nn \l_semio_viz_slope_width_fp { 4 } \semio_viz_slope_change: }
      { delta } { \fp_set:Nn \l_semio_viz_slope_width_fp { 2 } \semio_viz_slope_change: }
      { before-after } { \semio_viz_slope_before_after: }
    } { \semio_viz_slope_line: }
  }
}

% ➗ The slope itself: one segment between the two ends, with a dot at each under `markers`.
\cs_new_protected:Npn \semio_viz_slope_line: {
  \semio_viz_cart_draw_seg:nnnn
    { \fp_eval:n { \l_semio_viz_cart_xlo_fp + 4 } } { \fp_eval:n { \l_semio_viz_cart_a_fp } }
    { \fp_eval:n { \l_semio_viz_cart_xhi_fp - 4 } } { \fp_eval:n { \l_semio_viz_cart_b_fp } }
  \bool_if:NT \l_semio_viz_slope_markers_bool {
    \semio_viz_cart_draw_dot:nnn { \fp_eval:n { \l_semio_viz_cart_xlo_fp + 4 } }
      { \fp_eval:n { \l_semio_viz_cart_a_fp } } { 1.2 }
    \semio_viz_cart_draw_dot:nnn { \fp_eval:n { \l_semio_viz_cart_xhi_fp - 4 } }
      { \fp_eval:n { \l_semio_viz_cart_b_fp } } { 1.2 }
  }
}

\fp_new:N \l_semio_viz_slope_width_fp

% ↔️ before/after keeps the two ends as separate marks joined by a hairline, not a bold slope.
\cs_new_protected:Npn \semio_viz_slope_before_after: {
  \semio_viz_cart_draw_hair:nnnn
    { \fp_eval:n { \l_semio_viz_cart_xlo_fp + 4 } } { \fp_eval:n { \l_semio_viz_cart_a_fp } }
    { \fp_eval:n { \l_semio_viz_cart_xhi_fp - 4 } } { \fp_eval:n { \l_semio_viz_cart_b_fp } }
  \semio_viz_cart_draw_dot:nnn { \fp_eval:n { \l_semio_viz_cart_xlo_fp + 4 } }
    { \fp_eval:n { \l_semio_viz_cart_a_fp } } { 1.8 }
  \semio_viz_cart_draw_dot:nnn { \fp_eval:n { \l_semio_viz_cart_xhi_fp - 4 } }
    { \fp_eval:n { \l_semio_viz_cart_b_fp } } { 1.8 }
}

% 🔺 The change and delta forms: one bar per series spanning from its first value to its last,
% in the semantic colour of the direction it moved.
\cs_new_protected:Npn \semio_viz_slope_change: {
  \fp_set:Nn \l_semio_viz_cart_c_fp
    { \l_semio_viz_cart_xlo_fp
      + ( \l_semio_viz_bar_gi_int - 0.5 )
        * ( \l_semio_viz_cart_xhi_fp - \l_semio_viz_cart_xlo_fp )
        / \seq_count:N \l_semio_viz_cart_groups_seq }
  \fp_compare:nNnTF { \l_semio_viz_cart_b_fp } < { \l_semio_viz_cart_a_fp }
    { \tl_set:Nn \l_semio_viz_cart_fill_tl { \semio_viz_theme_semantic:n { negative } } }
    { \tl_set:Nn \l_semio_viz_cart_fill_tl { \semio_viz_theme_semantic:n { positive } } }
  \semio_viz_cart_draw_rect:nnnn
    { \fp_eval:n { \l_semio_viz_cart_c_fp - \l_semio_viz_slope_width_fp / 2 } }
    { \fp_eval:n { \l_semio_viz_cart_a_fp } }
    { \fp_eval:n { \l_semio_viz_slope_width_fp } }
    { \fp_eval:n { \l_semio_viz_cart_b_fp - \l_semio_viz_cart_a_fp } }
}

