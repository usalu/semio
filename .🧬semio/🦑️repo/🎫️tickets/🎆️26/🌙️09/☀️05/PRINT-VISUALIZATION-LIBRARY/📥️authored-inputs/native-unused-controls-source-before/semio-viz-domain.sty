%region 🔖️Keys-engineering-diagram
% 🔑 `engineering-diagram` keys, l3keys family `semio / viz / family / engineering-diagram`. §36
% draws one machine seven ways, so the family reads a part table once and hands the placed parts
% to the schematic the `mode` key selects.
% variant (tl)      catalogue slug, recorded by the registry
% data    (table)   part table                                     default `demo-machine`
% id      (column)  part identity                                  default `id`
% label   (column)  part caption                                   default `label`
% class   (column)  `body`, `gear` or `link`                       default `kind`
% x, y    (column)  nominal part position                          default `x`, `y`
% size    (column)  body extent in millimetres                     default `size`
% teeth   (column)  tooth count of a gear                          default `teeth`
% link    (column)  the part this one is jointed to                default `link`
% mode    (choice `assembly|exploded|gear|kinematic|linkage|mechanism|truss`) default `assembly`
% explode (mm)      radial displacement away from the centroid     default 0
% body    (number)  scale factor applied to every part extent      default 1
% node    (mm)      joint and pin radius                           default 0.9
% leaders (bool)    dashed leader from nominal to displaced place  default false
% ground  (bool)    hatch the fixed part                           default false
% labels  (bool)    print part captions                            default true
\keys_define:nn { semio / viz / family / engineering-diagram } {
  data    .tl_set:N   = \l_semio_viz_dom_data_tl,
  id      .tl_set:N   = \l_semio_viz_dom_id_tl,
  label   .tl_set:N   = \l_semio_viz_dom_label_tl,
  class   .tl_set:N   = \l_semio_viz_dom_group_tl,
  x       .tl_set:N   = \l_semio_viz_dom_x_tl,
  y       .tl_set:N   = \l_semio_viz_dom_y_tl,
  size    .tl_set:N   = \l_semio_viz_dom_value_tl,
  teeth   .tl_set:N   = \l_semio_viz_dom_second_tl,
  link    .tl_set:N   = \l_semio_viz_dom_edges_tl,
  mode    .tl_set:N   = \l_semio_viz_dom_mode_tl,
  explode .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  body    .fp_set:N   = \l_semio_viz_dom_beta_fp,
  node    .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  pad     .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width   .fp_set:N   = \l_semio_viz_dom_width_fp,
  height  .fp_set:N   = \l_semio_viz_dom_height_fp,
  leaders .bool_set:N = \l_semio_viz_dom_annotate_bool,
  ground  .bool_set:N = \l_semio_viz_dom_grid_bool,
  labels  .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown .code:n     = { },
}
%endregion 🔖️Keys-engineering-diagram

%region 🔖️EngineeringDiagram
% ⚙️ Reads the part table and maps every nominal position into the frame; the props it fills are
% the only state the seven schematics below share.
\cs_new_protected:Npn \semio_viz_dom_eng_load: {
  \prop_clear:N \l_semio_viz_dom_pos_prop
  \prop_clear:N \l_semio_viz_dom_bag_prop
  \prop_clear:N \l_semio_viz_dom_kid_prop
  \prop_clear:N \l_semio_viz_dom_lab_prop
  \prop_clear:N \l_semio_viz_dom_par_prop
  \prop_clear:N \l_semio_viz_dom_sum_prop
  \seq_clear:N \l_semio_viz_dom_keys_seq
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_x_tl
    \l_semio_viz_dom_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_x_tl
    \l_semio_viz_dom_hi_fp
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_y_tl
    \l_semio_viz_dom_lo_b_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_y_tl
    \l_semio_viz_dom_hi_b_fp
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_eng_part:n {##1} }
}

% ⚙️ One part: its frame position, its body extent, its class, its caption and its joint.
\cs_new_protected:Npn \semio_viz_dom_eng_part:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
    \l_semio_viz_dom_key_tl
  \seq_put_right:NV \l_semio_viz_dom_keys_seq \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_x_tl }
    \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_x_fp
    {
      \l_semio_viz_dom_xa_fp + 5
      + ( \l_semio_viz_dom_cell_tl - \l_semio_viz_dom_lo_fp )
        * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp - 10 )
        / max ( 1e-9 , \l_semio_viz_dom_hi_fp - \l_semio_viz_dom_lo_fp )
    }
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_y_tl }
    \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_y_fp
    {
      \l_semio_viz_dom_ya_fp + 4
      + ( \l_semio_viz_dom_cell_tl - \l_semio_viz_dom_lo_b_fp )
        * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp - 8 )
        / max ( 1e-9 , \l_semio_viz_dom_hi_b_fp - \l_semio_viz_dom_lo_b_fp )
    }
  \prop_put:NVx \l_semio_viz_dom_pos_prop \l_semio_viz_dom_key_tl
    { \fp_eval:n { \l_semio_viz_dom_x_fp } , \fp_eval:n { \l_semio_viz_dom_y_fp } }
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \tl_if_empty:NT \l_semio_viz_dom_cell_tl { \tl_set:Nn \l_semio_viz_dom_cell_tl { 4 } }
  \prop_put:NVx \l_semio_viz_dom_bag_prop \l_semio_viz_dom_key_tl
    { \fp_eval:n { \l_semio_viz_dom_cell_tl * \l_semio_viz_dom_beta_fp } }
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_group_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_kid_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_label_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_lab_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_edges_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_par_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_second_tl }
    \l_semio_viz_dom_cell_tl
  \tl_if_empty:NT \l_semio_viz_dom_cell_tl { \tl_set:Nn \l_semio_viz_dom_cell_tl { 0 } }
  \prop_put:NVV \l_semio_viz_dom_sum_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
}

% 📍 Reads the frame position of part #1 into the fp variables #2 and #3.
\cs_new_protected:Npn \semio_viz_dom_eng_at:nNN #1#2#3 {
  \prop_get:NnN \l_semio_viz_dom_pos_prop {#1} \l_semio_viz_dom_key_tl
  \seq_set_split:NnV \l_semio_viz_dom_aux_seq { , } \l_semio_viz_dom_key_tl
  \fp_set:Nn #2 { \seq_item:Nn \l_semio_viz_dom_aux_seq { 1 } }
  \fp_set:Nn #3 { \seq_item:Nn \l_semio_viz_dom_aux_seq { 2 } }
}

% 💥 Pushes every part away from the centroid of the assembly by the `explode` distance and
% remembers the nominal place so the leader lines can point back at it.
\cs_new_protected:Npn \semio_viz_dom_eng_explode: {
  \fp_zero:N \l_semio_viz_dom_a_fp
  \fp_zero:N \l_semio_viz_dom_b_fp
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq {
    \semio_viz_dom_eng_at:nNN {##1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
    \fp_add:Nn \l_semio_viz_dom_a_fp { \l_semio_viz_dom_x_fp }
    \fp_add:Nn \l_semio_viz_dom_b_fp { \l_semio_viz_dom_y_fp }
  }
  \fp_set:Nn \l_semio_viz_dom_a_fp
    { \l_semio_viz_dom_a_fp / max ( 1 , \l_semio_viz_dom_n_int ) }
  \fp_set:Nn \l_semio_viz_dom_b_fp
    { \l_semio_viz_dom_b_fp / max ( 1 , \l_semio_viz_dom_n_int ) }
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_eng_push:n {##1} }
}

% 💥 One part's displacement plus its optional leader back to the nominal position.
\cs_new_protected:Npn \semio_viz_dom_eng_push:n #1 {
  \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \fp_set:Nn \l_semio_viz_dom_c_fp
    {
      max ( 1e-6 ,
            sqrt ( ( \l_semio_viz_dom_x_fp - \l_semio_viz_dom_a_fp ) ^ 2
                   + ( \l_semio_viz_dom_y_fp - \l_semio_viz_dom_b_fp ) ^ 2 ) )
    }
  \fp_set:Nn \l_semio_viz_dom_d_fp
    { 1 + \l_semio_viz_dom_alpha_fp / \l_semio_viz_dom_c_fp }
  \prop_put:Nnx \l_semio_viz_dom_pos_prop {#1}
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_a_fp
          + ( \l_semio_viz_dom_x_fp - \l_semio_viz_dom_a_fp ) * \l_semio_viz_dom_d_fp
        }
      ,
      \fp_eval:n
        {
          \l_semio_viz_dom_b_fp
          + ( \l_semio_viz_dom_y_fp - \l_semio_viz_dom_b_fp ) * \l_semio_viz_dom_d_fp
        }
    }
  \bool_if:NT \l_semio_viz_dom_annotate_bool {
    \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_c_fp \l_semio_viz_dom_d_fp
    \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
      { \l_semio_viz_dom_c_fp } { \l_semio_viz_dom_d_fp }
      {
        draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline ,
        dash~pattern = on~0.3mm~off~0.4mm
      }
  }
}

% 🔗 Draws the joint of every part that names one, in the chrome stroke.
\cs_new_protected:Npn \semio_viz_dom_eng_joints:n #1 {
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_eng_joint:nn {##1} {#1} }
}

% 🔗 One joint between a part and the part it names, drawn #2 millimetres wide.
\cs_new_protected:Npn \semio_viz_dom_eng_joint:nn #1#2 {
  \prop_get:NnN \l_semio_viz_dom_par_prop {#1} \l_semio_viz_dom_tmp_tl
  \tl_if_empty:NF \l_semio_viz_dom_tmp_tl {
    \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
    \semio_viz_dom_eng_at:VNN \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_c_fp \l_semio_viz_dom_d_fp
    \semio_viz_dom_edge:nnnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
      { \l_semio_viz_dom_c_fp } { \l_semio_viz_dom_d_fp } {#2}
  }
}
\cs_generate_variant:Nn \semio_viz_dom_eng_at:nNN { VNN , xNN }

% 🧱 The assembly: one body per part, its extent the size column, joined along the part list.
\cs_new_protected:Npn \semio_viz_dom_eng_bodies: {
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_eng_body:n {##1} }
}

% 🧱 One body.
\cs_new_protected:Npn \semio_viz_dom_eng_body:n #1 {
  \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \prop_get:NnN \l_semio_viz_dom_bag_prop {#1} \l_semio_viz_dom_cell_tl
  \semio_viz_dom_box:nnnnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    { \l_semio_viz_dom_cell_tl } { \l_semio_viz_dom_cell_tl * 0.7 }
    { \l_semio_viz_dom_k_int } { \prop_item:Nn \l_semio_viz_dom_lab_prop {#1} }
}

% ⚙️ The gear train: a pitch circle per toothed part with one tick per tooth, bodies elsewhere.
\cs_new_protected:Npn \semio_viz_dom_eng_gears: {
  \semio_viz_dom_eng_joints:n { 0.12 }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_eng_gear:n {##1} }
}

% ⚙️ One gear, or the plain body of a part that carries no teeth.
\cs_new_protected:Npn \semio_viz_dom_eng_gear:n #1 {
  \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \prop_get:NnN \l_semio_viz_dom_sum_prop {#1} \l_semio_viz_dom_tmp_tl
  \prop_get:NnN \l_semio_viz_dom_bag_prop {#1} \l_semio_viz_dom_cell_tl
  \int_compare:nNnTF { \l_semio_viz_dom_tmp_tl } > { 0 }
    {
      \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
        { \l_semio_viz_dom_cell_tl }
        {
          fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , fill~opacity = 0.16 ,
          draw = \semio_viz_palette:n { \l_semio_viz_dom_k_int } ,
          line~width = \semio@stroke@hairline
        }
      \int_step_inline:nn { \l_semio_viz_dom_tmp_tl } { \semio_viz_dom_eng_tooth:nn {##1} {#1} }
      \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
        { \l_semio_viz_dom_gamma_fp }
        { fill = semio-chrome-canvas , draw = semio-chrome-border-normal ,
          line~width = \semio@stroke@hairline }
    }
    {
      \semio_viz_dom_box:nnnnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
        { \l_semio_viz_dom_cell_tl } { \l_semio_viz_dom_cell_tl }
        { \l_semio_viz_dom_k_int } { \prop_item:Nn \l_semio_viz_dom_lab_prop {#1} }
    }
}

% ⚙️ Tooth #1 of gear #2 as a radial tick on the pitch circle.
\cs_new_protected:Npn \semio_viz_dom_eng_tooth:nn #1#2 {
  \prop_get:NnN \l_semio_viz_dom_sum_prop {#2} \l_semio_viz_dom_tmp_tl
  \prop_get:NnN \l_semio_viz_dom_bag_prop {#2} \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_a_fp
    { 360 * ( (#1) - 1 ) / \l_semio_viz_dom_tmp_tl }
  \semio_viz_g_line:nnnnn
    { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_cell_tl * cosd ( \l_semio_viz_dom_a_fp ) }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_cell_tl * sind ( \l_semio_viz_dom_a_fp ) }
    {
      \l_semio_viz_dom_x_fp
      + ( \l_semio_viz_dom_cell_tl + 0.6 ) * cosd ( \l_semio_viz_dom_a_fp )
    }
    {
      \l_semio_viz_dom_y_fp
      + ( \l_semio_viz_dom_cell_tl + 0.6 ) * sind ( \l_semio_viz_dom_a_fp )
    }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@hairline }
}

% 🦿 The kinematic skeleton: pin joints on the part positions, links as bars between them.
\cs_new_protected:Npn \semio_viz_dom_eng_kinematic: {
  \semio_viz_dom_eng_joints:n { 0.4 }
  \bool_if:NT \l_semio_viz_dom_grid_bool { \semio_viz_dom_eng_ground: }
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_eng_pin:n {##1} }
}

% 🦿 One pin joint.
\cs_new_protected:Npn \semio_viz_dom_eng_pin:n #1 {
  \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    { \l_semio_viz_dom_gamma_fp }
    {
      fill = semio-chrome-canvas , draw = semio-chrome-border-emphasized ,
      line~width = \semio@stroke@default
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp }
      { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_gamma_fp + 0.5 } { south }
      { \prop_item:Nn \l_semio_viz_dom_lab_prop {#1} }
  }
}

% ⛰️ The fixed member: a hatched footing under the first part of the list.
\cs_new_protected:Npn \semio_viz_dom_eng_ground: {
  \semio_viz_dom_eng_at:xNN { \seq_item:Nn \l_semio_viz_dom_keys_seq { 1 } }
    \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp - 4 } { \l_semio_viz_dom_y_fp - 2 }
    { \l_semio_viz_dom_x_fp + 4 } { \l_semio_viz_dom_y_fp - 2 }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@default }
  \int_step_inline:nn { \l_semio_viz_dom_iter_int } { \semio_viz_dom_eng_hatch:n {##1} }
}

% ⛰️ One hatch stroke of the footing.
\cs_new_protected:Npn \semio_viz_dom_eng_hatch:n #1 {
  \semio_viz_g_line:nnnnn
    {
      \l_semio_viz_dom_x_fp - 4
      + 8 * ( (#1) - 1 ) / max ( 1 , \l_semio_viz_dom_iter_int - 1 )
    }
    { \l_semio_viz_dom_y_fp - 2 }
    {
      \l_semio_viz_dom_x_fp - 5
      + 8 * ( (#1) - 1 ) / max ( 1 , \l_semio_viz_dom_iter_int - 1 )
    }
    { \l_semio_viz_dom_y_fp - 3.2 }
    { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline }
}

% 🔺 The truss: every part triangulated with its two successors, on pinned supports.
\cs_new_protected:Npn \semio_viz_dom_eng_truss: {
  \int_step_inline:nn { \l_semio_viz_dom_n_int - 1 } { \semio_viz_dom_eng_chord:nn {##1} { 1 } }
  \int_step_inline:nn { \l_semio_viz_dom_n_int - 2 } { \semio_viz_dom_eng_chord:nn {##1} { 2 } }
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_eng_pin:n {##1} }
  \semio_viz_dom_eng_support:n { 1 }
  \semio_viz_dom_eng_support:n { \l_semio_viz_dom_n_int }
}

% 🔺 The chord joining member #1 to the member #2 places further along the list.
\cs_new_protected:Npn \semio_viz_dom_eng_chord:nn #1#2 {
  \semio_viz_dom_eng_at:xNN
    { \seq_item:Nn \l_semio_viz_dom_keys_seq {#1} }
    \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \semio_viz_dom_eng_at:xNN
    { \seq_item:Nn \l_semio_viz_dom_keys_seq { (#1) + (#2) } }
    \l_semio_viz_dom_c_fp \l_semio_viz_dom_d_fp
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    { \l_semio_viz_dom_c_fp } { \l_semio_viz_dom_d_fp }
    {
      draw = \semio_viz_palette:n {#2} ,
      line~width = \fp_eval:n { 0.5 / (#2) } mm
    }
}

% 🔺 A pinned support triangle under member #1.
\cs_new_protected:Npn \semio_viz_dom_eng_support:n #1 {
  \semio_viz_dom_eng_at:xNN
    { \seq_item:Nn \l_semio_viz_dom_keys_seq {#1} }
    \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \semio_viz_g_polygon:xn
    {
      \fp_eval:n { \l_semio_viz_dom_x_fp } , \fp_eval:n { \l_semio_viz_dom_y_fp } ,
      \fp_eval:n { \l_semio_viz_dom_x_fp - 1.8 } , \fp_eval:n { \l_semio_viz_dom_y_fp - 2.6 } ,
      \fp_eval:n { \l_semio_viz_dom_x_fp + 1.8 } , \fp_eval:n { \l_semio_viz_dom_y_fp - 2.6 }
    }
    {
      fill = none , draw = semio-chrome-border-emphasized ,
      line~width = \semio@stroke@default
    }
}

% 🔩 The linkage: the joint chain closed into a loop, with a pin on every member.
\cs_new_protected:Npn \semio_viz_dom_eng_linkage: {
  \seq_clear:N \l_semio_viz_dom_path_seq
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_eng_vertex:n {##1} }
  \semio_viz_g_polygon:xn { \seq_use:Nn \l_semio_viz_dom_path_seq { , } }
    {
      fill = \semio_viz_palette:n { 1 } , fill~opacity = 0.10 ,
      draw = \semio_viz_palette:n { 1 } , line~width = \semio@stroke@default
    }
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_eng_pin:n {##1} }
}

% 🔩 Appends one member to the linkage loop.
\cs_new_protected:Npn \semio_viz_dom_eng_vertex:n #1 {
  \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \seq_put_right:Nx \l_semio_viz_dom_path_seq { \fp_eval:n { \l_semio_viz_dom_x_fp } }
  \seq_put_right:Nx \l_semio_viz_dom_path_seq { \fp_eval:n { \l_semio_viz_dom_y_fp } }
}

% 🛠️ The mechanism: gear bodies and link bars in one drawing, the two classes told apart by the
% class column rather than by a second option set.
\cs_new_protected:Npn \semio_viz_dom_eng_mechanism: {
  \semio_viz_dom_eng_joints:n { 0.5 }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_eng_member:n {##1} }
}

% 🛠️ One member, drawn as a disc when its class is a gear and as a bar otherwise.
\cs_new_protected:Npn \semio_viz_dom_eng_member:n #1 {
  \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \prop_get:NnN \l_semio_viz_dom_kid_prop {#1} \l_semio_viz_dom_tmp_tl
  \prop_get:NnN \l_semio_viz_dom_bag_prop {#1} \l_semio_viz_dom_cell_tl
  \str_if_eq:VnTF \l_semio_viz_dom_tmp_tl { gear }
    {
      \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
        { \l_semio_viz_dom_cell_tl }
        {
          fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , fill~opacity = 0.28 ,
          draw = \semio_viz_palette:n { \l_semio_viz_dom_k_int } ,
          line~width = \semio@stroke@default
        }
    }
    {
      \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_cell_tl }
        { \l_semio_viz_dom_y_fp - 0.7 } { \l_semio_viz_dom_cell_tl * 2 } { 1.4 }
        {
          fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , fill~opacity = 0.55 ,
          draw = none , rounded~corners = 0.7mm
        }
    }
  \semio_viz_dom_eng_pin:n {#1}
}

% ⚙️ engineering-diagram: taxonomy §36. One part table, seven schematics; each catalogue kind is a
% distinct `mode` with its own displacement, joint width and annotation set.
\SemioVizFamily { engineering-diagram } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-machine }
  \tl_set:Nn \l_semio_viz_dom_id_tl { id }
  \tl_set:Nn \l_semio_viz_dom_label_tl { label }
  \tl_set:Nn \l_semio_viz_dom_group_tl { kind }
  \tl_set:Nn \l_semio_viz_dom_x_tl { x }
  \tl_set:Nn \l_semio_viz_dom_y_tl { y }
  \tl_set:Nn \l_semio_viz_dom_value_tl { size }
  \tl_set:Nn \l_semio_viz_dom_second_tl { teeth }
  \tl_set:Nn \l_semio_viz_dom_edges_tl { link }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { assembly }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 0 }
  \fp_set:Nn \l_semio_viz_dom_beta_fp { 1 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 0.9 }
  \int_set:Nn \l_semio_viz_dom_iter_int { 7 }
  \keys_set:nn { semio / viz / family / engineering-diagram } {#1}
  \semio_viz_dom_frame:
  \semio_viz_dom_eng_load:
  \fp_compare:nNnT { \l_semio_viz_dom_alpha_fp } > { 0 } { \semio_viz_dom_eng_explode: }
  \str_case:VnF \l_semio_viz_dom_mode_tl
    {
      { gear } { \semio_viz_dom_eng_gears: }
      { kinematic } { \semio_viz_dom_eng_kinematic: }
      { linkage } { \semio_viz_dom_eng_linkage: }
      { mechanism } { \semio_viz_dom_eng_mechanism: }
      { truss } { \semio_viz_dom_eng_truss: }
    }
    { \semio_viz_dom_eng_joints:n { 0.14 } \semio_viz_dom_eng_bodies: }
}
%endregion 🔖️EngineeringDiagram

%region 🔖️Keys-optimization
% 🔑 `optimization` keys, l3keys family `semio / viz / family / optimization`. §40 states an
% operations-research problem five ways; each `mode` reads the columns its formulation needs and
% every other key parameterises the drawing of that formulation.
% variant  (tl)      catalogue slug, recorded by the registry
% data     (table)   tableau, activity list, arc list or schedule    default `demo-assignment`
% mode     (choice `assignment|critical-path|flow|transport|schedule`) default `assignment`
% row      (column)  agent, machine or arc source                    default `agent`
% column   (column)  task or arc target                              default `task`
% value    (column)  cost, flow or duration                          default `cost`
% capacity (column)  arc capacity                                    default `capacity`
% id       (column)  activity identity                               default `id`
% pred     (column)  the activity this one waits for                 default `pred`
% label    (column)  visible caption                                 default `label`
% start    (column)  start of a scheduled job                        default `start`
% gutter   (mm)      space reserved for the row and column captions  default 6
% node     (mm)      node radius or half height of a bar             default 1.6
% arrow    (mm)      arrow head length                               default 1.4
% values   (bool)    print the numeric cell value                    default false
% select   (bool)    mark the greedy optimum of every row            default false
% labels   (bool)    print captions                                  default true
\keys_define:nn { semio / viz / family / optimization } {
  data     .tl_set:N   = \l_semio_viz_dom_data_tl,
  mode     .tl_set:N   = \l_semio_viz_dom_mode_tl,
  row      .tl_set:N   = \l_semio_viz_dom_id_tl,
  column   .tl_set:N   = \l_semio_viz_dom_second_tl,
  value    .tl_set:N   = \l_semio_viz_dom_value_tl,
  capacity .tl_set:N   = \l_semio_viz_dom_edges_tl,
  id       .tl_set:N   = \l_semio_viz_dom_id_tl,
  pred     .tl_set:N   = \l_semio_viz_dom_group_tl,
  label    .tl_set:N   = \l_semio_viz_dom_label_tl,
  start    .tl_set:N   = \l_semio_viz_dom_x_tl,
  scheme   .tl_set:N   = \l_semio_viz_dom_scheme_tl,
  gutter   .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  node     .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  arrow    .fp_set:N   = \l_semio_viz_dom_beta_fp,
  pad      .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width    .fp_set:N   = \l_semio_viz_dom_width_fp,
  height   .fp_set:N   = \l_semio_viz_dom_height_fp,
  values   .bool_set:N = \l_semio_viz_dom_annotate_bool,
  select   .bool_set:N = \l_semio_viz_dom_highlight_bool,
  labels   .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown  .code:n     = { },
}
%endregion 🔖️Keys-optimization

%region 🔖️Optimization
% 🧮 The assignment tableau: one cell per agent-task pairing, its tint the cost, and the greedy
% optimum of every row ringed when the `select` key asks for it.
\cs_new_protected:Npn \semio_viz_dom_op_assignment: {
  \semio_viz_dom_mx_load:
  \seq_clear:N \l_semio_viz_dom_stack_seq
  \int_step_inline:nn { \l_semio_viz_dom_rows_int } { \semio_viz_dom_op_costrow:n {##1} }
  \bool_if:NT \l_semio_viz_dom_labels_bool { \semio_viz_dom_mx_captions: }
}

% 🧮 One tableau row plus its greedy pick.
\cs_new_protected:Npn \semio_viz_dom_op_costrow:n #1 {
  \int_zero:N \l_semio_viz_dom_j_int
  \fp_set:Nn \l_semio_viz_dom_c_fp { 1e9 }
  \int_step_inline:nn { \l_semio_viz_dom_cols_int } { \semio_viz_dom_op_cost:nn {#1} {##1} }
  \bool_lazy_and:nnT
    { \l_semio_viz_dom_highlight_bool }
    { \int_compare_p:nNn { \l_semio_viz_dom_j_int } > { 0 } }
    {
      \semio_viz_dom_mx_at:nn {#1} { \l_semio_viz_dom_j_int }
      \seq_put_right:Nx \l_semio_viz_dom_stack_seq { \int_use:N \l_semio_viz_dom_j_int }
      \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp + 0.3 } { \l_semio_viz_dom_y_fp + 0.3 }
        { \l_semio_viz_dom_w_fp - 0.6 } { \l_semio_viz_dom_h_fp - 0.6 }
        {
          fill = none , draw = \semio_viz_palette:n { 2 } ,
          line~width = \semio@stroke@focus
        }
    }
}

% 🧮 One tableau cell; it also keeps the cheapest still free column of the row.
\cs_new_protected:Npn \semio_viz_dom_op_cost:nn #1#2 {
  \semio_viz_dom_mx_get:nnN {#1} {#2} \l_semio_viz_dom_cell_tl
  \tl_if_empty:NF \l_semio_viz_dom_cell_tl {
    \semio_viz_dom_mx_at:nn {#1} {#2}
    \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp + 0.15 } { \l_semio_viz_dom_y_fp + 0.15 }
      { \l_semio_viz_dom_w_fp - 0.3 } { \l_semio_viz_dom_h_fp - 0.3 }
      {
        fill = \semio_viz_dom_ramp:n
          { 1 - \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } } ,
        draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline
      }
    \bool_if:NT \l_semio_viz_dom_annotate_bool {
      \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_w_fp / 2 }
        { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_h_fp / 2 } { center }
        { \tl_use:N \l_semio_viz_dom_cell_tl }
    }
    \fp_compare:nNnT { \l_semio_viz_dom_cell_tl } < { \l_semio_viz_dom_c_fp } {
      \seq_if_in:NnF \l_semio_viz_dom_stack_seq {#2} {
        \fp_set:Nn \l_semio_viz_dom_c_fp { \l_semio_viz_dom_cell_tl }
        \int_set:Nn \l_semio_viz_dom_j_int {#2}
      }
    }
  }
}

% 🕓 The activity network: earliest start and chain depth of every activity, then the node-link
% drawing with the longest chain to the last finish drawn as the critical path.
\cs_new_protected:Npn \semio_viz_dom_op_critical: {
  \prop_clear:N \l_semio_viz_dom_par_prop
  \prop_clear:N \l_semio_viz_dom_bag_prop
  \prop_clear:N \l_semio_viz_dom_dep_prop
  \prop_clear:N \l_semio_viz_dom_sum_prop
  \prop_clear:N \l_semio_viz_dom_lab_prop
  \prop_clear:N \l_semio_viz_dom_cur_prop
  \seq_clear:N \l_semio_viz_dom_keys_seq
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_op_activity:n {##1} }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_op_relax: }
  \semio_viz_dom_op_chain:
  \semio_viz_dom_op_lanes:
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_op_arc:n {##1} }
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_op_task:n {##1} }
}

% 🕓 One activity: its predecessor, its duration, its caption and the neutral start it begins with.
\cs_new_protected:Npn \semio_viz_dom_op_activity:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
    \l_semio_viz_dom_key_tl
  \seq_put_right:NV \l_semio_viz_dom_keys_seq \l_semio_viz_dom_key_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_group_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_par_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_bag_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_label_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_lab_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \prop_put:NVn \l_semio_viz_dom_sum_prop \l_semio_viz_dom_key_tl { 0 }
  \prop_put:NVn \l_semio_viz_dom_dep_prop \l_semio_viz_dom_key_tl { 1 }
}

% 🕓 One relaxation sweep of the earliest start and of the chain depth over every activity.
\cs_new_protected:Npn \semio_viz_dom_op_relax: {
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_op_ease:n {##1} }
}

% 🕓 Pushes one activity behind its predecessor.
\cs_new_protected:Npn \semio_viz_dom_op_ease:n #1 {
  \prop_get:NnN \l_semio_viz_dom_par_prop {#1} \l_semio_viz_dom_tmp_tl
  \tl_if_empty:NF \l_semio_viz_dom_tmp_tl {
    \prop_get:NVN \l_semio_viz_dom_sum_prop \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_key_tl
    \prop_get:NVN \l_semio_viz_dom_bag_prop \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_cell_tl
    \prop_put:Nnx \l_semio_viz_dom_sum_prop {#1}
      {
        \fp_eval:n
          {
            max ( \prop_item:Nn \l_semio_viz_dom_sum_prop {#1} ,
                  \l_semio_viz_dom_key_tl + \l_semio_viz_dom_cell_tl )
          }
      }
    \prop_get:NVN \l_semio_viz_dom_dep_prop \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_key_tl
    \prop_put:Nnx \l_semio_viz_dom_dep_prop {#1}
      {
        \fp_to_int:n
          {
            max ( \prop_item:Nn \l_semio_viz_dom_dep_prop {#1} ,
                  \l_semio_viz_dom_key_tl + 1 )
          }
      }
  }
}

% 🕓 Walks back from the latest finish and marks every activity of that chain as critical.
\cs_new_protected:Npn \semio_viz_dom_op_chain: {
  \fp_set:Nn \l_semio_viz_dom_hi_fp { -1e9 }
  \tl_clear:N \l_semio_viz_dom_tmp_tl
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_op_finish:n {##1} }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_op_back: }
}

% 🕓 Keeps the activity with the latest finish.
\cs_new_protected:Npn \semio_viz_dom_op_finish:n #1 {
  \fp_set:Nn \l_semio_viz_dom_c_fp
    {
      \prop_item:Nn \l_semio_viz_dom_sum_prop {#1}
      + \prop_item:Nn \l_semio_viz_dom_bag_prop {#1}
    }
  \fp_compare:nNnT { \l_semio_viz_dom_c_fp } > { \l_semio_viz_dom_hi_fp } {
    \fp_set_eq:NN \l_semio_viz_dom_hi_fp \l_semio_viz_dom_c_fp
    \tl_set:Nn \l_semio_viz_dom_tmp_tl {#1}
  }
}

% 🕓 One step back along the critical chain.
\cs_new_protected:Npn \semio_viz_dom_op_back: {
  \tl_if_empty:NF \l_semio_viz_dom_tmp_tl {
    \prop_put:NVn \l_semio_viz_dom_cur_prop \l_semio_viz_dom_tmp_tl { 1 }
    \prop_get:NVN \l_semio_viz_dom_par_prop \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_key_tl
    \tl_set_eq:NN \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_key_tl
  }
}

% 🕓 Assigns every activity a lane inside its depth column, and keeps the greatest depth and the
% greatest lane the network needs, so neither the column count nor the lane count is written down.
\cs_new_protected:Npn \semio_viz_dom_op_lanes: {
  \prop_clear:N \l_semio_viz_dom_off_prop
  \prop_clear:N \l_semio_viz_dom_kid_prop
  \int_set:Nn \l_semio_viz_dom_m_int { 1 }
  \int_set:Nn \l_semio_viz_dom_r_int { 1 }
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_op_lane:n {##1} }
}

% 🕓 One activity's lane, the greatest depth and the greatest lane seen so far.
\cs_new_protected:Npn \semio_viz_dom_op_lane:n #1 {
  \prop_get:NnN \l_semio_viz_dom_dep_prop {#1} \l_semio_viz_dom_cell_tl
  \prop_get:NVNF \l_semio_viz_dom_kid_prop \l_semio_viz_dom_cell_tl \l_semio_viz_dom_key_tl
    { \tl_set:Nn \l_semio_viz_dom_key_tl { 0 } }
  \prop_put:Nnx \l_semio_viz_dom_off_prop {#1}
    { \int_eval:n { \l_semio_viz_dom_key_tl + 1 } }
  \prop_put:NVx \l_semio_viz_dom_kid_prop \l_semio_viz_dom_cell_tl
    { \int_eval:n { \l_semio_viz_dom_key_tl + 1 } }
  \int_compare:nNnT { \l_semio_viz_dom_cell_tl } > { \l_semio_viz_dom_m_int }
    { \int_set:Nn \l_semio_viz_dom_m_int { \l_semio_viz_dom_cell_tl } }
  \int_compare:nNnT { \l_semio_viz_dom_key_tl + 1 } > { \l_semio_viz_dom_r_int }
    { \int_set:Nn \l_semio_viz_dom_r_int { \l_semio_viz_dom_key_tl + 1 } }
}

% 📍 Centre of activity #1 into the fp variables #2 and #3.
\cs_new_protected:Npn \semio_viz_dom_op_at:nNN #1#2#3 {
  \prop_get:NnN \l_semio_viz_dom_dep_prop {#1} \l_semio_viz_dom_cell_tl
  \prop_get:NnN \l_semio_viz_dom_off_prop {#1} \l_semio_viz_dom_key_tl
  \fp_set:Nn #2
    {
      \l_semio_viz_dom_xa_fp
      + ( \l_semio_viz_dom_cell_tl - 0.5 )
        * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
        / max ( 1 , \l_semio_viz_dom_m_int )
    }
  \fp_set:Nn #3
    {
      \l_semio_viz_dom_yb_fp
      - ( \l_semio_viz_dom_key_tl - 0.5 )
        * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
        / max ( 1 , \l_semio_viz_dom_r_int )
    }
}
\cs_generate_variant:Nn \semio_viz_dom_op_at:nNN { VNN }

% ➤ The arc from the predecessor of activity #1 into it.
\cs_new_protected:Npn \semio_viz_dom_op_arc:n #1 {
  \prop_get:NnN \l_semio_viz_dom_par_prop {#1} \l_semio_viz_dom_tmp_tl
  \tl_if_empty:NF \l_semio_viz_dom_tmp_tl {
    \semio_viz_dom_op_at:VNN \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_a_fp \l_semio_viz_dom_b_fp
    \semio_viz_dom_op_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
    \prop_if_in:NnTF \l_semio_viz_dom_cur_prop {#1}
      {
        \semio_viz_dom_arrow:nnnnnn { \l_semio_viz_dom_a_fp + \l_semio_viz_dom_alpha_fp * 2 }
          { \l_semio_viz_dom_b_fp } { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_alpha_fp * 2 }
          { \l_semio_viz_dom_y_fp } { \l_semio_viz_dom_beta_fp }
          { draw = \semio_viz_palette:n { 2 } , fill = \semio_viz_palette:n { 2 } ,
            line~width = \semio@stroke@focus }
      }
      {
        \semio_viz_dom_arrow:nnnnnn { \l_semio_viz_dom_a_fp + \l_semio_viz_dom_alpha_fp * 2 }
          { \l_semio_viz_dom_b_fp } { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_alpha_fp * 2 }
          { \l_semio_viz_dom_y_fp } { \l_semio_viz_dom_beta_fp }
          { draw = semio-chrome-border-normal , fill = semio-chrome-border-normal ,
            line~width = \semio@stroke@hairline }
      }
  }
}

% 🔲 One activity node; the critical ones carry the emphasis colour.
\cs_new_protected:Npn \semio_viz_dom_op_task:n #1 {
  \semio_viz_dom_op_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \prop_if_in:NnTF \l_semio_viz_dom_cur_prop {#1}
    { \int_set:Nn \l_semio_viz_dom_k_int { 2 } }
    { \int_set:Nn \l_semio_viz_dom_k_int { 1 } }
  \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_alpha_fp * 2 }
    { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_alpha_fp }
    { \l_semio_viz_dom_alpha_fp * 4 } { \l_semio_viz_dom_alpha_fp * 2 }
    {
      fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , fill~opacity = 0.22 ,
      draw = \semio_viz_palette:n { \l_semio_viz_dom_k_int } ,
      line~width = \semio@stroke@default , rounded~corners = 0.5mm
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp } { center }
      { \prop_item:Nn \l_semio_viz_dom_lab_prop {#1} }
  }
}

% 🚚 The bipartite arc list: sources on the left, sinks on the right. In `flow` mode every arc is
% a ribbon whose height is the capacity and whose filled core is the flow; in `transport` mode the
% nodes are discs sized by their total and the arcs are straight lines.
\cs_new_protected:Npn \semio_viz_dom_op_bipartite: {
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_id_tl
    \l_semio_viz_dom_rowlev_seq
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_second_tl
    \l_semio_viz_dom_collev_seq
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_op_link:n {##1} }
  \semio_viz_dom_op_side:nN { 1 } \l_semio_viz_dom_rowlev_seq
  \semio_viz_dom_op_side:nN { 2 } \l_semio_viz_dom_collev_seq
}

% 📍 Ordinate of member #1 of a side that holds #2 members.
\cs_new:Npn \semio_viz_dom_op_y:nn #1#2 {
  \fp_eval:n
    {
      \l_semio_viz_dom_yb_fp
      - ( (#1) - 0.5 ) * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp ) / max ( 1 , #2 )
    }
}

% 🚚 One arc between its two sides.
\cs_new_protected:Npn \semio_viz_dom_op_link:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_second_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_a_fp
    { \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_gamma_fp }
  \semio_viz_dom_index:NNV \l_semio_viz_dom_i_int \l_semio_viz_dom_rowlev_seq
    \l_semio_viz_dom_key_tl
  \semio_viz_dom_index:NNV \l_semio_viz_dom_j_int \l_semio_viz_dom_collev_seq
    \l_semio_viz_dom_tmp_tl
  \fp_set:Nn \l_semio_viz_dom_b_fp
    {
      \semio_viz_dom_op_y:nn { \l_semio_viz_dom_i_int }
        { \seq_count:N \l_semio_viz_dom_rowlev_seq }
    }
  \fp_set:Nn \l_semio_viz_dom_x_fp
    { \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_gamma_fp }
  \fp_set:Nn \l_semio_viz_dom_y_fp
    {
      \semio_viz_dom_op_y:nn { \l_semio_viz_dom_j_int }
        { \seq_count:N \l_semio_viz_dom_collev_seq }
    }
  \str_if_eq:VnTF \l_semio_viz_dom_mode_tl { flow }
    { \semio_viz_dom_op_ribbon:n {#1} }
    {
      \semio_viz_dom_edge:nnnnn { \l_semio_viz_dom_a_fp } { \l_semio_viz_dom_b_fp }
        { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
        { 0.1 + 0.7 * \l_semio_viz_dom_cell_tl / max ( 1e-9 , \l_semio_viz_dom_hi_fp ) }
    }
}

% 🎗️ One capacitated arc: a pale band of the capacity with the flow drawn solid inside it.
\cs_new_protected:Npn \semio_viz_dom_op_ribbon:n #1 {
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_edges_tl }
    \l_semio_viz_dom_tmp_tl
  \tl_if_empty:NT \l_semio_viz_dom_tmp_tl
    { \tl_set_eq:NN \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_cell_tl }
  \semio_viz_dom_op_band:nn { \l_semio_viz_dom_tmp_tl } { 0.16 }
  \semio_viz_dom_op_band:nn { \l_semio_viz_dom_cell_tl } { 0.68 }
  \bool_if:NT \l_semio_viz_dom_annotate_bool {
    \semio_viz_g_text:nnnn
      { ( \l_semio_viz_dom_a_fp + \l_semio_viz_dom_x_fp ) / 2 }
      { ( \l_semio_viz_dom_b_fp + \l_semio_viz_dom_y_fp ) / 2 } { center }
      { \tl_use:N \l_semio_viz_dom_cell_tl }
  }
}

% 🎗️ One band of thickness proportional to #1 drawn with opacity #2.
\cs_new_protected:Npn \semio_viz_dom_op_band:nn #1#2 {
  \fp_set:Nn \l_semio_viz_dom_d_fp
    {
      \l_semio_viz_dom_alpha_fp * 2 * (#1) / max ( 1e-9 , \l_semio_viz_dom_hi_fp )
    }
  \semio_viz_g_polygon:xn
    {
      \fp_eval:n { \l_semio_viz_dom_a_fp } ,
      \fp_eval:n { \l_semio_viz_dom_b_fp - \l_semio_viz_dom_d_fp } ,
      \fp_eval:n { \l_semio_viz_dom_x_fp } ,
      \fp_eval:n { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_d_fp } ,
      \fp_eval:n { \l_semio_viz_dom_x_fp } ,
      \fp_eval:n { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_d_fp } ,
      \fp_eval:n { \l_semio_viz_dom_a_fp } ,
      \fp_eval:n { \l_semio_viz_dom_b_fp + \l_semio_viz_dom_d_fp }
    }
    { fill = \semio_viz_palette:n { 1 } , fill~opacity = #2 , draw = none }
}

% 🚚 One side of the bipartite drawing: a bar per member in `flow` mode, a disc in `transport`.
\cs_new_protected:Npn \semio_viz_dom_op_side:nN #1#2 {
  \int_set:Nn \l_semio_viz_dom_m_int { \seq_count:N #2 }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn #2
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_op_terminal:nn {#1} {##1} }
}

% 🚚 One terminal of a side.
\cs_new_protected:Npn \semio_viz_dom_op_terminal:nn #1#2 {
  \int_compare:nNnTF {#1} = { 1 }
    {
      \fp_set:Nn \l_semio_viz_dom_x_fp
        { \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_gamma_fp }
      \semio_viz_dom_sum_where:VVVnN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
        \l_semio_viz_dom_id_tl {#2} \l_semio_viz_dom_c_fp
    }
    {
      \fp_set:Nn \l_semio_viz_dom_x_fp
        { \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_gamma_fp }
      \semio_viz_dom_sum_where:VVVnN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
        \l_semio_viz_dom_second_tl {#2} \l_semio_viz_dom_c_fp
    }
  \fp_set:Nn \l_semio_viz_dom_y_fp
    { \semio_viz_dom_op_y:nn { \l_semio_viz_dom_k_int } { \l_semio_viz_dom_m_int } }
  \str_if_eq:VnTF \l_semio_viz_dom_mode_tl { flow }
    {
      \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp - 0.8 }
        { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_alpha_fp * 2 } { 1.6 }
        { \l_semio_viz_dom_alpha_fp * 4 }
        { fill = \semio_viz_palette:n {#1} , draw = none }
    }
    {
      \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
        {
          \l_semio_viz_dom_alpha_fp
          * sqrt ( max ( 0.3 , \l_semio_viz_dom_c_fp / max ( 1e-9 , \l_semio_viz_dom_hi_fp ) ) )
        }
        { fill = \semio_viz_palette:n {#1} , fill~opacity = 0.8 , draw = none }
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \int_compare:nNnTF {#1} = { 1 }
      {
        \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp - 1.4 } { \l_semio_viz_dom_y_fp }
          { east } {#2}
      }
      {
        \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp + 1.4 } { \l_semio_viz_dom_y_fp }
          { west } {#2}
      }
  }
}

% 🗓️ The machine schedule: one lane per resource, one bar per job over the common time axis.
\cs_new_protected:Npn \semio_viz_dom_op_schedule: {
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_id_tl
    \l_semio_viz_dom_rowlev_seq
  \int_set:Nn \l_semio_viz_dom_rows_int { \seq_count:N \l_semio_viz_dom_rowlev_seq }
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \fp_zero:N \l_semio_viz_dom_lo_fp
  \fp_set:Nn \l_semio_viz_dom_hi_fp { 1e-9 }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_op_horizon:n {##1} }
  \fp_set:Nn \l_semio_viz_dom_h_fp
    {
      ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
      / max ( 1 , \l_semio_viz_dom_rows_int )
    }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_op_job:n {##1} }
  \bool_if:NT \l_semio_viz_dom_labels_bool { \semio_viz_dom_op_lanecaps: }
}

% 🗓️ Widens the time horizon by one job.
\cs_new_protected:Npn \semio_viz_dom_op_horizon:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_x_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_hi_fp
    {
      max ( \l_semio_viz_dom_hi_fp ,
            \l_semio_viz_dom_key_tl + \l_semio_viz_dom_cell_tl )
    }
}

% 🗓️ One job bar in its resource lane.
\cs_new_protected:Npn \semio_viz_dom_op_job:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_x_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \semio_viz_dom_index:NNV \l_semio_viz_dom_k_int \l_semio_viz_dom_rowlev_seq
    \l_semio_viz_dom_tmp_tl
  \fp_set:Nn \l_semio_viz_dom_y_fp
    { \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_k_int * \l_semio_viz_dom_h_fp }
  \fp_set:Nn \l_semio_viz_dom_x_fp
    {
      \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_gamma_fp
      + \l_semio_viz_dom_key_tl
        * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp - \l_semio_viz_dom_gamma_fp )
        / max ( 1e-9 , \l_semio_viz_dom_hi_fp )
    }
  \fp_set:Nn \l_semio_viz_dom_w_fp
    {
      \l_semio_viz_dom_cell_tl
      * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp - \l_semio_viz_dom_gamma_fp )
      / max ( 1e-9 , \l_semio_viz_dom_hi_fp )
    }
  \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_h_fp * 0.2 }
    { max ( 0.3 , \l_semio_viz_dom_w_fp ) } { \l_semio_viz_dom_h_fp * 0.6 }
    {
      fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , fill~opacity = 0.78 ,
      draw = none , rounded~corners = 0.4mm
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1}
      { \l_semio_viz_dom_label_tl } \l_semio_viz_dom_cell_tl
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp + 0.5 }
      { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_h_fp / 2 } { west }
      { \tl_use:N \l_semio_viz_dom_cell_tl }
  }
}

% 🏷️ The resource captions of the schedule lanes.
\cs_new_protected:Npn \semio_viz_dom_op_lanecaps: {
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_rowlev_seq {
    \int_incr:N \l_semio_viz_dom_k_int
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_gamma_fp - 0.6 }
      {
        \l_semio_viz_dom_yb_fp
        - ( \l_semio_viz_dom_k_int - 0.5 ) * \l_semio_viz_dom_h_fp
      }
      { east } {##1}
  }
}

% 🧮 optimization: taxonomy §40. The assignment tableau, the activity network with its critical
% path, the capacitated flow, the transportation network and the machine schedule.
\SemioVizFamily { optimization } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-assignment }
  \tl_set:Nn \l_semio_viz_dom_id_tl { agent }
  \tl_set:Nn \l_semio_viz_dom_second_tl { task }
  \tl_set:Nn \l_semio_viz_dom_value_tl { cost }
  \tl_set:Nn \l_semio_viz_dom_edges_tl { capacity }
  \tl_set:Nn \l_semio_viz_dom_group_tl { pred }
  \tl_set:Nn \l_semio_viz_dom_label_tl { label }
  \tl_set:Nn \l_semio_viz_dom_x_tl { start }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { assignment }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 1.6 }
  \fp_set:Nn \l_semio_viz_dom_beta_fp { 1.4 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 6 }
  \keys_set:nn { semio / viz / family / optimization } {#1}
  \semio_viz_dom_frame:
  \str_case:VnF \l_semio_viz_dom_mode_tl
    {
      { critical-path } { \semio_viz_dom_op_critical: }
      { flow } { \semio_viz_dom_op_bipartite: }
      { transport } { \semio_viz_dom_op_bipartite: }
      { schedule } { \semio_viz_dom_op_schedule: }
    }
    { \semio_viz_dom_op_assignment: }
}
%endregion 🔖️Optimization

%region 🔖️Keys-analytical
% 🔑 `analytical` keys, l3keys family `semio / viz / family / analytical`. §42's cause-effect
% analysis reads a flat cause list grouped by category and builds the spine, the bones and the
% twigs from it; nothing about the drawing is counted in advance.
% variant  (tl)     catalogue slug, recorded by the registry
% data     (table)  cause list                                     default `demo-causes`
% cause    (column) the cause itself                               default `cause`
% category (column) the bone the cause hangs on                    default `category`
% effect   (tl)     caption of the effect box; empty prints the bilingual default    default empty
% angle    (deg)    slope of a bone against the spine              default 34
% bone     (mm)     length of a bone                               default 14
% twig     (mm)     length of a cause twig                         default 4
% labels   (bool)   print bone and cause captions                  default true
\keys_define:nn { semio / viz / family / analytical } {
  data     .tl_set:N   = \l_semio_viz_dom_data_tl,
  cause    .tl_set:N   = \l_semio_viz_dom_label_tl,
  category .tl_set:N   = \l_semio_viz_dom_group_tl,
  effect   .tl_set:N   = \l_semio_viz_dom_id_tl,
  angle    .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  bone     .fp_set:N   = \l_semio_viz_dom_beta_fp,
  twig     .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  pad      .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width    .fp_set:N   = \l_semio_viz_dom_width_fp,
  height   .fp_set:N   = \l_semio_viz_dom_height_fp,
  labels   .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown  .code:n     = { },
}
%endregion 🔖️Keys-analytical

%region 🔖️Analytical
% 🐟 The spine, the effect box and one bone per category, the bones alternating above and below
% the spine so the drawing stays readable however many categories the data holds.
\cs_new_protected:Npn \semio_viz_dom_an_run: {
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_group_tl
    \l_semio_viz_dom_rowlev_seq
  \int_set:Nn \l_semio_viz_dom_m_int { \seq_count:N \l_semio_viz_dom_rowlev_seq }
  \fp_set:Nn \l_semio_viz_dom_c_fp
    { ( \l_semio_viz_dom_ya_fp + \l_semio_viz_dom_yb_fp ) / 2 }
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_xa_fp } { \l_semio_viz_dom_c_fp }
    { \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_beta_fp } { \l_semio_viz_dom_c_fp }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@focus }
  \semio_viz_dom_box:nnnnnn
    { \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_beta_fp / 2 } { \l_semio_viz_dom_c_fp }
    { \l_semio_viz_dom_beta_fp } { \l_semio_viz_dom_beta_fp / 2 } { 1 }
    { \semio_viz_dom_an_effect: }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_rowlev_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_an_bone:n {##1} }
}

% 🏷️ The effect caption: the `effect` key, or the bilingual default when it is empty.
\cs_new:Npn \semio_viz_dom_an_effect: {
  \tl_if_empty:NTF \l_semio_viz_dom_id_tl
    { \semio_viz_dom_lang:nn { Effect } { Wirkung } }
    { \tl_use:N \l_semio_viz_dom_id_tl }
}

% 🦴 One category bone plus every cause that hangs on it.
\cs_new_protected:Npn \semio_viz_dom_an_bone:n #1 {
  \int_if_odd:nTF { \l_semio_viz_dom_k_int }
    { \fp_set:Nn \l_semio_viz_dom_d_fp { 1 } }
    { \fp_set:Nn \l_semio_viz_dom_d_fp { -1 } }
  \fp_set:Nn \l_semio_viz_dom_a_fp
    {
      \l_semio_viz_dom_xa_fp
      + ceil ( \l_semio_viz_dom_k_int / 2 )
        * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp - \l_semio_viz_dom_beta_fp )
        / ( ceil ( \l_semio_viz_dom_m_int / 2 ) + 1 )
    }
  \fp_set:Nn \l_semio_viz_dom_x_fp
    { \l_semio_viz_dom_a_fp - \l_semio_viz_dom_beta_fp * cosd ( \l_semio_viz_dom_alpha_fp ) }
  \fp_set:Nn \l_semio_viz_dom_y_fp
    {
      \l_semio_viz_dom_c_fp
      + \l_semio_viz_dom_d_fp * \l_semio_viz_dom_beta_fp
        * sind ( \l_semio_viz_dom_alpha_fp )
    }
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_a_fp } { \l_semio_viz_dom_c_fp }
    { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    {
      draw = \semio_viz_palette:n { \l_semio_viz_dom_k_int } ,
      line~width = \semio@stroke@default
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp - 0.6 } { \l_semio_viz_dom_y_fp } { east }
      {#1}
  }
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \int_zero:N \l_semio_viz_dom_r_int
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_an_tally:nn {##1} {#1} }
  \int_zero:N \l_semio_viz_dom_p_int
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_an_cause:nn {##1} {#1} }
}

% 🔢 Counts row #1 when it belongs to category #2, so the twigs of a bone can be spread over the
% causes that bone actually carries instead of over a written-down number of slots.
\cs_new_protected:Npn \semio_viz_dom_an_tally:nn #1#2 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_group_tl }
    \l_semio_viz_dom_q_tl
  \str_if_eq:VnT \l_semio_viz_dom_q_tl {#2} { \int_incr:N \l_semio_viz_dom_r_int }
}

% 🪝 One cause twig, placed along its bone at the position its rank on that bone selects.
\cs_new_protected:Npn \semio_viz_dom_an_cause:nn #1#2 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_group_tl }
    \l_semio_viz_dom_q_tl
  \str_if_eq:VnT \l_semio_viz_dom_q_tl {#2} {
    \int_incr:N \l_semio_viz_dom_p_int
    \fp_set:Nn \l_semio_viz_dom_b_fp
      {
        0.3 + 0.55 * ( \l_semio_viz_dom_p_int - 1 )
        / max ( 1 , \l_semio_viz_dom_r_int - 1 )
      }
    \fp_set:Nn \l_semio_viz_dom_lo_b_fp
      {
        \l_semio_viz_dom_a_fp
        + \l_semio_viz_dom_b_fp * ( \l_semio_viz_dom_x_fp - \l_semio_viz_dom_a_fp )
      }
    \fp_set:Nn \l_semio_viz_dom_hi_b_fp
      {
        \l_semio_viz_dom_c_fp
        + \l_semio_viz_dom_b_fp * ( \l_semio_viz_dom_y_fp - \l_semio_viz_dom_c_fp )
      }
    \semio_viz_g_line:nnnnn { \l_semio_viz_dom_lo_b_fp } { \l_semio_viz_dom_hi_b_fp }
      { \l_semio_viz_dom_lo_b_fp - \l_semio_viz_dom_gamma_fp } { \l_semio_viz_dom_hi_b_fp }
      { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline }
    \bool_if:NT \l_semio_viz_dom_labels_bool {
      \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_label_tl }
        \l_semio_viz_dom_q_tl
      \semio_viz_g_text:nnnn
        { \l_semio_viz_dom_lo_b_fp - \l_semio_viz_dom_gamma_fp - 0.4 }
        { \l_semio_viz_dom_hi_b_fp } { east } { \tl_use:N \l_semio_viz_dom_q_tl }
    }
  }
}

% 🐟 analytical: taxonomy §42. The cause-effect diagram, built from the cause list alone.
\SemioVizFamily { analytical } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-causes }
  \tl_set:Nn \l_semio_viz_dom_label_tl { cause }
  \tl_set:Nn \l_semio_viz_dom_group_tl { category }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 34 }
  \fp_set:Nn \l_semio_viz_dom_beta_fp { 14 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 4 }
  \keys_set:nn { semio / viz / family / analytical } {#1}
  \semio_viz_dom_frame:
  \semio_viz_dom_an_run:
}
%endregion 🔖️Analytical

%region 🔖️Keys-notation
% 🔑 `notation` keys, l3keys family `semio / viz / family / notation`. §56 holds the three
% domain notations that are read rather than measured; each `mode` reads its own symbol table and
% draws the glyph vocabulary of that notation.
% variant (tl)     catalogue slug, recorded by the registry
% data    (table)  symbol table                                   default `demo-molecule`
% mode    (choice `molecule|circuit|staff`)                       default `molecule`
% id      (column) symbol identity                                default `id`
% label   (column) printed glyph name                             default `label`
% class   (column) component class of a circuit symbol            default `kind`
% x, y    (column) symbol position, or the staff step of a note   default `x`, `y`
% link    (column) the symbol this one connects to                default `bond`
% order   (column) bond order, or the length of a note            default `order`
% node    (mm)     glyph radius                                   default 1.4
% offset  (mm)     gap between the two rules of a double bond     default 0.5
% lines   (int)    rules of the staff                             default 5
% labels  (bool)   print glyph captions                           default true
\keys_define:nn { semio / viz / family / notation } {
  data    .tl_set:N   = \l_semio_viz_dom_data_tl,
  mode    .tl_set:N   = \l_semio_viz_dom_mode_tl,
  id      .tl_set:N   = \l_semio_viz_dom_id_tl,
  label   .tl_set:N   = \l_semio_viz_dom_label_tl,
  class   .tl_set:N   = \l_semio_viz_dom_group_tl,
  x       .tl_set:N   = \l_semio_viz_dom_x_tl,
  y       .tl_set:N   = \l_semio_viz_dom_y_tl,
  link    .tl_set:N   = \l_semio_viz_dom_edges_tl,
  order   .tl_set:N   = \l_semio_viz_dom_value_tl,
  node    .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  offset  .fp_set:N   = \l_semio_viz_dom_beta_fp,
  lines   .int_set:N  = \l_semio_viz_dom_rows_int,
  pad     .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width   .fp_set:N   = \l_semio_viz_dom_width_fp,
  height  .fp_set:N   = \l_semio_viz_dom_height_fp,
  labels  .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown .code:n     = { },
}
%endregion 🔖️Keys-notation

%region 🔖️Notation
% ⚗️ The skeletal formula: bonds first so the atom glyphs sit on top of them.
\cs_new_protected:Npn \semio_viz_dom_nt_molecule: {
  \semio_viz_dom_eng_load:
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_nt_bond:n {##1} }
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_nt_atom:n {##1} }
}

% ⚗️ One bond; a double bond is two rules offset perpendicular to the bond axis.
\cs_new_protected:Npn \semio_viz_dom_nt_bond:n #1 {
  \prop_get:NnN \l_semio_viz_dom_par_prop {#1} \l_semio_viz_dom_tmp_tl
  \tl_if_empty:NF \l_semio_viz_dom_tmp_tl {
    \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
    \semio_viz_dom_eng_at:VNN \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_c_fp \l_semio_viz_dom_d_fp
    \prop_get:NnN \l_semio_viz_dom_sum_prop {#1} \l_semio_viz_dom_q_tl
    \fp_set:Nn \l_semio_viz_dom_a_fp
      { \l_semio_viz_dom_d_fp - \l_semio_viz_dom_y_fp }
    \fp_set:Nn \l_semio_viz_dom_b_fp
      { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_c_fp }
    \fp_set:Nn \l_semio_viz_dom_e_fp
      { max ( 1e-6 , sqrt ( \l_semio_viz_dom_a_fp ^ 2 + \l_semio_viz_dom_b_fp ^ 2 ) ) }
    \int_step_inline:nn { \l_semio_viz_dom_q_tl } { \semio_viz_dom_nt_rule:nn {##1} { \l_semio_viz_dom_q_tl } }
  }
}

% ⚗️ Rule #1 of a bond of order #2.
\cs_new_protected:Npn \semio_viz_dom_nt_rule:nn #1#2 {
  \fp_set:Nn \l_semio_viz_dom_lo_b_fp
    {
      \l_semio_viz_dom_beta_fp * ( (#1) - ( (#2) + 1 ) / 2 )
      * \l_semio_viz_dom_a_fp / \l_semio_viz_dom_e_fp
    }
  \fp_set:Nn \l_semio_viz_dom_hi_b_fp
    {
      \l_semio_viz_dom_beta_fp * ( (#1) - ( (#2) + 1 ) / 2 )
      * \l_semio_viz_dom_b_fp / \l_semio_viz_dom_e_fp
    }
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_lo_b_fp }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_hi_b_fp }
    { \l_semio_viz_dom_c_fp + \l_semio_viz_dom_lo_b_fp }
    { \l_semio_viz_dom_d_fp + \l_semio_viz_dom_hi_b_fp }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@default }
}

% ⚗️ One atom glyph: a disc of canvas so the bonds stop at it, plus the element caption.
\cs_new_protected:Npn \semio_viz_dom_nt_atom:n #1 {
  \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    { \l_semio_viz_dom_alpha_fp }
    { fill = semio-chrome-canvas , draw = none }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp } { center }
      { \prop_item:Nn \l_semio_viz_dom_lab_prop {#1} }
  }
}

% ⚡ The mesh: orthogonal wires first, then one glyph per component class.
\cs_new_protected:Npn \semio_viz_dom_nt_circuit: {
  \semio_viz_dom_eng_load:
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_nt_wire:n {##1} }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_nt_component:n {##1} }
}

% ⚡ One orthogonal wire between a component and the component it names.
\cs_new_protected:Npn \semio_viz_dom_nt_wire:n #1 {
  \prop_get:NnN \l_semio_viz_dom_par_prop {#1} \l_semio_viz_dom_tmp_tl
  \tl_if_empty:NF \l_semio_viz_dom_tmp_tl {
    \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
    \semio_viz_dom_eng_at:VNN \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_c_fp \l_semio_viz_dom_d_fp
    \semio_viz_g_polyline:xn
      {
        \fp_eval:n { \l_semio_viz_dom_x_fp } , \fp_eval:n { \l_semio_viz_dom_y_fp } ,
        \fp_eval:n { \l_semio_viz_dom_c_fp } , \fp_eval:n { \l_semio_viz_dom_y_fp } ,
        \fp_eval:n { \l_semio_viz_dom_c_fp } , \fp_eval:n { \l_semio_viz_dom_d_fp }
      }
      { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline }
  }
}

% ⚡ One component glyph; the class column picks the vocabulary.
\cs_new_protected:Npn \semio_viz_dom_nt_component:n #1 {
  \semio_viz_dom_eng_at:nNN {#1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
  \prop_get:NnN \l_semio_viz_dom_kid_prop {#1} \l_semio_viz_dom_tmp_tl
  \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    { \l_semio_viz_dom_alpha_fp * 1.6 } { fill = semio-chrome-canvas , draw = none }
  \str_case:VnF \l_semio_viz_dom_tmp_tl
    {
      { resistor } { \semio_viz_dom_nt_zigzag: }
      { capacitor } { \semio_viz_dom_nt_plates: }
      { inductor } { \semio_viz_dom_nt_coil: }
      { diode } { \semio_viz_dom_nt_diode: }
    }
    { \semio_viz_dom_nt_source: }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp }
      { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_alpha_fp * 2 } { south }
      { \prop_item:Nn \l_semio_viz_dom_lab_prop {#1} }
  }
}

% ⚡ The resistor: a zigzag of as many peaks as the `lines` key asks for.
\cs_new_protected:Npn \semio_viz_dom_nt_zigzag: {
  \seq_clear:N \l_semio_viz_dom_path_seq
  \int_step_inline:nn { \l_semio_viz_dom_rows_int + 2 } { \semio_viz_dom_nt_peak:n {##1} }
  \semio_viz_g_polyline:xn { \seq_use:Nn \l_semio_viz_dom_path_seq { , } }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@default }
}

% ⚡ One vertex of the zigzag.
\cs_new_protected:Npn \semio_viz_dom_nt_peak:n #1 {
  \seq_put_right:Nx \l_semio_viz_dom_path_seq
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_x_fp - \l_semio_viz_dom_alpha_fp * 2
          + ( (#1) - 1 ) * \l_semio_viz_dom_alpha_fp * 4
            / ( \l_semio_viz_dom_rows_int + 1 )
        }
    }
  \seq_put_right:Nx \l_semio_viz_dom_path_seq
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_y_fp
          + \l_semio_viz_dom_alpha_fp
            * ( \int_if_odd:nTF {#1} { 1 } { -1 } )
            * ( \int_compare:nNnTF {#1} = { 1 } { 0 } { 1 } )
        }
    }
}

% ⚡ The capacitor: two plates across the wire.
\cs_new_protected:Npn \semio_viz_dom_nt_plates: {
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_beta_fp }
    { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_alpha_fp }
    { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_beta_fp }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_alpha_fp }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@focus }
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_beta_fp }
    { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_alpha_fp }
    { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_beta_fp }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_alpha_fp }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@focus }
}

% ⚡ The inductor: one half turn per staff rule.
\cs_new_protected:Npn \semio_viz_dom_nt_coil: {
  \int_step_inline:nn { \l_semio_viz_dom_rows_int - 1 } { \semio_viz_dom_nt_turn:n {##1} }
}

% ⚡ One half turn of the coil.
\cs_new_protected:Npn \semio_viz_dom_nt_turn:n #1 {
  \semio_viz_g_arc:nnnnnnn
    {
      \l_semio_viz_dom_x_fp - \l_semio_viz_dom_alpha_fp * 2
      + ( (#1) - 0.5 ) * \l_semio_viz_dom_alpha_fp * 4
        / ( \l_semio_viz_dom_rows_int - 1 )
    }
    { \l_semio_viz_dom_y_fp }
    {
      \l_semio_viz_dom_alpha_fp * 2 / ( \l_semio_viz_dom_rows_int - 1 ) - 0.05
    }
    { \l_semio_viz_dom_alpha_fp * 2 / ( \l_semio_viz_dom_rows_int - 1 ) }
    { -1.5707963 } { 1.5707963 }
    { draw = semio-chrome-border-emphasized , fill = semio-chrome-border-emphasized }
}

% ⚡ The diode: a triangle stopped by a bar.
\cs_new_protected:Npn \semio_viz_dom_nt_diode: {
  \semio_viz_g_polygon:xn
    {
      \fp_eval:n { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_alpha_fp } ,
      \fp_eval:n { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_alpha_fp } ,
      \fp_eval:n { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_alpha_fp } ,
      \fp_eval:n { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_alpha_fp } ,
      \fp_eval:n { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_alpha_fp } ,
      \fp_eval:n { \l_semio_viz_dom_y_fp }
    }
    { fill = semio-chrome-border-emphasized , draw = none }
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_alpha_fp }
    { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_alpha_fp }
    { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_alpha_fp }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_alpha_fp }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@focus }
}

% ⚡ The source: a ring across the wire.
\cs_new_protected:Npn \semio_viz_dom_nt_source: {
  \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    { \l_semio_viz_dom_alpha_fp * 1.4 }
    {
      fill = none , draw = semio-chrome-border-emphasized ,
      line~width = \semio@stroke@default
    }
}

% 🎼 The staff: the rules, then one note head per row with its stem.
\cs_new_protected:Npn \semio_viz_dom_nt_staff: {
  \fp_set:Nn \l_semio_viz_dom_h_fp
    {
      ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
      / ( \l_semio_viz_dom_rows_int + 3 )
    }
  \fp_set:Nn \l_semio_viz_dom_c_fp
    { ( \l_semio_viz_dom_ya_fp + \l_semio_viz_dom_yb_fp ) / 2 }
  \int_step_inline:nn { \l_semio_viz_dom_rows_int } { \semio_viz_dom_nt_rule_line:n {##1} }
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_nt_note:n {##1} }
}

% 🎼 One staff rule.
\cs_new_protected:Npn \semio_viz_dom_nt_rule_line:n #1 {
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_xa_fp }
    {
      \l_semio_viz_dom_c_fp
      + ( (#1) - ( \l_semio_viz_dom_rows_int + 1 ) / 2 ) * \l_semio_viz_dom_h_fp
    }
    { \l_semio_viz_dom_xb_fp }
    {
      \l_semio_viz_dom_c_fp
      + ( (#1) - ( \l_semio_viz_dom_rows_int + 1 ) / 2 ) * \l_semio_viz_dom_h_fp
    }
    { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline }
}

% 🎼 One note: its head on the staff step and its stem, filled when the note is short.
\cs_new_protected:Npn \semio_viz_dom_nt_note:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_x_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_y_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_q_tl
  \fp_set:Nn \l_semio_viz_dom_x_fp
    {
      \l_semio_viz_dom_xa_fp
      + ( \l_semio_viz_dom_key_tl - 0.5 )
        * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
        / max ( 1 , \l_semio_viz_dom_n_int )
    }
  \fp_set:Nn \l_semio_viz_dom_y_fp
    {
      \l_semio_viz_dom_c_fp
      + ( \l_semio_viz_dom_tmp_tl - \l_semio_viz_dom_rows_int ) * \l_semio_viz_dom_h_fp / 2
    }
  \fp_compare:nNnTF { \l_semio_viz_dom_q_tl } > { 1 }
    {
      \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
        { \l_semio_viz_dom_alpha_fp }
        {
          fill = semio-chrome-canvas , draw = semio-chrome-border-emphasized ,
          line~width = \semio@stroke@default
        }
    }
    {
      \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
        { \l_semio_viz_dom_alpha_fp }
        { fill = semio-chrome-border-emphasized , draw = none }
    }
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_alpha_fp }
    { \l_semio_viz_dom_y_fp } { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_alpha_fp }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_h_fp * 2 }
    { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@hairline }
}

% 🎵 notation: taxonomy §56. The three read notations — a skeletal formula, a circuit mesh and a
% staff — each with its own symbol table and its own glyph vocabulary.
\SemioVizFamily { notation } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-molecule }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { molecule }
  \tl_set:Nn \l_semio_viz_dom_id_tl { id }
  \tl_set:Nn \l_semio_viz_dom_label_tl { label }
  \tl_set:Nn \l_semio_viz_dom_group_tl { kind }
  \tl_set:Nn \l_semio_viz_dom_x_tl { x }
  \tl_set:Nn \l_semio_viz_dom_y_tl { y }
  \tl_set:Nn \l_semio_viz_dom_edges_tl { bond }
  \tl_set:Nn \l_semio_viz_dom_value_tl { order }
  \tl_set:Nn \l_semio_viz_dom_second_tl { order }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 1.4 }
  \fp_set:Nn \l_semio_viz_dom_beta_fp { 0.5 }
  \int_set:Nn \l_semio_viz_dom_rows_int { 5 }
  \keys_set:nn { semio / viz / family / notation } {#1}
  \semio_viz_dom_frame:
  \str_case:VnF \l_semio_viz_dom_mode_tl
    {
      { circuit } { \semio_viz_dom_nt_circuit: }
      { staff } { \semio_viz_dom_nt_staff: }
    }
    { \semio_viz_dom_nt_molecule: }
}
%endregion 🔖️Notation

%region 🔖️Ribbon
% 🎗️ The two-axis ribbon renderer shared by §59's shipment sankey and §61's alluvial plot: both
% read a source, a target and a quantity and stack the quantity on both axes, and they differ only
% in whether the axis is drawn as a node bar or as a plain rule.
\cs_new_protected:Npn \semio_viz_dom_rb_run: {
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_id_tl
    \l_semio_viz_dom_rowlev_seq
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_second_tl
    \l_semio_viz_dom_collev_seq
  \semio_viz_table_col_sum:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \fp_set:Nn \l_semio_viz_dom_e_fp
    {
      ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
      / max ( 1e-9 , \l_semio_viz_dom_hi_fp )
    }
  \prop_clear:N \l_semio_viz_dom_off_prop
  \fp_set:Nn \l_semio_viz_dom_f_fp
    { \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_gamma_fp }
  \fp_set:Nn \l_semio_viz_dom_g_fp
    { \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_gamma_fp }
  \semio_viz_dom_rb_axis:NnnN \l_semio_viz_dom_rowlev_seq { s } { 1 } \l_semio_viz_dom_id_tl
  \semio_viz_dom_rb_axis:NnnN \l_semio_viz_dom_collev_seq { t } { 2 } \l_semio_viz_dom_second_tl
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_rb_flow:n {##1} }
}

% 🎗️ One axis: the running top of every category, and its node bar or its axis rule.
\cs_new_protected:Npn \semio_viz_dom_rb_axis:NnnN #1#2#3#4 {
  \fp_set_eq:NN \l_semio_viz_dom_lo_b_fp \l_semio_viz_dom_yb_fp
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn #1
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_rb_stop:nnnN {##1} {#2} {#3} #4 }
}

% 🎗️ One category of an axis.
\cs_new_protected:Npn \semio_viz_dom_rb_stop:nnnN #1#2#3#4 {
  \semio_viz_dom_sum_where:VVVnN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl #4 {#1}
    \l_semio_viz_dom_c_fp
  \fp_set:Nn \l_semio_viz_dom_d_fp
    { \l_semio_viz_dom_c_fp * \l_semio_viz_dom_e_fp }
  \prop_put:Nnx \l_semio_viz_dom_off_prop { #2 / #1 }
    { \fp_eval:n { \l_semio_viz_dom_lo_b_fp } }
  \int_compare:nNnTF {#3} = { 1 }
    { \fp_set_eq:NN \l_semio_viz_dom_x_fp \l_semio_viz_dom_f_fp }
    { \fp_set_eq:NN \l_semio_viz_dom_x_fp \l_semio_viz_dom_g_fp }
  \bool_if:NTF \l_semio_viz_dom_fill_bool
    {
      \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_alpha_fp / 2 }
        { \l_semio_viz_dom_lo_b_fp - \l_semio_viz_dom_d_fp + 0.2 }
        { \l_semio_viz_dom_alpha_fp } { max ( 0.3 , \l_semio_viz_dom_d_fp - 0.4 ) }
        { fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , draw = none }
    }
    {
      \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp }
        { \l_semio_viz_dom_lo_b_fp } { \l_semio_viz_dom_x_fp }
        { \l_semio_viz_dom_lo_b_fp - \l_semio_viz_dom_d_fp }
        {
          draw = \semio_viz_palette:n { \l_semio_viz_dom_k_int } ,
          line~width = \semio@stroke@focus
        }
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \int_compare:nNnTF {#3} = { 1 }
      {
        \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_alpha_fp - 0.6 }
          { \l_semio_viz_dom_lo_b_fp - \l_semio_viz_dom_d_fp / 2 } { east } {#1}
      }
      {
        \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_alpha_fp + 0.6 }
          { \l_semio_viz_dom_lo_b_fp - \l_semio_viz_dom_d_fp / 2 } { west } {#1}
      }
  }
  \fp_sub:Nn \l_semio_viz_dom_lo_b_fp { \l_semio_viz_dom_d_fp }
}

% 🎗️ One ribbon between its two axis stops.
\cs_new_protected:Npn \semio_viz_dom_rb_flow:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_second_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_d_fp
    { \l_semio_viz_dom_cell_tl * \l_semio_viz_dom_e_fp }
  \tl_set:Nx \l_semio_viz_dom_q_tl { s / \l_semio_viz_dom_key_tl }
  \prop_get:NVN \l_semio_viz_dom_off_prop \l_semio_viz_dom_q_tl \l_semio_viz_dom_src_tl
  \fp_set:Nn \l_semio_viz_dom_a_fp { \l_semio_viz_dom_src_tl }
  \prop_put:NVx \l_semio_viz_dom_off_prop \l_semio_viz_dom_q_tl
    { \fp_eval:n { \l_semio_viz_dom_a_fp - \l_semio_viz_dom_d_fp } }
  \tl_set:Nx \l_semio_viz_dom_q_tl { t / \l_semio_viz_dom_tmp_tl }
  \prop_get:NVN \l_semio_viz_dom_off_prop \l_semio_viz_dom_q_tl \l_semio_viz_dom_tgt_tl
  \fp_set:Nn \l_semio_viz_dom_b_fp { \l_semio_viz_dom_tgt_tl }
  \prop_put:NVx \l_semio_viz_dom_off_prop \l_semio_viz_dom_q_tl
    { \fp_eval:n { \l_semio_viz_dom_b_fp - \l_semio_viz_dom_d_fp } }
  \semio_viz_dom_index:NNV \l_semio_viz_dom_k_int \l_semio_viz_dom_rowlev_seq
    \l_semio_viz_dom_key_tl
  \semio_viz_g_polygon:xn
    {
      \fp_eval:n { \l_semio_viz_dom_f_fp + \l_semio_viz_dom_alpha_fp / 2 } ,
      \fp_eval:n { \l_semio_viz_dom_a_fp } ,
      \fp_eval:n { \l_semio_viz_dom_g_fp - \l_semio_viz_dom_alpha_fp / 2 } ,
      \fp_eval:n { \l_semio_viz_dom_b_fp } ,
      \fp_eval:n { \l_semio_viz_dom_g_fp - \l_semio_viz_dom_alpha_fp / 2 } ,
      \fp_eval:n { \l_semio_viz_dom_b_fp - \l_semio_viz_dom_d_fp } ,
      \fp_eval:n { \l_semio_viz_dom_f_fp + \l_semio_viz_dom_alpha_fp / 2 } ,
      \fp_eval:n { \l_semio_viz_dom_a_fp - \l_semio_viz_dom_d_fp }
    }
    {
      fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , fill~opacity = 0.42 ,
      draw = none
    }
  \bool_if:NT \l_semio_viz_dom_annotate_bool {
    \semio_viz_g_text:nnnn { ( \l_semio_viz_dom_f_fp + \l_semio_viz_dom_g_fp ) / 2 }
      {
        ( \l_semio_viz_dom_a_fp + \l_semio_viz_dom_b_fp ) / 2 - \l_semio_viz_dom_d_fp / 2
      }
      { center } { \tl_use:N \l_semio_viz_dom_cell_tl }
  }
}
%endregion 🔖️Ribbon

%region 🔖️Tile
% 🔳 The tile reader shared by §34's range maps and §70's constituency maps: a table of integer
% grid places, mapped onto square cells that fill the frame.
\cs_new_protected:Npn \semio_viz_dom_tile_load: {
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_x_tl
    \l_semio_viz_dom_lo_b_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_x_tl
    \l_semio_viz_dom_hi_b_fp
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_y_tl
    \l_semio_viz_dom_f_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_y_tl
    \l_semio_viz_dom_g_fp
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \fp_set:Nn \l_semio_viz_dom_e_fp
    {
      min
        (
          ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
          / ( \l_semio_viz_dom_hi_b_fp - \l_semio_viz_dom_lo_b_fp + 1 ) ,
          ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
          / ( \l_semio_viz_dom_g_fp - \l_semio_viz_dom_f_fp + 1 )
        )
    }
}

% 📍 Centre of the tile at the grid place (#1,#2) into the working x and y.
\cs_new_protected:Npn \semio_viz_dom_tile_at:nn #1#2 {
  \fp_set:Nn \l_semio_viz_dom_x_fp
    {
      \l_semio_viz_dom_xa_fp
      + ( (#1) - \l_semio_viz_dom_lo_b_fp + 0.5 ) * \l_semio_viz_dom_e_fp
    }
  \fp_set:Nn \l_semio_viz_dom_y_fp
    {
      \l_semio_viz_dom_ya_fp
      + ( (#2) - \l_semio_viz_dom_f_fp + 0.5 ) * \l_semio_viz_dom_e_fp
    }
}
%endregion 🔖️Tile

%region 🔖️Keys-logistics
% 🔑 `logistics` keys, l3keys family `semio / viz / family / logistics`. §59 asks the same freight
% table twice: as an origin-destination tableau and as a flow between the two depot axes.
% variant     (tl)     catalogue slug, recorded by the registry
% data        (table)  shipment table                                default `demo-shipments`
% mode        (choice `matrix|sankey`)                               default `matrix`
% origin      (column) shipping depot                                default `origin`
% destination (column) receiving depot                               default `destination`
% value       (column) shipped quantity                              default `volume`
% scheme      (choice `sequential|diverging|cyclic`)                 default `sequential`
% gutter      (mm)     space reserved for the depot captions         default 8
% node        (mm)     width of an axis node bar                     default 2
% values      (bool)   print the shipped quantity                    default false
% labels      (bool)   print depot captions                          default true
\keys_define:nn { semio / viz / family / logistics } {
  data        .tl_set:N   = \l_semio_viz_dom_data_tl,
  mode        .tl_set:N   = \l_semio_viz_dom_mode_tl,
  origin      .tl_set:N   = \l_semio_viz_dom_id_tl,
  destination .tl_set:N   = \l_semio_viz_dom_second_tl,
  value       .tl_set:N   = \l_semio_viz_dom_value_tl,
  scheme      .tl_set:N   = \l_semio_viz_dom_scheme_tl,
  gutter      .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  node        .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  pad         .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width       .fp_set:N   = \l_semio_viz_dom_width_fp,
  height      .fp_set:N   = \l_semio_viz_dom_height_fp,
  values      .bool_set:N = \l_semio_viz_dom_annotate_bool,
  labels      .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown     .code:n     = { },
}
%endregion 🔖️Keys-logistics

%region 🔖️Logistics
% 🗺️ The origin-destination tableau: one tinted cell per depot pair.
\cs_new_protected:Npn \semio_viz_dom_lg_matrix: {
  \semio_viz_dom_mx_load:
  \int_step_inline:nn { \l_semio_viz_dom_rows_int } { \semio_viz_dom_lg_row:n {##1} }
  \bool_if:NT \l_semio_viz_dom_labels_bool { \semio_viz_dom_mx_captions: }
}

% 🗺️ One tableau row.
\cs_new_protected:Npn \semio_viz_dom_lg_row:n #1 {
  \int_step_inline:nn { \l_semio_viz_dom_cols_int } { \semio_viz_dom_lg_cell:nn {#1} {##1} }
}

% 🗺️ One tableau cell.
\cs_new_protected:Npn \semio_viz_dom_lg_cell:nn #1#2 {
  \semio_viz_dom_mx_get:nnN {#1} {#2} \l_semio_viz_dom_cell_tl
  \tl_if_empty:NF \l_semio_viz_dom_cell_tl {
    \semio_viz_dom_mx_at:nn {#1} {#2}
    \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp + 0.2 } { \l_semio_viz_dom_y_fp + 0.2 }
      { \l_semio_viz_dom_w_fp - 0.4 } { \l_semio_viz_dom_h_fp - 0.4 }
      {
        fill = \semio_viz_dom_ramp:n
          { \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } } ,
        draw = none
      }
    \bool_if:NT \l_semio_viz_dom_annotate_bool {
      \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_w_fp / 2 }
        { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_h_fp / 2 } { center }
        { \tl_use:N \l_semio_viz_dom_cell_tl }
    }
  }
}

% 🚛 logistics: taxonomy §59. The origin-destination tableau and the shipment sankey, one freight
% table read two ways.
\SemioVizFamily { logistics } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-shipments }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { matrix }
  \tl_set:Nn \l_semio_viz_dom_id_tl { origin }
  \tl_set:Nn \l_semio_viz_dom_second_tl { destination }
  \tl_set:Nn \l_semio_viz_dom_value_tl { volume }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 2 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 8 }
  \bool_set_true:N \l_semio_viz_dom_fill_bool
  \keys_set:nn { semio / viz / family / logistics } {#1}
  \semio_viz_dom_frame:
  \str_if_eq:VnTF \l_semio_viz_dom_mode_tl { sankey }
    { \semio_viz_dom_rb_run: }
    { \semio_viz_dom_lg_matrix: }
}
%endregion 🔖️Logistics

%region 🔖️Keys-niche
% 🔑 `niche` keys, l3keys family `semio / viz / family / niche`. §61 collects the four shapes that
% belong to no larger family of their own; each `mode` reads its own table.
% variant (tl)     catalogue slug, recorded by the registry
% data    (table)  category flow, part list, stratified tree or series  default `demo-survey`
% mode    (choice `alluvial|coxcomb|icicle|spiral`)                     default `alluvial`
% source  (column) left category, part name, node identity or step      default `question`
% target  (column) right category                                       default `group`
% value   (column) the quantity                                         default `value`
% parent  (column) parent node of the stratified tree                   default `parent`
% label   (column) visible caption                                      default `label`
% scheme  (choice `sequential|diverging|cyclic`)                        default `sequential`
% node    (mm)     axis node width, or the radial band of a spiral cell default 2
% turns   (number) turns of the spiral                                  default 2.5
% gutter  (mm)     space reserved for the captions                      default 8
% values  (bool)   print the numeric quantity                           default false
% labels  (bool)   print captions                                       default true
\keys_define:nn { semio / viz / family / niche } {
  data    .tl_set:N   = \l_semio_viz_dom_data_tl,
  mode    .tl_set:N   = \l_semio_viz_dom_mode_tl,
  source  .tl_set:N   = \l_semio_viz_dom_id_tl,
  target  .tl_set:N   = \l_semio_viz_dom_second_tl,
  value   .tl_set:N   = \l_semio_viz_dom_value_tl,
  parent  .tl_set:N   = \l_semio_viz_dom_group_tl,
  label   .tl_set:N   = \l_semio_viz_dom_label_tl,
  scheme  .tl_set:N   = \l_semio_viz_dom_scheme_tl,
  node    .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  turns   .fp_set:N   = \l_semio_viz_dom_beta_fp,
  gutter  .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  pad     .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width   .fp_set:N   = \l_semio_viz_dom_width_fp,
  height  .fp_set:N   = \l_semio_viz_dom_height_fp,
  values  .bool_set:N = \l_semio_viz_dom_annotate_bool,
  labels  .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown .code:n     = { },
}
%endregion 🔖️Keys-niche

%region 🔖️Niche
% 🌹 The polar area chart: equal angular sectors whose radius carries the square root of the
% quantity, so the sector area stays proportional to it.
\cs_new_protected:Npn \semio_viz_dom_ni_coxcomb: {
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \fp_set:Nn \l_semio_viz_dom_e_fp
    {
      min ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ,
            \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp ) / 2
    }
  \fp_set:Nn \l_semio_viz_dom_f_fp
    { ( \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_xb_fp ) / 2 }
  \fp_set:Nn \l_semio_viz_dom_g_fp
    { ( \l_semio_viz_dom_ya_fp + \l_semio_viz_dom_yb_fp ) / 2 }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_ni_petal:n {##1} }
}

% 🌹 One petal.
\cs_new_protected:Npn \semio_viz_dom_ni_petal:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \semio_viz_g_arc:nnnnnnn { \l_semio_viz_dom_f_fp } { \l_semio_viz_dom_g_fp }
    { \l_semio_viz_dom_alpha_fp }
    {
      \l_semio_viz_dom_alpha_fp
      + ( \l_semio_viz_dom_e_fp - \l_semio_viz_dom_alpha_fp )
        * sqrt ( max ( 0 , \l_semio_viz_dom_cell_tl ) / max ( 1e-9 , \l_semio_viz_dom_hi_fp ) )
    }
    { 6.2831853 * ( (#1) - 1 ) / \l_semio_viz_dom_n_int }
    { 6.2831853 * (#1) / \l_semio_viz_dom_n_int - 0.02 }
    {
      fill = \semio_viz_palette:n {#1} , fill~opacity = 0.72 ,
      draw = semio-chrome-canvas , line~width = \semio@stroke@hairline
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1}
      { \l_semio_viz_dom_id_tl } \l_semio_viz_dom_q_tl
    \semio_viz_g_text:nnnn
      {
        \l_semio_viz_dom_f_fp
        + ( \l_semio_viz_dom_e_fp + 1.4 )
          * cos ( 6.2831853 * ( (#1) - 0.5 ) / \l_semio_viz_dom_n_int )
      }
      {
        \l_semio_viz_dom_g_fp
        + ( \l_semio_viz_dom_e_fp + 1.4 )
          * sin ( 6.2831853 * ( (#1) - 0.5 ) / \l_semio_viz_dom_n_int )
      }
      { center } { \tl_use:N \l_semio_viz_dom_q_tl }
  }
}

% 🧊 The icicle: the partition laid out along the abscissa, one column per depth, so the reading
% direction is the opposite of §62's flame shapes.
\cs_new_protected:Npn \semio_viz_dom_ni_icicle: {
  \semio_viz_dom_tree_load:
  \semio_viz_dom_tree_offsets:
  \fp_set:Nn \l_semio_viz_dom_w_fp
    {
      ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
      / max ( 1 , \l_semio_viz_dom_rows_int )
    }
  \fp_set:Nn \l_semio_viz_dom_h_fp
    {
      ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
      / max ( 1e-9 , \l_semio_viz_dom_hi_fp )
    }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_ni_shard:n {##1} }
}

% 🧊 One icicle shard.
\cs_new_protected:Npn \semio_viz_dom_ni_shard:n #1 {
  \prop_get:NnN \l_semio_viz_dom_dep_prop {#1} \l_semio_viz_dom_cell_tl
  \prop_get:NnN \l_semio_viz_dom_off_prop {#1} \l_semio_viz_dom_key_tl
  \prop_get:NnN \l_semio_viz_dom_sum_prop {#1} \l_semio_viz_dom_tmp_tl
  \semio_viz_g_rect:nnnnn
    {
      \l_semio_viz_dom_xa_fp
      + ( \l_semio_viz_dom_cell_tl - 1 ) * \l_semio_viz_dom_w_fp + 0.2
    }
    {
      \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_key_tl * \l_semio_viz_dom_h_fp
      - \l_semio_viz_dom_tmp_tl * \l_semio_viz_dom_h_fp + 0.15
    }
    { \l_semio_viz_dom_w_fp - 0.4 }
    { max ( 0.2 , \l_semio_viz_dom_tmp_tl * \l_semio_viz_dom_h_fp - 0.3 ) }
    {
      fill = \semio_viz_palette:n { \l_semio_viz_dom_cell_tl } , fill~opacity = 0.68 ,
      draw = semio-chrome-canvas , line~width = \semio@stroke@hairline
    }
}

% 🌀 The spiral heat map: one cell per sample laid along an Archimedean spiral, its tint the value.
\cs_new_protected:Npn \semio_viz_dom_ni_spiral: {
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \fp_set:Nn \l_semio_viz_dom_e_fp
    {
      min ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ,
            \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp ) / 2
    }
  \fp_set:Nn \l_semio_viz_dom_f_fp
    { ( \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_xb_fp ) / 2 }
  \fp_set:Nn \l_semio_viz_dom_g_fp
    { ( \l_semio_viz_dom_ya_fp + \l_semio_viz_dom_yb_fp ) / 2 }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_ni_turn_cell:n {##1} }
}

% 🌀 One spiral cell, an annular sector at the angle and radius its rank selects.
\cs_new_protected:Npn \semio_viz_dom_ni_turn_cell:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_c_fp
    {
      \l_semio_viz_dom_alpha_fp
      + ( \l_semio_viz_dom_e_fp - \l_semio_viz_dom_alpha_fp * 2 )
        * ( (#1) - 1 ) / max ( 1 , \l_semio_viz_dom_n_int - 1 )
    }
  \semio_viz_g_arc:nnnnnnn { \l_semio_viz_dom_f_fp } { \l_semio_viz_dom_g_fp }
    { \l_semio_viz_dom_c_fp }
    { \l_semio_viz_dom_c_fp + \l_semio_viz_dom_alpha_fp }
    {
      6.2831853 * \l_semio_viz_dom_beta_fp * ( (#1) - 1 )
      / max ( 1 , \l_semio_viz_dom_n_int )
    }
    {
      6.2831853 * \l_semio_viz_dom_beta_fp * (#1) / max ( 1 , \l_semio_viz_dom_n_int )
    }
    {
      fill = \semio_viz_dom_ramp:n { \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } } ,
      draw = none
    }
}

% 🎭 niche: taxonomy §61. The alluvial plot, the polar area chart, the icicle and the spiral heat
% map, four shapes that share no larger family.
\SemioVizFamily { niche } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-survey }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { alluvial }
  \tl_set:Nn \l_semio_viz_dom_id_tl { question }
  \tl_set:Nn \l_semio_viz_dom_second_tl { group }
  \tl_set:Nn \l_semio_viz_dom_value_tl { value }
  \tl_set:Nn \l_semio_viz_dom_group_tl { parent }
  \tl_set:Nn \l_semio_viz_dom_label_tl { label }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 2 }
  \fp_set:Nn \l_semio_viz_dom_beta_fp { 2.5 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 8 }
  \bool_set_false:N \l_semio_viz_dom_fill_bool
  \keys_set:nn { semio / viz / family / niche } {#1}
  \semio_viz_dom_frame:
  \str_case:VnF \l_semio_viz_dom_mode_tl
    {
      { coxcomb } { \semio_viz_dom_ni_coxcomb: }
      { icicle } { \semio_viz_dom_ni_icicle: }
      { spiral } { \semio_viz_dom_ni_spiral: }
    }
    { \semio_viz_dom_rb_run: }
}
%endregion 🔖️Niche

%region 🔖️Keys-monitoring
% 🔑 `monitoring` keys, l3keys family `semio / viz / family / monitoring`. §65 looks at one running
% system four ways: as a layered dependency, as a latency grid, as a call graph and as a topology.
% variant (tl)     catalogue slug, recorded by the registry
% data    (table)  service inventory, or the latency grid              default `demo-services`
% edges   (table)  call table                                          default `demo-services-edges`
% mode    (choice `layered|heat|graph|rings`)                          default `layered`
% id      (column) service identity, or the row of the latency grid    default `id`
% column  (column) the column of the latency grid                      default `bucket`
% label   (column) service caption                                     default `label`
% tier    (column) the layer the service belongs to                    default `tier`
% value   (column) response time                                       default `latency`
% errors  (column) error rate driving the node tint                    default `errors`
% source  (column) calling service                                     default `source`
% target  (column) called service                                      default `target`
% weight  (column) call volume                                         default `calls`
% scheme  (choice `sequential|diverging|cyclic`)                       default `sequential`
% node    (mm)     node radius                                         default 1.6
% arrow   (mm)     arrow head length, zero for plain connectors        default 0
% gutter  (mm)     space reserved for the captions                     default 8
% labels  (bool)   print captions                                      default true
\keys_define:nn { semio / viz / family / monitoring } {
  data    .tl_set:N   = \l_semio_viz_dom_data_tl,
  edges   .tl_set:N   = \l_semio_viz_dom_edges_tl,
  mode    .tl_set:N   = \l_semio_viz_dom_mode_tl,
  id      .tl_set:N   = \l_semio_viz_dom_id_tl,
  column  .tl_set:N   = \l_semio_viz_dom_second_tl,
  label   .tl_set:N   = \l_semio_viz_dom_label_tl,
  tier    .tl_set:N   = \l_semio_viz_dom_group_tl,
  value   .tl_set:N   = \l_semio_viz_dom_value_tl,
  errors  .tl_set:N   = \l_semio_viz_dom_x_tl,
  source  .tl_set:N   = \l_semio_viz_dom_src_tl,
  target  .tl_set:N   = \l_semio_viz_dom_tgt_tl,
  weight  .tl_set:N   = \l_semio_viz_dom_wgt_tl,
  scheme  .tl_set:N   = \l_semio_viz_dom_scheme_tl,
  node    .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  arrow   .fp_set:N   = \l_semio_viz_dom_beta_fp,
  gutter  .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  pad     .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width   .fp_set:N   = \l_semio_viz_dom_width_fp,
  height  .fp_set:N   = \l_semio_viz_dom_height_fp,
  labels  .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown .code:n     = { },
}
%endregion 🔖️Keys-monitoring

%region 🔖️Monitoring
% 📡 Reads the service inventory: identity, tier, response time and error rate of every service,
% and places it in the geometry the active mode asks for.
\cs_new_protected:Npn \semio_viz_dom_mo_load: {
  \prop_clear:N \l_semio_viz_dom_pos_prop
  \prop_clear:N \l_semio_viz_dom_bag_prop
  \prop_clear:N \l_semio_viz_dom_dep_prop
  \prop_clear:N \l_semio_viz_dom_lab_prop
  \prop_clear:N \l_semio_viz_dom_kid_prop
  \seq_clear:N \l_semio_viz_dom_keys_seq
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_x_tl
    \l_semio_viz_dom_f_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_x_tl
    \l_semio_viz_dom_g_fp
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_group_tl
    \l_semio_viz_dom_rowlev_seq
  \int_set:Nn \l_semio_viz_dom_m_int { \seq_count:N \l_semio_viz_dom_rowlev_seq }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_mo_service:n {##1} }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_mo_place:n {##1} }
}

% 📡 One service of the inventory.
\cs_new_protected:Npn \semio_viz_dom_mo_service:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
    \l_semio_viz_dom_key_tl
  \seq_put_right:NV \l_semio_viz_dom_keys_seq \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_group_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_dep_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_bag_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_x_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_kid_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_label_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_lab_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
}

% 📡 The place of one service: a column in `layered`, a ring seat in `graph`, a tier circle in
% `rings`.
\cs_new_protected:Npn \semio_viz_dom_mo_place:n #1 {
  \prop_get:NnN \l_semio_viz_dom_dep_prop {#1} \l_semio_viz_dom_cell_tl
  \semio_viz_dom_index:NNV \l_semio_viz_dom_i_int \l_semio_viz_dom_rowlev_seq
    \l_semio_viz_dom_cell_tl
  \str_case:VnF \l_semio_viz_dom_mode_tl
    {
      { layered }
        {
          \fp_set:Nn \l_semio_viz_dom_x_fp
            {
              \l_semio_viz_dom_xa_fp
              + ( \l_semio_viz_dom_i_int - 0.5 )
                * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
                / max ( 1 , \l_semio_viz_dom_m_int )
            }
          \fp_set:Nn \l_semio_viz_dom_y_fp
            {
              \l_semio_viz_dom_yb_fp
              - ( \l_semio_viz_dom_k_int - 0.5 )
                * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
                / max ( 1 , \l_semio_viz_dom_n_int )
            }
        }
      { rings }
        {
          \fp_set:Nn \l_semio_viz_dom_c_fp
            {
              \l_semio_viz_dom_i_int
              * min ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ,
                      \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
                / ( 2 * ( \l_semio_viz_dom_m_int + 1 ) )
            }
          \semio_viz_dom_mo_polar:n
            {
              6.2831853 * ( \l_semio_viz_dom_k_int - 1 )
              / max ( 1 , \l_semio_viz_dom_n_int )
            }
        }
    }
    {
      \fp_set:Nn \l_semio_viz_dom_c_fp
        {
          min ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ,
                \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp ) / 2 - 2
        }
      \semio_viz_dom_mo_polar:n
        {
          6.2831853 * ( \l_semio_viz_dom_k_int - 1 ) / max ( 1 , \l_semio_viz_dom_n_int )
        }
    }
  \prop_put:Nnx \l_semio_viz_dom_pos_prop {#1}
    { \fp_eval:n { \l_semio_viz_dom_x_fp } , \fp_eval:n { \l_semio_viz_dom_y_fp } }
}

% 📍 Places the working point at the angle #1 on the current radius, about the frame centre.
\cs_new_protected:Npn \semio_viz_dom_mo_polar:n #1 {
  \fp_set:Nn \l_semio_viz_dom_x_fp
    {
      ( \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_xb_fp ) / 2
      + \l_semio_viz_dom_c_fp * cos (#1)
    }
  \fp_set:Nn \l_semio_viz_dom_y_fp
    {
      ( \l_semio_viz_dom_ya_fp + \l_semio_viz_dom_yb_fp ) / 2
      + \l_semio_viz_dom_c_fp * sin (#1)
    }
}

% 🔗 Every call of the edge table, drawn between the places of its two services.
\cs_new_protected:Npn \semio_viz_dom_mo_calls: {
  \semio_viz_table_nrows:VN \l_semio_viz_dom_edges_tl \l_semio_viz_dom_p_int
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_edges_tl \l_semio_viz_dom_wgt_tl
    \l_semio_viz_dom_hi_b_fp
  \int_step_inline:nn { \l_semio_viz_dom_p_int } { \semio_viz_dom_mo_call:n {##1} }
}

% 🔗 One call.
\cs_new_protected:Npn \semio_viz_dom_mo_call:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_edges_tl } {#1} { \l_semio_viz_dom_src_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_edges_tl } {#1} { \l_semio_viz_dom_tgt_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_edges_tl } {#1} { \l_semio_viz_dom_wgt_tl }
    \l_semio_viz_dom_cell_tl
  \prop_get:NVNT \l_semio_viz_dom_pos_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_q_tl {
    \seq_set_split:NnV \l_semio_viz_dom_aux_seq { , } \l_semio_viz_dom_q_tl
    \fp_set:Nn \l_semio_viz_dom_a_fp { \seq_item:Nn \l_semio_viz_dom_aux_seq { 1 } }
    \fp_set:Nn \l_semio_viz_dom_b_fp { \seq_item:Nn \l_semio_viz_dom_aux_seq { 2 } }
    \prop_get:NVNT \l_semio_viz_dom_pos_prop \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_q_tl {
      \seq_set_split:NnV \l_semio_viz_dom_aux_seq { , } \l_semio_viz_dom_q_tl
      \fp_set:Nn \l_semio_viz_dom_x_fp { \seq_item:Nn \l_semio_viz_dom_aux_seq { 1 } }
      \fp_set:Nn \l_semio_viz_dom_y_fp { \seq_item:Nn \l_semio_viz_dom_aux_seq { 2 } }
      \fp_compare:nNnTF { \l_semio_viz_dom_beta_fp } > { 0 }
        {
          \semio_viz_dom_arrow:nnnnnn { \l_semio_viz_dom_a_fp } { \l_semio_viz_dom_b_fp }
            { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp } { \l_semio_viz_dom_beta_fp }
            {
              draw = semio-chrome-border-normal , fill = semio-chrome-border-normal ,
              line~width = \semio@stroke@hairline
            }
        }
        {
          \semio_viz_dom_edge:nnnnn { \l_semio_viz_dom_a_fp } { \l_semio_viz_dom_b_fp }
            { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
            {
              0.08 + 0.5 * \l_semio_viz_dom_cell_tl
              / max ( 1e-9 , \l_semio_viz_dom_hi_b_fp )
            }
        }
    }
  }
}

% ⚪ Every service node: its radius the response time, its tint the error rate.
\cs_new_protected:Npn \semio_viz_dom_mo_nodes: {
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_mo_node:n {##1} }
}

% ⚪ One service node.
\cs_new_protected:Npn \semio_viz_dom_mo_node:n #1 {
  \prop_get:NnN \l_semio_viz_dom_pos_prop {#1} \l_semio_viz_dom_q_tl
  \seq_set_split:NnV \l_semio_viz_dom_aux_seq { , } \l_semio_viz_dom_q_tl
  \fp_set:Nn \l_semio_viz_dom_x_fp { \seq_item:Nn \l_semio_viz_dom_aux_seq { 1 } }
  \fp_set:Nn \l_semio_viz_dom_y_fp { \seq_item:Nn \l_semio_viz_dom_aux_seq { 2 } }
  \prop_get:NnN \l_semio_viz_dom_bag_prop {#1} \l_semio_viz_dom_cell_tl
  \prop_get:NnN \l_semio_viz_dom_kid_prop {#1} \l_semio_viz_dom_tmp_tl
  \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    {
      \l_semio_viz_dom_alpha_fp
      * sqrt ( max ( 0.25 , \l_semio_viz_dom_cell_tl / max ( 1e-9 , \l_semio_viz_dom_hi_fp ) ) )
    }
    {
      fill = \semio_viz_dom_ramp:n { \semio_viz_dom_unit_b:n { \l_semio_viz_dom_tmp_tl } } ,
      draw = semio-chrome-canvas , line~width = \semio@stroke@hairline
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp }
      { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_alpha_fp + 0.8 } { south }
      { \prop_item:Nn \l_semio_viz_dom_lab_prop {#1} }
  }
}

% 📐 A value normalised onto [0,1] over the secondary extent, which carries the error rate.
\cs_new:Npn \semio_viz_dom_unit_b:n #1 {
  \fp_eval:n
    {
      ( (#1) - \l_semio_viz_dom_f_fp )
      / max ( 1e-9 , \l_semio_viz_dom_g_fp - \l_semio_viz_dom_f_fp )
    }
}

% ⭕ The tier rings of the topology, one circle per layer.
\cs_new_protected:Npn \semio_viz_dom_mo_rings: {
  \int_step_inline:nn { \l_semio_viz_dom_m_int } { \semio_viz_dom_mo_ring:n {##1} }
}

% ⭕ One tier ring plus the spoke to its first seat.
\cs_new_protected:Npn \semio_viz_dom_mo_ring:n #1 {
  \semio_viz_g_circle:nnnn { ( \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_xb_fp ) / 2 }
    { ( \l_semio_viz_dom_ya_fp + \l_semio_viz_dom_yb_fp ) / 2 }
    {
      (#1) * min ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ,
                   \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
      / ( 2 * ( \l_semio_viz_dom_m_int + 1 ) )
    }
    {
      fill = none , draw = semio-chrome-border-normal ,
      line~width = \semio@stroke@hairline , dash~pattern = on~0.4mm~off~0.6mm
    }
}

% 🌡️ The latency grid: one tinted cell per service and time bucket.
\cs_new_protected:Npn \semio_viz_dom_mo_heat: {
  \semio_viz_dom_mx_load:
  \int_step_inline:nn { \l_semio_viz_dom_rows_int } { \semio_viz_dom_lg_row:n {##1} }
  \bool_if:NT \l_semio_viz_dom_labels_bool { \semio_viz_dom_mx_captions: }
}

% 📡 monitoring: taxonomy §65. The layered dependency, the latency grid, the call graph and the
% ring topology of one running system.
\SemioVizFamily { monitoring } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-services }
  \tl_set:Nn \l_semio_viz_dom_edges_tl { demo-services-edges }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { layered }
  \tl_set:Nn \l_semio_viz_dom_id_tl { id }
  \tl_set:Nn \l_semio_viz_dom_second_tl { bucket }
  \tl_set:Nn \l_semio_viz_dom_label_tl { label }
  \tl_set:Nn \l_semio_viz_dom_group_tl { tier }
  \tl_set:Nn \l_semio_viz_dom_value_tl { latency }
  \tl_set:Nn \l_semio_viz_dom_x_tl { errors }
  \tl_set:Nn \l_semio_viz_dom_src_tl { source }
  \tl_set:Nn \l_semio_viz_dom_tgt_tl { target }
  \tl_set:Nn \l_semio_viz_dom_wgt_tl { calls }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 1.6 }
  \fp_set:Nn \l_semio_viz_dom_beta_fp { 0 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 8 }
  \keys_set:nn { semio / viz / family / monitoring } {#1}
  \semio_viz_dom_frame:
  \str_if_eq:VnTF \l_semio_viz_dom_mode_tl { heat }
    { \semio_viz_dom_mo_heat: }
    {
      \semio_viz_dom_mo_load:
      \str_if_eq:VnT \l_semio_viz_dom_mode_tl { rings } { \semio_viz_dom_mo_rings: }
      \semio_viz_dom_mo_calls:
      \semio_viz_dom_mo_nodes:
    }
}
%endregion 🔖️Monitoring

%region 🔖️Keys-neural
% 🔑 `neural` keys, l3keys family `semio / viz / family / neural`. §67 reads one activation tensor
% flattened to a channel, a row, a column and a value; the modes differ in how many channels they
% show and in how the value is coloured.
% variant (tl)     catalogue slug, recorded by the registry
% data    (table)  flattened tensor                                default `demo-neural`
% mode    (choice `single|multiples`)                             default `single`
% channel (column) the channel of a cell                           default `channel`
% row     (column) the row of a cell                               default `row`
% column  (column) the column of a cell                            default `col`
% value   (column) the activation                                  default `value`
% select  (int)    which channel `single` shows                     default 1
% columns (int)    channels per row of the small multiples          default 2
% scheme  (choice `sequential|diverging|cyclic`)                    default `sequential`
% threshold (number) the activation an outlined cell must reach     default 0.5
% outline (bool)   ring the cells above the threshold               default false
% gutter  (mm)     gap between two channel panels                   default 1.5
% labels  (bool)   print the channel captions                       default false
\keys_define:nn { semio / viz / family / neural } {
  data      .tl_set:N   = \l_semio_viz_dom_data_tl,
  mode      .tl_set:N   = \l_semio_viz_dom_mode_tl,
  channel   .tl_set:N   = \l_semio_viz_dom_group_tl,
  row       .tl_set:N   = \l_semio_viz_dom_id_tl,
  column    .tl_set:N   = \l_semio_viz_dom_second_tl,
  value     .tl_set:N   = \l_semio_viz_dom_value_tl,
  select    .int_set:N  = \l_semio_viz_dom_iter_int,
  columns   .int_set:N  = \l_semio_viz_dom_bins_int,
  scheme    .tl_set:N   = \l_semio_viz_dom_scheme_tl,
  threshold .fp_set:N   = \l_semio_viz_dom_beta_fp,
  outline   .bool_set:N = \l_semio_viz_dom_highlight_bool,
  gutter    .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  pad       .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width     .fp_set:N   = \l_semio_viz_dom_width_fp,
  height    .fp_set:N   = \l_semio_viz_dom_height_fp,
  labels    .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown   .code:n     = { },
}
%endregion 🔖️Keys-neural

%region 🔖️Neural
% 🧠 Reads the tensor: its channels, its grid extent and the value range every panel shares.
\cs_new_protected:Npn \semio_viz_dom_nn_load: {
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_group_tl
    \l_semio_viz_dom_aux_seq
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_id_tl
    \l_semio_viz_dom_rowlev_seq
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_second_tl
    \l_semio_viz_dom_collev_seq
  \int_set:Nn \l_semio_viz_dom_rows_int { \seq_count:N \l_semio_viz_dom_rowlev_seq }
  \int_set:Nn \l_semio_viz_dom_cols_int { \seq_count:N \l_semio_viz_dom_collev_seq }
  \int_set:Nn \l_semio_viz_dom_m_int { \seq_count:N \l_semio_viz_dom_aux_seq }
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
}

% 🧠 One channel panel filling the rectangle (#2,#3) with extent (#4,#5).
\cs_new_protected:Npn \semio_viz_dom_nn_panel:nnnnn #1#2#3#4#5 {
  \fp_set:Nn \l_semio_viz_dom_f_fp {#2}
  \fp_set:Nn \l_semio_viz_dom_g_fp {#3}
  \fp_set:Nn \l_semio_viz_dom_w_fp { (#4) / max ( 1 , \l_semio_viz_dom_cols_int ) }
  \fp_set:Nn \l_semio_viz_dom_h_fp { (#5) / max ( 1 , \l_semio_viz_dom_rows_int ) }
  \tl_set:Nn \l_semio_viz_dom_q_tl {#1}
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_nn_cell:n {##1} }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_f_fp + (#4) / 2 }
      { \l_semio_viz_dom_g_fp + (#5) + 0.4 } { south } {#1}
  }
}

% 🧠 One cell of the active channel panel.
\cs_new_protected:Npn \semio_viz_dom_nn_cell:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_group_tl }
    \l_semio_viz_dom_key_tl
  \tl_if_eq:NNT \l_semio_viz_dom_key_tl \l_semio_viz_dom_q_tl {
    \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
      \l_semio_viz_dom_tmp_tl
    \semio_viz_dom_index:NNV \l_semio_viz_dom_i_int \l_semio_viz_dom_rowlev_seq
      \l_semio_viz_dom_tmp_tl
    \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_second_tl }
      \l_semio_viz_dom_tmp_tl
    \semio_viz_dom_index:NNV \l_semio_viz_dom_j_int \l_semio_viz_dom_collev_seq
      \l_semio_viz_dom_tmp_tl
    \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
      \l_semio_viz_dom_cell_tl
    \fp_set:Nn \l_semio_viz_dom_x_fp
      {
        \l_semio_viz_dom_f_fp + ( \l_semio_viz_dom_j_int - 1 ) * \l_semio_viz_dom_w_fp
      }
    \fp_set:Nn \l_semio_viz_dom_y_fp
      {
        \l_semio_viz_dom_g_fp
        + ( \l_semio_viz_dom_rows_int - \l_semio_viz_dom_i_int ) * \l_semio_viz_dom_h_fp
      }
    \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
      { \l_semio_viz_dom_w_fp } { \l_semio_viz_dom_h_fp }
      {
        fill = \semio_viz_dom_ramp:n { \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } } ,
        draw = none
      }
    \bool_if:NT \l_semio_viz_dom_highlight_bool {
      \fp_compare:nNnT { abs ( \l_semio_viz_dom_cell_tl ) } > { \l_semio_viz_dom_beta_fp } {
        \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp + 0.1 } { \l_semio_viz_dom_y_fp + 0.1 }
          { \l_semio_viz_dom_w_fp - 0.2 } { \l_semio_viz_dom_h_fp - 0.2 }
          {
            fill = none , draw = semio-chrome-border-emphasized ,
            line~width = \semio@stroke@hairline
          }
      }
    }
  }
}

% 🧠 The small multiples: one panel per channel on the `columns` grid.
\cs_new_protected:Npn \semio_viz_dom_nn_multiples: {
  \fp_set:Nn \l_semio_viz_dom_a_fp
    {
      ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ) / max ( 1 , \l_semio_viz_dom_bins_int )
    }
  \fp_set:Nn \l_semio_viz_dom_b_fp
    {
      ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
      / max ( 1 , ceil ( \l_semio_viz_dom_m_int / \l_semio_viz_dom_bins_int ) )
    }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_aux_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_nn_multiple:n {##1} }
}

% 🧠 One panel of the small multiples.
\cs_new_protected:Npn \semio_viz_dom_nn_multiple:n #1 {
  \fp_set:Nn \l_semio_viz_dom_c_fp
    {
      \l_semio_viz_dom_xa_fp
      + \int_mod:nn { \l_semio_viz_dom_k_int - 1 } { \l_semio_viz_dom_bins_int }
        * \l_semio_viz_dom_a_fp
    }
  \fp_set:Nn \l_semio_viz_dom_d_fp
    {
      \l_semio_viz_dom_yb_fp
      - ( floor ( ( \l_semio_viz_dom_k_int - 1 ) / \l_semio_viz_dom_bins_int ) + 1 )
        * \l_semio_viz_dom_b_fp
    }
  \semio_viz_dom_nn_panel:nnnnn {#1} { \l_semio_viz_dom_c_fp } { \l_semio_viz_dom_d_fp }
    { \l_semio_viz_dom_a_fp - \l_semio_viz_dom_gamma_fp }
    { \l_semio_viz_dom_b_fp - \l_semio_viz_dom_gamma_fp }
}

% 🧠 neural: taxonomy §67. The activation grid of one channel, the small multiples of every
% channel, and the signed saliency grid with its outlined peaks.
\SemioVizFamily { neural } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-neural }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { single }
  \tl_set:Nn \l_semio_viz_dom_group_tl { channel }
  \tl_set:Nn \l_semio_viz_dom_id_tl { row }
  \tl_set:Nn \l_semio_viz_dom_second_tl { col }
  \tl_set:Nn \l_semio_viz_dom_value_tl { value }
  \int_set:Nn \l_semio_viz_dom_iter_int { 1 }
  \int_set:Nn \l_semio_viz_dom_bins_int { 2 }
  \fp_set:Nn \l_semio_viz_dom_beta_fp { 0.5 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 1.5 }
  \bool_set_false:N \l_semio_viz_dom_labels_bool
  \keys_set:nn { semio / viz / family / neural } {#1}
  \semio_viz_dom_frame:
  \semio_viz_dom_nn_load:
  \str_if_eq:VnTF \l_semio_viz_dom_mode_tl { multiples }
    { \semio_viz_dom_nn_multiples: }
    {
      \semio_viz_dom_nn_panel:xnnnn
        { \seq_item:Nn \l_semio_viz_dom_aux_seq { \l_semio_viz_dom_iter_int } }
        { \l_semio_viz_dom_xa_fp } { \l_semio_viz_dom_ya_fp }
        { \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp }
        { \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp }
    }
}
\cs_generate_variant:Nn \semio_viz_dom_nn_panel:nnnnn { xnnnn }
%endregion 🔖️Neural

%region 🔖️Keys-survey
% 🔑 `survey` keys, l3keys family `semio / viz / family / survey`. §69 crosses questions with
% respondent groups; the `mark` key decides whether a cell is a tinted patch or a sized symbol.
% variant  (tl)     catalogue slug, recorded by the registry
% data     (table)  answer table                                   default `demo-survey`
% question (column) the row of the grid                            default `question`
% group    (column) the column of the grid                         default `group`
% value    (column) the share that agrees                          default `value`
% mark     (choice `cell|symbol`)                                  default `cell`
% scheme   (choice `sequential|diverging|cyclic`)                  default `sequential`
% gutter   (mm)     space reserved for the captions                default 8
% node     (mm)     greatest symbol radius                         default 2.2
% values   (bool)   print the numeric share                        default false
% labels   (bool)   print question and group captions              default true
\keys_define:nn { semio / viz / family / survey } {
  data     .tl_set:N   = \l_semio_viz_dom_data_tl,
  question .tl_set:N   = \l_semio_viz_dom_id_tl,
  group    .tl_set:N   = \l_semio_viz_dom_second_tl,
  value    .tl_set:N   = \l_semio_viz_dom_value_tl,
  mark     .tl_set:N   = \l_semio_viz_dom_mode_tl,
  scheme   .tl_set:N   = \l_semio_viz_dom_scheme_tl,
  gutter   .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  node     .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  pad      .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width    .fp_set:N   = \l_semio_viz_dom_width_fp,
  height   .fp_set:N   = \l_semio_viz_dom_height_fp,
  values   .bool_set:N = \l_semio_viz_dom_annotate_bool,
  labels   .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown  .code:n     = { },
}
%endregion 🔖️Keys-survey

%region 🔖️Survey
% 📋 One symbol cell: a disc whose area carries the share, on the grid the matrix reader builds.
\cs_new_protected:Npn \semio_viz_dom_sv_symbol:nn #1#2 {
  \semio_viz_dom_mx_get:nnN {#1} {#2} \l_semio_viz_dom_cell_tl
  \tl_if_empty:NF \l_semio_viz_dom_cell_tl {
    \semio_viz_dom_mx_at:nn {#1} {#2}
    \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp + 0.2 } { \l_semio_viz_dom_y_fp + 0.2 }
      { \l_semio_viz_dom_w_fp - 0.4 } { \l_semio_viz_dom_h_fp - 0.4 }
      {
        fill = none , draw = semio-chrome-border-normal ,
        line~width = \semio@stroke@hairline
      }
    \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_w_fp / 2 }
      { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_h_fp / 2 }
      {
        \l_semio_viz_dom_alpha_fp
        * sqrt ( max ( 0 , \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } ) )
      }
      { fill = \semio_viz_palette:n {#2} , fill~opacity = 0.8 , draw = none }
    \bool_if:NT \l_semio_viz_dom_annotate_bool {
      \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_w_fp / 2 }
        { \l_semio_viz_dom_y_fp + 0.5 } { south } { \tl_use:N \l_semio_viz_dom_cell_tl }
    }
  }
}

% 📋 One row of the symbol grid.
\cs_new_protected:Npn \semio_viz_dom_sv_row:n #1 {
  \int_step_inline:nn { \l_semio_viz_dom_cols_int } { \semio_viz_dom_sv_symbol:nn {#1} {##1} }
}

