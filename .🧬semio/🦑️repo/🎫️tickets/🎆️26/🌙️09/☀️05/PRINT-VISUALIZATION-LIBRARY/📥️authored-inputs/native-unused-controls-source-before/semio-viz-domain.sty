% 🧪 Response times per service and time bucket: the grid the latency heat map reads.
\cs_new_protected:Npn \semio_viz_dom_demo_latency: {
  \seq_if_in:NnF \g_semio_viz_table_names_seq { demo-latency } {
    \semio_viz_table_new:nn { demo-latency } { service, bucket, ms }
    \int_zero:N \l_semio_viz_dom_seed_int
    \clist_map_inline:nn { edge, auth, api, cart, search, db } {
      \int_incr:N \l_semio_viz_dom_seed_int
      \int_step_inline:nnn { 1 } { 8 } {
        \semio_viz_table_row:nn { demo-latency }
          {
            ##1 , ####1 ,
            \fp_eval:n
              {
                round
                  (
                    18 + 46 * ( sin ( \l_semio_viz_dom_seed_int * 0.9 + ####1 * 0.55 ) ) ^ 2
                    + ####1 * 1.5 , 1
                  )
              }
          }
      }
    }
  }
}

