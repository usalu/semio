  \tl_set:Nn \l_semio_viz_dom_y_tl { y }
  \tl_set:Nn \l_semio_viz_dom_value_tl { richness }
  \tl_set:Nn \l_semio_viz_dom_group_tl { species }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 2.6 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 0.6 }
  \bool_set_false:N \l_semio_viz_dom_labels_bool
  \keys_set:nn { semio / viz / family / biology } {#1}
