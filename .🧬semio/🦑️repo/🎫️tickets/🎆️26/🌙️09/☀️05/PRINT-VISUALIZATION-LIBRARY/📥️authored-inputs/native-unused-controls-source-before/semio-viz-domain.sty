%region 🔖️Keys-election
% 🔑 `election` keys, l3keys family `semio / viz / family / election`. §70 places constituencies on
% a tile grid and reads the winning share, the swing and the seats from the same table.
% variant (tl)     catalogue slug, recorded by the registry
% data    (table)  constituency table                              default `demo-election`
% mode    (choice `tile|cartogram|swing`)                          default `tile`
% label   (column) constituency caption                            default `region`
% x, y    (column) grid place                                      default `x`, `y`
% value   (column) the tinted quantity                             default `share`
% delta   (column) the swing the arrows carry                      default `swing`
% size    (column) the quantity a cartogram tile sizes             default `seats`
% scheme  (choice `sequential|diverging|cyclic`)                    default `sequential`
% inset   (mm)     gap between two tiles                            default 0.6
% arrow   (mm)     arrow head length of a swing arrow               default 1.2
% gain    (mm)     length of a swing arrow at the greatest swing    default 4
% labels  (bool)   print constituency captions                      default false
\keys_define:nn { semio / viz / family / election } {
  data    .tl_set:N   = \l_semio_viz_dom_data_tl,
  mode    .tl_set:N   = \l_semio_viz_dom_mode_tl,
  label   .tl_set:N   = \l_semio_viz_dom_label_tl,
  x       .tl_set:N   = \l_semio_viz_dom_x_tl,
  y       .tl_set:N   = \l_semio_viz_dom_y_tl,
  value   .tl_set:N   = \l_semio_viz_dom_value_tl,
  delta   .tl_set:N   = \l_semio_viz_dom_second_tl,
  size    .tl_set:N   = \l_semio_viz_dom_edges_tl,
  scheme  .tl_set:N   = \l_semio_viz_dom_scheme_tl,
  inset   .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  arrow   .fp_set:N   = \l_semio_viz_dom_beta_fp,
  gain    .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  pad     .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width   .fp_set:N   = \l_semio_viz_dom_width_fp,
  height  .fp_set:N   = \l_semio_viz_dom_height_fp,
  labels  .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown .code:n     = { },
}
%endregion 🔖️Keys-election

%region 🔖️Election
% 🗳️ One constituency tile in the active mode.
\cs_new_protected:Npn \semio_viz_dom_el_tile:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_x_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_y_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \semio_viz_dom_tile_at:nn { \l_semio_viz_dom_key_tl } { \l_semio_viz_dom_tmp_tl }
  \str_case:VnF \l_semio_viz_dom_mode_tl
    {
      { cartogram } { \semio_viz_dom_el_disc:n {#1} }
      { swing } { \semio_viz_dom_el_swing:n {#1} }
    }
    { \semio_viz_dom_el_patch: }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_label_tl }
      \l_semio_viz_dom_q_tl
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp } { center }
      { \tl_use:N \l_semio_viz_dom_q_tl }
  }
}

% 🗳️ The choropleth tile: a square tinted by the winning share.
\cs_new_protected:Npn \semio_viz_dom_el_patch: {
  \semio_viz_g_rect:nnnnn
    { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_e_fp / 2 + \l_semio_viz_dom_gamma_fp / 2 }
    { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_e_fp / 2 + \l_semio_viz_dom_gamma_fp / 2 }
    { \l_semio_viz_dom_e_fp - \l_semio_viz_dom_gamma_fp }
    { \l_semio_viz_dom_e_fp - \l_semio_viz_dom_gamma_fp }
    {
      fill = \semio_viz_dom_ramp:n { \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } } ,
      draw = none
    }
}

% 🗳️ The cartogram tile: a disc whose area carries the seats and whose tint carries the share.
\cs_new_protected:Npn \semio_viz_dom_el_disc:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_edges_tl }
    \l_semio_viz_dom_q_tl
  \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    {
      ( \l_semio_viz_dom_e_fp - \l_semio_viz_dom_gamma_fp ) / 2
      * sqrt ( max ( 0.1 , \l_semio_viz_dom_q_tl / max ( 1e-9 , \l_semio_viz_dom_hi_b_fp ) ) )
    }
    {
      fill = \semio_viz_dom_ramp:n { \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } } ,
      draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline
    }
}

% 🗳️ The swing tile: an arrow whose direction and length carry the change since the last poll.
\cs_new_protected:Npn \semio_viz_dom_el_swing:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_second_tl }
    \l_semio_viz_dom_q_tl
  \semio_viz_g_rect:nnnnn
    { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_e_fp / 2 + \l_semio_viz_dom_gamma_fp / 2 }
    { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_e_fp / 2 + \l_semio_viz_dom_gamma_fp / 2 }
    { \l_semio_viz_dom_e_fp - \l_semio_viz_dom_gamma_fp }
    { \l_semio_viz_dom_e_fp - \l_semio_viz_dom_gamma_fp }
    {
      fill = \semio_viz_theme_ramp_diverging:n
        { \l_semio_viz_dom_q_tl / max ( 1e-9 , \l_semio_viz_dom_g_fp ) } ,
      draw = none
    }
  \semio_viz_dom_arrow:nnnnnn { \l_semio_viz_dom_x_fp }
    { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_alpha_fp / 2 }
    {
      \l_semio_viz_dom_x_fp
      + \l_semio_viz_dom_alpha_fp * \l_semio_viz_dom_q_tl
        / max ( 1e-9 , \l_semio_viz_dom_g_fp )
    }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_alpha_fp / 2 }
    { \l_semio_viz_dom_beta_fp }
    {
      draw = semio-chrome-border-emphasized , fill = semio-chrome-border-emphasized ,
      line~width = \semio@stroke@hairline
    }
}

% 🗳️ election: taxonomy §70. The tile choropleth, the seat cartogram and the swing map, three
% readings of one constituency table.
\SemioVizFamily { election } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-election }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { tile }
  \tl_set:Nn \l_semio_viz_dom_label_tl { region }
  \tl_set:Nn \l_semio_viz_dom_x_tl { x }
  \tl_set:Nn \l_semio_viz_dom_y_tl { y }
  \tl_set:Nn \l_semio_viz_dom_value_tl { share }
  \tl_set:Nn \l_semio_viz_dom_second_tl { swing }
  \tl_set:Nn \l_semio_viz_dom_edges_tl { seats }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 4 }
  \fp_set:Nn \l_semio_viz_dom_beta_fp { 1.2 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 0.6 }
  \bool_set_false:N \l_semio_viz_dom_labels_bool
  \keys_set:nn { semio / viz / family / election } {#1}
  \semio_viz_dom_frame:
  \semio_viz_dom_tile_load:
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_edges_tl
    \l_semio_viz_dom_hi_b_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_second_tl
    \l_semio_viz_dom_g_fp
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_el_tile:n {##1} }
}
%endregion 🔖️Election

%region 🔖️Keys-biology
% 🔑 `biology` keys, l3keys family `semio / viz / family / biology`. §34 reads a survey grid: how
% rich every plot is, and which taxon holds it.
% variant (tl)     catalogue slug, recorded by the registry
% data    (table)  survey grid                                     default `demo-biodiversity`
% mode    (choice `graduated|range`)                               default `graduated`
% label   (column) plot caption                                    default `cell`
% x, y    (column) grid place                                      default `x`, `y`
% value   (column) species richness                                default `richness`
% group   (column) the taxon holding the plot                      default `species`
% scheme  (choice `sequential|diverging|cyclic`)                    default `sequential`
% node    (mm)     greatest symbol radius                          default 2.6
% inset   (mm)     gap between two plots                           default 0.6
% labels  (bool)   print plot captions                             default false
\keys_define:nn { semio / viz / family / biology } {
  data    .tl_set:N   = \l_semio_viz_dom_data_tl,
  mode    .tl_set:N   = \l_semio_viz_dom_mode_tl,
  label   .tl_set:N   = \l_semio_viz_dom_label_tl,
  x       .tl_set:N   = \l_semio_viz_dom_x_tl,
  y       .tl_set:N   = \l_semio_viz_dom_y_tl,
  value   .tl_set:N   = \l_semio_viz_dom_value_tl,
  group   .tl_set:N   = \l_semio_viz_dom_group_tl,
  scheme  .tl_set:N   = \l_semio_viz_dom_scheme_tl,
  node    .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  inset   .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  pad     .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width   .fp_set:N   = \l_semio_viz_dom_width_fp,
  height  .fp_set:N   = \l_semio_viz_dom_height_fp,
  labels  .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown .code:n     = { },
}
%endregion 🔖️Keys-biology

%region 🔖️Biology
% 🌿 The graduated survey: one disc per plot, its area the richness recorded there.
\cs_new_protected:Npn \semio_viz_dom_bi_plot:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_x_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_y_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \semio_viz_dom_tile_at:nn { \l_semio_viz_dom_key_tl } { \l_semio_viz_dom_tmp_tl }
  \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    {
      \l_semio_viz_dom_alpha_fp
      * sqrt ( max ( 0.08 , \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } ) )
    }
    {
      fill = \semio_viz_dom_ramp:n { \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } } ,
      draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_label_tl }
      \l_semio_viz_dom_q_tl
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp }
      { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_alpha_fp + 0.5 } { south }
      { \tl_use:N \l_semio_viz_dom_q_tl }
  }
}

% 🐾 The range map: the plots of one taxon tinted, and their extent closed into a range hull.
\cs_new_protected:Npn \semio_viz_dom_bi_ranges: {
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_group_tl
    \l_semio_viz_dom_rowlev_seq
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_rowlev_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_bi_range:n {##1} }
}

% 🐾 One taxon range: its patches, then the rectangle its patches span.
\cs_new_protected:Npn \semio_viz_dom_bi_range:n #1 {
  \fp_set:Nn \l_semio_viz_dom_a_fp { 1e9 }
  \fp_set:Nn \l_semio_viz_dom_b_fp { -1e9 }
  \fp_set:Nn \l_semio_viz_dom_c_fp { 1e9 }
  \fp_set:Nn \l_semio_viz_dom_d_fp { -1e9 }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_bi_patch:nn {##1} {#1} }
  \semio_viz_g_rect:nnnnn
    { \l_semio_viz_dom_a_fp - \l_semio_viz_dom_e_fp / 2 + \l_semio_viz_dom_gamma_fp }
    { \l_semio_viz_dom_c_fp - \l_semio_viz_dom_e_fp / 2 + \l_semio_viz_dom_gamma_fp }
    {
      \l_semio_viz_dom_b_fp - \l_semio_viz_dom_a_fp + \l_semio_viz_dom_e_fp
      - 2 * \l_semio_viz_dom_gamma_fp
    }
    {
      \l_semio_viz_dom_d_fp - \l_semio_viz_dom_c_fp + \l_semio_viz_dom_e_fp
      - 2 * \l_semio_viz_dom_gamma_fp
    }
    {
      fill = none , draw = \semio_viz_palette:n { \l_semio_viz_dom_k_int } ,
      line~width = \semio@stroke@default , rounded~corners = 1mm
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn
      { ( \l_semio_viz_dom_a_fp + \l_semio_viz_dom_b_fp ) / 2 }
      { \l_semio_viz_dom_d_fp + \l_semio_viz_dom_e_fp / 2 } { south } {#1}
  }
}

% 🐾 One plot of a taxon range; it also widens the range extent.
\cs_new_protected:Npn \semio_viz_dom_bi_patch:nn #1#2 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_group_tl }
    \l_semio_viz_dom_q_tl
  \str_if_eq:VnT \l_semio_viz_dom_q_tl {#2} {
    \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_x_tl }
      \l_semio_viz_dom_key_tl
    \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_y_tl }
      \l_semio_viz_dom_tmp_tl
    \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
      \l_semio_viz_dom_cell_tl
    \semio_viz_dom_tile_at:nn { \l_semio_viz_dom_key_tl } { \l_semio_viz_dom_tmp_tl }
    \fp_set:Nn \l_semio_viz_dom_a_fp { min ( \l_semio_viz_dom_a_fp , \l_semio_viz_dom_x_fp ) }
    \fp_set:Nn \l_semio_viz_dom_b_fp { max ( \l_semio_viz_dom_b_fp , \l_semio_viz_dom_x_fp ) }
    \fp_set:Nn \l_semio_viz_dom_c_fp { min ( \l_semio_viz_dom_c_fp , \l_semio_viz_dom_y_fp ) }
    \fp_set:Nn \l_semio_viz_dom_d_fp { max ( \l_semio_viz_dom_d_fp , \l_semio_viz_dom_y_fp ) }
    \semio_viz_g_rect:nnnnn
      { \l_semio_viz_dom_x_fp - \l_semio_viz_dom_e_fp / 2 + \l_semio_viz_dom_gamma_fp / 2 }
      { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_e_fp / 2 + \l_semio_viz_dom_gamma_fp / 2 }
      { \l_semio_viz_dom_e_fp - \l_semio_viz_dom_gamma_fp }
      { \l_semio_viz_dom_e_fp - \l_semio_viz_dom_gamma_fp }
      {
        fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } ,
        fill~opacity =
          \fp_eval:n
            { 0.18 + 0.55 * \semio_viz_dom_unit:n { \l_semio_viz_dom_cell_tl } } ,
        draw = none
      }
  }
}

% 🌱 biology: taxonomy §34. The graduated biodiversity survey and the taxon range map, two
