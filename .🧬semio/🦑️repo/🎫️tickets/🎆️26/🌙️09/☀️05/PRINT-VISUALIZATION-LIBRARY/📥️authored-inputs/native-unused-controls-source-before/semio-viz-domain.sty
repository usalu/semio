  \tl_clear:N \l_semio_viz_dom_shape_tl
  \tl_set:Nn \l_semio_viz_dom_scheme_tl { sequential }
  \tl_set:Nn \l_semio_viz_dom_order_tl { none }
  \clist_clear:N \l_semio_viz_dom_series_clist
  \fp_zero:N \l_semio_viz_dom_alpha_fp
  \fp_zero:N \l_semio_viz_dom_beta_fp
  \fp_zero:N \l_semio_viz_dom_gamma_fp
  \fp_set:Nn \l_semio_viz_dom_pad_fp { 3 }
  \int_set:Nn \l_semio_viz_dom_cols_int { 4 }
  \int_set:Nn \l_semio_viz_dom_rows_int { 4 }
  \int_set:Nn \l_semio_viz_dom_bins_int { 10 }
  \int_set:Nn \l_semio_viz_dom_iter_int { 12 }
  \bool_set_true:N \l_semio_viz_dom_labels_bool
  \bool_set_false:N \l_semio_viz_dom_annotate_bool
  \bool_set_false:N \l_semio_viz_dom_grid_bool
  \bool_set_false:N \l_semio_viz_dom_mirror_bool
  \bool_set_true:N \l_semio_viz_dom_fill_bool
  \bool_set_false:N \l_semio_viz_dom_highlight_bool
  \semio_viz_dom_canvas:
}

% 🧭 Sets the drawing rectangle from the canvas and the padding key.
\cs_new_protected:Npn \semio_viz_dom_frame: {
  \fp_set_eq:NN \l_semio_viz_dom_xa_fp \l_semio_viz_dom_pad_fp
  \fp_set_eq:NN \l_semio_viz_dom_ya_fp \l_semio_viz_dom_pad_fp
  \fp_set:Nn \l_semio_viz_dom_xb_fp { \l_semio_viz_dom_width_fp - \l_semio_viz_dom_pad_fp }
  \fp_set:Nn \l_semio_viz_dom_yb_fp { \l_semio_viz_dom_height_fp - \l_semio_viz_dom_pad_fp }
}

% 🗃️ Distinct values of column #2 of table #1 in first-appearance order, into #3.
\cs_new_protected:Npn \semio_viz_dom_levels:nnN #1#2#3 {
  \seq_clear:N #3
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dom_m_int
  \int_step_inline:nn { \l_semio_viz_dom_m_int } {
    \semio_viz_table_cell:nnnN {#1} {##1} {#2} \l_semio_viz_dom_cell_tl
    \seq_if_in:NVF #3 \l_semio_viz_dom_cell_tl
      { \seq_put_right:NV #3 \l_semio_viz_dom_cell_tl }
  }
}
\cs_generate_variant:Nn \semio_viz_dom_levels:nnN { VVN , VnN }

% 🔲 A labelled node body centred at (#1,#2) with size (#3,#4) in palette slot #5.
\cs_new_protected:Npn \semio_viz_dom_box:nnnnnn #1#2#3#4#5#6 {
  \semio_viz_g_rect:nnnnn { (#1) - (#3) / 2 } { (#2) - (#4) / 2 } {#3} {#4}
    {
      fill = \semio_viz_palette:n {#5} , fill~opacity = 0.20 ,
      draw = \semio_viz_palette:n {#5} , line~width = \semio@stroke@hairline ,
      rounded~corners = 0.5mm
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool
    { \semio_viz_g_text:nnnn {#1} {#2} { center } {#6} }
}

% ➖ A connector between two node centres in the chrome stroke.
\cs_new_protected:Npn \semio_viz_dom_edge:nnnnn #1#2#3#4#5 {
  \semio_viz_g_line:nnnnn {#1} {#2} {#3} {#4}
    { draw = semio-chrome-border-normal , line~width = \fp_eval:n { max ( 0.08 , #5 ) } mm }
}

% 📐 A value normalised onto [0,1] over the current lo/hi extent.
\cs_new:Npn \semio_viz_dom_unit:n #1 {
  \fp_eval:n
    {
      ( (#1) - \l_semio_viz_dom_lo_fp )
      / max ( 1e-9 , \l_semio_viz_dom_hi_fp - \l_semio_viz_dom_lo_fp )
    }
}

% 🎨 The active scheme's colour expression for a normalised value.
\cs_new:Npn \semio_viz_dom_ramp:n #1 {
  \str_case:VnF \l_semio_viz_dom_scheme_tl
    {
      { diverging } { \semio_viz_theme_ramp_diverging:n { 2 * (#1) - 1 } }
      { cyclic } { \semio_viz_theme_ramp_cyclic:n { 6.2832 * (#1) } }
    }
    { \semio_viz_theme_ramp:n {#1} }
}

% 📍 Reads point #2 of the named point set #1 into the two fp variables #3 and #4.
\cs_new_protected:Npn \semio_viz_dom_point:nnNN #1#2#3#4 {
  \tl_set:Nx \l_semio_viz_dom_cell_tl
    { \seq_item:cn { g_semio_viz_points_ \tl_to_str:n {#1} _seq } {#2} }
  \seq_set_split:NnV \l_semio_viz_dom_aux_seq { , } \l_semio_viz_dom_cell_tl
  \fp_set:Nn #3 { \seq_item:Nn \l_semio_viz_dom_aux_seq { 1 } }
  \fp_set:Nn #4 { \seq_item:Nn \l_semio_viz_dom_aux_seq { 2 } }
}

% 🔢 Number of points in the named point set #1.
\cs_new_protected:Npn \semio_viz_dom_point_count:nN #1#2
  { \int_set:Nn #2 { \seq_count:c { g_semio_viz_points_ \tl_to_str:n {#1} _seq } } }

% 🗣️ The English literal #1 or the German literal #2, chosen by the document language; there is no
% default language in the code, only the fallback a standalone probe without `semio-core` needs.
\cs_new:Npn \semio_viz_dom_lang:nn #1#2 {
  \cs_if_exist:NTF \l_semio_language_tl
    { \str_if_eq:VnTF \l_semio_language_tl { de } {#2} {#1} }
    {#1}
}

% ➤ A connector from (#1,#2) to (#3,#4) closed by a solid head of size #5.
\cs_new_protected:Npn \semio_viz_dom_arrow:nnnnnn #1#2#3#4#5#6 {
  \semio_viz_g_line:nnnnn {#1} {#2} {#3} {#4} {#6}
  \fp_set:Nn \l_semio_viz_dom_a_fp { atand ( (#4) - (#2) , (#3) - (#1) ) }
  \semio_viz_g_polygon:xn
    {
      \fp_eval:n {#3} , \fp_eval:n {#4} ,
      \fp_eval:n { (#3) - (#5) * cosd ( \l_semio_viz_dom_a_fp - 16 ) } ,
      \fp_eval:n { (#4) - (#5) * sind ( \l_semio_viz_dom_a_fp - 16 ) } ,
      \fp_eval:n { (#3) - (#5) * cosd ( \l_semio_viz_dom_a_fp + 16 ) } ,
      \fp_eval:n { (#4) - (#5) * sind ( \l_semio_viz_dom_a_fp + 16 ) }
    }
    {#6}
}

\seq_new:N \l_semio_viz_dom_rowlev_seq
\seq_new:N \l_semio_viz_dom_collev_seq
\prop_new:N \l_semio_viz_dom_mx_prop

% 🔲 The tabular reader every grid-shaped domain family shares: the row and column levels in
% first-appearance order, the cell values keyed `row/column`, and the value extent.
\cs_new_protected:Npn \semio_viz_dom_mx_load: {
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_id_tl
    \l_semio_viz_dom_rowlev_seq
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_second_tl
    \l_semio_viz_dom_collev_seq
  \prop_clear:N \l_semio_viz_dom_mx_prop
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_mx_put:n {##1} }
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \int_set:Nn \l_semio_viz_dom_rows_int { \seq_count:N \l_semio_viz_dom_rowlev_seq }
  \int_set:Nn \l_semio_viz_dom_cols_int { \seq_count:N \l_semio_viz_dom_collev_seq }
  \fp_set:Nn \l_semio_viz_dom_w_fp
    {
      ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp - \l_semio_viz_dom_gamma_fp )
      / max ( 1 , \l_semio_viz_dom_cols_int )
    }
  \fp_set:Nn \l_semio_viz_dom_h_fp
    {
      ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp - \l_semio_viz_dom_gamma_fp )
      / max ( 1 , \l_semio_viz_dom_rows_int )
    }
}

% 🔲 Stores one source row under its `row/column` key.
\cs_new_protected:Npn \semio_viz_dom_mx_put:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_second_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:Nxx \l_semio_viz_dom_mx_prop
    { \l_semio_viz_dom_key_tl / \l_semio_viz_dom_tmp_tl } { \l_semio_viz_dom_cell_tl }
}

% 🔲 The value of the cell in row #1 and column #2, or the empty string when the pair is absent.
\cs_new_protected:Npn \semio_viz_dom_mx_get:nnN #1#2#3 {
  \tl_set:Nx \l_semio_viz_dom_q_tl
    {
      \seq_item:Nn \l_semio_viz_dom_rowlev_seq {#1} /
      \seq_item:Nn \l_semio_viz_dom_collev_seq {#2}
    }
  \prop_get:NVNF \l_semio_viz_dom_mx_prop \l_semio_viz_dom_q_tl #3 { \tl_clear:N #3 }
}

% 🔢 One-based position of the value #3 inside the sequence #2, into the integer #1; zero when the
% sequence does not hold it.
\cs_new_protected:Npn \semio_viz_dom_index:NNn #1#2#3 {
  \int_zero:N #1
  \seq_map_indexed_inline:Nn #2
    { \str_if_eq:nnT {##2} {#3} { \int_set:Nn #1 {##1} \seq_map_break: } }
}
\cs_generate_variant:Nn \semio_viz_dom_index:NNn { NNV }

% ➕ Total of the column #2 of table #1 over every row whose column #3 equals #4, into #5.
\cs_new_protected:Npn \semio_viz_dom_sum_where:nnnnN #1#2#3#4#5 {
  \fp_zero:N #5
  \semio_viz_table_nrows:nN {#1} \l_semio_viz_dom_p_int
  \int_step_inline:nn { \l_semio_viz_dom_p_int } {
    \semio_viz_table_cell:nnnN {#1} {##1} {#3} \l_semio_viz_dom_q_tl
    \str_if_eq:VnT \l_semio_viz_dom_q_tl {#4} {
      \semio_viz_table_cell:nnnN {#1} {##1} {#2} \l_semio_viz_dom_q_tl
      \fp_add:Nn #5 { \l_semio_viz_dom_q_tl }
    }
  }
}
\cs_generate_variant:Nn \semio_viz_dom_sum_where:nnnnN { VVVnN }

% 🔲 Lower-left corner of the cell in row #1 and column #2, into the working x and y.
\cs_new_protected:Npn \semio_viz_dom_mx_at:nn #1#2 {
  \fp_set:Nn \l_semio_viz_dom_x_fp
    {
      \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_gamma_fp
      + ( (#2) - 1 ) * \l_semio_viz_dom_w_fp
    }
  \fp_set:Nn \l_semio_viz_dom_y_fp
    {
      \l_semio_viz_dom_yb_fp - (#1) * \l_semio_viz_dom_h_fp
    }
}

% 🏷️ The row and column captions of the grid, printed in the gutter the `gutter` key reserves.
\cs_new_protected:Npn \semio_viz_dom_mx_captions: {
  \int_step_inline:nn { \l_semio_viz_dom_rows_int } {
    \semio_viz_dom_mx_at:nn {##1} { 1 }
    \semio_viz_g_text:nnnn
      { \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_gamma_fp - 0.6 }
      { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_h_fp / 2 } { east }
      { \seq_item:Nn \l_semio_viz_dom_rowlev_seq {##1} }
  }
  \int_step_inline:nn { \l_semio_viz_dom_cols_int } {
    \semio_viz_dom_mx_at:nn { 1 } {##1}
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp + \l_semio_viz_dom_w_fp / 2 }
      { \l_semio_viz_dom_yb_fp + 0.4 } { south }
      { \seq_item:Nn \l_semio_viz_dom_collev_seq {##1} }
  }
}
%endregion 🔖️Kernel

%region 🔖️Keys-spatial-layout
% 🔑 `spatial-layout` keys, l3keys family `semio / viz / family / spatial-layout`. Taxonomy §47 is
% the placement question itself, so the family reads a node table, hands the planar point set to a
% §75/§78 layout algorithm and draws the field the algorithm returns.
% variant  (tl)      catalogue slug, recorded by the registry
% data     (table)   node table                                       default `demo-scatter`
% x, y     (column)  source coordinates                               default `x`, `y`
% size     (column)  node area channel                                default `size`
% label    (column)  node caption                                     default `label`
% group    (column)  categorical channel driving the palette slot     default `grp`
% algorithm (choice `beeswarm|voronoi|relax|align|grid|matrix|layered|radial|spiral`) default `grid`
% radius   (mm)      collision radius handed to the beeswarm layout   default 2.4
% amount   (mm)      relaxation step / ring spacing / spiral growth   default 2
% columns  (int)     columns of the grid and of the small multiples   default 5
% rings    (int)     rings of the radial layout                       default 2
% iterations (int)   relaxation passes of the `relax` algorithm       default 24
% node     (mm)      base node radius                                 default 1.1
% cells    (bool)    draw the polygons or the panel frames            default false
% labels   (bool)    print node captions                              default true
\keys_define:nn { semio / viz / family / spatial-layout } {
  data       .tl_set:N   = \l_semio_viz_dom_data_tl,
  x          .tl_set:N   = \l_semio_viz_dom_x_tl,
  y          .tl_set:N   = \l_semio_viz_dom_y_tl,
  size       .tl_set:N   = \l_semio_viz_dom_value_tl,
  label      .tl_set:N   = \l_semio_viz_dom_label_tl,
  group      .tl_set:N   = \l_semio_viz_dom_group_tl,
  algorithm  .tl_set:N   = \l_semio_viz_dom_mode_tl,
  radius     .fp_set:N   = \l_semio_viz_dom_alpha_fp,
  amount     .fp_set:N   = \l_semio_viz_dom_beta_fp,
  node       .fp_set:N   = \l_semio_viz_dom_gamma_fp,
  columns    .int_set:N  = \l_semio_viz_dom_cols_int,
  rings      .int_set:N  = \l_semio_viz_dom_rows_int,
  iterations .int_set:N  = \l_semio_viz_dom_iter_int,
  pad        .fp_set:N   = \l_semio_viz_dom_pad_fp,
  width      .fp_set:N   = \l_semio_viz_dom_width_fp,
  height     .fp_set:N   = \l_semio_viz_dom_height_fp,
  cells      .bool_set:N = \l_semio_viz_dom_grid_bool,
  labels     .bool_set:N = \l_semio_viz_dom_labels_bool,
  unknown    .code:n     = { },
}
%endregion 🔖️Keys-spatial-layout

%region 🔖️SpatialLayout
% 📥 Reads the node table and maps its two coordinate columns into the frame, publishing the
% result as the point set every layout algorithm below consumes.
\cs_new_protected:Npn \semio_viz_dom_sl_field: {
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_x_tl
    \l_semio_viz_dom_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_x_tl
    \l_semio_viz_dom_hi_fp
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_y_tl
    \l_semio_viz_dom_lo_b_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_y_tl
    \l_semio_viz_dom_hi_b_fp
  \seq_clear:N \l_semio_viz_dom_stack_seq
  \seq_clear:N \l_semio_viz_dom_path_seq
  \seq_clear:N \l_semio_viz_dom_keys_seq
  \seq_clear:N \l_semio_viz_dom_cols_seq
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_node:n {##1} }
  \use:x
    {
      \exp_not:N \semio_viz_points_new:nn { semio-dom-field }
        { \seq_use:Nn \l_semio_viz_dom_stack_seq { ; } }
    }
}

% 📥 One node of the source table: its frame position, its caption and its size channel.
\cs_new_protected:Npn \semio_viz_dom_sl_node:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_x_tl }
    \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_x_fp
    {
      \l_semio_viz_dom_xa_fp + 3
      + ( \l_semio_viz_dom_cell_tl - \l_semio_viz_dom_lo_fp )
        * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp - 6 )
        / max ( 1e-9 , \l_semio_viz_dom_hi_fp - \l_semio_viz_dom_lo_fp )
    }
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_y_tl }
    \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_y_fp
    {
      \l_semio_viz_dom_ya_fp + 3
      + ( \l_semio_viz_dom_cell_tl - \l_semio_viz_dom_lo_b_fp )
        * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp - 6 )
        / max ( 1e-9 , \l_semio_viz_dom_hi_b_fp - \l_semio_viz_dom_lo_b_fp )
    }
  \seq_put_right:Nx \l_semio_viz_dom_stack_seq
    { \fp_eval:n { \l_semio_viz_dom_x_fp } , \fp_eval:n { \l_semio_viz_dom_y_fp } }
  \seq_put_right:Nx \l_semio_viz_dom_path_seq { \fp_eval:n { \l_semio_viz_dom_x_fp } }
  \seq_put_right:Nx \l_semio_viz_dom_path_seq { \fp_eval:n { \l_semio_viz_dom_y_fp } }
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_label_tl }
    \l_semio_viz_dom_cell_tl
  \seq_put_right:NV \l_semio_viz_dom_keys_seq \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \tl_if_empty:NT \l_semio_viz_dom_cell_tl { \tl_set:Nn \l_semio_viz_dom_cell_tl { 1 } }
  \seq_put_right:NV \l_semio_viz_dom_cols_seq \l_semio_viz_dom_cell_tl
}

% 🐝 Replaces the working positions by the collision-free swarm the kernel layout returns.
\cs_new_protected:Npn \semio_viz_dom_sl_swarm: {
  \use:x
    {
      \exp_not:N \semio_viz_layout_run:nnnn { beeswarm } { semio-dom-field } { semio-dom-out }
        { radius = \fp_eval:n { \l_semio_viz_dom_alpha_fp } }
    }
  \seq_clear:N \l_semio_viz_dom_path_seq
  \semio_viz_dom_point_count:nN { semio-dom-out } \l_semio_viz_dom_m_int
  \int_step_inline:nn { \l_semio_viz_dom_m_int } {
    \semio_viz_dom_point:nnNN { semio-dom-out } {##1} \l_semio_viz_dom_x_fp \l_semio_viz_dom_y_fp
    \seq_put_right:Nx \l_semio_viz_dom_path_seq { \fp_eval:n { \l_semio_viz_dom_x_fp } }
    \seq_put_right:Nx \l_semio_viz_dom_path_seq { \fp_eval:n { \l_semio_viz_dom_y_fp } }
  }
}

% 🔷 Draws the clipped Voronoi cells the kernel layout publishes as a geometry collection.
\cs_new_protected:Npn \semio_viz_dom_sl_cells: {
  \use:x
    {
      \exp_not:N \semio_viz_layout_run:nnnn { voronoi } { semio-dom-field } { semio-dom-cells }
        {
          x0 = \fp_eval:n { \l_semio_viz_dom_xa_fp } ,
          y0 = \fp_eval:n { \l_semio_viz_dom_ya_fp } ,
          x1 = \fp_eval:n { \l_semio_viz_dom_xb_fp } ,
          y1 = \fp_eval:n { \l_semio_viz_dom_yb_fp }
        }
    }
  \int_zero:N \l_semio_viz_dom_k_int
  \semio_viz_geom_map_inline:nn { semio-dom-cells }
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_sl_cell:nnnn ##1 }
}

% 🔷 One Voronoi cell; the ring arrives as `x,y;x,y;…` and becomes a flat polygon.
\cs_new_protected:Npn \semio_viz_dom_sl_cell:nnnn #1#2#3#4 {
  \seq_set_split:Nnn \l_semio_viz_dom_aux_seq { ; } {#4}
  \seq_clear:N \l_semio_viz_dom_stack_seq
  \seq_map_inline:Nn \l_semio_viz_dom_aux_seq
    { \seq_put_right:Nn \l_semio_viz_dom_stack_seq {##1} }
  \semio_viz_g_polygon:xn { \seq_use:Nn \l_semio_viz_dom_stack_seq { , } }
    {
      fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , fill~opacity = 0.14 ,
      draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline
    }
}

% 🧲 Deterministic collision relaxation: repulsion between overlapping nodes plus a pull to the
% frame centre, run for a fixed number of passes so print output never depends on a random seed.
\cs_new_protected:Npn \semio_viz_dom_sl_relax: {
  \int_step_inline:nn { \l_semio_viz_dom_iter_int } { \semio_viz_dom_sl_pass: }
}

% 🧲 One relaxation pass over every ordered pair of nodes.
\cs_new_protected:Npn \semio_viz_dom_sl_pass: {
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_row:n {##1} }
}

% 🧲 The partners of node #1 in one relaxation pass.
\cs_new_protected:Npn \semio_viz_dom_sl_row:n #1 {
  \int_step_inline:nn { \l_semio_viz_dom_n_int }
    { \int_compare:nNnT {#1} < {##1} { \semio_viz_dom_sl_pair:nn {#1} {##1} } }
}

% 🧲 Pushes two nodes apart when their bodies overlap.
\cs_new_protected:Npn \semio_viz_dom_sl_pair:nn #1#2 {
  \fp_set:Nn \l_semio_viz_dom_a_fp
    {
      \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#2) - 1 }
      - \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#1) - 1 }
    }
  \fp_set:Nn \l_semio_viz_dom_b_fp
    {
      \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#2) }
      - \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#1) }
    }
  \fp_set:Nn \l_semio_viz_dom_c_fp
    { max ( 1e-6 , sqrt ( \l_semio_viz_dom_a_fp ^ 2 + \l_semio_viz_dom_b_fp ^ 2 ) ) }
  \fp_compare:nNnT { \l_semio_viz_dom_c_fp } < { \l_semio_viz_dom_beta_fp } {
    \fp_set:Nn \l_semio_viz_dom_d_fp
      {
        ( \l_semio_viz_dom_beta_fp - \l_semio_viz_dom_c_fp ) / \l_semio_viz_dom_c_fp / 2
      }
    \semio_viz_dom_sl_shift:nnn {#1} { -\l_semio_viz_dom_a_fp * \l_semio_viz_dom_d_fp }
      { -\l_semio_viz_dom_b_fp * \l_semio_viz_dom_d_fp }
    \semio_viz_dom_sl_shift:nnn {#2} { \l_semio_viz_dom_a_fp * \l_semio_viz_dom_d_fp }
      { \l_semio_viz_dom_b_fp * \l_semio_viz_dom_d_fp }
  }
}

% 🧲 Moves node #1 by (#2,#3), clamped to the frame.
\cs_new_protected:Npn \semio_viz_dom_sl_shift:nnn #1#2#3 {
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) - 1 }
    {
      \fp_eval:n
        {
          min ( max ( \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#1) - 1 } + (#2) ,
                      \l_semio_viz_dom_xa_fp ) , \l_semio_viz_dom_xb_fp )
        }
    }
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) }
    {
      \fp_eval:n
        {
          min ( max ( \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#1) } + (#3) ,
                      \l_semio_viz_dom_ya_fp ) , \l_semio_viz_dom_yb_fp )
        }
    }
}

% 📐 Snaps every node onto the nearest of `columns` vertical and `rings` horizontal guides: the
% smallest constraint system that still reads as one, and the only one a print figure can show.
\cs_new_protected:Npn \semio_viz_dom_sl_align: {
  \bool_if:NT \l_semio_viz_dom_grid_bool { \semio_viz_dom_sl_guides: }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_snap:n {##1} }
}

% 📐 Draws the guide rules the constraint layout snaps to.
\cs_new_protected:Npn \semio_viz_dom_sl_guides: {
  \int_step_inline:nn { \l_semio_viz_dom_cols_int } {
    \semio_viz_g_line:nnnnn
      {
        \l_semio_viz_dom_xa_fp
        + ( ##1 - 0.5 ) * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
          / \l_semio_viz_dom_cols_int
      }
      { \l_semio_viz_dom_ya_fp }
      {
        \l_semio_viz_dom_xa_fp
        + ( ##1 - 0.5 ) * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
          / \l_semio_viz_dom_cols_int
      }
      { \l_semio_viz_dom_yb_fp }
      {
        draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline ,
        dash~pattern = on~0.4mm~off~0.5mm
      }
  }
}

% 📐 Snaps node #1 onto its nearest guide intersection.
\cs_new_protected:Npn \semio_viz_dom_sl_snap:n #1 {
  \fp_set:Nn \l_semio_viz_dom_a_fp
    {
      round
        (
          ( \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#1) - 1 } - \l_semio_viz_dom_xa_fp )
          * \l_semio_viz_dom_cols_int
          / max ( 1e-9 , \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ) + 0.5
        )
    }
  \fp_set:Nn \l_semio_viz_dom_a_fp
    { min ( max ( \l_semio_viz_dom_a_fp , 1 ) , \l_semio_viz_dom_cols_int ) }
  \fp_set:Nn \l_semio_viz_dom_b_fp
    {
      round
        (
          ( \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#1) } - \l_semio_viz_dom_ya_fp )
          * \l_semio_viz_dom_rows_int
          / max ( 1e-9 , \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp ) + 0.5
        )
    }
  \fp_set:Nn \l_semio_viz_dom_b_fp
    { min ( max ( \l_semio_viz_dom_b_fp , 1 ) , \l_semio_viz_dom_rows_int ) }
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) - 1 }
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_xa_fp
          + ( \l_semio_viz_dom_a_fp - 0.5 )
            * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ) / \l_semio_viz_dom_cols_int
        }
    }
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) }
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_ya_fp
          + ( \l_semio_viz_dom_b_fp - 0.5 )
            * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp ) / \l_semio_viz_dom_rows_int
        }
    }
}

% 🔳 Places node #1 at the row-major grid slot of index #1.
\cs_new_protected:Npn \semio_viz_dom_sl_grid:n #1 {
  \fp_set:Nn \l_semio_viz_dom_a_fp
    { \int_mod:nn { (#1) - 1 } { \l_semio_viz_dom_cols_int } }
  \fp_set:Nn \l_semio_viz_dom_b_fp
    { floor ( ( (#1) - 1 ) / \l_semio_viz_dom_cols_int ) }
  \fp_set:Nn \l_semio_viz_dom_c_fp
    { ceil ( \l_semio_viz_dom_n_int / \l_semio_viz_dom_cols_int ) }
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) - 1 }
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_xa_fp
          + ( \l_semio_viz_dom_a_fp + 0.5 )
            * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ) / \l_semio_viz_dom_cols_int
        }
    }
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) }
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_yb_fp
          - ( \l_semio_viz_dom_b_fp + 0.5 )
            * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
            / max ( 1 , \l_semio_viz_dom_c_fp )
        }
    }
}

% 🔳 Panel frames of the small-multiple layout, one cell per grid slot.
\cs_new_protected:Npn \semio_viz_dom_sl_panels: {
  \fp_set:Nn \l_semio_viz_dom_w_fp
    { ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ) / \l_semio_viz_dom_cols_int }
  \fp_set:Nn \l_semio_viz_dom_c_fp
    { ceil ( \l_semio_viz_dom_n_int / \l_semio_viz_dom_cols_int ) }
  \fp_set:Nn \l_semio_viz_dom_h_fp
    {
      ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
      / max ( 1 , \l_semio_viz_dom_c_fp )
    }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_panel:n {##1} }
}

% 🔳 One panel frame.
\cs_new_protected:Npn \semio_viz_dom_sl_panel:n #1 {
  \semio_viz_g_rect:nnnnn
    {
      \l_semio_viz_dom_xa_fp
      + \int_mod:nn { (#1) - 1 } { \l_semio_viz_dom_cols_int } * \l_semio_viz_dom_w_fp + 0.3
    }
    {
      \l_semio_viz_dom_yb_fp
      - ( floor ( ( (#1) - 1 ) / \l_semio_viz_dom_cols_int ) + 1 ) * \l_semio_viz_dom_h_fp + 0.3
    }
    { \l_semio_viz_dom_w_fp - 0.6 } { \l_semio_viz_dom_h_fp - 0.6 }
    { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline , fill = none }
}

% 🌀 Places node #1 on a ring, a square block or an Archimedean spiral.
\cs_new_protected:Npn \semio_viz_dom_sl_polar:n #1 {
  \fp_set:Nn \l_semio_viz_dom_a_fp
    { 6.2831853 * ( (#1) - 1 ) / max ( 1 , \l_semio_viz_dom_n_int ) }
  \str_if_eq:VnTF \l_semio_viz_dom_mode_tl { spiral }
    {
      \fp_set:Nn \l_semio_viz_dom_a_fp
        { \l_semio_viz_dom_beta_fp * ( (#1) - 1 ) * 0.9 }
      \fp_set:Nn \l_semio_viz_dom_c_fp
        { \l_semio_viz_dom_beta_fp * ( (#1) - 1 ) * 0.55 }
    }
    {
      \fp_set:Nn \l_semio_viz_dom_c_fp
        {
          ( 0.35 + 0.65 * \int_mod:nn { (#1) - 1 } { \l_semio_viz_dom_rows_int }
            / max ( 1 , \l_semio_viz_dom_rows_int - 1 ) )
          * min ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ,
                  \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp ) / 2
        }
    }
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) - 1 }
    {
      \fp_eval:n
        {
          ( \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_xb_fp ) / 2
          + 1.6 * \l_semio_viz_dom_c_fp * cos ( \l_semio_viz_dom_a_fp )
        }
    }
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) }
    {
      \fp_eval:n
        {
          ( \l_semio_viz_dom_ya_fp + \l_semio_viz_dom_yb_fp ) / 2
          + \l_semio_viz_dom_c_fp * sin ( \l_semio_viz_dom_a_fp )
        }
    }
}

% 🪜 Places node #1 on the row its value rank selects and spreads the row over the frame width.
\cs_new_protected:Npn \semio_viz_dom_sl_layer:n #1 {
  \fp_set:Nn \l_semio_viz_dom_a_fp
    { \int_mod:nn { (#1) - 1 } { \l_semio_viz_dom_rows_int } }
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) - 1 }
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_xa_fp
          + ( floor ( ( (#1) - 1 ) / \l_semio_viz_dom_rows_int ) + 0.5 )
            * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
            / max ( 1 , ceil ( \l_semio_viz_dom_n_int / \l_semio_viz_dom_rows_int ) )
        }
    }
  \seq_set_item:Nnx \l_semio_viz_dom_path_seq { 2 * (#1) }
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_yb_fp
          - ( \l_semio_viz_dom_a_fp + 0.5 )
            * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp ) / \l_semio_viz_dom_rows_int
        }
    }
}

% ⚪ Draws the placed field: one disc per node, its area carrying the size channel.
\cs_new_protected:Npn \semio_viz_dom_sl_draw: {
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_dot:n {##1} }
}

% ⚪ One node disc plus its caption.
\cs_new_protected:Npn \semio_viz_dom_sl_dot:n #1 {
  \fp_set:Nn \l_semio_viz_dom_x_fp
    { \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#1) - 1 } }
  \fp_set:Nn \l_semio_viz_dom_y_fp
    { \seq_item:Nn \l_semio_viz_dom_path_seq { 2 * (#1) } }
  \semio_viz_g_circle:nnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_y_fp }
    {
      \l_semio_viz_dom_gamma_fp
      * sqrt ( max ( 0.2 , \seq_item:Nn \l_semio_viz_dom_cols_seq {#1} / 10 ) )
    }
    { fill = \semio_viz_palette:n {#1} , draw = none , fill~opacity = 0.85 }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp }
      { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_gamma_fp + 0.6 } { south }
      { \seq_item:Nn \l_semio_viz_dom_keys_seq {#1} }
  }
}

% 📐 spatial-layout: taxonomy §47. Ten placement algorithms over one node field; two of them are
% the kernel's own §75/§78 layouts, the others are computed here from the same point set.
\SemioVizFamily { spatial-layout } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-scatter }
  \tl_set:Nn \l_semio_viz_dom_x_tl { x }
  \tl_set:Nn \l_semio_viz_dom_y_tl { y }
  \tl_set:Nn \l_semio_viz_dom_value_tl { size }
  \tl_set:Nn \l_semio_viz_dom_label_tl { label }
  \tl_set:Nn \l_semio_viz_dom_group_tl { grp }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { grid }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 2.4 }
  \fp_set:Nn \l_semio_viz_dom_beta_fp { 2 }
  \fp_set:Nn \l_semio_viz_dom_gamma_fp { 1.1 }
  \int_set:Nn \l_semio_viz_dom_cols_int { 5 }
  \int_set:Nn \l_semio_viz_dom_rows_int { 2 }
  \int_set:Nn \l_semio_viz_dom_iter_int { 24 }
  \keys_set:nn { semio / viz / family / spatial-layout } {#1}
  \semio_viz_dom_frame:
  \semio_viz_dom_sl_field:
  \str_case:VnF \l_semio_viz_dom_mode_tl
    {
      { beeswarm } { \semio_viz_dom_sl_swarm: }
      { voronoi } { \semio_viz_dom_sl_cells: }
      { relax } { \semio_viz_dom_sl_relax: }
      { align } { \semio_viz_dom_sl_align: }
      { matrix }
        {
          \int_set:Nn \l_semio_viz_dom_cols_int
            { \fp_to_int:n { ceil ( sqrt ( \l_semio_viz_dom_n_int ) ) } }
          \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_grid:n {##1} }
        }
      { layered }
        { \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_layer:n {##1} } }
      { radial }
        { \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_polar:n {##1} } }
      { spiral }
        { \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_polar:n {##1} } }
    }
    {
      \bool_if:NT \l_semio_viz_dom_grid_bool { \semio_viz_dom_sl_panels: }
      \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sl_grid:n {##1} }
    }
  \semio_viz_dom_sl_draw:
}
%endregion 🔖️SpatialLayout

%region 🔖️Partition
% 🌲 The stratified reader every partition-shaped domain family shares: parent, depth, own value
% and caption of each node, and the tree's greatest depth.
\cs_new_protected:Npn \semio_viz_dom_tree_load: {
  \prop_clear:N \l_semio_viz_dom_par_prop
  \prop_clear:N \l_semio_viz_dom_dep_prop
  \prop_clear:N \l_semio_viz_dom_bag_prop
  \prop_clear:N \l_semio_viz_dom_lab_prop
  \prop_clear:N \l_semio_viz_dom_sum_prop
  \seq_clear:N \l_semio_viz_dom_keys_seq
  \int_set:Nn \l_semio_viz_dom_rows_int { 1 }
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_tree_row:n {##1} }
  \int_step_inline:nn { \l_semio_viz_dom_rows_int - 1 }
    { \semio_viz_dom_tree_fold:n { \l_semio_viz_dom_rows_int - ##1 + 1 } }
}

% 🌲 One stratified row: its parent, its depth, its own value and its caption.
\cs_new_protected:Npn \semio_viz_dom_tree_row:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_group_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \tl_if_empty:NT \l_semio_viz_dom_cell_tl { \tl_set:Nn \l_semio_viz_dom_cell_tl { 0 } }
  \seq_put_right:NV \l_semio_viz_dom_keys_seq \l_semio_viz_dom_key_tl
  \prop_put:NVV \l_semio_viz_dom_par_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_tmp_tl
  \prop_put:NVV \l_semio_viz_dom_bag_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_sum_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_label_tl }
    \l_semio_viz_dom_cell_tl
  \prop_put:NVV \l_semio_viz_dom_lab_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \tl_if_empty:NTF \l_semio_viz_dom_tmp_tl
    { \prop_put:NVn \l_semio_viz_dom_dep_prop \l_semio_viz_dom_key_tl { 1 } }
    {
      \prop_get:NVNTF \l_semio_viz_dom_dep_prop \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_cell_tl
        {
          \prop_put:NVx \l_semio_viz_dom_dep_prop \l_semio_viz_dom_key_tl
            { \int_eval:n { \l_semio_viz_dom_cell_tl + 1 } }
        }
        { \prop_put:NVn \l_semio_viz_dom_dep_prop \l_semio_viz_dom_key_tl { 2 } }
    }
  \prop_get:NVN \l_semio_viz_dom_dep_prop \l_semio_viz_dom_key_tl \l_semio_viz_dom_cell_tl
  \int_compare:nNnT { \l_semio_viz_dom_cell_tl } > { \l_semio_viz_dom_rows_int }
    { \int_set:Nn \l_semio_viz_dom_rows_int { \l_semio_viz_dom_cell_tl } }
}

% 🌲 Folds every node of depth #1 into its parent's subtree total.
\cs_new_protected:Npn \semio_viz_dom_tree_fold:n #1 {
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \semio_viz_dom_tree_add:nn {##1} {#1} }
}

% 🌲 Adds node #1's total to its parent when its depth is #2.
\cs_new_protected:Npn \semio_viz_dom_tree_add:nn #1#2 {
  \prop_get:NnN \l_semio_viz_dom_dep_prop {#1} \l_semio_viz_dom_cell_tl
  \int_compare:nNnT { \l_semio_viz_dom_cell_tl } = { \int_eval:n {#2} } {
    \prop_get:NnN \l_semio_viz_dom_par_prop {#1} \l_semio_viz_dom_tmp_tl
    \tl_if_empty:NF \l_semio_viz_dom_tmp_tl {
      \prop_get:NnN \l_semio_viz_dom_sum_prop {#1} \l_semio_viz_dom_key_tl
      \prop_get:NVN \l_semio_viz_dom_sum_prop \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_cell_tl
      \prop_put:NVx \l_semio_viz_dom_sum_prop \l_semio_viz_dom_tmp_tl
        { \fp_eval:n { \l_semio_viz_dom_cell_tl + \l_semio_viz_dom_key_tl } }
    }
  }
}

% 📐 Left offsets of every node: siblings follow one another inside their parent's span, which is
% exactly the d3 partition layout on a one-dimensional axis.
\cs_new_protected:Npn \semio_viz_dom_tree_offsets: {
  \prop_clear:N \l_semio_viz_dom_off_prop
  \prop_clear:N \l_semio_viz_dom_cur_prop
  \fp_zero:N \l_semio_viz_dom_hi_fp
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq { \semio_viz_dom_tree_root:n {##1} }
  \int_step_inline:nn { \l_semio_viz_dom_rows_int }
    { \semio_viz_dom_tree_level:n {##1} }
}

% 📐 Roots sit next to one another and together define the layout's total width.
\cs_new_protected:Npn \semio_viz_dom_tree_root:n #1 {
  \prop_get:NnN \l_semio_viz_dom_dep_prop {#1} \l_semio_viz_dom_cell_tl
  \int_compare:nNnT { \l_semio_viz_dom_cell_tl } = { 1 } {
    \prop_put:Nnx \l_semio_viz_dom_off_prop {#1} { \fp_eval:n { \l_semio_viz_dom_hi_fp } }
    \prop_get:NnN \l_semio_viz_dom_sum_prop {#1} \l_semio_viz_dom_key_tl
    \fp_add:Nn \l_semio_viz_dom_hi_fp { \l_semio_viz_dom_key_tl }
  }
}

% 📐 Places every node of depth #1 after its already placed siblings.
\cs_new_protected:Npn \semio_viz_dom_tree_level:n #1 {
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \semio_viz_dom_tree_slot:nn {##1} {#1} }
}

% 📐 One node's offset inside its parent's span.
\cs_new_protected:Npn \semio_viz_dom_tree_slot:nn #1#2 {
  \prop_get:NnN \l_semio_viz_dom_dep_prop {#1} \l_semio_viz_dom_cell_tl
  \int_compare:nNnT { \l_semio_viz_dom_cell_tl } = { \int_eval:n {#2} } {
    \prop_get:NnN \l_semio_viz_dom_par_prop {#1} \l_semio_viz_dom_tmp_tl
    \tl_if_empty:NF \l_semio_viz_dom_tmp_tl {
      \prop_get:NVNF \l_semio_viz_dom_cur_prop \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_key_tl
        { \prop_get:NVN \l_semio_viz_dom_off_prop \l_semio_viz_dom_tmp_tl \l_semio_viz_dom_key_tl }
      \prop_put:Nnx \l_semio_viz_dom_off_prop {#1} { \tl_use:N \l_semio_viz_dom_key_tl }
      \prop_get:NnN \l_semio_viz_dom_sum_prop {#1} \l_semio_viz_dom_cell_tl
      \prop_put:NVx \l_semio_viz_dom_cur_prop \l_semio_viz_dom_tmp_tl
        { \fp_eval:n { \l_semio_viz_dom_key_tl + \l_semio_viz_dom_cell_tl } }
    }
  }
}
%endregion 🔖️Partition

%region 🔖️Keys-performance
% 🔑 `performance` keys, l3keys family `semio / viz / family / performance`. §62 asks four
% different questions of one profile, so the family carries the partition renderer of the flame
% shapes, the indented call tree, the latency distribution and the call graph.
% variant     (tl)      catalogue slug
% data        (table)   stratified profile, distribution or edge table  default `demo-hierarchy-deep`
% id          (column)  frame identity                                  default `id`
% parent      (column)  calling frame, empty at a root                  default `parent`
% value       (column)  self time                                       default `value`
% label       (column)  frame caption                                   default `label`
% mode        (choice `flame|icicle|tree|histogram|graph`)               default `flame`
% orientation (choice `bottom-up|top-down`) growth direction of the rows default `bottom-up`
% order       (choice `none|value|label`) sibling order                  default `none`
% bins        (int)     bins of the latency histogram                    default 12
% percentiles (clist)   marked quantiles of the latency histogram        default empty
% rowgap      (mm)      gap between two depth rows                       default 0.4
% labels      (bool)    print frame captions                             default true
\clist_new:N \l_semio_viz_dom_marks_clist
\keys_define:nn { semio / viz / family / performance } {
  data        .tl_set:N    = \l_semio_viz_dom_data_tl,
  id          .tl_set:N    = \l_semio_viz_dom_id_tl,
  parent      .tl_set:N    = \l_semio_viz_dom_group_tl,
  value       .tl_set:N    = \l_semio_viz_dom_value_tl,
  label       .tl_set:N    = \l_semio_viz_dom_label_tl,
  source      .tl_set:N    = \l_semio_viz_dom_id_tl,
  target      .tl_set:N    = \l_semio_viz_dom_second_tl,
  mode        .tl_set:N    = \l_semio_viz_dom_mode_tl,
  orientation .tl_set:N    = \l_semio_viz_dom_shape_tl,
  order       .tl_set:N    = \l_semio_viz_dom_order_tl,
  bins        .int_set:N   = \l_semio_viz_dom_bins_int,
  percentiles .clist_set:N = \l_semio_viz_dom_marks_clist,
  rowgap      .fp_set:N    = \l_semio_viz_dom_alpha_fp,
  pad         .fp_set:N    = \l_semio_viz_dom_pad_fp,
  width       .fp_set:N    = \l_semio_viz_dom_width_fp,
  height      .fp_set:N    = \l_semio_viz_dom_height_fp,
  labels      .bool_set:N  = \l_semio_viz_dom_labels_bool,
  unknown     .code:n      = { },
}
%endregion 🔖️Keys-performance

%region 🔖️Performance
% 🔥 The flame shapes: one rectangle per frame, its width the subtree total, its row the depth.
\cs_new_protected:Npn \semio_viz_dom_pf_flame: {
  \semio_viz_dom_tree_load:
  \semio_viz_dom_tree_offsets:
  \fp_set:Nn \l_semio_viz_dom_h_fp
    {
      ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
      / max ( 1 , \l_semio_viz_dom_rows_int )
    }
  \fp_set:Nn \l_semio_viz_dom_w_fp
    {
      ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
      / max ( 1e-9 , \l_semio_viz_dom_hi_fp )
    }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_pf_frame:n {##1} }
}

% 🔥 One frame rectangle.
\cs_new_protected:Npn \semio_viz_dom_pf_frame:n #1 {
  \prop_get:NnN \l_semio_viz_dom_dep_prop {#1} \l_semio_viz_dom_cell_tl
  \prop_get:NnN \l_semio_viz_dom_off_prop {#1} \l_semio_viz_dom_key_tl
  \prop_get:NnN \l_semio_viz_dom_sum_prop {#1} \l_semio_viz_dom_tmp_tl
  \fp_set:Nn \l_semio_viz_dom_x_fp
    { \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_key_tl * \l_semio_viz_dom_w_fp }
  \str_if_eq:VnTF \l_semio_viz_dom_shape_tl { top-down }
    {
      \fp_set:Nn \l_semio_viz_dom_y_fp
        { \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_cell_tl * \l_semio_viz_dom_h_fp }
    }
    {
      \fp_set:Nn \l_semio_viz_dom_y_fp
        {
          \l_semio_viz_dom_ya_fp
          + ( \l_semio_viz_dom_cell_tl - 1 ) * \l_semio_viz_dom_h_fp
        }
    }
  \fp_set:Nn \l_semio_viz_dom_b_fp
    { \l_semio_viz_dom_tmp_tl * \l_semio_viz_dom_w_fp }
  \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_x_fp }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_alpha_fp / 2 }
    { max ( 0.2 , \l_semio_viz_dom_b_fp ) }
    { \l_semio_viz_dom_h_fp - \l_semio_viz_dom_alpha_fp }
    {
      fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , fill~opacity = 0.75 ,
      draw = semio-chrome-canvas , line~width = \semio@stroke@hairline
    }
  \bool_lazy_and:nnT
    { \l_semio_viz_dom_labels_bool }
    { \fp_compare_p:n { \l_semio_viz_dom_b_fp > 6 } }
    {
      \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp + 0.8 }
        { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_h_fp / 2 } { west }
        { \prop_item:Nn \l_semio_viz_dom_lab_prop {#1} }
    }
}

% 🌳 The indented call tree: one row per frame, its indent the depth, its bar the subtree total.
\cs_new_protected:Npn \semio_viz_dom_pf_tree: {
  \semio_viz_dom_tree_load:
  \semio_viz_dom_tree_offsets:
  \fp_set:Nn \l_semio_viz_dom_h_fp
    {
      ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
      / max ( 1 , \l_semio_viz_dom_n_int )
    }
  \fp_set:Nn \l_semio_viz_dom_w_fp
    {
      ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp - 14 )
      / max ( 1e-9 , \l_semio_viz_dom_hi_fp )
    }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_pf_row:n {##1} }
}

% 🌳 One call-tree row: the indent rule, the caption and the total bar.
\cs_new_protected:Npn \semio_viz_dom_pf_row:n #1 {
  \prop_get:NnN \l_semio_viz_dom_dep_prop {#1} \l_semio_viz_dom_cell_tl
  \prop_get:NnN \l_semio_viz_dom_sum_prop {#1} \l_semio_viz_dom_tmp_tl
  \fp_set:Nn \l_semio_viz_dom_y_fp
    {
      \l_semio_viz_dom_yb_fp
      - ( \l_semio_viz_dom_k_int - 0.5 ) * \l_semio_viz_dom_h_fp
    }
  \fp_set:Nn \l_semio_viz_dom_x_fp
    { \l_semio_viz_dom_xa_fp + ( \l_semio_viz_dom_cell_tl - 1 ) * 2.4 }
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp }
    { \l_semio_viz_dom_y_fp + \l_semio_viz_dom_h_fp / 2 } { \l_semio_viz_dom_x_fp }
    { \l_semio_viz_dom_y_fp }
    { draw = semio-chrome-border-normal , line~width = \semio@stroke@hairline }
  \semio_viz_g_rect:nnnnn { \l_semio_viz_dom_xa_fp + 14 }
    { \l_semio_viz_dom_y_fp - \l_semio_viz_dom_h_fp * 0.32 }
    { max ( 0.2 , \l_semio_viz_dom_tmp_tl * \l_semio_viz_dom_w_fp ) }
    { \l_semio_viz_dom_h_fp * 0.64 }
    {
      fill = \semio_viz_palette:n { \l_semio_viz_dom_cell_tl } , fill~opacity = 0.7 ,
      draw = none
    }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \l_semio_viz_dom_x_fp + 0.8 } { \l_semio_viz_dom_y_fp } { west }
      { \prop_item:Nn \l_semio_viz_dom_lab_prop {#1} }
  }
}

% ⏱️ The latency distribution: equal-width bins of the value column plus the marked quantiles.
\cs_new_protected:Npn \semio_viz_dom_pf_histogram: {
  \semio_viz_table_col_values:nnN { \l_semio_viz_dom_data_tl } { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_aux_seq
  \semio_viz_table_col_min:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_lo_fp
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \seq_clear:N \l_semio_viz_dom_stack_seq
  \int_step_inline:nn { \l_semio_viz_dom_bins_int }
    { \seq_put_right:Nn \l_semio_viz_dom_stack_seq { 0 } }
  \seq_map_inline:Nn \l_semio_viz_dom_aux_seq { \semio_viz_dom_pf_bin:n {##1} }
  \fp_set:Nn \l_semio_viz_dom_c_fp { 1 }
  \seq_map_inline:Nn \l_semio_viz_dom_stack_seq
    { \fp_set:Nn \l_semio_viz_dom_c_fp { max ( \l_semio_viz_dom_c_fp , ##1 ) } }
  \fp_set:Nn \l_semio_viz_dom_w_fp
    {
      ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ) / \l_semio_viz_dom_bins_int
    }
  \int_step_inline:nn { \l_semio_viz_dom_bins_int } { \semio_viz_dom_pf_bar:n {##1} }
  \clist_map_inline:Nn \l_semio_viz_dom_marks_clist { \semio_viz_dom_pf_mark:n {##1} }
}

% ⏱️ Counts one observation into its bin.
\cs_new_protected:Npn \semio_viz_dom_pf_bin:n #1 {
  \int_set:Nn \l_semio_viz_dom_j_int
    {
      \fp_to_int:n
        {
          min ( \l_semio_viz_dom_bins_int ,
                1 + floor ( ( (#1) - \l_semio_viz_dom_lo_fp ) * \l_semio_viz_dom_bins_int
                            / max ( 1e-9 , \l_semio_viz_dom_hi_fp - \l_semio_viz_dom_lo_fp ) ) )
        }
    }
  \seq_set_item:Nnx \l_semio_viz_dom_stack_seq { \l_semio_viz_dom_j_int }
    {
      \int_eval:n { \seq_item:Nn \l_semio_viz_dom_stack_seq { \l_semio_viz_dom_j_int } + 1 }
    }
}

% ⏱️ One histogram bar.
\cs_new_protected:Npn \semio_viz_dom_pf_bar:n #1 {
  \semio_viz_g_rect:nnnnn
    { \l_semio_viz_dom_xa_fp + ( (#1) - 1 ) * \l_semio_viz_dom_w_fp + 0.15 }
    { \l_semio_viz_dom_ya_fp } { \l_semio_viz_dom_w_fp - 0.3 }
    {
      \seq_item:Nn \l_semio_viz_dom_stack_seq {#1} / \l_semio_viz_dom_c_fp
      * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
    }
    { fill = \semio_viz_palette:n { 1 } , fill~opacity = 0.7 , draw = none }
}

% ⏱️ A quantile rule across the distribution.
\cs_new_protected:Npn \semio_viz_dom_pf_mark:n #1 {
  \semio_viz_table_col_quantile:nnnN { \l_semio_viz_dom_data_tl } { \l_semio_viz_dom_value_tl }
    {#1} \l_semio_viz_dom_d_fp
  \fp_set:Nn \l_semio_viz_dom_x_fp
    {
      \l_semio_viz_dom_xa_fp
      + ( \l_semio_viz_dom_d_fp - \l_semio_viz_dom_lo_fp )
        * ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
        / max ( 1e-9 , \l_semio_viz_dom_hi_fp - \l_semio_viz_dom_lo_fp )
    }
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_ya_fp }
    { \l_semio_viz_dom_x_fp } { \l_semio_viz_dom_yb_fp }
    {
      draw = \semio_viz_palette:n { 2 } , line~width = \semio@stroke@hairline ,
      dash~pattern = on~0.6mm~off~0.4mm
    }
}

% 🕸️ The call graph: services on a ring, calls as chords whose width carries the call volume.
\cs_new_protected:Npn \semio_viz_dom_pf_graph: {
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_id_tl
    \l_semio_viz_dom_keys_seq
  \semio_viz_dom_levels:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_second_tl
    \l_semio_viz_dom_aux_seq
  \seq_map_inline:Nn \l_semio_viz_dom_aux_seq
    {
      \seq_if_in:NnF \l_semio_viz_dom_keys_seq {##1}
        { \seq_put_right:Nn \l_semio_viz_dom_keys_seq {##1} }
    }
  \int_set:Nn \l_semio_viz_dom_m_int { \seq_count:N \l_semio_viz_dom_keys_seq }
  \prop_clear:N \l_semio_viz_dom_pos_prop
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_pf_ring:n {##1} }
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \semio_viz_table_col_max:VVN \l_semio_viz_dom_data_tl \l_semio_viz_dom_value_tl
    \l_semio_viz_dom_hi_fp
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_pf_call:n {##1} }
  \int_zero:N \l_semio_viz_dom_k_int
  \seq_map_inline:Nn \l_semio_viz_dom_keys_seq
    { \int_incr:N \l_semio_viz_dom_k_int \semio_viz_dom_pf_vertex:n {##1} }
}

% 🕸️ Stores the ring position of one vertex.
\cs_new_protected:Npn \semio_viz_dom_pf_ring:n #1 {
  \fp_set:Nn \l_semio_viz_dom_a_fp
    { 6.2831853 * ( \l_semio_viz_dom_k_int - 1 ) / max ( 1 , \l_semio_viz_dom_m_int ) }
  \fp_set:Nn \l_semio_viz_dom_c_fp
    {
      min ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp ,
            \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp ) / 2 - 1
    }
  \prop_put:Nnx \l_semio_viz_dom_pos_prop {#1}
    {
      \fp_eval:n
        {
          ( \l_semio_viz_dom_xa_fp + \l_semio_viz_dom_xb_fp ) / 2
          + 1.5 * \l_semio_viz_dom_c_fp * cos ( \l_semio_viz_dom_a_fp )
        }
      ,
      \fp_eval:n
        {
          ( \l_semio_viz_dom_ya_fp + \l_semio_viz_dom_yb_fp ) / 2
          + \l_semio_viz_dom_c_fp * sin ( \l_semio_viz_dom_a_fp )
        }
    }
}

% 🕸️ One call edge between two ring positions.
\cs_new_protected:Npn \semio_viz_dom_pf_call:n #1 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_id_tl }
    \l_semio_viz_dom_key_tl
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_second_tl }
    \l_semio_viz_dom_tmp_tl
  \semio_viz_table_cell_opt:nnnN { \l_semio_viz_dom_data_tl } {#1} { \l_semio_viz_dom_value_tl }
    \l_semio_viz_dom_cell_tl
  \tl_if_empty:NT \l_semio_viz_dom_cell_tl { \tl_set:Nn \l_semio_viz_dom_cell_tl { 1 } }
  \semio_viz_dom_pf_pair:VV \l_semio_viz_dom_key_tl \l_semio_viz_dom_tmp_tl
}

% 🕸️ Draws the connector between the ring positions of #1 and #2.
\cs_new_protected:Npn \semio_viz_dom_pf_pair:nn #1#2 {
  \prop_get:NnN \l_semio_viz_dom_pos_prop {#1} \l_semio_viz_dom_key_tl
  \prop_get:NnN \l_semio_viz_dom_pos_prop {#2} \l_semio_viz_dom_tmp_tl
  \seq_set_split:NnV \l_semio_viz_dom_aux_seq { , } \l_semio_viz_dom_key_tl
  \fp_set:Nn \l_semio_viz_dom_a_fp { \seq_item:Nn \l_semio_viz_dom_aux_seq { 1 } }
  \fp_set:Nn \l_semio_viz_dom_b_fp { \seq_item:Nn \l_semio_viz_dom_aux_seq { 2 } }
  \seq_set_split:NnV \l_semio_viz_dom_aux_seq { , } \l_semio_viz_dom_tmp_tl
  \semio_viz_dom_edge:nnnnn { \l_semio_viz_dom_a_fp } { \l_semio_viz_dom_b_fp }
    { \seq_item:Nn \l_semio_viz_dom_aux_seq { 1 } }
    { \seq_item:Nn \l_semio_viz_dom_aux_seq { 2 } }
    {
      0.1 + 0.5 * \l_semio_viz_dom_cell_tl / max ( 1e-9 , \l_semio_viz_dom_hi_fp )
    }
}
\cs_generate_variant:Nn \semio_viz_dom_pf_pair:nn { VV }

% 🕸️ One graph vertex.
\cs_new_protected:Npn \semio_viz_dom_pf_vertex:n #1 {
  \prop_get:NnN \l_semio_viz_dom_pos_prop {#1} \l_semio_viz_dom_key_tl
  \seq_set_split:NnV \l_semio_viz_dom_aux_seq { , } \l_semio_viz_dom_key_tl
  \semio_viz_g_circle:nnnn { \seq_item:Nn \l_semio_viz_dom_aux_seq { 1 } }
    { \seq_item:Nn \l_semio_viz_dom_aux_seq { 2 } } { 1.2 }
    { fill = \semio_viz_palette:n { \l_semio_viz_dom_k_int } , draw = none }
  \bool_if:NT \l_semio_viz_dom_labels_bool {
    \semio_viz_g_text:nnnn { \seq_item:Nn \l_semio_viz_dom_aux_seq { 1 } }
      { \fp_eval:n { \seq_item:Nn \l_semio_viz_dom_aux_seq { 2 } + 1.6 } } { south } {#1}
  }
}

% 🔥 performance: taxonomy §62. Flame shapes, the call tree, the latency distribution and the
% service call graph, all option sets over one profile reader.
\SemioVizFamily { performance } {
  \semio_viz_dom_reset:
  \tl_set:Nn \l_semio_viz_dom_data_tl { demo-hierarchy-deep }
  \tl_set:Nn \l_semio_viz_dom_id_tl { id }
  \tl_set:Nn \l_semio_viz_dom_group_tl { parent }
  \tl_set:Nn \l_semio_viz_dom_value_tl { value }
  \tl_set:Nn \l_semio_viz_dom_label_tl { label }
  \tl_set:Nn \l_semio_viz_dom_second_tl { target }
  \tl_set:Nn \l_semio_viz_dom_mode_tl { flame }
  \tl_set:Nn \l_semio_viz_dom_shape_tl { bottom-up }
  \fp_set:Nn \l_semio_viz_dom_alpha_fp { 0.4 }
  \int_set:Nn \l_semio_viz_dom_bins_int { 12 }
  \clist_clear:N \l_semio_viz_dom_marks_clist
  \keys_set:nn { semio / viz / family / performance } {#1}
  \semio_viz_dom_frame:
  \str_case:VnF \l_semio_viz_dom_mode_tl
    {
      { tree } { \semio_viz_dom_pf_tree: }
      { histogram } { \semio_viz_dom_pf_histogram: }
      { graph } { \semio_viz_dom_pf_graph: }
    }
    { \semio_viz_dom_pf_flame: }
}
%endregion 🔖️Performance

%region 🔖️Series
% 📈 The multi-series cartesian renderer shared by the two families whose charts are a set of
% named columns over a time axis: §16 delivery burn charts and §64 repository churn.
\cs_new_protected:Npn \semio_viz_dom_sr_extent: {
  \semio_viz_table_nrows:VN \l_semio_viz_dom_data_tl \l_semio_viz_dom_n_int
  \fp_zero:N \l_semio_viz_dom_lo_fp
  \fp_set:Nn \l_semio_viz_dom_hi_fp { 1e-9 }
  \int_zero:N \l_semio_viz_dom_j_int
  \clist_map_inline:Nn \l_semio_viz_dom_series_clist { \semio_viz_dom_sr_span:n {##1} }
  \bool_if:NT \l_semio_viz_dom_fill_bool { \semio_viz_dom_sr_stacked_span: }
  \bool_if:NT \l_semio_viz_dom_mirror_bool
    { \fp_set:Nn \l_semio_viz_dom_lo_fp { - \l_semio_viz_dom_hi_fp } }
  \fp_set:Nn \l_semio_viz_dom_w_fp
    {
      ( \l_semio_viz_dom_xb_fp - \l_semio_viz_dom_xa_fp )
      / max ( 1 , \l_semio_viz_dom_n_int - 1 )
    }
}

% 📐 Widens the value extent by one series column.
\cs_new_protected:Npn \semio_viz_dom_sr_span:n #1 {
  \int_incr:N \l_semio_viz_dom_j_int
  \semio_viz_table_col_max:VnN \l_semio_viz_dom_data_tl {#1} \l_semio_viz_dom_c_fp
  \fp_set:Nn \l_semio_viz_dom_hi_fp { max ( \l_semio_viz_dom_hi_fp , \l_semio_viz_dom_c_fp ) }
  \semio_viz_table_col_min:VnN \l_semio_viz_dom_data_tl {#1} \l_semio_viz_dom_c_fp
  \fp_set:Nn \l_semio_viz_dom_lo_fp { min ( \l_semio_viz_dom_lo_fp , \l_semio_viz_dom_c_fp ) }
}

% 📐 A stacked chart's ceiling is the largest column total, not the largest single value.
\cs_new_protected:Npn \semio_viz_dom_sr_stacked_span: {
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sr_total:n {##1} }
}

% 📐 The total of every series at row #1.
\cs_new_protected:Npn \semio_viz_dom_sr_total:n #1 {
  \fp_zero:N \l_semio_viz_dom_d_fp
  \clist_map_inline:Nn \l_semio_viz_dom_series_clist
    {
      \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#1} {##1} \l_semio_viz_dom_cell_tl
      \fp_add:Nn \l_semio_viz_dom_d_fp { \l_semio_viz_dom_cell_tl }
    }
  \fp_set:Nn \l_semio_viz_dom_hi_fp { max ( \l_semio_viz_dom_hi_fp , \l_semio_viz_dom_d_fp ) }
}

% 📏 Frame ordinate of a value.
\cs_new:Npn \semio_viz_dom_sr_y:n #1 {
  \fp_eval:n
    {
      \l_semio_viz_dom_ya_fp
      + ( (#1) - \l_semio_viz_dom_lo_fp ) * ( \l_semio_viz_dom_yb_fp - \l_semio_viz_dom_ya_fp )
        / max ( 1e-9 , \l_semio_viz_dom_hi_fp - \l_semio_viz_dom_lo_fp )
    }
}

% 📈 Draws every listed series in the active mode, plus the optional zero rule and reference line.
\cs_new_protected:Npn \semio_viz_dom_sr_run: {
  \semio_viz_dom_sr_extent:
  \bool_if:NT \l_semio_viz_dom_grid_bool {
    \semio_viz_g_line:nnnnn { \l_semio_viz_dom_xa_fp } { \semio_viz_dom_sr_y:n { 0 } }
      { \l_semio_viz_dom_xb_fp } { \semio_viz_dom_sr_y:n { 0 } }
      { draw = semio-chrome-border-emphasized , line~width = \semio@stroke@hairline }
  }
  \seq_clear:N \l_semio_viz_dom_stack_seq
  \int_step_inline:nn { \l_semio_viz_dom_n_int }
    { \seq_put_right:Nn \l_semio_viz_dom_stack_seq { 0 } }
  \int_zero:N \l_semio_viz_dom_j_int
  \int_set:Nn \l_semio_viz_dom_m_int { \clist_count:N \l_semio_viz_dom_series_clist }
  \clist_map_inline:Nn \l_semio_viz_dom_series_clist { \semio_viz_dom_sr_series:n {##1} }
  \bool_if:NT \l_semio_viz_dom_highlight_bool { \semio_viz_dom_sr_reference: }
}

% 📈 One series column in the active mode.
\cs_new_protected:Npn \semio_viz_dom_sr_series:n #1 {
  \int_incr:N \l_semio_viz_dom_j_int
  \fp_set:Nn \l_semio_viz_dom_b_fp { 1 }
  \bool_lazy_and:nnT
    { \l_semio_viz_dom_mirror_bool }
    { \int_compare_p:nNn { \l_semio_viz_dom_j_int } > { 1 } }
    { \fp_set:Nn \l_semio_viz_dom_b_fp { -1 } }
  \str_case:VnF \l_semio_viz_dom_mode_tl
    {
      { bar } { \semio_viz_dom_sr_bars:n {#1} }
      { area } { \semio_viz_dom_sr_area:n {#1} }
    }
    { \semio_viz_dom_sr_line:n {#1} }
}

% 📈 A polyline through the samples of column #1.
\cs_new_protected:Npn \semio_viz_dom_sr_line:n #1 {
  \seq_clear:N \l_semio_viz_dom_path_seq
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sr_point:nn {#1} {##1} }
  \semio_viz_g_polyline:xn { \seq_use:Nn \l_semio_viz_dom_path_seq { , } }
    {
      draw = \semio_viz_palette:n { \l_semio_viz_dom_j_int } ,
      line~width = \semio@stroke@default
    }
}

% 📈 Appends sample #2 of column #1 to the working path, honouring the running stack offset.
\cs_new_protected:Npn \semio_viz_dom_sr_point:nn #1#2 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#2} {#1} \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_c_fp
    { \l_semio_viz_dom_b_fp * \l_semio_viz_dom_cell_tl }
  \bool_if:NT \l_semio_viz_dom_fill_bool {
    \fp_add:Nn \l_semio_viz_dom_c_fp { \seq_item:Nn \l_semio_viz_dom_stack_seq {#2} }
    \seq_set_item:Nnx \l_semio_viz_dom_stack_seq {#2}
      { \fp_eval:n { \l_semio_viz_dom_c_fp } }
  }
  \seq_put_right:Nx \l_semio_viz_dom_path_seq
    { \fp_eval:n { \l_semio_viz_dom_xa_fp + ( (#2) - 1 ) * \l_semio_viz_dom_w_fp } }
  \seq_put_right:Nx \l_semio_viz_dom_path_seq
    { \semio_viz_dom_sr_y:n { \l_semio_viz_dom_c_fp } }
}

% 🌊 A filled band under the samples of column #1.
\cs_new_protected:Npn \semio_viz_dom_sr_area:n #1 {
  \seq_clear:N \l_semio_viz_dom_path_seq
  \seq_set_eq:NN \l_semio_viz_dom_aux_seq \l_semio_viz_dom_stack_seq
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sr_point:nn {#1} {##1} }
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sr_floor:n {##1} }
  \semio_viz_g_polygon:xn { \seq_use:Nn \l_semio_viz_dom_path_seq { , } }
    {
      fill = \semio_viz_palette:n { \l_semio_viz_dom_j_int } , fill~opacity = 0.62 ,
      draw = semio-chrome-canvas , line~width = \semio@stroke@hairline
    }
}

% 🌊 Walks the band's lower edge back to the start, at the previous stack level.
\cs_new_protected:Npn \semio_viz_dom_sr_floor:n #1 {
  \seq_put_right:Nx \l_semio_viz_dom_path_seq
    {
      \fp_eval:n
        {
          \l_semio_viz_dom_xa_fp
          + ( \l_semio_viz_dom_n_int - (#1) ) * \l_semio_viz_dom_w_fp
        }
    }
  \seq_put_right:Nx \l_semio_viz_dom_path_seq
    {
      \semio_viz_dom_sr_y:n
        { \seq_item:Nn \l_semio_viz_dom_aux_seq { \l_semio_viz_dom_n_int - (#1) + 1 } }
    }
}

% 📊 Grouped bars of column #1, one slot per series inside every time step.
\cs_new_protected:Npn \semio_viz_dom_sr_bars:n #1 {
  \int_step_inline:nn { \l_semio_viz_dom_n_int } { \semio_viz_dom_sr_bar:nn {#1} {##1} }
}

% 📊 One bar.
\cs_new_protected:Npn \semio_viz_dom_sr_bar:nn #1#2 {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } {#2} {#1} \l_semio_viz_dom_cell_tl
  \fp_set:Nn \l_semio_viz_dom_c_fp { \l_semio_viz_dom_b_fp * \l_semio_viz_dom_cell_tl }
  \fp_set:Nn \l_semio_viz_dom_d_fp
    {
      ( \l_semio_viz_dom_w_fp - \l_semio_viz_dom_alpha_fp ) / \l_semio_viz_dom_m_int
    }
  \semio_viz_g_rect:nnnnn
    {
      \l_semio_viz_dom_xa_fp + ( (#2) - 1 ) * \l_semio_viz_dom_w_fp
      - ( \l_semio_viz_dom_w_fp - \l_semio_viz_dom_alpha_fp ) / 2
      + ( \l_semio_viz_dom_j_int - 1 ) * \l_semio_viz_dom_d_fp
    }
    { \semio_viz_dom_sr_y:n { 0 } } { \l_semio_viz_dom_d_fp * 0.86 }
    { \semio_viz_dom_sr_y:n { \l_semio_viz_dom_c_fp } - \semio_viz_dom_sr_y:n { 0 } }
    {
      fill = \semio_viz_palette:n { \l_semio_viz_dom_j_int } , fill~opacity = 0.8 ,
      draw = none
    }
}

% 📉 The ideal reference: a straight run from the first sample of the first series down to zero.
\cs_new_protected:Npn \semio_viz_dom_sr_reference: {
  \semio_viz_table_cell:nnnN { \l_semio_viz_dom_data_tl } { 1 }
    { \clist_item:Nn \l_semio_viz_dom_series_clist { 1 } } \l_semio_viz_dom_cell_tl
  \semio_viz_g_line:nnnnn { \l_semio_viz_dom_xa_fp }
    { \semio_viz_dom_sr_y:n { \l_semio_viz_dom_cell_tl } } { \l_semio_viz_dom_xb_fp }
    { \semio_viz_dom_sr_y:n { 0 } }
    {
      draw = semio-chrome-border-emphasized , line~width = \semio@stroke@hairline ,
      dash~pattern = on~0.8mm~off~0.5mm
    }
}
%endregion 🔖️Series

%region 🔖️Keys-schedule
% 🔑 `schedule` keys, l3keys family `semio / viz / family / schedule`. §16's delivery charts are
% one set of named columns over the sprint axis, so the family is the series renderer plus the
% burn-down reference.
% variant (tl)      catalogue slug
% data    (table)   sprint table                       default `demo-sprint`
% time    (column)  sprint index                       default `t`
% series  (clist)   the value columns to draw          default `{remaining}`
% mode    (choice `line|area|bar`)                     default `line`
% stacked (bool)    accumulate the series on one another default false
% ideal   (bool)    draw the ideal burn reference       default false
% zero    (bool)    draw the zero rule                  default false
% gap     (mm)      gap between two time steps' bars    default 1.2
% labels  (bool)    print captions                      default true
\keys_define:nn { semio / viz / family / schedule } {
  data    .tl_set:N    = \l_semio_viz_dom_data_tl,
  time    .tl_set:N    = \l_semio_viz_dom_id_tl,
  series  .clist_set:N = \l_semio_viz_dom_series_clist,
  mode    .tl_set:N    = \l_semio_viz_dom_mode_tl,
  stacked .bool_set:N  = \l_semio_viz_dom_fill_bool,
  ideal   .bool_set:N  = \l_semio_viz_dom_highlight_bool,
  zero    .bool_set:N  = \l_semio_viz_dom_grid_bool,
  gap     .fp_set:N    = \l_semio_viz_dom_alpha_fp,
  pad     .fp_set:N    = \l_semio_viz_dom_pad_fp,
  width   .fp_set:N    = \l_semio_viz_dom_width_fp,
  height  .fp_set:N    = \l_semio_viz_dom_height_fp,
  labels  .bool_set:N  = \l_semio_viz_dom_labels_bool,
  unknown .code:n      = { },
}
%endregion 🔖️Keys-schedule

