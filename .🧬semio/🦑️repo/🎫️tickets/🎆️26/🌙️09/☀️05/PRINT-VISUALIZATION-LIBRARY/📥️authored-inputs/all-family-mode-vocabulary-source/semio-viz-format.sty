\int_const:Nn \c_semio_viz_format_unbounded_int { 1000000 }

% 🔎 Parses `[[fill]align][sign][symbol][0][width][,][.precision][~][type]` into the specifier registers.
\cs_new_protected:Npn \semio_viz_format_spec_parse:n #1 {
  \regex_extract_once:nnNTF
    {
