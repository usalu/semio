% 📆 Julian day number of a proleptic Gregorian date (Fliegel--Van Flandern, positive operands only).
\cs_new:Npn \semio_viz_time_jdn:nnn #1#2#3 {
  \int_eval:n
    {
      (#3)
      + \int_div_truncate:nn
          { 153 * ( (#2) + 12 * \int_div_truncate:nn { 14 - (#2) } { 12 } - 3 ) + 2 } { 5 }
      + 365 * ( (#1) + 4800 - \int_div_truncate:nn { 14 - (#2) } { 12 } )
      + \int_div_truncate:nn { (#1) + 4800 - \int_div_truncate:nn { 14 - (#2) } { 12 } } { 4 }
      - \int_div_truncate:nn { (#1) + 4800 - \int_div_truncate:nn { 14 - (#2) } { 12 } } { 100 }
      + \int_div_truncate:nn { (#1) + 4800 - \int_div_truncate:nn { 14 - (#2) } { 12 } } { 400 }
      - 32045
    }
}

