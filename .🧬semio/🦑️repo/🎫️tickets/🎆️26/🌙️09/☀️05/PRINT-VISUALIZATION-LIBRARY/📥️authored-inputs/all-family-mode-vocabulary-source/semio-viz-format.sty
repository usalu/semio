% 🕒 Formats the ISO timestamp #2 with the d3-time-format specifier #1 into the str variable #3.
\cs_new_protected:Npn \semio_viz_time_format:nnN #1#2#3 {
  \semio_viz_format_locale_resolve:
  \semio_viz_time_parse:n {#2}
