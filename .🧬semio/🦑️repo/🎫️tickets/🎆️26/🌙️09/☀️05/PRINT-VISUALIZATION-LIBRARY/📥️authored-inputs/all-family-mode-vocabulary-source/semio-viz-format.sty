        {
          \str_if_eq:VVTF \l_semio_viz_time_directive_str \c_percent_str
            { \bool_set_true:N \l_semio_viz_time_escape_bool }
            { \str_put_right:NV \l_semio_viz_time_out_str \l_semio_viz_time_directive_str }
