\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz-format}[2026/09/05 v0.3.0 semio viz number and time formatting (d3-format, d3-time-format grammar; locales en, de)]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-viz-data}

\ExplSyntaxOn

%region 🔖️Diagnostics
\msg_new:nnn { semio-viz } { bad-format-spec }
  { Malformed~number~format~specifier~'#1'. }
\msg_new:nnn { semio-viz } { unknown-format-type }
  { Unknown~number~format~type~'#1'. }
\msg_new:nnn { semio-viz } { unknown-locale }
  { Unknown~viz~locale~'#1'~(known:~en,~de). }
\msg_new:nnn { semio-viz } { no-locale }
  { No~viz~locale~selected:~set~the~document~language~or~call~\SemioVizLocale. }
\msg_new:nnn { semio-viz } { bad-iso-date }
  { Malformed~ISO~timestamp~'#1'~(expected~YYYY-MM-DD[THH:MM[:SS]]). }
%endregion 🔖️Diagnostics

%region 🔖️Variants
\cs_generate_variant:Nn \str_if_in:nnTF { nV }
\cs_generate_variant:Nn \str_if_in:nnF { nV }
%endregion 🔖️Variants

%region 🔖️Locale
% 🌍 Locale identity: an explicit override wins, otherwise the document language decides; there is no built-in default.
\tl_new:N \l_semio_viz_format_locale_tl
\tl_new:N \l_semio_viz_format_lang_tl
\str_new:N \l_semio_viz_format_decimal_str
\str_new:N \l_semio_viz_format_thousands_str
\str_new:N \l_semio_viz_format_minus_str
\str_new:N \l_semio_viz_format_currency_prefix_str
\str_new:N \l_semio_viz_format_currency_suffix_str

\cs_new_protected:Npn \semio_viz_format_locale_resolve: {
  \tl_if_empty:NTF \l_semio_viz_format_locale_tl
    {
      \tl_if_exist:NTF \l_semio_language_tl
        { \tl_set_eq:NN \l_semio_viz_format_lang_tl \l_semio_language_tl }
        { \msg_error:nn { semio-viz } { no-locale } }
    }
    { \tl_set_eq:NN \l_semio_viz_format_lang_tl \l_semio_viz_format_locale_tl }
  \str_case:VnF \l_semio_viz_format_lang_tl
    {
      { en }
        {
          \str_set:Nn \l_semio_viz_format_decimal_str { . }
          \str_set:Nn \l_semio_viz_format_thousands_str { , }
          \str_set:Nn \l_semio_viz_format_currency_prefix_str { $ }
          \str_clear:N \l_semio_viz_format_currency_suffix_str
        }
      { de }
        {
          \str_set:Nn \l_semio_viz_format_decimal_str { , }
          \str_set:Nn \l_semio_viz_format_thousands_str { . }
          \str_clear:N \l_semio_viz_format_currency_prefix_str
          \str_set:Nx \l_semio_viz_format_currency_suffix_str { ~ \char_generate:nn { 8364 } { 12 } }
        }
    }
    { \msg_error:nnV { semio-viz } { unknown-locale } \l_semio_viz_format_lang_tl }
  \str_set:Nx \l_semio_viz_format_minus_str { \char_generate:nn { 8722 } { 12 } }
}
%endregion 🔖️Locale

%region 🔖️Primitives
% 📐 Expandable decimal rounding for geometry and probe records: #1 digits of #2.
\cs_new:Npn \semio_viz_format_round:nn #1#2 { \fp_eval:n { round( #2 , #1 ) } }

% 📐 The millimetre grid every renderer emits its coordinates on: four decimals.
\cs_new:Npn \semio_viz_format_mm:n #1 { \semio_viz_format_round:nn { 4 } {#1} }

% 🔢 A count rounded to the nearest integer, for indices and repetitions.
\cs_new:Npn \semio_viz_format_count:n #1 { \semio_viz_format_round:nn { 0 } {#1} }

\tl_if_exist:NF \l_semio_language_tl { \tl_new:N \l_semio_language_tl }

% 🗣️ Picks the English or the German wording by the document language. There is no default
% language: a document that set none is an error, never silently English.
\cs_new_protected:Npn \semio_viz_format_localized:nn #1#2
  {
    \str_case:VnF \l_semio_language_tl { { en } {#1} { de } {#2} }
      { \msg_error:nn { semio-viz } { no-locale } }
  }

% 🔢 A label number with #2 decimals in the document language: German writes the decimal comma.
\tl_new:N \l_semio_viz_format_decimal_tl
\cs_new_protected:Npn \semio_viz_format_decimal:nn #1#2
  {
    \tl_set:Nx \l_semio_viz_format_decimal_tl { \semio_viz_format_round:nn {#2} {#1} }
    \semio_viz_format_localized:nn
      { }
      { \tl_replace_all:Nnn \l_semio_viz_format_decimal_tl { . } { { , } } }
    \tl_use:N \l_semio_viz_format_decimal_tl
  }

% ⬇️ Floor division by three; l3int truncates towards zero, d3 floors.
\cs_new:Npn \semio_viz_format_floor_div3:n #1
  {
    \int_div_truncate:nn { #1 - \int_compare:nNnTF {#1} < { 0 } { 2 } { 0 } } { 3 }
  }

% 0️⃣ A run of #1 zero digits, never negative.
\cs_new:Npn \semio_viz_format_zeros:n #1 { \prg_replicate:nn { \int_max:nn {#1} { 0 } } { 0 } }

\fp_new:N \l_semio_viz_format_value_fp
\fp_new:N \l_semio_viz_format_mant_fp
\int_new:N \l_semio_viz_format_exp_int
\int_new:N \l_semio_viz_format_sig_int
\int_new:N \l_semio_viz_format_prefix_exp_int
\int_new:N \l_semio_viz_format_tmp_int
\str_new:N \l_semio_viz_format_coef_str
\str_new:N \l_semio_viz_format_int_str
\str_new:N \l_semio_viz_format_frac_str
\str_new:N \l_semio_viz_format_zeros_str
\str_new:N \l_semio_viz_format_scratch_str
\seq_new:N \l_semio_viz_format_split_seq

% ➕ Pads the fractional part of a decimal string to #2 digits, adding the separator when absent.
\cs_new_protected:Npn \semio_viz_format_pad_decimals:Nn #1#2 {
  \seq_set_split:NnV \l_semio_viz_format_split_seq { . } #1
  \str_set:Nx \l_semio_viz_format_int_str { \seq_item:Nn \l_semio_viz_format_split_seq { 1 } }
  \str_set:Nx \l_semio_viz_format_frac_str { \seq_item:Nn \l_semio_viz_format_split_seq { 2 } }
  \str_put_right:Nx \l_semio_viz_format_frac_str
    { \semio_viz_format_zeros:n { #2 - \str_count:N \l_semio_viz_format_frac_str } }
  \str_set:Nx #1 { \l_semio_viz_format_int_str . \l_semio_viz_format_frac_str }
}

% 🔢 Fixed-point rendering of #1 with exactly #2 decimals, mirroring Number.prototype.toFixed.
% l3fp's round() breaks ties to even, JavaScript breaks them away from zero, so the tie is
% resolved explicitly here rather than inherited from the engine.
\cs_new_protected:Npn \semio_viz_format_fixed:nnN #1#2#3 {
  \str_set:Nx #3
    {
      \fp_to_decimal:n
        {
          ( (#1) < 0 ? -1 : 1 ) * floor( abs(#1) * 10 ** (#2) + 0.5 ) / 10 ** (#2)
        }
    }
  \int_compare:nNnT {#2} > { 0 } { \semio_viz_format_pad_decimals:Nn #3 {#2} }
}

% 🔬 Decomposes |#1| into #2 significant digits (\l_semio_viz_format_coef_str) and a decimal exponent (\l_semio_viz_format_exp_int).
\cs_new_protected:Npn \semio_viz_format_sci:nn #1#2 {
  \int_set:Nn \l_semio_viz_format_sig_int { \int_max:nn {#2} { 1 } }
  \fp_set:Nn \l_semio_viz_format_value_fp { abs( #1 ) }
  \fp_compare:nNnTF { \l_semio_viz_format_value_fp } = { 0 }
    {
      \int_zero:N \l_semio_viz_format_exp_int
      \str_set:Nx \l_semio_viz_format_coef_str
        { \semio_viz_format_zeros:n { \l_semio_viz_format_sig_int } }
    }
    {
      \int_set:Nn \l_semio_viz_format_exp_int
        { \fp_to_int:n { floor( ln( \l_semio_viz_format_value_fp ) / ln(10) ) } }
      \fp_set:Nn \l_semio_viz_format_mant_fp
        { \l_semio_viz_format_value_fp / 10 ** \l_semio_viz_format_exp_int }
      \fp_compare:nT { \l_semio_viz_format_mant_fp >= 10 }
        {
          \int_incr:N \l_semio_viz_format_exp_int
          \fp_set:Nn \l_semio_viz_format_mant_fp { \l_semio_viz_format_mant_fp / 10 }
        }
      \fp_compare:nNnT { \l_semio_viz_format_mant_fp } < { 1 }
        {
          \int_decr:N \l_semio_viz_format_exp_int
          \fp_set:Nn \l_semio_viz_format_mant_fp { \l_semio_viz_format_mant_fp * 10 }
        }
      \fp_set:Nn \l_semio_viz_format_mant_fp
        { round( \l_semio_viz_format_mant_fp , \l_semio_viz_format_sig_int - 1 ) }
      \fp_compare:nT { \l_semio_viz_format_mant_fp >= 10 }
        {
          \int_incr:N \l_semio_viz_format_exp_int
          \fp_set:Nn \l_semio_viz_format_mant_fp { \l_semio_viz_format_mant_fp / 10 }
        }
      \semio_viz_format_fixed:nnN { \l_semio_viz_format_mant_fp }
        { \l_semio_viz_format_sig_int - 1 } \l_semio_viz_format_coef_str
      \str_remove_all:Nn \l_semio_viz_format_coef_str { . }
    }
}

% 🧮 Exponential notation of #1 with #2 fractional digits, mirroring Number.prototype.toExponential.
\cs_new_protected:Npn \semio_viz_format_exponential:nnN #1#2#3 {
  \semio_viz_format_sci:nn {#1} { #2 + 1 }
  \str_set:Nx #3 { \str_range:Nnn \l_semio_viz_format_coef_str { 1 } { 1 } }
  \int_compare:nNnT {#2} > { 0 }
    { \str_put_right:Nx #3 { . \str_range:Nnn \l_semio_viz_format_coef_str { 2 } { -1 } } }
  \str_put_right:Nx #3
    {
      e
      \int_compare:nNnTF { \l_semio_viz_format_exp_int } < { 0 } { - } { + }
      \int_eval:n { \int_abs:n { \l_semio_viz_format_exp_int } }
    }
}

% 🎯 Significant-digit notation of #1 with #2 digits, mirroring Number.prototype.toPrecision.
\cs_new_protected:Npn \semio_viz_format_precision:nnN #1#2#3 {
  \semio_viz_format_sci:nn {#1} {#2}
  \bool_lazy_or:nnTF
    { \int_compare_p:nNn { \l_semio_viz_format_exp_int } < { -6 } }
    { \int_compare_p:n { \l_semio_viz_format_exp_int >= #2 } }
    { \semio_viz_format_exponential:nnN {#1} { #2 - 1 } #3 }
    { \semio_viz_format_fixed:nnN {#1} { #2 - 1 - \l_semio_viz_format_exp_int } #3 }
}

% 🪙 Rounded fixed notation on #2 significant digits, mirroring d3-format's formatRounded.
\cs_new_protected:Npn \semio_viz_format_rounded:nnN #1#2#3 {
  \semio_viz_format_sci:nn {#1} {#2}
  \int_compare:nNnTF { \l_semio_viz_format_exp_int } < { 0 }
    {
      \str_set:Nx #3
        {
          0.
          \semio_viz_format_zeros:n { -\l_semio_viz_format_exp_int - 1 }
          \l_semio_viz_format_coef_str
        }
    }
    {
      \int_compare:nNnTF { \str_count:N \l_semio_viz_format_coef_str }
        > { \l_semio_viz_format_exp_int + 1 }
        {
          \str_set:Nx #3
            {
              \str_range:Nnn \l_semio_viz_format_coef_str { 1 } { \l_semio_viz_format_exp_int + 1 }
              .
              \str_range:Nnn \l_semio_viz_format_coef_str { \l_semio_viz_format_exp_int + 2 } { -1 }
            }
        }
        {
          \str_set:Nx #3
            {
              \l_semio_viz_format_coef_str
              \semio_viz_format_zeros:n
                { \l_semio_viz_format_exp_int + 1 - \str_count:N \l_semio_viz_format_coef_str }
            }
        }
    }
}

\str_const:Nx \c_semio_viz_format_prefixes_lo_str { yzafpn \char_generate:nn { 181 } { 12 } m }
\str_const:Nn \c_semio_viz_format_prefixes_hi_str { kMGTPEZY }

% 🧲 SI-prefixed mantissa of #1 on #2 significant digits; the chosen prefix exponent lands in \l_semio_viz_format_prefix_exp_int.
\cs_new_protected:Npn \semio_viz_format_prefix_auto:nnN #1#2#3 {
  \semio_viz_format_sci:nn {#1} {#2}
  \int_set:Nn \l_semio_viz_format_prefix_exp_int
    {
      3 * \int_max:nn { -8 }
        { \int_min:nn { 8 } { \semio_viz_format_floor_div3:n { \l_semio_viz_format_exp_int } } }
    }
  \int_set:Nn \l_semio_viz_format_tmp_int
    { \l_semio_viz_format_exp_int - \l_semio_viz_format_prefix_exp_int + 1 }
  \int_compare:nNnTF { \l_semio_viz_format_tmp_int } > { 0 }
    {
      \int_compare:nTF
        { \l_semio_viz_format_tmp_int >= \str_count:N \l_semio_viz_format_coef_str }
        {
          \str_set:Nx #3
            {
              \l_semio_viz_format_coef_str
              \semio_viz_format_zeros:n
                { \l_semio_viz_format_tmp_int - \str_count:N \l_semio_viz_format_coef_str }
            }
        }
        {
          \str_set:Nx #3
            {
              \str_range:Nnn \l_semio_viz_format_coef_str { 1 } { \l_semio_viz_format_tmp_int }
              .
              \str_range:Nnn \l_semio_viz_format_coef_str { \l_semio_viz_format_tmp_int + 1 } { -1 }
            }
        }
    }
    {
      \str_set:Nx \l_semio_viz_format_zeros_str
        { \semio_viz_format_zeros:n { -\l_semio_viz_format_tmp_int } }
      \int_set:Nn \l_semio_viz_format_sig_int
        { \int_max:nn { 1 } { #2 + \l_semio_viz_format_tmp_int - 1 } }
      \int_set:Nn \l_semio_viz_format_tmp_int { \l_semio_viz_format_prefix_exp_int }
      \semio_viz_format_sci:nn {#1} { \l_semio_viz_format_sig_int }
      \int_set:Nn \l_semio_viz_format_prefix_exp_int { \l_semio_viz_format_tmp_int }
      \str_set:Nx #3 { 0. \l_semio_viz_format_zeros_str \l_semio_viz_format_coef_str }
    }
}

% 🔤 The SI prefix character for a prefix exponent, empty at 10^0.
\cs_new:Npn \semio_viz_format_prefix_symbol:n #1 {
  \int_compare:nNnTF {#1} < { 0 }
    {
      \str_range:Nnn \c_semio_viz_format_prefixes_lo_str
        { 9 + \int_div_truncate:nn {#1} { 3 } } { 9 + \int_div_truncate:nn {#1} { 3 } }
    }
    {
      \int_compare:nNnF {#1} = { 0 }
        {
          \str_range:Nnn \c_semio_viz_format_prefixes_hi_str
            { \int_div_truncate:nn {#1} { 3 } } { \int_div_truncate:nn {#1} { 3 } }
        }
    }
}

\int_new:N \l_semio_viz_format_group_i_int
\int_new:N \l_semio_viz_format_group_g_int
\int_new:N \l_semio_viz_format_group_len_int
\seq_new:N \l_semio_viz_format_group_seq
\str_new:N \l_semio_viz_format_joined_str
\bool_new:N \l_semio_viz_format_first_bool

% 🔗 Groups the integer digits of #1 into thousands, stopping once #2 characters are consumed.
\cs_new_protected:Npn \semio_viz_format_group:NnN #1#2#3 {
  \int_set:Nn \l_semio_viz_format_group_i_int { \str_count:N #1 }
  \int_set:Nn \l_semio_viz_format_group_g_int { 3 }
  \int_zero:N \l_semio_viz_format_group_len_int
  \seq_clear:N \l_semio_viz_format_group_seq
  \bool_while_do:nn
    {
      \int_compare_p:nNn { \l_semio_viz_format_group_i_int } > { 0 } &&
      \int_compare_p:nNn { \l_semio_viz_format_group_g_int } > { 0 }
    }
    {
      \int_compare:nNnT
        { \l_semio_viz_format_group_len_int + \l_semio_viz_format_group_g_int + 1 } > {#2}
        {
          \int_set:Nn \l_semio_viz_format_group_g_int
            { \int_max:nn { 1 } { #2 - \l_semio_viz_format_group_len_int } }
        }
      \seq_put_left:Nx \l_semio_viz_format_group_seq
        {
          \str_range:Nnn #1
            {
              \int_max:nn { 1 }
                { \l_semio_viz_format_group_i_int - \l_semio_viz_format_group_g_int + 1 }
            }
            { \l_semio_viz_format_group_i_int }
        }
      \int_sub:Nn \l_semio_viz_format_group_i_int { \l_semio_viz_format_group_g_int }
      \int_add:Nn \l_semio_viz_format_group_len_int { \l_semio_viz_format_group_g_int + 1 }
      \int_compare:nNnTF { \l_semio_viz_format_group_len_int } > {#2}
        { \int_zero:N \l_semio_viz_format_group_g_int }
        { \int_set:Nn \l_semio_viz_format_group_g_int { 3 } }
    }
  \str_clear:N \l_semio_viz_format_joined_str
  \bool_set_true:N \l_semio_viz_format_first_bool
  \seq_map_inline:Nn \l_semio_viz_format_group_seq
    {
      \bool_if:NTF \l_semio_viz_format_first_bool
        { \bool_set_false:N \l_semio_viz_format_first_bool }
        { \str_put_right:NV \l_semio_viz_format_joined_str \l_semio_viz_format_thousands_str }
      \str_put_right:Nn \l_semio_viz_format_joined_str {##1}
    }
  \str_set_eq:NN #3 \l_semio_viz_format_joined_str
}

\int_new:N \l_semio_viz_format_trim_zero_int
\int_new:N \l_semio_viz_format_trim_last_int
\bool_new:N \l_semio_viz_format_trim_stop_bool
\str_new:N \l_semio_viz_format_trim_char_str

% ✂️ Drops insignificant trailing zeros, mirroring d3-format's formatTrim.
\cs_new_protected:Npn \semio_viz_format_trim:N #1 {
  \int_set:Nn \l_semio_viz_format_trim_zero_int { -1 }
  \int_zero:N \l_semio_viz_format_trim_last_int
  \bool_set_false:N \l_semio_viz_format_trim_stop_bool
  \int_step_inline:nnn { 2 } { \str_count:N #1 }
    {
      \bool_if:NF \l_semio_viz_format_trim_stop_bool
        {
          \str_set:Nx \l_semio_viz_format_trim_char_str { \str_range:Nnn #1 {##1} {##1} }
          \str_case:VnF \l_semio_viz_format_trim_char_str
            {
              { . }
                {
                  \int_set:Nn \l_semio_viz_format_trim_zero_int {##1}
                  \int_set:Nn \l_semio_viz_format_trim_last_int {##1}
                }
              { 0 }
                {
                  \int_compare:nNnT { \l_semio_viz_format_trim_zero_int } = { 0 }
                    { \int_set:Nn \l_semio_viz_format_trim_zero_int {##1} }
                  \int_set:Nn \l_semio_viz_format_trim_last_int {##1}
                }
            }
            {
              \str_if_in:nVTF { 123456789 } \l_semio_viz_format_trim_char_str
                {
                  \int_compare:nNnT { \l_semio_viz_format_trim_zero_int } > { 0 }
                    { \int_zero:N \l_semio_viz_format_trim_zero_int }
                }
                { \bool_set_true:N \l_semio_viz_format_trim_stop_bool }
            }
        }
    }
  \int_compare:nNnT { \l_semio_viz_format_trim_zero_int } > { 0 }
    {
      \str_set:Nx #1
        {
          \str_range:Nnn #1 { 1 } { \l_semio_viz_format_trim_zero_int - 1 }
          \str_range:Nnn #1 { \l_semio_viz_format_trim_last_int + 1 } { -1 }
        }
    }
}
