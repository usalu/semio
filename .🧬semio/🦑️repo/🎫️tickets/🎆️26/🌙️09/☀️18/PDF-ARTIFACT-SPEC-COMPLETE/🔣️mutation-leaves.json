   "diff": "diff::diff_remove_content(self.index, self.at, self.count)",
   "inverse": "base.pages.get(self.index).filter(|page| self.at + self.count <= page.content.len()).map(|page| PdfMutation::InsertContent(super::insert_content::InsertContent { index: self.index, at: self.at, content: page.content[self.at..self.at + self.count].to_vec() })).into_iter().collect()",
   "label": "format!(\"Remove {} operators at {} on page {}\", self.count, self.at, self.index)", "target": "vec![self.index.to_string(), self.at.to_string()]"},
