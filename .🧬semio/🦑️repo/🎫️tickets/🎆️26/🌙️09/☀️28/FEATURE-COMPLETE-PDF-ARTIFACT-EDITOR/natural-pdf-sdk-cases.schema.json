{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "naturalPort",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "naturalPort": {
      "const": "artifact:native"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "port",
          "binary",
          "extent",
          "maximum",
          "rawWireBytes",
          "accepted"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "string",
            "minLength": 1
          },
          "binary": {
            "type": "boolean"
          },
          "extent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "maximum": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "rawWireBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
