{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "expected",
      "writes",
      "acks",
      "closed",
      "cancelled",
      "localRetired"
    ],
    "properties": {
      "name": {
        "enum": [
          "complete",
          "foreign-document",
          "oversized-archive",
          "foreign-page-receipt",
          "foreign-write-receipt",
          "cancel-first-write",
          "foreign-seal-readback",
          "frontier-changed-after-write",
          "close-refused",
          "owner-lost-after-close"
        ]
      },
      "expected": {
        "type": "string",
        "minLength": 1
      },
      "writes": {
        "type": "integer",
        "minimum": 0
      },
      "acks": {
        "type": "integer",
        "minimum": 0
      },
      "closed": {
        "type": "integer",
        "minimum": 0
      },
      "cancelled": {
        "type": "integer",
        "minimum": 0
      },
      "localRetired": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
