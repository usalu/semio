{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "schema", "generation", "extent", "page", "cases"],
  "properties": {
    "document": { "type": "string", "minLength": 1 },
    "schema": { "type": "string", "minLength": 1 },
    "generation": { "type": "string", "pattern": "^[1-9][0-9]+$" },
    "extent": { "const": 2130150 },
    "page": { "const": 4096 },
    "cases": {
      "type": "object",
      "required": ["commit", "retry", "rollback", "stale", "schema", "seal", "order", "format", "overLimit", "interior"],
      "additionalProperties": false,
      "properties": {
        "commit": { "const": "accepted" },
        "retry": { "const": "accepted" },
        "rollback": { "const": "cancelled" },
        "stale": { "const": "first archive folder authority changed" },
        "schema": { "const": "different first archive already exists" },
        "seal": { "const": "archive seal differs from capture" },
        "order": { "const": "archive page changed order" },
        "format": { "const": "first archive must contain exactly its parent pair" },
        "overLimit": { "const": "invalid first archive frontier" },
        "interior": { "const": "checksum mismatch" }
      }
    }
  }
}
