{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/snapshot.json",
  "title": "PngSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bytes"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Schema",
          "de": "Schema"
        }
      }
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Exact PNG bytes",
          "de": "Exakte PNG-Bytes"
        },
        "description": {
          "en": "The complete source file, preserving chunk order, duplicate chunks, compressed image data, sample precision and interlace layout.",
          "de": "Die vollständige Quelldatei mit Chunk-Reihenfolge, doppelten Chunks, komprimierten Bilddaten, Abtastpräzision und Interlace-Layout."
        }
      }
    }
  }
}
