{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "prefixHex",
    "offset",
    "primitive",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "prefixHex": {
      "const": "ccdd"
    },
    "offset": {
      "const": 2
    },
    "primitive": {
      "const": "unsignedLEB128ConsumedPrefix"
    },
    "cases": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bodyHex",
        "trailingHex",
        "reads",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "bodyHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){0,10}$"
        },
        "trailingHex": {
          "enum": [
            "",
            "aa55",
            "07aa55"
          ]
        },
        "reads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "outcome": {
          "oneOf": [
            {
              "$ref": "#/$defs/success"
            },
            {
              "$ref": "#/$defs/refusal"
            }
          ]
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valueDecimal",
        "consumed"
      ],
      "properties": {
        "valueDecimal": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,19})$"
        },
        "consumed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "offset"
      ],
      "properties": {
        "kind": {
          "enum": [
            "truncated",
            "malformed"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        }
      }
    }
  }
}
