{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","maximumCloseItems","maximumCloseBytes","allocationBytes","payloadBytes","cancelAt","cases"],
  "properties":{
    "schema":{"const":"pdf14.operation-source/v1"},
    "maximumCloseItems":{"const":1},
    "maximumCloseBytes":{"const":4096},
    "allocationBytes":{"const":131072},
    "payloadBytes":{"const":8194},
    "cancelAt":{"const":256},
    "cases":{
      "type":"array","minItems":7,"maxItems":7,
      "items":{
        "type":"object","additionalProperties":false,"required":["kind","tag","frameHex"],
        "properties":{
          "kind":{"type":"string"},"tag":{"type":"integer","minimum":0,"maximum":6},
          "index":{"type":"integer","minimum":0},"from":{"type":"integer","minimum":0},"to":{"type":"integer","minimum":0},
          "widthBits":{"$ref":"#/$defs/Word"},"heightBits":{"$ref":"#/$defs/Word"},"identity":{"type":"string"},"text":{"type":"string"},
          "pages":{"type":"array","items":{"$ref":"#/$defs/Page"}},
          "patch":{"type":"object","additionalProperties":false,"required":["operation","path"],"properties":{"operation":{"const":"remove"},"path":{"type":"string"}}},
          "frameHex":{"type":"string","pattern":"^(?:[0-9a-f]{2})+$"}
        },
        "oneOf":[
          {"properties":{"kind":{"const":"insert-page"},"tag":{"const":0}},"required":["index","widthBits","heightBits","text"]},
          {"properties":{"kind":{"const":"remove-page"},"tag":{"const":1}},"required":["index"]},
          {"properties":{"kind":{"const":"move-page"},"tag":{"const":2}},"required":["from","to"]},
          {"properties":{"kind":{"const":"resize-page"},"tag":{"const":3}},"required":["index","widthBits","heightBits"]},
          {"properties":{"kind":{"const":"replace-page-text"},"tag":{"const":4}},"required":["index","text"]},
          {"properties":{"kind":{"const":"set-snapshot"},"tag":{"const":5}},"required":["identity","pages"]},
          {"properties":{"kind":{"const":"patch-snapshot"},"tag":{"const":6}},"required":["patch"]}
        ]
      }
    }
  },
  "$defs":{
    "Word":{"type":"string","pattern":"^[0-9]+$"},
    "Page":{"type":"object","additionalProperties":false,"required":["widthBits","heightBits","text"],"properties":{"widthBits":{"$ref":"#/$defs/Word"},"heightBits":{"$ref":"#/$defs/Word"},"text":{"type":"string"}}}
  }
}
