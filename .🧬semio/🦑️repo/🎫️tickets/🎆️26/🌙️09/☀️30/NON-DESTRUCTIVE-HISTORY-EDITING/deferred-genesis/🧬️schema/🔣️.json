{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cases",
    "domains"
  ],
  "properties": {
    "schema": {
      "const": "retained-initialization-genesis/v1"
    },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "enum": [
          "GisMap",
          "Writer",
          "Jack",
          "Raster",
          "Generation2d",
          "Generation3d",
          "Process3d",
          "Drawing"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "events",
          "states"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "BIND",
                "FINISH",
                "WITHDRAWN",
                "MUTATE",
                "COPIED",
                "RETIRED",
                "CANCEL"
              ]
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "aliased",
                "complete",
                "copying",
                "retiring",
                "owned",
                "cancelled"
              ]
            }
          }
        }
      }
    }
  }
}
