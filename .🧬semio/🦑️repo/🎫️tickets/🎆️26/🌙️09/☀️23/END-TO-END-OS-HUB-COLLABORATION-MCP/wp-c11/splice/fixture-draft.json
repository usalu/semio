      "splices": [
        {
          "author": "a",
          "hlc": 1,
          "splice": {
            "start": 3,
            "deleted": "",
            "insert": "X",
            "before": "abc",
            "after": "def"
          }
        },
        {
          "author": "b",
          "hlc": 2,
          "splice": {
            "start": 2,
            "deleted": "cde",
            "insert": "",
            "before": "ab",
            "after": "f"
          }
        }
      ],
      "expected": {
        "text": "abcXdef",
        "clamped": [
          1
        ]
      }
