{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/plugin/table/row-capacity.fixture.json",
  "title": "TableRowCapacityFixture",
  "description": "A Home-shaped windowed table row (cells, labelled row actions and a row activation, each binding carrying its own argument map), the host's default window, and the rows one window of such rows must materialise inside the body's item budget. Row actions travel only as RowAction props, never as child records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "controller", "tableLabel", "columns", "actionsLabel", "row", "window", "expect"],
  "properties": {
    "$schema": { "type": "string" },
    "controller": { "type": "string", "minLength": 1 },
    "tableLabel": { "type": "string", "minLength": 1 },
    "columns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "maxItems": 16 },
    "actionsLabel": { "type": "string", "minLength": 1 },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyPrefix", "idLength", "cells", "argument", "activation", "actions"],
      "properties": {
        "keyPrefix": { "type": "string", "minLength": 1 },
        "idLength": { "type": "integer", "minimum": 1, "maximum": 64 },
        "cells": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 16 },
        "argument": { "type": "string", "minLength": 1 },
        "activation": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["icon", "label", "action"],
            "properties": {
              "icon": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "rows"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1, "description": "The host's default window request (TREE_WINDOW_DEFAULT_ROWS)." }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minRowsPerWindow", "rowChildren"],
      "properties": {
        "minRowsPerWindow": { "type": "integer", "minimum": 1, "description": "Rows of this shape one window must fit inside the body item budget." },
        "rowChildren": { "const": 0, "description": "A plain row has no child records: cells and row actions are props." }
      }
    }
  }
}
