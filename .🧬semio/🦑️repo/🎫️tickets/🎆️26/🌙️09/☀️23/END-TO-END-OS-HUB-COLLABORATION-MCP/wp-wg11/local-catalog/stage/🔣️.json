{
  "schema": "semio.os.shell-local-catalog/v1",
  "description": "The host-owned local document catalog lane (`os.config.local-catalog`, persisted local-only in `<S_DATA_DIR>/os`) both shells serve: the guest commands, the landing app's re-hydration action, the bounds, what the lane tells the user (en, de; any other locale reads en; `{name}` is the document's name) under which fault code, and the shared vectors both shells' laws answer — an admission request resolves to its catalog entry, event folder and exact archive bytes or to a refusal; a catalog persists as exactly its archive bytes.",
  "actions": {
    "admit": "os.local-catalog.admit",
    "retire": "os.local-catalog.retire",
    "rehydrate": "applyLocalCatalogDocument"
  },
  "codePrefix": "shell.localCatalog.",
  "bounds": {
    "textMaximumBytes": 256,
    "targetMaximumBytes": 4096,
    "documentMaximumBase64Bytes": 8388608,
    "writeDeadlineMs": 30000,
    "readDeadlineMs": 10000
  },
  "notices": {
    "keeping": {
      "en": "Keeping “{name}” on this device…",
      "de": "„{name}“ wird auf diesem Gerät gespeichert…"
    },
    "kept": {
      "en": "“{name}” is kept on this device.",
      "de": "„{name}“ ist auf diesem Gerät gespeichert."
    },
    "retired": {
      "en": "“{name}” is no longer listed on this device; its files stay where they are.",
      "de": "„{name}“ wird auf diesem Gerät nicht mehr aufgeführt; seine Dateien bleiben erhalten."
    },
    "no-data-folder": {
      "en": "This shell has no data folder, so it cannot keep documents on this device.",
      "de": "Diese Shell hat keinen Datenordner und kann daher keine Dokumente auf diesem Gerät speichern."
    },
    "invalid-request": {
      "en": "That request to keep a document was incomplete and was not run.",
      "de": "Diese Anfrage zum Speichern eines Dokuments war unvollständig und wurde nicht ausgeführt."
    },
    "document-unknown": {
      "en": "That document is not kept on this device.",
      "de": "Dieses Dokument ist auf diesem Gerät nicht gespeichert."
    },
    "write-failed": {
      "en": "“{name}” could not be written to this device.",
      "de": "„{name}“ konnte nicht auf diesem Gerät gespeichert werden."
    },
    "cancelled": {
      "en": "Keeping “{name}” on this device was cancelled; nothing was written.",
      "de": "Das Speichern von „{name}“ auf diesem Gerät wurde abgebrochen; nichts wurde geschrieben."
    }
  },
  "admissions": [
    {
      "name": "an empty folder target lands in the data folder",
      "args": {
        "documentId": "studio-1",
        "schema": "s.space",
        "name": "Studio",
        "storage": "folder",
        "pack": "AQID",
        "spr": "BAU="
      },
      "dataDir": "/data/",
      "nowMs": 1727600000123,
      "expect": {
        "document": {
          "documentId": "studio-1",
          "schema": "s.space",
          "name": "Studio",
          "storage": "folder",
          "target": "/data/os/local-documents/studio-1",
          "admittedAtMs": 1727600000123
        },
        "folder": "/data/os/local-documents/studio-1",
        "archiveHex": "010301020302040500"
      }
    },
    {
      "name": "a file target keeps its events in the file's folder",
