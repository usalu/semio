{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "🪟️ Neutral tree-window request vectors (WG11 P5, ticket 26/09/23 session 14d): what React's rule (🌳️Tree/🟦️.tsx region 🪟️TreeWindow + 🗣️Interpreter treeWindowBodyRequestsV1) answers for a measured body, and what the wgpu twin (🌳️Tree/🪟️window/🦀️.rs) must answer too.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$comment", "budget", "overscan", "rowExtentPx", "cases"],
  "properties": {
    "$comment": { "type": "string" },
    "budget": { "type": "integer", "minimum": 1 },
    "overscan": { "type": "integer", "minimum": 0 },
    "rowExtentPx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "compactText", "compactSmallControl", "compactControl"],
      "properties": {
        "standard": { "type": "number", "exclusiveMinimum": 0 },
        "compactText": { "type": "number", "exclusiveMinimum": 0 },
        "compactSmallControl": { "type": "number", "exclusiveMinimum": 0 },
        "compactControl": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "viewportHeight", "containers", "visible", "requests", "body"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "viewportHeight": { "type": "number", "minimum": 0 },
          "containers": { "type": "array", "items": { "$ref": "#/definitions/container" } },
          "visible": { "type": "array", "items": { "$ref": "#/definitions/visible" } },
          "requests": { "type": "array", "items": { "$ref": "#/definitions/request" } },
          "body": { "type": "array", "items": { "$ref": "#/definitions/request" } }
        }
      }
    }
  },
  "definitions": {
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "total", "offset", "length", "top", "height", "rowExtent", "rows"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "total": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "top": { "type": "number" },
        "height": { "type": "number", "minimum": 0 },
        "rowExtent": { "enum": ["standard", "compactText", "compactSmallControl", "compactControl"] },
        "rows": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": [{ "type": "integer", "minimum": 0 }, { "type": "number" }] } }
      }
    },
    "visible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "total", "visibleRows", "firstVisibleRow", "distancePx"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "total": { "type": "integer", "minimum": 1 },
        "visibleRows": { "type": "integer", "minimum": 1 },
        "firstVisibleRow": { "type": "integer", "minimum": 0 },
        "distancePx": { "type": "number", "minimum": 0 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "offset", "rows"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
