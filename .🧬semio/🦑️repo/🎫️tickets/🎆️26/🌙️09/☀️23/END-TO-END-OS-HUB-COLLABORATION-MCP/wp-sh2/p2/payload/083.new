
use super::*;
use crate::editor::space_index::unit_tests::context;

/// 🗃️ "Open with…" reads the directory-owned row from the captured transient and relays the explicit choice.
#[semio_framework_async_macros::async_test]
async fn open_artifact_with_relays_the_explicit_choice() {
    let (mut app, id) = context::new_app_with_indexed_artifact().await;
    let settled = context::settle_action(&mut app, "openArtifactWith", pack::json!({ "id": id, "role": "viewer", "pluginId": "draw", "appId": "draw-play" })).await.expect("open with");
    let [Effect::ReplayShellCommand { action_id, args }] = settled.effects.as_slice() else { panic!("one ReplayShellCommand, got {:?}", settled.effects) };
    assert_eq!(action_id, "os.open-artifact-with");
    let args = pack::json_from_dsl_value(args.as_ref().expect("relay args"));
    assert_eq!(args.get("role").and_then(|v| v.as_str()), Some("viewer"));
    assert_eq!(args.get("pluginId").and_then(|v| v.as_str()), Some("draw"));
    assert_eq!(args.get("appId").and_then(|v| v.as_str()), Some("draw-play"));
    assert_eq!(args.get("schema").and_then(|v| v.as_str()), Some("s.draw.draw"));
}
