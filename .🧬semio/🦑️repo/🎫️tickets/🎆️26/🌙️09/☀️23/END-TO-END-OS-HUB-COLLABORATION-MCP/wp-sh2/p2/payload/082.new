//! 🗃️️ SpaceIndexEditor commands command — `open-artifact-with`. The explicit "Open with…" chooser
//! variant of `🗿️open-artifact`: `role`/`plugin_id`/`app_id` are the user's explicit picks from the
//! chooser dialog (worker-brief task 2), always sent, never defaulted by the shell.

use crate::standards::v1::subsets::any::schema::mutations::SSpaceMutation;
use crate::standards::v1::subsets::any::schema::snapshot::{SSpaceSnapshot, SpaceArtifactRow};
use semio_framework_plugin::kernel::Effect;
use semio_framework_plugin::{ArtifactView, ConfigView, Emit, Fault, FaultCode, FaultOrigin, NoConfig, NoConfigMutation};

#[derive(Clone, Debug, PartialEq, value_derive::ToValue, value_derive::FromValue, dsl::DslRecord)]
#[dsl(keyword = "open-artifact-with")]
pub struct OpenArtifactWith {
    pub id: String,
    pub role: String,
    pub plugin_id: String,
    pub app_id: String,
}

/// 🚫️ The direct lane has no directory projection to find the row in: opening runs only as the retained job.
pub fn handle(_payload: &OpenArtifactWith, _doc: &ArtifactView<'_, SSpaceSnapshot>, _cfg: &ConfigView<'_, NoConfig>) -> Result<Emit<SSpaceMutation, NoConfigMutation>, Fault> {
    Err(Fault::new(FaultOrigin::App, "s.space.open-artifact-with.requires-retained-job", "opening an artifact runs only as the retained job"))
}

/// 📂️ The retained route: `row` is the artifact's one directory-owned row from the transient the job captured at dispatch.
pub fn handle_with_row(payload: &OpenArtifactWith, doc: &ArtifactView<'_, SSpaceSnapshot>, row: Option<&SpaceArtifactRow>) -> Result<Emit<SSpaceMutation, NoConfigMutation>, Fault> {
    let row = row.ok_or_else(|| Fault::new(FaultOrigin::App, FaultCode::new("s.space.index.target-missing"), format!("indexed artifact `{}` not found", payload.id)))?;
    let artifact_ref = format!("{}@{}/{}", row.dialect.artifact_kind, row.dialect.standard, row.dialect.subset);
    Ok(Emit::effect(Effect::ReplayShellCommand {
        action_id: "os.open-artifact-with".into(),
        args: Some(pack::json_to_dsl_value(
            &pack::json!({ "artifactRef": artifact_ref, "documentId": row.id.clone(), "spaceId": doc.snapshot.space_id.clone(), "schema": row.schema.clone(), "role": payload.role.clone(), "pluginId": payload.plugin_id.clone(), "appId": payload.app_id.clone() }),
        )),
    }))
}

