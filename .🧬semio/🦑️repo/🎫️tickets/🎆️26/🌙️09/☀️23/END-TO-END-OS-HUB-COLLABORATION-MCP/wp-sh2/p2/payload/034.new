{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/space/space/transient/mutation/ApplyDirectoryEvents/schema.json",
  "title": "ApplyDirectoryEvents",
  "description": "📥️ One bounded batch of this space's directory events (canonical JSON, strictly ascending, strictly after the frontier it continues; afterSeqExclusive 0 restarts from the origin) folded into the Space index transient projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spaceId",
    "afterSeqExclusive",
    "eventsJson"
  ],
  "properties": {
    "spaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "afterSeqExclusive": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventsJson": {
      "type": "string",
      "minLength": 2,
      "maxLength": 65536
    }
  }
}
