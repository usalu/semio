
use super::*;

#[semio_framework_async_macros::async_test]
async fn create_space_index_viewer_builds_a_definition_for_this_dialect() {
    let def = create_space_index_viewer();
    assert_eq!(def.dialect, SPACE_INDEX_DIALECT.into());
}

#[semio_framework_async_macros::async_test]
async fn viewer_dialect_matches_the_artifact_coordinate() {
    assert_eq!(<SpaceIndexViewer as ArtifactViewer>::DIALECT, SPACE_INDEX_DIALECT);
}

#[semio_framework_async_macros::async_test]
async fn an_unknown_body_key_falls_back_to_a_text_node() {
    let snapshot = SSpaceSnapshot::default();
    let history = semio_framework_plugin::HistoryView::empty();
    let doc = ArtifactView::new(&snapshot, &history);
    let tree = <SpaceIndexViewer as ArtifactViewer>::render("nope", &doc, &ConfigView { snapshot: &NoConfig::default(), window: None }, &semio_framework_plugin::ViewModel::default()).expect("unknown Space viewer body tree");
    let json = semio_framework_plugin::artifact_app_laws::project_and_retire_fixture_tree(tree).expect("unknown Space viewer body projection");
    assert!(json.contains("Unknown body"));
}

/// 🧵️ The viewer's two feeds are chrome-only, migrated, transient-only routes of one exact roster.
#[semio_framework_async_macros::async_test]
async fn the_viewer_declares_its_feeds_as_chrome_only_transient_routes() {
    let def = create_space_index_viewer();
    for id in SPACE_INDEX_VIEW_TOOL_IDS {
        let action = def.actions.iter().find(|action| action.id == *id).unwrap_or_else(|| panic!("the viewer declares {id}"));
        assert_eq!(action.semantics.audience, Some(semio_framework_plugin::CapabilityAudience::Chrome));
    }
    assert_eq!(<SpaceIndexViewCommand as protocol::OpBinary>::TOOL_JOB_IDS, SPACE_INDEX_VIEW_TOOL_IDS);
    assert_eq!(<SpaceIndexViewer as ArtifactViewer>::bounded_first_step_tool_proofs().len(), SPACE_INDEX_VIEW_TOOL_IDS.len());
    assert!(<SpaceIndexViewCommandJobFactory as semio_framework_plugin::ArtifactOwnedToolJobFactory>::PUBLICATION_CONTRACTS.iter().all(|contract| contract.lanes.len() == 1 && matches!(contract.lanes[0], ArtifactToolPublicationLane::Transient)));
    assert!(SpaceIndexViewer::command_from_action("bogus", None).is_err());
    let encoded = protocol::OpBinary::encode_op(&SpaceIndexViewCommand::default()).expect("binary command");
    assert_eq!(<SpaceIndexViewCommand as protocol::OpBinary>::decode_op(&encoded).expect("binary round trip"), SpaceIndexViewCommand::default());
}

/// 👁️ The Space viewer never mutates the document, draft or config — proven over the REGISTERED viewer surface, fed exactly
/// as the host feeds it: the directory batch and the presence row each settle as a transient item and nothing else, and the
/// host-facing table lists the folded directory row with its presence. (The generic `assert_viewer_never_mutates` fixture
/// admits only lane-less viewers; this surface owns a transient lane.)
#[semio_framework_async_macros::async_test]
async fn the_viewers_feeds_publish_only_transient_items() {
    use crate::viewer::space_index::transient::tests::{origin_of, publishes_only_transient_state, Registered, SPACE};
    use semio_framework_plugin::PluginApp;
    let mut app = Registered::bound(semio_framework_plugin::VcsArtifactApp::<ViewerApp<SpaceIndexViewer>>::with_registry(Default::default(), semio_framework_plugin::AppActionRegistry::from_definition(&create_space_index_viewer())).await).await;
    let meta = semio_framework_plugin::artifact_app_laws::meta("local");
    for (action, args) in [
        ("foldDirectoryEvents", pack::json!({ "spaceId": SPACE, "afterSeqExclusive": 0, "eventsJson": pack::to_json_string(&origin_of("artifact-1")) })),
        ("presenceHeartbeat", pack::json!({ "artifactId": "artifact-1", "actorsCsv": "user:u-2#s1" })),
    ] {
        app.handle_action(action, Some(&pack::json_to_dsl_value(&args)), &meta).await.unwrap_or_else(|error| panic!("the viewer admits {action}: {error:?}"));
        let settled = semio_framework_plugin::artifact_app_laws::settle_registered_typed_operation(&mut *app, 1).await.expect("the feed settles");
        assert!(publishes_only_transient_state(&settled.lanes), "{action} writes only the transient lane: {:?}", settled.lanes);
    }
    let rendered = app.render(main::BODY_KEY, None, &semio_framework_plugin::ViewModel::default()).await.expect("host-facing viewer render");
    let json = semio_framework_plugin::artifact_app_laws::project_and_retire_fixture_tree(rendered).expect("viewer projection");
    assert!(json.contains("artifact:artifact-1") && json.contains("First"), "the viewer lists the folded directory row: {json}");
    assert!(json.contains("user:u-2#s1"), "the viewer shows the row's presence: {json}");
}
