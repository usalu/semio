//! 👁️ S Space index viewer — the read-only counterpart of `✏️editor` for this subset (ticket
//! 26/08/16/HUB-SPACES-LIVE-PRESENCE-AND-COLLABORATIVE-STUDIOS §C4, contract
//! 26/08/16/ARTIFACT-VIEWERS-AND-EDITORS-PER-SUBSET §2.2). `SpaceIndexViewer` implements
//! `ArtifactViewer`, never `ArtifactEditor`/`ArtifactApp` — `ViewerApp<SpaceIndexViewer>` (framework
//! SDK) is the sole runtime adapter, so this file can never structurally emit an artifact or draft
//! mutation. MUST NOT import anything from the sibling `✏️editor` (`policyViewerPurityBreaches`).
//!
//! 🫧️ The viewer OWNS the Space index's transient lane (`🫧️transient`: the folded directory of this space and the live
//! presence rows) and the editor reuses it, so a spectator's Space table lists the same directory-owned rows — with the
//! same "Updated" moved by every check-in — as an author's (ticket 26/09/23 SH2 P2).

use crate::standards::v1::subsets::any::schema::snapshot::SSpaceSnapshot;
use crate::viewer::space_index::modes::view;
use crate::viewer::space_index::modes::view::windows::main;
use crate::viewer::space_index::transient::{ApplyDirectoryEvents, SetArtifactPresence, SpaceIndexTransient, SpaceIndexTransientMutation, SpaceIndexTransientRetirementFactory, SpaceIndexTransientWork};
use crate::SPACE_INDEX_DIALECT;
use semio_framework_plugin::app::{Dialect, InteractionView};
use semio_framework_plugin::retained_command::{ArtifactRetainedCommandInputs, ArtifactRetainedCommandJob, ArtifactRetainedCommandPayload};
use semio_framework_plugin::{
    built_to_component_tree, AppOperationContext, ArtifactOwnedToolJobRequest, ArtifactToolFactoryRegistry, ArtifactToolPublicationContract, ArtifactToolPublicationLane, ArtifactView, ArtifactViewer, ComponentTree, ConfigView, DslValue, Fault, FaultOrigin,
    InteractiveJobClassification, LocalizedLabel, NoConfig, NoConfigMutation, NoPresence, NoPresenceMutation, ToolExecutionContract, ToolFactoryKey, ToolJobFactoryError, UiAssemblyResult, ViewEmit, Viewer, ViewerApp,
};
use store::EngineHandles;

//#region 🔖️Command
/// 🏷️ Every verb the read-only Space index is dispatched with: the host's directory batches and presence rows, nothing a
/// human authors.
pub const SPACE_INDEX_VIEW_TOOL_IDS: &[&str] = &["foldDirectoryEvents", "presenceHeartbeat"];
const SPACE_INDEX_VIEW_RETAINED_PAYLOAD_SCHEMA: &str = "s.space.index.view-tool-command.v1";
const SPACE_INDEX_VIEW_RETAINED_RAW_BYTES: usize = 128 * 1024;
const SPACE_INDEX_VIEW_RETAINED_OUTPUT_BYTES: usize = 4 * 1024 * 1024;

/// 👁️ The read-only Space index's typed command channel: the host's two feeds, each ONE transient item on the shared route
/// ([`SpaceIndexTransientWork`]). A transient item is not a document mutation — the artifact lane stays unreachable by
/// construction.
///
/// 🔒️ Row order is the binary variant ordinal: appending is safe, reordering is a wire break.
#[derive(Clone, Debug, PartialEq, value_derive::ToValue, value_derive::FromValue, dsl::DslOps)]
pub enum SpaceIndexViewCommand {
    /// 📥️ One bounded batch of this space's directory events, continuing `after_seq_exclusive` (`0` = from the origin).
    #[dsl(key = "fold-directory-events")]
    FoldDirectoryEvents { space_id: String, after_seq_exclusive: u64, events_json: String },
    /// 👥️ The live actors on one artifact's documents.
    #[dsl(key = "presence-heartbeat")]
    PresenceHeartbeat { artifact_id: String, actors_csv: String },
}

impl Default for SpaceIndexViewCommand {
    /// 🌱️ An empty batch, which the route refuses as invalid rather than applying: there is no "do nothing" verb.
    fn default() -> Self {
        Self::FoldDirectoryEvents { space_id: String::new(), after_seq_exclusive: 0, events_json: String::new() }
    }
}

impl SpaceIndexViewCommand {
    /// 🪪️ The manifest action id this command stands for.
    pub fn action_id(&self) -> &'static str {
        match self {
            Self::FoldDirectoryEvents { .. } => "foldDirectoryEvents",
            Self::PresenceHeartbeat { .. } => "presenceHeartbeat",
        }
    }
}

impl protocol::OpBinary for SpaceIndexViewCommand {
    /// 🎯️ The exact manifest ids this typed command schema owns — equal to the `bounded_first_step_tool_proofs!` rows.
    const TOOL_JOB_IDS: &'static [&'static str] = SPACE_INDEX_VIEW_TOOL_IDS;
    fn encode_op(&self) -> Result<Vec<u8>, protocol::ProtocolError> {
        dsl::variants_binary::encode_op(self)
    }
    fn decode_op(bytes: &[u8]) -> Result<Self, protocol::ProtocolError> {
        dsl::variants_binary::decode_op(bytes)
    }
}

/// 🫧️ The transient verb a viewer command stands for, for the route both Space surfaces share.
fn space_index_view_transient_item(command: &SpaceIndexViewCommand) -> Option<SpaceIndexTransientMutation> {
    Some(match command {
        SpaceIndexViewCommand::FoldDirectoryEvents { space_id, after_seq_exclusive, events_json } => ApplyDirectoryEvents { space_id: space_id.clone(), after_seq_exclusive: *after_seq_exclusive, events_json: events_json.clone() }.into(),
        SpaceIndexViewCommand::PresenceHeartbeat { artifact_id, actors_csv } => SetArtifactPresence { artifact_id: artifact_id.clone(), actors_csv: actors_csv.clone() }.into(),
    })
}
//#endregion 🔖️Command

//#region 🧵️RetainedCommands
fn space_index_view_retained_contract() -> ToolExecutionContract {
    ToolExecutionContract::bounded_first_step(SPACE_INDEX_VIEW_RETAINED_RAW_BYTES, 64, 1, SPACE_INDEX_VIEW_RETAINED_OUTPUT_BYTES, 7_500)
}

pub struct SpaceIndexViewCommandJobFactory {
    keys: Vec<ToolFactoryKey>,
}

impl SpaceIndexViewCommandJobFactory {
    fn new(controller_id: &str) -> Self {
        Self { keys: SPACE_INDEX_VIEW_TOOL_IDS.iter().map(|tool_id| ToolFactoryKey::new(controller_id, *tool_id)).collect() }
    }
}

impl semio_framework_plugin::ToolJobFactory for SpaceIndexViewCommandJobFactory {
    type Payload = ArtifactRetainedCommandPayload<ViewerApp<SpaceIndexViewer>>;
    type Job = ArtifactRetainedCommandJob<ViewerApp<SpaceIndexViewer>>;

    fn keys(&self) -> &[ToolFactoryKey] {
        &self.keys
    }
    fn payload_schema_id(&self) -> &str {
        SPACE_INDEX_VIEW_RETAINED_PAYLOAD_SCHEMA
    }
    fn classification(&self) -> InteractiveJobClassification {
        InteractiveJobClassification::Migrated
    }
    fn execution_contract(&self) -> ToolExecutionContract {
        space_index_view_retained_contract()
    }
    fn create_job(&mut self, _operation: semio_framework_job::Operation, payload: Self::Payload) -> Result<Self::Job, ToolJobFactoryError> {
        Ok(ArtifactRetainedCommandJob::new(payload))
    }
    fn create_job_from_wire_pages_with_payload(
        &mut self,
        _operation: semio_framework_job::Operation,
        payload: Self::Payload,
        input: semio_framework_plugin::action_bus::RetainedToolWireInput,
        checkpoint: Option<semio_framework_plugin::action_bus::RetainedToolWireInput>,
    ) -> Result<Self::Job, (ToolJobFactoryError, semio_framework_plugin::action_bus::RetainedToolWireInput, Option<semio_framework_plugin::action_bus::RetainedToolWireInput>)> {
        if input.declared_bytes() > SPACE_INDEX_VIEW_RETAINED_RAW_BYTES || checkpoint.is_some() {
            return Err((ToolJobFactoryError::new("Space index view command rejects an oversized wire or a checkpoint owner"), input, checkpoint));
        }
        Ok(ArtifactRetainedCommandJob::from_wire(payload, input))
    }
}

impl semio_framework_plugin::ArtifactOwnedToolJobFactory for SpaceIndexViewCommandJobFactory {
    type Owner = ViewerApp<SpaceIndexViewer>;
    const TOOL_IDS: &'static [&'static str] = SPACE_INDEX_VIEW_TOOL_IDS;
    const DOCUMENT_SCHEMA: &'static str = crate::S_SPACE_INDEX_DOCUMENT_SCHEMA;
    /// 🔒️ TRANSIENT ONLY — naming `ArtifactToolPublicationLane::Artifact` here would be refused against a viewer's emit.
    const PUBLICATION_CONTRACTS: &'static [ArtifactToolPublicationContract] = &[
        ArtifactToolPublicationContract { tool_id: "foldDirectoryEvents", lanes: &[ArtifactToolPublicationLane::Transient] },
        ArtifactToolPublicationContract { tool_id: "presenceHeartbeat", lanes: &[ArtifactToolPublicationLane::Transient] },
    ];
}
//#endregion 🧵️RetainedCommands

//#region 🔖️Viewer
#[derive(Default, Clone, Copy)]
pub struct SpaceIndexViewer;

impl ArtifactViewer for SpaceIndexViewer {
    type Snapshot = SSpaceSnapshot;
    type Mutation = crate::standards::v1::subsets::any::schema::mutations::SSpaceMutation;
    type Config = NoConfig;
    type ConfigMutation = NoConfigMutation;
    type Presence = NoPresence;
    type PresenceMutation = NoPresenceMutation;
    type Transient = SpaceIndexTransient;
    type TransientMutation = SpaceIndexTransientMutation;
    type Command = SpaceIndexViewCommand;

    const DIALECT: Dialect = SPACE_INDEX_DIALECT;
    const DOCUMENT_SCHEMA: &'static str = crate::S_SPACE_INDEX_DOCUMENT_SCHEMA;

    fn initial_snapshot() -> SSpaceSnapshot {
        SSpaceSnapshot::default()
    }

    /// 🫧️ One bounded batch or presence row per publication, roots retired by the transient's own byte estimate.
    fn build_transient_store_disposer() -> Option<Box<dyn semio_framework_plugin::ArtifactOwnedDisposer<store::TransientStore<Self::Transient, Self::TransientMutation>>>> {
        Some(semio_framework_plugin::transient_store_disposer::<Self::Transient, Self::TransientMutation>(std::sync::Arc::new(SpaceIndexTransientRetirementFactory)))
    }

    fn build_transient_store_one_item_preparation_factory() -> Option<std::sync::Arc<dyn store::ArtifactEphemeralOneItemPreparationFactory<Self::Transient, Self::TransientMutation>>> {
        Some(semio_framework_plugin::bounded_transient_preparation_factory::<Self::Transient, Self::TransientMutation>())
    }

    fn build_transient_local_root_retirement_factory() -> Option<std::sync::Arc<dyn store::SnapshotRetirementFactory<Self::Transient>>> {
        Some(std::sync::Arc::new(SpaceIndexTransientRetirementFactory))
    }

    fn register_tool_job_factories(registry: &mut ArtifactToolFactoryRegistry<'_, ViewerApp<Self>>) -> Result<(), Fault> {
        let controller = registry.controller_id().to_string();
        registry.register(SpaceIndexViewCommandJobFactory::new(&controller))
    }

    semio_framework_plugin::bounded_first_step_tool_proofs! {
        owner: ViewerApp<SpaceIndexViewer>,
        owner_file: "✏️s/🔌️plugins/🪐️space/🗿️artifacts/🪐️space/🏅️standards/🔖️1/🪆️subsets/✳️any/👁️viewer/🦀️.rs",
        controller: "s.space.space@1/*#viewer",
        artifact_schema: "s.space",
        factory: "SpaceIndexViewCommandJobFactory",
        factory_type: SpaceIndexViewCommandJobFactory,
        contract: space_index_view_retained_contract(),
        tools: ["foldDirectoryEvents", "presenceHeartbeat"]
    }

    fn build_tool_job(request: ArtifactOwnedToolJobRequest<ViewerApp<Self>>) -> Result<Option<semio_framework_plugin::ToolOperationSpec>, Fault> {
        if !SPACE_INDEX_VIEW_TOOL_IDS.contains(&request.tool_id.as_str()) {
            return Ok(None);
        }
        if request.command.action_id() != request.tool_id {
            return Err(Fault::new(FaultOrigin::App, "s.space.index.view.tool-mismatch", "the Space index view command does not match its registered tool"));
        }
        if !space_index_view_transient_item(&request.command).is_some_and(|item| item.is_bounded()) {
            return Err(Fault::new(FaultOrigin::App, "s.space.index.view.payload-too-large", "the Space index view command exceeds its one-batch bound"));
        }
        let tool_id = request.command.action_id();
        let work = Box::new(SpaceIndexTransientWork::<ViewerApp<Self>>::new(tool_id, space_index_view_transient_item));
        let operation = AppOperationContext {
            app_instance_id: request.app_instance_id,
            parent_document_id: request.parent_document_id.clone(),
            operation_id: request.operation.operation.0,
            generation: request.operation.generation.0,
            canonical_base_revision: request.canonical_base_revision,
            authoring_seed: request.authoring_seed.clone(),
        };
        let payload = ArtifactRetainedCommandPayload::try_new(
            ArtifactRetainedCommandInputs { command: *request.command, snapshot: request.snapshot, config: request.config, history: request.history, interaction_state: request.interaction_state, interaction_hover: request.interaction_hover, context: Some(request.context), operation, completion: request.completion },
            SpaceIndexViewCommand::action_id,
            SPACE_INDEX_VIEW_RETAINED_RAW_BYTES,
            1,
            work,
        )?;
        Ok(Some(semio_framework_plugin::ToolOperationSpec::new(request.controller_id, request.tool_id, request.payload_schema_id, payload, request.operation)))
    }

    fn command_id(command: &Self::Command) -> &'static str {
        command.action_id()
    }

    /// 🎯️ The host's two feeds are the only actions this surface is dispatched with; anything else is refused by name.
    fn command_from_action(action: &str, args: Option<&DslValue>) -> Result<Self::Command, Fault> {
        let str_field = |key: &str| args.and_then(|value| value.get(key)).and_then(DslValue::as_str).map(str::to_string).unwrap_or_default();
        let u64_field = |key: &str| args.and_then(|value| value.get(key)).and_then(DslValue::as_f64).map_or(0, |value| value as u64);
        match action {
            "foldDirectoryEvents" => Ok(SpaceIndexViewCommand::FoldDirectoryEvents { space_id: str_field("spaceId"), after_seq_exclusive: u64_field("afterSeqExclusive"), events_json: str_field("eventsJson") }),
            "presenceHeartbeat" => Ok(SpaceIndexViewCommand::PresenceHeartbeat { artifact_id: str_field("artifactId"), actors_csv: str_field("actorsCsv") }),
            other => Err(Fault::new(FaultOrigin::App, "s.space.index.view.unknown-action", format!("the Space index viewer declares no action {other}"))),
        }
    }

    /// 👁️ Structurally read-only and inert: a feed is admitted ONLY on the retained route ([`SpaceIndexTransientWork`]).
    fn handle(_command: &Self::Command, _doc: &ArtifactView<'_, Self::Snapshot>, _cfg: &ConfigView<'_, Self::Config>, _interaction: &InteractionView<'_>, _view_state: Option<&semio_framework_plugin::ViewModel>, _engines: &EngineHandles) -> Result<ViewEmit<Self::ConfigMutation>, Fault> {
        Ok(ViewEmit::default())
    }

    /// 👁️ The bare render has no transient: the table is empty. The host renders through [`Self::render_with_request_context`].
    fn render(body_key: &str, doc: &ArtifactView<'_, Self::Snapshot>, _cfg: &ConfigView<'_, Self::Config>, view_state: &semio_framework_plugin::ViewModel) -> UiAssemblyResult<ComponentTree> {
        render_view_body(body_key, doc.snapshot, &SpaceIndexTransient::default(), view_state)
    }

    /// 👁️ The SAME table the editor's main window renders, read-only: the directory-owned rows of this space's own transient,
    /// never the index document's retired artifact rows.
    fn render_with_request_context(
        _owner: &semio_framework_plugin::ArtifactInstanceOperationOwnerHandle,
        body_key: &str,
        doc: &ArtifactView<'_, Self::Snapshot>,
        _cfg: &ConfigView<'_, Self::Config>,
        view_state: &semio_framework_plugin::ViewModel,
        transient: &semio_framework_plugin::TransientView<'_, Self::Transient>,
        _interaction: &InteractionView<'_>,
    ) -> UiAssemblyResult<ComponentTree> {
        render_view_body(body_key, doc.snapshot, transient.snapshot, view_state)
    }
}

/// 👁️ One viewer body from the index document and the folded transient.
pub fn render_view_body(body_key: &str, document: &SSpaceSnapshot, transient: &SpaceIndexTransient, view_state: &semio_framework_plugin::ViewModel) -> UiAssemblyResult<ComponentTree> {
    match body_key {
        main::BODY_KEY => Ok(built_to_component_tree(main::render(document, transient, view_state)?)),
        _ => semio_framework_plugin::built_text_to_component_tree(semio_framework_plugin::Label::data(format!("Unknown body: {body_key}"))),
    }
}
//#endregion 🔖️Viewer

//#region 🔖️Manifest
pub fn create_space_index_viewer() -> semio_framework_plugin::AppDefinition {
    Viewer::builder(SPACE_INDEX_DIALECT)
        .document(["semio", "s", "space", "index"])
        .icon_id("layout-grid")
        .mode_def(view::definition())
        .default_mode_id(view::SPACE_INDEX_MODE_VIEW)
        .window_kind_def(main::definition())
        .default_layout(view::layout())
        .view_action("foldDirectoryEvents", LocalizedLabel::native("Fold Directory Events", "Verzeichnisereignisse übernehmen"))
        .view_action("presenceHeartbeat", LocalizedLabel::native("Presence Heartbeat", "Präsenz-Heartbeat"))
        .action_interactive_job("foldDirectoryEvents", InteractiveJobClassification::Migrated)
        .action_interactive_job("presenceHeartbeat", InteractiveJobClassification::Migrated)
        .action_audience("foldDirectoryEvents", semio_framework_plugin::CapabilityAudience::Chrome)
        .action_audience("presenceHeartbeat", semio_framework_plugin::CapabilityAudience::Chrome)
        .build_definition()
}
//#endregion 🔖️Manifest

