//! 📇️ SpaceIndexEditor commands command — `fold-directory-events`: one bounded batch of this space's directory events,
//! fed by the host's space lane (`🏛️ShellHost/📇️space-directory`), folded into the viewer-owned transient projection
//! (`👁️viewer/🫧️transient`) through the canonical kernel fold — never into the shared `SSpaceSnapshot` document
//! (contract §C4: space name/kind/visibility/members are directory-owned) and never into config history.
//!
//! A batch carries at most one hub page of events, strictly after the frontier `after_seq_exclusive` the projection holds;
//! `0` restarts the projection from the origin. So a space's history of any length — every check-in publishes one
//! `artifact.checkpoint-published` event — folds in bounded steps, and a checkpoint moves its row's "Updated" within the
//! one batch that carries it.

use crate::standards::v1::subsets::any::schema::mutations::SSpaceMutation;
use crate::standards::v1::subsets::any::schema::snapshot::SSpaceSnapshot;
use crate::viewer::space_index::transient::{ApplyDirectoryEvents, SpaceIndexTransientMutation};
use semio_framework_plugin::{ArtifactView, ConfigView, Emit, Fault, FaultOrigin, NoConfig, NoConfigMutation};

#[derive(Clone, Debug, PartialEq, value_derive::ToValue, value_derive::FromValue, dsl::DslRecord)]
#[dsl(keyword = "fold-directory-events")]
pub struct FoldDirectoryEvents {
    /// 🪪️ The one space every event of the batch names.
    pub space_id: String,
    /// 🚦️ The frontier the batch continues; `0` restarts the projection from the origin.
    pub after_seq_exclusive: u64,
    /// 📄️ The batch's directory events, canonical JSON, strictly ascending and strictly after the frontier.
    pub events_json: String,
}

impl FoldDirectoryEvents {
    /// 🫧️ The transient item this batch folds as.
    pub fn item(&self) -> SpaceIndexTransientMutation {
        ApplyDirectoryEvents { space_id: self.space_id.clone(), after_seq_exclusive: self.after_seq_exclusive, events_json: self.events_json.clone() }.into()
    }
}

/// 🚫️ The direct lane never folds a batch: without the retained route there is no captured transient to judge it against.
pub fn handle(_payload: &FoldDirectoryEvents, _doc: &ArtifactView<'_, SSpaceSnapshot>, _cfg: &ConfigView<'_, NoConfig>) -> Result<Emit<SSpaceMutation, NoConfigMutation>, Fault> {
    Err(Fault::new(FaultOrigin::App, "s.space.fold-directory-events.requires-retained-job", "a directory batch folds only as the retained job"))
}

