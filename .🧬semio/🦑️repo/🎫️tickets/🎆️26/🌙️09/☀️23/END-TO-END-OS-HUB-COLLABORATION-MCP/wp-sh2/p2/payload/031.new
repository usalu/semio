//! 🫧️ S Space index app-transient mutation aggregate — two verbs, both derived and never undone: fold one bounded directory
//! batch of this space into the projection, and replace one artifact's live presence row.

use super::SpaceIndexTransient;

#[path = "📥️apply-directory-events/🦀️.rs"]
mod apply_directory_events;
pub use apply_directory_events::ApplyDirectoryEvents;

#[path = "👥️set-artifact-presence/🦀️.rs"]
mod set_artifact_presence;
pub use set_artifact_presence::SetArtifactPresence;

#[derive(Clone, Debug, PartialEq, value_derive::ToValue, value_derive::FromValue, dsl::DslOps, dsl::Mutations)]
#[mutations(snapshot = SpaceIndexTransient, diff = SpaceIndexTransient, schema = "s.space.space.transient")]
pub enum SpaceIndexTransientMutation {
    #[dsl(key = "apply-directory-events")]
    ApplyDirectoryEvents(ApplyDirectoryEvents),
    #[dsl(key = "set-artifact-presence")]
    SetArtifactPresence(SetArtifactPresence),
}

impl protocol::OpText for SpaceIndexTransientMutation {
    fn parse_op(line: &str) -> Result<Self, store::TextError> {
        let variants = <Self as dsl::DslVariants>::variants();
        for (keyword, spec_fn) in &variants {
            let probe = format!("{keyword} ");
            if line == keyword.as_str() || line.starts_with(&probe) {
                let record = dsl::parse(line, &spec_fn(), &dsl::ParseOptions { limits: dsl::Limits::default(), mode: dsl::SourceMode::Inline })?;
                return <Self as dsl::DslVariants>::from_named_record(keyword, &record);
            }
        }
        Err(dsl::__rt::field_error(format!("unknown operation line '{line}'")))
    }
    fn print_op(&self) -> String {
        let (keyword, record) = <Self as dsl::DslVariants>::to_named_record(self);
        let variants = <Self as dsl::DslVariants>::variants();
        let spec_fn = variants.iter().find(|(key, _)| key == &keyword).map(|(_, spec)| *spec).expect("variant spec must exist for its own keyword");
        dsl::print(&record, &spec_fn(), dsl::JoinMode::Inline)
    }
}

impl protocol::OpBinary for SpaceIndexTransientMutation {
    fn encode_op(&self) -> Result<Vec<u8>, protocol::ProtocolError> {
        dsl::variants_binary::encode_op(self)
    }
    fn decode_op(bytes: &[u8]) -> Result<Self, protocol::ProtocolError> {
        dsl::variants_binary::decode_op(bytes)
    }
}

impl protocol::MutationDiff<SpaceIndexTransient> for SpaceIndexTransient {
    fn apply(&self, _base: &SpaceIndexTransient) -> protocol::MutationApplyResult<SpaceIndexTransient> {
        Ok(self.clone())
    }
    fn absorb(&mut self, other: Self) {
        *self = other;
    }
}

/// ⚖️ One verb's outcome over `base` from its judgement: the next transient, a warned no-op, or the named refusal.
fn outcome(verb: &SpaceIndexTransientMutation, base: &SpaceIndexTransient, target: &'static str, unchanged: &str) -> protocol::MutationOutcome<SpaceIndexTransient> {
    match verb.judge(base) {
        Ok(Some(next)) => protocol::MutationOutcome::new(next),
        Ok(None) => protocol::MutationOutcome::new(base.clone()).warn("mutation.no-op", unchanged.to_owned()),
        Err(fault) => protocol::MutationOutcome::new(base.clone()).absorb_messages([protocol::MutationMessage::error(fault.code, fault.message.as_str()).at([target])]),
    }
}

//#region 🌉️TestBridge
/// 🌉️ The committed-vector report of this state lane for the language-neutral case adapter, which links only this crate:
/// production dispatch (`Mutation::diff(..).apply_to`) and the mutation's own inverse over `SpaceIndexTransient`.
///
/// @see store::os_store::test_support::mutation_report_json
pub fn space_index_transient_mutation_report_json(base_json: &str, mutation_json: &str, after_json: &str) -> Result<String, String> {
    store::os_store::test_support::mutation_report_json::<SpaceIndexTransient, SpaceIndexTransientMutation>(base_json, mutation_json, after_json)
}
//#endregion 🌉️TestBridge
