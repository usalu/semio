{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/os/config/mutation/admit-local-document/schema.json",
  "title": "AdmitLocalDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admittedAtMs",
    "documentId",
    "name",
    "schema",
    "storage",
    "target"
  ],
  "properties": {
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "storage": {
      "$ref": "#/$defs/LocalDocumentStorage"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "admittedAtMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "LocalDocumentStorage": {
      "type": "string",
      "enum": [
        "folder",
        "file"
      ],
      "description": "folder = a folder event log (`.semio/documents.db`), file = one document file"
    },
    "LocalDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admittedAtMs",
        "documentId",
        "name",
        "schema",
        "storage",
        "target"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "storage": {
          "$ref": "#/$defs/LocalDocumentStorage"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "admittedAtMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "LocalCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "x-semio-state": "config",
          "items": {
            "$ref": "#/$defs/LocalDocument"
          }
        }
      }
    }
  }
}
