{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/space/space/transient/schema.json",
  "title": "SpaceIndexTransient",
  "description": "🫧️ The Space index's app-local transient state, shared by its editor and viewer: the kernel read model folded from exactly this space's directory events (never persisted, shared or undone; replayed from the origin whenever a Space surface mounts) and the live presence per artifact — all empty before the first batch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spaceId",
    "directory",
    "presence"
  ],
  "properties": {
    "spaceId": {
      "type": "string",
      "maxLength": 256
    },
    "directory": {
      "$ref": "https://json.schemas.assets.semio-tech.com/os/directory/component.json#/$defs/DirectoryReadModel"
    },
    "presence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SpaceIndexArtifactPresence"
      }
    }
  },
  "$defs": {
    "SpaceIndexArtifactPresence": {
      "description": "👥️ The live actors on one artifact's documents, comma-separated.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "actorsCsv"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actorsCsv": {
          "type": "string",
          "maxLength": 4096
        }
      }
    }
  }
}
