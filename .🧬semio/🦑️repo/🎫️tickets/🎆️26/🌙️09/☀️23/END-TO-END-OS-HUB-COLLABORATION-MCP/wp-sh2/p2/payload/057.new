{
  "controller": "s-space-index",
  "documentSchema": "s.space",
  "factory": "SpaceIndexRetainedCommandJobFactory",
  "limits": {
    "bounded": {
      "maxRawBytes": 131072,
      "maxDecodedItems": 64,
      "maxWorkUnitsPerStep": 1,
      "maxOutputBytes": 4194304,
      "maxStepMicros": 7500
    }
  },
  "publicationContracts": [
    {
      "toolId": "createArtifact",
      "lanes": [
        "HostOnly"
      ]
    },
    {
      "toolId": "deleteArtifact",
      "lanes": [
        "Artifact"
      ]
    },
    {
      "toolId": "renameArtifact",
      "lanes": [
        "Artifact"
      ]
    },
    {
      "toolId": "requestDeleteArtifact",
      "lanes": [
        "HostOnly"
      ]
    },
    {
      "toolId": "openArtifact",
      "lanes": [
        "HostOnly"
      ]
    },
    {
      "toolId": "openArtifactWith",
      "lanes": [
        "HostOnly"
      ]
    },
    {
      "toolId": "foldDirectoryEvents",
      "lanes": [
        "Transient"
      ]
    },
    {
      "toolId": "presenceHeartbeat",
      "lanes": [
        "Transient"
      ]
    },
    {
      "toolId": "inviteMember",
      "lanes": [
        "HostOnly"
      ]
    },
    {
      "toolId": "removeMember",
      "lanes": [
        "HostOnly"
      ]
    },
    {
      "toolId": "setVisibility",
      "lanes": [
        "HostOnly"
      ]
    },
    {
      "toolId": "copyInviteLink",
      "lanes": [
        "HostOnly"
      ]
    },
    {
      "toolId": "requestInviteMember",
      "lanes": [
        "HostOnly"
      ]
    }
  ],
  "routes": [
    {
      "id": "createArtifact",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "append one artifact row through the installed artifact preparation factory"
    },
    {
      "id": "deleteArtifact",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "remove one artifact row through the installed artifact preparation factory"
    },
    {
      "id": "renameArtifact",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "rename one artifact row through the installed artifact preparation factory"
    },
    {
      "id": "requestDeleteArtifact",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "open the delete-confirm dialog for one row, publishing nothing"
    },
    {
      "id": "openArtifact",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "relay one open-artifact shell command, publishing nothing"
    },
    {
      "id": "openArtifactWith",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "relay one open-artifact-with shell command, publishing nothing"
    },
    {
      "id": "foldDirectoryEvents",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "fold one bounded directory event batch into the transient projection through the installed transient preparation factory"
    },
    {
      "id": "presenceHeartbeat",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "replace one artifact's presence row through the installed transient preparation factory"
    },
    {
      "id": "inviteMember",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "relay one upsert-member directory command, publishing nothing"
    },
    {
      "id": "removeMember",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "relay one remove-member directory command, publishing nothing"
    },
    {
      "id": "setVisibility",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "relay one set-visibility directory command, publishing nothing"
    },
    {
      "id": "copyInviteLink",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "relay one share-link directory command, publishing nothing"
    },
    {
      "id": "requestInviteMember",
      "execution": "bounded",
      "status": "Migrated",
      "feature": "open the invite dialog, publishing nothing"
    }
  ],
  "oracle": {
    "library": "serde_json",
    "scope": "test-only-existing-dependency",
    "ownedInterface": "SpaceRetainedCatalogOracle",
    "runtimeDependency": false,
    "expected": {
      "routes": 13,
      "bounded": 13,
      "batch": 0,
      "migrated": 13,
      "unique": true
    }
  }
}
