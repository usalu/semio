{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/space/home/config/schema.json",
  "title": "HomeConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "retiredLocalStudioIds": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "x-semio-state": "config"
    }
  }
}
