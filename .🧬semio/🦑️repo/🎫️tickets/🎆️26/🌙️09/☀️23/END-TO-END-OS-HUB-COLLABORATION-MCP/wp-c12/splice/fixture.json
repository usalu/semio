  "rebases": [
    {
      "id": "nothing-pending",
      "note": "no local splice pending: the remote text, the caret keeps its context",
      "remote": "Oh. Hello",
      "unapplied": [],
      "local": "Hello",
      "selection": {
        "anchor": 5,
        "caret": 5
      },
      "expected": {
        "text": "Oh. Hello",
        "anchor": 9,
        "caret": 9
      }
    },
    {
      "id": "pending-typing-over-a-remote-prefix",
      "note": "the unapplied local run folds onto the remote text; the caret follows it",
      "remote": "Oh. Hello",
      "unapplied": [
        {
          "start": 5,
          "deleted": "",
          "insert": " there",
          "before": "Hello",
          "after": ""
        }
      ],
      "local": "Hello there",
      "selection": {
