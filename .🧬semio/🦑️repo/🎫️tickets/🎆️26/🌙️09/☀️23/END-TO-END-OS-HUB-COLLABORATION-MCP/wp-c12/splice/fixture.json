{
  "schema": "semio.ui.scene.text-splice.v1",
  "contextScalars": 32,
  "minTwoSidedScalars": 4,
  "edits": [
    {
      "id": "insert-into-empty",
      "previous": "",
      "next": "a",
      "splice": {
        "start": 0,
        "deleted": "",
        "insert": "a",
        "before": "",
        "after": ""
      }
    },
    {
      "id": "replace-a-middle-run",
      "previous": "abcdef",
      "next": "abXYef",
      "splice": {
        "start": 2,
        "deleted": "cd",
        "insert": "XY",
        "before": "ab",
        "after": "ef"
      }
    },
    {
      "id": "delete-a-suffix",
      "previous": "hello",
      "next": "help",
      "splice": {
        "start": 3,
        "deleted": "lo",
        "insert": "p",
        "before": "hel",
        "after": ""
      }
    },
    {
      "id": "astral-insert",
      "previous": "a😀b",
      "next": "a😀Zb",
      "splice": {
        "start": 2,
        "deleted": "",
        "insert": "Z",
        "before": "a😀",
        "after": "b"
      }
    },
    {
      "id": "unchanged",
      "previous": "same",
      "next": "same",
      "splice": null
    },
    {
      "id": "delete-everything",
      "previous": "xyz",
      "next": "",
      "splice": {
        "start": 0,
        "deleted": "xyz",
        "insert": "",
        "before": "",
        "after": ""
      }
    },
    {
      "id": "repeated-letter-inserts-after-the-run",
      "previous": "aa",
      "next": "aaa",
      "splice": {
        "start": 2,
        "deleted": "",
        "insert": "a",
        "before": "aa",
        "after": ""
      }
    },
    {
      "id": "context-is-capped-at-32",
      "previous": "pppppppppppppppppppppppppppppppppppppppp|ssssssssssssssssssssssssssssssssssssssss",
      "next": "pppppppppppppppppppppppppppppppppppppppp+|ssssssssssssssssssssssssssssssssssssssss",
      "splice": {
        "start": 40,
        "deleted": "",
        "insert": "+",
        "before": "pppppppppppppppppppppppppppppppp",
        "after": "|sssssssssssssssssssssssssssssss"
      }
    }
  ],
  "applications": [
    {
      "id": "in-place",
      "note": "the text around the splice is unchanged: it lands at its start",
      "text": "hello world",
      "splice": {
        "start": 6,
        "deleted": "",
        "insert": "big ",
        "before": "hello ",
        "after": "world"
      },
      "located": {
        "start": 6,
        "deleteLength": 0,
        "clamped": false
      },
      "result": "hello big world",
      "inverse": {
        "start": 6,
        "deleted": "big ",
        "insert": "",
        "before": "hello ",
        "after": "world"
      }
    },
    {
      "id": "shifted-by-an-earlier-insert",
      "note": "text inserted before the splice moves it; the context finds it",
      "text": "oh, hello world",
      "splice": {
        "start": 6,
        "deleted": "",
        "insert": "big ",
        "before": "hello ",
        "after": "world"
      },
      "located": {
        "start": 10,
        "deleteLength": 0,
        "clamped": false
      },
      "result": "oh, hello big world",
      "inverse": {
        "start": 10,
        "deleted": "big ",
        "insert": "",
        "before": "oh, hello ",
        "after": "world"
      }
    },
    {
      "id": "deleted-run-moved",
      "note": "a deletion follows its run",
      "text": "XXhello world",
      "splice": {
        "start": 0,
        "deleted": "hello",
        "insert": "",
        "before": "",
        "after": " world"
      },
      "located": {
        "start": 2,
        "deleteLength": 5,
        "clamped": false
      },
      "result": "XX world",
      "inverse": {
        "start": 2,
        "deleted": "",
        "insert": "hello",
        "before": "XX",
        "after": " world"
      }
    },
    {
      "id": "deleted-run-gone",
      "note": "a deletion whose run is gone deletes nothing",
      "text": "hi world",
      "splice": {
        "start": 0,
        "deleted": "hello",
        "insert": "",
        "before": "",
        "after": " world"
      },
      "located": {
        "start": 2,
        "deleteLength": 0,
        "clamped": true
      },
      "result": "hi world",
      "inverse": {
        "start": 2,
        "deleted": "",
        "insert": "",
        "before": "hi",
        "after": " world"
      }
    },
    {
      "id": "one-sided-context",
      "note": "an insert whose two-sided context was split by another insert lands after its left context",
      "text": "hello big world",
      "splice": {
        "start": 6,
        "deleted": "",
        "insert": "new ",
        "before": "hello ",
        "after": "world"
      },
      "located": {
        "start": 6,
        "deleteLength": 0,
        "clamped": false
      },
      "result": "hello new big world",
      "inverse": {
        "start": 6,
        "deleted": "new ",
        "insert": "",
        "before": "hello ",
        "after": "big world"
      }
    },
    {
      "id": "no-context-anywhere",
      "note": "nothing of the context survives: the author's start, clamped to the text",
      "text": "zzz",
      "splice": {
        "start": 9,
        "deleted": "",
        "insert": "!",
        "before": "abc",
        "after": "def"
      },
      "located": {
        "start": 3,
        "deleteLength": 0,
        "clamped": true
      },
      "result": "zzz!",
      "inverse": {
        "start": 3,
        "deleted": "!",
        "insert": "",
        "before": "zzz",
        "after": ""
      }
    },
    {
      "id": "empty-text",
      "note": "a splice into an empty text lands at 0",
      "text": "",
      "splice": {
        "start": 0,
        "deleted": "",
        "insert": "a",
        "before": "",
        "after": ""
      },
      "located": {
        "start": 0,
        "deleteLength": 0,
        "clamped": false
      },
      "result": "a",
      "inverse": {
        "start": 0,
        "deleted": "a",
        "insert": "",
        "before": "",
        "after": ""
      }
    },
    {
      "id": "astral-context",
      "note": "context and positions count scalars",
      "text": "😀😀x😀",
      "splice": {
        "start": 3,
        "deleted": "",
        "insert": "y",
        "before": "😀😀x",
        "after": "😀"
      },
      "located": {
        "start": 3,
        "deleteLength": 0,
        "clamped": false
      },
      "result": "😀😀xy😀",
      "inverse": {
        "start": 3,
        "deleted": "y",
        "insert": "",
        "before": "😀😀x",
        "after": "😀"
      }
    }
  ],
  "concurrent": [
