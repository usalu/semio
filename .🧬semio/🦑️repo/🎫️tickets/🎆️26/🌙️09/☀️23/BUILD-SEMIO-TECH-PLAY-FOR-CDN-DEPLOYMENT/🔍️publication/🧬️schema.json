{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coreName",
    "cases"
  ],
  "properties": {
    "coreName": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "content",
          "declared",
          "writeCore",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "declared": {
            "type": "string"
          },
          "writeCore": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
