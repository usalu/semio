{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frozenOwner",
    "currentOwner",
    "packageEntry",
    "loaderBoundaries",
    "configuration",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "frozenOwner": {
      "type": "string",
      "minLength": 1
    },
    "currentOwner": {
      "type": "string",
      "minLength": 1
    },
    "packageEntry": {
      "type": "string",
      "pattern": "(?:^|/)🟦️\\.mts$"
    },
    "loaderBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standalone",
        "vite"
      ],
      "properties": {
        "standalone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "searchPlace"
          ],
          "properties": {
            "kind": {
              "const": "explicit-search-place"
            },
            "searchPlace": {
              "const": "🟦️.mts"
            }
          }
        },
        "vite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exportName"
          ],
          "properties": {
            "kind": {
              "const": "inline-plugin-array"
            },
            "exportName": {
              "const": "uiPostcssInlinePlugins"
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugins"
      ],
      "properties": {
        "plugins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "@tailwindcss/postcss"
          ],
          "properties": {
            "@tailwindcss/postcss": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "expectedDeclarations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "expectedDeclarations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selector",
                "property",
                "value"
              ],
              "properties": {
                "selector": {
                  "type": "string"
                },
                "property": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
