        {"id": "standing-chewing", "title": {"en": "Standing and chewing the cud", "de": "Stehend beim Wiederkäuen"}, "description": {"en": "Standing square with the head carried below the withers, the near hind leg under the hip, the far hind leg forward and the far fore leg slightly behind; the jaw is half open in the rhythm of rumination and the ears rest sideways.", "de": "Ruhiges Stehen mit unter dem Widerrist getragenem Kopf, nahem Hinterbein unter der Hüfte, fernem Hinterbein vorn und fernem Vorderbein leicht zurück; der Kiefer ist im Rhythmus des Wiederkäuens halb geöffnet, die Ohren stehen seitlich."}, "bones": {"jaw": {"angleDeg": -4}, "head": {"angleDeg": 2}, "tail-2": {"angleDeg": 4}, "tail-3": {"angleDeg": 3}, "ear-n": {"angleDeg": 6}, "ear-f": {"angleDeg": 4}, "thigh-hn": {"angleDeg": 2.8}, "shank-hn": {"angleDeg": -4.9}, "metatarsus-hn": {"angleDeg": 2.1}, "humerus-fn": {"angleDeg": -0.2}, "forearm-fn": {"angleDeg": 0.5}, "cannon-fn": {"angleDeg": -0.3}, "thigh-hf": {"angleDeg": 13.6}, "shank-hf": {"angleDeg": -3.4}, "metatarsus-hf": {"angleDeg": -10.3}, "humerus-ff": {"angleDeg": -0.2}, "forearm-ff": {"angleDeg": -8.3}, "cannon-ff": {"angleDeg": 8.5}}, "ground": "auto", "contacts": ["contact-hn", "contact-hf", "contact-fn", "contact-ff"], "thermal": {"activityMet": 2.95, "emitters": {"breath-nose": 0.5}}, "loads": []},
