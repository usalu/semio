{"id":"storm","title":{"en":"Gale","de":"Sturm"},"description":{"en":"Beaufort 9, 22 m/s at 10 m. Drag with cd 0.22 (strong reconfiguration of leaves and twigs, Vogel 1989): about 8.8 kN on the crown and a base moment of about 100 kN m. All joints approach their limits, foliage masses sweep 10 degrees downwind, transpiration is damped.","de":"Beaufort 9, 22 m/s in 10 m Höhe. Widerstand mit cd 0,22 (starke Umformung von Blättern und Zweigen, Vogel 1989): etwa 8,8 kN auf die Krone und ein Fußmoment von rund 100 kNm. Alle Gelenke nähern sich ihren Grenzen, die Laubmassen schwenken 10 Grad in Windrichtung, die Transpiration ist gedämpft."},"bones":{"trunk":{"angleDeg":-1.9},"trunk-upper":{"angleDeg":-2.3},"leader":{"angleDeg":-3},"leader-top":{"angleDeg":-4.5},"limb-w-low":{"angleDeg":-4},"limb-e-low":{"angleDeg":-4},"limb-w-mid":{"angleDeg":-4},"limb-e-mid":{"angleDeg":-4},"br-w-low":{"angleDeg":-6},"br-e-low":{"angleDeg":-6},"br-w-mid":{"angleDeg":-6},"br-e-mid":{"angleDeg":-6},"br-leader-w":{"angleDeg":-6},"br-leader-e":{"angleDeg":-6},"br-low-w-up":{"angleDeg":-5.5},"br-low-e-up":{"angleDeg":-5.5},"fol-w-low":{"angleDeg":-10},"fol-e-low":{"angleDeg":-10},"fol-w-mid":{"angleDeg":-10},"fol-e-mid":{"angleDeg":-10},"fol-leader-w":{"angleDeg":-10},"fol-leader-e":{"angleDeg":-10},"fol-top":{"angleDeg":-10},"fol-core":{"angleDeg":-10}},"ground":"authored","contacts":[],"thermal":{"operating":{},"emitters":{"transpiration-top":0.5,"transpiration-w":0.5,"transpiration-e":0.5}},"loads":[
