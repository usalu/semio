        {"id": "take-off", "title": {"en": "Take-off into flight", "de": "Abflug in den Flug"}, "description": {"en": "From the crouch the wings rise and beat down while the legs extend and push; the feet leave the ground at 0.36 s and three wing positions follow in climbing flight (about 0.36 s without ground contact). Wing beats are slowed to about 4 Hz for legibility; real take-off beats are faster.", "de": "Aus dem Ducken heben sich die Flügel und schlagen nach unten, während die Beine strecken und abstoßen; die Füße verlassen den Boden bei 0,36 s, danach folgen drei Flügelstellungen im Steigflug (etwa 0,36 s ohne Bodenkontakt). Die Flügelschläge sind zur besseren Lesbarkeit auf etwa 4 Hz verlangsamt; echte Abflugschläge sind schneller."}, "durationS": 0.72, "fps": 30, "loop": false, "rootMotion": "none", "keys": [{"t": 0, "pose": "takeoff-crouch", "ease": "smooth"}, {"t": 0.22, "pose": "takeoff-wings-up", "ease": "smooth"}, {"t": 0.3, "pose": "takeoff-push", "ease": "smooth"}, {"t": 0.36, "pose": "takeoff-liftoff", "ease": "smooth"}, {"t": 0.48, "pose": "airborne-wings-up", "ease": "smooth"}, {"t": 0.6, "pose": "airborne-wings-down", "ease": "smooth"}, {"t": 0.72, "pose": "airborne-climb", "ease": "smooth"}], "contacts": [{"anchor": "contact-n", "fromS": 0, "toS": 0.36}, {"anchor": "contact-f", "fromS": 0, "toS": 0.36}], "phases": [{"id": "crouch", "fromS": 0, "toS": 0.22, "title": {"en": "Crouch and wings up", "de": "Ducken und Flügel heben"}}, {"id": "push-off", "fromS": 0.22, "toS": 0.36, "title": {"en": "Downstroke and push-off", "de": "Abschlag und Abstoßen"}}, {"id": "flight", "fromS": 0.36, "toS": 0.72, "ballistic": true, "title": {"en": "Climbing flight", "de": "Steigflug"}}], "events": [{"t": 0, "kind": "contact-on", "title": {"en": "Near foot on the ground", "de": "Naher Fuß am Boden"}, "target": "contact-n"}, {"t": 0, "kind": "contact-on", "title": {"en": "Far foot on the ground", "de": "Ferner Fuß am Boden"}, "target": "contact-f"}, {"t": 0.36, "kind": "contact-off", "title": {"en": "Near foot leaves the ground", "de": "Naher Fuß verlässt den Boden"}, "target": "contact-n"}, {"t": 0.36, "kind": "contact-off", "title": {"en": "Far foot leaves the ground", "de": "Ferner Fuß verlässt den Boden"}, "target": "contact-f"}, {"t": 0.22, "kind": "motion", "title": {"en": "Downstroke begins", "de": "Abschlag beginnt"}}, {"t": 0.3, "kind": "thermal", "title": {"en": "Flight metabolism starts", "de": "Flugstoffwechsel beginnt"}}], "tracks": [{"target": "activityMet", "ease": "smooth", "keys": [{"t": 0, "v": 2.5}, {"t": 0.22, "v": 4}, {"t": 0.3, "v": 12}, {"t": 0.72, "v": 12}]}, {"target": "emitter:breath-exertion", "ease": "smooth", "keys": [{"t": 0, "v": 0.5}, {"t": 0.22, "v": 0.8}, {"t": 0.3, "v": 1}, {"t": 0.72, "v": 1}]}, {"target": "emitter:breath-nostril", "ease": "smooth", "keys": [{"t": 0, "v": 0.3}, {"t": 0.3, "v": 0.1}, {"t": 0.72, "v": 0.1}]}, {"target": "region:plumage-wings:exposedFraction", "ease": "smooth", "keys": [{"t": 0, "v": 0.7}, {"t": 0.22, "v": 1}, {"t": 0.72, "v": 1}]}]}
