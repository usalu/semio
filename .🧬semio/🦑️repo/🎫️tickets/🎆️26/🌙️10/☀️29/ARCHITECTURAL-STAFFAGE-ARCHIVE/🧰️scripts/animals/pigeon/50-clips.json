      "clips": [
        {"id": "walk-cycle", "title": {"en": "Walking with head-bob", "de": "Gehen mit Kopfnicken"}, "description": {"en": "Two-beat walk with alternating feet: each foot is on the ground 62 % of the stride so both feet share the load briefly twice per stride. The head is held still in space while the body passes under it and then thrust forward during each step (hold and thrust, Frost 1978).", "de": "Zweitakt-Gang mit wechselnden Füßen: jeder Fuß steht 62 % des Doppelschritts am Boden, sodass beide Füße pro Doppelschritt zweimal kurz gemeinsam tragen. Der Kopf bleibt im Raum ruhig, während der Körper darunter vorbeizieht, und wird dann bei jedem Schritt nach vorn gestoßen (Halten und Stoßen, Frost 1978)."}, "durationS": 0.5, "fps": 30, "loop": true, "rootMotion": "plant", "advanceM": 0.1452, "keys": [{"t": 0.0, "pose": "walk-phase-0", "ease": "smooth"}, {"t": 0.04167, "pose": "walk-phase-1", "ease": "smooth"}, {"t": 0.08333, "pose": "walk-phase-2", "ease": "smooth"}, {"t": 0.125, "pose": "walk-phase-3", "ease": "smooth"}, {"t": 0.16667, "pose": "walk-phase-4", "ease": "smooth"}, {"t": 0.20833, "pose": "walk-phase-5", "ease": "smooth"}, {"t": 0.25, "pose": "walk-phase-6", "ease": "smooth"}, {"t": 0.29167, "pose": "walk-phase-7", "ease": "smooth"}, {"t": 0.33333, "pose": "walk-phase-8", "ease": "smooth"}, {"t": 0.375, "pose": "walk-phase-9", "ease": "smooth"}, {"t": 0.41667, "pose": "walk-phase-10", "ease": "smooth"}, {"t": 0.45833, "pose": "walk-phase-11", "ease": "smooth"}], "contacts": [{"anchor": "contact-n", "fromS": 0, "toS": 0.31}, {"anchor": "contact-f", "fromS": 0.25, "toS": 0.5}, {"anchor": "contact-f", "fromS": 0, "toS": 0.06}], "phases": [{"id": "double-support-a", "fromS": 0, "toS": 0.06, "title": {"en": "Both feet on the ground", "de": "Beide Füße am Boden"}}, {"id": "near-stance", "fromS": 0.06, "toS": 0.25, "title": {"en": "Near foot carries, far foot swings", "de": "Naher Fuß trägt, ferner Fuß schwingt"}}, {"id": "double-support-b", "fromS": 0.25, "toS": 0.31, "title": {"en": "Both feet on the ground", "de": "Beide Füße am Boden"}}, {"id": "far-stance", "fromS": 0.31, "toS": 0.5, "title": {"en": "Far foot carries, near foot swings", "de": "Ferner Fuß trägt, naher Fuß schwingt"}}], "events": [{"t": 0, "kind": "contact-on", "title": {"en": "Near foot touches down", "de": "Naher Fuß setzt auf"}, "target": "contact-n"}, {"t": 0.31, "kind": "contact-off", "title": {"en": "Near foot lifts", "de": "Naher Fuß hebt ab"}, "target": "contact-n"}, {"t": 0.25, "kind": "contact-on", "title": {"en": "Far foot touches down", "de": "Ferner Fuß setzt auf"}, "target": "contact-f"}, {"t": 0.06, "kind": "contact-off", "title": {"en": "Far foot lifts", "de": "Ferner Fuß hebt ab"}, "target": "contact-f"}, {"t": 0.1667, "kind": "motion", "title": {"en": "Head thrust forward", "de": "Kopf wird nach vorn gestoßen"}}, {"t": 0.4167, "kind": "motion", "title": {"en": "Head thrust forward", "de": "Kopf wird nach vorn gestoßen"}}], "tracks": [{"target": "emitter:breath-nostril", "ease": "smooth", "keys": [{"t": 0, "v": 0.8}, {"t": 0.25, "v": 0.9}, {"t": 0.5, "v": 0.8}]}]},
        {"id": "peck-cycle", "title": {"en": "Pecking food", "de": "Futter picken"}, "description": {"en": "Standing on both feet the pigeon lowers the body and stretches the neck down twice, strikes the ground with the beak and straightens up again; the feet do not move.", "de": "Auf beiden Füßen stehend senkt die Taube den Körper und streckt den Hals zweimal nach unten, stößt mit dem Schnabel auf den Boden und richtet sich wieder auf; die Füße bewegen sich nicht."}, "durationS": 2.0, "fps": 30, "loop": true, "rootMotion": "none", "keys": [{"t": 0, "pose": "standing-alert", "ease": "smooth"}, {"t": 0.4, "pose": "pecking-reach", "ease": "smooth"}, {"t": 0.5, "pose": "pecking-strike", "ease": "smooth"}, {"t": 0.62, "pose": "pecking-reach", "ease": "smooth"}, {"t": 0.72, "pose": "pecking-strike", "ease": "smooth"}, {"t": 0.84, "pose": "pecking-reach", "ease": "smooth"}, {"t": 1.3, "pose": "standing-alert", "ease": "smooth"}], "contacts": [{"anchor": "contact-n", "fromS": 0, "toS": 2.0}, {"anchor": "contact-f", "fromS": 0, "toS": 2.0}], "phases": [{"id": "look", "fromS": 0, "toS": 0.4, "title": {"en": "Lowering the head", "de": "Kopf senken"}}, {"id": "pecks", "fromS": 0.4, "toS": 0.84, "title": {"en": "Two pecks", "de": "Zwei Picks"}}, {"id": "rise", "fromS": 0.84, "toS": 2.0, "title": {"en": "Straightening up and scanning", "de": "Aufrichten und Umschauen"}}], "events": [{"t": 0, "kind": "contact-on", "title": {"en": "Near foot on the ground", "de": "Naher Fuß am Boden"}, "target": "contact-n"}, {"t": 0, "kind": "contact-on", "title": {"en": "Far foot on the ground", "de": "Ferner Fuß am Boden"}, "target": "contact-f"}, {"t": 0.5, "kind": "motion", "title": {"en": "Beak strikes the ground", "de": "Schnabel trifft den Boden"}}, {"t": 0.72, "kind": "motion", "title": {"en": "Beak strikes the ground", "de": "Schnabel trifft den Boden"}}, {"t": 0, "kind": "inhale", "title": {"en": "Inhalation", "de": "Einatmen"}}, {"t": 1.1, "kind": "exhale", "title": {"en": "Exhalation"