        {"id": "alarm-freeze", "title": {"en": "Alarm freeze", "de": "Schreckstarre"}, "description": {"en": "The roe grazes, then the head snaps up, the ears flick forward and back, the animal freezes and finally lifts the near foreleg and holds it motionless. The three other hooves stay planted throughout.", "de": "Das Reh äst, dann ruckt der Kopf hoch, die Lauscher schnellen nach vorn und zurück, das Tier erstarrt und hebt schließlich den nahen Vorderlauf an und hält ihn reglos. Die anderen drei Hufe bleiben die ganze Zeit am Boden."}, "durationS": 7, "fps": 30, "loop": false, "rootMotion": "none", "keys": [{"t": 0, "pose": "grazing", "ease": "smooth"}, {"t": 1.5, "pose": "grazing", "ease": "smooth", "bones": {"jaw": {"angleDeg": -12}}}, {"t": 1.9, "pose": "grazing", "ease": "smooth"}, {"t": 2.25, "pose": "alert", "ease": "smooth", "bones": {"ear-n": {"angleDeg": -42}, "ear-f": {"angleDeg": -46}}}, {"t": 2.7, "pose": "alert", "ease": "smooth"}, {"t": 3.1, "pose": "alert", "ease": "smooth", "bones": {"ear-n": {"angleDeg": -4}, "ear-f": {"angleDeg": -30}}}, {"t": 3.5, "pose": "alert", "ease": "smooth"}, {"t": 3.6, "pose": "alert", "ease": "smooth"}, {"t": 4.4, "pose": "alert-foreleg-raised", "ease": "smooth"}, {"t": 7, "pose": "alert-foreleg-raised", "ease": "smooth"}], "contacts": [{"anchor": "contact-hn", "fromS": 0, "toS": 7}, {"anchor": "contact-hf", "fromS": 0, "toS": 7}, {"anchor": "contact-ff", "fromS": 0, "toS": 7}, {"anchor": "contact-fn", "fromS": 0, "toS": 3.7}], "phases": [{"id": "graze", "fromS": 0, "toS": 1.9, "title": {"en": "Grazing", "de": "Äsen"}}, {"id": "head-snap", "fromS": 1.9, "toS": 2.7, "title": {"en": "Head snaps up, ears forward", "de": "Kopf ruckt hoch, Lauscher nach vorn"}}, {"id": "freeze", "fromS": 2.7, "toS": 3.6, "title": {"en": "Freezing, ear flick", "de": "Erstarren, Lauscherzucken"}}, {"id": "raise", "fromS": 3.6, "toS": 4.4, "title": {"en": "Near foreleg lifts", "de": "Naher Vorderlauf hebt an"}}, {"id": "hold", "fromS": 4.4, "t