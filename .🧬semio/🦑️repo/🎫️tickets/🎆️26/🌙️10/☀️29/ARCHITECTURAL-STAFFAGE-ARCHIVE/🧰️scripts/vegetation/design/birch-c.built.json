{"id":"wind-stem-c-1","kind":"wind","title":{"en":"Wind drag on centre stem, lower","de":"Winddruck auf Mittlerer Stamm, unten"},"fxN":0,"fyN":0,"distributed":{"bone":"stem-c-1","fromM":0.0,"toM":5.5,"wxNPerM":59.6,"wyNPerM":0},"source":"literature","reference":"mayhead-1973"}]},{"id":"ice","title":{"en":"Ice-laden, bent outwards","de":"Eisbeladen, nach außen gebogen"},"description":{"en":"Wet snow or glaze ice of 10 kg/m2 on the plan area 0.9 pi a^2 of each foliage cloud (0.64 to 0.92 kN each) bows the outer stems apart and drags branches and foliage down: birches are known to bend to the ground under such loads. Order of magnitude after EN 1991-1-3; wind is calm.","de":"Nassschnee oder Eisregen von 10 kg/m2 auf die Grundrissfläche 0,9 pi a^2 jeder Laubwolke (je 0,64 bis 0,92 kN) biegt die äußeren Stämme auseinander und zieht Äste und Laub herab: Birken sind dafür bekannt, sich unter solchen Lasten bis zum Boden zu neigen. Größenordnung nach EN 1991-1-3; Windstille."},"bones":{"stem-l-1":{"angleDeg":2.4},"stem-l-2":{"angleDeg":3.4},"stem-c-1":{"angleDeg":0.8},"stem-c-2":{"angleDeg":1.5},"stem-r-1":{"angleDeg":-2.4},"stem-r-2":{"angleDeg":-3.4},"br-l-a":{"angleDeg":7},"br-l-b":{"angleDeg":7},"br-c-a":{"angleDeg":7},"br-c-b":{"angleDeg":-7},"br-r-a":{"angleDeg":-7},"br-r-b":{"angleDeg":-7},"fol-l-a":{"angleDeg":10},"fol-l-b":{"angleDeg":10},"fol-c-a":{"angleDeg":10},"fol-c-b":{"angleDeg":-10},"fol-r-a":{"angleDeg":-10},"fol-r-b":{"angleDeg":-10},"fol-l-top":{"angleDeg":6},"fol-r-top":{"angleDeg":-6}},"ground":"authored","contacts":[],"thermal":{"operating":{},"emitters":{"transpiration-top":0,"transpiration-l":0}},"loads":[{"id":"snow-fol-l-a","kind":"snow","title":{"en":"Snow on foliage, left upper","de":"Schnee auf Laub links oben"},"bone":"fol-l-a","x":1.5,"y":0,"fxN":0,"fyN":-817.0,"source":"authored-estimate","reference":"en-1991-1-3"},
