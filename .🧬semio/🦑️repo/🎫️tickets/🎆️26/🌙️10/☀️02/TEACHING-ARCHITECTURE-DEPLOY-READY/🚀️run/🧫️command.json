{
  "version": 1,
  "stopCodes": {
    "SIGINT": 130,
    "SIGTERM": 143,
    "deadline": 124
  },
  "timeoutMs": 7200000,
  "cases": [
    {
      "name": "interrupt-zero-transport",
      "events": [
        "SIGINT"
      ],
      "rawStatus": 0,
      "cleanupStatus": 0,
      "status": 130
    },
    {
      "name": "normal-success",
      "events": [],
      "rawStatus": 0,
      "cleanupStatus": 0,
      "status": 0
    },
    {
      "name": "normal-failure",
      "events": [],
      "rawStatus": 7,
      "cleanupStatus": 0,
      "status": 7
    },
    {
      "name": "terminate-zero-transport",
      "events": [
        "SIGTERM"
      ],
      "rawStatus": 0,
      "cleanupStatus": 0,
      "status": 143
    },
    {
      "name": "deadline-zero-transport",
      "events": [
        "deadline"
      ],
      "rawStatus": 0,
      "cleanupStatus": 0,
      "status": 124
    },
    {
      "name": "interrupt-one-shot",
      "events": [
        "SIGINT",
        "SIGTERM",
