      "cleanupStatus": 0,
      "status": 124
    },
    {
      "name": "interrupt-cleanup-failure",
      "events": [
        "SIGINT"
      ],
      "rawStatus": 0,
      "cleanupStatus": 9,
      "status": 130
    },
    {
      "name": "deadline-cleanup-failure",
      "events": [
        "deadline"
      ],
      "rawStatus": 0,
      "cleanupStatus": 9,
      "status": 124
    },
    {
      "name": "interrupt-waits-child-after-cleanup",
      "events": [
        "SIGINT"
      ],
      "rawStatus": 0,
      "cleanupStatus": 0,
      "status": 130,
