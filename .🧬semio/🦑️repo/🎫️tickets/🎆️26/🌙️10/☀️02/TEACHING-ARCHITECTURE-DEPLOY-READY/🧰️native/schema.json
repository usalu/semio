{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bounded Retained Builder Native Frontend Provisioning",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "identitySha256",
    "containerId",
    "sourceManifestSha256",
    "artifact",
    "guestPath",
    "inputs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "native-linux-frontend-pin"
    },
    "identitySha256": {
      "const": "90e45f2eba59e4986cc1099310a66f175d3b54ca3d74a24f4a6bfe584f084a60"
    },
    "containerId": {
      "const": "b28d90788b3e7e94c98667ea3500a976657dad3cd9e33b20365924becadb4cd6"
    },
    "sourceManifestSha256": {
      "const": "8579fa82486d7a67d41046c62d04167914d25b4ff3747d6514f2c0c44a836c36"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "sha256",
        "bytes",
        "elf"
      ],
      "properties": {
        "relativePath": {
          "enum": [
            "🗑️generated/n/repo",
            "🗑️generated/n2/repo",
            "🗑️generated/n3/repo"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 64,
          "maximum": 67108864
        },
        "elf": {
          "$ref": "#/definitions/elf"
        }
      }
    },
    "guestPath": {
      "type": "string",
      "pattern": "^/tmp/semio-course-native-[a-f0-9]{32}/repo$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scriptSha256",
        "schemaSha256"
      ],
      "properties": {
        "scriptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schemaSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "definitions": {
    "elf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "endianness",
        "machine",
        "type",
        "interpreter"
      ],
      "properties": {
        "class": {
          "const": 64
        },
        "endianness": {
          "const": "little"
        },
        "machine": {
          "const": 62
        },
        "type": {
          "enum": [
            2,
            3
          ]
        },
        "interpreter": {
          "type": "null"
        }
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "pinCases",
        "elfCases",
        "identityCases",
        "transportCases",
        "fileCases",
        "guestCases",
        "platformCases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "pinCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              }
            }
          }
        },
        "elfCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              }
            }
          }
        },
        "identityCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              }
            }
          }
        },
        "transportCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              }
            }
          }
        },
        "fileCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              }
            }
          }
        },
        "guestCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "boolean"
              },
              "kind": {
                "enum": [
                  "receive",
                  "probe"
                ]
              }
            }
          }
        },
        "platformCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "platform",
              "mode",
              "executable",
              "changed",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "platform": {
                "enum": [
                  "win32",
                  "linux",
                  "darwin"
                ]
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              },
              "executable": {
                "type": "boolean"
              },
              "changed": {
                "type": "boolean"
              },
              "accepted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "x-policy": {
    "maximumBinaryBytes": 67108864,
    "maximumTransportBytes": 131072,
    "maximumStderrBytes": 4096,
    "totalMilliseconds": 120000,
    "receiveMilliseconds": 45000,
    "helpMilliseconds": 20000,
    "maximumIdentityBytes": 4096,
    "maximumPlanBytes": 65536,
    "maximumReceiptBytes": 8192,
    "postAuthenticationMilliseconds": 10000
  }
}
