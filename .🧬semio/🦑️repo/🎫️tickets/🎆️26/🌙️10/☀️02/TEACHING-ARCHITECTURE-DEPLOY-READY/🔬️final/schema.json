{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "cohort",
    "tag",
    "artifactRoot",
    "expected",
    "refs",
    "authored",
    "milliseconds",
    "boundaryEvidence"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "fresh-final-verification"
    },
    "cohort": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^(?!latest$)[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
    },
    "artifactRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "caddy",
        "version",
        "revision",
        "created"
      ],
      "properties": {
        "repository": {
          "const": "ghcr.io/usalu/architecture-course-proctor"
        },
        "caddy": {
          "const": "caddy:2.11.4@sha256:0c994536bddb66445885237f1a5dcc1916bccea922661c76b4e9fc24061f9b52"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}(-dirty)?$"
        },
        "created": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohortPlan",
        "terminal",
        "sourceReceipt",
        "sourceManifest",
        "gitPlan",
        "gitTerminal",
        "provision",
        "afterLock",
        "afterSync",
        "afterGates",
        "cargoReceipt",
        "proctorReceipt",
        "imageInspect",
        "caddyInspect",
        "exportReceipt",
        "beforeLock",
        "imageBuildLog"
      ],
      "properties": {
        "cohortPlan": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "terminal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "sourceReceipt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "sourceManifest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "gitPlan": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "gitTerminal": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "provision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "afterLock": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "afterSync": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "afterGates": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "cargoReceipt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "proctorReceipt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "imageInspect": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "caddyInspect": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "exportReceipt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "beforeLock": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        },
        "imageBuildLog": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/fileReference"
            }
          ]
        }
      }
    },
    "authored": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compose",
        "caddyfile",
        "bundleProducer",
        "dockerfile",
        "productSchema",
        "deployment"
      ],
      "properties": {
        "compose": {
          "$ref": "#/definitions/fileReference"
        },
        "caddyfile": {
          "$ref": "#/definitions/fileReference"
        },
        "bundleProducer": {
          "$ref": "#/definitions/fileReference"
        },
        "dockerfile": {
          "$ref": "#/definitions/fileReference"
        },
        "productSchema": {
          "$ref": "#/definitions/fileReference"
        },
        "deployment": {
          "$ref": "#/definitions/fileReference"
        }
      }
    },
    "milliseconds": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 600000
    },
    "boundaryEvidence": {
      "enum": [
        "required",
        "record-unavailable"
      ]
    }
  },
  "definitions": {
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "cohort",
        "boundary",
        "initialManifestSha256",
        "observedAt",
        "observedBeforeNextNative",
        "atomicSnapshot",
        "completeSourceRoster",
        "rows",
        "ownerEvidence",
        "planSha256",
        "workload",
        "limits",
        "controlBefore",
        "controlAfter"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "fresh-source-boundary-observation"
        },
        "cohort": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "boundary": {
          "enum": [
            "before-lock",
            "after-lock",
            "after-sync",
            "after-gates"
          ]
        },
        "initialManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedBeforeNextNative": {
          "const": true
        },
        "atomicSnapshot": {
          "const": false
        },
        "completeSourceRoster": {
          "const": true
        },
        "rows": {
          "type": "array",
          "maxItems": 262144,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "ownerEvidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/fileReference"
          }
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workload": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "bytes",
            "fileBytes",
            "milliseconds"
          ],
          "properties": {
            "files": {
              "const": 262144
            },
            "bytes": {
              "const": 4294967296
            },
            "fileBytes": {
              "const": 268435456
            },
            "milliseconds": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 600000
            }
          }
        },
        "controlBefore": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tracked",
            "untracked",
            "providers",
            "membership",
            "registry"
          ],
          "properties": {
            "tracked": {
              "type": "string"
            },
            "untracked": {
              "type": "string"
            },
            "providers": {
              "type": "string"
            },
            "membership": {
              "type": "string"
            },
            "registry": {
              "type": "string"
            }
          }
        },
        "controlAfter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tracked",
            "untracked",
            "providers",
            "membership",
            "registry"
          ],
          "properties": {
            "tracked": {
              "type": "string"
            },
            "untracked": {
              "type": "string"
            },
            "providers": {
              "type": "string"
            },
            "membership": {
              "type": "string"
            },
            "registry": {
              "type": "string"
            }
          }
        }
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "cases",
        "fixtures"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "group",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "group": {
                "enum": [
                  "plan",
                  "terminal",
                  "delta",
                  "archive",
                  "export",
                  "receipt",
                  "integration"
                ]
              },
              "accepted": {
                "type": "boolean"
              }
            }
          }
        },
        "fixtures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delta"
          ],
          "properties": {
            "delta": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "before",
                "after",
                "expected"
              ],
              "properties": {
                "before": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "bytes",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "bytes",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                },
                "expected": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "kind"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "kind": {
                        "enum": [
                          "added",
                          "deleted",
                          "changed"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        }
      }
    },
    "hostModes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "platform",
        "physicalModeSemantics",
        "logicalModesPreserved"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "platform": {
          "enum": [
            "win32",
            "darwin",
            "linux"
          ]
        },
        "physicalModeSemantics": {
          "enum": [
            "windows-readonly",
            "posix"
          ]
        },
        "logicalModesPreserved": {
          "const": true
        }
      }
    }
  }
}
