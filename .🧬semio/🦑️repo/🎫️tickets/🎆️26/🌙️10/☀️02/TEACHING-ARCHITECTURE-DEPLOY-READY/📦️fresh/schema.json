{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fresh Source Capture Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "captureId",
    "workspaceRoot",
    "critical",
    "inputs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "fresh-source-capture-plan"
    },
    "captureId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "critical": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "host",
        "entry",
        "schema",
        "contract"
      ],
      "properties": {
        "core": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entry": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "definitions": {
    "limits": {
      "const": {
        "maximumFiles": 262144,
        "maximumSourceBytes": 4294967296,
        "maximumFileBytes": 268435456,
        "maximumManifestBytes": 134217728,
        "maximumPathCharacters": 256,
        "maximumPathUtf8Bytes": 1024,
        "maximumDepth": 64,
        "chunkFiles": 128,
        "chunkBytes": 33554432,
        "streamChunkBytes": 65536,
        "maximumMilliseconds": 900000
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked",
        "untracked",
        "providers",
        "membership",
        "registry"
      ],
      "properties": {
        "tracked": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "untracked": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providers": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "membership": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerId",
        "image",
        "volumeName",
        "runToken",
        "planSha256",
        "manifestSha256",
        "name",
        "created",
        "user",
        "identityReceiptSha256",
        "sourceDestination"
      ],
      "properties": {
        "containerId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "not": {
            "const": "b28d90788b3e7e94c98667ea3500a976657dad3cd9e33b20365924becadb4cd6"
          }
        },
        "image": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "volumeName": {
          "type": "string",
          "pattern": "^semio-course-source-[a-f0-9]{12}-[a-f0-9]{8}$"
        },
        "runToken": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "not": {
            "const": "8579fa82486d7a67d41046c62d04167914d25b4ff3747d6514f2c0c44a836c36"
          }
        },
        "name": {
          "type": "string",
          "pattern": "^semio-course-native-[a-f0-9]{32}$"
        },
        "created": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identityReceiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceDestination": {
          "const": "/repo"
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "criticalPaths",
        "absent",
        "control",
        "observedAt"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "maxItems": 262144,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "owner"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              }
            }
          }
        },
        "criticalPaths": {
          "type": "array",
          "maxItems": 262144,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "absent": {
          "type": "array",
          "maxItems": 262144,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "control": {
          "$ref": "#/definitions/control"
        },
        "observedAt": {
          "type": "string"
        }
      }
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "owner",
        "bytes",
        "sha256",
        "identity",
        "executable",
        "epoch"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "executable": {
          "type": "boolean"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "captureId",
        "planSha256",
        "atomicHostSnapshot",
        "model",
        "controlBefore",
        "controlAfter",
        "criticalPaths",
        "rows",
        "absent",
        "epochs",
        "divergence",
        "bytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "fresh-source-manifest"
        },
        "captureId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "atomicHostSnapshot": {
          "const": false
        },
        "model": {
          "const": "stable-file-critical-control-and-owner-epochs"
        },
        "controlBefore": {
          "$ref": "#/definitions/control"
        },
        "controlAfter": {
          "$ref": "#/definitions/control"
        },
        "criticalPaths": {
          "type": "array",
          "maxItems": 262144,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 262144,
          "items": {
            "$ref": "#/definitions/sourceRow"
          }
        },
        "absent": {
          "type": "array",
          "maxItems": 262144,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "epoch",
              "observedAt"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "epoch": {
                "type": "integer",
                "minimum": 0
              },
              "observedAt": {
                "type": "string"
              }
            }
          }
        },
        "epochs": {
          "type": "array",
          "maxItems": 262145,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "epoch",
              "owner",
              "openedAt",
              "sealedAt",
              "rowsSha256",
              "files",
              "bytes"
            ],
            "properties": {
              "epoch": {
                "type": "integer",
                "minimum": 0
              },
              "owner": {
                "type": "string"
              },
              "openedAt": {
                "type": "string"
              },
              "sealedAt": {
                "type": "string"
              },
              "rowsSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "files": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "divergence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "added",
            "missing",
            "changedIdentity",
            "controlChanged"
          ],
          "properties": {
            "added": {
              "type": "array",
              "maxItems": 262144,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "missing": {
              "type": "array",
              "maxItems": 262144,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "changedIdentity": {
              "type": "array",
              "maxItems": 262144,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "controlChanged": {
              "type": "boolean"
            }
          }
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967296
        }
      }
    },
    "payload": {
      "const": {
        "excludedSegments": [
          ".git",
          ".cache",
          ".🧬semio",
          ".semio-private",
          "node_modules",
          ".venv",
          "target",
          "dist",
          "📤️dist",
          "🗑️generated",
          "🤖️generated",
          "coverage",
          "storybook-static",
          "__pycache__"
        ]
      }
    }
  }
}
