{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "baseBounds",
    "layerOrder",
    "cases",
    "refusals"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "baseBounds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/vec"
      }
    },
    "layerOrder": {
      "const": "inner-to-outer"
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layers",
          "repeatedSource",
          "expectedBounds",
          "expectedVolume"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "layers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/layer"
            }
          },
          "repeatedSource": {
            "type": "boolean"
          },
          "expectedBounds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/vec"
            }
          },
          "expectedVolume": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layers",
          "damage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "layers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/layer"
            }
          },
          "damage": {
            "enum": [
              null,
              "cycle",
              "two-dimensional-operator"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "vec": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "originRotation",
        "target",
        "axes",
        "scale",
        "secondary"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/vec"
        },
        "originRotation": {
          "type": "number"
        },
        "target": {
          "$ref": "#/$defs/vec"
        },
        "axes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/vec"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "scale": {
          "type": [
            "number",
            "null"
          ]
        },
        "secondary": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
