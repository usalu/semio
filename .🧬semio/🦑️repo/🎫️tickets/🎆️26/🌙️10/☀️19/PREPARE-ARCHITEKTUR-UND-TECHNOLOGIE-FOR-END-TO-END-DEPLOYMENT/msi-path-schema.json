{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "directories", "directory", "file"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "directories": { "type": "array", "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } } },
          "directory": { "type": "string" },
          "file": { "type": "string" },
          "expected": { "type": "string" },
          "error": { "const": true }
        },
        "oneOf": [{ "required": ["expected"] }, { "required": ["error"] }]
      }
    }
  }
}
