      "id",
      "target",
      "expected",
      "missing"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "target": {
        "type": "object",
        "required": [
          "execution"
        ],
        "properties": {
          "execution": {
            "type": "object"
          },
          "configurations": {
            "type": "object",
            "additionalProperties": {
