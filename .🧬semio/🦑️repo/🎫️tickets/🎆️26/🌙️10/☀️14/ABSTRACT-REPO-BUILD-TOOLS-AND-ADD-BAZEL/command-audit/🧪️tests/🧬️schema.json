              "required": [
                "execution"
              ],
              "properties": {
                "execution": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "expected": {
        "type": "array",
        "items": {
          "type": "object",
