            "argv",
            "cwd"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "missing": {
