[
  {
    "id": "authored",
    "target": {
      "execution": {
        "kind": "command",
        "command": "node \"two words\" value"
      }
    },
    "expected": [
      {
        "argv": [
          "node",
          "two words",
          "value"
        ],
        "cwd": "/workspace"
      }
    ],
    "missing": []
  },
  {
    "id": "authored-list",
    "target": {
      "execution": {
        "kind": "command",
        "commands": [
          "node one",
          {
            "command": "node two",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "expected": [
      {
        "argv": [
          "node",
          "one"
        ],
        "cwd": "/workspace"
      },
      {
        "argv": [
          "node",
          "two"
        ],
        "cwd": "/workspace"
      }
    ],
    "missing": []
  },
  {
