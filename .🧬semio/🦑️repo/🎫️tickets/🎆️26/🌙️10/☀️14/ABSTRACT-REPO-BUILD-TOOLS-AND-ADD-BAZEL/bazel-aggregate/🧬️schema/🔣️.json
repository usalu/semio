{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode"
  ],
  "properties": {
    "mode": {
      "enum": [
        "--prepare",
        "--execute",
        "--receive-proof",
        "--source-pair-model"
      ]
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "owner": "repository:build",
        "maximumElapsedMilliseconds": 0
      }
    },
    "Selection": {
      "const": [
        "run",
        "workspace:test-build-tool-bazel"
      ]
    },
    "Dispatcher": {
      "const": [
        "test",
        "bazel"
      ]
    },
    "Phases": {
      "const": [
        "cache",
        "nested",
        "uncached",
        "birth",
        "services",
        "refusals",
        "cancellation",
        "configuration",
        "offline"
      ]
    },
    "Forbidden": {
      "const": [
        "SEMIO_SCRIPT_PROCESS_INVOCATION",
        "SEMIO_SCRIPT_POLICY",
        "SEMIO_SCRIPT_CAPABILITIES",
        "SEMIO_BUILD_TOOL",
        "SEMIO_BUILD_MODE",
        "SEMIO_BUILD_GRAPH_PATH",
        "SEMIO_BUILD_GRAPH_DIGEST",
        "SEMIO_BUILD_REUSE_GRAPH",
        "SEMIO_SCRIPT_MAX_ELAPSED_MS",
        "SEMIO_BUILD_INVOCATION_PID",
        "SEMIO_TASK_PROJECT",
        "SEMIO_TASK_TARGET",
        "SEMIO_BAZEL_FIXTURE_PHASE",
        "SEMIO_BAZEL_INTEGRATION"
      ]
    },
    "CapturePair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "first",
        "second",
        "diff"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "first": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "files",
            "bytes",
            "sources"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sources": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "second": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "files",
            "bytes",
            "sources"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 512
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sources": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identityChanged",
            "added",
            "removed",
            "changed"
          ],
          "properties": {
            "identityChanged": {
              "type": "boolean"
            },
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "CapturePairCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "writeFailure",
        "outcome",
        "writes"
      ],
      "properties": {
        "primary": {
          "enum": [
            "none",
            "undefined",
            "frozen"
          ]
        },
        "writeFailure": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "success",
            "primary",
            "write"
          ]
        },
        "writes": {
          "const": 1
        }
      }
    }
  }
}
