    {
      "name": "windows-exact",
      "platform": "win32",
      "generated": "C:\\repo\\ticket\\generated",
      "candidate": "C:\\repo\\ticket\\generated",
      "mounts": [
        "C:\\"
      ],
      "expected": true
    },
    {
      "name": "windows-descendant-case",
      "platform": "win32",
      "generated": "C:\\repo\\ticket\\generated",
      "candidate": "C:\\repo\\ticket\\generated",
      "mounts": [
        "c:\\REPO\\ticket\\generated\\volume"
      ],
      "expected": false
    },
    {
      "name": "unicode",
      "platform": "darwin",
      "generated": "/repo/🎫️/🗑️generated",
      "candidate": "/repo/🎫️/🗑️generated",
      "mounts": [
        "/repo/🎫️/🗑️generated/initial-authority/.cache/b/l/m"
      ],
      "expected": false
    }
  ],
  "inventoryCases": [
    {
      "name": "darwin-unicode",
      "platform": "darwin",
      "text": "/dev/disk14s1 on /repo/🎫️/🗑️generated/initial-authority/.cache/b/l/m (apfs, local, nodev)\n",
      "paths": [
        "/repo/🎫️/🗑️generated/initial-authority/.cache/b/l/m"
      ]
    },
    {
      "name": "darwin-system-and-spaces",
      "platform": "darwin",
      "text": "/dev/disk1 on / (apfs, local, read-only)\nmap auto_home on /System/Volumes/Data/home (autofs, automounted)\n/dev/disk2 on /Volumes/Fixture Mount (apfs, local)\n",
      "paths": [
        "/",
        "/System/Volumes/Data/home",
        "/Volumes/Fixture Mount"
      ]
    },
    {
      "name": "linux-bind-and-escaped-space",
      "platform": "linux",
      "text": "21 1 8:1 / / rw - ext4 /dev/sda rw\n22 21 8:1 /source /repo/generated/bind rw - ext4 /dev/sda rw\n23 21 8:2 / /media/with\\040space rw - ext4 /dev/sdb rw\n",
      "paths": [
        "/",
        "/repo/generated/bind",
        "/media/with space"
      ]
    }
  ],
