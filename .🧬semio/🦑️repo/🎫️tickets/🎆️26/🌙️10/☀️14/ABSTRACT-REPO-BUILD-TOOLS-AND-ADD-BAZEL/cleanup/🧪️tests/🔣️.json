      "mounts": [
        "/repo/ticket/generated/a"
      ],
      "expected": false
    },
    {
      "name": "equal-mount",
      "platform": "darwin",
      "generated": "/repo/ticket/generated",
      "candidate": "/repo/ticket/generated",
