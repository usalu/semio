{
  "version": 1,
  "cases": [
    {
      "name": "exact-posix",
      "platform": "linux",
      "generated": "/repo/ticket/generated",
      "candidate": "/repo/ticket/generated",
      "mounts": [
        "/",
        "/repo"
      ],
      "expected": true
    },
    {
      "name": "sibling",
      "platform": "darwin",
      "generated": "/repo/ticket/generated",
      "candidate": "/repo/ticket/generated-peer",
      "mounts": [],
      "expected": false
    },
    {
      "name": "global",
      "platform": "darwin",
      "generated": "/repo/ticket/generated",
      "candidate": "/repo/.cache",
      "mounts": [],
      "expected": false
    },
    {
