{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["phase", "path", "digest"],
  "properties": {
    "phase": {"enum": ["cache", "nested", "uncached", "birth", "services", "refusals", "cancellation", "configuration", "offline"]},
    "path": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "definitions": {"Policy": {"const": {"maximumElapsedMilliseconds": 120000, "target": "workspace:test-build-tool-bazel"}}}
}
