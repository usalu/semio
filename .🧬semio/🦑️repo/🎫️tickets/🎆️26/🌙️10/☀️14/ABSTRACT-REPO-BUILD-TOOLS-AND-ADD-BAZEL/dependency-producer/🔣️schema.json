{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.ticket/ProtectedDependencyProducerProposalV1",
  "definitions": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "selection",
        "parent",
        "artifact",
        "sourceSha256",
        "bindingsSha256",
        "producerSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "const": "produce-and-rebind-current-dependencies"
        },
        "selection": {
          "const": "all"
        },
        "parent": {
          "$ref": "https://semio.tech/framework/process/native-storage/v1#/definitions/ProtectedMaintenanceRequest"
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "https://semio.tech/framework/process/native-storage/v1#/definitions/ProtectedArtifactExpectation"
            },
            {
              "properties": {
                "action": {
                  "const": "retain-allocation-payload"
                }
              },
              "type": "object"
            }
          ]
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindingsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producerSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "Facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody",
        "row",
        "bindings",
        "owners",
        "recipe",
        "stage",
        "plannedPathUnits",
        "observedPathUnits",
        "observedCodePoints",
        "child",
        "source",
        "scopeReadiness",
        "bindingCAS",
        "stop",
        "bindingCount"
      ],
      "properties": {
        "custody": {
          "enum": [
            "actual-private",
            "copied",
            "foreign-control",
            "escaped",
            "cancelled-incoming"
          ]
        },
        "row": {
          "enum": [
            "sole-committed-whole",
            "absent",
            "drift"
          ]
        },
        "bindings": {
          "enum": [
            "qualified-current",
            "all-missing",
            "unqualified-symlink-current-intent",
            "unknown-physical-directory",
            "foreign-owner"
          ]
        },
        "owners": {
          "enum": [
            "all-current",
            "changed"
          ]
        },
        "recipe": {
          "enum": [
            "shared-canonical",
            "argv-only-override",
            "stale-reader"
          ]
        },
        "stage": {
          "enum": [
            "fresh",
            "ready-existing",
            "prefix-collision",
            "unknown-content"
          ]
        },
        "plannedPathUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedPathUnits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedCodePoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "child": {
          "enum": [
            "zero",
            "nonzero",
            "not-terminal"
          ]
        },
        "source": {
          "enum": [
            "stable",
            "changed-after-install"
          ]
        },
        "scopeReadiness": {
          "enum": [
            "all-ready",
            "one-failed"
          ]
        },
        "bindingCAS": {
          "enum": [
            "stable",
            "drift"
          ]
        },
        "stop": {
          "enum": [
            "none",
            "before-install",
            "before-bindings",
            "after-first-binding"
          ]
        },
        "bindingCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "installChildren",
        "receiptWrites",
        "bindingSwitches",
        "oldPayloadDeletes",
        "allocationRetired"
      ],
      "properties": {
        "status": {
          "enum": [
            "settled",
            "refused",
            "partial-staging",
            "partial-binding"
          ]
        },
        "installChildren": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "receiptWrites": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "bindingSwitches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "oldPayloadDeletes": {
          "const": 0
        },
        "allocationRetired": {
          "const": false
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "facts",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "facts": {
          "$ref": "#/definitions/Facts"
        },
        "expected": {
          "$ref": "#/definitions/Expected"
        }
      }
    }
  }
}
