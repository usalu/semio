{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root",
    "artifacts",
    "path",
    "digest",
    "reuse"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifacts": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reuse": {
      "const": "true"
    }
  }
}
