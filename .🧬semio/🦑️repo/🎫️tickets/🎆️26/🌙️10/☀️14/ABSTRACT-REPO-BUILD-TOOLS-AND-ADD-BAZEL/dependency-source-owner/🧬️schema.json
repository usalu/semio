{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.ticket/SharedSourceOwnerProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authority",
    "executed",
    "owners",
    "identity",
    "semantics",
    "orchestration"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "authority": {
      "const": false
    },
    "executed": {
      "const": false
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "scopes",
          "requested",
          "accepted"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "manifest",
                "packages"
              ],
              "properties": {
                "manifest": {
                  "type": "string"
                },
                "packages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "requested": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accepted": {
            "type": "boolean"
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            }
          },
          "memberships": {
            "type": "integer"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "identity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "changedScopes",
          "stable",
          "changed"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "changedScopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stable": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "semantics": {
      "$ref": "#/definitions/verdicts"
    },
    "orchestration": {
      "$ref": "#/definitions/verdicts"
    }
  },
  "definitions": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "accepted"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
