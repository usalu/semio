    "ProducerCompletionSourceEntry":{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"enum":["--producer-sync-source","--producer-sync-strict"]}}},
    "SelectedRetirementEntry": {"anyOf":[{"type":"object","additionalProperties":false,"required":["mode","census","prefix"],"properties":{"mode":{"const":"--dependency-selected-plan"},"census":{"type":"string","pattern":"^native-assets-protected-[1-9][0-9]*[.]json$","maxLength":80},"prefix":{"type":"string","pattern":"^[a-f0-9]{20}$"}}},{"type":"object","additionalProperties":false,"required":["mode","path","sha256"],"properties":{"mode":{"enum":["--dependency-observe","--dependency-retire"]},"path":{"type":"string","minLength":1,"maxLength":256},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}]},
    "SelectedRetirementSourceEntry": {"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"enum":["--dependency-retirement-source","--dependency-retirement-source-strict"]}}},
    "SelectedRetirementLaunchCase": {"type":"object","additionalProperties":false,"required":["mode","fault","accepted"],"properties":{"mode":{"enum":["plan","observe","retire"]},"fault":{"enum":["none","input","owner","busy","active","operation"]},"accepted":{"type":"boolean"}}},
    "ProducerProbeEntry": {"type": "object", "additionalProperties": false, "required": ["mode", "census"], "properties": {"mode": {"const": "--producer-probe"}, "census": {"type": "string", "pattern": "^native-assets-protected-[1-9][0-9]*[.]json$", "maxLength": 80}}},
