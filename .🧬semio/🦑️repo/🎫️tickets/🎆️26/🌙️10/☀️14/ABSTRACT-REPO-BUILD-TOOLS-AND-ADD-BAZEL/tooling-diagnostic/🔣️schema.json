  "$id": "schema://repo.ticket/DependencyCurrentPlanDiagnosticV1",
  "definitions": {
    "ProducerUnreadyEntry":{"type":"object","additionalProperties":false,"required":["mode","census"],"properties":{"mode":{"const":"--producer-rebuild-unready"},"census":{"type":"string","pattern":"^native-assets-protected-[1-9][0-9]*[.]json$","maxLength":80}}},
