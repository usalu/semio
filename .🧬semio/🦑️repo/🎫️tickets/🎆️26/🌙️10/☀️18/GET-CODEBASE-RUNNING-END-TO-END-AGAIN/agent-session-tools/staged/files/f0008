const request=(id:string,megabytes:number):HostRequestV1=>({id,operation:"run",priority:"batch",minimumJobs:1,preferredJobs:1,fixedMegabytes:megabytes,perJobMegabytes:0,cpuPerJob:1});
const waiter=(id:string,session:string|undefined,weight:number|undefined,arrived:number):HostWaiterV1=>({request:request(id,100),arrivedAtMs:arrived,pid:1,...session===undefined?{}:{session,weight:weight!}});
const grant=(session:string,reserved:number):HostGrantV1=>({id:"g"+session+reserved,operation:"run",jobs:1,cpu:1,reservedMegabytes:reserved,admittedAtMs:0,observedMegabytes:null,pid:1,bootAtMs:0,session});

test("the admission queue serves the session holding the least memory per unit of weight first, then by arrival, and ignores sessions when none is named",()=>{
 const a="0123456789ab.sa",b="0123456789ab.sb",c="0123456789ab.sc";
 const queue=[waiter("w1",a,1,1),waiter("w2",b,1,2),waiter("w3",c,2,3),waiter("w4",undefined,undefined,4)];
 expect(orderHostWaitersV1(queue).map(row=>row.request.id)).toEqual(["w1","w2","w3","w4"]);
 expect(orderHostWaitersV1(queue,[grant(a,800),grant(b,300)]).map(row=>row.request.id)).toEqual(["w3","w4","w2","w1"]);
 expect(orderHostWaitersV1(queue,[grant(a,800),grant(b,300),grant(c,700)]).map(row=>row.request.id)).toEqual(["w4","w2","w3","w1"]);
 const heavy="0123456789ab.sx",light="0123456789ab.sy";
 expect(orderHostWaitersV1([waiter("wy",light,1,1),waiter("wx",heavy,3,2)],[grant(heavy,300),grant(light,200)]).map(row=>row.request.id),"300 MB at weight 3 is less than 200 MB at weight 1").toEqual(["wx","wy"]);
 expect(orderHostWaitersV1([waiter("wy",light,1,1),waiter("wx",heavy,1,2)],[grant(heavy,300),grant(light,200)]).map(row=>row.request.id)).toEqual(["wy","wx"]);
 const interactive=[{...waiter("i1",a,1,9),request:{...request("i1",100),priority:"interactive" as const}},...queue];
 expect(orderHostWaitersV1(interactive,[grant(a,800)])[0]!.request.id).toBe("i1");
 let seed=11;const next=()=>(seed=(seed*1103515245+12345)&0x7fffffff);
 for(let round=0;round<200;round++){
  const sessions=["s0","s1","s2","s3"].map(name=>"0123456789ab."+name),weights=sessions.map(()=>1+next()%4),held=sessions.map(()=>next()%1000);
  const rows=Array.from({length:6},(_,index)=>{const at=next()%4;return waiter("w"+index,sessions[at],weights[at],index);}),ledger=sessions.map((name,index)=>grant(name,held[index]!));
  const order=orderHostWaitersV1(rows,ledger),load=(row:HostWaiterV1)=>held[sessions.indexOf(row.session!)]!/weights[sessions.indexOf(row.session!)]!;
  for(let index=1;index<order.length;index++)expect(load(order[index-1]!)).toBeLessThanOrEqual(load(order[index]!)+1e-9);
 }
});

test("a session that already holds memory does not delay another session's equally sized request in the full decision",()=>{
 const policy={memory:{floorBasisPoints:0,floorMinimumMegabytes:0,floorMaximumMegabytes:0,budgetBasisPoints:10000,rampMilliseconds:0},load:{perCoreCeiling:99,overrideAfterMilliseconds:99999},swap:{ceilingBasisPoints:10000,outMegabytesPerSecond:99999},files:{ceilingBasisPoints:10000},attaches:{maximum:99},wait:{bypassMilliseconds:60000,maximumBypasses:99,agingMilliseconds:9999999}} as never;
 const host={atMs:0,totalMegabytes:1000,availableMegabytes:1000,swapUsedMegabytes:0,swapOutMegabytesPerSecond:0,load:0,cores:8,pressure:"normal",openFiles:null,openFilesMaximum:null,attachedImages:null} as never;
 const heavy="0123456789ab.sheavy",light="0123456789ab.slight",busy=[{...grant(heavy,700),observedMegabytes:700}];
 const queue=[waiter("first",heavy,1,1),waiter("second",light,1,2)].map(row=>({...row,request:request(row.request.id,250)}));
 const decided=evaluateHostCapacityV1(policy,host,busy,queue,10);
 expect(decided.decisions.map(row=>[row.id,row.verdict])).toEqual([["second","admit"],["first","wait"]]);
 const without=evaluateHostCapacityV1(policy,host,busy.map(row=>({...row,session:undefined})),queue.map(row=>({...row,session:undefined})),10);
 expect(without.decisions.map(row=>row.id)).toEqual(["first","second"]);
});

