{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime seam: which JavaScript runtime hosts the framework and how each capability family is provided",
  "definitions": {
    "RuntimeId": {
      "enum": [
        "bun",
        "node"
      ]
    },
    "Family": {
      "enum": [
        "glob",
        "toml",
        "jsonc",
        "yaml",
        "which",
        "resolve",
        "sleep",
        "spawn",
        "stdin",
        "file",
        "serve",
        "sqlite",
        "ffi",
        "transpile",
        "bundle",
        "semver",
        "identity",
        "main",
        "gc"
      ]
    },
    "Support": {
      "enum": [
        "native",
        "standard",
        "portable",
        "missing"
      ]
    },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "detect",
        "executable",
        "minimumVersion",
        "adapter",
        "support",
        "builtins",
        "typeEnvironment"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/RuntimeId"
        },
        "detect": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "minimumVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "adapter": {
          "type": "string"
        },
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "glob",
            "toml",
            "jsonc",
            "yaml",
            "which",
            "resolve",
            "sleep",
            "spawn",
            "stdin",
            "file",
            "serve",
            "sqlite",
            "ffi",
            "transpile",
            "bundle",
            "semver",
            "identity",
            "main",
            "gc"
          ],
          "properties": {
            "glob": {
              "$ref": "#/definitions/Support"
            },
            "toml": {
              "$ref": "#/definitions/Support"
            },
            "jsonc": {
              "$ref": "#/definitions/Support"
            },
            "yaml": {
              "$ref": "#/definitions/Support"
            },
            "which": {
              "$ref": "#/definitions/Support"
            },
            "resolve": {
              "$ref": "#/definitions/Support"
            },
            "sleep": {
              "$ref": "#/definitions/Support"
            },
            "spawn": {
              "$ref": "#/definitions/Support"
            },
            "stdin": {
              "$ref": "#/definitions/Support"
            },
            "file": {
              "$ref": "#/definitions/Support"
            },
            "serve": {
              "$ref": "#/definitions/Support"
            },
            "sqlite": {
              "$ref": "#/definitions/Support"
            },
            "ffi": {
              "$ref": "#/definitions/Support"
            },
            "transpile": {
              "$ref": "#/definitions/Support"
            },
            "bundle": {
              "$ref": "#/definitions/Support"
            },
            "semver": {
              "$ref": "#/definitions/Support"
            },
            "identity": {
              "$ref": "#/definitions/Support"
            },
            "main": {
              "$ref": "#/definitions/Support"
            },
            "gc": {
              "$ref": "#/definitions/Support"
            }
          }
        },
        "builtins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prefixes",
            "names"
          ],
          "properties": {
            "prefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": ":$"
              },
              "uniqueItems": true
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "typeEnvironment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "families",
        "runtimes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Family"
          },
          "uniqueItems": true
        },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Runtime"
          }
        }
      },
      "const": {
        "version": 1,
        "families": [
          "glob",
          "toml",
          "jsonc",
          "yaml",
          "which",
          "resolve",
          "sleep",
          "spawn",
          "stdin",
          "file",
          "serve",
          "sqlite",
          "ffi",
          "transpile",
          "bundle",
          "semver",
          "identity",
          "main",
          "gc"
        ],
        "runtimes": [
          {
            "id": "bun",
            "detect": "bun",
            "executable": "bun",
            "minimumVersion": "1.3.14",
            "adapter": "🍞️bun",
            "support": {
              "glob": "native",
              "toml": "native",
              "jsonc": "native",
              "yaml": "native",
              "which": "native",
              "resolve": "native",
              "sleep": "native",
              "spawn": "standard",
              "stdin": "native",
              "file": "native",
              "serve": "native",
              "sqlite": "native",
              "ffi": "native",
              "transpile": "native",
              "bundle": "native",
              "semver": "native",
              "identity": "native",
              "main": "portable",
              "gc": "native"
            },
            "builtins": {
              "prefixes": [
                "bun:"
              ],
              "names": [
                "bun"
              ]
            },
            "typeEnvironment": "bun"
          },
          {
            "id": "node",
            "detect": "node",
            "executable": "node",
            "minimumVersion": "24.2.0",
            "adapter": "🟢️node",
            "support": {
              "glob": "portable",
              "toml": "portable",
              "jsonc": "portable",
              "yaml": "missing",
              "which": "portable",
              "resolve": "portable",
              "sleep": "standard",
              "spawn": "standard",
              "stdin": "standard",
              "file": "standard",
              "serve": "standard",
              "sqlite": "standard",
              "ffi": "missing",
              "transpile": "missing",
              "bundle": "missing",
              "semver": "portable",
              "identity": "native",
              "main": "portable",
              "gc": "standard"
            },
            "builtins": {
              "prefixes": [
                "node:"
              ],
              "names": []
            },
            "typeEnvironment": "node"
          }
        ]
      }
    }
  }
}
