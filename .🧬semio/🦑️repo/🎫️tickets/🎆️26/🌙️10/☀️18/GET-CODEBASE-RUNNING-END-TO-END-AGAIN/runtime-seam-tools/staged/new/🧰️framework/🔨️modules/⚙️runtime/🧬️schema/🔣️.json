{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runtime seam: which JavaScript runtime hosts the framework and how each capability family is provided",
  "definitions": {
    "RuntimeId": {
      "enum": [
        "bun",
        "node"
      ]
    },
    "Family": {
      "enum": [
        "glob",
        "toml",
        "jsonc",
        "yaml",
        "which",
        "resolve",
        "sleep",
        "spawn",
        "stdin",
        "file",
        "serve",
        "sqlite",
        "ffi",
        "transpile",
        "bundle",
        "semver",
        "identity",
        "gc",
        "plugin",
        "test"
      ]
    },
    "Support": {
      "enum": [
        "native",
        "standard",
        "portable",
        "provider",
        "missing"
      ]
    },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "detect",
        "executable",
        "minimumVersion",
        "adapter",
        "support",
        "builtins",
        "typeEnvironment",
        "sourceUrl",
        "product",
        "packageManager"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/RuntimeId"
        },
        "detect": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "minimumVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "adapter": {
          "type": "string"
        },
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "glob",
            "toml",
            "jsonc",
            "yaml",
            "which",
            "resolve",
            "sleep",
            "spawn",
            "stdin",
            "file",
            "serve",
            "sqlite",
            "ffi",
            "transpile",
            "bundle",
            "semver",
            "identity",
            "gc",
            "plugin",
            "test"
          ],
          "properties": {
            "glob": {
              "$ref": "#/definitions/Support"
            },
            "toml": {
              "$ref": "#/definitions/Support"
            },
            "jsonc": {
              "$ref": "#/definitions/Support"
            },
            "yaml": {
              "$ref": "#/definitions/Support"
            },
            "which": {
              "$ref": "#/definitions/Support"
            },
            "resolve": {
              "$ref": "#/definitions/Support"
            },
            "sleep": {
              "$ref": "#/definitions/Support"
            },
            "spawn": {
              "$ref": "#/definitions/Support"
            },
            "stdin": {
              "$ref": "#/definitions/Support"
            },
            "file": {
              "$ref": "#/definitions/Support"
            },
            "serve": {
              "$ref": "#/definitions/Support"
            },
            "sqlite": {
              "$ref": "#/definitions/Support"
            },
            "ffi": {
              "$ref": "#/definitions/Support"
            },
            "transpile": {
              "$ref": "#/definitions/Support"
            },
            "bundle": {
              "$ref": "#/definitions/Support"
            },
            "semver": {
              "$ref": "#/definitions/Support"
            },
            "identity": {
              "$ref": "#/definitions/Support"
            },
            "gc": {
              "$ref": "#/definitions/Support"
            },
            "plugin": {
              "$ref": "#/definitions/Support"
            },
            "test": {
              "$ref": "#/definitions/Support"
            }
          }
        },
        "builtins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prefixes",
            "names"
          ],
          "properties": {
            "prefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": ":$"
              },
              "uniqueItems": true
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "typeEnvironment": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "enum": [
            "blob",
            "data"
          ]
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "packageManager": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "add",
            "exec"
          ],
          "properties": {
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "add": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exec": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "families",
        "runtimes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Family"
          },
          "uniqueItems": true
        },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Runtime"
          }
        }
      }
    }
  }
}
