{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/build/inference-observation/v1",
  "title": "Build inference observation record",
  "description": "The first line of a persisted inference cache: the digest of the implementation revision and inference key, plus every filesystem fact the computation observed. The second line is the exactly JSON-representable result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digest",
    "observations",
    "authorityObservations",
    "resultSha256"
  ],
  "properties": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "authorityObservations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "resultSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "fact"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "exists",
            "stat",
            "lstat",
            "readdir",
            "realpath",
            "realpathNative",
            "resolve",
            "readdirNames",
            "fileExists",
            "directoryExists",
            "directories",
            "typescriptText",
            "typescriptRealpath",
            "analysis",
            "stamp",
            "closure",
            "registry"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "fact": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "size",
                "mtimeMs",
                "ctimeMs",
                "ino",
                "sha256"
              ],
              "properties": {
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "mtimeMs": {
                  "type": "number"
                },
                "ctimeMs": {
                  "type": "number"
                },
                "ino": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "$ref": "#/$defs/sourceAnalysis"
            }
          ]
        }
      }
    },
    "sourceAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "revision",
        "source",
        "resultSha256",
        "nestedObservations"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "mtimeMs",
            "ctimeMs",
            "ino",
            "sha256"
          ],
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "mtimeMs": {
              "type": "number"
            },
            "ctimeMs": {
              "type": "number"
            },
            "ino": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "resultSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nestedObservations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "observationBlock": {
      "const": {
        "directory": "ob",
        "extension": ".br",
        "digestPattern": "^[a-f0-9]{64}$",
        "maximumPackedBytes": 16777216,
        "maximumOutputBytes": 67108864,
        "maximumRows": 4096,
        "maximumHeaderPackedBytes": 67108864,
        "maximumHeaderOutputBytes": 268435456,
        "maximumHeaderRows": 4194304,
        "maximumBlocks": 65536,
        "maximumDepth": 64,
        "maximumNodes": 4194304,
        "maximumAncestors": 64,
        "maximumPathUnits": 256,
        "maximumAggregatePackedBytes": 67108864,
        "maximumAggregateOutputBytes": 268435456,
        "maximumAggregateRows": 4194304,
        "maximumAggregateNodes": 4194304,
        "maximumParentSets": 16
      }
    },
    "observationBlockCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "accepted"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "observationRows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "inferenceHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "resultSha256",
        "authorityObservations",
        "blocks",
        "observations"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "resultSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorityObservations": {
          "type": "array",
          "maxItems": 4194304,
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "blocks": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "observations": {
          "type": "array",
          "maxItems": 4194304,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    "blockRevalidationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fault",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fault": {
          "enum": [
            "missing",
            "packed",
            "hash",
            "contract",
            "symlink",
            "hardlink",
            "ancestor-replaced",
            "leaf-replaced",
            "cancel",
            "deadline",
            "fifo",
            "cancel-close",
            "ancestor-mode",
            "utf8"
          ]
        },
        "outcome": {
          "enum": [
            "refuse",
            "recompute"
          ]
        }
      }
    },
    "pathClassificationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "scope",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "enum": [
            "graph",
            "ordinary",
            "unknown-native"
          ]
        },
        "scope": {
          "enum": [
            "writer",
            "consumer",
            "expired",
            "absent",
            "mismatch"
          ]
        },
        "outcome": {
          "enum": [
            "managed",
            "ordinary",
            "refuse"
          ]
        }
      }
    },
    "blockRevalidationCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "faults",
        "paths",
        "budgets",
        "recovery"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "faults": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "$ref": "#/$defs/blockRevalidationCase"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/pathClassificationCase"
          }
        },
        "budgets": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/blockBudgetCase"
          }
        },
        "recovery": {
          "$ref": "#/$defs/blockRecoveryLifecycle"
        }
      }
    },
    "blockBudgetCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "used",
        "next",
        "maximum",
        "accepted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "packed",
            "output",
            "rows",
            "nodes",
            "parentSets"
          ]
        },
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "next": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "blockRecoveryLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "states"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "states": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "warm",
              "missing-block-recomputed",
              "group-absent",
              "recomputed"
            ]
          }
        }
      }
    },
    "record": {
      "description": "The format and meaning of a persisted project record. Bump the stamp when the rows, the digest or the validation of a record change for the same inputs; a record written under another stamp is a miss.",
      "const": {
        "stamp": "semio.graph-record/2"
      }
    }
  }
}
