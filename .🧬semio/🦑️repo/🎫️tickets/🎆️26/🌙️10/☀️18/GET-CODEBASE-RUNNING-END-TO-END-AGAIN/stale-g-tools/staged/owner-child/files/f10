{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry",
    "files",
    "links",
    "steps"
  ],
  "properties": {
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "edit",
          "rowsHold",
          "rosterMoved"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "edit": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "rowsHold": {
            "type": "boolean"
          },
          "rosterMoved": {
            "type": "boolean"
          }
        }
      }
    }
  }
}