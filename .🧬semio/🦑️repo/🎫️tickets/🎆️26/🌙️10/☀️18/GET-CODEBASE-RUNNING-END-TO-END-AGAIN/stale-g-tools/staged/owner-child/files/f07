{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files",
    "driver",
    "child",
    "projectRoot",
    "driverClosure",
    "childClosure",
    "wrapped",
    "notWrapped"
  ],
  "properties": {
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "driver": {
      "type": "string",
      "minLength": 1
    },
    "child": {
      "type": "string",
      "minLength": 1
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "driverClosure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "childClosure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "wrapped": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cwd",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        }
      }
    },
    "notWrapped": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        }
      }
    }
  }
}