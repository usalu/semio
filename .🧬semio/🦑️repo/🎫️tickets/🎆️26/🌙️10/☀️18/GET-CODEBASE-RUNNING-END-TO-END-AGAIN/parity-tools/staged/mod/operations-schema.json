{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Neutral Build Operations",
  "description": "Catalogue of the tool-neutral build operations, who implements each one per build tool, and the result shapes every implementation must print.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "languages", "labels", "flags", "operations"],
  "properties": {
    "version": { "const": 1 },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/Language" } },
    "labels": { "$ref": "#/definitions/Labels" },
    "flags": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Flag" } },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Operation" } }
  },
  "definitions": {
    "ToolName": { "enum": ["nx", "bazel"] },
    "Implementation": { "enum": ["native", "adapter", "neutral", "missing"] },
    "OperationName": {
      "enum": ["run", "run-many", "affected", "exec", "watch", "graph", "show", "inputs", "reset", "tools", "preflight", "incremental", "dependencies", "cargo", "cache", "capacity"]
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "synopsis", "summary", "implementations", "dryRun", "progress", "cancellable", "flags", "examples"],
      "properties": {
        "name": { "$ref": "#/definitions/OperationName" },
        "synopsis": { "type": "string", "minLength": 1 },
        "implementations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nx", "bazel"],
          "properties": { "nx": { "$ref": "#/definitions/Implementation" }, "bazel": { "$ref": "#/definitions/Implementation" } }
        },
        "dryRun": { "type": "boolean" },
        "progress": { "type": "boolean" },
        "cancellable": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "summary": { "$ref": "#/definitions/LocalizedText" },
        "subcommands": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Subcommand" } },
        "flags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/FlagName" } },
        "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Example" } }
      }
    },
    "TaskGraph": {
      "type": "object",
      "required": ["roots", "tasks", "dependencies"],
      "properties": {
        "roots": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["id", "target"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "target": {
                "type": "object",
                "required": ["project", "target"],
                "properties": {
                  "project": { "type": "string", "minLength": 1 },
                  "target": { "type": "string", "minLength": 1 },
                  "configuration": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "dependencies": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } },
        "continuousDependencies": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
      }
    },
    "DryRunPlan": { "type": "object", "required": ["tasks"], "properties": { "tasks": { "$ref": "#/definitions/TaskGraph" } } },
    "CacheActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builds", "actions", "executed", "cacheHits"],
      "properties": {
        "builds": { "type": "integer", "minimum": 0 },
        "actions": { "type": "integer", "minimum": 0 },
        "executed": { "type": "integer", "minimum": 0 },
        "cacheHits": { "type": "integer", "minimum": 0 }
      }
    },
    "ExecEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SEMIO_PROJECT_NAME", "SEMIO_PROJECT_ROOT"],
      "properties": { "SEMIO_PROJECT_NAME": { "type": "string", "minLength": 1 }, "SEMIO_PROJECT_ROOT": { "type": "string", "minLength": 1 } }
    },
    "CacheStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tool", "available", "directory", "entries", "bytes"],
      "properties": {
        "version": { "const": 1 },
        "tool": { "$ref": "#/definitions/ToolName" },
        "available": { "type": "boolean" },
        "directory": { "type": ["string", "null"] },
        "entries": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "activity": { "$ref": "#/definitions/CacheActivity" }
      }
    },
    "CacheClear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tool", "cleared", "removedEntries", "removedBytes"],
      "properties": {
        "version": { "const": 1 },
        "tool": { "$ref": "#/definitions/ToolName" },
        "cleared": { "type": "boolean" },
        "removedEntries": { "type": "integer", "minimum": 0 },
        "removedBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "Language": { "enum": ["en", "de"] },
    "LocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
    },
    "Labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagline", "usage", "commands", "options", "globalOptions", "subcommands", "examples", "usedBy"],
      "properties": {
        "tagline": { "$ref": "#/definitions/LocalizedText" },
        "usage": { "$ref": "#/definitions/LocalizedText" },
        "commands": { "$ref": "#/definitions/LocalizedText" },
        "options": { "$ref": "#/definitions/LocalizedText" },
        "globalOptions": { "$ref": "#/definitions/LocalizedText" },
        "subcommands": { "$ref": "#/definitions/LocalizedText" },
        "examples": { "$ref": "#/definitions/LocalizedText" },
        "usedBy": { "$ref": "#/definitions/LocalizedText" }
      }
    },
    "FlagName": { "type": "string", "pattern": "^--[a-z][a-z-]*$" },
    "Flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "description"],
      "properties": {
        "name": { "$ref": "#/definitions/FlagName" },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^--?[a-z][a-z-]*$" } },
        "value": { "enum": ["none", "required", "optional", "separate"] },
        "valueName": { "type": "string", "minLength": 1 },
        "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/OperationName" } },
        "description": { "$ref": "#/definitions/LocalizedText" }
      }
    },
    "Subcommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "synopsis", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "synopsis": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/definitions/LocalizedText" }
      }
    },
    "Example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "description"],
      "properties": { "command": { "type": "string", "minLength": 6, "pattern": "^repo " }, "description": { "$ref": "#/definitions/LocalizedText" } }
    }
  }
}
