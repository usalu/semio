{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/typescript-check/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace",
    "stateRoot",
    "cwd",
    "project",
    "owner",
    "timeoutMs",
    "mode"
  ],
  "properties": {
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "stateRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "args": {
      "$ref": "#/definitions/Arguments"
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    }
  },
  "definitions": {
    "Arguments": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "--extendedDiagnostics",
          "--diagnostics",
          "--pretty",
          "--listFiles",
          "--listFilesOnly",
          "--explainFiles",
          "--traceResolution",
          "--noErrorTruncation"
        ]
      }
    },
    "RetentionPolicy": {
      "const": {
        "retainedPrograms": 2,
        "maximumRetainedPrograms": 8,
        "maximumHeapBytes": 2147483648,
        "idleMilliseconds": 120000
      }
    },
    "CompilerEnvironment": {
      "const": {
        "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
        "NODE_DISABLE_COMPILE_CACHE": "1"
      }
    }
  }
}
