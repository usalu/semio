{
  "version": 1,
  "rules": {
    "outOfOrder": "observe",
    "holdAndWait": "enforce",
    "selfDeadlock": "enforce",
    "cycle": "enforce"
  },
  "holdAndWait": {
    "graceMilliseconds": 15000,
    "pollMilliseconds": 250
  },
  "cycle": {
    "intervalMilliseconds": 500
  },
  "registry": {
    "flushMilliseconds": 100,
    "maximumEntryBytes": 65536,
    "maximumViolations": 200
  },
  "fairness": {
    "queuedWithResourceLeases": true
  },
  "gate": {
    "releaseWhileWaiting": true,
    "pollInitialMilliseconds": 20,
    "pollMaximumMilliseconds": 250
  },
  "classes": [
    {
      "id": "compiler-capacity",
      "rank": 1,
      "scope": "machine",
      "owner": "compiler-capacity",
      "title": {
        "en": "Compiler capacity gate, picker and core slots",
        "de": "Compiler-Kapazitätstor, Auswahl und Kernplätze"
      },
      "match": [
        {
          "kind": "exact",
          "value": "semio.compiler.host-capacity/v1"
        },
        {
          "kind": "exact",
          "value": "semio.compiler.cpu-picker/v1"
        },
        {
          "kind": "prefix",
          "value": "semio.compiler.cpu/v1/"
        }
      ]
    },
    {
      "id": "tool-singleton",
      "rank": 2,
      "scope": "checkout",
      "owner": "build-tools",
      "title": {
        "en": "Tool activation, download and provisioning singletons",
        "de": "Singletons für Werkzeug-Aktivierung, -Download und -Bereitstellung"
      },
      "match": [
        {
          "kind": "exact",
          "value": "nx-tooling-activation"
        },
        {
          "kind": "exact",
          "value": "nx-tool-download-cache"
        },
        {
          "kind": "exact",
          "value": "nx-tooling-provision"
        },
        {
          "kind": "prefix",
          "value": "nx-tooling:"
        },
        {
          "kind": "prefix",
          "value": "nx-authorizer-"
        },
        {
          "kind": "prefix",
          "value": "nx-sdk-snapshot:"
        },
        {
          "kind": "exact",
          "value": "bazel-metrics"
        },
        {
          "kind": "exact",
          "value": "bazel-snapshot-restore"
        },
        {
          "kind": "prefix",
          "value": "bazel-"
        },
        {
          "kind": "prefix",
          "value": "bun-"
        },
        {
          "kind": "prefix",
          "value": "rustup:"
        },
        {
          "kind": "exact",
          "value": "cache-prune"
        },
        {
          "kind": "exact",
          "value": "tools"
        },
        {
          "kind": "prefix",
          "value": "tools:"
        },
        {
          "kind": "prefix",
          "value": "repository:selected-tooling:"
        },
        {
          "kind": "prefix",
          "value": "selected-rust-"
        }
      ]
    },
    {
      "id": "cargo-coordination",
      "rank": 2,
      "scope": "crate",
      "owner": "cargo",
      "title": {
        "en": "Cargo registry, preparation, source admission and build leases",
        "de": "Cargo-Registry, -Vorbereitung, -Quellzulassung und -Build-Leases"
      },
      "match": [
        {
          "kind": "prefix",
          "value": "cargo:"
        },
        {
          "kind": "prefix",
          "value": "cargo-"
        },
        {
          "kind": "prefix",
          "value": "[\"semio.cargo."
        }
      ]
    },
    {
      "id": "graph",
      "rank": 3,
      "scope": "checkout",
      "owner": "graph",
      "title": {
        "en": "Graph pools, writers, publications and daemons",
        "de": "Graph-Pools, -Schreiber, -Veröffentlichungen und -Daemons"
      },
      "match": [
        {
          "kind": "prefix",
          "value": "nx:"
        },
        {
          "kind": "prefix",
          "value": "repository-graph-"
        },
        {
          "kind": "prefix",
          "value": "build-graph-"
        },
        {
          "kind": "prefix",
          "value": "runtime-graph:"
        },
        {
          "kind": "prefix",
          "value": "repository:graph-"
        },
        {
          "kind": "exact",
          "value": "repository-build-reports"
        }
      ]
    },
    {
      "id": "namespace",
      "rank": 4,
      "scope": "project",
      "owner": "namespaces",
      "title": {
        "en": "Per-project and per-crate namespaces, bindings and descriptors",
        "de": "Namespaces, Bindungen und Deskriptoren je Projekt und Crate"
      },
      "match": [
        {
          "kind": "prefix",
          "value": "rust-code"
        },
        {
          "kind": "prefix",
          "value": "rust:"
        },
        {
          "kind": "prefix",
          "value": "rust-"
        },
        {
          "kind": "prefix",
          "value": "javascript-dependency-"
        },
        {
          "kind": "prefix",
          "value": "typescript-package-binding:"
        },
        {
          "kind": "prefix",
          "value": "styling-python:"
        },
        {
          "kind": "prefix",
          "value": "storybook-"
        },
        {
          "kind": "prefix",
          "value": "vite-"
        },
        {
          "kind": "prefix",
          "value": "native-snapshot"
        },
        {
          "kind": "prefix",
          "value": "native-artifact-"
        }
      ]
    },
    {
      "id": "artifact",
      "rank": 5,
      "scope": "path",
      "owner": "artifacts",
      "title": {
        "en": "Artifact paths, scratch and capture",
        "de": "Artefaktpfade, Scratch und Erfassung"
      },
      "match": [
        {
          "kind": "prefix",
          "value": "artifact:"
        },
        {
          "kind": "prefix",
          "value": "artifact-scratch:"
        },
        {
          "kind": "prefix",
          "value": "artifact-capture:"
        }
      ]
    },
    {
      "id": "image",
      "rank": 6,
      "scope": "generation",
      "owner": "storage",
      "title": {
        "en": "Fixed images, native storage and persistent state",
        "de": "Feste Images, nativer Speicher und persistenter Zustand"
      },
      "match": [
        {
          "kind": "prefix",
          "value": "native-fixed-image:"
        },
        {
          "kind": "prefix",
          "value": "native-storage:"
        },
        {
          "kind": "prefix",
          "value": "persistent-state:"
        },
        {
          "kind": "prefix",
          "value": "persistent-data:"
        },
        {
          "kind": "prefix",
          "value": "repository-cache-charge:"
        },
        {
          "kind": "prefix",
          "value": "repo:compiler-charge:"
        }
      ]
    }
  ],
  "allowed": [
    {
      "from": "compiler-capacity",
      "to": "tool-singleton",
      "reason": {
        "en": "A capacity slot is taken for the command that then activates tools.",
        "de": "Ein Kapazitätsplatz wird für den Befehl genommen, der danach Werkzeuge aktiviert."
      }
    },
    {
      "from": "compiler-capacity",
      "to": "graph",
      "reason": {
        "en": "Capacity is taken before the graph is asked.",
        "de": "Kapazität wird vor der Anfrage an den Graphen genommen."
      }
    }
  ]
}
