{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Build Backend Registry",
  "description": "The authored list of build backends behind the neutral `repo` interface. One row per backend is everything neutral code knows about it; the adapter module named by the row implements BuildBackendV1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "backends"],
  "properties": {
    "version": { "const": 1 },
    "backends": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Backend" } }
  },
  "definitions": {
    "Id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
    },
    "Support": { "enum": ["native", "adapter", "neutral", "missing"] },
    "Capability": {
      "enum": ["plan", "run", "cache-restore", "invalidation", "early-cutoff", "uncached", "outputs", "failure-isolation", "test-results", "affected", "cancellation", "progress", "parallelism", "concurrent-invocations", "single-flight", "remote-cache", "run-record"]
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support"],
      "properties": { "support": { "$ref": "#/definitions/Support" }, "note": { "$ref": "#/definitions/Text" } }
    },
    "Backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "module", "driver", "dependencyModel", "operations", "capabilities"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "title": { "$ref": "#/definitions/Text" },
        "kind": { "enum": ["external", "in-house"] },
        "default": { "type": "boolean" },
        "module": { "type": "string", "pattern": "^\\.\\./.+\\.ts$" },
        "driver": { "type": "string", "pattern": "^\\.\\./.+\\.ts$" },
        "dependencyModel": { "enum": ["all", "consumers"] },
        "processEnvironment": { "type": "object", "additionalProperties": { "type": "string" } },
        "nativeSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["variable", "environment"],
          "properties": { "variable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }, "environment": { "type": "object", "additionalProperties": { "type": "string" } } }
        },
        "operations": { "type": "object", "propertyNames": { "type": "string", "pattern": "^[a-z][a-z-]*$" }, "additionalProperties": { "$ref": "#/definitions/Support" } },
        "capabilities": { "type": "object", "propertyNames": { "$ref": "#/definitions/Capability" }, "additionalProperties": { "$ref": "#/definitions/Claim" } }
      }
    }
  }
}
