{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Build Backend Conformance",
  "description": "Language-agnostic contract every build backend must satisfy behind the neutral interface: a workspace of stub tasks, scenarios over it, and the closed shapes of what a run reports.",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "maximumScenarios": 64,
        "maximumSteps": 16,
        "cancelWithinMilliseconds": 5000,
        "cancelSettleMilliseconds": 3800,
        "stubDirectory": ".conformance",
        "maximumRunMilliseconds": 300000
      }
    },
    "Id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "TaskId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" },
    "RelativePath": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$" },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["emit", "fail", "sleep"] },
        "milliseconds": { "type": "integer", "minimum": 1 },
        "normalize": { "type": "boolean" },
        "report": { "type": "boolean" }
      }
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache", "reads", "outputs", "action"],
      "properties": {
        "cache": { "type": "boolean" },
        "kind": { "enum": ["build", "test", "check"] },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/TaskId" } },
        "reads": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "outputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/RelativePath" } },
        "action": { "$ref": "#/definitions/Action" }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dependsOn", "targets"],
      "properties": {
        "name": { "$ref": "#/definitions/Id" },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/Id" } },
        "targets": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/definitions/Id" }, "additionalProperties": { "$ref": "#/definitions/Target" } }
      }
    },
    "Workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "projects"],
      "properties": {
        "files": { "type": "object", "propertyNames": { "$ref": "#/definitions/RelativePath" }, "additionalProperties": { "type": "string" } },
        "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Project" } }
      }
    },
    "TaskSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/TaskId" } },
    "OutputCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "path", "state"],
      "properties": {
        "task": { "$ref": "#/definitions/TaskId" },
        "path": { "$ref": "#/definitions/RelativePath" },
        "state": { "enum": ["expected", "absent", "unchanged", "changed"] }
      }
    },
    "RunOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallel": { "type": "integer", "minimum": 1 },
        "skipCache": { "type": "boolean" },
        "remote": { "enum": ["off", "read-write"] }
      }
    },
    "RunExpect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit": { "enum": ["zero", "nonzero"] },
        "executed": { "$ref": "#/definitions/TaskSet" },
        "executedEach": { "$ref": "#/definitions/TaskSet" },
        "restored": { "$ref": "#/definitions/TaskSet" },
        "outputs": { "type": "array", "items": { "$ref": "#/definitions/OutputCheck" } },
        "ordered": { "type": "boolean" },
        "maxConcurrent": { "type": "integer", "minimum": 1 },
        "minConcurrent": { "type": "integer", "minimum": 1 },
        "events": { "enum": ["covers-executed"] },
        "startsOnce": { "$ref": "#/definitions/TaskSet" }
      }
    },
    "Step": {
      "oneOf": [
        { "$ref": "#/definitions/RunStep" },
        { "$ref": "#/definitions/EditStep" },
        { "$ref": "#/definitions/DeleteStep" },
        { "$ref": "#/definitions/PlanStep" },
        { "$ref": "#/definitions/AffectedStep" },
        { "$ref": "#/definitions/CancelStep" },
        { "$ref": "#/definitions/ConcurrentStep" },
        { "$ref": "#/definitions/MoveStep" }
      ]
    },
    "RunStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "targets", "expect"],
      "properties": {
        "step": { "const": "run" },
        "targets": { "$ref": "#/definitions/TaskSet" },
        "options": { "$ref": "#/definitions/RunOptions" },
        "expect": { "$ref": "#/definitions/RunExpect" }
      }
    },
    "EditStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "file", "op"],
      "properties": { "step": { "const": "edit" }, "file": { "$ref": "#/definitions/RelativePath" }, "op": { "enum": ["append-line", "append-comment"] } }
    },
    "DeleteStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "paths"],
      "properties": { "step": { "const": "delete" }, "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/RelativePath" } } }
    },
    "PlanStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "target", "tasks", "edges"],
      "properties": {
        "step": { "const": "plan" },
        "target": { "$ref": "#/definitions/TaskId" },
        "tasks": { "$ref": "#/definitions/TaskSet" },
        "edges": { "type": "object", "propertyNames": { "$ref": "#/definitions/TaskId" }, "additionalProperties": { "$ref": "#/definitions/TaskSet" } }
      }
    },
    "AffectedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "files", "projects"],
      "properties": {
        "step": { "const": "affected" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/RelativePath" } },
        "projects": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/Id" } }
      }
    },
    "CancelStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "targets", "afterStart", "settled"],
      "properties": {
        "step": { "const": "cancel" },
        "targets": { "$ref": "#/definitions/TaskSet" },
        "afterStart": { "$ref": "#/definitions/TaskId" },
        "settled": { "$ref": "#/definitions/TaskId" }
      }
    },
    "ConcurrentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "runs", "expect"],
      "properties": {
        "step": { "const": "concurrent" },
        "runs": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/TaskSet" } },
        "expect": { "$ref": "#/definitions/RunExpect" }
      }
    },
    "MoveStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step"],
      "properties": { "step": { "const": "fresh-checkout" } }
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "title", "steps"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "capability": { "enum": ["plan", "run", "cache-restore", "invalidation", "early-cutoff", "uncached", "outputs", "failure-isolation", "test-results", "affected", "cancellation", "progress", "parallelism", "concurrent-invocations", "single-flight", "remote-cache", "run-record"] },
        "title": { "$ref": "#/definitions/Text" },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/Evidence" } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/Step" } }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "id"],
      "properties": {
        "suite": { "enum": ["incremental", "parity", "concurrency", "bazel-contract"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "ScenarioSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "workspace", "scenarios"],
      "properties": {
        "version": { "const": 1 },
        "workspace": { "$ref": "#/definitions/Workspace" },
        "scenarios": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/definitions/Scenario" } }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "task"],
      "properties": { "kind": { "enum": ["start", "end"] }, "task": { "$ref": "#/definitions/TaskId" }, "status": { "type": "string" } }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "dependencies"],
      "properties": { "tasks": { "$ref": "#/definitions/TaskSet" }, "dependencies": { "type": "object", "additionalProperties": { "$ref": "#/definitions/TaskSet" } } }
    },
    "Marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "task", "at"],
      "properties": { "kind": { "enum": ["start", "end"] }, "task": { "$ref": "#/definitions/TaskId" }, "at": { "type": "number" } }
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode", "milliseconds"],
      "properties": {
        "exitCode": { "type": "integer" },
        "milliseconds": { "type": "number", "minimum": 0 },
        "output": { "type": "string" },
        "restored": { "$ref": "#/definitions/TaskSet" },
        "events": { "type": "array", "items": { "$ref": "#/definitions/Event" } }
      }
    },
    "Verdict": { "enum": ["pass", "regression", "gap", "stale-claim", "unobserved", "error"] },
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "backend", "capability", "claim", "measured", "verdict", "failures", "milliseconds"],
      "properties": {
        "scenario": { "$ref": "#/definitions/Id" },
        "backend": { "type": "string", "minLength": 1 },
        "capability": { "type": "string" },
        "claim": { "enum": ["native", "adapter", "neutral", "missing"] },
        "measured": { "enum": ["pass", "fail", "unobserved", "error"] },
        "verdict": { "$ref": "#/definitions/Verdict" },
        "failures": { "type": "array", "items": { "type": "string" } },
        "milliseconds": { "type": "number", "minimum": 0 }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rows", "passed", "failed", "unobserved"],
      "properties": {
        "version": { "const": 1 },
        "rows": { "type": "array", "items": { "$ref": "#/definitions/Row" } },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unobserved": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
