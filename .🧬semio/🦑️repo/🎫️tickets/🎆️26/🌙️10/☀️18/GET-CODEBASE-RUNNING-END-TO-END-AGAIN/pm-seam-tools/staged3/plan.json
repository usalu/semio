   "path": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🚀️bootstrap/📦️dependencies/🔌️managers/🧪️tests/🐍️oracle.py",
   "edits": [
    {
     "id": "round3-oracle-regions",
     "group": "seam3",
     "old": "def schema_bases():\n",
     "new": "def is_region(node):\n    return (\"$manager\" in node) if isinstance(node, dict) else isinstance(node, str) and TOKEN.search(node) is not None\n\n\ndef regions(node, view, path=\"\"):\n    if is_region(node):\n        return [[path, materialize(node, view)]]\n    rows = []\n    if isinstance(node, list):\n        for index, item in enumerate(node):\n            step = \"$\" + item[\"$manager\"] if isinstance(item, dict) and \"$manager\" in item else item if is_region(item) else str(index)\n            rows += regions(item, view, path + \"/[\" + step + \"]\")\n    elif isinstance(node, dict):\n        for key, value in node.items():\n            rows += regions(value, view, path + \"/\" + key)\n    return rows\n\n\ndef schema_bases():\n",
     "counts": [
      1
     ]
    },
    {
     "id": "round3-oracle-digest",
     "group": "seam3",
     "old": "sha(canonical(materialize(base, view))) for key, base in schema_bases().items()",
     "new": "sha(canonical(regions(base, view))) for key, base in schema_bases().items()",
     "counts": [
      1
     ]
    }
   ],
