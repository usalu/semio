{
  "version": 1,
  "id": "uv",
  "ecosystem": "python",
  "toolchain": "python",
  "executable": "uv",
  "runtime": {
    "hostVersionKey": null,
    "probe": {
      "arguments": [
        "--version"
      ],
      "pattern": "^uv ([0-9]+\\.[0-9]+\\.[0-9]+)"
    }
  },
  "manifests": [
    "pyproject.toml"
  ],
  "manifestIdentity": {
    "excludedTopLevelFields": [],
    "bootstrapFields": [
      "project",
      "dependency-groups",
      "tool"
    ]
  },
  "locks": [
    {
      "name": "uv.lock",
      "role": "primary",
      "format": "uv-lock"
    }
  ],
  "configurations": {
    "scope": [
      "uv.toml",
      ".python-version"
    ],
    "home": [],
    "config": [
      "uv/uv.toml"
    ]
  },
  "environment": {
    "set": {
      "HOME": "role:home",
      "USERPROFILE": "role:home",
      "XDG_CONFIG_HOME": "role:config",
      "XDG_CACHE_HOME": "role:cache",
      "TMPDIR": "role:temporary",
      "TMP": "role:temporary",
      "TEMP": "role:temporary",
      "UV_CACHE_DIR": "role:cache",
      "UV_PYTHON_INSTALL_DIR": "role:global",
      "UV_NO_PROGRESS": "literal:1"
    }
  },
  "recipe": {
    "version": 1,
    "kind": "python-install-projection",
    "backends": {
      "darwin": "clone",
      "linux": "copy",
      "win32": "copy"
    },
    "cache": "uv-cache",
    "global": "uv-python",
    "bin": "uv-bin",
    "clearEnvironmentPrefixes": [
      "UV_"
    ],
    "clearEnvironmentKeys": [
      "HOME",
      "USERPROFILE",
      "XDG_CONFIG_HOME",
      "XDG_CACHE_HOME",
      "TMPDIR",
      "TMP",
      "TEMP"
    ],
    "temporary": "tmp",
    "home": "home",
    "config": "config"
  },
  "backendKinds": {
    "clone": "clone",
    "copy": "copy",
    "hardlink": "alias",
    "symlink": "alias"
  },
  "operations": {
    "lock": {
      "arguments": [
        "lock",
        "--cache-dir",
        "{cache}"
      ]
    },
    "sync": {
      "arguments": [
        "sync",
        "--locked",
        "--link-mode={backend}",
        "--cache-dir",
        "{cache}"
      ]
    },
    "verify": {
      "arguments": [
        "lock",
        "--check",
        "--cache-dir",
        "{cache}"
      ]
    }
  },
  "installed": {
    "containers": [
      ".venv/lib/*/site-packages",
      ".venv/Lib/site-packages"
    ],
    "entry": "{name}-{version}.dist-info",
    "match": "listed",
    "nameTransform": "pep-escape",
    "nameEscape": {},
    "fold": "pep-escape",
    "suffix": null,
    "sourcePrefix": null
  },
  "resolution": {
    "profiles": [],
    "strictPrefix": null
  },
  "generationDirectory": "p",
  "graphComponent": null
}
