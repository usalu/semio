{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository Worker Contract",
  "description": "👷️ Tool-neutral worker pool contract: which action kinds may run in persistent workers, how many instances, whether one worker multiplexes requests, how much memory the pools may hold, how many local jobs run, and whether workers are sandboxed. Every build tool maps these fields to its own mechanism and reports what it can not honour; the JSON worker protocol below is the wire format of the persistent worker runtime.",
  "definitions": {
    "ActionKind": {
      "description": "What a task does, derived from its target name and continuity, never from a build tool.",
      "enum": [
        "test",
        "check",
        "generate",
        "build",
        "script",
        "service"
      ]
    },
    "Count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "Rule": {
      "description": "One ordered classification rule; the first match wins. `continuous` matches the declared continuity, `pattern` matches the target name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/ActionKind"
        },
        "continuous": {
          "type": "boolean"
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "anyOf": [
        {
          "required": [
            "continuous"
          ],
          "properties": {
            "continuous": {
              "type": "boolean"
            }
          }
        },
        {
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers",
        "maxInstances",
        "multiplex",
        "inProcess"
      ],
      "properties": {
        "workers": {
          "type": "boolean",
          "description": "Run this kind in persistent workers."
        },
        "maxInstances": {
          "$ref": "#/definitions/Count",
          "description": "Upper bound of worker instances of this kind."
        },
        "multiplex": {
          "type": "boolean",
          "description": "One worker process handles several requests at once."
        },
        "inProcess": {
          "type": "boolean",
          "description": "The worker runs the action body in its own process instead of one child process per request."
        }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "multiplex": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "inProcess": {
              "const": false
            }
          }
        }
      ]
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "protocol",
        "localJobs",
        "memory",
        "sandboxing",
        "cancellation",
        "resetAfterRequests",
        "classification",
        "defaultKind",
        "kinds"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "protocol": {
          "enum": [
            "json"
          ]
        },
        "localJobs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximum"
          ],
          "properties": {
            "maximum": {
              "$ref": "#/definitions/Count",
              "description": "Local job count is min(cores, maximum) unless the caller passes --parallel."
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostShareBasisPoints",
            "perWorkerMegabytes"
          ],
          "properties": {
            "hostShareBasisPoints": {
              "type": "integer",
              "minimum": 100,
              "maximum": 9000,
              "description": "Share of host memory all worker pools together may hold, in 1/10000."
            },
            "perWorkerMegabytes": {
              "type": "integer",
              "minimum": 64,
              "maximum": 65536,
              "description": "Memory one worker instance may hold before it is recycled."
            }
          }
        },
        "sandboxing": {
          "type": "boolean"
        },
        "cancellation": {
          "type": "boolean"
        },
        "resetAfterRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "classification": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/Rule"
          }
        },
        "defaultKind": {
          "description": "The kind of a task no rule matches.",
          "enum": [
            "test",
            "check",
            "generate",
            "build",
            "script"
          ]
        },
        "kinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "test",
            "check",
            "generate",
            "build",
            "script",
            "service"
          ],
          "properties": {
            "test": {
              "$ref": "#/definitions/Kind"
            },
            "check": {
              "$ref": "#/definitions/Kind"
            },
            "generate": {
              "$ref": "#/definitions/Kind"
            },
            "build": {
              "$ref": "#/definitions/Kind"
            },
            "script": {
              "$ref": "#/definitions/Kind"
            },
            "service": {
              "$ref": "#/definitions/Kind"
            }
          }
        }
      }
    },
    "Plan": {
      "description": "A policy resolved against one host and one invocation; every field is final.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "protocol",
        "localJobs",
        "memory",
        "sandboxing",
        "cancellation",
        "resetAfterRequests",
        "kinds"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "protocol": {
          "enum": [
            "json"
          ]
        },
        "localJobs": {
          "$ref": "#/definitions/Count"
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "totalMegabytes",
            "perWorkerMegabytes",
            "instances"
          ],
          "properties": {
            "totalMegabytes": {
              "type": "integer",
              "minimum": 64
            },
            "perWorkerMegabytes": {
              "type": "integer",
              "minimum": 64
            },
            "instances": {
              "$ref": "#/definitions/Count",
              "description": "How many worker instances the total fits."
            }
          }
        },
        "sandboxing": {
          "type": "boolean"
        },
        "cancellation": {
          "type": "boolean"
        },
        "resetAfterRequests": {
          "type": "integer",
          "minimum": 1
        },
        "kinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "test",
            "check",
            "generate",
            "build",
            "script",
            "service"
          ],
          "properties": {
            "test": {
              "$ref": "#/definitions/Kind"
            },
            "check": {
              "$ref": "#/definitions/Kind"
            },
            "generate": {
              "$ref": "#/definitions/Kind"
            },
            "build": {
              "$ref": "#/definitions/Kind"
            },
            "script": {
              "$ref": "#/definitions/Kind"
            },
            "service": {
              "$ref": "#/definitions/Kind"
            }
          }
        }
      }
    },
    "Support": {
      "description": "How exactly a tool honours one contract field.",
      "enum": [
        "exact",
        "approximate",
        "unsupported"
      ]
    },
    "Mapping": {
      "description": "What one tool does with one contract field.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "support",
        "setting"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "$ref": "#/definitions/Support"
        },
        "setting": {
          "type": "string"
        }
      }
    },
    "Input": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "WorkRequest": {
      "description": "One line of the JSON worker protocol on the worker's standard input. Unknown fields are ignored.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Input"
          }
        },
        "requestId": {
          "type": "integer",
          "minimum": 0
        },
        "cancel": {
          "type": "boolean"
        },
        "verbosity": {
          "type": "integer",
          "minimum": 0
        },
        "sandboxDir": {
          "type": "string"
        }
      }
    },
    "WorkResponse": {
      "description": "One line of the JSON worker protocol on the worker's standard output.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "output"
      ],
      "properties": {
        "exitCode": {
          "type": "integer"
        },
        "output": {
          "type": "string"
        },
        "requestId": {
          "type": "integer",
          "minimum": 0
        },
        "wasCancelled": {
          "type": "boolean"
        }
      }
    },
    "Protocol": {
      "const": {
        "maximumRequestBytes": 16777216,
        "maximumOutputBytes": 1048576,
        "truncationMarker": "\n[worker] output truncated\n"
      }
    }
  }
}
