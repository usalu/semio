{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "semio:build/graph-queue-yield",
 "title": "Graph queue yield policy",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "contract",
  "yieldAfterMilliseconds",
  "maximumYields",
  "wakeMilliseconds",
  "pollMilliseconds",
  "progressMilliseconds",
  "environment",
  "exitCode",
  "texts"
 ],
 "properties": {
  "version": {
   "const": 1
  },
  "contract": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "en",
    "de"
   ],
   "properties": {
    "en": {
     "type": "string",
     "minLength": 1
    },
    "de": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "yieldAfterMilliseconds": {
   "type": "integer",
   "minimum": 1000
  },
  "maximumYields": {
   "type": "integer",
   "minimum": 1,
   "maximum": 10
  },
  "wakeMilliseconds": {
   "type": "integer",
   "minimum": 1000
  },
  "pollMilliseconds": {
   "type": "integer",
   "minimum": 100
  },
  "progressMilliseconds": {
   "type": "integer",
   "minimum": 1000
  },
  "environment": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "ticket",
    "requestedAt",
    "round"
   ],
   "properties": {
    "ticket": {
     "type": "string",
     "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "requestedAt": {
     "type": "string",
     "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "round": {
     "type": "string",
     "pattern": "^[A-Z][A-Z0-9_]+$"
    }
   }
  },
  "exitCode": {
   "type": "integer",
   "minimum": 1,
   "maximum": 255
  },
  "texts": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "waiting",
    "resumed"
   ],
   "properties": {
    "waiting": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "en",
      "de"
     ],
     "properties": {
      "en": {
       "type": "string",
       "minLength": 1
      },
      "de": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "resumed": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "en",
      "de"
     ],
     "properties": {
      "en": {
       "type": "string",
       "minLength": 1
      },
      "de": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   }
  }
 }
}