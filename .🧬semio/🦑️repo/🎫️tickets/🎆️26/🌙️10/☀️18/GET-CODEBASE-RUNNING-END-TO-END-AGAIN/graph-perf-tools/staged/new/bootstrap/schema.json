{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://repo/build/bootstrap-install/v1",
  "title": "Bootstrap install de-duplication cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adoption", "installs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "adoption": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "adopted"],
        "properties": { "status": { "enum": ["published", "present", "deferred", "stale", "failed"] }, "adopted": { "type": "boolean" } }
      }
    },
    "installs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runs", "recheck", "initiallyReady", "readyAfterInstall", "expectedPrepares"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "runs": { "type": "integer", "minimum": 1, "maximum": 16 },
          "recheck": { "type": "boolean" },
          "initiallyReady": { "type": "boolean" },
          "readyAfterInstall": { "type": "boolean" },
          "expectedPrepares": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
