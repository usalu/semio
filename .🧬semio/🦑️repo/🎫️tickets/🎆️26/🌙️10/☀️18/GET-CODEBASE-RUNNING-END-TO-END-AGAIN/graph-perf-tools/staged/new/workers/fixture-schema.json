{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:worker-pool-fixture:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "files", "square", "count", "bounded", "cancel", "failure"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "files": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["text", "sha256"], "properties": { "text": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } },
    "square": { "type": "object", "additionalProperties": false, "required": ["inputs", "expected"], "properties": { "inputs": { "type": "array", "items": { "type": "integer" } }, "expected": { "type": "array", "items": { "type": "integer" } } } },
    "count": { "type": "object", "additionalProperties": false, "required": ["total"], "properties": { "total": { "type": "integer", "minimum": 1 } } },
    "bounded": { "type": "object", "additionalProperties": false, "required": ["workers", "tasks", "maximumDistinctThreads"], "properties": { "workers": { "type": "integer", "minimum": 1 }, "tasks": { "type": "integer", "minimum": 1 }, "maximumDistinctThreads": { "type": "integer", "minimum": 1 } } },
    "cancel": { "type": "object", "additionalProperties": false, "required": ["spinMilliseconds", "workers", "tasks", "deadlineMilliseconds"], "properties": { "spinMilliseconds": { "type": "integer" }, "workers": { "type": "integer", "minimum": 1 }, "tasks": { "type": "integer", "minimum": 1 }, "deadlineMilliseconds": { "type": "integer" } } },
    "failure": { "type": "object", "additionalProperties": false, "required": ["message"], "properties": { "message": { "type": "string" } } }
  }
}
