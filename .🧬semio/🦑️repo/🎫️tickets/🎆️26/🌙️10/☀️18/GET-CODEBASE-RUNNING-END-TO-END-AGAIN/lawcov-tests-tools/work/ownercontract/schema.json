{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:owner-contract-corpus:v1",
  "title": "Owner Contract Conformance Corpus",
  "description": "Language-agnostic cases for the owner contract validator: a closed JSON Schema subset (rule), values and whether the rule admits them; rows where the independent Ajv verdict is the opposite are marked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contracts"],
  "properties": {
    "version": { "const": 1 },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "contract", "values"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "contract": { "type": "object" },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "object", "additionalProperties": false, "required": ["value", "accepted"], "properties": { "value": {}, "accepted": { "type": "boolean" }, "ajv": { "const": "differs" } } }
          }
        }
      }
    }
  }
}
