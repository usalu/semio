  {
   "name": "two patches keep the authored order",
   "recipe": {
    "name": "tools",
    "private": true,
    "packageManager": "bun@1.3.14",
    "dependencies": {},
    "semio": {
     "toolPatches": {
      "b@1.0.0": "patches/b.patch",
      "a@1.0.0": "patches/a.patch"
     }
    }
   },
   "lock": {
    "patchedDependencies": {
     "b@1.0.0": "patches/b.patch",
     "a@1.0.0": "patches/a.patch"
    }
   },
   "sources": {
    "patches/a.patch": "diff --git a/index.js b/index.js\n--- a/index.js\n+++ b/index.js\n@@ -1,2 +1,2 @@\n keep\n-old\n+new\n",
    "patches/b.patch": "diff --git a/a.js b/a.js\n--- a/a.js\n+++ b/a.js\n@@ -1 +1 @@\n-x\n+y\ndiff --git a/lib/b.js b/lib/b.js\n--- a/lib/b.js\n+++ b/lib/b.js\n@@ -2,1 +2,2 @@\n z\n+w\n"
   }
  },
