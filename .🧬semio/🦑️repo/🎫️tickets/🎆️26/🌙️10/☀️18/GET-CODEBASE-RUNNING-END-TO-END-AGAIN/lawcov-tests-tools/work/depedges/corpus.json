     "b/x.ts"
    ]
   },
   "project": "p",
   "preferred": "a/x.ts",
   "expected": "a/x.ts"
  },
  {
   "name": "a moved file is found by its base name",
   "files": [
    "b/x.ts"
   ],
   "map": {
    "p": [
     "a/x.ts",
     "b/x.ts"
    ]
   },
   "project": "p",
   "preferred": "a/x.ts",
   "expected": "b/x.ts"
  },
  {
   "name": "two existing candidates keep the preferred path",
   "files": [
    "b/x.ts",
    "c/x.ts"
   ],
   "map": {
    "p": [
     "b/x.ts",
     "c/x.ts"
    ]
   },
   "project": "p",
   "preferred": "a/x.ts",
   "expected": "a/x.ts"
  },
  {
   "name": "a candidate that does not exist does not count",
   "files": [
    "c/x.ts"
   ],
   "map": {
    "p": [
     "b/x.ts",
     "c/x.ts"
    ]
   },
   "project": "p",
   "preferred": "a/x.ts",
   "expected": "c/x.ts"
  },
  {
   "name": "without a file map the preferred path stays",
   "files": [
    "c/x.ts"
   ],
   "map": null,
   "project": "p",
   "preferred": "a/x.ts",
   "expected": "a/x.ts"
  },
  {
   "name": "a project missing from the map keeps the preferred path",
   "files": [
    "c/x.ts"
   ],
   "map": {
    "q": [
     "c/x.ts"
    ]
   },
   "project": "p",
   "preferred": "a/x.ts",
   "expected": "a/x.ts"
  },
  {
   "name": "an empty file list keeps the preferred path",
   "files": [
    "c/x.ts"
   ],
   "map": {
    "p": []
   },
   "project": "p",
   "preferred": "a/x.ts",
   "expected": "a/x.ts"
  },
  {
   "name": "an explicit hint selects another base name",
   "files": [
