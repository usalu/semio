{
 "version": 1,
 "workspaceRoot": "/ws",
 "inputs": [
  {
   "name": "patterns only",
   "contract": {
    "inputPatterns": [
     "a/*.json",
     "b/c.ts"
    ]
   },
   "expected": {
    "inputs": [
     "{workspaceRoot}/a/*.json",
     "{workspaceRoot}/b/c.ts"
    ],
    "dependsOn": []
   }
  },
  {
   "name": "no patterns",
   "contract": {
    "inputPatterns": []
   },
   "expected": {
    "inputs": [],
    "dependsOn": []
   }
  },
  {
   "name": "a discovery kind adds the fingerprint output and its producer",
   "contract": {
    "inputPatterns": [
     "x"
    ],
    "inputDiscovery": {
     "kind": "registry-catalog"
    }
   },
   "fingerprint": "registry-catalog"
  },
  {
   "name": "an unknown discovery kind is refused",
   "contract": {
    "inputPatterns": [],
    "inputDiscovery": {
     "kind": "nope"
    }
   },
   "error": "Generator input discovery has no fingerprint owner: nope"
  },
  {
   "name": "an inherited object member is not a discovery kind",
   "contract": {
    "inputPatterns": [],
    "inputDiscovery": {
     "kind": "toString"
    }
   },
   "error": "Generator input discovery has no fingerprint owner: toString"
  },
  {
   "name": "a constructor is not a discovery kind",
   "contract": {
    "inputPatterns": [
     "x"
    ],
    "inputDiscovery": {
     "kind": "constructor"
    }
   },
   "error": "Generator input discovery has no fingerprint owner: constructor"
  }
 ],
 "owners": [
  {
   "name": "an owned contract maps its outputs to its own target",
   "root": "r",
   "project": "p",
   "targets": [
    "gen"
   ],
   "contracts": {
    "c": {
     "ownership": "owned",
     "ownerPath": "r",
     "target": "p:gen",
     "outputRoots": [
      {
       "path": "a/x"
      },
      {
       "path": "a/y"
      }
     ]
    }
   },
   "expected": [
    [
     "p:gen",
     [
      "{workspaceRoot}/a/x",
      "{workspaceRoot}/a/y"
     ]
    ]
   ]
  },
  {
   "name": "a contract of another root maps nothing",
   "root": "r",
   "project": "p",
   "targets": [
    "gen"
   ],
   "contracts": {
    "c": {
     "ownership": "owned",
     "ownerPath": "s",
     "target": "p:gen",
     "outputRoots": [
      {
       "path": "a/x"
      }
     ]
    }
   },
   "expected": []
  },
  {
   "name": "a contract that is not owned is skipped",
   "root": "r",
   "project": "p",
   "targets": [
    "gen"
   ],
   "contracts": {
    "c": {
     "ownership": "external",
     "ownerPath": "r",
     "target": "p:gen",
     "outputRoots": [
      {
       "path": "a/x"
      }
     ]
    }
   },
   "expected": []
  },
  {
   "name": "a contract of this root without outputs keeps its entry point",
   "root": "r",
   "project": "p",
   "targets": [
    "gen"
   ],
   "contracts": {
    "c": {
     "ownership": "owned",
     "ownerPath": "r",
     "target": "p:gen",
     "outputRoots": []
    }
   },
   "expected": [
    [
     "p:gen",
     []
    ]
   ]
  },
  {
   "name": "an output with a producer of this root goes to that producer",
   "root": "r",
   "project": "p",
   "targets": [
    "gen",
    "build"
   ],
   "contracts": {
    "c": {
     "ownership": "owned",
     "ownerPath": "s",
     "target": "q:gen",
     "outputRoots": [
      {
       "path": "a/x",
       "producer": {
        "ownerPath": "r",
        "target": "p:build"
       }
      }
     ]
    }
   },
   "expected": [
    [
     "p:build",
     [
      "{workspaceRoot}/a/x"
     ]
    ]
   ]
  },
  {
   "name": "a producer of another root is left to its owner",
   "root": "r",
   "project": "p",
   "targets": [
    "gen"
   ],
   "contracts": {
    "c": {
     "ownership": "owned",
     "ownerPath": "r",
     "target": "p:gen",
     "outputRoots": [
      {
       "path": "a/x",
       "producer": {
        "ownerPath": "s",
        "target": "q:build"
       }
      },
      {
       "path": "a/y"
      }
     ]
    }
   },
   "expected": [
    [
     "p:gen",
     [
      "{workspaceRoot}/a/y"
     ]
    ]
   ]
  },
  {
   "name": "two contracts for one target append in order and keep the first entry",
   "root": "r",
   "project": "p",
   "targets": [
    "gen"
   ],
   "contracts": {
    "c1": {
     "ownership": "owned",
     "ownerPath": "r",
     "target": "p:gen",
     "outputRoots": [
      {
       "path": "a/1"
      }
     ]
    },
    "c2": {
     "ownership": "owned",
     "ownerPath": "r",
     "target": "p:gen",
     "outputRoots": [
      {
       "path": "a/2"
      }
     ]
    }
   },
   "expected": [
    [
     "p:gen",
     [
      "{workspaceRoot}/a/1",
      "{workspaceRoot}/a/2"
     ]
    ]
   ]
  },
  {
   "name": "a producer target missing from the project is refused",
   "root": "r",
   "project": "p",
   "targets": [
    "gen"
   ],
   "contracts": {
    "c": {
     "ownership": "owned",
     "ownerPath": "r",
     "target": "p:gen",
     "outputRoots": [
      {
       "path": "a/x",
       "producer": {
        "ownerPath": "r",
        "target": "p:nothing"
       }
      }
     ]
    }
   },
   "error": "Generator output has no Build producer: a/x"
  },
  {
   "name": "a producer of another project is refused",
   "root": "r",
   "project": "p",
   "targets": [
    "gen"
   ],
   "contracts": {
    "c": {
     "ownership": "owned",
     "ownerPath": "r",
     "target": "p:gen",
     "outputRoots": [
      {
       "path": "a/z",
       "producer": {
        "ownerPath": "r",
        "target": "q:gen"
       }
      }
     ]
    }
   },
   "error": "Generator output has no Build producer: a/z"
  },
  {
   "name": "a producer name that only shares the project prefix is refused",
   "root": "r",
   "project": "p",
   "targets": [
    "gen"
   ],
   "contracts": {
    "c": {
     "ownership": "owned",
     "ownerPath": "r",
     "target": "pp:gen",
     "outputRoots": [
      {
       "path": "a/w"
      }
     ]
    }
   },
   "error": "Generator output has no Build producer: a/w"
  },
  {
   "name": "an own target missing from the project is refused",
   "root": "r",
   "project": "p",
   "targets": [],
   "contracts": {
    "c": {
     "ownership": "owned",
     "ownerPath": "r",
     "target": "p:gen",
     "outputRoots": [
      {
       "path": "a/v"
      }
     ]
    }
   },
   "error": "Generator output has no Build producer: a/v"
  }
 ],
 "paths": [
  {
   "output": "{projectRoot}/a/b",
   "root": "pkg/x",
   "expected": "/ws/pkg/x/a/b"
  },
  {
   "output": "{workspaceRoot}/a",
   "root": "pkg",
   "expected": "/ws/a"
  },
  {
   "output": "rel/path",
   "root": "pkg",
   "expected": null
  },
  {
   "output": "{projectRoot}",
   "root": "pkg",
   "expected": null
  },
  {
   "output": "{workspaceRoot}",
   "root": "pkg",
   "expected": null
  },
  {
   "output": "/abs/path",
   "root": "pkg",
   "expected": null
  },
  {
   "output": "{projectRoot}/../y",
   "root": "pkg",
   "expected": "/ws/y"
  },
  {
   "output": "{projectRoot}/x",
   "root": ".",
   "expected": "/ws/x"
  },
  {
   "output": "{workspaceRoot}/{projectRoot}/z",
   "root": "pkg",
   "expected": "/ws/pkg/z"
  },
  {
   "output": "{projectRoot}/x/{projectRoot}",
   "root": "pkg",
   "expected": "/ws/pkg/x/{projectRoot}"
  },
  {
   "output": "{projectRoot}/x",
   "root": "a$&b",
   "expected": "/ws/a$&b/x"
  },
  {
   "output": "{projectRoot}/x",
   "root": "a$'b",
   "expected": "/ws/a$'b/x"
  },
  {
   "output": "{projectRoot}/x",
   "root": "a$$b",
   "expected": "/ws/a$$b/x"
  },
  {
   "output": "{workspaceRoot}/a/../../outside",
   "root": "pkg",
   "expected": "/outside"
  },
  {
   "output": "{projectRoot}/é/📜️script.ts",
   "root": "pkg",
   "expected": "/ws/pkg/é/📜️script.ts"
  },
  {
   "output": "{projectRoot}//a///b/",
   "root": "pkg",
   "expected": "/ws/pkg/a/b"
  },
  {
   "output": "{Projectroot}/a",
   "root": "pkg",
   "expected": null
  }
 ],
 "couplings": [
  {
   "name": "a build target is not coupled",
   "target": "build",
   "targets": {
    "generate": {
     "outputs": [
      "{projectRoot}/o"
     ]
    }
   },
   "root": "pkg",
   "expected": []
  },
  {
   "name": "a check target is coupled to the output of a generate sibling",
   "target": "check",
   "targets": {
    "generate": {
     "outputs": [
      "{projectRoot}/o"
     ]
    }
   },
   "root": "pkg",
   "expected": [
    "/ws/pkg/o"
   ]
  },
  {
   "name": "a check-prefixed target is coupled",
   "target": "check-docs",
   "targets": {
    "generate-docs": {
     "outputs": [
      "{workspaceRoot}/d"
     ]
    }
   },
   "root": "pkg",
   "expected": [
    "/ws/d"
   ]
  },
  {
   "name": "a name that only starts with check is not coupled",
   "target": "checks",
   "targets": {
    "generate": {
     "outputs": [
      "{projectRoot}/o"
     ]
    }
   },
   "root": "pkg",
   "expected": []
  },
  {
   "name": "recheck is not coupled",
   "target": "recheck",
   "targets": {
    "generate": {
     "outputs": [
      "{projectRoot}/o"
     ]
    }
   },
   "root": "pkg",
   "expected": []
  },
  {
   "name": "generator and regenerate are not generate siblings",
   "target": "check",
   "targets": {
    "generator": {
     "outputs": [
      "{projectRoot}/a"
     ]
    },
    "regenerate": {
     "outputs": [
      "{projectRoot}/b"
     ]
    },
    "generates": {
     "outputs": [
      "{projectRoot}/c"
     ]
    }
   },
   "root": "pkg",
   "expected": []
  },
  {
   "name": "siblings contribute in declaration order",
   "target": "check",
   "targets": {
    "generate-b": {
     "outputs": [
      "{projectRoot}/b"
     ]
    },
    "generate-a": {
     "outputs": [
      "{projectRoot}/a",
      "{workspaceRoot}/w"
     ]
    }
   },
   "root": "pkg",
   "expected": [
    "/ws/pkg/b",
    "/ws/pkg/a",
    "/ws/w"
   ]
  },
  {
   "name": "outputs of an unrecognized shape and siblings without outputs are ignored",
   "target": "check",
   "targets": {
    "generate": {
     "outputs": [
      "rel/o",
      "{projectRoot}/ok"
     ]
    },
    "generate-x": {}
   },
   "root": "pkg",
   "expected": [
    "/ws/pkg/ok"
   ]
  },
  {
   "name": "a digest already authored for the same path is not repeated",
   "target": "check",
   "targets": {
    "generate": {
     "outputs": [
      "{projectRoot}/o",
      "{projectRoot}/p"
     ]
    }
   },
   "root": "pkg",
   "authored": [
    "/ws/pkg/o"
   ],
   "expected": [
    "/ws/pkg/p"
   ]
  },
  {
   "name": "the same output named twice is digested once",
   "target": "check",
   "targets": {
    "generate": {
     "outputs": [
      "{projectRoot}/o",
      "{projectRoot}/o"
     ]
    },
    "generate-b": {
     "outputs": [
      "{projectRoot}/o"
     ]
    }
   },
   "root": "pkg",
   "expected": [
    "/ws/pkg/o"
   ]
  },
  {
   "name": "string and unrelated authored inputs do not count as digests",
   "target": "check",
   "targets": {
    "generate": {
     "outputs": [
      "{projectRoot}/o"
     ]
    }
   },
   "root": "pkg",
   "authoredOther": [
    "x",
    {
     "dependentTasksOutputFiles": "y"
    },
    {
     "runtime": 5
    }
   ],
   "expected": [
    "/ws/pkg/o"
   ]
  },
  {
   "name": "the target itself is never its own sibling",
   "target": "check",
   "targets": {
    "check": {
     "outputs": [
      "{projectRoot}/o"
     ]
    }
   },
   "root": "pkg",
   "expected": []
  }
 ],
 "digests": [
  {
   "name": "a missing root digests like nothing",
   "path": "missing",
   "files": {},
   "expected": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  },
  {
   "name": "an empty directory digests like nothing",
   "path": "d",
   "files": {},
   "directories": [
    "d"
   ],
   "expected": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  },
  {
   "name": "one file",
   "path": "d",
   "files": {
    "d/a.txt": "hello"
   },
   "expected": "83eb0df169264277633baff1a9f594717691a83c07501eb1e7fa7325c1bc0584"
  },
  {
   "name": "a root that is itself a file",
   "path": "f.txt",
   "files": {
    "f.txt": "alone"
   },
   "expected": "e5d3f4b4055ace44eea97ebf561dcf66216957d31866fa5501aed52608781f0a"
  },
  {
   "name": "directory entries are visited in sorted order",
   "path": "d",
   "files": {
    "d/c": "2",
    "d/a": "1",
    "d/B": "0",
    "d/_": "u",
    "d/10": "x",
    "d/9": "y"
   },
   "expected": "04ac57cb78b488f6dfc6315ed5687cdfb3b5b0675f67bb47f603ad23be5cc41c"
  },
  {
   "name": "nested directories are walked depth first in name order",
   "path": "d",
   "files": {
    "d/z/1": "z1",
    "d/a/2": "a2",
    "d/a/1": "a1",
    "d/m": "m"
   },
   "expected": "bc2800309e3cfad3933b2f1c00fffbf4183baab1ac7f3b355df621a085e3c038"
  },
  {
   "name": "names with a slash joiner are separated from content by a NUL",
   "path": "d",
   "files": {
    "d/a": "b\u0000c",
    "d/ab": "c"
   },
   "expected": "777ec73d1bbafb9feebca6a8226c7c2e232b30a7091311c85afeca677c8c2006"
  },
  {
   "name": "unicode names and content",
   "path": "d",
   "files": {
    "d/é.txt": "ünï",
    "d/日本.txt": "語",
    "d/emoji😀.txt": "🙂"
   },
   "expected": "945c611d3f205790e7d9893d2b275db1e34a87b9c5d1528ea5164a99947cba25"
  },
  {
   "name": "binary looking content",
   "path": "d",
   "files": {
    "d/x": "\u0001\u0002"
   },
   "expected": "d41ee607225154adcbcc60ce5dd0a931c4a652a7c9393ff12b8122daa14a49b9"
  },
  {
   "name": "a symbolic link is not part of the digest",
   "path": "d",
   "files": {
    "d/a": "1"
   },
   "links": {
    "d/l": "a",
    "d/dl": "../elsewhere"
   },
   "expected": "05a9c569a185ac60f5511f9760bc3f1ac046b20d18db2ad4d8fa86eda4f5b28e"
  },
  {
   "name": "an empty file still contributes its name",
   "path": "d",
   "files": {
    "d/empty": "",
    "d/other": "o"
   },
   "expected": "e726ea21e0043c37e8f74c877ea63fb5e0bfc292881c20e0e340ccb811247baf"
  },
  {
   "name": "a trailing difference changes the digest",
   "path": "d",
   "files": {
    "d/a": "hello "
   },
   "expected": "166cc285e8e555bef3a0d90d0ef6b9c3002a28ebb06ab493035de6bc9f58ca92"
  }
 ]
}