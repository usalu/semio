{
 "version": 1,
 "workspaceRoot": "ws",
 "dependencies": [
  {
   "name": "a path dependency",
   "toml": "[dependencies]\nb = { path = \"../b\" }\n",
   "workspace": {},
   "expected": [
    {
     "name": "b",
     "path": "../b",
     "workspace": false,
     "kind": "dependencies"
    }
   ]
  },
  {
   "name": "a registry dependency has no path",
   "toml": "[dependencies]\nserde = \"1\"\nrand = { version = \"0.8\" }\n",
   "workspace": {},
   "expected": []
  },
  {
   "name": "a renamed dependency reports the package name",
   "toml": "[dependencies]\nalias = { path = \"../real\", package = \"real-crate\" }\n",
   "workspace": {},
   "expected": [
    {
     "name": "real-crate",
     "path": "../real",
     "workspace": false,
     "kind": "dependencies"
    }
   ]
  },
  {
   "name": "build and dev dependencies are reported by kind in table order",
   "toml": "[dev-dependencies]\nd = { path = \"../d\" }\n[build-dependencies]\nb = { path = \"../b\" }\n[dependencies]\na = { path = \"../a\" }\n",
   "workspace": {},
   "expected": [
    {
     "name": "a",
     "path": "../a",
     "workspace": false,
     "kind": "dependencies"
    },
    {
     "name": "b",
     "path": "../b",
     "workspace": false,
     "kind": "build-dependencies"
    },
    {
     "name": "d",
     "path": "../d",
     "workspace": false,
     "kind": "dev-dependencies"
    }
   ]
  },
  {
   "name": "target tables are searched after the manifest tables",
   "toml": "[target.'cfg(unix)'.dependencies]\nu = { path = \"../u\" }\n[dependencies]\na = { path = \"../a\" }\n[target.'cfg(windows)'.dev-dependencies]\nw = { path = \"../w\" }\n",
   "workspace": {},
   "expected": [
    {
     "name": "a",
     "path": "../a",
     "workspace": false,
     "kind": "dependencies"
    },
    {
     "name": "u",
     "path": "../u",
     "workspace": false,
     "kind": "dependencies"
    },
    {
     "name": "w",
     "path": "../w",
     "workspace": false,
     "kind": "dev-dependencies"
    }
   ]
  },
  {
   "name": "an inherited dependency takes its path from the workspace",
   "toml": "[dependencies]\nx = { workspace = true }\n",
   "workspace": {
    "dependencies": {
     "x": {
      "path": "crates/x"
     }
    }
   },
   "expected": [
    {
     "name": "x",
     "path": "crates/x",
     "workspace": true,
     "kind": "dependencies"
    }
   ]
  },
  {
   "name": "an inherited dependency uses the workspace package name",
   "toml": "[dependencies]\nx = { workspace = true }\n",
   "workspace": {
    "dependencies": {
     "x": {
      "path": "crates/x",
      "package": "real-x"
     }
    }
   },
   "expected": [
    {
     "name": "real-x",
     "path": "crates/x",
     "workspace": true,
     "kind": "dependencies"
    }
   ]
  },
  {
   "name": "an inherited dependency without a workspace path is dropped",
   "toml": "[dependencies]\nx = { workspace = true }\ny = { workspace = true }\nz = { workspace = true }\n",
   "workspace": {
    "dependencies": {
     "x": "1.0",
     "y": {
      "version": "2"
     }
    }
   },
   "expected": []
  },
  {
   "name": "a workspace flag that is not true is a plain declaration",
   "toml": "[dependencies]\nx = { workspace = false, path = \"../x\" }\n",
   "workspace": {
    "dependencies": {
     "x": {
      "path": "elsewhere"
     }
    }
   },
   "expected": [
    {
     "name": "x",
     "path": "../x",
     "workspace": false,
     "kind": "dependencies"
    }
   ]
  },
  {
   "name": "a dependency with an inline table and features",
   "toml": "[dependencies]\nx = { path = \"../x\", features = [\"a\", \"b\"], default-features = false, optional = true }\n",
   "workspace": {},
   "expected": [
    {
     "name": "x",
     "path": "../x",
     "workspace": false,
     "kind": "dependencies"
    }
   ]
  },
  {
   "name": "a dependency written as its own table",
   "toml": "[dependencies.x]\npath = \"../x\"\nversion = \"0.1\"\n",
   "workspace": {},
   "expected": [
    {
     "name": "x",
     "path": "../x",
     "workspace": false,
     "kind": "dependencies"
    }
   ]
  },
  {
   "name": "several dependencies keep declaration order",
   "toml": "[dependencies]\nz = { path = \"../z\" }\na = { path = \"../a\" }\nm = { path = \"../m\" }\n",
   "workspace": {},
   "expected": [
    {
     "name": "z",
     "path": "../z",
     "workspace": false,
     "kind": "dependencies"
    },
    {
     "name": "a",
     "path": "../a",
     "workspace": false,
     "kind": "dependencies"
    },
    {
     "name": "m",
     "path": "../m",
     "workspace": false,
     "kind": "dependencies"
    }
   ]
  },
  {
   "name": "a manifest without dependency tables",
   "toml": "[package]\nname = \"p\"\n",
   "workspace": {},
   "expected": []
  },
  {
   "name": "an empty path is not a path dependency",
   "toml": "[dependencies]\nx = { path = \"\" }\n",
   "workspace": {},
   "expected": []
  },
  {
   "name": "several target tables in order of appearance",
   "toml": "[target.'cfg(a)'.dependencies]\na = { path = \"../a\" }\n[target.'cfg(b)'.dependencies]\nb = { path = \"../b\" }\n[target.'cfg(a)'.build-dependencies]\nc = { path = \"../c\" }\n",
   "workspace": {},
   "expected": [
    {
     "name": "a",
     "path": "../a",
     "workspace": false,
     "kind": "dependencies"
    },
    {
     "name": "c",
     "path": "../c",
     "workspace": false,
     "kind": "build-dependencies"
    },
    {
     "name": "b",
     "path": "../b",
     "workspace": false,
     "kind": "dependencies"
    }
   ]
  }
 ],
 "workspaces": [
  {
   "name": "a crate that is itself a workspace root",
   "files": {
    "c/Cargo.toml": "[package]\nname = \"c\"\n[workspace]\nmembers = [\"x\"]\n"
   },
   "directory": "c",
   "root": "c",
   "declaration": {
    "members": [
     "x"
    ]
   }
  },
  {
   "name": "the nearest ancestor workspace",
   "files": {
    "Cargo.toml": "[workspace]\nmembers = [\"a\"]\n",
    "crates/a/Cargo.toml": "[package]\nname = \"p\"\n"
   },
   "directory": "crates/a",
   "root": ".",
   "declaration": {
    "members": [
     "a"
    ]
   }
  },
  {
   "name": "a nested workspace wins over the outer one",
   "files": {
    "Cargo.toml": "[workspace]\nmembers = [\"a\"]\n",
    "crates/Cargo.toml": "[workspace]\nmembers = [\"inner\"]\n",
    "crates/inner/Cargo.toml": "[package]\nname = \"p\"\n"
   },
   "directory": "crates/inner",
   "root": "crates",
   "declaration": {
    "members": [
     "inner"
    ]
   }
  },
  {
   "name": "ancestors without a workspace table are skipped",
   "files": {
    "Cargo.toml": "[workspace]\nmembers = [\"a\"]\n",
    "crates/Cargo.toml": "[package]\nname = \"p\"\n",
    "crates/a/Cargo.toml": "[package]\nname = \"p\"\n"
   },
   "directory": "crates/a",
   "root": ".",
   "declaration": {
    "members": [
     "a"
    ]
   }
  },
  {
   "name": "no workspace anywhere ends at the repository root",
   "files": {
    "crates/a/Cargo.toml": "[package]\nname = \"p\"\n"
   },
   "directory": "crates/a",
   "root": ".",
   "declaration": {}
  },
  {
   "name": "an explicit workspace key points at its root",
   "files": {
    "Cargo.toml": "[workspace]\nmembers = [\"a\"]\n",
    "other/ws/Cargo.toml": "[workspace]\nmembers = [\"m\"]\n",
    "crates/a/Cargo.toml": "[package]\nname = \"a\"\nworkspace = \"../../other/ws\"\n"
   },
   "directory": "crates/a",
   "root": "other/ws",
   "declaration": {
    "members": [
     "m"
    ]
   }
  },
  {
   "name": "an explicit workspace key to a directory without a workspace walks up from there",
   "files": {
    "Cargo.toml": "[workspace]\nmembers = [\"a\"]\n",
    "other/deep/Cargo.toml": "[package]\nname = \"p\"\n",
    "crates/a/Cargo.toml": "[package]\nname = \"a\"\nworkspace = \"../../other/deep\"\n"
   },
   "directory": "crates/a",
   "root": ".",
   "declaration": {
    "members": [
     "a"
    ]
   }
  },
  {
   "name": "a workspace key that leaves the repository is refused",
   "files": {
    "crates/a/Cargo.toml": "[package]\nname = \"a\"\nworkspace = \"../../../outside\"\n"
   },
   "directory": "crates/a",
   "error": "Native workspace escapes repository: {directory}"
  },
  {
   "name": "a workspace key to the parent of the repository is refused",
   "files": {
    "Cargo.toml": "[workspace]\nmembers = [\"a\"]\n",
    "a/Cargo.toml": "[package]\nname = \"a\"\nworkspace = \"../..\"\n"
   },
   "directory": "a",
   "error": "Native workspace escapes repository: {directory}"
  },
  {
   "name": "the repository root itself needs no manifest above it",
   "files": {
    "Cargo.toml": "[package]\nname = \"p\"\n"
   },
   "directory": ".",
   "root": ".",
   "declaration": {}
  },
  {
   "name": "a declaration carries the whole workspace table",
   "files": {
    "Cargo.toml": "[workspace]\nmembers = [\"a\", \"b/*\"]\nexclude = [\"c\"]\nresolver = \"2\"\n[workspace.dependencies]\nx = { path = \"crates/x\" }\n",
    "a/Cargo.toml": "[package]\nname = \"p\"\n"
   },
   "directory": "a",
   "root": ".",
   "declaration": {
    "members": [
     "a",
     "b/*"
    ],
    "exclude": [
     "c"
    ],
    "resolver": "2",
    "dependencies": {
     "x": {
      "path": "crates/x"
     }
    }
   }
  },
  {
   "name": "a crate without a manifest cannot be read",
   "files": {
    "Cargo.toml": "[workspace]\nmembers = [\"a\"]\n"
   },
   "directory": "missing",
   "error": "ENOENT"
  },
  {
   "name": "a workspace key with a trailing slash resolves like the plain path",
   "files": {
    "ws/Cargo.toml": "[workspace]\nmembers = [\"a\"]\n",
    "ws/a/Cargo.toml": "[package]\nname = \"a\"\nworkspace = \"../\"\n"
   },
   "directory": "ws/a",
   "root": "ws",
   "declaration": {
    "members": [
     "a"
    ]
   }
  }
 ],
 "go": [
  {
   "name": "a module with single and block requirements and replacements",
   "text": "module example.com/m\n\ngo 1.22\n\nrequire example.com/a v1.0.0\nrequire (\n\texample.com/b v1.2.3\n\texample.com/c v0.1.0 // indirect\n)\n\nreplace example.com/a => ../a\nreplace (\n\texample.com/b v1.2.3 => ./b\n\texample.com/c => example.com/fork v1.0.0\n)\n",
   "module": "example.com/m",
   "requires": [
    "example.com/a",
    "example.com/b",
    "example.com/c"
   ],
   "replacements": [
    {
     "module": "example.com/a",
     "path": "../a"
    },
    {
     "module": "example.com/b",
     "path": "./b"
    },
    {
     "module": "example.com/c",
     "path": "example.com/fork"
    }
   ]
  },
  {
   "name": "a quoted module path",
   "text": "module \"example.com/q\"\n\ngo 1.21\n",
   "module": "example.com/q",
   "requires": [],
   "replacements": []
  },
  {
   "name": "comments and blank lines",
   "text": "// header\nmodule example.com/m // trailing\n\n// note\nrequire example.com/a v1.0.0 // indirect\n\nrequire (\n\t// inside\n\texample.com/b v1.0.0\n\n)\n",
   "module": "example.com/m",
   "requires": [
    "example.com/a",
    "example.com/b"
   ],
   "replacements": []
  },
  {
   "name": "a replacement with versions on both sides",
   "text": "module m\n\nrequire example.com/a v1.0.0\nreplace example.com/a v1.0.0 => example.com/f v2.0.0\n",
   "module": "m",
   "requires": [
    "example.com/a"
   ],
   "replacements": [
    {
     "module": "example.com/a",
     "path": "example.com/f"
    }
   ]
  },
  {
   "name": "exclude, retract and toolchain lines are ignored",
   "text": "module m\n\ngo 1.22.0\ntoolchain go1.22.3\n\nexclude example.com/z v1.0.0\nexclude (\n\texample.com/y v1.0.0\n)\nretract v1.0.0\nretract (\n\tv1.1.0\n\t[v1.2.0, v1.3.0]\n)\nrequire example.com/a v1.0.0\n",
   "module": "m",
   "requires": [
    "example.com/a"
   ],
   "replacements": []
  },
  {
   "name": "Windows line ends",
   "text": "module example.com/m\r\n\r\nrequire (\r\n\texample.com/a v1.0.0\r\n)\r\nreplace example.com/a => ../a\r\n",
   "module": "example.com/m",
   "requires": [
    "example.com/a"
   ],
   "replacements": [
    {
     "module": "example.com/a",
     "path": "../a"
    }
   ]
  },
  {
   "name": "a replacement path with a comment",
   "text": "module m\nreplace example.com/a => ./a // local\n",
   "module": "m",
   "requires": [],
   "replacements": [
    {
     "module": "example.com/a",
     "path": "./a"
    }
   ]
  },
  {
   "name": "quoted requirements and replacements",
   "text": "module m\nrequire \"example.com/a\" v1.0.0\nreplace \"example.com/a\" => \"../a b\"\n",
   "module": "m",
   "requires": [
    "example.com/a"
   ],
   "replacements": [
    {
     "module": "example.com/a",
     "path": "../a b"
    }
   ]
  },
  {
   "name": "tools and godebug lines are ignored",
   "text": "module m\ngo 1.24\ngodebug default=go1.21\ntool example.com/cmd/x\nrequire example.com/a v1.0.0\n",
   "module": "m",
   "requires": [
    "example.com/a"
   ],
   "replacements": []
  },
  {
   "name": "a file without a module line",
   "text": "go 1.22\nrequire example.com/a v1.0.0\n",
   "module": "",
   "requires": [
    "example.com/a"
   ],
   "replacements": [],
   "noGo": true
  },
  {
   "name": "an empty file",
   "text": "",
   "module": "",
   "requires": [],
   "replacements": [],
   "noGo": true
  }
 ]
}