{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:generator-outputs-corpus:v1",
  "title": "Generator Outputs Corpus",
  "description": "Language-agnostic cases for the coupling of generator contracts to Build producers: contract inputs, output ownership, declared output paths, check/generate coupling and output-root digests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workspaceRoot", "inputs", "owners", "paths", "couplings", "digests"],
  "definitions": {
    "name": { "type": "string", "minLength": 1 },
    "strings": { "type": "array", "items": { "type": "string" } }
  },
  "properties": {
    "version": { "const": 1 },
    "workspaceRoot": { "type": "string", "pattern": "^/" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "contract"],
        "oneOf": [{ "required": ["expected"] }, { "required": ["fingerprint"] }, { "required": ["error"] }],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/definitions/name" },
          "contract": { "type": "object", "required": ["inputPatterns"], "properties": { "inputPatterns": { "$ref": "#/definitions/strings" }, "inputDiscovery": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string" } } } } },
          "expected": { "type": "object", "required": ["inputs", "dependsOn"] },
          "fingerprint": { "type": "string" },
          "error": { "type": "string", "minLength": 1 }
        }
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "root", "project", "targets", "contracts"],
        "oneOf": [{ "required": ["expected"] }, { "required": ["error"] }],
        "additionalProperties": false,
        "properties": {
          "name": { "$ref": "#/definitions/name" },
          "root": { "type": "string" },
          "project": { "type": "string" },
          "targets": { "$ref": "#/definitions/strings" },
          "contracts": { "type": "object", "additionalProperties": { "type": "object", "required": ["ownership", "ownerPath", "target", "outputRoots"] } },
          "expected": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": [{ "type": "string" }, { "$ref": "#/definitions/strings" }] } },
          "error": { "type": "string", "minLength": 1 }
        }
      }
    },
    "paths": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["output", "root", "expected"], "properties": { "output": { "type": "string" }, "root": { "type": "string" }, "expected": { "type": ["string", "null"] } } } },
    "couplings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "target", "targets", "root", "expected"], "properties": { "name": { "$ref": "#/definitions/name" }, "target": { "type": "string" }, "targets": { "type": "object" }, "root": { "type": "string" }, "authored": { "$ref": "#/definitions/strings" }, "authoredOther": { "type": "array" }, "expected": { "$ref": "#/definitions/strings" } } }
    },
    "digests": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "path", "files", "expected"], "properties": { "name": { "$ref": "#/definitions/name" }, "expected": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "path": { "type": "string", "minLength": 1 }, "files": { "type": "object", "additionalProperties": { "type": "string" } }, "directories": { "$ref": "#/definitions/strings" }, "links": { "type": "object", "additionalProperties": { "type": "string" } } } }
    }
  }
}
