{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:cargo-toml-boundary-corpus:v1",
  "title": "Cargo TOML Boundary Corpus",
  "description": "Language-agnostic TOML documents of the kind Cargo manifests use, with the value TOML 1.0 gives them (null for a document every conforming parser refuses) and whether the Bun TOML parser behind the build graph agrees.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "documents", "refusals"],
  "properties": {
    "version": { "const": 1 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "text", "expected", "bun"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "expected": { "type": ["object", "null"] },
          "bun": { "enum": ["same", "differs", "refuses"] }
        }
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "text", "line"], "properties": { "name": { "type": "string", "minLength": 1 }, "text": { "type": "string" }, "line": { "type": "integer", "minimum": 0 } } }
    }
  }
}
