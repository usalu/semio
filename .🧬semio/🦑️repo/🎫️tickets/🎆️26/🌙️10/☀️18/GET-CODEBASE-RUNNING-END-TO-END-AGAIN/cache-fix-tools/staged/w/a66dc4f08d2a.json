{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cache Correctness Rule Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "globs"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "records", "expect"],
        "properties": {
          "id": { "type": "string" },
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "root", "authoredCache", "target", "namedInputs"],
              "properties": {
                "id": { "type": "string" },
                "root": { "type": "string" },
                "authoredCache": { "type": ["boolean", "null"] },
                "target": { "type": "object" },
                "namedInputs": { "type": "object", "additionalProperties": { "type": "array" } }
              }
            }
          },
          "expect": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": [{ "type": "string" }, { "enum": ["unclassified-target", "authored-cache-overridden", "empty-inputs", "producer-without-outputs", "env-unhashed", "named-input-undeclared", "output-escapes", "output-overlap", "command-mutating", "command-network"] }]
            }
          }
        }
      }
    },
    "globs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "path", "match"],
        "properties": { "pattern": { "type": "string" }, "path": { "type": "string" }, "match": { "type": "boolean" } }
      }
    }
  }
}
