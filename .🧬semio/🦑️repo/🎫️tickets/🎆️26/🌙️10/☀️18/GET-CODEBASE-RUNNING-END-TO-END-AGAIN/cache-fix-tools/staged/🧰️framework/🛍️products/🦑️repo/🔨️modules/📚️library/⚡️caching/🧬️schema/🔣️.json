{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/library/caching/schema.json",
  "title": "NxCachePolicy",
  "$defs": {},
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "uncached",
    "uncachedExact",
    "cachedExact",
    "targetClasses",
    "continuous",
    "generatedDirectories",
    "toolchains",
    "generatorInputs",
    "storage",
    "manifestBasenames"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "uncached": {
      "description": "Target families that never replay: the name itself and every `<name>-…` variant.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "uncachedExact": {
      "description": "Target names that never replay while their `<name>-…` variants stay cacheable (e.g. `format` vs `format-check`, `os` vs `os-*`).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cachedExact": {
      "description": "Target names verified deterministic whose name merely collides with the mutating/live name heuristics (e.g. a domain term like `live-catalog`); they replay with their declared outputs.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "targetClasses": {
      "description": "Ordered, closed classification of target names into cache classes; a leading emoji or other symbol prefix never hides a name from its row. A row that lists the name in `exact` decides before any head, tail or token of any row, then the first row with a matching head (`<head>` or `<head>-…`), tail (`<tail>` or `…-<tail>`) or token (a hyphen-delimited segment) decides. Only `deterministic` rows replay; a target no row, declaration or verifying command classifies is `unclassified` and never replays.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision"],
        "properties": {
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "reason"],
            "properties": { "class": { "type": "string" }, "reason": { "type": "string" } }
          },
          "exact": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "uniqueItems": true },
          "heads": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "uniqueItems": true },
          "tails": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "uniqueItems": true },
          "tokens": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "uniqueItems": true }
        },
        "anyOf": [{ "required": ["exact"] }, { "required": ["heads"] }, { "required": ["tails"] }, { "required": ["tokens"] }]
      }
    },
    "continuous": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "serialTargets": {
      "description": "Nx target names that must keep parallelism:false because they mutate shared toolchain stores.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "ephemeralOwnerGlobs": {
      "description": "Glob segments under each Cargo plugin owner root excluded from nativeSources (descriptor staging temps, etc.).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "generatedDirectories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files",
          "environment",
          "commands"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "targetDefaults": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "generatorInputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "output"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^\\S+:\\S+$"
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:*?{}\\[\\]\\u0000]).+$"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pressure",
        "guardAgeMs",
        "cargo",
        "vite",
        "agents",
        "tests",
        "strictStorage",
        "sourceBoundary"
      ],
      "properties": {
        "pressure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "minimumAvailableBytes",
            "targetAvailableBytes",
            "guardAgeMs",
            "maximumDeletionBytes"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "minimumAvailableBytes": {
              "type": "integer",
              "minimum": 1
            },
            "targetAvailableBytes": {
              "type": "integer",
              "minimum": 1
            },
            "guardAgeMs": {
              "type": "integer",
              "minimum": 1
            },
            "maximumDeletionBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "guardAgeMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "cargo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "budgetBytes",
            "unusedAgeMs",
            "incremental"
          ],
          "properties": {
            "budgetBytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "unusedAgeMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "incremental": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "budgetBytes",
                "unusedAgeMs",
                "guardAgeMs"
              ],
              "properties": {
                "budgetBytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "unusedAgeMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "guardAgeMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        "vite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unusedAgeMs"
          ],
          "properties": {
            "unusedAgeMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unusedAgeMs"
          ],
          "properties": {
            "unusedAgeMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unusedAgeMs"
          ],
          "properties": {
            "unusedAgeMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        },
        "strictStorage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "directory",
            "capacityBytes",
            "filesystemBytes",
            "maximumWorkspaceBytes",
            "maximumArtifactBytes"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "directory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:*?{}\\[\\]\\u0000]).+$"
            },
            "capacityBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "filesystemBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximumWorkspaceBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximumArtifactBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "sourceBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "maxSourceBytes",
            "maxSourceFiles",
            "maxActiveLines"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "maxSourceBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "maxSourceFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maxActiveLines": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4000
            }
          }
        }
      }
    },
    "manifestBasenames": {
      "const": [
        "📋️project.json",
        "project.json",
        "package.json",
        "Cargo.toml",
        "bun.lock",
        "*.patch"
      ]
    }
  }
}
