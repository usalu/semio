{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "entrySuffix": ".fetched.json",
        "stageSuffix": ".stage",
        "maximumLocks": 64,
        "maximumLockBytes": 4194304,
        "maximumRegistryEntries": 512,
        "maximumReceiptBytes": 262144,
        "registryDirectories": ["registry/cache", "registry/src"]
      }
    },
    "Stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "dev", "ino", "mtimeNs"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "dev": {"type": "string", "pattern": "^[0-9]+$"},
        "ino": {"type": "string", "pattern": "^[0-9]+$"},
        "mtimeNs": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request", "locks", "registry"],
      "properties": {
        "version": {"const": 1},
        "request": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "locks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest", "bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 256},
              "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "bytes": {"type": "integer", "minimum": 0, "maximum": 4194304}
            }
          }
        },
        "registry": {"type": "array", "maxItems": 512, "items": {"$ref": "#/definitions/Stamp"}}
      }
    }
  }
}
