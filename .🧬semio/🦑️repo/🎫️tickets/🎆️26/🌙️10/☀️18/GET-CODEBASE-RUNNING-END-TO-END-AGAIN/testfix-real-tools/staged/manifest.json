     "old": "fn optional_field_sparse_changes_and_inverse_preserve_original_sources(){let fixture:serde_json::Value=serde_json::from_str(fixture_text!(\"../../🪡️field/🟰️change/🧪️tests/🧫️fixtures/🔣️.json\")).unwrap();for row in fixture[\"cases\"].as_array().unwrap(){let mut authored=source(nullable(&row[\"authored\"]));let mut original=source(nullable(&row[\"original\"]));let pointer=original.borrow().get().as_ref().map(|text|text.as_ptr());let(mut field,heap)=observe_heap(RetainedFieldChange::<Option<String>>::default);assert_eq!(heap,(0,0));let mut turns=0;while !field.ready(){let g=grant(field.decision_demand(authored.borrow(),original.borrow(),257).unwrap());assert_eq!(field.decide(authored.borrow(),original.borrow(),RetainedCloneGrant{maximum_items:0,..g}).unwrap().progress(),Default::default());assert!(field.decide(authored.borrow(),original.borrow(),g).unwrap().progress().fits(g));assert!({turns+=1;turns}<100000);}let g=grant(field.decision_demand(authored.borrow(),original.borrow(),257).unwrap());let(change,p)=field.take_change(g).unwrap().unwrap();assert!(p.fits(g));assert_eq!(change.is_none(),row[\"unchanged\"].as_bool().unwrap());if let Some(change)=change.as_ref(){assert_eq!(change,&nullable(&row[\"change\"]));}while !field.inverse_ready(){let g=grant(field.inverse_demand(original.borrow(),257).unwrap());assert!(field.inverse(original.borrow(),g).unwrap().progress().fits(g));assert!({turns+=1;turns}<100000);}let g=grant(field.inverse_take_demand().unwrap());let(inverse,p)=field.take_inverse(g).unwrap().unwrap();assert!(p.fits(g));assert_eq!(inverse,nullable(&row[\"inverse\"]));close(&mut field);assert_eq!(original.borrow().get().as_ref().map(|text|text.as_ptr()),pointer);assert_eq!(observe_heap(||drop(field)).1,(0,0));drain(change);drain(inverse);close_source(&mut authored);close_source(&mut original);eprintln!(\"[DEBUG] Optional original {:?} exact sparse clear/set/no-op and inverse custody passed\",row[\"id\"]);}}",
