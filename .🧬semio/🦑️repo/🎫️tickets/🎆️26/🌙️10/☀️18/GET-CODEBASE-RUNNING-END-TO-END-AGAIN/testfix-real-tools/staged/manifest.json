     "old": "fn typed_field_changes_plain_text_bytes_and_ieee_preserve_original_children(){let fixture:serde_json::Value=serde_json::from_str(fixture_text!(\"../../🪡️field/🟰️change/🧪️tests/🧫️fixtures/🔣️.json\")).unwrap();for row in fixture[\"plainCases\"].as_array().unwrap(){for cut in fixture[\"cancelCuts\"].as_array().unwrap().iter().map(|cut|Some(cut.as_u64().unwrap()as usize)).chain(std::iter::once(None)){let same=row[\"unchanged\"].as_bool().unwrap();match row[\"type\"].as_str().unwrap(){\"text\"=>exercise_plain(row[\"authored\"].as_str().unwrap().to_owned(),row[\"original\"].as_str().unwrap().to_owned(),same,cut,|a,b|a==b),\"bytes\"=>{let bytes=|v:&serde_json::Value|v.as_array().unwrap().iter().map(|v|v.as_u64().unwrap()as u8).collect::<Vec<_>>();exercise_plain(bytes(&row[\"authored\"]),bytes(&row[\"original\"]),same,cut,|a,b|a==b)},\"f64\"=>{let number=|v:&serde_json::Value|if v==\"nan\"{f64::NAN}else{v.as_str().unwrap().parse::<f64>().unwrap()};exercise_plain(number(&row[\"authored\"]),number(&row[\"original\"]),same,cut,|a,b|a.to_bits()==b.to_bits());},_=>unreachable!()}eprintln!(\"[DEBUG] Generic field {:?} exact plain typed output/inverse and original child custody cut={cut:?}\",row[\"id\"]);}}}",
     "new": "fn typed_field_changes_plain_text_bytes_and_ieee_preserve_original_children(){let fixture:serde_json::Value=serde_json::from_str(fixture_text!(\"../../../🪡️field/🟰️change/🧪️tests/🧫️fixtures/🔣️.json\")).unwrap();for row in fixture[\"plainCases\"].as_array().unwrap(){for cut in fixture[\"cancelCuts\"].as_array().unwrap().iter().map(|cut|Some(cut.as_u64().unwrap()as usize)).chain(std::iter::once(None)){let same=row[\"unchanged\"].as_bool().unwrap();match row[\"type\"].as_str().unwrap(){\"text\"=>exercise_plain(row[\"authored\"].as_str().unwrap().to_owned(),row[\"original\"].as_str().unwrap().to_owned(),same,cut,|a,b|a==b),\"bytes\"=>{let bytes=|v:&serde_json::Value|v.as_array().unwrap().iter().map(|v|v.as_u64().unwrap()as u8).collect::<Vec<_>>();exercise_plain(bytes(&row[\"authored\"]),bytes(&row[\"original\"]),same,cut,|a,b|a==b)},\"f64\"=>{let number=|v:&serde_json::Value|if v==\"nan\"{f64::NAN}else{v.as_str().unwrap().parse::<f64>().unwrap()};exercise_plain(number(&row[\"authored\"]),number(&row[\"original\"]),same,cut,|a,b|a.to_bits()==b.to_bits());},_=>unreachable!()}eprintln!(\"[DEBUG] Generic field {:?} exact plain typed output/inverse and original child custody cut={cut:?}\",row[\"id\"]);}}}"
    },
    {
     "old": "fn optional_field_partial_cancellation_and_foreign_sources_remain_owned(){let fixture:serde_json::Value=serde_json::from_str(fixture_text!(\"../../🪡️field/🟰️change/🧪️tests/🧫️fixtures/🔣️.json\")).unwrap();for row in fixture[\"cases\"].as_array().unwrap(){for cut in fixture[\"cancelCuts\"].as_array().unwrap().iter().map(|cut|cut.as_u64().unwrap()as usize){let mut a=source(nullable(&row[\"authored\"]));let mut b=source(nullable(&row[\"original\"]));let mut foreign=source(nullable(&row[\"authored\"]));let pointer=b.borrow().get().as_ref().map(|text|text.as_ptr());let mut p=RetainedFieldChange::<Option<String>>::default();let mut turns=0;while !p.ready()&&turns<cut{let g=grant(p.decision_demand(a.borrow(),b.borrow(),257).unwrap());assert!(p.decide(a.borrow(),b.borrow(),g).unwrap().progress().fits(g));turns+=1;}if turns>0{assert!(p.equality.verify(foreign.borrow(),b.borrow()).is_err());}let mut change=None;let mut inverse=None;if p.ready()&&turns<cut{let g=grant(p.decision_demand(a.borrow(),b.borrow(),257).unwrap());change=Some(p.take_change(g).unwrap().unwrap().0);turns+=1;while !p.inverse_ready()&&turns<cut{let g=grant(p.inverse_demand(b.borrow(),257).unwrap());assert!(p.inverse(b.borrow(),g).unwrap().progress().fits(g));turns+=1;}if p.inverse_ready()&&turns<cut{inverse=Some(p.take_inverse(grant(p.inverse_take_demand().unwrap())).unwrap().unwrap().0);}}close(&mut p);assert_eq!(b.borrow().get().as_ref().map(|text|text.as_ptr()),pointer);drain(change);drain(inverse);close_source(&mut a);close_source(&mut b);close_source(&mut foreign);eprintln!(\"[DEBUG] Optional original {:?} cancellation cut={cut} source/payload child custody closes under original grants\",row[\"id\"]);}}",
     "new": "fn optional_field_partial_cancellation_and_foreign_sources_remain_owned(){let fixture:serde_json::Value=serde_json::from_str(fixture_text!(\"../../../🪡️field/🟰️change/🧪️tests/🧫️fixtures/🔣️.json\")).unwrap();for row in fixture[\"cases\"].as_array().unwrap(){for cut in fixture[\"cancelCuts\"].as_array().unwrap().iter().map(|cut|cut.as_u64().unwrap()as usize){let mut a=source(nullable(&row[\"authored\"]));let mut b=source(nullable(&row[\"original\"]));let mut foreign=source(nullable(&row[\"authored\"]));let pointer=b.borrow().get().as_ref().map(|text|text.as_ptr());let mut p=RetainedFieldChange::<Option<String>>::default();let mut turns=0;while !p.ready()&&turns<cut{let g=grant(p.decision_demand(a.borrow(),b.borrow(),257).unwrap());assert!(p.decide(a.borrow(),b.borrow(),g).unwrap().progress().fits(g));turns+=1;}if turns>0{assert!(p.equality.verify(foreign.borrow(),b.borrow()).is_err());}let mut change=None;let mut inverse=None;if p.ready()&&turns<cut{let g=grant(p.decision_demand(a.borrow(),b.borrow(),257).unwrap());change=Some(p.take_change(g).unwrap().unwrap().0);turns+=1;while !p.inverse_ready()&&turns<cut{let g=grant(p.inverse_demand(b.borrow(),257).unwrap());assert!(p.inverse(b.borrow(),g).unwrap().progress().fits(g));turns+=1;}if p.inverse_ready()&&turns<cut{inverse=Some(p.take_inverse(grant(p.inverse_take_demand().unwrap())).unwrap().unwrap().0);}}close(&mut p);assert_eq!(b.borrow().get().as_ref().map(|text|text.as_ptr()),pointer);drain(change);drain(inverse);close_source(&mut a);close_source(&mut b);close_source(&mut foreign);eprintln!(\"[DEBUG] Optional original {:?} cancellation cut={cut} source/payload child custody closes under original grants\",row[\"id\"]);}}"
    },
