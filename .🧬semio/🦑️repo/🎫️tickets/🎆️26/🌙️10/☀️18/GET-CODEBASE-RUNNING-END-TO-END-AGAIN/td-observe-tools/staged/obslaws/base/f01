registerBuildTestLawV1("observation block publisher rebuilds retired shared bytes before publishing a fresh header","sdk-runtime",async original=>{
 const control=createIssuedResourceControlV1(original,"observation:rebuild-blocks",120000),database=new Database(":memory:"),ajv=new Ajv({strict:true});try{expect(ajv.validate({$defs:schema.$defs,$ref:"#/$defs/blockRevalidationCorpus"},corpus)).toBe(true);await withRepositoryBuildGraphPublicationFixtureV1(workspace,original,control,async fixture=>{
  let calls=0,path="",digests:string[]=[];const states:string[]=[];const compute=()=>({generation:++calls,bytes:observedFs.readFileSync(join(workspace,"Cargo.toml")).length});await fixture.withWriter(async()=>{const directory=join(repositoryBuildGraphWriterDirectoryV1(workspace,"inference"),"np");mkdirSync(directory,{recursive:true});path=bounded(join(directory,"a".repeat(24)+".json"));await observeInference({cachePath:path,key:"first"},compute);await observeInference({cachePath:path,key:"first"},compute);expect(calls).toBe(1);states.push("warm");expect(existsSync(path)).toBe(true);const text=brotliDecompressSync(readFileSync(path)).toString("utf8"),header=JSON.parse(text.slice(0,text.indexOf("\n")));digests=header.blocks;expect(digests.length).toBeGreaterThan(0);readInferenceHeaderV1(path);database.exec("create table edges(header text,block text)");for(const digest of digests){const bytes=brotliDecompressSync(readFileSync(inferenceObservationBlockPathV1(directory,digest)));expect(hash(bytes)).toBe(digest);expect(ajv.validate({$defs:schema.$defs,$ref:"#/$defs/observationRows"},JSON.parse(bytes.toString("utf8")))).toBe(true);database.query("insert into edges values(?,?)").run(path,digest);}const missing=inferenceObservationBlockPathV1(directory,digests[0]!);rmSync(missing);let refused=false;try{await observeInference({cachePath:path,key:"first"},compute);}catch(error){expect((error as {code?:string}).code).toBe("BUILD_INFERENCE_BLOCK_ABSENT");refused=true;}expect(refused).toBe(true);expect(calls).toBe(1);expect(existsSync(path)).toBe(true);expect(existsSync(missing)).toBe(false);states.push("typed-missing-refusal");});
  await fixture.withMaintenance(async(image,custody)=>{const free=nativeStatfsSyncV1(image.root),minimumAvailableBytes=free.bavail*free.bsize+1;expect(minimumAvailableBytes).toBeLessThanOrEqual(2684354560);const result=await retireBuildGraphOptionalGroupsHeadroomV1(image,custody,{minimumAvailableBytes});expect(result.retiredFiles).toBeGreaterThan(0);expect(existsSync(path)).toBe(false);states.push("group-absent");});
  await fixture.withWriter(async()=>{const directory=join(repositoryBuildGraphWriterDirectoryV1(workspace,"inference"),"np");mkdirSync(directory,{recursive:true});const fresh=path,value=await observeInference({cachePath:fresh,key:"first"},compute),text=brotliDecompressSync(readFileSync(fresh)).toString("utf8"),header=JSON.parse(text.slice(0,text.indexOf("\n")));expect(value.generation).toBe(2);expect(calls).toBe(2);states.push("recomputed");expect(states).toEqual(corpus.recovery.states);expect(database.query<{count:number},[string]>("select count(*) count from json_each(?)").get(JSON.stringify(states))?.count).toBe(4);expect(header.blocks.length).toBeGreaterThan(0);for(const digest of header.blocks){const bytes=brotliDecompressSync(readFileSync(inferenceObservationBlockPathV1(directory,digest)));expect(hash(bytes)).toBe(digest);}expect(header.blocks).toEqual(database.query<{block:string},[]>("select block from edges order by rowid").all().map(row=>row.block));expect(readInferenceHeaderV1(fresh).observations.length).toBeGreaterThan(0);});
 });}finally{database.close();}
});

