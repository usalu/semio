{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:glob-dialects-corpus:v1",
  "title": "Glob Dialects Corpus",
  "description": "Language-agnostic cases for the three glob compilers of the build graph: for each pattern the engines it applies to, the paths it selects and the paths it rejects, and whether minimatch gives the same verdicts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "engines", "rows", "errors"],
  "definitions": { "engine": { "enum": ["ws", "parity", "input"] }, "paths": { "type": "array", "items": { "type": "string" } } },
  "properties": {
    "version": { "const": 1 },
    "engines": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/definitions/engine" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "engines", "matches", "rejects", "minimatch"],
        "properties": { "pattern": { "type": "string" }, "engines": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/engine" } }, "matches": { "$ref": "#/definitions/paths" }, "rejects": { "$ref": "#/definitions/paths" }, "minimatch": { "enum": ["agrees", "differs"] }, "note": { "type": "string", "minLength": 1 } }
      }
    },
    "errors": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["pattern", "engine", "name"], "properties": { "pattern": { "type": "string" }, "engine": { "$ref": "#/definitions/engine" }, "name": { "type": "string", "minLength": 1 } } } }
  }
}
