{
  "version": 1,
  "id": "process",
  "languages": [
    "en",
    "de"
  ],
  "messages": {
    "capacity.empty-process-table": {
      "en": "The process table is empty",
      "de": "Die Prozesstabelle ist leer"
    },
    "cargoTiming.process-id-required": {
      "en": "Actual process id required",
      "de": "Eine tatsächliche Prozess-ID ist erforderlich"
    },
    "execution.renewable-command-needs-ceiling": {
      "en": "A renewable repository command requires a positive ceiling",
      "de": "Ein erneuerbarer Repository-Befehl verlangt eine positive Obergrenze"
    },
    "leases.admission-resource-reserved": {
      "en": "Directory admission resource is reserved",
      "de": "Die Ressource der Verzeichnis-Zulassung ist reserviert"
    },
    "leases.invalid-access-mode": {
      "en": "Invalid resource access mode",
      "de": "Ungültiger Zugriffsmodus der Ressource"
    },
    "leases.invalid-queue-owner": {
      "en": "Invalid lease queue owner",
      "de": "Ungültiger Besitzer der Lease-Warteschlange"
    },
    "leases.invalid-resource": {
      "en": "Invalid lease resource",
      "de": "Ungültige Lease-Ressource"
    },
    "leases.invalid-timeout": {
      "en": "Invalid resource lease timeout",
      "de": "Ungültiges Zeitlimit der Ressourcen-Lease"
    },
    "leases.yielding-requires-exclusive": {
      "en": "Yielding lease tickets require exclusive access",
      "de": "Nachgebende Lease-Tickets erfordern exklusiven Zugriff"
    },
    "nativeBuild.image-size-invalid": {
      "en": "Native image size {bytes} must be a multiple of {unit} bytes and at least {minimum} bytes",
      "de": "Die Größe {bytes} des Native-Images muss ein Vielfaches von {unit} Bytes und mindestens {minimum} Bytes sein"
    },
    "nativeBuild.metadata-incomplete": {
      "en": "Resolved Cargo metadata with a workspace root and packages required",
      "de": "Aufgelöste Cargo-Metadaten mit Workspace-Wurzel und Paketen sind erforderlich"
    },
    "nativeBuild.namespace-path-unowned": {
      "en": "A Native namespace path nobody owns is still present: {path}",
      "de": "Ein Native-Namensraumpfad ohne Besitzer ist noch vorhanden: {path}"
    },
    "nativeBuild.writer-custody-not-entered": {
      "en": "Offered Cargo compiler writer custody was never entered",
      "de": "Die angebotene Schreiber-Obhut des Cargo-Compilers wurde nie betreten"
    },
    "nativeHelpers.scheduler-absent": {
      "en": "The build scheduler executable is missing after its build: {path}",
      "de": "Das Programm des Build-Planers fehlt nach seinem Build: {path}"
    },
    "nativeHelpers.wrapper-absent": {
      "en": "The unit cache compiler wrapper is missing after its build: {path}",
      "de": "Der Compiler-Wrapper des Unit-Caches fehlt nach seinem Build: {path}"
    },
    "publication.lease-directory-required": {
      "en": "Explicit absolute publication lease directory required",
      "de": "Ein ausdrücklich angegebenes absolutes Lease-Verzeichnis für die Veröffentlichung ist erforderlich"
    },
    "routing.forwarded-request-invocation-required": {
      "en": "The original forwarded request needs its script process invocation",
      "de": "Die ursprüngliche weitergeleitete Anfrage braucht ihren Skriptprozess-Aufruf"
    },
    "routing.renewable-control-needs-nonrenewable-maximum": {
      "en": "A renewable original control requires its nonrenewable maximum as the requested budget",
      "de": "Eine erneuerbare ursprüngliche Steuerung verlangt ihr nicht erneuerbares Maximum als angefordertes Budget"
    },
    "script.suite-files-failed": {
      "en": "Test suite {suite} failed in {count} test file(s): {files}",
      "de": "Die Testsuite {suite} ist in {count} Testdatei(en) fehlgeschlagen: {files}"
    },
    "script.suite-launcher-missing": {
      "en": "Test suite launcher is not provided by the route: {launcher}",
      "de": "Der Starter der Testsuite wird von der Route nicht bereitgestellt: {launcher}"
    },
    "script.suite-platform-skipped": {
      "en": "SKIPPED, not passed: test suite {suite} is declared for {platforms} and this host is {host}; none of its {count} test file(s) ran.",
      "de": "ÜBERSPRUNGEN, nicht bestanden: Die Testsuite {suite} ist für {platforms} deklariert und dieser Rechner ist {host}; keine ihrer {count} Testdatei(en) wurde ausgeführt."
    },
    "script.suite-sources-missing": {
      "en": "Test suite sources are missing (bun test would silently skip them): {missing}",
      "de": "Quellen der Testsuite fehlen (bun test würde sie stillschweigend überspringen): {missing}"
    },
    "script.suite-unknown": {
      "en": "Unknown test suite {suite}; the route table declares: {known}",
      "de": "Unbekannte Testsuite {suite}; die Routentabelle deklariert: {known}"
    },
    "testing.extracted-function-required": {
      "en": "Extracted function required: {name}",
      "de": "Extrahierte Funktion erforderlich: {name}"
    },
    "testing.platform-policy-invalid": {
      "en": "The platform evidence rules of the test suites are invalid: they must satisfy their closed schema and every pattern must be a regular expression",
      "de": "Die Plattform-Belegregeln der Testsuites sind ungültig: sie müssen ihrem geschlossenen Schema genügen und jedes Muster muss ein regulärer Ausdruck sein"
    },
    "testing.route-suite-duplicated": {
      "en": "The process test route table repeats a suite identifier",
      "de": "Die Routentabelle der Prozess-Tests wiederholt eine Suite-Kennung"
    },
    "testing.route-table-invalid": {
      "en": "The process test route table is invalid: it must satisfy its closed schema",
      "de": "Die Routentabelle der Prozess-Tests ist ungültig: sie muss ihrem geschlossenen Schema genügen"
    },
    "typescript.check-cancelled": {
      "en": "TypeScript check cancelled",
      "de": "TypeScript-Prüfung abgebrochen"
    },
    "typescript.check-switches-not-admitted": {
      "en": "TypeScript check switches not admitted by the engine: {switches}",
      "de": "Die Engine lässt diese TypeScript-Prüfschalter nicht zu: {switches}"
    },
    "typescript.retained-programs-range": {
      "en": "Retained TypeScript programs must be an integer from 1 to {maximum}",
      "de": "Die Zahl der behaltenen TypeScript-Programme muss eine ganze Zahl von 1 bis {maximum} sein"
    }
  }
}
