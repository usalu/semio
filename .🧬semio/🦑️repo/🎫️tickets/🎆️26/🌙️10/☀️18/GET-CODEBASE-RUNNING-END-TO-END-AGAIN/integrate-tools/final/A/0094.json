{
  "version": 1,
  "defaultTool": "nx",
  "remoteCache": {
    "version": 1,
    "environment": {
      "endpoint": "SEMIO_REMOTE_CACHE_ENDPOINT",
      "instance": "SEMIO_REMOTE_CACHE_INSTANCE",
      "access": "SEMIO_REMOTE_CACHE_ACCESS",
      "upload": "SEMIO_REMOTE_CACHE_UPLOAD",
      "compression": "SEMIO_REMOTE_CACHE_COMPRESSION",
      "download": "SEMIO_REMOTE_CACHE_DOWNLOAD",
      "timeoutSeconds": "SEMIO_REMOTE_CACHE_TIMEOUT_SECONDS",
      "retries": "SEMIO_REMOTE_CACHE_RETRIES",
      "tokenEnvironment": "SEMIO_REMOTE_CACHE_TOKEN_ENVIRONMENT"
    },
    "defaults": {
      "endpoint": null,
      "instance": "main",
      "access": "read-only",
      "upload": true,
      "compression": true,
      "download": "toplevel",
      "timeoutSeconds": 30,
      "retries": 3,
      "tokenEnvironment": "SEMIO_REMOTE_CACHE_TOKEN"
    },
    "server": {
      "host": "127.0.0.1",
      "port": 6090,
      "directory": ".cache/remote-cache",
      "maximumBytes": 4294967296,
      "maximumEntryBytes": 536870912,
      "maximumAgeDays": 30,
      "tokenEnvironment": {
        "read": "SEMIO_REMOTE_CACHE_SERVER_READ_TOKEN",
        "write": "SEMIO_REMOTE_CACHE_SERVER_WRITE_TOKEN"
      }
    }
  },
  "graphMembers": {
    "description": "Workspace files whose presence the portable graph consumes; every other file reaches inference only through observed facts, so adding or removing it cannot change the graph.",
    "basenames": [
      "📋️project.json",
      "Cargo.toml",
      "package.json",
      "go.mod",
      "bun.lock"
    ],
    "suffixes": [
      ".patch",
      ".feature",
      ".js",
      ".jsx",
      ".ts",
      ".tsx",
      ".cjs",
      ".cjsx",
      ".mjs",
      ".mjsx",
      ".cts",
      ".ctsx",
      ".mts",
      ".mtsx"
    ]
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      {
        "runtime": "node -p \"process.platform.concat(process.arch)\""
      },
      {
        "runtime": "bun --version"
      },
      {
        "env": "SEMIO_BUILD_MODE"
      }
    ],
    "schemaSources": [
      "sharedGlobals",
      "{workspaceRoot}/**/🧬️schema/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔣️taxonomy.json",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔍️discovery/**/*.ts"
    ],
    "production": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "!{projectRoot}/**/🧪️tests/**/*",
      "!{projectRoot}/{🧫️fixtures,🧫️examples,🧪️fixtures,🧪️examples}/**/*",
      "!{projectRoot}/**/!(🔨️modules)/{🧫️fixtures,🧫️examples,🧪️fixtures,🧪️examples}/**/*",
      "!{projectRoot}/**/?(*.)+(stories|story|mdx).[cmjtshx]?([sx])?(.snap)?",
      "!{projectRoot}/.storybook/**"
    ],
    "cargo": [
      "{projectRoot}/**/*.rs",
      "{projectRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml"
    ],
    "go": [
      "{projectRoot}/**/*.go",
      "{projectRoot}/go.mod",
      "{projectRoot}/go.sum",
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ],
    "uv": [
      "{projectRoot}/**/*.py",
      "{projectRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock"
    ],
    "dotnet": [
      "{projectRoot}/**/*.cs",
      "{projectRoot}/**/*.csproj",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🔣️policy.json",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🔣️policy.json"
    ],
    "nativeSources": [
      "production"
    ],
    "nativeTestSources": [
      "default"
    ]
  },
  "workers": {
    "version": 1,
    "enabled": true,
    "protocol": "json",
    "localJobs": {
      "maximum": 8
    },
    "memory": {
      "hostShareBasisPoints": 3000,
      "perWorkerMegabytes": 512
    },
    "sandboxing": false,
    "cancellation": true,
    "resetAfterRequests": 256,
    "classification": [
      {
        "kind": "service",
        "continuous": true
      },
      {
        "kind": "test",
        "pattern": "^(?:test|smoke|mutation|bench|e2e)(?:-|$)"
      },
      {
        "kind": "check",
        "pattern": "^(?:check|lint|verify|typecheck|format-check|contract|schema|stdio)(?:-|$)|-check$"
      },
      {
        "kind": "generate",
        "pattern": "(?:^|[^a-z])(?:generate|generator)(?:-|$)"
      },
      {
        "kind": "build",
        "pattern": "^(?:build|prepare|activate|wasm|native|package|bundle|cpp|publish|canonical|preview|setup|deps)(?:-|$)"
      }
    ],
    "defaultKind": "script",
    "kinds": {
      "test": {
        "workers": true,
        "maxInstances": 8,
        "multiplex": false,
        "inProcess": true
      },
      "check": {
        "workers": true,
        "maxInstances": 8,
        "multiplex": false,
        "inProcess": true
      },
      "generate": {
        "workers": true,
        "maxInstances": 4,
        "multiplex": false,
        "inProcess": true
      },
      "build": {
        "workers": true,
        "maxInstances": 2,
        "multiplex": false,
        "inProcess": true
      },
      "script": {
        "workers": true,
        "maxInstances": 4,
        "multiplex": false,
        "inProcess": true
      },
      "service": {
        "workers": false,
        "maxInstances": 1,
        "multiplex": false,
        "inProcess": false
      }
    }
  }
}
