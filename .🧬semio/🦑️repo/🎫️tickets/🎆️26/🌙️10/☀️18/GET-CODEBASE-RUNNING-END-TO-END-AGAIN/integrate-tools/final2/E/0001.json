{
  "name": "@semio-tech/mit-bestand-demonstrator",
  "$schema": "../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/♻️mit-bestand/🧺️demonstrator/🏗️builder/🌐️vite/🟦️.ts",
      "{workspaceRoot}/♻️mit-bestand/🧺️demonstrator/🔨️modules/🧪️e2e/🎚️config/🟦️.ts",
      "{workspaceRoot}/♻️mit-bestand/🧺️demonstrator/🧪️tests/🎚️config/🟦️.ts",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/test-results/**",
      "sharedGlobals"
    ],
    "activationSources": [
      "production",
      "^production",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/test-results/**"
    ]
  },
  "targets": {
    "prepare-prototype": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "inputs": [
        "activationSources",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ],
      "dependsOn": [
        "@semio-tech/framework-os-dev:prepare-aggregator-react-prototype",
        "@semio-tech/framework-os-dev:prepare-aussuchen-react-prototype",
        "@semio-tech/framework-os-dev:prepare-bearbeiten-react-prototype",
        "@semio-tech/framework-os-dev:prepare-energy-react-prototype",
        "@semio-tech/framework-os-dev:prepare-fem3d-react-prototype",
        "@semio-tech/framework-os-dev:prepare-generation3d-react-prototype",
        "@semio-tech/framework-os-dev:prepare-generator-react-prototype",
        "@semio-tech/framework-os-dev:prepare-koordinator-react-prototype",
        "@semio-tech/framework-os-dev:prepare-verfolgen-react-prototype",
        "@semio-tech/framework-surface-rs:wasm",
        "@semio-tech/framework-editor-rs:wasm",
        "@semio-tech/framework-os-node-graph-rs:wasm",
        "@semio-tech/puzzle-plugin:wasm"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts prepare",
        "forwardAllArgs": false,
        "env": {
          "SEMIO_BUILD_MODE": "prototype"
        }
      },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "driver-owned", "reason": "freshness-owned-by-driver" }
        }
      },
      "defaultConfiguration": "prototype"
    },
    "prepare-release": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "inputs": [
        "activationSources",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ],
      "dependsOn": [
        "@semio-tech/framework-os-dev:prepare-aggregator-react-release",
        "@semio-tech/framework-os-dev:prepare-aussuchen-react-release",
        "@semio-tech/framework-os-dev:prepare-bearbeiten-react-release",
        "@semio-tech/framework-os-dev:prepare-energy-react-release",
        "@semio-tech/framework-os-dev:prepare-fem3d-react-release",
        "@semio-tech/framework-os-dev:prepare-generation3d-react-release",
        "@semio-tech/framework-os-dev:prepare-generator-react-release",
        "@semio-tech/framework-os-dev:prepare-koordinator-react-release",
        "@semio-tech/framework-os-dev:prepare-verfolgen-react-release",
        "@semio-tech/framework-surface-rs:wasm",
        "@semio-tech/framework-editor-rs:wasm",
        "@semio-tech/framework-os-node-graph-rs:wasm",
        "@semio-tech/puzzle-plugin:wasm"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts prepare",
        "forwardAllArgs": false,
        "env": {
          "SEMIO_BUILD_MODE": "release"
        }
      },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "driver-owned", "reason": "freshness-owned-by-driver" }
        }
      },
      "defaultConfiguration": "release"
    },
    "dev": {
      "metadata": {
        "semio": {
          "dashboard": {
            "ready": {
              "port": 6029,
              "portEnv": "MIT_BESTAND_DEMONSTRATOR_PORT"
            }
          }
        }
      },
      "executor": "repo:script",
      "dependsOn": [
        "activate-prototype"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts serve",
        "env": {
          "MIT_BESTAND_DEMONSTRATOR_PORT": "6029",
          "NODE_OPTIONS": "",
          "SEMIO_BUILD_DYNAMIC_OUTPUT": "false",
          "SEMIO_BUILD_TERMINAL": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": false
      },
      "cache": false,
      "continuous": true,
      "outputs": []
    },
    "build": {
      "executor": "repo:script",
      "dependsOn": [
        "prepare-release",
        "@semio-tech/framework-surface-rs:wasm",
        "@semio-tech/framework-editor-rs:wasm",
        "@semio-tech/framework-os-node-graph-rs:wasm",
        "@semio-tech/puzzle-plugin:wasm"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/📦️site/📜️script.ts build",
        "forwardAllArgs": false
      },
      "cache": false,
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "managed-output", "reason": "outputs-in-managed-store" }
        }
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "activate-prototype": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [
        "{projectRoot}/dist/♻️activation/prototype"
      ],
      "inputs": [
        "activationSources",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ],
      "dependsOn": [
        "prepare-prototype",
        "@semio-tech/mit-bestand-demonstrator:activate-lanes-prototype"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts activate",
        "forwardAllArgs": false,
        "env": {
          "SEMIO_BUILD_MODE": "prototype"
        }
      },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "driver-owned", "reason": "freshness-owned-by-driver" }
        }
      },
      "defaultConfiguration": "prototype"
    },
    "activate-lanes-prototype": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "inputs": [
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        }
      ],
      "dependsOn": [
        "@semio-tech/framework-os-dev:activate-energy-react-prototype",
        "@semio-tech/framework-os-dev:activate-fem3d-react-prototype",
        "@semio-tech/framework-os-dev:activate-generator-react-prototype"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts complete",
        "forwardAllArgs": false,
        "env": {
          "SEMIO_BUILD_MODE": "prototype"
        }
      },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "driver-owned", "reason": "freshness-owned-by-driver" }
        }
      },
      "defaultConfiguration": "prototype"
    },
    "serve": {
      "metadata": {
        "semio": {
          "dashboard": {
            "ready": {
              "port": 6029,
              "portEnv": "MIT_BESTAND_DEMONSTRATOR_PORT"
            }
          }
        }
      },
      "executor": "repo:script",
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts serve",
        "forwardAllArgs": false
      },
      "cache": false,
      "continuous": true,
      "outputs": [],
      "dependsOn": [
        "activate-prototype"
      ]
    },
    "prepare-e2e": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "activate-prototype",
        "workspace:deps-browsers"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts prepare-test",
        "forwardAllArgs": false
      },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "side-effecting", "reason": "mutates-host-store" }
        }
      }
    },
    "serve-e2e": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "prepare-e2e"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧩️runtime/📜️script.ts serve-test",
        "forwardAllArgs": false
      },
      "continuous": true,
      "metadata": {
        "semio": {
          "continuousSharing": false
        }
      }
    },
    "test-e2e": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "serve-e2e"
      ],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./🔨️modules/🧪️e2e/📜️script.ts test",
        "forwardAllArgs": false
      },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "live", "reason": "drives-running-process" }
        }
      }
    },
    "canonical-architecture": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./📜️script.ts test long \"./🧪️tests/🏛️shell-brand/🟦️.ts\"",
        "forwardAllArgs": true
      },
      "inputs": [
        "default",
        "^default",
        { "env": "SEMIO_TEST_LEVEL" },
        { "env": "SEMIO_TEST_BUDGET_MS" },
        { "env": "SEMIO_BUILD_BUDGET_MS" }
      ]
    },
    "test-runtime-catalog": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "♻️mit-bestand/🧺️demonstrator",
        "command": "bun ./📜️script.ts runtime-catalog-test"
      }
    }
  }
}
