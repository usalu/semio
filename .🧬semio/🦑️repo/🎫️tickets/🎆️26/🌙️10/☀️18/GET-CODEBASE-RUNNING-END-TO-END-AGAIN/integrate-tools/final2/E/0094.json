{
  "name": "@semio-tech/repo-coordinator-rs",
  "$schema": "../../../../📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "application",
  "namedInputs": {
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "inputs": [
        "production",
        "^production",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build"
      },
      "metadata": {
        "semio": {
          "rustBuildIntent": {
            "version": 1,
            "manifest": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/📦️packages/🦀️rust/Cargo.toml",
            "package": "semio-framework-repo-coordinator",
            "scope": "package",
            "fallback": {
              "kind": "bounded-cargo",
              "adapters": [
                "foreign-source",
                "proc-macro",
                "build-script",
                "build-script-run",
                "binary"
              ]
            }
          }
        }
      },
      "cache": true
    },
    "run": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts run",
        "forwardAllArgs": true
      },
      "continuous": true,
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "continuous", "reason": "serves-until-stopped" }
        }
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🖥️server/🎛️coordinator/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    }
  }
}
