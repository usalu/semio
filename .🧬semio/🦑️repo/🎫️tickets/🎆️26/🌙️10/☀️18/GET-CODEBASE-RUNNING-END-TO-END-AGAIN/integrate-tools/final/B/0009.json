{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Coverage Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows", "reports"],
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "input": { "$ref": "coverage#/definitions/Input" },
          "expected": { "$ref": "coverage#" }
        }
      }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rows", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "rows": { "type": "array", "items": { "$ref": "coverage#" } },
          "expected": { "$ref": "coverage#/definitions/Report" }
        }
      }
    }
  }
}
