{
 "environment": [
  {
   "name": "unset keeps every action local",
   "environment": {},
   "expected": null
  },
  {
   "name": "empty endpoint keeps every action local",
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": ""
   },
   "expected": null
  },
  {
   "name": "endpoint only routes to the default linux-x64 pool",
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "grpcs://exec.example.test:443"
   },
   "expected": {
    "endpoint": "grpcs://exec.example.test:443",
    "platform": "linux-x64",
    "properties": {
     "Arch": "amd64",
     "OSFamily": "linux"
    },
    "jobs": 128
   }
  },
  {
   "name": "unix socket endpoint",
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "unix:/run/exec.sock"
   },
   "expected": {
    "endpoint": "unix:/run/exec.sock",
    "platform": "linux-x64",
    "properties": {
     "Arch": "amd64",
     "OSFamily": "linux"
    },
    "jobs": 128
   }
  },
  {
   "name": "properties override platform defaults and are sorted",
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "grpc://10.0.0.7:8980",
    "SEMIO_REMOTE_EXECUTION_PROPERTIES": "pool=repo,Arch=arm64,container-image=docker://example.test/worker@sha256:0123"
   },
   "expected": {
    "endpoint": "grpc://10.0.0.7:8980",
    "platform": "linux-x64",
    "properties": {
     "Arch": "arm64",
     "OSFamily": "linux",
     "container-image": "docker://example.test/worker@sha256:0123",
     "pool": "repo"
    },
    "jobs": 128
   }
  },
  {
   "name": "platform and jobs are honoured and jobs are capped",
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "grpc://h:1",
    "SEMIO_REMOTE_EXECUTION_PLATFORM": "darwin-arm64",
    "SEMIO_REMOTE_EXECUTION_JOBS": "4000"
   },
   "expected": {
    "endpoint": "grpc://h:1",
    "platform": "darwin-arm64",
    "properties": {
     "Arch": "arm64",
     "OSFamily": "macos"
    },
    "jobs": 512
   }
  },
  {
   "name": "http endpoints are refused",
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "http://exec.example.test"
   },
   "expected": {
    "error": "Closed Bazel remote execution environment required"
   }
  },
  {
   "name": "unknown platform is refused",
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "grpc://h:1",
    "SEMIO_REMOTE_EXECUTION_PLATFORM": "linux-riscv"
   },
   "expected": {
    "error": "Closed Bazel remote execution environment required"
   }
  },
  {
   "name": "malformed property is refused",
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "grpc://h:1",
    "SEMIO_REMOTE_EXECUTION_PROPERTIES": "pool"
   },
   "expected": {
    "error": "Closed Bazel remote execution environment required"
   }
  },
  {
   "name": "zero jobs are refused",
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "grpc://h:1",
    "SEMIO_REMOTE_EXECUTION_JOBS": "0"
   },
   "expected": {
    "error": "Closed Bazel remote execution environment required"
   }
  }
 ],
 "flags": [
  {
   "name": "no hermetic action registers nothing",
   "host": {
    "platform": "darwin",
    "arch": "arm64"
   },
   "hermetic": false,
   "jobs": 8,
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "grpc://h:1"
   },
   "expected": {
    "command": [],
    "remote": false,
    "platform": "darwin-arm64",
    "jobs": 8
   }
  },
  {
   "name": "hermetic local registers the host platform and toolchain only",
   "host": {
    "platform": "darwin",
    "arch": "arm64"
   },
   "hermetic": true,
   "jobs": 8,
   "environment": {},
   "expected": {
    "command": [
     "--extra_execution_platforms=//:exec_darwin_arm64",
     "--extra_toolchains=//:bun_toolchain_darwin_arm64"
    ],
    "remote": false,
    "platform": "darwin-arm64",
    "jobs": 8
   }
  },
  {
   "name": "hermetic remote routes to the pool without local fallback",
   "host": {
    "platform": "darwin",
    "arch": "arm64"
   },
   "hermetic": true,
   "jobs": 8,
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "grpcs://exec.example.test:443"
   },
   "expected": {
    "command": [
     "--extra_execution_platforms=//:exec_darwin_arm64,//:exec_remote_linux_x64",
     "--extra_toolchains=//:bun_toolchain_darwin_arm64,//:bun_toolchain_linux_x64",
     "--remote_executor=grpcs://exec.example.test:443",
     "--noremote_local_fallback"
    ],
    "remote": true,
    "platform": "linux-x64",
    "jobs": 128
   }
  },
  {
   "name": "linux host with a linux pool shares one toolchain",
   "host": {
    "platform": "linux",
    "arch": "x64"
   },
   "hermetic": true,
   "jobs": 8,
   "environment": {
    "SEMIO_REMOTE_EXECUTION_ENDPOINT": "grpc://h:1"
   },
   "expected": {
    "command": [
     "--extra_execution_platforms=//:exec_linux_x64,//:exec_remote_linux_x64",
     "--extra_toolchains=//:bun_toolchain_linux_x64",
     "--remote_executor=grpc://h:1",
     "--noremote_local_fallback"
    ],
    "remote": true,
    "platform": "linux-x64",
    "jobs": 128
   }
  },
  {
   "name": "windows host maps win32 to windows-x64",
   "host": {
    "platform": "win32",
    "arch": "x64"
   },
   "hermetic": true,
   "jobs": 4,
   "environment": {},
   "expected": {
    "command": [
     "--extra_execution_platforms=//:exec_windows_x64",
     "--extra_toolchains=//:bun_toolchain_windows_x64"
    ],
    "remote": false,
    "platform": "windows-x64",
    "jobs": 4
   }
  },
  {
   "name": "unsupported host is refused",
   "host": {
    "platform": "freebsd",
    "arch": "x64"
   },
   "hermetic": true,
   "jobs": 4,
   "environment": {},
   "expected": {
    "error": "Unsupported Bazel execution platform: freebsd/x64"
   }
  }
 ],
 "decisions": [
  {
   "name": "declared cacheable command is hermetic",
   "definition": {
    "execution": {
     "kind": "command",
     "command": "bun {projectRoot}/gen.ts"
    },
    "outputs": [
     "{projectRoot}/gen"
    ],
    "metadata": {
     "semio": {
      "hermetic": {
       "version": 1,
       "tools": [
        "bun"
       ]
      }
     }
    }
   },
   "cache": true,
   "inputs": [
    "{projectRoot}/src/**/*"
   ],
   "expected": {
    "hermetic": true
   }
  },
  {
   "name": "no declaration keeps host state",
   "definition": {
    "execution": {
     "kind": "command",
     "command": "bun x"
    },
    "outputs": []
   },
   "cache": true,
   "inputs": [],
   "expected": {
    "hermetic": false,
    "reason": "undeclared"
   }
  },
  {
   "name": "continuous never hermetic",
   "definition": {
    "execution": {
     "kind": "command",
     "command": "bun {projectRoot}/gen.ts"
    },
    "outputs": [
     "{projectRoot}/gen"
    ],
    "metadata": {
     "semio": {
      "hermetic": {
       "version": 1,
       "tools": [
        "bun"
       ]
      }
     }
    },
    "continuous": true
   },
   "cache": false,
   "inputs": [],
   "expected": {
    "hermetic": false,
    "reason": "continuous"
   }
  },
  {
