{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:worker-pool:v1",
  "title": "Build worker pool protocol",
  "description": "Pure, module-addressed tasks run on bounded worker threads; every message is plain data.",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "defaultWorkers": 8,
        "maximumWorkers": 32,
        "maximumQueuedTasks": 65536,
        "maximumNameCharacters": 256
      }
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "export"],
      "properties": {
        "module": { "type": "string", "pattern": "^file:///" },
        "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$", "maxLength": 256 }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "module", "export", "input"],
      "properties": {
        "type": { "const": "run" },
        "id": { "type": "integer", "minimum": 0 },
        "module": { "type": "string", "pattern": "^file:///" },
        "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$", "maxLength": 256 },
        "input": {}
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "completed", "total"],
      "properties": {
        "type": { "const": "progress" },
        "id": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "value"],
      "properties": { "type": { "const": "result" }, "id": { "type": "integer", "minimum": 0 }, "value": {} }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "name", "message"],
      "properties": {
        "type": { "const": "error" },
        "id": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/Request" },
    { "$ref": "#/definitions/Progress" },
    { "$ref": "#/definitions/Result" },
    { "$ref": "#/definitions/Failure" }
  ]
}
