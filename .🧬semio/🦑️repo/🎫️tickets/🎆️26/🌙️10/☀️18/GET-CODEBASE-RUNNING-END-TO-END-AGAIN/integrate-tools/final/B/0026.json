{
 "graph": {
  "version": 1,
  "projects": {
   "lib": {
    "name": "lib",
    "root": "lib",
    "targets": {
     "generate": {
      "execution": {
       "kind": "command",
       "command": "bun ./📜️script.ts generate"
      },
      "cache": true,
      "outputs": [
       "{projectRoot}/gen"
      ],
      "inputs": [
       "{projectRoot}/src/**/*"
      ]
     },
     "test": {
      "execution": {
       "kind": "command",
       "command": "bun ./📜️script.ts test"
      },
      "cache": true,
      "outputs": [],
      "inputs": [
       "{projectRoot}/**/*"
      ],
      "dependsOn": [
       "generate"
      ]
     }
    }
   },
   "app": {
    "name": "app",
    "root": "app",
    "targets": {
     "build": {
      "execution": {
       "kind": "command",
       "command": "bun ./📜️script.ts build"
      },
      "cache": true,
      "outputs": [
       "{projectRoot}/dist"
      ],
      "inputs": [
       "{projectRoot}/**/*"
      ]
     },
     "test": {
      "execution": {
       "kind": "command",
       "command": "bun ./📜️script.ts test"
      },
      "cache": true,
      "outputs": [],
      "inputs": [
       "{projectRoot}/**/*"
      ],
      "dependsOn": [
       "build"
      ]
     },
     "test-snapshot": {
      "execution": {
       "kind": "command",
       "command": "bun ./📜️script.ts test snapshot"
      },
      "cache": true,
      "outputs": [
       "{projectRoot}/snap"
      ],
      "inputs": [
       "{projectRoot}/**/*"
      ]
     },
     "test-live": {
      "execution": {
       "kind": "command",
       "command": "bun ./📜️script.ts test live"
      },
      "cache": false,
      "outputs": []
     },
     "test-gate": {
      "execution": {
       "kind": "command",
       "command": "bun ./📜️script.ts test gate"
      },
      "cache": true,
      "outputs": [],
      "inputs": [
       "{projectRoot}/**/*"
      ],
      "dependsOn": [
       "test"
      ]
     },
     "check": {
      "execution": {
       "kind": "command",
       "command": "bun ./📜️script.ts check"
      },
      "cache": true,
      "outputs": [],
      "inputs": [
       "{projectRoot}/**/*"
      ]
     },
     "serve": {
      "execution": {
       "kind": "command",
       "command": "bun ./📜️script.ts serve"
      },
      "cache": false,
      "continuous": true,
      "dependsOn": [
       "build"
      ]
     }
    }
   }
  },
  "dependencies": [
   {
    "source": "app",
    "target": "lib",
    "type": "static"
   }
  ]
 },
 "requests": [
  {
   "name": "a selected pure test becomes a Bazel test",
   "tasks": [
    "lib:test"
   ],
   "kinds": {
    "lib:generate": "task",
    "lib:test": "test"
   }
  },
  {
   "name": "a test consumed by another selected task stays an action",
   "tasks": [
    "app:test-gate"
   ],
   "kinds": {
    "app:build": "task",
    "app:test": "task",
    "app:test-gate": "test"
   }
  },
  {
   "name": "a test that declares outputs, a live uncached test, a check and a server keep their kinds",
   "tasks": [
    "app:test-snapshot",
    "app:test-live",
    "app:check",
    "app:serve"
   ],
   "kinds": {
    "app:build": "task",
    "app:test-snapshot": "task",
    "app:test-live": "task",
    "app:check": "task",
    "app:serve": "launch"
   }
  },
  {
   "name": "a skipped cache never becomes a cached test",
   "tasks": [
    "lib:test"
   ],
   "skipCache": true,
   "kinds": {
    "lib:generate": "task",
    "lib:test": "task"
   }
  },
  {
   "name": "every selected test beside a build",
   "tasks": [
    "lib:test",
    "app:test",
    "app:build"
   ],
   "kinds": {
    "lib:generate": "task",
    "lib:test": "test",
    "app:build": "task",
    "app:test": "test"
   }
  }
 ],
 "coverage": {
  "lib:test": {
   "family": "bun-test",
   "disposition": "test"
  },
  "app:build": {
   "family": "bun-script",
   "disposition": "action"
  },
  "app:serve": {
   "family": "bun-script",
   "disposition": "interactive",
   "reason": "continuous"
  },
  "app:test-live": {
   "family": "bun-test",
   "disposition": "uncached",
   "reason": "declared"
  },
  "app:test-snapshot": {
   "family": "bun-test",
   "disposition": "action"
  },
  "app:check": {
   "family": "bun-script",
   "disposition": "action"
  }
 },
 "reports": [
