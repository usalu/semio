      "action": 2
     },
     "bun-test": {
      "test": 2
     }
    }
   }
  },
  {
   "name": "a consumed test counts as an action and a server as interactive",
   "tasks": [
    "app:test-gate",
    "app:serve"
   ],
   "expected": {
    "version": 1,
    "tasks": 4,
    "dispositions": {
     "action": 2,
     "interactive": 1,
     "test": 1
    },
    "families": {
     "bun-script": {
      "action": 1,
      "interactive": 1
     },
     "bun-test": {
      "action": 1,
      "test": 1
     }
    }
   }
  }
 ]
}