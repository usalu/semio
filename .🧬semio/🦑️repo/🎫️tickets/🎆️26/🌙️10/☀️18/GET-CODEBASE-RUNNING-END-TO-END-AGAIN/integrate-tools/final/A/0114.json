{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tasks",
    "selected"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "project",
          "target",
          "label",
          "dependencies",
          "args"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "configuration": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "pattern": "^t_[a-f0-9]{16}$"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ActionBirth": {
      "title": "Private Bazel Action Birth",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "task",
        "manifestSha256",
        "parameters"
      ],
      "properties": {
        "kind": {
          "enum": [
            "action",
            "launcher",
            "launch"
          ]
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parameters": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000]+$"
          }
        }
      },
      "definitions": {
        "Protocol": {
          "const": {
            "maximumManifestBytes": 1048576,
            "maximumRuntimeBytes": 1048576,
            "maximumHandshakeMilliseconds": 10000,
            "readChunkBytes": 65536,
            "cooperativeCancellationRole": "execution"
          }
        },
        "ParameterGrants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ActionBirth/properties/parameters"
          }
        },
        "ControlRole": {
          "enum": [
            "birth",
            "execution"
          ]
        }
      }
    },
    "OutputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "roots",
        "entries"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "kind",
                  "mode"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "directory"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "path",
                  "kind",
                  "mode",
                  "file",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "file"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  },
                  "file": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "path",
                  "kind",
                  "mode",
                  "link",
                  "linkKind"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "const": "symlink"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  },
                  "link": {
                    "type": "string",
                    "minLength": 1
                  },
                  "linkKind": {
                    "enum": [
                      "directory",
                      "file"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "ModuleSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "identity",
        "lockSha256",
        "blobs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lockSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "blobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "ImplementationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "serverIdleSeconds",
        "moduleSetupMilliseconds",
        "terminationReceiptMilliseconds",
        "maximumControlMessageBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "serverIdleSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "moduleSetupMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "terminationReceiptMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maximumControlMessageBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        }
      }
    },
    "Planner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "workspace",
        "graph",
        "request",
        "implementation"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "graph": {
          "type": "object"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tasks"
          ],
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 65536,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "args": {
              "type": "array",
              "maxItems": 65536,
              "items": {
                "type": "string",
                "maxLength": 65536
              }
            },
            "configuration": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "parallel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "excludeDependencies": {
              "type": "boolean"
            },
            "skipCache": {
              "type": "boolean"
            },
            "skipRemoteCache": {
              "type": "boolean"
            },
            "bail": {
              "type": "boolean"
            },
            "verbose": {
              "type": "boolean"
            },
            "outputStyle": {
              "enum": [
                "stream",
                "stream-without-prefixes",
                "static"
              ]
            }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "snapshot",
            "runner",
            "sha256",
            "loaderSha256"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "snapshot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "runner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "loaderSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "definitions": {
        "Policy": {
          "const": {
            "maximumDataBytes": 536870912,
            "readChunkBytes": 65536
          }
        },
        "Result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspace",
            "plan",
            "implementation"
          ],
          "properties": {
            "workspace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "implementation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "snapshot",
                "runner",
                "sha256",
                "loaderSha256"
              ],
              "properties": {
                "version": {
                  "const": 1
                },
                "snapshot": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "runner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "loaderSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "plan": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "selected",
                "tasks"
              ],
              "properties": {
                "version": {
                  "const": 1
                },
                "selected": {
                  "type": "array",
                  "maxItems": 65536,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "tasks": {
                  "type": "object",
                  "maxProperties": 65536,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "project",
                      "target",
                      "label",
                      "dependencies",
                      "args",
                      "definition",
                      "root"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "project": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "root": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "configuration": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "label": {
                        "type": "string",
                        "pattern": "^t_[a-f0-9]{16}$"
                      },
                      "dependencies": {
                        "type": "array",
                        "maxItems": 65536,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024
                        }
                      },
                      "args": {
                        "type": "array",
                        "maxItems": 65536,
                        "items": {
                          "type": "string",
                          "maxLength": 65536
                        }
                      },
                      "definition": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "snapshot",
        "runner",
        "sha256",
        "loaderSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "loaderSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "StorageLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "executable",
        "install",
        "modules",
        "workspace",
        "outputs",
        "actions",
        "server",
        "temporary"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "install": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modules": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outputs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "server": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "temporary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "OwnerCommandBudgetCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "effects"
      ],
      "properties": {
        "kind": {
          "enum": [
            "root0",
            "finite",
            "cancelled",
            "expired",
            "fractional"
          ]
        },
        "effects": {
          "enum": [
            0,
            2
          ]
        }
      }
    },
    "OwnerCommandBudgetCaller": {
      "enum": [
        "captured-planner",
        "launch",
        "build"
      ]
    },
    "Policy": {
      "const": {
        "version": 1,
        "serverIdleSeconds": 120,
        "moduleSetupMilliseconds": 120000,
        "terminationReceiptMilliseconds": 5000,
        "maximumControlMessageBytes": 65536
      }
    },
    "CachePolicy": {
      "const": {
        "version": 1,
        "diskCache": {
          "productsShareBasisPoints": 4000,
          "garbageCollectionMaximumAgeDays": 30,
          "garbageCollectionIdleDelaySeconds": 10,
          "garbageCollectionWindowSeconds": 110
        },
        "repositoryContents": {
          "garbageCollectionMaximumAgeDays": 3
        }
      }
    },
    "CacheFlags": {
      "description": "Closed Bazel flags derived from the storage layout, the products budget and the neutral remote cache contract. The startup flag binds one output base, and therefore one server, to one workspace directory; the disk cache garbage collector only runs inside such a persistent server, never under --batch. The remote flags are the Bazel rendering of the contract in the build policy; the access token never appears in a flag: it travels as the one environment entry of the Bazel client that the credential helper reads, and the helper holds only the variable name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup",
        "command",
        "remote",
        "environment"
      ],
      "properties": {
        "startup": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/CacheFlags/definitions/Flag"
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/CacheFlags/definitions/Flag"
          }
        },
        "remote": {
          "type": "boolean"
        },
        "environment": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~+/=-]{1,4096}$"
          }
        },
        "helper": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "content",
            "mode"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "mode": {
              "enum": [
                420,
                493
              ]
            }
          }
        }
      },
      "definitions": {
        "Flag": {
          "type": "string",
          "pattern": "^--(no)?[a-z][a-z_]*(=[^\\u0000]+)?$",
          "maxLength": 1024
        }
      }
    },
    "HostPaths": {
      "const": {
        "version": 1,
        "guarded": [
          "install",
          "outputs",
          "server"
        ],
        "platforms": {
          "darwin": {
            "pattern": "^[\\u0020-\\u007e]+$",
            "reason": "The macOS JVM opens its classpath from Bazel's byte-wise path strings as UTF-8, so a non-ASCII install base crashes the server at startup (main class not found). Bazel writes the darwin-sandbox profile (sandbox.sb) from the same byte-wise strings but encodes each byte as UTF-8 again, so a non-ASCII output base (sandbox directory, execroot and stats.out) is allow-listed under mojibake and every sandboxed action fails with Operation not permitted unless the base happens to sit under an allow-listed directory such as /private/tmp. Source labels, output names inside the execroot, disk cache and workspace paths accept non-ASCII names."
          }
        }
      }
    },
    "HostPathPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "guarded",
        "platforms"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "guarded": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "install",
              "outputs",
              "server"
            ]
          }
        },
        "platforms": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "reason"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 16
              }
            }
          }
        }
      }
    },
    "Actions": {
      "const": {
        "version": 1,
        "sources": {
          "link": "s",
          "label": "^(?:[A-Za-z0-9_@=,+~%./\\-]|[^\\u0000-\\u007f])+$",
          "boundaries": [
            "BUILD",
            "BUILD.bazel"
          ],
          "bundled": [
            "bun.lock",
            "package.json"
          ]
        },
        "kinds": {
          "task": {
            "sandbox": false,
            "reason": "The task process runs in the real checkout: its working directory, the declared source-tree and shared-store writes, the loopback control socket and the out-of-tree runtime channel are host state that a Bazel sandbox hides or blocks."
          },
          "launcher": {
            "sandbox": false,
            "reason": "Action birth binds exact execroot output paths and obtains authority from the owning invocation over its loopback control socket and out-of-tree runtime channel, which a sandbox execroot would change."
          },
          "noop": {
            "sandbox": true
          }
        },
        "uncached": {
          "continuous": "A long-running service is started on demand and never produced.",
          "declared": "The target declares itself uncacheable: it publishes, deploys or exercises a live environment.",
          "skipped": "The invocation skips the action cache.",
          "undeclared": "cache not declared: the target states no cache policy, so undeclared side effects could be lost on a cache hit and it reruns until it declares one.",
          "unbounded": "outputs not declared: the target says cache true but names no outputs, so a cache hit could not restore what it produced."
        }
      }
    },
    "ActionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sources",
        "kinds",
        "uncached"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "link",
            "label",
            "boundaries",
            "bundled"
          ],
          "properties": {
            "link": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "boundaries": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "bundled": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "kinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task",
            "launcher",
            "noop"
          ],
          "properties": {
            "task": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sandbox"
                  ],
                  "properties": {
                    "sandbox": {
                      "const": true
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sandbox",
                    "reason"
                  ],
                  "properties": {
                    "sandbox": {
                      "const": false
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 16
                    }
                  }
                }
              ]
            },
            "launcher": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sandbox"
                  ],
                  "properties": {
                    "sandbox": {
                      "const": true
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sandbox",
                    "reason"
                  ],
                  "properties": {
                    "sandbox": {
                      "const": false
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 16
                    }
                  }
                }
              ]
            },
            "noop": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sandbox"
                  ],
                  "properties": {
                    "sandbox": {
                      "const": true
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sandbox",
                    "reason"
                  ],
                  "properties": {
                    "sandbox": {
                      "const": false
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 16
                    }
                  }
                }
              ]
            }
          }
        },
        "uncached": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "continuous",
