    "nativeSources",
    "^nativeSources",
    "nativeTestSources",
    "^nativeTestSources",
    "reads"
  ],
  "reads": [
    {
      "router": {
        "source": "🧰️framework/📦️packages/🦀️rust/📜️script.ts",
