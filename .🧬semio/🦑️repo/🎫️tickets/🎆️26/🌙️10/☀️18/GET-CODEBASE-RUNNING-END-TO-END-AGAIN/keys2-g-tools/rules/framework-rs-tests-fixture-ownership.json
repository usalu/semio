{
  "id": "framework-rs-tests-fixture-ownership",
  "evidence": "static",
  "description": "Like framework-rs-tests; the fixture ownership test also reads the pixel lock fixture that its hierarchy oracle compares (learned by the read oracle: a runtime path no static read can see).",
  "select": {
    "project": "@semio-tech/framework-rs",
    "targets": [
      "test-fixture-ownership-source"
    ]
  },
  "replaces": [
    "default",
