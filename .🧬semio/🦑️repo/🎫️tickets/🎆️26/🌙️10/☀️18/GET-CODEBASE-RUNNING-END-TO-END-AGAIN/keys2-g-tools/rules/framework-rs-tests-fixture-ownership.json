          "🧰️framework"
        ]
      }
    },
    {
      "globs": [
        "{workspaceRoot}/bunfig.toml",
        "{workspaceRoot}/tsconfig.json",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/🏗️build/🗣️language/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/📦️packages/🟦️typescript/🏗️build/🗣️language/**/*"
      ]
    },
    {
      "globs": [
        "{workspaceRoot}/🧰️framework/🔨️modules/🗺️surface/🎨️paint/🧪️tests/🧫️fixtures/🔒️protection/🔣️.json"
