{
  "schemaVersion": 1,
  "GiB": 1073741824,
  "limits": [
    {"name": "defaults on 64 GiB", "environment": {}, "memoryGiB": 64, "expected": {"finite": 2, "watch": 6, "idleMilliseconds": 600000}},
    {"name": "8 GiB host", "environment": {}, "memoryGiB": 8, "expected": {"finite": 1, "watch": 6, "idleMilliseconds": 600000}},
    {"name": "4 GiB host has no finite daemon", "environment": {}, "memoryGiB": 4, "expected": {"finite": 0, "watch": 6, "idleMilliseconds": 600000}},
    {"name": "256 GiB host stays at the authored maximum", "environment": {}, "memoryGiB": 256, "expected": {"finite": 2, "watch": 6, "idleMilliseconds": 600000}},
    {"name": "override both", "environment": {"SEMIO_NX_DAEMONS": "4,3"}, "memoryGiB": 8, "expected": {"finite": 4, "watch": 3, "idleMilliseconds": 600000}},
    {"name": "override off", "environment": {"SEMIO_NX_DAEMONS": "0"}, "memoryGiB": 64, "expected": {"finite": 0, "watch": 6, "idleMilliseconds": 600000}},
    {"name": "override capped at 16", "environment": {"SEMIO_NX_DAEMONS": "99,99"}, "memoryGiB": 64, "expected": {"finite": 16, "watch": 16, "idleMilliseconds": 600000}},
    {"name": "garbage ignored", "environment": {"SEMIO_NX_DAEMONS": "x,-1", "SEMIO_NX_DAEMON_IDLE_MS": "1.5"}, "memoryGiB": 64, "expected": {"finite": 2, "watch": 6, "idleMilliseconds": 600000}},
    {"name": "idle override", "environment": {"SEMIO_NX_DAEMON_IDLE_MS": "1000"}, "memoryGiB": 64, "expected": {"finite": 2, "watch": 6, "idleMilliseconds": 1000}}
  ],
  "decisions": [
    {"name": "explicit false", "input": {"explicit": "false", "namespaceLive": true, "live": 0, "limit": 2}, "expected": {"enabled": false, "reason": "explicit"}},
    {"name": "explicit true beats saturation", "input": {"explicit": "true", "namespaceLive": false, "live": 9, "limit": 2}, "expected": {"enabled": true, "reason": "explicit"}},
    {"name": "live namespace is reused beyond the limit", "input": {"namespaceLive": true, "live": 5, "limit": 2}, "expected": {"enabled": true, "reason": "reuse"}},
    {"name": "free slot admits", "input": {"namespaceLive": false, "live": 1, "limit": 2}, "expected": {"enabled": true, "reason": "admitted"}},
    {"name": "full slots saturate", "input": {"namespaceLive": false, "live": 2, "limit": 2}, "expected": {"enabled": false, "reason": "saturated"}},
    {"name": "zero limit disables", "input": {"namespaceLive": false, "live": 0, "limit": 0}, "expected": {"enabled": false, "reason": "disabled"}}
  ],
  "idle": [
    {"name": "finite quiet", "state": {"kind": "finite", "openRequests": 0, "lastActivity": 0, "now": 600000, "idleMilliseconds": 600000}, "expected": true},
    {"name": "finite just active", "state": {"kind": "finite", "openRequests": 0, "lastActivity": 1, "now": 600000, "idleMilliseconds": 600000}, "expected": false},
    {"name": "finite with an open request", "state": {"kind": "finite", "openRequests": 1, "lastActivity": 0, "now": 9999999, "idleMilliseconds": 600000}, "expected": false},
    {"name": "watch never idles", "state": {"kind": "watch", "openRequests": 0, "lastActivity": 0, "now": 9999999, "idleMilliseconds": 600000}, "expected": false},
    {"name": "idle off", "state": {"kind": "finite", "openRequests": 0, "lastActivity": 0, "now": 9999999, "idleMilliseconds": 0}, "expected": false}
  ]
}
