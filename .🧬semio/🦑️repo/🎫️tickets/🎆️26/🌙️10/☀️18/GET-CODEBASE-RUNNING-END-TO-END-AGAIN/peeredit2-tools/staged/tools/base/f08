import { refuseBuildV1 } from "../../../../📖️texts/🟦️.ts";
import { validateJsonSchemaSubset } from "../../../../../../../../../🔨️modules/🧬️schema/✅️validator/📦️packages/🟦️typescript/🟦️.ts";
import schema from "./🧬️schema/🔣️.json" with { type: "json" };
import table from "./🔣️.json" with { type: "json" };

if (validateJsonSchemaSubset(schema, table).length) throw refuseBuildV1("invalid", "closure.provider-closures-required");

/** 🔌️ The admitted provider closure policy: group names, the views a provider closure is published in and how the providers project is recognized. See `./🔣️.json`, `../👓️walk-views` (the views) and `./🧪️tests/🟦️.ts` (the law). */
export const PROVIDER_CLOSURE_POLICY_V1 = Object.freeze(structuredClone(table));

const PORT_V1 = /^[a-z0-9-]+$/u;

/** 🏷️ The named input of the providers project that holds the closure of `port` read through `view`; an unknown view or a port the designation grammar does not admit is refused. */
export function providerGroupNameV1(port, view) {
  if (typeof port !== "string" || !PORT_V1.test(port) || !Object.hasOwn(table.views, view)) throw refuseBuildV1("invalid", "closure.provider-closures-required");
  return `${table.group.prefix}${port}${table.group.separator}${view}`;
}

/** 🔍️ The port and view a provider group name stands for, or undefined for any other name. */
export function providerGroupOfV1(name) {
  if (typeof name !== "string" || !name.startsWith(table.group.prefix)) return undefined;
  const [port, view, ...rest] = name.slice(table.group.prefix.length).split(table.group.separator);
  return rest.length === 0 && PORT_V1.test(port ?? "") && Object.hasOwn(table.views, view) ? { port, view } : undefined;
}

/** 🔗️ The reference a command closure holds for one provider closure: the provider group of the providers project, as a build named input reference. */
export function providerReferenceV1(project, port, view) {
  return { input: providerGroupNameV1(port, view), projects: [project] };
}

/** 🧲️ Reads one closure item as a provider reference (`{input, projects:[project]}` naming a provider group), or undefined for any other item. */
export function providerReferenceOfV1(item) {
  if (item === null || typeof item !== "object" || Array.isArray(item) || Object.keys(item).length !== 2 || !Array.isArray(item.projects) || item.projects.length !== 1 || typeof item.projects[0] !== "string") return undefined;
  const group = providerGroupOfV1(item.input);
  return group && { project: item.projects[0], ...group };
}

/** 📋️ The provider references of a closure value: a list, or a target-sources value whose `closure` is the list. */
export function providerReferencesOfV1(value) {
  return (Array.isArray(value) ? value : Array.isArray(value?.closure) ? value.closure : []).flatMap(item => { const reference = providerReferenceOfV1(item); return reference ? [reference] : []; });
}

/** 🔀️ Joins command input lists and reads every provider reference through `view` once, after the other items (a Rust command joins the target's own closure, read through `scheduling`, with the native command closure). */
export function joinWithProviderViewV1(lists, view) {
  const items = [], references = new Map();
  for (const list of lists) for (const item of list) { const reference = providerReferenceOfV1(item); if (reference) references.set(`${reference.project}\0${reference.port}`, providerReferenceV1(reference.project, reference.port, view)); else items.push(item); }
  return [...new Set(items), ...[...references.keys()].sort().map(key => references.get(key))];
}

/** 🧩️ A closure value whose provider references are replaced by the files of the provider closures they name, as the queries over a command closure (`some`, `excludedPaths`, `workspaceKeys`) see it. */
export function expandClosureValueV1(value, files) {
  const expand = list => [...new Set([...list.filter(item => !providerReferenceOfV1(item)), ...files])];
  return Array.isArray(value) ? expand(value) : value !== null && typeof value === "object" && Array.isArray(value.closure) ? { ...value, closure: expand(value.closure) } : value;
}

/** 🪪️ The name of the providers project from its configuration: it must declare the designation by its file name under the policy's metadata key; anything else is refused. */
export function providerProjectNameV1(json, designation) {
  if (json === null || typeof json !== "object" || typeof json.name !== "string" || !json.name || json.metadata?.semio?.[table.project.metadata] !== designation) throw refuseBuildV1("invalid", "closure.provider-project-required", { designation: String(designation) });
  return json.name;
}
