 "scopes": [
  {
   "name": "scopes are the root and every owner directory with a lock; members are normalized, globs and missing members skipped",
   "files": {
    "package.json": "{\"name\": \"r\", \"workspaces\": [\"pkgs/a\", \"pkgs/*\", \"gone\"], \"semio\": {\"workspace\": {\"owners\": [\"*/package.json\"]}}}",
    "bun.lock": "{\"lockfileVersion\":1,\"workspaces\":{\"\":{\"name\":\"r\"}},\"packages\":{}}",
    "pkgs/a/package.json": "{\"name\": \"a\"}",
    "s1/package.json": "{\"name\": \"s1\", \"workspaces\": [\"../pkgs/a\", \"m/\", \"./n\"]}",
    "s1/bun.lock": "{\"lockfileVersion\":1,\"workspaces\":{\"\":{\"name\":\"r\"}},\"packages\":{}}",
    "s1/m/package.json": "{\"name\": \"m\"}",
    "s1/n/package.json": "{\"name\":\"n\", // comment\n}",
    "s2/package.json": "{\"name\": \"s2\"}",
    "plain/readme.md": "x"
   },
   "expected": {
    "scopes": [
     {
      "scope": ".",
      "manifests": [
       "package.json",
       "pkgs/a/package.json"
      ]
     },
     {
      "scope": "s1",
      "manifests": [
       "package.json",
       "../pkgs/a/package.json",
       "m/package.json",
       "n/package.json"
      ]
     }
    ]
   }
  },
  {
   "name": "an owner pattern deeper than one level is refused by name",
   "files": {
    "package.json": "{\"name\": \"r\", \"semio\": {\"workspace\": {\"owners\": [\"**/package.json\"]}}}",
    "bun.lock": "{\"lockfileVersion\":1,\"workspaces\":{\"\":{\"name\":\"r\"}},\"packages\":{}}"
   },
   "expected": {
    "error": "Declared one-level dependency scope owner pattern required: **/package.json"
   }
  }
 ],
 "staged": [
  {
   "name": "a staged lock names the original member behind w/<index>",
   "scope": "s1",
   "members": [
    "../a",
    "b"
   ],
   "manifest": {
    "name": "r",
    "workspaces": [
     "w/0",
     "w/1"
    ]
   },
   "projected": {
    "w/0": {
     "name": "a"
    },
    "w/1": {
     "name": "b",
     "dependencies": {
      "x": "1"
     }
    }
   },
   "lock": "{\"lockfileVersion\":1,\"workspaces\":{\"\":{\"name\":\"r\"},\"w/0\":{\"name\":\"a\"},\"w/1\":{\"name\":\"b\"}},\"packages\":{\"a\":[\"a@workspace:w/0\"],\"b\":[\"b@workspace:w/1\"]}}",
   "expected": [
    {
     "kind": "missing-in-lock",
     "manifest": "b/package.json",
     "section": "dependencies",
     "dependency": "x",
     "manifestVersion": "1",
     "frozen": true
    }
   ]
  },
  {
   "name": "a staged lock that lacks a member row is a workspace finding of that member",
   "scope": ".",
   "members": [
    "pkgs/a",
    "pkgs/b/"
   ],
   "manifest": {
    "name": "r",
    "workspaces": [
     "w/0",
     "w/1"
    ]
   },
   "projected": {
    "w/0": {
     "name": "a"
    },
    "w/1": {
     "name": "b"
    }
   },
   "lock": "{\"lockfileVersion\":1,\"workspaces\":{\"\":{\"name\":\"r\"},\"w/0\":{\"name\":\"a\"}},\"packages\":{\"a\":[\"a@workspace:w/0\"]}}",
   "expected": [
    {
     "kind": "workspace-missing",
     "manifest": "pkgs/b/package.json",
     "frozen": true
    }
   ]
  },
  {
   "name": "an in-sync staged lock has no finding",
   "scope": ".",
   "members": [
    "pkgs/a"
   ],
   "manifest": {
    "name": "r",
    "workspaces": [
     "w/0"
    ]
   },
   "projected": {
    "w/0": {
     "name": "a"
    }
   },
   "lock": "{\"lockfileVersion\":1,\"workspaces\":{\"\":{\"name\":\"r\"},\"w/0\":{\"name\":\"a\"}},\"packages\":{\"a\":[\"a@workspace:w/0\"]}}",
   "expected": []
  }
 ],
