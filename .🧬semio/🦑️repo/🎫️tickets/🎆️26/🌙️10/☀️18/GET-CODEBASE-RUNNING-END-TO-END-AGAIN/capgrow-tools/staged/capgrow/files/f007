        fits=lambda jobs:(cost_observed(jobs)<=free_observed and cost_budget(jobs)<=free_budget) or (replaced is not None and cost_observed(jobs)<=unrealized_of(replaced) and cost_budget(jobs)<=committed_of(replaced))
        def refuse(reason):
