{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Input Precision Fixture",
  "description": "🧫️ The language-agnostic cases of the input precision engine: every implementation answers the same globs, command words, JSONC documents, dispatcher branches, package names and derivations over one in-memory workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["globs", "commands", "jsonc", "dispatch", "packageNames", "workspace", "document", "derive", "unselected", "refusals", "expect"],
  "properties": {
    "globs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["pattern", "path", "match"], "properties": { "pattern": { "type": "string" }, "path": { "type": "string" }, "match": { "type": "boolean" } } } },
    "commands": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["command", "words"], "properties": { "command": { "type": "string" }, "words": { "type": ["object", "null"] } } } },
    "jsonc": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["text", "value"], "properties": { "text": { "type": "string" }, "value": {} } } },
    "dispatch": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "type": "string" } } } },
    "packageNames": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["manifest", "name"], "properties": { "manifest": { "type": "string" }, "name": { "type": ["string", "null"] } } } },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "kinds", "cargoRoots", "cargoSources", "cargoToolchain"],
      "properties": {
        "files": { "type": "object", "additionalProperties": { "type": "string" } },
        "kinds": { "type": "object" },
        "cargoRoots": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "cargoSources": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "cargoToolchain": { "type": "array", "items": { "type": "string" } }
      }
    },
    "document": { "type": "object" },
    "derive": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["identity"], "properties": { "identity": { "type": "object" } } } },
    "unselected": { "type": "array", "items": { "type": "object" } },
    "refusals": { "type": "array", "items": { "type": "object" } },
    "expect": { "type": "object" }
  }
}
