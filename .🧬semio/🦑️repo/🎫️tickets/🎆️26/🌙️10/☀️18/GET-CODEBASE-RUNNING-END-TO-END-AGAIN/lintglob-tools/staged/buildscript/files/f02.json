  {
   "name": "path-mount-outside-the-package-directory",
   "mechanism": "path attribute on a mod",
   "crate": "owner/📦️packages/🦀️rust",
   "files": {
    "owner/📦️packages/🦀️rust/Cargo.toml": "[package]\nname = \"retained\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\npath = \"🦀️.rs\"\n",
    "owner/📦️packages/🦀️rust/🦀️.rs": "//! glue\n\n/// 🔏️ doc comment above the mount.\n#[path = \"../../🦀️.rs\"]\npub mod retained;\n",
    "owner/🦀️.rs": "#[path=\"✂️span/🦀️.rs\"] pub mod span;\n#[path = \"🩹️patch/🦀️.rs\"] pub mod patch;\n",
    "owner/✂️span/🦀️.rs": "pub fn span() {}\n",
    "owner/🩹️patch/🦀️.rs": "#[path=\"🚚️apply/🦀️.rs\"] mod apply;\n",
    "owner/🩹️patch/🚚️apply/🦀️.rs": "pub fn apply() {}\n"
   },
   "flavor": "named",
   "resolved": true,
   "expected": [
    "owner/📦️packages/🦀️rust/🦀️.rs",
    "owner/🦀️.rs",
    "owner/✂️span/🦀️.rs",
    "owner/🩹️patch/🦀️.rs",
    "owner/🩹️patch/🚚️apply/🦀️.rs"
   ],
   "outside": [
    "owner/🦀️.rs",
    "owner/✂️span/🦀️.rs",
    "owner/🩹️patch/🦀️.rs",
    "owner/🩹️patch/🚚️apply/🦀️.rs"
   ]
