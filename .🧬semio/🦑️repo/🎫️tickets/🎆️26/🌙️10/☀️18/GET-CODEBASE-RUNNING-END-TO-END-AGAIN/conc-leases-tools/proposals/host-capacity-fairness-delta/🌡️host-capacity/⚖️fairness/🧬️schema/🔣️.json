{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/host-capacity-fairness/v1",
  "title": "Host capacity fairness: bounded bypass and starvation guard",
  "definitions": {
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "bypassMilliseconds", "maximumBypasses", "agingMilliseconds"],
      "properties": {
        "version": { "const": 1 },
        "bypassMilliseconds": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "maximumBypasses": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "agingMilliseconds": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      }
    },
    "Authored": {
      "const": { "version": 1, "bypassMilliseconds": 30000, "maximumBypasses": 6, "agingMilliseconds": 300000 }
    }
  }
}
