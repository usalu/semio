{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Language Selection",
  "description": "The language protocol of the repository (explicit variable, preference list, locale variables) or an explicit choice resolves the language. Otherwise interactive startup requires an explicit selection; choice order never selects a language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "choices",
    "prompt",
    "messages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "name"
        ],
        "properties": {
          "language": {
            "enum": [
              "en",
              "de"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "language"
            ],
            "properties": {
              "language": {
                "const": "en"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "language"
            ],
            "properties": {
              "language": {
                "const": "de"
              }
            }
          }
        }
      ]
    },
    "prompt": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saving",
        "saveFailed",
        "disconnected",
        "terminalUnavailable",
        "required",
        "cancelled"
      ],
      "properties": {
        "saving": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "saveFailed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "disconnected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "terminalUnavailable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "required": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "cancelled": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    }
  }
}
