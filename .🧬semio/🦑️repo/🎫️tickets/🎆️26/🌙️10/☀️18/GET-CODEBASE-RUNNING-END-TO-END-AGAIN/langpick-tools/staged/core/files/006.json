{
  "version": 1,
  "languages": ["en", "de"],
  "notices": "A notice reads the arguments and the environment of a row but never its operating system list: its language is the row resolved without `os`, or every offered language (withoutChoice.notices).",
  "resolve": [
    {"name": "flag wins over everything", "args": ["--lang", "de"], "environment": {"SEMIO_LANGUAGE": "en", "LANG": "en_US.UTF-8"}, "os": ["en-US"], "expected": {"language": "de", "source": "--lang"}},
    {"name": "flag with equals sign", "args": ["show", "--lang=en"], "environment": {"SEMIO_LANGUAGE": "de"}, "os": [], "expected": {"language": "en", "source": "--lang"}},
    {"name": "flag after the separator belongs to the child", "args": ["--", "--lang=fr"], "environment": {"SEMIO_LANGUAGE": "de"}, "os": [], "expected": {"language": "de", "source": "SEMIO_LANGUAGE"}},
    {"name": "last flag wins", "args": ["--lang=en", "--lang=de"], "environment": {}, "os": [], "expected": {"language": "de", "source": "--lang"}},
    {"name": "explicit variable with a locale spelling", "args": [], "environment": {"SEMIO_LANGUAGE": "de_CH.UTF-8", "LANG": "en_US.UTF-8"}, "os": [], "expected": {"language": "de", "source": "SEMIO_LANGUAGE"}},
    {"name": "preference list skips unoffered entries", "args": [], "environment": {"LANGUAGE": "fr:de:en", "LANG": "en_US.UTF-8"}, "os": [], "expected": {"language": "de", "source": "LANGUAGE"}},
    {"name": "neutral entries of the preference list carry no language", "args": [], "environment": {"LANGUAGE": "C:POSIX", "LC_MESSAGES": "de_DE"}, "os": [], "expected": {"language": "de", "source": "LC_MESSAGES"}},
    {"name": "LC_ALL decides before LC_MESSAGES and LANG", "args": [], "environment": {"LC_ALL": "de_DE.UTF-8", "LC_MESSAGES": "en_US", "LANG": "en_US"}, "os": [], "expected": {"language": "de", "source": "LC_ALL"}},
    {"name": "empty LC_ALL is unset", "args": [], "environment": {"LC_ALL": "", "LANG": "en_GB.UTF-8@euro"}, "os": [], "expected": {"language": "en", "source": "LANG"}},
    {"name": "LC_ALL=C overrides LANG and falls through to the operating system", "args": [], "environment": {"LC_ALL": "C", "LANG": "de_DE.UTF-8"}, "os": ["de-DE"], "expected": {"language": "de", "source": "os"}},
    {"name": "an unoffered locale falls through to the operating system", "args": [], "environment": {"LANG": "fr_FR.UTF-8"}, "os": ["fr-FR", "en-US"], "expected": {"language": "en", "source": "os"}},
    {"name": "operating system list in preference order", "args": [], "environment": {}, "os": ["it-IT", "de-CH", "en-US"], "expected": {"language": "de", "source": "os"}},
    {"name": "POSIX locale and an empty operating system list resolve nothing", "args": [], "environment": {"LANG": "POSIX"}, "os": [], "refusal": "none"},
    {"name": "empty environment resolves nothing", "args": [], "environment": {}, "os": [], "refusal": "none"},
    {"name": "unoffered flag is refused", "args": ["--lang=fr"], "environment": {"SEMIO_LANGUAGE": "de"}, "os": [], "refusal": "flag"},
    {"name": "flag without a value is refused", "args": ["--lang"], "environment": {}, "os": ["en-US"], "refusal": "flag"},
    {"name": "unoffered explicit variable is refused", "args": [], "environment": {"SEMIO_LANGUAGE": "fr"}, "os": ["en-US"], "refusal": "variable"},
    {"name": "LANGUAGE decides before the locale variables", "args": [], "environment": {"LANGUAGE": "de", "LC_ALL": "en_US.UTF-8"}, "os": [], "expected": {"language": "de", "source": "LANGUAGE"}},
    {"name": "LC_MESSAGES decides when LC_ALL is unset", "args": [], "environment": {"LC_MESSAGES": "de_DE.UTF-8", "LANG": "en_US.UTF-8"}, "os": [], "expected": {"language": "de", "source": "LC_MESSAGES"}},
    {"name": "an unoffered LC_ALL hides LANG", "args": [], "environment": {"LC_ALL": "fr_FR.UTF-8", "LANG": "de_DE.UTF-8"}, "os": [], "refusal": "none"},
    {"name": "the operating system decides when the environment names nothing", "args": [], "environment": {}, "os": ["de-CH", "en-US"], "expected": {"language": "de", "source": "os"}},
    {"name": "the retired dashboard variable chooses nothing", "args": [], "environment": {"SEMIO_DASHBOARD_LOCALE": "de", "LANG": "en_US.UTF-8"}, "os": [], "expected": {"language": "en", "source": "LANG"}},
    {"name": "SEMIO_LOCALE chooses nothing", "args": [], "environment": {"SEMIO_LOCALE": "de"}, "os": [], "refusal": "none"},
    {"name": "an unoffered explicit variable is refused although the locale names an offered language", "args": [], "environment": {"SEMIO_LANGUAGE": "fr", "LANG": "de_DE.UTF-8"}, "os": [], "refusal": "variable"},
    {"name": "an empty explicit variable is unset", "args": [], "environment": {"SEMIO_LANGUAGE": "", "LC_MESSAGES": "de"}, "os": [], "expected": {"language": "de", "source": "LC_MESSAGES"}},
    {"name": "blanks around the explicit variable", "args": [], "environment": {"SEMIO_LANGUAGE": " de "}, "os": [], "expected": {"language": "de", "source": "SEMIO_LANGUAGE"}},
    {"name": "a preference list with an empty first entry", "args": [], "environment": {"LANGUAGE": ":de:en"}, "os": [], "expected": {"language": "de", "source": "LANGUAGE"}},
    {"name": "a three-letter tag is not its two-letter prefix", "args": [], "environment": {"LANG": "den_CA.UTF-8"}, "os": [], "refusal": "none"},
    {"name": "the flag decides although the explicit variable is unoffered", "args": ["--lang", "en"], "environment": {"SEMIO_LANGUAGE": "fr"}, "os": [], "expected": {"language": "en", "source": "--lang"}}
  ],
  "tags": [
    ["de_CH.UTF-8@euro", "de"],
    ["en-US", "en"],
    ["EN_gb", "en"],
    ["zh-Hans-CN", "zh"],
    ["pt_BR", "pt"]
  ],
  "neutral": ["C", "POSIX", "c", "", "  "]
}
