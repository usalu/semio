{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:leases-status-corpus:v1",
  "title": "Leases Status Corpus",
  "description": "Language-agnostic cases for `repo leases status`: argument vectors with the kind of outcome (text lines, one JSON document or a refusal message), the repository lease directory and the bounds of the admission floor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "leaseDirectory", "floorMegabytes", "commands"],
  "properties": {
    "version": { "const": 1 },
    "leaseDirectory": { "type": "string", "minLength": 1 },
    "floorMegabytes": { "type": "object", "additionalProperties": false, "required": ["minimum"], "properties": { "minimum": { "type": "integer", "minimum": 1 } } },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["args", "outcome"],
        "properties": { "args": { "type": "array", "items": { "type": "string" } }, "outcome": { "enum": ["text", "json", "throw"] }, "message": { "type": "string", "minLength": 1 } },
        "if": { "properties": { "outcome": { "const": "throw" } } },
        "then": { "required": ["message"] }
      }
    }
  }
}
