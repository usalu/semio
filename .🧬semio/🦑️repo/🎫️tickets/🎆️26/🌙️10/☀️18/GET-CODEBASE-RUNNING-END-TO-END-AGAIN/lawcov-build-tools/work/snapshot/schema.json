{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:authorizer-snapshot-corpus:v1",
  "title": "Authorizer Snapshot Corpus",
  "description": "Language-agnostic cases for captured authorizer snapshots: faults injected into a snapshot built from declared sources, the import closure of a small workspace, and the closed entry roles and targets of the compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "snapshots", "knownDefects", "workspace", "roles"],
  "properties": {
    "version": { "const": 1 },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sources", "entry", "patch", "error"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
          "entry": { "type": "string" },
          "manifest": { "type": "object" },
          "patch": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "extra": { "type": "integer" }, "version": { "type": "integer" }, "dropFile": { "type": "integer", "minimum": 0 }, "addFile": { "type": "string" } }
          },
          "error": { "type": "string" }
        }
      }
    },
    "knownDefects": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "sources", "entry", "patch", "error"], "properties": { "name": { "type": "string" }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } }, "entry": { "type": "string" }, "patch": { "type": "object" }, "error": { "type": "string" } } } },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "entry", "closure"],
      "properties": { "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } }, "entry": { "type": "string" }, "closure": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "refused", "targets"],
      "properties": {
        "valid": { "type": "array", "items": { "enum": ["module", "program"] } },
        "refused": { "type": "array" },
        "targets": { "type": "object", "additionalProperties": false, "required": ["valid", "refused"], "properties": { "valid": { "type": "array", "items": { "enum": ["node", "bun"] } }, "refused": { "type": "array" } } }
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string" } } },
            { "type": "object", "additionalProperties": false, "required": ["repeat", "times"], "properties": { "repeat": { "type": "string", "minLength": 1 }, "times": { "type": "integer", "minimum": 1, "maximum": 4194304 } } }
          ]
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "base64": { "type": "string" }
      }
    }
  }
}
