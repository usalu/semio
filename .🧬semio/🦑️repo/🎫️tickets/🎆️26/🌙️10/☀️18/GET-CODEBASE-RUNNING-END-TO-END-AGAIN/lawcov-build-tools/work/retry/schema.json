{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:graph-retry-extra-corpus:v1",
  "title": "Graph Retry Diagnostic Extra Corpus",
  "description": "Language-agnostic cases for the bounded graph retry diagnostic: declared reason and digests, observed stale facts, the digests the observer sees now (keyed by path relative to the root) and an authored refusal message.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "root", "cases"],
  "properties": {
    "version": { "const": 1 },
    "root": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason", "before", "after", "stale", "current", "error"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" },
          "before": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
          "after": { "anyOf": [{ "type": "null" }, { "type": "string" }] },
          "stale": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "fact"], "properties": { "kind": { "type": "string" }, "path": { "type": "string" }, "fact": { "type": "object" } } } },
          "current": { "type": "object", "additionalProperties": { "type": "string" } },
          "error": { "type": "string" }
        }
      }
    }
  }
}
