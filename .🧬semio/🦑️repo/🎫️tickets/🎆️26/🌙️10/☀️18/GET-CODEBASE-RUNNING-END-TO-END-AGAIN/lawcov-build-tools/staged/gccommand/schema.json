{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:cache-command-arguments-corpus:v1",
  "title": "Cache Command Arguments Corpus",
  "description": "Language-agnostic argument vectors for `repo cache status|gc`, the ledger whose area ids are legal, authored parses and authored refusals (message key and variables).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ledger", "vectors", "authored", "refused"],
  "properties": {
    "version": { "const": 1 },
    "ledger": { "type": "object" },
    "vectors": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "type": "string" } } },
    "authored": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["args", "parsed"], "properties": { "args": { "type": "array", "items": { "type": "string" } }, "parsed": { "type": "object", "additionalProperties": false, "required": ["operation", "json", "dryRun", "only", "language"], "properties": { "operation": { "enum": ["status", "gc"] }, "json": { "type": "boolean" }, "dryRun": { "type": "boolean" }, "only": { "anyOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }] }, "language": { "anyOf": [{ "type": "null" }, { "type": "string" }] } } } } } },
    "refused": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["args", "key", "variables"], "properties": { "args": { "type": "array", "items": { "type": "string" } }, "key": { "enum": ["error.syntax", "error.option", "error.repeated", "error.value", "error.area", "error.areaEmpty"] }, "variables": { "type": "object", "additionalProperties": { "type": "string" } } } } }
  }
}
