{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:funded-workspace-corpus:v1",
  "title": "Funded Compiler Workspace Corpus",
  "description": "Language-agnostic cases for the funded compiler scratch plan: a request, whether the scratch directory is one unit directly below the mode's units directory with its own `.tmp` sibling, or a refusal message.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "request", "expected", "error"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "request": { "type": "object", "additionalProperties": false, "required": ["version", "root", "mode", "directory", "temporary", "platform"], "properties": { "version": { "type": "integer" }, "root": { "type": "string" }, "mode": { "type": "string" }, "directory": { "type": "string" }, "temporary": { "type": "string" }, "platform": { "type": "string" } } },
          "expected": { "type": "boolean" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
