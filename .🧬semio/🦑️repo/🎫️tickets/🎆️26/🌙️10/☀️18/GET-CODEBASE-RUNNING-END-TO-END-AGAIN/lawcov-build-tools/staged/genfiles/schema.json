{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:generation-files-window-corpus:v1",
  "title": "Generation Files Window Corpus",
  "description": "Language-agnostic scenarios for the generation file port: sequences of operations with a recheck window and refused rechecks, and concurrent workloads with a slow recheck; an independent model derives which operations are refused and how many rechecks may run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "defaultWindow", "sequences", "concurrent"],
  "properties": {
    "version": { "const": 1 },
    "defaultWindow": { "type": "integer", "minimum": 1 },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "window", "operations", "failRechecks"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "window": { "type": "integer", "minimum": 1 },
          "operations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "enum": ["read", "write", "names", "list", "remove"] }, "path": { "type": "string", "pattern": "^/store/" } } } },
          "failRechecks": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "concurrent": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "workers", "each", "window", "sleepMs"], "properties": { "name": { "type": "string" }, "workers": { "type": "integer", "minimum": 1 }, "each": { "type": "integer", "minimum": 1 }, "window": { "type": "integer", "minimum": 1 }, "sleepMs": { "type": "integer", "minimum": 0 } } } }
  }
}
