{
 "schemaVersion": 1,
 "measure": [
  {
   "name": "hardlinks count once, links never, recency from files only",
   "limit": 1000,
   "entries": [
    {
     "kind": "file",
     "path": "a.bin",
     "size": 5000,
     "ageHours": 72
    },
    {
     "kind": "file",
     "path": "deep/er/b.bin",
     "size": 100,
     "ageHours": 216
    },
    {
     "kind": "hardlink",
     "path": "hard.bin",
     "of": "a.bin"
    },
    {
     "kind": "symlink",
     "path": "link",
     "to": "@outside"
    },
    {
     "kind": "dir",
     "path": "deep",
     "ageHours": 0
    }
   ],
   "outside": [
    {
     "kind": "file",
     "path": "huge.bin",
     "size": 100000,
     "ageHours": 1
    }
   ],
   "expected": {
    "present": true,
    "countedGroups": [
     [
      "a.bin",
      "hard.bin"
     ],
     [
      "deep/er/b.bin"
     ]
    ],
    "entries": 6,
    "partial": false,
    "sqlite": [],
    "queues": [],
    "recencyAgeHours": 72
   }
  },
  {
   "name": "sqlite lease files and queue directories are found at any depth",
   "limit": 1000,
   "entries": [
    {
     "kind": "file",
     "path": "x.sqlite",
     "size": 10,
     "ageHours": 5
    },
    {
     "kind": "file",
     "path": "sub/y.sqlite",
     "size": 10,
     "ageHours": 6
    },
    {
     "kind": "file",
     "path": "sub/z.db",
     "size": 10,
     "ageHours": 7
    },
    {
     "kind": "file",
     "path": "q/a.queue/ticket",
     "size": 1,
     "ageHours": 8
    },
    {
     "kind": "file",
     "path": "deep/er/b.queue/t",
     "size": 1,
     "ageHours": 9
    },
    {
     "kind": "dir",
     "path": "plain.queued"
    }
   ],
   "expected": {
    "present": true,
    "countedGroups": [
     [
      "x.sqlite"
     ],
     [
      "sub/y.sqlite"
     ],
     [
      "sub/z.db"
     ],
     [
      "q/a.queue/ticket"
     ],
     [
      "deep/er/b.queue/t"
     ]
    ],
    "entries": 12,
    "partial": false,
    "sqlite": [
     "sub/y.sqlite",
     "x.sqlite"
    ],
    "queues": [
     "deep/er/b.queue",
     "q/a.queue"
    ],
    "recencyAgeHours": 5
   }
  },
  {
   "name": "an empty directory has no files so its own time is its recency",
   "limit": 10,
   "entries": [
    {
     "kind": "dir",
     "path": "",
     "ageHours": 30
    }
   ],
   "expected": {
    "present": true,
    "countedGroups": [],
    "entries": 0,
    "partial": false,
    "sqlite": [],
    "queues": [],
    "recencyAgeHours": 30
   }
  },
  {
   "name": "a missing path is absent",
   "limit": 10,
   "entries": [],
   "missing": true,
   "expected": {
    "present": false,
    "countedGroups": [],
    "entries": 0,
    "partial": false,
    "sqlite": [],
    "queues": [],
    "recencyAgeHours": null
   }
  },
  {
   "name": "a path that is one sqlite file measures as itself",
   "limit": 10,
   "singleFile": "one.sqlite",
   "entries": [
    {
     "kind": "file",
     "path": "one.sqlite",
     "size": 4000,
     "ageHours": 12
    }
   ],
   "expected": {
    "present": true,
    "countedGroups": [
     [
      "one.sqlite"
     ]
    ],
    "entries": 1,
    "partial": false,
    "sqlite": [
     "one.sqlite"
    ],
    "queues": [],
    "recencyAgeHours": 12
   }
  },
  {
   "name": "only links inside a tree count nothing",
   "limit": 10,
   "entries": [
    {
     "kind": "symlink",
     "path": "l1",
     "to": "@outside/target.bin"
    },
    {
     "kind": "symlink",
     "path": "l2",
     "to": "@outside"
    }
   ],
   "outside": [
    {
     "kind": "file",
     "path": "target.bin",
     "size": 9000,
     "ageHours": 1
    }
   ],
   "expected": {
    "present": true,
    "countedGroups": [],
    "entries": 2,
    "partial": false,
    "sqlite": [],
    "queues": [],
    "recencyAgeHours": null
   }
  },
  {
   "name": "the entry limit makes a partial walk that stops one entry past the limit",
   "limit": 4,
   "entries": [
    {
     "kind": "file",
     "path": "f0",
     "size": 10,
     "ageHours": 1
    },
    {
     "kind": "file",
     "path": "f1",
     "size": 10,
     "ageHours": 2
    },
    {
     "kind": "file",
     "path": "f2",
     "size": 10,
     "ageHours": 3
    },
    {
     "kind": "file",
     "path": "f3",
     "size": 10,
     "ageHours": 4
    },
    {
     "kind": "file",
     "path": "f4",
     "size": 10,
     "ageHours": 5
    },
    {
     "kind": "file",
     "path": "f5",
     "size": 10,
     "ageHours": 6
    },
    {
     "kind": "file",
     "path": "f6",
     "size": 10,
     "ageHours": 7
    },
    {
     "kind": "file",
     "path": "f7",
     "size": 10,
     "ageHours": 8
    },
    {
     "kind": "file",
     "path": "f8",
     "size": 10,
     "ageHours": 9
    },
    {
     "kind": "file",
     "path": "f9",
     "size": 10,
     "ageHours": 10
    }
   ],
   "expected": {
    "present": true,
    "countedGroups": null,
    "entries": 5,
    "partial": true,
    "sqlite": [],
    "queues": [],
    "recencyAgeHours": null
   }
  }
 ],
 "held": [
  {
   "name": "a live queue ticket holds the tree",
   "entries": [
    {
     "kind": "file",
     "path": "q/a.queue/0000000abc-000039u-owner",
     "size": 1,
     "ageHours": 72
    }
   ],
   "alive": [
    4242
   ],
   "heldSqlite": [],
   "expected": "pid:4242"
  },
  {
   "name": "a dead queue ticket does not",
   "entries": [
    {
     "kind": "file",
     "path": "q/a.queue/0000000abc-000039v-owner",
     "size": 1,
     "ageHours": 72
    }
   ],
   "alive": [
    4242
   ],
   "heldSqlite": [],
   "expected": null
  },
  {
   "name": "names that are not tickets never hold",
   "entries": [
    {
     "kind": "file",
     "path": "q/a.queue/not-a-ticket",
     "size": 1,
     "ageHours": 72
    },
    {
     "kind": "file",
     "path": "q/a.queue/0000000abc-000039u",
     "size": 1,
     "ageHours": 72
    },
    {
     "kind": "file",
     "path": "q/a.queue/0000000abc-000039U-owner",
     "size": 1,
     "ageHours": 72
    },
    {
     "kind": "file",
     "path": "q/a.queue/0000000abc-000039u-",
     "size": 1,
     "ageHours": 72
    }
   ],
   "alive": [
    4242
   ],
   "heldSqlite": [],
   "expected": null
  },
  {
   "name": "process zero never holds",
   "entries": [
    {
     "kind": "file",
     "path": "q/a.queue/0000000abc-0000000-owner",
     "size": 1,
     "ageHours": 72
    }
   ],
   "alive": [
    0
   ],
   "heldSqlite": [],
   "expected": null
  },
  {
   "name": "a directory that is not named .queue is no queue",
   "entries": [
    {
     "kind": "file",
     "path": "q/a.queue2/0000000abc-000039u-owner",
     "size": 1,
     "ageHours": 72
    },
    {
     "kind": "file",
     "path": "q/queue/0000000abc-000039u-owner",
     "size": 1,
     "ageHours": 72
    }
   ],
   "alive": [
    4242
   ],
   "heldSqlite": [],
   "expected": null
  },
  {
   "name": "a queue deep inside holds the tree",
   "entries": [
    {
     "kind": "file",
     "path": "d/e/x.queue/0000000abc-000039u-owner",
     "size": 1,
     "ageHours": 72
    }
   ],
   "alive": [
    4242
   ],
   "heldSqlite": [],
   "expected": "pid:4242"
  },
  {
   "name": "a locked sqlite file is named before any queue",
   "entries": [
    {
     "kind": "file",
     "path": "s/db.sqlite",
     "size": 10,
     "ageHours": 72
    },
    {
     "kind": "file",
     "path": "q/a.queue/0000000abc-000039u-owner",
     "size": 1,
     "ageHours": 72
    }
   ],
   "alive": [
    4242
   ],
   "heldSqlite": [
    "s/db.sqlite"
   ],
   "expected": "sqlite:s/db.sqlite"
  },
  {
   "name": "a free sqlite file and no queue hold nothing",
   "entries": [
    {
     "kind": "file",
     "path": "s/db.sqlite",
     "size": 10,
     "ageHours": 72
    }
   ],
   "alive": [],
   "heldSqlite": [],
   "expected": null
  }
 ],
