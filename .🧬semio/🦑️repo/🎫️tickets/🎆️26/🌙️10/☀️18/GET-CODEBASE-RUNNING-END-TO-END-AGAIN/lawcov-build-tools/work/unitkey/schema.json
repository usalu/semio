{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:unit-cache-key-corpus:v1",
  "title": "Unit Cache Key Corpus",
  "description": "Language-agnostic inputs for the unit cache key: rustc command lines (hand-written and seeded pseudo-random), lane texts, environments, dependency files, build script output, key inputs, hashed texts, response files and admission requests. Expected answers come from independent oracles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cwd", "laneRoot", "externDigests", "vectors", "lanes", "environments", "depinfo", "directives", "keys", "hashes", "responses", "admit"],
  "properties": {
    "version": { "const": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "laneRoot": { "type": "string", "minLength": 1 },
    "externDigests": { "type": "object", "additionalProperties": { "type": "string" } },
    "vectors": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "type": "string" } } },
    "lanes": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["text", "root"], "properties": { "text": { "type": "string" }, "root": { "anyOf": [{ "type": "null" }, { "type": "string" }] } } } },
    "environments": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": { "type": "string" } } },
    "depinfo": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "directives": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "keys": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["toolchain", "normalized", "sourceSha256", "externs", "environment"], "properties": { "toolchain": { "type": "string" }, "normalized": { "type": "array", "items": { "type": "string" } }, "sourceSha256": { "type": "string" }, "externs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": { "name": { "type": "string" }, "sha256": { "type": "string" } } } }, "environment": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } } } } } },
    "hashes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "responses": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "files", "args"], "properties": { "name": { "type": "string" }, "files": { "type": "object", "additionalProperties": { "type": "string" } }, "args": { "type": "array", "items": { "type": "string" } } } } },
    "admit": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["args", "environment"], "properties": { "args": { "type": "array", "items": { "type": "string" } }, "environment": { "type": "object", "additionalProperties": { "type": "string" } } } } }
  }
}
