{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:caching:recency-corpus:v1",
  "title": "Recency Corpus",
  "description": "Language-agnostic cases for recency summaries, the diagnostic byte funding decision and the retirement mismatch report. `generate` names a count of rows p0000.. with access time equal to their index.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "summaries", "funding", "describe"],
  "properties": {
    "version": { "const": 1 },
    "summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rows", "error"],
        "properties": { "name": { "type": "string", "minLength": 1 }, "rows": { "type": "array", "items": { "$ref": "#/definitions/file" } }, "generate": { "type": "integer", "minimum": 1 }, "error": { "type": "string" } }
      }
    },
    "funding": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["used", "bytes", "expected"], "properties": { "used": { "type": "number" }, "bytes": { "type": "number" }, "expected": { "type": "boolean" } } } },
    "describe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "root", "expected", "current"],
        "properties": { "name": { "type": "string", "minLength": 1 }, "root": { "type": "string" }, "expected": { "$ref": "#/definitions/unit" }, "current": { "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/unit" }] } }
      }
    }
  },
  "definitions": {
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "device", "inode", "bytes", "atimeNs", "mtimeNs", "ctimeNs"], "properties": { "path": { "type": "string" }, "device": { "type": "string" }, "inode": { "type": "string" }, "bytes": { "type": "string" }, "atimeNs": { "type": "string" }, "mtimeNs": { "type": "string" }, "ctimeNs": { "type": "string" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["path", "device", "inode", "bytes", "atimeNs", "mtimeNs", "ctimeNs", "field"], "properties": { "path": { "type": "string" }, "device": { "type": "string" }, "inode": { "type": "string" }, "bytes": { "type": "string" }, "atimeNs": { "type": "string" }, "mtimeNs": { "type": "string" }, "ctimeNs": { "type": "string" }, "field": { "enum": ["atimeNs", "mtimeNs"] } } },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "recencyMs", "lockHeld"],
      "properties": {
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "recencyMs": { "type": "number", "minimum": 0 },
        "lockHeld": { "type": "boolean" },
        "recencySource": { "$ref": "#/definitions/source" }
      }
    }
  }
}
