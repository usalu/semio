{
  "$id": "semio:build-test-envelope:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner", "maximumElapsedMilliseconds", "capabilities"],
  "properties": {
    "owner": { "type": "string", "minLength": 1 },
    "maximumElapsedMilliseconds": { "type": "integer", "minimum": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifacts": { "const": true },
        "command": { "type": "string", "minLength": 1 },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "arguments", "scratch"],
          "properties": {
            "kind": { "enum": ["native-build-caller"] },
            "arguments": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "scratch": { "enum": ["sandbox", "checkout"] }
          }
        }
      }
    }
  }
}
