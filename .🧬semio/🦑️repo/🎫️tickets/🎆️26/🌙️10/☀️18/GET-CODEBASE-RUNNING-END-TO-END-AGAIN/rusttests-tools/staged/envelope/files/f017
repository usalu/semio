const owner=fileURLToPath(new URL("../🟦️.ts",import.meta.url)),policy=fileURLToPath(new URL("../🧬️schema/🔣️.json",import.meta.url)),routing=fileURLToPath(new URL("../../../../../../../../../🔨️modules/🏃️process/📦️packages/🟦️typescript/🧭️routing/🟦️.ts",import.meta.url));
function oracle(){const db=new Database(":memory:");db.exec("create table projects(name text,position integer);create index project_names on projects(name);create table refs(source text,target text,position integer);create index referenced_names on refs(target);create table members(source text,target text,primary key(source,target));create table wanted(source text,target text,position integer)");return db;}
function project(db:Database,rows:readonly Project[]){db.exec("delete from projects;delete from refs;delete from wanted");let edge=0;db.transaction(()=>{for(const[index,row]of rows.entries()){db.query("insert into projects values(?,?)").run(row.name,index);for(const ref of row.dependencies)db.query("insert into refs values(?,?,?)").run(row.name,ref.slice(0,ref.indexOf(":")),edge++);}})();return edge;}
function expected(db:Database,owner:string,rows:readonly Project[]){const count=project(db,rows),roots=(db.query("select name from projects where not exists(select 1 from refs where target=projects.name) order by position").all()as{name:string}[]).map(row=>row.name);db.exec("insert into wanted select source,target,min(position) from refs group by source,target order by min(position)");for(const[index,name]of roots.entries())db.query("insert into wanted values(?,?,?)").run(owner,name,count+index);const dependencies=(db.query("select source,target,'implicit' type from wanted where not exists(select 1 from members where source=wanted.source and target=wanted.target) order by position").all()as{source:string;target:string;type:"implicit"}[]);db.exec("insert or ignore into members select source,target from wanted");return{roots,dependencies};}
async function child(program:string,original:ScriptInvocation,control:ResourceLeaseControl){const result=await captureOwnedCommandResultV1(process.execPath,["-e",program],process.cwd(),{control,env:{...scriptInvocationEnvironment(original,process.env),BUN_RUNTIME_TRANSPILER_CACHE_PATH:"0",NODE_DISABLE_COMPILE_CACHE:"1"},output:{maximumBytes:16384,maximumLines:128}});expect(result.signal).toBeNull();if(!result.stdout.trim())throw Error("Actual graph child omitted terminal DATA: "+result.stderr);return{status:result.status,stderr:result.stderr,data:JSON.parse(result.stdout.trim().split("\n").at(-1)??"")};}
const prelude=`const owner=await import(${JSON.stringify(owner)}),routing=await import(${JSON.stringify(routing)});`;
test("neutral selected Rust graph assembly corpus agrees with independent relational roots and pairs",()=>{const ajv=new Ajv({strict:true});expect(ajv.validate(corpusSchema,corpus)).toBe(true);expect(schema.definitions.Policy.const.maximumDependencies).toBe(planSchema.definitions.Plan.properties.dependencyDigests.maxItems);expect(graphPolicy.maximumSnapshotBytes).toBe(536870912);for(const row of corpus.cases){const db=oracle();try{for(const edge of row.seed)db.query("insert or ignore into members values(?,?)").run(edge.source,edge.target);for(const batch of row.batches)expect<unknown>(expected(db,batch.owner,batch.projects),row.name).toEqual(batch.expected);}finally{db.close();}}for(const row of corpus.invalid){const db=oracle();try{project(db,row.projects);const invalid=db.query("with recursive paths(source,target)as(select source,target from refs union select paths.source,refs.target from paths join refs on paths.target=refs.source) select (select count(*)<>count(distinct name) from projects) or exists(select 1 from refs where target not in(select name from projects)) or exists(select 1 from paths where source=target) invalid").get()as{invalid:number};expect(!row.projects.every(value=>ajv.validate(schema.definitions.Project,value))||Boolean(invalid.invalid),row.name).toBe(true);}finally{db.close();}}});
for(const row of corpus.cases)registerBuildTestLawV1("default indexed selected Rust graph assembly preserves "+row.name,"sdk-fence",original=>withIssuedResourceControlV1(original,"rust:graph-assembly:"+row.name,0,async control=>{const db=oracle(),seed:Edge[]=structuredClone(row.seed),all=[...seed],before=structuredClone(seed);let projects=0,references=0,checks=0;try{for(const edge of seed)db.query("insert or ignore into members values(?,?)").run(edge.source,edge.target);await assembly.withSelectedRustGraphAssemblyV1(seed,control,async index=>{for(const batch of row.batches){const result=await assembly.appendSelectedRustGraphAssemblyV1(index,batch.owner,batch.projects,control),independent=expected(db,batch.owner,batch.projects);expect<unknown>(result).toEqual({version:1,...batch.expected});expect(result).toEqual({version:1,...independent});expect(new Ajv({strict:true}).validate(schema,result)).toBe(true);expect(Object.isFrozen(result)&&Object.isFrozen(result.roots)&&Object.isFrozen(result.dependencies)&&result.dependencies.every(Object.isFrozen)).toBe(true);all.push(...result.dependencies);projects+=batch.projects.length;references+=batch.projects.reduce((sum,row)=>sum+row.dependencies.length,0);checks+=batch.projects.reduce((sum,row)=>sum+row.dependencies.length,0)+result.roots.length;}expect(assembly.selectedRustGraphAssemblyFactsV1(index,control)).toEqual({seedEntries:seed.length,edgeEntries:all.length,projects,references,membershipChecks:checks,insertedEdges:all.length-seed.length,requests:row.batches.length,bytes:Buffer.byteLength(JSON.stringify(all))});});expect(seed).toEqual(before);}finally{db.close();}}));
for(const row of corpus.growth)registerBuildTestLawV1("default indexed selected Rust graph retains full growth "+row.projects,"sdk-fence",original=>withIssuedResourceControlV1(original,"rust:graph-growth:"+row.projects,0,async control=>{const rows=Array.from({length:row.projects},(_,index)=>({name:"rust-unit-n"+index,dependencies:index?["rust-unit-n0:compile"]:[]})),db=oracle();try{const references=project(db,rows),roots=(db.query("select count(*) roots from projects where not exists(select 1 from refs where target=projects.name)").get()as{roots:number}).roots;expect(roots).toBe(row.roots);expect(references).toBe(row.references);await assembly.withSelectedRustGraphAssemblyV1([],control,async index=>{const value=await assembly.appendSelectedRustGraphAssemblyV1(index,"build",rows,control),facts=assembly.selectedRustGraphAssemblyFactsV1(index,control);expect(value.roots.length).toBe(roots);expect(value.dependencies.length).toBe(row.newEdges);expect(facts).toEqual({seedEntries:0,edgeEntries:row.newEdges,projects:row.projects,references:row.references,membershipChecks:row.membershipChecks,insertedEdges:row.newEdges,requests:1,bytes:Buffer.byteLength(JSON.stringify(value.dependencies))});});}finally{db.close();}}));
registerBuildTestLawV1("default indexed selected Rust graph owns lifetime and drains accepted projection","sdk-fence",original=>withIssuedResourceControlV1(original,"rust:graph-lifetime",0,async control=>{let retained:Parameters<typeof assembly.appendSelectedRustGraphAssemblyV1>[0]|undefined,settled=false,work:Promise<unknown>|undefined,touches=0;await assembly.withSelectedRustGraphAssemblyV1([],control,async index=>{retained=index;expect(()=>assembly.selectedRustGraphAssemblyFactsV1({...index},control)).toThrow("Live owned");const pending=assembly.appendSelectedRustGraphAssemblyV1(index,"build",[{name:"rust-unit-a",dependencies:[]}],control);expect(()=>assembly.appendSelectedRustGraphAssemblyV1(index,"build",[],control)).toThrow("Serialized");work=pending.then(()=>{settled=true;});return"body";});expect(settled).toBe(true);await work;expect(()=>assembly.appendSelectedRustGraphAssemblyV1(retained!,"build",new Proxy([],{get(){touches++;throw Error("Retired graph DATA touched");}}),control)).toThrow("Live owned");expect(touches).toBe(0);}));
