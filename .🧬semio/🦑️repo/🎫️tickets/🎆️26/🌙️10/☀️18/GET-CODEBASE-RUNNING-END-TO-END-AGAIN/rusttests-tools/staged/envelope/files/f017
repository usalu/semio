registerBuildTestLawV1("default indexed selected Rust graph refuses actual malformed DAGs without healing Originals","sdk-fence",original=>withIssuedResourceControlV1(original,"rust:graph-invalid",0,async control=>{for(const row of corpus.invalid){const program=prelude+`let refused=false,message='';try{await routing.receiveScriptProcessInvocation(process.env,async original=>{const control=routing.createIssuedResourceControlV1(original,'graph:invalid',0);await owner.withSelectedRustGraphAssemblyV1([],control,index=>owner.appendSelectedRustGraphAssemblyV1(index,'build',${JSON.stringify(row.projects)},control));});}catch(error){refused=true;message=error instanceof Error?error.message:String(error);}console.log(JSON.stringify({refused,message}));process.exitCode=refused?1:0;`,result=await child(program,original,control);expect(result.status,row.name+":"+result.stderr).toBe(1);expect(result.data).toEqual({refused:true,message:row.message});}}));
registerBuildTestLawV1("default indexed selected Rust graph refuses executable DATA before hooks","sdk-fence",original=>withIssuedResourceControlV1(original,"rust:graph-hooks",0,async control=>{for(const kind of corpus.hooks){const program=prelude+`let refused=false,hooks=0;const trap=()=>{hooks++;throw Error('Unexpected graph hook');};try{await routing.receiveScriptProcessInvocation(process.env,async original=>{const control=routing.createIssuedResourceControlV1(original,'graph:hooks',0),seed=${JSON.stringify(kind)}==='seed-proxy'?new Proxy([],{get:trap,ownKeys:trap}):[];await owner.withSelectedRustGraphAssemblyV1(seed,control,index=>owner.appendSelectedRustGraphAssemblyV1(index,'build',[${JSON.stringify(kind)}==='project-getter'?{get name(){return trap();},dependencies:[]}:{name:'rust-unit-a',dependencies:new Proxy([],{get:trap,ownKeys:trap})}],control));});}catch{refused=true;}console.log(JSON.stringify({refused,hooks}));process.exitCode=refused?1:0;`,result=await child(program,original,control);expect(result.status,kind+":"+result.stderr).toBe(1);expect(result.data).toEqual({refused:true,hooks:0});}}));
registerBuildTestLawV1("default indexed selected Rust graph retains primary body failures through accepted work","sdk-fence",original=>withIssuedResourceControlV1(original,"rust:graph-primary",0,async control=>{for(const kind of corpus.failures){const program=prelude+`const primary=${JSON.stringify(kind)}==='undefined'?undefined:Error('Actual graph body primary');let preserved=false;try{await routing.receiveScriptProcessInvocation(process.env,async original=>{const control=routing.createIssuedResourceControlV1(original,'graph:primary',0);try{await owner.withSelectedRustGraphAssemblyV1([],control,index=>{void owner.appendSelectedRustGraphAssemblyV1(index,'build',[{name:'invalid',dependencies:[]}],control).catch(()=>{});throw primary;});}catch(error){preserved=Object.is(error,primary);throw error;}});}catch{}console.log(JSON.stringify({preserved}));process.exitCode=1;`,result=await child(program,original,control);expect(result.status,kind+":"+result.stderr).toBe(1);expect(result.data).toEqual({preserved:true});}}));
registerBuildTestLawV1("default indexed selected Rust graph cancellation retains the genuine Original signal","sdk-fence",original=>withIssuedResourceControlV1(original,"rust:graph-cancel",0,async control=>{const program=prelude+`const stop=new AbortController(),reason=Error('Actual graph cancellation');let cancelled=false,delivered=false;try{await routing.receiveScriptProcessInvocation(process.env,original=>routing.withScriptInvocationSignalV1(original,stop.signal,actual=>routing.withIssuedResourceControlV1(actual,'graph:cancel',0,async control=>{await owner.withSelectedRustGraphAssemblyV1([],control,index=>{const work=owner.appendSelectedRustGraphAssemblyV1(index,'build',Array.from({length:65536},(_,at)=>({name:'rust-unit-n'+at,dependencies:at?['rust-unit-n0:compile']:[]})),control);stop.abort(reason);return work;});delivered=true;})));}catch(error){cancelled=Object.is(error,reason);}console.log(JSON.stringify({cancelled,delivered}));process.exitCode=1;`,result=await child(program,original,control);expect(result.status,result.stderr).toBe(1);expect(result.data).toEqual({cancelled:true,delivered:false});}));
test("neutral indexed selected Rust graph controller retains original custody and final Source validation",()=>{const text=readFileSync(new URL("../../🟦️.ts",import.meta.url),"utf8"),tree=ts.createSourceFile("selected.ts",text,ts.ScriptTarget.Latest,true),calls:string[]=[];const visit=(node:ts.Node):void=>{if(ts.isCallExpression(node))calls.push(node.expression.getText(tree));ts.forEachChild(node,visit);};visit(tree);expect(calls.filter(name=>name==="withSelectedRustGraphAssemblyV1")).toHaveLength(1);expect(calls.filter(name=>name==="appendSelectedRustGraphAssemblyV1")).toHaveLength(1);expect(calls).not.toContain("result.dependencies.some");expect(text).not.toContain("Object.values(produced.projects).some");expect(calls).toContain("requireRepositoryCompilerStoreV1");expect(calls).toContain("selectedRustSourceFactsV1");expect(calls).toContain("withSelectedRustUnitDescriptorSetV1");const flow=readFileSync(new URL("../../../../../⚡️caching/🦀️cargo/📦️units/📥️descriptor/💾️cache/📤️publication/🟦️.ts",import.meta.url),"utf8"),flowTree=ts.createSourceFile("flow.ts",flow,ts.ScriptTarget.Latest,true),flowCalls:string[]=[];const inspect=(node:ts.Node):void=>{if(ts.isCallExpression(node))flowCalls.push(node.expression.getText(flowTree));ts.forEachChild(node,inspect);};inspect(flowTree);expect(flowCalls).toContain("withRustUnitDescriptorMaintenanceV2");expect(flowCalls).toContain("retireRustUnitDescriptorStageV1");});
registerBuildTestLawV1("default indexed selected Rust graph retains loaded source policy and graph budget epochs","sdk-fence",original=>withIssuedResourceControlV1(original,"rust:graph-epochs",0,async control=>{const sink=process.env.SEMIO_TEST_ARTIFACT_DIR;if(!sink)throw Error("Actual ticket epoch sink required");const root=await mkdtemp(sink+sep),budget=fileURLToPath(new URL("../../../../../⚡️caching/💾️storage/🔒️enforcement/📦️budget/🕸️graph/🔣️policy.json",import.meta.url));try{for(const row of corpus.epochs){const program=`const routing=await import(${JSON.stringify(routing)}),{default:fs}=await import('node:fs'),{mock}=await import('bun:test'),{fileURLToPath}=await import('node:url'),row=${JSON.stringify(row)},target=row.target==='source'?${JSON.stringify(owner)}:row.target==='policy'?${JSON.stringify(policy)}:${JSON.stringify(budget)},victim=${JSON.stringify(join(root,"epoch"))};fs.writeFileSync(victim,'changed physical Source');let changed=false,hooks=0,refused=false,message='';const actualOpen=fs.openSync,actualStat=fs.lstatSync,at=path=>changed&&(path instanceof URL?fileURLToPath(path):String(path))===target;mock.module('node:fs',()=>({...fs,default:{...fs},openSync(path,...args){return actualOpen(at(path)?victim:path,...args);},lstatSync(path,...args){return actualStat(at(path)?victim:path,...args);}}));const owner=await import(${JSON.stringify(owner)});changed=row.stage==='entry';try{await routing.receiveScriptProcessInvocation(process.env,async original=>{const control=routing.createIssuedResourceControlV1(original,'graph:epoch',0);await routing.withoutImplementationPinV1(()=>owner.withSelectedRustGraphAssemblyV1(row.stage==='entry'?new Proxy([],{get(){hooks++;throw Error('Epoch DATA touched');}}):[],control,async()=>{changed=true;}));});}catch(error){refused=true;message=error instanceof Error?error.message:String(error);}finally{changed=false;}console.log(JSON.stringify({refused,message,hooks}));process.exitCode=refused?1:0;`,result=await child(program,original,control);expect(result.status,JSON.stringify(row)+":"+result.stderr).toBe(1);expect(result.data).toEqual({refused:true,message:"Stale loaded selected Rust graph assembly; restart required",hooks:0});}}finally{await rm(root,{recursive:true,force:true});}}));
registerBuildTestLawV1("default indexed selected Rust graph meters exact reducing byte extents","sdk-fence",original=>withIssuedResourceControlV1(original,"rust:graph-extents",0,async control=>{const db=new Database(":memory:");try{for(const row of corpus.extents){expect(new Ajv({strict:true}).validate(corpusSchema.properties.extents.items,row)).toBe(true);expect(db.query("select ? >= 0 accepted").get(row.delta)).toEqual({accepted:row.accepted?1:0});const program=prelude+`const row=${JSON.stringify(row)},seed=[{source:'prior',target:'external',type:'static',sourceFile:'é/😀\\n'}],bytes=Buffer.byteLength(JSON.stringify(seed));let refused=false,delivered=false,message='',actual=0;try{await routing.receiveScriptProcessInvocation(process.env,async original=>{const control=routing.createIssuedResourceControlV1(original,'graph:extents',0);await owner.withSelectedRustGraphAssemblyV1(seed,control,async index=>{actual=owner.selectedRustGraphAssemblyFactsV1(index,control).bytes;delivered=true;},bytes+row.delta);});}catch(error){refused=true;message=error instanceof Error?error.message:String(error);}console.log(JSON.stringify({refused,delivered,message,bytes,actual}));process.exitCode=refused?1:0;`,result=await child(program,original,control);expect(result.status,result.stderr).toBe(row.accepted?0:1);expect(result.data.refused).toBe(!row.accepted);expect(result.data.delivered).toBe(row.accepted);if(row.accepted)expect(result.data.actual).toBe(result.data.bytes);else expect(result.data.message).toBe("Selected Rust graph byte budget exceeded");}}finally{db.close();}}));
