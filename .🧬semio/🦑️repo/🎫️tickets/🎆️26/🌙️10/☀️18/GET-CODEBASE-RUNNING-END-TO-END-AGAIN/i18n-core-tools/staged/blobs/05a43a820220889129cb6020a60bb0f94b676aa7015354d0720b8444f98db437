{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repo Error",
  "description": "A refusal that carries data and no prose: a machine code, the qualified catalog key `<namespace>.<key>` and the values of its placeholders. The CLI boundary renders it in the language it resolved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "code", "key", "values"],
  "properties": {
    "version": { "const": 1 },
    "code": { "enum": ["usage", "invalid", "missing", "refused", "failed", "breach", "stale", "unsupported"] },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[A-Za-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)*$" },
    "values": {
      "type": "object",
      "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }] }
    }
  }
}
