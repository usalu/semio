{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local Config Event Log",
  "description": "The repo's persisted local-only configuration as an append-only event log: one JSON event per line in `<git directory>/semio/config/events.jsonl` (or the directory named by SEMIO_CONFIG_DIRECTORY). Nothing is ever rewritten; the current configuration is the fold of the events, the last event of a setting wins.",
  "oneOf": [{ "$ref": "#/definitions/LanguageChosen" }, { "$ref": "#/definitions/LanguageCleared" }],
  "definitions": {
    "Location": {
      "const": { "environmentVariable": "SEMIO_CONFIG_DIRECTORY", "gitSubdirectory": ["semio", "config"], "file": "events.jsonl" }
    },
    "Id": { "type": "string", "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$" },
    "Instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "LanguageChosen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "at", "type", "language"],
      "properties": {
        "version": { "const": 1 },
        "id": { "$ref": "#/definitions/Id" },
        "at": { "$ref": "#/definitions/Instant" },
        "type": { "const": "language-chosen" },
        "language": { "enum": ["en", "de"] }
      }
    },
    "LanguageCleared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "at", "type"],
      "properties": {
        "version": { "const": 1 },
        "id": { "$ref": "#/definitions/Id" },
        "at": { "$ref": "#/definitions/Instant" },
        "type": { "const": "language-cleared" }
      }
    },
    "Projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "events"],
      "properties": {
        "version": { "const": 1 },
        "language": { "enum": ["en", "de"] },
        "events": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
