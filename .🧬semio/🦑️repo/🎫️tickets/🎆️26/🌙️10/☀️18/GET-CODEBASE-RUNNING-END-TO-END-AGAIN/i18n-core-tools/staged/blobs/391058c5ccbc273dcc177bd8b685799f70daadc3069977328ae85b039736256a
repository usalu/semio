{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Language Law Corpus",
  "description": "Language-agnostic cases of the language law: for every case the findings over its sources and allowlist, and the number of English prose literals of every listed text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "prose"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sources", "allowlist", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "text"],
              "properties": { "path": { "type": "string", "minLength": 1 }, "text": { "type": "string" } }
            }
          },
          "allowlist": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "ceiling", "files", "defaultsCeiling", "defaults"],
            "properties": {
              "version": { "const": 1 },
              "ceiling": { "type": "integer", "minimum": 0 },
              "files": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
              "defaultsCeiling": { "type": "integer", "minimum": 0 },
              "defaults": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
            }
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule", "path", "detail"],
              "properties": {
                "rule": { "enum": ["languages-not-en-de", "leaf-missing-language", "placeholder-mismatch", "table-key-mismatch", "default-language", "prose-literal", "allowance-stale", "ceiling-grown"] },
                "path": { "type": "string" },
                "detail": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "prose": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "count"],
        "properties": { "text": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
