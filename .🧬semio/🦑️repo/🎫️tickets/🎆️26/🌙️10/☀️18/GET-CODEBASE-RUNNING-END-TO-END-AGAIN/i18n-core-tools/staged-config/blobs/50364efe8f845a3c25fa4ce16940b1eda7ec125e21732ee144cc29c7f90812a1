{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local Config Log Corpus",
  "description": "Language-agnostic cases of the local config event log: the text of a log and the configuration it folds to, or the line that is refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "logs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "logs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "text",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "events": {
                "type": "integer",
                "minimum": 0
              },
              "language": {
                "enum": [
                  "en",
                  "de"
                ]
              },
              "refusal": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "line"
                ],
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
