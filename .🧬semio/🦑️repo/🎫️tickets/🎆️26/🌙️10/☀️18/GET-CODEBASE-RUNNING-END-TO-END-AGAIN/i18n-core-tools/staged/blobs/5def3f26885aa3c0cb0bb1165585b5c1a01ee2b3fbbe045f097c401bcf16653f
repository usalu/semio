{
  "version": 1,
  "catalog": {
    "version": 1,
    "id": "demo",
    "languages": ["en", "de"],
    "messages": {
      "greet": { "en": "Hello {name}", "de": "Hallo {name}" },
      "count": { "en": "{count} file(s) checked in {seconds} s", "de": "{count} Datei(en) in {seconds} s geprüft" },
      "plain": { "en": "Done.", "de": "Fertig." },
      "braces": { "en": "Write {{emoji}} first, then {name}", "de": "Schreibe zuerst {{emoji}}, dann {name}" },
      "reorder": { "en": "{second} after {first}", "de": "{first} vor {second}" },
      "joined": { "en": "{a}{b}", "de": "{b}{a}" },
      "nested.key-1": { "en": "Nested {x}", "de": "Verschachtelt {x}" }
    }
  },
  "render": [
    { "name": "english", "key": "greet", "language": "en", "values": { "name": "Ada" }, "expected": "Hello Ada" },
    { "name": "german", "key": "greet", "language": "de", "values": { "name": "Ada" }, "expected": "Hallo Ada" },
    { "name": "integers and halves", "key": "count", "language": "de", "values": { "count": 3, "seconds": 0.5 }, "expected": "3 Datei(en) in 0.5 s geprüft" },
    { "name": "no placeholder", "key": "plain", "language": "en", "values": {}, "expected": "Done." },
    { "name": "escaped braces stay literal", "key": "braces", "language": "en", "values": { "name": "Ada" }, "expected": "Write {emoji} first, then Ada" },
    { "name": "escaped braces in german", "key": "braces", "language": "de", "values": { "name": "Ada" }, "expected": "Schreibe zuerst {emoji}, dann Ada" },
    { "name": "placeholder order differs per language", "key": "reorder", "language": "en", "values": { "first": "A", "second": "B" }, "expected": "B after A" },
    { "name": "placeholder order differs in german", "key": "reorder", "language": "de", "values": { "first": "A", "second": "B" }, "expected": "A vor B" },
    { "name": "values are never expanded again", "key": "greet", "language": "en", "values": { "name": "{count}" }, "expected": "Hello {count}" },
    { "name": "adjacent placeholders", "key": "joined", "language": "de", "values": { "a": "1", "b": "2" }, "expected": "21" },
    { "name": "dotted key", "key": "nested.key-1", "language": "en", "values": { "x": "ok" }, "expected": "Nested ok" },
    { "name": "empty language is refused", "key": "greet", "language": "", "values": { "name": "Ada" }, "refusal": "language-required" },
    { "name": "unoffered language is refused", "key": "greet", "language": "fr", "values": { "name": "Ada" }, "refusal": "language-unavailable" },
    { "name": "unknown key is refused", "key": "nothing", "language": "en", "values": {}, "refusal": "unknown-key" },
    { "name": "inherited key is refused", "key": "constructor", "language": "en", "values": {}, "refusal": "unknown-key" },
    { "name": "missing placeholder is refused", "key": "greet", "language": "en", "values": {}, "refusal": "missing-placeholder" },
    { "name": "unknown placeholder is refused", "key": "plain", "language": "en", "values": { "x": 1 }, "refusal": "unknown-placeholder" },
    { "name": "extra placeholder is refused", "key": "greet", "language": "de", "values": { "name": "Ada", "extra": "x" }, "refusal": "unknown-placeholder" }
  ],
  "templates": [
    { "template": "{a} and {b}", "placeholders": ["a", "b"] },
    { "template": "{b}{a}{b}", "placeholders": ["a", "b"] },
    { "template": "{{x}} {y}", "placeholders": ["y"] },
    { "template": "no placeholder", "placeholders": [] },
    { "template": "{under_score} {Mixed1}", "placeholders": ["Mixed1", "under_score"] },
    { "template": "{x", "refusal": "invalid-template" },
    { "template": "x}", "refusal": "invalid-template" },
    { "template": "{ x }", "refusal": "invalid-template" },
    { "template": "{1}", "refusal": "invalid-template" },
    { "template": "{}", "refusal": "invalid-template" },
    { "template": "{x}}", "refusal": "invalid-template" }
  ],
  "documents": [
    { "name": "the valid catalog", "valid": true, "schemaValid": true, "document": { "version": 1, "languages": ["en", "de"], "messages": { "a": { "en": "A {x}", "de": "A {x}" } } } },
    { "name": "an empty text pair is admitted", "valid": true, "schemaValid": true, "document": { "version": 1, "languages": ["en", "de"], "messages": { "a": { "en": "", "de": "" } } } },
    { "name": "german first is refused", "valid": false, "schemaValid": false, "document": { "version": 1, "languages": ["de", "en"], "messages": { "a": { "en": "A", "de": "A" } } } },
    { "name": "a third language is refused", "valid": false, "schemaValid": false, "document": { "version": 1, "languages": ["en", "de", "fr"], "messages": { "a": { "en": "A", "de": "A" } } } },
    { "name": "a missing german text is refused", "valid": false, "schemaValid": false, "document": { "version": 1, "languages": ["en", "de"], "messages": { "a": { "en": "A" } } } },
    { "name": "an extra language in a leaf is refused", "valid": false, "schemaValid": false, "document": { "version": 1, "languages": ["en", "de"], "messages": { "a": { "en": "A", "de": "A", "fr": "A" } } } },
    { "name": "different placeholder sets are refused", "valid": false, "schemaValid": true, "document": { "version": 1, "languages": ["en", "de"], "messages": { "a": { "en": "A {x}", "de": "A {y}" } } } },
    { "name": "a placeholder missing in german is refused", "valid": false, "schemaValid": true, "document": { "version": 1, "languages": ["en", "de"], "messages": { "a": { "en": "A {x}", "de": "A" } } } },
    { "name": "an unbalanced brace is refused", "valid": false, "schemaValid": true, "document": { "version": 1, "languages": ["en", "de"], "messages": { "a": { "en": "A {x", "de": "A {x" } } } },
    { "name": "version two is refused", "valid": false, "schemaValid": false, "document": { "version": 2, "languages": ["en", "de"], "messages": { "a": { "en": "A", "de": "A" } } } },
    { "name": "a bad key is refused", "valid": false, "schemaValid": false, "document": { "version": 1, "languages": ["en", "de"], "messages": { "a b": { "en": "A", "de": "A" } } } },
    { "name": "no messages are refused", "valid": false, "schemaValid": false, "document": { "version": 1, "languages": ["en", "de"], "messages": {} } },
    { "name": "an unknown top-level name is refused", "valid": false, "schemaValid": false, "document": { "version": 1, "languages": ["en", "de"], "messages": { "a": { "en": "A", "de": "A" } }, "default": "en" } },
    { "name": "a bad id is refused", "valid": false, "schemaValid": false, "document": { "version": 1, "id": "Bad Id", "languages": ["en", "de"], "messages": { "a": { "en": "A", "de": "A" } } } }
  ]
}
