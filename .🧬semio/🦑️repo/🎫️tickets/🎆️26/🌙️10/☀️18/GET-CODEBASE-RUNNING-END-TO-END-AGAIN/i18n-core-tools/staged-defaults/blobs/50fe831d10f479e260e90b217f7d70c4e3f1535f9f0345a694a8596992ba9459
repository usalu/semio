import {expect,test} from "bun:test";
import Ajv from "ajv";
import {join} from "node:path";
import schema from "../🧬️schema/🔣️.json" with {type:"json"};
import policyDocument from "../🔣️policy.json" with {type:"json"};
import rulesDocument from "../📖️rules/🔣️.json" with {type:"json"};
import textsDocument from "../📖️texts/🔣️.json" with {type:"json"};
import {DOCTOR_POLICY_V1,DOCTOR_PROTOCOL_V1,DOCTOR_RULES_V1,clipResourceV1,redactCommandV1,commandLabelV1,commandRelevantV1,doctorTextV1,fillDoctorV1,readDoctorPolicyV1,readDoctorRulesV1,requireDoctorFactsV1,validateDoctorV1,type DoctorFactsV1} from "../🟦️.ts";
import {analyzeDoctorV1,buildDoctorReportV1,summarizeDoctorV1} from "../🧮️analysis/🟦️.ts";
import {parseElapsedSecondsV1,parsePosixProcessListingV1,parseWindowsProcessListingV1} from "../🔌️ports/🟦️.ts";
import {DOCTOR_REPAIRS_V1} from "../🔎️probes/🟦️.ts";
import {formatDoctorReportInV1,formatDoctorReportV1} from "../🖨️report/🟦️.ts";
import fixture from "./🧫️fixtures/🔣️.json";

type Case={name:string;ordered:boolean;facts:DoctorFactsV1;expect:{findings:[string,string,string][];waits:[string,number,number|null,string|null][];processes:[number,string,number|null][];verdict:string;counts:Record<string,number>}};
const cases=fixture.cases as unknown as Case[];
const ajv=new Ajv({strict:true,allowUnionTypes:true}),compile=(definition:string)=>ajv.compile({definitions:schema.definitions,$ref:`#/definitions/${definition}`});
const key=(row:readonly [string,string,string]):string=>row.join("\u0000");
const rows=(analysis:ReturnType<typeof analyzeDoctorV1>)=>({
 findings:analysis.findings.map(row=>[row.id,row.severity,row.subject] as [string,string,string]),
 waits:analysis.waits.map(row=>[row.kind,row.pid,row.root?.pid??null,row.root?.state??null]) as unknown[][],
 processes:analysis.processes.map(row=>[row.pid,row.phase,row.via]) as unknown[][],
});

test("the contract schema compiles under strict Ajv and every authored document is valid in both validators",()=>{
 for(const [definition,value] of [["Policy",policyDocument],["Rules",rulesDocument],["Texts",textsDocument]] as const){
  expect(compile(definition)(value),definition).toBe(true);
  expect(validateDoctorV1(definition,value),definition).toEqual([]);
 }
 expect(compile("Protocol")(schema.definitions.Protocol.const)).toBe(true);
});

test("both validators accept the fixture facts and reject the same mutations of them",()=>{
 const valid=compile("Facts"),base=structuredClone(cases[0]!.facts) as Record<string,unknown>;
 for(const item of cases){expect(valid(item.facts),item.name).toBe(true);expect(validateDoctorV1("Facts",item.facts),item.name).toEqual([]);}
 const mutations:[string,(value:Record<string,any>)=>void][]=[
  ["missing version",value=>{delete value.version;}],
  ["unknown section",value=>{value.extra=1;}],
  ["bad platform",value=>{value.platform="plan9";}],
  ["negative megabytes",value=>{value.host.availableMegabytes=-1;}],
  ["host field of the wrong type",value=>{value.host.load="high";}],
  ["unknown partition state",value=>{value.storage.partitions[0].state="exploded";}],
  ["lease hash not hex",value=>{value.leases={holders:[{resource:"a",hash:"zz",mode:"shared",pid:1,heldSeconds:0,class:"c",owner:"o",command:""}],waiters:[],cycles:[],violations:[],registry:{folders:0,orphanFolders:0,deadEntries:0,liveEntries:0},deadTickets:0,deadHolders:[]};}],
  ["pid zero",value=>{value.processes=[{pid:0,parent:0,ageSeconds:0,rssMegabytes:0,cpuPercent:0,command:"x"}];}],
  ["probe status unknown",value=>{value.probes=[{area:"tools",status:"maybe",durationMs:1}];}],
 ];
 for(const [name,mutate] of mutations){
  const copy=structuredClone(base);mutate(copy);
  expect(valid(copy),name).toBe(false);
  expect(validateDoctorV1("Facts",copy).length>0,name).toBe(true);
  expect(()=>requireDoctorFactsV1(copy),name).toThrow();
 }
});

test("the policy and the rule catalogue refuse the documents that would make a report lie",()=>{
 const policy=structuredClone(policyDocument) as any,rules=structuredClone(rulesDocument) as any;
 expect(readDoctorPolicyV1(policy,rules)).toEqual(DOCTOR_POLICY_V1);
 const policyMutations:[string,(value:any)=>void][]=[
  ["wait thresholds out of order",value=>{value.leases.waitWarnSeconds=value.leases.waitErrorSeconds;}],
  ["free percent thresholds out of order",value=>{value.storage.freePercentError=value.storage.freePercentWarn;}],
  ["unknown key",value=>{value.leases.extra=1;}],
  ["repair that no rule points at",value=>{value.repairs[0].id="nobody-points-here";}],
  ["repair declared twice",value=>{value.repairs.push(structuredClone(value.repairs[0]));}],
 ];
 for(const [name,mutate] of policyMutations){const copy=structuredClone(policy);mutate(copy);expect(()=>readDoctorPolicyV1(copy,rules),name).toThrow();}
 const ruleMutations:[string,(value:any)=>void][]=[
  ["title uses undeclared data",value=>{value["host.load-high"].title.en="Load {nope}";}],
  ["languages differ in placeholders",value=>{value["host.load-high"].title.de="Last {load}";}],
  ["automatic fix without a repair",value=>{delete value["caches.dead-publication"].fix.repair;}],
  ["repair on a command fix",value=>{value["host.load-high"].fix.repair="leases-registry";}],
  ["command fix without a command",value=>{delete value["host.load-high"].fix.command;}],
  ["id outside its area",value=>{value["wrong.area"]=structuredClone(value["host.load-high"]);}],
  ["fix command that does not start with repo",value=>{value["host.load-high"].fix.command="bun x";}],
 ];
 for(const [name,mutate] of ruleMutations){const copy=structuredClone(rules);mutate(copy);expect(()=>readDoctorRulesV1(copy,policy),name).toThrow();}
});

test("every declared repair has an implementation, every implementation is declared and every automatic fix names one",()=>{
 const declared=new Set(DOCTOR_POLICY_V1.repairs.map(row=>row.id));
 expect([...DOCTOR_REPAIRS_V1.keys()].sort()).toEqual([...declared].sort());
 for(const [id,rule] of Object.entries(DOCTOR_RULES_V1))if(rule.fix.kind==="automatic"){expect(declared.has(rule.fix.repair!),id).toBe(true);expect(rule.fix.command,id).toBe(`repo doctor --fix --only=${rule.area}`);}
 for(const repair of DOCTOR_POLICY_V1.repairs)expect(DOCTOR_REPAIRS_V1.get(repair.id)!.area,repair.id).toBe(repair.area);
});

test("every catalogued rule is exercised by the hand-stated fixture and no case invents a rule",()=>{
 const used=new Set<string>();
 for(const item of cases)for(const row of item.expect.findings)used.add(row[0]);
 expect([...used].sort()).toEqual(Object.keys(DOCTOR_RULES_V1).sort());
});

test("the analysis reproduces the hand-stated findings, waits and processes of every fixture case",()=>{
 for(const item of cases){
  const analysis=analyzeDoctorV1(item.facts),actual=rows(analysis);
  expect(actual.findings.map(key).sort(),item.name).toEqual(item.expect.findings.map(key).sort());
  if(item.ordered)expect(actual.findings,item.name+" order").toEqual(item.expect.findings);
  expect(actual.waits,item.name+" waits").toEqual(item.expect.waits as unknown[][]);
  expect(actual.processes,item.name+" processes").toEqual(item.expect.processes as unknown[][]);
  const summary=summarizeDoctorV1(analysis.findings);
  expect(summary.verdict as string,item.name).toBe(item.expect.verdict);
  expect(summary.counts,item.name).toEqual(item.expect.counts as never);
 }
});

test("an independent Python implementation reproduces every case",()=>{
 const run=Bun.spawnSync(["python3",join(import.meta.dir,"🐍️oracle.py")],{stdin:new TextEncoder().encode(JSON.stringify({policy:policyDocument,cases:cases.map(item=>item.facts)})),stdout:"pipe",stderr:"pipe"});
 expect(run.exitCode,new TextDecoder().decode(run.stderr)).toBe(0);
 const results=JSON.parse(new TextDecoder().decode(run.stdout)) as {findings:[string,string,string][];waits:[string,number,number|null,string|null][];processes:[number,string,number|null][];verdict:string;counts:Record<string,number>}[];
 expect(results.length).toBe(cases.length);
 cases.forEach((item,index)=>{
  const python=results[index]!,actual=rows(analyzeDoctorV1(item.facts));
  expect(python.findings.map(key),item.name).toEqual(actual.findings.map(key));
  expect(python.waits as unknown[][],item.name).toEqual(actual.waits);
  expect(python.processes as unknown[][],item.name).toEqual(actual.processes);
  expect(python.verdict,item.name).toBe(item.expect.verdict);
  expect(python.counts,item.name).toEqual(item.expect.counts);
 });
});

test("every finding and every report validates, names an owner and a resolution, and reads the same in both languages",()=>{
 const validReport=compile("Report"),validFinding=compile("Finding");
 for(const item of cases){
  const analysis=analyzeDoctorV1(item.facts),report=buildDoctorReportV1(item.facts,analysis);
  expect(validReport(report),item.name+JSON.stringify(validReport.errors?.slice(0,2))).toBe(true);
  expect(validateDoctorV1("Report",report),item.name).toEqual([]);
  for(const row of analysis.findings){
   expect(validFinding(row),row.id).toBe(true);
   expect(row.owner.length>0&&row.title.en.length>0&&row.title.de.length>0).toBe(true);
   expect(["command","automatic"].includes(row.fix.kind)?row.fix.command?.startsWith("repo "):true,row.id).toBe(true);
   for(const language of ["en","de"] as const)expect(`${row.title[language]} ${row.detail[language]}`,row.id).not.toMatch(/\{[A-Za-z]+\}/u);
  }
  const en=formatDoctorReportInV1("en",report),de=formatDoctorReportInV1("de",report);
  expect(en.length,item.name).toBe(de.length);
  expect(en.join("\n"),item.name).not.toMatch(/\{[A-Za-z]+\}/u);
  expect(de.join("\n"),item.name).not.toMatch(/\{[A-Za-z]+\}/u);
  expect(formatDoctorReportV1(report,["en","de"]).length,item.name).toBe(en.length+de.length+2);
 }
});

test("the analysis is pure: frozen facts are not touched and the same facts give the same answer",()=>{
 const freeze=(value:unknown):unknown=>{if(value&&typeof value==="object"){Object.freeze(value);for(const child of Object.values(value))freeze(child);}return value;};
 for(const item of cases){
  const copy=freeze(structuredClone(item.facts)) as DoctorFactsV1;
  expect(JSON.stringify(analyzeDoctorV1(copy))).toBe(JSON.stringify(analyzeDoctorV1(item.facts)));
 }
});

test("findings are ordered by severity, then area, then id, then subject, and capped",()=>{
 const everything=cases.flatMap(item=>analyzeDoctorV1(item.facts).findings),rank={error:0,warn:1,info:2} as const;
 for(const item of cases){
  const list=analyzeDoctorV1(item.facts).findings;
  for(let index=1;index<list.length;index++){
   const left=list[index-1]!,right=list[index]!;
   expect(rank[left.severity]<=rank[right.severity],item.name).toBe(true);
   if(left.severity===right.severity)expect(DOCTOR_PROTOCOL_V1.areas.indexOf(left.area)<=DOCTOR_PROTOCOL_V1.areas.indexOf(right.area),item.name).toBe(true);
  }
 }
 expect(everything.length>0).toBe(true);
 const many=structuredClone(cases[0]!.facts) as any;many.leases={holders:[],waiters:[],cycles:Array.from({length:600},(_,index)=>({members:[`${index}/0`,`${index+1}/0`],victim:"x"})),violations:[],registry:{folders:0,orphanFolders:0,deadEntries:0,liveEntries:0},deadTickets:0,deadHolders:[]};
 expect(analyzeDoctorV1(many).findings.length).toBe(DOCTOR_PROTOCOL_V1.maximumFindings);
});

test("the boundaries of every numeric threshold in the policy are exact",()=>{
 const base=structuredClone(cases[0]!.facts) as any,policy=DOCTOR_POLICY_V1;
 const ids=(facts:unknown):string[]=>analyzeDoctorV1(facts as DoctorFactsV1).findings.map(row=>`${row.id}:${row.severity}`);
 const withHost=(patch:Record<string,unknown>)=>({...base,host:{...base.host,...patch}});
 expect(ids(withHost({load:policy.host.loadPerCoreWarn*10-0.01}))).toEqual([]);
 expect(ids(withHost({load:policy.host.loadPerCoreWarn*10}))).toEqual(["host.load-high:warn"]);
 expect(ids(withHost({load:policy.host.loadPerCoreError*10}))).toEqual(["host.load-high:error"]);
 expect(ids(withHost({attachedImages:policy.host.imagesWarn-1}))).toEqual([]);
 expect(ids(withHost({attachedImages:policy.host.imagesError}))).toEqual(["host.images-many:error"]);
 const lease=(waited:number)=>({...base,leases:{...base.leases,holders:[],waiters:[{resource:"r",hash:"a".repeat(64),mode:"exclusive",pid:5,waitedSeconds:waited,class:"c",owner:"o",position:null,queued:null,blockers:[],command:""}]}});
 expect(ids(lease(policy.leases.waitWarnSeconds-1))).toEqual([]);
 expect(ids(lease(policy.leases.waitWarnSeconds))).toEqual(["leases.wait-long:warn"]);
 expect(ids(lease(policy.leases.waitErrorSeconds))).toEqual(["leases.wait-long:error"]);
});

