test("command lines collapse to what a person needs",()=>{
 const vectors:[string,string][]=[
  ["/Users/x/.bun/bin/bun /Users/x/w/🏗️build/📜️script.ts repo run a:b --skip-cache","repo run a:b --skip-cache"],
  ["/w/🏗️build/📜️script.ts repo cargo test","repo cargo test"],
  ["bun repo show projects","repo show projects"],
  ["bun --watch ./x/📜️script.ts dev","repo dev"],
  ["bun --cwd /w repo cargo check","repo cargo check"],
  ["repo cargo check","repo cargo check"],
  ["bun test ./a.test.ts","bun test ./a.test.ts"],
  ["cargo test -p x","cargo test -p x"],
  ["  node   ./y/script.mjs   a  ","repo a"],
 ];
 for(const [raw,expected] of vectors)expect(commandLabelV1(raw),raw).toBe(expected);
 expect(commandLabelV1("repo "+"x".repeat(200),20)).toBe("repo xxxxxxxxxxxxxx…");
 expect(clipResourceV1("short")).toBe("short");
 expect(clipResourceV1("a".repeat(100),10)).toBe("…"+"a".repeat(9));
});

test("secret-looking options and assignments never reach a report",()=>{
 expect(redactCommandV1("tool --token abc123 --password=hunter2 --name x")).toBe("tool --token=*** --password=*** --name x");
 expect(redactCommandV1("env GITHUB_TOKEN=ghp_abc API_KEY=zzz run")).toBe("env GITHUB_TOKEN=*** API_KEY=*** run");
 expect(redactCommandV1("curl -H Bearer abcdefghijkl1234 url")).toBe("curl -H Bearer *** url");
 expect(redactCommandV1("bun script.ts repo run a:b --skip-cache")).toBe("bun script.ts repo run a:b --skip-cache");
 expect(redactCommandV1("tool --keyboard layout")).toBe("tool --keyboard layout");
});

test("shells and wrappers never count as repo processes, whatever text they carry",()=>{
 const patterns=DOCTOR_POLICY_V1.processes.patterns.map(pattern=>new RegExp(pattern,"u")),excluded=DOCTOR_POLICY_V1.processes.exclude.map(pattern=>new RegExp(pattern,"u"));
 const relevant=(command:string):boolean=>commandRelevantV1(command,patterns,excluded);
 expect(relevant("/bin/zsh -c repo cargo test")).toBe(false);
 expect(relevant("nohup repo cargo test")).toBe(false);
 expect(relevant("repo mcp stdio")).toBe(false);
 expect(relevant("repo dev mcp stdio os")).toBe(false);
 expect(relevant("bun /w/script.ts repo run a")).toBe(true);
 expect(relevant("rustc --crate-name x")).toBe(true);
 expect(relevant("vim notes.txt")).toBe(false);
});

