 const posix=parsePosixProcessListingV1(["  1651     1 19:42:04   7728   0.0 repo mcp","  17330 17329 01:47:46 5860960  98.7 bun ./🧰️framework/📜️script.ts show projects","not a row","  5 1 00:05 1024 1,5 sleep 5"].join("\n"));
 expect(posix.map(row=>[row.pid,row.parent,row.ageSeconds,row.rssMegabytes,row.cpuPercent])).toEqual([[1651,1,70924,8,0],[17330,17329,6466,5724,98.7],[5,1,5,1,1.5]]);
 expect(posix[1]!.command).toBe("bun ./🧰️framework/📜️script.ts show projects");
 const windows=parseWindowsProcessListingV1(JSON.stringify([{ProcessId:10,ParentProcessId:4,CreationDate:"/Date(1000000)/",WorkingSetSize:104857600,CommandLine:"bun x.ts",Name:"bun.exe"},{ProcessId:11,ParentProcessId:10,CreationDate:"2026-10-21T10:00:00Z",WorkingSetSize:0,CommandLine:null,Name:"git.exe"},{ProcessId:0}]),2000000);
 expect(windows.map(row=>[row.pid,row.parent,row.ageSeconds,row.rssMegabytes,row.command])).toEqual([[10,4,1000,100,"bun x.ts"],[11,10,Math.max(0,Math.floor((2000000-Date.parse("2026-10-21T10:00:00Z"))/1000)),0,"git.exe"]]);
