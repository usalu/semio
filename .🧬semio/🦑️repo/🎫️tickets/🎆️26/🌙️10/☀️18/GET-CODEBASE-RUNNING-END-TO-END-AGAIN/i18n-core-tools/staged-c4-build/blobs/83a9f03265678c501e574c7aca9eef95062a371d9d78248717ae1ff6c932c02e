import {createHash} from "node:crypto";
import {copyFile,mkdir,readFile,rename,rm,writeFile} from "node:fs/promises";
import {isAbsolute,join} from "node:path";
import {fileURLToPath} from "node:url";
import {validateJsonSchemaSubset} from "../../../../../../../../🔨️modules/🧬️schema/✅️validator/📦️packages/🟦️typescript/🟦️.ts";
import schema from "../../../🧾️ci-report/🧬️schema/🔣️.json" with {type:"json"};
import {sayBuildV1} from "../../../📖️texts/🟦️.ts";

/** 🧾️ The final attempt of one test run as Bazel's build event stream reports it; `xml` is the local path of its JUnit XML, absent when Bazel kept the file remote. */
export type BazelTestResultV1=Readonly<{label:string;run:number;shard:number;attempt:number;status:"passed"|"failed"|"flaky"|"timeout"|"error";cached:boolean;durationMillis:number;xml:string|undefined}>;

type Row=Readonly<{label:string;status:BazelTestResultV1["status"];cached:boolean;durationMillis:number;file:string}>;
type Index=Readonly<{version:1;tool:"bazel";results:readonly Row[]}>;

const missing=(error:unknown)=>["ENOENT","ENOTDIR"].includes((error as NodeJS.ErrnoException).code??"");
const statuses:Readonly<Record<string,BazelTestResultV1["status"]>>={PASSED:"passed",FAILED:"failed",FLAKY:"flaky",TIMEOUT:"timeout"};

/** 📍️ Names the directory a caller asked test results in, or nothing when none are requested. */
export function bazelTestResultsDirectoryV1(environment:Readonly<Record<string,string|undefined>>):string|undefined{
 const directory=environment.SEMIO_BUILD_TEST_RESULTS_DIR;
 if(directory===undefined||directory==="")return undefined;
 if(!isAbsolute(directory)||directory.length>200)throw Error("SEMIO_BUILD_TEST_RESULTS_DIR must be an absolute path of at most 200 characters");
 return directory;
}

/** 🔎️ Reads the test results of a build event stream (JSON lines): the last attempt of every label, run and shard, with the status mapped to the neutral vocabulary. */
export function bazelTestResultsFromEventsV1(events:string):readonly BazelTestResultV1[]{
 const latest=new Map<string,BazelTestResultV1>();
 for(const line of events.split("\n")){
  if(!line.includes('"testResult"'))continue;
  let event:{id?:{testResult?:{label?:string;run?:number;shard?:number;attempt?:number}};testResult?:{status?:string;cachedLocally?:boolean;testAttemptDurationMillis?:string|number;testActionOutput?:readonly {name?:string;uri?:string}[];executionInfo?:{cachedRemotely?:boolean}}};
  try{event=JSON.parse(line);}catch{continue;}
  const id=event.id?.testResult,result=event.testResult;
  if(id?.label===undefined||result===undefined)continue;
  const uri=result.testActionOutput?.find(output=>output.name==="test.xml")?.uri;
  let xml:string|undefined;
  if(uri!==undefined&&uri.startsWith("file:")){try{xml=fileURLToPath(uri);}catch{xml=undefined;}}
  const row:BazelTestResultV1={label:id.label,run:id.run??1,shard:id.shard??1,attempt:id.attempt??1,status:statuses[result.status??""]??"error",cached:result.cachedLocally===true||result.executionInfo?.cachedRemotely===true,durationMillis:Math.max(0,Math.trunc(Number(result.testAttemptDurationMillis??0))||0),xml};
  const key=`${row.label}\n${row.run}\n${row.shard}`,previous=latest.get(key);
  if(previous===undefined||previous.attempt<=row.attempt)latest.set(key,row);
 }
 return Object.freeze([...latest.values()]);
}

/** 🏷️ Names the exported file of one result: ASCII only and unique per label, run and shard. */
export function bazelTestResultFileV1(result:Pick<BazelTestResultV1,"label"|"run"|"shard">,multiple:boolean):string{
 const stem=result.label.replace(/^\/\//u,"").replace(/[^A-Za-z0-9._-]+/gu,"_").replace(/^_+|_+$/gu,"").slice(0,90)||"test";
 const hash=createHash("sha256").update(result.label).digest("hex").slice(0,8);
 return `${stem}-${hash}${multiple?`.run${result.run}.shard${result.shard}`:""}.xml`;
}

function validIndex(value:unknown):value is Index{return validateJsonSchemaSubset({$ref:"#/definitions/TestResultsIndex"},value,schema).length===0;}

/** 📤️ Copies the JUnit XML of every test of a finished build into one directory and maintains its `index.json` (rows are replaced by file, so several builds of one run add up); never throws, because reporting must not fail a build. */
export async function exportBazelTestResultsV1(events:string,directory:string):Promise<Readonly<{exported:number;unavailable:number}>>{
 let exported=0,unavailable=0;
 try{
  const results=bazelTestResultsFromEventsV1(events);
  if(!results.length)return Object.freeze({exported,unavailable});
  const perLabel=new Map<string,number>();
  for(const result of results)perLabel.set(result.label,(perLabel.get(result.label)??0)+1);
  await mkdir(directory,{recursive:true});
  const rows:Row[]=[];
  for(const result of results){
   if(result.xml===undefined){unavailable++;continue;}
   const file=bazelTestResultFileV1(result,(perLabel.get(result.label)??0)>1);
   try{await copyFile(result.xml,join(directory,file));}catch(error){if(missing(error)){unavailable++;continue;}throw error;}
   rows.push({label:result.label,status:result.status,cached:result.cached,durationMillis:result.durationMillis,file});exported++;
  }
  const path=join(directory,"index.json");
  let previous:readonly Row[]=[];
  try{const value=JSON.parse(await readFile(path,"utf8"));if(validIndex(value))previous=value.results;}catch(error){if(!missing(error)&&!(error instanceof SyntaxError))throw error;}
  const files=new Set(rows.map(row=>row.file)),index:Index={version:1,tool:"bazel",results:[...previous.filter(row=>!files.has(row.file)),...rows].sort((a,b)=>a.file<b.file?-1:1)};
  if(!validIndex(index))throw Error("Closed test results index required");
  const temporary=`${path}.${process.pid}.tmp`;
  await writeFile(temporary,JSON.stringify(index,null,1)+"\n");await rename(temporary,path).catch(async error=>{await rm(temporary,{force:true});throw error;});
 }catch(error){sayBuildV1("tools.bazel-test-results-not-exported",{message:String((error as Error).message)},"warn");}
 return Object.freeze({exported,unavailable});
}
