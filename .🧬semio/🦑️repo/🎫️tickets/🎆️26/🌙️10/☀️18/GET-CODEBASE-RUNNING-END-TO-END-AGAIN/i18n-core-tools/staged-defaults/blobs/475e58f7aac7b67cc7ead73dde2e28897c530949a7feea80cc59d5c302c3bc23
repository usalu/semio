   const scope=take("--classes")??"status,query,run,watch",projects=take("--for"),ttl=take("--ttl"),agent=take("--agent"),seconds=ttl===undefined?CORE_POLICY.defaultTtlSeconds:Number(ttl);
   const language=preferredLanguageV1(context.languages),say=key=>(renderTextV1(key,{maximum:CORE_POLICY.maximumLifetimeMilliseconds/1000},[language])??renderBothV1(key,{maximum:CORE_POLICY.maximumLifetimeMilliseconds/1000}))[language]??"";
