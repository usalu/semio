function renderCoreRefusal(code,fields){
 const message={};
 for(const language of SUPPORTED_LANGUAGES_V1)message[language]=CORE_POLICY.messages[language][code].replace(/\{([A-Za-z]+)\}/gu,(_,key)=>String(fields?.[key]??"?"));
