/** ⌨ `repo service …`: status, start, stop, restart, issue, revoke, drop-caches and probe of the resident service of this worktree. */
import {spawn} from "node:child_process";
import {existsSync,readFileSync} from "node:fs";
import {canonicalRootV1,endpointsV1} from "../📨️protocol/📍️endpoint/🟨️.mjs";
import {POLICY_V1,preferredLanguageV1,renderTextV1} from "../📨️protocol/🎚️policy/🟨️.mjs";
import {mintCapabilityV1} from "../📨️protocol/🔑️capability/🟨️.mjs";
import {forwardCommandV1} from "../🚪️client/🟨️.mjs";

/** 🚫 What the watcher and the state never look at: caches, VCS metadata, dependency trees and Bazel's convenience links. */
export const RESIDENT_EXCLUDES_V1=Object.freeze({
 rooted:Object.freeze([".git",".cache",".🧬semio/🦑️repo/⚡️cache",".🧬semio/🦑️repo/🎫️tickets","bazel-out","bazel-bin","bazel-testlogs","bazel-semio"]),
 names:Object.freeze(["node_modules","target","__pycache__",".venv"]),
});
/** 🚧 Directory the service touches to fence the event stream; never excluded. */
export const RESIDENT_FENCE_DIRECTORY_V1=".🧬semio/🦑️repo/🏡️resident-fence";

const sleep=milliseconds=>new Promise(resolve=>setTimeout(resolve,milliseconds));

const say=(languages,key,fields)=>{const text=renderTextV1(key,fields,languages);return text?text[preferredLanguageV1(languages)]??Object.values(text)[0]:key;};

async function ask(options,command,args,cap){
 const out=[],err=[];
 const result=await forwardCommandV1({root:options.root,command,args,cwd:options.root,languages:options.languages,cap,environment:options.environment,stdout:{write:t=>out.push(String(t))},stderr:{write:t=>err.push(String(t))}});
 return{...result,out:out.join(""),err:err.join("")};
}

const adminCapability=runtime=>{try{return mintCapabilityV1(readFileSync(runtime.key),[{k:"notAfter",v:Date.now()+60000}]);}catch{return undefined;}};

/** ⌨ Runs one subcommand and returns the process exit code. */
export async function runResidentCommandV1(options){
 const{root,args,languages,environment=process.env,stdout=process.stdout,stderr=process.stderr}=options,runtime=endpointsV1(canonicalRootV1(root),environment),sub=args[0];
 const print=text=>stdout.write(text.endsWith("\n")?text:text+"\n"),fail=text=>stderr.write(text.endsWith("\n")?text:text+"\n");
 const live=async()=>{const r=await ask({root,languages,environment},"ping",[]);return r.handled&&r.exit===0;};
 const stop=async()=>{
  if(!(await live())){print(say(languages,"service-down",{}));return 0;}
  const r=await ask({root,languages,environment},"stop",[],adminCapability(runtime));
  for(let at=0;at<200&&await live();at++)await sleep(50);
  print(say(languages,"service-stopped",{}));return r.exit??0;
 };
 const start=async()=>{
  if(await live()){const status=JSON.parse((await ask({root,languages,environment},"status",[])).out||"{}");print(say(languages,"service-running",{pid:status.pid??"?"}));return 0;}
  if(args.includes("--foreground")){
   const{runForeground}=options;
   if(!runForeground){fail(say(languages,"service-failed",{reason:"no foreground runner"}));return 1;}
   return runForeground({runtime,root:canonicalRootV1(root),languages,environment});
  }
  const child=spawn(options.execPath??process.execPath,[...(options.scriptArguments??[]),"service","start","--foreground"],{cwd:root,env:{...environment,SEMIO_RESIDENT_CHILD:"1"},stdio:"ignore",detached:true,windowsHide:true});
  child.unref();
  const deadline=Date.now()+(options.startTimeoutMilliseconds??60000);
  let exited=false;child.once("exit",()=>{exited=true;});
  while(Date.now()<deadline&&!exited){
   if(existsSync(runtime.descriptor)&&await live()){const status=JSON.parse((await ask({root,languages,environment},"status",[])).out||"{}");print(say(languages,"service-started",{pid:status.pid??"?",files:status.state?.files??"?",backend:status.watcher?.backend??"?"}));return 0;}
   await sleep(100);
  }
  fail(say(languages,"service-failed",{reason:exited?"exited":"timeout"}));return 1;
 };
 switch(sub){
  case"status":{
   const r=await ask({root,languages,environment},"status",[]);
   if(!r.handled){print(say(languages,"service-down",{}));return 1;}
   print(args.includes("--json")?r.out.trim():JSON.stringify(JSON.parse(r.out),null,2));return r.exit;
  }
  case"probe":return(await live())?0:1;
  case"start":return start();
  case"stop":return stop();
  case"restart":{await stop();return start();}
  case"issue":case"revoke":case"drop-caches":{
   const r=await ask({root,languages,environment},sub,args.slice(1),adminCapability(runtime));
   if(!r.handled){print(say(languages,"service-down",{}));return 1;}
   stdout.write(r.out);if(r.err)stderr.write(r.err);return r.exit;
  }
  default:fail(say(languages,"service-usage",{}));return 1;
 }
}

export{POLICY_V1};
