test("the CLI door reads the config only when no flag and no SEMIO_LANGUAGE decide first and survives a broken log", async () => {
  const directory = temporary(), environment = { SEMIO_CONFIG_DIRECTORY: directory };
  await run(directory, ["set", "language", "de"], {});
  expect(configuredLanguageForDoorV1(directory, [], environment)).toBe("de");
  expect(configuredLanguageForDoorV1(directory, ["--lang=en"], environment)).toBeUndefined();
  expect(configuredLanguageForDoorV1(directory, [], { ...environment, SEMIO_LANGUAGE: "en" })).toBeUndefined();
  writeFileSync(join(directory, "events.jsonl"), "garbage\n");
  const warnings: string[] = [];
  expect(configuredLanguageForDoorV1(directory, [], environment, (line) => warnings.push(line))).toBeUndefined();
  expect(warnings.join("\n")).toContain("Das Konfigurationsprotokoll");
  expect(warnings.join("\n")).toContain("The config log");
  rmSync(directory, { recursive: true });
});
