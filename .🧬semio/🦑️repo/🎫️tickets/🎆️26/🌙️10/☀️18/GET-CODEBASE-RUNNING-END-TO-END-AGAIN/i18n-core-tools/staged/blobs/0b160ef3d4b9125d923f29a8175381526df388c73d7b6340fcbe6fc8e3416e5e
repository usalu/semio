 const current=new Map(rows.filter(row=>row.kind==="stamp").map(row=>[row.path,row.fact])),environment=host.environment??{};
 for(const reason of spec.reasons??[]){const row=describeGenerationReasonV1(reason,{workspaceRoot:host.workspaceRoot,separator:host.separator,current,environment});host.say("reason",{project:row.project,why:row.why});}
