{
  "version": 1,
  "languages": ["en", "de"],
  "labels": {
    "tagline": {
      "en": "Tool-neutral build entry with two implementations: Nx with Bun (default) and Bazel.",
      "de": "Werkzeugneutraler Build-Einstieg mit zwei Implementierungen: Nx mit Bun (Standard) und Bazel."
    },
    "usage": { "en": "Usage", "de": "Verwendung" },
    "commands": { "en": "Commands", "de": "Befehle" },
    "options": { "en": "Options", "de": "Optionen" },
    "globalOptions": { "en": "Global options", "de": "Globale Optionen" },
    "subcommands": { "en": "Subcommands", "de": "Unterbefehle" },
    "examples": { "en": "Examples", "de": "Beispiele" },
    "usedBy": { "en": "used by", "de": "verwendet von" },
    "notes": { "en": "Notes", "de": "Hinweise" }
  },
  "flags": [
    {
      "name": "--tool",
      "value": "required",
      "valueName": "nx|bazel",
      "description": {
        "en": "Select the build implementation; otherwise SEMIO_BUILD_TOOL, then the policy default (nx).",
        "de": "Wählt die Build-Implementierung; sonst SEMIO_BUILD_TOOL, dann der Standard der Policy (nx)."
      }
    },
    {
      "name": "--workers",
      "value": "required",
      "valueName": "on|off",
      "description": {
        "en": "Run actions in persistent workers (on) or in one process each (off); otherwise SEMIO_BUILD_WORKERS, then the worker policy of the build policy.",
        "de": "Führt Aktionen in persistenten Workern (on) oder je in einem eigenen Prozess (off) aus; sonst SEMIO_BUILD_WORKERS, dann die Worker-Policy der Build-Policy."
      }
    },
    {"name": "--service", "value": "required", "valueName": "auto|off|require", "description": {"en": "Use the resident service (auto: when one answers), never use it (off), or fail when none answers (require); otherwise SEMIO_BUILD_SERVICE, then auto.", "de": "Nutzt den residenten Dienst (auto: wenn einer antwortet), nutzt ihn nie (off) oder schlägt fehl, wenn keiner antwortet (require); sonst SEMIO_BUILD_SERVICE, dann auto."}},
    {"name": "--foreground", "value": "none", "operations": ["service"], "description": {"en": "service start: run the service in this terminal instead of detached.", "de": "service start: führt den Dienst in diesem Terminal statt losgelöst aus."}},
    {"name": "--agent", "value": "required", "valueName": "id", "operations": ["service", "session"], "description": {"en": "service issue: the agent the token is issued to; service revoke: revoke every session of this agent.", "de": "service issue: der Agent, dem die Berechtigung ausgestellt wird; service revoke: widerruft alle Sitzungen dieses Agenten."}},
    {"name": "--classes", "value": "required", "valueName": "classes", "operations": ["service"], "description": {"en": "service issue: comma separated command classes the token allows (status, query, run, watch, admin).", "de": "service issue: kommagetrennte Befehlsklassen, die die Berechtigung erlaubt (status, query, run, watch, admin)."}},
    {"name": "--for", "value": "required", "valueName": "names", "operations": ["service"], "description": {"en": "service issue: comma separated project names or prefixes ending in * the token is limited to.", "de": "service issue: kommagetrennte Projektnamen oder Präfixe mit * am Ende, auf die die Berechtigung beschränkt ist."}},
    {"name": "--ttl", "value": "required", "valueName": "seconds", "operations": ["service"], "description": {"en": "service issue: lifetime of the token in seconds (default 3600, at most 86400).", "de": "service issue: Lebensdauer der Berechtigung in Sekunden (Standard 3600, höchstens 86400)."}},
    { "name": "--help", "aliases": ["-h"], "value": "none", "description": { "en": "Print the usage of the command and stop.", "de": "Gibt die Verwendung des Befehls aus und endet." } },
    {
      "name": "--lang",
      "value": "required",
      "valueName": "en|de",
      "description": {
        "en": "Language of the texts; otherwise SEMIO_LANGUAGE, then LANGUAGE and the locale variables (LC_ALL, LC_MESSAGES, LANG), then the operating system language. No language is assumed: the command refuses when none resolves.",
        "de": "Sprache der Texte; sonst SEMIO_LANGUAGE, dann LANGUAGE und die Locale-Variablen (LC_ALL, LC_MESSAGES, LANG), dann die Sprache des Betriebssystems. Es wird keine Sprache angenommen: Der Befehl verweigert sich, wenn keine bestimmt werden kann."
      }
    },
    {
      "name": "--projects",
      "aliases": ["-p"],
      "value": "required",
      "valueName": "projects",
      "operations": ["run-many", "exec", "watch"],
      "description": {
        "en": "Comma list of project names with * wildcards, tag:<tag>, name:<name>, directory:<root> and !<pattern> negation.",
        "de": "Kommaliste von Projektnamen mit *-Platzhaltern, tag:<tag>, name:<name>, directory:<root> und !<Muster> als Verneinung."
      }
    },
    {
      "name": "--exclude",
      "value": "required",
      "valueName": "projects",
      "operations": ["run-many", "affected", "exec", "watch"],
      "description": { "en": "Comma list of projects to leave out (same patterns as --projects).", "de": "Kommaliste auszuschließender Projekte (gleiche Muster wie --projects)." }
    },
    {
      "name": "--targets",
      "aliases": ["--target", "-t"],
      "value": "required",
      "valueName": "targets",
      "operations": ["run-many", "affected"],
      "description": { "en": "Comma list of target names or * patterns.", "de": "Kommaliste von Target-Namen oder *-Mustern." }
    },
    {
      "name": "--configuration",
      "aliases": ["-c"],
      "value": "required",
      "valueName": "prototype|release",
      "operations": ["run", "run-many", "affected", "cargo"],
      "description": {
        "en": "Compiler configuration; disagreeing values (also a :<configuration> suffix or SEMIO_BUILD_MODE) are refused; cargo takes the full name only.",
        "de": "Compiler-Konfiguration; widersprüchliche Werte (auch ein :<Konfiguration>-Suffix oder SEMIO_BUILD_MODE) werden abgelehnt; cargo nimmt nur den vollen Namen."
      }
    },
    {
      "name": "--parallel",
      "value": "required",
      "valueName": "n",
      "operations": ["run", "run-many", "affected"],
      "description": { "en": "Maximum number of concurrent tasks.", "de": "Höchstzahl gleichzeitiger Tasks." }
    },
    {
      "name": "--bail",
      "value": "none",
      "operations": ["run", "run-many", "affected"],
      "description": { "en": "Stop at the first failing task.", "de": "Stoppt bei der ersten fehlschlagenden Task." }
    },
    { "name": "--verbose", "value": "none", "operations": ["run", "run-many", "affected"], "description": { "en": "Print more detail.", "de": "Gibt mehr Details aus." } },
    {
      "name": "--output",
      "aliases": ["--output-style"],
      "value": "required",
      "valueName": "stream|stream-without-prefixes|static",
      "operations": ["run", "run-many", "affected"],
      "description": { "en": "Output style of the task logs.", "de": "Ausgabestil der Task-Logs." }
    },
    { "name": "--skip-cache", "value": "none", "operations": ["run", "run-many", "affected"], "description": { "en": "Ignore the task cache.", "de": "Ignoriert den Task-Cache." } },
    { "name": "--skip-remote-cache", "value": "none", "operations": ["run", "run-many", "affected"], "description": { "en": "Ignore the remote cache.", "de": "Ignoriert den Remote-Cache." } },
    {
      "name": "--exclude-dependencies",
      "aliases": ["--exclude-task-dependencies"],
      "value": "none",
      "operations": ["run", "run-many", "affected"],
      "description": { "en": "Run only the named tasks, not the tasks they depend on.", "de": "Führt nur die benannten Tasks aus, nicht die Tasks, von denen sie abhängen." }
    },
    {
      "name": "--dry-run",
      "value": "none",
      "operations": ["run", "run-many", "affected", "exec", "cache", "remote-cache", "doctor"],
      "description": {
        "en": "Print the task graph as a DryRunPlan on stdout and execute nothing; the same for every tool. With cache gc or remote-cache gc: list what would be removed and remove nothing.",
        "de": "Gibt den Task-Graphen als DryRunPlan auf stdout aus und führt nichts aus; für jedes Werkzeug gleich. Mit cache gc oder remote-cache gc: listet auf, was entfernt würde, und entfernt nichts."
      }
    },
    {
      "name": "--graph",
      "value": "optional",
      "valueName": "file",
      "operations": ["run", "run-many", "affected", "exec"],
      "description": {
        "en": "Same as --dry-run; with a file the plan is written there (Nx: the file as given, Bazel: a report whose path is printed).",
        "de": "Wie --dry-run; mit einer Datei wird der Plan dorthin geschrieben (Nx: die Datei wie angegeben, Bazel: ein Bericht, dessen Pfad ausgegeben wird)."
      }
    },
    {
      "name": "--all",
      "value": "none",
      "operations": ["affected", "watch", "dependencies", "leases", "session"],
      "description": { "en": "Select every project (affected, watch), every dependency owner (dependencies) or every lease directory with registered processes (leases).", "de": "Wählt jedes Projekt (affected, watch), jeden Abhängigkeits-Eigentümer (dependencies) oder jedes Lease-Verzeichnis mit registrierten Prozessen (leases)." }
    },
    {
      "name": "--base",
      "value": "required",
      "valueName": "ref",
      "operations": ["affected"],
      "description": { "en": "Compare against this revision instead of HEAD.", "de": "Vergleicht mit dieser Revision statt mit HEAD." }
    },
    { "name": "--head", "value": "required", "valueName": "ref", "operations": ["affected"], "description": { "en": "End revision of the comparison.", "de": "Endrevision des Vergleichs." } },
    {
      "name": "--files",
      "value": "required",
      "valueName": "files",
      "operations": ["affected"],
      "description": { "en": "Comma list of changed files instead of the git comparison.", "de": "Kommaliste geänderter Dateien statt des Git-Vergleichs." }
    },
    { "name": "--uncommitted", "value": "none", "operations": ["affected"], "description": { "en": "Only uncommitted changes.", "de": "Nur nicht committete Änderungen." } },
    { "name": "--untracked", "value": "none", "operations": ["affected"], "description": { "en": "Only untracked files.", "de": "Nur unverfolgte Dateien." } },
    {
      "name": "--include-global-files",
      "value": "none",
      "operations": ["watch"],
      "description": { "en": "Also react to files outside any project.", "de": "Reagiert auch auf Dateien außerhalb jedes Projekts." }
    },
    {
      "name": "--file",
      "value": "required",
      "valueName": "path",
      "operations": ["graph", "show", "incremental", "concurrency", "bench"],
      "description": { "en": "Write the result as a report file and print its path.", "de": "Schreibt das Ergebnis als Berichtsdatei und gibt deren Pfad aus." }
    },
    {
      "name": "--json",
      "value": "none",
      "operations": ["graph", "show", "incremental", "concurrency", "bench", "capacity", "leases", "cache", "remote-cache", "doctor", "service", "session", "config"],
      "description": { "en": "Print lists as JSON instead of one entry per line.", "de": "Gibt Listen als JSON statt eines Eintrags je Zeile aus." }
    },
    {
      "name": "--area",
      "value": "required",
      "valueName": "id[,id]",
      "operations": ["cache"],
      "description": { "en": "cache status|gc: limit the report or the collection to these ledger areas (or retired, undeclared).", "de": "cache status|gc: beschränkt Bericht oder Einsammeln auf diese Bereiche des Verzeichnisses (oder retired, undeclared)." }
    },
    {
      "name": "--deep",
      "value": "none",
      "operations": ["cache"],
      "description": { "en": "cache status: walk every cache home now (with progress, cancellable) and record the sizes, instead of reading statfs and the size ledger.", "de": "cache status: läuft jetzt jede Cache-Heimat ab (mit Fortschritt, abbrechbar) und erfasst die Größen, statt statfs und das Größenverzeichnis zu lesen." }
    },
    {
      "name": "--tasks",
      "value": "none",
      "operations": ["cache"],
      "description": { "en": "cache status: print the selected tool's task cache (a CacheStatus) instead of the cache ledger.", "de": "cache status: gibt den Task-Cache des gewählten Werkzeugs (einen CacheStatus) statt der Cache-Bilanz aus." }
    },
    {
      "name": "--graph-policy",
      "value": "required",
      "valueName": "fresh|current",
      "operations": ["graph", "show"],
      "description": {
        "en": "fresh (default) verifies the graph and waits for a rebuild when a project changed; current serves the newest sealed graph at once and never waits; otherwise SEMIO_BUILD_GRAPH_POLICY.",
        "de": "fresh (Standard) prüft den Graphen und wartet bei geänderten Projekten auf den Neuaufbau; current liefert sofort den neuesten versiegelten Graphen und wartet nie; sonst SEMIO_BUILD_GRAPH_POLICY."
      }
    },
    {
      "name": "--scenario",
      "value": "required",
      "valueName": "ids|all",
      "operations": ["incremental"],
      "description": { "en": "incremental plan|run: comma list of scenario ids, or all.", "de": "incremental plan|run: Kommaliste von Szenario-IDs oder all." }
    },
    {
      "name": "--implementations",
      "value": "required",
      "valueName": "nx,bazel",
      "operations": ["incremental", "concurrency", "bench"],
      "description": { "en": "incremental, concurrency and bench plan|run: implementations to judge (default: both).", "de": "incremental, concurrency und bench plan|run: zu prüfende Implementierungen (Standard: beide)." }
    },
    {
      "name": "--root",
      "value": "required",
      "valueName": "path",
      "operations": ["incremental", "concurrency", "bench"],
      "description": { "en": "incremental, concurrency, bench: the disposable repository copy (default: the folder sinc in the temporary directory of the process); it must not lie inside or contain the checkout, and its path stays short because absolute paths are limited to 256 characters.", "de": "incremental, concurrency, bench: die Wegwerf-Kopie des Repositorys (Standard: der Ordner sinc im temporären Verzeichnis des Prozesses); sie darf weder im Checkout liegen noch ihn enthalten, und ihr Pfad bleibt kurz, weil absolute Pfade auf 256 Zeichen begrenzt sind." }
    },
    {
      "name": "--phases",
      "value": "required",
      "valueName": "warm,edit,revert",
      "operations": ["incremental"],
      "description": { "en": "incremental run: phases to judge (default: all three).", "de": "incremental run: zu prüfende Phasen (Standard: alle drei)." }
    },
    {
      "name": "--fresh",
      "value": "none",
      "operations": ["incremental"],
      "description": { "en": "incremental prepare: discard the copy and clone it again.", "de": "incremental prepare: verwirft die Kopie und klont sie neu." }
    },
    {
      "name": "--workloads",
      "value": "required",
      "valueName": "ids|all",
      "operations": ["concurrency"],
      "description": { "en": "concurrency plan|run: comma list of workload ids, or all.", "de": "concurrency plan|run: Kommaliste von Arbeitslast-IDs oder all." }
    },
    {
      "name": "--sessions",
      "value": "required",
      "valueName": "n",
      "operations": ["concurrency"],
      "description": { "en": "concurrency plan|run: simulated agents per workload, the first n of its sessions (default: 3, at most 8).", "de": "concurrency plan|run: simulierte Agenten je Arbeitslast, die ersten n ihrer Sitzungen (Standard: 3, höchstens 8)." }
    },
    {
      "name": "--criteria",
      "value": "required",
      "valueName": "id",
      "operations": ["concurrency"],
      "description": { "en": "concurrency run: judge every workload with this set of pass criteria instead of its own.", "de": "concurrency run: beurteilt jede Arbeitslast mit diesen Abnahmekriterien statt mit ihren eigenen." }
    },
    {
      "name": "--slo",
      "value": "required",
      "valueName": "ids|all",
      "operations": ["bench"],
      "description": { "en": "bench run: comma list of objective ids, probe:<id>, kind:<cli-help|noop|edit|graph|cache|concurrency>, or all.", "de": "bench run: Kommaliste von Ziel-IDs, probe:<id>, kind:<cli-help|noop|edit|graph|cache|concurrency> oder all." }
    },
    {
      "name": "--runs",
      "value": "required",
      "valueName": "n",
      "operations": ["bench"],
      "description": { "en": "bench run: samples per probe instead of the authored count (the 95th percentile needs 20 samples, the 99th needs 100; fewer leave those objectives unproven).", "de": "bench run: Stichproben je Messung statt der verfassten Anzahl (das 95. Perzentil braucht 20 Stichproben, das 99. braucht 100; bei weniger bleiben diese Ziele unbewiesen)." }
    },
    {
      "name": "--baseline",
      "value": "required",
      "valueName": "path",
      "operations": ["bench"],
      "description": { "en": "bench run|compare: a stored report to compare with; a change beyond the tolerance of an objective is a regression or an improvement.", "de": "bench run|compare: ein gespeicherter Bericht als Referenz; eine Änderung über die Toleranz eines Ziels hinaus ist eine Verschlechterung oder Verbesserung." }
    },
    {
      "name": "--save-baseline",
      "value": "required",
      "valueName": "path",
      "operations": ["bench"],
      "description": { "en": "bench run: store the report as the baseline of later runs.", "de": "bench run: speichert den Bericht als Referenz für spätere Läufe." }
    },
    {
      "name": "--current",
      "value": "required",
      "valueName": "path",
      "operations": ["bench"],
      "description": { "en": "bench compare: the stored report to judge against --baseline.", "de": "bench compare: der gespeicherte Bericht, der gegen --baseline beurteilt wird." }
    },
    {
      "name": "--markdown",
      "value": "required",
      "valueName": "path",
      "operations": ["bench"],
      "description": { "en": "bench run|compare: also write the report as a markdown file.", "de": "bench run|compare: schreibt den Bericht zusätzlich als Markdown-Datei." }
    },
    {
      "name": "--max-load",
      "value": "required",
      "valueName": "per-core",
      "operations": ["bench"],
      "description": { "en": "bench run: refuse to start when the one-minute load per core of the host exceeds this number.", "de": "bench run: startet nicht, wenn die Einminutenlast je Kern des Rechners diese Zahl überschreitet." }
    },
    {
      "name": "--prepare",
      "value": "none",
      "operations": ["bench"],
      "description": { "en": "bench run: discard and prepare the disposable copy first, so that the cold graph probe starts from a copy without graph.", "de": "bench run: verwirft die Wegwerf-Kopie und bereitet sie zuerst vor, damit die Messung des kalten Graphen von einer Kopie ohne Graph startet." }
    },
    {
      "name": "--scope",
      "value": "separate",
      "valueName": "owner",
      "operations": ["dependencies"],
      "description": { "en": "Restrict the operation to one dependency owner.", "de": "Beschränkt die Operation auf einen Abhängigkeits-Eigentümer." }
    },
    {
      "name": "--store",
      "value": "required",
      "valueName": "shared|isolated",
      "operations": ["cargo"],
      "description": { "en": "Cargo target store; never create a private target directory.", "de": "Cargo-Zielspeicher; niemals ein privates Zielverzeichnis anlegen." }
    },
    {
      "name": "--parallelism",
      "value": "required",
      "valueName": "cores",
      "operations": ["cargo"],
      "description": { "en": "Positive number of cores for Cargo.", "de": "Positive Anzahl von Kernen für Cargo." }
    },
    {
      "name": "--port",
      "value": "separate",
      "valueName": "port",
      "operations": ["remote-cache"],
      "description": { "en": "remote-cache serve: port to listen on; 0 picks a free port (default from the build policy).", "de": "remote-cache serve: Port, auf dem gelauscht wird; 0 wählt einen freien Port (Standard aus der Build-Policy)." }
    },
    {
      "name": "--host",
      "value": "separate",
      "valueName": "address",
      "operations": ["remote-cache"],
      "description": { "en": "remote-cache serve: address to listen on; beyond loopback a token is required.", "de": "remote-cache serve: Adresse, auf der gelauscht wird; außerhalb von Loopback ist ein Token nötig." }
    },
    {
      "name": "--directory",
      "value": "separate",
      "valueName": "path",
      "operations": ["remote-cache"],
      "description": { "en": "remote-cache serve|status|gc: store directory, relative to the workspace root (default: the remote cache home of the cache ledger).", "de": "remote-cache serve|status|gc: Speicherverzeichnis, relativ zum Workspace-Wurzelverzeichnis (Standard: die Remote-Cache-Heimat der Cache-Bilanz)." }
    },
    {
      "name": "--max-bytes",
      "value": "separate",
      "valueName": "bytes",
      "operations": ["remote-cache"],
      "description": { "en": "remote-cache serve|gc: upper bound of the store; the least recently used entries are evicted beyond it.", "de": "remote-cache serve|gc: Obergrenze des Speichers; darüber werden die am längsten ungenutzten Einträge entfernt." }
    },
    {
      "name": "--read-only",
      "value": "none",
      "operations": ["remote-cache"],
      "description": { "en": "remote-cache serve: refuse every write with 403, whatever token is presented.", "de": "remote-cache serve: lehnt jedes Schreiben mit 403 ab, welches Token auch vorgelegt wird." }
    },
    {
      "name": "--tls-certificate",
      "value": "separate",
      "valueName": "path",
      "operations": ["remote-cache", "remote-execution"],
      "description": { "en": "remote-cache serve, remote-execution serve: PEM certificate chain; together with --tls-key the server speaks HTTPS (grpcs for the execution service).", "de": "remote-cache serve, remote-execution serve: PEM-Zertifikatskette; zusammen mit --tls-key spricht der Server HTTPS (grpcs beim Ausführungsdienst)." }
    },
    {
      "name": "--tls-key",
      "value": "separate",
      "valueName": "path",
      "operations": ["remote-cache", "remote-execution"],
      "description": { "en": "remote-cache serve, remote-execution serve: PEM private key of the certificate.", "de": "remote-cache serve, remote-execution serve: PEM-Privatschlüssel des Zertifikats." }
    },
    {
      "name": "--bind",
      "value": "separate",
      "valueName": "address",
      "operations": ["remote-execution"],
      "description": { "en": "remote-execution serve: address both listeners bind to (default 127.0.0.1); beyond loopback the cache tokens and the worker token are required.", "de": "remote-execution serve: Adresse, an die beide Listener gebunden werden (Standard 127.0.0.1); außerhalb von Loopback sind die Cache-Tokens und das Worker-Token nötig." }
    },
    {
      "name": "--grpc-port",
      "value": "separate",
      "valueName": "port",
      "operations": ["remote-execution"],
      "description": { "en": "remote-execution serve: port of the gRPC listener for build tools (default 8980); 0 picks a free port.", "de": "remote-execution serve: Port des gRPC-Listeners für Build-Werkzeuge (Standard 8980); 0 wählt einen freien Port." }
    },
    {
      "name": "--worker-port",
      "value": "separate",
      "valueName": "port",
      "operations": ["remote-execution"],
      "description": { "en": "remote-execution serve: port of the HTTP listener for workers and status (default 8981); 0 picks a free port.", "de": "remote-execution serve: Port des HTTP-Listeners für Worker und Status (Standard 8981); 0 wählt einen freien Port." }
    },
    {
      "name": "--cache",
      "value": "separate",
      "valueName": "url",
      "operations": ["remote-execution"],
      "description": { "en": "remote-execution serve: the shared store to use, the URL of a running repo remote-cache server; by default serve starts the store itself.", "de": "remote-execution serve: der zu verwendende gemeinsame Speicher, die URL eines laufenden repo-remote-cache-Servers; standardmäßig startet serve den Speicher selbst." }
    },
    {
      "name": "--local-workers",
      "value": "separate",
      "valueName": "n",
      "operations": ["remote-execution"],
      "description": { "en": "remote-execution serve: worker processes started with the service (default 1; 0 starts none).", "de": "remote-execution serve: mit dem Dienst gestartete Worker-Prozesse (Standard 1; 0 startet keinen)." }
    },
    {
      "name": "--concurrency",
      "value": "separate",
      "valueName": "n",
      "operations": ["remote-execution"],
      "description": { "en": "remote-execution serve|workers: actions one worker runs at the same time (default: one per CPU).", "de": "remote-execution serve|workers: Actions, die ein Worker gleichzeitig ausführt (Standard: eine je CPU)." }
    },
    {
      "name": "--advertise",
      "value": "separate",
      "valueName": "host",
      "operations": ["remote-execution"],
