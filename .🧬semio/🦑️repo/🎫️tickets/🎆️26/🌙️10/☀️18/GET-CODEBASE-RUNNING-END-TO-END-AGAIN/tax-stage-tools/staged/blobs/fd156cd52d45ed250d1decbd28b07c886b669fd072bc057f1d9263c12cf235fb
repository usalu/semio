test("Nx staged publication preserves arbitrary primary while all cleanup failures remain observable",async()=>{
 const source=await readFile(new URL("../../🟦️.ts",import.meta.url),"utf8"),tree=ts.createSourceFile("tools.ts",source,ts.ScriptTarget.Latest,true);let stage:import("typescript").TryStatement|undefined;const visit=(node:import("typescript").Node)=>{if(ts.isTryStatement(node)&&node.finallyBlock?.getText(tree).includes("rmSync(staging,"))stage=node;ts.forEachChild(node,visit);};visit(tree);if(!stage||!stage.finallyBlock||!ts.isBlock(stage.parent))throw Error("Actual staged publication cleanup required");const statements=stage.parent.statements,index=statements.indexOf(stage),prior=statements.slice(0,index),staging=prior.findIndex(node=>node.getText(tree).includes('mkdtempSync(join(base, ".stage-"))'));if(staging<0)throw Error("Actual staging declaration required");const prefix=prior.slice(staging+1).map(node=>node.getText(tree)).join("\n"),returned=stage.tryBlock.statements.at(-1);if(!returned||!ts.isReturnStatement(returned)||!returned.expression)throw Error("Actual staged result required");const boundary=ts.isAwaitExpression(returned.expression)?"return await body();":"return body();",text="async function run(body,rmSync,staging,console){"+prefix+"try{"+boundary+"}"+(stage.catchClause?.getText(tree)??"")+stage.finallyBlock.getText(tree).replace(/^\{/,"finally{")+"}",code=ts.transpileModule(text,{compilerOptions:{target:ts.ScriptTarget.ESNext}}).outputText,run=new Function(code+";return run;")()as(body:()=>Promise<string>,cleanup:()=>void,path:string,logger:{error:()=>void})=>Promise<string>,admit=new Ajv({strict:true}).compile(schema),db=new Database(":memory:");
 try{for(const row of corpus.cases){expect(admit(row)).toBe(true);const primary=row.body==="undefined"?undefined:row.body==="primitive"?"primitive-primary":Object.freeze(Error("frozen-primary")),secondary=Error("cleanup-secondary");let cleanup=0,diagnostic=0,failed=false,failure:unknown,value:unknown;try{value=await run(async()=>{await Promise.resolve();if(row.body!=="resolve")throw primary;return"published";},()=>{cleanup++;if(row.cleanup==="throw")throw secondary;},"/owned/staging",{error:()=>{diagnostic++;if(row.diagnostic==="throw")throw Error("diagnostic-secondary");}});}catch(error){failed=true;failure=error;}const oracle=db.query("select case when ?!='resolve' then 'body' when ?='throw' then 'cleanup' else 'value' end outcome").get(row.body,row.cleanup)as{outcome:string};expect(oracle.outcome).toBe(row.expected);expect(cleanup).toBe(1);expect(failed).toBe(row.expected!=="value");if(row.expected==="value")expect(value).toBe("published");else expect(failure).toBe(row.expected==="body"?primary:secondary);if(row.body!=="resolve"&&row.cleanup==="throw")expect(diagnostic).toBe(1);}}
 finally{db.close();}expect(await readFile(new URL("../../🟦️.ts",import.meta.url),"utf8")).toBe(source);
