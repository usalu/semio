test("published compiler wrapper retains closed captured workspace resolutions",()=>{
 expect(new Ajv({strict:true}).validate(schema,corpus)).toBe(true);const source=ts.createSourceFile("tools.ts",readFileSync(new URL("../../../🟦️.ts",import.meta.url),"utf8"),ts.ScriptTarget.Latest,true);let statement:ts.CallExpression|undefined;function visit(node:ts.Node):void{if(ts.isCallExpression(node)&&node.expression.getText(source)==="files.set"&&node.arguments[0]&&ts.isStringLiteral(node.arguments[0])&&node.arguments[0].text===".semio-authorizer-compiler.json")statement=node;ts.forEachChild(node,visit);}visit(source);if(!statement)throw Error("Actual compiler publication builder required");const code=ts.transpileModule(statement.getText(source),{compilerOptions:{target:ts.ScriptTarget.ES2022}}).outputText,ajv=new Ajv({strict:true});ajv.addSchema(authorizerSchema);const validate=ajv.compile({$ref:authorizerSchema.$id+"#/$defs/CompilerPublication"}),db=new Database(":memory:");try{for(const row of corpus.publications){const files=new Map<string,Buffer>(),compiler={manifest:{resolutions:row.resolutions,sources:[{path:"entry.ts",sha256:"a".repeat(64)}]}};new Function("files","compiler","manifest","Buffer",code)(files,compiler,{packageManager:"bun@1.3.9"},Buffer);const bytes=files.get(".semio-authorizer-compiler.json");if(!bytes)throw Error("Actual published compiler bytes required");const publication=JSON.parse(bytes.toString());expect(validate(publication),JSON.stringify(validate.errors)).toBe(true);expect(publication.resolutions).toEqual(row.resolutions);expect(JSON.parse((db.query("select json_extract(?,'$.resolutions') value").get(bytes.toString())as{value:string}).value)).toEqual(row.resolutions);const missing={...publication};delete missing.resolutions;expect(validate(missing)).toBe(false);expect(validate({...publication,unexpected:true})).toBe(false);expect(new Ajv({strict:true}).validate(authorizerSchema,{version:1,mode:"release",entry:"entry.ts",resolutions:publication.resolutions,sources:publication.sources})).toBe(true);}}finally{db.close();}
