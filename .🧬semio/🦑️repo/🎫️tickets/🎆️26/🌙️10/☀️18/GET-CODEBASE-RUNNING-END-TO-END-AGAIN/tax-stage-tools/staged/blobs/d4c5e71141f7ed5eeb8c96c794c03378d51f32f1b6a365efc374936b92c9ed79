}).maximum;expect(checkResourceLeaseControl(control)!).toBeLessThanOrEqual(upper);expect(calls.filter(name=>name==="withBuildTestInvocationV1").length).toBe(1);expect(calls).not.toContain("receiveScriptProcessInvocation");const body=store!.arguments[4];if(!body||!ts.isArrowFunction(body))throw Error("Actual accepted callback required");expect(body.parameters[1]?.name.getText(source)).toBe("storePhase");released=control;},new AbortController().signal);if(!released)throw Error("Actual compiler child required");expect(()=>requireIssuedResourceControlV1(released!)).toThrow();}console.log("[DEBUG] Actual "+corpus.cases.length+" authorizer compiler initializers retain genuine accepted phase, SQLite shrinking bound and released lifetime; no Tools/store opened");}finally{db.close();}
