  await fs.mkdir(directory,{recursive:true});await fs.writeFile(join(directory,"value.txt"),data);
  for(const entry of fixture.entries)await fs.symlink(entry.link,join(root,entry.path),entry.linkKind==="directory"?"dir":"file");
  await fs.chmod(directory,fixture.directoryMode);const mode=(await fs.lstat(directory)).mode&0o777;
  await captureBazelSnapshotV1({version:1,workspace:root,runtime:join(root,"runtime.json"),task:{id:"fixture:build",project:"fixture",target:"build",label:"t_links",dependencies:[],args:[],definition:{execution:{kind:"noop"},outputs:["out"]},root:"."}},snapshot,original);
  const captured=JSON.parse(await fs.readFile(join(snapshot,"snapshot.json"),"utf8"));for(const entry of fixture.entries){const actual=captured.entries.find((row:{path:string})=>row.path===entry.path);expect(actual).toMatchObject({path:entry.path,kind:entry.kind,link:entry.link,linkKind:entry.linkKind});expect(actual.mode).toBe((await fs.lstat(join(root,entry.path))).mode&0o777);}
  await fs.chmod(directory,0o755);await fs.rm(join(root,"out"),{recursive:true});const symlink=fs.symlink;observer=spyOn(fs,"symlink").mockImplementation(async(target,path,type)=>{types.push(type);await symlink(target,path,type);});
  await restoreBazelSnapshotV1(root,snapshot,original,createIssuedResourceControlV1(original,"bazel:snapshot-fixture",0));expect(types).toEqual(fixture.expectedTypes);
  for(const entry of fixture.entries){expect(await fs.readlink(join(root,entry.path))).toBe(entry.link);expect((await fs.stat(join(root,entry.path))).isDirectory()).toBe(entry.linkKind==="directory");}
  expect(await fs.readFile(join(root,"out/b"))).toEqual(data);expect((await fs.lstat(directory)).mode&0o777).toBe(mode);expect((await glob("out/**/*",{cwd:root,onlyFiles:false,followSymbolicLinks:false})).sort()).toEqual(fixture.expectedPaths);
  const before=types.length;await restoreBazelSnapshotV1(root,snapshot,original,createIssuedResourceControlV1(original,"bazel:snapshot-fixture",0));expect(types.length).toBe(before);
  await fs.writeFile(join(directory,"value.txt"),"changed");await restoreBazelSnapshotV1(root,snapshot,original,createIssuedResourceControlV1(original,"bazel:snapshot-fixture",0));expect(await fs.readFile(join(root,"out/b"))).toEqual(data);expect((await fs.lstat(directory)).mode&0o777).toBe(mode);
 }finally{observer?.mockRestore();await fs.chmod(directory,0o755).catch(error=>{if((error as NodeJS.ErrnoException).code!=="ENOENT")throw error;});await fs.rm(root,{recursive:true,force:true});}
}));

test.skipIf(!process.env.SEMIO_TEST_ARTIFACT_DIR)("Bazel snapshot directory handles close without replacing a primary failure",()=>withBuildTestInvocationV1(async original=>{
 const{captureBazelSnapshotV1,restoreBazelSnapshotV1}=await import("../../🟦️.ts"),database=new Database(":memory:"),admit=new Ajv({strict:true}).compile(fixture.modeCleanupSchema),oracle=database.query("select case when ? != 'success' then 'body' when ? != 'success' then 'close' else 'success' end as outcome");
 try{for(const row of fixture.modeCleanup){
  expect(admit(row)).toBe(true);expect((oracle.get(row.body,row.close)as{outcome:string}).outcome).toBe(row.expected);
  const root=join(process.env.SEMIO_TEST_ARTIFACT_DIR!,"mode-close-"+randomUUID().slice(0,8)),target=join(root,"out"),snapshot=join(root,"snapshot"),primary=row.body==="undefined"?undefined:Error("mode-primary"),secondary=Error("mode-close"),observers:{mockRestore():void}[]=[];let closed=0,failed=false,received:unknown,handle:Awaited<ReturnType<typeof fs.open>>|undefined;
  try{
   await fs.mkdir(target,{recursive:true});await fs.writeFile(join(target,"value"),"captured");await captureBazelSnapshotV1({version:1,workspace:root,runtime:join(root,"runtime.json"),task:{id:"fixture:build",project:"fixture",target:"build",label:"t_close",dependencies:[],args:[],definition:{execution:{kind:"noop"},outputs:["out"]},root:"."}},snapshot,original);await fs.rm(target,{recursive:true});
   const open=fs.open;observers.push(spyOn(fs,"open").mockImplementation(async(...args)=>{const current=await open(...args);if(String(args[0])===target){handle=current;const chmod=current.chmod.bind(current),close=current.close.bind(current);observers.push(spyOn(current,"chmod").mockImplementation(async mode=>{if(row.body!=="success")throw primary;await chmod(mode);}));observers.push(spyOn(current,"close").mockImplementation(async()=>{closed++;await close();if(row.close!=="success")throw secondary;}));}return current;}));
   try{await restoreBazelSnapshotV1(root,snapshot,original,createIssuedResourceControlV1(original,"bazel:snapshot-fixture",0));}catch(error){failed=true;received=error;}
   expect(closed).toBe(1);expect(failed).toBe(row.expected!=="success");if(failed)expect(received).toBe(row.expected==="body"?primary:secondary);expect(handle).toBeDefined();await expect(handle!.stat()).rejects.toThrow();
  }finally{for(const observer of observers.reverse())observer.mockRestore();await fs.rm(root,{recursive:true,force:true});}
 }}finally{database.close();}
}));

test.skipIf(!process.env.SEMIO_TEST_ARTIFACT_DIR)("Bazel snapshot directory modes never follow a replacement symlink",()=>withBuildTestInvocationV1(async original=>{
 const{captureBazelSnapshotV1,restoreBazelSnapshotV1}=await import("../../🟦️.ts"),database=new Database(":memory:"),oracle=database.query("select case when ? = 1 then ? else ? end as mode");
 try{for(const row of fixture.modeRaces){
  const root=join(process.env.SEMIO_TEST_ARTIFACT_DIR!,"mode-"+randomUUID().slice(0,8)),target=join(root,"out/nested"),moved=join(root,"moved"),foreign=join(root,"foreign"),snapshot=join(root,"snapshot"),observers:{mockRestore():void}[]=[];let swaps=0,refused=false;
  try{
   await fs.mkdir(target,{recursive:true});await fs.mkdir(foreign);await fs.writeFile(join(target,"value"),"captured");await fs.chmod(target,fixture.directoryMode);await fs.chmod(foreign,row.foreignMode);const foreignMode=(await fs.lstat(foreign)).mode&0o777;
   await captureBazelSnapshotV1({version:1,workspace:root,runtime:join(root,"runtime.json"),task:{id:"fixture:build",project:"fixture",target:"build",label:"t_modes",dependencies:[],args:[],definition:{execution:{kind:"noop"},outputs:["out"]},root:"."}},snapshot,original);
   if(row.stage==="final"){await fs.chmod(target,0o755);await fs.rm(join(root,"out"),{recursive:true});}else await fs.writeFile(join(target,"value"),"changed");
   const swap=async()=>{if(swaps++)throw Error("Directory mode syscall repeated after replacement");await fs.rename(target,moved);await fs.symlink(foreign,target,"dir");},chmod=fs.chmod,open=fs.open;
   observers.push(spyOn(fs,"chmod").mockImplementation(async(path,mode)=>{if(String(path)===target)await swap();await chmod(path,mode);}));
   observers.push(spyOn(fs,"open").mockImplementation(async(...args)=>{const handle=await open(...args);if(String(args[0])===target){const mode=handle.chmod.bind(handle);observers.push(spyOn(handle,"chmod").mockImplementation(async value=>{await swap();return mode(value);}));}return handle;}));
   try{await restoreBazelSnapshotV1(root,snapshot,original,createIssuedResourceControlV1(original,"bazel:snapshot-fixture",0));}catch{refused=true;}
   expect(swaps).toBe(1);expect((await fs.lstat(foreign)).mode&0o777).toBe((oracle.get(Number(row.preserved),foreignMode,fixture.directoryMode)as{mode:number}).mode);expect(refused).toBe(true);
  }finally{for(const observer of observers.reverse())observer.mockRestore();for(const path of[target,moved])try{const facts=await fs.lstat(path);if(facts.isDirectory()&&!facts.isSymbolicLink())await fs.chmod(path,0o755);}catch(error){if((error as NodeJS.ErrnoException).code!=="ENOENT")throw error;}await fs.rm(root,{recursive:true,force:true});}
 }}finally{database.close();}
