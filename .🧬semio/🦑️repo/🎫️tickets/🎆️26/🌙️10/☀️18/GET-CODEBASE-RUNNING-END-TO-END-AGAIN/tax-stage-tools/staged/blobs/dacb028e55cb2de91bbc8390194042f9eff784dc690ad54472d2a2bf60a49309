import{test,expect}from"bun:test";import{readFile}from"node:fs/promises";import Ajv from"ajv";import{Database}from"bun:sqlite";import schema from"../🧬️schema/🔣️.json";import corpus from"./🔣️.json";
test("Native graph expected physical refusals use a closed same-wire process purpose",async()=>{const source=await readFile(new URL("../../🟦️.ts",import.meta.url),"utf8"),admit=new Ajv({strict:true,allowUnionTypes:true}).compile(schema),db=new Database(":memory:");try{db.exec("create table purposes(kind text primary key,reason text)");for(const row of corpus.cases){expect(admit({version:1,kind:row.kind,directory:"/owned/generated/p"})).toBe(true);db.query("insert into purposes values(?,?)").run(row.kind,row.expectedReason);expect(schema.definitions.Protocol.const.reasons[row.kind as keyof typeof schema.definitions.Protocol.const.reasons]).toBe((db.query("select reason from purposes where kind=?").get(row.kind)as{reason:string}).reason);}expect(admit({version:1,kind:"foreign",directory:"/owned/generated/p"})).toBe(false);}finally{db.close();}expect(source).toContain('captureNxGraphPurposeV1(original,"pressure")');expect(source).toContain('captureNxGraphPurposeV1(original,"watcher")');});

test("Native graph purpose child honestly fails its enrolled ledger while parent continues",async()=>{const{receiveScriptProcessInvocation,withIssuedResourceControlV1}=await import("../../../../../../../../../../../../🔨️modules/🏃️process/📦️packages/🟦️typescript/🧭️routing/🟦️.ts"),{captureNxGraphPurposeV1}=await import("../🟦️.ts");await receiveScriptProcessInvocation(process.env,async original=>{await captureNxGraphPurposeV1(original,"ledger");expect(await withIssuedResourceControlV1(original,"nx:graph-purpose:healthy",0,async()=>"healthy")).toBe("healthy");});});

test("Native graph purpose cleanup preserves undefined and frozen primaries and refuses cleanup after success",async()=>{const ts=await import("typescript"),source=await readFile(new URL("../📦️child/🟦️.ts",import.meta.url),"utf8"),tree=ts.createSourceFile("purpose.ts",source,ts.ScriptTarget.Latest,true),node=tree.statements.find(node=>ts.isFunctionDeclaration(node)&&node.name?.text==="withPurposeCleanupV1");if(!node)throw Error("Actual purpose cleanup owner required");const code=ts.transpileModule(node.getText(tree),{compilerOptions:{target:ts.ScriptTarget.ESNext}}).outputText,run=new Function(code+";return withPurposeCleanupV1;")(),db=new Database(":memory:");try{for(const row of corpus.cleanupCases){const primary=row.body==="undefined"?undefined:Object.freeze(Error("frozen-primary")),secondary=Error("cleanup-secondary");let cleanup=false,caught=false,failure:unknown;try{await run(async()=>{if(row.body!=="resolve")throw primary;return"done";},async()=>{cleanup=true;throw secondary;});}catch(error){caught=true;failure=error;}expect(caught).toBe(true);expect(cleanup).toBe(true);const oracle=db.query("select case when ?='resolve' then 'cleanup' else 'body' end outcome").get(row.body)as{outcome:string};expect(oracle.outcome).toBe(row.expected);expect(failure).toBe(oracle.outcome==="body"?primary:secondary);}}finally{db.close();}});
