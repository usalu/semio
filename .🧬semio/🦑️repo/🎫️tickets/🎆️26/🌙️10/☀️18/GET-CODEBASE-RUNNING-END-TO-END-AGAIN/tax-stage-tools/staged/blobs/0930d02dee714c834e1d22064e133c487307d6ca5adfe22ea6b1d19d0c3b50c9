 try{check();const before=await file.stat({bigint:true});check();if(!before.isFile()||before.nlink!==1n||before.size>BigInt(maximumBytes))throw Error("Bounded toolkit purpose input required");const bytes=Buffer.alloc(Number(before.size));for(let offset=0;offset<bytes.length;){check();const row=await file.read(bytes,offset,Math.min(128,bytes.length-offset),offset);check();if(!row.bytesRead)throw Error("Toolkit purpose input shortened");offset+=row.bytesRead;}const after=await file.stat({bigint:true}),named=await lstat(path,{bigint:true});check();if(named.isSymbolicLink()||["dev","ino","size","mtimeNs","ctimeNs"].some(key=>before[key as keyof typeof before]!==after[key as keyof typeof after]||before[key as keyof typeof before]!==named[key as keyof typeof named]))throw Error("Toolkit purpose input changed");for(const[parent,stamp]of parents){const row=await lstat(parent,{bigint:true});check();if(!row.isDirectory()||row.isSymbolicLink()||[row.dev,row.ino].join(":")!==stamp)throw Error("Toolkit purpose ancestry changed");}return JSON.parse(bytes.toString("utf8"));
 }catch(error){failed=true;throw error;}finally{try{await file.close();}catch(error){if(!failed)throw error;}}
}

