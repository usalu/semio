test("neutral context observer fixture retains exact five-phase Source and independent TOML SQLite closure",()=>{expect(new Ajv({strict:true}).validate(schema,corpus)).toBe(true);const db=new Database(":memory:");try{db.exec("create table dependencies(source text,target text);insert into dependencies values('profile_dependency','profile_arguments')");let files=createCargoContextFixtureV1();expect(Object.isFrozen(files)&&files.every(Object.isFrozen)).toBe(true);expect(files).toHaveLength(5);let prior="";for(const phase of corpus.phases){files=applyCargoContextPhaseV1(files,phase.name);const values=new Map(files.map(row=>[row.path,row.content])),manifest=TOML.parse(values.get("Cargo.toml")!)as{profile:{prototype:{"codegen-units":number;inherits:string}};dependencies:{profile_dependency:{path:string}}},config=TOML.parse(values.get(".cargo/config.toml")!)as{profile:{prototype:{"codegen-units":number}}};expect(Bun.TOML.parse(values.get("Cargo.toml")!)).toEqual(manifest);expect(manifest.dependencies.profile_dependency.path).toBe("leaf");const{inherits,...settings}=manifest.profile.prototype;expect(inherits).toBe("dev");expect(config.profile.prototype).toEqual(settings);expect(manifest.profile.prototype["codegen-units"]).toBe(phase.name==="context"?128:256);expect(values.get("lib.rs")).toContain("VALUE:u8="+(["cold","unchanged"].includes(phase.name)?7:8));expect(values.get("leaf/lib.rs")).toContain(["leaf-body","context"].includes(phase.name)?"{12}":"{11}");const encoded=JSON.stringify(files),digest=createHash("sha256").update(encoded).digest("hex");expect(new Bun.CryptoHasher("sha256").update(encoded).digest("hex")).toBe(digest);if(phase.name==="unchanged")expect(digest).toBe(prior);else if(prior)expect(digest).not.toBe(prior);prior=digest;const seeds=phase.affected.filter(name=>name!=="profile_arguments"||!phase.affected.includes("profile_dependency")),actual=db.query("with recursive changed(name) as(select value from json_each(?) union select d.target from dependencies d join changed c on c.name=d.source) select name from changed order by name").all(JSON.stringify(seeds)).map(row=>(row as{name:string}).name);expect(actual).toEqual([...phase.affected].sort());expect(files.reduce((total,row)=>total+Buffer.byteLength(row.content),0)).toBeLessThanOrEqual(corpus.limits.maximumSourceBytes);expect(Object.isFrozen(files)&&files.every(Object.isFrozen)).toBe(true);}expect(()=>applyCargoContextPhaseV1(files,"root-body")).toThrow("exactly once");expect(()=>applyCargoContextPhaseV1(files,"unknown")).toThrow();expect(()=>applyCargoContextPhaseV1([...files,files[0]!],"unchanged")).toThrow();}finally{db.close();}});
