import {admitCargoSourceBoundariesV1,actualCargoSourceAdmissionPortV1} from "@semio-tech/process/artifacts/native-build/source/admission";
test("ordinary selected Cargo crates refuse byte/file/active-line growth before a compiler port exists",async()=>{
 const row=fixture.cases[0]!,graph=readCargoCompilationGraphV1({version:1,roots:row.roots,units:row.units},fixture.metadata,"/repo"),control={signal:new AbortController().signal,remainingMilliseconds:()=>null,publish:async()=>{},yieldContinuation:async()=>{}},encoder=new TextEncoder();
 for(const testCase of [{id:"small",source:"pub fn value(){}",limits:{maxSourceBytes:64,maxSourceFiles:4,maxActiveLines:8},refuse:false},{id:"bytes",source:"x".repeat(65),limits:{maxSourceBytes:64,maxSourceFiles:4,maxActiveLines:8},refuse:true},{id:"files",source:"mod extra;",limits:{maxSourceBytes:64,maxSourceFiles:1,maxActiveLines:8},refuse:true},{id:"lines",source:"pub fn value(){}\n\n\n",limits:{maxSourceBytes:64,maxSourceFiles:4,maxActiveLines:2},refuse:true}]){const port={cfg:async()=>[],recheck:async()=>undefined,read:async(path:string)=>path.endsWith("lib.rs")?encoder.encode(testCase.source):path.endsWith("extra.rs")?encoder.encode("pub fn extra(){}"):null},work=admitCargoSourceBoundariesV1(graph,"/repo",{version:1,...testCase.limits},control,port);if(testCase.refuse)await expect(work,testCase.id).rejects.toThrow("before compiler");else await work;}
});

