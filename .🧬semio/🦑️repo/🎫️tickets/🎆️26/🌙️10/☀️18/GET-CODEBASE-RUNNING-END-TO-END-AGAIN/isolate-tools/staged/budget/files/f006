/** 📣️ Reports only bounded captured publication DATA without invoking unknown error hooks. */
test("publication exact service payload diagnostic delivery keeps the primary",()=>withBuildTestInvocationV1(async()=>{
 const helper=join(import.meta.dir,"👷️graph-purpose/📜️script.ts"),source=await fs.readFile(helper,"utf8"),tree=ts.createSourceFile("reporter.ts",source,ts.ScriptTarget.Latest,true),node=tree.statements.find((node):node is ts.FunctionDeclaration=>ts.isFunctionDeclaration(node)&&node.name?.text==="reportGraphPublicationRefusalV1");expect(node).toBeDefined();const types=await import("node:util"),db=new Database(":memory:");try{for(const row of corpus.preservationDiagnosticDelivery){expect(new Ajv({strict:true}).validate(ownerSchema.definitions.PreservationDiagnosticDeliveryCase,row)).toBe(true);let hooks=0;const hook=()=>{hooks++;throw Error("Unexpected diagnostic hook");},witness={version:1,digest:"a".repeat(64),applicationSha256:"b".repeat(64),files:1,directories:2,links:0,sockets:0,bytes:"36",journalSha256:null,service:null,exactServicePayload:{version:1,withoutServiceMetadataSha256:"c".repeat(64),serviceContentSha256:"d".repeat(64),serviceMetadataSha256:"e".repeat(64),authority:false}},cause:Record<string|symbol,unknown>={version:1,kind:"publication-preservation-refusal",before:witness,after:{...witness,applicationSha256:"f".repeat(64)},authority:false};let primary:unknown=Error("Native application payload, journal or service identity changed",{cause});if(row.effect==="error-proxy")primary=new Proxy(primary as Error,{get:hook,ownKeys:hook,getOwnPropertyDescriptor:hook,getPrototypeOf:hook});if(row.effect==="cause-accessor")Object.defineProperty(primary,"cause",{get:hook});if(row.effect==="cause-proxy")(primary as Error).cause=new Proxy(cause,{get:hook,ownKeys:hook,getOwnPropertyDescriptor:hook,getPrototypeOf:hook});if(row.effect==="nested-proxy")cause.before=new Proxy(witness,{get:hook,ownKeys:hook,getOwnPropertyDescriptor:hook,getPrototypeOf:hook});if(row.effect==="nested-accessor")Object.defineProperty(witness,"digest",{get:hook});if(row.effect==="symbol")cause[Symbol("foreign")]=1;if(row.effect==="inherited")Object.setPrototypeOf(cause,{foreign:1});if(row.effect==="unknown-field")cause.foreign=1;if(row.effect==="overbounds")witness.digest="x".repeat(8193);if(row.effect==="undefined-primary")primary=undefined;const output:string[]=[],ports={graphMaintenanceDiagnosticTypesV1:types.types,graphMaintenancePublicationSchema:ownerSchema,graphMaintenanceNativeSchema:nativeStorageSchema,validateJsonSchemaSubset,writeSync:(_fd:number,value:string)=>{if(row.effect==="sink-failure")throw Object.freeze({sink:true});output.push(value);return Buffer.byteLength(value);}},run=new Function(...Object.keys(ports),compile(node!.getText(tree))+";return reportGraphPublicationRefusalV1;")(...Object.values(ports));expect(()=>run(primary)).not.toThrow();expect(hooks).toBe(0);expect(output.length>0,row.effect).toBe(row.reported);expect(output.length).toBeLessThanOrEqual(1);const independent=db.query("select ?1='valid' reported").get(row.effect)as{reported:number};expect(row.reported).toBe(Boolean(independent.reported));if(output.length){const text=output[0]!;expect(text.startsWith("[DATA] Current Graph publication refusal ")).toBe(true);const data=JSON.parse(text.slice("[DATA] Current Graph publication refusal ".length));expect(new Ajv({strict:true}).validate({...ownerSchema.definitions.PreservationRefusal,definitions:ownerSchema.definitions},data)).toBe(true);expect(data).toEqual(cause);expect(Buffer.byteLength(JSON.stringify(data))).toBeLessThanOrEqual(ownerSchema.definitions.PreservationRefusalProtocol.const.maximumBytes);}}}finally{db.close();}
}));

/** 🧯️ Observes genuine failed requested children settle in separate processes without replacing their primaries. */
test("publication exact service payload prepared parent isolated failures settle",()=>withBuildTestInvocationV1(async original=>{
 const helper=join(import.meta.dir,"👷️asset-publication/📜️script.ts"),birth=routing.readIssuedScriptProcessEnvelopeV1(original),db=new Database(":memory:");try{for(const row of corpus.preparedParentFailure){const control=routing.createIssuedResourceControlV1(original,"publication:prepared-parent-worker:"+row.mode,20000),env=routing.scriptResourceProcessEnvironmentV1(control,Object.fromEntries(Object.entries(process.env).filter(([name])=>!freshEnvironment.includes(name)))),result=await captureOwnedCommandResultV1(process.execPath,[helper,row.entry],process.cwd(),{control,env,output:{maximumBytes:65536,maximumLines:128}});expect(result.status,result.stderr).toBe(0);expect(result.signal).toBeNull();const prefix="[DATA] Prepared publication parent worker ",lines=result.stdout.split("\n").filter(line=>line.startsWith(prefix));expect(lines).toHaveLength(1);const receipt=JSON.parse(lines[0]!.slice(prefix.length));expect(new Ajv({strict:true}).validate(schema.definitions.PreparedParentWorkerReceipt,receipt)).toBe(true);expect(receipt.mode).toBe(row.mode);expect(receipt.policySha256).toBe(createHash("sha256").update(JSON.stringify(JSON.parse(env.SEMIO_SCRIPT_PROCESS_INVOCATION!).policy)).digest("hex"));expect(receipt.deadlineEpochMilliseconds).toBe(JSON.parse(env.SEMIO_SCRIPT_PROCESS_INVOCATION!).deadlineEpochMilliseconds);expect(receipt.wireSha256).toBe(createHash("sha256").update(env.SEMIO_SCRIPT_PROCESS_INVOCATION!).digest("hex"));let absent=false;try{process.kill(receipt.pid,0);}catch(error){absent=(error as NodeJS.ErrnoException).code==="ESRCH";}expect(absent).toBe(true);expect(routing.readIssuedScriptProcessEnvelopeV1(original)).toBe(birth);const independent=db.query("select ?1 in ('undefined','frozen') and json_extract(?2,'$[1]')='child-enter' and json_extract(?2,'$[3]')='original-settled' settled").get(row.mode,JSON.stringify(receipt.events))as{settled:number};expect(independent.settled).toBe(1);}}finally{db.close();}
}),30000);
