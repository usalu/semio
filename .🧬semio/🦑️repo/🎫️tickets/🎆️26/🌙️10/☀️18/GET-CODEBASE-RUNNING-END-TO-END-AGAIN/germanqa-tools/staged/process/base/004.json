  "extract": {
    "tar.gz": {
      "darwin": [
        "tar",
        "-xzf",
        "{archive}",
        "-C",
        "{destination}"
      ],
      "linux": [
        "tar",
        "-xzf",
        "{archive}",
        "-C",
        "{destination}"
      ],
      "win32": [
        "tar",
        "-xzf",
        "{archive}",
        "-C",
        "{destination}"
      ]
    },
    "zip": {
      "darwin": [
        "tar",
        "-xf",
        "{archive}",
        "-C",
        "{destination}"
      ],
      "linux": [
        "unzip",
        "-q",
        "-o",
        "{archive}",
        "-d",
        "{destination}"
      ],
      "win32": [
        "tar",
        "-xf",
        "{archive}",
        "-C",
        "{destination}"
      ]
    }
