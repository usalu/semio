  "messages": {
    "languages": [
      "en",
      "de"
    ],
    "texts": {
      "host": {
        "en": "No pinned native toolchain for the host {host}.",
        "de": "Kein gepinntes natives Toolchain-Paket für den Host {host}."
      },
      "missing": {
        "en": "The pinned {tool} {version} is not provisioned; run `repo tools setup toolchains` (it downloads the checksum-pinned archive once).",
        "de": "Das gepinnte {tool} {version} ist nicht bereitgestellt; führe `repo tools setup toolchains` aus (es lädt das prüfsummen-gepinnte Archiv einmalig)."
      },
      "offline": {
        "en": "The pinned {tool} {version} is not provisioned and the network is offline.",
        "de": "Das gepinnte {tool} {version} ist nicht bereitgestellt und das Netzwerk ist offline."
      },
      "download": {
        "en": "Downloading the pinned {tool} {version} for {host} ({bytes} bytes).",
        "de": "Lade das gepinnte {tool} {version} für {host} ({bytes} Bytes)."
      },
      "progress": {
        "en": "{tool} {version}: {received} of {bytes} bytes ({percent} %).",
        "de": "{tool} {version}: {received} von {bytes} Bytes ({percent} %)."
      },
      "checksum": {
        "en": "The archive of {tool} {version} does not match its pinned size and SHA-256.",
        "de": "Das Archiv von {tool} {version} entspricht nicht der gepinnten Größe und dem SHA-256."
      },
      "member": {
        "en": "The archive of {tool} {version} holds an unsafe member: {member}.",
        "de": "Das Archiv von {tool} {version} enthält ein unsicheres Element: {member}."
      },
      "binary": {
        "en": "The archive of {tool} {version} holds no {binary}.",
        "de": "Das Archiv von {tool} {version} enthält kein {binary}."
      },
      "receipt": {
        "en": "The installation of {tool} {version} differs from its receipt: {path}.",
        "de": "Die Installation von {tool} {version} weicht von ihrer Quittung ab: {path}."
      },
      "python": {
        "en": "The pinned interpreter {series} is not provisioned; run `repo run deps-python`.",
        "de": "Der gepinnte Interpreter {series} ist nicht bereitgestellt; führe `repo run deps-python` aus."
      },
      "pin": {
        "en": "{tool} {actual} differs from the pin {expected} ({source}).",
        "de": "{tool} {actual} weicht vom Pin {expected} ab ({source})."
      },
      "usage": {
        "en": "{command} takes {choices}.",
        "de": "{command} erwartet {choices}."
      },
      "project": {
        "en": "Unknown Python project: {project}.",
        "de": "Unbekanntes Python-Projekt: {project}."
      },
      "digests": {
        "en": "The digests of the manifest and the lock are required.",
        "de": "Die Prüfsummen von Manifest und Lock sind erforderlich."
      },
      "file": {
        "en": "{file} of the Python project {project} is missing.",
        "de": "{file} des Python-Projekts {project} fehlt."
      },
      "directory": {
        "en": "A directory of the native tools is not a plain directory: {path}.",
        "de": "Ein Verzeichnis der nativen Werkzeuge ist kein gewöhnliches Verzeichnis: {path}."
      },
      "http": {
        "en": "The download failed with status {status}: {url}.",
        "de": "Der Download scheiterte mit Status {status}: {url}."
      },
      "depth": {
        "en": "The archive nests deeper than the finite ceiling allows.",
        "de": "Das Archiv ist tiefer verschachtelt, als die endliche Grenze erlaubt."
      },
      "size": {
        "en": "The archive holds more entries than the finite ceiling allows.",
        "de": "Das Archiv enthält mehr Einträge, als die endliche Grenze erlaubt."
      },
      "link": {
        "en": "The archive link leaves its tree: {path} -> {target}.",
        "de": "Ein Archiv-Link verlässt seinen Baum: {path} -> {target}."
      },
      "special": {
        "en": "The archive holds a special file: {path}.",
        "de": "Das Archiv enthält eine Spezialdatei: {path}."
      }
    }
