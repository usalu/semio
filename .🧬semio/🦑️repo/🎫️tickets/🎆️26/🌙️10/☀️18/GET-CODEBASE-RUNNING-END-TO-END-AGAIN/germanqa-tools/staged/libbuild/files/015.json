{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service Invocation",
  "description": "One declared kind of issued invocation: it holds a grant that lets a resident service admit plain task commands on behalf of authenticated client sessions. The grant widens nothing; every admitted command declares exactly the launches the same client would have been issued one-shot.",
  "definitions": {
    "Operation": {
      "enum": [
        "run",
        "run-many",
        "affected"
      ]
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "worktree",
        "keyDigest",
        "operations",
        "maximumRequests",
        "maximumConcurrent"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "worktree": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "keyDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Operation"
          }
        },
        "maximumRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maximumConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "agent",
        "cwd",
        "args"
      ],
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^v1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "maxLength": 8192
        },
        "agent": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,64}$"
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]+$"
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "named": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "Refusal": {
      "enum": [
        "grant",
        "token",
        "caveats",
        "expired",
        "unbounded",
        "revoked",
        "worktree",
        "agent",
        "scope",
        "arguments",
        "tool",
        "closure",
        "busy",
        "audit"
      ]
    },
    "Audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "at",
        "event",
        "session",
        "agent",
        "worktree",
        "operation",
        "args"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "event": {
          "enum": [
            "admit",
            "refuse",
            "finish",
            "revoke"
          ]
        },
        "session": {
          "type": "string",
          "pattern": "^([0-9a-f]{16}|-)$"
        },
        "agent": {
          "type": "string",
          "maxLength": 64
        },
        "worktree": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "operation": {
          "type": "string",
          "maxLength": 32
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "code": {
          "$ref": "#/definitions/Refusal"
        },
        "launches": {
          "type": "integer",
          "minimum": 0
        },
        "exit": {
          "type": "integer"
        }
      }
    },
    "Policy": {
      "description": "Authored constants of the admission. Nothing here is a path or a user visible language except the message table.",
      "const": {
        "version": 1,
        "operations": [
          "run",
          "run-many",
          "affected"
        ],
        "defaults": {
          "maximumRequests": 100000,
          "maximumConcurrent": 4
        },
        "requiredCaveats": [
          "scope",
          "worktree",
          "agent",
          "notAfter"
        ],
        "maximumLifetimeMilliseconds": 86400000,
        "maximumArguments": 64,
        "forbiddenFlags": [
          "--graph"
        ],
        "taskPattern": "^[A-Za-z0-9@][A-Za-z0-9@_./+-]*(:[A-Za-z0-9_.+-]+){0,2}$",
        "positionals": {
          "run": [
            1,
            1
          ],
          "run-many": [
            0,
            0
          ],
          "affected": [
            0,
            0
          ]
        },
        "projectFlags": {
          "run-many": "--projects"
        },
        "wire": {
          "grant": "capability",
          "token": "capability",
          "caveats": "capability",
          "expired": "capability",
          "unbounded": "capability",
          "revoked": "capability",
          "worktree": "scope",
          "agent": "scope",
          "scope": "scope",
          "arguments": "scope",
          "tool": "scope",
          "closure": "scope",
          "busy": "busy",
          "audit": "internal"
        },
        "messages": {
          "en": {
            "grant": "The resident service holds no service grant that matches this worktree and key.",
            "token": "The capability token is not genuine.",
            "caveats": "The capability token lacks a required restriction ({caveat}).",
            "expired": "The capability token has expired.",
            "unbounded": "The capability token has no lifetime within the allowed {hours} hours.",
            "revoked": "This agent session was revoked.",
            "worktree": "The request does not belong to the worktree this service serves.",
            "agent": "The capability token was issued to another agent.",
            "scope": "The capability token does not allow this command or project.",
            "arguments": "The command is not a plain task command of the catalogue: {reason}.",
            "tool": "The command selects another build implementation than the service invocation.",
            "closure": "The task {task} is neither named by the request nor one of its dependencies.",
            "busy": "This agent session reached its request limit or has too many commands running.",
            "audit": "The request could not be recorded in the audit journal and was not run."
          },
          "de": {
            "grant": "Der residente Dienst hält keine Dienst-Berechtigung, die zu diesem Arbeitsbaum und Schlüssel passt.",
            "token": "Die Berechtigung ist nicht echt.",
            "caveats": "Der Berechtigung fehlt eine erforderliche Einschränkung ({caveat}).",
            "expired": "Die Berechtigung ist abgelaufen.",
            "unbounded": "Die Berechtigung hat keine Lebensdauer innerhalb der erlaubten {hours} Stunden.",
            "revoked": "Diese Agenten-Sitzung wurde widerrufen.",
            "worktree": "Die Anfrage gehört nicht zu dem Arbeitsbaum, den dieser Dienst bedient.",
            "agent": "Die Berechtigung wurde einem anderen Agenten ausgestellt.",
            "scope": "Die Berechtigung erlaubt diesen Befehl oder dieses Projekt nicht.",
            "arguments": "Der Befehl ist kein einfacher Task-Befehl des Katalogs: {reason}.",
            "tool": "Der Befehl wählt eine andere Build-Implementierung als die Dienst-Aufrufung.",
            "closure": "Die Task {task} wird weder von der Anfrage genannt noch ist sie eine ihrer Abhängigkeiten.",
            "busy": "Diese Agenten-Sitzung hat ihr Anfragelimit erreicht oder führt zu viele Befehle aus.",
            "audit": "Die Anfrage konnte nicht im Prüfprotokoll aufgezeichnet werden und wurde nicht ausgeführt."
          }
        },
        "defaultTtlSeconds": 3600
      }
    }
  }
}
