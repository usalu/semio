{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resident repo service protocol, descriptor, watcher frames and policy (v1)",
  "description": "Authority for every document the resident service exchanges: client frames, service frames, native watcher frames, the discovery descriptor, the capability token payload and the policy. All documents are closed (additionalProperties false). Texts are always given per language; no language is a default.",
  "definitions": {
    "Language": {"type": "string", "enum": ["en", "de"]},
    "Text": {
      "description": "Texts keyed by language, only the languages the client asked for; at least one.",
      "type": "object",
      "propertyNames": {"enum": ["en", "de"]},
      "additionalProperties": {"type": "string", "maxLength": 2000},
      "minProperties": 1
    },
    "RequestId": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "Capability": {"type": "string", "pattern": "^v1\\.[A-Za-z0-9_-]{4,8192}\\.[A-Za-z0-9_-]{43}$"},
    "Hello": {
      "type": "object", "additionalProperties": false, "required": ["t", "v", "client", "languages"],
      "properties": {
        "t": {"const": "hello"},
        "v": {"const": 1},
        "client": {
          "type": "object", "additionalProperties": false, "required": ["name", "pid", "lane"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 64},
            "pid": {"type": "integer", "minimum": 0},
            "lane": {"type": "string", "minLength": 1, "maxLength": 64, "description": "Fairness lane, one per agent or terminal."}
          }
        },
        "languages": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/definitions/Language"}},
        "cap": {"$ref": "#/definitions/Capability"}
      }
    },
    "Request": {
      "type": "object", "additionalProperties": false, "required": ["t", "id", "command", "args", "cwd"],
      "properties": {
        "t": {"const": "request"},
        "id": {"$ref": "#/definitions/RequestId"},
        "command": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "args": {"type": "array", "maxItems": 4096, "items": {"type": "string", "maxLength": 65536}},
        "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
        "env": {"type": "object", "maxProperties": 256, "additionalProperties": {"type": "string", "maxLength": 32768}},
        "cap": {"$ref": "#/definitions/Capability"},
        "deadlineMs": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "detach": {"type": "boolean", "description": "Keep running after the client disconnects (watch-like jobs); default false."}
      }
    },
    "Cancel": {"type": "object", "additionalProperties": false, "required": ["t", "id"], "properties": {"t": {"const": "cancel"}, "id": {"$ref": "#/definitions/RequestId"}}},
    "Ping": {"type": "object", "additionalProperties": false, "required": ["t", "n"], "properties": {"t": {"const": "ping"}, "n": {"type": "integer", "minimum": 0}}},
    "ClientFrame": {"oneOf": [{"$ref": "#/definitions/Hello"}, {"$ref": "#/definitions/Request"}, {"$ref": "#/definitions/Cancel"}, {"$ref": "#/definitions/Ping"}]},
    "WatcherState": {
      "type": "object", "additionalProperties": false, "required": ["backend", "trust", "cursor"],
      "properties": {
        "backend": {"type": "string", "enum": ["fsevents", "inotify", "rdcw", "portable", "poll", "none"]},
        "trust": {"type": "string", "enum": ["exact", "verify", "none"], "description": "exact: events plus fence prove freshness; verify: every request re-proves membership by stat; none: no memo answers."},
        "cursor": {"type": "string", "maxLength": 32}
      }
    },
    "Welcome": {
      "type": "object", "additionalProperties": false, "required": ["t", "v", "service", "limits"],
      "properties": {
        "t": {"const": "welcome"},
        "v": {"const": 1},
        "service": {
          "type": "object", "additionalProperties": false, "required": ["pid", "instance", "startedAt", "implementation", "generation", "watcher"],
          "properties": {
            "pid": {"type": "integer", "minimum": 1},
            "instance": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "startedAt": {"type": "integer", "minimum": 0},
            "implementation": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "generation": {"type": ["integer", "null"], "minimum": 0},
            "watcher": {"$ref": "#/definitions/WatcherState"}
          }
        },
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["maximumFrameBytes", "maximumInFlight"],
          "properties": {"maximumFrameBytes": {"type": "integer", "minimum": 1024}, "maximumInFlight": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "Accepted": {"type": "object", "additionalProperties": false, "required": ["t", "id", "queue"], "properties": {"t": {"const": "accepted"}, "id": {"$ref": "#/definitions/RequestId"}, "queue": {"type": "integer", "minimum": 0}}},
    "Progress": {
      "type": "object", "additionalProperties": false, "required": ["t", "id", "phase", "done", "total", "message"],
      "properties": {
        "t": {"const": "progress"}, "id": {"$ref": "#/definitions/RequestId"},
        "phase": {"type": "string", "enum": ["queued", "fence", "plan", "digest", "execute", "replay", "resync", "custody", "idle"]},
        "done": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0},
        "message": {"$ref": "#/definitions/Text"}
      }
    },
    "Output": {
      "type": "object", "additionalProperties": false, "required": ["t", "id", "stream"],
      "properties": {
        "t": {"const": "output"}, "id": {"$ref": "#/definitions/RequestId"}, "stream": {"type": "string", "enum": ["stdout", "stderr"]},
        "text": {"type": "string", "maxLength": 524288}, "b64": {"type": "string", "maxLength": 699052, "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
      },
      "oneOf": [{"required": ["text"], "not": {"required": ["b64"]}}, {"required": ["b64"], "not": {"required": ["text"]}}]
    },
    "Timing": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "queueMs": {"type": "number", "minimum": 0}, "fenceMs": {"type": "number", "minimum": 0}, "planMs": {"type": "number", "minimum": 0},
        "digestMs": {"type": "number", "minimum": 0}, "admitMs": {"type": "number", "minimum": 0}, "spawnMs": {"type": "number", "minimum": 0},
        "runMs": {"type": "number", "minimum": 0}, "totalMs": {"type": "number", "minimum": 0}
      }
    },
    "Result": {
      "type": "object", "additionalProperties": false, "required": ["t", "id", "exit", "served", "timing"],
      "properties": {
        "t": {"const": "result"}, "id": {"$ref": "#/definitions/RequestId"},
        "exit": {"type": "integer", "minimum": 0, "maximum": 255},
        "signal": {"type": ["string", "null"]},
        "served": {"type": "string", "enum": ["memo", "executed", "query", "delegated"]},
        "timing": {"$ref": "#/definitions/Timing"},
        "summary": {"$ref": "#/definitions/Text"}
      }
    },
    "RefusalCode": {"type": "string", "enum": ["capability", "scope", "language", "busy", "stale", "shutdown", "unknown-command", "invalid", "deadline", "environment", "internal"]},
    "Refused": {
      "type": "object", "additionalProperties": false, "required": ["t", "code", "message", "retry"],
      "properties": {
        "t": {"const": "refused"}, "id": {"$ref": "#/definitions/RequestId"}, "code": {"$ref": "#/definitions/RefusalCode"},
        "message": {"description": "Refusals carry both languages: the client may have asked for none the service can render.", "type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": {"en": {"type": "string"}, "de": {"type": "string"}}},
        "retry": {"type": "string", "enum": ["never", "fallback", "later"], "description": "fallback: run the command in-process without the service."}
      }
    },
    "Notice": {
      "type": "object", "additionalProperties": false, "required": ["t", "kind", "message"],
      "properties": {"t": {"const": "notice"}, "kind": {"type": "string", "enum": ["draining", "stale", "degraded", "recovered"]}, "message": {"$ref": "#/definitions/Text"}}
    },
    "Pong": {"type": "object", "additionalProperties": false, "required": ["t", "n"], "properties": {"t": {"const": "pong"}, "n": {"type": "integer", "minimum": 0}}},
    "ServiceFrame": {"oneOf": [{"$ref": "#/definitions/Welcome"}, {"$ref": "#/definitions/Accepted"}, {"$ref": "#/definitions/Progress"}, {"$ref": "#/definitions/Output"}, {"$ref": "#/definitions/Result"}, {"$ref": "#/definitions/Refused"}, {"$ref": "#/definitions/Notice"}, {"$ref": "#/definitions/Pong"}]},
    "RelativePath": {"type": "string", "maxLength": 4096, "not": {"pattern": "^/|(^|/)\\.\\.(/|$)"}},
    "ChangeRow": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": [{"type": "string", "enum": ["a", "m", "r", "n"]}, {"type": "integer", "enum": [0, 1]}, {"$ref": "#/definitions/RelativePath"}],
      "description": "[kind, isDirectory, path]: added, modified, removed, renamed. Kinds are advisory; every row means re-stat the path (a directory row means its subtree)."
    },
    "WatcherReady": {
      "type": "object", "additionalProperties": false, "required": ["v", "t", "backend", "root", "cursor", "uuid", "replay", "latencyMs", "native"],
      "properties": {"v": {"const": 1}, "t": {"const": "ready"}, "backend": {"type": "string", "enum": ["fsevents", "inotify", "rdcw"]}, "root": {"type": "string"}, "cursor": {"type": "string"}, "uuid": {"type": "string"}, "replay": {"type": "boolean"}, "latencyMs": {"type": "integer", "minimum": 0}, "native": {"const": true}, "watches": {"type": "integer", "minimum": 0}}
    },
    "WatcherBatch": {
      "type": "object", "additionalProperties": false, "required": ["v", "t", "n", "at", "cursor", "c"],
      "properties": {"v": {"const": 1}, "t": {"const": "batch"}, "n": {"type": "integer", "minimum": 1}, "at": {"type": "integer", "minimum": 0}, "cursor": {"type": "string"}, "c": {"type": "array", "items": {"$ref": "#/definitions/ChangeRow"}}}
    },
    "WatcherLost": {
      "type": "object", "additionalProperties": false, "required": ["v", "t", "at", "reason", "scope"],
      "properties": {"v": {"const": 1}, "t": {"const": "lost"}, "at": {"type": "integer", "minimum": 0}, "reason": {"type": "string", "enum": ["overflow", "kernel-dropped", "user-dropped", "must-scan", "root-changed", "mount", "watch-limit", "read-error"]}, "scope": {"type": "string", "description": "Relative directory whose events may be missing; empty means everything."}}
    },
    "WatcherHistoryDone": {"type": "object", "additionalProperties": false, "required": ["v", "t", "cursor"], "properties": {"v": {"const": 1}, "t": {"const": "history-done"}, "cursor": {"type": "string"}}},
    "WatcherError": {"type": "object", "additionalProperties": false, "required": ["v", "t", "code", "message"], "properties": {"v": {"const": 1}, "t": {"const": "error"}, "code": {"type": "string"}, "message": {"type": "string"}}},
    "WatcherBye": {"type": "object", "additionalProperties": false, "required": ["v", "t"], "properties": {"v": {"const": 1}, "t": {"const": "bye"}}},
    "WatcherVersion": {"type": "object", "additionalProperties": false, "required": ["v", "t", "name", "protocol", "os"], "properties": {"v": {"const": 1}, "t": {"const": "version"}, "name": {"const": "semio-repo-watch"}, "protocol": {"const": 1}, "os": {"type": "string"}}},
    "WatcherFrame": {"oneOf": [{"$ref": "#/definitions/WatcherReady"}, {"$ref": "#/definitions/WatcherBatch"}, {"$ref": "#/definitions/WatcherLost"}, {"$ref": "#/definitions/WatcherHistoryDone"}, {"$ref": "#/definitions/WatcherError"}, {"$ref": "#/definitions/WatcherBye"}, {"$ref": "#/definitions/WatcherVersion"}]},
    "Descriptor": {
      "description": "Discovery file the service writes atomically into its runtime directory; the native launcher reads it instead of probing blindly.",
      "type": "object", "additionalProperties": false, "required": ["v", "pid", "instance", "startedAt", "endpoint", "protocol", "implementation", "root"],
      "properties": {"v": {"const": 1}, "pid": {"type": "integer", "minimum": 1}, "instance": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "startedAt": {"type": "integer"}, "endpoint": {"type": "string", "minLength": 1}, "protocol": {"const": 1}, "implementation": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "root": {"type": "string"}, "stopping": {"type": "boolean"}}
    },
    "Caveat": {
      "description": "Conjunctive restriction appended to a capability. Anyone holding a token can add caveats (narrow it) without the key; nobody can remove one.",
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["k", "v"], "properties": {"k": {"const": "scope"}, "v": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["status", "query", "run", "watch", "admin"]}}}},
        {"type": "object", "additionalProperties": false, "required": ["k", "v"], "properties": {"k": {"const": "projects"}, "v": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}},
        {"type": "object", "additionalProperties": false, "required": ["k", "v"], "properties": {"k": {"const": "notAfter"}, "v": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["k", "v"], "properties": {"k": {"const": "cwd"}, "v": {"type": "string", "minLength": 1, "maxLength": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["k", "v"], "properties": {"k": {"const": "worktree"}, "v": {"type": "string", "pattern": "^[0-9a-f]{12}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["k", "v"], "properties": {"k": {"const": "agent"}, "v": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$"}}}
      ]
    },
    "CapabilityPayload": {"type": "object", "additionalProperties": false, "required": ["id", "caveats"], "properties": {"id": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "caveats": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/Caveat"}}}},
    "Policy": {
      "description": "Authored defaults. Every number is an upper bound or a timer; none is a language or a path.",
      "const": {
        "version": 1,
        "maximumFrameBytes": 1048576,
        "maximumInFlight": 8,
        "maximumQueued": 64,
        "maximumClients": 64,
        "idleShutdownMilliseconds": 900000,
        "pinReleaseMilliseconds": 20000,
        "maximumResidentBytes": 536870912,
        "residentCheckMilliseconds": 5000,
        "fenceTimeoutMilliseconds": 1500,
        "racyWindowMilliseconds": 2000,
        "watcherLatencyMilliseconds": 5,
        "watcherRestartBackoffMilliseconds": [200, 1000, 5000],
        "watcherRestartsBeforePortable": 3,
        "memoMaximumEntries": 65536,
        "digestCacheMaximumFiles": 2000000,
        "outputSignatureMaximumEntries": 2048,
        "replayMaximumBytes": 1048576,
        "frontierMaximumEntries": 64,
        "journalMaximumEvents": 262144,
        "graphInputNames": ["project.json", "📋️project.json", "Cargo.toml", "package.json", "go.mod", "pyproject.toml", "BUILD.bazel", "MODULE.bazel"],
        "bindEnvironment": ["SEMIO_BUILD_TOOL", "SEMIO_BUILD_MODE", "SEMIO_BUILD_WORKERS", "SEMIO_BUILD_GRAPH_POLICY"],
        "eligibleFlags": ["--service=", "--lang=", "--output=stream", "--no-color"],
        "forwardEnvironment": ["SEMIO_LANGUAGE", "SEMIO_BUILD_TOOL", "SEMIO_BUILD_MODE", "SEMIO_BUILD_WORKERS", "SEMIO_BUILD_PARALLEL", "SEMIO_BUILD_GRAPH_POLICY", "NX_PARALLEL", "CI", "NO_COLOR", "FORCE_COLOR", "TERM", "LANG", "LC_ALL"],
        "commands": {
          "ping": {"class": "status", "idempotent": true, "tier": "service"},
          "status": {"class": "status", "idempotent": true, "tier": "service"},
          "dirty": {"class": "query", "idempotent": true, "tier": "service"},
          "affected": {"class": "query", "idempotent": true, "tier": "service"},
          "cursor": {"class": "query", "idempotent": true, "tier": "service"},
          "adopt": {"class": "run", "idempotent": true, "tier": "service"},
          "adopt-frontier": {"class": "run", "idempotent": true, "tier": "service"},
          "run": {"class": "run", "idempotent": true, "tier": "service"},
          "test": {"class": "run", "idempotent": true, "tier": "service"},
          "run-many": {"class": "run", "idempotent": true, "tier": "service"},
          "watch": {"class": "watch", "idempotent": true, "tier": "service"},
          "drop-caches": {"class": "admin", "idempotent": true, "tier": "service"},
          "issue": {"class": "admin", "idempotent": true, "tier": "service"},
          "revoke": {"class": "admin", "idempotent": true, "tier": "service"},
          "stop": {"class": "admin", "idempotent": true, "tier": "service"}
        },
        "messages": {
          "en": {
            "graph": "Re-reading the project graph after a configuration change.",
            "queued": "Waiting for a free slot in the resident service ({position} ahead).",
            "fence": "Synchronising with the file watcher.",
            "plan": "Planning {tasks} tasks.",
            "digest": "Hashing {files} changed files.",
            "execute": "Running {task}.",
            "replay": "Up to date, nothing changed since {since}.",
            "resync": "Re-proving membership after a gap in the file events ({reason}).",
            "stale-implementation": "The resident service runs outdated code and will restart; run the command again.",
            "shutdown": "The resident service is stopping.",
            "busy": "The resident service is busy ({inFlight} running, {queued} queued).",
            "capability": "The capability token is missing, forged or expired.",
            "revoked": "This agent session was revoked.",
            "issue-agent": "service issue needs --agent <id> (letters, digits and . _ : - only, at most 64): a token belongs to one agent session.",
            "issue-ttl": "service issue needs --ttl between 1 and {maximum} seconds (default 3600).",
            "scope": "The capability does not allow the command class {class}.",
            "language": "None of the requested languages is available.",
            "unknown-command": "The resident service does not know the command {command}.",
            "invalid": "The request is invalid: {reason}.",
            "deadline": "The request exceeded its deadline of {milliseconds} ms.",
            "environment": "The request runs with {key}={value} but the resident service was started with {actual}; running in this process instead.",
            "internal": "The resident service failed: {reason}.",
            "degraded": "File events are unavailable ({reason}); every answer is re-proved by stat.",
            "recovered": "File events are available again.",
            "service-started": "The resident service is running (pid {pid}, {files} files watched, backend {backend}).",
            "service-running": "The resident service is already running (pid {pid}).",
            "service-down": "No resident service is running for this worktree.",
            "service-stopped": "The resident service has stopped.",
            "service-failed": "The resident service did not become ready: {reason}.",
            "service-usage": "Usage: repo service status|start|stop|restart|issue|revoke|drop-caches|probe"
          },
          "de": {
            "graph": "Lese den Projektgraphen nach einer Konfigurationsänderung neu.",
            "queued": "Warte auf einen freien Platz im residenten Dienst ({position} davor).",
            "fence": "Synchronisiere mit dem Dateibeobachter.",
            "plan": "Plane {tasks} Tasks.",
            "digest": "Berechne Prüfsummen für {files} geänderte Dateien.",
            "execute": "Führe {task} aus.",
            "replay": "Aktuell, seit {since} hat sich nichts geändert.",
            "resync": "Weise die Mitgliedschaft nach einer Lücke in den Dateiereignissen neu nach ({reason}).",
            "stale-implementation": "Der residente Dienst führt veralteten Code aus und startet neu; führe den Befehl erneut aus.",
            "shutdown": "Der residente Dienst wird beendet.",
            "busy": "Der residente Dienst ist ausgelastet ({inFlight} laufen, {queued} wartend).",
            "capability": "Die Berechtigung fehlt, ist gefälscht oder abgelaufen.",
            "revoked": "Diese Agenten-Sitzung wurde widerrufen.",
            "issue-agent": "service issue braucht --agent <id> (nur Buchstaben, Ziffern und . _ : -, höchstens 64): eine Berechtigung gehört zu genau einer Agenten-Sitzung.",
            "issue-ttl": "service issue braucht --ttl zwischen 1 und {maximum} Sekunden (Standard 3600).",
            "scope": "Die Berechtigung erlaubt die Befehlsklasse {class} nicht.",
            "language": "Keine der angeforderten Sprachen ist verfügbar.",
            "unknown-command": "Der residente Dienst kennt den Befehl {command} nicht.",
            "invalid": "Die Anfrage ist ungültig: {reason}.",
            "deadline": "Die Anfrage hat ihre Frist von {milliseconds} ms überschritten.",
            "environment": "Die Anfrage läuft mit {key}={value}, der residente Dienst wurde aber mit {actual} gestartet; der Befehl läuft stattdessen in diesem Prozess.",
            "internal": "Der residente Dienst ist fehlgeschlagen: {reason}.",
            "degraded": "Dateiereignisse sind nicht verfügbar ({reason}); jede Antwort wird per stat neu belegt.",
            "recovered": "Dateiereignisse sind wieder verfügbar.",
            "service-started": "Der residente Dienst läuft (pid {pid}, {files} Dateien beobachtet, Backend {backend}).",
            "service-running": "Der residente Dienst läuft bereits (pid {pid}).",
            "service-down": "Für diesen Arbeitsbaum läuft kein residenter Dienst.",
            "service-stopped": "Der residente Dienst wurde beendet.",
            "service-failed": "Der residente Dienst ist nicht bereit geworden: {reason}.",
            "service-usage": "Verwendung: repo service status|start|stop|restart|issue|revoke|drop-caches|probe"
          }
        }
      }
    }
  }
}
