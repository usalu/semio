{
  "version": 1,
  "tables": {
    "rules": {
      "version": 1,
      "sizes": {
        "small": {
          "timeout": "short",
          "seconds": 60
        },
        "medium": {
          "timeout": "moderate",
          "seconds": 300
        },
        "large": {
          "timeout": "long",
          "seconds": 900
        },
        "enormous": {
          "timeout": "eternal",
          "seconds": 3600
        }
      },
      "levels": {
        "fundamental": "small",
        "quick": "medium",
        "long": "large",
        "exhaustive": "enormous"
      },
      "witness": {
        "from": 100
      },
      "measure": {
        "headroom": 3,
        "minimumRuns": 5,
        "shardAboveSeconds": 300
      },
      "default": {
        "size": "enormous",
        "shards": 1,
        "flaky": false
      },
      "rules": [
        {
          "id": "native",
          "evidence": "declared",
          "reason": "Cargo tests compile first and run long.",
          "targets": [
            "test-*-native"
          ],
          "size": "enormous"
        },
        {
          "id": "stdio-split",
          "evidence": "measured",
          "reason": "p95 410 s over 12 runs, bun files only.",
          "targets": [
            "test",
            "test-source"
          ],
          "projects": [
            "@semio-tech/stdio-*"
          ],
          "size": "large",
          "shards": 4
        },
        {
          "id": "quick-unit",
          "evidence": "measured",
          "reason": "p95 9 s over 30 runs.",
          "targets": [
            "test-unit?"
          ],
          "size": "small",
          "flaky": true
        },
        {
          "id": "shadowed",
          "evidence": "declared",
          "reason": "Never reached: the first rule wins.",
          "targets": [
            "test-*"
          ],
          "size": "medium"
        }
      ],
      "messages": {
        "shardNotHonoured": {
          "en": "No command of ${label} honoured shard ${index}/${total}; this shard ran the whole task.",
          "de": "Kein Befehl von ${label} hat den Shard ${index}/${total} beachtet; dieser Shard hat die ganze Task ausgeführt."
        }
      }
    }
  },
  "plans": [
    {
      "name": "the authored table is the longest class, no shards, no retry",
      "table": "authored",
      "input": {
        "project": "p",
        "target": "test",
        "files": 5
      },
      "expected": {
        "size": "enormous",
        "timeout": "eternal",
        "shards": 1,
        "flaky": false,
        "witness": false,
        "rule": null
      }
    },
    {
      "name": "the authored witness starts above 2000 files",
      "table": "authored",
      "input": {
        "project": "p",
        "target": "test",
        "files": 2001
      },
      "expected": {
        "size": "enormous",
        "timeout": "eternal",
        "shards": 1,
        "flaky": false,
        "witness": true,
        "rule": null
      }
    },
    {
      "name": "2000 files are still runfiles",
      "table": "authored",
      "input": {
        "project": "p",
        "target": "test",
        "files": 2000
      },
      "expected": {
        "size": "enormous",
        "timeout": "eternal",
        "shards": 1,
        "flaky": false,
        "witness": false,
        "rule": null
      }
    },
    {
      "name": "a target glob selects",
      "table": "rules",
      "input": {
        "project": "x",
        "target": "test-ui-native",
        "files": 3
      },
      "expected": {
        "size": "enormous",
        "timeout": "eternal",
        "shards": 1,
        "flaky": false,
        "witness": false,
        "rule": "native"
      }
    },
    {
      "name": "a project glob and a target list select together",
      "table": "rules",
      "input": {
        "project": "@semio-tech/stdio-plugin",
        "target": "test-source",
        "files": 101
      },
      "expected": {
        "size": "large",
        "timeout": "long",
        "shards": 4,
        "flaky": false,
        "witness": true,
        "rule": "stdio-split"
      }
    },
    {
      "name": "the right target in the wrong project falls through to the next rule",
      "table": "rules",
      "input": {
        "project": "@other/x",
        "target": "test-source",
        "files": 1
      },
      "expected": {
        "size": "medium",
        "timeout": "moderate",
        "shards": 1,
        "flaky": false,
        "witness": false,
        "rule": "shadowed"
      }
    },
    {
      "name": "a question mark matches exactly one character and a rule can ask for a retry",
      "table": "rules",
      "input": {
        "project": "x",
        "target": "test-unit1",
        "files": 1
      },
      "expected": {
        "size": "small",
        "timeout": "short",
        "shards": 1,
        "flaky": true,
        "witness": false,
        "rule": "quick-unit"
      }
    },
    {
      "name": "two characters do not match a question mark",
      "table": "rules",
      "input": {
        "project": "x",
        "target": "test-unit12",
        "files": 1
      },
      "expected": {
        "size": "medium",
        "timeout": "moderate",
        "shards": 1,
        "flaky": false,
        "witness": false,
        "rule": "shadowed"
      }
    },
    {
      "name": "the first matching rule wins even when a later one matches too",
      "table": "rules",
      "input": {
        "project": "x",
        "target": "test-a-native",
        "files": 1
      },
      "expected": {
        "size": "enormous",
        "timeout": "eternal",
        "shards": 1,
        "flaky": false,
        "witness": false,
        "rule": "native"
      }
    },
    {
      "name": "no rule and no default override leaves the default",
      "table": "rules",
      "input": {
        "project": "x",
        "target": "lint",
        "files": 1
      },
      "expected": {
        "size": "enormous",
        "timeout": "eternal",
        "shards": 1,
        "flaky": false,
        "witness": false,
        "rule": null
      }
    },
    {
      "name": "a path-like project name is matched as text",
      "table": "rules",
      "input": {
        "project": "@semio-tech/stdio-a/b",
        "target": "test",
        "files": 100
      },
      "expected": {
        "size": "large",
        "timeout": "long",
        "shards": 4,
        "flaky": false,
        "witness": false,
        "rule": "stdio-split"
      }
    }
  ],
  "attributes": [
    {
      "name": "the default",
      "plan": {
        "size": "enormous",
        "timeout": "eternal",
        "shards": 1,
        "flaky": false,
        "witness": false,
        "rule": null
      },
      "expected": [
        [
          "size",
          "\"enormous\""
        ],
        [
          "timeout",
          "\"eternal\""
        ]
      ]
    },
    {
      "name": "shards and retry",
      "plan": {
        "size": "large",
        "timeout": "long",
        "shards": 4,
        "flaky": true,
        "witness": true,
        "rule": "x"
      },
      "expected": [
        [
          "size",
          "\"large\""
        ],
        [
          "timeout",
          "\"long\""
        ],
        [
          "shard_count",
          "4"
        ],
        [
          "flaky",
          "True"
        ]
      ]
    }
  ],
  "environments": [
    {
      "name": "an unsharded run keeps only its result file",
      "bazel": {
        "TEST_TOTAL_SHARDS": "1",
        "TEST_SHARD_INDEX": "0",
        "XML_OUTPUT_FILE": "/o/test.xml"
      },
      "expected": {
        "SEMIO_TEST_XML_OUTPUT_FILE": "/o/test.xml"
      }
    },
    {
      "name": "the second of four shards",
      "bazel": {
        "TEST_TOTAL_SHARDS": "4",
        "TEST_SHARD_INDEX": "1",
        "TEST_SHARD_STATUS_FILE": "/o/shard",
        "XML_OUTPUT_FILE": "/o/shard_2_of_4/test.xml"
      },
      "expected": {
        "SEMIO_TEST_SHARD": "2/4",
        "SEMIO_TEST_SHARD_STATUS_FILE": "/o/shard",
        "SEMIO_TEST_XML_OUTPUT_FILE": "/o/shard_2_of_4/test.xml"
      }
    },
    {
      "name": "the first shard is index zero",
      "bazel": {
        "TEST_TOTAL_SHARDS": "2",
        "TEST_SHARD_INDEX": "0",
        "TEST_SHARD_STATUS_FILE": "/s"
      },
      "expected": {
        "SEMIO_TEST_SHARD": "1/2",
        "SEMIO_TEST_SHARD_STATUS_FILE": "/s"
      }
    },
    {
      "name": "nothing set maps nothing",
      "bazel": {},
      "expected": {}
    },
    {
      "name": "empty values count as unset",
      "bazel": {
        "XML_OUTPUT_FILE": "",
        "TEST_TOTAL_SHARDS": ""
      },
      "expected": {}
    }
  ],
  "refusedEnvironments": [
    {
      "TEST_TOTAL_SHARDS": "2",
      "TEST_SHARD_INDEX": "2"
    },
    {
      "TEST_TOTAL_SHARDS": "2"
    },
    {
      "TEST_TOTAL_SHARDS": "0"
    },
    {
      "TEST_TOTAL_SHARDS": "2",
      "TEST_SHARD_INDEX": "-1"
    },
    {
      "XML_OUTPUT_FILE": "relative/test.xml"
    },
    {
      "TEST_TOTAL_SHARDS": "2",
      "TEST_SHARD_INDEX": "0",
      "TEST_SHARD_STATUS_FILE": "relative"
    }
  ],
  "refusedTables": [
    {
      "name": "an unknown size",
      "patch": {
        "default": {
          "size": "huge",
          "shards": 1,
          "flaky": false
        }
      }
    },
    {
      "name": "a default that shards",
      "patch": {
        "default": {
          "size": "small",
          "shards": 2,
          "flaky": false
        }
      }
    },
    {
      "name": "a rule without a reason",
      "patch": {
        "rules": [
          {
            "id": "x",
            "evidence": "declared",
            "targets": [
              "t"
            ]
          }
        ]
      }
    },
    {
      "name": "a rule with a vague evidence",
      "patch": {
        "rules": [
          {
            "id": "x",
            "evidence": "guess",
            "reason": "no reason at all",
            "targets": [
              "t"
            ]
          }
        ]
      }
    },
    {
      "name": "a rule that shards beyond 64",
      "patch": {
        "rules": [
          {
            "id": "x",
            "evidence": "measured",
            "reason": "p95 100 s over 10 runs",
            "targets": [
              "t"
            ],
            "shards": 65
          }
        ]
      }
    },
    {
      "name": "a glob with a character class",
      "patch": {
        "rules": [
          {
            "id": "x",
            "evidence": "declared",
            "reason": "character classes are not globs here",
            "targets": [
              "t[ab]"
            ]
          }
        ]
      }
    },
    {
      "name": "a missing size row",
      "patch": {
        "sizes": {
          "small": {
            "timeout": "short",
            "seconds": 60
          }
        }
      }
    },
    {
      "name": "an extra key",
      "patch": {
        "extra": 1
      }
    }
  ]
}
