    }
   ],
   "evidence": [
    {
     "suite": "parity",
     "id": "fw-graph-generate"
    }
   ]
  },
  {
   "id": "failure-isolation",
   "capability": "failure-isolation",
   "title": {
    "en": "A failing task fails the run, its dependents do not execute and independent tasks still finish.",
    "de": "Eine fehlgeschlagene Task lässt den Lauf scheitern, ihre Abhängigen laufen nicht, unabhängige Tasks werden beendet."
   },
   "steps": [
    {
     "step": "run",
     "targets": [
      "after:build",
      "sibling:build"
     ],
     "expect": {
      "exit": "nonzero",
      "executed": [
       "broken:build",
       "sibling:build"
      ],
      "outputs": [
       {
        "task": "sibling:build",
        "path": "sibling/out/sibling.txt",
        "state": "expected"
       },
       {
        "task": "after:build",
        "path": "after/out/after.txt",
        "state": "absent"
       }
      ]
     }
    }
   ]
  },
