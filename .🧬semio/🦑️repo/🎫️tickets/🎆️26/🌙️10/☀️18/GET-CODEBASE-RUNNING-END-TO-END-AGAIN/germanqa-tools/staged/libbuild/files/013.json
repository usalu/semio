   "id": "cancellation",
   "capability": "cancellation",
   "title": {
    "en": "Cancelling stops the running task promptly and publishes nothing; the next run completes.",
    "de": "Abbrechen stoppt die laufende Task zügig und veröffentlicht nichts; der nächste Lauf wird abgeschlossen."
   },
   "steps": [
    {
