 "scenarios": [
  {
   "id": "plan-closure",
   "capability": "plan",
   "title": {
    "en": "A plan lists exactly the dependency closure with its edges.",
    "de": "Ein Plan nennt genau den Abhängigkeitsabschluss mit seinen Kanten."
   },
   "steps": [
    {
     "step": "plan",
     "target": "app:test",
     "tasks": [
      "core:build",
      "util:build",
      "app:build",
      "app:test"
     ],
     "edges": {
      "app:test": [
       "app:build"
      ],
      "app:build": [
       "core:build",
       "util:build"
      ],
      "core:build": [],
      "util:build": []
     }
    }
   ],
   "evidence": [
    {
     "suite": "parity",
     "id": "fw-graph-generate"
    }
   ]
  },
  {
   "id": "run-cold",
   "capability": "run",
   "title": {
    "en": "A cold run executes exactly the closure, in dependency order, with correct outputs, and nothing else.",
    "de": "Ein kalter Lauf führt genau den Abschluss in Abhängigkeitsreihenfolge mit korrekten Ausgaben aus, sonst nichts."
   },
   "steps": [
    {
     "step": "run",
     "targets": [
      "app:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "core:build",
       "util:build",
       "app:build"
      ],
      "ordered": true,
      "outputs": [
       {
        "task": "core:build",
        "path": "core/out/core.txt",
        "state": "expected"
       },
       {
        "task": "util:build",
        "path": "util/out/util.txt",
        "state": "expected"
       },
       {
        "task": "app:build",
        "path": "app/out/app.txt",
        "state": "expected"
       },
       {
        "task": "sibling:build",
        "path": "sibling/out/sibling.txt",
        "state": "absent"
       }
      ]
     }
    }
   ],
   "evidence": [
    {
     "suite": "parity",
     "id": "fw-graph-test"
    }
   ]
  },
  {
   "id": "cache-restore",
   "capability": "cache-restore",
   "title": {
    "en": "A second identical run executes nothing and restores every output.",
    "de": "Ein zweiter identischer Lauf führt nichts aus und stellt alle Ausgaben wieder her."
   },
   "steps": [
    {
     "step": "run",
     "targets": [
      "app:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "core:build",
       "util:build",
       "app:build"
      ]
     }
    },
    {
     "step": "run",
     "targets": [
      "app:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [],
      "outputs": [
       {
        "task": "app:build",
        "path": "app/out/app.txt",
        "state": "expected"
       }
      ]
     }
    }
   ],
   "evidence": [
    {
     "suite": "incremental",
     "id": "fw-ts-comment"
    },
    {
     "suite": "bazel-contract",
     "id": "cache"
    }
   ]
  },
  {
   "id": "restore-deleted-output",
   "capability": "cache-restore",
   "title": {
    "en": "Deleted outputs come back from the cache without executing.",
    "de": "Gelöschte Ausgaben kommen aus dem Cache zurück, ohne auszuführen."
   },
   "steps": [
    {
     "step": "run",
     "targets": [
      "app:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "core:build",
       "util:build",
       "app:build"
      ]
     }
    },
    {
     "step": "delete",
     "paths": [
      "core/out/core.txt",
      "app/out/app.txt"
     ]
    },
    {
     "step": "run",
     "targets": [
      "app:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [],
      "outputs": [
       {
        "task": "core:build",
        "path": "core/out/core.txt",
        "state": "expected"
       },
       {
        "task": "app:build",
        "path": "app/out/app.txt",
        "state": "expected"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "invalidation",
   "capability": "invalidation",
   "title": {
    "en": "Editing one input re-executes exactly the task that reads it and what depends on its output.",
    "de": "Das Ändern einer Eingabe führt genau die lesende Task und ihre Abhängigen neu aus."
   },
   "steps": [
    {
     "step": "run",
     "targets": [
      "app:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "core:build",
       "util:build",
       "app:build"
      ]
     }
    },
    {
     "step": "edit",
     "file": "core/src/a.txt",
     "op": "append-line"
    },
    {
     "step": "run",
     "targets": [
      "app:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "core:build",
       "app:build"
      ],
      "outputs": [
       {
        "task": "core:build",
        "path": "core/out/core.txt",
        "state": "changed"
       },
       {
        "task": "util:build",
        "path": "util/out/util.txt",
        "state": "unchanged"
       },
       {
        "task": "app:build",
        "path": "app/out/app.txt",
        "state": "expected"
       }
      ]
     }
    }
   ],
   "evidence": [
    {
     "suite": "incremental",
     "id": "fw-ts-body"
    }
   ]
  },
  {
   "id": "early-cutoff",
   "capability": "early-cutoff",
   "title": {
    "en": "A change that leaves a task's output identical does not re-execute its dependents.",
    "de": "Eine Änderung, die die Ausgabe einer Task unverändert lässt, führt deren Abhängige nicht erneut aus."
   },
   "steps": [
    {
     "step": "run",
     "targets": [
      "user:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "edge:build",
       "user:build"
      ]
     }
    },
    {
     "step": "edit",
     "file": "edge/src/a.txt",
     "op": "append-comment"
    },
    {
     "step": "run",
     "targets": [
      "user:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "edge:build"
      ],
      "outputs": [
       {
        "task": "edge:build",
        "path": "edge/out/edge.txt",
        "state": "unchanged"
       },
       {
        "task": "user:build",
        "path": "user/out/user.txt",
        "state": "unchanged"
       }
      ]
     }
    }
   ],
   "evidence": [
    {
     "suite": "incremental",
     "id": "fw-ts-comment"
    }
   ]
  },
  {
   "id": "uncached-always-runs",
   "capability": "uncached",
   "title": {
    "en": "A task that declares no cache executes on every run.",
    "de": "Eine Task ohne Cache wird bei jedem Lauf ausgeführt."
   },
   "steps": [
    {
     "step": "run",
     "targets": [
      "app:lint"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "app:lint"
      ]
     }
    },
    {
     "step": "run",
     "targets": [
      "app:lint"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "app:lint"
      ]
     }
    }
   ],
   "evidence": [
    {
     "suite": "bazel-contract",
     "id": "uncached"
    }
   ]
  },
  {
