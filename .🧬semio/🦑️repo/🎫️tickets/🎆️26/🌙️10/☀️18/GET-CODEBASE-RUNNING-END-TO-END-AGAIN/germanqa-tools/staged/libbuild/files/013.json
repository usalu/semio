    },
    {
     "step": "run",
     "targets": [
      "slow:build"
     ],
     "expect": {
      "exit": "zero",
      "executed": [
       "slow:build"
      ],
      "outputs": [
       {
        "task": "slow:build",
        "path": "slow/out/slow.txt",
