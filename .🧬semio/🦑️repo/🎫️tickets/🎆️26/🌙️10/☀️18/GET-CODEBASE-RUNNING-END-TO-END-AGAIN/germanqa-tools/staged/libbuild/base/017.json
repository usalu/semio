{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sha256",
    "byteLength",
    "text"
  ],
  "properties": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8388608
    },
    "text": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 65536
        }
      ]
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "maximumSourceBytes": 8388608,
        "maximumTextBytes": 65536,
        "maximumChunkBytes": 65536,
        "maximumPathUnits": 256,
        "maximumAncestors": 64,
        "settleMilliseconds": 2000,
        "maximumSettledRevisions": 4096
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "maximumBytes",
        "retainText",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388609
        },
        "maximumBytes": {
          "type": "number"
        },
        "retainText": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "PhysicalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "primary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "enum": [
            "ancestry",
            "leaf",
            "body",
            "undefined",
            "close",
            "short",
            "eof",
            "changed"
          ]
        }
      }
    },
    "CapturedPhysicalSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "sources"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "CapturedPhysicalSourceImages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "images"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "images": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "byteLength"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              },
              "text": {
                "type": "string",
                "maxLength": 8388608
              }
            }
          }
        }
      }
    },
    "ModuleOrigin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^file:"
    },
    "CapturedReadRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "path",
        "sourceCount"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "scope": {
          "enum": [
            "workspace",
            "outside"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "sourceCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "CapturedReadRefusalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "path",
        "sources",
        "expected"
      ],
      "properties": {
        "root": {
          "type": "string",
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "maxLength": 256
        },
        "sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "expected": {
          "$ref": "#/definitions/CapturedReadRefusal"
        }
      }
    },
    "ImplementationPinCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scopes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "parent",
              "module",
              "pin",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "parent": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "module": {
                "enum": [
                  "main",
                  "copy"
                ]
              },
              "pin": {
                "type": "boolean"
              },
              "expected": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "ImplementationPinLifetimeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "innerFailure",
        "outerFailure",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "innerFailure": {
          "type": "boolean"
        },
        "outerFailure": {
          "type": "boolean"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outer",
            "inner",
            "afterInner",
            "innerDescendant",
            "afterOuter",
            "outerDescendant"
          ],
          "properties": {
            "outer": {
              "type": "boolean"
            },
            "inner": {
              "type": "boolean"
            },
            "afterInner": {
              "type": "boolean"
            },
            "innerDescendant": {
              "type": "boolean"
            },
            "afterOuter": {
              "type": "boolean"
            },
            "outerDescendant": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "PolicyDescriptions": {
      "const": {
        "en": {
          "maximumSourceBytes": "The most bytes of one source file a revision captures (8 MiB).",
          "maximumTextBytes": "The most bytes of a source or schema whose text is retained (64 KiB): schemas and policy files are read under this ceiling.",
          "maximumChunkBytes": "The size of one read while a file is hashed (64 KiB).",
          "maximumPathUnits": "The most UTF-16 units of an absolute source path.",
          "maximumAncestors": "The most directory levels between the base and a captured source.",
          "settleMilliseconds": "How long a source must be unchanged before its revision is remembered by file identity.",
          "maximumSettledRevisions": "The most settled revisions remembered at once."
        },
        "de": {
          "maximumSourceBytes": "Die meisten Bytes einer Quelldatei, die eine Revision erfasst (8 MiB).",
          "maximumTextBytes": "Die meisten Bytes einer Quelle oder eines Schemas, deren Text behalten wird (64 KiB): Schemas und Richtliniendateien werden unter dieser Obergrenze gelesen.",
          "maximumChunkBytes": "Die Groesse eines Lesevorgangs beim Hashen einer Datei (64 KiB).",
          "maximumPathUnits": "Die meisten UTF-16-Einheiten eines absoluten Quellpfads.",
          "maximumAncestors": "Die meisten Verzeichnisebenen zwischen Basis und erfasster Quelle.",
          "settleMilliseconds": "Wie lange eine Quelle unveraendert sein muss, bevor ihre Revision unter der Dateiidentitaet gemerkt wird.",
          "maximumSettledRevisions": "Die meisten gleichzeitig gemerkten beruhigten Revisionen."
        }
      }
    }
  }
}
