   "id",
   "effect",
   "target",
   "endpoint",
   "full"
  ],
  "properties": {
   "id": {
    "type": "string",
    "minLength": 1
   },
   "effect": {
    "enum": [
     "none",
     "retarget",
     "remove",
     "replace-with-directory",
     "touch-link",
     "replace-directory",
     "add-sibling",
     "swap-for-link",
     "touch-directory"
    ]
   },
   "target": {
    "enum": [
     "none",
     "e0",
     "e1",
     "e2",
     "p0",
     "p1",
     "g",
     "root"
    ]
   },
   "endpoint": {
    "type": "boolean"
   },
   "full": {
    "type": "boolean"
   }
  }
 },
