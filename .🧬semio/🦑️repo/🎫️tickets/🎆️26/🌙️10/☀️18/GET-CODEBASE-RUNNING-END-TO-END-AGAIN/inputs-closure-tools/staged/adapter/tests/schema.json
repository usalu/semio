{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files",
    "manifests",
    "graph",
    "cases",
    "refusals",
    "mutation",
    "unreachedProject"
  ],
  "properties": {
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "lock"
      ],
      "properties": {
        "source": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "object"
              }
            }
          }
        },
        "lock": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namedInputs",
        "projects",
        "dependencies"
      ],
      "properties": {
        "namedInputs": {
          "type": "object"
        },
        "projects": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "root",
              "namedInputs"
            ],
            "properties": {
              "root": {
                "type": "string"
              },
              "namedInputs": {
                "type": "object"
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "project",
          "inputs",
          "expanded",
          "passthrough"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "inputs": {
            "type": "array"
          },
          "expanded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "passthrough": {
            "type": "array"
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "value",
          "error"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "source",
              "lock"
            ]
          },
          "value": {
            "type": "object"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "content",
        "unrelatedFile",
        "unrelatedContent"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "unrelatedFile": {
          "type": "string"
        },
        "unrelatedContent": {
          "type": "string"
        }
      }
    },
    "unreachedProject": {
      "type": "string"
    }
  }
}