{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files",
    "links",
    "entry",
    "closure",
    "declared",
    "mutations",
    "url"
  ],
  "properties": {
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "closure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "declared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "command",
        "projectRoot",
        "closure"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string"
        },
        "projectRoot": {
          "type": "string"
        },
        "closure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "file",
          "content",
          "digest",
          "closure"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "digest": {
            "enum": [
              "same",
              "changes"
            ]
          },
          "closure": {
            "anyOf": [
              {
                "const": "same"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "url": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "closure"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "closure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}