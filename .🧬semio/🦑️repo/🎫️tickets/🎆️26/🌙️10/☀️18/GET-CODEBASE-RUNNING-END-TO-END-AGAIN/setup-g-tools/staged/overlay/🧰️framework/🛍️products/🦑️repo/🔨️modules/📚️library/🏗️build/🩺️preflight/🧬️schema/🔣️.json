{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Platform": {
      "type": "object", "additionalProperties": false,
      "required": ["architectures", "minimumAvailableBytes", "tools", "exchange"],
      "properties": {
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["x64", "arm64"]}},
        "minimumAvailableBytes": {"type": "integer", "minimum": 1},
        "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"}},
        "exchange": {"type": "boolean"},
        "apt": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*$"}}}
      }
    },
    "Policy": {
      "type": "object", "additionalProperties": false, "required": ["version", "platforms"],
      "properties": {
        "version": {"const": 1},
        "platforms": {
          "type": "object", "additionalProperties": false, "required": ["linux", "darwin", "win32"],
          "properties": {
            "linux": {"$ref": "#/definitions/Platform"},
            "darwin": {"$ref": "#/definitions/Platform"},
            "win32": {"$ref": "#/definitions/Platform"}
          }
        }
      }
    },
    "Facts": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "architecture", "availableBytes", "tools", "exchange", "caseSensitive"],
      "properties": {
        "platform": {"type": "string"}, "architecture": {"type": "string"},
        "availableBytes": {"type": "integer", "minimum": 0},
        "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "exchange": {"enum": ["supported", "unsupported", "unprobed"]},
        "caseSensitive": {"enum": ["yes", "no", "unprobed"]}
      }
    }
  }
}
