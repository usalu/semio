const facts=fs.fstatSync(3),chunks=[],chunk=Buffer.alloc(${policy.readChunkBytes});let size=0,used=0,encoded;if(facts.isFile()){if(facts.size>${policy.maximumSnapshotBytes})throw Error('Bounded immutable implementation snapshot required');encoded=Buffer.allocUnsafe(facts.size);while(used<encoded.length){check();const count=fs.readSync(3,encoded,used,encoded.length-used,null);if(!count)throw Error('Immutable implementation snapshot changed');used+=count;}if(fs.readSync(3,Buffer.alloc(1),0,1,null))throw Error('Bounded immutable implementation snapshot required');}else{for(;;){check();const count=fs.readSync(3,chunk,used,Math.min(chunk.length-used,${policy.maximumSnapshotBytes}-size+1),null);check();if(!count){if(used)chunks.push(Buffer.from(chunk.subarray(0,used)));break;}if(count>${policy.maximumSnapshotBytes}-size)throw Error('Bounded immutable implementation snapshot required');size+=count;used+=count;if(used===chunk.length){chunks.push(Buffer.from(chunk));used=0;}}encoded=Buffer.concat(chunks,size);}check();