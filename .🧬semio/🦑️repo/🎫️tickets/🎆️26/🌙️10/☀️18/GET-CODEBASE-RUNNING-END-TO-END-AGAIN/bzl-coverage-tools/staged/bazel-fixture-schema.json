{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bazel Test Disposition Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph",
    "requests",
    "coverage",
    "reports"
  ],
  "properties": {
    "graph": {
      "type": "object"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tasks",
          "kinds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "skipCache": {
            "type": "boolean"
          },
          "kinds": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "task",
                "noop",
                "launch",
                "test"
              ]
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "$ref": "coverage#"
      }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tasks",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "$ref": "coverage#/definitions/Report"
          }
        }
      }
    }
  }
}