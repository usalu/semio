{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:nx-toolkit-store-bound:v1",
  "title": "Nx Toolkit Store Bound",
  "description": "The proactive, count-based bound of the Nx toolkit generations in the tools image: the newest generations stay (fewer while the machine budget or the free space of the image is under pressure), the current activation, any generation a live reader holds and any generation younger than the minimum age always stay, everything else is retired oldest first, at most a bounded number per run, inside a whole-image exclusive scope that is only entered when the image is seen idle: the run polls without queueing (a queued request would hold back every new reader) for a bounded time and otherwise leaves the work to the next run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "keepNewest",
    "keepNewestUnderPressure",
    "minimumAgeMs",
    "maximumPerRun",
    "maximumCensus",
    "intervalMs",
    "idleWaitMs",
    "idlePollMs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "keepNewest": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "keepNewestUnderPressure": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "minimumAgeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "maximumPerRun": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "intervalMs": {
      "type": "integer",
      "minimum": 60000,
      "maximum": 86400000
    },
    "maximumCensus": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "idleWaitMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "idlePollMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    }
  }
}
