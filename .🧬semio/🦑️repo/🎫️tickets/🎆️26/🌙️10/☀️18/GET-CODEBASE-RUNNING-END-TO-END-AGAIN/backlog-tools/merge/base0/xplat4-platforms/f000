{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/process/testing/suites.json",
  "title": "ProcessTestSuitesV1",
  "description": "The complete route table of the process module: every test file of the module belongs to exactly one suite (or is a declared child program), every suite is run by one project target `test-<id>` as `repo ./📜️script.ts test <id>`, and every test file runs in its own process because one process receives one Original birth.",
  "definitions": {
    "SuiteIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "ModulePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(\\.\\./)*[^/\\\\\\u0000][^\\\\\\u0000]*$"
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "const": true
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "Suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "budgetMs",
        "typecheck"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/SuiteIdentifier"
        },
        "budgetMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1800000
        },
        "typecheck": {
          "enum": [
            "none",
            "strict",
            "strict-indexed"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ModulePath"
          }
        },
        "trees": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ModulePath"
          }
        },
        "typecheckFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ModulePath"
          }
        },
        "function": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "export"
          ],
          "properties": {
            "module": {
              "$ref": "#/definitions/ModulePath"
            },
            "export": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*$",
              "maxLength": 96
            }
          }
        },
        "testNamePattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "capabilities": {
          "$ref": "#/definitions/Capabilities"
        },
        "scratch": {
          "enum": [
            "sandbox",
            "checkout"
          ]
        },
        "fileLaunchers": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/definitions/ModulePath"
          },
          "additionalProperties": {
            "$ref": "#/definitions/LauncherIdentifier"
          }
        },
        "platforms": {
          "description": "The hosts the suite can run on. On any other host the route runs none of its files and reports the suite SKIPPED (never green); a suite without this field runs everywhere.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "darwin",
              "linux",
              "win32"
            ]
          }
        },
        "tools": {
          "description": "Registered external tools whose pinned binary the route resolves from the tool registry and hands to every test file as SEMIO_TEST_<TOOL>_BINARY; a tool that is not provisioned on the host fails the suite instead of letting its laws skip.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ToolIdentifier"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "files"
          ],
          "properties": {
            "files": {}
          }
        },
        {
          "required": [
            "trees"
          ],
          "properties": {
            "trees": {}
          }
        },
        {
          "required": [
            "function"
          ],
          "properties": {
            "function": {}
          }
        }
      ]
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "suites",
        "codeSuites",
        "helpers"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "suites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/definitions/Suite"
          }
        },
        "codeSuites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/SuiteIdentifier"
          }
        },
        "helpers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ModulePath"
          }
        }
      }
    },
    "Protocol": {
      "const": {
        "testDirectory": "🧪️tests",
        "extension": ".ts",
        "importPatterns": [
          "\\{[^}]*\\b(test|it|describe)\\b[^}]*\\}\\s*from\\s*[\"']bun:test[\"']",
          "\\{[^}]*\\b(test|it|describe)\\b[^}]*\\}\\s*from\\s*[\"'][^\"']*/🧪️test/🟦️\\.ts[\"']"
        ],
        "skippedDirectories": [
          "node_modules"
        ],
        "checkoutScratchDirectory": ".cache/test-sandbox",
        "output": {
          "maximumFileOutputBytes": 4194304,
          "maximumFileOutputLines": 65536,
          "maximumTotalOutputBytes": 16777216
        }
      }
    },
    "LauncherIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "ToolIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    }
  }
}
