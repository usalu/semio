{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:build:graph-farm:v1",
  "title": "Graph inference farm",
  "description": "A bounded pool of worker processes that infer disjoint graph owners in parallel; every message is plain data, shared facts travel once through content-identified tables.",
  "$defs": {
    "Policy": {
      "const": {
        "version": 1,
        "languages": [
          "en",
          "de"
        ],
        "languageEnvironment": [
          "SEMIO_LANGUAGE",
          "SEMIO_DASHBOARD_LOCALE",
          "LC_ALL",
          "LC_MESSAGES",
          "LANG"
        ],
        "workersEnvironment": "SEMIO_GRAPH_WORKERS",
        "workerMegabytesEnvironment": "SEMIO_GRAPH_WORKER_MB",
        "minimumWorkerMegabytes": 512,
        "planEnvironment": "SEMIO_HOST_CAPACITY_PLAN",
        "phasesEnvironment": "SEMIO_GRAPH_PHASES",
        "maximumWorkers": 12,
        "minimumProjects": 24,
        "projectsPerWorker": 6,
        "workerMegabytes": 1536,
        "parentReserveMegabytes": 2048,
        "hostShareBasisPoints": 5000,
        "cpuReserve": 1,
        "maximumRestarts": 8,
        "capacityWaitMilliseconds": 30000,
        "initTimeoutMilliseconds": 180000,
        "jobTimeoutMilliseconds": 1800000,
        "shutdownGraceMilliseconds": 3000,
        "maximumTableEntries": 8388608,
        "maximumRecordBytes": 268435456,
        "runtime": {
          "bun": {
            "ramFactor": 0.75,
            "environment": {
              "BUN_JSC_numberOfGCMarkers": "1",
              "BUN_JSC_useConcurrentGC": "0"
            }
          },
          "node": {
            "ramFactor": 1,
            "environment": {}
          }
        },
        "residentIdleMilliseconds": 120000,
        "prestartColdBasisPoints": 5000,
        "grantBytes": 8388608,
        "maximumFallbacks": 16,
        "seedMegabytes": 64,
        "recordTableMegabytes": 256
      }
    },
    "Messages": {
      "const": {
        "en": {
          "starting": "graph: inferring {projects} projects with {workers} worker processes ({megabytes} MB each)",
          "serial": "graph: inferring {projects} projects in this process ({reason})",
          "fallback": "graph: project {project} is inferred again in this process, its worker did not answer ({reason}); {count} of at most {maximum}",
          "recycled": "graph: worker {worker} restarted after {megabytes} MB",
          "finished": "graph: {projects} projects inferred by {workers} workers in {seconds} s ({jobs} jobs, {fallbacks} in this process, {recycled} restarts)",
          "fallbackLimit": "graph: {count} projects had to be inferred again in this process, more than the {maximum} allowed; the last was {project} ({reason})",
          "disabled": "graph: the worker pool was switched off ({reason})"
        },
        "de": {
          "starting": "Graph: {projects} Projekte werden mit {workers} Arbeitsprozessen abgeleitet ({megabytes} MB je Prozess)",
          "serial": "Graph: {projects} Projekte werden in diesem Prozess abgeleitet ({reason})",
          "fallback": "Graph: Projekt {project} wird in diesem Prozess erneut abgeleitet, sein Arbeitsprozess hat nicht geantwortet ({reason}); {count} von höchstens {maximum}",
          "recycled": "Graph: Arbeitsprozess {worker} nach {megabytes} MB neu gestartet",
          "finished": "Graph: {projects} Projekte von {workers} Arbeitsprozessen in {seconds} s abgeleitet ({jobs} Aufträge, {fallbacks} in diesem Prozess, {recycled} Neustarts)",
          "fallbackLimit": "Graph: {count} Projekte mussten in diesem Prozess erneut abgeleitet werden, mehr als die erlaubten {maximum}; zuletzt {project} ({reason})",
          "disabled": "Graph: Der Arbeitsprozess-Pool wurde abgeschaltet ({reason})"
        }
      }
    },
    "Reasons": {
      "enum": [
        "disabled",
        "forced",
        "small",
        "single",
        "cpu",
        "memory",
        "work",
        "limit"
      ]
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers",
        "reason",
        "workerMegabytes"
      ],
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "$ref": "#/$defs/Reasons"
        },
        "workerMegabytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "kind",
        "job"
      ],
      "properties": {
        "type": {
          "const": "run"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "job": {}
      }
    },
    "Result": {
      "type": "object",
      "required": [
        "type",
        "id",
        "rssMegabytes"
      ],
      "properties": {
        "type": {
          "const": "result"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "rssMegabytes": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "message"
      ],
      "properties": {
        "type": {
          "const": "failure"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Fatal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "message"
      ],
      "properties": {
        "type": {
          "const": "fatal"
        },
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "Shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "shutdown"
        }
      }
    },
    "Load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "services"
      ],
      "properties": {
        "type": {
          "const": "load"
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^file:///"
          }
        }
      }
    },
    "Loaded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pid"
      ],
      "properties": {
        "type": {
          "const": "loaded"
        },
        "pid": {
          "type": "integer"
        }
      }
    },
    "Open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "service",
        "token",
        "sessionFile"
      ],
      "properties": {
        "type": {
          "const": "open"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "pattern": "^file:///"
        },
        "token": {
          "type": "integer",
          "minimum": 1
        },
        "sessionFile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Opened": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "token",
        "identity"
      ],
      "properties": {
        "type": {
          "const": "opened"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "integer",
          "minimum": 1
        },
        "identity": {}
      }
    },
    "Reasons2": {
      "const": {
        "en": {
          "exited": "the process exited",
          "job timeout": "the job took too long",
          "init timeout": "the process did not start in time",
          "open timeout": "the session did not open in time",
          "restarts": "too many restarts",
          "implementation differs": "the worker runs another implementation",
          "closed": "the pool was closed",
          "disabled": "the pool was switched off",
          "failure": "the job failed"
        },
        "de": {
          "exited": "der Prozess wurde beendet",
          "job timeout": "der Auftrag dauerte zu lange",
          "init timeout": "der Prozess startete nicht rechtzeitig",
          "open timeout": "die Sitzung öffnete sich nicht rechtzeitig",
          "restarts": "zu viele Neustarts",
          "implementation differs": "der Arbeitsprozess führt eine andere Implementierung aus",
          "closed": "der Pool wurde geschlossen",
          "disabled": "der Pool wurde abgeschaltet",
          "failure": "der Auftrag ist fehlgeschlagen"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Load"
    },
    {
      "$ref": "#/$defs/Loaded"
    },
    {
      "$ref": "#/$defs/Open"
    },
    {
      "$ref": "#/$defs/Opened"
    },
    {
      "$ref": "#/$defs/Run"
    },
    {
      "$ref": "#/$defs/Result"
    },
    {
      "$ref": "#/$defs/Failure"
    },
    {
      "$ref": "#/$defs/Fatal"
    },
    {
      "$ref": "#/$defs/Shutdown"
    }
  ]
}