{
 "version": 1,
 "cases": [
  {
   "name": "immediate publication goes through the ledger once per leaf",
   "quota": {
    "maximumBytes": 1000,
    "usedBytes": 100,
    "availableBytes": 5000,
    "minimumAvailableBytes": 10
   },
   "policy": {
    "flushBytes": 300,
    "flushLeaves": 3,
    "flushMilliseconds": 250,
    "finalFlushAttempts": 3
   },
   "steps": [
    {
     "op": "publish",
     "bytes": 120
    },
    {
     "op": "publish",
     "bytes": 80
    },
    {
     "op": "publish",
     "bytes": 50,
     "ledgerAccepts": false
    }
   ],
   "expect": {
    "results": [
     "published",
     "published",
     "declined"
    ],
    "ledger": [
     {
      "peakBytes": 120,
      "retainedDeltaBytes": 120,
      "accepted": true
     },
     {
      "peakBytes": 80,
      "retainedDeltaBytes": 80,
      "accepted": true
     },
     {
      "peakBytes": 50,
      "retainedDeltaBytes": 50,
      "accepted": false
     }
    ],
    "used": 300,
    "owedBytes": 0,
    "owedLeaves": 0,
    "removed": [],
    "refused": []
   }
  },
  {
