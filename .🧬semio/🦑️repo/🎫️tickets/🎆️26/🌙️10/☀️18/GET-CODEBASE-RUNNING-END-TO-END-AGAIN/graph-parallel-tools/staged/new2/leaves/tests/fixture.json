     "op": "grant",
     "bytes": 150
    },
    {
     "op": "publish",
     "bytes": 100,
     "deferred": true
    },
    {
     "op": "publish",
     "bytes": 60,
     "deferred": true
    },
    {
     "op": "grant",
     "bytes": 100
    },
    {
     "op": "release"
    },
    {
     "op": "publish",
     "bytes": 60,
     "deferred": true
    }
   ],
   "expect": {
    "results": [
     "granted",
     "declined",
     "declined",
     "refused",
     "released",
     "deferred"
    ],
    "ledger": [],
    "used": 160,
    "owedBytes": 60,
    "owedLeaves": 1,
    "removed": [],
    "refused": []
   }
  },
