{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Bazel Go Toolchain Contract",
 "type": "object",
 "additionalProperties": false,
 "definitions": {
  "Policy": {
   "const": {
    "version": 1,
    "binary": {
     "posix": "go",
     "windows": "go.exe"
    },
    "versionFile": "VERSION",
    "environment": [
     "CGO_ENABLED",
     "GOARCH",
     "GOEXPERIMENT",
     "GOFLAGS",
     "GOOS",
     "GOTOOLCHAIN"
    ],
    "hosts": {
     "darwin-arm64": "darwin/arm64",
     "darwin-x64": "darwin/amd64",
     "linux-arm64": "linux/arm64",
     "linux-x64": "linux/amd64",
     "win32-x64": "windows/amd64"
    }
   }
  },
  "Digest": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "Identity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "binary",
    "host",
    "environment"
   ],
   "properties": {
    "version": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[a-f0-9]{64}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "binary": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^[a-f0-9]{64}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "host": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "environment": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  }
 }
}
