{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slice custody of the graph generation builders",
  "description": "Who may build the next graph generation at the same time. A builder announces the owners it is going to write (the stale projects of its plan) as a CLAIM, a closed document `<directory>/<token>.json` beside the generation documents (written by rename), and holds the exclusive lease `graph-custody:<root>:<token>` from before the document exists until it is removed; a claim whose lease is free belongs to a dead command and is removed by the next reader. A claim is `structural` when its write set cannot be named before the build (a cold generation, a stale environment, added or removed project configurations): it conflicts with every other claim. Two claims conflict when either is structural or their owner sets intersect. Every claim receives under the short admission lease `graph-custody-admission:<root>` a ticket one above the largest ticket of the live claims; a claim is `held` (may build) once no live claim that is held or has a smaller ticket conflicts with it, so disjoint refreshes build at the same time, overlapping ones build one after the other in ticket order, and a waiting claim is never overtaken by a later conflicting one (no starvation). A holder that finds more stale owners than it claimed extends its claim when no other held claim conflicts with the extension, else it gives the custody back and queues again with the union (at most `widenRounds` times, then structurally). A holder retires old generation documents only when it can make its claim structural because no other live claim exists. Waiting is event driven (the leases of the blocking claims) with a poll of `pollMilliseconds`; a waiter tells why at most every `noticeMilliseconds`, naming up to `sampleOwners` shared owners.",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "directory": "s",
        "pollMilliseconds": 1000,
        "noticeMilliseconds": 20000,
        "maximumClaims": 1024,
        "maximumOwners": 65536,
        "sampleOwners": 3,
        "widenRounds": 8
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "token", "ticket", "owners", "structural", "state", "queuedMs"],
      "properties": {
        "version": {"const": 1},
        "token": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
        "ticket": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "owners": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 65536},
        "structural": {"type": "boolean"},
        "state": {"enum": ["waiting", "held"]},
        "queuedMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "Messages": {
      "const": {
        "en": {
          "blocked": "graph: {peers} refresh(es) of the same projects go first ({seconds} s; shared: {sample})",
          "blockedAll": "graph: {peers} refresh(es) go first, one of them rebuilds the whole workspace ({seconds} s)"
        },
        "de": {
          "blocked": "Graph: {peers} Erneuerung(en) derselben Projekte sind zuerst dran ({seconds} s; gemeinsam: {sample})",
          "blockedAll": "Graph: {peers} Erneuerung(en) sind zuerst dran, eine davon baut den ganzen Arbeitsbereich neu ({seconds} s)"
        }
      }
    },
    "AdmissionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mine", "others", "admit", "blockers"],
      "properties": {
        "id": {"type": "string"},
        "mine": {"$ref": "#/definitions/CaseClaim"},
        "others": {"type": "array", "items": {"$ref": "#/definitions/CaseClaim"}},
        "admit": {"type": "boolean"},
        "blockers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "CaseClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "ticket", "owners", "structural", "state"],
      "properties": {
        "token": {"type": "string"},
        "ticket": {"type": "integer", "minimum": 1},
        "owners": {"type": "array", "items": {"type": "string"}},
        "structural": {"type": "boolean"},
        "state": {"enum": ["waiting", "held"]}
      }
    }
  }
}
