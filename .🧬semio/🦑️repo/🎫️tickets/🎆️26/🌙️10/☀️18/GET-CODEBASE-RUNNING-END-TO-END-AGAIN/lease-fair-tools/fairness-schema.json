{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "bounds",
    "starvation",
    "reaping",
    "upgrade",
    "observability"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdMilliseconds",
        "readers",
        "observationMilliseconds",
        "writerStartOffsetMilliseconds",
        "boundedWriterMaximumMilliseconds",
        "reapMaximumMilliseconds",
        "waiters",
        "waiterObservationMilliseconds",
        "waiterCpuFractionMaximum",
        "upgradeMaximumMilliseconds",
        "upgradeReaderHoldMilliseconds"
      ],
      "properties": {
        "holdMilliseconds": {
          "type": "integer",
          "minimum": 50,
          "maximum": 2000
        },
        "readers": {
          "type": "integer",
          "minimum": 3,
          "maximum": 16
        },
        "observationMilliseconds": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 60000
        },
        "writerStartOffsetMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        },
        "boundedWriterMaximumMilliseconds": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000
        },
        "reapMaximumMilliseconds": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000
        },
        "waiters": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "waiterObservationMilliseconds": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "waiterCpuFractionMaximum": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "upgradeMaximumMilliseconds": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "upgradeReaderHoldMilliseconds": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        }
      }
    },
    "starvation": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "readers",
          "readerRuntime",
          "writer",
          "writerRuntime",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "readers": {
            "enum": [
              "queued",
              "python"
            ]
          },
          "readerRuntime": {
            "enum": [
              "bun",
              "node",
              "python"
            ]
          },
          "writer": {
            "enum": [
              "queued",
              "raw"
            ]
          },
          "writerRuntime": {
            "enum": [
              "bun",
              "node"
            ]
          },
          "outcome": {
            "enum": [
              "bounded",
              "starved"
            ]
          }
        }
      }
    },
    "reaping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dead",
          "runtimes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dead": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "runtimes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "bun",
                "node"
              ]
            }
          }
        }
      }
    },
    "upgrade": {
      "type": "array",
      "minItems": 3,
      "items": {
        "enum": [
          "position-preserved",
          "concurrent-upgraders",
          "failed-upgrade-holds-nothing"
        ]
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holderMode",
        "expectedPosition",
        "expectedQueued"
      ],
      "properties": {
        "holderMode": {
          "enum": [
            "shared",
            "exclusive"
          ]
        },
        "expectedPosition": {
          "type": "integer",
          "minimum": 2
        },
        "expectedQueued": {
          "type": "integer",
          "minimum": 2
        }
      }
    }
  }
}
