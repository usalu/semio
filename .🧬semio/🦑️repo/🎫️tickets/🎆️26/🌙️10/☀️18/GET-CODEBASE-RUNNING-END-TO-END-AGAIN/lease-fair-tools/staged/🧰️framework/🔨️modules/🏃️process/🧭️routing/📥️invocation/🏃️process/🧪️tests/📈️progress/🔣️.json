        }
      },
      "expected": "compiler remains active on ordinary-work (shared, 15 s)"
    },
    {
      "progress": {
        "owner": "process-progress-fixture",
        "command": "dependency-sync",
        "stage": "running",
        "activity": {
          "resource": "retire-obsolete:256",
          "mode": "exclusive",
          "elapsedMs": 15499
        }
      },
      "expected": "dependency-sync remains active on retire-obsolete:256 (exclusive, 15 s)"
    },
    {
      "progress": {
        "owner": "process-progress-fixture",
