  "queueCases": [
    {
      "name": "english-behind-exclusive",
      "environment": {
        "LANG": "en_US.UTF-8"
      },
      "resource": "lease-queue:{\"version\":1,\"position\":3,\"queued\":15,\"holderMode\":\"exclusive\",\"holderPid\":12528,\"holderSeconds\":8040,\"resource\":\"native-fixed-image:/repo/.cache/b/d\"}",
      "command": "bun:dependency-storage",
      "mode": "shared",
      "elapsedMs": 0,
      "expected": "bun:dependency-storage · Waiting for access to native-fixed-image:/repo/.cache/b/d (shared): position 3 of 15, behind the request of process 12528 (exclusive, queued 8040 s ago)"
    },
    {
      "name": "german-behind-shared",
      "environment": {
        "SEMIO_DASHBOARD_LOCALE": "de"
      },
      "resource": "lease-queue:{\"version\":1,\"position\":2,\"queued\":2,\"holderMode\":\"shared\",\"holderPid\":4620,\"holderSeconds\":0,\"resource\":\"native-fixed-image:/repo/.cache/b/d\"}",
      "command": "repository:command",
      "mode": "exclusive",
      "elapsedMs": 0,
      "expected": "repository:command · Wartet auf Zugriff auf native-fixed-image:/repo/.cache/b/d (exklusiv): Position 2 von 2, hinter der Anfrage von Prozess 4620 (geteilt, seit 0 s eingereiht)"
    },
