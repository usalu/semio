{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "urn:semio:framework:process:testing:sandbox",
 "title": "Per-run test sandbox protocol",
 "description": "Closed declaration of the per-run test sandbox: environment names, directory layout, port lease range, runtime guard policy and the static concurrency-law rules, plus the language-agnostic corpus, the debt ledger and the guard report row it is verified with.",
 "definitions": {
  "Protocol": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "owner",
    "environment",
    "layout",
    "ports",
    "guard",
    "scan",
    "rules"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "owner": {
     "type": "string",
     "pattern": "^repository:[a-z][a-z0-9-]*$"
    },
    "environment": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "sandbox",
      "artifacts",
      "images",
      "cache",
      "guard",
      "report",
      "checkout"
     ],
     "properties": {
      "sandbox": {
       "type": "string",
       "pattern": "^SEMIO_TEST_[A-Z_]+$"
      },
      "artifacts": {
       "type": "string",
       "pattern": "^SEMIO_TEST_[A-Z_]+$"
      },
      "images": {
       "type": "string",
       "pattern": "^SEMIO_TEST_[A-Z_]+$"
      },
      "cache": {
       "type": "string",
       "pattern": "^SEMIO_TEST_[A-Z_]+$"
      },
      "guard": {
       "type": "string",
       "pattern": "^SEMIO_TEST_[A-Z_]+$"
      },
      "report": {
       "type": "string",
       "pattern": "^SEMIO_TEST_[A-Z_]+$"
      },
      "checkout": {
       "type": "string",
       "pattern": "^SEMIO_TEST_[A-Z_]+$"
      }
     }
    },
    "layout": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "parent",
      "owner",
      "directories",
      "maximumRootLength",
      "heartbeatMilliseconds",
      "staleHeartbeatMilliseconds",
      "graceMilliseconds",
      "reclaimIntervalMilliseconds",
      "stamp"
     ],
     "properties": {
      "parent": {
       "type": "string",
       "pattern": "^[a-z0-9]{1,8}$"
      },
      "owner": {
       "type": "string",
       "minLength": 1
      },
      "directories": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "maximumRootLength": {
       "type": "integer",
       "minimum": 40,
       "maximum": 120
      },
      "heartbeatMilliseconds": {
       "type": "integer",
       "minimum": 1000
      },
      "staleHeartbeatMilliseconds": {
       "type": "integer",
       "minimum": 60000
      },
      "graceMilliseconds": {
       "type": "integer",
       "minimum": 1000
      },
      "reclaimIntervalMilliseconds": {
       "type": "integer",
       "minimum": 1000
      },
      "stamp": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "ports": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "minimum",
      "maximum",
      "attempts",
      "directory"
     ],
     "properties": {
      "minimum": {
       "type": "integer",
       "minimum": 1024,
       "maximum": 65535
      },
      "maximum": {
       "type": "integer",
       "minimum": 1024,
       "maximum": 65535
      },
      "attempts": {
       "type": "integer",
       "minimum": 1,
       "maximum": 1000
      },
      "directory": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "guard": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "modes",
      "defaultMode",
      "writeTargets",
      "openFunctions",
      "kernelPrograms",
      "killPrograms",
      "kernelVerbs",
      "protectedCheckoutPrefixes",
      "allowedCheckoutPrefixes",
      "scratchRoots"
     ],
     "properties": {
      "modes": {
       "type": "array",
       "items": {
        "enum": [
         "off",
         "report",
         "enforce"
        ]
       }
      },
      "defaultMode": {
       "enum": [
        "off",
        "report",
        "enforce"
       ]
      },
      "writeTargets": {
       "type": "object",
       "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "integer",
         "minimum": 0,
         "maximum": 3
        }
       }
      },
      "openFunctions": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "kernelPrograms": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "killPrograms": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "kernelVerbs": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "protectedCheckoutPrefixes": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "allowedCheckoutPrefixes": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "scratchRoots": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "scan": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "testSegment",
      "skipSegments",
      "extensions",
      "maximumBytes",
      "suite",
      "commentLine"
     ],
     "properties": {
      "testSegment": {
       "type": "string",
       "minLength": 1
      },
      "skipSegments": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "extensions": {
       "type": "object",
       "additionalProperties": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "required": [
        "ts",
        "go",
        "rs",
        "py",
        "sh"
       ],
       "properties": {
        "ts": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "go": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "rs": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "py": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "sh": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        }
       }
      },
      "maximumBytes": {
       "type": "integer",
       "minimum": 1024
      },
      "suite": {
       "type": "object",
       "additionalProperties": {
        "type": "string",
        "minLength": 1
       },
       "required": [
        "ts",
        "go",
        "rs",
        "py",
        "sh"
       ],
       "properties": {
        "ts": {
         "type": "string",
         "minLength": 1
        },
        "go": {
         "type": "string",
         "minLength": 1
        },
        "rs": {
         "type": "string",
         "minLength": 1
        },
        "py": {
         "type": "string",
         "minLength": 1
        },
        "sh": {
         "type": "string",
         "minLength": 1
        }
       }
      },
      "commentLine": {
       "type": "object",
       "additionalProperties": {
        "type": "string",
        "minLength": 1
       },
       "required": [
        "ts",
        "go",
        "rs",
        "py",
        "sh"
       ],
       "properties": {
        "ts": {
         "type": "string",
         "minLength": 1
        },
        "go": {
         "type": "string",
         "minLength": 1
        },
        "rs": {
         "type": "string",
         "minLength": 1
        },
        "py": {
         "type": "string",
         "minLength": 1
        },
        "sh": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    },
    "rules": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "severity",
       "languages",
       "scope",
       "message"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
       },
       "severity": {
        "enum": [
         "error",
         "warn"
        ]
       },
       "languages": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
         "enum": [
          "ts",
          "go",
          "rs",
          "py",
          "sh"
         ]
        }
       },
       "scope": {
        "enum": [
         "line",
         "file",
         "owner"
        ]
       },
       "flags": {
        "enum": [
         "i"
        ]
       },
       "pattern": {
        "type": "string",
        "minLength": 1
       },
       "also": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "exempt": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "all": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "none": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "en",
         "de"
        ],
        "properties": {
         "en": {
          "type": "string",
          "minLength": 1
         },
         "de": {
          "type": "string",
          "minLength": 1
         }
        }
       }
      }
     }
    }
   }
  },
  "Rule": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "severity",
    "languages",
    "scope",
    "message"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9-]*$"
    },
    "severity": {
     "enum": [
      "error",
      "warn"
     ]
    },
    "languages": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "enum": [
       "ts",
       "go",
       "rs",
       "py",
       "sh"
      ]
     }
    },
    "scope": {
     "enum": [
      "line",
      "file",
      "owner"
     ]
    },
    "flags": {
     "enum": [
      "i"
     ]
    },
    "pattern": {
     "type": "string",
     "minLength": 1
    },
    "also": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "exempt": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "all": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "none": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "message": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "en",
      "de"
     ],
     "properties": {
      "en": {
       "type": "string",
       "minLength": 1
      },
      "de": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   }
  },
  "Corpus": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "scans",
    "owners",
    "paths",
    "writes",
    "spawns",
    "listens"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "scans": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "path",
       "language",
       "text",
       "expected"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "path": {
        "type": "string",
        "minLength": 1
       },
       "language": {
        "enum": [
         "ts",
         "go",
         "rs",
         "py",
         "sh"
        ]
       },
       "text": {
        "type": "string"
       },
       "expected": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "rule",
          "line"
         ],
         "properties": {
          "rule": {
           "type": "string"
          },
          "line": {
           "type": "integer",
           "minimum": 1
          }
         }
        }
       }
      }
     }
    },
    "owners": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "sources",
       "expected"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "sources": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "language",
          "text"
         ],
         "properties": {
          "language": {
           "enum": [
            "ts",
            "go",
            "rs",
            "py",
            "sh"
           ]
          },
          "text": {
           "type": "string"
          }
         }
        }
       },
       "expected": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "rule"
         ],
         "properties": {
          "rule": {
           "type": "string",
           "minLength": 1
          }
         }
        }
       }
      }
     }
    },
    "paths": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "path",
       "test"
      ],
      "properties": {
       "path": {
        "type": "string",
        "minLength": 1
       },
       "test": {
        "type": "boolean"
       },
       "declared": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    },
    "writes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "context",
       "function",
       "target",
       "expected"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "context": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "cwd",
         "platform",
         "checkout",
         "allowed",
         "sandboxRoots",
         "protectedPrefixes",
         "allowedCheckoutPrefixes"
        ],
        "properties": {
         "cwd": {
          "type": "string",
          "minLength": 1
         },
         "platform": {
          "enum": [
           "linux",
           "darwin",
           "win32"
          ]
         },
         "checkout": {
          "type": "string",
          "minLength": 1
         },
         "allowed": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "sandboxRoots": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "protectedPrefixes": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "allowedCheckoutPrefixes": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         }
        }
       },
       "function": {
        "type": "string",
        "minLength": 1
       },
       "target": {
        "type": "string",
        "minLength": 1
       },
       "expected": {
        "enum": [
         "checkout-write",
         "protected-write",
         null
        ]
       }
      }
     }
    },
    "spawns": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "context",
       "command",
       "args",
       "expected"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "context": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "cwd",
         "platform",
         "checkout",
         "allowed",
         "sandboxRoots",
         "protectedPrefixes",
         "allowedCheckoutPrefixes"
        ],
        "properties": {
         "cwd": {
          "type": "string",
          "minLength": 1
         },
         "platform": {
          "enum": [
           "linux",
           "darwin",
           "win32"
          ]
         },
         "checkout": {
          "type": "string",
          "minLength": 1
         },
         "allowed": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "sandboxRoots": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "protectedPrefixes": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "allowedCheckoutPrefixes": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         }
        }
       },
       "command": {
        "type": "string",
        "minLength": 1
       },
       "args": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "expected": {
        "enum": [
         "kernel-image",
         "process-kill",
         null
        ]
       }
      }
     }
    },
    "listens": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "context",
       "port",
       "leased",
       "expected"
      ],
      "properties": {
       "id": {
        "type": "string",
        "minLength": 1
       },
       "context": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "cwd",
         "platform",
         "checkout",
         "allowed",
         "sandboxRoots",
         "protectedPrefixes",
         "allowedCheckoutPrefixes"
        ],
        "properties": {
         "cwd": {
          "type": "string",
          "minLength": 1
         },
         "platform": {
          "enum": [
           "linux",
           "darwin",
           "win32"
          ]
         },
         "checkout": {
          "type": "string",
          "minLength": 1
         },
         "allowed": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "sandboxRoots": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "protectedPrefixes": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "allowedCheckoutPrefixes": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         }
        }
       },
       "port": {
        "type": "integer"
       },
       "leased": {
        "type": "array",
        "items": {
         "type": "integer"
        }
       },
       "expected": {
        "enum": [
         "fixed-port",
         null
        ]
       }
      }
     }
    }
   }
  },
  "Ledger": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "entries"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "entries": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "file",
       "rule",
       "count",
       "reason"
      ],
      "properties": {
       "file": {
        "type": "string",
        "minLength": 1
       },
       "rule": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
       },
       "count": {
        "type": "integer",
        "minimum": 1
       },
       "reason": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "GuardReportRow": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "time",
    "pid",
    "kind",
    "function",
    "target",
    "frame"
   ],
   "properties": {
    "time": {
     "type": "integer"
    },
    "pid": {
     "type": "integer"
    },
    "kind": {
     "enum": [
      "checkout-write",
      "protected-write",
      "kernel-image",
      "process-kill",
      "fixed-port"
     ]
    },
    "function": {
     "type": "string",
     "minLength": 1
    },
    "target": {
     "type": "string"
    },
    "frame": {
     "type": "string"
    }
   }
  }
 }
}
