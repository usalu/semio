{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:native-recovery-owner-bytes-corpus:v1",
  "title": "Native Recovery Owner Bytes Corpus",
  "description": "Language-agnostic cases for the owner byte budget: the bootstrap ceiling, the Source revision text ceiling, the authored headroom and one owner manifest size in, accepted or refused out.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ownerBytes", "maximumOwnerBytes", "maximumTextBytes", "headroomPercent", "accepted"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ownerBytes": { "type": "integer", "minimum": 0 },
          "maximumOwnerBytes": { "type": "integer", "minimum": 1 },
          "maximumTextBytes": { "type": "integer", "minimum": 1 },
          "headroomPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
