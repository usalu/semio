{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Collected graph inference errors / Gesammelte Inferenzfehler des Graphen",
 "description": "EN: Diagnostic mode of the graph builder (SEMIO_GRAPH_COLLECT_ERRORS=<directory>): every project is inferred, every failure is recorded, the report is written, nothing is published. DE: Diagnosemodus des Graph-Builders (SEMIO_GRAPH_COLLECT_ERRORS=<Verzeichnis>): jedes Projekt wird abgeleitet, jeder Fehler wird erfasst, der Bericht geschrieben, nichts veroeffentlicht.",
 "texts": {
  "en": {
   "headline": "{failed} of {total} projects failed in {causes} causes; report: {directory}",
   "group": "  {count} x {cause} (e.g. {example}) at {top}",
   "final": "Error collection finished: {failed} of {total} projects failed, nothing was published; report: {directory}"
  },
  "de": {
   "headline": "{failed} von {total} Projekten fehlgeschlagen in {causes} Ursachen; Bericht: {directory}",
   "group": "  {count} x {cause} (z. B. {example}) bei {top}",
   "final": "Fehlersammlung beendet: {failed} von {total} Projekten fehlgeschlagen, nichts wurde veroeffentlicht; Bericht: {directory}"
  }
 },
 "definitions": {
  "Row": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "project",
    "root",
    "phase",
    "error",
    "cause",
    "stackTop"
   ],
   "properties": {
    "project": {
     "type": "string"
    },
    "root": {
     "type": "string"
    },
    "phase": {
     "enum": [
      "project",
      "cargo-targets"
     ]
    },
    "target": {
     "type": "string"
    },
    "code": {
     "type": "string"
    },
    "error": {
     "type": "string",
     "maxLength": 2048
    },
    "cause": {
     "type": "string",
     "maxLength": 200
    },
    "stackTop": {
     "type": "array",
     "maxItems": 3,
     "items": {
      "type": "string"
     }
    }
   }
  },
  "Group": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "cause",
    "count",
    "code",
    "message",
    "stackTop",
    "projects"
   ],
   "properties": {
    "cause": {
     "type": "string"
    },
    "count": {
     "type": "integer",
     "minimum": 1
    },
    "code": {
     "type": [
      "string",
      "null"
     ]
    },
    "message": {
     "type": "string"
    },
    "stackTop": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "projects": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "project",
       "root",
       "phase"
      ],
      "properties": {
       "project": {
        "type": "string"
       },
       "root": {
        "type": "string"
       },
       "phase": {
        "type": "string"
       },
       "target": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "Report": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "startedAt",
    "finishedAt",
    "workspace",
    "directory",
    "projectsTotal",
    "projectsFailed",
    "groups",
    "rows"
   ],
   "properties": {
    "version": {
     "const": 1
    },
    "startedAt": {
     "type": "string"
    },
    "finishedAt": {
     "type": "string"
    },
    "workspace": {
     "type": "string"
    },
    "directory": {
     "type": "string"
    },
    "projectsTotal": {
     "type": "integer",
     "minimum": 0
    },
    "projectsFailed": {
     "type": "integer",
     "minimum": 0
    },
    "groups": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/Group"
     }
    },
    "rows": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/Row"
     }
    }
   }
  }
 }
}