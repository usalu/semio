{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Build CLI front door policy",
  "description": "Which commands the front door serves without loading the build implementation, which subcommand sets are closed, and the EN/DE texts of its refusals. Commands, subcommands, options and help come from the neutral operations catalogue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "passthrough", "fullTargetPrefixes", "environment", "light", "closedSubcommands", "refusedExitCode", "texts"],
  "properties": {
    "version": { "const": 1 },
    "passthrough": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/Word" } },
    "fullTargetPrefixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["--tool", "--workers"],
      "properties": { "--tool": { "$ref": "#/definitions/Variable" }, "--workers": { "$ref": "#/definitions/Variable" } }
    },
    "light": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/Light" } },
    "closedSubcommands": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/Word" } },
    "refusedExitCode": { "type": "integer", "minimum": 2, "maximum": 63 },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknownCommand", "unknownSubcommand", "invalidValue", "missingArgument"],
      "properties": {
        "unknownCommand": { "$ref": "#/definitions/LocalizedText" },
        "unknownSubcommand": { "$ref": "#/definitions/LocalizedText" },
        "invalidValue": { "$ref": "#/definitions/LocalizedText" },
        "missingArgument": { "$ref": "#/definitions/LocalizedText" }
      }
    }
  },
  "definitions": {
    "Word": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "Variable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "Export": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*V[0-9]+$" },
    "Light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "export", "call"],
      "properties": {
        "operation": { "$ref": "#/definitions/Word" },
        "export": { "$ref": "#/definitions/Export" },
        "call": { "enum": ["root-args-environment", "args-options"] }
      }
    },
    "LocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
    }
  }
}
