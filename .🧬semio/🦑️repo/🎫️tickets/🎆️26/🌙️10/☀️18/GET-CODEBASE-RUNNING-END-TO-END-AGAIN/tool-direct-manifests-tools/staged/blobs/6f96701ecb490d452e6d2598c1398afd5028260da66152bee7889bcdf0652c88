{
  "version": 1,
  "id": "direct-tool-declarations",
  "summary": {
    "en": "No declarative file (manifest, script, workflow, container file, document or catalogue text) starts an external build tool by name: humans and agents call `repo ...` only.",
    "de": "Keine deklarative Datei (Manifest, Skript, Workflow, Container-Datei, Dokument oder Katalogtext) startet ein externes Build-Werkzeug beim Namen: Menschen und Agenten rufen nur `repo ...` auf."
  },
  "enforced": [
    {
      "id": "bun",
      "commands": [
        "bun",
        "bunx"
      ]
    },
    {
      "id": "node",
      "commands": [
        "node",
        "nodejs"
      ]
    },
    {
      "id": "npm",
      "commands": [
        "npm",
        "npx",
        "pnpm",
        "pnpx",
        "yarn"
      ]
    },
    {
      "id": "cargo",
      "commands": [
        "cargo",
        "rustc",
        "rustfmt",
        "rustdoc",
        "clippy-driver"
      ]
    },
    {
      "id": "rustup",
      "commands": [
        "rustup"
      ]
    },
    {
      "id": "bazel",
      "commands": [
        "bazel",
        "bazelisk"
      ]
    },
    {
      "id": "nx",
      "commands": [
        "nx"
      ]
    },
    {
      "id": "go",
      "commands": [
        "go",
        "gofmt"
      ]
    },
    {
      "id": "python",
      "commands": [
        "python",
        "python3",
        "pip",
        "pip3",
        "pytest"
      ]
    },
    {
      "id": "uv",
      "commands": [
        "uv",
        "uvx"
      ]
    },
    {
      "id": "dotnet",
      "commands": [
        "dotnet"
      ]
    },
    {
      "id": "cmake",
      "commands": [
        "cmake",
        "ctest",
        "ninja",
        "make",
        "gmake"
      ]
    },
    {
      "id": "typescript",
      "commands": [
        "tsc"
      ]
    },
    {
      "id": "vite",
      "commands": [
        "vite",
        "vitest"
      ]
    },
    {
      "id": "playwright",
      "commands": [
        "playwright"
      ]
    },
    {
      "id": "wasm",
      "commands": [
        "jco",
        "wasm-opt",
        "wasm-pack"
      ]
    },
    {
      "id": "tectonic",
      "commands": [
        "tectonic"
      ]
    }
  ],
  "observed": [
    {
      "id": "git",
      "commands": [
        "git"
      ]
    },
    {
      "id": "gh",
      "commands": [
        "gh"
      ]
    },
    {
      "id": "docker",
      "commands": [
        "docker",
        "docker-compose"
      ]
    }
  ],
  "wrappers": [
    "sudo",
    "doas",
    "env",
    "time",
    "nice",
    "nohup",
    "exec",
    "xargs",
    "command",
    "builtin",
    "then",
    "else",
    "do",
    "if",
    "elif",
    "while",
    "until",
    "!",
    "call",
    "start",
    "run_privileged"
  ],
  "wrapperValueOptions": {
    "nice": [
      "-n"
    ],
    "sudo": [
      "-u",
      "-E",
      "-H"
    ],
    "env": [
      "-u",
      "-C",
      "-S"
    ],
    "xargs": [
      "-n",
      "-I",
      "-P",
      "-L"
    ]
  },
  "shells": [
    "sh",
    "bash",
    "zsh",
    "dash",
    "pwsh",
    "powershell",
    "cmd"
  ],
  "shellCommandFlags": [
    "-c",
    "-lc",
    "-ic",
    "-ec",
    "-euc",
    "-command",
    "-c",
    "/c",
    "/k"
  ],
  "separators": [
    "&&",
    "||",
    "|&",
    ";",
    "|",
    "&",
    "$(",
    "`",
    "(",
    "{"
  ],
  "prompts": [
    "$ ",
    "> ",
    "PS> ",
    "# "
  ],
  "payloadAfterDoubleDash": [
    [
      "capacity",
      "run"
    ],
    [
      "exec"
    ],
    [
      "watch"
    ]
  ],
  "kinds": [
    {
      "id": "markdown",
      "extractor": "markdown",
      "files": [
        "**/*.md"
      ],
      "fenceLanguages": [
        "",
        "sh",
        "bash",
        "shell",
        "zsh",
        "console",
        "powershell",
        "pwsh",
        "ps1",
        "cmd",
        "bat",
        "dockerfile",
        "fish"
      ],
      "inlineSpans": true,
      "inline": {
        "verbs": [
          "run",
          "execute",
          "use",
          "call",
          "start",
          "invoke",
          "type",
          "enter",
          "launch",
          "try",
          "führe",
          "rufe",
          "starte",
          "nutze",
          "benutze",
          "verwende",
          "tippe",
          "gib"
        ],
        "modals": [
          "then",
          "and",
          "please",
          "to",
          "must",
          "should",
          "can",
          "may",
          "just",
          "first",
          "now",
          "you",
          "dann",
          "und",
          "bitte",
          "kannst",
          "musst",
          "sollst",
          "zuerst",
          "jetzt"
        ],
        "negations": [
          "never",
          "not",
          "don't",
          "dont",
          "do not",
          "avoid",
          "instead of",
          "rather than",
          "nie",
          "niemals",
          "nicht",
          "kein",
          "keine",
          "statt",
          "anstelle"
        ],
        "verbGap": 24,
        "negationWindow": 40,
        "repoPayload": true
      }
    },
    {
      "id": "shell-script",
      "extractor": "script",
      "files": [
        "**/*.sh",
        "**/*.bash",
        "**/*.zsh",
        "**/*.ps1",
        "**/*.psm1",
        "**/*.cmd",
        "**/*.bat",
        "**/Makefile",
        "**/makefile",
        "**/justfile",
        "**/*.mk"
      ],
      "commentPrefixes": [
        "#",
        "REM ",
        "rem ",
        "::"
      ]
    },
    {
      "id": "container-file",
      "extractor": "dockerfile",
      "files": [
        "**/Dockerfile",
        "**/Dockerfile.*",
        "**/*.dockerfile"
      ]
    },
    {
      "id": "yaml-config",
      "extractor": "yaml",
      "files": [
        "**/*.yml",
        "**/*.yaml"
      ],
      "keys": [
        "run",
        "runCmd",
        "command",
        "entrypoint",
        "cmd"
      ]
    },
    {
      "id": "json-config",
      "extractor": "json",
      "files": [
        "**/*.json",
        "**/*.jsonc"
      ],
      "stringKeys": [
        "command",
        "cmd",
        "run",
        "runCmd",
        "entrypoint",
        "postCreateCommand",
        "postStartCommand",
        "postAttachCommand",
        "onCreateCommand",
        "updateContentCommand",
        "initializeCommand",
        "program",
        "executable"
      ],
      "argvKeys": [
        "command",
        "argv",
        "cmd",
        "entrypoint",
        "postCreateCommand",
        "postStartCommand",
        "postAttachCommand",
        "onCreateCommand",
        "updateContentCommand",
        "initializeCommand"
      ],
      "mapKeys": [
        "scripts"
      ],
      "proseFiles": [
        "**/⚙️operations/🔣️catalog.json",
        "**/🖼️assets/**/🏗️build-surface.json",
        "**/🔌️mcp/**/🧬️schema/**/*.json"
      ],
      "proseKeys": [
        "description",
        "summary",
        "synopsis",
        "notes",
        "en",
        "de",
        "help"
      ],
      "spacedKeys": [
        "runtime",
        "commands"
      ]
    },
    {
      "id": "cargo-config",
      "extractor": "toml",
      "files": [
        "**/.cargo/config.toml",
        "**/.cargo/config"
      ],
      "keys": [
        "rustc-wrapper",
        "rustc-workspace-wrapper",
        "rustc",
        "rustdoc",
        "linker",
        "runner"
      ]
    },
    {
      "id": "bazel-file",
      "extractor": "bazel",
      "files": [
        "**/*.bzl",
        "**/BUILD",
        "**/BUILD.bazel",
        "**/MODULE.bazel",
        "**/WORKSPACE",
        "**/WORKSPACE.bazel"
      ],
      "keys": [
        "cmd",
        "command",
        "cmd_bash",
        "cmd_bat",
        "cmd_ps"
      ]
    }
  ],
  "exclude": [
    {
      "id": "tickets",
      "paths": [
        ".🧬semio/🦑️repo/🎫️tickets/**"
      ],
      "reason": {
        "en": "Ticket folders are working records, not product declarations.",
        "de": "Ticket-Ordner sind Arbeitsprotokolle, keine Produkt-Deklarationen."
      }
    },
    {
      "id": "fixtures",
      "paths": [
        "**/🧫️fixtures/**",
        "**/🧪️tests/**",
        "**/node_modules/**",
        "**/.git/**"
      ],
      "reason": {
        "en": "Test vectors and fixtures hold commands as data for parsers and tests.",
        "de": "Testvektoren und Fixtures enthalten Befehle als Daten für Parser und Tests."
      }
    },
    {
      "id": "personal-records",
      "paths": [
        ".🧬semio/🦑️repo/✍️notes/**",
        ".🧬semio/🦑️repo/💬️prompts/**",
        ".🧬semio/🦑️repo/📊️metrics/**",
        ".cursor/**",
        ".codex/plans/**"
      ],
      "reason": {
        "en": "Personal notes, prompt history, metrics and archived client plans are history, not instructions.",
        "de": "Persönliche Notizen, Prompt-Verlauf, Metriken und archivierte Client-Pläne sind Verlauf, keine Anweisungen."
      }
    },
    {
      "id": "locks",
      "paths": [
        "**/*.lock",
        "**/package-lock.json",
        "**/Cargo.lock"
      ],
      "reason": {
        "en": "Lock files are generated.",
        "de": "Sperrdateien sind generiert."
      }
    }
  ],
  "allow": [
    {
      "id": "launcher-bootstrap",
      "paths": [
        "🧰️framework/🛍️products/🦑️repo/🔨️modules/🔩️native/🥾️bootstrap/**",
        "🧰️framework/🛍️products/🦑️repo/🔨️modules/🚀️launcher/📥️install/**"
      ],
      "tools": [
        "*"
      ],
      "reason": {
        "en": "The bootstrap provisions the platform prerequisites and builds the launcher before `repo` exists.",
        "de": "Das Bootstrap richtet die Plattform-Voraussetzungen ein und baut den Launcher, bevor `repo` existiert."
      },
      "contexts": [
        "fence",
        "line",
        "inline",
        "json"
      ]
    },
    {
      "id": "image-definition",
      "paths": [
        ".devcontainer/Dockerfile"
      ],
      "tools": [
        "node"
      ],
      "reason": {
        "en": "The image definition installs the pinned Node binary and checks its version; no checkout exists yet.",
        "de": "Die Image-Definition installiert die gepinnte Node-Binärdatei und prüft ihre Version; es gibt noch keinen Checkout."
      },
      "contexts": [
        "fence",
        "line",
        "inline",
        "json"
      ]
    },
    {
      "id": "tool-adapters",
      "paths": [
        "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏃️process/**",
        "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🚀️bootstrap/🛠️tools/**",
        "🧰️framework/🔨️modules/🏃️process/**",
        "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚖️laws/🚷️raw-process-spawn/📒️allowlist/**",
        "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧰️tool-setup/**"
      ],
      "tools": [
        "*"
      ],
      "reason": {
        "en": "Tool adapters and the registry are the one place that knows a tool.",
        "de": "Werkzeug-Adapter und die Registry sind der eine Ort, der ein Werkzeug kennt."
      },
      "contexts": [
        "fence",
        "line",
        "inline",
        "json"
      ]
    },
    {
      "id": "package-manager-descriptors",
      "paths": [
        "**/⚡️caching/🚀️bootstrap/📦️dependencies/🔌️managers/**"
      ],
      "tools": [
        "*"
      ],
      "contexts": [
        "json"
      ],
      "reason": {
        "en": "Package-manager descriptors are the adapter data that names the executable of each manager.",
        "de": "Paketmanager-Deskriptoren sind die Adapter-Daten, die das Programm jedes Managers nennen."
      }
    },
    {
      "id": "bazel-adapter-schemas",
      "paths": [
        "**/🏗️build/🔧️tools/🏗️bazel/**"
      ],
      "tools": [
        "*"
      ],
      "contexts": [
        "json"
      ],
      "reason": {
        "en": "The Bazel adapter schemas name the programs the adapter starts.",
        "de": "Die Bazel-Adapter-Schemata nennen die Programme, die der Adapter startet."
      }
    },
    {
      "id": "image-build-stages",
      "paths": [
        "🌎️hub/Dockerfile",
        "**/🎛️coordinator/Dockerfile"
      ],
      "tools": [
        "bun",
        "npm",
        "node"
      ],
      "contexts": [
        "line"
      ],
      "reason": {
        "en": "A container build stage runs inside an isolated image that carries no `repo`; it installs and calls the toolchain of that image only.",
        "de": "Eine Container-Build-Stufe läuft in einem isolierten Image ohne `repo`; sie installiert und ruft nur die Werkzeugkette dieses Images auf."
      }
    }
  ]
}
