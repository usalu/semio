{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:laws/direct-tool-declarations",
  "title": "Direct tool declarations law",
  "description": "The language-agnostic pattern list of the law that no declarative file starts an external build tool by name. Every implementation of the law reads this one document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "summary",
    "enforced",
    "observed",
    "wrappers",
    "wrapperValueOptions",
    "shells",
    "shellCommandFlags",
    "separators",
    "prompts",
    "payloadAfterDoubleDash",
    "kinds",
    "exclude",
    "allow"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "summary": {
      "$ref": "#/definitions/Text"
    },
    "enforced": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Family"
      }
    },
    "observed": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Family"
      }
    },
    "wrappers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "wrapperValueOptions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shells": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shellCommandFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "separators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payloadAfterDoubleDash": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Kind"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Exclude"
      }
    },
    "allow": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Allow"
      }
    }
  },
  "definitions": {
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "Family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "commands"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Inline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verbs",
        "modals",
        "negations",
        "verbGap",
        "negationWindow",
        "repoPayload"
      ],
      "properties": {
        "verbs": {
          "$ref": "#/definitions/Strings"
        },
        "modals": {
          "$ref": "#/definitions/Strings"
        },
        "negations": {
          "$ref": "#/definitions/Strings"
        },
        "verbGap": {
          "type": "integer",
          "minimum": 0
        },
        "negationWindow": {
          "type": "integer",
          "minimum": 0
        },
        "repoPayload": {
          "type": "boolean"
        }
      }
    },
    "Kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "extractor",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "extractor": {
          "enum": [
            "markdown",
            "script",
            "dockerfile",
            "yaml",
            "json",
            "toml",
            "bazel"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fenceLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inlineSpans": {
          "type": "boolean"
        },
        "inline": {
          "$ref": "#/definitions/Inline"
        },
        "commentPrefixes": {
          "$ref": "#/definitions/Strings"
        },
        "keys": {
          "$ref": "#/definitions/Strings"
        },
        "stringKeys": {
          "$ref": "#/definitions/Strings"
        },
        "spacedKeys": {
          "$ref": "#/definitions/Strings"
        },
        "argvKeys": {
          "$ref": "#/definitions/Strings"
        },
        "mapKeys": {
          "$ref": "#/definitions/Strings"
        },
        "proseFiles": {
          "$ref": "#/definitions/Strings"
        },
        "proseKeys": {
          "$ref": "#/definitions/Strings"
        }
      }
    },
    "Exclude": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paths",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "$ref": "#/definitions/Text"
        }
      }
    },
    "Allow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paths",
        "tools",
        "contexts",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "fence",
              "line",
              "inline",
              "json"
            ]
          }
        },
        "reason": {
          "$ref": "#/definitions/Text"
        }
      }
    }
  }
}
