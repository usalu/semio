{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Incremental Build Conformance",
  "description": "Scenarios, task slices, expectations, observations and verdicts of the incremental-build conformance harness; every build implementation behind the tool-neutral interface is judged by the same contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "taskId": "^\\S+:\\S+$",
        "scenarioId": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "nonce": "^[0-9a-z]{6,32}$",
        "maximumTasks": 20000,
        "maximumLogBytes": 268435456,
        "maximumLogEntries": 5000000,
        "maximumPathLength": 255,
        "phases": [
          "warm",
          "edit",
          "revert"
        ],
        "label": "^t_[0-9a-f]{16}$",
        "bazelReport": "SEMIO_BUILD_TASK_REPORT",
        "copyConcurrency": 32
      }
    },
    "Tool": {
      "enum": [
        "nx",
        "bazel"
      ]
    },
    "Phase": {
      "enum": [
        "warm",
        "edit",
        "revert"
      ]
    },
    "EditKind": {
      "enum": [
        "comment-only",
        "body-change",
        "signature-change",
        "lockfile",
        "unrelated-sibling",
        "config"
      ]
    },
    "EditOp": {
      "enum": [
        "comment",
        "private-body",
        "public-api",
        "whitespace"
      ]
    },
    "EditLanguage": {
      "enum": [
        "ts",
        "rs",
        "py",
        "text"
      ]
    },
    "Family": {
      "enum": [
        "bun-script",
        "tsc",
        "vitest",
        "bun-test",
        "vite",
        "playwright",
        "go",
        "python",
        "dotnet",
        "latex",
        "docker",
        "wasm",
        "cargo",
        "aggregate"
      ]
    },
    "Effect": {
      "enum": [
        "changed",
        "identical",
        "unknown"
      ]
    },
    "Status": {
      "enum": [
        "pass",
        "stale",
        "excess",
        "stale-excess",
        "failed",
        "skipped"
      ]
    },
    "TaskId": {
      "type": "string",
      "pattern": "^\\S+:\\S+$"
    },
    "TaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/TaskId"
      }
    },
    "Path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "LocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SliceTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "cache",
        "outputs",
        "dependsOn",
        "consumes",
        "inputs"
      ],
      "properties": {
        "family": {
          "$ref": "#/definitions/Family"
        },
        "cache": {
          "type": "boolean"
        },
        "outputs": {
          "type": "boolean"
        },
        "dependsOn": {
          "$ref": "#/definitions/TaskIds"
        },
        "consumes": {
          "$ref": "#/definitions/TaskIds"
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Path"
          }
        }
      }
    },
    "Slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "selected",
        "tasks"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "selected": {
          "$ref": "#/definitions/TaskIds"
        },
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/SliceTask"
          }
        }
      }
    },
    "Edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "files"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/EditKind"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Path"
          }
        }
      }
    },
    "SensitivityRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "kind",
        "effect"
      ],
      "properties": {
        "family": {
          "$ref": "#/definitions/Family"
        },
        "kind": {
          "$ref": "#/definitions/EditKind"
        },
        "effect": {
          "$ref": "#/definitions/Effect"
        }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct",
        "must",
        "may",
        "cutoff"
      ],
      "properties": {
        "direct": {
          "$ref": "#/definitions/TaskIds"
        },
        "must": {
          "$ref": "#/definitions/TaskIds"
        },
        "may": {
          "$ref": "#/definitions/TaskIds"
        },
        "cutoff": {
          "$ref": "#/definitions/TaskIds"
        }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "executed",
        "restored",
        "cached",
        "unmapped"
      ],
      "properties": {
        "tool": {
          "$ref": "#/definitions/Tool"
        },
        "executed": {
          "$ref": "#/definitions/TaskIds"
        },
        "restored": {
          "$ref": "#/definitions/TaskIds"
        },
        "cached": {
          "$ref": "#/definitions/TaskIds"
        },
        "unmapped": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "stale",
        "excess",
        "exact"
      ],
      "properties": {
        "status": {
          "$ref": "#/definitions/Status"
        },
        "stale": {
          "$ref": "#/definitions/TaskIds"
        },
        "excess": {
          "$ref": "#/definitions/TaskIds"
        },
        "exact": {
          "type": "boolean"
        }
      }
    },
    "Mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "language",
        "file"
      ],
      "properties": {
        "op": {
          "$ref": "#/definitions/EditOp"
        },
        "language": {
          "$ref": "#/definitions/EditLanguage"
        },
        "file": {
          "$ref": "#/definitions/Path"
        }
      }
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "area",
        "target",
        "kind",
        "mutation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        },
        "area": {
          "enum": [
            "framework-ts",
            "rust-crate",
            "wasm-component",
            "vite-app",
            "test-target",
            "product-activation"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^\\S+:\\S+$"
        },
        "kind": {
          "$ref": "#/definitions/EditKind"
        },
        "mutation": {
          "$ref": "#/definitions/Mutation"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Tool"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SensitivityRow"
          }
        }
      }
    },
    "Labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "tool",
        "phase",
        "must",
        "may",
        "executed",
        "restored",
        "cutoff",
        "verdict",
        "milliseconds",
        "stale",
        "excess",
        "pass",
        "failed",
        "skipped",
        "summary",
        "area",
        "kind",
        "target",
        "progress",
        "cancelled",
        "title",
        "exact",
        "bounded",
        "warm",
        "edit",
        "revert",
        "comparison",
        "agree",
        "differ",
        "only"
      ],
      "properties": {
        "scenario": {
          "$ref": "#/definitions/LocalizedText"
        },
        "tool": {
          "$ref": "#/definitions/LocalizedText"
        },
        "phase": {
          "$ref": "#/definitions/LocalizedText"
        },
        "must": {
          "$ref": "#/definitions/LocalizedText"
        },
        "may": {
          "$ref": "#/definitions/LocalizedText"
        },
        "executed": {
          "$ref": "#/definitions/LocalizedText"
        },
        "restored": {
          "$ref": "#/definitions/LocalizedText"
        },
        "cutoff": {
          "$ref": "#/definitions/LocalizedText"
        },
        "verdict": {
          "$ref": "#/definitions/LocalizedText"
        },
        "milliseconds": {
          "$ref": "#/definitions/LocalizedText"
        },
        "stale": {
          "$ref": "#/definitions/LocalizedText"
        },
        "excess": {
          "$ref": "#/definitions/LocalizedText"
        },
        "pass": {
          "$ref": "#/definitions/LocalizedText"
        },
        "failed": {
          "$ref": "#/definitions/LocalizedText"
        },
        "skipped": {
          "$ref": "#/definitions/LocalizedText"
        },
        "summary": {
          "$ref": "#/definitions/LocalizedText"
        },
        "area": {
          "$ref": "#/definitions/LocalizedText"
        },
        "kind": {
          "$ref": "#/definitions/LocalizedText"
        },
        "target": {
          "$ref": "#/definitions/LocalizedText"
        },
        "progress": {
          "$ref": "#/definitions/LocalizedText"
        },
        "cancelled": {
          "$ref": "#/definitions/LocalizedText"
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        },
        "exact": {
          "$ref": "#/definitions/LocalizedText"
        },
        "bounded": {
          "$ref": "#/definitions/LocalizedText"
        },
        "warm": {
          "$ref": "#/definitions/LocalizedText"
        },
        "edit": {
          "$ref": "#/definitions/LocalizedText"
        },
        "revert": {
          "$ref": "#/definitions/LocalizedText"
        },
        "comparison": {
          "$ref": "#/definitions/LocalizedText"
        },
        "agree": {
          "$ref": "#/definitions/LocalizedText"
        },
        "differ": {
          "$ref": "#/definitions/LocalizedText"
        },
        "only": {
          "$ref": "#/definitions/LocalizedText"
        }
      }
    },
    "ScenarioSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "labels",
        "sensitivity",
        "scenarios"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "labels": {
          "$ref": "#/definitions/Labels"
        },
        "sensitivity": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/SensitivityRow"
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Scenario"
          }
        }
      }
    },
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "tool",
        "phase",
        "expected",
        "observation",
        "verdict",
        "milliseconds"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "$ref": "#/definitions/Tool"
        },
        "phase": {
          "$ref": "#/definitions/Phase"
        },
        "expected": {
          "$ref": "#/definitions/Expected"
        },
        "observation": {
          "$ref": "#/definitions/Observation"
        },
        "verdict": {
          "$ref": "#/definitions/Verdict"
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "rows",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Row"
          }
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sensitivity",
        "evaluation",
        "verdicts",
        "mutations",
        "labels",
        "environments",
        "refusals",
        "bazelLogs",
        "nxRecords"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sensitivity": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SensitivityRow"
          }
        },
        "evaluation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "tool",
              "slice",
              "edit",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tool": {
                "$ref": "#/definitions/Tool"
              },
              "slice": {
                "$ref": "#/definitions/Slice"
              },
              "edit": {
                "$ref": "#/definitions/Edit"
              },
              "expected": {
                "$ref": "#/definitions/Expected"
              }
            }
          }
        },
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "expected",
              "executed",
              "verdict"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "$ref": "#/definitions/Expected"
              },
              "executed": {
                "$ref": "#/definitions/TaskIds"
              },
              "verdict": {
                "$ref": "#/definitions/Verdict"
              }
            }
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "op",
              "language",
              "nonce",
              "before",
              "after"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "$ref": "#/definitions/EditOp"
              },
              "language": {
                "$ref": "#/definitions/EditLanguage"
              },
              "nonce": {
                "type": "string",
                "pattern": "^[0-9a-z]{6,32}$"
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              }
            }
          }
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "label"
            ],
            "properties": {
              "task": {
                "$ref": "#/definitions/TaskId"
              },
              "label": {
                "type": "string",
                "pattern": "^t_[0-9a-f]{16}$"
              }
            }
          }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "parent",
              "extra",
              "child"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "parent": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "extra": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "child": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "refusals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {}
            }
          }
        },
        "bazelLogs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "tasks",
              "compact",
              "spawns",
              "observation"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tasks": {
                "$ref": "#/definitions/TaskIds"
              },
              "compact": {
                "type": "string"
              },
              "spawns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "mnemonic",
                    "runner",
                    "cacheHit"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "mnemonic": {
                      "type": "string"
                    },
                    "runner": {
                      "type": "string"
                    },
                    "cacheHit": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "observation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "executed",
                  "restored",
                  "cached",
                  "unmapped"
                ],
                "properties": {
                  "executed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "restored": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cached": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "unmapped": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "nxRecords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "tasks",
              "record",
              "observation"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tasks": {
                "$ref": "#/definitions/TaskIds"
              },
              "record": {},
              "observation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "executed",
                  "restored",
                  "cached",
                  "unmapped"
                ],
                "properties": {
                  "executed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "restored": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cached": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "unmapped": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
