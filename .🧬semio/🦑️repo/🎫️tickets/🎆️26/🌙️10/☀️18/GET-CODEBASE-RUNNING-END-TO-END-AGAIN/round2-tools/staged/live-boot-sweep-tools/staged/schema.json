{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/native-storage/boot-recovery/v1",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "toleranceMilliseconds": 5000,
        "maximumSteps": 4096,
        "maximumFacts": 4096,
        "ledger": {
          "extension": ".jsonl",
          "maximumBytes": 65536,
          "maximumLineBytes": 2048,
          "retainedCommits": 2
        },
        "publication": {
          "directory": ".publication",
          "files": [
            "intent.json",
            "receipt.json"
          ],
          "directoryMode": 448
        },
        "phases": {
          "lease-ticket": 10,
          "lease-catalog": 20,
          "publication-residue": 30,
          "directory-swap": 40,
          "tool-server": 50,
          "leaked-image": 60
        },
        "leakedImages": {
          "scratchRoots": [
            "/private/tmp",
            "/private/var/folders",
            "/var/tmp",
            "/tmp"
          ],
          "environmentRoots": [
            "SEMIO_TEST_ARTIFACT_DIR",
            "TMPDIR"
          ],
          "idleMilliseconds": 900000,
          "sweepMilliseconds": 300000,
          "maximumImages": 256,
          "imageFile": "fixed.dmg",
          "leaseSibling": "c",
          "partitionPattern": "^(.+)/\\.cache/b/[a-z]/fixed\\.dmg$",
          "leaseResourcePrefix": "native-fixed-image:",
          "detach": {
            "program": "/usr/bin/hdiutil",
            "arguments": [
              "detach"
            ],
            "maximumBytes": 65536
          }
        },
        "serverFiles": {
          "bazel-server": [
            "server/server.pid.txt",
            "server/request_cookie",
            "server/response_cookie"
          ],
          "nx-daemon": [
            "d/server-process.json",
            "d/d.sock"
          ]
        },
        "claimsDirectory": "claims",
        "bootEpoch": {
          "darwin": {
            "program": "/usr/sbin/sysctl",
            "arguments": [
              "-n",
              "kern.boottime"
            ],
            "pattern": "sec = ([0-9]{9,11}), usec = ([0-9]{1,6})"
          },
          "linux": {
            "file": "/proc/stat",
            "pattern": "^btime ([0-9]{9,11})$"
          },
          "win32": {
            "program": "powershell.exe",
            "arguments": [
              "-NoProfile",
              "-NonInteractive",
              "-Command",
              "(Get-CimInstance Win32_OperatingSystem).LastBootUpTime.ToUniversalTime().ToString('o')"
            ],
            "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?:\\.([0-9]{1,7}))?Z\\s*$"
          },
          "maximumBytes": 65536
        },
        "scopes": {
          "stable": "inode, size, mode and name survive restarts and remounts and are compared exactly",
          "host-boot": "device number of the host volume is valid inside one boot session and is never compared across boots",
          "image-attach": "device number of a mounted image is valid for one attach of that image and is never compared from a record; only its equality relation between identities is compared",
          "process": "process identifiers and arrival times are valid inside one boot session; records older than the boot epoch belong to dead processes"
        },
        "identityFamilies": {
          "child-parent-identity": {
            "carrier": "journal ChildRequest.parentIdentity",
            "fields": [
              {
                "name": "hostDev",
                "scope": "host-boot"
              },
              {
                "name": "ino",
                "scope": "stable"
              },
              {
                "name": "size",
                "scope": "stable"
              },
              {
                "name": "mountDev",
                "scope": "image-attach"
              }
            ]
          },
          "creator-claim": {
            "carrier": "sidecar .native-birth-<allocation>.jsonl",
            "fields": [
              {
                "name": "dev",
                "scope": "image-attach"
              },
              {
                "name": "ino",
                "scope": "stable"
              },
              {
                "name": "mode",
                "scope": "stable"
              }
            ]
          },
          "namespace-receipt": {
            "carrier": "journal Allocation.namespace",
            "fields": [
              {
                "name": "dev",
                "scope": "image-attach"
              },
              {
                "name": "ino",
                "scope": "stable"
              },
              {
                "name": "mode",
                "scope": "stable"
              }
            ]
          },
          "image-receipt": {
            "carrier": "image.json",
            "fields": [
              {
                "name": "bootSession",
                "scope": "host-boot"
              },
              {
                "name": "dev",
                "scope": "host-boot"
              },
              {
                "name": "ino",
                "scope": "stable"
              },
              {
                "name": "size",
                "scope": "stable"
              },
              {
                "name": "ancestry",
                "scope": "stable"
              },
              {
                "name": "mountDirectory.dev",
                "scope": "host-boot"
              },
              {
                "name": "mountDirectory.ino",
                "scope": "stable"
              }
            ]
          },
          "persistent-state-binding": {
            "carrier": "persistent-development.json",
            "fields": [
              {
                "name": "ino",
                "scope": "stable"
              },
              {
                "name": "size",
                "scope": "stable"
              },
              {
                "name": "receipt",
                "scope": "stable"
              }
            ]
          },
          "persistent-data-binding": {
            "carrier": "data.binding.json",
            "fields": [
              {
                "name": "ino",
                "scope": "stable"
              }
            ]
          },
          "recovery-ledger": {
            "carrier": "boot-recovery ledger",
            "fields": [
              {
                "name": "boot",
                "scope": "host-boot"
              },
              {
                "name": "at",
                "scope": "process"
              }
            ]
          }
        }
      }
    },
    "BootSession": {
      "type": "string",
      "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^/\\u0000][^\\u0000]*$"
    },
    "Millis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 281474976710655
    },
    "Family": {
      "enum": [
        "publication-residue",
        "lease-ticket",
        "tool-server",
        "directory-swap",
        "persistent-record",
        "creator-claim",
        "image-receipt",
        "leaked-image"
      ]
    },
    "Action": {
      "enum": [
        "remove-file",
        "remove-directory",
        "retire-ticket",
        "retire-settled-claims",
        "recover-directory-swap",
        "detach-image"
      ]
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino",
        "mode"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[0-9]+$"
        },
        "ino": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[0-9]+$"
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "Verdict": {
      "enum": [
        "keep",
        "act",
        "refuse"
      ]
    },
    "PublicationFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "writerFree",
        "directory",
        "intent",
        "receipt",
        "unknownEntries",
        "intentReceiptSha256",
        "image"
      ],
      "properties": {
        "family": {
          "const": "publication-residue"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "writerFree": {
          "type": "boolean"
        },
        "directory": {
          "enum": [
            "absent",
            "ordinary",
            "unsafe"
          ]
        },
        "intent": {
          "enum": [
            "absent",
            "torn",
            "valid",
            "unsafe"
          ]
        },
        "receipt": {
          "enum": [
            "absent",
            "torn",
            "valid",
            "unsafe"
          ]
        },
        "unknownEntries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "intentReceiptSha256": {
          "anyOf": [
            {
              "$ref": "#/definitions/Sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "sha256"
          ],
          "properties": {
            "state": {
              "enum": [
                "absent",
                "invalid",
                "valid"
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "TicketFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "queue",
        "name",
        "parsed",
        "arrivedAtMs",
        "pid"
      ],
      "properties": {
        "family": {
          "const": "lease-ticket"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "queue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-f0-9]{64}\\.queue$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "parsed": {
          "type": "boolean"
        },
        "arrivedAtMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Millis"
            },
            {
              "type": "null"
            }
          ]
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999999999
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ClaimCatalogFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "claimDatabases",
        "previousBootClaimDatabases"
      ],
      "properties": {
        "family": {
          "const": "lease-claims"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "claimDatabases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "previousBootClaimDatabases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "ServerFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "files"
      ],
      "properties": {
        "family": {
          "const": "tool-server"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "files": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "modifiedAtMs"
            ],
            "properties": {
              "path": {
                "$ref": "#/definitions/RelativePath"
              },
              "modifiedAtMs": {
                "$ref": "#/definitions/Millis"
              }
            }
          }
        }
      }
    },
    "SwapFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "writerFree",
        "intent"
      ],
      "properties": {
        "family": {
          "const": "directory-swap"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "writerFree": {
          "type": "boolean"
        },
        "intent": {
          "enum": [
            "absent",
            "present"
          ]
        }
      }
    },
    "RecordFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "final",
        "temporary",
        "pair"
      ],
      "properties": {
        "family": {
          "const": "persistent-record"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "final": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "links"
          ],
          "properties": {
            "state": {
              "enum": [
                "absent",
                "present"
              ]
            },
            "links": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "temporary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "links"
          ],
          "properties": {
            "state": {
              "enum": [
                "absent",
                "present"
              ]
            },
            "links": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "pair": {
          "enum": [
            "not-applicable",
            "same-inode",
            "different-inode"
          ]
        }
      }
    },
    "ClaimFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "sidecar",
        "binding"
      ],
      "properties": {
        "family": {
          "const": "creator-claim"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "sidecar": {
          "enum": [
            "absent",
            "partial",
            "complete"
          ]
        },
        "binding": {
          "enum": [
            "not-applicable",
            "exact",
            "rebound",
            "mismatch"
          ]
        }
      }
    },
    "ReceiptFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "state",
        "binding"
      ],
      "properties": {
        "family": {
          "const": "image-receipt"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "state": {
          "enum": [
            "absent",
            "valid",
            "unreadable"
          ]
        },
        "binding": {
          "enum": [
            "not-applicable",
            "exact",
            "rebound",
            "mismatch"
          ]
        }
      }
    },
    "LeakFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "key",
        "backing",
        "location",
        "idle",
        "lease"
      ],
      "properties": {
        "family": {
          "const": "leaked-image"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "key": {
          "$ref": "#/definitions/Sha256"
        },
        "backing": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "location": {
          "enum": [
            "scratch",
            "workspace",
            "other"
          ]
        },
        "idle": {
          "type": "boolean"
        },
        "lease": {
          "enum": [
            "free",
            "held",
            "unavailable"
          ]
        }
      }
    },
    "Fact": {
      "oneOf": [
        {
          "$ref": "#/definitions/LeakFact"
        },
        {
          "$ref": "#/definitions/PublicationFact"
        },
        {
          "$ref": "#/definitions/TicketFact"
        },
        {
          "$ref": "#/definitions/ClaimCatalogFact"
        },
        {
          "$ref": "#/definitions/ServerFact"
        },
        {
          "$ref": "#/definitions/SwapFact"
        },
        {
          "$ref": "#/definitions/RecordFact"
        },
        {
          "$ref": "#/definitions/ClaimFact"
        },
        {
          "$ref": "#/definitions/ReceiptFact"
        }
      ]
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "bootSession",
        "bootEpochMs",
        "facts"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "bootSession": {
          "$ref": "#/definitions/BootSession"
        },
        "bootEpochMs": {
          "$ref": "#/definitions/Millis"
        },
        "facts": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/definitions/Fact"
          }
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "phase",
        "family",
        "scope",
        "action",
        "target",
        "reason"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "phase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "family": {
          "enum": [
            "publication-residue",
            "lease-ticket",
            "lease-claims",
            "tool-server",
            "directory-swap",
            "leaked-image"
          ]
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "action": {
          "$ref": "#/definitions/Action"
        },
        "target": {
          "$ref": "#/definitions/RelativePath"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "Retained": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "scope",
        "verdict",
        "reason"
      ],
      "properties": {
        "family": {
          "enum": [
            "publication-residue",
            "lease-ticket",
            "tool-server",
            "directory-swap",
            "persistent-record",
            "creator-claim",
            "image-receipt",
            "leaked-image",
            "lease-claims"
          ]
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "verdict": {
          "enum": [
            "keep",
            "refuse"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "bootSession",
        "steps",
        "retained"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "bootSession": {
          "$ref": "#/definitions/BootSession"
        },
        "steps": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/definitions/Step"
          }
        },
        "retained": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/definitions/Retained"
          }
        }
      }
    },
    "PlanCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "observation",
        "plan"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source": {
          "enum": [
            "captured",
            "derived"
          ]
        },
        "observation": {
          "$ref": "#/definitions/Observation"
        },
        "plan": {
          "$ref": "#/definitions/Plan"
        }
      }
    },
    "IdentityTuple": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/definitions/Identity"
      }
    },
    "IdentityBindingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "recorded",
        "current",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source": {
          "enum": [
            "captured",
            "derived"
          ]
        },
        "recorded": {
          "$ref": "#/definitions/IdentityTuple"
        },
        "current": {
          "$ref": "#/definitions/IdentityTuple"
        },
        "expected": {
          "enum": [
            "exact",
            "rebound",
            "mismatch"
          ]
        }
      }
    },
    "BackingIdentityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "recorded",
        "current",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source": {
          "enum": [
            "captured",
            "derived"
          ]
        },
        "recorded": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "current": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expected": {
          "enum": [
            "exact",
            "rebound",
            "mismatch"
          ]
        }
      }
    },
    "BootEpochCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "platform",
        "text",
        "expectedMs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "platform": {
          "enum": [
            "darwin",
            "linux",
            "win32"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        },
        "expectedMs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Millis"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LedgerEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "v",
            "type",
            "boot",
            "at",
            "steps",
            "plan"
          ],
          "properties": {
            "v": {
              "const": 1
            },
            "type": {
              "const": "begin"
            },
            "boot": {
              "$ref": "#/definitions/BootSession"
            },
            "at": {
              "$ref": "#/definitions/Millis"
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
