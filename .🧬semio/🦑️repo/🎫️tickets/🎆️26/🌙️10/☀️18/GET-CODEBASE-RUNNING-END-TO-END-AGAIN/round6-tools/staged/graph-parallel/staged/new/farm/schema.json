{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:build:graph-farm:v1",
  "title": "Graph inference farm",
  "description": "A bounded pool of worker processes that infer disjoint graph owners in parallel; every message is plain data, shared facts travel once through content-identified tables.",
  "$defs": {
    "Policy": {
      "const": {
        "version": 1,
        "languages": ["en", "de"],
        "languageEnvironment": ["SEMIO_LANGUAGE", "SEMIO_DASHBOARD_LOCALE", "LC_ALL", "LC_MESSAGES", "LANG"],
        "workersEnvironment": "SEMIO_GRAPH_WORKERS",
        "workerMegabytesEnvironment": "SEMIO_GRAPH_WORKER_MB",
        "minimumWorkerMegabytes": 512,
        "planEnvironment": "SEMIO_HOST_CAPACITY_PLAN",
        "phasesEnvironment": "SEMIO_GRAPH_PHASES",
        "maximumWorkers": 12,
        "minimumProjects": 24,
        "projectsPerWorker": 6,
        "workerMegabytes": 1536,
        "parentReserveMegabytes": 2048,
        "hostShareBasisPoints": 5000,
        "cpuReserve": 1,
        "maximumRestarts": 8,
        "capacityWaitMilliseconds": 30000,
        "initTimeoutMilliseconds": 180000,
        "jobTimeoutMilliseconds": 1800000,
        "shutdownGraceMilliseconds": 3000,
        "maximumTableEntries": 8388608,
        "maximumRecordBytes": 268435456,
        "runtime": {
          "bun": { "ramFactor": 0.75, "environment": { "BUN_JSC_numberOfGCMarkers": "1", "BUN_JSC_useConcurrentGC": "0" } },
          "node": { "ramFactor": 1, "environment": {} }
        }
      }
    },
    "Messages": {
      "const": {
        "en": {
          "starting": "graph: inferring {projects} projects with {workers} worker processes ({megabytes} MB each)",
          "serial": "graph: inferring {projects} projects in this process ({reason})",
          "fallback": "graph: {count} projects were inferred in this process because a worker was unavailable ({reason})",
          "recycled": "graph: worker {worker} restarted after {megabytes} MB",
          "finished": "graph: {projects} projects inferred by {workers} workers in {seconds} s ({jobs} jobs, {fallbacks} in this process, {recycled} restarts)"
        },
        "de": {
          "starting": "Graph: {projects} Projekte werden mit {workers} Arbeitsprozessen abgeleitet ({megabytes} MB je Prozess)",
          "serial": "Graph: {projects} Projekte werden in diesem Prozess abgeleitet ({reason})",
          "fallback": "Graph: {count} Projekte wurden in diesem Prozess abgeleitet, weil ein Arbeitsprozess nicht verfügbar war ({reason})",
          "recycled": "Graph: Arbeitsprozess {worker} nach {megabytes} MB neu gestartet",
          "finished": "Graph: {projects} Projekte von {workers} Arbeitsprozessen in {seconds} s abgeleitet ({jobs} Aufträge, {fallbacks} in diesem Prozess, {recycled} Neustarts)"
        }
      }
    },
    "Reasons": { "enum": ["disabled", "forced", "small", "single", "cpu", "memory", "work", "limit"] },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workers", "reason", "workerMegabytes"],
      "properties": {
        "workers": { "type": "integer", "minimum": 0 },
        "reason": { "$ref": "#/$defs/Reasons" },
        "workerMegabytes": { "type": "integer", "minimum": 1 }
      }
    },
    "Init": { "type": "object", "additionalProperties": false, "required": ["type", "service", "sessionFile"], "properties": { "type": { "const": "init" }, "service": { "type": "string", "pattern": "^file:///" }, "sessionFile": { "type": "string", "minLength": 1 } } },
    "Ready": { "type": "object", "additionalProperties": false, "required": ["type", "pid", "identity"], "properties": { "type": { "const": "ready" }, "pid": { "type": "integer" }, "identity": {} } },
    "Run": { "type": "object", "additionalProperties": false, "required": ["type", "id", "job"], "properties": { "type": { "const": "run" }, "id": { "type": "integer", "minimum": 0 }, "job": {} } },
    "Result": { "type": "object", "required": ["type", "id", "rssMegabytes"], "properties": { "type": { "const": "result" }, "id": { "type": "integer", "minimum": 0 }, "rssMegabytes": { "type": "number", "minimum": 0 } } },
    "Failure": { "type": "object", "additionalProperties": false, "required": ["type", "id", "name", "message"], "properties": { "type": { "const": "failure" }, "id": { "type": "integer", "minimum": 0 }, "name": { "type": "string" }, "message": { "type": "string" }, "code": { "type": ["string", "null"] } } },
    "Fatal": { "type": "object", "additionalProperties": false, "required": ["type", "name", "message"], "properties": { "type": { "const": "fatal" }, "name": { "type": "string" }, "message": { "type": "string" } } },
    "Shutdown": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "shutdown" } } }
  },
  "oneOf": [
    { "$ref": "#/$defs/Init" }, { "$ref": "#/$defs/Ready" }, { "$ref": "#/$defs/Run" }, { "$ref": "#/$defs/Result" },
    { "$ref": "#/$defs/Failure" }, { "$ref": "#/$defs/Fatal" }, { "$ref": "#/$defs/Shutdown" }
  ]
}
