{
 "accepted": [
  {"name": "no arguments print the help", "args": []},
  {"name": "a top level help flag", "args": ["--help"]},
  {"name": "help of a command", "args": ["run", "--help"]},
  {"name": "help of a subcommand with a tool option first", "args": ["--tool=bazel", "tools", "--help"]},
  {"name": "a catalogue command with its subcommand", "args": ["tools", "setup", "nx"]},
  {"name": "a catalogue command after a spaced option", "args": ["--tool", "nx", "tools", "setup", "nx"]}
 ],
 "refused": [
  {"name": "a mistyped command", "args": ["tset", "x"], "command": "tset"},
  {"name": "the word test, which is not a repo command", "args": ["test", "some-suite"], "command": "test"},
  {"name": "an unknown command after a tool option", "args": ["--tool=bazel", "bogus", "--help-me"], "command": "bogus"},
  {"name": "an unknown command after a spaced option", "args": ["--tool", "nx", "frobnicate"], "command": "frobnicate"}
 ]
}
