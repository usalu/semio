{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/process/artifacts/native-build/storage/backends/component.json",
  "definitions": {
    "Platform": {"enum": ["darwin", "linux", "win32"]},
    "Capability": {
      "enum": ["kernel-quota", "mounted-volume", "volume-events", "declared-envelope", "unprivileged", "atomic-exchange"]
    },
    "Backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platforms", "capabilities", "backingFilename", "dispatch", "modules"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/Platform"}},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/Capability"}},
        "backingFilename": {"type": "string", "pattern": "^[a-z][a-z0-9.]{1,31}$"},
        "dispatch": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": {"$ref": "#/definitions/Platform"},
          "patternProperties": {"^(darwin|linux|win32)$": {"$ref": "#/definitions/Platform"}}
        },
        "modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "Selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {"$ref": "#/definitions/Platform"},
        "backend": {"type": "string"},
        "require": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/Capability"}},
        "prefer": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/Capability"}}
      }
    },
    "Protocol": {
      "const": {
        "version": 1,
        "environment": {"backend": "SEMIO_NATIVE_STORAGE_BACKEND", "require": "SEMIO_NATIVE_STORAGE_REQUIRE", "prefer": "SEMIO_NATIVE_STORAGE_PREFER"},
        "preferred": ["kernel-quota"],
        "backends": [
          {
            "id": "mounted-image",
            "platforms": ["darwin"],
            "capabilities": ["kernel-quota", "mounted-volume", "volume-events"],
            "backingFilename": "fixed.dmg",
            "dispatch": {"darwin": "darwin"},
            "modules": ["🍎️image", "🧹️cleanup/🎛️command", "📤️publication/📚️witness/🍎️events", "🔌️backends/🍎️mounted-image"]
          },
          {
            "id": "directory-partition",
            "platforms": ["darwin", "linux", "win32"],
            "capabilities": ["declared-envelope", "unprivileged", "atomic-exchange"],
            "backingFilename": "fixed.dir",
            "dispatch": {"darwin": "linux", "linux": "linux", "win32": "win32"},
            "modules": ["📁️directory", "📁️image", "🧱️fixed", "📤️publication/🧱️fixed", "🪟️conditional-retirement", "🔌️backends/📁️directory-partition"]
          }
        ],
        "refusals": {
          "platform": "Declared native storage platform required",
          "unavailable": "Declared native storage backend unavailable on this host",
          "unsatisfied": "No declared native storage backend satisfies the requirements",
          "unbound": "Native storage backend adapter is unbound"
        }
      }
    }
  }
}
