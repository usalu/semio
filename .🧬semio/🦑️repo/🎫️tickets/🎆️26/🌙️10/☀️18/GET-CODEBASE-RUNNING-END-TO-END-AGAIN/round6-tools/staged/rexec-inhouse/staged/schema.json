{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Remote execution",
  "description": "Closed shapes of the in-house remote execution service: policy, worker protocol, status and message catalogue. The protocol towards build tools (the Remote Execution API over gRPC) is generated from Bazel's own descriptors into the wire schema of the module and is not repeated here.",
  "definitions": {
    "Digest": {
      "description": "A content digest: lowercase SHA-256 and the size in bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "size"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Instance": {
      "type": "string",
      "pattern": "^([a-z0-9][a-z0-9._-]{0,63})?$",
      "description": "The instance name of the protocol; empty selects the default instance of the cache."
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "Sandbox": {
      "enum": [
        "darwin-sandbox",
        "linux-sandbox",
        "isolated-root"
      ],
      "description": "How a worker confines an action: the macOS sandbox, a Linux user-namespace sandbox, or a private input root with a cleaned environment (every platform)."
    },
    "Language": {
      "enum": [
        "en",
        "de"
      ]
    },
    "EnvironmentNames": {
      "description": "The variables of the client contract (shared with the build tool adapters) and of the worker agent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "platform",
        "instance",
        "properties",
        "jobs",
        "scheduler",
        "workerToken"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "platform": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "instance": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "properties": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "jobs": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "scheduler": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        },
        "workerToken": {
          "type": "string",
          "pattern": "^SEMIO_[A-Z0-9_]+$"
        }
      }
    },
    "ServerPolicy": {
      "description": "Bounds of the scheduler and its two listeners: gRPC for build clients and an HTTP API for workers and status.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "workerPort",
        "localWorkers",
        "unmatchedSeconds",
        "lingerSeconds",
        "leaseSeconds",
        "maximumAttempts",
        "defaultActionSeconds",
        "maximumQueued",
        "maximumMessageBytes",
        "maximumBatchBytes",
        "defaultInstance"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "workerPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "localWorkers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "unmatchedSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "lingerSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3600
        },
        "maximumAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "defaultActionSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "maximumQueued": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "maximumMessageBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 268435456
        },
        "maximumBatchBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "defaultInstance": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "WorkerPolicy": {
      "description": "Defaults of a worker agent; concurrency 0 means one slot per CPU.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency",
        "heartbeatSeconds",
        "pollSeconds",
        "directory",
        "materialize",
        "maximumBlobBytes",
        "sandbox",
        "inlineOutputBytes"
      ],
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "heartbeatSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "materialize": {
          "enum": [
            "clone",
            "copy"
          ]
        },
        "maximumBlobBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1125899906842624
        },
        "sandbox": {
          "enum": [
            "auto",
            "darwin-sandbox",
            "linux-sandbox",
            "isolated-root"
          ]
        },
        "inlineOutputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "Policy": {
      "description": "The authored data in the build policy.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "environment",
        "server",
        "worker"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "environment": {
          "$ref": "#/definitions/EnvironmentNames"
        },
        "server": {
          "$ref": "#/definitions/ServerPolicy"
        },
        "worker": {
          "$ref": "#/definitions/WorkerPolicy"
        }
      }
    },
    "WorkerRegistration": {
      "description": "What a worker announces when it joins.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "name",
        "host",
        "platform",
        "properties",
        "concurrency",
        "sandbox",
        "runtime"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Property"
          },
          "maxItems": 64
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "sandbox": {
          "$ref": "#/definitions/Sandbox"
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "WorkerRegistered": {
      "description": "The scheduler's answer to a registration; `relative` means the cache lives on the scheduler's host at the url's port.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "heartbeatSeconds",
        "pollSeconds",
        "leaseSeconds",
        "cache",
        "language"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "heartbeatSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "relative"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "relative": {
              "type": "boolean"
            }
          }
        },
        "language": {
          "enum": [
            "en",
            "de",
            "none"
          ]
        }
      }
    },
    "Task": {
      "description": "One action assigned to a worker.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "instance",
        "action",
        "timeoutSeconds",
        "attempt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instance": {
          "$ref": "#/definitions/Instance"
        },
        "action": {
          "$ref": "#/definitions/Digest"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "PollAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "task",
        "cancel",
        "known"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "task": {
          "oneOf": [
            {
              "$ref": "#/definitions/Task"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancel": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "known": {
          "type": "boolean"
        }
      }
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "running"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "running": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 512
        }
      }
    },
    "HeartbeatAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "known",
        "cancel"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "known": {
          "type": "boolean"
        },
        "cancel": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "TaskStatus": {
      "description": "Outcome in the vocabulary of gRPC; `missing` lists input blobs the worker could not find (FAILED_PRECONDITION).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "missing": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Digest"
          },
          "maxItems": 100000
        }
      }
    },
    "TaskResult": {
      "description": "A worker's report; `actionResult` is the serialized ActionResult of the protocol in base64.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "outcome",
        "status",
        "actionResult"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "status": {
          "$ref": "#/definitions/TaskStatus"
        },
        "actionResult": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Counter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queued",
        "executing",
        "completed",
        "cached",
        "failed",
        "cancelled",
        "retried",
        "deduplicated"
      ],
      "properties": {
        "queued": {
          "type": "integer",
          "minimum": 0
        },
        "executing": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "retried": {
          "type": "integer",
          "minimum": 0
        },
        "deduplicated": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WorkerRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "host",
        "platform",
        "properties",
        "concurrency",
        "running",
        "sandbox",
        "lastSeenSeconds",
        "draining"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Property"
          }
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "sandbox": {
          "$ref": "#/definitions/Sandbox"
        },
        "lastSeenSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "draining": {
          "type": "boolean"
        }
      }
    },
    "ServerStatus": {
      "description": "What `GET /status` of the worker API answers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "service",
        "startedAt",
        "grpc",
        "workerApi",
        "cache",
        "counters",
        "workers",
        "platforms"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "service": {
          "const": "semio-remote-execution"
        },
        "startedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "grpc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "workerApi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "answers"
          ],
          "properties": {
            "url": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "answers": {
              "type": "boolean"
            }
          }
        },
        "counters": {
          "$ref": "#/definitions/Counter"
        },
        "workers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WorkerRow"
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "queued",
              "workers"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "queued": {
                "type": "integer",
                "minimum": 0
              },
              "workers": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "Probe": {
      "description": "One reachability probe.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reachable",
        "milliseconds",
        "detail"
      ],
      "properties": {
        "reachable": {
          "type": "boolean"
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "Status": {
      "description": "What `remote-execution status` prints.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "configured",
        "contract",
        "scheduler",
        "grpc",
        "server",
        "token"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "configured": {
          "type": "boolean"
        },
        "contract": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "endpoint",
                "platform",
                "instance",
                "properties",
                "jobs"
              ],
              "properties": {
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "platform": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "instance": {
                  "$ref": "#/definitions/Instance"
                },
                "properties": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Property"
                  }
                },
                "jobs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 512
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduler": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "grpc": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capabilities",
                "execution",
                "apiVersions",
                "digestFunctions",
                "probe"
              ],
              "properties": {
                "capabilities": {
                  "type": "boolean"
                },
                "execution": {
                  "type": "boolean"
                },
                "apiVersions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "digestFunctions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "probe": {
                  "$ref": "#/definitions/Probe"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "server": {
          "oneOf": [
            {
              "$ref": "#/definitions/ServerStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "environment",
                "present"
              ],
              "properties": {
                "environment": {
                  "type": "string",
                  "pattern": "^SEMIO_[A-Z0-9_]+$"
                },
                "present": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TextCatalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "languages",
        "messages"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Language"
          },
          "minItems": 2
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "description": "The bilingual messages of the command; there is no default language."
    }
  }
}
