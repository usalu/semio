{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native Toolchain Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "roots", "environments", "identities", "tools", "links", "publisher", "messages"],
  "properties": {
    "version": {"const": 1},
    "roots": {"type": "array", "minItems": 2, "items": {"$ref": "#/definitions/Roots"}},
    "environments": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Environment"}},
    "identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Identity"}},
    "tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Tool"}},
    "links": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Link"}},
    "publisher": {"type": "object", "additionalProperties": false, "required": ["cmake", "ninja", "go"], "properties": {"cmake": {"$ref": "#/definitions/Listing"}, "ninja": {"$ref": "#/definitions/Listing"}, "go": {"$ref": "#/definitions/Listing"}}},
    "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Message"}}
  },
  "definitions": {
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Roots": {"type": "object", "additionalProperties": false, "required": ["dependencies", "tools"], "properties": {"dependencies": {"type": "string", "minLength": 1}, "tools": {"type": "string", "minLength": 1}}},
    "Environment": {"type": "object", "additionalProperties": false, "required": ["name", "project", "host", "roots", "manifest", "lock"], "properties": {"name": {"type": "string", "minLength": 1}, "project": {"type": "string", "minLength": 1}, "host": {"type": "string", "minLength": 1}, "roots": {"$ref": "#/definitions/Roots"}, "manifest": {"$ref": "#/definitions/Sha256"}, "lock": {"$ref": "#/definitions/Sha256"}}},
    "Identity": {"type": "object", "additionalProperties": false, "required": ["name", "kind", "host", "environment"], "properties": {"name": {"type": "string", "minLength": 1}, "kind": {"enum": ["python", "dotnet", "cmake", "go"]}, "host": {"type": "string", "minLength": 1}, "project": {"type": "string", "minLength": 1}, "environment": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "Tool": {"type": "object", "additionalProperties": false, "required": ["name", "tool", "host", "root"], "properties": {"name": {"type": "string", "minLength": 1}, "tool": {"enum": ["cmake", "ninja", "go"]}, "host": {"type": "string", "minLength": 1}, "root": {"type": "string", "minLength": 1}}},
    "Link": {"type": "object", "additionalProperties": false, "required": ["name", "path", "target"], "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}},
    "Listing": {"type": "object", "additionalProperties": false, "required": ["source", "lines"], "properties": {"source": {"type": "string", "minLength": 1}, "lines": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}  [A-Za-z0-9._-]+$"}}}},
    "Message": {"type": "object", "additionalProperties": false, "required": ["name", "key", "values", "environment"], "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}, "values": {"type": "object", "additionalProperties": {"type": "string"}}, "environment": {"type": "object", "additionalProperties": {"type": "string"}}}}
  }
}
