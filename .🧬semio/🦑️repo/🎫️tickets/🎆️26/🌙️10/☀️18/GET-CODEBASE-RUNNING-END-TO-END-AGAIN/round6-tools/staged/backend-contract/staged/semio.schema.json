{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semio Build Engine",
  "description": "Closed contracts of the in-house build engine: its authored policy, the cache entry it stores per action key and the run record it prints.",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "maximumEntryBytes": 268435456,
        "maximumOutputFiles": 200000,
        "lockStaleMilliseconds": 30000,
        "lockHeartbeatMilliseconds": 5000,
        "lockPollMilliseconds": 20,
        "killGraceMilliseconds": 2000,
        "remoteTimeoutMilliseconds": 10000,
        "remoteKeyPrefix": "semio-",
        "remotePath": "/v1/cache/",
        "archiveMagic": "SEMIO1\n",
        "directory": "semio",
        "ledgerArea": "semio-actions",
        "ledgerDirectory": "semio/actions",
        "collectGraceMilliseconds": 600000,
        "touchIntervalMilliseconds": 60000
      }
    },
    "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Path": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "File": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "mode"],
      "properties": {
        "path": { "$ref": "#/definitions/Path" },
        "kind": { "enum": ["file", "directory", "symlink"] },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "sha256": { "$ref": "#/definitions/Sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "link": { "type": "string", "minLength": 1 }
      }
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "key", "task", "files", "digest"],
      "properties": {
        "version": { "const": 1 },
        "key": { "$ref": "#/definitions/Sha256" },
        "task": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "$ref": "#/definitions/File" } },
        "digest": { "$ref": "#/definitions/Sha256" }
      }
    },
    "Status": { "enum": ["executed", "restored", "cached", "failed", "skipped", "cancelled"] },
    "RecordTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "startedMs", "endedMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/Status" },
        "source": { "enum": ["local", "remote"] },
        "key": { "$ref": "#/definitions/Sha256" },
        "startedMs": { "type": "number", "minimum": 0 },
        "endedMs": { "type": "number", "minimum": 0 },
        "exitCode": { "type": "integer" },
        "reason": { "type": "string" }
      }
    },
    "Record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "exitCode", "cancelled", "tasks"],
      "properties": {
        "version": { "const": 1 },
        "exitCode": { "type": "integer" },
        "cancelled": { "type": "boolean" },
        "tasks": { "type": "array", "items": { "$ref": "#/definitions/RecordTask" } }
      }
    }
  }
}
