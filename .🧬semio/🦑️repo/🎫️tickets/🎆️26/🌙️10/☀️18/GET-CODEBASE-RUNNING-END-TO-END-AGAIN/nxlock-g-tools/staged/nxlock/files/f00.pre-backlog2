{
  "version": 1,
  "rules": {
    "outOfOrder": "observe",
    "holdAndWait": "enforce",
    "selfDeadlock": "enforce",
    "cycle": "enforce",
    "strictWait": "enforce"
  },
  "holdAndWait": {
    "graceMilliseconds": 15000,
    "pollMilliseconds": 250
  },
  "cycle": {
    "intervalMilliseconds": 500
  },
  "registry": {
    "flushMilliseconds": 100,
    "maximumEntryBytes": 65536,
    "maximumViolations": 200
  },
  "fairness": {
    "queuedWithResourceLeases": true,
    "writerPreferenceMilliseconds": 120000
  },
  "gate": {
    "releaseWhileWaiting": true,
    "pollInitialMilliseconds": 20,
    "pollMaximumMilliseconds": 250,
    "admissionPatienceMilliseconds": 5000,
    "claimSweepIntervalMilliseconds": 30000,
    "claimSweepPressureFreeRatio": 0.2,
    "claimSweepPressureIntervalMilliseconds": 1000
  },
  "media": [
    {
      "prefix": "native-fixed-image:"
    }
  ],
  "classes": [
    {
      "id": "toolchain",
      "rank": 1,
      "scope": "checkout",
      "owner": "build-tools",
      "title": {
        "en": "Rust toolchain home, generation and Cargo configuration view, held by readers around a whole build and by provisioners",
        "de": "Rust-Toolchain-Home, -Generation und Cargo-Konfigurationssicht, gehalten von Lesern um einen ganzen Build und von Bereitstellern"
      },
      "match": [
        {
          "kind": "prefix",
          "value": "rustup:"
        },
        {
          "kind": "prefix",
          "value": "cargo:configuration-view:"
        }
      ]
    },
    {
      "id": "compiler-capacity",
      "rank": 3,
      "scope": "machine",
      "owner": "compiler-capacity",
      "title": {
        "en": "Compiler capacity gate, picker and core slots",
        "de": "Compiler-Kapazitätstor, Auswahl und Kernplätze"
      },
      "match": [
        {
          "kind": "exact",
          "value": "semio.compiler.host-capacity/v1"
        },
        {
          "kind": "exact",
          "value": "semio.compiler.cpu-picker/v1"
        },
        {
          "kind": "prefix",
          "value": "semio.compiler.cpu/v1/"
        }
      ]
    },
    {
      "id": "tool-singleton",
      "rank": 2,
      "scope": "checkout",
      "owner": "build-tools",
      "title": {
        "en": "Tool activation, download and provisioning singletons",
        "de": "Singletons für Werkzeug-Aktivierung, -Download und -Bereitstellung"
      },
      "match": [
        {
          "kind": "exact",
          "value": "nx-tooling-activation"
        },
        {
          "kind": "exact",
          "value": "nx-tool-download-cache"
        },
        {
          "kind": "exact",
          "value": "nx-tooling-provision"
        },
        {
          "kind": "prefix",
          "value": "nx-tooling:"
        },
        {
          "kind": "prefix",
          "value": "nx-authorizer-"
        },
        {
          "kind": "prefix",
          "value": "nx-sdk-snapshot:"
        },
        {
          "kind": "exact",
          "value": "bazel-metrics"
        },
        {
          "kind": "exact",
          "value": "bazel-snapshot-restore"
        },
        {
          "kind": "prefix",
          "value": "bazel-"
        },
        {
          "kind": "prefix",
          "value": "bun-"
        },
        {
          "kind": "exact",
          "value": "cache-prune"
        },
        {
          "kind": "exact",
          "value": "tools"
        },
        {
          "kind": "prefix",
          "value": "tools:"
        },
        {
          "kind": "prefix",
          "value": "repository:selected-tooling:"
        },
        {
          "kind": "prefix",
          "value": "selected-rust-"
        }
      ]
    },
    {
      "id": "cargo-coordination",
      "rank": 2,
      "scope": "crate",
      "owner": "cargo",
      "title": {
        "en": "Cargo registry, preparation, source admission and build leases",
        "de": "Cargo-Registry, -Vorbereitung, -Quellzulassung und -Build-Leases"
      },
      "match": [
        {
          "kind": "prefix",
          "value": "cargo:"
        },
        {
          "kind": "prefix",
          "value": "cargo-"
        },
        {
          "kind": "prefix",
          "value": "[\"semio.cargo."
        },
        {
          "kind": "prefix",
          "value": "[\"cargo-target-recipe-v1\""
        }
      ]
    },
    {
      "id": "graph",
      "rank": 4,
      "scope": "checkout",
      "owner": "graph",
      "title": {
        "en": "Graph pools, writers, publications and daemons",
        "de": "Graph-Pools, -Schreiber, -Veröffentlichungen und -Daemons"
      },
      "match": [
        {
          "kind": "prefix",
          "value": "nx:"
