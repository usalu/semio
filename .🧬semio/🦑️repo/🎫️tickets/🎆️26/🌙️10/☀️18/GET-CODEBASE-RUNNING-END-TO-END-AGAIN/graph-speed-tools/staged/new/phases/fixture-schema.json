{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "refusals"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "minimumMilliseconds",
          "steps",
          "published",
          "rows"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "minimumMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "phase",
                "at"
              ],
              "properties": {
                "op": {
                  "enum": [
                    "begin",
                    "advance",
                    "end"
                  ]
                },
                "phase": {
                  "type": "string"
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                },
                "total": {
                  "type": "integer"
                },
                "done": {
                  "type": "integer"
                }
              }
            }
          },
          "published": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^build:graph-phase:[a-z]+:(?:0|[1-9][0-9]*):(?:0|[1-9][0-9]*)$"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "milliseconds",
                "done",
                "total"
              ],
              "properties": {
                "phase": {
                  "type": "string"
                },
                "milliseconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "done": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "phase",
                "at"
              ],
              "properties": {
                "op": {
                  "enum": [
                    "begin",
                    "advance",
                    "end"
                  ]
                },
                "phase": {
                  "type": "string"
                },
                "at": {
                  "type": "number",
                  "minimum": 0
                },
                "total": {
                  "type": "integer"
                },
                "done": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
