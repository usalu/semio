{
 "version": 1,
 "cases": [
  {
   "name": "a diamond reaches the top once",
   "projects": {
    "a": {
     "root": "a",
     "targets": {
      "build": {}
     }
    },
    "b": {
     "root": "b",
     "targets": {
      "build": {}
     }
    },
    "c": {
     "root": "c",
     "targets": {
      "build": {}
     }
    },
    "d": {
     "root": "d",
     "targets": {
      "build": {}
     }
    }
   },
   "edges": [
    [
     "b",
     "a"
    ],
    [
     "c",
     "a"
    ],
    [
     "d",
     "b"
    ],
    [
     "d",
     "c"
    ]
   ],
   "files": [
    "a/x.ts"
   ],
   "affected": [
    "a",
    "b",
    "c",
    "d"
   ]
  },
  {
   "name": "a dependency cycle terminates",
   "projects": {
    "x": {
     "root": "x",
     "targets": {
      "build": {}
     }
    },
    "y": {
     "root": "y",
     "targets": {
      "build": {}
     }
    },
    "z": {
     "root": "z",
     "targets": {
      "build": {}
     }
    }
   },
   "edges": [
    [
     "x",
     "y"
    ],
    [
     "y",
     "x"
    ]
   ],
   "files": [
    "x/f.ts"
   ],
   "affected": [
    "x",
    "y"
   ]
  },
  {
   "name": "a named input pulls its projects in",
   "projects": {
    "app": {
     "root": "app",
     "targets": {
      "build": {
       "inputs": [
        "default",
        "shared"
       ]
      }
     }
    },
    "other": {
     "root": "other",
     "targets": {
      "build": {}
     }
    }
   },
   "edges": [],
   "files": [
    "config/c.json"
   ],
   "namedInputs": {
    "shared": [
     "{workspaceRoot}/config/**/*"
    ]
   },
   "affected": [
    "app"
   ]
  },
  {
   "name": "deleted and untracked files count like any change",
   "projects": {
    "lib": {
     "root": "lib",
     "targets": {
      "build": {}
     }
    },
    "app": {
     "root": "app",
     "targets": {
      "build": {}
     }
    },
    "tool": {
     "root": "tool",
     "targets": {
      "build": {}
     }
    }
   },
   "edges": [
    [
     "app",
     "lib"
    ]
   ],
   "files": [
    "lib/gone.ts",
    "lib/new.ts"
   ],
   "affected": [
    "app",
    "lib"
   ]
  },
  {
   "name": "one file can touch an owner and a declaring project",
   "projects": {
    "app": {
     "root": "app",
     "targets": {
      "build": {}
     }
    },
    "tool": {
     "root": "tool",
     "targets": {
      "build": {
       "inputs": [
        "default",
        "{workspaceRoot}/app/**/*"
       ]
      }
     }
    }
   },
   "edges": [],
   "files": [
    "app/a.ts"
   ],
   "affected": [
    "app",
    "tool"
   ]
  },
  {
   "name": "names with emoji and spaces are ordinary",
   "projects": {
    "pkg": {
     "root": "📦️pkg a",
     "targets": {
      "build": {}
     }
    },
    "user": {
     "root": "user",
     "targets": {
      "build": {}
     }
    }
   },
   "edges": [
    [
     "user",
     "pkg"
    ]
   ],
   "files": [
    "📦️pkg a/ü ß.ts"
   ],
   "affected": [
    "pkg",
    "user"
   ]
  },
  {
   "name": "an edge to an unknown project is ignored",
   "projects": {
    "a": {
     "root": "a",
     "targets": {
      "build": {}
     }
    }
   },
   "edges": [
    [
     "a",
     "ghost"
    ],
    [
     "ghost",
     "a"
    ]
   ],
   "files": [
    "a/x.ts"
   ],
   "affected": [
    "a"
   ],
   "nx": false
  }
 ]
}