test("neutral queue claim cleanup preserves authored frontiers and bounded progress",()=>{expect(new Ajv({strict:true}).validate(corpusSchema,corpus)).toBe(true);const policy=authoritySchema.definitions.ClaimRetentionPolicy.properties;expect(policy.maximumClaimsPerTurn.const).toBe(corpus.maximumClaimsPerTurn);expect(policy.maximumDatabaseBytes.const).toBe(16384);expect(authoritySchema.definitions.RetirementPolicy.properties.maximumDirectoryEntries.const).toBe(corpus.maximumDirectoryEntries);expect(scanSchema.definitions.Scan.const).toEqual({entriesPerYield:128,entriesPerProgress:4096});});
registerBuildTestLawV1("default queue claim cleanup passes unfinished prefixes and preserves cancellation","sdk-fence",original=>withIssuedResourceControlV1(original,"lease:claim-frontier",0,async control=>{const sink=process.env.SEMIO_TEST_ARTIFACT_DIR;if(!sink)throw Error("Actual claim frontier sink required");const oracle=new Database(":memory:");try{oracle.exec("create table facts(authenticated integer,held integer,safe integer);insert into facts values(1,0,1),(1,1,1),(0,0,0)");expect(oracle.query("select sum(authenticated and safe and not held) retired,sum(authenticated and safe) examined from facts").get()).toEqual({retired:1,examined:2});for(const row of corpus.cases){const area=await mkdtemp(sink+sep);try{const program=`const root=${JSON.stringify(area)},row=${JSON.stringify(row)},routing=await import(${JSON.stringify(routing)}),{mock}=await import('bun:test'),retirement=await import(${JSON.stringify(retirement)}),capture=retirement.captureResourceLeaseCandidateV1,fs=await import('node:fs/promises'),{join,basename}=await import('node:path'),{Database}=await import('bun:sqlite'),claims=join(root,'claims'),stop=new AbortController(),primary=Error('Actual claim scan cancellation');let armed=false,scanned=0,yielded=false,failed=false,exact=false,liveRetained=false,blockers=0,turns=[],reads=[];mock.module(${JSON.stringify(retirement)},()=>({...retirement,captureResourceLeaseCandidateV1(...args){const value=capture(...args);if(armed&&args[0]===claims){scanned++;if(row.cancel&&scanned===128)setImmediate(()=>{yielded=true;stop.abort(primary);});}return value;}}));const api=await import(${JSON.stringify(lease)});try{await routing.receiveScriptProcessInvocation(process.env,original=>routing.withIssuedResourceControlV1(original,'lease:claim:fixture',0,async base=>{const queued=async(resource,owner,control)=>api.acquireQueuedResourceLease({directory:root,resource,owner,mode:'shared',signal:control.signal,control});const live=await queued('live-claim-frontier','live-claim-frontier',base);let liveFile;try{const actual=await fs.readdir(claims);for(const name of actual){const file=join(claims,name),db=new Database(file,{readonly:true});try{const resource=db.query('select resource from semio_resource_lease where id=1').get()?.resource;if(typeof resource==='string'&&resource.startsWith('queued-original:'))liveFile=file;}finally{db.close();}}if(!liveFile)throw Error('Actual live claim missing');for(let first=0;first<row.blockers;first+=128){await Promise.all(Array.from({length:Math.min(128,row.blockers-first)},(_,offset)=>fs.writeFile(join(claims,(first+offset).toString(16).padStart(64,'0')+'.sqlite'),'',{flag:'wx'})));await base.yieldContinuation();}const control=routing.createRequestedIssuedResourceControlV1(base,0,stop.signal);for(let turn=0;turn<row.turns;turn++){const beforeNames=new Set(await fs.readdir(claims)),idle=await queued('idle-claim-frontier:'+turn,'idle-claim-frontier-'+turn,control);idle.release();const file=join(claims,(await fs.readdir(claims)).find(name=>!beforeNames.has(name))??'missing'),before=await fs.lstat(file),name=basename(file),last=(row.blockers-1).toString(16).padStart(64,'0')+'.sqlite';if(name<=last)throw Error('Actual idle claim must sort after unfinished prefix');const identity=await api.readResourceQueueClaimIdentityV1(root,name,control);if(!identity||identity.path!==file)throw Error('Actual public claim reader missing identity');const independent=new Database(file,{readwrite:true,create:false});let exclusive=false;try{independent.exec('pragma busy_timeout=0;begin exclusive');exclusive=independent.query('select resource from semio_resource_lease where id=1').get()?.resource===identity.resource;independent.exec('rollback');}finally{independent.close();}reads.push({path:identity.path===file,bytes:identity.allocatedBytes===before.blocks*512,exclusive});armed=true;const value=await api.retireResourceQueueClaimsV1(root,control,0);armed=false;turns.push({...value,removed:!await fs.lstat(file).then(()=>true,()=>false),beforeBlocks:before.blocks*512});}}finally{armed=false;liveRetained=!!liveFile&&await fs.lstat(liveFile).then(()=>true,()=>false);live.release();}}));}catch(error){failed=true;exact=Object.is(error,primary);}for(const name of await fs.readdir(claims))if(/^[a-f0-9]{64}\\.sqlite$/.test(name)&&(await fs.lstat(join(claims,name))).size===0)blockers++;console.log(JSON.stringify({failed,exact,scanned,yielded,turns,liveRetained,blockers,reads}));process.exitCode=failed?1:0;`,actual=await child(program,original,control);expect(actual.status,actual.stderr).toBe(row.cancel?1:0);expect(actual.data.failed).toBe(row.cancel);expect(actual.data.blockers).toBe(row.blockers);expect(actual.data.liveRetained).toBe(true);for(const value of actual.data.reads)expect(value).toEqual({path:true,bytes:true,exclusive:true});if(row.cancel){expect(actual.data.exact).toBe(true);expect(actual.data.yielded).toBe(true);expect(oracle.query("select ?1>=128 and ?1<=260 accepted").get(actual.data.scanned)).toEqual({accepted:1});}else{expect(actual.data.turns).toHaveLength(row.turns);for(const value of actual.data.turns){expect(value.retired).toBe(row.retiredPerTurn);expect(value.examined).toBe(2);expect(value.removed).toBe(true);expect(value.allocatedBytes).toBe(value.beforeBlocks);}}}finally{await rm(area,{recursive:true,force:true});}}}finally{oracle.close();}}));
registerBuildTestLawV1("default queue claim cleanup caps actual eligible foreign probes","sdk-fence",original=>withIssuedResourceControlV1(original,"lease:claim-cap",0,async control=>{const sink=process.env.SEMIO_TEST_ARTIFACT_DIR;if(!sink)throw Error("Actual claim cap sink required");const area=await mkdtemp(sink+sep);try{const program=`const root=${JSON.stringify(area)},routing=await import(${JSON.stringify(routing)}),api=await import(${JSON.stringify(lease)}),fs=await import('node:fs/promises'),{join,basename}=await import('node:path'),{Database}=await import('bun:sqlite'),claims=join(root,'claims');await routing.receiveScriptProcessInvocation(process.env,original=>routing.withIssuedResourceControlV1(original,'lease:claim:cap:fixture',0,async control=>{const idle=await api.acquireQueuedResourceLease({directory:root,resource:'idle-claim-cap',owner:'idle-claim-cap',mode:'shared',signal:control.signal,control});idle.release();const template=join(root,'foreign.sqlite'),db=new Database(template);db.exec('create table foreign_owner(value)');db.close();const before=await fs.readdir(claims),tail=before.find(name=>name!==basename(api.resourceLeasePathV1(claims,'resource-directory-admission:v1')));if(!tail||tail<='0'.repeat(61)+'0ff.sqlite')throw Error('Actual settled tail must sort beyond foreign prefix');for(let first=0;first<${corpus.maximumClaimsPerTurn};first+=128){await Promise.all(Array.from({length:128},(_,offset)=>fs.copyFile(template,join(claims,(first+offset).toString(16).padStart(64,'0')+'.sqlite'))));await control.yieldContinuation();}const value=await api.retireResourceQueueClaimsV1(root,control,0),tailRetained=await fs.lstat(join(claims,tail)).then(()=>true,()=>false);let foreign=0;for(const name of await fs.readdir(claims))if(BigInt('0x'+name.slice(0,64))<256n)foreign++;console.log(JSON.stringify({...value,tailRetained,foreign}));}));`,actual=await child(program,original,control),oracle=new Database(":memory:");try{expect(actual.status,actual.stderr).toBe(0