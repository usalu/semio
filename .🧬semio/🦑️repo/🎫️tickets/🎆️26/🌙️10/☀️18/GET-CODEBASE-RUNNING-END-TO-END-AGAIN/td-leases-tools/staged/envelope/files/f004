registerBuildTestLawV1("default resource and claim scans bound controlled full name traffic","sdk-fence",original=>withIssuedResourceControlV1(original,"lease:scan-traffic",0,async control=>{const sink=process.env.SEMIO_TEST_ARTIFACT_DIR;if(!sink)throw Error("Actual scan traffic sink required");for(const kind of ["resource","claim"]){const area=await mkdtemp(sink+sep);try{const program=`const root=${JSON.stringify(area)},kind=${JSON.stringify(kind)},routing=await import(${JSON.stringify(routing)}),{mock}=await import('bun:test'),retirement=await import(${JSON.stringify(retirement)});mock.module(${JSON.stringify(retirement)},()=>({...retirement,resourceLeaseRetirementNamesV1:async()=>Object.freeze(Array.from({length:${corpus.maximumDirectoryEntries}},(_,i)=>i.toString(16).padStart(64,'0')+'.sqlite'))}));const api=await import(${JSON.stringify(lease)});await routing.receiveScriptProcessInvocation(process.env,original=>routing.withIssuedResourceControlV1(original,'lease:controlled-scan-traffic',0,async control=>{const value=kind==='resource'?await api.retireResourceLeasesV1(root,control,0):await api.retireResourceQueueClaimsV1(root,control,0);console.log(JSON.stringify(value));}));`,actual=await child(program,original,control);expect(actual.status,actual.stderr).toBe(0);expect(actual.data).toEqual({examined:0,retired:0,allocatedBytes:0});const progress=actual.stderr.split("\n").filter(line=>line.startsWith('[script]')).length;expect(progress).toBeLessThanOrEqual(18);expect(progress).toBe(17);}finally{await rm(area,{recursive:true,force:true});}}}));
