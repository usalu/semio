+ constructor(code:ServiceRefusalCodeV1,fields:Readonly<Record<string,string>>={}){super("Service request refused ("+code+")"+(fields.reason?": "+fields.reason:""));this.name="ServiceRefusalV1";this.code=code;this.fields=fields;}
