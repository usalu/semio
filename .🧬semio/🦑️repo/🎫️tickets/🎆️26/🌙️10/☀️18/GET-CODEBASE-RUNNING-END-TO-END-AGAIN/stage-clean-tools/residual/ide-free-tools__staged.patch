+/// 🏭️ Builds the production server for one repository and one profile.
+pub fn repository_server(repository: impl Repository + 'static, profile: Profile, limits: Limits) -> Result<Server, Error> {
+    let repository: Arc<dyn Repository> = Arc::new(repository);
+    let mut server = Server::new(Config {
+        server_name: profile.server_name().to_string(),
+        server_version: "1.0.0".to_string(),
+        instructions: "Use repository tools and resources through their owned schemas. Build, test and inspect through the build tools (run, test, run_many, affected, show_projects, graph, leases_status, capacity_status, cache_status, ...): each maps one to one onto an operation of the tool-neutral repo catalogue (repo run <project>:<target>, repo tools setup all, ...), returns a structured result, reports progress and stops when cancelled, so never start the underlying build tools yourself. The build policy chooses the default build tool; select another with the tool argument (--tool=nx|bazel) and read the tool from the result. Nested tasks inherit SEMIO_BUILD_TOOL. Pass agent to attribute leases, capacity grants and cache lanes to one agent; queries read the sealed graph (graph_policy=current) and never wait for a rebuild; pass language=en|de, no language is assumed. Deutsch: Bauen, Testen und Untersuchen laufen ueber die Build-Werkzeuge (run, test, run_many, affected, show_projects, graph, leases_status, capacity_status, cache_status, ...): jedes bildet genau eine Operation des werkzeugneutralen repo-Katalogs ab, liefert ein strukturiertes Ergebnis, meldet Fortschritt und endet bei Abbruch; die zugrunde liegenden Build-Werkzeuge nie selbst starten. Die Build-Policy waehlt das Standardwerkzeug; ein anderes waehlt das Argument tool (--tool=nx|bazel), das ausgefuehrte Werkzeug steht im Ergebnis. Mit agent werden Leases, Kapazitaetszusagen und Cache-Bahnen einem Agenten zugeordnet; Abfragen lesen den versiegelten Graphen (graph_policy=current) und warten nie auf einen Neuaufbau; language=en|de angeben, es wird keine Sprache angenommen.".to_string(),
+        limits,
+    })?;
+    for schema in tool_schemas(profile) {
+        let name = schema.name.clone();
+        let declared = schema.output_schema.is_some();
+        let owned = Arc::clone(&repository);
+        server.register_tool(
+            schema,
+            Box::new(move |context, params, progress| {
+                progress.report(context, 0.0, None, "started").map_err(|_| HandlerError::tool("progress failed"))?;
+                let result = owned.call(context, &name, &params.arguments)?;
+                progress.report(context, 1.0, None, "completed").map_err(|_| HandlerError::tool("progress failed"))?;
+                Ok(CallToolResult { content: vec![Content::text(&result.text)], structured_content: result.structured, is_error: result.is_error, output_schema_declared: declared })
+            }),
+        )?;
+    }
+    for schema in resource_schemas(profile) {
+        let uri = schema.uri.clone();
+        let owned = Arc::clone(&repository);
+        server.register_resource(
+            schema,
+            Box::new(move |context, _requested, progress| {
+                progress.report(context, 0.0, None, "started").map_err(|_| HandlerError::tool("progress failed"))?;
+                Ok(vec![owned.read(context, &uri)?])
+            }),
+        )?;
+    }
+    for schema in prompt_schemas(profile) {
+        let name = schema.name.clone();
+        let owned = Arc::clone(&repository);
+        server.register_prompt(schema, Box::new(move |context, _requested, arguments| owned.prompt(context, &name, arguments)))?;
+    }
+    Ok(server)
+}
