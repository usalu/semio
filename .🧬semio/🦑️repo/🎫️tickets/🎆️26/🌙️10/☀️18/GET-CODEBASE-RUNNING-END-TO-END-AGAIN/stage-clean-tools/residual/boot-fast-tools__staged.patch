+const jsonSchemaSubsetLinearPatterns: ReadonlyMap<string, string> = new Map([[String.raw`^(?!/)(?!.*(?:^|/)\.\.(?:/|$))(?!.*\\)(?!.*\u0000).+$`, String.raw`^(?=[^\n\r\u2028\u2029])(?!/)(?:(?!\.\.(?:/|$))[^/\\\u0000\n\r\u2028\u2029]*(?:/|$))+$`]]);
