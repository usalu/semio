+  const ours=model(fixture.designs[name]),python=spawnSync("python3",["-I",resolve(import.meta.dir,"./🐍️oracle.py"),resolve(import.meta.dir,"./🧫️fixtures/🔣️.json"),name],{encoding:"utf8"});
