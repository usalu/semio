modules/⚠️diagnostic/📦️packages/🦀️rust\" }\nsemio-framework-dsl = { path = \"../../../../../../🔨️modules/🗣️dsl/📦️packages/🦀️rust\" }\nsemio-framework-ui-locale = { path = \"../../../../../../🔨️modules/🖱️ui/🌐️locale/📦️packages/🦀️rust\" }\nsemio-framework-schema-state = { path = \"../../../../../../🔨️modules/🧬️schema/📶️state/📦️packages/🦀️rust\" }\nsemio-framework-schema-composition = { path = \"../../../../../../🔨️modules/🧬️schema/🧩️composition/📦️packages/🦀️rust\" }\nsemio-framework-schema-registry = { path = \"../../../../../../🔨️modules/🧬️schema/📇️registry/📦️packages/🦀️rust\" }\nsemio-framework-2d = { path = \"../../../../../../🔨️modules/◻️2d/📦️packages/🦀️rust\" }\nsemio-framework-value = { path = \"../../../../../../🔨️modules/🌱️value/📦️packages/🦀️rust\" }\nsemio-framework = { path = \"../../../../../../../🧰️framework/📦️packages/🦀️rust\", package = \"semio-framework\" }\nsemio-framework-async = { path = \"../../../../../../../🧰️framework/🔨️modules/⏳️async/📦️packages/🦀️rust\", package = \"semio-framework-async\" }\nsemio-framework-job = { path = \"../../../../../../../🧰️framework/🔨️modules/🧵️job/📦️packages/🦀️rust\", package = \"semio-framework-job\" }\nsemio-framework-job-payload = { path = \"../../../../../../🔨️modules/🧵️job/📬️outcome/📦️builder/📦️packages/🦀️rust\" }\nsemio-framework-actor = { workspace = true }\n# ⏯️ Tool run contract (ticket 26/09/13/INTERACTIVE-TOOLS-VISIBLE-PROCESS lane W0-D): the runtime ledger/driver\n# folds `ToolRunTick`s and publishes one `Edit` at finalize; the pure contract crate never depends back on this one.\nsemio-framework-tool-run = { workspace = true }\n# ⏪️ Non-destructive history editing (ticket 26/09/30/NON-DESTRUCTIVE-HISTORY-EDITING lane W2-A): the per-instance\n# `TimeTravelLedger` drives the pure session reducer; the contract crate never depends back on this one.\nsemio-framework-time-travel = { workspace = true }\n# 🎚️ Continuous controls (ticket 26/09/30/NON-DESTRUCTIVE-HISTORY-EDITING lane W3-T2-CONTROLS): every dispatch carrying a\n# `gesture` rides the window's `ScrubLedger`; the contract crate never depends back on this one.\nsemio-framework-tool-machine = { workspace = true }\n# 🔤️ First-party RFC 4648 §5 base64url codec: the tool run trace delta rides the scene `toolRunTrace` lane as\n# unpadded base64url text (ticket 26/09/13/INTERACTIVE-TOOLS-VISIBLE-PROCESS lane W0-H).\nbase64_codec = { path = \"../../../../../../🔨️modules/🚪️io/🔤️base64/📦️packages/🦀️rust\", package = \"semio-framework-io-base64\" }\n# ⏱️ `runtime_live_cleanup_pump`/`runtime_callback_clock_elapsed` judge each maintenance step against\n# the interactive-step contract, which this crate calls directly as `semio_framework_trace::…`. The\n# call site landed without the manifest edge, so every build of this crate failed on an unlinked crate.\nsemio-framework-trace = { workspace = true }\nsemio-framework-hash = { path = \"../../../../../../../🧰️framework/🔨️modules/🔏️hash/📦️packages/🦀️rust\", package = \"semio-framework-hash\" }\n# 🗃️ MICROKERNEL-POOLED-ACTOR-PLUGIN-RUNTIME (sdk-dedyn, O1): `#[dyn_enum]` on `trait PluginApp` —\n# each fleet plugin crate closes its own per-plugin app enum via `dyn_enum_close!` (cross-crate,\n# see 📓️terra-dyn-enum-macro-report.md's recipe §5).\nsemio-framework-dispatch-macros = { path = \"../../../../../../../🧰️framework/🔨️modules/🔀️dispatch/📦️packages/🦀️rust\", package = \"semio-framework-dispatch-macros\" }\nsemio-framework-os-kernel = { path = \"../../../../📦️packages/🦀️rust\", package = \"semio-framework-os-kernel\" }\n# 🧩️ UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM (C1): `ArtifactChildren`'s `slots() -> &'static\n# [ChildSlotSpec]` needs the real `ChildSlotSpec`/ `ArtifactCompositionFields` types A2 landed in\n# this crate — not otherwise reachable from `semio-framework-plugin` (`semio-framework` itself does\n# not depend on `semio-framework-schema`). No cycle: `semio-framework-schema` depends only on\n# `semio-framework-os-kernel` + its own derive crate, never on this crate or `semio-framework`.\nsemio-framework-schema = { path = \"../../../../../../../🧰️framework/🔨️modules/🧬️schema/📦️packages/🦀️rust\", package = \"semio-framework-schema\" }\n# 🧬️ The semantic UI contract and its headless runtime replace `ui_wgpu`'s node types here: both are\n# dependency-light (serde + styling tokens) and compile for wasm32-wasip2, where the old dependency\n# dragged a whole render engine into every guest.\n# 📐️ The renderer-neutral layout contract owns context-menu requests, window engagements, window\n# measures and the framework body keys the instance, reactor and declarations name directly.\nsemio-framework-ui-layout = { path = \"../../../../../../🔨️modules/🖱️ui/📜️declaration/📐️layout/📦️packages/🦀️rust\" }\n# 📜️ The renderer-independent declaration crate owns `SurfaceKind` (the window surface-kind bridge), the world3d scene\n# JSON helpers, table cells, tree actions and inspector helpers this crate uses and re-exports.\nsemio-framework-ui-declaration = { path = \"../../../../../../🔨️modules/🖱️ui/📜️declaration/📦️packages/🦀️rust\" }\nsemio_framework_ui_contract = { path = \"../../../../../../🔨️modules/🖱️ui/🧬️contract/📦️packages/🦀️rust\", package = \"semio-framework-ui-contract\" }\nsemio_framework_ui_runtime = { path = \"../../../../../../🔨️modules/🖱️ui/🧠️runtime/📦️packages/🦀️rust\", package = \"semio-framework-ui-runtime\" }\n# 🧬️ M2 fallout (ticket 26/08/17 `design-unified.md`, terra-sdk-wire): the `scene-surface` packet\n# relocated the 15 product scene structs (`TableScene`, `World3dScene`, …) plus their helpers\n# (`world3d_default_selection_json`) out of `ui_wgpu::wgpu` into this new crate — `ui_wgpu` no\n# longer re-exports them, so this SDK needs the dependency directly to keep compiling.\nsemio_framework_ui_scene = { path = \"../../../../../../🔨️modules/🖱️ui/🎬️scene/📦️packages/🦀️rust\", package = \"semio-framework-ui-scene\" }\nserde = { version = \"1.0.219\", features = [\"derive\"] }\nserde_json = \"1.0.140\"\n# 🪶️ RUNTIME-DEPENDENCY-ELIMINATION-FOR-S-PLUGINS-AND-ARTIFACTS (26/09/01): default features drop\n# `bitflags` — `world actor`'s WIT (`🧬️schema/*.wit`) declares no `flags` type, so wit-bindgen's\n# generated code never calls into it; confirmed dead (one leftover generic-instantiation symbol,\n# no real function) in the built `.wasm` before this change. `async`/`std`/`realloc`/`macro-string`\n# stay: `poll` is `async func` in the WIT and genuinely exercises `wit_bindgen::rt::async_support`\n# (266 distinct linked symbols observed in a built component). See\n# `🔍️research/📓️wit-bindgen-guest-surface.md`.\nwit-bindgen = { version = \"0.57.1\", default-features = false, features = [\"macros\", \"realloc\", \"async\", \"std\", \"macro-string\"] }\n# 🌱️ RUNTIME-DEPENDENCY-ELIMINATION-FOR-S-PLUGINS-AND-ARTIFACTS (26/09/01): `ArtifactApp::Snapshot`/\n# `Config`/`Draft`/`Presence`/`Transient` now bound on `ToValue`/`FromValue` instead of\n# `Serialize`/`DeserializeOwned` (`../../📦️packages/🦀️rust/🦀️.rs`'s trait definitions). Promoted from\n# `[dev-dependencies]` because the crate's own production defaults (`NoConfig`/`NoPresence`/\n# `NoTransient`, `crate::local_interaction`'s `InteractionConfigMutation`) derive `ToValue`/\n# `FromValue` directly now, not only the test fixtures.\nsemio-framework-value-derive = { path = \"../../../../../../../🧰️framework/🔨️modules/🌱️value/✨️derive/📦️packages/🦀️rust\", package = \"semio-framework-value-derive\" }\n\n# 🧭️ Transitional carve targets of the crate partition of this crate (PLAN-PLUGIN-CRATES.md, section 12.5): the work package that carves a module replaces its mount in `🪝️mounts` by `extern crate <crate> as <module>;`; phase 2 of WP0 prunes this block to the facade re-exports.\nsemio-framework-plugin-abi = { path = \"../../🚪️io/📦️packages/🦀️rust\" }\nsemio-framework-plugin-actor-host = { path = \"../../🌐host/📦️packages/🦀️rust\" }\nsemio-framework-plugin-identity = { path = \"../../🪪️identity/📦️packages/🦀️rust\" }\nsemio-framework-plugin-interaction = { path = \"../../🕹️i