 }\n\n        #[derive(Clone, Debug, Default)]\n        #[allow(dead_code, reason = \"grammar-smoke-test invocations never construct this — see comment above\")]\n        $visibility struct $builder($crate::__private::semio_framework_plugin_abi::DerivedArtifactBuilder<$spec>);\n\n        impl $crate::__private::semio_framework_plugin_abi::ArtifactBuilder for $builder {\n            type Snapshot = <$spec as $crate::__private::semio_framework_plugin_abi::DerivedArtifactSpec>::Snapshot;\n            type Mutation = <$spec as $crate::__private::semio_framework_plugin_abi::DerivedArtifactSpec>::Mutation;\n            type Diff = <$spec as $crate::__private::semio_framework_plugin_abi::DerivedArtifactSpec>::Diff;\n\n            fn empty() -> Self { Self(<$crate::__private::semio_framework_plugin_abi::DerivedArtifactBuilder<$spec> as $crate::__private::semio_framework_plugin_abi::ArtifactBuilder>::empty()) }\n            fn from_snapshot(snapshot: Self::Snapshot) -> Self { Self(<$crate::__private::semio_framework_plugin_abi::DerivedArtifactBuilder<$spec> as $crate::__private::semio_framework_plugin_abi::ArtifactBuilder>::from_snapshot(snapshot)) }\n            fn from_text(text: &str) -> Result<Self, $crate::__private::semio_framework_diagnostic::TextError> { Ok(Self(<$crate::__private::semio_framework_plugin_abi::DerivedArtifactBuilder<$spec> as $crate::__private::semio_framework_plugin_abi::ArtifactBuilder>::from_text(text)?)) }\n            fn from_binary(bytes: &[u8]) -> Result<Self, store::PackError> { Ok(Self(<$crate::__private::semio_framework_plugin_abi::DerivedArtifactBuilder<$spec> as $crate::__private::semio_framework_plugin_abi::ArtifactBuilder>::from_binary(bytes)?)) }\n            fn mutate(self, mutation: Self::Mutation) -> (Self, protocol::MutationOutcome<Self::Diff>) { let (builder, outcome) = <$crate::__private::semio_framework_plugin_abi::DerivedArtifactBuilder<$spec> as $crate::__private::semio_framework_plugin_abi::ArtifactBuilder>::mutate(self.0, mut