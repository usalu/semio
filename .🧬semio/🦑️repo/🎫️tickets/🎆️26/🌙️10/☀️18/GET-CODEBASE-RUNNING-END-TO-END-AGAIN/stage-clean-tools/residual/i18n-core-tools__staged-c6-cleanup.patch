+const LANGUAGE_NEUTRAL: readonly string[] = ["command-contract.clean-taxonomy-apply-build-owners", "command-contract.clean-taxonomy-apply-state-moves", "command-contract.clean-taxonomy-clean-errors-warnings", "command-contract.clean-taxonomy-inventory-entries-source", "command-contract.clean-taxonomy-plan-unresolved-digest", "command-contract.clean-taxonomy-progress", "command.clean-coverage", "command.clean-coverage-removals", "command.clean-empty-folders", "command.clean-empty-folders-removals-bytes", "command.clean-marker-only-folders", "command.clean-marker-only-folders-removals", "mutation.clean-taxonomy-apply-kind-state", "mutation.clean-taxonomy-inventory-kind-roots", "mutation.clean-taxonomy-kind-clean-errors", "mutation.clean-taxonomy-plan-kind-moves"];
+const owner = join(import.meta.dir, "..", "../..");
+const sources = (directory: string): string[] => readdirSync(directory, { withFileTypes: true }).flatMap((entry) => entry.isDirectory() ? (["🧪️tests", "📖️texts", "node_modules", ".cache"].includes(entry.name) ? [] : sources(join(directory, entry.name))) : /\.(?:ts|mjs)$/u.test(entry.name) ? [join(directory, entry.name)] : []);
