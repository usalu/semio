+/** 🚦️ Admits at most one durable storage recheck per interval and always settles the completion phase. */
+export function storageRecheckGateV1(intervalMilliseconds:number,now:()=>number,recheck:()=>Promise<void>):(phase:CargoSourceAdmissionRecheckPhaseV1)=>Promise<void>{let last:number|undefined;return async phase=>{if(phase!=="complete"&&last!==undefined&&now()-last<intervalMilliseconds)return;await recheck();last=now();};}
+/** 🔌️ Observes actual compiler cfg and no-follow source bytes without executing a compilation unit. */
+export function actualCargoSourceAdmissionPortV1(environment:Readonly<Record<string,string|undefined>>,cwd:string,storage:NativeStorageReservationV1,now:()=>number=()=>performance.now()):CargoSourceAdmissionPortV1{const cfgs=new Map<string,Promise<readonly string[]>>(),gate=storageRecheckGateV1(schema.definitions.storageRecheck.const.intervalMilliseconds,now,()=>storage.recheck());return{async recheck(control,phase){requireNativeStorageReservationV1(storage,control);await gate(phase);},async cfg(unit,control){requireNativeStorageReservationV1(storage,control);const args=["--print","cfg",...unit.compilerArguments,...unit.compilerFlags,...unit.features.flatMap(feature=>["--cfg","feature="+JSON.stringify(feature)])];if(unit.platform!==null)args.push("--target",unit.platform);if(unit.kind==="proc-macro")args.push("--crate-type=proc-macro");if(unit.kind==="test")args.push("--test");const key=JSON.stringify(args);let pending=cfgs.get(key);if(!pending){pending=captureOwnedCommandV1("rustc",args,cwd,{control,env:rustCompilerExecutionEnvironmentV1(environment),output:{maximumBytes:1048576,maximumLines:65536}}).then(text=>Object.freeze(text.trim().split("\n").map(value=>value.replace(/=(".*")$/u,(_,quoted)=>"="+JSON.parse(quoted)))));cfgs.set(key,pending);pending.catch(()=>{if(cfgs.get(key)===pending)cfgs.delete(key);});}return[...await pending];},async read(path,control,request){requireNativeStorageReservationV1(storage,control);return readPhysicalCargoSourceV1(path,request,control);}};}
