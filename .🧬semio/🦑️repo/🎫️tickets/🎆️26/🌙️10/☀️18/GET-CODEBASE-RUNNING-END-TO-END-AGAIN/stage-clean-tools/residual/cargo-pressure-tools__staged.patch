+/** 🔌️ Observes actual compiler cfg and no-follow source bytes without executing a compilation unit. */
+export function actualCargoSourceAdmissionPortV1(environment:Readonly<Record<string,string|undefined>>,cwd:string,storage:NativeStorageReservationV1):CargoSourceAdmissionPortV1{return{async cfg(unit,control){requireNativeStorageReservationV1(storage,control);await storage.recheck();const args=["--print","cfg",...unit.compilerArguments,...unit.compilerFlags,...unit.features.flatMap(feature=>["--cfg","feature="+JSON.stringify(feature)])];if(unit.platform!==null)args.push("--target",unit.platform);if(unit.kind==="proc-macro")args.push("--crate-type=proc-macro");if(unit.kind==="test")args.push("--test");const text=await captureOwnedCommandV1("rustc",args,cwd,{control,env:rustCompilerExecutionEnvironmentV1(environment),output:{maximumBytes:1048576,maximumLines:65536}});return text.trim().split("\n").map(value=>value.replace(/=(".*")$/u,(_,quoted)=>"="+JSON.parse(quoted)));},async read(path,control,request){requireNativeStorageReservationV1(storage,control);await storage.recheck();const bytes=await readPhysicalCargoSourceV1(path,request,control);await storage.recheck();return bytes;}};}
