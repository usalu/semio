+import {createHash} from "node:crypto";
+import schema from "./affected-schema.json" with {type:"json"};
+import {validateJsonSchemaSubset} from "../../../../../../../../../🧰️framework/🔨️modules/🧬️schema/✅️validator/📦️packages/🟦️typescript/🟦️.ts";
