+import {bazelCommandPlanV1,bazelTestActionV1,bazelTestTargetV1,bazelTestWithinLimitV1} from "./commands.ts";
+import schema from "./commands-schema.json" with {type:"json"};
+import fixture from "./commands-fixture.json" with {type:"json"};
+
+const ajv=new Ajv({strict:true,allowUnionTypes:true}),compile=(definition:string)=>ajv.compile({$schema:schema.$schema,definitions:schema.definitions,$ref:`#/definitions/${definition}`}),input=compile("Input"),plan=compile("Plan"),action=compile("TestAction");
+
+test("the fixture and the schema agree with Ajv, and every refused input is refused by both validators",()=>{
+ expect(ajv.validateSchema(schema)).toBe(true);
+ for(const row of fixture.cases){expect(input(row.input),row.name).toBe(true);expect(plan(row.expected),row.name).toBe(true);}
+ for(const row of fixture.refused){expect(input(row.input),row.name).toBe(false);expect(validateJsonSchemaSubset(schema.definitions.Input,row.input,schema).length>0,row.name).toBe(true);expect(()=>bazelCommandPlanV1(row.input as never),row.name).toThrow("Closed Bazel command input required");}
+ for(const row of fixture.classification)expect(action({target:row.target,cache:row.cache,outputs:row.outputs,dependents:row.dependents}),row.target).toBe(true);
+ expect(schema.definitions.Operations.const.map(row=>row.operation)).toEqual(["run","run-many","affected","exec","watch","graph","show","cache-status","cache-clear"]);
+ expect(schema.definitions.Policy.const.sharding).toBe("unsupported");
+});
+
+test("every fixture case maps to exactly its authored Bazel invocation",()=>{
+ for(const row of fixture.cases)expect(bazelCommandPlanV1(row.input as never),row.name).toEqual(row.expected as never);
+});
+
+test("test actions are classified by the authored table",()=>{
+ for(const row of fixture.classification){const facts={target:row.target,cache:row.cache,outputs:row.outputs,dependents:row.dependents};expect(bazelTestActionV1(facts),row.target).toBe(row.expected);}
+ expect(bazelTestTargetV1("test-snapshot-sqlite")).toBe(true);
+ expect(bazelTestTargetV1("contest")).toBe(false);
