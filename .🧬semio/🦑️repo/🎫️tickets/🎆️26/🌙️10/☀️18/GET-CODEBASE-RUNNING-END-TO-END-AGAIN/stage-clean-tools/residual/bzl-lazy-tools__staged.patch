+  for(const row of fixture.cases){
+   const{events,...rest}=row.input as {events?:string},mapped=bazelCommandPlanV1({...rest,mode:"execute",base:[`--disk_cache=${disk}`],...events?{events:join(directory,"events.json")}:{}} as never);
