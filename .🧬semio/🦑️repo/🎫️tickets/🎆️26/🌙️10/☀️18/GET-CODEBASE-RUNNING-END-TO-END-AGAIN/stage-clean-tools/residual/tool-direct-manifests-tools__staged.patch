+        found.push([at + 1, value, "line"]);
+      });
+    } else if (kind.extractor === "bazel") {
+      const keys = (kind.keys ?? []).map(escape).join("|");
+      for (const match of text.matchAll(new RegExp(`(?:${keys})\\s*=\\s*("""|'''|"|')([\\s\\S]*?)\\1`, "gu"))) found.push([lineAt(text, match.index), match[2]!, "line"]);
