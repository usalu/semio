+  if(!spec.cold&&envDigest!==spec.previousEnv)for(const owner of owners)if(!fullNames.has(owner.name)){signal?.throwIfAborted();extra.push(await inferOwner(dir,owner,owners));edgeOnly.push({name:owner.name});}
