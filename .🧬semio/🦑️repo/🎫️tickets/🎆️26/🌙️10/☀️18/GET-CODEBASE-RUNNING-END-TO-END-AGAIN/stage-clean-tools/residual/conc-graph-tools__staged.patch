+  const capture=[...inferred,...extra].flatMap(row=>row.rows);
+  return{
+   owners:inferred.map(row=>({name:row.name,root:row.root,config:row.config,...(row.kind==="unavailable"?{unavailable:row.node}:{node:row.node}),nodeRows:row.rows})),
