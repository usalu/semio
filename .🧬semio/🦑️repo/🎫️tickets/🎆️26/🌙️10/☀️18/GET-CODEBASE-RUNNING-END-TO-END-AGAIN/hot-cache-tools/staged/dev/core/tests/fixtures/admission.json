{
 "version": 1,
 "description": "Language-agnostic corpus of the service invocation admission: symbolic requests with the decision every implementation must reach. @root, @outside, @other-worktree and @worktree stand for the paths and the id of the test worktrees, {\"@now\":n} for the clock plus n milliseconds. Tokens are minted by the test from the symbolic description; the reference decision of oracle.py is computed independently of the expectations stored here.",
 "clock": 1000000,
 "requests": [
  {
   "name": "a genuine token",
   "token": {
    "kind": "genuine"
   },
   "expect": "ok"
  },
  {
   "name": "a genuine token with narrower scope still containing run",
   "token": {
    "kind": "genuine",
    "attenuate": [
     {
      "k": "scope",
      "v": [
       "run",
       "status"
      ]
     }
    ]
   },
   "expect": "ok"
  },
  {
   "name": "a project caveat that names the project",
   "token": {
    "kind": "genuine",
    "attenuate": [
     {
      "k": "projects",
      "v": [
       "app"
      ]
     }
    ]
   },
   "expect": "ok"
  },
  {
   "name": "a project caveat with a prefix",
   "token": {
    "kind": "genuine",
    "attenuate": [
     {
      "k": "projects",
      "v": [
       "ap*"
      ]
     }
    ]
   },
   "expect": "ok"
  },
  {
   "name": "a directory caveat above the directory",
   "token": {
    "kind": "genuine",
    "attenuate": [
     {
      "k": "cwd",
      "v": "@root/pkgs"
     }
    ]
   },
   "expect": "ok"
  },
  {
   "name": "empty token",
   "token": {
    "kind": "empty"
   },
   "expect": "token"
  },
  {
   "name": "garbage token",
   "token": {
    "kind": "garbage"
   },
   "expect": "token"
  },
  {
   "name": "forged MAC",
   "token": {
    "kind": "forged-mac"
   },
   "expect": "token"
  },
  {
   "name": "widened payload under the old MAC",
   "token": {
    "kind": "tampered-scope"
   },
   "expect": "token"
  },
  {
   "name": "dropped expiry under the old MAC",
   "token": {
    "kind": "tampered-expiry"
   },
   "expect": "token"
  },
  {
   "name": "token of another key",
   "token": {
    "kind": "other-key"
   },
   "expect": "token"
  },
  {
   "name": "expired",
   "token": {
    "kind": "genuine",
    "extra": [
     {
      "k": "notAfter",
      "v": {
       "@now": -1
      }
     }
    ]
   },
   "expect": "expired"
  },
  {
   "name": "expired a millisecond ago in a long token",
   "token": {
    "kind": "genuine",
    "extra": [
     {
      "k": "notAfter",
      "v": {
       "@now": -1
      }
     }
    ],
    "attenuate": [
     {
      "k": "notAfter",
      "v": {
       "@now": 3600000
      }
     }
    ]
   },
   "expect": "expired"
  },
  {
   "name": "no expiry",
   "token": {
    "kind": "genuine",
    "drop": [
     "notAfter"
    ]
   },
   "expect": "caveats"
  },
  {
   "name": "no worktree",
   "token": {
    "kind": "genuine",
    "drop": [
     "worktree"
    ]
   },
   "expect": "caveats"
  },
  {
   "name": "no agent",
   "token": {
    "kind": "genuine",
    "drop": [
     "agent"
    ]
   },
   "expect": "caveats"
  },
  {
   "name": "no scope",
   "token": {
    "kind": "genuine",
    "drop": [
     "scope"
    ]
   },
   "expect": "caveats"
  },
  {
   "name": "lifetime beyond the authored maximum",
   "token": {
    "kind": "genuine",
    "drop": [
     "notAfter"
    ],
    "extra": [
     {
      "k": "notAfter",
      "v": {
       "@now": 90000000
      }
     }
    ]
   },
   "expect": "unbounded"
  },
  {
