{
  "schema": "semio.repo.mcp.entrypoint/1",
  "profileEnvironment": "SEMIO_REPO_MCP_CLIENT",
  "arguments": ["mcp"],
  "protocolVersions": [
    "2025-11-25",
    "2025-06-18",
    "2025-03-26",
    "2024-11-05",
    "2024-10-07"
  ],
  "profiles": [
    {
      "slug": "client",
      "kind": "generic",
      "serverName": "repo"
    },
    {
      "slug": "cursor",
      "kind": "cursor",
      "serverName": "repo"
    },
    {
      "slug": "kiro",
      "kind": "kiro",
      "serverName": "repo"
    },
    {
      "slug": "copilot",
      "kind": "copilot",
      "serverName": "repo"
    },
    {
      "slug": "claude",
      "kind": "claude",
      "serverName": "repo"
    },
    {
      "slug": "codex",
      "kind": "codex",
      "serverName": "repo"
    }
  ],
  "flow": [
    "initialize",
    "notifications/initialized",
    "resources/list",
    "resources/read:repo://goals",
    "tools/list",
    "tools/call"
  ],
  "buildInstructions": [
    "repo run",
    "repo tools setup",
    "--tool=nx|bazel",
    "The build policy chooses the default build tool",
    "never start the underlying build tools yourself",
    "Deutsch:"
  ],
  "resourceContents": [
    {
      "uri": "repo://goals",
      "mimeType": "text/plain",
      "text": ""
    },
    {
      "uri": "repo://goals",
      "mimeType": "text/plain",
      "text": "Goals"
    },
    {
      "uri": "repo://binary",
      "mimeType": "application/octet-stream",
      "blob": "AQI="
    }
  ],
  "reopenPrompt": {
    "invalid": [
      null,
      "",
      " ",
      "\t\n"
    ],
    "valid": [
      "Continue the ticket",
      " Weiterarbeiten "
    ]
  }
}
