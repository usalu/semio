{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:laws/raw-process-spawn/allowlist",
  "title": "Raw process spawn allowlist",
  "description": "Language-agnostic data of the raw-process-spawn law: which calls start a process, which modules are the interface that may start processes, and the documented exceptions. Both the TypeScript law and the independent Python checker read this document and the tool registry; neither shares code with the other.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "roots",
    "processModules",
    "extraCallees",
    "commandFunnels",
    "interfaces",
    "exceptions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "processModules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extraCallees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "language",
          "shape"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "ts",
              "rust",
              "go",
              "python"
            ]
          },
          "shape": {
            "enum": [
              "command",
              "array",
              "shell-string",
              "template",
              "optionsCmd"
            ]
          },
          "imported": {
            "type": "boolean"
          }
        }
      }
    },
    "commandFunnels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "language",
          "argument"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "ts",
              "rust",
              "go",
              "python"
            ]
          },
          "argument": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "glob",
          "kind",
          "reason"
        ],
        "properties": {
          "glob": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "runtime-port",
              "launcher",
              "process-funnel",
              "terminal-host",
              "plugin-host",
              "process-control"
            ]
          },
          "reason": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "program",
          "count",
          "class",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "program": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "class": {
            "enum": [
              "os-primitive",
              "generic-runner",
              "declared-command",
              "own-executable",
              "injected-port",
              "shell-host",
              "terminal-host",
              "plugin-host",
              "pending-route",
              "layer-below-registry"
            ]
          },
          "reason": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "de"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
