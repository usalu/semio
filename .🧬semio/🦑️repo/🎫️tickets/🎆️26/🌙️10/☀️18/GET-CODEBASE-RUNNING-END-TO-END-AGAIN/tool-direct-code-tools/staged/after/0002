{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:process/tools/registry",
  "title": "External tool registry",
  "description": "Every external program the repository may run, the one pin, provisioning recipe, adapter and caller set of each. Code never names a registered program; it asks `runToolV1(toolId, args, options)`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "languages", "partitions", "packageRoots", "environment", "scan", "messages", "tools"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "languages": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["en", "de"]}},
    "partitions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "packageRoots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "testCallers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "funnels": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "marker"], "properties": {"path": {"type": "string", "minLength": 1}, "marker": {"type": "string", "minLength": 1}}}},
    "environment": {"$ref": "#/definitions/GlobalEnvironment"},
    "scan": {"$ref": "#/definitions/Scan"},
    "messages": {"$ref": "#/definitions/Messages"},
    "tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Tool"}}
  },
  "definitions": {
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {"en": {"type": "string", "minLength": 1}, "de": {"type": "string", "minLength": 1}}
    },
    "Id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "Glob": {"type": "string", "minLength": 1},
    "Platform": {"enum": ["win32", "darwin", "linux"]},
    "GlobalEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "deny"],
      "properties": {
        "base": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "deny": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "Scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callees", "shellWrappers", "selfExpressions", "testSegments", "ignoredSegments", "extensions", "declaredNames"],
      "properties": {
        "callees": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "language", "shape"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "language": {"enum": ["ts", "rust", "go", "python"]},
              "shape": {"enum": ["command", "array", "shell-string", "template", "optionsCmd"]}
            }
          }
        },
        "shellWrappers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "selfExpressions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "testSegments": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ignoredSegments": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "extensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ts", "rust", "go", "python", "shell"],
          "properties": {
            "ts": {"type": "array", "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
            "rust": {"type": "array", "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
            "go": {"type": "array", "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
            "python": {"type": "array", "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}},
            "shell": {"type": "array", "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}}
          }
        },
        "declaredNames": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "Messages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknownTool", "toolMissing", "callerRefused", "cancelled", "failed", "execUsage", "listHeader", "admitting", "running", "finished"],
      "properties": {
        "unknownTool": {"$ref": "#/definitions/Text"},
        "toolMissing": {"$ref": "#/definitions/Text"},
        "callerRefused": {"$ref": "#/definitions/Text"},
        "cancelled": {"$ref": "#/definitions/Text"},
        "failed": {"$ref": "#/definitions/Text"},
        "execUsage": {"$ref": "#/definitions/Text"},
        "listHeader": {"$ref": "#/definitions/Text"},
        "admitting": {"$ref": "#/definitions/Text"},
        "running": {"$ref": "#/definitions/Text"},
        "finished": {"$ref": "#/definitions/Text"}
      }
    },
    "RowFilter": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "Source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "format", "pointer"],
          "properties": {"file": {"type": "string", "minLength": 1}, "format": {"const": "json"}, "pointer": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "format", "table", "key"],
          "properties": {"file": {"type": "string", "minLength": 1}, "format": {"const": "toml"}, "table": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "format"],
          "properties": {"file": {"type": "string", "minLength": 1}, "format": {"const": "text"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "format", "pointer", "where", "field"],
          "properties": {"file": {"type": "string", "minLength": 1}, "format": {"const": "rows"}, "pointer": {"type": "string"}, "where": {"$ref": "#/definitions/RowFilter"}, "field": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "Digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "pointer", "where", "sha256", "name"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "pointer": {"type": "string"},
        "where": {"$ref": "#/definitions/RowFilter"},
        "platform": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "bytes": {"type": "string", "minLength": 1},
        "extras": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "hostExtras": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
      }
    },
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["pinned", "constrained", "floating", "system", "internal"]},
        "version": {"$ref": "#/definitions/Source"},
        "minimum": {"$ref": "#/definitions/Source"},
        "digests": {"$ref": "#/definitions/Digests"},
        "gap": {"$ref": "#/definitions/Text"}
      }
    },
    "Provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command"],
      "properties": {
        "kind": {"enum": ["internal", "bootstrap-asset", "release-archive", "package", "toolchain-file", "system", "source-build"]},
        "installer": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"darwin": {"type": "string"}, "linux": {"type": "string"}, "win32": {"type": "string"}}
        }
      }
    },
    "Locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {"kind": {"const": "environment"}, "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "runtime"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "partition", "segments", "executable"],
          "properties": {
            "kind": {"const": "provisioned"},
            "partition": {"type": "string", "minLength": 1},
            "segments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "executable": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "package", "script", "via"],
          "properties": {
            "kind": {"const": "package-script"},
            "package": {"type": "string", "minLength": 1},
            "script": {"type": "string", "minLength": 1},
            "via": {"$ref": "#/definitions/Id"},
            "prefix": {"type": "array", "items": {"type": "string"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "via"],
          "properties": {
            "kind": {"const": "script"},
            "path": {"type": "string", "minLength": 1},
            "via": {"$ref": "#/definitions/Id"},
            "prefix": {"type": "array", "items": {"type": "string"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "directories"],
          "properties": {"kind": {"const": "path"}, "directories": {"type": "array", "items": {"type": "string", "minLength": 1}}, "names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "Probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arguments", "pattern"],
      "properties": {"arguments": {"type": "array", "items": {"type": "string"}}, "pattern": {"type": "string", "minLength": 1}}
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "pass", "deny", "set"],
      "properties": {
        "mode": {"enum": ["inherit", "allowlist"]},
        "pass": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "deny": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "set": {"type": "object", "additionalProperties": {"type": "string"}},
        "cacheDirectories": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
      }
    },
    "Capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "inherit", "admit"]},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "kind": {"enum": ["test", "check", "generate", "build", "script", "service"]}
      }
    },
    "Tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "capabilities", "commands", "platforms", "pin", "provision", "locate", "adapter", "adapterScope", "allowedCallers", "environment", "capacity"],
      "properties": {
        "id": {"$ref": "#/definitions/Id"},
        "kind": {"enum": ["entry", "runtime", "build-system", "compiler", "package-manager", "test-runner", "typesetter", "optimizer", "vcs", "container", "disk-image", "bundler", "file-watcher", "archiver", "media-encoder"]},
        "summary": {"$ref": "#/definitions/Text"},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/Id"}},
        "commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/Platform"}},
        "pin": {"$ref": "#/definitions/Pin"},
        "provision": {"$ref": "#/definitions/Provision"},
        "locate": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Locator"}},
        "probe": {"$ref": "#/definitions/Probe"},
        "adapter": {"type": "string", "minLength": 1},
        "adapterScope": {"type": "array", "items": {"$ref": "#/definitions/Glob"}},
        "allowedCallers": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Glob"}},
        "environment": {"$ref": "#/definitions/Environment"},
        "capacity": {"$ref": "#/definitions/Capacity"}
      }
    }
  }
}
