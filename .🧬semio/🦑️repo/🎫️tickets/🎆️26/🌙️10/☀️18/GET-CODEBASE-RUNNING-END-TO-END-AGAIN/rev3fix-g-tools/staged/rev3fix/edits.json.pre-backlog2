   "file": "🧰️framework/🔨️modules/🏃️process/🔒️leases/📁️physical/🟦️.ts",
   "old": "  tryLock:()=>{if(library.symbols.flock!(held.at(-1)!.fd,protocol.exclusive|protocol.nonblocking)===0)return true;const pointer=library.symbols[errnoName]!();if(pointer===null||read.i32(pointer)!==protocol.contentionErrno[platform as\"darwin\"|\"linux\"])throw new PhysicalLockErrorV1(\"admission\");return false;},",
   "new": "  tryLock:()=>{for(let attempt=0;attempt<protocol.attempts;attempt++){if(library.symbols.flock!(held.at(-1)!.fd,protocol.exclusive|protocol.nonblocking)===0)return true;const pointer=library.symbols[errnoName]!();if(pointer!==null&&read.i32(pointer)===protocol.contentionErrno[platform as\"darwin\"|\"linux\"])return false;}throw new PhysicalLockErrorV1(\"admission\");},"
  },
  {
   "file": "🧰️framework/🔨️modules/🏃️process/🔒️leases/📁️physical/🟦️.ts",
   "old": "  tryLock:()=>{const row=rows.at(-1)!;if(range(row.handle,win.exclusive|win.failImmediately)!==0){row.locked=true;return true;}const code=Number(symbols.GetLastError!());if(code===win.contentionError)return false;throw new PhysicalLockErrorV1(\"admissionWindows\",code);},",
   "new": "  tryLock:()=>{const row=rows.at(-1)!;let code=0;for(let attempt=0;attempt<schema.definitions.Protocol.const.attempts;attempt++){if(range(row.handle,win.exclusive|win.failImmediately)!==0){row.locked=true;return true;}code=Number(symbols.GetLastError!());if(code===win.contentionError)return false;}throw new PhysicalLockErrorV1(\"admissionWindows\",code);},"
  },
  {
   "file": "🧰️framework/🔨️modules/🏃️process/🔒️leases/📁️physical/🟦️.ts",
   "old": "/** 🧱️ One host's kernel lock mechanism: `retain` opens and identifies a file, `tryLock` takes the exclusive lock on the file retained last (false = another holder),",
   "new": "/** 🧱️ One host's kernel lock mechanism: `retain` opens and identifies a file, `tryLock` takes the exclusive lock on the file retained last (false = another holder; the failure code is read by a second foreign call, so a failure that is not the contention code is repeated up to `Protocol.attempts` times before it is refused),"
  },
  {
