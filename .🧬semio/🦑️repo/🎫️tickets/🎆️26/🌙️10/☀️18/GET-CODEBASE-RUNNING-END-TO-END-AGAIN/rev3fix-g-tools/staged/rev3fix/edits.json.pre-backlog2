  },
  {
   "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/🗃️unit-cache/🧵️lane/📤️retention/🟦️.ts",
   "old": "/** 🔗️ Runs `body` in a held lane, then publishes the lane's provenance",
   "new": "/** 📝️ Records beside a lane which shared ledger receives its receipts, so whoever removes the lane while its holder is gone knows where they belong. Best effort: a lane without the record retains nothing when it is removed. */\nfunction recordDestinationV1(base:string,shared:string):void{\n try{const path=join(base,layout.destination),temporary=path+\".\"+randomBytes(3).toString(\"hex\");writeFileSync(temporary,shared);renameSync(temporary,path);}catch{}\n}\n\n/** 🧹️ The retention of a lane that a trimmer removes while its holder is gone (killed between its body and its own retention): the receipts the lane still holds are published into the shared ledger the holder recorded before the lane goes, so the removal cannot lose the provenance of a build that finished. The caller holds the lane's claim and has seen it idle. A lane without a record, a record that is not an absolute path and a failing retention retain nothing and never block the removal (the pool bound is the hard limit; a killed build is rebuilt by its next run); the names that conflict with the shared ledger are returned.\n * @see ../🏊️pool/🟦️.ts */\nexport function retainRemovedLaneV1(paths:Readonly<{id:string;base:string;build:string}>):readonly string[]{\n let shared:string;try{shared=readFileSync(join(paths.base,layout.destination),\"utf8\");}catch{return[];}\n if(!isAbsolute(shared))return[];\n try{return retainLaneOutputsV1({lane:paths.build,shared,laneId:paths.id,language:\"en\"}).conflicts;}catch{return[];}\n}\n\n/** 🔗️ Runs `body` in a held lane, then publishes the lane's provenance"
  },
  {
   "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/🗃️unit-cache/🧵️lane/📤️retention/🟦️.ts",
   "old": " let value!:T,bodyFailed=false,bodyFailure:unknown,retentionFailed=false,retentionFailure:unknown;\n try{value=await body();}catch(error){bodyFailed=true;bodyFailure=error;}\n try{await retainLaneOutputsV1(",
   "new": " let value!:T,bodyFailed=false,bodyFailure:unknown,retentionFailed=false,retentionFailure:unknown;\n recordDestinationV1(dirname(input.lane.paths.build),input.shared);\n try{value=await body();}catch(error){bodyFailed=true;bodyFailure=error;}\n try{retainLaneOutputsV1("
  },
  {
   "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/🗃️unit-cache/🧵️lane/🟦️.ts",
   "old": "/** 🗑️ Removes a whole lane or only its incremental directories. It takes the lane's own claim first, so it can never race an acquirer, and refuses while the claim is held or a live marker exists. */\nexport function removeLaneV1(root:string,id:string,scope:\"lane\"|\"incremental\",nowMs:number):boolean{",
   "new": "/** 🗑️ Removes a whole lane or only its incremental directories. It takes the lane's own claim first, so it can never race an acquirer, and refuses while the claim is held or a live marker exists; `beforeRemoval` runs for a whole lane under that claim, once the lane is known to be idle and before anything is deleted (the retention of what a holder that is gone left behind). */\nexport function removeLaneV1(root:string,id:string,scope:\"lane\"|\"incremental\",nowMs:number,beforeRemoval?:(paths:ReturnType<typeof lanePathsV1>)=>void):boolean{"
  },
  {
   "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/🗃️unit-cache/🧵️lane/🟦️.ts",
   "old": "  if(scope===\"lane\")rmSync(paths.base,{recursive:true,force:true});else",
   "new": "  if(scope===\"lane\"){beforeRemoval?.(paths);rmSync(paths.base,{recursive:true,force:true});}else"
  },
  {
   "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/🗃️unit-cache/🧵️lane/🏊️pool/🟦️.ts",
   "old": "import {UNIT_CACHE_POLICY_V1} from \"../../🔏️key/🟦️.ts\";\n",
   "new": "import {UNIT_CACHE_POLICY_V1} from \"../../🔏️key/🟦️.ts\";\nimport {retainRemovedLaneV1} from \"../📤️retention/🟦️.ts\";\n"
  },
  {
   "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/🗃️unit-cache/🧵️lane/🏊️pool/🟦️.ts",
   "old": "/** 🧹️ Removes the idle lanes the pool must shed. Every removal takes the lane's own claim first, so a lane that was taken since the plan survives; returns what was removed. */\nexport function trimPoolV1(root:string,bounds:PoolBoundsV1,nowMs:number):Readonly<{removed:number;freedBytes:number}>{\n const lanes=readPoolV1(root,nowMs),size=new Map(lanes.map(lane=>[lane.id,lane.bytes??0]));let removed=0,freedBytes=0;\n for(const id of planPoolTrimV1(lanes,bounds))if(removeLaneV1(root,id,\"lane\",nowMs)){removed++;freedBytes+=size.get(id)!;}",
   "new": "/** 🧹️ Removes the idle lanes the pool must shed. Every removal takes the lane's own claim first, so a lane that was taken since the plan survives, and publishes the receipts a holder that was killed before its own retention left in the lane (see `retainRemovedLaneV1`) before the lane goes; returns what was removed. */\nexport function trimPoolV1(root:string,bounds:PoolBoundsV1,nowMs:number,report?:PoolReportV1):Readonly<{removed:number;freedBytes:number}>{\n const lanes=readPoolV1(root,nowMs),size=new Map(lanes.map(lane=>[lane.id,lane.bytes??0]));let removed=0,freedBytes=0;\n const retain=(paths:ReturnType<typeof lanePathsV1>):void=>{const conflicts=retainRemovedLaneV1(paths);if(conflicts.length)report?.(\"retentionConflict\",{lane:paths.id,count:conflicts.length,names:conflicts.slice(0,4).join(\", \")});};\n for(const id of planPoolTrimV1(lanes,bounds))if(removeLaneV1(root,id,\"lane\",nowMs,retain)){removed++;freedBytes+=size.get(id)!;}"
  },
  {
   "file": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🦀️cargo/🗃️unit-cache/🧵️lane/🏊️pool/🟦️.ts",
   "old": "export type PoolReportV1=(kind:\"overflow\"|\"trimmed\"|\"poolBusy\",",
