{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "link",
    "cargo"
  ],
  "properties": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ignore"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ignore": {
          "type": "string",
          "pattern": "\\n$"
        }
      }
    },
    "cargo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "cases"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CARGO_"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "env",
              "directories",
              "base"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object"
                  }
                ]
              },
              "directories": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "base": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
