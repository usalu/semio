{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cover",
    "transitive",
    "dangling",
    "uncached"
  ],
  "properties": {
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "universe",
        "cases"
      ],
      "properties": {
        "universe": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "selected",
              "extra",
              "groups",
              "loose"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "selected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extra": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "groups": {
                "type": "integer",
                "minimum": 0
              },
              "loose": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "transitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "cases"
      ],
      "properties": {
        "graph": {
          "type": "object"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "project",
              "inputs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "array"
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "oneOf": [
              {
                "required": [
                  "expected"
                ],
                "properties": {
                  "expected": {
                    "type": "array"
                  }
                }
              },
              {
                "required": [
                  "error"
                ],
                "properties": {
                  "error": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "dangling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "expected",
        "refusals",
        "accepted"
      ],
      "properties": {
        "graph": {
          "type": "object"
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "dependency",
              "missing"
            ],
            "properties": {
              "task": {
                "type": "string"
              },
              "dependency": {
                "type": "string"
              },
              "missing": {
                "enum": [
                  "project",
                  "target"
                ]
              }
            }
          }
        },
        "refusals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "dependsOn",
              "message"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "dependsOn": {
                "type": "array"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "accepted": {
          "type": "array",
          "items": {
            "type": "array"
          }
        }
      }
    },
    "uncached": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "request",
        "expected"
      ],
      "properties": {
        "graph": {
          "type": "object"
        },
        "request": {
          "type": "object",
          "required": [
            "tasks"
          ],
          "properties": {
            "tasks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "expected": {
          "type": "object"
        }
      }
    }
  }
}
