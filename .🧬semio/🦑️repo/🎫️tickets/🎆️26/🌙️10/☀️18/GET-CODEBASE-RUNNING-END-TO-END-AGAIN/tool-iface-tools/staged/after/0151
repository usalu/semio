export function scopedGitPathspec(repoRoot: string, scope: string | undefined, taxonomy: LoadedTaxonomy): TaxonomyScopedGitPathspec {
  const exclusions = taxonomy.exclusions.map((entry) => entry.path);
  const candidate = taxonomyScopedGitPathspec(scope, exclusions);
  if (!candidate.normalizedScope || candidate.conservativePrefix === ".") return candidate;
  const segments = candidate.normalizedScope.split("/");
  for (let index = 1; index < segments.length; index++) {
    const ancestor = segments.slice(0, index).join("/");
    const stat = lstatOrNull(absolutePath(repoRoot, ancestor));
    if (stat && (stat.isSymbolicLink() || !stat.isDirectory())) return taxonomyScopedGitPathspec(undefined, exclusions);
    const indexed = spawnToolSyncV1("git", ["rev-parse", "--verify", "--quiet", "--end-of-options", `:${ancestor}`], { cwd: repoRoot, encoding: "utf8" });
    if (indexed.status === 0) return taxonomyScopedGitPathspec(undefined, exclusions);
    if (indexed.status !== 1) throw new Error(`Git index ancestor probe failed for ${ancestor}: ${indexed.stderr.trim() || `exit ${indexed.status ?? "unknown"}`}`);
  }
  return candidate;
}

export function gitRows(repoRoot: string, taxonomy: LoadedTaxonomy, pathspec = taxonomyScopedGitPathspec(undefined, taxonomy.exclusions.map((entry) => entry.path))): readonly CandidatePath[] {
  const stdout = execToolSyncV1("git", ["ls-files", "--stage", "-z", "--", pathspec.positivePathspec, ...pathspec.exclusionPathspecs], { cwd: repoRoot, encoding: "buffer", maxBuffer: 256 * 1024 * 1024 });
  return stdout
    .toString("utf8")
    .split("\u0000")
    .filter(Boolean)
    .map((row) => {
      const tab = row.indexOf("\t");
      const [mode, objectId, stage] = row.slice(0, tab).split(" ");
      if(tab<1||mode===undefined||objectId===undefined||stage===undefined)throw new Error("Exact Git stage header required");
      return { path: sourceRelative(row.slice(tab + 1)), mode, objectId, stage };
    })
    .filter((row) => row.stage === "0")
    .map(({ path, mode, objectId }) => ({ path, mode, objectId }));
}

export function untrackedGitPaths(repoRoot: string, taxonomy: LoadedTaxonomy, pathspec = taxonomyScopedGitPathspec(undefined, taxonomy.exclusions.map((entry) => entry.path))): readonly string[] {
  const stdout = execToolSyncV1("git", ["ls-files", "--others", "--exclude-standard", "-z", "--", pathspec.positivePathspec, ...pathspec.exclusionPathspecs], { cwd: repoRoot, encoding: "buffer", maxBuffer: 256 * 1024 * 1024 });
  return stdout.toString("utf8").split("\u0000").filter(Boolean).map(sourceRelative).sort((a, b) => Buffer.from(a).compare(Buffer.from(b)));
}

function worktreeCandidate(repoRoot: string, path: string): CandidatePath | null {
  const stat = lstatOrNull(absolutePath(repoRoot, path));
  if (!stat) return null;
  if (stat.isSymbolicLink()) return { path, mode: "120000" };
  if (stat.isDirectory()) return { path, mode: "040000", explicitDirectory: true };
  return { path, mode: (stat.mode & 0o111) !== 0 ? "100755" : "100644" };
}

export function explicitTicketRows(repoRoot: string, ticketDir: string | undefined, taxonomy: LoadedTaxonomy, scope?: string, cancelFile?: string): readonly CandidatePath[] {
  if (!ticketDir) return [];
  const rel = sourceRelative(isAbsolute(ticketDir) ? relative(resolve(repoRoot), resolve(ticketDir)) : ticketDir);
  if (isExcluded(rel, taxonomy) || !inScope(rel, scope)) return [];
  const root = absolutePath(repoRoot, rel);
  if (!existsSync(root)) return [];
  const rows: CandidatePath[] = [];
  const walk = (currentRel: string): void => {
    checkCancellation(repoRoot, cancelFile);
    if (isExcluded(currentRel, taxonomy) || !inScope(currentRel, scope)) return;
    const currentAbs = absolutePath(repoRoot, currentRel);
    const stat = lstatSync(currentAbs);
    if (stat.isSymbolicLink()) {
      rows.push({ path: currentRel, mode: "120000" });
      return;
    }
    if (!stat.isDirectory()) {
      rows.push({ path: currentRel, mode: (stat.mode & 0o111) !== 0 ? "100755" : "100644" });
      return;
    }
    rows.push({ path: currentRel, mode: "040000", explicitDirectory: true });
    const nestedGit = taxonomy.schema.fixedDirectoryContracts["nested-git-metadata"];
    if (nestedGit && basename(currentRel) === ".git" && taxonomy.pathMatcher.matches(currentRel, nestedGit.pathPattern)) return;
    const children = readdirSync(currentAbs).sort((a, b) => Buffer.from(a).compare(Buffer.from(b)));
    for (const child of children) {
      const childRel = sourceRelative(`${currentRel}/${child}`);
      if (isExcluded(childRel, taxonomy) || (currentRel === rel && child === TICKET_GENERATED_OUTPUT_DIRECTORY)) continue;
      walk(childRel);
    }
  };
  walk(rel);
  return rows;
}

export function generatorContractsForOutputPath(path: string, taxonomy: LoadedTaxonomy): readonly { readonly id: string; readonly contract: GeneratorContractSpec }[] {
  const normalized = normalizeRelative(path);
  return Object.entries(taxonomy.schema.generatorContracts)
    .filter(([, contract]) => contract.outputRoots.some((root) => normalized === root.path || normalized.startsWith(`${root.path}/`)))
    .map(([id, contract]) => ({ id, contract }))
    .sort((left, right) => left.id.localeCompare(right.id));
}

function ignoredGeneratorRows(repoRoot: string, taxonomy: LoadedTaxonomy, scope?: string): readonly CandidatePath[] {
  const rows = new Map<string, CandidatePath>();
  const walk = (path: string): void => {
    if (isExcluded(path, taxonomy) || !inScope(path, scope)) return;
    const stat = lstatOrNull(absolutePath(repoRoot, path));
    if (!stat) return;
    if (stat.isSymbolicLink()) {
      rows.set(path, { path, mode: "120000" });
      return;
    }
    if (!stat.isDirectory()) {
      rows.set(path, { path, mode: (stat.mode & 0o111) !== 0 ? "100755" : "100644" });
      return;
    }
    rows.set(path, { path, mode: "040000", explicitDirectory: true });
    for (const child of readdirSync(absolutePath(repoRoot, path)).sort((a, b) => Buffer.from(a).compare(Buffer.from(b)))) walk(sourceRelative(`${path}/${child}`));
  };
  for (const contract of Object.values(taxonomy.schema.generatorContracts)) for (const root of contract.outputRoots) if (root.inclusion === "ignored") walk(root.path);
  return [...rows.values()].sort((left, right) => Buffer.from(left.path).compare(Buffer.from(right.path)));
}

export function contentOf(repoRoot: string, row: CandidatePath, sourceRead: TaxonomyCapturedSourceRead): { readonly stat?: Stats; readonly observedAt?: number; readonly kind: TaxonomyNodeKind; readonly hash: string; readonly mode: number; readonly size: number; readonly symlinkTarget?: string; readonly bytes?: Uint8Array; readonly violation?: TaxonomyViolation } {
  if (row.mode === "040000") return { kind: "directory", hash: "", mode: 0, size: 0 };
  const path = absolutePath(repoRoot, row.path);
  if (!existsSync(path) && row.mode !== "120000") return { kind: "file", hash: row.objectId ?? sha256(""), mode: 0, size: 0, violation: violation("tracked-path-missing", row.path, "Tracked path is missing from the worktree") };
  try {
    const observedAt = Date.now(), stat = lstatSync(path);
    if (stat.isSymbolicLink() || row.mode === "120000") {
      const target = readlinkSync(path);
      return { kind: "symlink", hash: sha256(target), mode: stat.mode & 0o7777, size: Buffer.byteLength(target), symlinkTarget: target };
    }
    if (stat.isDirectory()) return { kind: "directory", hash: "", mode: stat.mode & 0o7777, size: 0 };
    const bytes = sourceRead(path);
    return { stat, observedAt, kind: "file", hash: sha256(bytes), mode: stat.mode & 0o7777, size: bytes.byteLength, bytes };
  } catch (error) {
    return { kind: row.mode === "120000" ? "symlink" : "file", hash: row.objectId ?? sha256(""), mode: 0, size: 0, violation: violation("path-read-failed", row.path, error instanceof Error ? error.message : String(error)) };
  }
}

/** 📇️ One leaf's content identity for classification: {@link contentOf}'s answer, with the bytes read and their exact-UTF-8 test run only on
 * demand. Through a record store, a regular file whose stamp (device, inode, size, times, mode) was recorded non-racily names its digest
 * and UTF-8 exactness without being read at all. */
interface LeafContent {
  readonly stat?: Stats;
  readonly observedAt?: number;
  readonly kind: TaxonomyNodeKind;
  readonly hash: string;
  readonly mode: number;
  readonly size: number;
  readonly symlinkTarget?: string;
  readonly violation?: TaxonomyViolation;
  readonly bytes: () => Uint8Array | undefined;
  readonly utf8: () => boolean | null;
}

const LEAF_STAMP_NAMESPACE = "taxonomy-leaf-stamp-v1";

export const TEXT_LIMIT_BYTES = 16 * 1024 * 1024;

/** 🔤️ Whether bytes decode as exact UTF-8, or `null` above the text size limit where no leaf is read as text. */
function exactUtf8(bytes: Uint8Array): boolean | null {
  if (bytes.byteLength > TEXT_LIMIT_BYTES) return null;
  try { new TextDecoder("utf-8", { fatal: true }).decode(bytes); return true; } catch { return false; }
}

export function leafContentOf(repoRoot: string, row: CandidatePath, sourceRead: TaxonomyCapturedSourceRead, store: RecordStore | null): LeafContent {
  const direct = (): LeafContent => {
    const content = contentOf(repoRoot, row, sourceRead);
    let utf8: boolean | null | undefined;
    return { ...content, bytes: () => content.bytes, utf8: () => utf8 === undefined ? utf8 = content.bytes ? exactUtf8(content.bytes) : null : utf8 };
  };
  const path = absolutePath(repoRoot, row.path);
  if (!store || row.mode === "040000" || row.mode === "120000" || !existsSync(path)) return direct();
  let observedAt: number, stat: Stats;
  try { observedAt = Date.now(); stat = lstatSync(path); } catch { return direct(); }
  if (!stat.isFile()) return direct();
  const key = recordKey(LEAF_STAMP_NAMESPACE, repoRoot, row.path, String(stat.dev), String(stat.ino), String(stat.size), String(stat.mtimeMs), String(stat.ctimeMs), String(stat.mode & 0o7777)), hit = store.get(key);
  if (hit !== undefined) {
    try {
      const record = JSON.parse(Buffer.from(hit).toString("utf8")) as { readonly hash: string; readonly utf8: boolean | null };
      let bytes: Uint8Array | undefined;
      const read = (): Uint8Array => {
        try { return sourceRead(path); } catch (error) { throw new Error(`Leaf changed during inventory: ${row.path}: ${error instanceof Error ? error.message : String(error)}`); }
      };
      return { stat, observedAt, kind: "file", hash: record.hash, mode: stat.mode & 0o7777, size: stat.size, bytes: () => bytes ??= read(), utf8: () => record.utf8 };
    } catch {}
  }
  let bytes: Uint8Array;
  try { bytes = sourceRead(path); } catch { return direct(); }
  const hash = sha256(bytes), utf8 = exactUtf8(bytes);
  if (stat.mtimeMs < observedAt - LEAF_STAMP_RACY_MS && stat.ctimeMs < observedAt - LEAF_STAMP_RACY_MS && bytes.byteLength === stat.size) store.put(key, Buffer.from(JSON.stringify({ hash, utf8 }), "utf8"));
  return { stat, observedAt, kind: "file", hash, mode: stat.mode & 0o7777, size: bytes.byteLength, bytes: () => bytes, utf8: () => utf8 };
}

/** 🧠️ One JSON-exact classification result through the record store under a key naming every input it reads; computed without a store. */
export function storedClassification<T>(store: RecordStore | null, key: () => string, compute: () => T): T {
  if (!store) return compute();
  const recordKeyValue = key(), hit = store.get(recordKeyValue);
  if (hit !== undefined) {
    try { return JSON.parse(Buffer.from(hit).toString("utf8")) as T; } catch {}
  }
  const value = compute(), text = JSON.stringify(value);
  if (text !== undefined && JSON.stringify(JSON.parse(text)) === text) store.put(recordKeyValue, Buffer.from(text, "utf8"));
  return value;
}

export function packageLocation(path: string, taxonomy: LoadedTaxonomy): { readonly owner: string; readonly packageRoot: string; readonly ecosystemId: string | null; readonly rule: PackageBoundaryRule | null } | null {
  const parts = path.split("/");
  const packageIndex = parts.findIndex((part) => {
    if (!part.endsWith("packages")) return false;
    const leading = splitLeadingEmojiIdentity(part);
    return leading.rest === "packages" && (directoryKindIndex(taxonomy).kindsByEmoji.get(emojiFold(leading.first)) ?? []).some((kind) => kind.id === "packages");
  });
  if (packageIndex >= 0) {
    const owner = parts.slice(0, packageIndex).join("/");
    const ecosystemSegment = parts[packageIndex + 1] ?? "";
    const ecosystemIds = Object.keys(taxonomy.schema.ecosystems).filter((id) => emojiFold(id) === emojiFold(ecosystemSegment));
    const selected = ecosystemIds.length === 1 && taxonomy.schema.packageBoundaryRules[requireTaxonomyValue(ecosystemIds[0],"ecosystemIds[0]")] ? [ecosystemIds[0], taxonomy.schema.packageBoundaryRules[requireTaxonomyValue(ecosystemIds[0],"ecosystemIds[0]")]] as const : null;
    return { owner, packageRoot: parts.slice(0, packageIndex + 2).join("/"), ecosystemId: selected?.[0] ?? null, rule: selected?.[1] ?? null };
  }
  return null;
}
