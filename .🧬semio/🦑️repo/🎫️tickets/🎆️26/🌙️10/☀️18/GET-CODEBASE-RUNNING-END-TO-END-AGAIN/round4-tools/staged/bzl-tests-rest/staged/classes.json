{
  "version": 1,
  "sizes": {
    "small": {
      "timeout": "short",
      "seconds": 60
    },
    "medium": {
      "timeout": "moderate",
      "seconds": 300
    },
    "large": {
      "timeout": "long",
      "seconds": 900
    },
    "enormous": {
      "timeout": "eternal",
      "seconds": 3600
    }
  },
  "levels": {
    "fundamental": "small",
    "quick": "medium",
    "long": "large",
    "exhaustive": "enormous"
  },
  "witness": {
    "from": 2000
  },
  "measure": {
    "headroom": 3,
    "minimumRuns": 5,
    "shardAboveSeconds": 300
  },
  "default": {
    "size": "enormous",
    "shards": 1,
    "flaky": false
  },
  "rules": [],
  "messages": {
    "shardNotHonoured": {
      "en": "No command of ${label} honoured shard ${index}/${total}; this shard ran the whole task.",
      "de": "Kein Befehl von ${label} hat den Shard ${index}/${total} beachtet; dieser Shard hat die ganze Aufgabe ausgeführt."
    }
  }
}
