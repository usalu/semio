{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bazel Test Classes",
  "description": "How a neutral test task becomes a Bazel test: its size and timeout class, its shard count, whether a failure is retried, and whether its declared sources enter the test as a single input witness instead of one runfile each. The default is the class every test had before classes existed (the longest Bazel allows); a rule may only be added with evidence of the class it asks for, and a shard count only for a task whose commands take the shard protocol. Sizes map one to one onto Bazel's timeout classes, and the neutral test levels map onto sizes.",
  "definitions": {
    "Size": {
      "enum": [
        "small",
        "medium",
        "large",
        "enormous"
      ]
    },
    "Glob": {
      "type": "string",
      "pattern": "^[^\\[\\]{}\\\\]+$",
      "minLength": 1
    },
    "Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence",
        "reason",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "evidence": {
          "enum": [
            "measured",
            "declared"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 8
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Glob"
          }
        },
        "projects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Glob"
          }
        },
        "size": {
          "$ref": "#/definitions/Size"
        },
        "shards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "flaky": {
          "type": "boolean"
        }
      }
    },
    "Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sizes",
        "levels",
        "witness",
        "measure",
        "default",
        "rules",
        "messages"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sizes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "small",
            "medium",
            "large",
            "enormous"
          ],
          "properties": {
            "small": {
              "$ref": "#/definitions/SizeRow"
            },
            "medium": {
              "$ref": "#/definitions/SizeRow"
            },
            "large": {
              "$ref": "#/definitions/SizeRow"
            },
            "enormous": {
              "$ref": "#/definitions/SizeRow"
            }
          }
        },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fundamental",
            "quick",
            "long",
            "exhaustive"
          ],
          "properties": {
            "fundamental": {
              "$ref": "#/definitions/Size"
            },
            "quick": {
              "$ref": "#/definitions/Size"
            },
            "long": {
              "$ref": "#/definitions/Size"
            },
            "exhaustive": {
              "$ref": "#/definitions/Size"
            }
          }
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "shards",
            "flaky"
          ],
          "properties": {
            "size": {
              "$ref": "#/definitions/Size"
            },
            "shards": {
              "const": 1
            },
            "flaky": {
              "const": false
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Rule"
          }
        },
        "measure": {
          "description": "How measured run times become classes: a size is chosen when its seconds cover headroom times the p95 of the slowest shard of a run, only from minimumRuns runs on, and a task above shardAboveSeconds is proposed for shards only when its commands are known to take the shard protocol.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headroom",
            "minimumRuns",
            "shardAboveSeconds"
          ],
          "properties": {
            "headroom": {
              "type": "number",
              "minimum": 1
            },
            "minimumRuns": {
              "type": "integer",
              "minimum": 1
            },
            "shardAboveSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "messages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shardNotHonoured"
          ],
          "properties": {
            "shardNotHonoured": {
              "$ref": "#/definitions/Text"
            }
          }
        }
      }
    },
    "SizeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout",
        "seconds"
      ],
      "properties": {
        "timeout": {
          "enum": [
            "short",
            "moderate",
            "long",
            "eternal"
          ]
        },
        "seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "target",
        "files"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "timeout",
        "shards",
        "flaky",
        "witness",
        "rule"
      ],
      "properties": {
        "size": {
          "$ref": "#/definitions/Size"
        },
        "timeout": {
          "enum": [
            "short",
            "moderate",
            "long",
            "eternal"
          ]
        },
        "shards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "flaky": {
          "type": "boolean"
        },
        "witness": {
          "type": "boolean"
        },
        "rule": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "BazelEnvironment": {
      "description": "What Bazel sets for a test run and what the neutral protocol receives: shard index (0-based) and total, the shard status file and the XML output file, all absolute paths.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "TEST_SHARD_INDEX": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "TEST_TOTAL_SHARDS": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "TEST_SHARD_STATUS_FILE": {
          "type": "string",
          "minLength": 1
        },
        "XML_OUTPUT_FILE": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
