{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/host-capacity/v1",
  "title": "Host capacity: machine-wide admission of expensive operations",
  "definitions": {
    "Protocol": {
      "const": {
        "resource": "semio.host.capacity/v1",
        "grantEnvironment": "SEMIO_HOST_CAPACITY_GRANT",
        "planEnvironment": "SEMIO_HOST_CAPACITY_PLAN",
        "directoryEnvironment": "SEMIO_HOST_CAPACITY_DIRECTORY",
        "switchEnvironment": "SEMIO_HOST_CAPACITY",
        "floorEnvironment": "SEMIO_HOST_CAPACITY_FLOOR_MEGABYTES",
        "maximumJobs": 1024,
        "maximumFileBytes": 65536,
        "bootToleranceMilliseconds": 120000
      }
    },
    "Level": {
      "enum": [
        "normal",
        "warn",
        "critical"
      ]
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "megabytes"
      ],
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "megabytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "shape",
        "fixedMegabytes",
        "cpu",
        "priority"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "shape": {
          "enum": [
            "tasks",
            "fixed"
          ]
        },
        "kind": {
          "enum": [
            "test",
            "check",
            "generate",
            "build",
            "script",
            "service"
          ]
        },
        "fixedMegabytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "cpu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "priority": {
          "enum": [
            "batch",
            "interactive"
          ]
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "enabled",
        "memory",
        "swap",
        "pressure",
        "load",
        "files",
        "attaches",
        "wait",
        "kinds",
        "operations"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "floorBasisPoints",
            "floorMinimumMegabytes",
            "floorMaximumMegabytes",
            "budgetBasisPoints",
            "rampMilliseconds"
          ],
          "properties": {
            "floorBasisPoints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "floorMinimumMegabytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "floorMaximumMegabytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            },
            "budgetBasisPoints": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "rampMilliseconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "swap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ceilingBasisPoints",
            "outMegabytesPerSecond"
          ],
          "properties": {
            "ceilingBasisPoints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "outMegabytesPerSecond": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "pressure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "psiWarnPercent",
            "psiCriticalPercent",
            "availableWarnBasisPoints",
            "availableCriticalBasisPoints"
          ],
          "properties": {
            "psiWarnPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "psiCriticalPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "availableWarnBasisPoints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "availableCriticalBasisPoints": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "load": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "perCoreCeiling",
            "overrideAfterMilliseconds"
          ],
          "properties": {
            "perCoreCeiling": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "overrideAfterMilliseconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ceilingBasisPoints"
          ],
          "properties": {
            "ceilingBasisPoints": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "attaches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximum"
          ],
          "properties": {
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        "wait": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pollMilliseconds",
            "progressMilliseconds",
            "heartbeatMilliseconds",
            "staleMilliseconds",
            "lockStaleMilliseconds",
            "sampleMaximumAgeMilliseconds",
            "maximumWaiters",
            "bypassMilliseconds",
            "maximumBypasses",
            "agingMilliseconds"
          ],
          "properties": {
            "pollMilliseconds": {
              "type": "integer",
              "minimum": 10
            },
            "progressMilliseconds": {
              "type": "integer",
              "minimum": 10
            },
            "heartbeatMilliseconds": {
              "type": "integer",
              "minimum": 10
            },
            "staleMilliseconds": {
              "type": "integer",
              "minimum": 1000
            },
            "lockStaleMilliseconds": {
              "type": "integer",
              "minimum": 100
            },
            "sampleMaximumAgeMilliseconds": {
              "type": "integer",
              "minimum": 0
            },
            "maximumWaiters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "bypassMilliseconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600000
            },
            "maximumBypasses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "agingMilliseconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            }
          }
        },
        "kinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "test",
            "check",
            "generate",
            "build",
            "script",
            "service"
          ],
          "properties": {
            "test": {
              "$ref": "#/definitions/Resource"
            },
            "check": {
              "$ref": "#/definitions/Resource"
            },
            "generate": {
              "$ref": "#/definitions/Resource"
            },
            "build": {
              "$ref": "#/definitions/Resource"
            },
            "script": {
              "$ref": "#/definitions/Resource"
            },
            "service": {
              "$ref": "#/definitions/Resource"
            }
          }
        },
        "operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Operation"
          }
        }
      }
    },
    "Host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "atMs",
        "platform",
        "cores",
        "totalMegabytes",
        "availableMegabytes",
        "pressure",
        "swapUsedMegabytes",
        "swapOutMegabytesPerSecond",
        "load",
        "openFiles",
        "openFilesMaximum",
        "attachedImages"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "platform": {
          "enum": [
            "darwin",
            "linux",
            "win32"
          ]
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "totalMegabytes": {
          "type": "integer",
          "minimum": 1
        },
        "availableMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "pressure": {
          "$ref": "#/definitions/Level"
        },
        "swapUsedMegabytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "swapOutMegabytesPerSecond": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "load": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "openFiles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "openFilesMaximum": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "attachedImages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "priority",
        "minimumJobs",
        "preferredJobs",
        "fixedMegabytes",
        "perJobMegabytes",
        "cpuPerJob"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,32}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "priority": {
          "enum": [
            "batch",
            "interactive"
          ]
        },
        "minimumJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "preferredJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "fixedMegabytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "perJobMegabytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "cpuPerJob": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "Waiter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "arrivedAtMs",
        "pid"
      ],
      "properties": {
        "request": {
          "$ref": "#/definitions/Request"
        },
        "arrivedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "jobs",
        "cpu",
        "reservedMegabytes",
        "admittedAtMs",
        "observedMegabytes",
        "pid",
        "bootAtMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,32}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "reservedMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "admittedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "observedMegabytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "bootAtMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Reason": {
      "enum": [
        "fits",
        "reduced",
        "override",
        "memory",
        "swap",
        "swap-activity",
        "pressure-critical",
        "pressure-warn",
        "files",
        "attaches",
        "load",
        "queue-order"
      ]
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "verdict",
        "jobs",
        "reservedMegabytes",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "admit",
            "wait"
          ]
        },
        "jobs": {
          "type": "integer",
          "minimum": 0
        },
        "reservedMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "$ref": "#/definitions/Reason"
        }
      }
    },
    "Evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floorMegabytes",
        "unrealizedMegabytes",
        "headroomMegabytes",
        "binding",
        "loadRoom",
        "decisions"
      ],
      "properties": {
        "floorMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "unrealizedMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "headroomMegabytes": {
          "type": "integer"
        },
        "binding": {
          "enum": [
            "available",
            "budget"
          ]
        },
        "loadRoom": {
          "type": [
            "number",
            "null"
          ]
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Decision"
          }
        }
      }
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "jobs",
        "cpu",
        "memoryMegabytes",
        "fixedMegabytes",
        "floorMegabytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memoryMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "fixedMegabytes": {
          "type": "integer",
          "minimum": 0
        },
        "floorMegabytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "support",
        "setting"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "support": {
          "enum": [
            "exact",
            "approximate",
            "unsupported"
          ]
        },
        "setting": {
          "type": "string"
        }
      }
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiting",
        "admitted",
        "reduced",
        "override",
        "bypassed",
        "status",
        "grant",
        "waiter",
        "reasons",
        "errors"
      ],
      "properties": {
        "waiting": {
          "type": "string"
        },
        "admitted": {
          "type": "string"
        },
        "reduced": {
          "type": "string"
        },
        "override": {
          "type": "string"
        },
        "bypassed": {
          "type": "string"
        },
        "reasons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory",
            "swap",
            "swap-activity",
            "pressure-critical",
            "pressure-warn",
            "files",
            "attaches",
            "load",
            "queue-order"
          ],
          "properties": {
            "memory": {
              "type": "string"
            },
            "swap": {
              "type": "string"
            },
            "swap-activity": {
              "type": "string"
            },
            "pressure-critical": {
              "type": "string"
            },
            "pressure-warn": {
              "type": "string"
            },
            "files": {
              "type": "string"
            },
            "attaches": {
              "type": "string"
            },
            "load": {
              "type": "string"
            },
            "queue-order": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string"
        },
        "grant": {
          "type": "string"
        },
        "waiter": {
          "type": "string"
        },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planRequired",
            "recordTooLarge",
            "grantIdentifierRequired",
            "queueFull",
            "definitionRequired",
            "floorOrder",
            "pressureOrder",
            "planJobs",
            "countersUnavailable",
            "platformUnsupported"
          ],
          "properties": {
            "planRequired": {
              "type": "string"
            },
            "recordTooLarge": {
              "type": "string"
            },
            "grantIdentifierRequired": {
              "type": "string"
            },
            "queueFull": {
              "type": "string"
            },
            "definitionRequired": {
              "type": "string"
            },
            "floorOrder": {
              "type": "string"
            },
            "pressureOrder": {
              "type": "string"
            },
            "planJobs": {
              "type": "string"
            },
            "countersUnavailable": {
              "type": "string"
            },
            "platformUnsupported": {
              "type": "string"
            }
          }
        }
      }
    },
    "Messages": {
      "const": {
        "en": {
          "waiting": "[capacity] waiting {seconds}s for {operation}: {reason} (need {need} MB; {spare} MB spare above the {floor} MB floor, load {load}; {running} running, {ahead} ahead)",
          "admitted": "[capacity] admitted {operation}: {jobs} job(s), {reserved} MB reserved ({available} MB available, {floor} MB floor)",
          "reduced": "[capacity] admitted {operation} with {jobs} of {preferred} job(s): the host cannot carry more right now",
          "override": "[capacity] admitted {operation} after {seconds}s although {reason}: nothing of ours is running and memory holds",
          "bypassed": "[capacity] host capacity governor is switched off ({switch}=off)",
          "status": "[capacity] {available} MB available of {total} MB (floor {floor} MB, {spare} MB spare), pressure {pressure}, swap {swap} MB, load {load}, open files {files}, attached images {images}; {grants} running, {waiters} waiting",
          "grant": "[capacity]   running {id} {operation}: {jobs} job(s), {reserved} MB reserved, {observed} MB observed, pid {pid}, since {seconds}s",
          "waiter": "[capacity]   waiting {id} {operation}: wants {jobs} job(s), {need} MB, since {seconds}s, pid {pid}",
          "reasons": {
            "memory": "not enough free memory",
            "swap": "swap use is above its ceiling",
            "swap-activity": "the host is swapping out too fast",
            "pressure-critical": "memory pressure is critical",
            "pressure-warn": "memory pressure is raised",
            "files": "the machine has too many open files",
            "attaches": "too many disk images are attached",
            "load": "the load is above its ceiling",
            "queue-order": "an earlier request is still waiting"
          },
          "errors": {
            "planRequired": "Closed host capacity plan required",
            "recordTooLarge": "Bounded host capacity record required",
            "grantIdentifierRequired": "Closed inherited host capacity grant identifier required",
            "queueFull": "Host capacity queue is full",
            "definitionRequired": "Closed host capacity {definition} required: {detail}",
            "floorOrder": "Host capacity floor minimum exceeds its maximum",
            "pressureOrder": "Host capacity pressure thresholds must rise from warn to critical",
            "planJobs": "Host capacity plan needs jobs between the request bounds",
            "countersUnavailable": "Linux memory counters unavailable",
            "platformUnsupported": "Host capacity does not support {platform}"
          }
        },
        "de": {
          "waiting": "[capacity] wartet seit {seconds} s auf {operation}: {reason} (benötigt {need} MB; {spare} MB frei oberhalb der Untergrenze von {floor} MB, Last {load}; {running} laufen, {ahead} davor)",
          "admitted": "[capacity] zugelassen {operation}: {jobs} Job(s), {reserved} MB reserviert ({available} MB verfügbar, Untergrenze {floor} MB)",
          "reduced": "[capacity] {operation} mit {jobs} von {preferred} Job(s) zugelassen: der Rechner trägt gerade nicht mehr",
          "override": "[capacity] {operation} nach {seconds} s zugelassen, obwohl {reason}: nichts von uns läuft und der Speicher reicht",
          "bypassed": "[capacity] Kapazitätsregelung des Rechners ist ausgeschaltet ({switch}=off)",
          "status": "[capacity] {available} MB verfügbar von {total} MB (Untergrenze {floor} MB, {spare} MB frei), Speicherdruck {pressure}, Auslagerung {swap} MB, Last {load}, offene Dateien {files}, eingehängte Images {images}; {grants} laufen, {waiters} warten",
          "grant": "[capacity]   läuft {id} {operation}: {jobs} Job(s), {reserved} MB reserviert, {observed} MB beobachtet, pid {pid}, seit {seconds} s",
          "waiter": "[capacity]   wartet {id} {operation}: möchte {jobs} Job(s), {need} MB, seit {seconds} s, pid {pid}",
          "reasons": {
            "memory": "nicht genug freier Speicher",
            "swap": "die Auslagerung liegt über ihrer Obergrenze",
            "swap-activity": "der Rechner lagert zu schnell aus",
            "pressure-critical": "der Speicherdruck ist kritisch",
            "pressure-warn": "der Speicherdruck ist erhöht",
            "files": "der Rechner hat zu viele offene Dateien",
            "attaches": "zu viele Disk-Images sind eingehängt",
            "load": "die Last liegt über ihrer Obergrenze",
            "queue-order": "eine frühere Anfrage wartet noch"
          },
          "errors": {
            "planRequired": "Geschlossener Kapazitätsplan des Rechners erforderlich",
            "recordTooLarge": "Begrenzter Kapazitätseintrag des Rechners erforderlich",
            "grantIdentifierRequired": "Geschlossene Kennung der geerbten Kapazitätszusage des Rechners erforderlich",
            "queueFull": "Die Warteschlange der Rechnerkapazität ist voll",
            "definitionRequired": "Geschlossene Kapazitätsdefinition {definition} des Rechners erforderlich: {detail}",
            "floorOrder": "Die Untergrenze der Rechnerkapazität überschreitet ihre Obergrenze",
            "pressureOrder": "Die Schwellen des Speicherdrucks müssen von Warnung zu kritisch steigen",
            "planJobs": "Der Kapazitätsplan braucht Jobs zwischen den Grenzen der Anfrage",
            "countersUnavailable": "Linux-Speicherzähler nicht verfügbar",
            "platformUnsupported": "Die Rechnerkapazität unterstützt {platform} nicht"
          }
        }
      }
    }
  }
}
