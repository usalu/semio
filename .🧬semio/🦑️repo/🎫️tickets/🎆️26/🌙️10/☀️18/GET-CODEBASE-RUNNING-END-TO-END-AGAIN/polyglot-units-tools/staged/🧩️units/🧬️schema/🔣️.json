{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Polyglot Compilation Units",
  "description": "🧩️ One language-neutral compilation unit model: a unit is a set of sources with declared dependencies, an optional interface artifact, outputs and a toolchain identity. A dependent re-runs only when the interface closure (or, for run-time edges, the output closure) of a dependency changes: early cutoff, the same for every language.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    }
  },
  "definitions": {
    "Digest": {
      "description": "Lowercase hex SHA-256.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Path": {
      "description": "Workspace-relative path with forward slashes, no leading slash, no `.` or `..` segment.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000]+$"
    },
    "Texts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "Language": {
      "description": "Closed registry of unit languages. The id of a unit starts with `<language>:`.",
      "enum": [
        "typescript",
        "rust",
        "go",
        "python",
        "dotnet",
        "cpp",
        "wit",
        "tex"
      ]
    },
    "UnitKind": {
      "enum": [
        "library",
        "binary",
        "test",
        "generated",
        "document"
      ]
    },
    "Use": {
      "description": "What a dependent consumes of a dependency. `interface`: only the interface closure (compilers, type checkers). `implementation`: the output closure (linkers, test runners, interpreters). `declared`: nothing; the edge orders and selects but never keys.",
      "enum": [
        "interface",
        "implementation",
        "declared"
      ]
    },
    "Dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "use"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 3
        },
        "use": {
          "$ref": "#/definitions/Use"
        }
      }
    },
    "Interface": {
      "description": "The artifact other units compile or check against. `kind` names an entry of the policy `interfaceKinds`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Toolchain": {
      "description": "Identity of the tools that produce the outputs: `id` (compiler, version, platform) plus further identity strings (flags digest, environment names).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Action": {
      "description": "Command template. Placeholders: `{unit}` id, `{out}` output directory, `{iface}` interface file, `{sources}` source paths. Part of the key.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "env"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "Unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "kind",
        "label",
        "sources",
        "inputs",
        "dependencies",
        "externals",
        "interface",
        "outputs",
        "toolchain",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+:.+$"
        },
        "language": {
          "$ref": "#/definitions/Language"
        },
        "kind": {
          "$ref": "#/definitions/UnitKind"
        },
        "label": {
          "type": "string"
        },
        "sources": {
          "description": "Files this unit owns exclusively. Content digests are part of the key.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Path"
          }
        },
        "inputs": {
          "description": "Further files read (manifests, data, configuration), owned by nobody. Content digests are part of the key.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Path"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Dependency"
          }
        },
        "externals": {
          "description": "Identities of dependencies outside the graph (registry package at an exact version, pinned distribution). Part of the key, sorted.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interface": {
          "anyOf": [
            {
              "$ref": "#/definitions/Interface"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "toolchain": {
          "$ref": "#/definitions/Toolchain"
        },
        "action": {
          "$ref": "#/definitions/Action"
        }
      }
    },
    "Graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "units"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Unit"
          }
        }
      }
    },
    "Receipt": {
      "description": "What a finished unit records: the key, success, diagnostics and the digests of its own outputs and interface. Closures are not stored: they fold the CURRENT closures of the dependencies and are recomputed from facts on every run, hit or not (a hit unit's link inputs still change when a dependency's implementation does).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "key",
        "unit",
        "ok",
        "diagnostics",
        "outputs",
        "interface",
        "exposes",
        "milliseconds"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "key": {
          "$ref": "#/definitions/Digest"
        },
        "unit": {
          "type": "string",
          "minLength": 3
        },
        "ok": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "string"
        },
        "outputs": {
          "$ref": "#/definitions/Digest"
        },
        "interface": {
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "exposes": {
          "description": "The interface dependencies whose types the interface mentions (null: all of them). Only these enter the interface closure.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InterfaceFile": {
      "description": "The small file a unit publishes as its interface for build tools that hash files (Nx dependentTasksOutputFiles, Bazel inputs): dependents list this file and nothing else of the unit, so the tool cuts off by itself when the closure and the artifact are unchanged.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "unit",
        "kind",
        "interface",
        "closure",
        "artifact"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "unit": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "interface": {
          "$ref": "#/definitions/Digest"
        },
        "closure": {
          "$ref": "#/definitions/Digest"
        },
        "artifact": {
          "description": "The interface text the dependents of a hermetic build read (python: the names each module binds). Null when the digest alone is the interface.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InterfaceKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "artifact",
        "digest",
        "closure",
        "bazel"
      ],
      "properties": {
        "language": {
          "$ref": "#/definitions/Language"
        },
        "artifact": {
          "description": "The compiler output (or derived text) other units compile against.",
          "type": "string"
        },
        "digest": {
          "description": "How the interface digest is computed from the artifact.",
          "type": "string"
        },
        "closure": {
          "description": "`transitive`: dependents key the interface digests of the whole interface-reachable closure (sound whenever the artifact can mention types of its own dependencies). `direct`: only the direct dependency digest (the artifact is self-contained).",
          "enum": [
            "transitive",
            "direct"
          ]
        },
        "bazel": {
          "description": "`artifact`: dependents compile against the interface artifact alone, so a build tool lists only the published interface file. `sources`: the tool reads the sources of its dependencies, so the build tool lists them too (correct; the cutoff then happens in the engine, not in the build tool).",
          "enum": [
            "artifact",
            "sources"
          ]
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "languages",
        "interfaceKinds",
        "key",
        "go",
        "python",
        "rust",
        "messages"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Language"
          }
        },
        "interfaceKinds": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/InterfaceKind"
          }
        },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "order",
            "text"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "order": {
              "description": "Order of every sorted list inside key material.",
              "const": "code-point"
            },
            "text": {
              "description": "The key layout in words (the python oracle implements exactly this text).",
              "type": "string"
            }
          }
        },
        "go": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goos",
            "goarch",
            "unix",
            "auxiliaryExtensions",
            "skipDirectories",
            "cgoDefault"
          ],
          "properties": {
            "goos": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "goarch": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unix": {
              "description": "GOOS values the `unix` build tag holds for.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "auxiliaryExtensions": {
              "description": "Non-Go compile inputs of a package directory (cgo, assembly, objects).",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skipDirectories": {
              "description": "Directory names that never hold a package (`testdata`, `vendor`, and names starting with `.` or `_` are skipped as well).",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cgoDefault": {
              "type": "boolean"
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stdlib",
            "skipDirectories",
            "unannotatedReturns",
            "api"
          ],
          "properties": {
            "stdlib": {
              "description": "Top-level names of the interpreter distribution: imports of them are not external dependencies.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skipDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unannotatedReturns": {
              "description": "`ignore`: the interface is the declared surface. `body`: a function without a return annotation also contributes the digest of its body (needed by a checker that infers return types).",
              "enum": [
                "ignore",
                "body"
              ]
            },
            "api": {
              "description": "The interface text in words (the python oracle implements exactly this text).",
              "type": "string"
            }
          }
        },
        "rust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skipDirectories",
            "sourceExtensions"
          ],
          "properties": {
            "skipDirectories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sourceExtensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "messages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "languages",
            "texts"
          ],
          "properties": {
            "languages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "texts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "planning",
                "running",
                "hit",
                "ran",
                "cutoff",
                "failed",
                "blocked",
                "done",
                "cancelled"
              ],
              "properties": {
                "planning": {
                  "$ref": "#/definitions/Texts"
                },
                "running": {
                  "$ref": "#/definitions/Texts"
                },
                "hit": {
                  "$ref": "#/definitions/Texts"
                },
                "ran": {
                  "$ref": "#/definitions/Texts"
                },
                "cutoff": {
                  "$ref": "#/definitions/Texts"
                },
                "failed": {
                  "$ref": "#/definitions/Texts"
                },
                "blocked": {
                  "$ref": "#/definitions/Texts"
                },
                "done": {
                  "$ref": "#/definitions/Texts"
                },
                "cancelled": {
                  "$ref": "#/definitions/Texts"
                }
              }
            }
          }
        }
      }
    },
    "OutFile": {
      "description": "The result file of a unit: key, success, diagnostics, the digest of its outputs and the closure over its implementation dependencies. Implementation consumers list this file of the whole dependency closure.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "unit",
        "key",
        "ok",
        "diagnostics",
        "outputs",
        "closure"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "unit": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/Digest"
        },
        "ok": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "string"
        },
        "outputs": {
          "$ref": "#/definitions/Digest"
        },
        "closure": {
          "$ref": "#/definitions/Digest"
        }
      }
    }
  }
}
