    "kinds": {
      "test": {
        "cpu": 1,
        "megabytes": 1536
      },
      "check": {
        "cpu": 1,
        "megabytes": 4096
      },
      "generate": {
        "cpu": 1,
        "megabytes": 1024
      },
      "build": {
        "cpu": 1,
        "megabytes": 2048
      },
      "script": {
        "cpu": 1,
        "megabytes": 768
      },
      "service": {
        "cpu": 1,
        "megabytes": 2048
      }
    },
    "operations": [
      {
        "name": "run",
        "shape": "tasks",
        "fixedMegabytes": 1536,
        "cpu": 1,
        "priority": "batch",
        "forecast": true
      },
      {
        "name": "run-many",
        "shape": "tasks",
        "fixedMegabytes": 1536,
        "cpu": 1,
        "priority": "batch",
        "forecast": true
      },
      {
        "name": "affected",
        "shape": "tasks",
        "fixedMegabytes": 1536,
        "cpu": 1,
        "priority": "batch",
        "forecast": true
      },
      {
        "name": "exec",
        "shape": "tasks",
        "fixedMegabytes": 1536,
        "cpu": 1,
        "priority": "batch"
      },
      {
        "name": "watch",
        "shape": "tasks",
        "fixedMegabytes": 1536,
        "cpu": 1,
        "priority": "interactive"
      },
      {
        "name": "cargo",
        "shape": "tasks",
        "kind": "build",
        "fixedMegabytes": 1536,
        "cpu": 1,
        "priority": "batch"
      },
      {
        "name": "show",
        "shape": "fixed",
        "fixedMegabytes": 5120,
        "cpu": 2,
        "priority": "batch"
      },
      {
        "name": "graph",
        "shape": "fixed",
        "fixedMegabytes": 5120,
        "cpu": 2,
        "priority": "batch"
      },
      {
        "name": "dependencies",
        "shape": "fixed",
        "fixedMegabytes": 6144,
        "cpu": 2,
        "priority": "batch"
      },
      {
        "name": "command",
        "shape": "fixed",
        "fixedMegabytes": 2048,
        "cpu": 1,
        "priority": "batch"
      }
    ],
    "envelopes": [
      {
        "name": "end-to-end",
        "pattern": "^test-e2e(?:-|$)",
        "cpu": 4,
        "megabytes": 6144
      }
    ],
    "classCeilings": [
      {
        "name": "course-build",
        "pattern": "^run:build:@teaching/architecture-course:build$",
        "megabytes": 12288
      }
    ],
    "estimates": {
      "halfLifeMilliseconds": 259200000,
      "quantileBasisPoints": 9000,
      "marginBasisPoints": 2500,
      "minimumSamples": 3,
      "maximumSamples": 16,
      "maximumClasses": 256,
      "minimumRatioBasisPoints": 3000,
      "maximumRatioBasisPoints": 20000,
      "minimumMegabytes": 512,
