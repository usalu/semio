  "hostCapacity": {
    "version": 1,
    "enabled": true,
    "memory": {
      "floorBasisPoints": 1250,
      "floorMinimumMegabytes": 1536,
      "floorMaximumMegabytes": 4096,
      "budgetBasisPoints": 10000,
      "rampMilliseconds": 60000,
      "maximumRamping": 2,
      "maximumQuiet": 4,
      "quietSoftStopGrants": 1
    },
    "swap": {
      "ceilingBasisPoints": 2500,
      "outMegabytesPerSecond": 64
    },
    "pressure": {
      "psiWarnPercent": 10,
      "psiCriticalPercent": 30,
      "availableWarnBasisPoints": 1500,
      "availableCriticalBasisPoints": 600,
      "compressedWarnBasisPoints": 3500,
      "compressedCriticalBasisPoints": 5500
    },
    "load": {
      "perCoreCeiling": 2,
      "overrideAfterMilliseconds": 120000
    },
    "files": {
      "ceilingBasisPoints": 8000
    },
    "attaches": {
      "maximum": 32
    },
    "wait": {
      "pollMilliseconds": 1000,
      "progressMilliseconds": 5000,
      "heartbeatMilliseconds": 15000,
      "staleMilliseconds": 21600000,
      "lockStaleMilliseconds": 10000,
      "sampleMaximumAgeMilliseconds": 1000,
      "maximumWaiters": 256,
      "bypassMilliseconds": 30000,
      "maximumBypasses": 6,
      "agingMilliseconds": 300000,
      "lendAfterMilliseconds": 5000,
      "jitterBasisPoints": 2500
