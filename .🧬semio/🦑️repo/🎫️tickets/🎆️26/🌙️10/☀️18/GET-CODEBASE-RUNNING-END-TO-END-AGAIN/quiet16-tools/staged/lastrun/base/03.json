      ".feature",
      ".js",
      ".jsx",
      ".ts",
      ".tsx",
      ".cjs",
      ".cjsx",
      ".mjs",
      ".mjsx",
      ".cts",
      ".ctsx",
      ".mts",
      ".mtsx"
