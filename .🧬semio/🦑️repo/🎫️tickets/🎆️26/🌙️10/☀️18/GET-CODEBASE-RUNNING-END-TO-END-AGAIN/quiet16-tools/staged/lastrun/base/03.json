      "retries": "SEMIO_REMOTE_CACHE_RETRIES",
      "tokenEnvironment": "SEMIO_REMOTE_CACHE_TOKEN_ENVIRONMENT"
    },
    "defaults": {
      "endpoint": null,
      "instance": "main",
      "access": "read-only",
      "upload": true,
      "compression": true,
      "download": "toplevel",
      "timeoutSeconds": 30,
      "retries": 3,
      "tokenEnvironment": "SEMIO_REMOTE_CACHE_TOKEN"
