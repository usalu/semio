      "port": 8980,
      "workerPort": 8981,
      "defaultInstance": "main",
      "localWorkers": 1,
      "unmatchedSeconds": 120,
      "lingerSeconds": 5,
      "leaseSeconds": 30,
      "maximumAttempts": 3,
