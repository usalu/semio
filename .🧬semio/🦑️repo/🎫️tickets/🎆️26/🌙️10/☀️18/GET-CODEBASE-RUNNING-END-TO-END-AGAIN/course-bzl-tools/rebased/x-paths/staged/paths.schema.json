{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "alias", "directories", "labels", "closure", "budgets"],
  "properties": {
    "version": {"const": 1},
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link", "hexLength"],
      "properties": {
        "link": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "hexLength": {"type": "integer", "minimum": 8, "maximum": 32}
      }
    },
    "directories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directory", "alias"],
        "properties": {
          "directory": {"type": "string"},
          "alias": {"type": "string", "pattern": "^[a-f0-9]{8,32}$"}
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "label"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1}
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "alias", "legacy"],
      "properties": {
        "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "alias": {"$ref": "#/definitions/Size"},
        "legacy": {"$ref": "#/definitions/Size"}
      }
    },
    "budgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "derive", "input", "expect"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "derive": {"enum": ["alias", "legacy", null]},
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "arch", "outputBase", "longPaths", "closure"],
            "properties": {
              "platform": {"enum": ["win32", "darwin", "linux"]},
              "arch": {"enum": ["x64", "arm64"]},
              "outputBase": {"type": "string", "minLength": 1},
              "longPaths": {"enum": ["enabled", "disabled", "unprobed"]},
              "closure": {
                "type": "object",
                "additionalProperties": false,
                "required": ["alias", "real"],
                "properties": {"alias": {"$ref": "#/definitions/Size"}, "real": {"$ref": "#/definitions/Size"}}
              }
            }
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["families", "limitUnits", "limitBytes", "slackUnits", "slackBytes", "fits", "refusals"],
            "properties": {
              "families": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/definitions/Size"}},
              "limitUnits": {"type": "integer", "minimum": 1},
              "limitBytes": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
              "slackUnits": {"type": "integer"},
              "slackBytes": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
              "fits": {"type": "boolean"},
              "refusals": {"type": "integer", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "bytes"],
      "properties": {"units": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0}}
    }
  }
}
