test("The closed schema accepts the quiet and upgrade members and refuses malformed ones, equal to Ajv",()=>{
 const ajv=new Ajv({strict:false,allErrors:false});ajv.addSchema({$id:"hc",definitions:schema.definitions});
 const agree=(definition:"Request"|"Waiter"|"Grant",value:unknown)=>{const mine=isHostCapacityV1(definition,value),theirs=ajv.validate({$ref:`hc#/definitions/${definition}`},value) as boolean;expect(mine,JSON.stringify(value)).toBe(theirs);return mine;};
 const request={id:"requestaaa1",operation:"run",priority:"batch",minimumJobs:1,preferredJobs:1,fixedMegabytes:900,perJobMegabytes:0,cpuPerJob:1,quiet:true};
 const grant={id:"requestaaa1",operation:"run",jobs:1,cpu:1,reservedMegabytes:900,admittedAtMs:5,observedMegabytes:null,pid:3,bootAtMs:1,quiet:true,arrivedAtMs:2,upgradedAtMs:9};
 expect(agree("Request",request)).toBe(true);expect(agree("Request",{...request,quiet:"yes"})).toBe(false);
 expect(agree("Waiter",{request,arrivedAtMs:2,pid:3,upgrade:true})).toBe(true);expect(agree("Waiter",{request,arrivedAtMs:2,pid:3,upgrade:1})).toBe(false);
 expect(agree("Grant",grant)).toBe(true);expect(agree("Grant",{...grant,arrivedAtMs:-1})).toBe(false);expect(agree("Grant",{...grant,extra:1})).toBe(false);
});
