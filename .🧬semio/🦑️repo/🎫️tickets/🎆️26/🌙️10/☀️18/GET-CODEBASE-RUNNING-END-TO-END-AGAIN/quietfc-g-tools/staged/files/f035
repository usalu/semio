const policyWith=(maximumQuiet:number)=>readHostCapacityPolicyV1({...decisionFixture.policy,memory:{...decisionFixture.policy.memory,maximumQuiet}});
const policy=policyWith(4),forecastPolicy=readHostCapacityPolicyV1({...decisionFixture.policy,memory:{...decisionFixture.policy.memory,maximumQuiet:4,rampMilliseconds:60000}});

test("Quiet requests and upgrade requests decide exactly as the Python oracle on every stored world",()=>{
 for(const item of fixture.decisions){
  const got=evaluateHostCapacityV1(policyWith(item.policy.maximumQuiet),item.host as HostSampleV1,item.ledger as HostGrantV1[],item.queue as HostWaiterV1[],item.nowMs);
  expect(JSON.parse(JSON.stringify(got)),item.name).toEqual(item.expect);
 }
