{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "🧠️ The graph memo: the slice a graph planner child produced once, kept beside the change journal and served again to the next identical request while the journal proves that nothing the planned generation read has changed. `relevance` is the closed table of what a fact row reads: `path` rows read the entry they name, `none` rows read nothing of the tree, `link` rows follow symbolic links, `resolve` rows resolve a request, `text` rows name their inputs inside their key. A kind this table does not name makes a generation unsealable (fail closed); a law keeps the table equal to the kinds the observation and generation schemas declare.",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "directory": "graph-memo",
        "switch": "SEMIO_BUILD_GRAPH_MEMO",
        "sidecar": "SEMIO_BUILD_GRAPH_MEMO_OUT",
        "recordSuffix": ".json",
        "planSuffix": ".plan",
        "relevanceSuffix": ".rel",
        "recheckSuffix": ".chk",
        "maximumRecordBytes": 8192,
        "maximumPlanBytes": 268435456,
        "maximumRelevanceBytes": 67108864,
        "maximumRecheckBytes": 268435456,
        "maximumRows": 4000000,
        "leafSymlinkCheckConcurrency": 64,
        "environmentPrefixes": [
          "SEMIO_BUILD_",
          "SEMIO_GRAPH_",
          "SEMIO_REPO_"
        ],
        "argumentsDenied": [
          "--parallel"
        ],
        "environmentDenied": [
          "SEMIO_BUILD_GENERATION_PIN",
          "SEMIO_BUILD_GRAPH_MEMO_EXPECT",
          "SEMIO_BUILD_GRAPH_MEMO_OUT",
          "SEMIO_BUILD_GRAPH_PLAN_OUT",
          "SEMIO_BUILD_GRAPH_REQUESTED_AT",
          "SEMIO_BUILD_GRAPH_YIELD_ROUND",
          "SEMIO_BUILD_GRAPH_YIELD_TICKET",
          "SEMIO_BUILD_INVOCATION_PID",
          "SEMIO_BUILD_INVOCATION_PIDS",
          "SEMIO_BUILD_PARALLEL",
          "SEMIO_BUILD_REUSE_GRAPH",
          "SEMIO_REPO_PROFILE"
        ],
        "relevance": {
          "file": "path",
          "exists": "path",
          "stat": "path",
          "lstat": "path",
          "readdir": "path",
          "readdirNames": "path",
          "fileExists": "path",
          "directoryExists": "path",
          "directories": "path",
          "typescriptText": "path",
          "digest": "path",
          "field": "path",
          "analysis": "analysis",
          "realpath": "link",
          "realpathNative": "link",
          "typescriptRealpath": "link",
          "resolve": "resolve",
          "derived": "text",
          "closure": "none",
          "stamp": "none",
          "registry": "none"
        },
        "texts": {
          "en": {
            "served": "graph: {projects} projects served from the memo of {seconds} s ago; the journal vouches for {rows} facts and {rechecked} facts outside its sight held, no planner process was started",
            "refused": "graph: the memo cannot serve this request ({reason}); the graph is planned"
          },
          "de": {
            "served": "graph: {projects} Projekte aus dem Memo von vor {seconds} s geliefert; das Journal bürgt für {rows} Fakten, {rechecked} Fakten ausserhalb seiner Sicht gelten noch, es wurde kein Planer-Prozess gestartet",
            "refused": "graph: das Memo kann diese Anfrage nicht bedienen ({reason}); der Graph wird geplant"
          }
        },
        "expect": "SEMIO_BUILD_GRAPH_MEMO_EXPECT"
      }
    },
    "Reason": {
      "enum": [
        "off",
        "no-key",
        "none",
        "light",
        "pointer",
        "generation",
        "journal",
        "changed",
        "stale",
        "plan",
        "pin",
        "error"
      ]
    },
    "Cursor": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}:[0-9]{1,15}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "key",
        "cursor",
        "sealedAtMs",
        "state",
        "manifest",
        "plan",
        "pin",
        "projects"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "key": {
          "$ref": "#/definitions/Sha256"
        },
        "cursor": {
          "$ref": "#/definitions/Cursor"
        },
        "sealedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "pointer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "generation",
            "manifest"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "generation": {
              "type": "integer",
              "minimum": 0
            },
            "manifest": {
              "$ref": "#/definitions/Sha256"
            }
          }
        },
        "relevance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "rows",
            "rechecked"
          ],
          "properties": {
            "id": {
              "$ref": "#/definitions/Sha256"
            },
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "rechecked": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/definitions/Sha256"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "pin": {
          "type": "string",
          "maxLength": 4096
        },
        "projects": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "light",
            "sealed"
          ],
          "$comment": "light: the slice and the generation it served, kept after the first planner run; sealed: with the relevance of the generation, written by the run that found the same generation again (so the sealing cost is paid only by a repeated request, never by an edit-and-run loop)."
        },
        "manifest": {
          "$ref": "#/definitions/Sha256"
        }
      }
    },
    "Sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "pointer",
        "rows",
        "rechecked",
        "directories",
        "linked",
        "unsealable"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "pointer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "generation",
            "manifest"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "generation": {
              "type": "integer",
              "minimum": 0
            },
            "manifest": {
              "$ref": "#/definitions/Sha256"
            }
          }
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "rechecked": {
          "type": "integer",
          "minimum": 0
        },
        "directories": {
          "type": "integer",
          "minimum": 0
        },
        "linked": {
          "type": "integer",
          "minimum": 0
        },
        "unsealable": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
