{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/repo/cargo-jobserver/v1",
  "definitions": {
    "Reason": { "enum": ["malformed", "disabled", "not-inherited", "out-of-range", "missing-fifo"] },
    "Endpoint": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "none" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "read", "write"], "properties": { "kind": { "const": "pipe" }, "read": { "type": "integer", "minimum": 0, "maximum": 63 }, "write": { "type": "integer", "minimum": 0, "maximum": 63 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "fifo" }, "path": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "const": "semaphore" }, "name": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "variable", "reason"], "properties": { "kind": { "const": "closed" }, "variable": { "enum": ["CARGO_MAKEFLAGS", "MAKEFLAGS", "MFLAGS"] }, "reason": { "$ref": "#/definitions/Reason" } } }
      ]
    },
    "Strings": { "type": "object", "additionalProperties": { "type": "string" } },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "platform", "environment", "fifos", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["linux", "darwin", "win32"] },
        "environment": { "$ref": "#/definitions/Strings" },
        "fifos": { "type": "array", "items": { "type": "string" } },
        "expect": { "$ref": "#/definitions/Endpoint" },
        "stricter": { "const": true }
      }
    },
    "ClosedPool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environment", "empty", "patch"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "environment": { "$ref": "#/definitions/Strings" },
        "empty": { "type": ["string", "null"] },
        "patch": { "$ref": "#/definitions/Strings" }
      }
    },
    "Fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "closedPools"],
      "properties": {
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Case" } },
        "closedPools": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ClosedPool" } }
      }
    }
  }
}
