 const stdioOf=(open:readonly number[])=>{const stdio:Array<"ignore"|"pipe">=["ignore","pipe","pipe"];for(let index=3;index<=Math.max(2,...open);index++)stdio[index]=open.includes(index)?"pipe":"ignore";return stdio;};
