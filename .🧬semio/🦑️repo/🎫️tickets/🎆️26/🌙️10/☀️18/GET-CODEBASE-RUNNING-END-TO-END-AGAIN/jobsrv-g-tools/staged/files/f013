    let seed = env::var("GEN_SEED").unwrap_or_default();
    fs::write(format!("{out}/gen.rs"), format!("pub const SEED: &str = {:?};\npub const WHERE: &str = {:?};\n", seed, out)).unwrap();
    fs::create_dir_all(format!("{out}/nested")).unwrap();
    fs::write(format!("{out}/nested/blob.bin"), [0u8, 1, 2, 3, seed.len() as u8]).unwrap();
