{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:dependencies/adopt-receipts/v1",
  "title": "Install-equivalent dependency generation adoption",
  "description": "Schema-first contract of adoption: a fresh dependency generation whose install-relevant inputs equal those of a verified earlier generation of the same runtime receives that generation's installed trees by copy-on-write clone instead of a Bun installation. Inputs differing only in install-inert manifest fields (for example exports) therefore cost a clone, not an installation.",
  "$defs": {
    "Protocol": {
      "const": {
        "version": 1,
        "directory": "generation",
        "adopt": {
          "purpose": "dependency-adopt-receipt",
          "receiptSuffix": ".adopt.json",
          "maximumReceiptBytes": 4096,
          "clonedRoots": {
            "root": "node_modules",
            "member": "w/{index}/node_modules"
          },
          "inertManifestFields": [
            "$schema",
            "author",
            "bugs",
            "bundleKind",
            "contributors",
            "description",
            "exports",
            "funding",
            "homepage",
            "imports",
            "keywords",
            "license",
            "main",
            "module",
            "repository",
            "sideEffects",
            "type",
            "types",
            "typings"
          ],
          "clone": {
            "darwin": ["/bin/cp", "-c", "-pR"],
            "linux": ["/bin/cp", "-a", "--reflink=auto"]
          }
        }
      }
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "AdoptRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bun", "platform", "arch", "recipeSha256"],
      "properties": {
        "bun": {"type": "string", "minLength": 1, "maxLength": 64},
        "platform": {"enum": ["darwin", "linux", "win32"]},
        "arch": {"type": "string", "minLength": 1, "maxLength": 32},
        "recipeSha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "AdoptReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "purpose", "generation", "projectionSha256", "runtime", "installed", "sha256"],
      "properties": {
        "version": {"const": 1},
        "purpose": {"const": "dependency-adopt-receipt"},
        "generation": {"$ref": "#/$defs/Sha256"},
        "projectionSha256": {"$ref": "#/$defs/Sha256"},
        "runtime": {"$ref": "#/$defs/AdoptRuntime"},
        "installed": {"$ref": "#/$defs/Sha256"},
        "sha256": {"$ref": "#/$defs/Sha256"}
      }
    }
  }
}
