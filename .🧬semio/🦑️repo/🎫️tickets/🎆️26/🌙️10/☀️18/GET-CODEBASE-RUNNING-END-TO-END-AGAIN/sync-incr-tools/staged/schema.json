{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:dependencies/incremental-receipts/v1",
  "title": "Incremental dependency synchronization receipts",
  "description": "Schema-first contract of the content-keyed receipts that make dependency lock and sync proportional to what changed since the last sealed generation: installed-paths ledgers verified by directory stamps, the sealed synchronization state, the persisted ownership listing index, converged lock receipts, the full-fence cadence, the retry classification and the single-link source invariant.",
  "$defs": {
    "Protocol": {
      "const": {
        "version": 1,
        "directory": "generation",
        "installed": {
          "purpose": "dependency-installed-paths-receipt",
          "receiptSuffix": ".installed.json",
          "evidenceSuffix": ".installed.ndjson",
          "maximumReceiptBytes": 65536,
          "maximumEvidenceBytes": 67108864,
          "maximumRows": 1048576,
          "maximumRelist": 4096,
          "settleMilliseconds": 5000,
          "stampFields": [
            "dev",
            "ino",
            "mode",
            "nlink",
            "size",
            "mtimeNs",
            "ctimeNs"
          ],
          "identityFields": [
            "dev",
            "ino",
            "mode"
          ],
          "childDigestUnits": 32,
          "checkWork": 256,
          "progressWork": 4096,
          "kinds": [
            "directory",
            "file",
            "link"
          ]
        },
        "sync": {
          "purpose": "dependency-sync-receipt",
          "receiptSuffix": ".sync.json",
          "maximumReceiptBytes": 262144,
          "keyLabel": "sync:all",
          "settleWaitMilliseconds": 5250
        },
        "ownership": {
          "purpose": "dependency-ownership-index",
          "receiptSuffix": ".ownership.json",
          "evidenceSuffix": ".ownership.ndjson",
          "keyLabel": "ownership:index",
          "maximumReceiptBytes": 65536,
          "maximumEvidenceBytes": 67108864,
          "maximumRows": 1048576,
          "maximumEntries": 65536
        },
        "lock": {
          "purpose": "dependency-lock-converged-receipt",
          "receiptSuffix": ".lock.json",
          "maximumReceiptBytes": 65536
        },
        "execution": {
          "settleMilliseconds": 5000,
          "stampSettleIndexes": [
            5,
            6
          ]
        },
        "retry": {
          "maximumAttempts": 3,
          "patterns": [
            "^Bun current (?:ownership|workspace membership|manifest|workspace manifests) changed",
            "^Declared (?:provider|execution physical) observation changed",
            "^Current (?:Store provider execution|Source-owner execution) changed",
            "^Original Bun dependency input (?:changed|appeared) during installation"
          ],
          "excluded": [
            "custody",
            "lease",
            "released",
            "cancel",
            "abort"
          ]
        },
        "singleLink": {
          "message": "Single-link Bun dependency input required"
        },
        "tiers": [
          {
            "name": "gate",
            "cost": "O(receipts + live directories)",
            "covers": "sealed synchronization state: generation receipts, installed-paths ledgers and the generation container listing"
          },
          {
            "name": "installed",
            "cost": "O(directories)",
            "covers": "names and kinds of every installed entry by directory stamps with listing-digest relisting"
          },
          {
            "name": "execution",
            "cost": "O(observations)",
            "covers": "provider resolution by replaying the recorded physical observations of an earlier walk of the same run"
          },
          {
            "name": "ownership",
            "cost": "O(directories) lstat, no readdir",
            "covers": "workspace listing projections reused across processes under their settled directory stamps"
          },
          {
            "name": "lock",
            "cost": "O(scopes)",
            "covers": "scopes whose produced lock equalled the published lock under identical inputs"
          }
        ]
      }
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "InstalledEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "bytes",
        "rows"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}\\.installed\\.ndjson$"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "InstalledShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "directories",
        "files",
        "links",
        "maximumPathUnits",
        "sha256"
      ],
      "properties": {
        "entries": {
          "type": "integer",
          "minimum": 1
        },
        "directories": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "integer",
          "minimum": 0
        },
        "maximumPathUnits": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "InstalledReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "generation",
        "device",
        "shape",
        "evidence",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "const": "dependency-installed-paths-receipt"
        },
        "generation": {
          "$ref": "#/$defs/Sha256"
        },
        "device": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "shape": {
          "$ref": "#/$defs/InstalledShape"
        },
        "evidence": {
          "$ref": "#/$defs/InstalledEvidence"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "InstalledRows": {
      "description": "Newline-delimited JSON arrays, one per installed directory in byte order of the posix path relative to the generation root (\".\" is the root): [\"g\",path,dev,ino,mode,nlink,size,mtimeNs,ctimeNs,settled,childrenDigest,directories,files,links]. All stamp fields are decimal strings; settled is 1 when mtime and ctime were older than the scan start minus the settle window; childrenDigest is the first 32 hex digits of sha256 of the JSON array of [name,kind] pairs of the directory entries in byte order, kind being directory, file or link.",
      "type": "array"
    },
    "SyncScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "generation",
        "read",
        "installed"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "generation": {
          "$ref": "#/$defs/Sha256"
        },
        "installed": {
          "$ref": "#/$defs/Sha256"
        },
        "read": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "SyncReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "selection",
        "runtimeSha256",
        "scopes",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "const": "dependency-sync-receipt"
        },
        "selection": {
          "const": "all"
        },
        "runtimeSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/SyncScope"
          }
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "OwnershipEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "bytes",
        "rows"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}\\.ownership\\.ndjson$"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OwnershipReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "evidence",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "const": "dependency-ownership-index"
        },
        "evidence": {
          "$ref": "#/$defs/OwnershipEvidence"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "OwnershipRows": {
      "description": "Newline-delimited JSON arrays, one per settled workspace directory listing in byte order of the posix path relative to the workspace root (\".\" is the root): [\"d\",path,dev,ino,mode,mtimeNs,ctimeNs,count,entries] where entries is the ownership projection as [[name,kind],...] and count the number of entries of the full listing.",
      "type": "array"
    },
    "LockReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "scope",
        "generation",
        "lockSha256",
        "recipeSha256",
        "runtimeSha256",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "const": "dependency-lock-converged-receipt"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "generation": {
          "$ref": "#/$defs/Sha256"
        },
        "lockSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "recipeSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "runtimeSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    }
  }
}
