func (h Host) root() (string, error) {
	start, err := StartDirectory(h.Env, h.Getwd)
	if err != nil {
		return "", err
	}
	return ResolveRoot(start)
}

// 🧾️ReportRoot prints a root failure in every built-in language and answers the exit code.
func (h Host) ReportRoot(err error) int {
	var invalid RootInvalidError
	var missing RootNotFoundError
	switch {
	case errors.As(err, &invalid):
		h.Stderr(builtin(Builtin["root"+strings.ToUpper(invalid.Kind[:1])+invalid.Kind[1:]], map[string]string{"file": invalid.File}))
	case errors.As(err, &missing):
		h.Stderr(builtin(Builtin["noRepository"], map[string]string{"start": missing.Start}))
	default:
		h.Stderr(builtin(Builtin["unexpected"], map[string]string{"reason": err.Error()}))
	}
	return 2
}

// 🧾️ReportRegistry prints a registry failure in every built-in language and answers the exit code.
func (h Host) ReportRegistry(err error) int {
	var problem RegistryError
	if !errors.As(err, &problem) {
		h.Stderr(builtin(Builtin["unexpected"], map[string]string{"reason": err.Error()}))
		return 2
	}
	if problem.Kind == "protocol" {
		h.Stderr(builtin(Builtin["languageProtocol"], map[string]string{"path": problem.Path}))
		return 2
	}
	h.Stderr(builtin(Builtin["registry."+problem.Kind], map[string]string{"path": problem.Path, "subject": problem.Subject, "found": strconv.Itoa(problem.Found), "expected": strconv.Itoa(Contract)}))
	return 2
}

func (h Host) implementationVersion(root string, registry *Registry) (string, bool) {
	raw, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(registry.Implementation.Version.File)))
	var document map[string]json.RawMessage
	if err != nil || json.Unmarshal(raw, &document) != nil {
		return "", false
	}
	var version string
	if json.Unmarshal(document[registry.Implementation.Version.Key], &version) != nil || version == "" {
		return "", false
	}
	return version, true
}

// 🔖️Version prints the versions of the launcher, of every runtime the entries use and of the implementation; the runtime is never fetched for it.
func (h Host) Version(args []string) int {
	values := map[string]string{"version": Version, "contract": strconv.Itoa(Contract)}
	root, err := h.root()
	if err != nil {
		if !IsRootNotFound(err) {
			return h.ReportRoot(err)
		}
		h.Stdout(builtin(Builtin["versionLauncher"], values))
		h.Stdout(builtin(Builtin["versionNoRepository"], nil))
		return 0
	}
	registry, err := LoadRegistry(root)
	if err != nil {
		return h.ReportRegistry(err)
	}
	talk := &speaker{host: h, root: root, registry: registry, args: args}
	if !talk.choose() {
		return 2
	}
	h.Stdout(Format(Builtin["versionLauncher"][talk.language], values))
	platform, arch, musl := h.Target()
	names := map[string]bool{registry.Selected: true}
	for _, entry := range registry.Implementation.Entries {
		names[registry.entryRuntime(entry)] = true
	}
	for _, name := range sortedKeys(names) {
		rt := registry.Runtimes[name]
		request := ProvisionRequest{Root: root, Name: name, Registry: registry, Runtime: rt, Platform: platform, Arch: arch, Musl: musl, Env: h.Env}
		facts := map[string]string{"runtime": name, "version": rt.Version}
		if install, present, _ := request.Locate(); present {
			facts["path"] = install.Executable
			h.Stdout(talk.text("versionRuntimeReady", facts))
		} else {
			h.Stdout(talk.text("versionRuntimeAbsent", facts))
		}
	}
	source := map[string]string{"source": registry.Implementation.Version.File}
	if version, ok := h.implementationVersion(root, registry); ok {
		source["version"] = version
		h.Stdout(talk.text("versionImplementation", source))
	} else {
		h.Stdout(talk.text("versionImplementationUnknown", source))
	}
	return 0
}

// 📖️Help prints the usage of the launcher.
func (h Host) Help(args []string) int {
	root, err := h.root()
	if err != nil {
		return h.ReportRoot(err)
	}
	registry, err := LoadRegistry(root)
	if err != nil {
		return h.ReportRegistry(err)
	}
	talk := &speaker{host: h, root: root, registry: registry, args: args}
	if !talk.choose() {
		return 2
	}
	rt := registry.Runtimes[registry.Selected]
	catalogued, _ := BuildVerbsAt(root, registry)
	verbs := append(append([]string{}, catalogued...), "dashboard")
	sort.Strings(verbs)
	h.Stdout(talk.text("helpUsage", nil))
	h.Stdout(talk.text("helpBuild", map[string]string{"verbs": strings.Join(verbs, ", ")}))
	h.Stdout(talk.text("helpRuntime", map[string]string{"runtime": registry.Selected, "version": rt.Version}))
	h.Stdout(talk.text("helpVersion", nil))
	return 0
}

// 🛎️Main is the stand-alone launcher: it routes the argument vector and answers the exit code; domain verbs need the full native command.
func (h Host) Main(ctx context.Context, argv []string) int {
	if len(argv) == 0 || argv[0] == "--help" || argv[0] == "-h" {
		return h.Help(argv)
	}
	if argv[0] == "--version" || argv[0] == "-V" {
		return h.Version(argv)
	}
	plan := PlanRoute(argv)
	root, err := h.root()
	if err != nil {
		return h.ReportRoot(err)
	}
	if plan.Kind == "build" || plan.Kind == "workspace" || plan.Kind == "script" {
		return h.Execute(ctx, root, plan.Kind, plan.Arguments)
	}
	registry, err := LoadRegistry(root)
	if err != nil {
		return h.ReportRegistry(err)
	}
	talk := &speaker{host: h, root: root, registry: registry, args: argv}
	if !talk.choose() {
		return 2
	}
	h.Stderr(talk.text("domainNeedsInstall", map[string]string{"verb": argv[0]}))
	return 2
}

