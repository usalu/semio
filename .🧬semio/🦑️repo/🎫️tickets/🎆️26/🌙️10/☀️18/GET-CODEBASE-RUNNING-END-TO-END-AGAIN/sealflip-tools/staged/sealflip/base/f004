import{spawn}from"node:child_process";
import{closeSync,createReadStream,fstatSync,openSync}from"node:fs";
import{constants as osConstants}from"node:os";
import{relative}from"node:path";
import{fileURLToPath}from"node:url";
import door from"../../🚪️door/🔣️.json"with{type:"json"};
import{implementationModeV1,readSealedBlockedV1,readSealedCheckedV1,readSealedLoaderV1,readSealedPointerV1,readSealedReceiptV1,sealedEntryOfV1,sealedLanguagesV1,sealedLightActionV1,sealedLightCommandV1,sealedPolicyV1,sealedTextV1,sealedTreeDriftV1,writeSealedCheckedV1,type ImplementationModeV1,type SealedEntryV1,type SealedPointerV1}from"../🟦️.ts";

/** 🏷️ The role argument that makes the sealed entry run the front door (the same literal the entry module exports; a law compares the two). */
const doorRoleV1="--semio-role=door";
/** 🔁️ What a promotion answers the trampoline. */
export interface TrampolinePromotionV1{readonly status:string;readonly pointer:Readonly<{digest:string}>}
/** 🔌️ What the trampoline needs beyond Node: the entry of the store and the promotion of a drifted tree (live code, loaded only when the tree drifted). */
export interface TrampolineOptionsV1{readonly entry?:string;readonly promote?:(root:string,entry:string,environment:NodeJS.ProcessEnv,write:(text:string)=>void)=>Promise<TrampolinePromotionV1>;readonly refresh?:(argv:readonly string[],environment:NodeJS.ProcessEnv)=>number|undefined}
/** ⏳️ What a start does with the pointer it found. A heavy command promotes a drifted tree (or a snapshot without a receipt); a light command never waits for the stat walk while its snapshot is fresh, checks the tree once it is older, and then promotes before it runs only when the snapshot is old enough that running it would be wrong, or starts a detached promotion while it runs the snapshot. The facts of a check are kept in the store, so the next light commands skip it.
 * @see ../🟦️.ts the policy `light` and the plan, ../🧪️tests/🗂️store/🟦️.ts the laws */
function startVerdictV1(root:string,store:SealedEntryV1,mode:ImplementationModeV1,pointer:SealedPointerV1|undefined,light:boolean,now=Date.now()):Readonly<{action:"run"|"promote"|"refresh";start:boolean}>{
 if(mode==="promote"||!pointer)return{action:"promote",start:false};
 if(!light){const receipt=readSealedReceiptV1(store,pointer.digest);return{action:!receipt?.tree||now-pointer.promotedAtMs>=sealedPolicyV1.coalesceMilliseconds&&!sealedTreeDriftV1(root,receipt.tree).fresh?"promote":"run",start:false};}
 const checked=readSealedCheckedV1(store,pointer.digest),plan=sealedLightActionV1({now,promotedAtMs:pointer.promotedAtMs,checked,drifted:()=>{const receipt=readSealedReceiptV1(store,pointer.digest);return!receipt?.tree||!sealedTreeDriftV1(root,receipt.tree).fresh;},blocked:()=>{const known=readSealedBlockedV1(store);return known?.tree!=null&&sealedTreeDriftV1(root,known.tree).fresh;}});
 if(plan.probed)writeSealedCheckedV1(store,{version:1,entry:store.entry,digest:pointer.digest,atMs:now,drifted:plan.drifted,refreshedAtMs:plan.start?now:checked?.refreshedAtMs??null});
 return{action:plan.action,start:plan.start};
}
/** 🔄️ Starts the detached process that promotes the live tree while a light command runs the snapshot it has (the same door script in `promote` mode, which runs nothing); the process id, or nothing when it could not be started. */
function refreshV1(argv:readonly string[],environment:NodeJS.ProcessEnv):number|undefined{
 try{const script=process.argv[1];if(!script)return undefined;const child=spawn(process.execPath,[script,...argv],{detached:true,stdio:"ignore",env:{...environment,[sealedPolicyV1.modeVariable]:"promote"}});child.unref();return child.pid;}catch{return undefined;}
}

const promoteLiveV1=async(root:string,entry:string,environment:NodeJS.ProcessEnv,write:(text:string)=>void):Promise<TrampolinePromotionV1>=>(await import("../🔁️promoter/🟦️.ts")).promoteLiveTreeV1(root,entry,environment,write);

/** 🚦️ Starts the build tool's front door from the sealed snapshot. This is the only code of the tool that runs from the live tree on every start, so it imports Node built-ins and the store reader only; everything heavier is loaded when it is needed. In `sealed` mode it compares the live tree with the tree the current snapshot was captured from (a stat fingerprint, no file read) and, when the tree drifted, promotes it from live code first (the store promotes only a tree that parses and boots, under one lock for all processes); a promotion that is blocked or fails says so in English and German and the last good snapshot runs, so a half-finished edit anywhere in the tool cannot stop a command. `live` (the declared opt-in of the agent that edits the tool) runs the live front door, `promote` promotes and runs nothing, a store without a snapshot runs the live door, and a sealed door that ends before it reported that it started (a snapshot that no longer loads here; not on Windows, where the report cannot be trusted and a command must never run twice) says so and runs the live door too. Signals reach the sealed door, its exit code is ours. A light command checks the live tree only once its snapshot is older than `light.freshMilliseconds`: a drifted tree older than `light.promoteAfterMilliseconds` is promoted before the command runs, a younger one is promoted by a detached process while the command runs the snapshot (one notice, debounced), and a snapshot still older than `light.refuseAfterMilliseconds` after the promotion attempt is refused with exit 75. On POSIX the snapshot reaches the sealed door as an inherited read-only descriptor of its stored file (one read instead of a pipe through this process).
 * @see ../🔁️promoter/🟦️.ts the promoter, ../🚪️entry/🟦️.ts the entry the snapshot runs, ../🟦️.ts the policy and the store */
export async function startImplementationV1(root:string,argv:readonly string[],environment:NodeJS.ProcessEnv,live:()=>Promise<void>,options:TrampolineOptionsV1={}):Promise<void>{
 let mode;
 try{mode=implementationModeV1(environment);}catch(error){process.stderr.write((error as Error).message+"\n");process.exitCode=2;return;}
 if(mode==="live")return live();
 const entry=options.entry??relative(root,fileURLToPath(new URL("../🚪️entry/🟦️.ts",import.meta.url))).split("\\").join("/"),store=sealedEntryOfV1(root,entry),languages=sealedLanguagesV1(environment),promote=options.promote??promoteLiveV1,say=(text:string)=>{try{process.stderr.write(text);}catch{}};
 let pointer=readSealedPointerV1(store);
 const light=sealedLightCommandV1(argv,door.light.map(row=>row.operation)),verdict=startVerdictV1(root,store,mode,pointer,light);
 if(verdict.action==="promote"){
  try{
   const done=await promote(root,entry,environment,say);
   if(mode==="promote"){say(sealedTextV1(languages,"promoteDone",{digest:done.pointer.digest.slice(0,12),status:done.status})+"\n");process.exitCode=["fresh","refreshed","promoted","served"].includes(done.status)?0:1;return;}
  }catch(error){
   const message=String((error as Error).message??error);
   say((error as{code?:string}).code==="SEMIO_IMPLEMENTATION_NONE"?message+"\n":sealedTextV1(languages,"promoter",{reason:message.replace(/\s+/gu," ").slice(0,200)})+"\n");
   if(mode==="promote"){process.exitCode=1;return;}
  }
  pointer=readSealedPointerV1(store);
  if(light&&pointer&&Date.now()-pointer.promotedAtMs>=sealedPolicyV1.light.refuseAfterMilliseconds){
   const rows=readSealedBlockedV1(store)?.rows??[],shown=rows.slice(0,sealedPolicyV1.shownBlockedRows).map(row=>sealedTextV1(["en"],"blockedRow",{path:row.path,line:row.line,column:row.column,message:row.message})).join("; ")||"-";
   say(sealedTextV1(languages,"refused",{digest:pointer.digest.slice(0,12),hours:Math.floor((Date.now()-pointer.promotedAtMs)/3600000),rows:shown,variable:sealedPolicyV1.modeVariable})+"\n");process.exitCode=75;return;
  }
 }else if(verdict.action==="refresh"&&verdict.start&&pointer){
  const pid=(options.refresh??refreshV1)(argv,environment);
  if(pid!==undefined)say(sealedTextV1(languages,"stale",{digest:pointer.digest.slice(0,12),minutes:Math.floor((Date.now()-pointer.promotedAtMs)/60000),pid})+"\n");
 }
 const loader=pointer&&readSealedLoaderV1(store,pointer);
 if(!pointer||loader===undefined)return live();
 let snapshot:number|undefined;
 if(process.platform!=="win32")try{snapshot=openSync(store.snapshot(pointer.digest),"r");if(fstatSync(snapshot).size!==pointer.bytes){closeSync(snapshot);return live();}}catch{if(snapshot!==undefined)try{closeSync(snapshot);}catch{}return live();}
 const code=await new Promise<number|undefined>(accept=>{
  const child=spawn(process.execPath,["--eval",loader,"--",pointer.digest,doorRoleV1,...argv],{stdio:["inherit","inherit","inherit",snapshot??"pipe","pipe"],env:{...environment,BUN_RUNTIME_TRANSPILER_CACHE_PATH:"0"}}),forwards=(["SIGINT","SIGTERM","SIGHUP"] as const).map(signal=>[signal,()=>{stopped=true;try{child.kill(signal);}catch{}}] as const);
  let ready=false,stopped=false;
  for(const[signal,forward] of forwards)process.on(signal,forward);
  const finish=(value:number|undefined)=>{for(const[signal,forward] of forwards)process.off(signal,forward);accept(value);};
  if(snapshot!==undefined)try{closeSync(snapshot);}catch{}
  const feed=child.stdio[3] as NodeJS.WritableStream|null;
  if(feed){feed.on("error",()=>{});createReadStream(store.snapshot(pointer.digest)).on("error",()=>{try{feed.end();}catch{}}).pipe(feed);}
  child.stdio[4]?.on("data",()=>{ready=true;});child.stdio[4]?.on("error",()=>{});
  child.once("error",()=>finish(undefined));
  child.once("close",(status,signal)=>{const exit=status??(signal?128+(osConstants.signals[signal]??0):1);finish(ready||stopped||process.platform==="win32"||status===0?exit:undefined);});
 });
 if(code===undefined){say(sealedTextV1(languages,"startup",{code:"-"})+"\n");return live();}
 process.exitCode=code;
}
