{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Concurrent Session Harness",
  "description": "Workloads of simulated agents working in one checkout copy, the lease classes their waits are attributed to, the pass criteria, the measurements and the report of the concurrency acceptance harness; every build implementation behind the tool-neutral interface is judged by the same contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    }
  },
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "id": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "taskId": "^\\S+:\\S+$",
        "nonce": "^[0-9a-z]{6,32}$",
        "maximumSessions": 8,
        "defaultSessions": 3,
        "maximumSteps": 64,
        "maximumPathLength": 255,
        "maximumStepMilliseconds": 1800000,
        "maximumPauseMilliseconds": 600000,
        "maximumLines": 200000,
        "maximumLogBytes": 268435456,
        "tailLines": 40,
        "episodeGapMilliseconds": 20000,
        "scriptRow": "^\\[script\\] (\\{.*\\})$",
        "queuePrefix": "lease-queue:",
        "ignoredPrefixes": [
          "javascript-source-provider:",
          "javascript-preserving-source:",
          "cargo:source-admission:",
          "build:parser-source:",
          "build:graph-phase:",
          "cache-scan:",
          "cache-delete:",
          "boot-recovery:",
          "dependencies:",
          "resource-directory-admission:",
          "compiler:capacity-subdivision"
        ],
        "bazelWait": "Another command \\(pid=(\\d+)\\) is running\\. Waiting for it to complete on the server",
        "bazelContinuation": "^(?:INFO: |WARNING: )?(?:Another command \\(pid=|Waiting for it to complete)",
        "bazelResource": "bazel:server",
        "cargoWait": "^\\s*Blocking waiting for file lock on (.+?)\\s*$",
        "cargoResourcePrefix": "cargo:",
        "taskReport": "SEMIO_BUILD_TASK_REPORT",
        "leaseTrace": "SEMIO_LEASE_TRACE",
        "nxSkewMilliseconds": 2000,
        "relations": [
          "related",
          "unrelated",
          "external"
        ]
      }
    },
    "Tool": {
      "enum": [
        "nx",
        "bazel"
      ]
    },
    "Language": {
      "enum": [
        "ts",
        "rs",
        "go",
        "py",
        "text"
      ]
    },
    "EditOp": {
      "enum": [
        "comment",
        "private-body",
        "public-api",
        "whitespace"
      ]
    },
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "TaskId": {
      "type": "string",
      "pattern": "^\\S+:\\S+$"
    },
    "Path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "Paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/Path"
      }
    },
    "LocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Mode": {
      "enum": [
        "shared",
        "exclusive"
      ]
    },
    "Relation": {
      "enum": [
        "related",
        "unrelated",
        "external"
      ]
    },
    "Observed": {
      "enum": [
        "exact",
        "window",
        "ambiguous",
        "none"
      ]
    },
    "Status": {
      "enum": [
        "pass",
        "fail",
        "skip"
      ]
    },
    "Scope": {
      "enum": [
        "workspace",
        "project",
        "host"
      ]
    },
    "EditStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file",
        "op",
        "language"
      ],
      "properties": {
        "kind": {
          "const": "edit"
        },
        "file": {
          "$ref": "#/definitions/Path"
        },
        "op": {
          "$ref": "#/definitions/EditOp"
        },
        "language": {
          "$ref": "#/definitions/Language"
        }
      }
    },
    "RevertStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "revert"
        }
      }
    },
    "RunStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "run"
        },
        "target": {
          "$ref": "#/definitions/TaskId"
        },
        "outputs": {
          "$ref": "#/definitions/Paths"
        }
      }
    },
    "RepoStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "args"
      ],
      "properties": {
        "kind": {
          "const": "repo"
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "$ref": "#/definitions/Paths"
        },
        "stdout": {
          "type": "boolean"
        }
      }
    },
    "BarrierStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "barrier"
        },
        "id": {
          "$ref": "#/definitions/Id"
        }
      }
    },
    "PauseStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "milliseconds"
      ],
      "properties": {
        "kind": {
          "const": "pause"
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      }
    },
    "Step": {
      "oneOf": [
        {
          "$ref": "#/definitions/EditStep"
        },
        {
          "$ref": "#/definitions/RevertStep"
        },
        {
          "$ref": "#/definitions/RunStep"
        },
        {
          "$ref": "#/definitions/RepoStep"
        },
        {
          "$ref": "#/definitions/BarrierStep"
        },
        {
          "$ref": "#/definitions/PauseStep"
        }
      ]
    },
    "SetupStep": {
      "oneOf": [
        {
          "$ref": "#/definitions/EditStep"
        },
        {
          "$ref": "#/definitions/RunStep"
        },
        {
          "$ref": "#/definitions/RepoStep"
        }
      ]
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "group",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "area": {
          "$ref": "#/definitions/Id"
        },
        "group": {
          "$ref": "#/definitions/Id"
        },
        "delayMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/Step"
          }
        }
      }
    },
    "Workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "criteria",
        "setup",
        "sessions"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        },
        "summary": {
          "$ref": "#/definitions/LocalizedText"
        },
        "criteria": {
          "$ref": "#/definitions/Id"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/Tool"
          }
        },
        "setup": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/SetupStep"
          }
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/Session"
          }
        }
      }
    },
    "LeaseClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "scope",
        "patterns"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "label": {
          "$ref": "#/definitions/LocalizedText"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Owners": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Id"
      }
    },
    "RuleNoFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owners",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        },
        "owners": {
          "$ref": "#/definitions/Owners"
        },
        "kind": {
          "const": "no-failure"
        }
      }
    },
    "RuleSerialEqual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owners",
        "kind",
        "compare"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        },
        "owners": {
          "$ref": "#/definitions/Owners"
        },
        "kind": {
          "const": "serial-equal"
        },
        "compare": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "exit",
              "outputs",
              "stdout"
            ]
          }
        }
      }
    },
    "RuleMaxWait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owners",
        "kind",
        "classes",
        "relation",
        "maximumMilliseconds"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        },
        "owners": {
          "$ref": "#/definitions/Owners"
        },
        "kind": {
          "const": "max-wait"
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relation": {
          "enum": [
            "related",
            "unrelated",
            "any"
          ]
        },
        "maximumMilliseconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Sessions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "RuleExecutesOnce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owners",
        "kind",
        "sessions",
        "excludeUncached"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        },
        "owners": {
          "$ref": "#/definitions/Owners"
        },
        "kind": {
          "const": "executes-once"
        },
        "sessions": {
          "$ref": "#/definitions/Sessions"
        },
        "excludeUncached": {
          "type": "boolean"
        }
      }
    },
    "RuleMaxExecuted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owners",
        "kind",
        "sessions",
        "maximum",
        "excludeUncached"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        },
        "owners": {
          "$ref": "#/definitions/Owners"
        },
        "kind": {
          "const": "max-executed"
        },
        "sessions": {
          "$ref": "#/definitions/Sessions"
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        },
        "excludeUncached": {
          "type": "boolean"
        }
      }
    },
    "Rule": {
      "oneOf": [
        {
          "$ref": "#/definitions/RuleNoFailure"
        },
        {
          "$ref": "#/definitions/RuleSerialEqual"
        },
        {
          "$ref": "#/definitions/RuleMaxWait"
        },
        {
          "$ref": "#/definitions/RuleExecutesOnce"
        },
        {
          "$ref": "#/definitions/RuleMaxExecuted"
        }
      ]
    },
    "Criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "rules"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/LocalizedText"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Rule"
          }
        }
      }
    },
