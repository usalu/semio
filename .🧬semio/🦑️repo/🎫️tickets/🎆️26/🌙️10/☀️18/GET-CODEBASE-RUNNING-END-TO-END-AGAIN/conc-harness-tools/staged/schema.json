    "WorkloadSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "labels",
        "classes",
        "criteria",
        "workloads"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "labels": {
          "$ref": "#/definitions/Labels"
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/LeaseClass"
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
