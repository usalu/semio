    "Wait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "resource",
        "mode",
        "source",
        "precise",
        "startMs",
        "endMs",
        "waitMs",
        "holderPid",
        "position"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "$ref": "#/definitions/Mode"
        },
        "source": {
          "enum": [
            "lease",
            "trace",
            "bazel",
            "cargo"
          ]
        },
        "precise": {
          "type": "boolean"
        },
        "startMs": {
          "type": "number",
          "minimum": -1000000000000.0
        },
        "endMs": {
          "type": "number",
          "minimum": -1000000000000.0
        },
        "waitMs": {
          "type": "number",
          "minimum": 0
        },
        "holderPid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "position": {
          "type": [
            "integer",
            "null"
          ]
        },
