/** 🧂️ The lowercase hex SHA-256 of a text (UTF-8) or of bytes, without a hash object. */
export function sha256HexV1(data:string|Uint8Array):string;
/** 🔪️ The first byte (0-255) of the SHA-256 of a text. */
export function sha256FirstByteV1(text:string):number;
/** 🧵️ The hex SHA-256 of `first` (when given) and every text, each followed by the ASCII `delimiter`, as one string. */
export function sha256DelimitedHexV1(texts:readonly string[],delimiter:string,first?:string):string;
/** ⚖️ Orders two texts by their UTF-8 bytes (-1, 0 or 1). */
export function compareUtf8V1(left:string,right:string):number;
/** 📜️ The UTF-8 text of bytes, without copying them. */
export function utf8TextV1(bytes:Uint8Array):string;
