{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "payload",
              "status",
              "signal",
              "frontend"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z-]+$"
              },
              "payload": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "signal": {
                "type": "null"
              },
              "frontend": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      }
    },
    "Outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "signal",
        "logPath",
        "pid",
        "args",
        "endedAt"
      ],
      "properties": {
        "status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "signal": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^SIG[A-Z0-9]+$"
        },
        "logPath": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "type": "integer"
            },
            "signal": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "type": "null"
            },
            "signal": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
