{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "limits",
    "owners"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSourceBytes",
        "maxSourceFiles",
        "maxActiveLines"
      ],
      "properties": {
        "maxSourceBytes": {
          "const": 262144
        },
        "maxSourceFiles": {
          "const": 32
        },
        "maxActiveLines": {
          "const": 4000
        }
      }
    },
    "owners": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "root",
          "dependencies",
          "declarations"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          },
          "declarations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
