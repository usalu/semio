{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "phases",
    "receipt",
    "initialStock"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owner": {
      "const": "semio-framework-job-worker"
    },
    "phases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "name",
          "classification"
        ],
        "properties": {
          "phase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "name": {
            "enum": [
              "transition",
              "idle",
              "submitted",
              "outcome",
              "terminal",
              "rejected",
              "checked-out",
              "close",
              "empty"
            ]
          },
          "classification": {
            "enum": [
              "empty",
              "borrow",
              "contention"
            ]
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "actual",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "#/definitions/receipt"
        },
        "actual": {
          "$ref": "#/definitions/receipt"
        },
        "after": {
          "$ref": "#/definitions/receipt"
        }
      }
    },
    "initialStock": {
      "const": [
        20000,
        16777216,
        16777216,
        16777216,
        128
      ]
    }
  },
  "definitions": {
    "receipt": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 16777216
      }
    }
  }
}
