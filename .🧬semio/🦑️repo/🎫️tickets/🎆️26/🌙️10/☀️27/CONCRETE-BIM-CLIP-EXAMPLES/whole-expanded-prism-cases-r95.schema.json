{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mesh",
          "outline",
          "accepted"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          },
          "outline": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "holes": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "mesh": {
            "type": "object",
            "required": [
              "vertices",
              "faces"
            ],
            "additionalProperties": false,
            "properties": {
              "vertices": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "faces": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}