{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "a",
          "b",
          "separated",
          "oracle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "object"
          },
          "b": {
            "type": "object"
          },
          "separated": {
            "type": "boolean"
          },
          "oracle": {
            "enum": [
              "polyhedron",
              "void",
              "circle_polygon",
              "circle_circle",
              "circle_hole"
            ]
          },
          "require_conservative_bounds": {
            "type": "boolean"
          },
          "numeric_zero_must_remain_unresolved": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
