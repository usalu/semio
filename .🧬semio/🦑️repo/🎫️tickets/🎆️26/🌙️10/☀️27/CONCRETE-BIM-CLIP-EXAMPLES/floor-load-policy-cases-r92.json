  "proposal": {
    "schema_first": true,
    "derived_component": "Replace the floor portion of the current generic finishes entry with spatially integrated authored first-floor FLOORING weight.",
    "residual_component": "If nonfloor finishes, partitions, fixed furnishings or unknown assemblies need an allowance, add an explicitly named, independently justified residual component. Do not retain the full1.5floor allowance and silently add physical floors.",
    "density_policy": "Material density fields are nominal unitweights in kN/m³, already gravitational weights; no9.81 multiplication. All retained materialweights assumed, not measured1930bulk mass.",
    "uncovered_policy": "Report structural area not covered by floor products separately; do not fill undercolumns/walls without identifying physical ownership.",
    "links": "Update slab-load storedanalytical links and bilingual assumptiontext after newpolicy calculation; not by manually forcing savedold total.",
    "status": "Research alternative only; superseded for current scope by current_acceptance_decision"
  },
  "acceptance": [
    {
      "id": "independent_part_weight",
      "method": "Firstpartyshoelace vsShapelypolygonarea×height×unitweight; exact per-material sums within floating tolerance."
    },
    {
      "id": "regional_conservation",
      "method": "Sum physical clipped regionalweights equals authored floorweight inside SL1; no extra global1.5 doublecount."
    },
    {
      "id": "spatial_not_mean_only",
      "method": "Nonuniform parquet/tile/paver fields produce local reactions from actual overlap, not merely globalmean replacement."
    },
    {
      "id": "scope_breadth",
      "method": "Floorcoveringsonly; wall/plaster/partitions/skirting/builtins/services/stairs and imposedloads are distinct and not certified by this fixture."
    }
  ],
  "current_acceptance_decision": {
    "owner": "root",
    "decision": "Preserve intentional uniform1.5kN/m² assumed teaching allowance. Clarify bilingually that physical floorcoverings are represented within this nominal allowance and are not additionally summed.",
    "status": "The numerical difference is not classified as a model error. No current doublecount exists. No additional mass term is requested.",
    "future_alternative": "Spatial floor-derived mode is only an optional future analytical policy requiring separate schema/acceptance; it is not part of the current requested change.",
    "source_assumption_published": "556/a3cedfef finish-load-ownership"
  },
