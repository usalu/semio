{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/repo/library/workspaces/cargo/preparation/custody/component.json",
  "title": "CargoPreparationCustody",
  "$defs": {
    "CargoPreparationInputV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "presence"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CargoPreparationObservationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "script",
        "command",
        "sources",
        "inputs",
        "outputs"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CargoPreparationInputV1"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/CargoPreparationInputV1"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/CargoPreparationInputV1"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/CargoPreparationObservationV1"
}
