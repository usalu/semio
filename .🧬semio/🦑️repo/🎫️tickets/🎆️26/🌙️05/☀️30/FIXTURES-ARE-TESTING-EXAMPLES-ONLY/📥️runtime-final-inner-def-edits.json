                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "elapsedUs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "terminalIndex": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 3,
                    "maximum": 15
                  },
                  "consecutive": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "longestRun": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0,
