[
  {
    "path": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🧾️yaml/🧬️schema/🔣️.json",
    "before": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://json.schemas.assets.semio-tech.com/repo/yaml/1",
      "title": "🧾️ Repo YAML codec fixtures and wire shapes",
      "description": "🧾️ The vector file the `🔁️codec-roundtrip` case reads and the projection every implementation of the codec must produce for it.",
      "type": "object",
      "$defs": {
        "CodecProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decoded"
          ],
          "description": "🎯️ One canonical-JSON rendering per vector, in vector order. Canonical means: object members sorted by key, integers without a fractional part, no insignificant whitespace — so the projection carries no host-language number or ordering artefacts.",
          "properties": {
            "decoded": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "📥️ `<vector name>=<canonical JSON of the decoded value>`, or `<vector name>!<error text prefix>` when the decoder rejects the document."
            }
          }
        },
        "RoundTripProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reDecoded"
          ],
          "description": "🔁️ The value obtained by decoding, re-encoding with the owned encoder, and decoding the result again.",
          "properties": {
            "reDecoded": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "🔁️ `<vector name>=<canonical JSON of the re-decoded value>`."
            }
          }
        }
      }
    },
    "removed": [
      "CodecVector",
      "CodecVectorFile"
    ]
  },
  {
    "path": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🔎️search/🧬️schema/🔣️.json",
    "before": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://json.schemas.assets.semio-tech.com/repo/search/1",
      "title": "🔎️ Repo search fixtures and wire shapes",
      "description": "🔎️ The ranking vector file the `🔍️ranked-search` case reads, the persisted index event, and the projection every implementation must produce.",
      "$defs": {
        "MatchTerm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "term",
            "fuzziness"
          ],
          "properties": {
            "term": {
              "type": "string"
            },
            "fuzziness": {
              "type": "integer",
              "minimum": 0,
              "description": "🎚️ The largest edit distance a word may be away from the term."
            }
          }
        },
        "IndexEvent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "seq",
            "kind",
            "id"
          ],
          "description": "📨️ One line of the persisted append-only index log.",
          "properties": {
            "schema": {
              "const": "semio.search.event/1"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "description": "🔢️ One-based, gapless; a gap is a corrupt index."
            },
            "kind": {
              "enum": [
                "indexed",
                "deleted"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            }
          }
        },
        "RankingProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rankings"
          ],
          "properties": {
            "rankings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "🎯️ `<vector name>=<total>:<id>@<score>,<id>@<score>…` — the total counted before truncation, then the retained hits best first."
            }
          }
        }
      }
    },
    "removed": [
      "RankingVector",
      "RankingVectorFile"
    ]
  },
  {
    "path": "🧰️framework/🛍️products/🦑️repo/🔨️modules/🗂️codebase/🧬️schema/🔣️.json",
