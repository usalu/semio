                "type": "string"
              }
            },
            "bundles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "🧱️ One `id|folder|folders|files|lines` line per bundle, in aggregate order."
            },
            "folders": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "📁️ One `path|id|files|lines` line per folder, in aggregate order."
            }
          }
        },
        "IdProjection": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "🪪️ What the artifact-id-builders case projects: one `name=id` entry per vector, in vector order.",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "uris": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "DetectionProjection": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "📦️ What the technology-bundle-detection case projects: one line per technology and one per bundle, in detection order.",
          "properties": {
            "technologies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "bundles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "IgnoreProjection": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "🙈️ What the ignore-integration case projects: one `name=excluded,gitignored,generated` entry per vector, plus the kept and dropped halves of a filtered walk.",
          "properties": {
            "verdicts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kept": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dropped": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RepoTree"
        }
      ]
    },
    "removed": [
      "ArtifactIdVector",
      "ArtifactIdVectors",
      "IgnoreVector",
      "IgnoreVectors"
    ]
  },
  {
    "path": "🧰️framework/🔨️modules/🧵️job/⏱️budget/🧬️schema/🔣️.json",
    "before": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "https://json.schemas.assets.semio-tech.com/framework/job/budget/schema.json",
      "title": "Job Budget Schema Module",
      "definitions": {
        "u64": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "unsigned": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "$defs": {
        "Budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "unit",
            "cases"
          ],
          "properties": {
            "$schema": {
              "const": "https://json.schemas.assets.semio-tech.com/framework/job/budget/schema.json#/$defs/Budget"
            },
            "unit": {
              "const": "microseconds"
            },
            "cases": {
              "type": "array",
              "minItems": 9,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "start",
                  "grant",
                  "fuel",
                  "deadline",
                  "samples",
                  "expired",
                  "yielded"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "$ref": "#/definitions/u64"
                  },
                  "grant": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 7500
                  },
                  "fuel": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "deadline": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/u64"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "samples": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/definitions/u64"
                    }
                  },
                  "expired": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "boolean"
                    }
                  },
                  "yielded": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "Clock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "browser",
            "wasi",
            "installation",
            "watchdog"
          ],
          "properties": {
            "$schema": {
              "const": "https://json.schemas.assets.semio-tech.com/framework/job/budget/schema.json#/$defs/Clock"
            },
            "browser": {
              "type": "array",
              "minItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "milliseconds",
                  "microseconds"
                ],
                "properties": {
                  "milliseconds": {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  },
                  "microseconds": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/unsigned"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "watchdog": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "elapsedMicroseconds",
                  "violated"
                ],
                "properties": {
                  "elapsedMicroseconds": {
                    "$ref": "#/definitions/unsigned"
                  },
                  "violated": {
                    "type": "boolean"
                  }
                }
              }
            },
            "installation": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "current",
                  "requested",
                  "accepted",
                  "retained"
                ],
                "properties": {
                  "current": {
                    "enum": [
                      null,
                      "browser",
                      "foreign"
                    ]
                  },
                  "requested": {
                    "enum": [
                      "browser",
                      "foreign"
                    ]
                  },
                  "accepted": {
                    "type": "boolean"
                  },
                  "retained": {
                    "enum": [
                      "browser",
                      "foreign"
                    ]
                  }
                }
              }
            },
            "wasi": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nanoseconds",
                  "accepted"
                ],
                "properties": {
                  "nanoseconds": {
                    "$ref": "#/definitions/unsigned"
                  },
                  "accepted": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "Binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$schema",
            "cases"
          ],
          "properties": {
            "$schema": {
              "const": "https://json.schemas.assets.semio-tech.com/framework/job/budget/schema.json#/$defs/Binding"
            },
            "cases": {
              "type": "array",
              "minItems": 9,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mutation",
                  "admitted"
                ],
                "properties": {
                  "mutation": {
                    "enum": [
                      "none",
                      "wrong-helper",
                      "divided-grant",
                      "rounded-grant",
                      "coarse-clock",
                      "overflow-fallback",
                      "expired-entry",
                      "synthetic-clock",
                      "missing-output-limit"
                    ]
                  },
                  "admitted": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "removed": [
      "Budget",
      "Clock",
      "Binding"
    ]
  },
