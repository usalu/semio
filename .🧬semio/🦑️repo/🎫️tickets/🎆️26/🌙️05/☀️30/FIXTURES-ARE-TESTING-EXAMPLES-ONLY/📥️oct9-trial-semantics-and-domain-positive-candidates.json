    {
      "id": "fixed-expected-bounds-envelope",
      "source": "import trial from \"./examples.json\";import trialSchema from \"./trial.json\";const admit=new Ajv().compile(trialSchema);admit(trial);for(const row of trial){const actual=computeBounds(row.record);expect(actual).toEqual(row.bounds);}",
      "classification": "whole trial when trialSchema admits name+record+expected bounds and no actual domain contract"
    },
    {
      "id": "actual-produced-bounds-report",
      "source": "import reportSchema from \"./report.json\";export function validateReport(value){return new Ajv().compile(reportSchema)(value)};const result={name:job.id,record:job.record,bounds:job.bounds};validateReport(result);",
      "classification": "genuine produced Report even same-shaped; domain owner plus actual production caller join"
    },
    {
      "id": "handoff-count-trial",
      "source": "import vectors from \"./examples.json\";new Ajv().compile(schema)(vectors);for(const row of vectors){const actual=run(row.source);expect(actual.parents).toBe(row.parents)}",
      "classification": "whole trial; source selects another original example, parents is expected result"
    },
    {
      "id": "dependency-parent-report",
      "source": "export const admitDependencyParents=new Ajv().compile(schema);const rows=collectActualDependencies();admitDependencyParents(rows);",
      "classification": "genuine runtime dependency report despite source/parents cardinality shape"
    },
    {
      "id": "fixture-row-selector",
      "source": "new Ajv().compile({$defs:schema.$defs,$ref:\"#/$defs/Grant\"})(fixture.grant);",
      "classification": "genuine individual Grant projection; enclosing law properties irrelevant to selected contract"
    },
    {
      "id": "law-root-selector",
      "source": "new Ajv().compile(schema)(fixture);",
      "classification": "whole trial only after selected root includes fixed grant/refusal/expected outcome schedules"
    },
    {
      "id": "runtime-request-whole",
      "source": "export const admit=new Ajv().compile(requestSchema);admit(fixture);",
