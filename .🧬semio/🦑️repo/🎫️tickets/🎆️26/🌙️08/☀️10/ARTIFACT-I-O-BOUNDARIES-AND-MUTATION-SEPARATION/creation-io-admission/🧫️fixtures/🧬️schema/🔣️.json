{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://test/creation-io-admission/v1",
  "title": "Creation IO Admission Test Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sources",
    "operation",
    "cancellations"
  ],
  "properties": {
    "schema": {
      "const": "semio.test.creation-io-admission/v1"
    },
    "sources": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "cancellations": {
      "type": "string",
      "minLength": 1
    }
  }
}
