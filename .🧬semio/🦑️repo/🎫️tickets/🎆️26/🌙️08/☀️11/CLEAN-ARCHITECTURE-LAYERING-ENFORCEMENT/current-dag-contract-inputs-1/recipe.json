\"expected\"].as_str().expect(\"wire\").as_bytes());\n        let mut cursor = DagSelectedNodesJsonCursor::default();\n        let mut output = Vec::new();\n        let mut census = None;\n        let mut complete = false;\n        for _ in 0..4096 {\n            match cursor.step(&host, cursor_grant()).expect(\"one-unit grant\") {\n                DagCursorStep::Census { bytes } => census = Some(bytes),\n                DagCursorStep::Byte(byte) => output.push(byte),\n                DagCursorStep::Complete => { complete = true; break; }\n                DagCursorStep::Progress { .. } => {}\n            }\n        }\n        assert!(complete, \"bounded selection wire completes\");\n        assert_eq!(census, Some(oracle.len()));\n        assert_eq!(output, oracle);\n        assert_eq!(cursor.step(&host, cursor_grant()), Ok(DagCursorStep::Complete));\n    }\n}\n"}, {"path": "🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/🗿️artifacts/🕸️dag/🧬️schema/📸️snapshot/🦀️.rs", "replacements": [{"from": "dag.host_snapshot", "to": "dag.hostDocument", "count": 1}]}, {"path": "🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/🗿️artifacts/🕸️dag/🧫️fixtures/🪶️sqlite/🔣️.json", "replacements": [{"from": "dag.host_snapshot", "to": "dag.hostDocument", "count": 1}]}, {"path": "🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/🗿️artifacts/🕸️dag/🧫️fixtures/📥️host-kind-admission/🔣️.json", "replacements": [{"from": "dag.host_snapshot", "to": "dag.hostDocument", "count": 15}]}, {"path": "🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/🗿️artifacts/🕸️dag/🚪️io/💾️binary/📸️snapshot/🦀️.rs", "replacements": [{"from": "dag.host_snapshot", "to": "dag.hostDocument", "count": 2}]}, {"path": "🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/🗿️artifacts/🕸️dag/🌿️vcs/🦀️.rs", "replacements": [{"from": "dag.host_snapshot", "to": "dag.hostDocument", "count": 1}]}, {"path": "🧰️framework/🛍️products/💻️os/🔨️modules/♾️infinite/🗿️artifacts/🕸️dag/🚪️io/🪶️sqlite/📸️snapshot/🧪️tests/🦀️.rs", "replacements": [{"from": "dag