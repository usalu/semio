{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "surface-node-graph-error/v1"
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "message"
        ],
        "properties": {
          "kind": {
            "enum": [
              "Json",
              "Pack",
              "Dag"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
