{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owner", "borrowedSource", "ownedSource", "refusalKind", "messageClassification", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owner": { "const": "semio-framework-value" },
    "borrowedSource": { "const": "std::str::Utf8Error" },
    "ownedSource": { "const": "std::string::FromUtf8Error" },
    "refusalKind": { "const": "invalidValue" },
    "messageClassification": { "const": false },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "bytes", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "bytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "kind", "display"],
            "properties": { "text": { "type": ["string", "null"] }, "kind": { "enum": ["invalidValue", null] }, "display": { "type": ["string", "null"] } },
            "anyOf": [
              { "properties": { "text": { "type": "string" }, "kind": { "type": "null" }, "display": { "type": "null" } } },
              { "properties": { "text": { "type": "null" }, "kind": { "const": "invalidValue" }, "display": { "type": "string", "minLength": 1 } } }
            ]
          }
        }
      }
    }
  }
}
