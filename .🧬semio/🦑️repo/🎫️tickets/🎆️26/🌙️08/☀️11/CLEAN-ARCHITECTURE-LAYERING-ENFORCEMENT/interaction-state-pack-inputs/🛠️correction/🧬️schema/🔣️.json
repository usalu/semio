{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rootFields", "selectionFields", "limits", "cases"],
  "properties": {
    "version": {"const": 1},
    "rootFields": {"const": ["activeGranularity", "activeMode", "hover", "selection"]},
    "selectionFields": {"const": {"present": ["anchorId", "granularity", "ids"], "absent": ["granularity", "ids"]}},
    "limits": {"const": {"maximumBytes": 100000, "maximumNodes": 2000, "maximumDepth": 32, "chunk": 128}},
    "cases": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "source"],
        "properties": {
          "id": {"enum": ["original-store-oracle", "no-anchor", "empty-state", "unicode-and-nul"]},
          "source": {"type": "string", "minLength": 1, "maxLength": 50000}
        }
      }
    }
  }
}
