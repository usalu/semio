{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/dsl/record/field-refusal",
  "type": "object",
  "additionalProperties": false,
  "required": ["kinds", "paths"],
  "properties": {
    "kinds": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["InvalidValue", "Canceled", "OwnershipLimit", "AllocationFailed", "WorkLimit", "DepthLimit", "UnsupportedOwner", "InvariantViolated"]
      }
    },
    "paths": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "boxed", "message", "under", "expectedMessage"],
        "properties": {
          "method": { "enum": ["projectValue", "projectRecord", "constructValue", "constructRecord"] },
          "boxed": { "type": "boolean" },
          "message": { "const": "refused field" },
          "under": { "const": "field" },
          "expectedMessage": { "const": "field.refused field" }
        }
      }
    }
  }
}
