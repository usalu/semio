{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "literal"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "path",
                    "include",
                    "include_str",
                    "include_bytes"
                  ]
                },
                "literal": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}