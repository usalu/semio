{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.semio.tech/framework/ui/render/exact-composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "cases"],
  "properties": {
    "contract": { "const": "neutral-render-exact-composition/v1" },
    "cases": {
      "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "edits", "expected"],
        "properties": {
          "id": { "enum": ["disjoint", "foreign-conserved", "moved-owner", "already-canonical", "ambiguous", "overlap", "deletion"] },
          "source": { "type": "string" },
          "edits": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "type": "string", "minLength": 1 }, { "type": "string" }], "items": false } },
          "expected": { "type": ["string", "null"] }
        }
      }
    }
  }
}
