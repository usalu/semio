{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "fields",
    "order",
    "callers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owner": {
      "const": "PreparedBrowserCanvas"
    },
    "fields": {
      "const": [
        "surface",
        "renderer",
        "render_ctx",
        "canvas"
      ]
    },
    "order": {
      "const": [
        "adapter",
        "surface",
        "renderer",
        "publication"
      ]
    },
    "callers": {
      "const": [
        "editor",
        "paint",
        "map",
        "graph",
        "dag",
        "flow"
      ]
    }
  }
}
