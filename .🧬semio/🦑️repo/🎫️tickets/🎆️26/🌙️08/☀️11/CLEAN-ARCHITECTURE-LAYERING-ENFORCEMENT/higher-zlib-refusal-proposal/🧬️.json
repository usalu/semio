{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/stdio/deflate/bare-refusal",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "operation",
      "inputHex",
      "maximumBytes",
      "maximumOutput",
      "maximumFile",
      "accept",
      "expected"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "operation": {
        "enum": [
          "decompress",
          "compress"
        ]
      },
      "inputHex": {
        "type": "string",
        "pattern": "^([0-9a-f]{2})*$"
      },
      "maximumBytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65536
      },
      "maximumOutput": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65536
      },
      "maximumFile": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65536
      },
      "accept": {
        "type": "boolean"
      },
      "expected": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "$ref": "https://semio.tech/schema/value/refusal#/$defs/kind"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hex"
            ],
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              }
            }
          }
        ]
      }
    }
  }
}