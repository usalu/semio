{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestPath",
    "binary",
    "cwd"
  ],
  "properties": {
    "manifestPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])[^\\u0000]*$"
    },
    "binary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])[^\\u0000]*$"
    }
  }
}

