{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nativeSource",
    "cases",
    "controls"
  ],
  "properties": {
    "schema": {
      "const": "semio.mutation-inventory.cargo-command/v1"
    },
    "nativeSource": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv",
          "code"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 4,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "code": {
            "enum": [
              0,
              7
            ]
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "enum": [
          "missing-policy",
          "mismatched-policy",
          "relative-manifest",
          "unknown-request-field",
          "mismatched-compiler-storage"
        ]
      },
      "uniqueItems": true
    }
  }
}
