{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "row",
          "held",
          "refused"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "held": {
            "type": [
              "string",
              "null"
            ]
          },
          "refused": {
            "type": "boolean"
          },
          "row": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "before",
              "after",
              "beforeHash",
              "afterHash"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "before": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "after": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "beforeHash": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                ]
              },
              "afterHash": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}