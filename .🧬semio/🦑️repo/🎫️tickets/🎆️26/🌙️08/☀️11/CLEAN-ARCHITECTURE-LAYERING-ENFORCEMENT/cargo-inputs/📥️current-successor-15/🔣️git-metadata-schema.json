{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semio:repo:active-git-metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "required",
    "optional"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z.-]*$"
      }
    },
    "optional": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z.-]*$"
      }
    }
  }
}