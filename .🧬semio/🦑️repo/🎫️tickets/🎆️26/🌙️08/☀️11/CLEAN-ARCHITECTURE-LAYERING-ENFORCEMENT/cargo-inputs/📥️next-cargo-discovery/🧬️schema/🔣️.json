{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspace",
    "files",
    "owners",
    "packages",
    "discovery",
    "blockedDepth"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "packages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumUnits",
        "maximumOwnedBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumUnits": {
          "const": 8388608
        },
        "maximumOwnedBytes": {
          "const": 67108864
        },
        "maximumDepth": {
          "const": 64
        }
      }
    },
    "blockedDepth": {
      "const": 65
    }
  }
}
