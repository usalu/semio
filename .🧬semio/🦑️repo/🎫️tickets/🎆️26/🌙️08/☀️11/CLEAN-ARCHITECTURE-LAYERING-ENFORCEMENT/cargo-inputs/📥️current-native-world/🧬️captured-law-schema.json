{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:world-live-captured-authority-laws",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceFixture",
    "cases",
    "replacementId",
    "replacementOwner",
    "maximumTurns"
  ],
  "properties": {
    "sourceFixture": {
      "const": "🎯️component-selection-merges/🔣️.json"
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "accepted"
        ],
        "properties": {
          "scenario": {
            "enum": [
              "view-revision",
              "selection-replacement",
              "surface-replacement",
              "controller-replacement"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "replacementId": {
      "type": "string",
      "minLength": 1
    },
    "replacementOwner": {
      "type": "string",
      "minLength": 1
    },
    "maximumTurns": {
      "const": 4096
    }
  }
}
