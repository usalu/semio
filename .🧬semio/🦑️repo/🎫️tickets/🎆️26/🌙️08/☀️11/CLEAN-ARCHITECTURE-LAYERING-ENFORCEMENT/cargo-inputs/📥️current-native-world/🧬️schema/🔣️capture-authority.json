{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:world-gumball-captured-command-authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surfaceId",
    "controllerId",
    "mode",
    "targets",
    "maximumBytes",
    "copyBytesPerFuel",
    "publication",
    "retirement"
  ],
  "properties": {
    "surfaceId": {
      "type": "string",
      "maxLength": 256
    },
    "controllerId": {
      "type": "string",
      "maxLength": 256
    },
    "mode": {
      "enum": [
        "mesh",
        "vertex",
        "edge",
        "face"
      ]
    },
    "targets": {
      "type": "array",
      "maxItems": 245,
      "items": {
        "type": "string"
      }
    },
    "maximumBytes": {
      "const": 16384
    },
    "copyBytesPerFuel": {
      "const": 1
    },
    "publication": {
      "const": "immutable-shared-owned-start-ids"
    },
    "retirement": {
      "const": "one-target-per-turn-then-shared-owner-release"
    }
  }
}
