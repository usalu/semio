{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "occupiedPaths",
    "collisions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "occupiedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
