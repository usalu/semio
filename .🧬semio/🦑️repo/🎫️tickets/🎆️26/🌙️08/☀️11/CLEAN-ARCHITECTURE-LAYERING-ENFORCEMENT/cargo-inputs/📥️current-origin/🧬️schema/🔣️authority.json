{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "at",
    "rows",
    "inputs",
    "callerFrames",
    "laws",
    "controls",
    "driver",
    "sourceWrites",
    "publicationReady"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "at": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before",
          "beforeHash",
          "after",
          "afterHash",
          "origin"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": [
              "string",
              "null"
            ]
          },
          "beforeHash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "after": {
            "type": "string"
          },
          "afterHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "origin": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source",
          "hash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "callerFrames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source",
          "hash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "laws": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testLevel",
        "bunTimeoutMilliseconds",
        "discovery"
      ],
      "properties": {
        "testLevel": {
          "const": "long"
        },
        "bunTimeoutMilliseconds": {
          "const": 60000
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumUnits",
            "maximumOwnedBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumUnits": {
              "const": 8388608
            },
            "maximumOwnedBytes": {
              "const": 67108864
            },
            "maximumDepth": {
              "const": 64
            }
          }
        }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceWrites": {
      "const": 0
    },
    "publicationReady": {
      "const": false
    }
  }
}
