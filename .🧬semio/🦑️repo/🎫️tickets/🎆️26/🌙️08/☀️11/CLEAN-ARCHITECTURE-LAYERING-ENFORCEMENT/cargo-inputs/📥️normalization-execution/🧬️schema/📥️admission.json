{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:repo:normalization:execution-admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "argv",
    "snapshot",
    "sourceFrames",
    "physicalInputFrames",
    "diagnostics",
    "execution",
    "authority",
    "refinement",
    "schemaAuthority",
    "cliAuthority",
    "cargoDiagnostic",
    "scopedSelection",
    "sourceWrites",
    "sourceReady",
    "callerReady",
    "publicationReady",
    "scope"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "snapshot": {
      "type": "string"
    },
    "sourceFrames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "origin",
          "entry",
          "encoding",
          "sourceHash",
          "bytes",
          "fullBodyCopy",
          "fullBodyHash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": [
              "string",
              "null"
            ]
          },
          "encoding": {
            "enum": [
              "utf8",
              "base64"
            ]
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "fullBodyCopy": {
            "type": "string",
            "minLength": 1
          },
          "fullBodyHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "physicalInputFrames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "origin",
          "sealedCopy",
          "hash",
          "bytes",
          "scope"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "sealedCopy": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "scope": {
            "type": "string"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array"
    },
    "execution": {
      "type": "object"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "refinement": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaAuthority": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cliAuthority": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cargoDiagnostic": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scopedSelection": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceWrites": {
      "const": 0
    },
    "sourceReady": {
      "const": false
    },
    "callerReady": {
      "const": false
    },
    "publicationReady": {
      "const": false
    },
    "scope": {
      "type": "string"
    }
  }
}
