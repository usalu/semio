{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "owned",
          "selected",
          "current",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "receiving-red",
              "receiving-test",
              "metadata-red",
              "metadata-test",
              "stage",
              "inspect",
              "whole",
              "preparation-test",
              "preparation-worker"
            ]
          },
          "owned": {
            "type": "boolean"
          },
          "selected": {
            "type": "boolean"
          },
          "current": {
            "type": "boolean"
          },
          "expected": {
            "enum": [
              "current",
              "qualified",
              "refused"
            ]
          }
        }
      }
    }
  }
}
