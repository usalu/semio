{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "identified-patchable-collection/v1"
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value",
          "other",
          "delta"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          },
          "other": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          },
          "delta": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -2000,
                "maximum": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
