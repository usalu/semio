{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mode",
    "criticalSources"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "const": "exact-feature-observed-transitive"
    },
    "criticalSources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
