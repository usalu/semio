{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/compiler/rust/path-references",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "roots",
    "cases",
    "invalidRoots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "expected",
          "sourceScope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "expected": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            }
          },
          "sourceScope": {
            "enum": [
              "file",
              "crate"
            ]
          }
        }
      }
    },
    "invalidRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "roots",
          "refusal"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "roots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "refusal": {
            "const": "invalid-root"
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "path",
        "root",
        "call",
        "context",
        "start",
        "end",
        "line",
        "origin"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "call": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "enum": [
            "method",
            "qualified"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based UTF-16 source offset"
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "description": "Exclusive UTF-16 source offset"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "literal"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "definition"
              ],
              "properties": {
                "kind": {
                  "const": "constant"
                },
                "definition": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "start",
                    "end",
                    "line"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}