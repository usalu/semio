{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "current",
          "authored",
          "expectedAccept",
          "targetOverride"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "current": {
            "type": "string"
          },
          "authored": {
            "type": "string"
          },
          "expectedAccept": {
            "type": "boolean"
          },
          "targetOverride": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}