{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/os/cli/transport/tests.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array", "minItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "args", "result"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "args": {"type": "array", "items": {"type": "string"}},
          "result": {"enum": ["help", "run", "refusal"]},
          "credit": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "inputCredit": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "refusal": {"enum": ["MissingCredit", "MissingInput", "MissingTimeout", "InvalidCredit", "InvalidInput", "InvalidTimeout", "DuplicateCredit", "DuplicateInput", "DuplicateTimeout", "MissingCommand"]}
        },
        "allOf": [
          {"if": {"properties": {"result": {"const": "run"}}}, "then": {"required": ["credit", "inputCredit", "timeoutMs", "command"], "properties": {"credit": true, "inputCredit": true, "timeoutMs": true, "command": true, "refusal": false}}},
          {"if": {"properties": {"result": {"const": "refusal"}}}, "then": {"required": ["refusal"], "properties": {"refusal": true, "credit": false, "inputCredit": false, "timeoutMs": false, "command": false}}},
          {"if": {"properties": {"result": {"const": "help"}}}, "then": {"properties": {"credit": false, "inputCredit": false, "timeoutMs": false, "command": false, "refusal": false}}}
        ]
      }
    }
  }
}
