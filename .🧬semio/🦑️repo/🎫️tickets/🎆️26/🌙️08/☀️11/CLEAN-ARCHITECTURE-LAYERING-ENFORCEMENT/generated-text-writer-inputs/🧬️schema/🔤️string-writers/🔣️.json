          },
          "returnType": {
            "enum": [
              "String",
              "Result<String, semio_framework_value::ValueError>",
              "Result<String, String>",
              "Result<String, String>",
              "Result<String, String>",
              "Result<String, String>"
            ]
          },
          "preserved": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
