{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "direct await",
      "source": "async function main(){await owned();}",
      "expression": "owned()",
      "expectedRole": "awaited",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": true,
      "rejects": false
    },
    {
      "name": "dropped promise",
      "source": "async function main(){owned();}",
      "expression": "owned()",
      "expectedRole": "requires-owned-await-decision",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": false,
      "rejects": false
    },
    {
      "name": "consumed global aggregation",
      "source": "async function main(){await Promise.all([owned()]);}",
      "expression": "owned()",
      "expectedRole": "aggregated-promise",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": true,
      "rejects": false
    },
    {
      "name": "discarded global aggregation",
      "source": "async function main(){Promise.all([owned()]);}",
      "expression": "owned()",
      "expectedRole": "requires-owned-await-decision",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": false,
      "rejects": false
    },
    {
      "name": "shadowed aggregation",
      "source": "async function main(){const Promise={all:(values:unknown[])=>values};await Promise.all([owned()]);}",
      "expression": "owned()",
      "expectedRole": "requires-owned-await-decision",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": false,
      "rejects": false
    },
    {
      "name": "Bun owned rejection matcher",
      "source": "import {expect} from \"bun:test\";async function main(){await expect(owned()).rejects.toThrow();}",
      "expression": "owned()",
      "expectedRole": "awaited-owned-matcher",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": true,
      "rejects": true
    },
    {
      "name": "shadowed rejection matcher",
      "source": "async function main(){function expect(_:unknown){return {rejects:{toThrow:()=>{}}};}await expect(owned()).rejects.toThrow();}",
      "expression": "owned()",
      "expectedRole": "requires-owned-await-decision",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": false,
      "rejects": true
    },
    {
      "name": "immediate bound promise",
      "source": "async function main(){const pending=owned();await pending;}",
      "expression": "owned()",
      "expectedRole": "immediately-awaited-binding",
