      "completesBeforeReturn": true,
      "rejects": false
    },
    {
      "name": "discarded native promise adoption",
      "source": "async function main(){Promise.resolve(owned());}",
      "expression": "owned()",
      "expectedRole": "requires-owned-await-decision",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": false,
      "rejects": false
    },
    {
      "name": "shadowed promise adoption",
      "source": "async function main(){const Promise={resolve:(_:unknown)=>0};await Promise.resolve(owned());}",
