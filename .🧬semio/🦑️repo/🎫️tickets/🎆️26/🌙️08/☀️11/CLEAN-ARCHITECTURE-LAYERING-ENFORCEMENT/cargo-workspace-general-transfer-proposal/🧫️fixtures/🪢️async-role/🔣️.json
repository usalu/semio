      "completesBeforeReturn": true,
      "rejects": false
    },
    {
      "name": "discarded bound promise",
      "source": "async function main(){const pending=owned();void pending;}",
      "expression": "owned()",
      "expectedRole": "requires-owned-await-decision",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": false,
      "rejects": false
    },
    {
      "name": "forwarded return promise",
      "source": "async function main(){function forward(){return owned();}await forward();}",
      "expression": "owned()",
      "expectedRole": "returned-promise",
      "expectedKind": "FunctionDeclaration",
      "completesBeforeReturn": true,
      "rejects": false
    },
    {
      "name": "constructor-owned inherited run",
      "source": "async function main(){class Base{async run(){await owned();}}class Derived extends Base{}await new Derived().run();}",
      "expression": "new Derived().run()",
      "expectedRole": "awaited",
      "expectedKind": "MethodDeclaration",
      "completesBeforeReturn": true,
      "rejects": false
    },
    {
      "name": "owned override run",
      "source": "async function main(){class Base{async run(){await owned();}}class Derived extends Base{async run(){await super.run();}}await new Derived().run();}",
      "expression": "new Derived().run()",
      "expectedRole": "awaited",
      "expectedKind": "MethodDeclaration",
      "completesBeforeReturn": true,
      "rejects": false
    },
    {
      "name": "typed injectable promise callback",
      "source": "async function main(){async function invoke(run:()=>Promise<void>=owned){await run();}await invoke();}",
      "expression": "run()",
