{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases",
    "directoryNames",
    "directoryReplay",
    "rootIsolation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "directoryReplay":{"type":"object","additionalProperties":false,"required":["owners","sameEntries"],"properties":{"owners":{"const":1},"sameEntries":{"const":true}}},
    "rootIsolation":{"const":"refused"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "accepted": {
            "type": "boolean"
          },
          "expected": {}
        },
        "oneOf": [
          {
            "properties": {
              "source": {
                "type": "string"
              }
            },
            "required": [
              "source"
            ]
          },
          {
            "properties": {
              "hex": {
                "type": "string"
              }
            },
            "required": [
              "hex"
            ]
          }
        ]
      }
    },
    "directoryNames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
