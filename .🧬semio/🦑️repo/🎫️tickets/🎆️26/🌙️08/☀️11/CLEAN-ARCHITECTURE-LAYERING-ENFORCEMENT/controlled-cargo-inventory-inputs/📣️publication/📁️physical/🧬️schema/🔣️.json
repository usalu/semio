{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "cases"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "members",
          "exclude",
          "foreign",
          "accepted",
          "written"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "check",
              "write"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "foreign": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean"
          },
          "written": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
