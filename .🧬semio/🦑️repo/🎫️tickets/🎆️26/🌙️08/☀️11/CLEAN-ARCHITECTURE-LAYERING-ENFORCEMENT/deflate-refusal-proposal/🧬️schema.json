{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/deflate/controlled-refusal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "callbacks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "admit",
              "checkpoint"
            ]
          },
          "kind": {
            "enum": [
              "invalidValue",
              "canceled",
              "ownershipLimit",
              "allocationFailed",
              "workLimit",
              "depthLimit",
              "unsupportedOwner",
              "invariantViolated"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "checkpointCount": {
            "enum": [
              1,
              2
            ]
          },
          "admissionCount": {
            "enum": [
              0,
              1
            ]
          }
        },
        "required": [
          "id",
          "mode",
          "kind",
          "message",
          "checkpointCount",
          "admissionCount"
        ]
      }
    },
    "owned": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "match-work-overflow",
              "position-allocation-overflow"
            ]
          },
          "kind": {
            "enum": [
              "workLimit",
              "allocationFailed"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "message"
        ]
      }
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        },
        "required": [
          "id",
          "hex",
          "repeat"
        ]
      }
    },
    "retained": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "reason",
          "requestedBytes",
          "allocatedBytes"
        ],
        "properties": {
          "id": {
            "enum": [
              "allocator-refused",
              "physical-ceiling"
            ]
          },
          "kind": {
            "enum": [
              "allocationFailed",
              "ownershipLimit"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "requestedBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "allocatedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32768
          }
        }
      }
    }
  },
  "required": [
    "version",
    "callbacks",
    "owned",
    "samples",
    "retained"
  ]
}
