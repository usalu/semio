{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.directory.admitted-checkpoint-selection.v1",
  "title": "Admitted Checkpoint Selection V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpointId",
    "descriptorDigestV1",
    "baselineFrontier",
    "aggregateSha256"
  ],
  "properties": {
    "checkpointId": {
      "$ref": "#/$defs/ArtifactHash"
    },
    "descriptorDigestV1": {
      "$ref": "#/$defs/ArtifactHash"
    },
    "aggregateSha256": {
      "$ref": "#/$defs/ArtifactHash"
    },
    "baselineFrontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "headEditOrdinal",
        "headEditId",
        "lastCommitSeq",
        "chainHash"
      ],
      "properties": {
        "documentId": {
          "type": "string"
        },
        "headEditOrdinal": {
          "type": "integer",
          "minimum": 0
        },
        "headEditId": {
          "type": "string"
        },
        "lastCommitSeq": {
          "type": "integer",
          "minimum": 0
        },
        "chainHash": {
          "$ref": "#/$defs/ArtifactHash"
        }
      }
    }
  },
  "$defs": {
    "ArtifactHash": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
