{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "base",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot",
        "specs",
        "units",
        "required"
      ],
      "properties": {
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "specs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "package",
              "sources"
            ],
            "properties": {
              "package": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sources"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mutation",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mutation": {
            "enum": [
              "none",
              "missing-optional",
              "required-uncompiled",
              "duplicate-spec",
              "duplicate-unit",
              "ambiguous-unit",
              "foreign-selected-source",
              "empty-required",
              "unknown-required",
              "empty-unit",
              "escaped-selected-root",
              "unknown-root-unit"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
