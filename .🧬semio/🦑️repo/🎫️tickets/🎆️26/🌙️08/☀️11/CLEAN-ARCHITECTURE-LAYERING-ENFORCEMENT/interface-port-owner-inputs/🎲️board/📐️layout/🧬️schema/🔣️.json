{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "handles"],
  "properties": {
    "nodes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "x", "y"], "properties": {"id": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}}}},
    "handles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "angle"], "properties": {"id": {"type": "string"}, "angle": {"type": "number"}}}}
  }
}
