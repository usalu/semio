{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "$id":"https://semio.tech/schema/dsl/conformance-generic-specimens",
 "oneOf":[{"$ref":"#/$defs/workflowCase"},{"$ref":"#/$defs/collectionCase"}],
 "$defs":{
  "workflowCase":{"type":"object","additionalProperties":false,"required":["schemaVersion","envelope","snapshot"],"properties":{"schemaVersion":{"const":1},"envelope":{"const":"os.workflow"},"snapshot":{"$ref":"#/$defs/workflow"}}},
  "collectionCase":{"type":"object","additionalProperties":false,"required":["schemaVersion","envelope","snapshot"],"properties":{"schemaVersion":{"const":1},"envelope":{"const":"os.collection"},"snapshot":{"$ref":"#/$defs/collection"}}},
  "empty":{"type":"array","maxItems":0},
  "workflow":{"type":"object","additionalProperties":false,"required":["schema","graph","parameters","parameter_bindings","inputs","input_bindings","output_bindings"],"properties":{"schema":{"const":"os.workflow"},"graph":{"type":"object","additionalProperties":false,"required":["schema","nodes","edges"],"properties":{"schema":{"const":"workflow.graph"},"nodes":{"$ref":"#/$defs/empty"},"edges":{"$ref":"#/$defs/empty"}}},"parameters":{"$ref":"#/$defs/empty"},"parameter_bindings":{"$ref":"#/$defs/empty"},"inputs":{"$ref":"#/$defs/empty"},"input_bindings":{"$ref":"#/$defs/empty"},"output_bindings":{"$ref":"#/$defs/empty"}}},
  "collection":{"type":"object","additionalProperties":false,"required":["schema","name","folders","entries"],"properties":{"schema":{"const":"os.collection"},"name":{"type":"string","minLength":1},"folders":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/folder"}},"entries":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/entry"}}}},
  "folder":{"type":"object","additionalProperties":false,"required":["id","parent_id","name"],"properties":{"id":{"type":"string"},"parent_id":{"type":["string","null"]},"name":{"type":"string"}}},
  "entry":{"type":"object","additionalProperties":false,"required":["id","folder_id","name","kind_id","body"],"properties":{"id":{"type":"string"},"folder_id":{"type":["string","null"]},"name":{"type":"string"},"kind_id":{"type":"string"},"body":{"oneOf":[{"$ref":"#/$defs/document"},{"$ref":"#/$defs/blob"}]}}},
  "document":{"type":"object","additionalProperties":false,"required":["kind","schema","document_id"],"properties":{"kind":{"const":"document"},"schema":{"type":"string"},"document_id":{"type":"string"}}},
  "blob":{"type":"object","additionalProperties":false,"required":["kind","blob"],"properties":{"kind":{"const":"blob"},"blob":{"type":"object","additionalProperties":false,"required":["hash","size","mediaType"],"properties":{"hash":{"type":"string"},"size":{"type":"integer","minimum":0},"mediaType":{"type":"string"}}}}}
 }
}
