{
  "name": "architecture-source-verification",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "bun ./📜️script.ts test", "forwardAllArgs": true }
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "bun ./📜️script.ts run", "forwardAllArgs": true }
    },
    "strict": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "bun ./📜️script.ts strict", "forwardAllArgs": true }
    }
  }
}
