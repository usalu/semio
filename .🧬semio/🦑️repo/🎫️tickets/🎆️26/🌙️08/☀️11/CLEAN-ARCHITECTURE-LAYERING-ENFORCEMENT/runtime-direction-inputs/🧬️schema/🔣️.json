{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/research/runtime-direction/current-fixture-paths",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourcePath",
          "targetPath",
          "beforeLiteral",
          "afterLiteral",
          "occurrences"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          },
          "beforeLiteral": {
            "type": "string",
            "minLength": 1
          },
          "afterLiteral": {
            "type": "string",
            "minLength": 1
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          }
        }
      }
    }
  }
}
