{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "chunkBytes",
    "cases",
    "invalid"
  ],
  "additionalProperties": false,
  "properties": {
    "chunkBytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1048576
      },
      "minItems": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "invalid": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
