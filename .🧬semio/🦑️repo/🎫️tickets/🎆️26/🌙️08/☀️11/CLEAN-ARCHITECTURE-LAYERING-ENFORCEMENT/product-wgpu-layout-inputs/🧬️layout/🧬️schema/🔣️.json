{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "refusal"
                ],
                "properties": {
                  "refusal": {
                    "const": "LAYOUT_SUM"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "bytes",
                  "align",
                  "fields",
                  "padding"
                ],
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "align": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "padding": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "offset",
                        "bytes"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "bytes": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
