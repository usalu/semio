{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "maximumBytes",
    "maximumWork",
    "budgetMs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "physical-codecs/owners-1",
          "physical-codecs/general-1"
        ]
      }
    },
    "maximumBytes": {
      "const": 4294967296
    },
    "maximumWork": {
      "const": 200000
    },
    "budgetMs": {
      "const": 300000
    }
  }
}
