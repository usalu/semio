{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "before",
          "after"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
