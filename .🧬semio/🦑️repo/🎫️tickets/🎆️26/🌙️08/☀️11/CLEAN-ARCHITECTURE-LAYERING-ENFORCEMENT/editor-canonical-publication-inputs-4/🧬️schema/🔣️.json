{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pairs",
          "refused"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "refused": {
            "type": "boolean"
          },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "before",
                "after",
                "encoding",
                "beforeHash",
                "afterHash"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "before": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "after": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "encoding": {
                  "enum": [
                    "utf8",
                    "base64"
                  ]
                },
                "beforeHash": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                },
                "afterHash": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}