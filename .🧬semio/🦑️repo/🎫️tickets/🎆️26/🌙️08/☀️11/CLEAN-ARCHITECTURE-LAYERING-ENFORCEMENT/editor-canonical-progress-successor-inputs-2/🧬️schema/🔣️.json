{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "changedPaths",
    "addedPaths",
    "cases"
  ],
  "properties": {
    "changedPaths": {
      "const": [
        "main"
      ]
    },
    "addedPaths": {
      "const": []
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "before",
          "after",
          "refused"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "before": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Row"
            }
          },
          "after": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Row"
            }
          },
          "refused": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before",
        "after"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "before": {
          "type": [
            "string",
            "null"
          ]
        },
        "after": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
