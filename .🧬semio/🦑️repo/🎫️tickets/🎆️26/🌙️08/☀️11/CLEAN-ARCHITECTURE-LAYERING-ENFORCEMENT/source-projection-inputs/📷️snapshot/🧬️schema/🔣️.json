{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.semio.tech/framework/filesystem/source-projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "changes",
          "requests",
          "references",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "before",
                "after"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "before": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "after": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "requests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "target",
                "kind"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "files",
                  "inverse"
                ],
                "properties": {
                  "files": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "inverse": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "before",
                        "after"
                      ],
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "before": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "after": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "refusal"
                ],
                "properties": {
                  "refusal": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "code",
                      "path"
                    ],
                    "properties": {
                      "code": {
                        "enum": [
                          "invalid-path",
                          "duplicate-change",
                          "empty-change",
                          "predecessor-mismatch",
                          "deleted-reference",
                          "missing-reference"
                        ]
                      },
                      "path": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
