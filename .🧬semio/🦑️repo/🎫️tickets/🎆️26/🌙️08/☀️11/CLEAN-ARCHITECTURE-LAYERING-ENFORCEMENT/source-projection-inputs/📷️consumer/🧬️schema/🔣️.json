{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.semio.tech/framework/filesystem/source-projection/consumer",
  "type": "object", "additionalProperties": false, "required": ["retention", "paths"],
  "properties": {
    "retention": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "operation", "required", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["retain", "source", "require", "ancestor"] },
        "required": { "type": "boolean" },
        "expected": { "enum": ["omitted", "deleted-reference", "survivor"] }
      }
    } },
    "paths": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "platform", "root", "target", "canonical", "escaped"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "platform": { "enum": ["win32", "posix"] },
        "root": { "type": "string" }, "target": { "type": "string" }, "canonical": { "type": "string" }, "escaped": { "type": "boolean" }
      }
    } }
  }
}
