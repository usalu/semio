{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/io/refusal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cause",
    "diagnostics"
  ],
  "properties": {
    "cause": {
      "$ref": "https://semio.tech/schema/value/refusal/codec#/$defs/wire"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/diagnostic/controlled#/$defs/Diagnostic"
      }
    }
  }
}