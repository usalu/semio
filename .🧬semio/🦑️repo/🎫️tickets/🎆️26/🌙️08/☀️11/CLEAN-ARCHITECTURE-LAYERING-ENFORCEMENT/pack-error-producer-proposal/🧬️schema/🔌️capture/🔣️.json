{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://semio.dev/proposal/pack/transport/capture",
 "type":"object","additionalProperties":false,"required":["cases"],
 "properties":{"cases":{"type":"array","minItems":9,"maxItems":9,"items":{
  "type":"object","additionalProperties":false,
  "required":["id","category","retry","maximumBytes","ownedBefore","requestedBytes","allocatedBytes","cancelAt","cloneCount","expected"],
  "properties":{
   "id":{"type":"string","minLength":1},"category":{"enum":["nativeIo","httpRequest","httpBody"]},"retry":{"enum":["never","transient"]},
   "maximumBytes":{"type":"integer","minimum":0},"ownedBefore":{"type":"integer","minimum":0},"requestedBytes":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
   "allocatedBytes":{"type":["integer","null"],"minimum":0},"cancelAt":{"enum":["before","after",null]},"cloneCount":{"type":"integer","minimum":0},
   "expected":{"type":"object","additionalProperties":false,"required":["kind","committedAfter","retainedBytes","physicalBytes","allocatorCalls","freeCount","observerCalls","sourceReleaseCount"],"properties":{
    "kind":{"enum":[null,"canceled","ownershipLimit","allocationFailed","invariantViolated"]},"committedAfter":{"type":"integer","minimum":0},"retainedBytes":{"type":"integer","minimum":0},
    "physicalBytes":{"type":"integer","minimum":0},"allocatorCalls":{"type":"integer","minimum":0},"freeCount":{"type":"integer","minimum":0},"observerCalls":{"type":"integer","minimum":0},"sourceReleaseCount":{"type":"integer","minimum":0}
   }}
  }
 }}}
}
