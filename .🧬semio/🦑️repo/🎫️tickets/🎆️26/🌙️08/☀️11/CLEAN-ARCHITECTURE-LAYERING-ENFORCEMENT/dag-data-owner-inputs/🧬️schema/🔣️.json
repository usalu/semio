{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "cases"],
  "properties": {
    "contract": {"const": "defining-dag-identity/v1"},
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "identity"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["node", "edge"]},
          "identity": {"type": "string"}
        }
      }
    }
  }
}
