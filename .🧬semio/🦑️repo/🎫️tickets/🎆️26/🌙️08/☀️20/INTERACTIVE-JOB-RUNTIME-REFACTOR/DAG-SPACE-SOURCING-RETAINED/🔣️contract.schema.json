{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "limits",
    "apps",
    "laws"
  ],
  "properties": {
    "schema": {
      "const": "semio.interactivity.dag-space-sourcing.v1"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configRootBytes",
        "configTextBytes",
        "metadataTextBytes",
        "storeGrantBytes",
        "preparationSteps",
        "worstCaseEncodedBytes"
      ],
      "properties": {
        "configRootBytes": {
          "const": 768
        },
        "configTextBytes": {
          "const": 96
        },
        "metadataTextBytes": {
          "const": 64
        },
        "storeGrantBytes": {
          "const": 4096
        },
        "preparationSteps": {
          "const": 2
        },
        "worstCaseEncodedBytes": {
          "const": 3840
        }
      }
    },
    "apps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "factory",
          "rawBytes",
          "retained",
          "batch",
          "forbidden"
        ],
        "properties": {
          "name": {
            "enum": [
              "dag",
              "space",
              "sourcing"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "factory": {
            "type": "string",
            "minLength": 1
          },
          "rawBytes": {
            "enum": [
              8192,
              65536
            ]
          },
          "retained": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "lane"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "lane": {
                  "enum": [
                    "Config",
                    "HostOnly"
                  ]
                }
              }
            }
          },
          "batch": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "laws": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactLane",
        "exactAuthority",
        "boundedCopy",
        "cancellation",
        "resumableCleanup",
        "noFakeScan",
        "largeConfigUnfinished"
      ],
      "properties": {
        "exactLane": {
          "const": true
        },
        "exactAuthority": {
          "const": true
        },
        "boundedCopy": {
          "const": true
        },
        "cancellation": {
          "const": true
        },
        "resumableCleanup": {
          "const": true
        },
        "noFakeScan": {
          "const": true
        },
        "largeConfigUnfinished": {
          "const": true
        }
      }
    }
  }
}
