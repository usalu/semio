{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "savedAggregate",
      "observedAggregate",
      "savedFresh",
      "delta",
      "expected",
      "fresh"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "savedAggregate": {
        "type": "integer",
        "minimum": 0
      },
      "observedAggregate": {
        "type": "integer",
        "minimum": 0
      },
      "savedFresh": {
        "type": "integer",
        "minimum": 0
      },
      "delta": {
        "type": "integer",
        "minimum": 0
      },
      "expected": {
        "enum": [
          "accept",
          "reject"
        ]
      },
      "fresh": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
