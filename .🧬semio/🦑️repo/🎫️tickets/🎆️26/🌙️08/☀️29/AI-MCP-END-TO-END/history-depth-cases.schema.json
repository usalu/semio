{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "need",
      "current",
      "total",
      "expected"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "need": {
        "type": "integer",
        "minimum": 0
      },
      "current": {
        "type": "integer",
        "minimum": 0
      },
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "expected": {
        "enum": [
          "progress",
          "pending",
          "refusal"
        ]
      }
    }
  }
}
