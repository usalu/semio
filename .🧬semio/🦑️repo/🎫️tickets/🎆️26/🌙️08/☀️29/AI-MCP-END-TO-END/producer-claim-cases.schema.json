{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "total",
      "old",
      "next",
      "expected"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "old": {
        "type": "integer",
        "minimum": 0
      },
      "next": {
        "type": "integer",
        "minimum": 0
      },
      "expected": {
        "type": "integer",
        "minimum": -1
      }
    }
  }
}
