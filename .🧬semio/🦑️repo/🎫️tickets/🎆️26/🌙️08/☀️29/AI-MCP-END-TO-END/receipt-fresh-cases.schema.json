{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "aggregate",
      "semantic",
      "infrastructure",
      "grant",
      "expected",
      "fresh"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "aggregate": {
        "type": "integer",
        "minimum": 0
      },
      "semantic": {
        "type": "integer",
        "minimum": 0
      },
      "infrastructure": {
        "type": "integer",
        "minimum": 0
      },
      "grant": {
        "type": "integer",
        "minimum": 0
      },
      "expected": {
        "enum": [
          "accept",
          "reject"
        ]
      },
      "fresh": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
