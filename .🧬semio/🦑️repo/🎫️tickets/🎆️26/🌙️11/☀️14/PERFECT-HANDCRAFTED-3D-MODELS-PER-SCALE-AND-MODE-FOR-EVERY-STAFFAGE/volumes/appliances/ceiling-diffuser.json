e":"body","tone":0.8,"region":"plate","layer":"sheet","profile":[[0,0.02],[0.04,0.02]],"axis":[1,0,0],"origin":[0.262,-0.03,0],"tags":["jet-right"]}],"structure":[{"id":"member-body","of":"flange","member":"body","part":"member"},{"id":"mass-body","kind":"ellipsoid","bone":"body","material":"powder-coated-steel","role":"detail","tone":0.15,"member":"body","part":"mass","radii":[0.1,0.03,0.1],"transform":{"translation":[0,-0.015,0]}},{"id":"support-ceiling-hanger-left","kind":"revolve","bone":"body","material":"powder-coated-steel","role":"detail","tone":0.25,"member":"body","part":"support","profile":[[0,0.008],[0.016,0.008]],"axis":[0,1,0],"origin":[-0.28,-0.02,0],"tags":["ceiling-hanger-left"],"anchor":"ceiling-hanger-left"},{"id":"support-ceiling-hanger-right","kind":"revolve","bone":"body","material":"powder-coated-steel","role":"detail","tone":0.25,"member":"body","part":"support","profile":[[0,0.008],[0.016,0.008]],"axis":[0,0,1],"origin":[0.28,0.002,-0.008],"tags":["ceiling-hanger-right"],"anchor":"ceiling-hanger-right"}],"decisions":[{"en":"Own model for 1:100 against the 1:100 drawings: the flange is 20 mm thick, only two cones remain (0.255 to 0.225 and 0.18 to 0.12 half widths) and the collar bore is 0.1 m. Bead, screw heads and the third cone step are merged away because they fall below 15 mm.","de":"Eigenes Modell für 1:100 nach den 1:100-Zeichnungen: der Flansch ist 20 mm dick, es bleiben zwei Kegel (Halbbreiten 0,255 auf 0,225 und 0,18 auf 0,12) und die Kragenbohrung misst 0,1 m. Wulst, Schraubenköpfe und die dritte Kegelstufe sind weggefallen, weil sie unter 15 mm liegen."},{"en":"Thermal and structure are rebuilt on these solids: references to flange, both cones and the collar, two jets; flange plate as member, one mass ellipsoid, pin and roller supports sized at the 15 mm feature. One member solid is right here: the diffuser is a single rigid part (one rig bone) that hangs from its two ceiling hangers, so the flange plate is the whole load path and the cones and collar are cladding.","de":"Thermik und Tragwerk sind auf diesen Körpern neu aufgebaut: Verweise auf Flansch, beide Kegel und Kragen, zwei Strahlen; Flanschplatte als Stab, ein Massenellipsoid, Bolzen- und Rollenlager in der Grösse des 15-mm-Merkmals. Ein Stabkörper ist hier richtig: der Auslass ist ein einziges starres Teil (eine Rig-Bone), das an seinen zwei Deckenhaltern hängt; die Flanschplatte ist der ganze Lastpfad, Kegel und Stutzen sind Verkleidung."}]},"200":{"status":"authored","denominator":200,"body":[{"id":"collar","kind":"extrude","bone":"body","material":"galvanised-steel","role":"body","tone":0.5,"profile":[[0.127,0.0],[0.12591,0.01658],[0.12267,0.03287],[0.11733,0.0486],[0.10999,0.0635],[0.10076,0.07731],[0.0898,0.0898],[0.07731,0.10076],[0.0635,0.10999],[0.0486,0.11733],[0.03287,0.12267],[0.01658,0.12591],[0.0,0.127],[-0.01658,0.12591],[-0.03287,0.12267],[-0.0486,0.11733],[-0.0635,0.10999],[-0.07731,0.10076],[-0.0898,0.0898],[-0.10076,0.07731],[-0.10999,0.0635],[-0.11733,0.0486],[-0.12267,0.03287],[-0.12591,0.01658],[-0.127,0.0],[-0.12591,-0.01658],[-0.12267,-0.03287],[-0.11733,-0.0486],[-0.10999,-0.0635],[-0.10076,-0.07731],[-0.0898,-0.0898],[-0.07731,-0.10076],[-0.0635,-0.10999],[-0.0486,-0.11733],[-0.03287,-0.12267],[-0.01658,-0.12591],[0.0,-0.127],[0.01658,-0.12591],[0.03287,-0.12267],[0.0486,-0.11733],[0.0635,-0.10999],[0.07731,-0.10076],[0.0898,-0.0898],[0.10076,-0.07731],[0.10999,-0.0635],[0.11733,-0.0486],[0.12267,-0.03287],[0.12591,-0.01658]],"plane":"zx","from":0.0,"to":0.05,"holes":[[[0.097,0.0],[0.09617,0.01266],[0.09369,0.02511],[0.08962,0.03712],[0.084,0.0485],[0.07696,0.05905],[0.06859,0.06859],[0.05905,0.07696],[0.0485,0.084],[0.03712,0.08962],[0.02511,0.09369],[0.01266,0.09617],[0.0,0.097],[-0.01266,0.09617],[-0.02511,0.09369],[-0.03712,0.08962],[-0.0485,0.084],[-0.05905,0.07696],[-0.06859,0.06859],[-0.07696,0.05905],[-0.084,0.0485],[-0.08962,0.03712],[-0.09369,0.02511],[-0.09617,0.01266],[-0.097,0.0],[-0.09617,-0.01