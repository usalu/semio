    {
      "after": "        wall.in_plane_moment_nm = 20_000.0;\n",
      "add": "        wall.bracing_system = BracingSystem::Confined;\n        wall.diaphragm_stiffness_n_per_m = 5.0e7;\n"
    },
    {
      "after": "        doc.walls[0].f_yd_pa = 435e6;\n",
      "add": "        doc.walls[0].bracing_system = BracingSystem::Reinforced;\n"
    },
