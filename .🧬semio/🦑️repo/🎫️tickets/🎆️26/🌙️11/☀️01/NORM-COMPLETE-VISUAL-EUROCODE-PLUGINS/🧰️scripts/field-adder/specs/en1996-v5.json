      "after": "        wall.diaphragm_stiffness_n_per_m = 5.0e7;\n",
      "add": "        doc.chases = vec![WallChase { id: \"chase-1\".into(), wall_id: \"wall-members\".into(), kind: ChaseKind::Vertical, x_m: 3.0, y_m: 0.4, width_m: 0.08, length_m: 1.2, depth_m: 0.03 }];\n        doc.movement_joints = vec![MovementJoint { id: \"joint-1\".into(), wall_id: \"wall-members\".into(), position_m: 2.5 }];\n"
    }
