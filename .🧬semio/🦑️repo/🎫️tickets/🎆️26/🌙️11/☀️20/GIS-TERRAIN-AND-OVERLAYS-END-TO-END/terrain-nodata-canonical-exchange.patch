+        let significant = self.digits[..self.length].iter().fold(0_i64, |value, &digit| value * 10 + i64::from(digit));
+        let magnitude = significant * 10_i64.pow(scale);
+        i32::try_from(if self.negative { -magnitude } else { magnitude }).ok()
+    }
