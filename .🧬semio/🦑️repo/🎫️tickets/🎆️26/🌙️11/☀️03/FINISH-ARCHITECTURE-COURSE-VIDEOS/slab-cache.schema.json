{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact Slab Cache Record",
  "type": "object",
  "required": [
    "revision",
    "key",
    "value",
    "digest"
  ],
  "additionalProperties": false,
  "properties": {
    "revision": {
      "const": "semio-exact-slab-cache/v1"
    },
    "key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "value": {
      "$ref": "#/$defs/value"
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "scalar"
            },
            {
              "type": [
                "null",
                "boolean",
                "string"
              ]
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "integer"
            },
            {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "fraction"
            },
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "float"
            },
            {
              "type": "string"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "list"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "tuple"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "dict"
            },
            {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "$ref": "#/$defs/value"
                  },
                  {
                    "$ref": "#/$defs/value"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    }
  }
}
