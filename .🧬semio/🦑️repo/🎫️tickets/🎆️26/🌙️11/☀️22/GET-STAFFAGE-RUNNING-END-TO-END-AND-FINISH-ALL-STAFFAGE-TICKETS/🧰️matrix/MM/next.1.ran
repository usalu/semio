#!/bin/sh
# 🎟️ MM job 1 (about 15 min, at most 700 MB): identity of the states and of the cells of finned-heat-exchanger and atlas-cedar between the base tree and the trial tree, profiles of both.
M=/Users/ueli/Documents/semio/.🧬semio/🦑️repo/🎫️tickets/🎆️26/🌙️11/☀️22/GET-STAFFAGE-RUNNING-END-TO-END-AND-FINISH-ALL-STAFFAGE-TICKETS/🧰️matrix/MM
mv "$M/next.sh" "$M/next.1.ran" 2>/dev/null
G="${M%/🧰️matrix/MM}/🗑️generated/matrix/MM"
X=/private/tmp/claude-501/-Users-ueli-Documents-semio/26600f60-7314-4bf4-ab97-26644d4b8c37/scratchpad
BUN=$(ls ~/Library/Caches/semio/runtimes/bun/*/bun | head -1)
L="$G/n1"; mkdir -p "$L"; rm -f "$L/ended"
cd "$X" || exit 1
g() { name=$1; shift; sh "$M/guarded.sh" 700 "$L/$name.log" timeout "$@"; }
S=🎓️teaching/🏛️architecture/🧍️staffage
g digest 60 "$BUN" "$M/digest.ts" cat/*/*/🔣️.json
for t in trial base; do
  g finned-$t 120 "$BUN" "$M/one.ts" --snapshot cat/🏗️machinery/finned-heat-exchanger/🔣️.json --out "$L/finned-$t.json" --suite "$X/$t/$S/🧪️tests/🔭️multiview-coverage"
  g hot-$t 200 "$BUN" --cpu-prof --cpu-prof-dir "$L/prof-$t" "$M/hot.ts" --tree "$X/$t" --count 4 jogger:50 saguaro-cactus:50
  g hot2-$t 100 "$BUN" --cpu-prof --cpu-prof-dir "$L/prof2-$t" "$M/hot.ts" --tree "$X/$t" --only evaluate --count 2 cyclist:500 cyclist:50 dancer:50
  g hot3-$t 100 "$BUN" --cpu-prof --cpu-prof-dir "$L/prof3-$t" "$M/hot.ts" --tree "$X/$t" --only suitability,render,derived weeping-willow:100
  g cedar-$t 300 "$BUN" "$M/one.ts" --snapshot cat/🌳️vegetation/atlas-cedar/🔣️.json --out "$L/cedar-$t.json" --suite "$X/$t/$S/🧪️tests/🔭️multiview-coverage"
done
for p in finned cedar; do cmp "$L/$p-trial.json" "$L/$p-base.json" && echo "$p identical" >> "$L/same.txt" || echo "$p DIFFERENT" >> "$L/same.txt"; done
date > "$L/ended"
