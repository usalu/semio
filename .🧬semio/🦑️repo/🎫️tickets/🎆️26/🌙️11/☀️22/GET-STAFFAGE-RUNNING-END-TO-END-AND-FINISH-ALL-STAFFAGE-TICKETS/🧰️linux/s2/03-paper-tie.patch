 /** 🎯️ The D18 tolerance of a dimension: the larger of 15 mm and 2 % of it. */
 export const d18 = (nominalM: number): number => Math.max(0.015, 0.02 * nominalM);
 
+/** 🧷️ The bound of the floating-point rounding of a comparison at a tolerance, in units in the last place of the largest number that entered it: a paper or model coordinate reaches the comparison through a few dozen rounded operations (the frames of the rig, the projection, the scale of the sheet), each at most half a unit in the last place. */
+export const ROUNDING_ULPS = 64;
+
+/** ⚖️ Whether a deviation exceeds its tolerance by more than the rounding of the numbers it was computed from ({@link ROUNDING_ULPS} units in the last place of `magnitude`, the largest absolute operand): a deviation that equals the tolerance is within it whatever the unit (metres or paper millimetres) and whatever the scale it is computed at, and a deviation that is not a number exceeds every tolerance. The bound is arithmetic, not a widening: at a magnitude of 1 m it is 1.4e-14 m, nine orders below the micrometre the documents are written in, so no drawing that differs from its tolerance by a representable authored amount changes its verdict. */
+export const exceeds = (deviation: number, tolerance: number, magnitude: number): boolean => !(deviation - tolerance <= ROUNDING_ULPS * Number.EPSILON * Math.abs(magnitude));
+
 /** 💾️ The D18 tolerance of the synchrony checks: D18 of the largest dimension of the asset. */
 export const toleranceM = (asset: Asset): number => d18(Math.max(asset.dimensions.heightM, asset.dimensions.widthM, asset.dimensions.depthM));
 
