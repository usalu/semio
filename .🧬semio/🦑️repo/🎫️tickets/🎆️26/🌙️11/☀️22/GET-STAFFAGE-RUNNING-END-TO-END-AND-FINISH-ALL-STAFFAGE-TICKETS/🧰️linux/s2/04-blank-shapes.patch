+/** 🖋️ Whether a path item leaves ink: a fill, or a stroke of a width above zero that is not fully transparent. */
+const inked = (item: { readonly fill?: unknown; readonly stroke?: { readonly widthMm: number; readonly opacity?: number } }): boolean => item.fill !== undefined || (item.stroke !== undefined && item.stroke.widthMm > 0 && item.stroke.opacity !== 0);
+
+/** 🖍️ The ids of the path items that draw the non-ground shapes of a view with ink ({@link paperIds} without the items that have neither a fill nor a visible stroke): what makes a view not blank, whether a shape is drawn filled or as an unfilled outline. */
+export function drawnIds(scene: DrawingScene, shapes: readonly EvaluatedShape[]): Set<string> {
+  const ids = paperIds(scene, shapes);
+  const drawn = new Set<string>();
+  for (const layer of scene.layers) for (const item of layer.items) if (item.kind === "path" && ids.has(item.id) && inked(item)) drawn.add(item.id);
+  return drawn;
+}
+
