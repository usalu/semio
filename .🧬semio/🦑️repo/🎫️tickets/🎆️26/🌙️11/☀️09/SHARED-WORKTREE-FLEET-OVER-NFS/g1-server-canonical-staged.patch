+/** 🌳️ The `ps` table of a POSIX host as `{pid,ppid,rssBytes}` rows. */
+export function psProcessRowsV1(text){
+ const rows=[];
+ for(const line of text.split("\n")){const[pid,ppid,rss]=line.trim().split(/\s+/u).map(Number);if(Number.isInteger(pid)&&Number.isInteger(ppid)&&Number.isFinite(rss))rows.push({pid,ppid,rssBytes:rss*1024});}
+ return rows;
+}
+
+/** 🌳️ The resident bytes of the process `pid` and everything it started (a slice worker and the `cargo metadata`, farm workers and compilers below it), summed over the process table `rows`; a pid absent from the table counts nothing. */
+export function processTreeBytesV1(rows,pid){
+ const children=new Map(),own=new Map();
+ for(const row of rows){const list=children.get(row.ppid)??[];list.push(row.pid);children.set(row.ppid,list);own.set(row.pid,row.rssBytes);}
+ const seen=new Set(),pending=[pid];let total=0;
+ while(pending.length){const next=pending.pop();if(seen.has(next))continue;seen.add(next);total+=own.get(next)??0;pending.push(...children.get(next)??[]);}
+ return total;
+}
+
+/** 🌳️ The reader of the memory this process and its descendants hold, never the host: other processes of the machine (peer builds, the file cache) are not billed to the owners that run here, which is what the learned owner cost needs. POSIX hosts read the process table (`ps`), others the resident memory of this process alone; an answer is kept for `maximumAgeMilliseconds`. The sources are ports. */
+export function createProcessTreeMemoryV1({pid=process.pid,platform=process.platform,run=()=>execFileSync("ps",["-A","-o","pid=,ppid=,rss="],{encoding:"utf8",timeout:2000,maxBuffer:64*1024*1024}),own=()=>process.memoryUsage().rss,now=()=>performance.now(),maximumAgeMilliseconds=1000}={}){
+ let at=-Infinity,value=0;
+ const source=()=>{if(platform!=="win32")try{const bytes=processTreeBytesV1(psProcessRowsV1(run()),pid);if(bytes>0)return bytes;}catch{}return own();};
+ return()=>{const time=now();if(at===-Infinity||time-at>=maximumAgeMilliseconds){value=source();at=time;}return value;};
+}
