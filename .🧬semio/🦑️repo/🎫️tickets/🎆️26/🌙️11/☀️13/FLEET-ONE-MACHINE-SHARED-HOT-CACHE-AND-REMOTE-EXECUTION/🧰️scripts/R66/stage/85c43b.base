import {createHash} from "node:crypto";
import {graphOwnerAdmissionV1} from "../../../../🧠️memory/🟨️.mjs";
import {fetchGraphEntryV1,publishGraphEntryV1,type GraphDocumentV1,type GraphFleetClientV1} from "../../../../🪪️graph-state/🛰️exchange/🟦️.ts";
import type {GraphStateV1} from "../../../../🪪️graph-state/🟦️.ts";
import type {ProjectClaimV1} from "../../../../🪪️graph-state/📦️project-records/🟦️.ts";
import schema from "./🧬️schema/🔣️.json" with {type:"json"};

/** 📐️ The authored numbers of the pool: poll intervals, retry delays, how a unit is sized and how many a machine takes at once.
 * @see ./🧬️schema/🔣️.json */
export const OWNER_POOL_POLICY_V1=schema.definitions.Policy.const;
const P=OWNER_POOL_POLICY_V1,MEGABYTE=1048576,ZERO="0".repeat(64),sha=(text:string)=>createHash("sha256").update(text).digest("hex");

/** 🏷️ One owner of the pool as every machine reads it: the name, the kind its learned peak is filed under, how long it is expected to run (the claim lives that long times its multiple) and its project JSON. */
export type OwnerPoolUnitV1=Readonly<{name:string;kind:string;expectedMilliseconds:number;json:Readonly<Record<string,unknown>>}>;
/** 🧾️ What a puller needs besides the units: see the schema definition `Head`. */
export type OwnerPoolHeadV1=Readonly<{version:1;revision?:string;id:string;createdMs:number;publisher:string;identity:string;globals:Readonly<{projectAuthority:string;registryDigest:string;commandRevision:string;late:boolean}>;peaks:Readonly<Record<string,readonly number[]>>}>;
/** 📦️ The published pool of one wave: the head, the session the units are inferred in (opaque bytes of the publisher's runtime) and the units in the order the publisher infers them. */
export type OwnerPoolManifestV1=Readonly<{head:OwnerPoolHeadV1;session:Uint8Array;units:readonly OwnerPoolUnitV1[]}>;
/** 📍️ The tiny entry machines poll. */
export type OwnerPoolPointerV1=Readonly<{version:1;id:string;createdMs:number;units:number}>;

const stateOf=(name:string,id:string|undefined):GraphStateV1=>Object.freeze({version:1,frame:Object.freeze({kind:"project-inference" as const,tooling:sha(P.domain+":"+name),implementation:ZERO,platform:"neutral",extra:Object.freeze({})}),names:ZERO,content:ZERO,files:0,contentFiles:0,digest:sha(JSON.stringify([P.domain,name,id??null]))}) as unknown as GraphStateV1;

/** 🧮️ The state a pointer or a manifest is stored under: the pointer has one fixed state (a newer one replaces it), a manifest one per wave id; each name has its own retention slot, so a newer manifest supersedes the older ones. */
export const ownerPoolStateV1=(name:"pointer"|"manifest",id?:string):GraphStateV1=>stateOf(name,name==="pointer"?undefined:id);

/** 🆔️ The id of a wave: the digest of its head parts and its unit names and project JSON, so two machines that publish the same wave publish the same entry. */
export const ownerPoolIdV1=(head:Omit<OwnerPoolHeadV1,"id"|"createdMs"|"publisher">,units:readonly OwnerPoolUnitV1[])=>sha(JSON.stringify([head.identity,head.globals,units.map(unit=>[unit.name,unit.json])]));

const documentOf=(documents:readonly GraphDocumentV1[],name:string)=>documents.find(row=>row.name===name)?.bytes;
const encode=(value:unknown)=>Buffer.from(JSON.stringify(value));

/** 🧮️ The state a failure note is stored under: one per record state of the owner (the digest the claim is made by). */
export const ownerPoolFailureStateV1=(recordDigest:string):GraphStateV1=>stateOf(P.failureName,recordDigest);

/** 🚫️ Tells the fleet that an owner failed with a deterministic cause on this machine, so the other pullers leave it to the machine that runs the wave. Never throws. */
export async function publishOwnerPoolFailureV1(input:Readonly<{client:GraphFleetClientV1;owner:string;origin:string;recordDigest:string;revision:string;cause:string;now?:()=>number}>):Promise<boolean>{
 try{return await publishGraphEntryV1({client:input.client,state:ownerPoolFailureStateV1(input.recordDigest),owner:input.owner,documents:[{name:P.failureName,bytes:encode({version:1,revision:input.revision,cause:input.cause.slice(0,300),origin:input.origin,atMs:(input.now??Date.now)()})}]});}catch{return false;}
}

/** 🔎️ The failure note of a record state if it is younger than the policy's maximum age and of the same record-code revision. */
export async function readOwnerPoolFailureV1(client:GraphFleetClientV1,recordDigest:string,revision:string,now:()=>number=Date.now):Promise<Readonly<{cause:string;origin:string;atMs:number}>|undefined>{
 try{
  const entry=await fetchGraphEntryV1(client,ownerPoolFailureStateV1(recordDigest));
  if(entry===undefined||entry==="fault")return undefined;
  const bytes=documentOf(entry.documents,P.failureName);if(bytes===undefined)return undefined;
  const note=JSON.parse(Buffer.from(bytes).toString("utf8")) as {version:number;revision:string;cause:string;origin:string;atMs:number};
  return note.version===1&&note.revision===revision&&now()-note.atMs<=P.failureMaximumAgeMilliseconds?note:undefined;
 }catch{return undefined;}
}

/** ⬆️ Publishes the pool of a wave to the fleet cache: the manifest first, the pointer last, so a puller that sees the pointer finds the manifest. `false` when the fleet refuses (nothing is lost: the publisher infers every owner itself). */
export async function publishOwnerPoolV1(input:Readonly<{client:GraphFleetClientV1;owner:string;manifest:OwnerPoolManifestV1}>):Promise<boolean>{
 const {client,owner,manifest}=input,{head}=manifest;
 const stored=await publishGraphEntryV1({client,state:ownerPoolStateV1("manifest",head.id),owner,documents:[{name:P.headName,bytes:encode(head)},{name:P.sessionName,bytes:manifest.session},{name:P.unitsName,bytes:encode(manifest.units)}]});
 if(!stored)return false;
 const pointer:OwnerPoolPointerV1={version:1,id:head.id,createdMs:head.createdMs,units:manifest.units.length};
 return publishGraphEntryV1({client,state:ownerPoolStateV1("pointer"),owner,head:true,documents:[{name:P.pointerName,bytes:encode(pointer)}]});
}


/** 📍️ The latest published wave, or `undefined` when none is published, the fleet is unreachable or the pointer is older than the policy's maximum age. */
export async function readOwnerPoolPointerV1(client:GraphFleetClientV1,now:()=>number=Date.now):Promise<OwnerPoolPointerV1|undefined>{
 try{
  const entry=await fetchGraphEntryV1(client,ownerPoolStateV1("pointer"));
  if(entry===undefined||entry==="fault")return undefined;
  const bytes=documentOf(entry.documents,P.pointerName);if(bytes===undefined)return undefined;
  const pointer=JSON.parse(Buffer.from(bytes).toString("utf8")) as OwnerPoolPointerV1;
  return pointer.version===1&&/^[0-9a-f]{64}$/u.test(pointer.id)&&now()-pointer.createdMs<=P.manifestMaximumAgeMilliseconds?pointer:undefined;
 }catch{return undefined;}
}

/** ⬇️ The manifest of one wave, or `undefined` when it is not (yet) readable. */
export async function readOwnerPoolV1(client:GraphFleetClientV1,id:string):Promise<OwnerPoolManifestV1|undefined>{
 try{
  const entry=await fetchGraphEntryV1(client,ownerPoolStateV1("manifest",id));
  if(entry===undefined||entry==="fault")return undefined;
  const head=documentOf(entry.documents,P.headName),session=documentOf(entry.documents,P.sessionName),units=documentOf(entry.documents,P.unitsName);
  if(head===undefined||session===undefined||units===undefined)return undefined;
  const parsed=JSON.parse(Buffer.from(head).toString("utf8")) as OwnerPoolHeadV1;
  return parsed.version===1&&parsed.id===id?{head:parsed,session,units:JSON.parse(Buffer.from(units).toString("utf8")) as OwnerPoolUnitV1[]}:undefined;
 }catch{return undefined;}
}

/** 📏️ What one owner of a kind is expected to take: the largest of the last peak samples below the ceiling (a sample at the ceiling is a clamp, not a measurement), else the declared guess, flagged as not learned. */
export function ownerEstimateV1(kind:string,peaks:Readonly<Record<string,readonly number[]>>,policy:typeof P=P):Readonly<{bytes:number;learned:boolean}>{
 const valid=(peaks[kind]??[]).filter(sample=>Number.isFinite(sample)&&sample>0&&sample!==policy.ceilingBytes).slice(-policy.peakSamples);
 return valid.length===0?{bytes:policy.defaultOwnerMegabytes*MEGABYTE,learned:false}:{bytes:Math.max(...valid),learned:true};
}

/** 🪙️ The memory the pool process of a machine may hold: a fifth of its physical memory, at least 1 GB and at most 3 GB (an 8 GB machine keeps 6 GB for its own work), or the megabytes named by `SEMIO_OWNER_POOL_GRANT_MB`. */
export function ownerPoolGrantBytesV1(totalBytes:number,environment:Readonly<Record<string,string|undefined>>=process.env,policy:typeof P=P):number{
 const named=Number(environment[policy.grantEnvironment]);
 if(Number.isFinite(named)&&named>0)return Math.floor(named*MEGABYTE);
 return Math.max(policy.grantMinimumMegabytes*MEGABYTE,Math.min(policy.grantMaximumMegabytes*MEGABYTE,Math.floor(totalBytes*policy.grantShareBasisPoints/10000)));
}

/** 🚦️ How many owners a machine takes at once: its cores less the reserve, at most the policy's maximum, at least one. */
export const ownerPoolSlotsV1=(cores:number,policy:typeof P=P)=>Math.max(1,Math.min(policy.maximumConcurrent,Math.floor(cores)-policy.reserveCores));

/** 🧮️ Whether a machine takes one more owner: a free slot, the owner fits the free memory even alone (an owner larger than the machine is left to a larger one), and then the same law the graph governor applies (an owner of a kind without a learned peak runs alone, otherwise the headroom less what the running owners are still expected to take covers its estimate). */
export function ownerPoolAdmitV1(input:Readonly<{estimate:Readonly<{bytes:number;learned:boolean}>;running:readonly number[];headroomBytes:number;cores:number}>,policy:typeof P=P):boolean{
 if(input.running.length>=ownerPoolSlotsV1(input.cores,policy))return false;
 if(input.estimate.bytes>input.headroomBytes||input.estimate.bytes>=policy.heavyOwnerMegabytes*MEGABYTE&&input.running.length>0)return false;
 return graphOwnerAdmissionV1({headroom:input.headroomBytes,running:input.running.length,inflight:input.running.map(estimate=>({estimate,taken:0})),estimate:input.estimate.bytes,learned:input.estimate.learned});
}

/** 📊️ What one pull run did. */
export type OwnerPoolStatsV1={claimed:number;published:number;stored:number;held:number;faulted:number;failed:number;declined:number;refused:number};

const defaultSleep=(milliseconds:number,signal?:AbortSignal)=>new Promise<void>(done=>{const timer=setTimeout(done,milliseconds);signal?.addEventListener("abort",()=>{clearTimeout(timer);done();},{once:true});});

/** 🌐️ Pulls owners from the tail of the pool until every one is stored by someone, the signal aborts or `stop` says the wave is over (or this process is about to restart: it takes nothing new), `busy` is told how many owners are in flight. Each owner is claimed by the digest of its record state before it is computed (a claim another machine holds is looked at again later, a claim that lapsed is granted to the next machine that asks, a stored record is never computed), taken only when the free memory and cores admit it, published when finished and given back when it fails. Nothing here waits for another machine and nothing schedules for one. */
export async function pullOwnerPoolV1<U extends Readonly<{name:string;kind:string}>>(input:Readonly<{units:readonly U[];claim(unit:U):Promise<ProjectClaimV1>;run(unit:U):Promise<boolean>;headroomBytes():number;cores:number;peaks:Readonly<Record<string,readonly number[]>>;signal?:AbortSignal;stop?():boolean;busy?(running:number):void;progress?(stats:Readonly<OwnerPoolStatsV1>,running:number,blocked:boolean):void;known?:Set<string>;allow?(running:number):Promise<boolean>;fail?(name:string,message:string,deterministic:boolean):void;now?():number;sleep?(milliseconds:number,signal?:AbortSignal):Promise<void>;policy?:typeof P}>):Promise<OwnerPoolStatsV1>{
 const policy=input.policy??P,now=input.now??Date.now,sleep=input.sleep??defaultSleep,finished=input.known??new Set<string>(),retryAt=new Map<string,number>(),running=new Map<string,{estimate:number;work:Promise<void>}>(),stats:OwnerPoolStatsV1={claimed:0,published:0,stored:0,held:0,faulted:0,failed:0,declined:0,refused:0};
 const over=()=>input.signal?.aborted===true||input.stop?.()===true;
 const execute=async(unit:U,claim:Extract<ProjectClaimV1,{state:"granted"}>)=>{
  try{
   if(await input.run(unit)&&await claim.publish())stats.published++;
   else{stats.failed++;input.fail?.(unit.name,"the record was not stored: "+claim.why(),claim.deterministic());await claim.abandon();}
  }catch(error){stats.failed++;input.fail?.(unit.name,String((error as Error)?.message??error),true);await claim.abandon().catch(()=>undefined);}
  finally{running.delete(unit.name);finished.add(unit.name);input.busy?.(running.size);input.progress?.(stats,running.size,false);}
 };
 while(finished.size<input.units.length&&!over()){
  let started=false,fits=0,waiting=0,yielded=false;
  for(let index=input.units.length-1;index>=0&&!over();index--){
   const unit=input.units[index]!;
   if(running.size>=ownerPoolSlotsV1(input.cores,policy))break;
   if(finished.has(unit.name)||running.has(unit.name)||(retryAt.get(unit.name)??0)>now())continue;
   const estimate=ownerEstimateV1(unit.kind,input.peaks,policy);
   waiting++;
   if(!ownerPoolAdmitV1({estimate,running:[...running.values()].map(row=>row.estimate),headroomBytes:input.headroomBytes(),cores:input.cores},policy))continue;
   fits++;
   if(input.allow!==undefined&&!await input.allow(running.size)){yielded=true;break;}
   const claim=await input.claim(unit);
   if(claim.state==="stored"){finished.add(unit.name);stats.stored++;continue;}
   if(claim.state==="refused"){finished.add(unit.name);stats.refused++;continue;}
   if(claim.state==="held"){retryAt.set(unit.name,now()+policy.heldRetryMilliseconds);stats.held++;continue;}
   if(claim.state==="fault"){retryAt.set(unit.name,now()+policy.faultRetryMilliseconds);stats.faulted++;continue;}
   running.set(unit.name,{estimate:estimate.bytes,work:execute(unit,claim)});started=true;stats.claimed++;input.busy?.(running.size);input.progress?.(stats,running.size,false);
  }
  input.progress?.(stats,running.size,!started&&running.size===0&&waiting>0&&fits===0&&!yielded);
  await Promise.race([sleep(started?0:policy.sweepPollMilliseconds,input.signal),...[...running.values()].map(row=>row.work)]);
 }
 await Promise.allSettled([...running.values()].map(row=>row.work));
 return stats;
}
