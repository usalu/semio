    "RuntimeDataDiscoveryPolicy": {
      "const": {
        "maximumDepth": 32,
        "maximumDirectories": 8192,
        "maximumEntries": 8192,
        "maximumResults": 8192,
        "maximumDeclaredBytes": 67108864
      }
    },
    "MemoPolicy": {
      "const": {
        "maximumFileBytes": 33554432,
        "concurrency": 24
      }
    },
    "RuntimeDataDiscoveryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario",
        "accepted",
        "maximumEnumerations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "enum": [
            "ordinary",
            "absent",
            "symlink",
            "overflow",
            "entries",
            "depth",
            "race",
            "kind",
            "literal-symlink",
            "bytes",
            "close-primary",
            "cancel",
            "close-mutation"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "maximumEnumerations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34
        }
      }
    },
    "SourceCensusPolicy": { "const": { "maximumFiles": 65536, "maximumSourceBytes": 268435456, "progressFiles": 16 } },
    "SourceCapacityTexts": {
      "const": {
        "en": "Authorizer source closure capacity exceeded: files={files}/{maximumFiles}, bytes={bytes}/{maximumBytes}. The closure reached {path} through {chain}. Drop the import that pulls this subtree into the entry, or raise maximumFiles, maximumSourceBytes and maximumSnapshotBytes together in the Policy of build/source/closure/schema (one file per 4096 source bytes, snapshot 1.5 times the sources).",
        "de": "Kapazität des Autorisierer-Quellabschlusses überschritten: Dateien={files}/{maximumFiles}, Bytes={bytes}/{maximumBytes}. Der Abschluss erreichte {path} über {chain}. Entferne den Import, der diesen Teilbaum in den Einstieg zieht, oder erhöhe maximumFiles, maximumSourceBytes und maximumSnapshotBytes gemeinsam in der Policy von build/source/closure/schema (eine Datei je 4096 Quellbytes, Snapshot das 1,5-fache der Quellen)."
      }
    },
    "CompilerClosureLaw": {
      "const": {
        "version": 1,
        "entry": "🔏️authorizers/📜️script.ts",
        "maximumFiles": 12288,
        "maximumSourceBytes": 50331648,
        "maximumSnapshotBytes": 75497472,
        "reservedHeadroomBasisPoints": 1000,
        "entryGuardBound": "import\\.meta\\.main\\s*\\?\\?",
        "entryGuards": [
          "(?:===|!==|==|!=)\\s*(?:[A-Za-z_$][\\w$.]*\\(\\s*)*import\\.meta\\.(?:url|filename|path)\\b",
          "\\bimport\\.meta\\.(?:url|filename|path)\\b(?:\\s*\\))*\\s*(?:===|!==|==|!=)"
        ],
        "texts": {
          "en": { "budget": "The authorizer compiler closure holds {files} files and {sourceBytes} source bytes; the declared budget is {budgetBytes} bytes ({headroom} percent left), the hard limit {limitBytes} bytes.", "guard": "The authorizer compiler closure reaches {path}, which decides by itself whether it is the process entry; inside the single-file bundle that is true for every module. Use isMainModuleV1(import.meta.url)." },
          "de": { "budget": "Die Hülle des Autorisierer-Compilers enthält {files} Dateien und {sourceBytes} Quellbytes; das deklarierte Budget beträgt {budgetBytes} Bytes ({headroom} Prozent frei), die harte Grenze {limitBytes} Bytes.", "guard": "Die Hülle des Autorisierer-Compilers erreicht {path}, das selbst entscheidet, ob es der Prozess-Einstieg ist; im Einzeldatei-Bündel gilt das für jedes Modul. Verwende isMainModuleV1(import.meta.url)." }
        }
      }
    },
    "SourceCensus": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "version", "entry", "files", "sourceBytes", "snapshotBytes", "sources"],
      "properties": {
        "kind": { "const": "source-census" }, "version": { "const": 1 },
        "entry": { "type": "string", "minLength": 1, "maxLength": 256 },
        "files": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "sourceBytes": { "type": "integer", "minimum": 0, "maximum": 268435456 },
        "snapshotBytes": { "type": "integer", "minimum": 0 },
        "sources": { "type": "array", "maxItems": 65536, "items": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "origin", "importer"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 256 }, "bytes": { "type": "integer", "minimum": 0, "maximum": 4194304 }, "origin": { "enum": ["entry", "import", "declared-companion", "discovered-data", "workspace-manifest", "unknown"] }, "importer": { "type": ["string", "null"] } } } }
      }
    },
    "SourceCapacityDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "path",
        "origin",
        "chain",
        "files",
        "bytes",
        "largest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "origin": {
          "enum": [
            "entry",
            "import",
            "declared-companion",
            "discovered-data",
            "workspace-manifest",
            "unknown"
          ]
        },
        "chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16385
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 71303168
        },
        "largest": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "const": "release"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "maxItems": 16384
    },
    "resolutions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "specifier",
          "path"
        ],
        "properties": {
          "specifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "additionalProperties": false
      }
    }
  }
}
