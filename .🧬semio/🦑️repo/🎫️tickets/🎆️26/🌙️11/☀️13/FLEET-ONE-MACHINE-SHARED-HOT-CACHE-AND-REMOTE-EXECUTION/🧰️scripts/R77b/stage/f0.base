    "OriginCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fault",
        "accepted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fault": {
          "enum": [
            "none",
            "schema-before",
            "schema-after",
            "undeclared",
            "global-spoof",
            "local-collision",
            "reader-before",
            "reader-after",
            "reader-after-cached",
            "reader-policy-before",
            "reader-policy-after"
          ]
        },
        "accepted": {
          "type": "boolean"
        }
      }
