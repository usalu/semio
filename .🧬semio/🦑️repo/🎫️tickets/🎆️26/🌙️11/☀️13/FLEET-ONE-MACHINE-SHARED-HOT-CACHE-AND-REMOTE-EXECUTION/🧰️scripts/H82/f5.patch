+  expect(hereLimitBytesV1({limitBytes:2048*MB,soloBytes:600*MB,planBytes:Infinity})).toBe(2048*MB);
+  if(host>=16384)expect(limit*factor).toBeGreaterThanOrEqual(4200*MB);
+ }
