{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adaptive wave cases / Fälle der anpassenden Wellen",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size", "elapsedMilliseconds", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 1 },
          "elapsedMilliseconds": { "type": "integer", "minimum": 0 },
          "inferred": { "type": "integer", "minimum": 0 },
          "basisPoints": { "type": "integer", "minimum": 1 },
          "expected": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
