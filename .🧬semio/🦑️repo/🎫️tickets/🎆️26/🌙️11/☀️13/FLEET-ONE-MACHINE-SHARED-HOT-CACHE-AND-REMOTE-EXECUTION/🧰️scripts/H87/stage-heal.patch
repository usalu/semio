+/** 🩹️ Rewrites every stand-in under `buildDirectory` whose sealed module no longer exists (a unit Cargo keeps fresh forever carries the path it was written with), once per module and build directory; returns the number repaired. */
+export function healStaleBuildScriptShimsV1(buildDirectory:string,runtime:string=process.execPath):number{
+ const marker=join(buildDirectory,".shims-healed-"+toolchainFreeDigestV1(module));let repaired=0;
+ if(existsSync(marker))return 0;
+ const visit=(directory:string,depth:number):void=>{
+  let names:string[];try{names=readdirSync(directory);}catch{return;}
+  for(const name of names){
+   const path=join(directory,name);let facts;try{facts=statSync(path);}catch{continue;}
+   if(facts.isDirectory()){if(depth<4)visit(path,depth+1);continue;}
+   if(!facts.isFile()||facts.size>8192||!/^build[_-]script[_-]build/u.test(name)||name.endsWith(".real")||!isShimV1(path))continue;
+   const target=/exec '(?:[^']|'\\'')*' '((?:[^']|'\\'')*)' '/u.exec(readFileSync(path,"utf8"))?.[1]?.replaceAll("'\\''","'");
+   if(target!==undefined&&!existsSync(target)&&existsSync(path+".real")){try{installBuildScriptShimV1(path,runtime);repaired++;}catch{}}
+  }
+ };
+ visit(buildDirectory,0);
+ try{mkdirSync(buildDirectory,{recursive:true});writeFileSync(marker,String(repaired));}catch{}
+ return repaired;
+}
+const toolchainFreeDigestV1=(text:string):string=>{let hash=0;for(let index=0;index<text.length;index++)hash=Math.imul(hash^text.charCodeAt(index),16777619)>>>0;return hash.toString(16);};
+
 /** 🔎️ Whether a file is already a stand-in (a script carrying the marker), not a compiled executable. */
 export function isShimV1(path:string):boolean{
  try{const head=readFileSync(path).subarray(0,256).toString("latin1");return head.startsWith("#!")&&head.includes(policy.buildScript.shimMarker);}catch{return false;}
