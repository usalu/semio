{
 "lease": [
  {
   "name": "no lease is free",
   "lease": null,
   "nowMs": 100000,
   "staleMs": 60000,
   "process": "alive",
   "expect": {
    "state": "free",
    "reason": "none"
   }
  },
  {
   "name": "an old lease has expired even if its process lives",
   "lease": {
    "pid": 10,
    "startMs": 1000,
    "wallMs": 0
   },
   "nowMs": 100000,
   "staleMs": 60000,
   "process": "alive",
   "expect": {
    "state": "free",
    "reason": "expired"
   },
   "processStartMs": 1000
  },
  {
   "name": "a fresh lease of a live process with the recorded start is held",
   "lease": {
    "pid": 10,
    "startMs": 1000,
    "wallMs": 90000
   },
   "nowMs": 100000,
   "staleMs": 60000,
   "process": "alive",
   "expect": {
    "state": "held",
    "reason": "held"
   },
   "processStartMs": 1000
  },
  {
   "name": "a start time within the tolerance is the same process",
   "lease": {
    "pid": 10,
    "startMs": 1000,
    "wallMs": 90000
   },
   "nowMs": 100000,
   "staleMs": 60000,
   "process": "alive",
   "expect": {
    "state": "held",
    "reason": "held"
   },
   "processStartMs": 9000
  },
  {
   "name": "a fresh lease of a process that is gone is free at once",
   "lease": {
    "pid": 10,
    "startMs": 1000,
    "wallMs": 90000
   },
   "nowMs": 100000,
   "staleMs": 60000,
   "process": "gone",
   "expect": {
    "state": "free",
    "reason": "owner-gone"
   }
  },
  {
   "name": "a fresh lease whose pid belongs to a younger process is free (the pid was reused)",
   "lease": {
    "pid": 10,
    "startMs": 1000,
    "wallMs": 90000
   },
   "nowMs": 100000,
   "staleMs": 60000,
   "process": "alive",
   "expect": {
    "state": "free",
    "reason": "pid-reused"
   },
   "processStartMs": 500000
  },
  {
   "name": "a lease without a recorded start is held while its pid lives",
   "lease": {
    "pid": 10,
    "wallMs": 90000
   },
   "nowMs": 100000,
   "staleMs": 60000,
   "process": "alive",
   "expect": {
    "state": "held",
    "reason": "held"
   },
   "processStartMs": 500000
  },
  {
   "name": "an unknown process state keeps the lease",
   "lease": {
    "pid": 10,
    "startMs": 1000,
    "wallMs": 90000
   },
   "nowMs": 100000,
   "staleMs": 60000,
   "process": "unknown",
   "expect": {
    "state": "held",
    "reason": "held"
   }
  },
  {
   "name": "expiry wins over a gone process",
   "lease": {
    "pid": 10,
    "startMs": 1000,
    "wallMs": 0
   },
   "nowMs": 100000,
   "staleMs": 60000,
   "process": "gone",
   "expect": {
    "state": "free",
    "reason": "expired"
   }
  }
 ],
