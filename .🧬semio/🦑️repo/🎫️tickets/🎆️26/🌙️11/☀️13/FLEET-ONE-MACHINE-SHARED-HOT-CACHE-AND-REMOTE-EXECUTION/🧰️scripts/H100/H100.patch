+/** 🧪️ A content addressed generation file that a full disk cut, emptied or flipped is quarantined and written again by the next store of the same content; a plain `ifAbsent` file keeps its meaning. */
+import {afterAll,beforeAll,describe,expect,test} from "bun:test";
+import {createHash} from "node:crypto";
+import {existsSync,mkdirSync,mkdtempSync,readFileSync,readdirSync,rmSync,writeFileSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+import {createNodeFilePortV1} from "../../🗃️file-ports/🟨️.mjs";
+import {readQuarantineLogV1} from "../../../../🩹️cache-repair/🟦️.ts";
+
+let base:string;
+beforeAll(()=>{base=mkdtempSync(join(tmpdir(),"semio-generation-repair-"));});
+afterAll(()=>{rmSync(base,{recursive:true,force:true});});
+let count=0;
+const bytes=Buffer.from("a fragment of the project graph, long enough to be cut in half by a full disk".repeat(3));
+const digest=createHash("sha256").update(bytes).digest("hex");
+const quarantineLog=join(base0(),"q");
+function base0(){return mkdtempSync(join(tmpdir(),"semio-generation-q-"));}
+process.env.SEMIO_CACHE_QUARANTINE_ROOT=quarantineLog;
+const fresh=()=>{const root=join(base,"s"+count++,"generations");mkdirSync(join(root,"f"),{recursive:true});return{root,path:join(root,"f",digest+".json"),port:createNodeFilePortV1()};};
+
+for(const how of ["truncate","flip","empty"] as const){
+ test(`${how}: the next store of the same content replaces the damaged file and quarantines it`,async()=>{
+  const {root,path,port}=fresh(),before=readQuarantineLogV1(quarantineLog).length;
+  expect(await port.write(path,bytes,{ifAbsent:true})).toBe(true);
+  expect(await port.write(path,bytes,{ifAbsent:true})).toBe(false);
+  const held=readFileSync(path);
+  if(how==="empty")writeFileSync(path,"");else if(how==="truncate")writeFileSync(path,held.subarray(0,held.length>>1));else{const copy=Buffer.from(held);copy[7]=copy[7]!^0x08;writeFileSync(path,copy);}
+  expect(await port.write(path,bytes,{ifAbsent:true})).toBe(true);
+  expect(readFileSync(path)).toEqual(bytes);
+  const rows=readQuarantineLogV1(quarantineLog);
+  expect(rows.length).toBe(before+1);expect(rows.at(-1)!.kind).toBe("graph-record");expect(rows.at(-1)!.outcome).toBe("removed");expect(rows.at(-1)!.de).not.toBe(rows.at(-1)!.en);
+  expect(existsSync(join(root,".quarantine"))).toBe(false);
+  expect(readdirSync(join(root,"f")).filter(name=>name.endsWith(".tmp"))).toEqual([]);
+ });
+}
+
+test("a file under a plain name keeps the meaning of `ifAbsent`: an existing file is never replaced",async()=>{
+ const {root,port}=fresh(),path=join(root,"ask.json");
+ expect(await port.write(path,Buffer.from("first"),{ifAbsent:true})).toBe(true);
+ expect(await port.write(path,Buffer.from("second"),{ifAbsent:true})).toBe(false);
+ expect(readFileSync(path,"utf8")).toBe("first");
+ expect(existsSync(join(root,".quarantine"))).toBe(false);
+});
+test("a plain write replaces atomically and leaves no temporary file",async()=>{
+ const {root,port}=fresh(),path=join(root,"p.json");
+ await port.write(path,Buffer.from("one"));await port.write(path,Buffer.from("two"));
+ expect(readFileSync(path,"utf8")).toBe("two");expect(readdirSync(root).filter(name=>name.endsWith(".tmp"))).toEqual([]);
+});
