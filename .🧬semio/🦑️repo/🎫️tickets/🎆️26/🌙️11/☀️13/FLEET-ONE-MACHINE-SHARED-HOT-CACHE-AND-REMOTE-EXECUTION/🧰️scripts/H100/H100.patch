+import {existsSync} from "node:fs";
+import {join} from "node:path";
+import budget from "../../../../../⚡️caching/💾️storage/🔒️enforcement/📦️budget/🔣️policy.json" with {type:"json"};
+import {casRootV1} from "../../../../🗄️cas/🗃️store/🟦️.ts";
+import {parseRemoteCacheActionResultV1} from "../../../../🌐️remote-cache/🔬️action-result/🟦️.ts";
+import {CacheRepairCancelledV1,verifyCachesV1} from "../../../../🩹️cache-repair/🟦️.ts";
+import type {DoctorPortsV1} from "../../../🔌️ports/🟦️.ts";
+import type {DoctorProbeContextV1,DoctorRepairRunV1,DoctorRepairV1} from "../../../🔎️probes/📋️contract/🟦️.ts";
+
+/** 🗺️ The roots `repo doctor --repair` verifies: the host content store and every cache image of the checkout that is mounted (`<partition>/m`); an image that is not attached is not read. */
+export function integrityRootsV1(ports:Pick<DoctorPortsV1,"root"|"environment"|"platform">):readonly string[]{
+ const roots:string[]=[],host=casRootV1(ports.environment,ports.platform==="win32"?"win32":ports.platform);
+ if(existsSync(host))roots.push(host);
+ for(const partition of Object.values(budget.partitions as Record<string,{directory:string}>)){
+  const mount=join(ports.root,...partition.directory.split("/"),"m");
+  if(existsSync(mount))roots.push(mount);
+ }
+ return roots;
+}
+
+const structure=(kind:string,bytes:Uint8Array):string|undefined=>{
+ if(kind!=="remote-ac")return undefined;
+ try{parseRemoteCacheActionResultV1(bytes);return undefined;}catch(error){return String((error as Error).message);}
+};
+
+/** 🩹️ Verifies every cache record below the cache roots of the machine (units, host store objects, remote cache values, generations, closures, receipts, task archives) with progress and cancellation, and moves each corrupt record into the bounded quarantine of its root with a typed, bilingual log row; a dry run only counts. The records are caches: each one is rebuilt on its next miss. */
+export const integrityRepairV1:DoctorRepairV1=Object.freeze({
+ id:"caches-integrity",area:"caches" as const,
+ async run(ports:DoctorPortsV1,_context:DoctorProbeContextV1,dryRun:boolean):Promise<DoctorRepairRunV1>{
+  const roots=integrityRootsV1(ports);
+  if(roots.length===0)return {removed:0,bytes:0,status:"nothing",facts:{records:0,corrupt:0,failed:0,roots:0}};
+  try{
+   const report=await verifyCachesV1({roots,repair:!dryRun,structure,signal:ports.signal,progress:line=>ports.progress("integrity:"+line),stampDirectory:join(ports.root,".cache","b","l","m","verified")});
+   const facts={records:report.records,corrupt:report.corrupt,failed:report.failed,roots:roots.length,partial:report.partial?1:0};
+   return report.corrupt===0?{removed:0,bytes:0,status:"nothing",facts}:{removed:dryRun?report.corrupt:report.quarantined,bytes:0,facts};
+  }catch(error){
+   if(error instanceof CacheRepairCancelledV1)throw error;
+   throw error;
+  }
+ },
+});
