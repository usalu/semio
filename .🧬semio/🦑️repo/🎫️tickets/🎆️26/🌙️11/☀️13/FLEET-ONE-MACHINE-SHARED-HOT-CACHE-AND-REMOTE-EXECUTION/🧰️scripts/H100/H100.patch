+/** 🧪️ `repo doctor --repair` verifies every cache record with progress and cancellation, quarantines the corrupt ones, reports in both languages and never fails a healthy machine. */
+import {afterAll,expect,test} from "bun:test";
+import Ajv from "ajv";
+import {chmodSync,existsSync,mkdirSync,mkdtempSync,readFileSync,rmSync,writeFileSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+import schema from "../../🧬️schema/🔣️.json" with {type:"json"};
+import {doctorArgumentsV1,runDoctorCommandV1} from "../../⌨️command/🟦️.ts";
+import {readQuarantineLogV1,sealRecordV1,sha256HexV1} from "../../../🩹️cache-repair/🟦️.ts";
+
+const ajv=new Ajv({strict:true,allowUnionTypes:true}),report=ajv.compile({definitions:schema.definitions,$ref:"#/definitions/Report"});
+const roots:string[]=[];
+const fresh=():string=>{const root=mkdtempSync(join(tmpdir(),"doctor-repair-"));roots.push(root);return root;};
+afterAll(()=>{for(const root of roots)rmSync(root,{recursive:true,force:true});});
+const key=sha256HexV1("unit"),object=Buffer.from("an object of the host store ".repeat(8)),digest=sha256HexV1(object);
+const entry=sealRecordV1({version:1,key,crate:"demo",dependencies:[],environment:[],outputs:[{name:"a",sha256:digest,bytes:object.length,executable:false}],stderr:null,stdout:null});
+
+function machine(){
+ const root=fresh(),cas=join(root,"cas"),mount=join(root,".cache","b","r","m"),entryFile=join(mount,"u","e",key.slice(0,2),key,"1.json"),objectFile=join(cas,"v1","o",digest.slice(0,2),digest.slice(2));
+ mkdirSync(join(entryFile,".."),{recursive:true});writeFileSync(entryFile,entry);
+ mkdirSync(join(objectFile,".."),{recursive:true});writeFileSync(objectFile,object);chmodSync(objectFile,0o444);
+ return{root,cas,mount,entryFile,objectFile};
+}
+async function run(args:string[],root:string,cas:string,extra:{signal?:AbortSignal;progress?:(line:string)=>void;both?:boolean}={}){
+ const out:string[]=[],progress:string[]=[];
+ const code=await runDoctorCommandV1(args,{root,environment:(extra.both?{SEMIO_CAS_ROOT:cas}:{SEMIO_LANGUAGE:"en",SEMIO_CAS_ROOT:cas}) as never,write:line=>out.push(line),progress:line=>{progress.push(line);extra.progress?.(line);},ports:{now:()=>1000000000000},options:{probes:[]},...extra.signal?{signal:extra.signal}:{}});
+ return{code,out,progress,text:out.join("\n")};
+}
+const rows=(out:string[])=>(JSON.parse(out[0]!) as {repairs:{id:string;status:string;removed:number;dryRun:boolean;facts?:Record<string,number>}[]}).repairs;
+
+test("the arguments: --repair implies --fix, the word repair is the same flag, --dry-run is allowed with it",()=>{
+ expect(doctorArgumentsV1(["--repair"])).toMatchObject({fix:true,repair:true,dryRun:false});
+ expect(doctorArgumentsV1(["repair","--dry-run"])).toMatchObject({fix:true,repair:true,dryRun:true});
+ expect(doctorArgumentsV1(["--fix"])).toMatchObject({fix:true,repair:false});
+ expect(()=>doctorArgumentsV1(["--dry-run"])).toThrow();
+ expect(()=>doctorArgumentsV1(["repair","repair"])).toThrow();
+});
+
+test("a healthy machine: every record is read, nothing is quarantined, the report validates and says so in both languages",async()=>{
+ const {root,cas}=machine();
+ const json=await run(["--repair","--json"],root,cas);
+ expect(json.code).toBe(0);expect(report(JSON.parse(json.out[0]!))).toBe(true);
+ expect(rows(json.out).find(row=>row.id==="caches-integrity")).toMatchObject({status:"nothing",removed:0,facts:{records:2,corrupt:0}});
+ const text=await run(["--repair"],root,cas);
+ expect(text.text).toContain("verified the caches");
+ const both=await run(["--repair"],root,cas,{both:true});
+ expect(both.text).toContain("Caches geprüft");
+});
+
+for(const how of ["truncate","flip","empty"] as const){
+ test(`${how}: a dry run only counts, the repair quarantines the entry and the object, the next run is clean`,async()=>{
+  const {root,cas,entryFile,objectFile}=machine();
+  const damage=(path:string)=>{chmodSync(path,0o644);const bytes=readFileSync(path);if(how==="empty")writeFileSync(path,"");else if(how==="truncate")writeFileSync(path,bytes.subarray(0,bytes.length>>1));else{const copy=Buffer.from(bytes);copy[9]=copy[9]!^0x04;writeFileSync(path,copy);}};
+  damage(entryFile);damage(objectFile);
+  const dry=await run(["--repair","--dry-run","--json"],root,cas);
+  expect(rows(dry.out).find(row=>row.id==="caches-integrity")).toMatchObject({dryRun:true,status:"done",removed:2,facts:{corrupt:2}});
+  expect(existsSync(entryFile)&&existsSync(objectFile)).toBe(true);
+  const real=await run(["--repair","--json"],root,cas);
+  expect(report(JSON.parse(real.out[0]!))).toBe(true);
+  expect(rows(real.out).find(row=>row.id==="caches-integrity")).toMatchObject({dryRun:false,status:"done",removed:2,facts:{corrupt:2,failed:0}});
+  expect(existsSync(entryFile)||existsSync(objectFile)).toBe(false);
+  expect(readQuarantineLogV1(join(root,".cache","b","r","m")).map(row=>row.kind)).toEqual(["unit-entry"]);
+  expect(readQuarantineLogV1(join(cas,"v1")).map(row=>row.kind)).toEqual(["cas-object"]);
+  const again=await run(["--repair","--json"],root,cas);
+  expect(rows(again.out).find(row=>row.id==="caches-integrity")).toMatchObject({status:"nothing",facts:{corrupt:0}});
+ });
+}
+
+test("progress is reported while records are read and a stop request ends the repair as cancelled, keeping what was moved",async()=>{
+ const {root,cas}=machine();
+ for(let index=0;index<600;index++){const hash=sha256HexV1("spill"+index),path=join(root,".cache","b","r","m","u","w","spill",hash);mkdirSync(join(path,".."),{recursive:true});writeFileSync(path,"spill"+index);}
+ const controller=new AbortController();
+ const result=await run(["--repair"],root,cas,{both:true,signal:controller.signal,progress:line=>{if(line.includes("Verifying"))controller.abort();}});
+ expect(result.progress.some(line=>line.includes("Verifying"))).toBe(true);
+ expect(result.text).toContain("repair caches-integrity cancelled");
+});
+
+test("no cache roots at all is a clean machine, not an error",async()=>{
+ const root=fresh();
+ const result=await run(["--repair","--json"],root,join(root,"absent-cas"));
+ expect(result.code).toBe(0);
+ expect(rows(result.out).find(row=>row.id==="caches-integrity")).toMatchObject({status:"nothing",facts:{roots:0}});
+});
