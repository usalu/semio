+/** 🧪️ An image with open writers is never force-detached. */
+import { expect, test } from "bun:test";
+import { detachDiskImageGuardedV1 } from "../../🖼️images/🟦️.ts";
+
+const script = (rows: Record<string, { status: number | null; stdout?: string; error?: Error }>) => {
+  const calls: string[] = [];
+  return { calls, run: (program: string, args: readonly string[]) => { const key = program.split("/").pop() + " " + args.join(" "); calls.push(key); return rows[key] ?? { status: 99 }; } };
+};
+
+test("a polite detach that works never looks at holders", () => {
+  const { calls, run } = script({ "hdiutil detach /dev/disk9": { status: 0 } });
+  expect(detachDiskImageGuardedV1("/dev/disk9", "/Volumes/x", run)).toBe(true);
+  expect(calls).toEqual(["hdiutil detach /dev/disk9"]);
+});
+test("a busy image with an open writer is not forced", () => {
+  const { calls, run } = script({ "hdiutil detach /dev/disk9": { status: 16 }, "lsof -F pc +f -- /Volumes/x": { status: 0, stdout: "p4242\ncrustc\n" } });
+  expect(detachDiskImageGuardedV1("/dev/disk9", "/Volumes/x", run)).toBe(false);
+  expect(calls.some(call => call.includes("-force"))).toBe(false);
+});
+test("a busy image nobody holds (lsof answers 1: nothing found) is forced", () => {
+  const { calls, run } = script({ "hdiutil detach /dev/disk9": { status: 16 }, "lsof -F pc +f -- /Volumes/x": { status: 1, stdout: "" }, "hdiutil detach -force /dev/disk9": { status: 0 } });
+  expect(detachDiskImageGuardedV1("/dev/disk9", "/Volumes/x", run)).toBe(true);
+  expect(calls).toContain("hdiutil detach -force /dev/disk9");
+});
+test("holders that cannot be read are not a licence to force", () => {
+  expect(detachDiskImageGuardedV1("/dev/disk9", "/Volumes/x", script({ "hdiutil detach /dev/disk9": { status: 16 }, "lsof -F pc +f -- /Volumes/x": { status: null, error: new Error("ENOENT") } }).run)).toBe(false);
+  expect(detachDiskImageGuardedV1("/dev/disk9", "/Volumes/x", script({ "hdiutil detach /dev/disk9": { status: 16 }, "lsof -F pc +f -- /Volumes/x": { status: 2 } }).run)).toBe(false);
+});
