+/** 🧪️ A damaged unit cache record (entry file, build script run, cached object) is a miss, is quarantined with its typed reason and heals on the next publish; a compile after the damage is never a failure. */
+import {afterAll,beforeAll,describe,expect,test} from "bun:test";
+import {chmodSync,existsSync,mkdirSync,mkdtempSync,readFileSync,readdirSync,rmSync,writeFileSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+import {casObjectPathV1,casRootV1} from "../../../../../../🏗️build/🗄️cas/🗃️store/🟦️.ts";
+import {readQuarantineLogV1,sealRecordV1} from "../../../../../../🏗️build/🩹️cache-repair/🟦️.ts";
+import {lookupUnitV1,newestBuildRunV1,newestEntryV1,pruneEntriesV1,publishUnitV1,writeBuildRunV1,writeEntryV1} from "../../🟦️.ts";
+
+let base:string,previous:string|undefined;
+beforeAll(()=>{base=mkdtempSync(join(tmpdir(),"semio-unit-repair-"));previous=process.env.SEMIO_CAS_ROOT;process.env.SEMIO_CAS_ROOT=join(base,"cas");});
+afterAll(()=>{if(previous===undefined)delete process.env.SEMIO_CAS_ROOT;else process.env.SEMIO_CAS_ROOT=previous;rmSync(base,{recursive:true,force:true});});
+let count=0;
+const key="a".repeat(64);
+function publish():{root:string;cwd:string;context:Parameters<typeof lookupUnitV1>[2];entry:NonNullable<ReturnType<typeof publishUnitV1>>}{
+ const directory=join(base,"u"+count++),root=join(directory,"cache"),cwd=join(directory,"work"),out=join(cwd,"out");
+ mkdirSync(join(cwd,"src"),{recursive:true});mkdirSync(out,{recursive:true});
+ writeFileSync(join(cwd,"src","lib.rs"),"pub fn f(){}\n");writeFileSync(join(out,"libdemo.rlib"),"rlib bytes ".repeat(40));writeFileSync(join(out,"libdemo.d"),"libdemo.rlib: src/lib.rs\n");
+ const entry=publishUnitV1(root,{key,crate:"demo",cwd,outDir:out,laneRoot:undefined,outputs:[join(out,"libdemo.rlib"),join(out,"libdemo.d")],stdout:"",stderr:"warning: x\n",stampDirectory:undefined});
+ expect(entry).toBeDefined();
+ return{root,cwd,entry:entry!,context:{cwd,laneRoot:undefined,environment:{},stampDirectory:undefined}};
+}
+const entryFile=(root:string):string=>{const directory=join(root,"e",key.slice(0,2),key);return join(directory,readdirSync(directory).filter(name=>name.endsWith(".json"))[0]!);};
+const damage=(path:string,how:"truncate"|"flip"|"empty"):void=>{
+ chmodSync(path,0o644);const bytes=readFileSync(path);
+ if(how==="empty")writeFileSync(path,"");
+ else if(how==="truncate")writeFileSync(path,bytes.subarray(0,bytes.length>>1));
+ else{const copy=Buffer.from(bytes);const at=Math.floor(copy.length/2);copy[at]=copy[at]!^0x01;writeFileSync(path,copy);}
+};
+
+describe("entry files",()=>{
+ test("a published entry is sealed and a lookup hits",()=>{
+  const {root,context}=publish();
+  expect(JSON.parse(readFileSync(entryFile(root),"utf8")).seal).toMatch(/^[0-9a-f]{64}$/u);
+  expect(lookupUnitV1(root,key,context)?.crate).toBe("demo");
+  expect("seal" in lookupUnitV1(root,key,context)!).toBe(false);
+ });
+ for(const how of ["truncate","flip","empty"] as const){
+  test(`${how}: the lookup is a miss, the entry is quarantined once with a typed bilingual reason, a republish heals`,()=>{
+   const {root,context,cwd,entry}=publish();
+   damage(entryFile(root),how);
+   expect(lookupUnitV1(root,key,context)).toBeUndefined();
+   expect(newestEntryV1(root,key)).toBeUndefined();
+   const rows=readQuarantineLogV1(root);
+   expect(rows.length).toBe(1);expect(rows[0]!.kind).toBe("unit-entry");expect(rows[0]!.en).not.toBe(rows[0]!.de);
+   expect(existsSync(join(root,"e",key.slice(0,2),key,"x"))).toBe(false);
+   writeEntryV1(root,entry);
+   expect(lookupUnitV1(root,key,context)?.crate).toBe("demo");
+   void cwd;
+  });
+ }
+ test("an entry whose seal was flipped but whose content is fine is still a miss (a flipped field cannot pass)",()=>{
+  const {root,context}=publish(),path=entryFile(root),value=JSON.parse(readFileSync(path,"utf8"));
+  value.crate="other";writeFileSync(path,JSON.stringify(value));
+  expect(lookupUnitV1(root,key,context)).toBeUndefined();
+  expect(readQuarantineLogV1(root)[0]?.reason).toBe("seal-mismatch");
+ });
+ test("an entry from before sealing is accepted by its shape, and one with a wrong shape is not",()=>{
+  const {root,context,entry}=publish(),path=entryFile(root);
+  writeFileSync(path,JSON.stringify(entry));expect(lookupUnitV1(root,key,context)?.crate).toBe("demo");
+  writeFileSync(path,JSON.stringify({...entry,outputs:"nope"}));expect(lookupUnitV1(root,key,context)).toBeUndefined();
+  expect(readQuarantineLogV1(root)[0]?.reason).toBe("structure");
+ });
+ test("prune drops and quarantines damaged entries instead of throwing",()=>{
+  const {root}=publish();damage(entryFile(root),"truncate");
+  expect(pruneEntriesV1(root,Date.now()).entries).toBe(1);
+  expect(readQuarantineLogV1(root).length).toBe(1);
+ });
+});
+
+describe("cached objects",()=>{
+ for(const how of ["truncate","flip","empty"] as const){
+  test(`${how}: an entry replaying a damaged object is a miss, the object is quarantined in the host store, a republish restores both`,()=>{
+   const {root,context,entry}=publish(),sha=entry.outputs[0]!.sha256;
+   expect(lookupUnitV1(root,key,context)?.crate).toBe("demo");
+   damage(casObjectPathV1(casRootV1(),sha),how);
+   expect(lookupUnitV1(root,key,context)).toBeUndefined();
+   expect(existsSync(casObjectPathV1(casRootV1(),sha))).toBe(false);
+   expect(readQuarantineLogV1(join(casRootV1(),"v1")).some(row=>row.kind==="cas-object")).toBe(true);
+   const again=publish();
+   expect(again.entry.outputs[0]!.sha256).toBe(sha);
+   expect(lookupUnitV1(again.root,key,again.context)?.crate).toBe("demo");
+  });
+ }
+ test("an object replayed by a compile is whole: the restored file equals the published bytes",()=>{
+  const {root,context,entry}=publish();
+  expect(entry.outputs[0]!.bytes).toBe(readFileSync(casObjectPathV1(casRootV1(),entry.outputs[0]!.sha256)).length);
+  expect(lookupUnitV1(root,key,context)).toBeDefined();
+ });
+});
+
+describe("build script runs",()=>{
+ const run=(extra:object={})=>({version:1 as const,key:"b".repeat(64),package:"p",facts:[],environment:[],outputs:[],stdout:null,stderr:null,createdMs:Date.now(),...extra});
+ for(const how of ["truncate","flip","empty"] as const){
+  test(`${how}: a damaged run record is a miss and is quarantined`,()=>{
+   const root=join(base,"runs"+count++);writeBuildRunV1(root,run());
+   const directory=join(root,"r","bb","b".repeat(64)),file=join(directory,readdirSync(directory)[0]!);
+   expect(newestBuildRunV1(root,"b".repeat(64))).toBeDefined();
+   damage(file,how);
+   expect(newestBuildRunV1(root,"b".repeat(64))).toBeUndefined();
+   expect(readQuarantineLogV1(root)[0]?.kind).toBe("build-run");
+  });
+ }
+});
+
+test("sealed text written by the cache equals the contract's seal of the record",()=>{
+ const {root,entry}=publish();
+ const stored=JSON.parse(readFileSync(entryFile(root),"utf8"));
+ expect(stored.seal).toBe(JSON.parse(sealRecordV1(entry)).seal);
+});
