+import {describe,expect,test} from "bun:test";
+import {cacheWatermarkV1} from "../🟦️.ts";
+
+describe("watermark",()=>{
+ const GiB=1073741824;
+ test("the level follows the shared floor and low-water rule, and a need raises both",()=>{
+  const total=32*GiB,mark=cacheWatermarkV1(total,total,0);
+  expect(mark.level).toBe("ok");
+  expect(mark.floorBytes).toBeGreaterThan(0);expect(mark.reliefBytes).toBeGreaterThanOrEqual(mark.floorBytes);
+  expect(cacheWatermarkV1(total,mark.reliefBytes-1).level).toBe("relief");
+  expect(cacheWatermarkV1(total,mark.floorBytes-1).level).toBe("floor");
+  expect(cacheWatermarkV1(total,mark.reliefBytes+1,2*GiB).level).not.toBe("floor");
+  expect(cacheWatermarkV1(total,mark.floorBytes+1,2*GiB).level).toBe("floor");
+ });
+ test("matches the declared floor numbers of the ready sidecar for 19275 MB and 32 GiB images",()=>{
+  expect(Math.round(cacheWatermarkV1(19275*1048576,0).floorBytes/1048576)).toBe(771);
+  expect(Math.round(cacheWatermarkV1(32768*1048576,0).floorBytes/1048576)).toBe(1311);
+ });
+});
