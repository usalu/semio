+/** 🧪️ A damaged host store object is a miss, is quarantined with its typed reason and heals on the next put; sync and async stores alike. */
+import {existsSync,mkdirSync,mkdtempSync,readFileSync,rmSync,statSync,writeFileSync,chmodSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
