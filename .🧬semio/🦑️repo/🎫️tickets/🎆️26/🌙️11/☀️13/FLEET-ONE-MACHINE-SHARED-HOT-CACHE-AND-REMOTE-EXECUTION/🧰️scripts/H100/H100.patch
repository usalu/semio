+import {afterAll,beforeAll,describe,expect,test} from "bun:test";
+import {existsSync,mkdirSync,mkdtempSync,readFileSync,readdirSync,rmSync,writeFileSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+import {spawnSync} from "node:child_process";
+import {generationCanonicalJsonV1,generationSha256V1,parseGenerationReceiptV1,sealGenerationReceiptV1} from "../../../⚡️caching/🚀️bootstrap/📦️dependencies/🧾️generation/🟦️.ts";
+import {CACHE_REPAIR_POLICY_V1,CacheRepairCancelledV1,buildRunShapeV1,cacheRepairLineV1,classifyCacheRecordPathV1,machineQuarantineRootV1,mayForceDetachV1,openSealedRecordV1,parseJsonRecordV1,quarantineRecordSyncV1,readQuarantineLogV1,readSealedRecordSyncV1,readVerifiedRecordSyncV1,refuseForceDetachLineV1,sealRecordV1,setCacheRepairSinkV1,sha256HexV1,unitEntryShapeV1,verifyCacheRecordFileSyncV1,verifyReceiptBytesV1,verifyCachesV1,verifyDigestNamedV1,verifyFileDigestSyncV1,writeDurableSyncV1,writeDurableV1,type CacheRecordKindV1} from "../🟦️.ts";
+
+const structure=(_:CacheRecordKindV1,bytes:Uint8Array):string|undefined=>{const parsed=parseJsonRecordV1(bytes);return parsed.ok?undefined:parsed.reason;};
+let root:string;
+beforeAll(()=>{root=mkdtempSync(join(tmpdir(),"semio-cache-repair-"));});
+afterAll(()=>{rmSync(root,{recursive:true,force:true});});
+let counter=0;
+const fresh=():string=>{const directory=join(root,"c"+counter++);mkdirSync(directory,{recursive:true});return directory;};
+const key=sha256HexV1("unit");
+const entry=(extra:object={})=>({version:1,key,crate:"demo",dependencies:[{path:"a.rs",sha256:sha256HexV1("a")}],environment:[{name:"X",value:null}],outputs:[{name:"libdemo.rlib",sha256:sha256HexV1("lib"),bytes:3,executable:false}],stderr:null,stdout:null,...extra});
+
+type Injection="truncate"|"flip"|"empty"|"missing";
+const INJECTIONS:readonly Injection[]=["truncate","flip","empty","missing"];
+function inject(path:string,how:Injection):void{
+ const bytes=readFileSync(path);
+ if(how==="missing")rmSync(path);
+ else if(how==="empty")writeFileSync(path,"");
+ else if(how==="truncate")writeFileSync(path,bytes.subarray(0,Math.max(1,Math.floor(bytes.length/2))));
+ else{const copy=Buffer.from(bytes);const at=Math.floor(copy.length/2);copy[at]=copy[at]!^0x01;writeFileSync(path,copy);}
+}
+
+type Case={kind:CacheRecordKindV1;relative:string;make(directory:string,path:string):void;detects:readonly Injection[]};
+const ALL:readonly Injection[]=["truncate","flip","empty","missing"];
+const object=Buffer.from("object bytes of a cached compilation output, long enough to cut in half");
+const digest=sha256HexV1(object);
+const receipt=Buffer.from(JSON.stringify(sealGenerationReceiptV1({version:1,purpose:"dependency-generation-receipt",scope:".",walkStamp:"w"} as never)));
+const CASES:readonly Case[]=[
