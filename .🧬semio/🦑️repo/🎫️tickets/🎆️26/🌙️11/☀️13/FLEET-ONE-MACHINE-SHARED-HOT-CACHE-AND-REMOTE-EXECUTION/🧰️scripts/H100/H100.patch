+/** 🧪️ Law: every cache writer that publishes by rename also forces its data to the disk first. The debt is a closed register that may only shrink. */
+import {expect,test} from "bun:test";
+import {readFileSync} from "node:fs";
+import {join} from "node:path";
+import register from "./🔣️allowlist.json" with {type:"json"};
+
+const library=join(import.meta.dir,"..","..","..","..");
+const rename=/\brename(?:Sync)?\(/u,durable=/fsync|writeDurable|writeSynced|\.sync\(\)|datasync/iu,skipped=/(^|\/)(node_modules|🧪️tests|🧰️scripts|🗑️generated|🤖️generated)(\/|$)/u;
+function sources():readonly string[]{
+ const rows:string[]=[];
+ for(const top of ["🏗️build","⚡️caching"])for(const file of new Bun.Glob("**/*.{ts,mjs}").scanSync({cwd:join(library,top),dot:false,followSymlinks:false})){
+  const path=top+"/"+file;
+  if(skipped.test(path)||path.endsWith(".d.mts"))continue;
+  rows.push(path);
+ }
+ return rows.sort();
+}
+const publishesWithoutFsync=(path:string):boolean=>{const text=readFileSync(join(library,path),"utf8");return rename.test(text)&&!durable.test(text);};
+
+test("no new cache writer publishes by rename without an fsync",()=>{
+ const known=new Set(register.files),offenders=sources().filter(path=>publishesWithoutFsync(path)&&!known.has(path));
+ expect(offenders,"use writeDurableSyncV1, writeDurableV1 or writeSyncedSyncV1 of 🩹️cache-repair (en: a rename without fsync can publish an empty file after a crash; de: ein rename ohne fsync kann nach einem Absturz eine leere Datei veröffentlichen)").toEqual([]);
+});
+test("the register only shrinks: a file that became durable or vanished leaves it",()=>{
+ const present=new Set(sources()),stale=register.files.filter(path=>!present.has(path)||!publishesWithoutFsync(path));
+ expect(stale).toEqual([]);
+});
+test("the register is sorted and has no duplicates",()=>{
+ expect([...register.files]).toEqual([...new Set(register.files)].sort());
+});
