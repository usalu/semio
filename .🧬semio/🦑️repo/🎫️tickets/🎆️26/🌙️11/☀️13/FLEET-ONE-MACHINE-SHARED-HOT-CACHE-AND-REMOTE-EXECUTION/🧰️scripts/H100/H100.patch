+/** 🧪️ A damaged remote cache value (blob, action result, task archive) is a miss, is quarantined with its typed reason and the next upload stores a good one. */
+import {afterAll,describe,expect,test} from "bun:test";
+import {createHash} from "node:crypto";
+import {chmodSync,mkdirSync,mkdtempSync,readFileSync,rmSync,statSync,writeFileSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join} from "node:path";
+import {RemoteCacheStoreV1} from "../../💾️store/🟦️.ts";
+import {readQuarantineLogV1} from "../../../🩹️cache-repair/🟦️.ts";
+
+const scratch:string[]=[];
+const directory=(label:string)=>{const path=mkdtempSync(join(tmpdir(),`rcache-repair-${label}-`));scratch.push(path);return path;};
+afterAll(()=>{for(const path of scratch)rmSync(path,{recursive:true,force:true});});
+const body=(bytes:Uint8Array)=>(async function*(){yield bytes;})();
+const sha=(bytes:Uint8Array|string)=>createHash("sha256").update(bytes).digest("hex");
+const open=(folder:string)=>RemoteCacheStoreV1.open({directory:folder,maximumBytes:2**30,maximumEntryBytes:2**22,maximumAgeMilliseconds:0});
+const pathOf=(store:RemoteCacheStoreV1,kind:string,key:string)=>join(store.root,"main",kind,key.slice(0,2),key);
+const damage=(path:string,how:"truncate"|"flip"|"empty")=>{
+ chmodSync(path,0o644);const bytes=readFileSync(path);
+ if(how==="empty")writeFileSync(path,"");
+ else if(how==="truncate")writeFileSync(path,bytes.subarray(0,bytes.length>>1));
+ else{const copy=Buffer.from(bytes);copy[3]=copy[3]!^0x10;writeFileSync(path,copy);}
+};
+const blob=new TextEncoder().encode("a content addressed blob of a remote cache, long enough to be cut in half");
+const result=(()=>{const text=new TextEncoder().encode("hello world, a stdout stream of the action");return Uint8Array.from([0x20,0x01,0x2a,text.length,...text]);})();
+
+describe("blobs",()=>{
+ for(const how of ["truncate","flip","empty"] as const){
+  test(`${how}: a read is a miss, the blob is quarantined, the next upload stores a good one`,async()=>{
+   const store=await open(directory("blob")),key=sha(blob);
+   expect(await store.put("main","cas",key,body(blob),{mode:"content",verify:true,declaredLength:blob.length})).toMatch(/created|exists/u);
+   expect((await store.read("main","cas",key))?.size).toBe(blob.length);
+   damage(pathOf(store,"cas",key),how);
+   expect(await store.read("main","cas",key)).toBeUndefined();
+   expect(await store.has("main","cas",key)).toBe(false);
+   const rows=readQuarantineLogV1(store.root);expect(rows.length).toBe(1);expect(rows[0]!.kind).toBe("remote-cas");expect(rows[0]!.de).not.toBe(rows[0]!.en);
+   expect(await store.put("main","cas",key,body(blob),{mode:"content",verify:true,declaredLength:blob.length})).toBe("created");
+   expect((await store.read("main","cas",key))?.size).toBe(blob.length);
+   expect(readFileSync(pathOf(store,"cas",key))).toEqual(Buffer.from(blob));
+   await store.close();
+  });
+ }
+});
+
+describe("action results",()=>{
+ test("an intact result reads, a cut one is a miss and quarantined",async()=>{
+  const store=await open(directory("ac")),key=sha("action");
+  await store.put("main","ac",key,body(result),{mode:"replace",declaredLength:result.length});
+  expect((await store.read("main","ac",key))?.size).toBe(result.length);
+  writeFileSync(pathOf(store,"ac",key),result.subarray(0,result.length-10));
+  expect(await store.read("main","ac",key)).toBeUndefined();
+  expect(readQuarantineLogV1(store.root)[0]?.kind).toBe("remote-ac");
+  expect(statSync(store.root).isDirectory()).toBe(true);
+  await store.close();
+ });
+ test("an empty result is a legal message (exit code 0, no outputs) and reads",async()=>{
+  const store=await open(directory("ac-empty")),key=sha("none");
+  mkdirSync(join(store.root,"main","ac",key.slice(0,2)),{recursive:true});writeFileSync(pathOf(store,"ac",key),"");
+  expect((await store.read("main","ac",key))?.size).toBe(0);
+  await store.close();
+ });
+});
+
+describe("task archives",()=>{
+ test("an emptied archive is a miss and quarantined; a non-empty one reads",async()=>{
+  const store=await open(directory("nx")),key="12345678901234567890",archive=new Uint8Array(64).fill(7);
+  await store.put("main","nx",key,body(archive),{mode:"keep",declaredLength:archive.length});
+  expect((await store.read("main","nx",key))?.size).toBe(64);
+  writeFileSync(pathOf(store,"nx",key),"");
+  expect(await store.read("main","nx",key)).toBeUndefined();
+  expect(readQuarantineLogV1(store.root)[0]?.reason).toBe("empty");
+  await store.close();
+ });
+});
+
+describe("low-water mark of the volume",()=>{
+ const GiB=1073741824;
+ const withVolume=(free:()=>number)=>RemoteCacheStoreV1.open({directory:directory("volume"),maximumBytes:2**30,maximumEntryBytes:2**22,maximumAgeMilliseconds:0,volume:()=>({totalBytes:32*GiB,freeBytes:free()})});
+ test("above the mark nothing changes; below the floor a write is refused with the typed outcome and nothing is written",async()=>{
+  let free=20*GiB;const store=await withVolume(()=>free);
+  expect(await store.put("main","nx","k1",body(new Uint8Array(16)),{mode:"keep",declaredLength:16})).toBe("created");
+  free=100*1048576;
+  expect(await store.put("main","nx","k2",body(new Uint8Array(16)),{mode:"keep",declaredLength:16})).toBe("capacity");
+  expect(await store.has("main","nx","k2")).toBe(false);
+  free=20*GiB;
+  expect(await store.put("main","nx","k2",body(new Uint8Array(16)),{mode:"keep",declaredLength:16})).toBe("created");
+  await store.close();
+ });
+ test("between the floor and the low-water mark the collection runs before the write and the write is accepted",async()=>{
+  let free=20*GiB;const store=await withVolume(()=>free);
+  for(let index=0;index<4;index++)await store.put("main","nx","old"+index,body(new Uint8Array(1000)),{mode:"keep",declaredLength:1000});
+  const before=store.usage().entries;free=Math.floor(1.5*GiB);
+  expect(await store.put("main","nx","fresh",body(new Uint8Array(16)),{mode:"keep",declaredLength:16})).toBe("created");
+  expect(store.usage().entries).toBeLessThanOrEqual(before+1);
+  await store.close();
+ });
+ test("a volume that cannot be measured never refuses",async()=>{
+  const store=await RemoteCacheStoreV1.open({directory:directory("blind"),maximumBytes:2**30,maximumEntryBytes:2**22,maximumAgeMilliseconds:0,volume:()=>undefined});
+  expect(await store.put("main","nx","k",body(new Uint8Array(16)),{mode:"keep",declaredLength:16})).toBe("created");await store.close();
+ });
+});
