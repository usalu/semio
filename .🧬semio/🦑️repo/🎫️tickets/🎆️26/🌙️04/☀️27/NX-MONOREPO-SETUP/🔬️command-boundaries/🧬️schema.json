{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "entry",
          "exports",
          "maximumInputs"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "entry": {
            "type": "string"
          },
          "exports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maximumInputs": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
