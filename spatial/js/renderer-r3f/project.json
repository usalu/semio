{
  "name": "@spatial/js-renderer-r3f",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "spatial/js/renderer-r3f",
        "command": "bun ./script.ts dev",
        "env": {
          "SPATIAL_R3F_PLAY_PORT": "6020",
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "spatial/js/renderer-r3f",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "spatial/js/renderer-r3f",
        "command": "bun ./script.ts test",
        "env": {
          "SPATIAL_R3F_PLAY_PORT": "6041"
        },
        "forwardAllArgs": true
      }
    }
  }
}
