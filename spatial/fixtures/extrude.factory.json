{
  "schema": "spatial.factory/v1",
  "id": "feature.extrudeWire",
  "version": "1.0.0",
  "label": "Extrude Wire",
  "requires": {
    "kernel": {
      "operations": ["wire.extrudeToCell", "entity.tessellate"],
      "editableEntities": ["vertex", "edge", "wire", "face", "shell", "cell"]
    }
  },
  "guards": {
    "hasWireAndDistance": {
      "all": [
        { "exists": { "path": "wireId" } },
        { "exists": { "path": "distance" } },
        { ">": [{ "path": "distance" }, 0] }
      ]
    }
  },
  "history": {
    "excludeEvents": ["pointer.move"]
  },
  "machine": {
    "initial": "selectWire",
    "states": {
      "selectWire": {
        "on": {
          "selection.changed": {
            "target": "setDistance",
            "actions": [{ "op": "assign", "path": "wireId", "value": { "$event": "wireId" } }]
          },
          "cancel": { "target": "cancelled" }
        }
      },
      "setDistance": {
        "on": {
          "set.distance": {
            "actions": [{ "op": "assign", "path": "distance", "value": { "$event": "value" } }]
          },
          "confirm": { "target": "committed", "guard": "hasWireAndDistance" },
          "cancel": { "target": "cancelled" }
        }
      },
      "committed": { "final": true },
      "cancelled": { "final": true }
    }
  },
  "display": {
    "states": {
      "setDistance": [
        {
          "kind": "label",
          "id": "hint",
          "role": "prompt",
          "params": { "text": "Set extrude distance", "position": { "const": [0, 2, 0] } }
        }
      ]
    }
  },
  "commit": {
    "when": "hasWireAndDistance",
    "operation": {
      "kind": "wire.extrudeToCell",
      "params": {
        "wireId": { "path": "wireId" },
        "distance": { "path": "distance" },
        "direction": { "const": [0, 0, 1] }
      }
    }
  }
}
