{
  "schema": "spatial.command/v1",
  "id": "measure.area",
  "version": "1.0.0",
  "label": "Area",
  "guards": [
    {
      "name": "hasFaceArea",
      "expr": {
        "kind": "notEmpty",
        "target": { "root": "context", "segments": [{ "kind": "field", "name": "resolvedFaceIds" }] }
      }
    }
  ],
  "history": { "excludeEvents": ["pointer.move", "confirm"] },
  "machine": {
    "initial": "selectFace",
    "states": [
      {
        "name": "selectFace",
        "selection": { "accept": ["face", "surface"], "multiple": false, "prompt": "Pick face or surface" },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "ready",
                "actions": [
                  {
                    "op": "assign",
                    "target": { "root": "context", "segments": [{ "kind": "field", "name": "pickedId" }] },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        { "kind": "field", "name": "targets" },
                        { "kind": "index", "index": 0 },
                        { "kind": "field", "name": "id" }
                      ]
                    }
                  },
                  {
                    "op": "kernel.query",
                    "query": "surface.resolveFaces",
                    "assignTo": { "root": "context", "segments": [{ "kind": "field", "name": "resolvedFaceIds" }] },
                    "params": {
                      "kind": "surface.resolveFaces",
                      "surfaceId": {
                        "kind": "path",
                        "root": "context",
                        "segments": [{ "kind": "field", "name": "pickedId" }]
                      }
                    }
                  }
                ]
              }
            ]
          },
          { "event": "cancel", "transitions": [{ "target": "selectFace" }] }
        ]
      },
      {
        "name": "ready",
        "on": [{ "event": "confirm", "transitions": [{ "target": "committed", "guard": "hasFaceArea" }] }]
      },
      { "name": "committed", "final": true }
    ]
  },
  "commit": {
    "when": "hasFaceArea",
    "fromStates": ["ready"],
    "operation": {
      "kind": "measure.area",
      "faceId": {
        "kind": "path",
        "root": "context",
        "segments": [
          { "kind": "field", "name": "resolvedFaceIds" },
          { "kind": "index", "index": 0 }
        ]
      }
    },
    "outputDataPath": { "root": "context", "segments": [{ "kind": "field", "name": "area" }] }
  }
}
