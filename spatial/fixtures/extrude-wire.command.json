{
  "schema": "spatial.command/v1",
  "id": "feature.extrudeWire",
  "version": "1.0.0",
  "label": "Extrude Wire",
  "interaction": {
    "spatialGroundPick": false,
    "pickDisabledStates": ["idle", "selectWire", "setDistance", "committed"],
    "groundPointerMoveStates": [],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "requires": {
    "kernel": {
      "operations": ["wire.extrudeToCell", "entity.tessellate"],
      "editableEntities": ["vertex", "edge", "wire", "face", "shell", "cell"]
    }
  },
  "guards": {
    "hasWireAndDistance": {
      "all": [
        { "exists": { "path": "wireId" } },
        { "exists": { "path": "distance" } },
        { ">": [{ "path": "distance" }, 0] }
      ]
    }
  },
  "history": {
    "excludeEvents": ["pointer.move", "confirm"]
  },
  "machine": {
    "initial": "selectWire",
    "states": {
      "selectWire": {
        "selection": {
          "accept": ["wire"],
          "multiple": false,
          "prompt": "Pick wire"
        },
        "on": {
          "selection.changed": {
            "target": "setDistance",
            "key": "i",
            "label": "Pick wire",
            "actions": [{ "op": "assign", "path": "wireId", "value": { "$event": "targets.0.id" } }]
          },
          "cancel": { "target": "selectWire", "key": "x", "label": "Cancel" }
        }
      },
      "setDistance": {
        "on": {
          "set.distance": {
            "key": "n",
            "label": "Apply distance",
            "actions": [{ "op": "assign", "path": "distance", "value": { "$event": "value" } }]
          },
          "confirm": {
            "target": "committed",
            "guard": "hasWireAndDistance",
            "key": "Enter",
            "label": "Commit extrude"
          },
          "cancel": { "target": "selectWire", "key": "x", "label": "Cancel" }
        }
      },
      "committed": { "final": true }
    }
  },
  "display": {
    "states": {
      "setDistance": [
        {
          "kind": "label",
          "id": "hint",
          "role": "prompt",
          "params": { "text": "Set extrude distance", "position": { "const": [0, 2, 0] } }
        }
      ]
    }
  },
  "commit": {
    "when": "hasWireAndDistance",
    "fromStates": ["setDistance"],
    "operation": {
      "kind": "wire.extrudeToCell",
      "params": {
        "wireId": { "path": "wireId" },
        "distance": { "path": "distance" },
        "direction": { "const": [0, 0, 1] }
      }
    }
  }
}
