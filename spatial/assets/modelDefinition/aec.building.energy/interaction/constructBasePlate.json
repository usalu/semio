{
  "schema": "spatial.interaction/v1",
  "id": "energy.energy.constructBasePlate",
  "version": "1.0.0",
  "label": "Construct Base Plate",
  "key": "b",
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": [
      "choose_mode",
      "committed"
    ],
    "groundPointerMoveStates": [
      "two_points_first",
      "two_points_second"
    ],
    "heightDragStates": [
      "two_points_height",
      "curve_height"
    ],
    "verticalRodStates": [],
    "heightConfirmState": "two_points_height"
  },
  "guards": [
    {
      "name": "hasConstructMode",
      "expr": {
        "kind": "exists",
        "target": {
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "constructMode"
            }
          ]
        }
      }
    }
  ],
  "machine": {
    "initial": "choose_mode",
    "states": [
      {
        "name": "choose_mode",
        "on": [
          {
            "event": "mode.2points",
            "transitions": [
              {
                "target": "two_points_first",
                "key": "1",
                "label": "2 points + height",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "constructMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "2PointsAndHeight"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.curve",
            "transitions": [
              {
                "target": "curve_wire",
                "key": "2",
                "label": "Curve + height",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "constructMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "curveAndHeight"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.surface",
            "transitions": [
              {
                "target": "committed",
                "key": "3",
                "label": "Surface",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "constructMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "surface"
                    }
                  },
                  {
                    "op": "interaction.call",
                    "interaction": "pick.face",
                    "outputs": {
                      "faceId": "faceId"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "two_points_first",
        "on": [
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "two_points_second",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "pointA"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "two_points_second",
        "on": [
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "two_points_height",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "pointB"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "two_points_height",
        "on": [
          {
            "event": "set.height",
            "transitions": [
              {
                "target": "committed",
                "key": "n",
                "label": "Height",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "height"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "value"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "curve_wire",
        "selection": {
          "accept": [
            "wire"
          ],
          "multiple": false,
          "prompt": "Pick path wire"
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "curve_height",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "wireId"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        },
                        {
                          "kind": "index",
                          "index": 0
                        },
                        {
                          "kind": "field",
                          "name": "id"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "curve_height",
        "on": [
          {
            "event": "set.height",
            "transitions": [
              {
                "target": "committed",
                "key": "n",
                "label": "Height",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "height"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "value"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "choose_mode",
        "items": [
          {
            "kind": "label",
            "id": "choose-mode",
            "role": "prompt",
            "text": "Construct Base Plate: 1=2pts+height 2=curve+height 3=surface",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "when": "hasConstructMode",
    "fromStates": [
      "committed"
    ],
    "operation": {
      "kind": "action",
      "action": "energy.energy.constructBasePlate",
      "params": {
        "typology": {
          "kind": "const",
          "value": "energy.energy.baseplate"
        },
        "constructMode": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "constructMode"
            }
          ]
        },
        "pointA": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "pointA"
            }
          ]
        },
        "pointB": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "pointB"
            }
          ]
        },
        "height": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "height"
            }
          ]
        },
        "wireId": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "wireId"
            }
          ]
        },
        "faceId": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "faceId"
            }
          ]
        }
      }
    }
  },
  "produces": {
    "typology": "energy.energy.baseplate"
  }
}
