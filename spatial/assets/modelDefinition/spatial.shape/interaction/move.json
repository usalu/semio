{
  "schema": "spatial.interaction/v1",
  "id": "transform.move",
  "version": "1.0.0",
  "label": "Move",
  "key": "m",
  "guards": [
    {
      "name": "hasSelectionTargets",
      "expr": {
        "kind": "notEmpty",
        "target": {
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "targets"
            }
          ]
        }
      }
    },
    {
      "name": "hasMoveFrom",
      "expr": {
        "kind": "exists",
        "target": {
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "from"
            }
          ]
        }
      }
    },
    {
      "name": "noMoveFrom",
      "expr": {
        "kind": "not",
        "arg": {
          "kind": "exists",
          "target": {
            "root": "context",
            "segments": [
              {
                "kind": "field",
                "name": "from"
              }
            ]
          }
        }
      }
    }
  ],
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": [
      "idle",
      "committed"
    ],
    "groundPointerMoveStates": [
      "point_to_move_from",
      "point_to_move_to"
    ],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "select_objects_to_move",
                "key": "s",
                "label": "Start",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [
                        0,
                        0,
                        0
                      ]
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "free"
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cplaneNormal"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [
                        0,
                        0,
                        1
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_objects_to_move",
        "selection": {
          "accept": [
            "vertex",
            "edge",
            "wire",
            "face",
            "shell",
            "solid"
          ],
          "multiple": true,
          "prompt": "Select objects to move"
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_objects_to_move",
                "key": "s",
                "label": "Select",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "targets"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "guard": "hasSelectionTargets",
                "target": "point_to_move_from",
                "key": "Enter",
                "label": "Finish selection"
              }
            ]
          },
          {
            "event": "contextmenu",
            "transitions": [
              {
                "guard": "hasSelectionTargets",
                "target": "point_to_move_from",
                "key": "RightClick",
                "label": "Finish selection"
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "idle",
                "key": "x",
                "label": "Cancel"
              }
            ]
          }
        ]
      },
      {
        "name": "point_to_move_from",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.free",
            "transitions": [
              {
                "key": "f",
                "label": "Free",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "free"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.normal",
            "transitions": [
              {
                "key": "n",
                "label": "Normal",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "normal"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.vertical",
            "transitions": [
              {
                "key": "v",
                "label": "Vertical",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "vertical"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "guard": "hasMoveFrom",
                "target": "point_to_move_to",
                "key": "Enter",
                "label": "Source point picked"
              },
              {
                "guard": "noMoveFrom",
                "target": "point_to_move_to",
                "key": "Enter",
                "label": "Use selection center",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.selectionBboxCenter",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "from"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "point_to_move_to",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "from"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "idle",
                "key": "x",
                "label": "Cancel"
              }
            ]
          }
        ]
      },
      {
        "name": "point_to_move_to",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "action",
                    "action": "command.constrainMoveCursor",
                    "params": {
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.free",
            "transitions": [
              {
                "key": "f",
                "label": "Free",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "free"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.normal",
            "transitions": [
              {
                "key": "n",
                "label": "Normal",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "normal"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.vertical",
            "transitions": [
              {
                "key": "v",
                "label": "Vertical",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "vertical"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "undo.pick",
            "transitions": [
              {
                "target": "point_to_move_from",
                "key": "u",
                "label": "Undo pick",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.undoPick",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "clearKeys": {
                        "kind": "const",
                        "value": [
                          "from",
                          "to"
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "committed",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "to"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "idle",
                "key": "x",
                "label": "Cancel"
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "select_objects_to_move",
        "items": [
          {
            "kind": "label",
            "id": "select_objects_to_move-prompt",
            "role": "prompt",
            "text": "Select objects to move (Enter or Space to finish)",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "select_objects_to_move-preview",
            "role": "preview",
            "previewKind": "selected-objects",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "state": "point_to_move_from",
        "items": [
          {
            "kind": "label",
            "id": "point_to_move_from-prompt",
            "role": "prompt",
            "text": "Point to move from (Enter = selection center; n/v/f = Normal/Vertical/Free)",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "point_to_move_from-preview",
            "role": "preview",
            "previewKind": "selected-objects",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "point_to_move_from-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      },
      {
        "state": "point_to_move_to",
        "items": [
          {
            "kind": "label",
            "id": "point_to_move_to-prompt",
            "role": "prompt",
            "text": "Point to move to (u = undo pick; n/v/f = Normal/Vertical/Free)",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "point_to_move_to-preview",
            "role": "preview",
            "previewKind": "move-preview",
            "params": {
              "from": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "from"
                  }
                ]
              },
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "moveMode": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "moveMode"
                  }
                ]
              },
              "cplaneNormal": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cplaneNormal"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "point_to_move_to-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "point_to_move_to-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "from"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "fromStates": [
      "committed"
    ],
    "operation": {
      "kind": "action",
      "action": "transform.move",
      "params": {
        "from": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "from"
            }
          ]
        },
        "to": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "to"
            }
          ]
        },
        "targets": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "targets"
            }
          ]
        },
        "moveMode": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "moveMode"
            }
          ]
        },
        "cplaneNormal": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "cplaneNormal"
            }
          ]
        }
      }
    }
  },
  "produces": {
    "typology": "spatial.shape.transform.move"
  }
}
