{
  "schema": "spatial.interaction/v1",
  "id": "solid.sphere",
  "version": "1.0.0",
  "label": "Sphere",
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": [
      "idle",
      "committed"
    ],
    "groundPointerMoveStates": [
      "center_of_sphere",
      "radius"
    ],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "center_of_sphere",
                "key": "s",
                "label": "Start",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [
                        0,
                        0,
                        0
                      ]
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "center_of_sphere",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "radius",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "center"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "radius",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "committed",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "radiusPoint"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "set.radius",
            "transitions": [
              {
                "target": "committed",
                "key": "n",
                "label": "Apply Number",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "radius"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "value"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "center_of_sphere",
        "items": [
          {
            "kind": "label",
            "id": "center_of_sphere-prompt",
            "role": "prompt",
            "text": "Center of sphere",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "center_of_sphere-preview",
            "role": "preview",
            "previewKind": "point",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "center_of_sphere-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "center_of_sphere-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "prevPoint"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      },
      {
        "state": "radius",
        "items": [
          {
            "kind": "label",
            "id": "radius-prompt",
            "role": "prompt",
            "text": "Radius",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "radius-preview",
            "role": "preview",
            "previewKind": "sphere",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "radius-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "radius-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "prevPoint"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "fromStates": [
      "committed"
    ],
    "operation": {
      "kind": "action",
      "action": "command.finish",
      "params": {
        "commandId": {
          "kind": "const",
          "value": "solid.sphere"
        },
        "resultKind": {
          "kind": "const",
          "value": "sphere"
        }
      }
    }
  },
  "key": "h",
  "produces": {
    "typology": "spatial.shape.solid.sphere"
  }
}
