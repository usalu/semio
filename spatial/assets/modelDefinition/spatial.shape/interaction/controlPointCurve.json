{
  "schema": "spatial.interaction/v1",
  "id": "curve.controlPointCurve",
  "version": "1.0.0",
  "label": "ControlPointCurve",
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": [
      "idle",
      "committed"
    ],
    "groundPointerMoveStates": [
      "start_of_curve",
      "next_control_point"
    ],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "start_of_curve",
                "key": "s",
                "label": "Start",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [
                        0,
                        0,
                        0
                      ]
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "start_of_curve",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "next_control_point",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "next_control_point",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "next_control_point",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "committed",
                "key": "Enter",
                "label": "Finish"
              }
            ]
          },
          {
            "event": "contextmenu",
            "transitions": [
              {
                "target": "committed",
                "key": "RightClick",
                "label": "Finish"
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "start_of_curve",
        "items": [
          {
            "kind": "label",
            "id": "start_of_curve-prompt",
            "role": "prompt",
            "text": "Start of curve",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "start_of_curve-preview",
            "role": "preview",
            "previewKind": "point",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "start_of_curve-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "start_of_curve-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "prevPoint"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      },
      {
        "state": "next_control_point",
        "items": [
          {
            "kind": "label",
            "id": "next_control_point-prompt",
            "role": "prompt",
            "text": "Next control point",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "next_control_point-preview",
            "role": "preview",
            "previewKind": "control-curve",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "next_control_point-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "next_control_point-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "prevPoint"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "fromStates": [
      "committed"
    ],
    "operation": {
      "kind": "action",
      "action": "command.finish",
      "params": {
        "commandId": {
          "kind": "const",
          "value": "curve.controlPointCurve"
        },
        "resultKind": {
          "kind": "const",
          "value": "curve"
        }
      }
    }
  },
  "key": "u",
  "produces": {
    "typology": "spatial.shape.curve.control-point-curve"
  }
}
