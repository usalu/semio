{
  "schema": "spatial.interaction/v1",
  "id": "surface.extrudeCrv",
  "version": "1.0.0",
  "label": "ExtrudeCrv",
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": [
      "idle",
      "committed"
    ],
    "groundPointerMoveStates": [
      "extrusion_distance"
    ],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "select_curves_to_extrude",
                "key": "s",
                "label": "Start",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [
                        0,
                        0,
                        0
                      ]
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_curves_to_extrude",
        "selection": {
          "accept": [
            "wire",
            "edge"
          ],
          "multiple": true,
          "prompt": "Select curves to extrude"
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_curves_to_extrude",
                "key": "s",
                "label": "Select",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "curves"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "committed",
                "key": "Enter",
                "label": "Finish"
              }
            ]
          },
          {
            "event": "contextmenu",
            "transitions": [
              {
                "target": "committed",
                "key": "RightClick",
                "label": "Finish"
              }
            ]
          }
        ]
      },
      {
        "name": "extrusion_distance",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "committed",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "distancePoint"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "set.distance",
            "transitions": [
              {
                "target": "committed",
                "key": "n",
                "label": "Apply Number",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "distance"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "value"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "select_curves_to_extrude",
        "items": [
          {
            "kind": "label",
            "id": "select_curves_to_extrude-prompt",
            "role": "prompt",
            "text": "Select curves to extrude",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "select_curves_to_extrude-preview",
            "role": "preview",
            "previewKind": "highlight-curves",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "curves"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "state": "extrusion_distance",
        "items": [
          {
            "kind": "label",
            "id": "extrusion_distance-prompt",
            "role": "prompt",
            "text": "Extrusion distance",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "extrusion_distance-preview",
            "role": "preview",
            "previewKind": "extrusion",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "extrusion_distance-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "extrusion_distance-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "prevPoint"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "fromStates": [
      "ready"
    ],
    "operation": {
      "kind": "action",
      "action": "command.finish",
      "params": {
        "commandId": {
          "kind": "const",
          "value": "surface.extrudeCrv"
        },
        "resultKind": {
          "kind": "const",
          "value": "extrusion"
        }
      }
    }
  },
  "key": "0",
  "produces": {
    "typology": "builtin.surface.extrude-crv"
  }
}
