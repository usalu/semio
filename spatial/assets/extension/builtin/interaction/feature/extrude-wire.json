{
  "schema": "spatial.interaction/v1",
  "id": "feature.extrudeWire",
  "version": "1.0.0",
  "label": "ExtrudeWire",
  "key": "e",
  "interaction": {
    "spatialGroundPick": false,
    "pickDisabledStates": [
      "idle",
      "selectWire",
      "setDistance",
      "committed"
    ],
    "groundPointerMoveStates": [],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "requires": {
    "kernel": {
      "operations": [
        "wire.extrudeToCell",
        "entity.tessellate"
      ]
    }
  },
  "guards": [
    {
      "name": "hasWireAndDistance",
      "expr": {
        "kind": "all",
        "args": [
          {
            "kind": "exists",
            "target": {
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "wireId"
                }
              ]
            }
          },
          {
            "kind": "exists",
            "target": {
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "distance"
                }
              ]
            }
          },
          {
            "kind": "binop",
            "op": ">",
            "left": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "distance"
                }
              ]
            },
            "right": {
              "kind": "const",
              "value": 0
            }
          }
        ]
      }
    }
  ],
  "machine": {
    "initial": "selectWire",
    "states": [
      {
        "name": "selectWire",
        "selection": {
          "accept": [
            "wire"
          ],
          "multiple": false,
          "prompt": "Pick wire"
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "setDistance",
                "key": "i",
                "label": "Pick wire",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "wireId"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        },
                        {
                          "kind": "index",
                          "index": 0
                        },
                        {
                          "kind": "field",
                          "name": "id"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "selectWire",
                "key": "x",
                "label": "Cancel"
              }
            ]
          }
        ]
      },
      {
        "name": "setDistance",
        "on": [
          {
            "event": "set.distance",
            "transitions": [
              {
                "key": "n",
                "label": "Apply distance",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "distance"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "value"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "committed",
                "guard": "hasWireAndDistance",
                "key": "Enter",
                "label": "Commit extrude"
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "selectWire",
                "key": "x",
                "label": "Cancel"
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "setDistance",
        "items": [
          {
            "kind": "label",
            "id": "hint",
            "role": "prompt",
            "text": "Set extrude distance",
            "position": {
              "kind": "const",
              "value": [
                0,
                2,
                0
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "when": "hasWireAndDistance",
    "fromStates": [
      "setDistance"
    ],
    "operation": {
      "kind": "action",
      "action": "feature.extrudeWireToSolid",
      "params": {
        "wireId": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "wireId"
            }
          ]
        },
        "distance": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "distance"
            }
          ]
        },
        "direction": {
          "kind": "const",
          "value": [
            0,
            0,
            1
          ]
        }
      }
    }
  },
  "produces": {
    "typology": "builtin.c:.git"
  }
}
