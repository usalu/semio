{
  "schema": "spatial.interaction/v1",
  "id": "transform.rotate",
  "version": "1.0.0",
  "label": "Rotate",
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": [
      "idle",
      "committed"
    ],
    "groundPointerMoveStates": [
      "center_of_rotation",
      "angle_or_first_reference_point",
      "second_reference_point"
    ],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "select_objects_to_rotate",
                "key": "s",
                "label": "Start",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [
                        0,
                        0,
                        0
                      ]
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_objects_to_rotate",
        "selection": {
          "accept": [
            "vertex",
            "edge",
            "wire",
            "face",
            "shell",
            "cell",
            "surface",
            "part"
          ],
          "multiple": true,
          "prompt": "Select objects to rotate"
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_objects_to_rotate",
                "key": "s",
                "label": "Select",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "targets"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "center_of_rotation",
                "key": "Enter",
                "label": "Finish"
              }
            ]
          },
          {
            "event": "contextmenu",
            "transitions": [
              {
                "target": "center_of_rotation",
                "key": "RightClick",
                "label": "Finish"
              }
            ]
          }
        ]
      },
      {
        "name": "center_of_rotation",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "angle_or_first_reference_point",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "center"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "angle_or_first_reference_point",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "second_reference_point",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "referenceA"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "set.angle",
            "transitions": [
              {
                "target": "second_reference_point",
                "key": "n",
                "label": "Apply Number",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "angle"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "value"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "second_reference_point",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "committed",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "referenceB"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
