{
  "schema": "spatial.interaction/v1",
  "id": "transform.move",
  "version": "1.0.0",
  "label": "Move",
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": [
      "idle",
      "committed"
    ],
    "groundPointerMoveStates": [
      "point_to_move_from",
      "point_to_move_to"
    ],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "select_objects_to_move",
                "key": "s",
                "label": "Start",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [
                        0,
                        0,
                        0
                      ]
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_objects_to_move",
        "selection": {
          "accept": [
            "vertex",
            "edge",
            "wire",
            "face",
            "shell",
            "cell",
            "surface",
            "part"
          ],
          "multiple": true,
          "prompt": "Select objects to move"
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_objects_to_move",
                "key": "s",
                "label": "Select",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "targets"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "point_to_move_from",
                "key": "Enter",
                "label": "Finish"
              }
            ]
          },
          {
            "event": "contextmenu",
            "transitions": [
              {
                "target": "point_to_move_from",
                "key": "RightClick",
                "label": "Finish"
              }
            ]
          }
        ]
      },
      {
        "name": "point_to_move_from",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "point_to_move_to",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "from"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "point_to_move_to",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "committed",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "to"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "select_objects_to_move",
        "items": [
          {
            "kind": "label",
            "id": "select_objects_to_move-prompt",
            "role": "prompt",
            "text": "Select objects to move",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "select_objects_to_move-preview",
            "role": "preview",
            "previewKind": "selected-objects",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "state": "point_to_move_from",
        "items": [
          {
            "kind": "label",
            "id": "point_to_move_from-prompt",
            "role": "prompt",
            "text": "Point to move from",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "point_to_move_from-preview",
            "role": "preview",
            "previewKind": "point",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "point_to_move_from-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "point_to_move_from-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "prevPoint"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      },
      {
        "state": "point_to_move_to",
        "items": [
          {
            "kind": "label",
            "id": "point_to_move_to-prompt",
            "role": "prompt",
            "text": "Point to move to",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "point_to_move_to-preview",
            "role": "preview",
            "previewKind": "move-preview",
            "params": {
              "from": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "from"
                  }
                ]
              },
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "point_to_move_to-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "point_to_move_to-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "from"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "fromStates": [
      "committed"
    ],
    "operation": {
      "kind": "action",
      "action": "transform.move",
      "params": {
        "from": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "from"
            }
          ]
        },
        "to": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "to"
            }
          ]
        },
        "targets": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "targets"
            }
          ]
        }
      }
    }
  },
  "key": "m"
}
