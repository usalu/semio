{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/command",
  "title": "SpatialCommandSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "machine", "commit"],
  "properties": {
    "schema": { "const": "spatial.command/v1" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "label": { "type": "string" },
    "context": { "$ref": "#/$defs/contextDecl" },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kernel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operations": { "type": "array", "items": { "type": "string" } },
            "editableEntities": { "type": "array", "items": { "type": "string" } },
            "derivedEntities": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expr"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "expr": { "$ref": "expression.json" }
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "states"],
      "properties": {
        "initial": { "type": "string" },
        "states": {
          "type": "array",
          "items": { "$ref": "#/$defs/stateDef" }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "items"],
            "properties": {
              "state": { "type": "string" },
              "items": { "type": "array", "items": { "$ref": "#/$defs/displayItem" } }
            }
          }
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excludeEvents": { "type": "array", "items": { "type": "string" } }
      }
    },
    "interaction": { "$ref": "#/$defs/spatialInteraction" },
    "commit": { "$ref": "#/$defs/commitSpec" }
  },
  "$defs": {
    "pathRoot": { "type": "string", "enum": ["context", "event"] },
    "pathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "field" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "index"],
          "properties": {
            "kind": { "const": "index" },
            "index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "pathTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "segments"],
      "properties": {
        "root": { "$ref": "#/$defs/pathRoot" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/pathSegment" } }
      }
    },
    "contextDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "kind": {
                "type": "string",
                "enum": ["string", "number", "boolean", "vec3", "stringArray", "unknown"]
              },
              "enumValues": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "spatialInteraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spatialGroundPick": { "type": "boolean" },
        "pickDisabledStates": { "type": "array", "items": { "type": "string" } },
        "groundPointerMoveStates": { "type": "array", "items": { "type": "string" } },
        "heightDragStates": { "type": "array", "items": { "type": "string" } },
        "verticalRodStates": { "type": "array", "items": { "type": "string" } },
        "heightConfirmState": { "type": ["string", "null"] }
      }
    },
    "selectionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accept"],
      "properties": {
        "accept": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vertex",
              "edge",
              "wire",
              "face",
              "shell",
              "cell",
              "cellComplex",
              "cluster",
              "surface",
              "part"
            ]
          }
        },
        "multiple": { "type": "boolean" },
        "prompt": { "type": "string" }
      }
    },
    "transitionSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string" },
        "guard": { "type": "string" },
        "transient": { "type": "boolean" },
        "key": { "type": "string" },
        "label": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    },
    "eventHandler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "transitions"],
      "properties": {
        "event": { "type": "string", "minLength": 1 },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transitionSpec" } }
      }
    },
    "stateDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "final": { "type": "boolean" },
        "selection": { "$ref": "#/$defs/selectionSpec" },
        "on": { "type": "array", "items": { "$ref": "#/$defs/eventHandler" } }
      }
    },
    "kernelQueryParams": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "surfaceId"],
          "properties": {
            "kind": { "const": "surface.resolveFaces" },
            "surfaceId": { "$ref": "expression.json" }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "target", "value"],
          "properties": {
            "op": { "const": "assign" },
            "target": { "$ref": "#/$defs/pathTarget" },
            "value": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "target"],
          "properties": {
            "op": { "const": "clear" },
            "target": { "$ref": "#/$defs/pathTarget" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "target", "value"],
          "properties": {
            "op": { "const": "append" },
            "target": { "$ref": "#/$defs/pathTarget" },
            "value": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "event"],
          "properties": {
            "op": { "const": "emit" },
            "event": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "event"],
          "properties": {
            "op": { "const": "raise" },
            "event": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {
            "op": { "const": "openTransaction" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {
            "op": { "const": "commitTransaction" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {
            "op": { "const": "rollbackTransaction" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {
            "op": { "const": "requestPreview" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "query", "assignTo", "params"],
          "properties": {
            "op": { "const": "kernel.query" },
            "query": { "type": "string" },
            "assignTo": { "$ref": "#/$defs/pathTarget" },
            "params": { "$ref": "#/$defs/kernelQueryParams" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {
            "op": { "const": "resolveEditable" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "severity", "code", "message"],
          "properties": {
            "op": { "const": "setDiagnostic" },
            "severity": { "type": "string", "enum": ["info", "warning", "error"] },
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "code"],
          "properties": {
            "op": { "const": "clearDiagnostic" },
            "code": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "transform"],
          "properties": {
            "op": { "const": "box.transform" },
            "transform": {
              "type": "string",
              "enum": [
                "aabbFromDiagonalCorners",
                "tripletRubber",
                "tripletCommit",
                "snapSquareFootprint",
                "setCubeHeightFromFootprint",
                "rubberCornerFromCenter",
                "rubberSquareFromCenter",
                "verticalFinalizeFootprint",
                "initPeakAboveOrigin",
                "peakFromOriginZ",
                "verticalRubberCorner",
                "cornerFromLengthWidth"
              ]
            }
          }
        }
      ]
    },
    "commitSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation"],
      "properties": {
        "when": { "type": "string" },
        "fromStates": { "type": "array", "items": { "type": "string" } },
        "outputDataPath": { "$ref": "#/$defs/pathTarget" },
        "operation": { "$ref": "#/$defs/commitOperation" }
      }
    },
    "commitOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "cornerA", "cornerB", "height"],
          "properties": {
            "kind": { "const": "cell.createBox" },
            "cornerA": { "$ref": "expression.json" },
            "cornerB": { "$ref": "expression.json" },
            "height": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "wireId", "distance", "direction"],
          "properties": {
            "kind": { "const": "wire.extrudeToCell" },
            "wireId": { "$ref": "expression.json" },
            "distance": { "$ref": "expression.json" },
            "direction": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "faceIds", "distance"],
          "properties": {
            "kind": { "const": "face.offset" },
            "faceIds": { "$ref": "expression.json" },
            "distance": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "a", "b"],
          "properties": {
            "kind": { "const": "measure.distance" },
            "a": { "$ref": "expression.json" },
            "b": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "faceId"],
          "properties": {
            "kind": { "const": "measure.area" },
            "faceId": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "cellId"],
          "properties": {
            "kind": { "const": "measure.volume" },
            "cellId": { "$ref": "expression.json" }
          }
        }
      ]
    },
    "displayItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "position"],
          "properties": {
            "kind": { "const": "point" },
            "id": { "type": "string" },
            "role": { "type": "string" },
            "position": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "text", "position"],
          "properties": {
            "kind": { "const": "label" },
            "id": { "type": "string" },
            "role": { "type": "string" },
            "text": { "type": "string" },
            "position": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "from", "to"],
          "properties": {
            "kind": { "const": "segment" },
            "id": { "type": "string" },
            "role": { "type": "string" },
            "from": { "$ref": "expression.json" },
            "to": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "axis", "origin"],
          "properties": {
            "kind": { "const": "linear-handle" },
            "id": { "type": "string" },
            "role": { "type": "string" },
            "axis": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "number" }
            },
            "origin": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "cornerA", "cornerB", "height"],
          "properties": {
            "kind": { "const": "box-preview" },
            "id": { "type": "string" },
            "role": { "type": "string" },
            "cornerA": { "$ref": "expression.json" },
            "cornerB": { "$ref": "expression.json" },
            "height": { "$ref": "expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "entity"],
          "properties": {
            "kind": { "const": "entity-highlight" },
            "id": { "type": "string" },
            "role": { "type": "string" },
            "entity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["vertex", "edge", "wire", "face", "shell", "cell", "cellComplex", "cluster", "surface", "part"]
                },
                "id": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "curve" },
            "id": { "type": "string" },
            "role": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "mesh" },
            "id": { "type": "string" },
            "role": { "type": "string" }
          }
        }
      ]
    }
  }
}
