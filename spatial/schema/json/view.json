{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/view",
  "title": "SpatialView",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "label", "derivedObjects"],
  "properties": {
    "schema": { "const": "spatial.view/v1" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "sourceTypologies": { "type": "array", "items": { "type": "string" } },
    "allows": { "type": "array", "items": { "type": "string" } },
    "derivedObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "properties": { "type": "array", "items": { "type": "string" } },
          "allows": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
