{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/topology",
  "title": "SpatialTopologyGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "vertices", "edges", "wires", "faces", "shells", "cells", "cellComplexes", "clusters"],
  "properties": {
    "schema": { "const": "spatial.topology/v1" },
    "revision": { "type": "integer", "minimum": 0 },
    "vertices": { "type": "object", "additionalProperties": { "$ref": "#/$defs/vertex" } },
    "edges": { "type": "object", "additionalProperties": { "$ref": "#/$defs/edge" } },
    "wires": { "type": "object", "additionalProperties": { "$ref": "#/$defs/wire" } },
    "faces": { "type": "object", "additionalProperties": { "$ref": "#/$defs/face" } },
    "shells": { "type": "object", "additionalProperties": { "$ref": "#/$defs/shell" } },
    "cells": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cell" } },
    "cellComplexes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cellComplex" } },
    "clusters": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cluster" } }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "vertex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vertexIds"],
      "properties": {
        "id": { "type": "string" },
        "vertexIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 2 }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "edgeIds"],
      "properties": {
        "id": { "type": "string" },
        "edgeIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wireIds"],
      "properties": {
        "id": { "type": "string" },
        "wireIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "faceIds"],
      "properties": {
        "id": { "type": "string" },
        "faceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "shellIds"],
      "properties": {
        "id": { "type": "string" },
        "shellIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cellComplex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cellIds"],
      "properties": {
        "id": { "type": "string" },
        "cellIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "memberIds"],
      "properties": {
        "id": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
