{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/topology",
  "title": "SpatialTopologyGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "vertices", "edges", "wires", "faces", "shells", "cells", "cellComplexes", "clusters"],
  "properties": {
    "schema": { "const": "spatial.topology/v1" },
    "revision": { "type": "integer", "minimum": 0 },
    "vertices": { "type": "object", "additionalProperties": { "$ref": "#/$defs/vertex" } },
    "edges": { "type": "object", "additionalProperties": { "$ref": "#/$defs/edge" } },
    "wires": { "type": "object", "additionalProperties": { "$ref": "#/$defs/wire" } },
    "faces": { "type": "object", "additionalProperties": { "$ref": "#/$defs/face" } },
    "shells": { "type": "object", "additionalProperties": { "$ref": "#/$defs/shell" } },
    "cells": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cell" } },
    "cellComplexes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cellComplex" } },
    "clusters": { "type": "object", "additionalProperties": { "$ref": "#/$defs/cluster" } }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "vertex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": { "type": "string" },
        "position": { "$ref": "#/$defs/vec3" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vertexA", "vertexB", "curve"],
      "properties": {
        "id": { "type": "string" },
        "vertexA": { "type": "string" },
        "vertexB": { "type": "string" },
        "curve": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["line", "polyline", "bezier"] },
            "controls": { "type": "array", "items": { "$ref": "#/$defs/vec3" } }
          }
        }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "edgeIds", "closed"],
      "properties": {
        "id": { "type": "string" },
        "edgeIds": { "type": "array", "items": { "type": "string" } },
        "closed": { "type": "boolean" }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outerWireId", "surface"],
      "properties": {
        "id": { "type": "string" },
        "outerWireId": { "type": "string" },
        "holeWireIds": { "type": "array", "items": { "type": "string" } },
        "surface": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["planar", "mesh"] },
            "normal": { "$ref": "#/$defs/vec3" },
            "origin": { "$ref": "#/$defs/vec3" },
            "vertices": { "type": "array", "items": { "$ref": "#/$defs/vec3" } },
            "triangles": { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 3, "maxItems": 3 } }
          }
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "faceIds"],
      "properties": {
        "id": { "type": "string" },
        "faceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "shellIds"],
      "properties": {
        "id": { "type": "string" },
        "shellIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cellComplex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cellIds", "sharedFaceIds"],
      "properties": {
        "id": { "type": "string" },
        "cellIds": { "type": "array", "items": { "type": "string" } },
        "sharedFaceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "memberIds"],
      "properties": {
        "id": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
