{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/extension",
  "title": "SpatialExtension",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "label", "kinds"],
  "properties": {
    "schema": { "const": "spatial.extension/v1" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["action", "attribute", "interaction", "property", "transformation", "typology"]
      },
      "minItems": 1
    }
  }
}
