{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/transformation",
  "title": "SpatialTransformation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "label", "source", "target", "typologies"],
  "properties": {
    "schema": { "const": "spatial.transformation/v1" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelDefinition"],
      "properties": {
        "modelDefinition": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelDefinition"],
      "properties": {
        "modelDefinition": { "type": "string" }
      }
    },
    "typologies": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "derive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collect", "hull", "classify"],
      "properties": {
        "collect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceModelDefinition", "primitiveKind"],
          "properties": {
            "sourceModelDefinition": { "type": "string" },
            "primitiveKind": {
              "type": "string",
              "enum": ["anchor", "vertex", "edge", "wire", "face", "shell", "solid"]
            }
          }
        },
        "fuse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hullSolidId": { "type": "string" },
            "contactPairs": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "maxSeparation": { "type": "number" }
          }
        },
        "hull": {
          "type": "object",
          "additionalProperties": false,
          "required": ["typology", "primitiveKind"],
          "properties": {
            "typology": { "type": "string" },
            "primitiveKind": { "type": "string" }
          }
        },
        "classify": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rules"],
          "properties": {
            "zTolRatio": { "type": "number" },
            "zTolMin": { "type": "number" },
            "opening": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fields", "values", "typology", "role"],
              "properties": {
                "fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "values": { "type": "array", "minItems": 1 },
                "typology": { "type": "string" },
                "role": { "type": "string" }
              }
            },
            "mergeRoles": { "type": "array", "items": { "type": "string" } },
            "mergeByPlane": { "type": "boolean" },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "typology"],
                "properties": {
                  "role": { "type": "string" },
                  "typology": { "type": "string" },
                  "dominantAxis": { "type": "string", "enum": ["x", "y", "z"] },
                  "minDominantNormal": { "type": "number" },
                  "minAxisNormal": { "type": "number" },
                  "zBand": { "type": "string", "enum": ["min", "max", "mid"] },
                  "fallback": { "type": "boolean" }
                }
              }
            }
          }
        },
        "ensure": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["typology"],
            "properties": {
              "typology": { "type": "string" },
              "empty": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
