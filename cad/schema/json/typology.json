{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/typology",
  "title": "SpatialTypology",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "label", "primitiveKinds", "actions", "interactions"],
  "properties": {
    "schema": { "const": "spatial.typology/v1" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "primitiveKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["anchor", "solid", "surface", "curve"]
      },
      "minItems": 0
    },
    "actions": { "type": "array", "items": { "type": "string" } },
    "interactions": { "type": "array", "items": { "type": "string" } },
    "properties": { "type": "array", "items": { "type": "string" } },
    "attributes": { "type": "array", "items": { "type": "string" } },
    "style": { "$ref": "#/$defs/style" }
  },
  "$defs": {
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "edgeColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "pattern": { "$ref": "#/$defs/pattern" }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["none", "hatch", "crosshatch", "dots"] },
        "direction": { "type": "number" },
        "spacing": { "type": "number", "exclusiveMinimum": 0 },
        "lineWidth": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    }
  }
}
