{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/attribute",
  "title": "SpatialAttributeDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "label", "field", "targets", "value"],
  "properties": {
    "schema": { "const": "spatial.attribute/v1" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "field": { "type": "string" },
    "targets": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "value": { "type": "object" },
    "geometrySelector": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
