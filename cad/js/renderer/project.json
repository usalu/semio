{
  "name": "@semio-tech/cad-js-renderer",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "cad/js/renderer",
        "command": "bun ./script.ts dev",
        "env": {
          "CAD_JS_RENDERER_PLAY_PORT": "6020",
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "cad/js/renderer",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "cad/js/renderer",
        "command": "bun ./script.ts test",
        "env": {
          "CAD_JS_RENDERER_PLAY_PORT": "6041"
        },
        "forwardAllArgs": true
      }
    },
    "dev-concrete-forest": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "cad/js/renderer",
        "command": "bun ./script.ts dev fixture concrete",
        "env": {
          "CAD_JS_RENDERER_PLAY_PORT": "6020",
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      }
    },
    "build-concrete-forest": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "cad/js/renderer",
        "command": "bun ./script.ts build fixture concrete",
        "forwardAllArgs": true
      }
    }
  }
}
