                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "origin_point-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "prevPoint"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
