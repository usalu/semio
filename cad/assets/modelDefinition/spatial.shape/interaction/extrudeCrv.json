{
  "schema": "spatial.interaction/v1",
  "id": "surface.extrudeCrv",
  "version": "1.0.0",
  "label": "ExtrudeCrv",
  "requires": {
    "kernel": {
      "operations": [
        "wire.extrudeToSolid",
        "entity.tessellate"
      ]
    }
  },
  "guards": [
    {
      "name": "selectionHasCurves",
      "expr": {
        "kind": "exists",
        "target": {
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "curves"
            },
            {
              "kind": "index",
              "index": 0
            },
            {
              "kind": "field",
              "name": "id"
            }
          ]
        }
      }
    },
    {
      "name": "hasExtrusionReady",
      "expr": {
        "kind": "all",
        "args": [
          {
            "kind": "exists",
            "target": {
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "curves"
                },
                {
                  "kind": "index",
                  "index": 0
                },
                {
                  "kind": "field",
                  "name": "id"
                }
              ]
            }
          },
          {
            "kind": "exists",
            "target": {
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "distance"
                }
              ]
            }
          },
          {
            "kind": "binop",
            "op": ">",
            "left": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "distance"
                }
              ]
            },
            "right": {
              "kind": "const",
              "value": 0
            }
          }
        ]
      }
    }
  ],
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": [
      "idle",
      "select_curves_to_extrude",
      "committed"
    ],
    "groundPointerMoveStates": [
      "pick_direction"
    ],
    "heightDragStates": [],
    "verticalRodStates": [
      "extrusion_distance"
    ],
    "heightConfirmState": null,
    "lengthEntry": [
      {
        "state": "extrusion_distance",
        "anchor": "origin",
        "field": "cursor",
        "control": "stepper",
        "min": 0,
        "step": 0.1,
        "unit": "m"
      }
    ]
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "select_curves_to_extrude",
                "key": "s",
                "label": "Start",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [
                        0,
                        0,
                        0
                      ]
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_curves_to_extrude",
        "selection": {
          "accept": [
            "wire",
            "edge"
          ],
          "multiple": true,
          "prompt": "Select curves to extrude"
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_curves_to_extrude",
                "key": "s",
                "label": "Select",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "curves"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "extrusion_distance",
                "guard": "selectionHasCurves",
                "key": "Enter",
                "label": "Set distance",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.selectionBboxCenter",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "origin"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "context",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "curves"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "prevPoint"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "origin"
                        }
                      ]
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "direction"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [
                        0,
                        0,
                        1
                      ]
                    }
                  },
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "origin"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "extrusion_distance",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "committed",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "distancePoint"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "op": "action",
                    "action": "command.assignExtrusionDistance"
                  }
                ]
              }
            ]
          },
          {
            "event": "set.distance",
            "transitions": [
              {
                "target": "committed",
                "key": "n",
                "label": "Apply Number",
                "effects": [
                  {
                    "op": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "distance"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "value"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "committed",
                "key": "Enter",
                "label": "Finish",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.assignExtrusionDistance"
                  }
                ]
              }
            ]
          },
          {
            "event": "start",
            "transitions": [
              {
                "target": "pick_direction",
                "key": "d",
                "label": "Direction"
              }
            ]
          }
        ]
      },
      {
        "name": "pick_direction",
        "on": [
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "extrusion_distance",
                "effects": [
                  {
                    "op": "action",
                    "action": "command.assignDirectionFromPoint",
                    "params": {
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "extrusion_distance",
                "key": "x",
                "label": "Cancel"
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "select_curves_to_extrude",
        "items": [
          {
            "kind": "label",
            "id": "select_curves_to_extrude-prompt",
            "role": "prompt",
            "text": "Select curves to extrude",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "select_curves_to_extrude-preview",
            "role": "preview",
            "previewKind": "highlight-curves",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "curves"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "state": "extrusion_distance",
        "items": [
          {
            "kind": "label",
            "id": "extrusion_distance-prompt",
            "role": "prompt",
            "text": "Extrusion distance (Z default, d = direction)",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "preview",
            "id": "extrusion_distance-preview",
            "role": "preview",
            "previewKind": "extrusion",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "curves"
                  }
                ]
              },
              "direction": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "direction"
                  }
                ]
              },
              "origin": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "origin"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "extrusion_distance-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "extrusion_distance-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "origin"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      },
      {
        "state": "pick_direction",
        "items": [
          {
            "kind": "label",
            "id": "pick_direction-prompt",
            "role": "prompt",
            "text": "Pick extrusion direction",
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "when": "hasExtrusionReady",
    "fromStates": [
      "committed"
    ],
    "operation": {
      "kind": "action",
      "action": "command.finish",
      "params": {
        "commandId": {
          "kind": "const",
          "value": "surface.extrudeCrv"
        },
        "resultKind": {
          "kind": "const",
          "value": "extrusion"
        }
      }
    }
  },
  "key": "0",
  "produces": {
    "typology": "spatial.shape.surface.extrude-crv"
  }
}
