{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@semio-tech/trinity-jack-host-core",
  "version": "0.1.0",
  "description": "trinity/jack · playground harness core",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./js/index.ts"
  },
  "scripts": {
    "test": "bun nx run @semio-tech/trinity-jack-host-core:test"
  },
  "dependencies": {
    "@semio-tech/framework-core": "workspace:*",
    "@semio-tech/framework-playground-core": "workspace:*",
    "@semio-tech/trinity-rewrite-core": "workspace:*",
    "@semio-tech/trinity-react": "workspace:*",
    "@semio-tech/ui-react": "workspace:*",
    "@semio-tech/framework-platform-core": "workspace:*",
    "@semio-tech/framework-os-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "@semio-tech/framework-playground-renderer-react": "workspace:*",
    "@semio-tech/ui-react": "workspace:*"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "trinity/jack/host-core"
  },
  "bundleKind": "library",
  "semio": {
    "app": {
      "kind": "trinity-jack",
      "aliases": [
        "trinity-jack",
        "trinity jack"
      ],
      "packageRoot": "trinity/jack/host-core",
      "corePackage": "@semio-tech/trinity-jack-host-core",
      "definitionExport": "trinityJackPlayAppDefinition",
      "hostKind": "trinity-jack",
      "port": {
        "dev": 6054,
        "test": 6055,
        "env": "TRINITY_JACK_PLAY_PORT"
      },
      "programExport": "trinityProgramContribution",
      "programId": "trinity",
      "rendererPackage": "@semio-tech/trinity-react",
      "rendererExport": "trinityJackAppRenderer"
    }
  }
}
