schema="trinity.graph" name="Branch Chain" manifest_id="nakagin"
camera {
  x=0 y=0 zoom=1
}
nodes= [ id="branch-root" kind="Piece" name="root" x=-120 y=0 width=88 height=40 properties= {
}
ports= [ id="out-a" kind="Connector" direction=out properties= {
}
] id="branch-mid" kind="Piece" name="mid" x=0 y=0 width=88 height=40 properties= {
}
ports= [ id="in-a" kind="Connector" direction=in properties= {
}
id="out-b" kind="Connector" direction=out properties= {
}
] id="branch-leaf" kind="Piece" name="leaf" x=120 y=0 width=88 height=40 properties= {
}
ports= [ id="in-b" kind="Connector" direction=in properties= {
}
] ] edges= [ id="e-root-mid" kind="Connection" source="branch-root:out-a" target="branch-mid:in-a" properties= {
}
id="e-mid-leaf" kind="Connection" source="branch-mid:out-b" target="branch-leaf:in-b" properties= {
}
] root_node_id="branch-root"
