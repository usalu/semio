schema=trinity.graph name="Branch Chain" manifest-id=nakagin root-node-id=branch-root
camera {
  x=0 y=0 zoom=1
}
nodes [id:TEXT kind:TEXT name:TEXT x:NUM y:NUM width:NUM height:NUM properties:MAP ports:LIST] {
  branch-root Piece root -120 0 88 40 {
  }
  [ id=out-a kind=Connector direction=out properties={
  }
  ]
  branch-mid Piece mid 0 0 88 40 {
  }
  [ id=in-a kind=Connector direction=in properties={
  }
  id=out-b kind=Connector direction=out properties={
  }
  ]
  branch-leaf Piece leaf 120 0 88 40 {
  }
  [ id=in-b kind=Connector direction=in properties={
  }
  ]
}
edges [id:TEXT kind:TEXT source:TEXT target:TEXT properties:MAP] {
  e-root-mid Connection "branch-root@out-a" "branch-mid@in-a" {
  }
  e-mid-leaf Connection "branch-mid@out-b" "branch-leaf@in-b" {
  }
}
