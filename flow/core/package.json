{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@semio-tech/flow-core",
  "version": "0.1.0",
  "description": "flow · core",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./js/index.ts",
    "./pkg/flow_core.js": "./rs/pkg/flow_core.js"
  },
  "dependencies": {
    "@semio-tech/vcs-core": "workspace:*",
    "@semio-tech/graph-manifest": "workspace:*",
    "@semio-tech/framework-os-core": "workspace:*",
    "@semio-tech/framework-platform-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "flow/core"
  },
  "bundleKind": "library",
  "semio": {
    "app": {
      "kind": "flow",
      "aliases": [
        "flow"
      ],
      "packageRoot": "flow",
      "corePackage": "@semio-tech/flow-core",
      "definitionExport": "flowPlayAppDefinition",
      "hostKind": "flow",
      "port": {
        "dev": 6016,
        "test": 6029,
        "env": "FLOW_PLAY_PORT"
      },
      "programExport": "flowProgramContribution",
      "programId": "flow",
      "optimizeDepsExclude": [
        "@semio-tech/flow-module-core",
        "@semio-tech/flow-core",
        "@semio-tech/flow-module-math",
        "@semio-tech/flow-module-text",
        "@semio-tech/flow-module-logic",
        "@semio-tech/flow-module-dictionary",
        "@semio-tech/flow-module-list",
        "@semio-tech/flow-module-brep",
        "@semio-tech/flow-module-draw"
      ],
      "rendererPackage": "@semio-tech/flow-react",
      "rendererExport": "flowAppRenderer"
    }
  }
}
