			"id": "face-floor",
			"kind": "face",
			"label": "Floor Face",
			"wires": ["wire-floor"],
			"surface": {
				"vertices": [[-1.5, 0, -1.5], [1.5, 0, -1.5], [1.5, 0, 1.5], [-1.5, 0, 1.5]],
