		},
		{
			"id": "vertex-beacon",
			"kind": "vertex",
			"label": "Vertex Beacon",
			"point": [0, 2.6, 0],
			"radius": 0.18,
			"style": { "color": "#38bdf8" }
		},
		{ "id": "v0", "kind": "vertex", "point": [-1.5, 0, -1.5], "style": { "color": "#94a3b8" } },
		{ "id": "v1", "kind": "vertex", "point": [1.5, 0, -1.5], "style": { "color": "#94a3b8" } },
		{ "id": "v2", "kind": "vertex", "point": [1.5, 0, 1.5], "style": { "color": "#94a3b8" } },
		{ "id": "v3", "kind": "vertex", "point": [-1.5, 0, 1.5], "style": { "color": "#94a3b8" } },
		{ "id": "v4", "kind": "vertex", "point": [-1.5, 2.2, -1.5], "style": { "color": "#94a3b8" } },
		{ "id": "v5", "kind": "vertex", "point": [1.5, 2.2, -1.5], "style": { "color": "#94a3b8" } },
		{ "id": "v6", "kind": "vertex", "point": [1.5, 2.2, 1.5], "style": { "color": "#94a3b8" } },
