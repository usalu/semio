			"manifold": false,
			"style": { "color": "#fb7185", "lineWidth": 2.5 }
		},
		{
			"id": "wire-floor",
			"kind": "wire",
			"label": "Floor Loop",
			"edges": ["e0", "e1", "e2", "e3"],
