		{ "id": "wire-right", "kind": "wire", "edges": ["e1", "e10", "e5", "e9"], "closed": true, "style": { "color": "#f97316" } },
		{ "id": "wire-back", "kind": "wire", "edges": ["e2", "e11", "e6", "e10"], "closed": true, "style": { "color": "#a78bfa" } },
		{ "id": "wire-left", "kind": "wire", "edges": ["e3", "e8", "e7", "e11"], "closed": true, "style": { "color": "#22c55e" } },
