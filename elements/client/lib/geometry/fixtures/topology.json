			},
			"style": { "color": "#22c55e", "opacity": 0.35 }
		},
		{
			"id": "face-roof",
			"kind": "face",
			"label": "Roof Face",
			"wires": ["wire-roof"],
			"surface": {
				"vertices": [[-1.5, 2.2, -1.5], [1.5, 2.2, -1.5], [1.5, 2.2, 1.5], [-1.5, 2.2, 1.5]],
				"triangles": [0, 1, 2, 0, 2, 3]
			},
			"style": { "color": "#60a5fa", "opacity": 0.28 }
		},
		{
			"id": "face-front",
			"kind": "face",
			"wires": ["wire-front"],
			"surface": {
				"vertices": [[-1.5, 0, -1.5], [1.5, 0, -1.5], [1.5, 2.2, -1.5], [-1.5, 2.2, -1.5]],
				"triangles": [0, 1, 2, 0, 2, 3]
