		{ "id": "e0", "kind": "edge", "vertices": ["v0", "v1"], "style": { "color": "#e2e8f0" } },
		{ "id": "e1", "kind": "edge", "vertices": ["v1", "v2"], "style": { "color": "#e2e8f0" } },
		{ "id": "e2", "kind": "edge", "vertices": ["v2", "v3"], "style": { "color": "#e2e8f0" } },
		{ "id": "e3", "kind": "edge", "vertices": ["v3", "v0"], "style": { "color": "#e2e8f0" } },
		{ "id": "e4", "kind": "edge", "vertices": ["v4", "v5"], "style": { "color": "#cbd5e1" } },
		{ "id": "e5", "kind": "edge", "vertices": ["v5", "v6"], "style": { "color": "#cbd5e1" } },
		{ "id": "e6", "kind": "edge", "vertices": ["v6", "v7"], "style": { "color": "#cbd5e1" } },
		{ "id": "e7", "kind": "edge", "vertices": ["v7", "v4"], "style": { "color": "#cbd5e1" } },
		{ "id": "e8", "kind": "edge", "vertices": ["v0", "v4"], "style": { "color": "#94a3b8" } },
		{ "id": "e9", "kind": "edge", "vertices": ["v1", "v5"], "style": { "color": "#94a3b8" } },
		{ "id": "e10", "kind": "edge", "vertices": ["v2", "v6"], "style": { "color": "#94a3b8" } },
		{ "id": "e11", "kind": "edge", "vertices": ["v3", "v7"], "style": { "color": "#94a3b8" } },
		{
			"id": "wire-open",
			"kind": "wire",
