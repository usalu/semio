			"wires": ["wire-right"],
			"surface": {
				"vertices": [[1.5, 0, -1.5], [1.5, 0, 1.5], [1.5, 2.2, 1.5], [1.5, 2.2, -1.5]],
				"triangles": [0, 1, 2, 0, 2, 3]
			},
			"style": { "color": "#fb923c", "opacity": 0.3 }
		},
		{
			"id": "face-back",
			"kind": "face",
			"wires": ["wire-back"],
			"surface": {
				"vertices": [[1.5, 0, 1.5], [-1.5, 0, 1.5], [-1.5, 2.2, 1.5], [1.5, 2.2, 1.5]],
				"triangles": [0, 1, 2, 0, 2, 3]
			},
			"style": { "color": "#a78bfa", "opacity": 0.3 }
		},
		{
			"id": "face-left",
			"kind": "face",
			"wires": ["wire-left"],
			"surface": {
				"vertices": [[-1.5, 0, 1.5], [-1.5, 0, -1.5], [-1.5, 2.2, -1.5], [-1.5, 2.2, 1.5]],
				"triangles": [0, 1, 2, 0, 2, 3]
			},
			"style": { "color": "#22c55e", "opacity": 0.3 }
		},
		{
			"id": "shell-room",
			"kind": "shell",
			"label": "Room Shell",
			"faces": ["face-floor", "face-roof", "face-front", "face-right", "face-back", "face-left"],
			"style": { "color": "#fde68a", "opacity": 0.18 }
