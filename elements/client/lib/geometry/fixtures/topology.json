			"label": "Shifted Cell",
			"shells": ["shell-room"],
			"transform": { "position": [3.6, 0, 0] },
			"style": { "color": "#7dd3fc", "opacity": 0.14 }
		},
		{
			"id": "cell-complex-campus",
			"kind": "cellComplex",
			"label": "Cell Complex",
			"cells": ["cell-room", "cell-room-shifted"],
			"style": { "color": "#e879f9", "opacity": 0.1 }
		},
		{
			"id": "cluster-inner",
			"kind": "cluster",
			"label": "Inner Cluster",
			"topologies": ["face-roof", "wire-open", "edge-arc"]
		},
		{
			"id": "cluster-campus",
			"kind": "cluster",
			"label": "Campus Cluster",
			"topologies": ["cluster-inner", "shell-room", "cell-room", "cell-complex-campus"],
			"style": { "color": "#c084fc", "opacity": 0.08 }
		}
