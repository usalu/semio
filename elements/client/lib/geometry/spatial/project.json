{
	"name": "@elements/geometry-spatial",
	"$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "elements/client/lib/geometry/spatial",
				"command": "bun ../script.ts spatial dev --port 6017",
				"env": {
					"CHOKIDAR_USEPOLLING": "1"
				},
				"forwardAllArgs": true
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "elements/client/lib/geometry/spatial",
				"command": "bun ../script.ts spatial build",
				"forwardAllArgs": true
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "elements/client/lib/geometry/spatial",
				"command": "bun ../script.ts spatial test",
				"forwardAllArgs": true
			}
		}
	}
}
