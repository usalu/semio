{
  "name": "@elements/board",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "elements/client/lib/board",
        "command": "bun ./script.ts dev",
        "env": {
          "BOARD_PLAY_PORT": "6012"
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "elements/client/lib/board",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "elements/client/lib/board",
        "command": "bun ./script.ts test",
        "env": {
          "BOARD_PLAY_PORT": "6027"
        },
        "forwardAllArgs": true
      }
    }
  }
}
