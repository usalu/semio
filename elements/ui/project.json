{
  "name": "@elements/ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "elements/ui",
        "command": "bun dev.script.ts",
        "env": {
          "STORYBOOK_PORT": "6006"
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "elements/ui",
        "command": "bunx storybook build",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "elements/ui",
        "command": "bunx eslint --max-warnings 0 --config eslint.config.ts .",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "elements/ui",
        "command": "bunx vitest run --config vitest.config.ts --passWithNoTests",
        "forwardAllArgs": true
      }
    }
  }
}
