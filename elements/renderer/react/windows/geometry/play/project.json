{
	"name": "@elements/geometry-play",
	"$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "elements/renderer/react/windows/geometry/play",
				"command": "bun ./script.ts dev --strictPort --port 6016",
				"env": {
					"CHOKIDAR_USEPOLLING": "1"
				},
				"forwardAllArgs": true
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "elements/renderer/react/windows/geometry/play",
				"command": "bun ./script.ts build",
				"forwardAllArgs": true
			}
		}
	}
}
