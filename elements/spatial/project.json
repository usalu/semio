{
	"name": "@elements/geometry-spatial",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": ".",
				"command": "bun nx run @elements/geometry-spatial-play:dev",
				"env": {
					"NODE_OPTIONS": "",
					"NX_NATIVE_COMMAND_RUNNER": "false",
					"NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
					"NX_TUI": "false",
					"VSCODE_INSPECTOR_OPTIONS": ""
				},
				"forwardAllArgs": true
			}
		},
		"build": {
			"dependsOn": [],
			"executor": "nx:run-commands",
			"options": {
				"cwd": ".",
				"command": "bun nx run @elements/geometry-spatial-play:build",
				"forwardAllArgs": true
			}
		},
		"test": {
			"dependsOn": [],
			"executor": "nx:run-commands",
			"options": {
				"cwd": "elements/spatial",
				"command": "bunx vitest run --config vitest.config.ts",
				"forwardAllArgs": true
			}
		}
	}
}
