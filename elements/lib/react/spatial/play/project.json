{
	"name": "@elements/spatial-play",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "elements/lib/react/spatial/play",
				"command": "bun ./script.ts dev --port 6017",
				"env": {
					"CHOKIDAR_USEPOLLING": "1"
				},
				"forwardAllArgs": true
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "elements/lib/react/spatial/play",
				"command": "bun ./script.ts build",
				"forwardAllArgs": true
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "elements/lib/react/spatial/play",
				"command": "bun ./script.ts test",
				"forwardAllArgs": true
			}
		}
	}
}