schema="note.document" id="semio" title="Semio Note"
camera {
  x=0 y=0 zoom=1
}
blocks {
  text id="welcome-text" name="Welcome" x=80 y=80 width=360 height=120 rotation=0 visible=true locked=false paragraphs= [ p runs= [ r "Welcome to Note — an infinite canvas for text, images, tables, math, and pencil ink." ] ] font_size=20 font_weight="normal" align="left"
  math id="welcome-math" name="Equation" x=80 y=240 width=240 height=80 rotation=0 visible=true locked=false tex="E = mc^2" display_mode=true
  table id="welcome-table" name="Blocks" x=80 y=360 width=360 height=140 rotation=0 visible=true locked=false columns= [ "Block" "Description" ] rows= [ [ "Text" "Rich text blocks" ] [ "Math" "TeX equations" ] [ "Ink" "Freehand pencil strokes" ] ]
}
grid_visible=true snap_enabled=false pencil_width=3 eraser_radius=12 assets= {
}
