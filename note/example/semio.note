note id="semio" schema="note.document" title="Semio Note"
camera x=0 y=0 zoom=1
grid visible=true
snap enabled=false
pencil width=3
eraser radius=12
blocks {
  text id="welcome-text" name="Welcome" x=80 y=80 width=360 height=120 rotation=0 visible=true locked=false size=20 weight="normal" align="left" {
    p {
      r "Welcome to Note — an infinite canvas for text, images, tables, math, and pencil ink."
    }
  }
  math id="welcome-math" name="Equation" x=80 y=240 width=240 height=80 rotation=0 visible=true locked=false display=true tex="E = mc^2"
  table id="welcome-table" name="Blocks" x=80 y=360 width=360 height=140 rotation=0 visible=true locked=false {
    columns "Block" "Description"
    row "Text" "Rich text blocks"
    row "Math" "TeX equations"
    row "Ink" "Freehand pencil strokes"
  }
}
