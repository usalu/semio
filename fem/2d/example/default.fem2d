elements {
  beam id=e3 start=n1 end=n2 material-id=steel section-id=chs76
  beam id=e4 start=n2 end=p0_l1 material-id=timber section-id=post140
  beam id=e5 start=p0_l1 end=p0_l2 material-id=timber section-id=post140
  beam id=e6 start=p8 end=p8_l1 material-id=timber section-id=post140
  beam id=e7 start=p8_l1 end=p8_l2 material-id=timber section-id=post140
  beam id=e8 start=p0_l1 end=p8_l1 material-id=timber section-id=floorbeam
  beam id=e9 start=p0_l2 end=p8_l2 material-id=timber section-id=floorbeam
  beam id=e10 start=p0_l2 end=ridge material-id=timber section-id=rafter
  beam id=e11 start=ridge end=p8_l2 material-id=timber section-id=rafter
}
analysis {
  modal-count=3 buckling-count=3 deformation-scale=300
}
camera {
  x=4 y=2 zoom=0.12
}
nodes [id:TEXT x:NUM y:NUM] {
  n1 0 -4
  n2 0 0
  p8 8 0
  p0_l1 0 2.8
  p8_l1 8 2.8
  p0_l2 0 5.6
  p8_l2 8 5.6
  ridge 4 7.6
  rc0 10 2.75
  rc1 12 2.75
  rc2 12 2.85
  rc3 10 2.85
}
regions [id:TEXT name:TEXT outline:LIST holes:LIST thickness:NUM material-id:TEXT mesh-size:NUM] {
  r1 "First Floor Slab" [ 10,2.75 12,2.75 12,2.85 10,2.85 ] [ ] 0.2 concrete 1
}
materials [id:TEXT name:TEXT e:NUM nu:NUM rho:NUM] {
  steel "Steel S235" 210000000000 0.3 7850
  timber "C24 Timber" 11000000000 0.3 450
  concrete "C30/37 Concrete" 33000000000 0.2 2400
}
sections [id:TEXT name:TEXT area:NUM iy:NUM] {
  chs76 "CHS 76 Foundation Column" 0.001 0.000001
  post140 "Timber Post 140x140" 0.0196 0.000032
  floorbeam "Timber Floor Beam 80x220" 0.0176 0.000071
  rafter "Timber Rafter 80x180" 0.0144 0.000039
}
supports [id:TEXT node-id:TEXT fixed:LIST] {
  s1 n1 [ Tx Ty ]
  s2 p8 [ Ty ]
  s3 rc0 [ Tx Ty ]
  s4 rc1 [ Tx Ty ]
}
load-cases [id:TEXT name:TEXT loads:BLOCK self-weight:BOOL] {
  dead "Dead Load" {
    area id=l5 region-id=r1 pressure=800
  }
  true
  live "Live Load" {
    nodal id=l6 node-id=p8_l1 dof=Ty value=-12000
    area id=l7 region-id=r1 pressure=1500
  }
  false
}
combinations [id:TEXT name:TEXT terms:LIST] {
  uls ULS [ case-id=dead factor=1.35 case-id=live factor=1.5 ]
}
