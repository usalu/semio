{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OutcomeLawGateVectors",
  "description": "Language-agnostic planted-violation vectors for rule 2 of `verify mutation-outcome-law`: each case is one planted source file (path segments plus lines) and the exact breaches the gate must report for it — position, fault class, code and level as spelled. A case without breaches is a canonical control that must stay silent. The frozen outcome vocabulary document is the oracle for every expected level.",
  "type": "object",
  "required": ["contract", "vocabulary", "cases"],
  "additionalProperties": false,
  "definitions": {
    "repositoryPath": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\:]+(?:/[^/\\\\:]+)*$" },
    "segment": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\:]+$" },
    "level": { "type": "string", "enum": ["info", "warning", "error", "fatal"] },
    "line": { "type": "integer", "minimum": 1 },
    "breach": {
      "oneOf": [
        {
          "type": "object",
          "required": ["line", "fault", "code"],
          "additionalProperties": false,
          "properties": { "line": { "$ref": "#/definitions/line" }, "fault": { "const": "outside-vocabulary" }, "code": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["line", "fault", "code", "level", "expected"],
          "additionalProperties": false,
          "properties": {
            "line": { "$ref": "#/definitions/line" },
            "fault": { "const": "level-mismatch" },
            "code": { "type": "string", "minLength": 1 },
            "level": { "type": "string", "pattern": "^[a-z]+$" },
            "expected": { "$ref": "#/definitions/level" }
          }
        },
        {
          "type": "object",
          "required": ["line", "fault", "code"],
          "additionalProperties": false,
          "properties": { "line": { "$ref": "#/definitions/line" }, "fault": { "const": "not-apply-code" }, "code": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["line", "fault"],
          "additionalProperties": false,
          "properties": { "line": { "$ref": "#/definitions/line" }, "fault": { "const": "level-alias" } }
        },
        {
          "type": "object",
          "required": ["line", "fault", "builder"],
          "additionalProperties": false,
          "properties": { "line": { "$ref": "#/definitions/line" }, "fault": { "const": "retired-builder" }, "builder": { "const": "warn" } }
        }
      ]
    },
    "case": {
      "type": "object",
      "required": ["id", "description", "segments", "lines", "breaches"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 1 },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/segment" } },
        "lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "breaches": { "type": "array", "items": { "$ref": "#/definitions/breach" } }
      }
    }
  },
  "properties": {
    "contract": { "type": "string", "const": "outcome-law-gate-v1" },
    "vocabulary": { "$ref": "#/definitions/repositoryPath" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/case" } }
  }
}
