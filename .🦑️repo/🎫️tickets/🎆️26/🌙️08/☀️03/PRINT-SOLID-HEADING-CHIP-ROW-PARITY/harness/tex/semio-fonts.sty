\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-fonts}[2026/08/03 v0.1.0 ticket harness font stack]

\RequirePackage{fontspec}
\RequirePackage{semio-tokens}

\def\semio@font@root{font/}

\newfontfamily\SemioSans[Path=\semio@font@root anta/]{Anta-Regular.ttf}
\let\SemioSerif\SemioSans
\newfontfamily\SemioMono[Path=\semio@font@root share-tech-mono/]{ShareTechMono-Regular.ttf}
\newfontfamily\SemioEmoji[Path=\semio@font@root noto-emoji/]{NotoEmoji-Regular.ttf}

\newcommand{\semio@set@main@fonts}{%
  \setmainfont{Anta-Regular.ttf}[Path=\semio@font@root anta/]%
  \setsansfont{Anta-Regular.ttf}[Path=\semio@font@root anta/]%
  \setmonofont{ShareTechMono-Regular.ttf}[Path=\semio@font@root share-tech-mono/]%
}
