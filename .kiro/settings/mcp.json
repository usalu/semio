{
  "mcpServers": {
    "playwright-test": {
      "command": "npx",
      "args": [
        "playwright",
        "run-test-mcp-server"
      ]
    },
    "repo": {
      "type": "stdio",
      "command": "go",
      "args": [
        "run",
        "./repo/cli",
        "mcp"
      ]
    },
    "semio": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "/workspaces/semio/semio/engine",
        "run",
        "main.py",
        "--mcp-stdio"
      ]
    },
    "coda": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "/workspaces/semio/coda/engine",
        "run",
        "coda.py",
        "--mcp-stdio"
      ]
    }
  }
}
