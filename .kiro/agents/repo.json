{
  "allowedTools": [
    "@repo",
    "@semio",
    "@coda"
  ],
  "description": "Interacts with the semio monorepo via repo CLI hooks and MCP tools",
  "hooks": {
    "agentSpawn": [
      {
        "command": "go run ./repo/kiro hook agentSpawn"
      }
    ],
    "postToolUse": [
      {
        "command": "go run ./repo/kiro hook postToolUse"
      }
    ],
    "preToolUse": [
      {
        "command": "go run ./repo/kiro hook preToolUse"
      }
    ],
    "stop": [
      {
        "command": "go run ./repo/kiro hook stop"
      }
    ],
    "userPromptSubmit": [
      {
        "command": "go run ./repo/kiro hook userPromptSubmit"
      }
    ]
  },
  "includeMcpJson": true,
  "name": "repo",
  "prompt": "file://../../AGENTS.md",
  "tools": [
    "*"
  ]
}
