{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "bunx",
      "runtimeArgs": ["storybook", "dev", "-c", ".storybook", "-p", "6006", "--host", "127.0.0.1", "--no-open"],
      "port": 6006
    },
    {
      "name": "puzzle-5d-react",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:puzzle:5d"],
      "port": 6014
    },
    {
      "name": "lowpoly-react-dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:lowpoly"],
      "env": {
        "LOWPOLY_PLAY_PORT": "6078",
        "SEMIO_RENDERER": "react"
      },
      "port": 6078
    },
    {
      "name": "shooting-react-dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:shooting:base-icon"],
      "env": {
        "SHOOTING_PLAY_PORT": "6119",
        "S_OS_PORT": "6119",
        "SEMIO_RENDERER": "react"
      },
      "port": 6119
    }
  ]
}
