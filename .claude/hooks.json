{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          "./semio-repo/cli/cli hook notification claude-code"
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          "./semio-repo/cli/cli hook tool.ended claude-code --tool-name \"$TOOL_NAME\""
        ],
        "matcher": ".*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          "./semio-repo/cli/cli hook compacting claude-code"
        ]
      }
    ],
    "PreToolUse": [
      {
        "blocking": true,
        "hooks": [
          "./semio-repo/cli/cli hook tool.calling claude-code --tool-name \"$TOOL_NAME\" --tool-args \"$TOOL_INPUT\""
        ],
        "matcher": ".*"
      }
    ],
    "PromptSubmit": [
      {
        "hooks": [
          "./semio-repo/cli/cli hook prompt.submit claude-code"
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          "./semio-repo/cli/cli hook agent.starting claude-code"
        ]
      }
    ],
    "SessionStop": [
      {
        "hooks": [
          "./semio-repo/cli/cli hook agent.ended claude-code"
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          "./semio-repo/cli/cli hook agent.starting claude-code --parent \"subagent\""
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          "./semio-repo/cli/cli hook agent.ended claude-code --parent \"subagent\""
        ]
      }
    ]
  }
}