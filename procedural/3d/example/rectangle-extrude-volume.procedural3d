schema="flow.fixture"
camera {
  x=140 y=-60 zoom=2.2
}
layout={
  distance=x=120 y=20 extrude=x=280 y=-40 height=x=40 y=-20 rect=x=120 y=-40 vector=x=200 y=20 volume=x=360 y=-40 width=x=40 y=-60
}
synapses [id:TEXT wire:WIRE] {
  e1 width@number->rect@width
  e2 height@number->rect@height
  e3 rect@wire->extrude@wire
  e4 distance@number->vector@z
  e5 vector@vector->extrude@vector
  e6 extrude@solid->volume@geometry
}
generations [id:TEXT name:TEXT values:VAL] {
}
widgets {
  input-slider id="width" value=2 min=0.1 max=10 step=0.1
  input-slider id="height" value=2 min=0.1 max=10 step=0.1
  input-slider id="distance" value=3 min=0.1 max=10 step=0.1
  neuron id="rect" neuron-kind=brep.curve.rectangle preview=false input-ports=[ "width" "height" ] output-ports=[ ] params=[ ]
  neuron id="vector" neuron-kind=math.vector preview=false input-ports=[ "x" "y" "z" ] output-ports=[ ] params=[ ]
  neuron id="extrude" neuron-kind=brep.solid.extrude preview=true input-ports=[ "wire" "vector" ] output-ports=[ ] params=[ ]
  neuron id="volume" neuron-kind=brep.measure.volume preview=false input-ports=[ "geometry" ] output-ports=[ ] params=[ ]
}
