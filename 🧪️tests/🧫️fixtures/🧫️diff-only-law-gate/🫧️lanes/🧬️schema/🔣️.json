{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^ephemeral-[a-z-]+$" },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[1-9][0-9]*\\|R1[34]$" }
          }
        }
      }
    }
  }
}
