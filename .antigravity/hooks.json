{
  "hooks": {
    "agent.ended": "./semio-repo/cli/cli hook agent.ended antigravity-chat",
    "agent.starting": "./semio-repo/cli/cli hook agent.starting antigravity-chat",
    "code.edited": "./semio-repo/cli/cli hook code.edited antigravity-chat --file \"$FILE\"",
    "code.reading": "./semio-repo/cli/cli hook code.reading antigravity-chat --file \"$FILE\"",
    "compacting": "./semio-repo/cli/cli hook compacting antigravity-chat",
    "notification": "./semio-repo/cli/cli hook notification antigravity-chat",
    "prompt.submit": "./semio-repo/cli/cli hook prompt.submit antigravity-chat",
    "tool.calling": "./semio-repo/cli/cli hook tool.calling antigravity-chat --tool-name \"$TOOL\" --tool-args \"$ARGS\"",
    "tool.ended": "./semio-repo/cli/cli hook tool.ended antigravity-chat --tool-name \"$TOOL\""
  }
}