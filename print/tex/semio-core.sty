\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-core}[2026/07/06 v0.1.0 semio core mechanisms]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-tokens}
\RequirePackage{semio-fonts}

\providecolor{semio-chrome-light-panel}{HTML}{c9c8bd}
\providecolor{semio-chrome-dark-panel}{HTML}{1d2b2f}

\ExplSyntaxOn

\tl_new:N \l_semio_type_tl
\tl_new:N \l_semio_theme_tl
\tl_new:N \l_semio_language_tl
\tl_new:N \l_semio_title_tl
\tl_new:N \l_semio_subtitle_tl
\tl_new:N \l_semio_author_tl
\tl_new:N \l_semio_date_tl
\tl_new:N \l_semio_identifier_tl
\tl_new:N \l_semio_aktenzeichen_tl
\tl_new:N \l_semio_foerderzeitraum_tl
\tl_new:N \l_semio_doi_tl
\bool_new:N \l_semio_kompakt_draft_bool

\tl_set:Nn \l_semio_type_tl { report }
\tl_set:Nn \l_semio_theme_tl { light }
\tl_set:Nn \l_semio_language_tl { de }

\keys_define:nn { semio / setup } {
  type .tl_set:N = \l_semio_type_tl,
  theme .tl_set:N = \l_semio_theme_tl,
  language .tl_set:N = \l_semio_language_tl,
  title .tl_set:N = \l_semio_title_tl,
  subtitle .tl_set:N = \l_semio_subtitle_tl,
  author .tl_set:N = \l_semio_author_tl,
  date .tl_set:N = \l_semio_date_tl,
  identifier .tl_set:N = \l_semio_identifier_tl,
  aktenzeichen .tl_set:N = \l_semio_aktenzeichen_tl,
  foerderzeitraum .tl_set:N = \l_semio_foerderzeitraum_tl,
  doi .tl_set:N = \l_semio_doi_tl,
  kompakt-draft .bool_set:N = \l_semio_kompakt_draft_bool,
}

\cs_new_protected:Npn \semio_chrome_apply_aliases: {
  \str_case:VnF \l_semio_theme_tl {
    { dark } {
      \colorlet{semio-chrome-base}{semio-chrome-dark-base}
      \colorlet{semio-chrome-window}{semio-chrome-dark-window}
      \colorlet{semio-chrome-canvas}{semio-chrome-dark-canvas}
      \colorlet{semio-chrome-panel}{semio-chrome-dark-panel}
      \colorlet{semio-chrome-border-normal}{semio-chrome-dark-border-normal}
      \colorlet{semio-chrome-border-emphasized}{semio-chrome-dark-border-emphasized}
      \colorlet{semio-chrome-active-base}{semio-chrome-dark-active-base}
      \colorlet{semio-chrome-active-foreground}{semio-chrome-dark-active-foreground}
      \colorlet{semio-chrome-foreground}{semio-chrome-dark-foreground}
      \colorlet{semio-chrome-text-normal}{semio-chrome-dark-border-normal}
    }
  } {
    \colorlet{semio-chrome-base}{semio-chrome-light-base}
    \colorlet{semio-chrome-window}{semio-chrome-light-window}
    \colorlet{semio-chrome-canvas}{semio-chrome-light-canvas}
    \colorlet{semio-chrome-panel}{semio-chrome-light-panel}
    \colorlet{semio-chrome-border-normal}{semio-chrome-light-border-normal}
    \colorlet{semio-chrome-border-emphasized}{semio-chrome-light-border-emphasized}
    \colorlet{semio-chrome-active-base}{semio-chrome-light-active-base}
    \colorlet{semio-chrome-active-foreground}{semio-chrome-light-active-foreground}
    \colorlet{semio-chrome-foreground}{semio-chrome-light-foreground}
    \colorlet{semio-chrome-text-normal}{semio-chrome-light-border-normal}
  }
}

\cs_new_protected:Npn \semio_theme_apply: {
  \semio_chrome_apply_aliases:
  \str_if_eq:VnTF \l_semio_theme_tl { dark } {
    \pagecolor{semio-dark}
  } {
    \pagecolor{semio-light}
  }
  \color{semio-chrome-text-normal}
}

\NewDocumentCommand{\SemioSetup}{m}{\keys_set:nn { semio / setup } {#1}}

\NewDocumentCommand{\aktenzeichen}{m}{\tl_set:Nn \l_semio_aktenzeichen_tl {#1}}
\NewDocumentCommand{\foerderzeitraum}{m}{\tl_set:Nn \l_semio_foerderzeitraum_tl {#1}}
\NewDocumentCommand{\doi}{m}{\tl_set:Nn \l_semio_doi_tl {#1}}
\RenewDocumentCommand{\subtitle}{m}{\tl_set:Nn \l_semio_subtitle_tl {#1}}

\cs_new_protected:Npn \semio_begindocument_hook: {
  \semio_theme_apply:
  \semio@set@main@fonts
}

\AddToHook{begindocument/before}{\semio_begindocument_hook:}

\ExplSyntaxOff

\newcommand{\SemioSpacingUnit}{\semio@spacing@single}
\newcommand{\SemioSpacingDouble}{\semio@spacing@double}
