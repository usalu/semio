\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-fonts}[2026/07/06 v0.1.0 semio font stacks]

\RequirePackage{fontspec}
\RequirePackage{semio-tokens}

\ExplSyntaxOn
\cs_new_protected:Npn \semio_fonts_resolve_root: {
  \file_if_exist:nTF { ../../asset/font/anta/Anta-Regular.ttf }
    { \def\semio@font@root { ../../asset/font/ } }
    {
      \file_if_exist:nTF { ../asset/font/anta/Anta-Regular.ttf }
        { \def\semio@font@root { ../asset/font/ } }
        {
          \file_if_exist:nTF { ../../../print/asset/font/anta/Anta-Regular.ttf }
            { \def\semio@font@root { ../../../print/asset/font/ } }
            { \def\semio@font@root { ../../../../print/asset/font/ } }
        }
    }
}
\semio_fonts_resolve_root:
\ExplSyntaxOff

\newfontfamily\SemioSans[
  Path=\semio@font@root anta/,
]{Anta-Regular.ttf}
\let\SemioSerif\SemioSans
\newfontfamily\SemioMono[
  Path=\semio@font@root share-tech-mono/,
]{ShareTechMono-Regular.ttf}
\newfontfamily\SemioEmoji[
  Path=\semio@font@root noto-emoji/,
]{NotoEmoji-Regular.ttf}

\newcommand{\semio@set@main@fonts}{%
  \setmainfont{Anta-Regular.ttf}[Path=\semio@font@root anta/]%
  \setsansfont{Anta-Regular.ttf}[Path=\semio@font@root anta/]%
  \setmonofont{ShareTechMono-Regular.ttf}[Path=\semio@font@root share-tech-mono/]%
}
