\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-tree}[2026/08/13 v0.3.0 semio phylogenetic trees]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-core}
\RequirePackage{semio-fonts}
\RequirePackage{semio-window}
% tikz itself arrives with semio-window.sty. `calc` does NOT -- no .sty in this
% system loads a tikz library (only the two document preambles do), so a
% package that wants one must say so here.
\usetikzlibrary{calc}

% 🌳 A rectangular cladogram: one vertical rail per parent, dropping from that
% parent's own bottom-left corner, with a horizontal branch into each child,
% ending after the last child. A table row cannot draw its own connector (a
% \rule spanning a row must know the row's height, which is only known after
% the cell has already been broken into lines), so this is TikZ: the rail is
% drawn from measured ANCHORS, and connectedness is structural rather than
% tuned. The cost is the cost GraphFigure already pays: a tikzpicture is one
% unbreakable box, so a tree that outgrows a page is split into plates by the
% caller -- exactly what the reference rendering of this appendix did
% ("Detailbaum ECO (Teil 1/2)").
%
% 📐 The grid is a single INDENT STEP, not one x per named level: a node's
% column is `depth * step`, so adding a level between two existing ones (or
% deeper than the deepest) is registering a kind at that integer depth via
% \SemioTreeKind -- no new x constant to invent, and every level scales
% together if the step ever changes. `width`/step values are millimetres
% because `semio tree picture` sets x=1mm; the column widths carry units
% because they are handed to a tabular, a different consumer.
\providecommand{\semio@tree@width}{147}
\providecommand{\semio@tree@indent@step}{7.3mm}
\providecommand{\semio@tree@w@code}{21.5mm}
\providecommand{\semio@tree@w@label}{72.5mm}
\providecommand{\semio@tree@w@marks}{33mm}
\providecommand{\semio@tree@w@gutter}{1.5mm}
% 📏 Vertical rhythm: only the GAPS between nodes -- the nodes size
% themselves, so no line-height estimate exists anywhere in this package.
\providecommand{\semio@tree@gap@box}{3.4mm}
\providecommand{\semio@tree@gap@row}{2.4mm}
% ↳ Where a branch meets a "row" kind (a leaf: text, not a box): the branch
% must land ON the first text line, not on the row's vertical middle --
% otherwise a three-line taxon reads as joined at its second line. Expressed
% as a FRACTION of that row's own leading (registered per kind, see
% KindRegistry) rather than a fixed length, so it stays correct if a kind's
% font size changes and self-scales for any new row-kind level a caller adds.
% As a numerator/denominator pair, not a decimal: \dimexpr's `*`/`/` operators
% only accept integers, so a decimal factor (`*0.5`) is not valid syntax --
% this is the same <coefficient><dimen> family of pitfall documented at the
% Primitives region's \semio_tree_elbow:n, worked around the same way
% dimensions are multiplied by a fraction everywhere else in this file.
% Calibrated against real output: factor 1/2 landed the branch 1.2pt above
% the first line's glyph top (measured via PyMuPDF word/line extraction) --
% visibly grazing above the text rather than pointing at it. Solving for the
% factor that lands on that line's CAP-HEIGHT CENTER instead (matching how a
% box kind's branch already centers on its box, via anchor=west) gives
% 9/8=1.125, not a small fraction -- the tabular's own internal row padding,
% not just the font's ascent, is part of what the branch has to clear.
\providecommand{\semio@tree@elbow@num}{9}
\providecommand{\semio@tree@elbow@den}{8}
\providecommand{\semio@tree@marks@sep}{;}

% 🔤 Row bodies are plain \newcommands, deliberately defined OUTSIDE
% \ExplSyntaxOn: they are ordinary LaTeX (a tabular preamble, font switches,
% \hspace) where a literal space is meaningful, and writing them under expl3
% catcodes would mean spelling every space `~` inside a tabular spec. Both
% are parametrized by FONT SWITCHES the caller's kind registration supplies
% (not hardcoded per named level), so a custom \SemioTreeKind gets the same
% two-part (code, label) formatting as root/group/leaf for free.
\newcommand{\semio@tree@box}[5]{% code-font, code, label-font, label, count
  {#1 #2}\hspace{0.55em}{#3 #4}\semio@tree@boxcount{#3}{#5}%
}
% An empty count is the normal case (most box kinds have none, or not yet),
% so it is tested rather than required -- \ifx\relax#1\relax is the
% plain-TeX empty test, valid here because this macro lives outside expl3: an
% EMPTY braced argument contributes no tokens at the call site, so
% "\ifx\relax#1\relax" degrades to "\ifx\relax\relax" exactly when #1 was {}.
\newcommand{\semio@tree@boxcount}[2]{%
  \ifx\relax#2\relax\else\ \textperiodcentered\ {#1 #2}\fi
}
% A row is three aligned columns, not three nodes: one tabular makes the
% row's height the maximum of code/label/marks automatically, and keeps the
% columns flush across every row without a shared coordinate system. The
% code-font switch wraps the WHOLE tabular, not just its own cell: a tabular
% opened under the document's ambient (body-text-sized) font computes its
% row padding from THAT font, not the small one used inside it, inflating
% the gap between a node's top edge and where its first line actually sits
% -- this is what the elbow alignment fix in the Primitives region depends on.
\newcommand{\semio@tree@row}[5]{% code-font, code, label-font, label, marks
  {#1
   \begin{tabular}[t]{@{}p{\semio@tree@w@code}@{\hspace{\semio@tree@w@gutter}}p{\semio@tree@w@label}@{\hspace{\semio@tree@w@gutter}}>{\raggedleft\arraybackslash}p{\semio@tree@w@marks}@{}}
     {\color{semio-chrome-text-normal}#2}
     & {#3\color{semio-chrome-foreground}#4}
     & {#5}
   \end{tabular}}%
}

\ExplSyntaxOn

%region Diagnostics
\msg_new:nnn { semio-tree } { unknown-kind }
  { Unknown~semio~tree~node~kind~'#1'.~Known~kinds:~
    \seq_use:Nn \g_semio_tree_kinds_seq { ,~ } . }
\msg_new:nnn { semio-tree } { kind-exists }
  { Semio~tree~node~kind~'#1'~is~already~defined. }
\msg_new:nnn { semio-tree } { outside-figure }
  { \iow_char:N\\#1~needs~an~enclosing~TreeFigure~(it~draws~into~its~tikzpicture). }
%endregion Diagnostics

%region StyleVocabulary
% 🎨 The tree vocabulary, namespaced `semio tree *`. It used to live in the
% document preamble, which is why every document that wanted a tree
% redeclared it. Depth reads through stroke weight and fill tone, never
% through hue, so the dark build needs no second vocabulary.
\tikzset{
  semio~tree~picture/.style={
    x=1mm, y=1mm,
    every~node/.append~style={ outer~sep=0pt },
  },
  semio~tree~branch/.style={
    draw=semio-chrome-border-normal,
    line~width=\semio@stroke@hairline,
  },
}
%endregion StyleVocabulary

%region KindRegistry
% 🧬 A node KIND carries everything that differs between hierarchy levels:
% how it is drawn (a tikz style), how deep it sits (an integer -- its column
% is `depth * \semio@tree@indent@step`, and it is what an incoming branch
% looks up its parent by), how a branch lands on it (`box` = at its
% middle-left, for a bordered box; `row` = on its first text line, for a bare
% text row), and the two font switches its content formatter uses for the
% code/label parts. Mirrors \semio_graph_state_define:nnn -- kinds never
% overwrite each other, and a deeper hierarchy adds a kind with \SemioTreeKind
% rather than editing the defaults below. Two SEPARATE depth=2, say, kinds
% are fine (a tree can have more than one flavour of node at one level); what
% matters for placement/connection is only the integer itself.
\seq_new:N \g_semio_tree_kinds_seq
\int_new:N \g_semio_tree_maxdepth_int

% Leading (#7) is stored here too, not via a separate call: a "row" kind's
% branch-elbow height (Primitives region) needs it, and a caller extending
% the hierarchy should not have to leave the public API to register a new
% level -- \SemioTreeKind alone is enough, no \ExplSyntaxOn required at the
% call site.
\cs_new_protected:Npn \semio_tree_kind_define:nnnnnnn #1#2#3#4#5#6#7 {
  \seq_if_in:NnTF \g_semio_tree_kinds_seq {#1}
    { \msg_error:nnn { semio-tree } { kind-exists } {#1} }
    {
      \seq_gput_right:Nn \g_semio_tree_kinds_seq {#1}
      \tl_const:cn { c_semio_tree_kind_#1_depth_tl }     {#3}
      \tl_const:cn { c_semio_tree_kind_#1_inlet_tl }     {#4}
      \tl_const:cn { c_semio_tree_kind_#1_codefont_tl }  {#5}
      \tl_const:cn { c_semio_tree_kind_#1_labelfont_tl } {#6}
      \tl_const:cn { c_semio_tree_kind_#1_leading_tl }   {#7}
      \tikzset{ semio~tree~node~#1/.style={#2} }
      % The open-ancestor slot for this depth (see Primitives) is created
      % once per depth, not per kind -- two kinds sharing a depth share a
      % slot, which is correct: only one node can be "currently open" at a
      % given depth at a time regardless of which kind it was.
      \tl_if_exist:cF { g_semio_tree_open_#3_tl } { \tl_new:c { g_semio_tree_open_#3_tl } }
      \int_compare:nNnT {#3} > \g_semio_tree_maxdepth_int
        { \int_gset:Nn \g_semio_tree_maxdepth_int {#3} }
    }
}
\cs_new_protected:Npn \semio_tree_kind_require:n #1 {
  \seq_if_in:NnF \g_semio_tree_kinds_seq {#1}
    { \msg_error:nnn { semio-tree } { unknown-kind } {#1} }
}
\NewDocumentCommand \SemioTreeKind { m m m m m m m }
  { \semio_tree_kind_define:nnnnnnn {#1}{#2}{#3}{#4}{#5}{#6}{#7} }

% 🌱 Defaults: clade box (depth 0), family box (depth 1), taxon row (depth 2).
% A caller building a deeper hierarchy registers a new kind at depth 2, 3, …
% rather than editing these -- e.g. a "familie"/"unterfamilie"/"taxon" tree
% inserts one at depth 2 and moves taxon-like rows to depth 3 under a NEW
% name (leaf, at depth 2, is simply left unused by that tree; nothing forces
% every registered kind to appear in every tree). Leading is the SAME number
% already in each kind's own code-font \fontsize{}{leading} switch --
% duplicated here (not derived) because there is no clean way to pull it back
% out of that token stream once assembled; see \semio_tree_elbow:n.
\semio_tree_kind_define:nnnnnnn { root }
  {
    draw=semio-chrome-border-emphasized,
    line~width=\semio@stroke@focus,
    fill=semio-chrome-panel,
    text=semio-chrome-foreground,
    align=left, minimum~height=8mm,
    inner~xsep=0.5em, inner~ysep=0.32em,
  }
  { 0 } { box }
  { \SemioMono\fontsize{8.4pt}{10pt}\selectfont }
  { \SemioSans\fontsize{8.4pt}{10pt}\selectfont }
  { 10pt }
\semio_tree_kind_define:nnnnnnn { group }
  {
    draw=semio-chrome-border-normal,
    line~width=\semio@stroke@default,
    fill=semio-chrome-window,
    text=semio-chrome-foreground,
    align=left, minimum~height=6.4mm,
    inner~xsep=0.45em, inner~ysep=0.28em,
  }
  { 1 } { box }
  { \SemioMono\fontsize{7.4pt}{8.8pt}\selectfont }
  { \SemioSans\fontsize{7.4pt}{8.8pt}\selectfont }
  { 8.8pt }
\semio_tree_kind_define:nnnnnnn { leaf }
  { inner~sep=0pt, align=left }
  { 2 } { row }
  { \SemioMono\fontsize{7pt}{8.2pt}\selectfont }
  { \SemioSans\fontsize{7.6pt}{9pt}\selectfont }
  { 8.2pt }
%endregion KindRegistry

%region Keys
% 🔑 Reset-before-set, never `.initial:n` -- this is how every semio key tree
% distinguishes "not passed, use the default" from "explicitly set to the
% default value". `window` is an opaque passthrough rather than a mirrored
% key set, exactly as in GraphFigure.
\tl_new:N \l_semio_tree_title_tl
\tl_new:N \l_semio_tree_window_tl
\keys_define:nn { semio / tree / figure }
  {
    title  .tl_set:N = \l_semio_tree_title_tl ,
    window .tl_set:N = \l_semio_tree_window_tl ,
  }
\cs_new_protected:Npn \semio_tree_figure_keys_reset: {
  \tl_clear:N \l_semio_tree_title_tl
  \tl_clear:N \l_semio_tree_window_tl
}
%endregion Keys

%region Figure
% 🪟 TreeFigure does NOT reimplement Figure -- it opens the existing window
% kind from semio-window.sty and adds only what a tree needs: the picture
% style, the millimetre unit contract and a minimum width so every plate of a
% multi-part tree lines up. break=false is structural (a tikzpicture is one
% unbreakable box), so it is not exposed as a key.
%
% The bounding box is NOT fixed with \useasboundingbox, unlike GraphFigure: a
% graph declares its frame up front, a tree's height is whatever its content
% turns out to be. A bare \path across the full width pins the horizontal
% extent and lets the vertical one grow.
\bool_new:N \l_semio_tree_in_figure_bool
\int_new:N \g_semio_tree_node_int
\tl_new:N \l_semio_tree_name_tl
\tl_new:N \l_semio_tree_prev_tl

\cs_new_protected:Npn \semio_tree_figure_open:n #1 {
  \begin{Figure}[#1]
  \begin{tikzpicture}[ semio~tree~picture ]
  \path (0,0) -- ( \semio@tree@width , 0 ) ;
}
% Every open-ancestor slot (see Primitives) is cleared, not just root/group's
% two: a plate that repeats the root box starts a fresh chain at EVERY depth,
% not only the two levels the earlier, hardcoded version tracked. Depths are
% integers 0..maxdepth by construction (KindRegistry only ever grows that
% ceiling), so stepping the whole range is exhaustive.
\cs_new_protected:Npn \semio_tree_open_reset: {
  \int_step_inline:nnn { 0 } { \g_semio_tree_maxdepth_int }
    { \tl_if_exist:cT { g_semio_tree_open_##1_tl } { \tl_gclear:c { g_semio_tree_open_##1_tl } } }
}
\cs_new_protected:Npn \semio_tree_figure_begin:n #1 {
  \semio_tree_figure_keys_reset:
  \keys_set:nn { semio / tree / figure } {#1}
  \tl_set:Nx \l_tmpa_tl {
    title = { \exp_not:V \l_semio_tree_title_tl } ,
    break = false ,
    \exp_not:V \l_semio_tree_window_tl
  }
  \exp_args:NV \semio_tree_figure_open:n \l_tmpa_tl
  \bool_set_true:N \l_semio_tree_in_figure_bool
  \tl_clear:N \l_semio_tree_prev_tl
  \semio_tree_open_reset:
}
\cs_new_protected:Npn \semio_tree_figure_end: {
  \bool_set_false:N \l_semio_tree_in_figure_bool
  \end{tikzpicture}
  \end{Figure}
}
\NewDocumentEnvironment { TreeFigure } { O{} }
  { \semio_tree_figure_begin:n {#1} }
  { \semio_tree_figure_end: }
%endregion Figure

%region Primitives
\cs_new_protected:Npn \semio_tree_frame_require:n #1 {
  \bool_if:NF \l_semio_tree_in_figure_bool
    { \msg_error:nnn { semio-tree } { outside-figure } {#1} }
}

% 🪢 Placement. No y-accumulator and no measured line heights: a node is put
% below its predecessor's real `.south`, so TikZ's own typesetting decides how
% far down that is -- what makes a three-line taxon push the next row down by
% three lines without anybody counting them. X comes from `depth * step`, so
% a caller-registered kind at any depth places itself correctly with no
% further code.
%
% Built through \use:x so the node name, the column and the gap are already
% resolved when TikZ reads them, and \exp_not:n keeps the caller's content
% untouched. The column coordinate gets a name unique to THIS node (suffix
% "col" on the node's own name) rather than one shared/reused name per
% picture, removing any question about redefining a shared coordinate
% repeatedly.
\cs_new_protected:Npn \semio_tree_node_name:N #1 {
  \int_gincr:N \g_semio_tree_node_int
  \tl_set:Nx #1 { semiotreenode \int_use:N \g_semio_tree_node_int }
}
\tl_new:N \l_semio_tree_colname_tl
\cs_new_protected:Npn \semio_tree_place:nnnn #1#2#3#4 { % kind, depth, gap-before, content
  \semio_tree_node_name:N \l_semio_tree_name_tl
  \tl_set:Nx \l_semio_tree_colname_tl { \l_semio_tree_name_tl col }
  \use:x {
    \exp_not:N \coordinate ( \l_semio_tree_colname_tl )
      at ( \dimexpr \semio@tree@indent@step * #2 \relax , 0mm ) ;
  }
  \tl_if_empty:NTF \l_semio_tree_prev_tl
    {
      \use:x {
        \exp_not:N \node [ semio~tree~node~#1 , anchor=north~west ]
          ( \l_semio_tree_name_tl ) at ( \l_semio_tree_colname_tl )
          { \exp_not:n {#4} } ;
      }
    }
    {
      % Split into two coordinates rather than one nested "-| ([shift]point)"
      % expression: pgf's shape lookup choked on the nested form (read the
      % whole "[yshift=...]..." sub-expression as an attempted node name).
      % Materialising the shifted point on its own line, THEN combining two
      % plain names with -|, sidesteps whatever that parsing conflict was.
      \use:x {
        \exp_not:N \coordinate ( \l_semio_tree_colname_tl below )
          at ( [ yshift=-#3 ] \l_semio_tree_prev_tl.south ) ;
      }
      % (P1 -| P2) takes its Y from P1 and its X from P2 -- confirmed by an
      % isolated test, since it is easy to misremember backwards (which the
      % first version of this line did: every node landed at y=0, the column
      % coordinates' own y, because the operands were swapped).
      \use:x {
        \exp_not:N \node [ semio~tree~node~#1 , anchor=north~west ]
          ( \l_semio_tree_name_tl )
          at ( \l_semio_tree_colname_tl below -| \l_semio_tree_colname_tl )
          { \exp_not:n {#4} } ;
      }
    }
  \tl_set_eq:NN \l_semio_tree_prev_tl \l_semio_tree_name_tl
}

% 🎯 Elbow height for a "row"-kind branch: a FRACTION
% (\semio@tree@elbow@num/\semio@tree@elbow@den) of that specific kind's OWN
% registered leading (KindRegistry's 7th field), not one global constant --
% a caller-registered row-kind with a different font size gets a correctly
% placed branch with no extra work. Macro (the leading, via \tl_use:c) FIRST,
% multiplier/divisor as bare integers AFTER, via dimexpr's */ operators --
% the same <coefficient><macro-expanding-to-dimension> pitfall documented
% throughout this file (\dimexpr's number scanner cannot tell where a
% macro's own digits end and a following coefficient begins), avoided the
% same way each time.
\cs_new_protected:Npn \semio_tree_elbow:n #1 { % kind -> leaves result in \l_semio_tree_elbow_dim
  \dim_set:Nn \l_semio_tree_elbow_dim
    {
      \dimexpr \tl_use:c { c_semio_tree_kind_#1_leading_tl }
        * \semio@tree@elbow@num / \semio@tree@elbow@den \relax
    }
}
\dim_new:N \l_semio_tree_elbow_dim

% 🌿 The connector, and the whole reason this package is TikZ. `|-` goes
% vertical first, then horizontal, starting at the parent box's own
% bottom-left corner -- so for several children the vertical segments coincide
% into ONE continuous rail that stops at the last child, with no last-child
% flag, no per-row state and nothing for a page break to desynchronise.
\cs_new_protected:Npn \semio_tree_connect:nnn #1#2#3 { % parent, child, child-kind
  \str_if_eq:eeTF { \tl_use:c { c_semio_tree_kind_#3_inlet_tl } } { row }
    {
      \semio_tree_elbow:n {#3}
      \use:x {
        \exp_not:N \draw [ semio~tree~branch ] ( #1.south\space west )
          |- ( [ yshift=-\l_semio_tree_elbow_dim ] #2.north\space west ) ;
      }
    }
    {
      \use:x {
        \exp_not:N \draw [ semio~tree~branch ] ( #1.south\space west ) |- ( #2.west ) ;
      }
    }
}
\cs_generate_variant:Nn \semio_tree_connect:nnn { VVn }

% 🧭 One generic node command replaces three hardcoded ones: it looks up the
% kind's depth, places the node, records itself as the currently-open
% ancestor AT that depth (for its own future children to find), and -- if
% something is open one depth shallower -- connects to it. This is what
% makes "more tree levels" a registration, not a code change: a 4th level
% is a new kind at depth 3, placed and connected by this same function.
\tl_new:N \l_semio_tree_depth_tl
\tl_new:N \l_semio_tree_parent_tl
\cs_new_protected:Npn \semio_tree_node:nnn #1#2#3 { % kind, gap-before, content
  \semio_tree_kind_require:n {#1}
  \tl_set:Nx \l_semio_tree_depth_tl { \tl_use:c { c_semio_tree_kind_#1_depth_tl } }
  \semio_tree_place:nnnn {#1} { \l_semio_tree_depth_tl } {#2} {#3}
  \tl_gset_eq:cN { g_semio_tree_open_ \l_semio_tree_depth_tl _tl } \l_semio_tree_name_tl
  \int_compare:nNnT { \l_semio_tree_depth_tl } > { 0 }
    {
      \tl_set:Nx \l_semio_tree_parent_tl
        { \tl_use:c { g_semio_tree_open_ \int_eval:n { \l_semio_tree_depth_tl - 1 } _tl } }
      \tl_if_empty:NF \l_semio_tree_parent_tl
        { \semio_tree_connect:VVn \l_semio_tree_parent_tl \l_semio_tree_name_tl {#1} }
    }
}

\cs_new_protected:Npn \semio_tree_box:nnnn #1#2#3#4 { % kind, code, label, count
  \semio_tree_frame_require:n { SemioTreeBox }
  \semio_tree_node:nnn {#1} { \semio@tree@gap@box }
    {
      \semio@tree@box
        { \tl_use:c { c_semio_tree_kind_#1_codefont_tl } } {#2}
        { \tl_use:c { c_semio_tree_kind_#1_labelfont_tl } } {#3}
        {#4}
    }
}
\cs_new_protected:Npn \semio_tree_row:nnnn #1#2#3#4 { % kind, code, label, marks
  \semio_tree_frame_require:n { SemioTreeRow }
  \semio_tree_node:nnn {#1} { \semio@tree@gap@row }
    {
      \semio@tree@row
        { \tl_use:c { c_semio_tree_kind_#1_codefont_tl } } {#2}
        { \tl_use:c { c_semio_tree_kind_#1_labelfont_tl } } {#3}
        {#4}
    }
}

% Generic entry points for a caller-registered kind at any depth, plus
% root/group/leaf as thin, familiar wrappers around the two above.
\NewDocumentCommand \SemioTreeBox { m m m O{} } { \semio_tree_box:nnnn {#1}{#2}{#3}{#4} }
\NewDocumentCommand \SemioTreeRow { m m m m }   { \semio_tree_row:nnnn {#1}{#2}{#3}{#4} }
\NewDocumentCommand \SemioTreeRoot  { m m }   { \semio_tree_box:nnnn { root }  {#1}{#2}{} }
\NewDocumentCommand \SemioTreeGroup { m m m } { \semio_tree_box:nnnn { group } {#1}{#2}{#3} }
\NewDocumentCommand \SemioTreeLeaf  { m m m } { \semio_tree_row:nnnn { leaf }  {#1}{#2}{#3} }
%endregion Primitives

%region Marks
% 🏷 A leaf's marks column is a delimited list of already-formatted segments
% (the caller's data layer knows what "R$\times$6" means, this package only
% owns the join). Mirrors \SemioCellList's O{sep} m signature and its
% seq_set_split:Nnn technique, styled for a compact right-reading metadata
% line instead of a bulleted block.
\seq_new:N \l_semio_tree_marks_seq
\cs_new_protected:Npn \semio_tree_marks_format:nn #1#2 {
  \seq_set_split:Nnn \l_semio_tree_marks_seq {#1} {#2}
  \int_zero:N \l_tmpa_int
  \seq_map_inline:Nn \l_semio_tree_marks_seq {
    \int_compare:nNnF \l_tmpa_int = \c_zero_int
      { \nobreak\ \textperiodcentered\ }
    \tl_trim_spaces:n {##1}
    \int_incr:N \l_tmpa_int
  }
}
\NewDocumentCommand \SemioTreeMarks { O{\semio@tree@marks@sep} m }
  {
    {\SemioMono\fontsize{7pt}{8.4pt}\selectfont
     \color{semio-chrome-text-normal}\semio_tree_marks_format:nn {#1}{#2}}
  }
%endregion Marks

%region Legend
% 🔖 Draws the vocabulary instead of describing it: each entry is a real node
% in that kind's own style, so a token change updates the legend
% automatically -- mirrors \SemioGraphLegend exactly (split on `=`, look the
% key up in the registry, let the registry supply the visual).
\seq_new:N \l_semio_tree_legend_pair_seq
\tl_new:N \l_semio_tree_legend_key_tl
\tl_new:N \l_semio_tree_legend_value_tl
\int_new:N \l_semio_tree_legend_int

% A "row"-inlet kind (leaves) has no draw/fill of its own -- it is plain
% text, reached by a branch, not a box -- so its node style alone would
% swatch as an empty rectangle. Draw the branch stub itself instead: the
% actual mark a leaf carries in the tree.
\cs_new_protected:Npn \semio_tree_legend_swatch:n #1 {
  \str_if_eq:eeTF { \tl_use:c { c_semio_tree_kind_#1_inlet_tl } } { row }
    {
      \tikz[ semio~tree~picture , baseline=-0.4ex ]
        \draw [ semio~tree~branch ] (0,0) -- (3.4mm,0) ;
    }
    {
      \tikz[ semio~tree~picture , baseline=-0.5ex ]
        \node [ semio~tree~node~#1 , minimum~height=0pt , minimum~width=3.4mm ,
                inner~sep=0.5mm ] {} ;
    }
}
\cs_new_protected:Npn \semio_tree_legend_item:nn #1#2 {
  \semio_tree_kind_require:n {#1}
  \int_incr:N \l_semio_tree_legend_int
  \int_compare:nNnT \l_semio_tree_legend_int > 1
    { \textcolor{semio-chrome-border-normal}{~\textperiodcentered}~ }
  \semio_tree_legend_swatch:n {#1} \nobreakspace #2
}
\cs_new_protected:Npn \semio_tree_legend_entry:n #1 {
  \seq_set_split:Nnn \l_semio_tree_legend_pair_seq { = } {#1}
  \tl_set:Nx \l_semio_tree_legend_key_tl   { \seq_item:Nn \l_semio_tree_legend_pair_seq {1} }
  \tl_set:Nx \l_semio_tree_legend_value_tl { \seq_item:Nn \l_semio_tree_legend_pair_seq {2} }
  \exp_args:NVV \semio_tree_legend_item:nn
    \l_semio_tree_legend_key_tl \l_semio_tree_legend_value_tl
}
\NewDocumentCommand \SemioTreeLegend { m }
  {
    \int_zero:N \l_semio_tree_legend_int
    {\SemioSans\fontsize{7pt}{8.4pt}\selectfont
     \color{semio-chrome-text-normal}
     \clist_map_inline:nn {#1} { \semio_tree_legend_entry:n {##1} }}
  }
%endregion Legend

\ExplSyntaxOff
