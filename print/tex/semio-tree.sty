\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-tree}[2026/08/12 v0.1.0 semio hierarchical tree tables]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-core}
\RequirePackage{semio-fonts}
\RequirePackage{semio-table}
% array/colortbl/longtable arrive with semio-table.sty; nothing extra to load.

% 🌳 A phylogenetic/outline tree is a hierarchy that must PAGINATE (a real
% tree can run to hundreds of leaves), so it cannot be a tikzpicture (one
% unbreakable box -- see semio-graph.sty's GraphSpread comment). It is built
% on the SAME longtable substrate as \SemioTableLong: every row's height comes
% from real `array` text measurement, not an estimate, and pagination is
% native, not precomputed. This package does not reimplement that substrate --
% it opens \SemioTableLong exactly as GraphFigure opens the existing Figure
% window, and adds only the tree-specific vocabulary: row kinds, indentation
% and mark formatting.
\providecommand{\semio@tree@text@size}{7.2pt}
\providecommand{\semio@tree@marks@size}{7pt}
\providecommand{\semio@tree@marks@sep}{;}
% Colspec/header are NOT indirected through a macro: \SemioTableLong is a
% plain \newcommand (not expl3-aware) that reads its 3rd/4th arguments as
% literal text -- every other call site in this codebase (register, glossary,
% the D-set appendices) passes that text inline for the same reason. A macro
% reference there is read as ONE unexpanded token, not split on its commas.

\ExplSyntaxOn

%region Diagnostics
\msg_new:nnn { semio-tree } { unknown-kind }
  { Unknown~semio~tree~row~kind~'#1'.~Known~kinds:~
    \seq_use:Nn \g_semio_tree_kinds_seq { ,~ } . }
\msg_new:nnn { semio-tree } { kind-exists }
  { Semio~tree~row~kind~'#1'~is~already~defined. }
%endregion

%region KindRegistry
% 🧬 A row KIND is a delta on the plain leaf row: which band fill it uses (or
% none, for an ordinary leaf), which font it sets, and how many indent units
% it steps in. Mirrors \semio_graph_state_define:nnn in semio-graph.sty: kinds
% never overwrite each other, and a new kind is added with \SemioTreeKind,
% never by editing the defaults below. `leaf` is the base (unstyled, deepest)
% member; `group` is a spanning band one level shallower.
\seq_new:N \g_semio_tree_kinds_seq

\cs_new_protected:Npn \semio_tree_kind_define:nnnn #1#2#3#4 {
  \seq_if_in:NnTF \g_semio_tree_kinds_seq {#1}
    { \msg_error:nnn { semio-tree } { kind-exists } {#1} }
    {
      \seq_gput_right:Nn \g_semio_tree_kinds_seq {#1}
      \tl_const:cn { c_semio_tree_kind_#1_fill_tl }   {#2}
      \tl_const:cn { c_semio_tree_kind_#1_font_tl }   {#3}
      \tl_const:cn { c_semio_tree_kind_#1_indent_tl } {#4}
    }
}
\cs_new_protected:Npn \semio_tree_kind_require:n #1 {
  \seq_if_in:NnF \g_semio_tree_kinds_seq {#1}
    { \msg_error:nnn { semio-tree } { unknown-kind } {#1} }
}
\NewDocumentCommand \SemioTreeKind { m m m m }
  { \semio_tree_kind_define:nnnn {#1}{#2}{#3}{#4} }

% 🌱 Defaults. `group` bands one step above the base; a caller building a
% deeper hierarchy (e.g. a 4-level hürden/klade/familie/taxon tree) adds a new
% kind rather than edit these two.
\semio_tree_kind_define:nnnn { group } { semio-chrome-window } { \SemioSans } { 0 }
\semio_tree_kind_define:nnnn { leaf }  {}                       { \SemioSans } { 1 }
%endregion

%region Marks
% 🏷 A leaf's marks column is a delimited list of already-formatted segments
% (the caller's data layer knows what "R$\times$6" means, this package only
% owns the join). Mirrors \SemioCellList's O{sep} m signature and its
% seq_set_split:Nnn technique, styled for a compact right-reading metadata
% line instead of a bulleted block.
\seq_new:N \l_semio_tree_marks_seq
\cs_new_protected:Npn \semio_tree_marks_format:nn #1#2 {
  \seq_set_split:Nnn \l_semio_tree_marks_seq {#1} {#2}
  \int_zero:N \l_tmpa_int
  \seq_map_inline:Nn \l_semio_tree_marks_seq {
    \int_compare:nNnF \l_tmpa_int = \c_zero_int
      { \nobreak\ \textperiodcentered\ }
    \tl_trim_spaces:n {##1}
    \int_incr:N \l_tmpa_int
  }
}
\NewDocumentCommand \SemioTreeMarks { O{\semio@tree@marks@sep} m }
  {
    {\SemioMono\fontsize{\semio@tree@marks@size}{\dimexpr \semio@tree@marks@size*6/5\relax}\selectfont
     \color{semio-chrome-text-normal}\semio_tree_marks_format:nn {#1}{#2}}
  }
%endregion

%region Rows
% 🌲 The reference this package targets (the pre-.sty TikZ rendering of this
% same appendix, kept for comparison, and a hand-drawn diagram of the
% pattern) is a rectangular cladogram: each node's trunk starts at its OWN
% bottom-left corner -- not carried over from a sibling above it -- runs
% down through ONLY that node's own children with one branch stub per
% child, and STOPS after the last child (a closing corner, not a line that
% keeps going). A group node itself carries no incoming trunk/stub; it is
% the anchor its children's trunk hangs from, not a stop along someone
% else's. A tikzpicture cannot paginate (one unbreakable box -- see
% semio-graph.sty's GraphSpread comment), so this is built from independent
% per-row segments, not one drawn path: every row already draws itself
% against the SAME strut envelope every ordinary cell uses
% (\semio@table@vtop above baseline, \semio@table@vbot below), so a \vrule
% with that exact height+depth, drawn fresh by consecutive LEAF rows at the
% same x, abuts with zero gap and reads as one line -- right up until the
% last child of a group, whose segment is cut short (zero depth) to close
% the branch instead of continuing into whatever comes next.
\newcommand{\semio@tree@trunk@x}{2mm}
% Continues into the row below (used by every leaf except a group's last).
\newcommand{\semio@tree@trunk}{%
  {\color{semio-chrome-border-normal}%
   \rule[-\semio@table@vbot]{0.6pt}{\dimexpr\semio@table@vtop+\semio@table@vbot\relax}}%
}
% Stops at this row (used by a group's last leaf) -- zero depth, so nothing
% is drawn below the branch stub; the line closes here instead of carrying
% on toward whatever row (a new group, or nothing) comes next.
\newcommand{\semio@tree@trunk@last}{%
  {\color{semio-chrome-border-normal}%
   \rule[0pt]{0.6pt}{\semio@table@vtop}}%
}
% Stub width IS the indent step: a leaf's code lands at trunk@x + this
% width, so this is what makes a leaf read as visibly nested under its
% group box rather than sitting at nearly the same x as it. Measured
% directly off the reference PDF (huerden_final.pdf, "Detailbaum ECO"):
% ECO.COST starts at x=100.13pt, ECO.COST.01 at x=120.73pt -- a 20.6pt
% (~7.3mm) step. 7mm here matches that; it only fit once the Code column
% itself was widened (0.16 -> 0.24 in \SemioTree below), which is the fix
% that was actually missing, not the stub width.
% Raise amount: same <coefficient><macro> \dimexpr hazard as everywhere else
% in this file (\raisebox's argument is a plain <dimen>, and
% \semio@tree@text@size is TEXT ("7.2pt"), not an internal dimen) -- macro
% first, multiplier after via \dimexpr's */ operators.
\newcommand{\semio@tree@stub@w}{7mm}
\newcommand{\semio@tree@stub}{%
  {\color{semio-chrome-border-normal}%
   \raisebox{\dimexpr\semio@tree@text@size*7/50\relax}{\rule{\semio@tree@stub@w}{0.6pt}}}%
}

% 🪟 A GROUP node is a content-sized bordered box (\fcolorbox, auto width),
% not a full-width filled band -- matching the reference's family/clade
% boxes, not \SemioTableBandRow's edge-to-edge band (which is unused
% anywhere in the report; nothing else in the codebase actually renders
% this way). It carries NO trunk/stub of its own (see this region's opening
% comment) -- just \hspace*{trunk@x} to sit at the same x its children's
% trunk will hang from. Still a \multicolumn spanning all 3 real columns,
% because the box's content (code+label+count together) does not map onto
% the table's 3-column grid -- but the multicolumn's own format spec only
% supplies alignment (border@L/R + padendL/R, matching the outer colspec so
% the box starts at the same x as the header), not a background fill.
%
% Found by isolated bisection (minimal macros run through \SemioTableLong
% standalone, one axis varied at a time -- plain vs expl3, protected vs not,
% direct vs through \SemioTableRow, assignment vs pure expansion before the
% call): the ONE thing that reproduces "Misplaced \omit" is a \protected
% macro (\cs_new_protected:Npn) whose expansion contains \multicolumn --
% \cs_new:Npn with byte-identical body compiles clean. The array/longtable
% cell-start scan that looks for \multicolumn's leading \omit does not
% transparently expand a \protected macro the way it does an ordinary one
% (\protected exists precisely to stop exactly this kind of silent
% expansion, so this is consistent, if easy to miss). \omit still has to be
% the FIRST thing reached, so the row is not routed through \SemioTableRow
% either (its long/short \ifnum sits in the way); it hand-rolls the
% long-table row terminator, matching \SemioTableBandRow.
% ?? \hspace{...} not ~ between the segments below: an active-character
% nbsp measurably produces NO width at all here (confirmed by extracting the
% compiled PDF's text layer -- "ECO.COSTKosten-..." came back as one glued
% word with zero space between), while the identical ~ works completely
% normally as ordinary body text elsewhere in the same document. Root cause
% not chased further since \hspace is unambiguous and side-steps whatever
% babel/active-char interaction is specific to this multicolumn cell.
% ?? Row ends in a plain \\, not \\*\semio@table@rule: a tree is an outline,
% not a data grid -- a hairline under every single row read as "normal table"
% rather than hierarchy-by-indentation (the whole point of this package).
% The outer table border stayed (it gives the tree the same contained-module
% look as every other Figure/Table -- an earlier attempt to drop it left the
% header's own corner-tick rule floating disconnected above a sideless body).
\cs_new:Npn \semio_tree_group_row:nnn #1#2#3 { % code, label, count
  \multicolumn{3}{@{\semio@table@border@L}@{\semio@table@padendL}%
    >{\raggedright\arraybackslash\semio@cell@inset\semio@cell@struttop\hspace{0pt}}
    p{\semio@table@long@inner@w}<{\semio@cell@strutbot}%
    @{\semio@table@padendR}@{\semio@table@border@R}}{%
    \hspace*{\semio@tree@trunk@x}%
    {\fboxsep=2.2pt\fboxrule=0.6pt
     \fcolorbox{semio-chrome-border-normal}{\tl_use:c{c_semio_tree_kind_group_fill_tl}}{%
       {\SemioMono\fontsize{\semio@tree@marks@size}{\dimexpr \semio@tree@marks@size*6/5\relax}\selectfont #1}%
       \hspace{0.5em}{\tl_use:c{c_semio_tree_kind_group_font_tl}\color{semio-chrome-foreground} #2}%
       \tl_if_blank:nF {#3} { \hspace{0.35em}\textperiodcentered\hspace{0.35em}{\SemioMono\fontsize{\semio@tree@marks@size}{\dimexpr \semio@tree@marks@size*6/5\relax}\selectfont #3}}%
     }}%
  }%
  \\
}

% 🍃 A LEAF row is three ordinary cells from \SemioTableLong's own
% fraction-driven colspec (real `array` p{} measurement -- no estimated line
% count anywhere). #5 (last) selects which trunk segment closes the branch:
% every leaf but a group's final one carries the trunk on into the row
% below; the final one stops it (see this region's opening comment) --
% the caller decides via \SemioTreeLeaf vs \SemioTreeLeafLast, since the
% data layer already knows which taxon ends its family's list. (The kind
% registry's `indent` field is unused here now -- the connector is
% fixed-position by design, so every leaf shares one trunk x -- but stays
% registered as a hook for a future kind wanting a second indent level.)
\cs_new_protected:Npn \semio_tree_leaf_row:nnnnn #1#2#3#4#5 { % kind, code, label, marks, last(0/1)
  \semio_tree_kind_require:n {#1}
  % Not routed through \SemioTableRow, for the same reason the group row
  % isn't (see its comment): \SemioTableRow always appends \\*\semio@table@rule
  % in long mode, and a hairline under every leaf item is exactly the
  % table-grid look this package exists to avoid. Content ends in a plain \\
  % -- ordinary longtable row end, natural page breaks allowed between items.
  \hspace*{\semio@tree@trunk@x}%
  \tl_if_eq:nnTF {#5}{1} { \semio@tree@trunk@last } { \semio@tree@trunk }
  \semio@tree@stub
  {\SemioMono\fontsize{\semio@tree@text@size}{\dimexpr \semio@tree@text@size*6/5\relax}\selectfont
   \color{semio-chrome-text-normal}#2}
  &
  {\tl_use:c{c_semio_tree_kind_#1_font_tl}#3}
  &
  #4
  \\
}

% 🩹 Plain \newcommand, not xparse, and every argument mandatory (pass {}
% when a leaf has no marks, or a group no count). Matches the documented
% precedent in \SemioTableBandRow above: an xparse-generated command whose
% expansion reaches a \multicolumn inside a longtable row breaks with
% "Misplaced \omit"; plain argument grabbing does not have that problem. Leaf
% carries no \multicolumn but is kept in the same mandatory-args shape for
% one consistent authoring idiom across both row kinds.
\newcommand{\SemioTreeGroup}[3]{\semio_tree_group_row:nnn{#1}{#2}{#3}}
% Two commands, not one with a last/not-last switch argument: the same
% "plain \newcommand, mandatory args only" reasoning as \SemioTreeGroup
% above (consistency, not a hard requirement here -- leaf carries no
% \multicolumn) and it keeps a group's LAST call visually distinct at the
% call site, where the data layer is already iterating its taxon list and
% knows which one is last without having to compute or pass a boolean.
\newcommand{\SemioTreeLeaf}[3]{\semio_tree_leaf_row:nnnnn{leaf}{#1}{#2}{#3}{0}}
\newcommand{\SemioTreeLeafLast}[3]{\semio_tree_leaf_row:nnnnn{leaf}{#1}{#2}{#3}{1}}
%endregion

%region Tree
% 🌲 SemioTree does NOT reimplement the long-table substrate -- it opens the
% existing \SemioTableLong exactly as GraphFigure opens the existing Figure
% window, supplying only the tree-shaped colspec/header. Body content is a
% brace-delimited sequence of \SemioTreeGroup/\SemioTreeLeaf/
% \SemioTreeLeafLast calls, matching how \SemioTableLong's own body is
% already a sequence of \SemioTableRow calls everywhere else in this
% codebase -- no new authoring idiom introduced.
\NewDocumentCommand \SemioTree { m m }
  {
    % The outer left/right table border (\semio@table@border@L/R) stays --
    % removing it left the header's own little corner-tick rule (drawn
    % directly by \semio@table@rule@band, independent of border@L/R) floating
    % disconnected above a sideless body, reading as broken rather than
    % deliberately open. The border gives the tree the same contained-module
    % look as every other Figure/Table in the report; what actually made it
    % read as a data grid was the hairline under every single row, which is
    % what the Rows region's plain \\ (instead of \\*\semio@table@rule)
    % removes -- that is the part that stays gone.
    % Code column widened from the register/glossary-style 0.16 -- measured
    % against the reference PDF (huerden_final.pdf), the real indent step
    % between a family and its taxa is ~20.6pt (~7.3mm); at 0.16 that step
    % overflowed the column by 8.4pt. 0.16 was sized for flush-left codes
    % with no connector; this tree needs room for trunk+stub+indent too.
    \SemioTableLong
      [ text-size = 7.2pt ]
      {#1}
      {0.24,0.50,0.26}
      {Code & Bezeichnung & Merkmale}
      {#2}
  }
%endregion

%region Legend
% 🔖 Draws the vocabulary instead of describing it: each entry is a real
% swatch in that kind's own fill, so a token change updates the legend
% automatically -- mirrors \SemioGraphLegend exactly (split on the first `=`,
% look the key up in the registry, let the registry supply the visual).
\seq_new:N \l_semio_tree_legend_pair_seq
\tl_new:N \l_semio_tree_legend_key_tl
\tl_new:N \l_semio_tree_legend_value_tl
\int_new:N \l_semio_tree_legend_int

\tl_new:N \l_semio_tree_swatch_fill_tl
\cs_new_protected:Npn \semio_tree_legend_swatch:n #1 {
  % \tl_use:c{...} is a csname lookup wrapped in a further token-list lookup
  % -- more than one expansion step from its stored content, so a direct
  % tl_if_blank:n/:o test on it is unreliable (it tests the accessor call's
  % raw tokens, never blank, not what it resolves to). Materialise it into a
  % scratch variable with a fully expanding (:x) assignment first, then test
  % THAT variable with tl_if_empty:N (an :N signature genuinely exists for
  % "empty", unlike "blank"; kind fills are registered as {} with no stray
  % space, so empty and blank coincide here).
  \tl_set:Nx \l_semio_tree_swatch_fill_tl { \tl_use:c{c_semio_tree_kind_#1_fill_tl} }
  \tl_if_empty:NTF \l_semio_tree_swatch_fill_tl
    { \rule[-0.15em]{1.6em}{0.68em} }
    { {\color{\l_semio_tree_swatch_fill_tl}\rule[-0.15em]{1.6em}{0.68em}} }
}
\cs_new_protected:Npn \semio_tree_legend_item:nn #1#2 {
  \semio_tree_kind_require:n {#1}
  \int_incr:N \l_semio_tree_legend_int
  \int_compare:nNnT \l_semio_tree_legend_int > 1
    { \textcolor{semio-chrome-border-normal}{~\textperiodcentered}~ }
  \semio_tree_legend_swatch:n {#1} \nobreakspace #2
}
\cs_new_protected:Npn \semio_tree_legend_entry:n #1 {
  \seq_set_split:Nnn \l_semio_tree_legend_pair_seq { = } {#1}
  \tl_set:Nx \l_semio_tree_legend_key_tl   { \seq_item:Nn \l_semio_tree_legend_pair_seq {1} }
  \tl_set:Nx \l_semio_tree_legend_value_tl { \seq_item:Nn \l_semio_tree_legend_pair_seq {2} }
  \exp_args:NVV \semio_tree_legend_item:nn
    \l_semio_tree_legend_key_tl \l_semio_tree_legend_value_tl
}
\NewDocumentCommand \SemioTreeLegend { m }
  {
    \int_zero:N \l_semio_tree_legend_int
    {\SemioSans\fontsize{\semio@tree@marks@size}{\dimexpr \semio@tree@marks@size*6/5\relax}\selectfont
     \color{semio-chrome-text-normal}
     \clist_map_inline:nn {#1} { \semio_tree_legend_entry:n {##1} }}
  }
%endregion

\ExplSyntaxOff
