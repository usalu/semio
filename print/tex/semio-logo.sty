\newcommand{\semioemblem}[1][1cm]{%
  \resizebox{#1}{!}{%
    \tikz[baseline=-0.6ex]{%
      \begin{scope}[scale=0.005, x=1cm, y=-1cm]%
        \draw[line width=2.5, draw=semio-dark, fill=semio-tertiary] (1.25,3.067)--(36.25,38.875)--(36.25,161.25)--(1.25,161.25)--cycle;%
        \draw[line width=2.5, draw=semio-dark, fill=semio-primary] (1.25,161.25)--(156.813,161.25)--(194.473,123.75)--(1.25,123.75)--cycle;%
        \draw[line width=2.5, draw=semio-dark, fill=semio-primary] (161.263,1.25)--(161.25,156.856)--(198.75,119.236)--(198.75,1.25)--cycle;%
        \draw[line width=2.5, draw=semio-dark, fill=semio-secondary] (85.467,1.25)--(156.25,1.25)--(156.25,38.75)--(122.081,38.75)--cycle;%
        \draw[line width=2.5, draw=semio-dark, fill=semio-secondary] (85.468,81.25)--(156.25,81.25)--(156.25,118.75)--(122.081,118.75)--cycle;%
      \end{scope}%
    }%
  }%
}

\newcommand{\semio@logo@slot}[2][4cm]{%
  \begin{minipage}[c]{#1}%
    \centering%
    \IfFileExists{#2}{%
      \includegraphics[width=\linewidth]{#2}%
    }{%
      \fbox{\rule{0pt}{#1}\rule{\linewidth}{0pt}}%
      \par\small\texttt{#2}%
    }%
  \end{minipage}%
}
