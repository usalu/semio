% endpoints on a band scale rather than index arithmetic
% (`\PX+\a*\PW`..`\PX+\b*\PW+\PW-1.0`) -- reordering a stage in the scale's
% own domain can no longer silently shift what a span points at. Replaces
% skalierung.tex's C/D digital-function and operative-service spans.
\cs_new_protected:Npn \semio_viz_family_gantt: {
  \semio_viz_table_nrows:nN { \l_semio_viz_data_tl } \l_semio_viz_n_int
  \int_compare:nNnT \l_semio_viz_n_int = { 0 } { \int_set:Nn \l_semio_viz_n_int { 1 } }
  \fp_compare:nNnT { \l_semio_viz_labelwidth_fp } = { 0 } { \fp_set:Nn \l_semio_viz_labelwidth_fp { 25 } }
  \int_step_inline:nn { \l_semio_viz_n_int } {
    \fp_set:Nn \l_semio_viz_y_fp { \fp_eval:n { - ( ##1 - 0.5 ) * \l_semio_viz_boxheight_fp } }
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_labelcol_tl } \l_semio_viz_cell_tl
    \node [ font=\semio@viz@font@label, text=semio-chrome-text-normal, anchor=west, align=left,
            text~width=\fp_eval:n{\l_semio_viz_labelwidth_fp-2}mm ]
      at ( 0 , \fp_eval:n { \l_semio_viz_y_fp } ) { \exp_not:V \l_semio_viz_cell_tl } ;
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_fromcol_tl } \l_tmpa_tl
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_tocol_tl } \l_tmpb_tl
    \semio_viz_scale_band_span:VVVNN \l_semio_viz_xscale_name_tl \l_tmpa_tl \l_tmpb_tl \l_semio_viz_x_fp \l_semio_viz_span_hi_fp
    \fp_set:Nn \l_tmpa_fp { \fp_eval:n { 0.4 * \l_semio_viz_boxheight_fp } }
    \draw [ semio~viz~bar ]
