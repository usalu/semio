  \exp_args:NV \semio_viz_legend_draw:n \l_semio_viz_legend_kind_tl
}

% 🧷 anchor=NAME captures the family's own drawn extent into an ordinary,
% caller-named coordinate -- the same local-bounding-box-then-resolve-to-a-
% plain-\path-coordinate technique VizSection uses to chain sections without
% a hand-measured height. Lets trailing content (e.g. a note below a heat
% matrix) position itself from what was actually drawn, instead of a guessed
% \node at (0,-N) that silently goes wrong the moment the data changes.
\cs_new_protected:Npn \semio_viz_layout:nn #1#2 {
  \semio_viz_layout_keys_reset:
  \keys_set:nn { semio / viz / layout } {#2}
  \seq_if_in:NnTF \g_semio_viz_layout_families_seq {#1}
    {
      \tl_if_empty:NTF \l_semio_viz_layout_anchor_tl
        { \use:c { semio_viz_family_ \tl_to_str:n {#1} : } }
        {
          \int_gincr:N \g_semio_viz_layout_anchor_int
          \begin{scope}[ local~bounding~box=vizlayoutanchor\int_use:N\g_semio_viz_layout_anchor_int ]
          \use:c { semio_viz_family_ \tl_to_str:n {#1} : }
          \end{scope}
          \use:x {
            \exp_not:N \path
              ( vizlayoutanchor \int_use:N \g_semio_viz_layout_anchor_int .south~west )
              coordinate ( \exp_not:V \l_semio_viz_layout_anchor_tl ) ;
          }
        }
    }
    { \msg_error:nnn { semio-viz } { unknown-layout } {#1} }
}

% 🧩 Dispatches a layout family onto the bound table.
\NewDocumentCommand \SemioVizLayout { m O{} } { \semio_viz_layout:nn {#1} {#2} }
%endregion Families

