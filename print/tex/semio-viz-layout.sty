% 🧱 Keys shared by the row-structured families (grid/gantt/process/heat/
% horizontal bar) that replace the Systemkarte's hand-placed coordinates:
% a column grid, a span over a band scale, a labelled stage chain, a sparse
% matrix, a horizontal value bar. Column NAMES, not positional indices, so
% reordering a row in the data can never silently shift what a span points at.
\tl_new:N \l_semio_viz_labelcol_tl
\tl_new:N \l_semio_viz_valuecol_tl
\tl_new:N \l_semio_viz_keycol_tl
\tl_new:N \l_semio_viz_fromcol_tl
\tl_new:N \l_semio_viz_tocol_tl
\tl_new:N \l_semio_viz_rowcol_tl
\tl_new:N \l_semio_viz_colcol_tl
\tl_new:N \l_semio_viz_chipcol_tl
\tl_new:N \l_semio_viz_unit_tl
\tl_new:N \l_semio_viz_scale_name_tl
\tl_new:N \l_semio_viz_xscale_name_tl
\tl_new:N \l_semio_viz_yscale_name_tl
\clist_new:N \l_semio_viz_stages_clist
\int_new:N \l_semio_viz_columns_int
\fp_new:N \l_semio_viz_boxheight_fp
\fp_new:N \l_semio_viz_gutter_fp
\fp_new:N \l_semio_viz_labelwidth_fp
\fp_new:N \l_semio_viz_domain_lo_user_fp
\fp_new:N \l_semio_viz_domain_hi_user_fp
\bool_new:N \l_semio_viz_frame_bool
\bool_new:N \l_semio_viz_header_bool
\bool_new:N \l_semio_viz_domain_user_bool

\cs_new_protected:Npn \semio_viz_layout_keys_reset: {
  \tl_set:Nn \l_semio_viz_data_tl { demo }
  \tl_set:Nn \l_semio_viz_xcol_tl { cat }
  \tl_set:Nn \l_semio_viz_ycol_tl { val }
  \tl_set:Nn \l_semio_viz_legend_kind_tl { swatch }
  \tl_set:Nn \l_semio_viz_axis_scale_tl { x }
  \tl_set:Nn \l_semio_viz_axis_orient_tl { bottom }
  \tl_set:Nn \l_semio_viz_labelcol_tl { label }
  \tl_set:Nn \l_semio_viz_valuecol_tl { value }
  \tl_set:Nn \l_semio_viz_keycol_tl { key }
  \tl_set:Nn \l_semio_viz_fromcol_tl { from }
  \tl_set:Nn \l_semio_viz_tocol_tl { to }
  \tl_set:Nn \l_semio_viz_rowcol_tl { row }
  \tl_set:Nn \l_semio_viz_colcol_tl { col }
  \tl_set:Nn \l_semio_viz_chipcol_tl { chip }
  \tl_clear:N \l_semio_viz_unit_tl
  \tl_clear:N \l_semio_viz_scale_name_tl
  \tl_set:Nn \l_semio_viz_xscale_name_tl { x }
  \clist_set:Nn \l_semio_viz_stages_clist { s1, s2, s3 }
  \int_zero:N \l_semio_viz_columns_int
  \fp_set:Nn \l_semio_viz_boxheight_fp { 8 }
  \fp_set:Nn \l_semio_viz_gutter_fp { 1.5 }
  \fp_zero:N \l_semio_viz_labelwidth_fp
  \bool_set_true:N \l_semio_viz_frame_bool
  \bool_set_false:N \l_semio_viz_header_bool
  \bool_set_false:N \l_semio_viz_domain_user_bool
  \tl_clear:N \l_semio_viz_layout_anchor_tl
}

\keys_define:nn { semio / viz / layout } {
  data .tl_set:N = \l_semio_viz_data_tl,
  x .tl_set:N = \l_semio_viz_xcol_tl,
  y .tl_set:N = \l_semio_viz_ycol_tl,
  legend .tl_set:N = \l_semio_viz_legend_kind_tl,
  scale .tl_set:N = \l_semio_viz_scale_name_tl,
  xscale .tl_set:N = \l_semio_viz_xscale_name_tl,
  yscale .tl_set:N = \l_semio_viz_yscale_name_tl,
  orient .tl_set:N = \l_semio_viz_axis_orient_tl,
  label .tl_set:N = \l_semio_viz_labelcol_tl,
  value .tl_set:N = \l_semio_viz_valuecol_tl,
  key .tl_set:N = \l_semio_viz_keycol_tl,
  from .tl_set:N = \l_semio_viz_fromcol_tl,
  to .tl_set:N = \l_semio_viz_tocol_tl,
  row .tl_set:N = \l_semio_viz_rowcol_tl,
  col .tl_set:N = \l_semio_viz_colcol_tl,
  chip .tl_set:N = \l_semio_viz_chipcol_tl,
  unit .tl_set:N = \l_semio_viz_unit_tl,
  stages .clist_set:N = \l_semio_viz_stages_clist,
  columns .int_set:N = \l_semio_viz_columns_int,
  boxheight .fp_set:N = \l_semio_viz_boxheight_fp,
  gutter .fp_set:N = \l_semio_viz_gutter_fp,
  labelwidth .fp_set:N = \l_semio_viz_labelwidth_fp,
  frame .bool_set:N = \l_semio_viz_frame_bool,
  header .bool_set:N = \l_semio_viz_header_bool,
  domain .code:n = {
    \bool_set_true:N \l_semio_viz_domain_user_bool
    \fp_set:Nn \l_semio_viz_domain_lo_user_fp { \clist_item:nn {#1} { 1 } }
    \fp_set:Nn \l_semio_viz_domain_hi_user_fp { \clist_item:nn {#1} { 2 } }
  },
  anchor .tl_set:N = \l_semio_viz_layout_anchor_tl,
}

\cs_new_protected:Npn \semio_viz_inner_prep: {
  \semio_viz_table_nrows:nN { \l_semio_viz_data_tl } \l_semio_viz_n_int
  \semio_viz_table_col_min:nnN { \l_semio_viz_data_tl } { \l_semio_viz_ycol_tl } \l_semio_viz_ymin_fp
  \semio_viz_table_col_max:nnN { \l_semio_viz_data_tl } { \l_semio_viz_ycol_tl } \l_semio_viz_ymax_fp
  \fp_compare:nNnT { \l_semio_viz_ymax_fp } = { \l_semio_viz_ymin_fp } { \fp_add:Nn \l_semio_viz_ymax_fp { 1 } }
  \fp_compare:nNnT { \l_semio_viz_ymin_fp } > { 0 } { \fp_zero:N \l_semio_viz_ymin_fp }
  \int_compare:nNnT \l_semio_viz_n_int = { 0 } { \int_set:Nn \l_semio_viz_n_int { 1 } }
  \fp_set:Nn \l_semio_viz_w_fp { \l_semio_viz_width_fp - 2 * \l_semio_viz_pad_fp }
  \fp_set:Nn \l_semio_viz_h_fp { \l_semio_viz_height_fp - 2 * \l_semio_viz_pad_fp }
  \use:x {
    \exp_not:N \semio_viz_scale_define:nnnn { viz-y } { linear }
      { \fp_eval:n { \l_semio_viz_ymin_fp } , \fp_eval:n { \l_semio_viz_ymax_fp } }
      { \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_pad_fp + \l_semio_viz_h_fp } }
  }
}

\cs_new_protected:Npn \semio_viz_palette_item:nN #1#2 {
  \semio_viz_palette_categorical:
  \int_set:Nn \l_tmpa_int { \int_mod:nn { #1 - 1 } { \seq_count:N \l_semio_viz_palette_seq } + 1 }
  \tl_set:Nx #2 { \seq_item:Nn \l_semio_viz_palette_seq { \l_tmpa_int } }
}

\cs_new_protected:Npn \semio_viz_map_y:nN #1#2 {
  \tl_set:Nx \l_tmpa_tl {#1}
  \tl_if_empty:NT \l_tmpa_tl { \tl_set:Nn \l_tmpa_tl { 0 } }
  \semio_viz_scale_map:nnN { viz-y } { \l_tmpa_tl } #2
}

\tl_new:N \l_semio_viz_coords_tl
\fp_new:N \l_semio_viz_angle_lo_fp
\fp_new:N \l_semio_viz_angle_hi_fp
\fp_new:N \l_semio_viz_span_hi_fp

% ▦ Grid: N equal-width label boxes, either as a computed single/multi-row
% grid (`columns=`) or positioned by a band scale (`scale=`, one box per
% named key). Replaces skalierung.tex's A/B/E blocks -- \i*24.4 for a fixed
% six-across row, \PX+\i*\PW for the nine-process backbone, and the
% mod(\i,5)/int(\i/5) hand-wrap for the two-row rahmenbedingungen grid.
\int_new:N \l_semio_viz_grid_col_int
\int_new:N \l_semio_viz_grid_row_int
\fp_new:N \l_semio_viz_grid_bw_fp

\cs_new_protected:Npn \semio_viz_grid_box:nnnn #1#2#3#4 { % x, y (top-left), width, content
  \node [ semio~viz~cell, anchor=north~west,
          text~width=\fp_eval:n{(#3)-2}mm, minimum~height=\fp_eval:n{\l_semio_viz_boxheight_fp}mm ]
    at ( \fp_eval:n {#1} , \fp_eval:n {#2} ) { \exp_not:n {#4} } ;
}

\cs_new_protected:Npn \semio_viz_grid_cell:n #1 { % row index, columns mode
  \int_set:Nn \l_semio_viz_grid_col_int { \int_mod:nn { #1 - 1 } { \l_tmpb_int } }
  \int_set:Nn \l_semio_viz_grid_row_int { \int_div_truncate:nn { #1 - 1 } { \l_tmpb_int } }
  \fp_set:Nn \l_semio_viz_x_fp { \fp_eval:n { \l_semio_viz_grid_col_int * ( \l_semio_viz_grid_bw_fp + \l_semio_viz_gutter_fp ) } }
  \fp_set:Nn \l_semio_viz_y_fp { \fp_eval:n { - \l_semio_viz_grid_row_int * ( \l_semio_viz_boxheight_fp + \l_semio_viz_gutter_fp ) } }
  \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {#1} { \l_semio_viz_labelcol_tl } \l_semio_viz_cell_tl
  \semio_viz_grid_box:nnnn { \l_semio_viz_x_fp } { \l_semio_viz_y_fp } { \l_semio_viz_grid_bw_fp } { \l_semio_viz_cell_tl }
}

\cs_new_protected:Npn \semio_viz_grid_cell_scaled:n #1 { % row index, scale mode -- one box per named key
  \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {#1} { \l_semio_viz_keycol_tl } \l_tmpa_tl
  \semio_viz_scale_band_edges:VVNN \l_semio_viz_scale_name_tl \l_tmpa_tl \l_tmpb_fp \l_semio_viz_x_fp
  \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {#1} { \l_semio_viz_labelcol_tl } \l_semio_viz_cell_tl
  \semio_viz_grid_box:nnnn
    { \fp_eval:n { \l_tmpb_fp + \l_semio_viz_gutter_fp / 2 } } { 0 }
    { \fp_eval:n { \l_semio_viz_x_fp - \l_tmpb_fp - \l_semio_viz_gutter_fp } } { \l_semio_viz_cell_tl }
}

\cs_new_protected:Npn \semio_viz_family_grid: {
  \semio_viz_table_nrows:nN { \l_semio_viz_data_tl } \l_semio_viz_n_int
  \int_compare:nNnT \l_semio_viz_n_int = { 0 } { \int_set:Nn \l_semio_viz_n_int { 1 } }
  \tl_if_empty:NTF \l_semio_viz_scale_name_tl
    {
      \int_compare:nNnT \l_semio_viz_columns_int = { 0 } { \int_set_eq:NN \l_semio_viz_columns_int \l_semio_viz_n_int }
      \int_set_eq:NN \l_tmpb_int \l_semio_viz_columns_int
      \fp_set:Nn \l_semio_viz_grid_bw_fp { \fp_eval:n { ( \l_semio_viz_width_fp - ( \l_tmpb_int - 1 ) * \l_semio_viz_gutter_fp ) / \l_tmpb_int } }
      \int_step_inline:nn { \l_semio_viz_n_int } { \semio_viz_grid_cell:n {##1} }
    }
    { \int_step_inline:nn { \l_semio_viz_n_int } { \semio_viz_grid_cell_scaled:n {##1} } }
}

\cs_new_protected:Npn \semio_viz_family_bar: {
  \str_if_eq:VnTF \l_semio_viz_axis_orient_tl { horizontal }
    { \semio_viz_family_bar_horizontal: }
    { \semio_viz_family_bar_vertical: }
}

\cs_new_protected:Npn \semio_viz_family_bar_vertical: {
  \semio_viz_inner_prep:
  \semio_viz_plot_frame:nn { \l_semio_viz_width_fp } { \l_semio_viz_height_fp }
  \int_step_inline:nn { \l_semio_viz_n_int } {
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_ycol_tl } \l_semio_viz_cell_tl
    \semio_viz_map_y:nN { \l_semio_viz_cell_tl } \l_semio_viz_y_fp
    \semio_viz_map_y:nN { 0 } \l_tmpa_fp
    \fp_set:Nn \l_semio_viz_x_fp { \fp_eval:n { \l_semio_viz_pad_fp + (##1 - 0.8) / \l_semio_viz_n_int * \l_semio_viz_w_fp } }
    \semio_viz_palette_item:nN {##1} \l_semio_viz_color_tl
    \fill [ \l_semio_viz_color_tl ]
      ( \fp_eval:n { \l_semio_viz_x_fp } , \fp_eval:n { \l_tmpa_fp } )
      rectangle ( \fp_eval:n { \l_semio_viz_x_fp + 0.55 * \l_semio_viz_w_fp / \l_semio_viz_n_int } , \fp_eval:n { \l_semio_viz_y_fp } ) ;
  }
}

% ▬ Horizontal value bar: label column left, bar length proportional to
% value/domain, value (+ unit) after the bar. Replaces skalierung.tex's H1/H3
% insets, whose two DIFFERENT hand-computed multipliers (\v*0.185, \v*0.5)
% were the same chart with two undocumented, un-reusable domains.
\cs_new_protected:Npn \semio_viz_family_bar_horizontal: {
  \semio_viz_table_nrows:nN { \l_semio_viz_data_tl } \l_semio_viz_n_int
  \int_compare:nNnT \l_semio_viz_n_int = { 0 } { \int_set:Nn \l_semio_viz_n_int { 1 } }
  \bool_if:NT \l_semio_viz_frame_bool { \semio_viz_plot_frame:nn { \l_semio_viz_width_fp } { \l_semio_viz_height_fp } }
  \fp_compare:nNnT { \l_semio_viz_labelwidth_fp } = { 0 }
    { \fp_set:Nn \l_semio_viz_labelwidth_fp { \fp_eval:n { \l_semio_viz_width_fp * 0.4 } } }
  \bool_if:NTF \l_semio_viz_domain_user_bool
    { \fp_set_eq:NN \l_semio_viz_ymax_fp \l_semio_viz_domain_hi_user_fp }
    { \semio_viz_table_col_max:nnN { \l_semio_viz_data_tl } { \l_semio_viz_valuecol_tl } \l_semio_viz_ymax_fp }
  \fp_compare:nNnT { \l_semio_viz_ymax_fp } = { 0 } { \fp_set:Nn \l_semio_viz_ymax_fp { 1 } }
  \fp_set:Nn \l_semio_viz_w_fp { \fp_eval:n { \l_semio_viz_width_fp - \l_semio_viz_labelwidth_fp - 14 } }
  \int_step_inline:nn { \l_semio_viz_n_int } {
    \fp_set:Nn \l_semio_viz_y_fp { \fp_eval:n { - ( ##1 - 0.5 ) * \l_semio_viz_boxheight_fp } }
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_labelcol_tl } \l_semio_viz_cell_tl
    \node [ font=\semio@viz@font@label, text=semio-chrome-text-normal,
            anchor=west, align=left, text~width=\fp_eval:n{\l_semio_viz_labelwidth_fp-2}mm ]
      at ( 0 , \fp_eval:n { \l_semio_viz_y_fp } ) { \exp_not:V \l_semio_viz_cell_tl } ;
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_valuecol_tl } \l_semio_viz_cell_tl
    \fp_set:Nn \l_semio_viz_span_hi_fp { \fp_eval:n { \l_semio_viz_w_fp * min(max(\l_semio_viz_cell_tl,0),\l_semio_viz_ymax_fp) / \l_semio_viz_ymax_fp } }
    \draw [ semio~viz~bar ]
      ( \fp_eval:n { \l_semio_viz_labelwidth_fp } , \fp_eval:n { \l_semio_viz_y_fp - 0.85 } )
      rectangle ( \fp_eval:n { \l_semio_viz_labelwidth_fp + \l_semio_viz_span_hi_fp } , \fp_eval:n { \l_semio_viz_y_fp + 0.85 } ) ;
    \node [ font=\semio@viz@font@value, text=semio-chrome-foreground, anchor=west ]
      at ( \fp_eval:n { \l_semio_viz_width_fp - 12 } , \fp_eval:n { \l_semio_viz_y_fp } )
      { \exp_not:V \l_semio_viz_cell_tl \exp_not:V \l_semio_viz_unit_tl } ;
  }
}

\cs_new_protected:Npn \semio_viz_family_dot: {
  \semio_viz_inner_prep:
  \semio_viz_plot_frame:nn { \l_semio_viz_width_fp } { \l_semio_viz_height_fp }
