\cs_new_protected:Npn \semio_viz_family_area: {
  \semio_viz_inner_prep:
  \semio_viz_plot_frame:nn { \l_semio_viz_width_fp } { \l_semio_viz_height_fp }
  \tl_clear:N \l_semio_viz_coords_tl
  \tl_set:Nx \l_semio_viz_coords_tl { ( \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_pad_fp } ) }
  \int_step_inline:nn { \l_semio_viz_n_int } {
