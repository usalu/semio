%region Diagnostics
\msg_new:nnn { semio-viz } { unknown-layout }
  { Unknown~viz~layout~family~'#1'. }
%endregion Diagnostics

%region Families
\seq_new:N \g_semio_viz_layout_families_seq
\tl_new:N \l_semio_viz_data_tl
\tl_new:N \l_semio_viz_xcol_tl
\tl_new:N \l_semio_viz_ycol_tl
\tl_new:N \l_semio_viz_family_tl
\fp_new:N \l_semio_viz_width_fp
\fp_new:N \l_semio_viz_height_fp
\fp_new:N \l_semio_viz_x_fp
\fp_new:N \l_semio_viz_y_fp
\fp_new:N \l_semio_viz_w_fp
\fp_new:N \l_semio_viz_h_fp
\fp_new:N \l_semio_viz_ymin_fp
\fp_new:N \l_semio_viz_ymax_fp
\int_new:N \l_semio_viz_n_int
\tl_new:N \l_semio_viz_color_tl

\clist_map_inline:nn {
  bar, dot, line, area, pie, dist, tree, net, flow, geo, heat, radar,
  parallel, waffle, funnel, gantt, bullet, pack, chord, sankey, force,
  voronoi, hexbin, calendar, text, science, process, special, path, mark, anno
} { \seq_gput_right:Nn \g_semio_viz_layout_families_seq {#1} }

\cs_new_protected:Npn \semio_viz_layout_keys_reset: {
  \tl_set:Nn \l_semio_viz_data_tl { demo }
  \tl_set:Nn \l_semio_viz_xcol_tl { cat }
  \tl_set:Nn \l_semio_viz_ycol_tl { val }
}

\keys_define:nn { semio / viz / layout } {
  data .tl_set:N = \l_semio_viz_data_tl,
  x .tl_set:N = \l_semio_viz_xcol_tl,
  y .tl_set:N = \l_semio_viz_ycol_tl,
}

\cs_new_protected:Npn \semio_viz_inner_prep: {
  \semio_viz_table_nrows:nN { \l_semio_viz_data_tl } \l_semio_viz_n_int
  \iow_term:x { [DEBUG] nrows=\int_use:N \l_semio_viz_n_int ~ tab=\l_semio_viz_tab_tl ~ data=\l_semio_viz_data_tl }
  \semio_viz_table_col_min:nnN { \l_semio_viz_data_tl } { \l_semio_viz_ycol_tl } \l_semio_viz_ymin_fp
  \semio_viz_table_col_max:nnN { \l_semio_viz_data_tl } { \l_semio_viz_ycol_tl } \l_semio_viz_ymax_fp
  \fp_compare:nNnT { \l_semio_viz_ymax_fp } = { \l_semio_viz_ymin_fp } { \fp_add:Nn \l_semio_viz_ymax_fp { 1 } }
  \int_compare:nNnT \l_semio_viz_n_int = { 0 } { \int_set:Nn \l_semio_viz_n_int { 1 } }
  \fp_set:Nn \l_semio_viz_w_fp { \l_semio_viz_width_fp - 12 }
  \fp_set:Nn \l_semio_viz_h_fp { \l_semio_viz_height_fp - 12 }
  \iow_term:x { [DEBUG] nrows=\int_use:N \l_semio_viz_n_int ~ tab=\l_semio_viz_tab_tl ~ ymin=\fp_use:N \l_semio_viz_ymin_fp ~ cell=\l_semio_viz_cell_tl ~ col=\int_use:N \l_semio_viz_col_int }
}

\cs_new_protected:Npn \semio_viz_palette_item:nN #1#2 {
  \semio_viz_palette_categorical:
  \int_set:Nn \l_tmpa_int { \int_mod:nn { #1 - 1 } { \seq_count:N \l_semio_viz_palette_seq } + 1 }
  \tl_set:Nx #2 { \seq_item:Nn \l_semio_viz_palette_seq { \l_tmpa_int } }
}

\cs_new_protected:Npn \semio_viz_map_y:nN #1#2 {
  \tl_set:Nx \l_tmpa_tl {#1}
  \tl_if_empty:NT \l_tmpa_tl { \tl_set:Nn \l_tmpa_tl { 0 } }
  \fp_set:Nn #2 { \fp_eval:n {
    8 + ( \l_tmpa_tl - \l_semio_viz_ymin_fp ) / ( \l_semio_viz_ymax_fp - \l_semio_viz_ymin_fp ) * \l_semio_viz_h_fp
  } }
}

\tl_new:N \l_semio_viz_coords_tl
\fp_new:N \l_semio_viz_angle_lo_fp
\fp_new:N \l_semio_viz_angle_hi_fp

\cs_new_protected:Npn \semio_viz_family_bar: {
  \semio_viz_inner_prep:
  \semio_viz_plot_frame:nn { \l_semio_viz_width_fp } { \l_semio_viz_height_fp }
  \int_step_inline:nn { \l_semio_viz_n_int } {
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_ycol_tl } \l_semio_viz_cell_tl
    \semio_viz_map_y:nN { \l_semio_viz_cell_tl } \l_semio_viz_y_fp
    \fp_set:Nn \l_semio_viz_x_fp { \fp_eval:n { 10 + (##1 - 0.8) / \l_semio_viz_n_int * \l_semio_viz_w_fp } }
    \semio_viz_palette_item:nN {##1} \l_semio_viz_color_tl
    \fill [ \l_semio_viz_color_tl ]
      ( \l_semio_viz_x_fp , 8 )
      rectangle ( \fp_eval:n { \l_semio_viz_x_fp + 0.55 * \l_semio_viz_w_fp / \l_semio_viz_n_int } , \l_semio_viz_y_fp ) ;
  }
}

\cs_new_protected:Npn \semio_viz_family_dot: {
  \semio_viz_inner_prep:
  \semio_viz_plot_frame:nn { \l_semio_viz_width_fp } { \l_semio_viz_height_fp }
  \int_step_inline:nn { \l_semio_viz_n_int } {
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_ycol_tl } \l_semio_viz_cell_tl
    \semio_viz_map_y:nN { \l_semio_viz_cell_tl } \l_semio_viz_y_fp
    \fp_set:Nn \l_semio_viz_x_fp { \fp_eval:n { 12 + (##1 - 0.5) / \l_semio_viz_n_int * \l_semio_viz_w_fp } }
    \semio_viz_palette_item:nN {##1} \l_semio_viz_color_tl
    \fill [ \l_semio_viz_color_tl ] ( \l_semio_viz_x_fp , \l_semio_viz_y_fp ) circle [ radius=1.6pt ] ;
  }
}

\cs_new_protected:Npn \semio_viz_draw_line:n #1 {
  \draw [ semio-primary, line~width=\semio@stroke@default ] plot [ smooth ] coordinates { #1 } ;
}

\cs_new_protected:Npn \semio_viz_family_line: {
  \semio_viz_inner_prep:
  \semio_viz_plot_frame:nn { \l_semio_viz_width_fp } { \l_semio_viz_height_fp }
  \tl_clear:N \l_semio_viz_coords_tl
  \int_step_inline:nn { \l_semio_viz_n_int } {
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_ycol_tl } \l_semio_viz_cell_tl
    \semio_viz_map_y:nN { \l_semio_viz_cell_tl } \l_semio_viz_y_fp
    \fp_set:Nn \l_semio_viz_x_fp { \fp_eval:n { 12 + (##1 - 0.5) / \l_semio_viz_n_int * \l_semio_viz_w_fp } }
    \tl_put_right:Nx \l_semio_viz_coords_tl { ( \fp_eval:n { \l_semio_viz_x_fp } , \fp_eval:n { \l_semio_viz_y_fp } ) }
  }
  \exp_args:NV \semio_viz_draw_line:n \l_semio_viz_coords_tl
}

\cs_new_protected:Npn \semio_viz_draw_area:n #1 {
  \fill [ semio-primary, fill~opacity=0.35 ] #1 ;
}

\cs_new_protected:Npn \semio_viz_family_area: {
  \semio_viz_inner_prep:
  \semio_viz_plot_frame:nn { \l_semio_viz_width_fp } { \l_semio_viz_height_fp }
  \tl_clear:N \l_semio_viz_coords_tl
  \tl_set:Nx \l_semio_viz_coords_tl { ( 12 , 8 ) }
  \int_step_inline:nn { \l_semio_viz_n_int } {
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {##1} { \l_semio_viz_ycol_tl } \l_semio_viz_cell_tl
    \semio_viz_map_y:nN { \l_semio_viz_cell_tl } \l_semio_viz_y_fp
    \fp_set:Nn \l_semio_viz_x_fp { \fp_eval:n { 12 + (##1 - 0.5) / \l_semio_viz_n_int * \l_semio_viz_w_fp } }
    \tl_put_right:Nx \l_semio_viz_coords_tl { -- ( \fp_eval:n { \l_semio_viz_x_fp } , \fp_eval:n { \l_semio_viz_y_fp } ) }
  }
  \tl_put_right:Nx \l_semio_viz_coords_tl { -- ( \fp_eval:n { 12 + ( \l_semio_viz_n_int - 0.5 ) / \l_semio_viz_n_int * \l_semio_viz_w_fp } , 8 ) -- cycle }
  \exp_args:NV \semio_viz_draw_area:n \l_semio_viz_coords_tl
}

\cs_new_protected:Npn \semio_viz_family_pie: {
  \fp_zero:N \l_semio_viz_angle_lo_fp
  \semio_viz_table_col_sum:nnN { demo } { val } \l_tmpb_fp
  \int_step_inline:nn { 5 } {
    \semio_viz_table_cell:nnnN { demo } {##1} { val } \l_semio_viz_cell_tl
    \semio_viz_palette_item:nN {##1} \l_semio_viz_color_tl
    \fp_set:Nn \l_semio_viz_angle_hi_fp { \fp_eval:n { \l_semio_viz_angle_lo_fp + \l_semio_viz_cell_tl / \l_tmpb_fp * 360 } }
    \fill [ \l_semio_viz_color_tl ]
      ( \fp_eval:n { \l_semio_viz_width_fp / 2 } , \fp_eval:n { \l_semio_viz_height_fp / 2 } )
      -- ++( \fp_eval:n { \l_semio_viz_angle_lo_fp } : 14 )
      arc [ start~angle=\fp_eval:n { \l_semio_viz_angle_lo_fp } , end~angle=\fp_eval:n { \l_semio_viz_angle_hi_fp } , radius=14 ]
      -- cycle ;
    \fp_set_eq:NN \l_semio_viz_angle_lo_fp \l_semio_viz_angle_hi_fp
  }
}

