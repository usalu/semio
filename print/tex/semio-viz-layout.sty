% 🔗 Evidence/process chain: a source chip followed by N labelled stage
% boxes with connecting arrows, the LAST edge always analytic (dashed) -- the
% source-quote/own-synthesis distinction skalierung.tex's evidence rows
% depend on. A per-row helper (not a nested inline loop) per the codebase's
% own documented gotcha: \int_step_inline:nn / \seq_map_inline:Nn are not
% nestable, thread the index as a real parameter instead.
\int_new:N \l_semio_viz_stage_int
\fp_new:N \l_semio_viz_prevx_fp
\tl_new:N \l_semio_viz_edge_style_tl

\cs_new_protected:Npn \semio_viz_process_row:n #1 { % row index
  \fp_set:Nn \l_semio_viz_y_fp { \fp_eval:n { - ( #1 - 0.5 ) * \l_semio_viz_boxheight_fp } }
  \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {#1} { \l_semio_viz_chipcol_tl } \l_semio_viz_cell_tl
  \node [ semio~viz~chip, anchor=center ] at ( 5 , \fp_eval:n { \l_semio_viz_y_fp } ) { \exp_not:V \l_semio_viz_cell_tl } ;
  \int_zero:N \l_semio_viz_stage_int
  \fp_zero:N \l_semio_viz_prevx_fp
  \clist_map_inline:Nn \l_semio_viz_stages_clist {
    \int_incr:N \l_semio_viz_stage_int
    \semio_viz_table_cell:nnnN { \l_semio_viz_data_tl } {#1} {##1} \l_semio_viz_cell_tl
    \fp_set:Nn \l_semio_viz_x_fp { \fp_eval:n { 11 + ( \l_semio_viz_stage_int - 1 ) * \l_tmpa_fp } }
    \int_compare:nNnT \l_semio_viz_stage_int > { 1 } {
      \int_compare:nNnTF \l_semio_viz_stage_int = { \l_tmpb_int }
        { \tl_set:Nn \l_semio_viz_edge_style_tl { semio~viz~edge~analytic } }
        { \tl_set:Nn \l_semio_viz_edge_style_tl { semio~viz~edge } }
      \draw [ \l_semio_viz_edge_style_tl ]
        ( \fp_eval:n { \l_semio_viz_prevx_fp } , \fp_eval:n { \l_semio_viz_y_fp } )
        -- ( \fp_eval:n { \l_semio_viz_x_fp } , \fp_eval:n { \l_semio_viz_y_fp } ) ;
    }
    \node [ semio~viz~module, anchor=west,
            text~width=\fp_eval:n{\l_tmpa_fp-3}mm, minimum~height=\fp_eval:n{0.9*\l_semio_viz_boxheight_fp}mm ]
      at ( \fp_eval:n { \l_semio_viz_x_fp } , \fp_eval:n { \l_semio_viz_y_fp - 0.45*\l_semio_viz_boxheight_fp } )
      { \exp_not:V \l_semio_viz_cell_tl } ;
    \fp_set:Nn \l_semio_viz_prevx_fp { \fp_eval:n { \l_semio_viz_x_fp + \l_tmpa_fp - 1 } }
  }
}

\cs_new_protected:Npn \semio_viz_family_process: {
  \semio_viz_table_nrows:nN { \l_semio_viz_data_tl } \l_semio_viz_n_int
  \int_compare:nNnT \l_semio_viz_n_int = { 0 } { \int_set:Nn \l_semio_viz_n_int { 1 } }
  \int_set:Nn \l_tmpb_int { \clist_count:N \l_semio_viz_stages_clist }
  \int_compare:nNnT \l_tmpb_int = { 0 } { \int_set:Nn \l_tmpb_int { 1 } }
  \fp_set:Nn \l_tmpa_fp { \fp_eval:n { ( \l_semio_viz_width_fp - 11 ) / \l_tmpb_int } }
  \int_step_inline:nn { \l_semio_viz_n_int } { \semio_viz_process_row:n {##1} }
}

\cs_new_protected:Npn \semio_viz_family_special: { \semio_viz_family_radar: }
