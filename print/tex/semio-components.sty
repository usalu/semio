%region PageNumbering
\cs_new_protected:Npn \semio_frontmatter_begin: {
  \renewcommand{\thepage}{\roman{page}}
  \use:c { semio@chrome@heading@set } { \SemioFrontmatterTitle }
}

% 📄 Recto-clear: for print binding every mainmatter/appendix start is forced
% onto a recto page, inserting a blank verso. Digital-only deliverables don't
% want those interior blanks — \SemioOpenAny{true} reduces this to a plain
% \clearpage (default stays recto so print workflows are unchanged).
\bool_new:N \g_semio_open_any_bool
\bool_gset_false:N \g_semio_open_any_bool
\NewDocumentCommand{\SemioOpenAny}{m}{
  \str_if_eq:nnTF {#1} {true}
    { \bool_gset_true:N \g_semio_open_any_bool }
    { \bool_gset_false:N \g_semio_open_any_bool }
}

\cs_new_protected:Npn \semio_clear_to_recto: {
  \clearpage
  \bool_if:NF \g_semio_open_any_bool {
    \legacy_if:nT { @twoside } {
      \int_if_even:nT { \value{page} } { \null\thispagestyle{empty}\newpage }
    }
  }
}

\cs_new_protected:Npn \semio_mainmatter_begin: {
  \semio_cover_geometry_restore:
  \semio_clear_to_recto:
  \setcounter{page}{1}
  \renewcommand{\thepage}{\arabic{page}}
  \use:c { semio@chrome@heading@set } { }
}

\NewDocumentCommand{\makemainmatter}{}{\semio_mainmatter_begin:}

\newcounter{semio@shippedpages}
\AddToHook{shipout/before}{\stepcounter{semio@shippedpages}}
% 📄 Signature padding: for print binding the document is padded with trailing
% empty pages up to a multiple of four. Digital-only deliverables don't want
% those blanks — \SemioSignaturePadding{false} disables the padding at the
% source (default stays true so print workflows are unchanged).
\bool_new:N \g_semio_signature_padding_bool
\bool_gset_true:N \g_semio_signature_padding_bool
\NewDocumentCommand{\SemioSignaturePadding}{m}{
  \str_if_eq:nnTF {#1} {false}
    { \bool_gset_false:N \g_semio_signature_padding_bool }
    { \bool_gset_true:N \g_semio_signature_padding_bool }
}
\AddToHook{enddocument}{
  \clearpage
  \legacy_if:nT { @twoside } {
    \bool_if:NT \g_semio_signature_padding_bool {
      \bool_while_do:nn { \int_compare_p:nNn { \int_mod:nn { \value{semio@shippedpages} + 1 } { 4 } } > { 0 } } {
        \null\thispagestyle{empty}\clearpage
      }
      \null\thispagestyle{empty}
    }
  }
}
%endregion PageNumbering

