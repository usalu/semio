\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-components}[2026/07/06 v0.1.0 semio document components]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-core}
\RequirePackage{semio-logo}
\RequirePackage{graphicx}
\RequirePackage{semio-table}
\RequirePackage{semio-window}

\ExplSyntaxOn

\bool_new:N \l_semio_cover@meta@row_bool
\bool_new:N \l_semio_cover@institution@row_bool

\cs_new_protected:Npn \semio_cover_address:n #1 {
  \group_begin:
  \ExplSyntaxOff
  \SemioSans
  \raggedright
  \setlength{\parindent}{0pt}%
  #1%
  \group_end:
}

\cs_new_protected:Npn \semio_maketitle: {
  \begin{titlepage}
    \semio_theme_apply:
    \centering
    \semioemblem[2.5cm]\par\vspace{\semio@spacing@double}
    {\SemioSans\LARGE\@title\par}
    \tl_if_empty:NTF \l_semio_subtitle_tl {} {{\large\tl_use:N \l_semio_subtitle_tl\par}}
    \vfill
    {\SemioSans\@author\par}
    {\SemioMono\@date\par}
    \tl_if_empty:NTF \l_semio_doi_tl {} {{\SemioMono DOI:~ \tl_use:N \l_semio_doi_tl\par}}
  \end{titlepage}
}

\RenewDocumentCommand{\maketitle}{}{\semio_maketitle:}

\NewDocumentCommand{\makecoverpages}{}{%
  \begin{titlepage}
    \semio_theme_apply:
    \centering
    \vfill
    \begin{Window}[title=Titel]
      {\SemioSans\Huge\@title\par}
      \tl_if_empty:NTF \l_semio_subtitle_tl {} {%
        \vspace{\semio@spacing@single}%
        {\large\tl_use:N \l_semio_subtitle_tl\par}%
      }
    \end{Window}
    \bool_set_false:N \l_semio_cover@meta@row_bool
    \tl_if_empty:NF \l_semio_aktenzeichen_tl { \bool_set_true:N \l_semio_cover@meta@row_bool }
    \tl_if_empty:NF \l_semio_foerderzeitraum_tl { \bool_set_true:N \l_semio_cover@meta@row_bool }
    \tl_if_empty:NF \l_semio_berichtszeitraum_tl { \bool_set_true:N \l_semio_cover@meta@row_bool }
    \bool_if:NT \l_semio_cover@meta@row_bool {
      \SemioWindowRowThree{%
        \begin{Window}[title=Aktenzeichen, row]
          {\SemioSans\tl_use:N \l_semio_aktenzeichen_tl\par}
        \end{Window}%
      }{%
        \begin{Window}[title=Förderzeitraum, row]
          {\SemioSans\tl_use:N \l_semio_foerderzeitraum_tl\par}
        \end{Window}%
      }{%
        \begin{Window}[title=Berichtszeitraum, row]
          {\SemioSans\tl_use:N \l_semio_berichtszeitraum_tl\par}
        \end{Window}%
      }
    }
    \tl_if_empty:NTF \l_semio_doi_tl {} {%
      \begin{Window}[title=DOI]
        {\SemioMono\tl_use:N \l_semio_doi_tl\par}
      \end{Window}%
    }
    \tl_if_empty:NTF \l_semio_kurzfassung_tl {} {%
      \begin{Window}[title=Beschreibung]
        {\SemioSans\small\tl_use:N \l_semio_kurzfassung_tl\par}
      \end{Window}%
    }
    \bool_set_false:N \l_semio_cover@institution@row_bool
    \tl_if_empty:NF \l_semio_antragstellendeinstitution_tl { \bool_set_true:N \l_semio_cover@institution@row_bool }
    \tl_if_empty:NF \l_semio_kooperationspartner_tl { \bool_set_true:N \l_semio_cover@institution@row_bool }
    \bool_if:NT \l_semio_cover@institution@row_bool {
      \SemioWindowRowTwo{%
        \begin{Window}[title=Antragstellende~Institution, row]
          \semio_cover_address:n { \tl_use:N \l_semio_antragstellendeinstitution_tl }
        \end{Window}%
      }{%
        \begin{Window}[title=Kooperationspartner, row]
          \semio_cover_address:n { \tl_use:N \l_semio_kooperationspartner_tl }
        \end{Window}%
      }
    }
    \SemioWindowRowThree{%
      \begin{Window}[title=Zukunft~Bau, row]
        \semio@logo@slot[\linewidth]{zukunftbau-logo.pdf}
      \end{Window}%
    }{%
      \begin{Window}[title=BBSR, row]
        \semio@logo@slot[\linewidth]{bbsr-logo.pdf}
      \end{Window}%
    }{%
      \begin{Window}[title=BBR, row]
        \semio@logo@slot[\linewidth]{bundesbauministerium-logo.pdf}
      \end{Window}%
    }
    \vfill
  \end{titlepage}
}

\NewDocumentCommand{\maketableofcontents}{o}{%
  \IfNoValueF{#1}{\setcounter{tocdepth}{#1}}%
  \tableofcontents
}

\NewDocumentCommand{\makefundingacknowledgement}{}{%
  \chapter*{Förderhinweis}
  \begin{Blockquote}
    Dieses Projekt wurde gefördert vom Bundesinstitut für Bau-, Stadt- und Raumforschung (BBSR) im Rahmen des Forschungsprogramms Zukunft Bau
  \end{Blockquote}
  \begin{Blockquote}
    The project was funded by the German Federal Institute for Research on Building, Urban Affairs and Spatial Development (BBSR) within the research programme Zukunft Bau
  \end{Blockquote}
}

\NewDocumentCommand{\makeworkpackages}{m}{%
  \section*{Arbeitspaketzuordnung}
  \begin{Table}[title=Netzwerk]
    #1
  \end{Table}
}

\NewDocumentCommand{\makeregisters}{}{%
  \listofimages
  \listofphotos
  \listoffigures
  \listoftables
  \listoflistings
  \listofpseudocodes
  \listoftheorems
  \listoflemmas
  \listofproofs
  \listofequations
  \listofglossaries
  \listofabbreviations
  \listofblockquotes
  \listofepigraphs
}

\cs_new_protected:Npn \semio_kompakt_draft_report: {
  \bool_if:NT \l_semio_kompakt_draft_bool {
    \typeout{[DEBUG] semio kompaktbericht draft: pages=\the\value{page} chars=\semio_char_count:}
  }
}

\newcount\semio@char@count
\cs_new_protected:Npn \semio_char_count: { \the\semio@char@count }

\AddToHook{enddocument/after}{\semio_kompakt_draft_report:}

\ExplSyntaxOff
