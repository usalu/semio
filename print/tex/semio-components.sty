\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-components}[2026/07/06 v0.1.0 semio document components]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-core}
\RequirePackage{semio-logo}
\RequirePackage{graphicx}
\RequirePackage{semio-table}
\RequirePackage{semio-window}

\ExplSyntaxOn

\bool_new:N \l_semio_cover@meta@row_bool
\bool_new:N \l_semio_cover@institution@row_bool
\bool_new:N \l_semio_is_zwischenbericht_bool
\seq_new:N \l_semio_title_seq
\tl_new:N \l_semio_clean_title_tl
\tl_new:N \l_semio_cover_institution_weight_tl
\tl_new:N \l_semio_cover_logo_weight_tl
\cs_generate_variant:Nn \seq_set_split:Nnn { Nnx }

\newcommand{\semio@cover@zukunftbau@logo}{zukunftbau-logo.pdf}
\newcommand{\semio@cover@bbsr@logo}{bbsr-logo.pdf}
\newcommand{\semio@cover@bundesministerium@logo}{bundesbauministerium-logo.pdf}
\newcommand{\semio@cover@arbeitsprobe@image}{}

\cs_new_protected:Npn \semio_cover_address:n #1 {
  \group_begin:
  \ExplSyntaxOff
  \SemioSans
  \setlength{\parindent}{0pt}%
  #1%
  \group_end:
}

%region PageNumbering
\cs_new_protected:Npn \semio_frontmatter_begin: {
  \renewcommand{\thepage}{\roman{page}}
  \use:c { semio@chrome@heading@set } { \SemioFrontmatterTitle }
}

\cs_new_protected:Npn \semio_clear_to_recto: {
  \clearpage
  \legacy_if:nT { @twoside } {
    \int_if_even:nT { \value{page} } { \null\thispagestyle{empty}\newpage }
  }
}

\cs_new_protected:Npn \semio_mainmatter_begin: {
  \semio_clear_to_recto:
  \setcounter{page}{1}
  \renewcommand{\thepage}{\arabic{page}}
  \use:c { semio@chrome@heading@set } { }
}

\NewDocumentCommand{\makemainmatter}{}{\semio_mainmatter_begin:}

\newcounter{semio@shippedpages}
\AddToHook{shipout/before}{\stepcounter{semio@shippedpages}}
\AddToHook{enddocument}{
  \clearpage
  \legacy_if:nT { @twoside } {
    \bool_while_do:nn { \int_compare_p:nNn { \int_mod:nn { \value{semio@shippedpages} + 1 } { 4 } } > { 0 } } {
      \null\thispagestyle{empty}\clearpage
    }
    \null\thispagestyle{empty}
  }
}
%endregion PageNumbering

\cs_new_protected:Npn \semio_maketitle: {
  \begin{titlepage}
    \semio_theme_apply:
    \centering
    \semioemblem[2.5cm]\par\vspace{\semio@spacing@double}
    {\SemioSans\LARGE\@title\par}
    \tl_if_empty:NTF \l_semio_subtitle_tl {} {{\large\tl_use:N \l_semio_subtitle_tl\par}}
    \vfill
    {\SemioSans\@author\par}
    {\SemioMono\@date\par}
    \tl_if_empty:NTF \l_semio_doi_tl {} {{\SemioMono DOI:~ \tl_use:N \l_semio_doi_tl\par}}
  \end{titlepage}
}

\RenewDocumentCommand{\maketitle}{}{\semio_maketitle:}

\NewDocumentCommand{\makecoverpages}{}{%
  \semio_frontmatter_begin:
  \clearpage
  \newgeometry{left=1.5cm, right=1.5cm, top=1.5cm, bottom=1.5cm}
  \begin{titlepage}
    \semio_theme_apply:
    \setlength{\semio@window@gap}{4pt}
    \bool_set_false:N \l_semio_cover@meta@row_bool
    \tl_if_empty:NF \l_semio_aktenzeichen_tl { \bool_set_true:N \l_semio_cover@meta@row_bool }
    \tl_if_empty:NF \l_semio_foerderzeitraum_tl { \bool_set_true:N \l_semio_cover@meta@row_bool }
    \tl_if_empty:NF \l_semio_berichtszeitraum_tl { \bool_set_true:N \l_semio_cover@meta@row_bool }
    \bool_set_false:N \l_semio_cover@institution@row_bool
    \tl_if_empty:NF \l_semio_antragstellendeinstitution_tl { \bool_set_true:N \l_semio_cover@institution@row_bool }
    \tl_if_empty:NF \l_semio_kooperationspartner_tl { \bool_set_true:N \l_semio_cover@institution@row_bool }
    \tl_set:Nn \l_semio_cover_institution_weight_tl { 3.3 }
    \tl_set:Nn \l_semio_cover_logo_weight_tl { 5.2 }
    \begin{WindowArrangement}[height=\textheight]
      \begin{WindowColumn}
        \cs_if_exist:cTF { zukunftbau@type } {
          \str_if_eq:eeTF { \use:c { zukunftbau@type } } { zwischenbericht } {
            \bool_set_true:N \l_semio_is_zwischenbericht_bool
            \tl_set:Nn \l_semio_cover_institution_weight_tl { 4 }
            \tl_set:Nn \l_semio_cover_logo_weight_tl { 6.5 }
            \seq_set_split:Nnx \l_semio_title_seq { --- } { \@title }
            \tl_set:Nx \l_semio_clean_title_tl { \seq_item:Nn \l_semio_title_seq { 2 } }
            \tl_trim_spaces:N \l_semio_clean_title_tl
            \tl_if_empty:NT \l_semio_clean_title_tl {
              \tl_set:Nn \l_semio_clean_title_tl { \@title }
            }
            \WindowItem[0.9]{
              \begin{WindowRow}
                \WindowItem{
                  \begin{Window}[title={Zukunft\ Bau}, anchor=center, text-size=fit]
                    \SemioSans Zwischenbericht
                  \end{Window}
                }
                \WindowItem{
                  \begin{Window}[title={Titel}, anchor=center, text-size=fit]
                    \SemioSans \tl_use:N \l_semio_clean_title_tl
                  \end{Window}
                }
              \end{WindowRow}
            }
            \WindowItem[1.15]{
              \begin{Window}[title={Untertitel}, anchor=center, text-size=fit]
                \SemioSans \tl_use:N \l_semio_subtitle_tl
              \end{Window}
            }
          } {
            \bool_set_false:N \l_semio_is_zwischenbericht_bool
            \WindowItem[1.8]{
              \begin{Window}[title={Titel}, anchor=center, text-size=fit]
                \SemioSans \@title
                \tl_if_empty:NTF \l_semio_subtitle_tl {} {%
                  \par\SemioSans \tl_use:N \l_semio_subtitle_tl
                }
              \end{Window}
            }
          }
        } {
          \bool_set_false:N \l_semio_is_zwischenbericht_bool
          \WindowItem[1.8]{
            \begin{Window}[title={Titel}, anchor=center, text-size=fit]
              \SemioSans \@title
              \tl_if_empty:NTF \l_semio_subtitle_tl {} {%
                \par\SemioSans \tl_use:N \l_semio_subtitle_tl
              }
            \end{Window}
          }
        }
        \tl_if_blank:eF { \semio@cover@arbeitsprobe@image } {
          \WindowItem[10.8]{
            \begin{Window}[title=Arbeitsprobe, anchor=center]
              \begin{minipage}[c]{\linewidth}
                \centering
                \includegraphics[
                  width=\linewidth,
                  height=\dimexpr\l_semio_window_pending_height_dim-\semio@chrome@titlebar@height
                    -\semio@chrome@padding-\semio@chrome@padding
                    -\semio@stroke@hairline-\semio@stroke@hairline
                  \relax,
                  keepaspectratio,
                ]{\semio@cover@arbeitsprobe@image}
              \end{minipage}
            \end{Window}
          }
        }
        \bool_if:NT \l_semio_cover@meta@row_bool {
          \WindowItem[1.05]{
            \begin{WindowRow}
              \WindowItem{
                \begin{Window}[title=Aktenzeichen, anchor=center, text-size=fit]
                  \SemioSans \tl_use:N \l_semio_aktenzeichen_tl
                \end{Window}
              }
              \WindowItem{
                \begin{Window}[title=Förderzeitraum, anchor=center, text-size=fit]
                  \SemioSans \tl_use:N \l_semio_foerderzeitraum_tl
                \end{Window}
              }
              \WindowItem{
                \begin{Window}[title=Berichtszeitraum, anchor=center, text-size=fit]
                  \SemioSans \tl_use:N \l_semio_berichtszeitraum_tl
                \end{Window}
              }
            \end{WindowRow}
          }
        }
        \tl_if_empty:NTF \l_semio_doi_tl {} {%
          \WindowItem[0.5]{
            \begin{Window}[title=DOI, anchor=center, text-size=fit]
              \SemioMono \tl_use:N \l_semio_doi_tl
            \end{Window}
          }
        }
        \bool_if:NF \l_semio_is_zwischenbericht_bool {
          \tl_if_empty:NTF \l_semio_kurzfassung_tl {} {%
            \WindowItem[2]{
              \begin{Window}[title=Beschreibung, anchor=center, text-size=fit]
                \SemioSans \tl_use:N \l_semio_kurzfassung_tl
              \end{Window}
            }
          }
        }
        \bool_if:NT \l_semio_cover@institution@row_bool {
          \WindowItem[\tl_use:N \l_semio_cover_institution_weight_tl]{
            \begin{WindowRow}
              \WindowItem{
                \begin{Window}[title=Antragstellende~Institution, anchor=center, text-size=fit]
                  \semio_cover_address:n { \tl_use:N \l_semio_antragstellendeinstitution_tl }
                \end{Window}
              }
              \WindowItem{
                \begin{Window}[title=Kooperationspartner, anchor=center, text-size=fit]
                  \semio_cover_address:n { \tl_use:N \l_semio_kooperationspartner_tl }
                \end{Window}
              }
            \end{WindowRow}
          }
        }
        \WindowItem[\tl_use:N \l_semio_cover_logo_weight_tl]{
          \begin{WindowRow}
            \WindowItem{
              \begin{Window}[title=BMWSB, anchor=center]
                \semio@logo@slot[\linewidth]{\semio@cover@bundesministerium@logo}
              \end{Window}
            }
            \WindowItem{
              \begin{Window}[title=BBSR, anchor=center]
                \semio@logo@slot[0.82\linewidth]{\semio@cover@bbsr@logo}
              \end{Window}
            }
            \WindowItem{
              \begin{Window}[title=Zukunft~Bau, anchor=center]
                \semio@logo@slot[\linewidth]{\semio@cover@zukunftbau@logo}
              \end{Window}
            }
          \end{WindowRow}
        }
      \end{WindowColumn}
    \end{WindowArrangement}
  \end{titlepage}
  \clearpage
  \restoregeometry
}

