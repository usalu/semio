\NewDocumentCommand{\makecoverpages}{}{%
  \semio_frontmatter_begin:
  \clearpage
  \newgeometry{left=1.5cm, right=1.5cm, top=1.5cm, bottom=1.5cm}
  \thispagestyle{empty}
  \bool_gset_true:N \g_semio_cover_geometry_bool
    \semio_theme_apply:
    \setlength{\parskip}{0pt}
    \bool_set_false:N \l_semio_cover@meta@row_bool
    \tl_if_empty:NF \l_semio_aktenzeichen_tl { \bool_set_true:N \l_semio_cover@meta@row_bool }
    \tl_if_empty:NF \l_semio_foerderzeitraum_tl { \bool_set_true:N \l_semio_cover@meta@row_bool }
    \tl_if_empty:NF \l_semio_berichtszeitraum_tl { \bool_set_true:N \l_semio_cover@meta@row_bool }
    \bool_set_false:N \l_semio_cover@institution@row_bool
    \tl_if_empty:NF \l_semio_antragstellendeinstitution_tl { \bool_set_true:N \l_semio_cover@institution@row_bool }
    \tl_if_empty:NF \l_semio_kooperationspartner_tl { \bool_set_true:N \l_semio_cover@institution@row_bool }
    \tl_set:Nn \l_semio_cover_institution_weight_tl { 3.3 }
    \tl_set:Nn \l_semio_cover_logo_weight_tl { 5.2 }
    \begin{WindowArrangement}[height=\dimexpr\textheight-1.2cm\relax]
      \begin{WindowColumn}
        \cs_if_exist:cTF { zukunftbau@type } {
          \str_if_eq:eeTF { \use:c { zukunftbau@type } } { zwischenbericht } {
            \bool_set_true:N \l_semio_is_zwischenbericht_bool
            \tl_set:Nn \l_semio_cover_institution_weight_tl { 6 }
            \tl_set:Nn \l_semio_cover_logo_weight_tl { 4 }
            \seq_set_split:Nnx \l_semio_title_seq { --- } { \@title }
            \tl_set:Nx \l_semio_clean_title_tl { \seq_item:Nn \l_semio_title_seq { 2 } }
            \tl_trim_spaces:N \l_semio_clean_title_tl
            \tl_if_empty:NT \l_semio_clean_title_tl {
              \tl_set:Nn \l_semio_clean_title_tl { \@title }
            }
            \WindowItem[0.9]{
              \begin{WindowRow}
                \WindowItem{
                  \begin{Window}[title={Zukunft\ Bau}, anchor=center, text-size=fit]
                    \SemioSans Zwischenbericht
                  \end{Window}
                }
                \WindowItem{
                  \begin{Window}[title={Titel}, anchor=center, text-size=fit]
                    \SemioSans \tl_use:N \l_semio_clean_title_tl
                  \end{Window}
                }
              \end{WindowRow}
            }
            \WindowItem[2.3]{
              \begin{Window}[title={Untertitel}, anchor=center, text-size=fit]
                \SemioSans \tl_use:N \l_semio_subtitle_tl
              \end{Window}
            }
          } {
            \bool_set_false:N \l_semio_is_zwischenbericht_bool
            \WindowItem[1.8]{
              \begin{Window}[title={Titel}, anchor=center, text-size=fit]
                \SemioSans \@title
                \tl_if_empty:NTF \l_semio_subtitle_tl {} {%
                  \par\SemioSans \tl_use:N \l_semio_subtitle_tl
                }
              \end{Window}
            }
          }
        } {
          \bool_set_false:N \l_semio_is_zwischenbericht_bool
          \WindowItem[1.8]{
            \begin{Window}[title={Titel}, anchor=center, text-size=fit]
              \SemioSans \@title
              \tl_if_empty:NTF \l_semio_subtitle_tl {} {%
                \par\SemioSans \tl_use:N \l_semio_subtitle_tl
              }
            \end{Window}
          }
        }
        \tl_if_blank:eF { \semio@cover@arbeitsprobe@image } {
          \WindowItem[10.3]{
            \begin{Window}[title=Arbeitsprobe, anchor=s]
              \begin{minipage}[c]{\linewidth}
                \centering
                \includegraphics[
                  width=\linewidth,
                  height=\dimexpr\l_semio_window_pending_height_dim-\semio@chrome@titlebar@height
                    -\semio@window@bodypad-\semio@window@bodypad
                    -\semio@stroke@hairline-\semio@stroke@hairline
                  \relax,
                  keepaspectratio,
                ]{\semio@cover@arbeitsprobe@image}
              \end{minipage}
            \end{Window}
          }
        }
        \bool_if:NT \l_semio_cover@meta@row_bool {
          \WindowItem[1.05]{
            \begin{WindowRow}
              \WindowItem{
                \begin{Window}[title=Aktenzeichen, anchor=center, text-size=fit]
                  \SemioSans \tl_use:N \l_semio_aktenzeichen_tl
                \end{Window}
              }
              \WindowItem{
                \begin{Window}[title=Förderzeitraum, anchor=center, text-size=fit]
                  \SemioSans \tl_use:N \l_semio_foerderzeitraum_tl
                \end{Window}
              }
              \WindowItem{
                \begin{Window}[title=Berichtszeitraum, anchor=center, text-size=fit]
                  \SemioSans \tl_use:N \l_semio_berichtszeitraum_tl
                \end{Window}
              }
            \end{WindowRow}
          }
        }
        \tl_if_empty:NTF \l_semio_doi_tl {} {%
          \WindowItem[0.5]{
            \begin{Window}[title=DOI, anchor=center, text-size=fit]
              \SemioMono \tl_use:N \l_semio_doi_tl
            \end{Window}
          }
        }
        \bool_if:NF \l_semio_is_zwischenbericht_bool {
          \tl_if_empty:NTF \l_semio_kurzfassung_tl {} {%
            \WindowItem[2]{
              \begin{Window}[title=Beschreibung, anchor=center, text-size=fit]
                \SemioSans \tl_use:N \l_semio_kurzfassung_tl
              \end{Window}
            }
          }
        }
        \bool_if:NT \l_semio_cover@institution@row_bool {
          \WindowItem[\tl_use:N \l_semio_cover_institution_weight_tl]{
            \begin{WindowRow}
              \WindowItem{
                \begin{Window}[title=Antragstellende~Institution, anchor=nw, text-size=fit]
                  \semio_cover_address:n { \tl_use:N \l_semio_antragstellendeinstitution_tl }
                \end{Window}
              }
              \WindowItem{
                \begin{Window}[title=Kooperationspartner, anchor=nw, text-size=fit]
                  \semio_cover_address:n { \tl_use:N \l_semio_kooperationspartner_tl }
                \end{Window}
              }
            \end{WindowRow}
          }
        }
        % LR-cover-logos: funder logos stay on page 1 with everything else. Their
        % weight is kept small so the Arbeitsprobe image above can take the
        % maximum remaining height (largest possible image while all cover
        % windows stay together on one page).
        \WindowItem[\tl_use:N \l_semio_cover_logo_weight_tl]{
          \begin{WindowRow}
            \WindowItem{
              \begin{Window}[title=BMWSB, anchor=center]
                \semio@logo@fit[\linewidth]{2.7cm}{\semio@cover@bundesministerium@logo}
              \end{Window}
            }
            \WindowItem{
              \begin{Window}[title=BBSR, anchor=center]
                \semio@logo@fit[0.82\linewidth]{2.7cm}{\semio@cover@bbsr@logo}
              \end{Window}
            }
            \WindowItem{
              \begin{Window}[title=Zukunft~Bau, anchor=center]
                \semio@logo@fit[\linewidth]{2.7cm}{\semio@cover@zukunftbau@logo}
              \end{Window}
            }
          \end{WindowRow}
        }
      \end{WindowColumn}
    \end{WindowArrangement}
  % Cover must occupy page 1 alone; Inhaltsverzeichnis starts on the next page
  % with restored body geometry (not the cover's tight 1.5cm margins).
  \semio_cover_geometry_restore:
}

