  % colspec flattened straight into the argument list via \exp_args:NV
  % throws the identical "Misplaced \omit" once a body row uses \multicolumn.
  \global\long\expandafter\def\expandafter\semio@table@long@colspec@current\expandafter{\l_semio_table_long_colspec_tl}
}
\ExplSyntaxOff

% 🩹 \semio@table@long@prepare (above) only fills the two "current" macros;
% the actual \semio@table@long@render call is plain TeX so the colspec can be
% expanded into the argument list the same way \SemioTableRegister does it
% (\expandafter{\semio@table@colspec@register@long}) — passing it as a bare
% macro reference like the head hits "Illegal pream-token", because array's
% preamble parser (unlike longtable's head/repeathead slots) never expands
% macro names on its own.
%
% 🩹 The leading [key=val] (e.g. [text-size=8pt]) uses the *kernel's* own
% \newcommand[n][default] optional-argument support, not xparse/ltcmd — that
% mechanism (\@protected@testopt/\@testopt/\@ifnextchar[) peeks for the `[`
% at the call site, at the main vertical list, before \begin{longtable} ever
% opens; the remaining 5 mandatory parameters are still grabbed by a plain
% \long\def exactly as before. It is unrelated to the ltcmd-argument-grabbing
% "Misplaced \omit" issue documented below on \SemioTableBandRow, so it does
% not reintroduce that break.
\newcommand{\SemioTableLong}[5][]{%
  \semio@table@keys@set{#1}%
  \semio@table@long@prepare{#3}{#4}%
  \semio@table@long@open{#2}%
  \expandafter\semio@table@long@render\expandafter{\semio@table@long@colspec@current}{\semio@table@long@head@current}{\semio@table@long@head@continuation@current}{#5}{\semio@table@long@column@count}%
  \semio@table@long@close
  \semio@table@keys@reset
}

% 🩹 Plain \newcommand, not \NewDocumentCommand/xparse: xparse's argument
% grabbing — even for all-mandatory arguments — breaks the same "Misplaced
% \omit" way once this macro's expansion contains \multicolumn (band rows
% span every column) inside this longtable. Plain TeX argument grabbing
% doesn't have that problem. For the same reason the image is mandatory
% (pass {} when a row has none) rather than an optional argument, and its
% \SemioImage call is unconditional — wrapping it in a conditional (\ifx,
% \tl_if_blank:nF, anything) reintroduces the same break even when the
% conditional's branches never touch \multicolumn at all; every project row
% in practice has an image, so this isn't a real limitation. A nested \\ for
% the title/meta line break has the same problem — colortbl's redefinition
% of \\ inside a \multicolumn cell conflicts with the table's own \\; use
% \newline instead, which stays a plain TeX primitive.
\newcommand{\SemioTableBandRow}[4]{%
  % #1 image path #2 colspan #3 title #4 meta
  \multicolumn{#2}{@{}>{\raggedright\arraybackslash\hspace{0pt}}p{\semio@table@long@inner@w}@{}}{%
    \cellcolor{semio-chrome-canvas}%
    \raisebox{-0.15\height}{\includegraphics[height=\dimexpr 2\semio@table@body@height\relax,keepaspectratio]{#1}}\hspace{\semio@chrome@padding}%
    \textbf{#3}\newline#4
  }%
  \\*\hline
}
%endregion GenericLongTable

