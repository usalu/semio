%region ProjectCatalogue
% 🏗️ Unified project-profile card — used ONLY by anhang/projekte.tex. Collapses
% the former quadruple (\subsection heading + Photo[Bild] + Table[Allgemein] +
% \SemioTableLong[Bauteile]) into ONE bordered longtable per project:
%   • title-chrome row  : project name (left) + P.K.x key (right)
%   • overview band row : photo spanning cols 1–2, metadata spanning cols 3–6
%   • component section : the six Bauteile columns + rows
% Reuses the shared \semio@table@long@render underneath (one continuous border,
% page-break header repeat). The title chrome is driven from the *section* key
% (\thesubsection → P.K.x), NOT from \begin{Table}'s `semiotable` counter, so no
% "Tabelle: P.K.x.b/c" number tabs are emitted. This region calls the shared
% primitives and defines only \semio@project@… / \SemioProject… names; it
% redefines nothing, so every other table in the report is untouched.

\newlength{\semio@project@bandheight}
\setlength{\semio@project@bandheight}{26mm}
% Photo cell inner width = cols 1+2 (0.28·inner) minus the outer chrome inset and
% the photo↔Spender boundary cell-pad, so the image's right edge lands exactly on
% the Spender column's left edge — alignment via the table grid, no coordinates.
% Photo multicolumn spans "|chrome@padding | photo | cellpad" = cols 1+2
% (chrome@padding + 0.28·inner), so photo width = 0.28·inner − cellpad and its
% right edge lands on the col-2/col-3 boundary = the Spender column's left edge.
% Metadata multicolumn spans "cellpad | meta | chrome@padding|" = cols 3–6, so
% meta width = 0.72·inner − cellpad and its text starts at Spender's text edge.
\newcommand{\semio@project@photow}{\dimexpr0.28\semio@table@long@inner@w-\semio@table@long@cellpad\relax}
\newcommand{\semio@project@metaw}{\dimexpr0.72\semio@table@long@inner@w-\semio@table@long@cellpad\relax}

% Continuous-fill colspec for the component section. Each cell gets a canvas
% \cellcolor, and every inter-column pad (plus the outer chrome inset) is a
% canvas-coloured \vrule of the SAME width as the pad it replaces — so the fill
% runs unbroken across the whole row with no cream stripes, and the geometry is
% identical to the standard builder. (Uses \color+\vrule rather than
% \columncolor, which misbehaves in this document's package stack.)
% Pad fills: interior gaps get one cellpad-wide canvas rule from each side (they
% abut → 2·cellpad, matching the two \hspace pads they replace); the two outer
% edges get one combined (chrome+cellpad)-wide rule so the fill reaches the
% border in a single stroke (no seam between abutting rules).
\newcommand{\semio@project@padcp}{{\color{semio-chrome-canvas}\vrule width \semio@table@long@cellpad}}
% Edge fills: a (chrome+cellpad)-wide canvas rule with a -cellpad kern, so the
% vrule starts one cellpad INSIDE the first/last cell (covering the cell↔pad seam)
% while the NET advance is only chrome@padding. padendL and padendR MUST stay
% symmetric: a wider +2cellpad vrule on either edge pushes that outer border a
% cellpad past \linewidth, so the border no longer lines up with the top rule and
% the flush-right P.K.x title tab — the tab then floats a cellpad inside the border
% (the "shifted tab" / broken top-right corner). At net chrome each side the whole
% card is exactly \linewidth wide and border, rule and tab all coincide.
\newcommand{\semio@project@padendL}{{\color{semio-chrome-canvas}\vrule width \dimexpr\semio@chrome@padding+\semio@table@long@cellpad\relax}\hspace{-\semio@table@long@cellpad}}
% Net advance chrome (not chrome+cellpad): the wider +2cellpad vrule pushed the
% right border one cellpad PAST where the horizontal rules end, so the top rule,
% the band↔component divider and every row separator stopped a cellpad short of
% the right border (an open top-right corner). At +cellpad the vrule still starts
% one cellpad inside the last cell (the \hspace{-cellpad}) so the fill reaches the
% border seamlessly, but the border now lands exactly where the rules end.
\newcommand{\semio@project@padendR}{\hspace{-\semio@table@long@cellpad}{\color{semio-chrome-canvas}\vrule width \dimexpr\semio@chrome@padding+\semio@table@long@cellpad\relax}}
% Data cells are vertically centred (m) with the same symmetric strut padding as
% every other table; the top strut rides in the cell-fill prefix, the bottom
% strut in each column's <{} slot.
\newcommand{\semio@project@cellfill}{\cellcolor{semio-chrome-canvas}\raggedright\arraybackslash\hspace{0pt}\semio@cell@struttop}
\newcommand{\semio@project@colspec}{%
|@{\semio@project@padendL}>{\semio@project@cellfill}m{\dimexpr0.18\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.10\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.26\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.12\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.17\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.17\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@project@padendR}|%
}

