\cs_new_protected:Npn \semio_table_long_header_build:nn #1#2 {
  \seq_set_split:Nnn \l_semio_table_row_seq { & } {#2}
  \tl_clear:N \l_semio_table_long_head_tl
  \int_zero:N \l_tmpa_int
  \seq_map_inline:Nn \l_semio_table_row_seq {
    \int_compare:nNnTF \l_tmpa_int = \c_zero_int {
      \tl_put_right:Nx \l_semio_table_long_head_tl {
        \exp_not:N \semio@table@long@header@left@cell
          { \clist_item:nn {#1} {1} }
          { ##1 }
      }
    } {
      \tl_put_right:Nn \l_semio_table_long_head_tl { & }
      \tl_put_right:Nx \l_semio_table_long_head_tl { \exp_not:N \semio@table@header@cell { ##1 } }
    }
    \int_incr:N \l_tmpa_int
  }
  % ?? No \exp_not:N here: \tl_put_right:Nn already stores its argument verbatim,
  % so the marker would survive into the head itself. TeX peeks past the \\ for
  % \noalign with an expanding read, and a \noexpand-shielded macro reads as an
  % ordinary token there ? the row opens first and the rule macro then runs inside
  % a cell ("Misplaced \noalign" / "Misplaced \omit" for the \hhline it replaced).
  \tl_put_right:Nn \l_semio_table_long_head_tl {
    \\
    \semio@table@long@hhline@current
  }
