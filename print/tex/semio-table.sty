  \int_zero:N \l_tmpa_int
  \clist_map_inline:nn {#1} {
    \int_compare:nNnTF \l_tmpa_int = \c_zero_int {
      \tl_put_right:Nn \l_semio_table_long_colspec_tl {
        >{\semio@table@long@cellfill}m{\dimexpr##1\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}
      }
    } {
