% Silent-but-registered project heading: steps the subsection counter (? P.K.x),
% writes the TOC/running-header/register entries and the \label, but draws no
% visible heading bar (the name is shown once, in the table's title-chrome row).
% Only the two visual chip renderers are blanked (inside a group); the hierarchy
% path ? consumed by the register ? is re-established explicitly afterwards.
\newcommand{\SemioProjectHeadingSilent}[2]{%
  \begingroup
    \long\def\semio@heading@pair@outline##1##2##3##4##5{}%
    \long\def\semio@heading@title@end@outline##1##2##3{}%
    \long\def\semio@heading@pair##1##2##3##4##5{}%
    \long\def\semio@heading@title@end##1##2##3{}%
    \subsection{#1}\label{#2}%
  \endgroup
  \@ifundefined{semio@hierarchy@path@set}{}{\semio@hierarchy@path@set{\thesubsection}}%
}

% Split the packed "ort & land & jahr & typ & status & quelle" metadata arg.
\def\semio@project@splitmeta#1&#2&#3&#4&#5&#6\relax{%
  \def\semio@project@ort{#1}\def\semio@project@land{#2}\def\semio@project@jahr{#3}%
  \def\semio@project@typ{#4}\def\semio@project@status{#5}\def\semio@project@quelle{#6}%
}

% Metadata subgrid (right of the photo): labelled fields, muted label / normal
% value. Ort/Stadt and Land are separate rows.
\newcommand{\semio@project@meta}[6]{%
  \begingroup
  \setlength{\extrarowheight}{0pt}%
  % Row pitch is INTENTIONALLY denser than the component body: that section uses
  % the airy symmetric-strut model (\semio@table@vtop/@vbot), but the band is a
  % compact 7-row key?value list where full strut air would balloon the 26mm band.
  % \arraystretch 1.2 is the deliberate compact rhythm; kept as a literal because
  % the strut tokens don't apply to this plain l l tabular.
  \renewcommand{\arraystretch}{1.2}%
  % Labels use the SAME synthetic-bold face as the component column headers. Anta
  % ships Regular only, so \bfseries is a no-op here; the headers get their weight
  % from the \SemioSansBold family (fontspec FakeBold, see semio-window.sty, where
  % \semio@table@header@cell is redefined to \SemioSansBold\semio@table@fontsize@apply).
  % Mirror that exactly in the label column so labels and headers share one face
  % and size. Values stay regular weight in the muted text colour.
  % Label?value gap sourced from the shared cell-pad token (2?\semio@table@long@cellpad
  % = the same width as every inter-column gap in the component body) instead of a
  % literal 1.2em, so it tracks the system's spacing. Purely horizontal ? the value
  % column shifts, the band height is unchanged.
  \begin{tabular}[t]{@{}>{\SemioSansBold\semio@table@fontsize@apply\color{semio-chrome-foreground}}l@{\hspace{2\semio@table@long@cellpad}}>{\color{semio-chrome-text-normal}}l@{}}
    Stadt & #1\tabularnewline
    Land & #2\tabularnewline
    Jahr & #3\tabularnewline
    Typ & #4\tabularnewline
    Status & #5\tabularnewline
    Quelle & #6\tabularnewline
  \end{tabular}%
  \endgroup
}

% Overview band row: photo multicolumn (cols 1?2) + metadata multicolumn (cols
% 3?8). Same padendL / padcp / padendR primitives as the component colspec, so the
% band is exactly \linewidth and the right-edge fill meets the border with no
% page-coloured strip (the old chrome-only bandpad left that gap when body pads
% moved to net chrome+cellpad).
%
% Photo: \semio@table@long@cellpad on all four sides (matches cell-text inset;
% left gap unchanged). Meta: toppad \semio@window@bodypad + \semio@cell@inset so
% Stadt stays in the Menge column. Both cells are \vtop-wrapped.
\newcommand{\semio@project@overview@band}[7]{%
  \multicolumn{2}{@{\semio@table@border@L}@{\semio@project@padendL}p{\semio@project@photow}@{\semio@project@padcp}}{%
    \cellcolor{semio-chrome-canvas}%
    % Photo inset matches cell text: \semio@table@long@cellpad on every side.
    % Left gap is already that pad — keep it. Equal top/bottom cellpads alone
    % still look uneven because row packing below the photo box is larger than
    % above (~array strut); \semio@project@photo@vbias shifts the photo down
    % inside the band (larger top pad, smaller bottom pad, same photo height)
    % so the visible gaps match without touching the meta cell (Stadt / Menge).
    \vtop{%
      \color{semio-chrome-canvas}%
      \hrule height\dimexpr\semio@table@long@cellpad+\semio@project@photo@vbias\relax depth\z@ width\dimexpr\linewidth\relax
      \nointerlineskip
      \hbox{%
        \hspace{\semio@table@long@cellpad}%
        \SemioProjectPhoto{#1}{\dimexpr\linewidth-2\semio@table@long@cellpad\relax}{\dimexpr\semio@project@bandheight-2\semio@table@long@cellpad\relax}%
      }%
      \nointerlineskip
      \hrule height\dimexpr\semio@table@long@cellpad-\semio@project@photo@vbias\relax depth\z@ width\dimexpr\linewidth\relax
    }%
  }%
  &
  \multicolumn{6}{@{}>{\raggedright\arraybackslash}p{\semio@project@metaw}@{\semio@project@padendR}@{\semio@table@border@R}}{%
    \cellcolor{semio-chrome-canvas}%
    \vtop{%
      \color{semio-chrome-canvas}%
      \hrule height\semio@window@bodypad depth\z@ width\dimexpr\linewidth\relax
      \nointerlineskip
      \hbox{%
        \begin{minipage}[t]{\linewidth}%
          \semio@cell@inset
          \semio@project@meta{#2}{#3}{#4}{#5}{#6}{#7}%
        \end{minipage}%
      }%
    }%
  }%
  \\*\semio@table@rule
}

\newcommand{\semio@project@headrow}{%
  \semio@table@header@cell{Bauteil} &
  \semio@table@header@cell{Neue Nutzung} &
  \semio@table@header@cell{Menge} &
  \semio@table@header@cell{Material} &
  \semio@table@header@cell{Quelle} &
  \semio@table@header@cell{ReUse-Ort} &
  \semio@table@header@cell{Herkunft $\rightarrow$ Ziel} &
  \semio@table@header@cell{Verfahren}\\
  \semio@table@long@hhline@current
  \noalign{\global\semio@table@row@startedfalse}%
}

% Non-breaking card render. A project card is at most ~8 component rows tall, so
% it always fits within one text column and never needs longtable's page-break /
% repeated-header machinery. Rendering it as a plain \tabular (an unbreakable box)
% means a card that does not fit in the space left on the page is carried to the
% next page AS ONE UNIT, at the inter-card glue. That removes the orphaned, EMPTY
% continuation head longtable stamps whenever \SemioCardKeep's soft \needspace
% break pushes a card after \begin{longtable} has already claimed the current page
% (the "two tables, one empty" artifact: a bare title + column-header band floats
% above the real card). Same setup, colspec, title chrome, band, header and rows
% as the longtable render ? only the outer container and the now-unnecessary
% firsthead/endhead slots differ.
\newcommand{\semio@project@render}[3]{% #1 colspec  #2 firsthead(band+header)  #3 rows
  \global\semio@table@long@mode=1\relax
  \global\semio@table@row@startedfalse
  \global\semio@table@headerfilltrue
  \gdef\semio@table@long@column@count{8}%
  \semio@table@long@rules@gset@project
  \par\addvspace{\semio@spacing@table@outer}%
  \begingroup
  \SemioSans
  \semio@table@fontsize@apply
  \semio@table@setup@long
  \color{semio-chrome-text-normal}%
  % Bare tabular card ? no tcolorbox frame; side \vrule borders stay on.
  \semio@table@owns@sidestrue
  \semio@table@long@inner@w@set
  \semio@table@long@title@chrome@prepare
  \ifvmode\nointerlineskip\fi
  \raggedright
  \noindent
  \begin{tabular}{#1}%
  \semio@table@long@continuation@chrome{8}%
  #2%
  \noalign{\vskip\z@}%
  #3%
  \end{tabular}%
  \endgroup
  \par\addvspace{\semio@spacing@table@outer}%
  \global\semio@table@long@mode=0\relax
  \global\semio@table@row@startedfalse
  \global\semio@table@headerfillfalse
}

\newcommand{\semio@project@long@render@call}[2]{%
  \semio@project@render{#1}{\semio@project@firsthead}{#2}%
}

% ?? The card's key chip is the project's hierarchy key, and
% \SemioProjectHeadingSilent has just registered a TOC line for it ? so it links
% back there like every other hierarchy key chip. This number reaches the title
% chrome raw rather than through \semio_kind_chip_number:nn, so both the link and
% the colour are attached here: the explicit \textcolor restates the muted tone
% \semio@heading@cap@muted@core applies anyway, which hyperref's colorlinks would
% otherwise override. Robust, because the key is carried to the chrome row
% through a \protected@edef and a further \edef before it is ever typeset.
\NewDocumentCommand \semio@project@key@chip { m } {%
  \semio@tocline@link{#1}{\textcolor{semio-chrome-text-normal}{#1}}%
}

% \SemioProject{name}{label}{image}{ort & land & jahr & typ & status & quelle}{rows}
\newcommand{\SemioProject}[5]{%
  \SemioCardKeep
  \SemioProjectHeadingSilent{#1}{#2}%
  \protected@edef\semio@project@key{\semio@project@key@chip{\thesubsection}}%
  \gdef\semio@window@header@title{#1}%
  \expandafter\semio@window@header@number@set\expandafter{\semio@project@key}%
  \semio@table@long@prepare{0.15,0.13,0.09,0.11,0.14,0.12,0.13,0.13}{Bauteil & Neue Nutzung & Menge & Material & Quelle & ReUse-Ort & Herkunft $\rightarrow$ Ziel & Verfahren}%
  \semio@project@splitmeta#4\relax
  % Cards with no documented components render band-only: the component column
  % header is dropped so no orphan header floats above an empty section.
  \def\semio@project@rows@arg{#5}%
  \ifx\semio@project@rows@arg\@empty
    \long\def\semio@project@firsthead{%
      \semio@project@overview@band{#3}%
        {\semio@project@ort}{\semio@project@land}{\semio@project@jahr}%
        {\semio@project@typ}{\semio@project@status}{\semio@project@quelle}%
    }%
  \else
    \long\def\semio@project@firsthead{%
      \semio@project@overview@band{#3}%
        {\semio@project@ort}{\semio@project@land}{\semio@project@jahr}%
        {\semio@project@typ}{\semio@project@status}{\semio@project@quelle}%
      \semio@project@headrow
    }%
  \fi
  \long\def\semio@project@head{\semio@project@headrow}%
  % Render with the project colspec (continuous canvas via \columncolor overhangs)
  % instead of the default one, so the fill runs through the whole table ? header
  % and every row ? with no cream gaps between columns.
  \expandafter\semio@project@long@render@call\expandafter{\semio@project@colspec}{#5}%
}
%endregion ProjectCatalogue
