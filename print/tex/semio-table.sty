}

\newcommand{\semio@table@long@title@chrome@prepare}{}

\newcommand{\semio@table@long@title@chrome@row@render}[2]{%
  % 🩹 Chrome spans the full table width with flush muted chips (no side
  % border slots, no shrink, no hairline pull). Body rows keep @{\border@L};
  % chip L then shares that same outer x. Phantom-L + hspace* pull still left a
  % ~0.5pt inset at the chip top-left (measured dark Zugang).
  \multicolumn{#1}{@{}l@{}}{%
    \begingroup
      \semio@window@header@flushtrue
      #2%
      \semio@window@header@flushfalse
    \endgroup
  }%
  \\%
  % Weld the next row onto the chip baseline. Without this pull, longtable /
  % tabular leaves a cream/page gap under the chips. Cancel only the \\ strut
  % (\extrarowheight + \dp\@arstrutbox). Do NOT also pull \lineskip or an
  % extra hairline ? that overlaps into the next row and eats project-band
  % toppad / cell struttop.
  \noalign{\vskip\dimexpr-\extrarowheight-\dp\@arstrutbox\relax}%
}

