\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-table}[2026/07/09 v1.1.0 semio data table styling]

\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{etoolbox}
\RequirePackage{longtable}
\RequirePackage{expl3}
\RequirePackage{semio-core}
\RequirePackage{semio-fonts}
% Fallback defs (semio-tokens.sty is generated and does not carry these);
% \providecommand is idempotent if semio-window.sty already defined them.
\providecommand{\semio@spacing@table@outer}{0.85em}
\providecommand{\semio@spacing@par}{0.5em}
% LR-cellpad: horizontal inset between cell content and every column boundary
% (outer borders and internal separators alike). ~1.5?2x the former values
% (short 0.4em / long 0.2em). Column widths are reduced to absorb it, so the
% table's total width is unchanged. One token drives short and long tables.
\providecommand{\semio@table@hpad}{0.55em}
\ExplSyntaxOn
\seq_new:N \l_semio_table_row_seq
\cs_new_protected:Npn \semio_table_header_row:n #1 {
  \seq_set_split:Nnn \l_semio_table_row_seq { & } {#1}
  \int_zero:N \l_tmpa_int
  \seq_map_inline:Nn \l_semio_table_row_seq {
    \int_compare:nNnF \l_tmpa_int = \c_zero_int { & }
    \semio@table@header@cell { ##1 }
    \int_incr:N \l_tmpa_int
  }
}
\NewDocumentCommand \SemioTableHeaderRow { m } {
  \semio_table_header_row:n {#1}
  \\
  \semio@table@row@sep
  \noalign{\global\semio@table@row@startedfalse}
}
\cs_new_protected:Npn \semio_table_dot_count_int:n #1 {
  \int_zero:N \l_tmpa_int
  \tl_map_inline:nn {#1} {
    \str_if_eq:nnT {##1} {.} { \int_incr:N \l_tmpa_int }
  }
}
\ExplSyntaxOff

\newcount\semio@table@dot@count
\def\semio@table@dot@sentinel{}
\newcommand{\semio@table@count@dots}[1]{%
  \semio@table@dot@count=0
  \semio@table@scan@dots#1\semio@table@dot@sentinel
}
\def\semio@table@scan@dots#1{%
  \ifx\semio@table@dot@sentinel#1\else
    \if.#1\advance\semio@table@dot@count1\fi
    \expandafter\semio@table@scan@dots
  \fi
}

\newcommand{\semio@table@register@indent}[1]{%
  \semio@table@count@dots{#1}%
  \dimen0=\semio@block@sep@skip
  \multiply\dimen0 by 2
  \multiply\dimen0 by \semio@table@dot@count
  \hspace{\dimen0}%
}

\newcommand{\semio@table@register@page}[1]{%
  \ifcsname r@#1\endcsname
    \getpagerefnumber{#1}%
  \else
    --%
  \fi
}

\newcommand{\SemioTableRegisterRow}[3]{%
  \SemioTableRow{%
    \cellcolor{semio-chrome-canvas}\semio@toc@number{#1} &
    \cellcolor{semio-chrome-canvas}{\semio@table@register@indent{#1}#2} &
    \cellcolor{semio-chrome-canvas}\semio@table@register@page{#3}
  }%
}

% ?? TOC cell linking to the section anchor (label #1) when it resolves, else
% the content #2 plain. Any \textcolor inside #2 overrides hyperref's colorlinks
% tint, so number/title keep their own hue while still being clickable.
\newcommand{\semio@toc@link}[2]{%
  \ifcsname r@#1\endcsname
    \hyperref[#1]{#2}%
  \else
    #2%
  \fi
}
% ?? TOC page cell: links the page number to the section anchor (label #1); the
% number is left uncoloured so it takes the semio-primary link colour like the
% glossary, or renders "--" when the ref is unresolved.
\newcommand{\semio@toc@page@link}[1]{%
  \ifcsname r@#1\endcsname
    \hyperref[#1]{\getpagerefnumber{#1}}%
  \else
    --%
  \fi
}

% ?? The number cell also carries this line's own anchor (\semio@tocline@anchor,
% semio-core.sty), so the hierarchy key chip printed next to the heading itself
% can jump back here. Placed after \cellcolor, which colortbl requires first.
\newcommand{\SemioTableTocRow}[3]{%
  \SemioTableRow{%
    \cellcolor{semio-chrome-canvas}\semio@tocline@anchor{#1}\semio@toc@link{#3}{\mbox{\semio@toc@number{#1}}} &
    \cellcolor{semio-chrome-canvas}\semio@toc@link{#3}{\textcolor{semio-chrome-text-normal}{#2}} &
    \cellcolor{semio-chrome-canvas}\semio@toc@page@link{#3}
  }%
}

\newlength{\semio@table@header@height}
\newlength{\semio@table@body@height}
\newif\ifsemio@table@row@started
\newcount\semio@table@long@mode
\newcount\semio@table@long@part
\newif\ifsemio@table@long@pageparts

% ?? Adjustable table body text size, mirroring the window `text-size`
% keyval (semio-window.sty) so `\begin{Table}[text-size=8pt]` and
% `\SemioTableLong[text-size=8pt]{...}` both work. Precedence: an explicit
% table-local size wins over an enclosing window's `text-size`, which wins
% over the fixed chrome body size. \l_semio_window_textsize_*  is only
% *referenced* here, not declared ? semio-window.sty loads after
% semio-table.sty, but this body only runs at document time, long after
% both packages are loaded.
\ExplSyntaxOn
\dim_new:N \l_semio_table_textsize_dim
\bool_new:N \l_semio_table_textsize_set_bool
\tl_new:N \l_semio_table_key_tl
\keys_define:nn { semio / table } {
  text-size .code:n = {
    \dim_set:Nn \l_semio_table_textsize_dim {#1}
    \bool_set_true:N \l_semio_table_textsize_set_bool
  },
  key .tl_set:N = \l_semio_table_key_tl,
}
% Named the plain (legacy) way, not \semio_table_keys_set:n ? these get
% called from \SemioTableLong's body, which is a plain \newcommand written
% where `_`/`:` are ordinary (non-letter) characters, so an expl3-style name
% would not tokenize as one control word there (see the identical rationale
% on \semio@table@long@prepare below).
\cs_new_protected:Npn \semio@table@keys@set #1 {
  \tl_clear:N \l_semio_table_key_tl
  \keys_set:nn { semio / table } {#1}
}
\cs_new_protected:Npn \semio@table@keys@reset {
  \bool_set_false:N \l_semio_table_textsize_set_bool
  \tl_clear:N \l_semio_table_key_tl
}
\cs_new_protected:Npn \semio@table@fontsize@apply {
  \bool_if:NTF \l_semio_table_textsize_set_bool
    { \tl_set:Nx \l_tmpa_tl { \dim_use:N \l_semio_table_textsize_dim } }
    {
      \bool_if:NTF \l_semio_window_textsize_set_bool
        { \tl_set:Nx \l_tmpa_tl { \dim_use:N \l_semio_window_textsize_dim } }
        { \tl_set:Nx \l_tmpa_tl { \semio@chrome@font@body } }
    }
  \fontsize{\tl_use:N \l_tmpa_tl}{\tl_use:N \l_tmpa_tl}\selectfont
}
\ExplSyntaxOff

\newcommand{\semio@table@setup}{%
  \setlength{\semio@table@header@height}{\dimexpr
    \semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit
    +\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit
  \relax}%
  \setlength{\semio@table@body@height}{\dimexpr
    \semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit
    +\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit
  \relax}%
  \global\semio@table@row@startedfalse
  \arrayrulecolor{semio-chrome-border-normal}%
  \setlength{\arrayrulewidth}{\semio@stroke@hairline}%
  % ?? Roomier cells: horizontal via \tabcolsep (colspecs subtract \tabcolsep,
  % so table width is preserved). Vertical padding is NOT done here with
  % \extrarowheight/\arraystretch (those are top-heavy and content-dependent);
  % it is handled symmetrically per cell by the \semio@cell@struttop /
  % \semio@cell@strutbot pair baked into the T/U/m columns, so top gap = bottom
  % gap in every cell and the value is identical across all table types. Hence
  % \extrarowheight is zeroed and \arraystretch is 1 here. \parskip is
  % neutralised so a multi-line cell doesn't inherit the body paragraph gap.
  % Horizontal inset is baked into column widths (-2\semio@table@hpad); zero
  % \tabcolsep so adjacent \cellcolor cells abut with no cream seam between them.
  \setlength{\semio@table@long@cellpad}{\semio@table@hpad}%
  \setlength{\tabcolsep}{0pt}%
  \setlength{\extrarowheight}{\z@}%
  \renewcommand{\arraystretch}{1}%
  \setlength{\parskip}{\z@}%
}

% LR-cellpad: columns split \linewidth evenly and carry their text inset inside
% the cell (\semio@cell@inset); \tabcolsep is zero so canvas \cellcolor regions
% touch with no inter-column cream seam.
\newcommand{\semio@table@colspec@two}{T{\dimexpr0.5\linewidth\relax}T{\dimexpr0.5\linewidth\relax}}

\newlength{\semio@table@long@inner@w}
\newbox\semio@table@long@pad@box
% Per-column inner padding for long tables (each column gets this much air on
% both sides ? 2? between adjacent columns). Column p-widths are reduced by
% 2? this, so the total still equals \semio@table@long@inner@w (no overflow).
\newlength{\semio@table@long@cellpad}

% When true, the table paints its own L/R \vrule borders and inner width
% reserves 2\times\arrayrulewidth for them. When false (windowed short tables),
% the enclosing tcolorbox frame owns the sides ? subtracting those hairlines
% would leave a page-coloured gutter inside the frame.
\newif\ifsemio@table@owns@sides
\semio@table@owns@sidestrue

\newcommand{\semio@table@long@inner@w@set}{%
  \setbox\semio@table@long@pad@box=\hbox{\hspace{\semio@chrome@padding}}%
  \ifsemio@table@owns@sides
    \setlength{\semio@table@long@inner@w}{%
      \dimexpr\linewidth-2\wd\semio@table@long@pad@box-2\arrayrulewidth\relax
    }%
  \else
    \setlength{\semio@table@long@inner@w}{%
      \dimexpr\linewidth-2\wd\semio@table@long@pad@box\relax
    }%
  \fi
  \setlength{\semio@table@long@cellpad}{\semio@table@hpad}%
}

\newcommand{\semio@table@setup@long}{%
  \semio@table@setup
  \setlength{\tabcolsep}{0pt}%
  % Vertical padding comes from the symmetric cell struts (same as short
  % tables) ? no separate \extrarowheight here, so long/short match exactly.
}

% Continuous canvas fill at the outer chrome inset. Cell text inset lives inside
% each cell (\semio@cell@inset in the cellfill), so interior \semio@table@padcp
% is empty and adjacent \cellcolor regions abut.
% The outer chrome slots MUST be canvas-coloured \vrule pads ? plain \hspace
% leaves a page-coloured strip between the last cell's \cellcolor and the
% border (measured ~1.5pt = \semio@chrome@padding on every table type).
\newcommand{\semio@table@padcp}{}
\newcommand{\semio@table@padendL}{{\color{semio-chrome-canvas}\vrule width \semio@chrome@padding}}
\newcommand{\semio@table@padendR}{{\color{semio-chrome-canvas}\vrule width \semio@chrome@padding}}
% Outer table side rules as @{} inserts (not preamble | tokens). Array | rules
% intersect \hhline and paint short horizontal ticks on every vertical at row
% boundaries; border-colored \vrule inserts do not. Omitted when the enclosing
% window frame already owns the sides (\ifsemio@table@owns@sidesfalse).
% Ungrouped coloured \vrule (not {\color...\vrule} and not \vline): braces
% pack the rule to natural height on tall m-rows; colortbl's \vline can do
% the same via \color@begingroup. A stretchable \vrule with colour set via
% \color before it fills the row box; padend/cellfill restore their own
% colours immediately after.
\newcommand{\semio@table@border@L}{%
  \ifsemio@table@owns@sides
    \color{semio-chrome-border-normal}\vrule width\arrayrulewidth
    \color{semio-chrome-text-normal}%
  \fi
}
\newcommand{\semio@table@border@R}{%
  \ifsemio@table@owns@sides
    \color{semio-chrome-border-normal}\vrule width\arrayrulewidth
    \color{semio-chrome-text-normal}%
  \fi
}
% Chrome-row right edge: width phantom only (no ink). A full-height border@R
% here becomes a vertical stem in the air on title-only chrome (TOC / glossary
% ? no number chip). When a number chip exists it already paints its own right
% wall via the muted open cap; body rows supply border@R below the baseline.
\newcommand{\semio@table@border@R@chrome}{%
  \vrule width\arrayrulewidth height\z@ depth\z@
}
% Chrome-row left edge: same phantom. A live border@L behind the title chip
% hid a 1-device-pixel inset of the chip's own left stroke (outer L looked flush
% because border@L ink was continuous, but the chip top-left corner sat inside
% ? tiny gap/jog). Body rows still paint \semio@table@border@L; the muted chip
% paints L only in the chrome band, pulled onto the same x.
\newcommand{\semio@table@border@L@chrome}{%
  \vrule width\arrayrulewidth height\z@ depth\z@
}

\newcommand{\semio@table@colspec@register@long}{@{\semio@table@border@L}@{\semio@table@padendL}>{\semio@table@long@cellfill}m{\dimexpr0.12\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}>{\semio@table@long@cellfill}m{\dimexpr0.78\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}>{\semio@table@long@cellfillR}m{\dimexpr0.10\semio@table@long@inner@w\relax}<{\semio@register@lastclose}@{\semio@table@padendR}@{\semio@table@border@R}}

\newcommand{\semio@table@colspec@glossary@long}{@{\semio@table@border@L}@{\semio@table@padendL}>{\semio@table@long@cellfill}m{\dimexpr0.22\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}>{\semio@table@long@cellfill}m{\dimexpr0.56\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}>{\semio@table@long@cellfillR}m{\dimexpr0.22\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@table@padendR}@{\semio@table@border@R}}

% ?? Symmetric vertical cell padding. Cells are vertically centred (m-columns);
% every cell also carries an invisible strut pair that reserves \semio@table@vtop
% above its first line and \semio@table@vbot below its last line. One pair of
% tokens drives EVERY table (short, long, register, glossary, project), so the
% padding is identical everywhere; values are em-relative so they track each
% table's text-size.
%
% Why a top value ? bottom value: an m-column centres the whole cell box on the
% math axis, and a text line box is ascender-heavy (cap ? 0.7em up, descender
% ? 0.2em down). Making \vtop about 0.66em larger than \vbot cancels that skew,
% so the *visible* top margin (top rule ? cap) equals the *visible* bottom
% margin (baseline/descender ? bottom rule). Both are then tuned to ? the
% horizontal inset (\semio@table@hpad + frame gap ? 5.5pt at the 9.6pt chrome
% body size) ? text sits the same distance from all four cell borders. Measured
% on the rendered PDF: cap?toprule ? 5.8pt, matching the ?5.5pt side inset.
\providecommand{\semio@table@vtop}{1.78em}
\providecommand{\semio@table@vbot}{1.12em}
% Exception: the register/TOC listing (Inhaltsverzeichnis) opts into HALF the
% vertical padding ? it is a dense, single-line index where the full data-table
% air reads as too loose. These are applied by locally \renewcommand-ing
% \semio@table@vtop/@vbot to these values around ONLY the main TOC render (see
% \semio_window_toc_render: in semio-window.sty); every other table, including
% the appendix list and glossaries, keeps the full padding. Kept symmetric the
% same way (vtop-vbot ? 0.7em cancels the ascender-heavy line box): measured
% cap?toprule ? 2.9pt, ? half of the standard 5.8pt.
\providecommand{\semio@table@vtop@toc}{1.40em}
\providecommand{\semio@table@vbot@toc}{0.70em}
% Top strut: zero-width rule that only sets the first line's height (no depth,
% so interline spacing in multi-line cells is untouched).
\newcommand{\semio@cell@struttop}{\rule[\z@]{\z@}{\semio@table@vtop}}
% Bottom strut: zero-width rule that only sets the last line's depth. LaTeX's
% \rule[raise]{width}{height} expands to a \vrule of height (height+raise) and
% depth (-raise), so the height argument MUST equal the raise magnitude, not
% \z@. With height=\z@ the vrule got a NEGATIVE height and contributed no
% reliable depth; m-columns then \vcenter-ed an ascender-only box and every
% single-line row (Huerden, Ueberblick, ...) read as top-heavy with a large empty
% band under the text. Height=vbot yields height 0 / depth vbot -- a pure depth
% strut, the mirror of \semio@cell@struttop. The leading zero glue is the
% counterpart of the one in \semio@cell@pre / the cellfills: TeX hyphenates a
% run of letters only when it is BOTH preceded and followed by glue, and this
% strut is a \rule that would otherwise butt straight against the cell's last
% word, so a single-word cell ("Faserzement", "Pfostenelement") never
% hyphenated and ran over the column edge. Discardable at a line break, zero
% width on the last line, so it changes nothing else.
\newcommand{\semio@cell@strutbot}{\hspace{0pt}\rule[-\semio@table@vbot]{\z@}{\semio@table@vbot}}
% Last-column closer for the register colspec (below). Kept as a named
% indirection so a future register table could close its right-aligned page
% column differently without editing the colspec.
\newcommand{\semio@register@lastclose}{\semio@cell@strutbot}
% ?? Horizontal cell inset, one cellpad on BOTH edges of EVERY line. Column
% widths are the full fraction of the table's inner width and the interior pads
% are empty (\semio@table@padcp), so the inset has to come from the paragraph
% shape rather than from glue in the cell's token stream: an \hspace at the start
% of a cell indents only its first line and one at the end only its last, which
% leaves every wrapped line flush against both column edges ? a long word then
% sits directly beside the neighbouring column's text and reads as if it left the
% table. \advance (not =) keeps the fil component \raggedright / \raggedleft put
% into the skip it stretches, so the alignment those set is preserved and the
% wrap width shrinks by exactly 2 cellpad on every line.
\newcommand{\semio@cell@inset}{%
  \advance\leftskip\semio@table@long@cellpad\relax
  \advance\rightskip\semio@table@long@cellpad\relax
}
% Unified cell openers: alignment + top strut + no-indent glue. The matching
% bottom strut goes in the column's <{} slot.
% ?? Hyphenation: the \hspace{0pt} glue MUST come *after* \semio@cell@struttop,
% not before it. TeX only hyphenates a run of letters that is immediately
% preceded by glue; \semio@cell@struttop is a \rule, so with the glue before it
% the first word of the cell sits directly after a rule and never hyphenates ?
% a long compound ("Beschaffungsschritte", "Mitgliedschaft") then overflows a
% narrow column and collides with the next one. Emitting the strut first and the
% zero glue last restores the "word preceded by glue" precondition (see the
% Hyphenation Safety note in semio-core.sty). The strut still sets the first
% line's height either way; the glue is zero-width, so nothing shifts visually.
\newcommand{\semio@cell@pre}{\cellcolor{semio-chrome-canvas}\raggedright\arraybackslash\semio@cell@inset\semio@cell@struttop\hspace{0pt}}
\newcommand{\semio@table@long@cellfill}{%
  \cellcolor{semio-chrome-canvas}%
  \raggedright\hyphenpenalty=50\exhyphenpenalty=50\emergencystretch=1.2em\arraybackslash\semio@cell@inset\semio@cell@struttop\hspace{0pt}%
}
\let\semio@table@long@cellfill@first\semio@table@long@cellfill
\newcommand{\semio@table@long@cellfillR}{%
  \cellcolor{semio-chrome-canvas}%
  \raggedleft\hyphenpenalty=50\exhyphenpenalty=50\emergencystretch=1.2em\arraybackslash\semio@cell@inset\semio@cell@struttop\hspace{0pt}%
}
\newcolumntype{T}[1]{%
  >{\semio@table@long@cellfill}%
  m{#1}%
  <{\semio@cell@strutbot}%
}

% No \cellcolor here: the column's >{\semio@table@long@cellfill} (or
% \semio@cell@pre) already paints the canvas. A second \cellcolor after
% \semio@cell@struttop was collapsing the header row's top strut, so column
% labels sat ~3.5pt under the chip baseline while body rows kept the full
% ~7.5pt air (measured on Huerden / BB.M.a vs body).
\newcommand{\semio@table@header@cell}[1]{%
  \SemioSans\semio@table@fontsize@apply
  \semio@text@emphasized{\bfseries #1}%
}

\newcommand{\semio@table@short@hhline@current}{}
\newif\ifsemio@table@window@rules
% Row separator. Side \vrule segments live only inside row boxes and do not
% extend through \noalign — the join band must therefore carry border ink at
% the L/R x-positions or cream shows through as a notch at every row.
%
% owns@sides mid-rule is a single picture-frame hbox: L stub | inner hairline |
% R stub. The stubs span only the join band (no +3pt climb into the row
% above). Full-width \hrule + overlapping upward pillars double-painted the
% outer L/R x and read as stacked "tiny" segments / jogs at fractional PDF
% zoom; an earlier hbox+extra-pillar pass also stacked a second hairline under
% longtable \endhead reinsertion — keep ONE hbox, no follow-up pillar pass.
%
% Windowed short tables: the tcolorbox leftrule/rightrule is the sole
% continuous outer edge. Mid-rules stay exactly \linewidth so they meet the
% INNER face of that frame.
\newcommand{\semio@table@rule@band}{%
  \hbox to \linewidth{%
    \vrule width\arrayrulewidth height\arrayrulewidth depth\z@
    \rule{\dimexpr\linewidth-2\arrayrulewidth\relax}{\arrayrulewidth}%
    \vrule width\arrayrulewidth height\arrayrulewidth depth\z@
  }%
}
\newcommand{\semio@table@rule}{%
  \noalign{%
    \begingroup
      \color{semio-chrome-border-normal}%
      \ifsemio@table@owns@sides
        \semio@table@rule@band
      \else
        \hrule height\arrayrulewidth width\linewidth
      \fi
    \endgroup
  }%
}
\newcommand{\semio@table@row@sep}{%
  \semio@table@rule
}

%region LongTableHeader
% Canvas-fill switch for fully-canvas long tables (register/glossary and
% \SemioTableLong). When set, the header's first cell (a \multicolumn) uses the
% same canvas \vrule pads and geometry as the body columns, so the header row
% fills seamlessly too.
\newif\ifsemio@table@headerfill
\semio@table@headerfillfalse
\newcommand{\semio@table@long@header@left@cell}[2]{%
  \ifsemio@table@headerfill
    % Structurally identical to a body col-1: canvas edge fill + width-2cellpad +
    % two canvas pads bridging to col-2, so the header title aligns with the body
    % cells AND the fill is continuous.
    \multicolumn{1}{@{\semio@table@border@L}@{\semio@table@padendL}>{\semio@table@long@cellfill}m{\dimexpr#1\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}}{%
      \semio@table@header@cell{#2}%
    }%
  \else
    \multicolumn{1}{|@{\hspace{\semio@chrome@padding}}@{}>{\semio@cell@pre}m{\dimexpr#1\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{}}{%
      \semio@table@header@cell{#2}%
    }%
  \fi
}

\newcommand{\semio@table@long@header@repeat@three}[4]{%
  \semio@table@long@header@left@cell{#1}{#2} &
  \semio@table@header@cell{#3} &
  \semio@table@header@cell{#4} \\
  \semio@table@long@hhline@current
  % Reset in \noalign: a bare \global assignment here sits *between* the \hhline
  % and \endfirsthead outside any row, so array's row scanner reads it as the
  % start of a new cell ? opening an empty, strut-height phantom row (a cream
  % band, unfilled by the header cellcolor) between the header and the first
  % entry. \noalign executes it on the row boundary without starting that row.
  \noalign{\global\semio@table@row@startedfalse}%
}

\newcommand{\semio@table@long@header@continuation@three}[4]{%
  \semio@table@long@header@left@cell{#1}{#2} &
  \semio@table@header@cell{#3} &
  \semio@table@header@cell{#4} \\
