        @{\semio@table@padcp}@{\semio@table@padcp}>{\semio@table@long@cellfill}m{\dimexpr##1\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}
      }
    }
    \int_incr:N \l_tmpa_int
  }
  \tl_put_right:Nn \l_semio_table_long_colspec_tl { @{\semio@table@padendR}@{\semio@table@border@R} }
