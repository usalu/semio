%region ProjectCatalogue
% ??? Unified project-profile card ? used ONLY by anhang/projekte.tex. Collapses
% the former quadruple (\subsection heading + Photo[Bild] + Table[Allgemein] +
% \SemioTableLong[Bauteile]) into ONE bordered longtable per project:
%   ? title-chrome row  : project name (left) + P.K.x key (right)
%   ? overview band row : photo spanning cols 1?2, metadata spanning cols 3?6
%   ? component section : the six Bauteile columns + rows
% Reuses the shared \semio@table@long@render underneath (one continuous border,
% page-break header repeat). The title chrome is driven from the *section* key
% (\thesubsection ? P.K.x), NOT from \begin{Table}'s `semiotable` counter, so no
% "Tabelle: P.K.x.b/c" number tabs are emitted. This region calls the shared
% primitives and defines only \semio@project@? / \SemioProject? names; it
% redefines nothing, so every other table in the report is untouched.

\newlength{\semio@project@bandheight}
\setlength{\semio@project@bandheight}{26mm}
% Half the residual top/bottom packing mismatch outside the photo box, so
% cellpad top+bottom pads still read visually even (same idea as text cells'
% asymmetric \semio@table@vtop/@vbot strut pair).
\newcommand{\semio@project@photo@vbias}{\dimexpr0.35\semio@table@long@cellpad+0.2pt\relax}
% Photo / meta widths match the shared padend geometry (net chrome+cellpad each
% edge, same as \semio@table@padendL/R). Photo spans cols 1?2:
%   padendL + (0.28?inner ? 2?cellpad) + padcp  =  chrome + 0.28?inner
% Meta spans cols 3?8:
%   (0.72?inner ? cellpad) + padendR  =  chrome + 0.72?inner
% so band + body share one \linewidth card with no right-edge cream/page gap.
\newcommand{\semio@project@photow}{\dimexpr0.28\semio@table@long@inner@w\relax}
\newcommand{\semio@project@metaw}{\dimexpr0.72\semio@table@long@inner@w\relax}

% Continuous-fill colspec for the component section. Same pad primitives as every
% other canvas-filled long table (\semio@table@padcp / padendL / padendR): interior
% gaps get one cellpad-wide canvas rule from each side; outer edges net
% chrome+cellpad so the fill reaches the border and the card is exactly
% \linewidth (matching \semio@table@rule and the P.K.x title tab). The older
% project-only "net chrome" edge pads left a page-coloured strip inside the right
% border because body width was 2?cellpad short of \linewidth while the band
% multicolumns were full width.
\newcommand{\semio@project@padcp}{\semio@table@padcp}
\newcommand{\semio@project@padendL}{\semio@table@padendL}
\newcommand{\semio@project@padendR}{\semio@table@padendR}
% Data cells are vertically centred (m) with the same symmetric strut padding as
% every other table; the top strut rides in the cell-fill prefix, the bottom
% strut in each column's <{} slot.
\newcommand{\semio@project@cellfill}{\cellcolor{semio-chrome-canvas}\raggedright\hyphenpenalty=50\exhyphenpenalty=50\emergencystretch=1.2em\arraybackslash\semio@cell@inset\semio@cell@struttop\hspace{0pt}}
\newcommand{\semio@project@colspec}{%
@{\semio@table@border@L}@{\semio@project@padendL}>{\semio@project@cellfill}m{\dimexpr0.15\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.13\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.09\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.11\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.14\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.12\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.13\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}m{\dimexpr0.13\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{\semio@project@padendR}@{\semio@table@border@R}%
}

