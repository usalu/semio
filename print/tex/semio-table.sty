\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-table}[2026/07/09 v1.1.0 semio data table styling]

\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{longtable}
\RequirePackage{expl3}
\RequirePackage{semio-core}
\RequirePackage{semio-fonts}

\ExplSyntaxOn
\seq_new:N \l_semio_table_row_seq
\cs_new_protected:Npn \semio_table_header_row:n #1 {
  \seq_set_split:Nnn \l_semio_table_row_seq { & } {#1}
  \int_zero:N \l_tmpa_int
  \seq_map_inline:Nn \l_semio_table_row_seq {
    \int_compare:nNnF \l_tmpa_int = \c_zero_int { & }
    \semio@table@header@cell { ##1 }
    \int_incr:N \l_tmpa_int
  }
}
\NewDocumentCommand \SemioTableHeaderRow { m } {
  \semio_table_header_row:n {#1}
  \\
  \hline
  \global\semio@table@row@startedfalse
}
\cs_new_protected:Npn \semio_table_dot_count_int:n #1 {
  \int_zero:N \l_tmpa_int
  \tl_map_inline:nn {#1} {
    \str_if_eq:nnT {##1} {.} { \int_incr:N \l_tmpa_int }
  }
}
\ExplSyntaxOff

\newcount\semio@table@dot@count
\def\semio@table@dot@sentinel{}
\newcommand{\semio@table@count@dots}[1]{%
  \semio@table@dot@count=0
  \semio@table@scan@dots#1\semio@table@dot@sentinel
}
\def\semio@table@scan@dots#1{%
  \ifx\semio@table@dot@sentinel#1\else
    \if.#1\advance\semio@table@dot@count1\fi
    \expandafter\semio@table@scan@dots
  \fi
}

\newcommand{\semio@table@register@indent}[1]{%
  \semio@table@count@dots{#1}%
  \dimen0=\semio@block@sep@skip
  \multiply\dimen0 by 2
  \multiply\dimen0 by \semio@table@dot@count
  \hspace{\dimen0}%
}

\newcommand{\SemioTableRegisterRow}[3]{%
  \SemioTableRow{%
    #1 &
    {\semio@table@register@indent{#1}#2} &
    \ifcsname r@#3\endcsname \pageref{#3}\else --\fi
  }%
}

\newlength{\semio@table@header@height}
\newlength{\semio@table@body@height}
\newif\ifsemio@table@row@started
\newcount\semio@table@long@mode

\newcommand{\semio@table@setup}{%
  \setlength{\semio@table@header@height}{\dimexpr9\semio@spacing@unit\relax}%
  \setlength{\semio@table@body@height}{\dimexpr7\semio@spacing@unit\relax}%
  \global\semio@table@row@startedfalse
  \arrayrulecolor{semio-chrome-border-normal}%
  \setlength{\arrayrulewidth}{\semio@stroke@hairline}%
  \setlength{\tabcolsep}{\semio@spacing@single}%
  \setlength{\extrarowheight}{\semio@spacing@single}%
  \renewcommand{\arraystretch}{1}%
}

\newcommand{\semio@table@colspec@two}{@{}T{\dimexpr0.5\linewidth-\tabcolsep\relax}T{\dimexpr0.5\linewidth-\tabcolsep\relax}@{}}

\newcommand{\semio@table@colspec@three}{@{}T{\dimexpr0.34\linewidth-\tabcolsep\relax}T{\dimexpr0.33\linewidth-\tabcolsep\relax}T{\dimexpr0.33\linewidth-2\tabcolsep\relax}@{}}

\newlength{\semio@table@long@inner@w}
\newbox\semio@table@long@pad@box

\newcommand{\semio@table@long@inner@w@set}{%
  \setbox\semio@table@long@pad@box=\hbox{\hspace{\semio@chrome@padding}}%
  \setlength{\semio@table@long@inner@w}{%
    \dimexpr\linewidth-2\wd\semio@table@long@pad@box-2\arrayrulewidth\relax
  }%
}

\newcommand{\semio@table@setup@long}{%
  \semio@table@setup
  \setlength{\tabcolsep}{0pt}%
  \setlength{\extrarowheight}{0pt}%
}

\newcommand{\semio@table@colspec@register@long}{|@{\hspace{\semio@chrome@padding}}@{}>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr0.16\semio@table@long@inner@w\relax}@{}>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr0.62\semio@table@long@inner@w\relax}@{}>{\raggedleft\arraybackslash\hspace{0pt}}p{\dimexpr0.22\semio@table@long@inner@w\relax}@{}@{\hspace{\semio@chrome@padding}}|}

\newcommand{\semio@table@colspec@reference@long}{|@{\hspace{\semio@chrome@padding}}@{}>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr0.12\semio@table@long@inner@w\relax}@{}>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr0.66\semio@table@long@inner@w\relax}@{}>{\raggedleft\arraybackslash\hspace{0pt}}p{\dimexpr0.22\semio@table@long@inner@w\relax}@{}@{\hspace{\semio@chrome@padding}}|}

\newcommand{\semio@table@colspec@glossary@long}{|@{\hspace{\semio@chrome@padding}}@{}>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr0.22\semio@table@long@inner@w\relax}@{}>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr0.56\semio@table@long@inner@w\relax}@{}>{\raggedleft\arraybackslash\hspace{0pt}}p{\dimexpr0.22\semio@table@long@inner@w\relax}@{}@{\hspace{\semio@chrome@padding}}|}

\newcommand{\semio@table@colspec@register}{@{}T{\dimexpr0.16\linewidth-\tabcolsep\relax}T{\dimexpr0.62\linewidth-\tabcolsep\relax}U{\dimexpr0.22\linewidth-2\tabcolsep\relax}@{}}

\newcommand{\semio@table@colspec@reference}{@{}T{\dimexpr0.12\linewidth-\tabcolsep\relax}T{\dimexpr0.66\linewidth-\tabcolsep\relax}U{\dimexpr0.22\linewidth-2\tabcolsep\relax}@{}}

\newcommand{\semio@table@colspec@glossary}{@{}T{\dimexpr0.22\linewidth-\tabcolsep\relax}T{\dimexpr0.56\linewidth-\tabcolsep\relax}U{\dimexpr0.22\linewidth-2\tabcolsep\relax}@{}}

\newcolumntype{T}[1]{%
  >{\raggedright\arraybackslash\hspace{0pt}}%
  p{#1}%
}

\newcolumntype{U}[1]{%
  >{\raggedleft\arraybackslash\hspace{0pt}}%
  p{#1}%
}

\newcommand{\semio@table@header@cell}[1]{%
  \cellcolor{semio-chrome-window}%
  \bfseries #1%
}

\newcommand{\semio@table@row@sep}{%
  \noalign{\hrule height\arrayrulewidth}%
}



\newcommand{\semio@table@long@header@repeat@three}[3]{%
  \semio@table@header@cell{#1} &
  \semio@table@header@cell{#2} &
  \semio@table@header@cell{#3} \\
  \hline
  \global\semio@table@row@startedfalse
}

\newcommand{\semio@table@long@title@chrome@prepare}{%
  \sbox{\semio@window@tab@box}{\semio@heading@cap@muted{\semio@window@header@title}}%
  \sbox{\semio@window@ctrl@box}{%
    \if\relax\detokenize\expandafter{\semio@window@header@number}\relax
      \hbox{}%
    \else
      \semio@heading@cap@muted@tab{\semio@window@header@number}%
    \fi
  }%
  \setlength{\semio@window@gap@w}{%
    \dimexpr\linewidth-2\arrayrulewidth-\wd\semio@window@tab@box-\wd\semio@window@ctrl@box\relax
  }%
}

\newcommand{\semio@table@long@continuation@chrome}{%
  \semio@table@long@title@chrome@prepare
  \multicolumn{3}{@{\hspace{\semio@chrome@padding}}@{}l@{\hspace{\semio@chrome@padding}}@{}}{%
    \hbox to \semio@table@long@inner@w{%
      \usebox{\semio@window@tab@box}%
      \semio@window@gap{semio-chrome-base}{semio-chrome-border-normal}%
      \usebox{\semio@window@ctrl@box}%
    }%
  }%
  \\%
}

\newcommand{\semio@register@table@header@long@repeat}{%
  \semio@table@long@header@repeat@three
    {\semio@register@header@number}
    {\semio@register@header@title}
    {\semio@register@header@page}%
}

\newcommand{\semio@references@table@header@long@repeat}{%
  \semio@table@long@header@repeat@three
    {\semio@register@header@number}
    {\semio@register@header@reference}
    {\semio@register@header@year}%
}

\newcommand{\semio@glossary@table@header@long@repeat}{%
  \semio@table@long@header@repeat@three
    {\semio@glossary@header@term}
    {\semio@glossary@header@definition}
    {\semio@glossary@header@pages}%
}

\newcommand{\semio@table@long@render}[4]{%
  \semio@table@setup@long
  \global\semio@table@long@mode=1\relax
  \global\semio@table@row@startedfalse
  \SemioSans
  \fontsize{\semio@chrome@font@body}{\semio@chrome@font@body}\selectfont
  \color{semio-chrome-text-normal}%
  \semio@table@long@inner@w@set
  \nointerlineskip
  \raggedright
  \setlength{\LTpre}{0pt}%
  \setlength{\LTpost}{0pt}%
  \setlength{\LTleft}{0pt}%
  \setlength{\LTright}{0pt}%
  \setlength{\LTcapwidth}{\linewidth}%
  \begin{longtable}{#1}%
  #2%
  \endfirsthead
  \semio@table@long@continuation@chrome
  #3%
  \endhead
  \endfoot
  \endlastfoot
  #4%
  \end{longtable}%
  \global\semio@table@long@mode=0\relax
  \global\semio@table@row@startedfalse
}

\newcommand{\semio@table@row@long}[1]{%
  #1\\
  \hline
}

\newcommand{\semio@table@row@short}[1]{%
  \ifsemio@table@row@started
    \semio@table@row@sep
  \fi
  \global\semio@table@row@startedtrue
  #1\\
}

\newcommand{\SemioTableRow}[1]{%
  \ifnum\semio@table@long@mode>0\relax
    \semio@table@row@long{#1}%
  \else
    \semio@table@row@short{#1}%
  \fi
}

\newcommand{\semio@table@render}[2]{%
  \ExplSyntaxOff
  \semio@table@require@window
  \semio@table@setup
  \begingroup
  \SemioSans
  \fontsize{\semio@chrome@font@body}{\semio@chrome@font@body}\selectfont
  \color{semio-chrome-text-normal}%
  \begin{tabular}{#1}%
  #2%
  \end{tabular}%
  \global\semio@table@row@startedfalse
  \endgroup
}

\newcommand{\SemioTableTwo}[1]{%
  \expandafter\semio@table@render\expandafter{\semio@table@colspec@two}{#1}%
}

\newcommand{\SemioTableThree}[1]{%
  \expandafter\semio@table@render\expandafter{\semio@table@colspec@three}{#1}%
}

\newcommand{\SemioTableRegister}[1]{%
  \expandafter\semio@table@long@render\expandafter{\semio@table@colspec@register@long}{\semio@register@table@header}{\semio@register@table@header@long@repeat}{#1}%
}

\newcommand{\SemioTableReferenceRow}[3]{%
  \SemioTableRow{#1 & #2 & #3}%
}

\newcommand{\SemioTableReference}[1]{%
  \expandafter\semio@table@long@render\expandafter{\semio@table@colspec@reference@long}{\semio@references@table@header}{\semio@references@table@header@long@repeat}{#1}%
}

\newcommand{\SemioGlossaryTableRow}[3]{%
  \SemioTableRow{#1 & #2 & \SemioTableGlossaryPages{#3}}%
}

\newcommand{\SemioGlossaryTableRowText}[3]{%
  \SemioTableRow{#1 & #2 & #3}%
}

\newcommand{\SemioTableGlossaryRow}[3]{%
  \SemioTableRow{#1 & #2 & #3}%
}

\newcommand{\SemioTableGlossaryPages}[1]{%
  \semio@glossary@pages@render{#1}%
}

\newcommand{\semio@glossary@pages@sentinel}{}
\newcommand{\semio@glossary@pages@sep}{}
\newcommand{\semio@glossary@pages@out}{}

\newcommand{\semio@glossary@pages@render@init}{%
  \gdef\semio@glossary@pages@out{}%
  \gdef\semio@glossary@pages@sep{}%
}

\newcommand{\semio@glossary@page@link}[1]{%
  \ifcsname r@#1\endcsname
    \hyperref[#1]{\pageref{#1}}%
  \else
    --%
  \fi
}

\newcommand{\semio@glossary@pages@dedup@add}[1]{%
  \ifcsname r@#1\endcsname
    \edef\semio@glossary@page@num{\getpagerefnumber{#1}}%
    \if\relax\detokenize\expandafter{\semio@glossary@page@num}\relax
    \else
      \edef\semio@glossary@page@key{\detokenize\expandafter{\semio@glossary@page@num}}%
      \@ifundefined{semio@glossary@seen@\semio@glossary@page@key}{%
        \global\@namedef{semio@glossary@seen@\semio@glossary@page@key}{1}%
        \edef\semio@glossary@pages@out{%
          \semio@glossary@pages@out\semio@glossary@pages@sep\noexpand\semio@glossary@page@link{#1}}%
        \gdef\semio@glossary@pages@sep{, }%
      }{}%
    \fi
  \fi
}

\newcommand{\semio@glossary@pages@render}[1]{%
  \begingroup
  \makeatletter
  \semio@glossary@pages@render@init
  \if\relax\detokenize{#1}\relax
    --%
  \else
    \@tfor\@semio@gls@label:=#1\do{%
      \ifx\@semio@gls@label\empty\else
        \semio@glossary@pages@dedup@add{\@semio@gls@label}%
      \fi
    }%
    \ifx\semio@glossary@pages@out\empty --\else\semio@glossary@pages@out\fi
  \fi
  \makeatother
  \endgroup
}

\newcommand{\SemioTableGlossary}[1]{%
  \expandafter\semio@table@long@render\expandafter{\semio@table@colspec@glossary@long}{\semio@glossary@table@header}{\semio@glossary@table@header@long@repeat}{#1}%
}

\newcommand{\semio@table@begin@tabular}[1]{\begin{tabular}{#1}}

\newcommand{\SemioTableBegin}[1]{%
  \ExplSyntaxOff
  \semio@table@require@window
  \semio@table@setup
  \begingroup
  \SemioSans
  \fontsize{\semio@chrome@font@body}{\semio@chrome@font@body}\selectfont
  \color{semio-chrome-text-normal}%
  \def\semio@table@spec{#1}%
  \ifx\semio@table@spec\semio@table@spec@ll
    \expandafter\semio@table@begin@tabular\expandafter{\semio@table@colspec@two}%
  \else
    \ifx\semio@table@spec\semio@table@spec@lll
      \expandafter\semio@table@begin@tabular\expandafter{\semio@table@colspec@three}%
    \else
      \ifx\semio@table@spec\semio@table@spec@nrp
        \expandafter\semio@table@begin@tabular\expandafter{\semio@table@colspec@register}%
      \else
        \ifx\semio@table@spec\semio@table@spec@nry
          \expandafter\semio@table@begin@tabular\expandafter{\semio@table@colspec@reference}%
        \else
          \begin{tabular}{@{}#1@{}}%
        \fi
      \fi
    \fi
  \fi
}

\def\semio@table@spec@ll{ll}
\def\semio@table@spec@lll{lll}
\def\semio@table@spec@nrp{nrp}
\def\semio@table@spec@nry{nry}

\newcommand{\SemioTableEnd}{%
  \end{tabular}%
  \endgroup
}

\newenvironment{SemioTable}[1]{%
  \SemioTableBegin{#1}%
}{%
  \SemioTableEnd
}
