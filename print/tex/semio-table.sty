\newcommand{\semio@glossary@table@header}{\semio@termlist@table@header@long@repeat{glossary}}
\newcommand{\semio@glossary@table@header@long@repeat}{\semio@termlist@table@header@long@repeat{glossary}}
\newcommand{\semio@abbreviations@table@header}{\semio@termlist@table@header@long@repeat{abbreviations}}
\newcommand{\semio@abbreviations@table@header@long@repeat}{\semio@termlist@table@header@long@repeat{abbreviations}}
%endregion LongTableHeader

\newcommand{\semio@table@long@render}[5]{%
  \global\semio@table@long@mode=1\relax
  \global\semio@table@row@startedfalse
  \begingroup
  \ifvmode\else\par\fi
  \SemioSans
  \semio@table@fontsize@apply
  \semio@table@setup@long
  \color{semio-chrome-text-normal}%
  \semio@table@long@inner@w@set
  \semio@table@long@title@chrome@prepare
  \nointerlineskip
  \raggedright
  \setlength{\LTpre}{\semio@spacing@table@outer}%
  \setlength{\LTpost}{\semio@spacing@table@outer}%
  \setlength{\LTleft}{0pt}%
  \setlength{\LTright}{0pt}%
  \setlength{\LTcapwidth}{\linewidth}%
  \begin{longtable}{#1}%
  \semio@table@long@continuation@chrome{#5}%
  #2%
  \endfirsthead
  \semio@table@long@continuation@chrome{#5}%
  #3%
  \endhead
  \noalign{\vskip\z@}% head->body transition: no negative pull (a -\semio@table@body@height skip here pulled the first body row up over the header row, hiding it)
