\ProvidesPackage{semio-table}[2026/07/09 v1.1.0 semio data table styling]

\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{hhline}
\RequirePackage{longtable}
\RequirePackage{expl3}
\RequirePackage{semio-core}
\RequirePackage{semio-fonts}
% Fallback defs (semio-tokens.sty is generated and does not carry these);
% \providecommand is idempotent if semio-window.sty already defined them.
\providecommand{\semio@spacing@table@outer}{0.85em}
\providecommand{\semio@spacing@par}{0.5em}
% LR-cellpad: horizontal inset between cell content and every column boundary
% (outer borders and internal separators alike). ~1.5–2x the former values
% (short 0.4em / long 0.2em). Column widths are reduced to absorb it, so the
% table's total width is unchanged. One token drives short and long tables.
\providecommand{\semio@table@hpad}{0.55em}

\ExplSyntaxOn
\seq_new:N \l_semio_table_row_seq
\cs_new_protected:Npn \semio_table_header_row:n #1 {
  \seq_set_split:Nnn \l_semio_table_row_seq { & } {#1}
  \int_zero:N \l_tmpa_int
  \seq_map_inline:Nn \l_semio_table_row_seq {
    \int_compare:nNnF \l_tmpa_int = \c_zero_int { & }
    \semio@table@header@cell { ##1 }
    \int_incr:N \l_tmpa_int
  }
}
\NewDocumentCommand \SemioTableHeaderRow { m } {
  \semio_table_header_row:n {#1}
  \\
  \semio@table@row@sep
  \global\semio@table@row@startedfalse
}
\cs_new_protected:Npn \semio_table_dot_count_int:n #1 {
  \int_zero:N \l_tmpa_int
  \tl_map_inline:nn {#1} {
    \str_if_eq:nnT {##1} {.} { \int_incr:N \l_tmpa_int }
  }
}
\ExplSyntaxOff

\newcount\semio@table@dot@count
\def\semio@table@dot@sentinel{}
\newcommand{\semio@table@count@dots}[1]{%
  \semio@table@dot@count=0
  \semio@table@scan@dots#1\semio@table@dot@sentinel
}
\def\semio@table@scan@dots#1{%
  \ifx\semio@table@dot@sentinel#1\else
    \if.#1\advance\semio@table@dot@count1\fi
    \expandafter\semio@table@scan@dots
  \fi
}

\newcommand{\semio@table@register@indent}[1]{%
  \semio@table@count@dots{#1}%
  \dimen0=\semio@block@sep@skip
  \multiply\dimen0 by 2
  \multiply\dimen0 by \semio@table@dot@count
  \hspace{\dimen0}%
}

\newcommand{\semio@table@register@page}[1]{%
  \ifcsname r@#1\endcsname
    \getpagerefnumber{#1}%
  \else
    --%
  \fi
}

\newcommand{\SemioTableRegisterRow}[3]{%
  \SemioTableRow{%
    \cellcolor{semio-chrome-canvas}\semio@toc@number{#1} &
    \cellcolor{semio-chrome-canvas}{\semio@table@register@indent{#1}#2} &
    \cellcolor{semio-chrome-canvas}\semio@table@register@page{#3}
  }%
}

\newcommand{\SemioTableTocRow}[3]{%
  \SemioTableRow{%
    \cellcolor{semio-chrome-canvas}\semio@toc@number{#1} &
    \cellcolor{semio-chrome-canvas}#2 &
    \cellcolor{semio-chrome-canvas}\semio@table@register@page{#3}
  }%
}

\newlength{\semio@table@header@height}
\newlength{\semio@table@body@height}
\newif\ifsemio@table@row@started
\newcount\semio@table@long@mode

% 🔤 Adjustable table body text size, mirroring the window `text-size`
% keyval (semio-window.sty) so `\begin{Table}[text-size=8pt]` and
% `\SemioTableLong[text-size=8pt]{...}` both work. Precedence: an explicit
% table-local size wins over an enclosing window's `text-size`, which wins
% over the fixed chrome body size. \l_semio_window_textsize_*  is only
% *referenced* here, not declared — semio-window.sty loads after
% semio-table.sty, but this body only runs at document time, long after
% both packages are loaded.
\ExplSyntaxOn
\dim_new:N \l_semio_table_textsize_dim
\bool_new:N \l_semio_table_textsize_set_bool
\tl_new:N \l_semio_table_key_tl
\keys_define:nn { semio / table } {
  text-size .code:n = {
    \dim_set:Nn \l_semio_table_textsize_dim {#1}
    \bool_set_true:N \l_semio_table_textsize_set_bool
  },
  key .tl_set:N = \l_semio_table_key_tl,
}
% Named the plain (legacy) way, not \semio_table_keys_set:n — these get
% called from \SemioTableLong's body, which is a plain \newcommand written
% where `_`/`:` are ordinary (non-letter) characters, so an expl3-style name
% would not tokenize as one control word there (see the identical rationale
% on \semio@table@long@prepare below).
\cs_new_protected:Npn \semio@table@keys@set #1 {
  \tl_clear:N \l_semio_table_key_tl
  \keys_set:nn { semio / table } {#1}
}
\cs_new_protected:Npn \semio@table@keys@reset {
  \bool_set_false:N \l_semio_table_textsize_set_bool
  \tl_clear:N \l_semio_table_key_tl
}
\cs_new_protected:Npn \semio@table@fontsize@apply {
  \bool_if:NTF \l_semio_table_textsize_set_bool
    { \tl_set:Nx \l_tmpa_tl { \dim_use:N \l_semio_table_textsize_dim } }
    {
      \bool_if:NTF \l_semio_window_textsize_set_bool
        { \tl_set:Nx \l_tmpa_tl { \dim_use:N \l_semio_window_textsize_dim } }
        { \tl_set:Nx \l_tmpa_tl { \semio@chrome@font@body } }
    }
  \fontsize{\tl_use:N \l_tmpa_tl}{\tl_use:N \l_tmpa_tl}\selectfont
}
\ExplSyntaxOff

\newcommand{\semio@table@setup}{%
  \setlength{\semio@table@header@height}{\dimexpr
    \semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit
    +\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit
  \relax}%
  \setlength{\semio@table@body@height}{\dimexpr
    \semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit
    +\semio@spacing@unit+\semio@spacing@unit+\semio@spacing@unit
  \relax}%
  \global\semio@table@row@startedfalse
  \arrayrulecolor{semio-chrome-border-normal}%
  \setlength{\arrayrulewidth}{\semio@stroke@hairline}%
  % 🔲 Roomier cells: horizontal via \tabcolsep (colspecs subtract \tabcolsep,
  % so table width is preserved). Vertical padding is NOT done here with
  % \extrarowheight/\arraystretch (those are top-heavy and content-dependent);
  % it is handled symmetrically per cell by the \semio@cell@struttop /
  % \semio@cell@strutbot pair baked into the T/U/m columns, so top gap = bottom
  % gap in every cell and the value is identical across all table types. Hence
  % \extrarowheight is zeroed and \arraystretch is 1 here. \parskip is
  % neutralised so a multi-line cell doesn't inherit the body paragraph gap.
  \setlength{\tabcolsep}{\semio@table@hpad}%
  \setlength{\extrarowheight}{\z@}%
  \renewcommand{\arraystretch}{1}%
  \setlength{\parskip}{\z@}%
}

% LR-cellpad: outer edges get \tabcolsep of inset (was @{} = none) so the first
% and last columns are inset from the outer border like the internal ones; column
% widths drop from -\tabcolsep to -2\tabcolsep to absorb it (total width kept).
\newcommand{\semio@table@colspec@two}{@{\hspace{\tabcolsep}}T{\dimexpr0.5\linewidth-2\tabcolsep\relax}T{\dimexpr0.5\linewidth-2\tabcolsep\relax}@{\hspace{\tabcolsep}}}

\newcommand{\semio@table@colspec@three}{@{\hspace{\tabcolsep}}T{\dimexpr0.34\linewidth-2\tabcolsep\relax}T{\dimexpr0.33\linewidth-2\tabcolsep\relax}T{\dimexpr0.33\linewidth-2\tabcolsep\relax}@{\hspace{\tabcolsep}}}

\newlength{\semio@table@long@inner@w}
\newbox\semio@table@long@pad@box
% Per-column inner padding for long tables (each column gets this much air on
% both sides → 2× between adjacent columns). Column p-widths are reduced by
% 2× this, so the total still equals \semio@table@long@inner@w (no overflow).
\newlength{\semio@table@long@cellpad}

\newcommand{\semio@table@long@inner@w@set}{%
  \setbox\semio@table@long@pad@box=\hbox{\hspace{\semio@chrome@padding}}%
  \setlength{\semio@table@long@inner@w}{%
    \dimexpr\linewidth-2\wd\semio@table@long@pad@box-2\arrayrulewidth\relax
  }%
  \setlength{\semio@table@long@cellpad}{\semio@table@hpad}%
}

\newcommand{\semio@table@setup@long}{%
  \semio@table@setup
  \setlength{\tabcolsep}{0pt}%
  % Vertical padding comes from the symmetric cell struts (same as short
  % tables) — no separate \extrarowheight here, so long/short match exactly.
}

% 🎨 Continuous canvas fill for the register/glossary long tables. Their cells
% carry \cellcolor{semio-chrome-canvas} (set in the row macros), but the inter-
% column pads were plain \hspace, so the cream page colour bled through as
% vertical seams between columns. Replace each pad with a canvas-coloured \vrule
% of the SAME width it used to occupy — so the fill runs unbroken across the
% whole table with identical geometry. Same technique the project catalogue uses
% (\semio@project@padcp et al.); factored here as generic \semio@table@pad* so
% register and glossary share it. \color+\vrule, not \columncolor (which
% misbehaves in this document's package stack).
% Interior pad: one cellpad-wide canvas rule (two abut between columns →
% 2·cellpad, matching the two \hspace pads they replace).
\newcommand{\semio@table@padcp}{{\color{semio-chrome-canvas}\vrule width \semio@table@long@cellpad}}
% Edge fills: overlap one cellpad INTO the first/last cell (net advance still
% chrome+cellpad, exactly the old \hspace{chrome}+\hspace{cellpad}) so the fill
% reaches the outer border in one seamless stroke.
\newcommand{\semio@table@padendL}{{\color{semio-chrome-canvas}\vrule width \dimexpr\semio@chrome@padding+2\semio@table@long@cellpad\relax}\hspace{-\semio@table@long@cellpad}}
\newcommand{\semio@table@padendR}{\hspace{-\semio@table@long@cellpad}{\color{semio-chrome-canvas}\vrule width \dimexpr\semio@chrome@padding+2\semio@table@long@cellpad\relax}}

\newcommand{\semio@table@colspec@register@long}{|@{\semio@table@padendL}>{\semio@cell@pre}m{\dimexpr0.12\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}>{\semio@cell@pre}m{\dimexpr0.78\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}>{\semio@cell@preR}m{\dimexpr0.10\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@register@lastclose}@{\semio@table@padendR}|}

\newcommand{\semio@table@colspec@glossary@long}{|@{\semio@table@padendL}>{\semio@cell@pre}m{\dimexpr0.22\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}>{\semio@cell@pre}m{\dimexpr0.56\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}>{\semio@cell@preR}m{\dimexpr0.22\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@table@padendR}|}

\newcommand{\semio@table@colspec@register}{@{\hspace{\tabcolsep}}T{\dimexpr0.12\linewidth-2\tabcolsep\relax}T{\dimexpr0.78\linewidth-2\tabcolsep\relax}U{\dimexpr0.10\linewidth-2\tabcolsep\relax}@{\hspace{\tabcolsep}}}

\newcommand{\semio@table@colspec@glossary}{@{\hspace{\tabcolsep}}T{\dimexpr0.22\linewidth-2\tabcolsep\relax}T{\dimexpr0.56\linewidth-2\tabcolsep\relax}U{\dimexpr0.22\linewidth-2\tabcolsep\relax}@{\hspace{\tabcolsep}}}

% 🔲 Symmetric vertical cell padding. Cells are vertically centred (m-columns);
% every cell also carries an invisible strut pair that reserves \semio@table@vtop
% above its first line and \semio@table@vbot below its last line. One pair of
% tokens drives EVERY table (short, long, register, glossary, project), so the
% padding is identical everywhere; values are em-relative so they track each
% table's text-size.
%
% Why a top value ≠ bottom value: an m-column centres the whole cell box on the
% math axis, and a text line box is ascender-heavy (cap ≈ 0.7em up, descender
% ≈ 0.2em down). Making \vtop about 0.66em larger than \vbot cancels that skew,
% so the *visible* top margin (top rule → cap) equals the *visible* bottom
% margin (baseline/descender → bottom rule). Both are then tuned to ≈ the
% horizontal inset (\semio@table@hpad + frame gap ≈ 5.5pt at the 9.6pt chrome
% body size) → text sits the same distance from all four cell borders. Measured
% on the rendered PDF: cap→toprule ≈ 5.8pt, matching the ≈5.5pt side inset.
\providecommand{\semio@table@vtop}{1.78em}
\providecommand{\semio@table@vbot}{1.12em}
% Exception: the register/TOC listing (Inhaltsverzeichnis) opts into HALF the
% vertical padding — it is a dense, single-line index where the full data-table
% air reads as too loose. These are applied by locally \renewcommand-ing
% \semio@table@vtop/@vbot to these values around ONLY the main TOC render (see
% \semio_window_toc_render: in semio-window.sty); every other table, including
% the appendix list and glossaries, keeps the full padding. Kept symmetric the
% same way (vtop−vbot ≈ 0.7em cancels the ascender-heavy line box): measured
% cap→toprule ≈ 2.9pt, ≈ half of the standard 5.8pt.
\providecommand{\semio@table@vtop@toc}{1.40em}
\providecommand{\semio@table@vbot@toc}{0.70em}
% Top strut: zero-width rule that only sets the first line's height (no depth,
% so interline spacing in multi-line cells is untouched).
\newcommand{\semio@cell@struttop}{\rule[\z@]{\z@}{\semio@table@vtop}}
% Bottom strut: zero-width rule that only sets the last line's depth.
\newcommand{\semio@cell@strutbot}{\rule[-\semio@table@vbot]{\z@}{\z@}}
% 🩹 Inset variant of the bottom strut for a right-aligned last column. The
% register/glossary long tables close their right edge with the seam-filling
% \semio@table@padendR, which backs up one cellpad INTO the cell and — being
% emitted after the cell — paints canvas ON TOP of it. Left-aligned columns hide
% that overlap in their empty left inset; a right-aligned column (\semio@cell@preR)
% sits flush against it, so its digits / the "Seite" label lose their right
% ~cellpad. This closer prepends exactly one cellpad of inset so the content abuts
% the fill instead of hiding under it — the same inset every other cell already has.
\newcommand{\semio@cell@strutbotR}{\hspace*{\semio@table@long@cellpad}\semio@cell@strutbot}
% Last-column closer for the register colspec (below). Defaults to the plain strut
% so the shared appendix register renders byte-identically to before; ONLY the
% Inhaltsverzeichnis render group locally \renews this to \semio@cell@strutbotR
% (see the TOC-only exception in semio-window.sty). No other table is affected.
\newcommand{\semio@register@lastclose}{\semio@cell@strutbot}
% Unified cell openers: alignment + top strut + no-indent glue. The matching
% bottom strut goes in the column's <{} slot.
% 🪢 Hyphenation: the \hspace{0pt} glue MUST come *after* \semio@cell@struttop,
% not before it. TeX only hyphenates a run of letters that is immediately
% preceded by glue; \semio@cell@struttop is a \rule, so with the glue before it
% the first word of the cell sits directly after a rule and never hyphenates —
% a long compound ("Beschaffungsschritte", "Mitgliedschaft") then overflows a
% narrow column and collides with the next one. Emitting the strut first and the
% zero glue last restores the "word preceded by glue" precondition (see the
% Hyphenation Safety note in semio-core.sty). The strut still sets the first
% line's height either way; the glue is zero-width, so nothing shifts visually.
\newcommand{\semio@cell@pre}{\raggedright\arraybackslash\semio@cell@struttop\hspace{0pt}}
\newcommand{\semio@cell@preR}{\raggedleft\arraybackslash\semio@cell@struttop\hspace{0pt}}

\newcolumntype{T}[1]{%
  >{\semio@cell@pre}%
  m{#1}%
  <{\semio@cell@strutbot}%
}

\newcolumntype{U}[1]{%
  >{\semio@cell@preR}%
  m{#1}%
  <{\semio@cell@strutbot}%
}

\newcommand{\semio@table@header@cell}[1]{%
  \cellcolor{semio-chrome-canvas}%
  \SemioSans\semio@table@fontsize@apply
  \semio@text@emphasized{\bfseries #1}%
}

\newcommand{\semio@table@row@sep}{%
  \noalign{\hrule height\arrayrulewidth width\linewidth}%
}

%region LongTableHeader
% Canvas-fill switch for fully-canvas long tables (register/glossary). When set,
% the header's first cell (a \multicolumn) uses the same canvas \vrule pads and
% geometry as the body columns, so the header row fills seamlessly too. Off by
% default → the generic \SemioTableLong header keeps its plain pads (those
% tables have transparent bodies, so a partially-filled header would look wrong).
\newif\ifsemio@table@headerfill
\semio@table@headerfillfalse
\newcommand{\semio@table@long@header@left@cell}[2]{%
  \ifsemio@table@headerfill
    % Structurally identical to a body col-1: canvas edge fill + width−2cellpad +
    % two canvas pads bridging to col-2, so the header title aligns with the body
    % cells AND the fill is continuous.
    \multicolumn{1}{|@{\semio@table@padendL}>{\semio@cell@pre}m{\dimexpr#1\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}<{\semio@cell@strutbot}@{\semio@table@padcp}@{\semio@table@padcp}}{%
      \semio@table@header@cell{#2}%
    }%
  \else
    \multicolumn{1}{|@{\hspace{\semio@chrome@padding}}@{}>{\semio@cell@pre}m{\dimexpr#1\semio@table@long@inner@w\relax}<{\semio@cell@strutbot}@{}}{%
      \semio@table@header@cell{#2}%
    }%
  \fi
}

\newcommand{\semio@table@long@header@repeat@three}[4]{%
  \semio@table@long@header@left@cell{#1}{#2} &
  \semio@table@header@cell{#3} &
  \semio@table@header@cell{#4} \\
  \hhline{|---|}
  % Reset in \noalign: a bare \global assignment here sits *between* the \hhline
  % and \endfirsthead outside any row, so array's row scanner reads it as the
  % start of a new cell — opening an empty, strut-height phantom row (a cream
  % band, unfilled by the header cellcolor) between the header and the first
  % entry. \noalign executes it on the row boundary without starting that row.
  \noalign{\global\semio@table@row@startedfalse}%
}

\newcommand{\semio@table@long@header@continuation@three}[4]{%
  \semio@table@long@header@left@cell{#1}{#2} &
  \semio@table@header@cell{#3} &
  \semio@table@header@cell{#4} \\
  \hhline{|---|}
  % head->body transition: no negative pull (a -\semio@table@body@height skip
  % here pulled the first body row up over the header row, hiding it). The
  % row-started reset shares the \noalign so it, too, cannot open a phantom row.
  \noalign{\vskip\z@\global\semio@table@row@startedfalse}%
}

\newif\ifsemio@table@long@title@number

\newcommand{\semio@table@long@title@chrome@prepare}{%
  \sbox{\semio@window@tab@box}{\semio@heading@cap@muted{\textcolor{semio-chrome-foreground}{\semio@window@header@title}}}%
  \edef\semio@table@long@title@number{\semio@window@header@number}%
  \ifx\semio@table@long@title@number\@empty
    \semio@table@long@title@numberfalse
    \setlength{\semio@window@gap@w}{\dimexpr\linewidth-\wd\semio@window@tab@box\relax}%
  \else
    \semio@table@long@title@numbertrue
    \sbox{\semio@window@ctrl@box}{\semio@heading@cap@muted{\semio@table@long@title@number}}%
    \setlength{\semio@window@gap@w}{%
      \dimexpr\linewidth-\wd\semio@window@tab@box-\wd\semio@window@ctrl@box\relax
    }%
  \fi
}

\newcommand{\semio@table@long@title@chrome@row}[1]{%
  \multicolumn{#1}{@{}l@{}}{%
    % Bleed the row one hairline into the left margin (and widen it to match) so
    % the title tab's left border lands exactly on the table's outer left rule
    % instead of a hairline inside it — the same overhang the tcolorbox tables get.
    \hskip-\semio@stroke@hairline\relax
    \hbox to \dimexpr\linewidth+\semio@stroke@hairline\relax{%
      % Title tab flush-left, number tab (if any) flush-right; the middle stays
      % open. The table's top border is NOT drawn here (the canvas header cells
      % would cover a stroke drawn in this row, leaving it visible only in the
      % inter-column pads — a broken/dashed line); it is a single continuous
      % \hrule emitted below, on the row boundary, so it runs unbroken full width.
      \usebox{\semio@window@tab@box}%
      \hfil
      \ifsemio@table@long@title@number\usebox{\semio@window@ctrl@box}\fi
    }%
  }%
  \\%
  % Weld the title bar onto the following column-header row so the (bigger) title
  % tab SITS DIRECTLY ON the table's top border instead of floating above it. Pull
  % back the header row's \extrarowheight top padding and strut depth, plus the
  % tab's own top cap padding (\semio@chrome@padding) — the small surplus that
  % opened as a visible gap once the header font grew.
  \noalign{\vskip\dimexpr-\extrarowheight-\dp\@arstrutbox\relax}%
  % One clean, continuous full-width top border for the table — the tab sits on it.
  \noalign{{\color{semio-chrome-border-normal}\hrule height\semio@stroke@hairline}}%
}

\newcommand{\semio@table@long@continuation@chrome}[1]{%
  \semio@table@long@title@chrome@row{#1}%
}

\newcommand{\semio@register@table@header@long@repeat}{%
  \semio@table@long@header@continuation@three
    {0.12}
    {\semio@register@header@key}
    {\semio@register@header@title}
    {\semio@register@header@page}%
}

