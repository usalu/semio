\newcommand{\semio@glossary@table@header@long@repeat}{\semio@termlist@table@header@long@repeat{glossary}}
\newcommand{\semio@abbreviations@table@header}{\semio@termlist@table@header@long@repeat{abbreviations}}
\newcommand{\semio@abbreviations@table@header@long@repeat}{\semio@termlist@table@header@long@repeat{abbreviations}}
%endregion LongTableHeader

\newcommand{\semio@table@long@render}[5]{%
  \global\semio@table@long@mode=1\relax
  \global\semio@table@row@startedfalse
  \begingroup
  \ifvmode\else\par\fi
  \SemioSans
  \semio@table@fontsize@apply
  \semio@table@setup@long
  \color{semio-chrome-text-normal}%
  \semio@table@long@inner@w@set
  \semio@table@long@title@chrome@prepare
  \nointerlineskip
  \raggedright
  \setlength{\LTpre}{\semio@spacing@table@outer}%
  \setlength{\LTpost}{\semio@spacing@table@outer}%
  \setlength{\LTleft}{0pt}%
  \setlength{\LTright}{0pt}%
  \setlength{\LTcapwidth}{\linewidth}%
  \begin{longtable}{#1}%
  \semio@table@long@continuation@chrome{#5}%
  #2%
  \endfirsthead
  \semio@table@long@continuation@chrome{#5}%
  #3%
  \endhead
  \noalign{\vskip\z@}% head->body transition: no negative pull (a -\semio@table@body@height skip here pulled the first body row up over the header row, hiding it)
  \noalign{{\color{red}\hrule height 3pt}}% DIAGNOSTIC MARKER body-start
  #4%
  \end{longtable}%
  \endgroup
  \global\semio@table@long@mode=0\relax
  \global\semio@table@row@startedfalse
}

\newcommand{\semio@table@row@long}[1]{%
  #1\\
  \hline
}

\newcommand{\semio@table@row@short}[1]{%
  \ifsemio@table@row@started
    \semio@table@row@sep
  \fi
  \global\semio@table@row@startedtrue
  #1\\
}

\newcommand{\SemioTableRow}[1]{%
  \ifnum\semio@table@long@mode>0\relax
    \semio@table@row@long{#1}%
  \else
    \semio@table@row@short{#1}%
  \fi
}

% 🩹 \semio@table@setup stays *before* \begingroup (not moved inside,
% alongside the font-size apply, the way \semio@table@long@render orders it)
% — moving it inside reproducibly threw a "Misplaced \omit" from deep inside
% hhline, but only under the zukunftbau `zwischenbericht` type (its
% `\SemioSetup{appendix-level=part}` chain, confirmed via bisection: neither
% \semio@table@fontsize@apply itself, nor `appendix-level=part` alone on a
% plain `semio` document, reproduce it — only this exact combination of
% class + relocated group boundary does). Left where it was, \tabcolsep/
% \extrarowheight/etc keep resolving against the *ambient* font rather than
% a custom `text-size`, a smaller, tolerable inconsistency versus a hard
% compile break.
\newcommand{\semio@table@render}[2]{%
  \ExplSyntaxOff
  \semio@table@require@window
  \semio@table@setup
  \begingroup
  \SemioSans
  \semio@table@fontsize@apply
  \color{semio-chrome-text-normal}%
  \begin{tabular}{#1}%
  #2%
  \end{tabular}%
  \global\semio@table@row@startedfalse
  \endgroup
}

\newcommand{\SemioTableTwo}[1]{%
  \expandafter\semio@table@render\expandafter{\semio@table@colspec@two}{#1}%
}

\newcommand{\SemioTableThree}[1]{%
  \expandafter\semio@table@render\expandafter{\semio@table@colspec@three}{#1}%
}

\newcommand{\SemioTableRegister}[1]{%
  \expandafter\semio@table@long@render\expandafter{\semio@table@colspec@register@long}{\semio@register@table@header}{\semio@register@table@header@long@repeat}{#1}{3}%
}

%region GenericLongTable
% 📎 Generic multi-page table + avatar band row, for report appendices (e.g. a
% project catalogue) that need more columns or rows than the register/
% reference/glossary long tables above hardcode. Mirrors their structure —
% \semio@table@long@render underneath — but takes the colspec and header row
% as plain arguments instead of a fixed three-column shape.
\ExplSyntaxOn

% 🩹 The colspec and header are built here, inside the package, from plain
% arguments — never from hand-written strings containing `\semio@...` names.
% Those names are only valid where `@` is catcode-11 (package files); a
% report's own content file (\input after \begin{document}) does not have
% that, so building them in the caller's source would silently break.
% Keeping composition inside the package is the fix, not a `\makeatletter`
% workaround at every call site.
%
% 🩹 The finished head is copied into a plain (non-expl3) macro and that bare
% macro *name* — not its pre-expanded value — is what reaches
% \semio@table@long@render, exactly like \SemioTableRegister passes
% \semio@register@table@header. longtable re-invokes the head macro itself on
% every page break; if a body row uses \multicolumn (as band rows do),
% pre-flattening the head's tokens into the argument list (via \exp_args:NV
% or similar) desyncs longtable's column bookkeeping and throws a "Misplaced
% \omit" the next time the header repeats. A colspec has no such issue since
% array fully expands it while parsing the preamble either way.
\tl_new:N \l_semio_table_long_colspec_tl
\tl_new:N \l_semio_table_long_head_tl
\newcommand{\semio@table@long@head@current}{}
\newcommand{\semio@table@long@head@continuation@current}{}

\cs_new_protected:Npn \semio_table_long_colspec_build:n #1 {
  \tl_set:Nn \l_semio_table_long_colspec_tl { | @ { \hspace{\semio@chrome@padding} } @ { } }
  \clist_map_inline:nn {#1} {
    \tl_put_right:Nn \l_semio_table_long_colspec_tl {
      @{\hspace{\semio@table@long@cellpad}}>{\raggedright\arraybackslash\hspace{0pt}}p{\dimexpr##1\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}@{\hspace{\semio@table@long@cellpad}}
    }
  }
  \tl_put_right:Nn \l_semio_table_long_colspec_tl { @ { \hspace{\semio@chrome@padding} } | }
}

\cs_new_protected:Npn \semio_table_long_header_build:nn #1#2 {
  \seq_set_split:Nnn \l_semio_table_row_seq { & } {#2}
  \tl_clear:N \l_semio_table_long_head_tl
  \int_zero:N \l_tmpa_int
  \seq_map_inline:Nn \l_semio_table_row_seq {
    \int_compare:nNnTF \l_tmpa_int = \c_zero_int {
      \tl_put_right:Nx \l_semio_table_long_head_tl {
        \exp_not:N \semio@table@long@header@left@cell
          { \clist_item:nn {#1} {1} }
          { ##1 }
      }
    } {
      \tl_put_right:Nn \l_semio_table_long_head_tl { & }
      \tl_put_right:Nx \l_semio_table_long_head_tl { \exp_not:N \semio@table@header@cell { ##1 } }
    }
    \int_incr:N \l_tmpa_int
  }
  \tl_put_right:Nn \l_semio_table_long_head_tl {
    \\
  }
  \tl_put_right:Nx \l_semio_table_long_head_tl {
    \exp_not:N \hhline { | \prg_replicate:nn { \seq_count:N \l_semio_table_row_seq } { - } | }
  }
  \global\long\expandafter\def\expandafter\semio@table@long@head@current\expandafter{\l_semio_table_long_head_tl\global\semio@table@row@startedfalse}
  \tl_put_right:Nn \l_semio_table_long_head_tl {
    \noalign{\vskip\z@}% head->body transition: no negative pull (a -\semio@table@body@height skip here pulled the first body row up over the header row, hiding it)
  }
  \tl_put_right:Nn \l_semio_table_long_head_tl {
    \global\semio@table@row@startedfalse
  }
  % 🩹 Not \tl_gset_eq:NN: that \let-aliases \semio@table@long@head@current to
  % an expl3 tl variable, which l3 always defines as a non-\long macro. A
  % \long macro (as \newcommand produces) is what longtable's own head-repeat
  % machinery expects when a body row uses \multicolumn — anything else
  % throws "Misplaced \omit" the next time the header repeats. The triple
  % \expandafter copies the tl's current tokens verbatim (one level, so
  % \hhline/\semio@table@header@cell inside stay unevaluated) into a fresh
  % \long macro instead of aliasing the tl var directly.
  \global\long\expandafter\def\expandafter\semio@table@long@head@continuation@current\expandafter{\l_semio_table_long_head_tl}
}

\newcommand{\semio@table@long@colspec@current}{}
\newcommand{\semio@table@long@column@count}{3}

% Named the plain (legacy) way, not \semio_table_long_prepare:nn — this gets
% called from \SemioTableLong's body below, which is a plain \newcommand
% written where `_`/`:` are ordinary (non-letter) characters, so an expl3-
% style name would not tokenize as one control word there.
\cs_new_protected:Npn \semio@table@long@prepare #1#2 {
  \semio_table_long_colspec_build:n {#1}
  \semio_table_long_header_build:nn {#1} {#2}
  \cs_gset:Npx \semio@table@long@column@count { \clist_count:n {#1} }
  % Same \long-macro-by-bare-name treatment as the head (see above) — a
  % colspec flattened straight into the argument list via \exp_args:NV
  % throws the identical "Misplaced \omit" once a body row uses \multicolumn.
  \global\long\expandafter\def\expandafter\semio@table@long@colspec@current\expandafter{\l_semio_table_long_colspec_tl}
}
\ExplSyntaxOff

% 🩹 \semio@table@long@prepare (above) only fills the two "current" macros;
% the actual \semio@table@long@render call is plain TeX so the colspec can be
% expanded into the argument list the same way \SemioTableRegister does it
% (\expandafter{\semio@table@colspec@register@long}) — passing it as a bare
% macro reference like the head hits "Illegal pream-token", because array's
% preamble parser (unlike longtable's head/repeathead slots) never expands
% macro names on its own.
%
% 🩹 The leading [key=val] (e.g. [text-size=8pt]) uses the *kernel's* own
% \newcommand[n][default] optional-argument support, not xparse/ltcmd — that
% mechanism (\@protected@testopt/\@testopt/\@ifnextchar[) peeks for the `[`
% at the call site, at the main vertical list, before \begin{longtable} ever
% opens; the remaining 5 mandatory parameters are still grabbed by a plain
% \long\def exactly as before. It is unrelated to the ltcmd-argument-grabbing
% "Misplaced \omit" issue documented below on \SemioTableBandRow, so it does
% not reintroduce that break.
\newcommand{\SemioTableLong}[5][]{%
  \semio@table@keys@set{#1}%
  \semio@table@long@prepare{#3}{#4}%
  \semio@table@long@open{#2}%
  \expandafter\semio@table@long@render\expandafter{\semio@table@long@colspec@current}{\semio@table@long@head@current}{\semio@table@long@head@continuation@current}{#5}{\semio@table@long@column@count}%
  \semio@table@long@close
  \semio@table@keys@reset
}

% 🩹 Plain \newcommand, not \NewDocumentCommand/xparse: xparse's argument
% grabbing — even for all-mandatory arguments — breaks the same "Misplaced
% \omit" way once this macro's expansion contains \multicolumn (band rows
% span every column) inside this longtable. Plain TeX argument grabbing
% doesn't have that problem. For the same reason the image is mandatory
% (pass {} when a row has none) rather than an optional argument, and its
% \SemioImage call is unconditional — wrapping it in a conditional (\ifx,
% \tl_if_blank:nF, anything) reintroduces the same break even when the
% conditional's branches never touch \multicolumn at all; every project row
% in practice has an image, so this isn't a real limitation. A nested \\ for
% the title/meta line break has the same problem — colortbl's redefinition
% of \\ inside a \multicolumn cell conflicts with the table's own \\; use
% \newline instead, which stays a plain TeX primitive.
\newcommand{\SemioTableBandRow}[4]{%
  % #1 image path #2 colspan #3 title #4 meta
  \multicolumn{#2}{@{}>{\raggedright\arraybackslash\hspace{0pt}}p{\semio@table@long@inner@w}@{}}{%
    \cellcolor{semio-chrome-canvas}%
    \raisebox{-0.15\height}{\includegraphics[height=\dimexpr 2\semio@table@body@height\relax,keepaspectratio]{#1}}\hspace{\semio@chrome@padding}%
    \textbf{#3}\newline#4
  }%
  \\*\hline
}
%endregion GenericLongTable

\newcommand{\SemioGlossaryTableRow}[3]{%
  \SemioTableRow{\cellcolor{semio-chrome-canvas}#1 & \cellcolor{semio-chrome-canvas}#2 & \cellcolor{semio-chrome-canvas}\SemioTableGlossaryPages{#3}}%
}

\newcommand{\SemioGlossaryTableRowText}[3]{%
  \SemioTableRow{\cellcolor{semio-chrome-canvas}#1 & \cellcolor{semio-chrome-canvas}#2 & \cellcolor{semio-chrome-canvas}#3}%
}

\newcommand{\SemioTableGlossaryRow}[3]{%
  \SemioTableRow{\cellcolor{semio-chrome-canvas}#1 & \cellcolor{semio-chrome-canvas}#2 & \cellcolor{semio-chrome-canvas}#3}%
}

\ExplSyntaxOn
\seq_new:N \l_semio_glossary_pages_seen_seq
\tl_new:N \l_semio_glossary_pages_out_tl
\tl_new:N \l_semio_glossary_pages_page_tl
\cs_generate_variant:Nn \seq_if_in:NnF { Nx }
\cs_generate_variant:Nn \seq_put_right:Nn { Nx }
\cs_generate_variant:Nn \tl_put_right:Nn { Nx }

\cs_new_protected:Npn \semio_glossary_page_link:n #1 {
  \ifcsname r@#1\endcsname
    \hyperref[#1]{\pageref{#1}}
  \else
    --
  \fi
}

\cs_new_protected:Npn \semio_glossary_pages_dedup_add:n #1 {
  \ifcsname r@#1\endcsname
    \tl_set:Nx \l_semio_glossary_pages_page_tl { \getpagerefnumber{#1} }
    \tl_if_empty:NF \l_semio_glossary_pages_page_tl {
      \seq_if_in:NxF \l_semio_glossary_pages_seen_seq { \l_semio_glossary_pages_page_tl } {
        \seq_put_right:Nx \l_semio_glossary_pages_seen_seq { \l_semio_glossary_pages_page_tl }
        \tl_if_empty:NF \l_semio_glossary_pages_out_tl {
          \tl_put_right:Nn \l_semio_glossary_pages_out_tl { ,~ }
        }
        \tl_put_right:Nx \l_semio_glossary_pages_out_tl { \semio_glossary_page_link:n {#1} }
      }
