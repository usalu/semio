    \sbox{\semio@table@long@part@chip@box}{%
      \semio@heading@cap@muted@open{\semio@table@long@part@number}%
    }%
    \nointerlineskip
    \hbox to 0pt{%
      \hbox to \linewidth{%
        \hfil
        \raisebox{-\height}[0pt][0pt]{\usebox{\semio@table@long@part@chip@box}}%
      }%
      \hss
    }%
    \nointerlineskip
  \endgroup
}

