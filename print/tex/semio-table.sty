\seq_new:N \l_semio_glossary_pages_seen_seq
\tl_new:N \l_semio_glossary_pages_out_tl
\tl_new:N \l_semio_glossary_pages_page_tl
\cs_generate_variant:Nn \seq_if_in:NnF { Nx }
\cs_generate_variant:Nn \seq_put_right:Nn { Nx }
\cs_generate_variant:Nn \tl_put_right:Nn { Nx }

\cs_new_protected:Npn \semio_glossary_page_link:n #1 {
  \ifcsname r@#1\endcsname
    \hyperref[#1]{\pageref{#1}}
  \else
    --
  \fi
}

\cs_new_protected:Npn \semio_glossary_pages_dedup_add:n #1 {
  \ifcsname r@#1\endcsname
    \tl_set:Nx \l_semio_glossary_pages_page_tl { \getpagerefnumber{#1} }
    \tl_if_empty:NF \l_semio_glossary_pages_page_tl {
      \seq_if_in:NxF \l_semio_glossary_pages_seen_seq { \l_semio_glossary_pages_page_tl } {
        \seq_put_right:Nx \l_semio_glossary_pages_seen_seq { \l_semio_glossary_pages_page_tl }
        \tl_if_empty:NF \l_semio_glossary_pages_out_tl {
          \tl_put_right:Nn \l_semio_glossary_pages_out_tl { ,~ }
        }
        \tl_put_right:Nx \l_semio_glossary_pages_out_tl { \semio_glossary_page_link:n {#1} }
      }
    }
  \fi
}

\cs_new_protected:Npn \semio_glossary_pages_render:n #1 {
  \seq_clear:N \l_semio_glossary_pages_seen_seq
  \tl_clear:N \l_semio_glossary_pages_out_tl
  \tl_if_blank:nF {#1} {
    \clist_map_inline:nn {#1} {
      \semio_glossary_pages_dedup_add:n {##1}
    }
  }
  \tl_if_empty:NTF \l_semio_glossary_pages_out_tl { -- } { \tl_use:N \l_semio_glossary_pages_out_tl }
}

\cs_new_protected:Npn \SemioTableGlossaryPages #1 {
  \group_begin:
  \semio_glossary_pages_render:n {#1}
  \group_end:
}
