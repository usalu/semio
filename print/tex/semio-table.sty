\newcommand{\semio@table@long@render}[5]{%
  \global\semio@table@long@mode=1\relax
  \global\semio@table@long@part=0\relax
  \global\semio@table@row@startedfalse
  \begingroup
  \ifvmode\else\par\fi
  \SemioSans
  \semio@table@fontsize@apply
  \semio@table@setup@long
  \color{semio-chrome-text-normal}%
  % Longtable has no enclosing tcolorbox frame ? it owns its side borders.
  \semio@table@owns@sidestrue
  \semio@table@long@inner@w@set
  \semio@table@long@title@chrome@prepare
  \ifvmode\nointerlineskip\fi
  \raggedright
  \setlength{\LTpre}{\semio@spacing@table@outer}%
  \setlength{\LTpost}{\semio@spacing@table@outer}%
  \setlength{\LTleft}{0pt}%
  \setlength{\LTright}{0pt}%
  \setlength{\LTcapwidth}{\linewidth}%
  % Do not call \endfirsthead. An empty \endfirsthead stores a non-void
  % empty \LT@firsthead, so page 1 ships that blank box and skips \LT@head
  % (measured: Abkuerzungen after Glossar lost chrome/header; cream gap +
  % pillar stubs between Test-Case and AP). With firsthead left void,
  % longtable uses \LT@head on page 1 and every continuation — one chrome,
  % one column-header (filling BOTH firsthead and head doubled Marktplaetze
  % chips ~48pt apart).
  \global\setbox\LT@firsthead=\box\voidb@x
  \begin{longtable}{#1}%
  \semio@table@long@title@chrome@row@pageparts{#5}%
  #3%
  \endhead
  \noalign{\vskip\z@}% head->body transition: no negative pull (a -\semio@table@body@height skip here pulled the first body row up over the header row, hiding it)
  #4%
  \end{longtable}%
  \semio@table@long@parts@record
  \endgroup
  \global\semio@table@long@mode=0\relax
  \global\semio@table@row@startedfalse
}

\let\semio@table@long@hhline@current\semio@table@rule
% \\* keeps the trailing mid-rule with its row. A plain \\ can page-break
% between the row and the \noalign rule; the orphaned rule then lands on the
% next page immediately under \endhead's own mid-rule and reads as a double
% hairline (measured 1.5pt on TOC continuations).
\newcommand{\semio@table@row@long}[1]{%
  #1\\*%
  \semio@table@rule
}

\newcommand{\semio@table@row@short}[1]{%
