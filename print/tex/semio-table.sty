}

% Split the packed "ort & land & jahr & typ & status & quelle" metadata arg.
\def\semio@project@splitmeta#1&#2&#3&#4&#5&#6\relax{%
  \def\semio@project@ort{#1}\def\semio@project@land{#2}\def\semio@project@jahr{#3}%
  \def\semio@project@typ{#4}\def\semio@project@status{#5}\def\semio@project@quelle{#6}%
}

% Metadata subgrid (right of the photo): labelled fields, muted label / normal
% value. Ort/Stadt and Land are separate rows.
\newcommand{\semio@project@meta}[6]{%
  \begingroup
  \setlength{\extrarowheight}{0pt}%
  \renewcommand{\arraystretch}{1.2}%
  % Labels use the SAME synthetic-bold face as the component column headers. Anta
  % ships Regular only, so \bfseries is a no-op here; the headers get their weight
  % from the \SemioSansBold family (fontspec FakeBold, see semio-window.sty, where
  % \semio@table@header@cell is redefined to \SemioSansBold\semio@table@fontsize@apply).
  % Mirror that exactly in the label column so labels and headers share one face
  % and size. Values stay regular weight in the muted text colour.
  \begin{tabular}[t]{@{}>{\SemioSansBold\semio@table@fontsize@apply\color{semio-chrome-foreground}}l@{\hspace{1.2em}}>{\color{semio-chrome-text-normal}}l@{}}
    Stadt & #1\tabularnewline
    Land & #2\tabularnewline
    Jahr & #3\tabularnewline
    Typ & #4\tabularnewline
    Status & #5\tabularnewline
    Quelle & #6\tabularnewline
    % Image credit / rights. Value comes from \SemioProject's optional argument
    % (\semio@project@bildrechte), defaulting to — until a real credit is supplied.
    Bildrechte & \semio@project@bildrechte\tabularnewline
  \end{tabular}%
  \endgroup
}

% Overview band row: photo multicolumn (cols 1–2) + metadata multicolumn (cols
% 3–6). The two multicolumns re-supply the outer border and mirror the base
% colspec's edge padding, so the shared boundary falls on the Spender edge.
% Canvas-coloured column separators for the band's outer inset and the photo↔meta
% gap, drop-in replacements for the former cream \hspace pads of the SAME width —
% so the band's fill runs edge-to-edge with no cream slivers at the border or
% between photo and metadata, exactly like the component section's padcp fills.
\newcommand{\semio@project@bandpadchrome}{{\color{semio-chrome-canvas}\vrule width \semio@chrome@padding}}
\newcommand{\semio@project@overview@band}[7]{%
  \multicolumn{2}{|@{\semio@project@bandpadchrome}p{\semio@project@photow}@{\semio@project@padcp}}{%
    \cellcolor{semio-chrome-canvas}%
    \begin{minipage}[t]{\linewidth}\vspace{0pt}%
      \SemioProjectPhoto{#1}{\linewidth}{\semio@project@bandheight}%
    \end{minipage}%
  }%
  &
  \multicolumn{4}{@{}>{\raggedright\arraybackslash}p{\dimexpr\semio@project@metaw+\semio@table@long@cellpad\relax}@{\semio@project@bandpadchrome}|}{%
    \cellcolor{semio-chrome-canvas}%
    \begin{minipage}[t]{\linewidth}\vspace{0pt}%
      \semio@project@meta{#2}{#3}{#4}{#5}{#6}{#7}%
    \end{minipage}%
  }%
  % Divide the overview band from the component section with a single unbroken
  % rule and NO cream breathing gap: the former \noalign{\vskip 4pt} above and
  % below the \hline left a cream band across the full width and cut the left/right
  % borders there. A bare \hline welds band-canvas → rule → header-canvas, borders
  % continuous, exactly like every body-row boundary.
  \\\hline
}

% Project component-section column header, rendered THROUGH the project colspec
% itself — not the shared \semio@table@long@header@left@cell. That shared left
% cell wraps column 1 in a \multicolumn whose preamble ends in a bare @{}, which
% drops the canvas-filled inter-column pad (\semio@project@padcp) on col 1's
% right edge and swaps the left edge for a plain \hspace. The result was a cream
% stripe between "Bauteil / Menge" and "Material" (and a cream sliver at the left
% border): the header fill broke away from the continuous body fill. Routing every
% cell through \semio@table@header@cell in a plain project column lets
% \semio@project@padendL / \semio@project@padcp fill the left edge and all five
% gaps exactly like the body rows, and gives col 1 the same width and struts as
% the body. Labels MUST stay in sync with the \semio@table@long@prepare call in
% \SemioProject. \hline (not \hhline) guarantees one unbroken full-width divider.
\newcommand{\semio@project@headrow}{%
  \semio@table@header@cell{Bauteil / Menge} &
  \semio@table@header@cell{Material} &
  \semio@table@header@cell{Spender} &
  \semio@table@header@cell{ReUse-Ort} &
  \semio@table@header@cell{Schicht} &
  \semio@table@header@cell{Prozess}\\
  \hline
  \noalign{\global\semio@table@row@startedfalse}%
}

\newcommand{\semio@project@long@render@call}[2]{%
  \semio@table@long@render{#1}{\semio@project@firsthead}{\semio@project@head}{#2}{6}%
}

% \SemioProject[bildrechte]{name}{label}{image}{ort & land & jahr & typ & status & quelle}{rows}
% Optional #1 = image credit / rights, shown as the "Bildrechte" metadata row.
% Defaults to — so every card carries the row as a placeholder until the credit
% is known; fill it per card with \SemioProject[Foto: … / …]{…}{…}{…}{…}{…}.
\newcommand{\SemioProject}[6][—]{%
  \SemioCardKeep
  \SemioProjectHeadingSilent{#2}{#3}%
  \protected@edef\semio@project@key{\thesubsection}%
  \gdef\semio@window@header@title{#2}%
  \global\let\semio@window@header@number\semio@project@key
  \def\semio@project@bildrechte{#1}%
  \semio@table@long@prepare{0.18,0.10,0.26,0.12,0.17,0.17}{Bauteil / Menge & Material & Spender & ReUse-Ort & Schicht & Prozess}%
  \semio@project@splitmeta#5\relax
  \long\def\semio@project@firsthead{%
    \semio@project@overview@band{#4}%
      {\semio@project@ort}{\semio@project@land}{\semio@project@jahr}%
      {\semio@project@typ}{\semio@project@status}{\semio@project@quelle}%
    \semio@project@headrow
  }%
  \long\def\semio@project@head{\semio@project@headrow}%
  % Render with the project colspec (continuous canvas via \columncolor overhangs)
  % instead of the default one, so the fill runs through the whole table — header
  % and every row — with no cream gaps between columns.
  \expandafter\semio@project@long@render@call\expandafter{\semio@project@colspec}{#6}%
}
%endregion ProjectCatalogue
