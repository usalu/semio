\newcommand{\semio@table@termlist}[2]{%
  \expandafter\semio@table@long@render\expandafter{\semio@table@colspec@glossary@long}{\csname semio@#1@table@header\endcsname}{\csname semio@#1@table@header@long@repeat\endcsname}{#2}{3}%
}

\newcommand{\SemioTableGlossary}[1]{\semio@table@termlist{glossary}{#1}}
\newcommand{\SemioTableAbbreviations}[1]{\semio@table@termlist{abbreviations}{#1}}

\newcommand{\semio@table@begin@tabular}[1]{\begin{tabular}{#1}}

% 🩹 Same as \semio@table@render above: \semio@table@setup stays outside
% \begingroup, not relocated next to the font-size apply — see that comment
% for why (a reproducible "Misplaced \omit" under zukunftbau's
% `zwischenbericht` type).
\newcommand{\SemioTableBegin}[1]{%
  \ExplSyntaxOff
  \semio@table@require@window
  \semio@table@setup
  \begingroup
  \SemioSans
  \semio@table@fontsize@apply
  \color{semio-chrome-text-normal}%
  \def\semio@table@spec{#1}%
  \ifx\semio@table@spec\semio@table@spec@ll
    \expandafter\semio@table@begin@tabular\expandafter{\semio@table@colspec@two}%
  \else
    \ifx\semio@table@spec\semio@table@spec@lll
      \expandafter\semio@table@begin@tabular\expandafter{\semio@table@colspec@three}%
    \else
      \ifx\semio@table@spec\semio@table@spec@nrp
        \expandafter\semio@table@begin@tabular\expandafter{\semio@table@colspec@register}%
      \else
        % LR-cellpad: arbitrary specs (e.g. Allgemein `lllll`) get \tabcolsep of
        % outer inset too, so their first/last columns are not attached to the border.
        \begin{tabular}{@{\hspace{\tabcolsep}}#1@{\hspace{\tabcolsep}}}%
      \fi
    \fi
  \fi
}

\def\semio@table@spec@ll{ll}
\def\semio@table@spec@lll{lll}
\def\semio@table@spec@nrp{nrp}

\newcommand{\SemioTableEnd}{%
  \end{tabular}%
  \endgroup
}

\newenvironment{SemioTable}[1]{%
  \SemioTableBegin{#1}%
}{%
  \SemioTableEnd
}

%region ProjectCatalogue
% 🏗️ Unified project-profile card — used ONLY by anhang/projekte.tex. Collapses
% the former quadruple (\subsection heading + Photo[Bild] + Table[Allgemein] +
% \SemioTableLong[Bauteile]) into ONE bordered longtable per project:
%   • title-chrome row  : project name (left) + P.K.x key (right)
%   • overview band row : photo spanning cols 1–2, metadata spanning cols 3–6
%   • component section : the six Bauteile columns + rows
% Reuses the shared \semio@table@long@render underneath (one continuous border,
% page-break header repeat). The title chrome is driven from the *section* key
% (\thesubsection → P.K.x), NOT from \begin{Table}'s `semiotable` counter, so no
% "Tabelle: P.K.x.b/c" number tabs are emitted. This region calls the shared
% primitives and defines only \semio@project@… / \SemioProject… names; it
% redefines nothing, so every other table in the report is untouched.

\newlength{\semio@project@bandheight}
\setlength{\semio@project@bandheight}{26mm}
% Photo cell inner width = cols 1+2 (0.28·inner) minus the outer chrome inset and
% the photo↔Spender boundary cell-pad, so the image's right edge lands exactly on
% the Spender column's left edge — alignment via the table grid, no coordinates.
% Photo multicolumn spans "|chrome@padding | photo | cellpad" = cols 1+2
% (chrome@padding + 0.28·inner), so photo width = 0.28·inner − cellpad and its
% right edge lands on the col-2/col-3 boundary = the Spender column's left edge.
% Metadata multicolumn spans "cellpad | meta | chrome@padding|" = cols 3–6, so
% meta width = 0.72·inner − cellpad and its text starts at Spender's text edge.
\newcommand{\semio@project@photow}{\dimexpr0.28\semio@table@long@inner@w-\semio@table@long@cellpad\relax}
\newcommand{\semio@project@metaw}{\dimexpr0.72\semio@table@long@inner@w-\semio@table@long@cellpad\relax}

% Continuous-fill colspec for the component section. Each cell gets a canvas
% \cellcolor, and every inter-column pad (plus the outer chrome inset) is a
% canvas-coloured \vrule of the SAME width as the pad it replaces — so the fill
% runs unbroken across the whole row with no cream stripes, and the geometry is
% identical to the standard builder. (Uses \color+\vrule rather than
% \columncolor, which misbehaves in this document's package stack.)
% Pad fills: interior gaps get one cellpad-wide canvas rule from each side (they
% abut → 2·cellpad, matching the two \hspace pads they replace); the two outer
% edges get one combined (chrome+cellpad)-wide rule so the fill reaches the
% border in a single stroke (no seam between abutting rules).
\newcommand{\semio@project@padcp}{{\color{semio-chrome-canvas}\vrule width \semio@table@long@cellpad}}
% Edge fills overlap one cellpad INTO the first/last cell (net width still
% chrome+cellpad) so they cover the cell↔pad seam and meet the border cleanly.
\newcommand{\semio@project@padendL}{{\color{semio-chrome-canvas}\vrule width \dimexpr\semio@chrome@padding+2\semio@table@long@cellpad\relax}\hspace{-\semio@table@long@cellpad}}
\newcommand{\semio@project@padendR}{\hspace{-\semio@table@long@cellpad}{\color{semio-chrome-canvas}\vrule width \dimexpr\semio@chrome@padding+2\semio@table@long@cellpad\relax}}
\newcommand{\semio@project@cellfill}{\cellcolor{semio-chrome-canvas}\raggedright\arraybackslash\hspace{0pt}}
\newcommand{\semio@project@colspec}{%
|@{\semio@project@padendL}>{\semio@project@cellfill}p{\dimexpr0.18\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}p{\dimexpr0.10\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}p{\dimexpr0.26\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}p{\dimexpr0.12\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}p{\dimexpr0.17\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}@{\semio@project@padcp}%
@{\semio@project@padcp}>{\semio@project@cellfill}p{\dimexpr0.17\semio@table@long@inner@w-2\semio@table@long@cellpad\relax}@{\semio@project@padendR}|%
}

% Cover-crop a project photo into an exact width×height box (no frame), reusing
% the window package's CSS object-fit:cover primitive.
\ExplSyntaxOn
\cs_new_protected:Npn \semio_project_photo:nnn #1#2#3 {
  \group_begin:
    \dim_set:Nn \l_semio_image_target_w_dim {#2}
    \dim_set:Nn \l_semio_image_target_h_dim {#3}
    \tl_set:Nn \l_semio_image_fit_tl { cover }
    \tl_gset:cn { semio@window@halign } { center }
    \tl_gset:cn { semio@window@valign } { center }
    \semio_image_typeset_cover:n {#1}
  \group_end:
}
\cs_new_eq:NN \SemioProjectPhoto \semio_project_photo:nnn
\ExplSyntaxOff

% Silent-but-registered project heading: steps the subsection counter (→ P.K.x),
% writes the TOC/running-header/register entries and the \label, but draws no
% visible heading bar (the name is shown once, in the table's title-chrome row).
% Only the two visual chip renderers are blanked (inside a group); the hierarchy
% path — consumed by the register — is re-established explicitly afterwards.
\newcommand{\SemioProjectHeadingSilent}[2]{%
  \begingroup
    \long\def\semio@heading@pair@outline##1##2##3##4##5{}%
    \long\def\semio@heading@title@end@outline##1##2##3{}%
    \long\def\semio@heading@pair##1##2##3##4##5{}%
    \long\def\semio@heading@title@end##1##2##3{}%
    \subsection{#1}\label{#2}%
  \endgroup
  \@ifundefined{semio@hierarchy@path@set}{}{\semio@hierarchy@path@set{\thesubsection}}%
}

% Split the packed "ort & land & jahr & typ & status & quelle" metadata arg.
\def\semio@project@splitmeta#1&#2&#3&#4&#5&#6\relax{%
  \def\semio@project@ort{#1}\def\semio@project@land{#2}\def\semio@project@jahr{#3}%
  \def\semio@project@typ{#4}\def\semio@project@status{#5}\def\semio@project@quelle{#6}%
}

% Metadata subgrid (right of the photo): labelled fields, muted label / normal
% value. Ort/Stadt and Land are separate rows.
\newcommand{\semio@project@meta}[6]{%
  \begingroup
  \setlength{\extrarowheight}{0pt}%
  \renewcommand{\arraystretch}{1.2}%
  \begin{tabular}[t]{@{}>{\color{semio-chrome-foreground}}l@{\hspace{1.2em}}>{\color{semio-chrome-text-normal}}l@{}}
    Stadt & #1\tabularnewline
    Land & #2\tabularnewline
    Jahr & #3\tabularnewline
    Typ & #4\tabularnewline
    Status & #5\tabularnewline
    Quelle & #6\tabularnewline
  \end{tabular}%
  \endgroup
}

% Overview band row: photo multicolumn (cols 1–2) + metadata multicolumn (cols
% 3–6). The two multicolumns re-supply the outer border and mirror the base
% colspec's edge padding, so the shared boundary falls on the Spender edge.
\newcommand{\semio@project@overview@band}[7]{%
  \multicolumn{2}{|@{\hspace{\semio@chrome@padding}}p{\semio@project@photow}@{\hspace{\semio@table@long@cellpad}}}{%
    \cellcolor{semio-chrome-canvas}%
    \begin{minipage}[t]{\linewidth}\vspace{0pt}%
      \SemioProjectPhoto{#1}{\linewidth}{\semio@project@bandheight}%
    \end{minipage}%
  }%
  &
  \multicolumn{4}{@{}>{\raggedright\arraybackslash}p{\dimexpr\semio@project@metaw+\semio@table@long@cellpad\relax}@{\hspace{\semio@chrome@padding}}|}{%
    \cellcolor{semio-chrome-canvas}%
    \begin{minipage}[t]{\linewidth}\vspace{0pt}%
      \semio@project@meta{#2}{#3}{#4}{#5}{#6}{#7}%
    \end{minipage}%
  }%
  % 3–5pt breathing room on BOTH sides of the dividing rule between the overview
  % band and the component section, while keeping the rule itself.
  \\\noalign{\vskip 4pt}\hline\noalign{\vskip 4pt}%
}

\newcommand{\semio@project@long@render@call}[2]{%
  \semio@table@long@render{#1}{\semio@project@firsthead}{\semio@project@head}{#2}{6}%
}

% \SemioProject{name}{label}{image}{ort & land & jahr & typ & status & quelle}{rows}
\newcommand{\SemioProject}[5]{%
  \SemioCardKeep
  \SemioProjectHeadingSilent{#1}{#2}%
  \protected@edef\semio@project@key{\thesubsection}%
  \gdef\semio@window@header@title{#1}%
  \global\let\semio@window@header@number\semio@project@key
  \semio@table@long@prepare{0.18,0.10,0.26,0.12,0.17,0.17}{Bauteil / Menge & Material & Spender & ReUse-Ort & Schicht & Prozess}%
  \semio@project@splitmeta#4\relax
  \long\def\semio@project@firsthead{%
    \semio@project@overview@band{#3}%
      {\semio@project@ort}{\semio@project@land}{\semio@project@jahr}%
      {\semio@project@typ}{\semio@project@status}{\semio@project@quelle}%
    \semio@table@long@head@current
  }%
  \long\def\semio@project@head{\semio@table@long@head@continuation@current}%
  % Render with the project colspec (continuous canvas via \columncolor overhangs)
  % instead of the default one, so the fill runs through the whole table — header
  % and every row — with no cream gaps between columns.
  \expandafter\semio@project@long@render@call\expandafter{\semio@project@colspec}{#5}%
}
%endregion ProjectCatalogue
