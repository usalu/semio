    \csname semio@#1@header@definition\endcsname &
    \csname semio@#1@header@pages\endcsname
  }%
}

\newcommand{\semio@termlist@table@header@long@repeat}[1]{%
  \semio@table@long@header@continuation@three
    {0.22}
    {\csname semio@#1@header@term\endcsname}
    {\csname semio@#1@header@definition\endcsname}
    {\csname semio@#1@header@pages\endcsname}%
