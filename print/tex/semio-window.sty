\keys_define:nn { semio / window / kind } {
  title .tl_set:N = \l_semio_window_kind_title_tl,
}

\cs_new_protected:Npn \semio_window_tier_header:nnn #1 #2 #3 {
  \str_case:nn { #3 } {
    { visual } { \semio@window@header { semio-primary } {#1} {#2} }
    { logical } { \semio@window@header { semio-secondary } {#1} {#2} }
    { structural } { \semio@window@header { semio-tertiary } {#1} {#2} }
  }
}

\cs_new_protected:Npn \semio_window_kind_begin:nnn #1 #2 #3 {
  \tl_clear:N \l_semio_window_kind_title_tl
  \keys_set:nn { semio / window / kind } { #3 }
  \refstepcounter {#1}
  \tl_if_empty:NTF \l_semio_window_kind_title_tl {
    \tl_set:Nx \l_semio_window_kind_title_tl { \use:c { semio@window@#1@label } }
  } { }
  \tl_set:Nx \l_semio_window_number_tl { \use:c { the #1 } }
  \addvspace { \semio@spacing@single }
  \semio_window_tier_header:nnn
    { \tl_use:N \l_semio_window_kind_title_tl }
    { \tl_use:N \l_semio_window_number_tl }
    { #2 }
  \noindent
  \begin{tcolorbox}[semio~window~tier~#2]
}

\cs_new_protected:Npn \semio_window_kind_define:nnn #1 #2 #3 {
  \newcounter {#1}
  \tl_const:cn { semio@window@#1@label } {#2}
  \tl_const:cn { semio@window@#1@tier } {#3}
  \exp_args:Ne \NewDocumentEnvironment { #2 } { O{} } {
    \semio_window_kind_begin:nnn {#1} {#3} {##1}
  } {
    \end{tcolorbox}
  }
}

\semio_window_kind_define:nnn { semioimage } { Image } { visual }
\semio_window_kind_define:nnn { semiophoto } { Photo } { visual }
\semio_window_kind_define:nnn { semiofigure } { Figure } { visual }
