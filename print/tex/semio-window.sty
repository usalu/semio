\newdimen\semio@panel@shipout@x
\newdimen\semio@panel@shipout@y

\newcommand{\semio@panel@draw}[4]{%
  \IfFileExists{.semio-panel-glass/\jobname/#1.png}{%
    \semio@panel@shipout@glass{#1}{#2}{#3}{#4}%
  }{%
    \IfFileExists{.semio-panel-glass/\jobname/.ready}{%
      \semio@panel@shipout@fallback{#1}{#2}{#3}{#4}%
    }{}%
  }%
}

\newcommand{\semio@panel@shipout@glass}[4]{%
  \put(\LenToUnit{\semio@panel@shipout@x},\LenToUnit{\semio@panel@shipout@y}){%
    \makebox(0,0)[bl]{%
      \setlength{\fboxsep}{\semio@chrome@padding}%
      \setlength{\fboxrule}{\semio@stroke@hairline}%
      \begingroup
      \color{semio-chrome-border-normal}%
      \fbox{%
        \begin{minipage}[c][#4][c]{\dimexpr#2-2\fboxsep-2\fboxrule\relax}%
          \rlap{%
            \vbox to #4{%
              \vfil
              \resizebox{\linewidth}{#4}{%
                \includegraphics{.semio-panel-glass/\jobname/#1.png}%
              }%
              \vfil
            }%
          }%
          \centering
          \color{semio-chrome-text-normal}%
          {\SemioSans\fontsize{\semio@chrome@font@body}{\semio@chrome@font@body}\selectfont\expandafter\usebox\csname semio@panel@box@#3\endcsname}%
        \end{minipage}%
      }%
      \endgroup
    }%
  }%
}

\newcommand{\semio@panel@shipout@fallback}[4]{%
  \put(\LenToUnit{\semio@panel@shipout@x},\LenToUnit{\semio@panel@shipout@y}){%
    \makebox(0,0)[bl]{%
      \setlength{\fboxsep}{\semio@chrome@padding}%
      \setlength{\fboxrule}{\semio@stroke@hairline}%
      \fcolorbox{semio-chrome-border-normal}{semio-chrome-panel!58}{%
        \begin{minipage}[c][#4][c]{\dimexpr#2-2\fboxsep-2\fboxrule\relax}%
          \centering
          \color{semio-chrome-text-normal}%
          {\SemioSans\fontsize{\semio@chrome@font@body}{\semio@chrome@font@body}\selectfont\expandafter\usebox\csname semio@panel@box@#3\endcsname}%
        \end{minipage}%
      }%
    }%
  }%
}

\newcommand{\semio@panel@storebox}[1]{%
  \expandafter\newbox\csname semio@panel@box@#1\endcsname
  \expandafter\global\expandafter\setbox\csname semio@panel@box@#1\endcsname=\box\semio@panel@content@box
}

\newcommand{\semio@panel@add@shipout}[1]{%
  \AddToShipoutPictureFG*{\csname #1\endcsname}%
}

\def\semio@chrome@heading{}

\newsavebox{\semio@window@cap@slot}
\newsavebox{\semio@window@tab@box}
\newsavebox{\semio@window@ctrl@box}
\newlength{\semio@window@gap@w}
\newlength{\semio@window@cap@w}
\newlength{\semio@window@cap@body@h}

\newcommand{\semio@window@cap@body@h@set}{%
  \setlength{\semio@window@cap@body@h}{%
    \dimexpr\semio@chrome@titlebar@height-\semio@stroke@hairline\relax
  }%
}

\newcommand{\semio@window@stroke@v}[1]{%
  \color{#1}%
  \rule{\semio@stroke@hairline}{\semio@chrome@titlebar@height}%
}

\newcommand{\semio@window@stroke@h}[2]{%
  \color{#1}%
  \rule{\dimexpr#2\relax}{\semio@stroke@hairline}%
}

\newcommand{\semio@window@cap}[3]{%
  \semio@window@cap@body@h@set
  \sbox{\semio@window@cap@slot}{%
    \begingroup
    #3\relax
    \hspace{\semio@chrome@padding}#2\hspace{\semio@chrome@padding}%
    \endgroup
  }%
  \setlength{\semio@window@cap@w}{\wd\semio@window@cap@slot}%
  \hbox{%
    \semio@window@stroke@v{#1}%
    \vbox to \semio@chrome@titlebar@height{%
      \nointerlineskip
      \hbox{\semio@window@stroke@h{#1}{\semio@window@cap@w}}%
      \nointerlineskip
      \hbox{%
        \begingroup
        \setlength{\fboxsep}{0pt}%
        \colorbox{#1}{%
          \vbox to \semio@window@cap@body@h{%
            \vfil
            \nointerlineskip
            \hbox to \semio@window@cap@w{%
              \hfil\usebox{\semio@window@cap@slot}\hfil
            }%
            \vfil
          }%
        }%
        \endgroup
      }%
    }%
    \semio@window@stroke@v{#1}%
  }%
}

\newcommand{\semio@window@tab}[2]{%
  \semio@window@cap{#1}{#2}{%
    \SemioSans\fontsize{\semio@chrome@font@title}{\semio@chrome@font@title}\selectfont\color{semio-chrome-canvas}%
  }%
}

\newcommand{\semio@window@ctrl}[2]{%
  \semio@window@cap{#1}{#2}{%
    \SemioSans\fontsize{\semio@chrome@font@number}{\semio@chrome@font@number}\selectfont\color{semio-chrome-canvas}%
  }%
}

\newcommand{\semio@window@gap}[1]{%
  \semio@window@cap@body@h@set
  \hbox to \dimexpr\semio@window@gap@w\relax{%
    \vbox to \semio@chrome@titlebar@height{%
      \nointerlineskip
      \hbox to \dimexpr\semio@window@gap@w\relax{%
        \begingroup
        \setlength{\fboxsep}{0pt}%
        \colorbox{#1}{%
          \vbox to \semio@window@cap@body@h{%
            \vfil\null\vfil
          }%
        }%
        \endgroup
      }%
      \nointerlineskip
      \hbox to \dimexpr\semio@window@gap@w\relax{%
        \semio@window@stroke@h{#1}{\semio@window@gap@w}%
      }%
    }%
  }%
}

\newcommand{\semio@window@header}[3]{%
  \sbox{\semio@window@tab@box}{\semio@window@tab{#1}{#2}}%
  \sbox{\semio@window@ctrl@box}{%
    \if\relax\detokenize{#3}\relax
      \hbox{}%
    \else
      \semio@window@ctrl{#1}{#3}%
    \fi
  }%
  \setlength{\semio@window@gap@w}{%
    \dimexpr\linewidth-\wd\semio@window@tab@box-\wd\semio@window@ctrl@box\relax
  }%
  \noindent
  \hbox to \linewidth{%
    \usebox{\semio@window@tab@box}%
    \semio@window@gap{#1}%
    \usebox{\semio@window@ctrl@box}%
  }%
  \par\nointerlineskip
}

