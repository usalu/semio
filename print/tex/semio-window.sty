%region WindowBreakParts state
% 🧩 Two-pass (aux-file) state for the page-break part suffix (":<N>") on the
% hierarchy chip — mirrors the `.register-toc` write-this-pass/read-next-pass
% convention already used by \semio_window_toc_append:nnn above. Key = the
% *unsuffixed* register number (\l_semio_window_register_number_tl, e.g.
% "1.2.3.4.a") so this never touches the hierarchy path, the register/TOC
% number, or any \label/\ref target — purely a display-time lookup.
\tl_new:N \g_semio_window_current_regnum_tl
\prop_new:N \g_semio_window_break_prop
\iow_new:N \g_semio_window_break_iow
\bool_new:N \g_semio_window_break_iow_open_bool
