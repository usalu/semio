  \ifcsname semio@heading@color@#1\endcsname
    \semio@koma@heading@lines{#1}{\csname semio@heading@color@#1\endcsname}{#4}{#3}%
  \else
    \semio@koma@heading@lines@muted{#4}{#3}%
  \fi
}

\newcommand{\semio@heading@install@spacing}[1]{%
  \RedeclareSectionCommand[
    beforeskip=\semio@block@sep@before@skip,
    afterskip=\semio@block@sep@skip,
  ]{#1}%
}

\newcommand{\semio@heading@installall}{%
  \def\semio@heading@color@chapter{semio-secondary}%
  \def\semio@heading@color@section{semio-tertiary}%
  \def\semio@heading@color@subsection{semio-secondary}%
  \def\semio@heading@color@subsubsection{semio-primary}%
  \ifcsname chapter\endcsname
    \setkomafont{chapter}{\semio@heading@chip@font}%
  \fi
  \setkomafont{section}{\semio@heading@chip@font}%
  \setkomafont{subsection}{\semio@heading@chip@font}%
  \setkomafont{subsubsection}{\semio@heading@chip@font}%
  \setkomafont{paragraph}{\semio@heading@chip@font}%
  \let\semio@orig@sectionlinesformat\sectionlinesformat
  \RenewDocumentCommand\sectionlinesformat{mmmm}{%
    \semio@heading@lines@dispatch{##1}{##2}{##3}{##4}%
  }%
  \ifcsname chapterlinesformat\endcsname
    \let\semio@orig@chapterlinesformat\chapterlinesformat
    \RenewDocumentCommand\chapterlinesformat{mmm}{%
      \semio@koma@heading@lines{chapter}{\semio@heading@color@chapter}{##3}{##2}%
    }%
  \fi
  \ifcsname chapter\endcsname
    \semio@heading@install@spacing{chapter}%
  \fi
  \semio@heading@install@spacing{section}%
  \semio@heading@install@spacing{subsection}%
  \semio@heading@install@spacing{subsubsection}%
  \semio@heading@install@spacing{paragraph}%
}

