  % compact list contexts, where it would loosen inter-item spacing past the
  % surrounding body text. Reset it locally at each list start via etoolbox hooks
  % (this build's LaTeX predates the kernel env/.../begin hooks).
  \AtBeginEnvironment{itemize}{\setlength{\parskip}{\z@}}%
