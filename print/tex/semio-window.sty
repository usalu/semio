\newcommand{\semio@heading@install}[3]{%
  \titleformat{#1}[block]{}{}{0pt}{%
    \semio@chrome@heading@track{#3}{##1}%
    \semio@if@heading@chips
      {%
        \if\relax\detokenize{\csname #3\endcsname}\relax
          \semio@heading@title@end{#2}{semio-chrome-foreground}{##1}%
        \else
          \semio@heading@pair{#2}{semio-chrome-foreground}{#3}{#3}{##1}%
        \fi
      }%
      {##1}%
  }%
  \titlespacing*{#1}{0pt}{\semio@spacing@double}{\semio@spacing@single}%
}

\newcommand{\semio@heading@installall}{%
  \semio@heading@install{\part}{semio-tertiary}{part}%
  \@ifundefined{chapter}{}{%
    \semio@heading@install{\chapter}{semio-secondary}{chapter}%
  }%
  \semio@heading@install{\section}{semio-primary}{section}%
  \semio@heading@install{\subsection}{semio-secondary}{subsection}%
  \semio@heading@install{\subsubsection}{semio-chrome-border-normal}{subsubsection}%
  \titleformat{\paragraph}[block]{}{}{0pt}{%
    \semio@if@heading@chips
      {%
        \if\relax\detokenize{\theparagraph}\relax
          \semio@heading@title@end@muted{##1}%
        \else
          \semio@heading@pair@muted{paragraph}{paragraph}{##1}%
        \fi
      }%
      {##1}%
  }%
  \titlespacing*{\paragraph}{0pt}{\semio@spacing@double}{\semio@spacing@single}%
}
