\cs_new:Npn \semio_window_frame_dims_seq_name: { g_semio_window_items_dims_seq_ \int_use:N \g_semio_window_depth_int }

\fp_new:N \l_semio_window_weight_item_fp
\fp_new:N \l_semio_window_weight_sum_fp
\dim_new:N \l_semio_window_gap_total_dim
\dim_new:N \l_semio_window_overhead_total_dim
\dim_new:N \l_semio_window_available_dim
\dim_new:N \l_semio_window_unit_dim

% Operates implicitly on the current frame (see \semio_window_frame_push:):
% reads the frame's weight seq, writes its dims seq. #1 = total available dim
% expr, #2 = fixed per-item overhead dim expr (subtracted once for every
% item, e.g. each item's own titlebar chrome, which is drawn separately from
% — and in addition to — the height=X box this computes); the returned dims
% do NOT include that item's own overhead.
\cs_new:Npn \semio_window_frame_weight_count: { \exp_args:Nc \seq_count:N { \semio_window_frame_weight_seq_name: } }

\cs_new_protected:Npn \semio_window_weights_to_dims:nn #1 #2 {
  \exp_args:Nc \seq_clear:N { \semio_window_frame_dims_seq_name: }
  \int_compare:nNnT { \semio_window_frame_weight_count: } > { 0 } {
    \fp_set:Nn \l_semio_window_weight_sum_fp { 0 }
    \exp_args:Nc \seq_map_inline:Nn { \semio_window_frame_weight_seq_name: } {
      \fp_set:Nn \l_semio_window_weight_sum_fp {
        \fp_eval:n { \fp_use:N \l_semio_window_weight_sum_fp + { ##1 } }
      }
    }
    % NB: a plain-TeX \dimexpr/l3 \dim_eval:n juxtaposition like "<int><dim>"
    % (intended as int-times-dim multiplication, e.g. count\some@macro) is
    % NOT safe here — TeX's dimen scanner greedily absorbs leading digits
    % across the macro-expansion boundary (e.g. "4" immediately followed by
    % a macro expanding to "4.0pt" reads as the single dimension "44.0pt",
    % not "4 * 4.0pt"). Route the multiplication through \fp_eval:n on a
    % decimal extracted from a real dim register instead, which has no such
    % token-adjacency hazard.
    \int_compare:nNnTF { \semio_window_frame_weight_count: } > { 1 } {
      \group_begin:
      \ExplSyntaxOff
      \makeatletter
      \xdef\semio@window@gap@pt{\the\semio@window@gap}
      \makeatother
      \group_end:
      \dim_set:Nn \l_semio_window_unit_dim { \semio@window@gap@pt }
      \dim_set:Nn \l_semio_window_gap_total_dim {
        \dim_eval:n {
          \fp_eval:n { \dim_to_decimal:n { \l_semio_window_unit_dim } * ( \semio_window_frame_weight_count: - 1 ) } pt
        }
      }
    } {
      \dim_zero:N \l_semio_window_gap_total_dim
    }
    \group_begin:
    \ExplSyntaxOff
    \makeatletter
    \xdef\semio@window@overhead@pt{\the\dimexpr #2 \relax}
    \makeatother
    \group_end:
    \dim_set:Nn \l_semio_window_unit_dim { \semio@window@overhead@pt }
    \dim_set:Nn \l_semio_window_overhead_total_dim {
      \dim_eval:n {
        \fp_eval:n { \dim_to_decimal:n { \l_semio_window_unit_dim } * \semio_window_frame_weight_count: } pt
      }
    }
    \dim_set:Nn \l_semio_window_available_dim {
      \dim_eval:n { (#1) - \l_semio_window_gap_total_dim - \l_semio_window_overhead_total_dim }
    }
    \exp_args:Nc \seq_map_inline:Nn { \semio_window_frame_weight_seq_name: } {
      \fp_set:Nn \l_semio_window_weight_item_fp { { ##1 } }
      \exp_args:Nc \seq_put_right:Nx { \semio_window_frame_dims_seq_name: } {
        \dim_eval:n {
          \fp_eval:n {
            \dim_to_decimal:n { \l_semio_window_available_dim }
            * \fp_use:N \l_semio_window_weight_item_fp / \fp_use:N \l_semio_window_weight_sum_fp
          } pt
        }
      }
    }
  }
}
