\keys_define:nn { semio / semiobox } {
  title .tl_set:N = \l_semio_semiobox_title_tl,
}

\cs_new_protected:Npn \semio_window_header:nn #1 #2 {
  \hbox_set:Nn \l_semio_window_tab_box { \tcbox[semio~window~tab]{#1} }
  \hbox_set:Nn \l_semio_window_controls_box { \tcbox[semio~window~controls]{#2} }
  \dim_set:Nn \l_semio_window_header_width_dim { \linewidth }
  \dim_set:Nn \l_semio_window_gap_dim {
    \dimexpr\l_semio_window_header_width_dim
      - \box_wd:N \l_semio_window_tab_box
      - \box_wd:N \l_semio_window_controls_box \relax
  }
  \noindent
  \vtop{%
    \hbox to \l_semio_window_header_width_dim {%
      \box_use:N \l_semio_window_tab_box
      \tcbox[semio~window~gap, width=\l_semio_window_gap_dim]{~}%
      \box_use:N \l_semio_window_controls_box
    }%
  }%
  \par\nointerlineskip
}

\cs_new_protected:Npn \semio_window_close_chapter_body: {
  \bool_if:NT \l_semio_window_chapter_open_bool {
    \end{tcolorbox}
    \bool_set_false:N \l_semio_window_chapter_open_bool
  }
}

\cs_new_protected:Npn \semio_window_close_section: {
  \bool_if:NT \l_semio_window_section_open_bool {
    \end{tcolorbox}
    \bool_set_false:N \l_semio_window_section_open_bool
  }
}

\cs_new_protected:Npn \semio_window_close_chapter: {
  \semio_window_close_section:
  \semio_window_close_chapter_body:
}

\cs_new_protected:Npn \semio_window_open_chapter:n #1 {
  \semio_window_close_chapter:
  \clearpage
  \refstepcounter{chapter}
  \chaptermark{#1}
  \tl_gset:Nn \g_semio_current_heading_tl {#1}
  \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter}#1}
  \semio_window_header:nn {#1} { \thechapter }
  \begin{tcolorbox}[semio~window~chapter]
  \bool_set_true:N \l_semio_window_chapter_open_bool
}

\cs_new_protected:Npn \semio_window_open_section:n #1 {
  \semio_window_close_section:
  \semio_window_close_chapter_body:
  \refstepcounter{section}
  \sectionmark{#1}
  \tl_gset:Nn \g_semio_current_heading_tl {#1}
  \addcontentsline{toc}{section}{\protect\numberline{\thesection}#1}
  \semio_window_header:nn {#1} { \thesection }
  \begin{tcolorbox}[semio~window]
  \bool_set_true:N \l_semio_window_section_open_bool
}

\cs_new_protected:Npn \semio_window_semiobox_begin:n #1 {
  \tl_clear:N \l_semio_semiobox_title_tl
  \keys_set:nn { semio / semiobox } { #1 }
  \bool_if:NTF \l_semio_window_chapter_open_bool {
    \begin{tcolorbox}[semio~window~inner, #1]
  } {
    \bool_if:NTF \l_semio_window_section_open_bool {
      \begin{tcolorbox}[semio~window~inner, #1]
    } {
      \tl_if_empty:NTF \l_semio_semiobox_title_tl {
        \begin{tcolorbox}[semio~window~boxed, #1]
      } {
        \semio_window_header:nn { \tl_use:N \l_semio_semiobox_title_tl } { }
        \begin{tcolorbox}[semio~window, #1]
      }
    }
  }
}

\@ifundefined{chapter}{
}{
  \let\semio@koma@chapter\chapter
  \RenewDocumentCommand{\chapter}{s m}{
    \semio_window_open_chapter:n {#2}
  }
  \AddToHook{cmd/tableofcontents/before}{%
    \let\semio@saved@chapter\chapter
    \let\chapter\semio@koma@chapter
  }
  \AddToHook{cmd/tableofcontents/after}{%
    \let\chapter\semio@saved@chapter
  }
  \AddToHook{cmd/listoffigures/before}{%
    \let\semio@saved@chapter\chapter
    \let\chapter\semio@koma@chapter
  }
  \AddToHook{cmd/listoftables/before}{%
    \let\semio@saved@chapter\chapter
    \let\chapter\semio@koma@chapter
  }
  \AddToHook{cmd/listoffigures/after}{%
    \let\chapter\semio@saved@chapter
  }
  \AddToHook{cmd/listoftables/after}{%
    \let\chapter\semio@saved@chapter
  }
}

\RenewDocumentCommand{\section}{s m}{
  \semio_window_open_section:n {#2}
}

\NewDocumentEnvironment{Semiobox}{O{}}{%
  \semio_window_semiobox_begin:n {#1}%
}{%
  \end{tcolorbox}%
}

