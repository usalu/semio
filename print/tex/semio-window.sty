\newcommand{\semio@heading@wrap@install}{%
  \ifcsname c@part\endcsname
    \semio@heading@wrap@part
  \fi
  \ifcsname c@chapter\endcsname
    \semio@heading@wrap@chapter
  \fi
  \semio@heading@wrap@section
  \semio@heading@wrap@subsection
  \semio@heading@wrap@subsubsection
  \semio@heading@wrap@paragraph
}

\newcommand{\semio@heading@install}[3]{%
  \titleformat{#1}[block]{}{}{0pt}{%
    \semio@chrome@heading@track{#3}{##1}%
    \semio@if@heading@chips
      {%
        \if\relax\detokenize{\csname the#3\endcsname}\relax
          \semio@heading@title@end{#2}{semio-chrome-foreground}{##1}%
        \else
          \semio@heading@pair{#2}{semio-chrome-foreground}{#3}{#3}{##1}%
        \fi
      }%
      {##1}%
