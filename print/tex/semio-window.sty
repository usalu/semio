\cs_new_protected:Npn \semio_image_graphics:n #1 {
  \exp_args:Nx \semio_image_target_w_sync:n { \dim_use:N \l_semio_image_target_w_dim }
  \semio@image@graphics@w { \semio@image@target@w@plain } {#1}
}

% 🖼 Renders width-only (see \semio_image_typeset:n's "contain" branch for
% why a WindowItem image can never let the box's own fixed height reach the
% *sizing* of the graphic), then clips the result to that height via a
% TikZ path — a value used only as a clip boundary on an already-rendered
% box, never as an input to how large the graphic itself is drawn. Without
% this, a portrait photo in a short item column would render at its full
% (width-bound) height and spill into whatever follows it in the layout.
\newsavebox{\semio@image@itemclip@box}
\cs_new_protected:Npn \semio_image_graphics_itemclip:n #1 {
  \exp_args:Nx \semio_image_target_w_sync:n { \dim_use:N \l_semio_image_target_w_dim }
  \sbox{\semio@image@itemclip@box}{\semio@image@graphics@w{\semio@image@target@w@plain}{#1}}
  \dim_compare:nNnTF {
    \dim_eval:n { \ht\semio@image@itemclip@box + \dp\semio@image@itemclip@box }
  } > { \l_semio_image_target_h_dim } {
    \leavevmode
    \begin{tikzpicture}[baseline=0pt]
      \path[clip] (0,0) rectangle (\the\wd\semio@image@itemclip@box, \dim_use:N \l_semio_image_target_h_dim);
      \pgftext[left,top,x=0pt,y=\dim_use:N \l_semio_image_target_h_dim]{\usebox{\semio@image@itemclip@box}}
    \end{tikzpicture}
  } {
    \usebox{\semio@image@itemclip@box}
  }
}

\cs_new_protected:Npn \semio_image_target_w_sync:n #1 {
  \xdef\semio@image@target@w@plain{#1}
}

\cs_new_protected:Npn \semio_image_target_wh_sync:nn #1#2 {
  \xdef\semio@image@target@w@plain{#1}
  \xdef\semio@image@target@h@plain{#2}
}

% 🖼 See \semio_image_typeset:n's "contain" branch for why this is now only
% ever reached outside a WindowItem — a height-bound image rendered while
% its own enclosing tcolorbox also carries that same fixed height made
% tcolorbox typeset the box body twice, confirmed by counting
% \includegraphics invocations via debug \typeout in isolation. That
% happened regardless of how the height reached the draw call (this
% function's own width+height keys, an equivalent \scalebox transform, even
% a heavily-downscaled one) — the common factor was using the height value
% at all while inside the box, not the resulting rendered size.
\cs_new_protected:Npn \semio_image_graphics_wh:n #1 {
  \exp_args:Nxx \semio_image_target_wh_sync:nn
    { \dim_use:N \l_semio_image_target_w_dim }
    { \dim_use:N \l_semio_image_target_h_dim }
  \semio@image@graphics@wh
    { \semio@image@target@w@plain }
    { \semio@image@target@h@plain }
    {#1}
}

\cs_new_protected:Npn \semio_image_graphics_fill:n #1 {
  \exp_args:Nxx \semio_image_target_wh_sync:nn
    { \dim_use:N \l_semio_image_target_w_dim }
    { \dim_use:N \l_semio_image_target_h_dim }
  \semio@image@graphics@fill
    { \semio@image@target@w@plain }
    { \semio@image@target@h@plain }
    {#1}
}

\cs_new_protected:Npn \semio_image_graphics_none:n #1 {
  \semio@image@graphics@none {#1}
}

\cs_new_protected:Npn \semio_image_typeset:n #1 {
  \bool_if:NTF \l_semio_image_width_set_bool {
    \dim_set_eq:NN \l_semio_image_target_w_dim \l_semio_image_width_dim
  } {
    \semio_image_default_width_resolve:
  }
  \semio_image_target_h_resolve:
  \str_case:VnTF \l_semio_image_fit_tl {
    { none } {
      \semio_image_graphics_none:n {#1}
    }
    { fill } {
      \semio_image_bounded_height_required:n { fill }
      \semio_image_graphics_fill:n {#1}
    }
    { cover } {
      % 🎯 Cover derives one proportional render dimension from the source
      % ratio, clips locally, and relies on the cover window's outer clip as
      % the CSS-like overflow boundary for the tcolorbox/driver paint pass.
      \semio_image_bounded_height_required:n { cover }
      \dim_set:Nn \l_semio_image_target_w_dim { \linewidth }
      \semio_image_typeset_cover:n {#1}
    }
    { contain } {
      % 🖼 A window-height-bound "contain" image, rendered while its own
      % enclosing tcolorbox also carries that same fixed height (only
      % reachable via WindowArrangement — introduced this session for the
      % Projekte Katalog), makes tcolorbox typeset the box body twice —
      % confirmed by counting \includegraphics invocations via debug
      % \typeout in isolation, and confirmed to depend specifically on
      % whether the *height*-derived value feeds into how large the graphic
      % itself is drawn (width+height keys, an equivalent \scalebox
      % transform, even a heavily-downscaled one, all showed it). Using
      % that same value only as a clip boundary on an already width-sized
      % box (\semio_image_graphics_itemclip:n) does not.
      \bool_if:NTF \l_semio_window_in_item_bool {
        \bool_if:NTF \g_semio_image_target_h_set_bool {
          \semio_image_graphics_itemclip:n {#1}
        } {
          \semio_image_graphics:n {#1}
        }
      } {
        \bool_if:NTF \g_semio_image_target_h_set_bool {
          \semio_image_graphics_wh:n {#1}
        } {
          \semio_image_graphics:n {#1}
        }
      }
    }
  } {
    \bool_if:NTF \l_semio_window_in_item_bool {
      \bool_if:NTF \g_semio_image_target_h_set_bool {
        \semio_image_graphics_itemclip:n {#1}
      } {
        \semio_image_graphics:n {#1}
      }
    } {
      \bool_if:NTF \g_semio_image_target_h_set_bool {
        \semio_image_graphics_wh:n {#1}
      } {
        \semio_image_graphics:n {#1}
      }
    }
  }
}

\cs_new_protected:Npn \semio_image:nn #1#2 {
  \tl_set:Nx \l_semio_image_fit_tl { \semio@window@imagefit }
  \bool_set_false:N \l_semio_image_width_set_bool
