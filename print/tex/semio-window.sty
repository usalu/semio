  \bool_if:NF \g_semio_window_break_iow_open_bool {
    \iow_open:Nn \g_semio_window_break_iow { \c_sys_jobname_str .window-breaks }
    \bool_gset_true:N \g_semio_window_break_iow_open_bool
  }
}

\cs_new_protected:Npn \semio_window_break_aux_line:nn #1#2 {
  \prop_gput:Nnn \g_semio_window_break_prop {#1} {#2}
}
\cs_new_protected:Npn \SemioWindowBreakLine #1#2 { \semio_window_break_aux_line:nn {#1}{#2} }

\cs_new_protected:Npn \semio_window_break_aux_input:n #1 {
  \file_if_exist_input:n {#1} { }
}

\cs_new_protected:Npn \semio_window_break_aux_load: {
  \prop_gclear:N \g_semio_window_break_prop
  \file_if_exist_input:n { \c_sys_jobname_str .window-breaks } { }
  \prop_if_empty:NT \g_semio_window_break_prop {
    \str_set:Nx \l_tmpa_str { dist / \c_sys_jobname_str .window-breaks }
    \semio_window_break_aux_input:n { \l_tmpa_str }
  }
}

\cs_new_protected:Npn \semio_window_break_write:nn #1#2 {
  \tl_if_empty:nF {#1} {
