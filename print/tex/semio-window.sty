          {\SemioSans\fontsize{\semio@chrome@font@chip}{\semio@chrome@font@chip}\selectfont\expandafter\usebox\csname semio@panel@box@#3\endcsname}%
        \end{minipage}%
      }%
    }%
  }%
}

