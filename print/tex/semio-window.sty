}

\cs_new_protected:Npn \semio_chrome_navbar_icon_dim: {
  \dimexpr\semio@chrome@navbar@height - 2 \semio@chrome@padding \relax
}

\cs_new_protected:Npn \semio_chrome_group_icon_dim: {
  \dimexpr\semio@chrome@titlebar@height - 2 \semio@chrome@padding \relax
}

\cs_new_protected:Npn \semio_chrome_group:nn #1 #2 {
  \tcbox[
    semio~chrome~group,
    nobeforeafter,
    boxsep=0pt,
    #1,
  ] { #2 }
}

\cs_new_protected:Npn \semio_chrome_navbar_bar:n #1 {
  \vbox {%
    \nointerlineskip
    \hbox {%
      \setlength { \fboxsep } { 0pt }%
      \colorbox { semio-chrome-window } {%
        \parbox [ c ] [ \semio@chrome@navbar@height ] [ c ] { \headwidth } { #1 }%
      }%
    }%
    \nointerlineskip
    \hbox to \headwidth {%
      \color { semio-chrome-border-normal }%
      \rule { \headwidth } { \semio@stroke@hairline }%
    }%
  }%
}

\cs_new_protected:Npn \semio_chrome_footer_bar:n #1 {
  \vbox {%
    \nointerlineskip
    \hbox to \headwidth {%
      \color { semio-chrome-border-normal }%
      \rule { \headwidth } { \semio@stroke@hairline }%
    }%
    \nointerlineskip
    \hbox {%
      \setlength { \fboxsep } { 0pt }%
      \colorbox { semio-chrome-window } {%
        \parbox [ c ] [ \semio@chrome@footer@height ] [ c ] { \headwidth } { #1 }%
      }%
    }%
  }%
}

\cs_new_protected:Npn \semio_navbar_apply: {
  \fancyhead[C] {%
    \semio_chrome_navbar_bar:n {%
      \hbox to \headwidth {%
        \hspace { \semio@chrome@padding }%
        \semioemblem [ 1em ]%
        \hspace { \semio@spacing@compact }%
        { \SemioSans \fontsize { \semio@chrome@font@body } { \semio@chrome@navbar@height } \selectfont \@title }%
        \hfil
        \tl_if_empty:NF \g_semio_current_heading_tl {
          \semio_chrome_group:nn { } { \tl_use:N \g_semio_current_heading_tl }
        }%
        \hspace { \semio@chrome@padding }%
      }%
    }%
  }%
}

\cs_new_protected:Npn \semio_footer_apply: {
  \fancyfoot[C] {%
    \semio_chrome_footer_bar:n {%
      \hbox to \headwidth {%
        \hspace { \semio@chrome@padding }%
        \semio_chrome_group:nn { } {%
          \semioemblem [ 0.75em ]%
          \hspace { \semio@spacing@compact }%
          { \SemioSans \fontsize { \semio@chrome@font@number } { \semio@chrome@titlebar@height } \selectfont \@author }%
        }%
        \hfil
        { \SemioMono \fontsize { \semio@chrome@font@number } { \semio@chrome@footer@height } \selectfont \thepage }%
        \hspace { \semio@chrome@padding }%
      }%
    }%
  }%
}

\cs_new_protected:Npn \semio_header_footer_apply: {
  \pagestyle { fancy }
  \fancyhf { }
  \semio_navbar_apply:
  \semio_footer_apply:
  \renewcommand { \headrulewidth } { 0pt }
  \renewcommand { \footrulewidth } { 0pt }
}

\AddToHook{begindocument}{\semio_header_footer_apply:}

\ExplSyntaxOff

\setlength{\headheight}{\dimexpr\semio@chrome@navbar@height+\semio@stroke@hairline+2pt\relax}
\setlength{\headsep}{\semio@spacing@touch}
\setlength{\footskip}{\dimexpr\semio@chrome@footer@height+\semio@stroke@hairline+2pt+\semio@spacing@touch\relax}

\AddToHook{enddocument/before}{\SemioWindowCloseAll}
\AtEndDocument{\SemioWindowCloseAll}
