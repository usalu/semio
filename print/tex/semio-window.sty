        \vbox to \semio@chrome@navbar@height{%
          \vfil
          \hbox to \headwidth{#1}%
          \vskip\semio@spacing@single
        }%
      }%
    }%
    \nointerlineskip
    \hbox to \headwidth{%
      \color{semio-chrome-border-normal}\rule{\headwidth}{\semio@stroke@hairline}%
    }%
  }%
}

\newcommand{\semio@chrome@footer@bar}[1]{%
  \vbox{%
    \nointerlineskip
    \hbox to \headwidth{%
      \color{semio-chrome-border-normal}\rule{\headwidth}{\semio@stroke@hairline}%
    }%
    \nointerlineskip
    \hbox to \headwidth{%
      \setlength{\fboxsep}{0pt}%
      \colorbox{semio-chrome-base}{%
        \vbox to \semio@chrome@footer@height{%
          \vskip\semio@spacing@single
          \hbox to \headwidth{#1}%
          \vfil
        }%
      }%
    }%
  }%
}

\newcommand{\semio@chrome@navbar@chip@text}[2]{%
  \semio@chrome@chip{%
    \semio@chrome@vcenter{\semio@chrome@row@height}{%
      {\SemioSans\fontsize{#1}{#1}\selectfont #2}%
    }%
  }%
}

\newsavebox{\semio@chrome@bar@edge@box}
\newsavebox{\semio@chrome@bar@center@box}

\newcommand{\semio@chrome@bar@threezone}[4]{%
  \sbox\semio@chrome@bar@edge@box{%
    \vbox to #1{%
      \vfil
      \hbox to \headwidth{%
        #2%
        \hfil
        #4%
      }%
      \vfil
    }%
  }%
  \sbox\semio@chrome@bar@center@box{%
    \vbox to #1{%
      \vfil
      \hbox to \headwidth{%
        \hfil
        #3%
        \hfil
      }%
      \vfil
    }%
  }%
  \hbox to \headwidth{%
    \usebox\semio@chrome@bar@edge@box
    \hskip-\wd\semio@chrome@bar@edge@box
    \usebox\semio@chrome@bar@center@box
  }%
}

\newcommand{\SemioChromeNavbarHead}{%
  \semio@chrome@navbar@bar{%
    \semio@chrome@bar@threezone{\semio@chrome@row@height}{%
      \semio@chrome@chip{%
        \semio@chrome@vcenter{\semio@chrome@row@height}{\usebox{\semio@chrome@navbar@emblem@box}}%
      }%
      \SemioChromeNavbarProjectChip
    }{%
      \SemioChromeNavbarCenterChip
    }{%
      \if\relax\detokenize{\semio@chrome@heading}\relax
      \else
        \semio@chrome@navbar@chip@text{\semio@chrome@font@chip}{\semio@chrome@heading}%
      \fi
    }%
  }%
}

\newcommand{\SemioChromeFooterHead}{%
  \semio@chrome@footer@bar{%
    \semio@chrome@bar@threezone{\semio@chrome@row@height@footer}{%
      \SemioFooterLogoChips
    }{%
      \SemioFooterAuthorChips
    }{%
      \semio@chrome@chip{%
        \semio@chrome@vcenter{\semio@chrome@row@height@footer}{%
          {\SemioMono\fontsize{\semio@chrome@font@chip}{\semio@chrome@font@chip}\selectfont\thepage}%
        }%
      }%
    }%
  }%
}

\newcommand{\SemioChromeIconSize}[1]{%
  \setlength{\semio@chrome@row@height}{\dimexpr#1\relax}%
  \setlength{\semio@chrome@icon@height}{\semio@chrome@row@height}%
  \semio@chrome@emblem@rebuild
}
\newcommand{\SemioChromeFooterIconSize}[1]{%
  \setlength{\semio@chrome@row@height@footer}{\dimexpr#1\relax}%
  \setlength{\semio@chrome@icon@height@footer}{\semio@chrome@row@height@footer}%
  \semio@chrome@emblem@rebuild
}

\NewDocumentCommand{\SemioChromeIconScale}{m}{%
  \renewcommand{\semio@chrome@icon@scale}{#1}%
  \semio@chrome@dims@compute
}
\NewDocumentCommand{\SemioChromeFooterIconScale}{m}{%
  \renewcommand{\semio@chrome@icon@scale@footer}{#1}%
  \semio@chrome@dims@compute
}

\setlength{\headheight}{\dimexpr\semio@chrome@navbar@height+\semio@stroke@hairline\relax}
\setlength{\headsep}{\semio@spacing@double}
\newlength{\semio@chrome@footer@reserve}
\setlength{\semio@chrome@footer@reserve}{\dimexpr\semio@spacing@double+\semio@chrome@footer@height+\semio@stroke@hairline\relax}
\newlength{\semio@chrome@page@gap}
\setlength{\semio@chrome@page@gap}{\dimexpr\semio@page@margin-\headheight-\headsep\relax}
\geometry{
  includehead, includefoot,
  top=\semio@chrome@page@gap,
  headheight=\headheight,
  headsep=\semio@spacing@double,
  bottom=\semio@chrome@page@gap,
  footskip=\semio@chrome@footer@reserve,
}
