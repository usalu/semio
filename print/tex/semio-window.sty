    \semio@register@window@close
    \makeatother
    \group_end:
  }
}

\cs_new_protected:Npn \semio_termlist_new:nnnn #1#2#3#4 {
  \exp_args:Nc \seq_new:N { g_semio_#1_terms_seq }
  \exp_args:Nc \prop_new:N { g_semio_#1_definition_prop }
  \exp_args:Nc \prop_new:N { g_semio_#1_pages_prop }
  % 🩹 \makeatletter/\makeatother must stay scoped to this group — this
  % function is called at file top level (see \semio_termlist_new:nnnn calls
  % below), so an unwrapped \makeatother here would permanently flip the
  % catcode of `@` to "other" for the rest of the package, breaking every
  % `\semio@...`-named control sequence typed later in this file.
  \group_begin:
  \ExplSyntaxOff
  \makeatletter
  \newcounter{semio#1usage}
  \expandafter\gdef\csname semio@#1@table@body\endcsname{}%
  \makeatother
  \group_end:
  \ExplSyntaxOn
  \cs_new_protected:cpn {#2} ##1##2 { \semio_termlist_define:nnn {#1} {##1} {##2} }
  \cs_new_protected:cpn {#3} ##1 { \semio_termlist_use:nn {#1} {##1} }
  \cs_gset:cpn {#4} { \semio_termlist_listof:n {#1} }
  \semio@register@hooks@install {#4}
}

