\cs_new_protected:Npn \semio_toc_level:n #1 {
  \str_case:nn {#1} {
    { part } { -1 }
    { chapter } { 0 }
    { section } { 1 }
    { subsection } { 2 }
    { subsubsection } { 3 }
    { paragraph } { 4 }
  } { 10 }
}

\cs_new_protected:Npn \semio_window_toc_append:nnn #1#2#3 {
  \tl_if_blank:nTF {#2} { } {
      \str_set:Nx \l_tmpb_str { semio-toc-#1-#2 }
      \exp_args:NV \label \l_tmpb_str
      \group_begin:
        \exp_args:Nc \seq_gput_right:Nn { g_semio_register_toc_num_seq } {#2}
        \exp_args:Nc \seq_gput_right:Nn { g_semio_register_toc_title_seq } {#3}
        \exp_args:Nc \seq_gput_right:Nn { g_semio_register_toc_label_seq }
          { \str_use:N \l_tmpb_str }
      \group_end:
      \semio_window_toc_iow_open:
      \iow_now:Nx \g_semio_toc_iow {
        \SemioTocAuxLine
          {#2}
          { \exp_not:n {#3} }
          { \str_use:N \l_tmpb_str }
      }
    }
}

\cs_new_protected:Npn \semio_window_toc_append:nn #1#2 {
  \cs_if_exist:cTF { the#1 }
    { \exp_args:Ncno \semio_window_toc_append:nnn {#1} { the#1 } {#2} }
    { }
}

