\providecommand{\semio@chrome@titlebar@height}{1.4em}
\providecommand{\semio@chrome@padding}{0.2em}
% Inner inset between a window's frame and its body content (text / image), for
% every non-table window kind (generic Window, Figure, Photo, Image, Blockquote,
% Epigraph, and the cover tiles). Deliberately SEPARATE from
% \semio@chrome@padding — that token also drives the title-tab cap height (see
% \semio@window@cap@metrics@set), so growing the content inset through it would
% balloon the tabs. This token touches only the four tcolorbox body insets and
% the image/text-fit content geometry. Set to 5.5pt to match the visible inset
% of table cells (\semio@table@hpad + frame gap ≈ 5.5pt), so window content and
% table content sit the same distance from their borders document-wide. Tables
% zero the window inset and supply their own padding, so they are untouched.
\providecommand{\semio@window@bodypad}{5.5pt}
% 🔲 Title-tab content inset. Matches the document inset constant
% (\semio@window@bodypad = table cell \semio@table@hpad + frame gap ≈ 5.5pt) so a
% tab's label sits the SAME distance from its four borders as body/table content
% does. Applied by the muted cap core (\semio@heading@cap@muted@core → the
% table / figure / contents / window title & number tabs) AND the section/appendix
% heading chips (solid \semio@heading@chip and outline \semio@heading@cap@nofill@core,
% via \semio@window@cap@hpad + the vpad budget), so heading boxes match the window/
% table tabs; accent tabs and the nav/footer chips keep the tighter \semio@chrome@padding.
% The tab is anchored so growing this inset never moves the borders that must
% stay continuous with the frame: the title tab is flush-left (left border fixed,
% grows right), the number tab flush-right (right border fixed, grows left), and
% the depth-0 cap raisebox sends all vertical growth upward (bottom border, the
% shared top rule, fixed).
\providecommand{\semio@tab@inset}{\semio@window@bodypad}
% 🔲 Vertical tab/heading inset = 70% of the horizontal \semio@tab@inset. Every
% cap that uses the roomy inset (window/table title & number tabs AND the
% section/appendix heading boxes) drives its top/bottom label gap from THIS token
% and its left/right gap from \semio@tab@inset, so the vertical air is uniformly
% 30% tighter than the horizontal while the two stay locked in one ratio. Written
% as a nested \dimexpr so it scales if \semio@tab@inset changes.
\providecommand{\semio@tab@inset@v}{\dimexpr\semio@tab@inset*7/10\relax}
\providecommand{\semio@window@imagefit}{contain}
\providecommand{\semio@chrome@navbar@height}{1.8em}
\providecommand{\semio@chrome@footer@height}{1.8em}
\providecommand{\semio@chrome@font@chip}{7.2pt}
% LR-consistency: body/window/table text unified to the 7.2pt chip size. The
% canonical token lives in semio-tokens.sty (kept at 9.6pt by a design-token
% guard), so override it here — window.sty loads after tokens, so this wins.
% Define-then-force so it is safe whether or not tokens.sty ran first.
\providecommand{\semio@chrome@font@body}{7.2pt}%
\renewcommand{\semio@chrome@font@body}{7.2pt}
% LR-table-header-bold: Anta ships only a Regular weight, so the \bfseries inside
% \semio@table@header@cell is a no-op — header cells (Schlüssel, Titel, …) render
% identical to the body cells, set apart only by the shaded background. Give the
% header row a genuine SYNTHETIC bold (fontspec FakeBold) at the unchanged 7.2pt
% size. Overridden here (window.sty loads after semio-table.sty) so the table
% file stays untouched. \semio@text@emphasized only sets the text colour.
\newfontfamily\SemioSansBold[Path=\semio@font@root anta/,FakeBold=2.5]{Anta-Regular.ttf}
\renewcommand{\semio@table@header@cell}[1]{%
  \SemioSansBold\semio@table@fontsize@apply
  \semio@text@emphasized{#1}%
}
\providecommand{\semio@chrome@icon@scale}{1}
\providecommand{\semio@chrome@icon@scale@footer}{1}
% Layout spacing (defined here, not in the generated semio-tokens.sty):
% \semio@spacing@par  = gap after body paragraphs (\parskip)
% \semio@spacing@single = block↔block / block↔paragraph junction (\semio@block@before)
% \semio@spacing@table@outer = air above/below tables
% \semio@window@gap = \semio@spacing@par after preamble (WindowArrangement H/V)
\providecommand{\semio@spacing@par}{0.5em}
\providecommand{\semio@spacing@table@outer}{0.85em}

