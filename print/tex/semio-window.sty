  \refstepcounter {#1}
  \tl_if_empty:NTF \l_semio_window_kind_title_tl {
    \tl_set:Nn \l_semio_window_kind_title_tl {
      \semio_kind_label:n { \use:c { semio@window@#1@kind } }
    }
  } { }
  \tl_set:Nx \l_semio_window_kind_title_tl { \tl_use:N \l_semio_window_kind_title_tl }
  \tl_set:Nn \l_semio_window_number_tl { \semio@window@kind@number {#1} }
  \semio_window_register_write:nn {#1} { \use:c { semio@window@#1@kind } }
  \addvspace { \semio@spacing@single }
