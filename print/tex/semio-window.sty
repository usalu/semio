\cs_new_protected:Npn \semio_toc_level:n #1 {
  \str_case:nn {#1} {
    { part } { -1 }
    { chapter } { 0 }
    { section } { 1 }
    { subsection } { 2 }
    { subsubsection } { 3 }
    { paragraph } { 4 }
  } { 10 }
}

\cs_new_protected:Npn \semio_window_toc_title_plain:n #1 {
  \tl_if_in:nnTF {#1} { Hy@SectionAnchorHref } {
    \tl_clear:N \l_tmpa_tl
  } {
    \tl_set:Nn \l_tmpa_tl {#1}
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_if_in:nnT {#1} { \Sectionformat } {
      \group_begin:
      \ExplSyntaxOff
      \def\semio@toc@title@extract##1\Sectionformat ##2##3\semio@toc@title@stop{##2}
      \exp_args:Nno \tl_gset:Nn \l_tmpa_tl { \semio@toc@title@extract#1\semio@toc@title@stop }
      \group_end:
      \tl_trim_spaces:N \l_tmpa_tl
    }
    \tl_if_in:nnT {#1} { \interlinepenalty } {
      \group_begin:
      \makeatletter
      \str_set:Nx \l_tmpa_str { \tl_to_str:n {#1} }
      \str_set:Nx \l_tmpb_str { \tl_to_str:n { \interlinepenalty \@M } }
      \str_set:Nx \l_tmpc_str { \tl_to_str:n { \@@par } }
      \str_replace_all:NVn \l_tmpa_str \l_tmpb_str { }
      \str_replace_all:NVn \l_tmpa_str \l_tmpc_str { }
      \tl_gset:Nx \l_tmpa_tl { \l_tmpa_str }
      \makeatother
      \group_end:
      \tl_trim_spaces:N \l_tmpa_tl
    }
    \tl_if_in:NnT \l_tmpa_tl { Hy@SectionAnchorHref } {
      \tl_clear:N \l_tmpa_tl
    }
    % LR-2.15: the register / TOC / bookmark write path stringifies this title
    % with \tl_to_str, which turns the control symbol \& into a literal backslash
    % + ampersand ("\&" shows in the contents). Normalise once here, at the single
    % choke point, so every downstream \tl_to_str is idempotent and a plain "&"
    % reaches the contents; body text and hyperref bookmarks are untouched.
    \tl_if_empty:NF \l_tmpa_tl {
      \str_set:Nx \l_tmpb_str { \tl_to_str:N \l_tmpa_tl }
      \str_set:Nx \l_tmpc_str { \tl_to_str:n { \& } }
      \str_replace_all:NVn \l_tmpb_str \l_tmpc_str { & }
      \tl_set:Nx \l_tmpa_tl { \l_tmpb_str }
    }
  }
}

\cs_new_protected:Npn \semio_window_toc_append:nnn #1#2#3 {
  \tl_if_blank:nTF {#2} { } {
    \tl_if_in:nnTF {#3} { Hy@SectionAnchorHref } { } {
      \semio_window_toc_title_plain:n {#3}
      \tl_if_empty:NF \l_tmpa_tl {
        \int_gincr:N \g_semio_toc_label_int
        \str_set:Nx \l_tmpb_str { semio-toc-#1-#2-\int_use:N \g_semio_toc_label_int }
        \exp_args:NV \label \l_tmpb_str
        \group_begin:
          \exp_args:Nc \seq_gput_right:Nn { g_semio_register_toc_num_seq } {#2}
          \seq_gput_right:Nx \g_semio_register_toc_title_seq { \tl_to_str:N \l_tmpa_tl }
          \exp_args:Nc \seq_gput_right:Nn { g_semio_register_toc_label_seq }
            { \str_use:N \l_tmpb_str }
        \group_end:
        % 🩹 Buffer the aux line in a seq instead of writing it to the file now.
        % The file is (re)written in one shot at \AtEndDocument. Writing
        % incrementally opened — and truncated — jobname.register-toc on the
        % first tracked heading; a report whose first heading precedes
        % \tableofcontents (e.g. \makefundingacknowledgement's \chapter*) thus
        % wiped the previous run's aux before the TOC could read it, leaving the
        % TOC permanently blank. Deferring the write keeps the prior run's aux
        % intact on disk until end-of-document, so \semio_window_toc_aux_load:
        % always reads a complete file regardless of heading/TOC order.
        \seq_gput_right:Nx \g_semio_toc_aux_seq {
          \SemioTocAuxLine
            { #2 }
            { \tl_to_str:N \l_tmpa_tl }
            { \str_use:N \l_tmpb_str }
        }
      }
    }
  }
}

