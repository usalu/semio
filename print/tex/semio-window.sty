    \ifcsname c@##1\endcsname
      \AddToHook{cmd/##1/before}{\semio@heading@block@before}%
    \fi
  }%
  \semio@heading@cmd@sep@level{part}%
  \semio@heading@cmd@sep@level{chapter}%
  \semio@heading@cmd@sep@level{section}%
  \semio@heading@cmd@sep@level{subsection}%
  \semio@heading@cmd@sep@level{subsubsection}%
  \semio@heading@cmd@sep@level{paragraph}%
