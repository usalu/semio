\cs_new_protected:Npn \semio_window_kind_begin:nnn #1 #2 #3 {
  \semio_window_content_state_reset:
  \bool_set_true:N \l_semio_window_hierarchy_bool
  \tl_clear:N \l_semio_window_kind_title_tl
  \keys_set:nn { semio / window / kind } { #3 }
  \semio_window_arrangement_height_adopt:
  \semio_window_content_validate:
  \use:c { semio@window@enter }
  \bool_if:NTF \l_semio_register_list_bool {
    \tl_if_empty:NT \l_semio_window_kind_title_tl {
      \tl_set:Nn \l_semio_window_kind_title_tl {
        \semio_kind_label:n { \use:c { semio@window@#1@kind } }
      }
    }
    \tl_set:Nx \l_semio_window_kind_title_tl { \tl_use:N \l_semio_window_kind_title_tl }
    \tl_clear:N \l_semio_window_number_tl
    \tl_gclear:N \g_semio_window_current_regnum_tl
    \bool_gset_false:N \g_semio_window_break_suffix_bool
  } {
    \bool_if:NTF \l_semio_window_hierarchy_bool {
      \refstepcounter {#1}
      \tl_if_empty:NTF \l_semio_window_kind_title_tl {
        \tl_set:Nn \l_semio_window_kind_title_tl {
          \semio_kind_label:n { \use:c { semio@window@#1@kind } }
        }
      } { }
      \tl_set:Nx \l_semio_window_kind_title_tl { \tl_use:N \l_semio_window_kind_title_tl }
      \semio_window_kind_number_set:n {#1}
      \semio_window_register_write:nn {#1} { \use:c { semio@window@#1@kind } }
      \semio_window_break_suffix_apply:
    } {
      \tl_if_empty:NTF \l_semio_window_kind_title_tl {
        \tl_set:Nn \l_semio_window_kind_title_tl {
          \semio_kind_label:n { \use:c { semio@window@#1@kind } }
        }
      } { }
      \tl_set:Nx \l_semio_window_kind_title_tl { \tl_use:N \l_semio_window_kind_title_tl }
      \tl_clear:N \l_semio_window_number_tl
      \tl_gclear:N \g_semio_window_current_regnum_tl
    \bool_gset_false:N \g_semio_window_break_suffix_bool
    }
  }
  \semio_window_header_store:
  \semio_block_sep_before:
  \semio_window_header_keep_with_body:
  \semio_window_header_muted_use:
  \semio_window_vskip_stroke_hairline:
  % 🩹 A "kind" window (Table, Figure, Photo, ...) never checked
  % \l_semio_window_in_item_bool the way the generic \Window does (compare
  % \semio_window_generic_begin: below, which passes breakable=false when
  % inside a WindowItem) — so a kind window placed in a WindowRow/WindowItem
  % stayed `breakable`. This alone wasn't the cause of the image-doubling
  % bug (see \semio_image_graphics_wh:n for that), but a kind window inside
  % a WindowItem genuinely should be non-breakable regardless, matching the
  % generic \Window's behavior for the same context.
  \str_if_eq:nnTF {#1} { semiotable }
    {
      \tl_set:Nn \l_tmpa_tl { semio~window~tier~#2, semio~window~table }
      % breakable=false when inside a WindowItem (see note above) OR when the
      % window explicitly opted out of breaking via `break=false`.
      \bool_lazy_or:nnT
        { \l_semio_window_in_item_bool } { ! \l_semio_window_break_bool }
        { \tl_put_right:Nn \l_tmpa_tl { , breakable=false } }
      \exp_args:NV \semio_window_tcb_open:n \l_tmpa_tl
    }
    {
      \tl_set:Nn \l_tmpa_tl { semio~window~tier~#2 }
      \str_if_eq:VnT \l_semio_window_imagefit_tl { cover } {
        \tl_put_right:Nn \l_tmpa_tl { , semio~window~image~cover }
      }
      \bool_lazy_or:nnT
        { \l_semio_window_in_item_bool } { ! \l_semio_window_break_bool }
        { \tl_put_right:Nn \l_tmpa_tl { , breakable=false } }
      \exp_args:NV \semio_window_tcb_open:n \l_tmpa_tl
    }
  \semio_window_textsize_apply:
}

