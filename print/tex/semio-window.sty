  \semio@heading@install{\subsection}{semio-secondary}{subsection}%
  \semio@heading@install{\subsubsection}{semio-primary}{subsubsection}%
  \titleformat{\paragraph}[block]{}{}{0pt}{%
    \semio@if@heading@chips
      {%
        \if\relax\detokenize{\theparagraph}\relax
          \semio@heading@title@end@muted{##1}%
        \else
