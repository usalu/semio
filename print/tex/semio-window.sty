%region WindowBreakParts chrome
% 🧩 Records (into the `.window-breaks` aux file, via
% \semio_window_break_record:n) how many page-parts this window instance
% rendered into on *this* compile pass — read back on the *next* pass by
% \semio_window_break_suffix_apply: to decide whether page 1's hierarchy
% chip needs a ":1" suffix. Wired into the `semio~window` tcbset style as
% `overlay unbroken=` / `overlay last=`.
\newcommand{\semio@window@break@record}[1]{%
  \ExplSyntaxOn
  \semio_window_break_record:n {#1}%
  \ExplSyntaxOff
}

% 🪟 Redraws the *exact* header chip row (same \semio@window@header@muted
% routine used for page 1, above/before the box) as a tcolorbox `overlay`
% anchored to that page-part's own `frame` node, so a continuation page of a
% genuinely broken window shows the identical title/hierarchy chip chrome —
% just with the live `\thetcbbreakpart` part index appended to the number.
% Wired into the `semio~window` tcbset style as `overlay middle=` /
% `overlay last=` (never fires for `unbroken` or single-part boxes, so a
% window that never breaks renders byte-for-byte as before).
\newcommand{\semio@window@header@repeat}{%
  \edef\semio@window@header@part@num{\arabic{tcbbreakpart}}%
  \node[anchor=south, inner sep=0pt, yshift=\semio@stroke@hairline] at (frame.north) {%
    \semio@window@header@muted{\semio@window@header@number:\semio@window@header@part@num}{\semio@window@header@title}%
  };%
}
%endregion WindowBreakParts chrome

\newcommand{\semio@chrome@heading@set}[1]{%
