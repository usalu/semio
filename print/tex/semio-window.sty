    \str_set:Nx \l_tmpd_str { \seq_item:cn { g_semio_register_ #1 _label_seq } { ##1 } }
    \tl_set:Nx \l_tmpe_tl { \str_use:N \l_tmpd_str }
    \semio_window_register_body_gappto:VVV \l_tmpb_tl \l_tmpc_tl \l_tmpe_tl
  }
}

