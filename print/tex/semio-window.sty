  }
}
\cs_generate_variant:Nn \semio_window_break_write:nn { Vn }

\cs_new_protected:Npn \semio_window_break_record:n #1 {
  \tl_if_empty:NF \g_semio_window_current_regnum_tl {
    \semio_window_break_write:Vn \g_semio_window_current_regnum_tl {#1}
  }
}

% 🔢 Called right after \semio_window_register_write:nn has computed the
% (unsuffixed) \l_semio_window_register_number_tl for this window instance:
% remembers it as the lookup key for the continuation-page overlay writer,
% and — if the *previous* compile pass recorded this same window as having
% rendered into >1 page-parts — appends ":1" to the page-1 header display
% number only (\l_semio_window_number_tl), never to the register/hierarchy
% number itself.
\cs_new_protected:Npn \semio_window_break_suffix_apply: {
  \tl_gset_eq:NN \g_semio_window_current_regnum_tl \l_semio_window_register_number_tl
  \prop_get:NVNTF \g_semio_window_break_prop \l_semio_window_register_number_tl \l_tmpf_tl {
    \int_compare:nNnT { \l_tmpf_tl } > { 1 } {
      \tl_put_right:Nn \l_semio_window_number_tl { :1 }
    }
  } { }
}

\AtEndDocument { \iow_close:N \g_semio_window_break_iow }
%endregion WindowBreakParts state

\cs_new_protected:Npn \semio_window_register_write:nn #1#2 {
  \semio_hierarchy_path_sync_document:
  \tl_if_empty:NTF \g_semio_hierarchy_path_tl {
    \tl_set:Nx \l_semio_window_register_number_tl {
      \int_to_alph:n { \int_use:c { c@semio@window@slot } }
    }
  } {
    \tl_set:Nx \l_semio_window_register_number_tl {
      \tl_use:N \g_semio_hierarchy_path_tl .
      \int_to_alph:n { \int_use:c { c@semio@window@slot } }
    }
  }
  \str_set:Nx \l_tmpb_str { semio-register-#2-\tl_use:N \l_semio_window_register_number_tl }
  \exp_args:NV \label \l_tmpb_str
  \group_begin:
    \exp_args:Nc \seq_gput_right:Nx { g_semio_register_ #1 _num_seq }
      { \tl_use:N \l_semio_window_register_number_tl }
    \exp_args:Nc \seq_gput_right:Nx { g_semio_register_ #1 _title_seq }
      { \tl_use:N \l_semio_window_kind_title_tl }
    \exp_args:Nc \seq_gput_right:Nx { g_semio_register_ #1 _label_seq }
      { \str_use:N \l_tmpb_str }
  \group_end:
}

