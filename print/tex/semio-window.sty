\newcommand{\semio@chrome@navbar@bar}[1]{%
  \vbox{%
    \nointerlineskip
    \hbox to \headwidth{%
      \setlength{\fboxsep}{0pt}%
      \colorbox{semio-chrome-base}{%
        \vbox to \semio@chrome@navbar@height{%
          \vfil
          \hbox to \headwidth{#1}%
          \vskip\semio@spacing@single
        }%
      }%
    }%
    \nointerlineskip
    \hbox to \headwidth{%
      \color{semio-chrome-border-normal}\rule{\headwidth}{\semio@stroke@hairline}%
    }%
  }%
}

\newcommand{\semio@chrome@footer@bar}[1]{%
  \vbox{%
    \nointerlineskip
    \hbox to \headwidth{%
      \color{semio-chrome-border-normal}\rule{\headwidth}{\semio@stroke@hairline}%
    }%
    \nointerlineskip
    \hbox to \headwidth{%
      \setlength{\fboxsep}{0pt}%
      \colorbox{semio-chrome-base}{%
        \vbox to \semio@chrome@footer@height{%
          \vskip\semio@spacing@single
          \hbox to \headwidth{#1}%
          \vfil
        }%
      }%
    }%
  }%
}

\newcommand{\semio@chrome@navbar@chip@text}[2]{%
  \semio@chrome@chip{%
    \semio@chrome@vcenter{\semio@chrome@row@height}{%
      {\SemioSans\fontsize{#1}{#1}\selectfont #2}%
    }%
  }%
}

\newsavebox{\semio@chrome@bar@edge@box}
\newsavebox{\semio@chrome@bar@center@box}

% LR-2.11: reusable project-card keep-together space test. Reserves the card
% heading bar + its fixed 30mm arrangement + the start of the following
% component table, so a card that cannot fit in the remaining space breaks to a
% fresh page as one unit instead of stranding the heading/image on one page and
% the table alone on the next (P.K.67). Public (no @) so appendix content files
% can call it where \semio@... names are not letters.
\newcommand{\SemioCardKeep}{%
  \needspace{\dimexpr\semio@chrome@titlebar@height+30mm+6\baselineskip\relax}%
}

%region PageParity
\newcommand{\Ifsemiochromemirrored}[2]{%
  \if@twoside\ifodd\value{page}#2\else#1\fi\else#2\fi
}
%endregion PageParity

\newcommand{\semio@chrome@bar@threezone}[4]{%
  \sbox\semio@chrome@bar@edge@box{%
    \vbox to #1{%
      \vfil
      \hbox to \headwidth{%
        \Ifsemiochromemirrored{#4\hfil#2}{#2\hfil#4}%
      }%
      \vfil
    }%
  }%
  \sbox\semio@chrome@bar@center@box{%
    \vbox to #1{%
      \vfil
      \hbox to \headwidth{%
        \hfil
        #3%
        \hfil
      }%
      \vfil
    }%
  }%
  \hbox to \headwidth{%
    \usebox\semio@chrome@bar@edge@box
    \hskip-\wd\semio@chrome@bar@edge@box
    \usebox\semio@chrome@bar@center@box
  }%
}

% LR-2.9: bound a running-header field to a maximum width, shrinking to fit only
% when it would otherwise overflow, so a long running-section title cannot reach
% back to the centred report-type chip (the three navbar zones are overlaid
% full-width boxes with no gutter). Footer/threezone untouched.
\newsavebox\semio@chrome@fit@box
\newcommand{\semio@chrome@fit@width}[2]{%
  \sbox\semio@chrome@fit@box{#2}%
  \ifdim\wd\semio@chrome@fit@box>\dimexpr#1\relax
    \resizebox{\dimexpr#1\relax}{!}{\usebox\semio@chrome@fit@box}%
  \else
    \usebox\semio@chrome@fit@box
  \fi
}

\newcommand{\SemioChromeNavbarHead}{%
  \semio@chrome@navbar@bar{%
    \semio@chrome@bar@threezone{\semio@chrome@zone@height}{%
      \semio@chrome@chip{%
        \semio@chrome@vcenter{\semio@chrome@row@height}{\usebox{\semio@chrome@navbar@emblem@box}}%
      }%
      \SemioChromeNavbarProjectChip
    }{%
      \SemioChromeNavbarCenterChip
    }{%
      % LR-2.8: read the section in effect on THIS page from the mark, not the
      % read-ahead \gdef. \protected@edef keeps robust tokens (e.g. \& in project
      % names) unexpanded.
      \protected@edef\semio@chrome@heading@now{\rightmark}%
      % LR-hdrfix: \rightmark is empty on pages that start no new heading —
      % continuation pages and the register/bibliography sections, which issue no
      % section mark — leaving those pages with a blank header slot. Fall back to
      % the persistent \gdef global (last heading set), which never empties, so
      % every page carries a section label.
      \ifx\semio@chrome@heading@now\@empty
        \protected@edef\semio@chrome@heading@now{\semio@chrome@heading}%
      \fi
      \ifx\semio@chrome@heading@now\@empty
      \else
        % LR-2.9: cap the running-section chip below half the free width so it
        % cannot reach the centred report-type chip; long titles scale down.
        \semio@chrome@fit@width{0.34\headwidth}{%
          \semio@chrome@navbar@chip@text{\semio@chrome@font@chip}{\semio@chrome@heading@now}%
        }%
      \fi
    }%
  }%
}

\newcommand{\SemioChromeFooterHead}{%
  \semio@chrome@footer@bar{%
    \semio@chrome@bar@threezone{\semio@chrome@zone@height@footer}{%
      \SemioFooterLogoChips
    }{%
      \SemioFooterAuthorChips
    }{%
      \semio@chrome@chip{%
        \semio@chrome@vcenter{\semio@chrome@row@height@footer}{%
          {\SemioMono\fontsize{\semio@chrome@font@chip}{\semio@chrome@font@chip}\selectfont\thepage}%
        }%
      }%
    }%
  }%
}

