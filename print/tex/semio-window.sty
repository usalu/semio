\newcommand{\semio@panel@shipout@glass}[4]{%
  \put(\LenToUnit{\semio@panel@shipout@x},\LenToUnit{\semio@panel@shipout@y}){%
    \makebox(0,0)[bl]{%
      \begin{tikzpicture}[x=1pt,y=1pt]%
        \useasboundingbox (0,0) rectangle (#2,#4);%
        \node[anchor=south west,inner sep=0pt,outer sep=0pt] at (0,0) {%
          \includegraphics[width=#2,height=#4,keepaspectratio=false]{.semio-panel-glass/\jobname/#1.png}%
        };%
        \draw[
          semio-chrome-border-normal,
          line width=\semio@stroke@hairline,
        ] (\semio@stroke@hairline/2,\semio@stroke@hairline/2)
          rectangle
          (\dimexpr#2-\semio@stroke@hairline/2\relax,\dimexpr#4-\semio@stroke@hairline/2\relax);%
        \node[
          anchor=center,
          inner sep=\semio@chrome@padding,
          align=center,
          text=semio-chrome-text-normal,
          font=\semio@panel@font,
        ] at (\dimexpr#2/2\relax,\dimexpr#4/2\relax) {%
          \expandafter\usebox\csname semio@panel@box@#3\endcsname
        };%
      \end{tikzpicture}%
    }%
  }%
}

\newcommand{\semio@panel@shipout@fallback}[4]{%
  \put(\LenToUnit{\semio@panel@shipout@x},\LenToUnit{\semio@panel@shipout@y}){%
