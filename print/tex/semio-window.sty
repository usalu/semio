\newcommand{\semio@nest@counter@reset}{%
  \ifcase\value{semio@nest@depth}\or
    \setcounter{semio@nest@a}{0}\or
    \setcounter{semio@nest@b}{0}\or
    \setcounter{semio@nest@c}{0}\or
    \setcounter{semio@nest@d}{0}\or
    \setcounter{semio@nest@e}{0}%
