\def\semio@chrome@heading{}

\def\semio@window@header@number{}
\def\semio@window@header@number@page1{}
\def\semio@window@header@title{}

% 📌 Chip number for callers that draw title chrome outside a window and so never
% pass through \semio_window_header_store_aux:nn (the project catalogue card).
% Such a card is an unbreakable box, so the page-1 display copy read by
% \semio@window@header@invoke equals the base number — set both here rather than
% leaving @page1 empty, which drops the chip.
\newcommand{\semio@window@header@number@set}[1]{%
  \gdef\semio@window@header@number{#1}%
  \gdef\semio@window@header@number@page1{#1}%
}

\newcommand{\semio@window@header@invoke}{%
  % 🔢 Page 1 uses \semio@window@header@number@page1 (base number, plus a
  % ":1" suffix if the *previous* compile pass recorded this window as
  % having broken — see \semio_window_break_suffix_apply:), never the bare
  % \semio@window@header@number that \semio@window@header@repeat reuses (and
  % appends its own live ":<N>" to) on continuation pages.
  \semio@window@header@muted{\semio@window@header@number@page1}{\semio@window@header@title}%
}

%region WindowBreakParts chrome
% 🧩 Records (into the `.window-breaks` aux file, via
% \semio_window_break_record:n) how many page-parts this window instance
% rendered into on *this* compile pass — read back on the *next* pass by
% \semio_window_break_suffix_apply: to decide whether page 1's hierarchy
% chip needs a ":1" suffix. Wired into the `semio~window` tcbset style as
% `overlay unbroken=` / `overlay last=`.
% ⚠️ \newcommand bodies are tokenized *once*, in full, using whatever
% catcodes are active at the point of definition — an `\ExplSyntaxOn` token
% appearing *inside* an already-tokenized body cannot retroactively fix how
% the "_"/":" characters right after it were scanned. So this macro's
% *definition* (not just its body) must sit inside this ExplSyntaxOn wrapper
% for its l3 (`\semio_window_break_record:n`) call site to tokenize as a
% single control sequence. NB: ExplSyntaxOn also makes space (char 32) an
% *ignored* character, not just kept at catcode 10 — that's why the rest of
% this file spells literal spaces inside ExplSyntaxOn regions as "~"
% (tcbset's `before~skip=0pt` etc.); this macro has none, so it's unaffected.
\ExplSyntaxOn
\newcommand{\semio@window@break@record}[1]{%
  \semio_window_break_record:n {#1}%
}
\ExplSyntaxOff

% 🪟 Page 1 / unbroken: chips+baseline are inline — do not TikZ-restroke
% frame.north (a second parallel hairline when the seam is a hair off).
% Continuation parts redraw the full chip row (no inline header on those pages).
\newcommand{\semio@window@header@overlay@continuation}{%
  \edef\semio@window@header@part@num{\arabic{tcbbreakpart}}%
  % south west @ frame.north west + flush chips: outer chip verticals sit on the
  % continuous leftrule/rightrule (centered south @ frame.north + moveleft made
  % a 1–2px jog / second edge).
  \node[anchor=south west, inner sep=0pt, yshift=\semio@stroke@hairline] at (frame.north west) {%
    \semio@window@header@flushtrue
    \semio@window@header@muted{\semio@window@header@number:\semio@window@header@part@num}{\semio@window@header@title}%
    \semio@window@header@flushfalse
  };%
}

\newcommand{\semio@window@header@overlay}{%
  \ifnum\value{tcbbreakpart}=1\relax
  \else
    \semio@window@header@overlay@continuation
  \fi
}

\newcommand{\semio@window@header@repeat}{\semio@window@header@overlay}

%endregion WindowBreakParts chrome

% LR-2.8: deliver the running-header section name via the marks mechanism, not a
% bare \gdef. A \gdef takes effect when the heading is tokenised in the main
% vertical list, while TeX's page builder breaks asynchronously (reading ahead),
% so a page whose break lands before a heading could ship carrying the NEXT
% section's name. A mark travels with the heading box. Classic \markright/
% \rightmark is used (this build's kernel predates the ltmarks \NewMarkClass API;
% fancyhdr, already loaded, provides \rightmark). The \gdef is kept as a harmless
% legacy value; the navbar reads the mark.
% LR-navshort: an optional short label for the RUNNING HEADER only. Placing
% \SemioNavShort{short} immediately before a heading feeds the navbar/mark a
% shorter form so long sentence-titles render at the flat 7.2pt chip size
% instead of auto-shrinking — while the FULL title stays verbatim in the body.
% The pending short is consumed (and cleared) by the next marking heading, so it
% never leaks onto a following section. \markright stores a copy of the tokens,
% and \let copies the meaning into the fallback macro, so both stay stable even
% after the pending is redefined by the next heading.
\let\semio@nav@short@pending\relax
\newcommand{\SemioNavShort}[1]{\gdef\semio@nav@short@pending{#1}}
\newcommand{\semio@chrome@heading@set}[1]{%
  \ifx\semio@nav@short@pending\relax
    \gdef\semio@chrome@heading{#1}%
    \markright{#1}%
  \else
    \global\let\semio@chrome@heading\semio@nav@short@pending
    \expandafter\markright\expandafter{\semio@nav@short@pending}%
    \global\let\semio@nav@short@pending\relax
  \fi
}

\newcommand{\semio@chrome@heading@track}[2]{%
  \def\semio@chrome@track@level{#1}%
  \def\semio@chrome@track@part{part}%
  \def\semio@chrome@track@chapter{chapter}%
  \def\semio@chrome@track@section{section}%
  \ifx\semio@chrome@track@level\semio@chrome@track@part
    \semio@chrome@heading@set{#2}%
  \else\ifx\semio@chrome@track@level\semio@chrome@track@chapter
    \semio@chrome@heading@set{#2}%
  \else\ifx\semio@chrome@track@level\semio@chrome@track@section
    \ifcsname c@chapter\endcsname
      \ifnum\value{chapter}>0 \else \semio@chrome@heading@set{#2}\fi
    \else
      \semio@chrome@heading@set{#2}%
    \fi
  \fi\fi\fi
  % LR-navshort (any level): part/chapter/section already consumed a pending
  % label above (which clears it), so this is a no-op for them. Deeper levels
  % (subsection…) get no custom mark and fall back to KOMA's full-title mark — so
  % if a short label is pending, force it through here to override that with the
  % short form in the running header. \semio@chrome@heading@set clears the pending.
  \ifx\semio@nav@short@pending\relax\else
    \semio@chrome@heading@set{#2}%
  \fi
}

\newsavebox{\semio@window@cap@slot}
\newsavebox{\semio@window@tab@box}
\newsavebox{\semio@window@ctrl@box}
\newlength{\semio@window@gap@w}
\newlength{\semio@window@cap@w}
\newlength{\semio@window@cap@body@h}
% 📐 Floor for \semio@window@cap@titleh during a heading-pair rebuild. Zero
% outside pairs; set to max(tab,ctrl) so both chips (and the solid gap band)
% share one height — otherwise the shorter number chip steps below/above the
% title+gap band (Bauteileinspeisung).
\newlength{\semio@window@cap@min@titleh}
\setlength{\semio@window@cap@min@titleh}{\z@}

% 🔲 Effective cap-box height. The nominal \semio@chrome@titlebar@height (1.4em)
% resolves against the *ambient* body font, so an enlarged chip font (e.g. 14pt
% headings) leaves the borders sitting on the letters. \semio@window@cap@titleh
% is instead the max of that nominal height and the *measured* slot content plus
% symmetric vertical padding, so the box grows with its text and the letters
% keep clear air above and below. body@h@set seeds it (before the slot exists);
% metrics@set recomputes it from the boxed slot.
\newlength{\semio@window@cap@titleh}
\newcommand{\semio@window@cap@body@h@set}{%
  \setlength{\semio@window@cap@titleh}{\dimexpr\semio@chrome@titlebar@height\relax}%
  \setlength{\semio@window@cap@body@h}{%
    \dimexpr\semio@window@cap@titleh-\semio@stroke@hairline\relax
  }%
}
% Vertical padding budget added to the measured slot to form the cap height.
% Default = 3·\semio@chrome@padding (unchanged for accent tabs). The muted cap
% core and the heading chips locally \renewcommand this — each scoped to its own
% \hbox — so their label gets \semio@tab@inset@v (70% of \semio@tab@inset) above
% and below.
\newcommand{\semio@window@cap@vpad@budget}{%
  \semio@chrome@padding+\semio@chrome@padding+\semio@chrome@padding}
% Horizontal label inset inside a cap slot. Default = \semio@chrome@padding
% (unchanged for accent tabs). Section/appendix heading chips \renewcommand this
% — scoped to their own box — to the full \semio@tab@inset, so a heading box's
% label sits the same distance from its left/right borders as a window/table
% title tab's does (which uses \semio@tab@inset via the muted cap core).
\newcommand{\semio@window@cap@hpad}{\semio@chrome@padding}
\newcommand{\semio@window@cap@metrics@set}{%
  \setlength{\semio@window@cap@titleh}{%
    \dimexpr\ht\semio@window@cap@slot+\dp\semio@window@cap@slot
      +\semio@window@cap@vpad@budget\relax
  }%
  \ifdim\semio@window@cap@titleh<\dimexpr\semio@chrome@titlebar@height\relax
    \setlength{\semio@window@cap@titleh}{\dimexpr\semio@chrome@titlebar@height\relax}%
  \fi
  \ifdim\semio@window@cap@titleh<\semio@window@cap@min@titleh\relax
    \setlength{\semio@window@cap@titleh}{\semio@window@cap@min@titleh}%
  \fi
  \setlength{\semio@window@cap@body@h}{%
    \dimexpr\semio@window@cap@titleh-\semio@stroke@hairline\relax
  }%
}

\newcommand{\semio@window@stroke@h}[2]{%
  \textcolor{#1}{\rule{\dimexpr#2\relax}{\semio@stroke@hairline}}%
}

\newcommand{\semio@window@stroke@v}[1]{%
  \textcolor{#1}{\rule{\semio@stroke@hairline}{\semio@window@cap@titleh}}%
}

\newcommand{\semio@window@stroke@v@to}[2]{%
  \textcolor{#1}{\rule{\semio@stroke@hairline}{\dimexpr#2\relax}}%
}

\newcommand{\semio@window@cap@raise}[1]{%
  \raisebox{0pt}[\semio@window@cap@titleh][0pt]{#1}%
}

\newcommand{\semio@window@cap@raise@to}[2]{%
  \raisebox{0pt}[\dimexpr#1\relax][0pt]{#2}%
}

\newcommand{\semio@window@cap@left@overlay}[1]{%
  \kern-\semio@window@cap@w
  \semio@window@cap@raise{\semio@window@stroke@v{#1}}%
  \kern\dimexpr\semio@window@cap@w-\semio@stroke@hairline\relax
}

\newcommand{\semio@window@cap@paint}[3]{%
  \hbox to #1{%
    \rlap{%
      \color{#2}%
      \rule{#1}{#3}%
    }%
    \vbox to #3{%
      \vfil
      \nointerlineskip
      \hbox to #1{\hfil\usebox{\semio@window@cap@slot}\hfil}%
      \vfil
    }%
  }%
}

\newcommand{\semio@window@cap@paint@nofill}[2]{%
  \vbox to #2{%
    \vfil
    \nointerlineskip
    \hbox to #1{\hfil\usebox{\semio@window@cap@slot}\hfil}%
    \vfil
  }%
}

\newcommand{\semio@window@cap@muted@vbox}[1]{%
  \vbox to \semio@window@cap@titleh{%
    \nointerlineskip
    \hbox{\semio@window@stroke@h{semio-chrome-border-normal}{\semio@window@cap@w}}%
    \nointerlineskip
    \hbox{\semio@window@cap@paint{\semio@window@cap@w}{#1}{\semio@window@cap@body@h}}%
  }%
}

\newcommand{\semio@window@cap@accent@vbox}[1]{%
  \vbox to \semio@window@cap@titleh{%
    \nointerlineskip
    \hbox{\semio@window@stroke@h{#1}{\semio@window@cap@w}}%
    \nointerlineskip
    \hbox{\semio@window@cap@paint{\semio@window@cap@w}{#1}{\semio@window@cap@body@h}}%
  }%
}

\newcommand{\semio@window@cap}[3]{%
  \semio@window@cap@body@h@set
  \sbox{\semio@window@cap@slot}{%
    \begingroup
    #3\relax
    \hspace{\semio@window@cap@hpad}#2\hspace{\semio@window@cap@hpad}%
    \endgroup
  }%
  \setlength{\semio@window@cap@w}{\wd\semio@window@cap@slot}%
    \semio@window@cap@metrics@set
  \hbox{%
    \semio@window@cap@raise{\semio@window@stroke@v{#1}}%
    \semio@window@cap@raise{\semio@window@cap@accent@vbox{#1}}%
    \semio@window@cap@left@overlay{#1}%
    \semio@window@cap@raise{\semio@window@stroke@v{#1}}%
  }%
}

% 📐 Open-bottom solid chip for pairs: identical to \semio@window@cap except the
% box stops one hairline above the pair baseline, so the row's shared full-width
% rule supplies the chip's bottom edge (and continues across the gap between the
% two chips) instead of the gap being filled into one solid rectangle.
\newcommand{\semio@window@cap@open}[3]{%
  \semio@window@cap@body@h@set
  \sbox{\semio@window@cap@slot}{%
    \begingroup
    #3\relax
    \hspace{\semio@window@cap@hpad}#2\hspace{\semio@window@cap@hpad}%
    \endgroup
  }%
  \setlength{\semio@window@cap@w}{\wd\semio@window@cap@slot}%
  \semio@window@cap@metrics@set
  \addtolength{\semio@window@cap@titleh}{-\semio@stroke@hairline}%
  \setlength{\semio@window@cap@body@h}{%
    \dimexpr\semio@window@cap@titleh-\semio@stroke@hairline\relax
  }%
  \hbox{%
    \semio@window@cap@raise{\semio@window@stroke@v{#1}}%
    \semio@window@cap@raise{\semio@window@cap@accent@vbox{#1}}%
    \semio@window@cap@left@overlay{#1}%
    \semio@window@cap@raise{\semio@window@stroke@v{#1}}%
  }%
}

\newcommand{\semio@window@tab}[2]{%
  \semio@window@cap{#1}{#2}{%
    \SemioSans\fontsize{\semio@chrome@font@chip}{\semio@chrome@font@chip}\selectfont\color{semio-chrome-canvas}%
  }%
}

\newcommand{\semio@window@ctrl}[2]{%
  \semio@window@cap{#1}{#2}{%
    \SemioSans\fontsize{\semio@chrome@font@chip}{\semio@chrome@font@chip}\selectfont\color{semio-chrome-canvas}%
  }%
}

%region Headings
\newcommand{\semio@heading@chip@font}{%
  \SemioSans\fontsize{\semio@chrome@font@chip}{\semio@chrome@font@chip}\selectfont
}

% 🔠 Section/appendix heading bars use a larger font than the small chrome
% chip font (navbar, footer, table captions keep the 7.2pt chip size). The
% title-bar height is em-based, so it scales with this font automatically.
\providecommand{\semio@chrome@font@heading}{11pt}
\newcommand{\semio@heading@bar@font}{%
  \SemioSans\fontsize{\semio@chrome@font@heading}{\semio@chrome@font@heading}\selectfont
}

% 📐 Outer outline-chip width = label slot + left hairline + right hairline.
% Written as a sum (not 2\semio@stroke@hairline): hairline is a macro starting
% with a digit (0.75pt), so 2\semio@stroke@hairline token-glues to 20.75pt and
% the top/bottom strokes overshoot the verticals by ~19pt (Bauteilportal).
% Returned as a dimexpr *term* so \semio@window@stroke@h's \dimexpr#2 wraps once.
\newcommand{\semio@window@cap@outer@w}{%
  \semio@window@cap@w+\semio@stroke@hairline+\semio@stroke@hairline
}

\newcommand{\semio@heading@cap@nofill@vbox}[1]{%
  \if\relax\detokenize{#1}\relax
    \vbox to \semio@window@cap@titleh{%
      \vfil
      \nointerlineskip
      \hbox to \semio@window@cap@w{\hfil\usebox{\semio@window@cap@slot}\hfil}%
      \vfil
    }%
  \else
    \vbox to \semio@window@cap@titleh{%
      \nointerlineskip
      \hbox{%
        \semio@window@stroke@v@to{#1}{\semio@window@cap@titleh}%
        \vbox{%
          \nointerlineskip
          \hbox{\semio@window@stroke@h{#1}{\semio@window@cap@w}}%
          \nointerlineskip
          \hbox{\semio@window@cap@paint@nofill{\semio@window@cap@w}{\dimexpr\semio@window@cap@body@h-\semio@stroke@hairline\relax}}%
          \nointerlineskip
          \hbox{\semio@window@stroke@h{#1}{\semio@window@cap@w}}%
        }%
        \semio@window@stroke@v@to{#1}{\semio@window@cap@titleh}%
      }%
    }%
  \fi
}

\newcommand{\semio@heading@cap@nofill}[3]{%
  \semio@window@cap@body@h@set
  \sbox{\semio@window@cap@slot}{%
    \begingroup
    \semio@heading@bar@font\color{#2}%
    \hspace{\semio@tab@inset}#1\hspace{\semio@tab@inset}%
    \endgroup
  }%
  \setlength{\semio@window@cap@w}{\wd\semio@window@cap@slot}%
  \renewcommand{\semio@window@cap@vpad@budget}{%
    \semio@tab@inset@v+\semio@tab@inset@v+\semio@stroke@hairline}%
  \semio@window@cap@metrics@set
  \hbox{\semio@window@cap@raise{\semio@heading@cap@nofill@vbox{#3}}}%
}

% 📐 Open-bottom outline chip for pairs: top is full outer width; sides stop above
% the shared pair baseline so verticals sit on that rule (no chip-local bottom).
\newcommand{\semio@heading@cap@nofill@open}[3]{%
  \semio@window@cap@body@h@set
  \sbox{\semio@window@cap@slot}{%
    \begingroup
    \semio@heading@bar@font\color{#2}%
    \hspace{\semio@tab@inset}#1\hspace{\semio@tab@inset}%
    \endgroup
  }%
  \setlength{\semio@window@cap@w}{\wd\semio@window@cap@slot}%
  \renewcommand{\semio@window@cap@vpad@budget}{%
    \semio@tab@inset@v+\semio@tab@inset@v+\semio@stroke@hairline}%
  \semio@window@cap@metrics@set
  \if\relax\detokenize{#3}\relax
    \hbox{%
      \semio@window@cap@raise@to{\semio@window@cap@titleh-\semio@stroke@hairline}{%
        \semio@window@cap@paint@nofill{\semio@window@cap@w}{\dimexpr\semio@window@cap@titleh-\semio@stroke@hairline\relax}%
      }%
    }%
  \else
    \semio@window@cap@raise@to{\semio@window@cap@titleh-\semio@stroke@hairline}{%
      \hbox{%
        \semio@window@stroke@v@to{#3}{\semio@window@cap@titleh-\semio@stroke@hairline}%
        \vbox{%
          \nointerlineskip
          \hbox{\semio@window@stroke@h{#3}{\semio@window@cap@w}}%
          \nointerlineskip
          \hbox{\semio@window@cap@paint@nofill{\semio@window@cap@w}{\dimexpr\semio@window@cap@body@h-\semio@stroke@hairline\relax}}%
        }%
        \semio@window@stroke@v@to{#3}{\semio@window@cap@titleh-\semio@stroke@hairline}%
      }%
    }%
  \fi
}

\newcommand{\semio@heading@cap@muted@core}[1]{%
  \semio@window@cap@body@h@set
  \sbox{\semio@window@cap@slot}{%
    \begingroup
    \semio@heading@bar@font\color{semio-chrome-text-normal}%
    \hspace{\semio@tab@inset}#1\hspace{\semio@tab@inset}%
    \endgroup
  }%
  \setlength{\semio@window@cap@w}{\wd\semio@window@cap@slot}%
  % Title-tab vertical inset: the label sits \semio@tab@inset@v (70% of the
  % horizontal \semio@tab@inset) from the top and bottom borders. The +hairline
  % compensates the tab's own top border stroke, so the canvas body (titleh−hairline)
  % yields \semio@tab@inset@v above AND below the vertically-centred label. Local to
  % the enclosing \hbox → other caps unaffected.
  \renewcommand{\semio@window@cap@vpad@budget}{%
    \semio@tab@inset@v+\semio@tab@inset@v+\semio@stroke@hairline}%
  \semio@window@cap@metrics@set
  \semio@window@cap@raise{\semio@window@cap@muted@vbox{semio-chrome-canvas}}%
}

\newcommand{\semio@heading@cap@muted@tab}[1]{%
  \hbox{%
    \semio@heading@cap@muted@core{#1}%
    \semio@window@cap@raise{\semio@window@stroke@v{semio-chrome-border-normal}}%
  }%
}

\newcommand{\semio@heading@cap@muted}[1]{%
  \hbox{%
    \semio@window@cap@raise{\semio@window@stroke@v{semio-chrome-border-normal}}%
    \semio@heading@cap@muted@core{#1}%
    \semio@window@cap@left@overlay{semio-chrome-border-normal}%
    \semio@window@cap@raise{\semio@window@stroke@v{semio-chrome-border-normal}}%
  }%
}

% 📐 Open-bottom muted tab for window/table headers. Mirror
% \semio@heading@cap@nofill@open: top + sides + canvas only, height
% titleh−hairline, so the shared baseline row is the sole bottom edge.
\newcommand{\semio@heading@cap@muted@open}[1]{%
  \semio@window@cap@body@h@set
  \sbox{\semio@window@cap@slot}{%
    \begingroup
    \semio@heading@bar@font\color{semio-chrome-text-normal}%
    \hspace{\semio@tab@inset}#1\hspace{\semio@tab@inset}%
    \endgroup
  }%
  \setlength{\semio@window@cap@w}{\wd\semio@window@cap@slot}%
  \renewcommand{\semio@window@cap@vpad@budget}{%
    \semio@tab@inset@v+\semio@tab@inset@v+\semio@stroke@hairline}%
  \semio@window@cap@metrics@set
  % Post-and-rail: L/R posts are full open height; top rail sits between them
  % (cap@w, not outer@w). Stacking a full-width top \rule above separate
  % verticals left a 1px cream butt-join notch at each outer top corner.
  \semio@window@cap@raise@to{\semio@window@cap@titleh-\semio@stroke@hairline}{%
    \hbox{%
      \semio@window@stroke@v@to{semio-chrome-border-normal}{\semio@window@cap@titleh-\semio@stroke@hairline}%
      \vbox{%
        \nointerlineskip
        \hbox{\semio@window@stroke@h{semio-chrome-border-normal}{\semio@window@cap@w}}%
        \nointerlineskip
        \hbox{\semio@window@cap@paint{\semio@window@cap@w}{semio-chrome-canvas}{\dimexpr\semio@window@cap@body@h-\semio@stroke@hairline\relax}}%
      }%
      \semio@window@stroke@v@to{semio-chrome-border-normal}{\semio@window@cap@titleh-\semio@stroke@hairline}%
    }%
  }%
}

\newcommand{\semio@heading@chip}[3]{%
  % LR-headbox-inset: match the window/table title tabs — the label sits
  % \semio@tab@inset from the left/right borders (via \semio@window@cap@hpad) and
  % \semio@tab@inset@v (70% of that) from top/bottom (via the vpad budget), instead
  % of the tight \semio@chrome@padding. Scoped to this box so accent tabs
  % (\semio@window@tab/@ctrl) keep their inset.
  \begingroup
  \renewcommand{\semio@window@cap@hpad}{\semio@tab@inset}%
  \renewcommand{\semio@window@cap@vpad@budget}{%
    \semio@tab@inset@v+\semio@tab@inset@v+\semio@stroke@hairline}%
  \semio@window@cap{#1}{#3}{%
    \semio@heading@bar@font\color{#2}%
  }%
  \endgroup
}

\newcommand{\semio@heading@chip@open}[3]{%
  \begingroup
  \renewcommand{\semio@window@cap@hpad}{\semio@tab@inset}%
  \renewcommand{\semio@window@cap@vpad@budget}{%
    \semio@tab@inset@v+\semio@tab@inset@v+\semio@stroke@hairline}%
  \semio@window@cap@open{#1}{#3}{%
    \semio@heading@bar@font\color{#2}%
  }%
  \endgroup
}

\newcommand{\semio@heading@number@suffix}[1]{%
  \if\relax\detokenize{#1}\relax\else#1.\fi
}


\newcommand{\semio@heading@row@wrap}[1]{%
  \semio@noindent@noparskip
  \vbox{%
    #1%
  }%
}

% 📐 Two-pass height sync makes title and number chips the same tallness (max of
% both) before they are placed on the shared pair baseline.
\newcommand{\semio@heading@pair@sync@height}{%
  \setlength{\semio@window@cap@min@titleh}{%
    \dimexpr\ht\semio@window@tab@box+\dp\semio@window@tab@box\relax
  }%
  \ifdim\dimexpr\ht\semio@window@ctrl@box+\dp\semio@window@ctrl@box\relax>\semio@window@cap@min@titleh\relax
    \setlength{\semio@window@cap@min@titleh}{%
      \dimexpr\ht\semio@window@ctrl@box+\dp\semio@window@ctrl@box\relax
    }%
  \fi
}

% 📐 Heading pairs — solid and outline alike: two open-bottom chips sit
% flush-left / flush-right on one shared baseline row, and a single full-width
% rule underneath supplies both chips' bottom edge and the connector between
% them. Solid levels therefore read as chip + border + chip, never as one
% continuous coloured rectangle spanning the text width.
\newcommand{\semio@heading@pair@row}[1]{%
  \semio@heading@row@wrap{%
    \vbox{%
      \hbox to \linewidth{%
        \usebox{\semio@window@tab@box}%
        \hfil
        \usebox{\semio@window@ctrl@box}%
      }%
      \nointerlineskip
      \hbox to \linewidth{%
        \semio@window@stroke@h{#1}{\linewidth}%
      }%
    }%
  }%
}

\newcommand{\semio@heading@pair}[5]{%
  \semio@hierarchy@path@set{\csname the#4\endcsname}%
  \setlength{\semio@window@cap@min@titleh}{\z@}%
  \sbox{\semio@window@tab@box}{\semio@heading@chip@open{#1}{#2}{#5}}%
  \sbox{\semio@window@ctrl@box}{\semio@heading@chip@open{#1}{#2}{\semio@heading@kind@number{#3}{#4}}}%
  \semio@heading@pair@sync@height
  % Open chips box to titleh−hairline (baseline is the pair row below); sync
  % measured that shorter box, so lift the floor back to full titleh.
  \addtolength{\semio@window@cap@min@titleh}{\dimexpr\semio@stroke@hairline\relax}%
  \sbox{\semio@window@tab@box}{\semio@heading@chip@open{#1}{#2}{#5}}%
  \sbox{\semio@window@ctrl@box}{\semio@heading@chip@open{#1}{#2}{\semio@heading@kind@number{#3}{#4}}}%
  \setlength{\semio@window@cap@min@titleh}{\z@}%
  \semio@heading@pair@row{#1}%
}

\newcommand{\semio@heading@pair@outline}[5]{%
  \semio@hierarchy@path@set{\csname the#4\endcsname}%
  \setlength{\semio@window@cap@min@titleh}{\z@}%
  \sbox{\semio@window@tab@box}{\semio@heading@cap@nofill@open{#5}{#2}{#1}}%
  \sbox{\semio@window@ctrl@box}{\semio@heading@cap@nofill@open{\semio@heading@kind@number{#3}{#4}}{#2}{#1}}%
  \semio@heading@pair@sync@height
  % Open chips box to titleh−hairline (baseline is the pair row below); sync
  % measured that shorter box, so lift the floor back to full titleh.
  \addtolength{\semio@window@cap@min@titleh}{\dimexpr\semio@stroke@hairline\relax}%
  \sbox{\semio@window@tab@box}{\semio@heading@cap@nofill@open{#5}{#2}{#1}}%
  \sbox{\semio@window@ctrl@box}{\semio@heading@cap@nofill@open{\semio@heading@kind@number{#3}{#4}}{#2}{#1}}%
  \setlength{\semio@window@cap@min@titleh}{\z@}%
  \semio@heading@pair@row{#1}%
}

% 📐 Explicit-number pairs — same construction as the level-driven pairs above,
% but the number is passed in rather than read from \the<level>, for the nested
% paragraphs whose numbers are composed by hand (see NestedParagraphs). Both
% carry the same argument order so the nest can pick one by ladder style alone.
\newcommand{\semio@heading@pair@num}[4]{%
  \semio@hierarchy@path@set{#1}%
  \setlength{\semio@window@cap@min@titleh}{\z@}%
  \sbox{\semio@window@tab@box}{\semio@heading@chip@open{#4}{#3}{#2}}%
  \sbox{\semio@window@ctrl@box}{\semio@heading@chip@open{#4}{#3}{\semio@kind@number@bare{#1}}}%
  \semio@heading@pair@sync@height
  \addtolength{\semio@window@cap@min@titleh}{\dimexpr\semio@stroke@hairline\relax}%
  \sbox{\semio@window@tab@box}{\semio@heading@chip@open{#4}{#3}{#2}}%
  \sbox{\semio@window@ctrl@box}{\semio@heading@chip@open{#4}{#3}{\semio@kind@number@bare{#1}}}%
  \setlength{\semio@window@cap@min@titleh}{\z@}%
  \semio@heading@pair@row{#4}%
}

\newcommand{\semio@heading@pair@nofill@num}[4]{%
  \semio@hierarchy@path@set{#1}%
  \setlength{\semio@window@cap@min@titleh}{\z@}%
  \sbox{\semio@window@tab@box}{\semio@heading@cap@nofill@open{#2}{#3}{#4}}%
  \sbox{\semio@window@ctrl@box}{\semio@heading@cap@nofill@open{\semio@kind@number@bare{#1}}{#3}{#4}}%
  \semio@heading@pair@sync@height
  \addtolength{\semio@window@cap@min@titleh}{\dimexpr\semio@stroke@hairline\relax}%
  \sbox{\semio@window@tab@box}{\semio@heading@cap@nofill@open{#2}{#3}{#4}}%
  \sbox{\semio@window@ctrl@box}{\semio@heading@cap@nofill@open{\semio@kind@number@bare{#1}}{#3}{#4}}%
  \setlength{\semio@window@cap@min@titleh}{\z@}%
  \semio@heading@pair@row{#4}%
}

\newcommand{\semio@heading@title@end}[3]{%
  \semio@heading@row@wrap{%
    \semio@heading@chip{#1}{#2}{#3}%
  }%
}

\newcommand{\semio@heading@title@end@outline}[3]{%
  \semio@heading@row@wrap{%
    \semio@heading@cap@nofill{#3}{#2}{#1}%
  }%
}

\newcommand{\semio@toc@level@part}{-1}
\newcommand{\semio@toc@level@chapter}{0}
\newcommand{\semio@toc@level@section}{1}
\newcommand{\semio@toc@level@subsection}{2}
\newcommand{\semio@toc@level@subsubsection}{3}
\newcommand{\semio@toc@level@paragraph}{4}
\newcommand{\semio@toc@level@subparagraph}{5}
\newcommand{\semio@toc@depth@unlimited}{99}

\newcommand{\semio@toc@level}[1]{%
  \ifcsname semio@toc@level@#1\endcsname
    \csname semio@toc@level@#1\endcsname
  \else
    10%
  \fi
}

\newcommand{\semio@toc@track@heading}[2]{%
  \ifnum\numexpr\semio@toc@level{#1}\relax>\value{tocdepth}\else
    \semio@toc@track@num{#1}{\csname the#1\endcsname}{#2}%
  \fi
}

\newcommand{\semio@toc@track@heading@num}[3]{%
  \ifnum\numexpr\semio@toc@level{#1}\relax>\value{tocdepth}\else
    \semio@toc@track@num{#1}{#2}{#3}%
  \fi
}

\def\semio@heading@style@outline@marker{outline}%

% LR-topspace: tunable extra breathing room above every display heading
% (section / subsection / subsubsection / paragraph / appendix). Applied in the
% shared dispatch below via \addvspace, which merges with the block-before glue
% (no double gap) and is dropped at the top of a page (leading headings aren't
% pushed down). Adjust this one length to taste.
\providecommand{\semio@heading@topskip}{1.28em}
% LR-bottomskip: dedicated space BELOW every heading bar, before the body text
% (KOMA's afterskip is pinned to 1sp, so without this there is no knob). Used by
% \semio@koma@heading@lines and the nested-paragraph renderer below; may be
% negative to tighten below the natural minimum.
\providecommand{\semio@heading@bottomskip}{-1.38pt}
\newcommand{\semio@koma@heading@lines}[5]{%
  \semio@block@before
  \addvspace{\semio@heading@topskip}% LR-topspace: a bit more air above headings
  % 🧲 Keep the heading bar with its first lines of content so it never sits
  % orphaned at the foot of a page (reserves the bar + ~3 body lines; if that
  % much space isn't left, the heading moves to the next page as one unit).
  % LR-2.7: reserve a SECOND title bar's worth on top, so a heading that
  % introduces a table (heading -> optional "N Fälle." count -> table title bar)
  % keeps that title bar with it instead of stranding the heading at the page
  % foot above a table that migrated to the next page.
  \Needspace*{\dimexpr\semio@chrome@titlebar@height+3\baselineskip+\semio@chrome@titlebar@height\relax}%
  \ifnum\numexpr\semio@toc@level{#1}\relax>\value{tocdepth}\else
    \semio@toc@track@num{#1}{\csname the#1\endcsname}{#3}%
  \fi
  \semio@chrome@heading@track{#1}{#3}%
  \semio@if@heading@chips
    {%
      \edef\semio@heading@style@resolved{\csname semio@heading@style@#1\endcsname}%
      \ifx\semio@heading@style@resolved\semio@heading@style@outline@marker
        \if\relax\detokenize{#4}\relax
          \semio@heading@title@end@outline{#2}{#5}{#3}%
        \else
          \semio@heading@pair@outline{#2}{#5}{#1}{#1}{#3}%
        \fi
      \else
        \if\relax\detokenize{#4}\relax
          \semio@heading@title@end{#2}{#5}{#3}%
        \else
          \semio@heading@pair{#2}{#5}{#1}{#1}{#3}%
        \fi
      \fi
    }%
    {#3}%
  \vspace{\semio@heading@bottomskip}% LR-bottomskip: space below the heading bar
}

\newcommand{\semio@heading@lines@dispatch}[4]{%
  \semio@koma@heading@lines{#1}{\csname semio@heading@color@#1\endcsname}{#4}{#3}{\csname semio@heading@textcolor@#1\endcsname}%
}

\newcommand{\semio@heading@install@spacing}[1]{%
  % 🪝 KOMA suppresses beforeskip when a heading directly follows another
  % heading (\@nobreak); the real before-space is emitted unconditionally
  % by \semio@block@before inside \semio@koma@heading@lines instead. Both
  % skips stay a strictly positive 1sp only so KOMA keeps display-style
  % (not run-in) heading placement — see \@xsect.
  \RedeclareSectionCommand[
    beforeskip=1sp,
    afterskip=1sp,
  ]{#1}%
}

% 🪜 The heading ladder: each of the three brand colours occupies two
% consecutive rungs, filled first then outlined, so depth reads twice over —
% once in the hue, once in the fill. Past the last brand pair the ladder runs
% out of hues and steps down through the neutrals instead, outline-only, so
% arbitrarily deep nesting still terminates in something legible.
% Rungs are handed out by a level's position in the *class's own* heading
% sequence, never by its name: an article-style class has no \chapter, so its
% \section takes the rung \chapter would have held instead of leaving that
% outline rung unused and jumping a whole colour. \semio@heading@rung@<level>
% keeps each level's number so the nested-paragraph chips (which sit below the
% deepest numbered level, see NestedParagraphs) can carry on down the same
% ladder rather than starting a second one.
% {@link https://github.com/usalu/semio/issues/2429}
\newcommand{\semio@heading@ladder@color}[1]{%
  \ifcase#1 semio-tertiary%
  \or semio-tertiary%
  \or semio-secondary%
  \or semio-secondary%
  \or semio-primary%
  \or semio-primary%
  \or semio-chrome-panel%
  \or semio-chrome-border-emphasized%
  \else semio-chrome-border-normal%
  \fi
}

\newcommand{\semio@heading@ladder@style}[1]{%
  \ifcase#1 solid%
  \or outline%
  \or solid%
  \or outline%
  \or solid%
  \or outline%
  \or solid%
  \else outline%
  \fi
}

\newcommand{\semio@heading@ladder@step}[1]{%
  \expandafter\edef\csname semio@heading@rung@#1\endcsname{\number\@tempcnta}%
  \expandafter\edef\csname semio@heading@color@#1\endcsname{%
    \semio@heading@ladder@color{\number\@tempcnta}%
  }%
  \expandafter\edef\csname semio@heading@style@#1\endcsname{%
    \semio@heading@ladder@style{\number\@tempcnta}%
  }%
  \expandafter\def\csname semio@heading@textcolor@#1\endcsname{semio-chrome-foreground}%
  \advance\@tempcnta\@ne
}

\newcommand{\semio@heading@ladder@install}{%
  \@tempcnta\z@
  \semio@heading@ladder@step{part}%
  \ifcsname chapter\endcsname
    \semio@heading@ladder@step{chapter}%
  \fi
  \semio@heading@ladder@step{section}%
  \semio@heading@ladder@step{subsection}%
  \semio@heading@ladder@step{subsubsection}%
  \semio@heading@ladder@step{paragraph}%
  \semio@heading@ladder@step{subparagraph}%
}

\newcommand{\semio@heading@installall}{%
  \semio@heading@ladder@install
  \ifcsname chapter\endcsname
    \setkomafont{chapter}{\semio@heading@chip@font}%
  \fi
  \setkomafont{section}{\semio@heading@chip@font}%
  \setkomafont{subsection}{\semio@heading@chip@font}%
  \setkomafont{subsubsection}{\semio@heading@chip@font}%
  \setkomafont{paragraph}{\semio@heading@chip@font}%
  \setkomafont{subparagraph}{\semio@heading@chip@font}%
  \let\semio@orig@sectionlinesformat\sectionlinesformat
  \RenewDocumentCommand\sectionlinesformat{mmmm}{%
    \semio@heading@lines@dispatch{##1}{##2}{##3}{##4}%
  }%
  \ifcsname chapterlinesformat\endcsname
    \let\semio@orig@chapterlinesformat\chapterlinesformat
    \RenewDocumentCommand\chapterlinesformat{mmm}{%
      \semio@koma@heading@lines{chapter}{\semio@heading@color@chapter}{##3}{##2}{\semio@heading@textcolor@chapter}%
    }%
  \fi
  \ifcsname partlineswithprefixformat\endcsname
    \let\semio@orig@partlineswithprefixformat\partlineswithprefixformat
    \RenewDocumentCommand\partlineswithprefixformat{mmm}{%
      \def\semio@part@kind{part}%
      \def\semio@part@kind@got{##1}%
      \ifx\semio@part@kind@got\semio@part@kind
        \edef\semio@part@title{\@currentheadentry}%
        \edef\semio@part@invoke{%
          \noexpand\semio@koma@heading@lines{part}{\semio@heading@color@part}%
          {\semio@part@title}{\unexpanded{##2}}{\semio@heading@textcolor@part}%
        }%
        \semio@part@invoke
      \else
        \semio@orig@partlineswithprefixformat{##1}{##2}{##3}%
      \fi
    }%
  \fi
  \ifcsname chapter\endcsname
    \semio@heading@install@spacing{chapter}%
  \fi
  \semio@heading@install@spacing{part}%
  \semio@heading@install@spacing{section}%
  \semio@heading@install@spacing{subsection}%
  \semio@heading@install@spacing{subsubsection}%
  \semio@heading@install@spacing{paragraph}%
  \semio@heading@install@spacing{subparagraph}%
  % 🪜 \newcounter{paragraph}[subsubsection] resets paragraph whenever
  % subsubsection steps, but a document may nest \paragraph directly under
  % \subsection (skipping \subsubsection, e.g. the appendix user-story list)
  % — that \subsection call still resets subsubsection to 0, so the kernel's
  % default \theparagraph (always \thesubsubsection.\arabic{paragraph}) would
  % render a phantom ".0." segment for a level that was never actually used.
  % Drop that segment only when subsubsection is genuinely unused (=0); once
  % \subsubsection *is* called, its counter is nonzero and the normal 4-level
  % form composes exactly as before.
  \renewcommand{\theparagraph}{%
    \ifnum\c@subsubsection=\z@
      \thesubsection.\arabic{paragraph}%
    \else
      \thesubsubsection.\arabic{paragraph}%
    \fi
  }%
}

%endregion Headings

%region NestedParagraphs
\newcounter{semio@nest@depth}
\newcounter{semio@nest@a}
\newcounter{semio@nest@b}[semio@nest@a]
\newcounter{semio@nest@c}[semio@nest@b]
\newcounter{semio@nest@d}[semio@nest@c]
\newcounter{semio@nest@e}[semio@nest@d]

\newcommand{\semio@nest@counter@reset}{%
  \ifcase\value{semio@nest@depth}\or
    \setcounter{semio@nest@a}{0}\or
    \setcounter{semio@nest@b}{0}\or
    \setcounter{semio@nest@c}{0}\or
    \setcounter{semio@nest@d}{0}\or
    \setcounter{semio@nest@e}{0}%
  \fi
}

\newcommand{\semio@nest@counter@step}{%
  \ifcase\value{semio@nest@depth}\or
    \stepcounter{semio@nest@a}\or
    \stepcounter{semio@nest@b}\or
    \stepcounter{semio@nest@c}\or
    \stepcounter{semio@nest@d}\or
    \stepcounter{semio@nest@e}%
  \fi
}

\newcommand{\semio@nest@build@number}{%
  \ifnum\c@paragraph>\z@ \theparagraph\else \thesubsubsection\fi
  \ifnum\value{semio@nest@depth}>0 .\thesemio@nest@a\fi
  \ifnum\value{semio@nest@depth}>1 .\thesemio@nest@b\fi
  \ifnum\value{semio@nest@depth}>2 .\thesemio@nest@c\fi
  \ifnum\value{semio@nest@depth}>3 .\thesemio@nest@d\fi
  \ifnum\value{semio@nest@depth}>4 .\thesemio@nest@e\fi
}

% 🎨 Nested paragraphs keep walking the heading ladder (see Headings) instead of
% starting a palette of their own: a nest chip sits exactly one rung below the
% level whose number it extends — \paragraph once that level has been used,
% \subsubsection otherwise, mirroring \semio@nest@build@number — and each extra
% depth steps one rung further. Depths past the last brand pair land on the
% ladder's neutral outline tail, which is where they lived before.
\newcommand{\semio@nest@style@resolve}{%
  \ifnum\c@paragraph>\z@
    \edef\semio@nest@rung{\number\numexpr\semio@heading@rung@paragraph+\value{semio@nest@depth}\relax}%
  \else
    \edef\semio@nest@rung{\number\numexpr\semio@heading@rung@subsubsection+\value{semio@nest@depth}\relax}%
  \fi
  \edef\semio@nest@color{\semio@heading@ladder@color{\semio@nest@rung}}%
  \edef\semio@nest@style{\semio@heading@ladder@style{\semio@nest@rung}}%
}

\newcommand{\semio@nest@paragraph}[1]{%
  \semio@block@before
  \addvspace{\semio@heading@topskip}% LR-topspace: same extra air above nested-paragraph headings (SemioNest redefines \paragraph to this, bypassing the main dispatch)
  % LR-orphanfix: nested-paragraph headings bypass \semio@koma@heading@lines and
  % so never got its keep-with-next reservation, leaving them stranded at the
  % page foot (e.g. "Gestaltung", "Tragwerksplanung"). Reserve the bar + ~3 body
  % lines so the heading moves to the next page with its content as one unit.
  \Needspace*{\dimexpr\semio@chrome@titlebar@height+3\baselineskip\relax}%
  \semio@nest@counter@step
  \edef\semio@nest@num{\semio@nest@build@number}%
  \ifnum\numexpr\semio@toc@level@subparagraph+\value{semio@nest@depth}\relax>\value{tocdepth}\else
    \semio@toc@track@num{paragraph}{\semio@nest@num}{#1}%
  \fi
  \semio@nest@style@resolve
  \ifx\semio@nest@style\semio@heading@style@outline@marker
    \semio@heading@pair@nofill@num{\semio@nest@num}{#1}{semio-chrome-foreground}{\semio@nest@color}%
  \else
    \semio@heading@pair@num{\semio@nest@num}{#1}{semio-chrome-foreground}{\semio@nest@color}%
  \fi
  \vspace{\semio@heading@bottomskip}% LR-bottomskip: space below nested-paragraph headings
  \semio@block@after
}

\newenvironment{SemioNest}{%
  \stepcounter{semio@nest@depth}%
  \semio@nest@counter@reset
  \begingroup
  \let\semio@saved@paragraph\paragraph
  \def\paragraph{\semio@nest@paragraph}%
}{%
  \endgroup
  \addtocounter{semio@nest@depth}{-1}%
}
%endregion NestedParagraphs

%region Header gap — open connector joining the title tab to the number/key tab; {@link https://github.com/usalu/semio/issues/1965}
% Open connector for MUTED title bars (table / figure / contents): the two chips
% are tabs sitting on the component's top edge, so the middle must stay UNFILLED
% (paper shows through) with NO top line — only a baseline stroke joining the two
% tabs along the component's top border. Height comes from the tab box — the chip
% builders set \semio@window@cap@titleh *inside* the \sbox that measures each chip,
% so that length has reverted by the time this macro runs in the surrounding row,
% while \ht+\dp of the tab box persists and is exactly the chip height.
% Open connector spacer between title and number tabs (no stroke here — the
% shared full-width baseline row below supplies the bottom edge for both chips).
\newcommand{\semio@window@header@gap@open}[1]{%
  \raisebox{0pt}[\dimexpr\ht\semio@window@tab@box+\dp\semio@window@tab@box\relax][0pt]{%
    \vbox to \dimexpr\ht\semio@window@tab@box+\dp\semio@window@tab@box\relax{%
      \vfil
      \nointerlineskip
      \hbox to \dimexpr\semio@window@gap@w\relax{\hfil}%
    }%
  }%
}
%endregion Header gap

\newcommand{\semio@window@header@row@wrap}[1]{%
  \ifvmode\else\par\fi
  \semio@noindent@noparskip
  #1%
  \ifvmode\nointerlineskip\fi
}

%region WindowHeaderMuted
% 🪟 Muted title/number chip row. Open-bottom caps (\semio@heading@cap@muted@open)
% stop one hairline above the shared baseline so that stroke is the sole bottom
% edge. Page-1 tcolorbox windows paint chips+baseline inline (same as long
% tables); the seam vskip welds frame.north onto that baseline. Page-1 overlay
% does NOT restroke the baseline (that doubled when the seam was off). Omitting
% the inline baseline left a ~5pt page gap under the open chips (seam was
% calibrated for chips+baseline height).
\newif\ifsemio@window@header@draw@baseline
\semio@window@header@draw@baselinetrue
% Flush: chip row / baseline span exactly \linewidth (no overhang).
% Required for tcolorbox windows so chip L/R sit on the continuous leftrule/
% rightrule. Long-table chrome keeps the overhang path (borders live outside a
% shrunk \linewidth; pull left by one hairline so chip L matches border@L).
\newif\ifsemio@window@header@flush
\semio@window@header@flushfalse

\newcommand{\semio@window@header@muted}[2]{%
  \semio@window@header@draw@baselinetrue
  \semio@window@header@muted@core{#1}{#2}%
}

% tcolorbox page-1: open chips + inline baseline (sole top hairline; no overlay stroke).
\newcommand{\semio@window@header@invoke@tcb}{%
  \semio@window@header@flushtrue
  \semio@window@header@muted{\semio@window@header@number@page1}{\semio@window@header@title}%
  \semio@window@header@flushfalse
}

\newcommand{\semio@window@header@muted@rowbox}[1]{%
  \ifsemio@window@header@flush
    \hbox to \linewidth{#1}%
  \else
    % 🩹 Pull left by one hairline and span inner+2·hairline so chip L/R sit on
    % the outer faces of border@L/R (title chip L and number chip R). \hspace*
    % (not \moveleft) so the pull works in the chrome hlist.
    \hbox{%
      \hspace*{-\semio@stroke@hairline}%
      \hbox to \dimexpr\linewidth+\semio@stroke@hairline+\semio@stroke@hairline\relax{#1}%
    }%
  \fi
}

\newcommand{\semio@window@header@muted@core}[2]{%
  \sbox{\semio@window@tab@box}{\semio@heading@cap@muted@open{\textcolor{semio-chrome-foreground}{#2}}}%
  \edef\semio@window@header@numval{#1}%
  \if\relax\detokenize\expandafter{\semio@window@header@numval}\relax
    \ifsemio@window@header@flush
      \setlength{\semio@window@gap@w}{%
        \dimexpr\linewidth-\wd\semio@window@tab@box\relax
      }%
    \else
      \setlength{\semio@window@gap@w}{%
        \dimexpr\linewidth+\semio@stroke@hairline+\semio@stroke@hairline-\wd\semio@window@tab@box\relax
      }%
    \fi
    \semio@window@header@row@wrap{%
      \vbox{%
        \semio@window@header@muted@rowbox{%
          \usebox{\semio@window@tab@box}%
          \semio@window@header@gap@open{semio-chrome-border-normal}%
        }%
        \semio@window@header@baseline@or@slot
      }%
    }%
  \else
    \sbox{\semio@window@ctrl@box}{\semio@heading@cap@muted@open{#1}}%
    \ifsemio@window@header@flush
      \setlength{\semio@window@gap@w}{%
        \dimexpr\linewidth-\wd\semio@window@tab@box-\wd\semio@window@ctrl@box+\semio@stroke@hairline\relax
      }%
    \else
      \setlength{\semio@window@gap@w}{%
        \dimexpr\linewidth+\semio@stroke@hairline+\semio@stroke@hairline-\wd\semio@window@tab@box-\wd\semio@window@ctrl@box+\semio@stroke@hairline\relax
      }%
    \fi
    \semio@window@header@row@wrap{%
      \vbox{%
        \semio@window@header@muted@rowbox{%
          \usebox{\semio@window@tab@box}%
          \semio@window@header@gap@open{semio-chrome-border-normal}%
          \hskip-\semio@stroke@hairline\relax
          \usebox{\semio@window@ctrl@box}%
        }%
        \semio@window@header@baseline@or@slot
      }%
    }%
  \fi
}

% 🩹 Corner stubs: overlap the shared baseline into body border@L/R below.
% Plain \hrule/\rule abutting a row \vrule is a butt join — PDF rasterizers
% leave a 1-device-pixel cream notch at the outer top-left/top-right corners
% (TOC "Seite", long chrome). Stubs live inside the baseline \hbox (via
% \rlap/\llap) so this stays legal in both vmode and hmode (cover pages).
\newcommand{\semio@window@header@baseline@corner@stub}{%
  \textcolor{semio-chrome-border-normal}{%
    \vrule width\semio@stroke@hairline
           height\semio@stroke@hairline
           depth\dimexpr\semio@stroke@hairline+3pt\relax
  }%
}
\newcommand{\semio@window@header@baseline@or@slot}{%
  \ifsemio@window@header@draw@baseline
    \ifvmode\nointerlineskip\fi
    \ifsemio@window@header@flush
      \hbox to \linewidth{%
        \rlap{\smash{\semio@window@header@baseline@corner@stub}}%
        \semio@window@stroke@h{semio-chrome-border-normal}{\linewidth}%
        \llap{\smash{\semio@window@header@baseline@corner@stub}}%
      }%
    \else
      \hbox{%
        \hspace*{-\semio@stroke@hairline}%
        \hbox to \dimexpr\linewidth+\semio@stroke@hairline+\semio@stroke@hairline\relax{%
          \rlap{\smash{\semio@window@header@baseline@corner@stub}}%
          \semio@window@stroke@h{semio-chrome-border-normal}{\dimexpr\linewidth+\semio@stroke@hairline+\semio@stroke@hairline\relax}%
          \llap{\smash{\semio@window@header@baseline@corner@stub}}%
        }%
      }%
    \fi
  \fi
}
%endregion WindowHeaderMuted

