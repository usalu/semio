\newcommand{\semio@nest@counter@step}{%
  \ifcase\value{semio@nest@depth}\or
    \stepcounter{semio@nest@a}\or
    \stepcounter{semio@nest@b}\or
    \stepcounter{semio@nest@c}\or
    \stepcounter{semio@nest@d}\or
    \stepcounter{semio@nest@e}%
  \fi
}

\newcommand{\semio@nest@build@number}{%
  \ifnum\c@paragraph>\z@ \theparagraph\else \thesubsubsection\fi
  \ifnum\value{semio@nest@depth}>0 .\thesemio@nest@a\fi
  \ifnum\value{semio@nest@depth}>1 .\thesemio@nest@b\fi
  \ifnum\value{semio@nest@depth}>2 .\thesemio@nest@c\fi
  \ifnum\value{semio@nest@depth}>3 .\thesemio@nest@d\fi
  \ifnum\value{semio@nest@depth}>4 .\thesemio@nest@e\fi
}

\newcommand{\semio@nest@paragraph}[1]{%
  \semio@heading@block@before
  \semio@nest@counter@step
  \edef\semio@nest@num{\semio@nest@build@number}%
  \ifnum\numexpr\semio@toc@level@paragraph+\value{semio@nest@depth}\relax>\value{tocdepth}\else
    \semio@toc@track@num{paragraph}{\semio@nest@num}{#1}%
  \fi
  \semio@heading@pair@muted@num{paragraph}{\semio@nest@num}{#1}%
  \semio@heading@block@after
}

\newenvironment{SemioNest}{%
  \stepcounter{semio@nest@depth}%
  \semio@nest@counter@reset
  \begingroup
  \let\semio@saved@paragraph\paragraph
  \def\paragraph{\semio@nest@paragraph}%
}{%
  \endgroup
  \addtocounter{semio@nest@depth}{-1}%
}
