%region TableLongWindow
% 📋 Long tables need register/number/label like \begin{Table}, but must not
% open a tcolorbox (longtable supplies its own rules and page-break chrome).
\cs_new_protected:Npn \semio_table_long_open:n #1 {
  \semio_window_content_state_reset:
  \tl_set_eq:NN \l_semio_window_key_tl \l_semio_table_key_tl
  \tl_set:Nn \l_semio_window_kind_title_tl {#1}
  \tl_set:Nx \l_semio_window_kind_title_tl { \tl_use:N \l_semio_window_kind_title_tl }
  \use:c { semio@window@enter }
  \refstepcounter { semiotable }
  \semio_window_kind_number_set:n { semiotable }
  \semio_window_register_write:nn { semiotable } { table }
  \semio_window_break_suffix_apply:
  \semio_window_header_store:
  \semio_block_sep_before:
  \semio_window_header_keep_with_body:
  % 🩹 The title bar is NOT drawn here as a separate chip anymore. A chip drawn
  % before \begin{longtable} was floated *below* longtable's firsthead (the
  % column-header row hoists to the galley top), so the title rendered under
  % the header. The title is now emitted inside the longtable's firsthead
  % itself (see \semio@table@long@render), exactly like the continuation head,
  % so it stacks above the column header on every page.
}
