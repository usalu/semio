\newcommand{\semio@chrome@dims@compute}{%
  \begingroup
  \normalfont
  \xdef\semio@chrome@tmp@row{\the\dimexpr\semio@chrome@font@body\relax}%
  \xdef\semio@chrome@tmp@row@footer{\the\dimexpr\semio@chrome@font@number\relax}%
  \endgroup
  \setlength{\semio@chrome@row@height}{\semio@chrome@tmp@row}%
  \setlength{\semio@chrome@row@height@footer}{\semio@chrome@tmp@row@footer}%
  \setlength{\semio@chrome@icon@height}{\semio@chrome@row@height}%
  \setlength{\semio@chrome@icon@height@footer}{\semio@chrome@row@height@footer}%
  \semio@chrome@emblem@rebuild
}

\newcommand{\semio@chrome@chip}[1]{%
  \begingroup
  \setlength{\fboxsep}{\semio@chrome@padding}%
  \setlength{\fboxrule}{\semio@stroke@hairline}%
  \fcolorbox{semio-chrome-border-normal}{semio-chrome-base}{#1}%
  \endgroup
}

\newcommand{\semio@chrome@navbar@bar}[1]{%
  \vbox{%
    \nointerlineskip
    \hbox to \headwidth{%
      \setlength{\fboxsep}{0pt}%
      \colorbox{semio-chrome-base}{%
        \parbox[c][\semio@chrome@navbar@height][c]{\headwidth}{#1}%
      }%
    }%
    \nointerlineskip
    \hbox to \headwidth{%
      \color{semio-chrome-border-normal}\rule{\headwidth}{\semio@stroke@hairline}%
    }%
  }%
}

\newcommand{\semio@chrome@footer@bar}[1]{%
  \vbox{%
    \nointerlineskip
    \hbox to \headwidth{%
      \color{semio-chrome-border-normal}\rule{\headwidth}{\semio@stroke@hairline}%
    }%
    \nointerlineskip
    \hbox to \headwidth{%
      \setlength{\fboxsep}{0pt}%
      \colorbox{semio-chrome-base}{%
        \parbox[c][\semio@chrome@footer@height][c]{\headwidth}{#1}%
      }%
    }%
  }%
}

\newcommand{\SemioChromeNavbarHead}{%
  \semio@chrome@navbar@bar{%
    \hbox to \headwidth{%
      \semio@chrome@chip{%
        \hbox{%
          \semio@chrome@vcenter{\semio@chrome@row@height}{\usebox{\semio@chrome@navbar@emblem@box}}%
          \hspace{\semio@chrome@padding}%
          \semio@chrome@vcenter{\semio@chrome@row@height}{%
            {\SemioSans\fontsize{\semio@chrome@font@body}{\semio@chrome@font@body}\selectfont\@title}%
          }%
        }%
      }%
      \hfil
      \if\relax\detokenize{\semio@chrome@heading}\relax
      \else
        \semio@chrome@chip{%
          \semio@chrome@vcenter{\semio@chrome@row@height}{%
            {\SemioSans\fontsize{\semio@chrome@font@title}{\semio@chrome@font@title}\selectfont\semio@chrome@heading}%
          }%
        }%
      \fi
    }%
  }%
}

\newcommand{\SemioChromeFooterHead}{%
  \semio@chrome@footer@bar{%
    \hbox to \headwidth{%
      \semio@chrome@chip{%
        \hbox{%
          \semio@chrome@vcenter{\semio@chrome@row@height@footer}{\usebox{\semio@chrome@footer@emblem@box}}%
          \hspace{\semio@chrome@padding}%
          \semio@chrome@vcenter{\semio@chrome@row@height@footer}{%
            {\SemioSans\fontsize{\semio@chrome@font@number}{\semio@chrome@font@number}\selectfont\@author}%
          }%
        }%
      }%
      \hfil
      \semio@chrome@chip{%
        \semio@chrome@vcenter{\semio@chrome@row@height@footer}{%
          {\SemioMono\fontsize{\semio@chrome@font@number}{\semio@chrome@font@number}\selectfont\thepage}%
        }%
      }%
    }%
  }%
}

\newcommand{\SemioChromeIconSize}[1]{%
  \setlength{\semio@chrome@row@height}{\dimexpr#1\relax}%
  \setlength{\semio@chrome@icon@height}{\semio@chrome@row@height}%
  \semio@chrome@emblem@rebuild
}
\newcommand{\SemioChromeFooterIconSize}[1]{%
  \setlength{\semio@chrome@row@height@footer}{\dimexpr#1\relax}%
  \setlength{\semio@chrome@icon@height@footer}{\semio@chrome@row@height@footer}%
  \semio@chrome@emblem@rebuild
}

\NewDocumentCommand{\SemioChromeIconScale}{m}{%
  \renewcommand{\semio@chrome@icon@scale}{#1}%
  \semio@chrome@dims@compute
}
\NewDocumentCommand{\SemioChromeFooterIconScale}{m}{%
  \renewcommand{\semio@chrome@icon@scale@footer}{#1}%
  \semio@chrome@dims@compute
}

