  \exp_args:Nc \semio_window_frame_seq_ensure:N { g_semio_window_items_body_seq_ \int_use:N \g_semio_window_depth_int }
  \exp_args:Nc \semio_window_frame_seq_ensure:N { g_semio_window_items_dims_seq_ \int_use:N \g_semio_window_depth_int }
}

