% \int_step_inline:nn/\seq_map_inline:Nn are not safe to nest (l3kernel shares
% one internal loop-body macro across all active calls of the same name), and
% a WindowRow/WindowColumn item's captured body can itself open a nested
% WindowRow/WindowColumn, which would re-enter the same inline loop. These two
% renderers thread the loop index/count as real per-call macro parameters
% instead, which is always safe to nest or recurse. They read the CURRENT
% frame's dims/body seqs (see \semio_window_frame_push:) at the point each
% item is rendered — always the caller's own frame, since a nested
% WindowRow/WindowColumn rendered along the way pushes/pops its own frame
% around itself without disturbing the caller's.
\cs_new_protected:Npn \semio_window_row_items_render:nn #1 #2 {
  \int_compare:nNnF {#1} > {#2} {
    \group_begin:
      \semio_window_item_provide:n { \dim_use:N \l_semio_window_height_dim }
      \semio@window@row@col
        { \exp_args:Nc \seq_item:Nn { \semio_window_frame_dims_seq_name: } {#1} }
        { \exp_args:Nc \seq_item:Nn { \semio_window_frame_body_seq_name: } {#1} }
    \group_end:
    \int_compare:nNnF {#1} = {#2} { \hspace{\semio@window@gap} }
    \semio_window_row_items_render:nn { \int_eval:n { #1 + 1 } } {#2}
  }
}

\cs_new_protected:Npn \semio_window_column_items_render:nn #1 #2 {
  \int_compare:nNnF {#1} > {#2} {
    \int_compare:nNnT {#1} > { 1 } { \vspace{\semio@window@gap} }
    \group_begin:
      \semio_window_item_provide:n { \exp_args:Nc \seq_item:Nn { \semio_window_frame_dims_seq_name: } {#1} }
      \exp_args:Nc \seq_item:Nn { \semio_window_frame_body_seq_name: } {#1}
    \group_end:
    \semio_window_column_items_render:nn { \int_eval:n { #1 + 1 } } {#2}
  }
}

