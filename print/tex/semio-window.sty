%region Registers
\cs_new_protected:Npn \semio_window_register_write:nn #1#2 {
  \semio_hierarchy_path_sync_document:
  \tl_if_empty:NTF \g_semio_hierarchy_path_tl {
    \tl_set:Nx \l_semio_window_register_number_tl { \alph { semio@window@slot } }
  } {
    \tl_set:Nx \l_semio_window_register_number_tl {
      \tl_use:N \g_semio_hierarchy_path_tl . \alph { semio@window@slot }
    }
  }
  \str_set:Nx \l_tmpb_str { semio-register-#2-\tl_use:N \l_semio_window_register_number_tl }
  \exp_args:NV \label \l_tmpb_str
  \group_begin:
    \exp_args:Nc \seq_gput_right:Nx { g_semio_register_ #1 _num_seq }
      { \tl_use:N \l_semio_window_register_number_tl }
    \exp_args:Nc \seq_gput_right:Nx { g_semio_register_ #1 _title_seq }
      { \tl_use:N \l_semio_window_kind_title_tl }
    \exp_args:Nc \seq_gput_right:Nx { g_semio_register_ #1 _label_seq }
      { \str_use:N \l_tmpb_str }
  \group_end:
}

\tl_new:N \g_semio_register_body_tl

\cs_new_protected:Npn \semio_window_register_body_build:n #1 {
  \tl_gclear:N \g_semio_register_body_tl
  \int_step_inline:nn { \seq_count:c { g_semio_register_ #1 _num_seq } } {
    \tl_set:Nx \l_tmpb_tl { \seq_item:cn { g_semio_register_ #1 _num_seq } { ##1 } }
    \tl_set:Nx \l_tmpc_tl { \seq_item:cn { g_semio_register_ #1 _title_seq } { ##1 } }
    \str_set:Nx \l_tmpd_str { \seq_item:cn { g_semio_register_ #1 _label_seq } { ##1 } }
    \tl_gput_right:Nx \g_semio_register_body_tl {
      \semio@register@data
        { \tl_use:N \l_tmpb_tl }
        { \tl_use:N \l_tmpc_tl }
        { \str_use:N \l_tmpd_str }
    }
  }
}

\cs_new_protected:Npn \semio_window_register_body_use: {
  \tl_use:N \g_semio_register_body_tl
}

\cs_new_protected:Npn \semio_window_listof:n #1 {
  \semio_window_register_body_build:n {#1}
  \semio@render@register {#1}
}

\cs_new_protected:Npn \semio_window_listof_cmd_define:nn #1#2 {
  \seq_new:c { g_semio_register_ #1 _num_seq }
  \seq_new:c { g_semio_register_ #1 _title_seq }
  \seq_new:c { g_semio_register_ #1 _label_seq }
  \cs_gset:cpn { listof #2 } { \semio_window_listof:n {#1} }
  \semio@register@hooks@install { listof #2 }
}
