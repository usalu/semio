\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-window}[2026/07/07 v0.9.2 semio OS window chrome]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{calc}
\RequirePackage{semio-core}
\RequirePackage{semio-fonts}
\RequirePackage{semio-logo}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

\providecommand{\semio@chrome@titlebar@height}{1.4em}
\providecommand{\semio@chrome@padding}{0.2em}
\providecommand{\semio@chrome@navbar@height}{1.8em}
\providecommand{\semio@chrome@footer@height}{1.8em}
\providecommand{\semio@chrome@font@title}{0.7em}
\providecommand{\semio@chrome@font@number}{0.6em}
\providecommand{\semio@chrome@font@body}{0.8em}
\providecommand{\semio@chrome@icon@scale}{1}
\providecommand{\semio@chrome@icon@scale@footer}{1}

\ExplSyntaxOn

\bool_new:N \l_semio_window_chapter_open_bool
\bool_new:N \l_semio_window_section_open_bool
\tl_new:N \l_semio_semiobox_title_tl
\tl_new:N \g_semio_current_heading_tl

\tl_gset:Nn \g_semio_current_heading_tl { }

\cs_new_protected:Npn \semio_window_header:nn #1 #2 {
  \semio@window@header {#1} {#2}
}

\tcbset{
  semio~window/.style={
    enhanced,
    breakable,
    arc=0mm,
    boxrule=\semio@stroke@hairline,
    colframe=semio-chrome-border-normal,
    toprule=0pt,
    leftrule=\semio@stroke@hairline,
    rightrule=\semio@stroke@hairline,
    bottomrule=\semio@stroke@hairline,
    colback=semio-chrome-canvas,
    coltext=semio-chrome-foreground,
    top=0pt,
    left=\semio@chrome@padding,
    right=\semio@chrome@padding,
    bottom=\semio@chrome@padding,
    before~skip=0pt,
    after~skip=0pt,
    parbox=false,
  },
  semio~window~chapter/.style={
    semio~window,
    breakable=false,
  },
  semio~window~section/.style={
    semio~window,
    breakable=false,
  },
  semio~window~boxed/.style={
    semio~window,
    toprule=\semio@stroke@hairline,
    top=\semio@chrome@padding,
  },
  semio~window~inner/.style={
    enhanced,
    breakable=false,
    arc=0mm,
    boxrule=0pt,
    colframe=semio-chrome-canvas,
    colback=semio-chrome-canvas,
    coltext=semio-chrome-foreground,
    left=\semio@chrome@padding,
    right=\semio@chrome@padding,
    top=\semio@chrome@padding,
    bottom=\semio@chrome@padding,
  },
}

\keys_define:nn { semio / semiobox } {
  title .tl_set:N = \l_semio_semiobox_title_tl,
}

\cs_new_protected:Npn \semio_window_close_chapter_body: {
  \bool_if:NT \l_semio_window_chapter_open_bool {
    \end{tcolorbox}
    \bool_set_false:N \l_semio_window_chapter_open_bool
  }
}

\cs_new_protected:Npn \semio_window_close_section: {
  \bool_if:NT \l_semio_window_section_open_bool {
    \end{tcolorbox}
    \bool_set_false:N \l_semio_window_section_open_bool
  }
}

\cs_new_protected:Npn \semio_window_close_chapter: {
  \semio_window_close_section:
  \semio_window_close_chapter_body:
}

\cs_new_protected:Npn \semio_window_open_chapter:n #1 {
  \semio_window_close_chapter:
  \clearpage
  \refstepcounter{chapter}
  \chaptermark{#1}
  \tl_gset:Nn \g_semio_current_heading_tl {#1}
  \tex_gdef:D \semio@chrome@heading {#1}
  \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter}#1}
  \semio_window_header:nn {#1} { \thechapter }
  \begin{tcolorbox}[semio~window~chapter]
  \bool_set_true:N \l_semio_window_chapter_open_bool
}

\cs_new_protected:Npn \semio_window_open_section:n #1 {
  \semio_window_close_section:
  \semio_window_close_chapter_body:
  \clearpage
  \refstepcounter{section}
  \sectionmark{#1}
  \tl_gset:Nn \g_semio_current_heading_tl {#1}
  \tex_gdef:D \semio@chrome@heading {#1}
  \addcontentsline{toc}{section}{\protect\numberline{\thesection}#1}
  \semio_window_header:nn {#1} { \thesection }
  \begin{tcolorbox}[semio~window~section]
  \bool_set_true:N \l_semio_window_section_open_bool
}

\cs_new_protected:Npn \semio_window_semiobox_begin:n #1 {
  \tl_clear:N \l_semio_semiobox_title_tl
  \keys_set:nn { semio / semiobox } { #1 }
  \bool_if:NTF \l_semio_window_chapter_open_bool {
    \begin{tcolorbox}[semio~window~inner, #1]
  } {
    \bool_if:NTF \l_semio_window_section_open_bool {
      \begin{tcolorbox}[semio~window~inner, #1]
    } {
      \tl_if_empty:NTF \l_semio_semiobox_title_tl {
        \begin{tcolorbox}[semio~window~boxed, #1]
      } {
        \semio_window_header:nn { \tl_use:N \l_semio_semiobox_title_tl } { }
        \begin{tcolorbox}[semio~window, #1]
      }
    }
  }
}

\@ifundefined{chapter}{
}{
  \let\semio@koma@chapter\chapter
  \RenewDocumentCommand{\chapter}{s m}{
    \semio_window_open_chapter:n {#2}
  }
  \AddToHook{cmd/tableofcontents/before}{%
    \let\semio@saved@chapter\chapter
    \let\chapter\semio@koma@chapter
  }
  \AddToHook{cmd/tableofcontents/after}{%
    \let\chapter\semio@saved@chapter
  }
  \AddToHook{cmd/listoffigures/before}{%
    \let\semio@saved@chapter\chapter
    \let\chapter\semio@koma@chapter
  }
  \AddToHook{cmd/listoftables/before}{%
    \let\semio@saved@chapter\chapter
    \let\chapter\semio@koma@chapter
  }
  \AddToHook{cmd/listoffigures/after}{%
    \let\chapter\semio@saved@chapter
  }
  \AddToHook{cmd/listoftables/after}{%
    \let\chapter\semio@saved@chapter
  }
}

\RenewDocumentCommand{\section}{s m}{
  \semio_window_open_section:n {#2}
}

\NewDocumentEnvironment{Semiobox}{O{}}{%
  \semio_window_semiobox_begin:n {#1}%
}{%
  \end{tcolorbox}%
}

\cs_new_protected:Npn \semio@appendix_before: {
  \semio_window_close_chapter:
}

\cs_new_eq:NN \semio@koma@appendix \appendix
\RenewDocumentCommand{\appendix}{}{%
  \semio@appendix_before:
  \semio@koma@appendix
}

\cs_new_protected:Npn \SemioWindowCloseAll {
  \semio_window_close_chapter:
}

\cs_new_protected:Npn \SemioWindowCloseChapter {
  \semio_window_close_chapter_body:
}

\cs_new_protected:Npn \semio_header_footer_apply: {
  \pagestyle { fancy }
  \fancyhf { }
  \fancyhead[C] { \SemioChromeNavbarHead }
  \fancyfoot[C] { \SemioChromeFooterHead }
  \renewcommand { \headrulewidth } { 0pt }
  \renewcommand { \footrulewidth } { 0pt }
}

\AtBeginDocument{%
  \semio@chrome@dims@compute
  \semio_header_footer_apply:
}

\ExplSyntaxOff

\def\semio@chrome@heading{}

\newsavebox{\semio@window@cap@slot}
\newsavebox{\semio@window@tab@box}
\newsavebox{\semio@window@ctrl@box}
\newlength{\semio@window@gap@w}
\newlength{\semio@window@cap@w}
\newlength{\semio@window@cap@body@h}

\newcommand{\semio@window@cap@body@h@set}{%
  \setlength{\semio@window@cap@body@h}{%
    \dimexpr\semio@chrome@titlebar@height-\semio@stroke@hairline\relax
  }%
}

\newcommand{\semio@window@stroke@v}{%
  \color{semio-chrome-border-normal}%
  \rule{\semio@stroke@hairline}{\semio@chrome@titlebar@height}%
}

\newcommand{\semio@window@stroke@h}[1]{%
  \color{semio-chrome-border-normal}%
  \rule{\dimexpr#1\relax}{\semio@stroke@hairline}%
}

\newcommand{\semio@window@cap}[2]{%
  \semio@window@cap@body@h@set
  \sbox{\semio@window@cap@slot}{%
    \setlength{\fboxsep}{\semio@chrome@padding}%
    \begingroup
    #2\relax
    #1%
    \endgroup
  }%
  \setlength{\semio@window@cap@w}{\wd\semio@window@cap@slot}%
  \hbox{%
    \semio@window@stroke@v
    \vbox to \semio@chrome@titlebar@height{%
      \nointerlineskip
      \hbox{\semio@window@stroke@h{\semio@window@cap@w}}%
      \nointerlineskip
      \hbox{%
        \begingroup
        \setlength{\fboxsep}{0pt}%
        \colorbox{semio-chrome-canvas}{%
          \vbox to \semio@window@cap@body@h{%
            \vfil
            \nointerlineskip
            \hbox to \semio@window@cap@w{%
              \hfil\usebox{\semio@window@cap@slot}\hfil
            }%
            \vfil
          }%
        }%
        \endgroup
      }%
    }%
    \semio@window@stroke@v
  }%
}

\newcommand{\semio@window@tab}[1]{%
  \semio@window@cap{#1}{%
    \SemioSans\fontsize{\semio@chrome@font@title}{\semio@chrome@titlebar@height}\selectfont\color{semio-chrome-border-emphasized}%
  }%
}

\newcommand{\semio@window@ctrl}[1]{%
  \semio@window@cap{#1}{%
    \SemioSans\fontsize{\semio@chrome@font@number}{\semio@chrome@titlebar@height}\selectfont\color{semio-chrome-border-emphasized}%
  }%
}

\newcommand{\semio@window@gap}{%
  \semio@window@cap@body@h@set
  \hbox to \dimexpr\semio@window@gap@w\relax{%
    \vbox to \semio@chrome@titlebar@height{%
      \nointerlineskip
      \hbox to \dimexpr\semio@window@gap@w\relax{%
        \begingroup
        \setlength{\fboxsep}{0pt}%
        \colorbox{semio-chrome-canvas}{%
          \vbox to \semio@window@cap@body@h{%
            \vfil\null\vfil
          }%
        }%
        \endgroup
      }%
      \nointerlineskip
      \hbox to \dimexpr\semio@window@gap@w\relax{%
        \semio@window@stroke@h{\semio@window@gap@w}%
      }%
    }%
  }%
}

\newcommand{\semio@window@header}[2]{%
  \sbox{\semio@window@tab@box}{\semio@window@tab{#1}}%
  \sbox{\semio@window@ctrl@box}{%
    \if\relax\detokenize{#2}\relax
      \hbox{}%
    \else
      \semio@window@ctrl{#2}%
    \fi
  }%
  \setlength{\semio@window@gap@w}{%
    \dimexpr\linewidth-\wd\semio@window@tab@box-\wd\semio@window@ctrl@box\relax
  }%
  \noindent
  \hbox to \linewidth{%
    \usebox{\semio@window@tab@box}%
    \semio@window@gap
    \usebox{\semio@window@ctrl@box}%
  }%
  \par\nointerlineskip
}

\newsavebox{\semio@chrome@navbar@emblem@box}
\newsavebox{\semio@chrome@footer@emblem@box}
\newlength{\semio@chrome@row@height}
\newlength{\semio@chrome@row@height@footer}
\newlength{\semio@chrome@icon@height}
\newlength{\semio@chrome@icon@height@footer}

\newcommand{\semio@chrome@vcenter}[2]{%
  \vbox to #1{\vfil\nointerlineskip\hbox{#2}\vfil}%
}

\newcommand{\semio@chrome@emblem@rebuild}{%
  \sbox{\semio@chrome@navbar@emblem@box}{\semioemblemheight{\semio@chrome@icon@height}}%
  \sbox{\semio@chrome@footer@emblem@box}{\semioemblemheight{\semio@chrome@icon@height@footer}}%
}

\newcommand{\semio@chrome@dims@compute}{%
  \begingroup
  \normalfont
  \xdef\semio@chrome@tmp@row{\the\dimexpr\semio@chrome@font@body\relax}%
  \xdef\semio@chrome@tmp@row@footer{\the\dimexpr\semio@chrome@font@number\relax}%
  \endgroup
  \setlength{\semio@chrome@row@height}{\semio@chrome@tmp@row}%
  \setlength{\semio@chrome@row@height@footer}{\semio@chrome@tmp@row@footer}%
  \setlength{\semio@chrome@icon@height}{\semio@chrome@row@height}%
  \setlength{\semio@chrome@icon@height@footer}{\semio@chrome@row@height@footer}%
  \semio@chrome@emblem@rebuild
}

\newcommand{\semio@chrome@chip}[1]{%
  \begingroup
  \setlength{\fboxsep}{\semio@chrome@padding}%
  \setlength{\fboxrule}{\semio@stroke@hairline}%
  \fcolorbox{semio-chrome-border-normal}{semio-chrome-base}{#1}%
  \endgroup
}

\newcommand{\semio@chrome@navbar@bar}[1]{%
  \vbox{%
    \nointerlineskip
    \hbox to \headwidth{%
      \setlength{\fboxsep}{0pt}%
      \colorbox{semio-chrome-base}{%
        \parbox[c][\semio@chrome@navbar@height][c]{\headwidth}{#1}%
      }%
    }%
    \nointerlineskip
    \hbox to \headwidth{%
      \color{semio-chrome-border-normal}\rule{\headwidth}{\semio@stroke@hairline}%
    }%
  }%
}

\newcommand{\semio@chrome@footer@bar}[1]{%
  \vbox{%
    \nointerlineskip
    \hbox to \headwidth{%
      \color{semio-chrome-border-normal}\rule{\headwidth}{\semio@stroke@hairline}%
    }%
    \nointerlineskip
    \hbox to \headwidth{%
      \setlength{\fboxsep}{0pt}%
      \colorbox{semio-chrome-base}{%
        \parbox[c][\semio@chrome@footer@height][c]{\headwidth}{#1}%
      }%
    }%
  }%
}

\newcommand{\SemioChromeNavbarHead}{%
  \semio@chrome@navbar@bar{%
    \hbox to \headwidth{%
      \semio@chrome@chip{%
        \hbox{%
          \semio@chrome@vcenter{\semio@chrome@row@height}{\usebox{\semio@chrome@navbar@emblem@box}}%
          \hspace{\semio@spacing@compact}%
          \semio@chrome@vcenter{\semio@chrome@row@height}{%
            {\SemioSans\fontsize{\semio@chrome@font@body}{\semio@chrome@font@body}\selectfont\@title}%
          }%
        }%
      }%
      \hfil
      \if\relax\detokenize{\semio@chrome@heading}\relax
      \else
        \semio@chrome@chip{%
          \semio@chrome@vcenter{\semio@chrome@row@height}{%
            {\SemioSans\fontsize{\semio@chrome@font@title}{\semio@chrome@font@title}\selectfont\semio@chrome@heading}%
          }%
        }%
      \fi
    }%
  }%
}

\newcommand{\SemioChromeFooterHead}{%
  \semio@chrome@footer@bar{%
    \hbox to \headwidth{%
      \semio@chrome@chip{%
        \hbox{%
          \semio@chrome@vcenter{\semio@chrome@row@height@footer}{\usebox{\semio@chrome@footer@emblem@box}}%
          \hspace{\semio@spacing@compact}%
          \semio@chrome@vcenter{\semio@chrome@row@height@footer}{%
            {\SemioSans\fontsize{\semio@chrome@font@number}{\semio@chrome@font@number}\selectfont\@author}%
          }%
        }%
      }%
      \hfil
      \semio@chrome@chip{%
        \semio@chrome@vcenter{\semio@chrome@row@height@footer}{%
          {\SemioMono\fontsize{\semio@chrome@font@number}{\semio@chrome@font@number}\selectfont\thepage}%
        }%
      }%
    }%
  }%
}

\newcommand{\SemioChromeIconSize}[1]{%
  \setlength{\semio@chrome@row@height}{\dimexpr#1\relax}%
  \setlength{\semio@chrome@icon@height}{\semio@chrome@row@height}%
  \semio@chrome@emblem@rebuild
}
\newcommand{\SemioChromeFooterIconSize}[1]{%
  \setlength{\semio@chrome@row@height@footer}{\dimexpr#1\relax}%
  \setlength{\semio@chrome@icon@height@footer}{\semio@chrome@row@height@footer}%
  \semio@chrome@emblem@rebuild
}

\NewDocumentCommand{\SemioChromeIconScale}{m}{%
  \renewcommand{\semio@chrome@icon@scale}{#1}%
  \semio@chrome@dims@compute
}
\NewDocumentCommand{\SemioChromeFooterIconScale}{m}{%
  \renewcommand{\semio@chrome@icon@scale@footer}{#1}%
  \semio@chrome@dims@compute
}

\setlength{\headheight}{38.14006pt}
\addtolength{\topmargin}{-21.14006pt}
\setlength{\headsep}{\semio@spacing@touch}
\setlength{\footskip}{\dimexpr\semio@chrome@footer@height+\semio@stroke@hairline+3pt+\semio@spacing@touch\relax}

