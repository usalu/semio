\cs_new_protected:Npn \semio_window_register_body_macro_apply:n #1 {
  \group_begin:
  \ExplSyntaxOff
  \makeatletter
  \gdef\semio@register@table@body{}
  \makeatother
  \group_end:
  \int_step_inline:nn { \seq_count:c { g_semio_register_ #1 _num_seq } } {
    \tl_set:Nx \l_tmpb_tl { \seq_item:cn { g_semio_register_ #1 _num_seq } { ##1 } }
