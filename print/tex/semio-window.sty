% 🎯 Distributes a crop-scaled image's overflow into an offset from its
% kept edge, per a CSS object-position-style keyword: #1 = resolved align
% value, #2 = keyword that keeps the leading edge (offset stays 0), #3 =
% keyword that keeps the trailing edge (offset becomes the full excess);
% anything else (center, justify) splits the excess in half.
\cs_new_protected:Npn \semio_image_cover_offset_distribute:nnn #1#2#3 {
  \str_case:nnF {#1} {
    {#2} { \dim_zero:N \l_semio_image_cover_offset_dim }
    {#3} { \dim_set_eq:NN \l_semio_image_cover_offset_dim \l_semio_image_cover_excess_dim }
  } {
    \dim_set:Nn \l_semio_image_cover_offset_dim {
      \dim_eval:n { \l_semio_image_cover_excess_dim / 2 }
    }
  }
}

% 🖼️ Matches CSS object-fit:cover with proportional scaling and anchor-aware clipping.
\newsavebox{\semio@image@cover@box}
\cs_new_protected:Npn \semio_image_typeset_cover:n #1 {
  \sbox{\semio@image@cover@box}{\includegraphics[draft]{#1}}
  \dim_set:Nn \l_semio_image_nat_w_dim { \wd \semio@image@cover@box }
  \dim_set:Nn \l_semio_image_nat_h_dim {
    \dim_eval:n { \ht \semio@image@cover@box + \dp \semio@image@cover@box }
  }
  \fp_compare:nNnTF
    {
      \dim_to_decimal:n { \l_semio_image_nat_w_dim }
      / \dim_to_decimal:n { \l_semio_image_nat_h_dim }
    }
    >
    {
      \dim_to_decimal:n { \l_semio_image_target_w_dim }
      / \dim_to_decimal:n { \l_semio_image_target_h_dim }
  }
  {
    \dim_set:Nn \l_semio_image_cover_render_dim {
      \fp_eval:n {
        \dim_to_decimal:n { \l_semio_image_nat_w_dim }
          * \dim_to_decimal:n { \l_semio_image_target_h_dim }
          / \dim_to_decimal:n { \l_semio_image_nat_h_dim }
      } pt
    }
    \dim_set:Nn \l_semio_image_cover_excess_dim {
      \dim_eval:n { \l_semio_image_cover_render_dim - \l_semio_image_target_w_dim }
    }
    \exp_args:Nx \semio_image_cover_offset_distribute:nnn
      { \semio@window@halign } { left } { right }
    \dim_set:Nn \l_semio_image_cover_offset_neg_dim { - \l_semio_image_cover_offset_dim }
    \leavevmode
    \begin{tikzpicture}[baseline=0pt]
      \useasboundingbox (0,0) rectangle
        (\dim_use:N \l_semio_image_target_w_dim,\dim_use:N \l_semio_image_target_h_dim);
      \path[clip] (0,0) rectangle
        (\dim_use:N \l_semio_image_target_w_dim,\dim_use:N \l_semio_image_target_h_dim);
      \node[anchor=north~west,inner~sep=0pt] at
        (\dim_use:N \l_semio_image_cover_offset_neg_dim,\dim_use:N \l_semio_image_target_h_dim)
        {\includegraphics[width=\l_semio_image_cover_render_dim]{#1}};
    \end{tikzpicture}
  } {
    \dim_set:Nn \l_semio_image_cover_render_dim {
      \fp_eval:n {
        \dim_to_decimal:n { \l_semio_image_nat_h_dim }
          * \dim_to_decimal:n { \l_semio_image_target_w_dim }
          / \dim_to_decimal:n { \l_semio_image_nat_w_dim }
      } pt
    }
    \dim_set:Nn \l_semio_image_cover_excess_dim {
      \dim_eval:n { \l_semio_image_cover_render_dim - \l_semio_image_target_h_dim }
    }
    \exp_args:Nx \semio_image_cover_offset_distribute:nnn
      { \semio@window@valign } { top } { bottom }
    \dim_set:Nn \l_semio_image_cover_ypos_dim {
      \dim_eval:n { \l_semio_image_target_h_dim + \l_semio_image_cover_offset_dim }
    }
    \leavevmode
    \begin{tikzpicture}[baseline=0pt]
      \useasboundingbox (0,0) rectangle
        (\dim_use:N \l_semio_image_target_w_dim,\dim_use:N \l_semio_image_target_h_dim);
      \path[clip] (0,0) rectangle
        (\dim_use:N \l_semio_image_target_w_dim,\dim_use:N \l_semio_image_target_h_dim);
      \node[anchor=north~west,inner~sep=0pt] at
        (0pt,\dim_use:N \l_semio_image_cover_ypos_dim)
        {\includegraphics[width=\l_semio_image_target_w_dim]{#1}};
    \end{tikzpicture}
  }
}

\cs_new_protected:Npn \semio_image_default_width_resolve: {
