\newcommand{\semio@toc@track@heading@num}[3]{%
  \ifnum\numexpr\semio@toc@level{#1}\relax>\value{tocdepth}\else
    \semio@toc@track@num{#1}{#2}{#3}%
  \fi
}

\newcommand{\semio@koma@heading@lines}[4]{%
  \ifnum\numexpr\semio@toc@level{#1}\relax>\value{tocdepth}\else
    \semio@toc@track@num{#1}{\csname the#1\endcsname}{#3}%
  \fi
  \semio@chrome@heading@track{#1}{#3}%
  \semio@if@heading@chips
    {%
      \if\relax\detokenize{#4}\relax
        \semio@heading@title@end{#2}{semio-chrome-foreground}{#3}%
      \else
        \semio@heading@pair{#2}{semio-chrome-foreground}{#1}{#1}{#3}%
      \fi
    }%
    {#3}%
}

\newcommand{\semio@koma@heading@lines@muted}[2]{%
  \ifnum\numexpr\semio@toc@level{paragraph}\relax>\value{tocdepth}\else
    \semio@toc@track@num{paragraph}{\theparagraph}{#1}%
  \fi
  \semio@if@heading@chips
    {%
      \if\relax\detokenize{#2}\relax
        \semio@heading@title@end@muted{#1}%
      \else
        \semio@heading@pair@muted{paragraph}{paragraph}{#1}%
      \fi
    }%
    {#1}%
}

