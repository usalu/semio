\makeatletter
\newcommand{\semio@this@pagestyle}{}
\newcommand{\semio@shipout@this@pagestyle}{}
\let\semio@saved@thispagestyle\thispagestyle
\renewcommand{\thispagestyle}[1]{%
  \def\semio@this@pagestyle{#1}%
  \semio@saved@thispagestyle{#1}%
}
\AddToHook{shipout/before}{%
  \global\let\semio@shipout@this@pagestyle\semio@this@pagestyle
  \gdef\semio@this@pagestyle{}%
}
\newcommand{\Ifthispagestyle}[3]{%
  \def\semio@ps@want{#1}%
  \ifx\semio@ps@want\semio@shipout@this@pagestyle #2\else #3\fi
}
\newcommand{\semio@chrome@footer@shipout}{%
  \Ifthispagestyle{empty}{}{%
    \AtPageLowerLeft{%
      \put(0,0){%
        \makebox(0,0)[bl]{%
          \setlength{\headwidth}{\textwidth}%
          \SemioChromeFooterHead
        }%
      }%
    }%
  }%
}

\newcommand{\semio@register@data}[3]{%
  \SemioTableRow{#1 & #2 & \pageref{#3}}%
}

\newcommand{\semio@register@body}{\semio_window_register_body_use:}

\newcommand{\semio@render@register}[1]{%
  \ifnum\value{#1}>0
    \SemioTableRegister{%
      \SemioTableHeaderRow{%
        \semio@register@header@number &
        \semio@register@header@title &
        \semio@register@header@page
      }%
      \semio@register@body
    }%
    \par\vskip\semio@spacing@double\relax
  \fi
}
\newdimen\semio@panel@shipout@x
\newdimen\semio@panel@shipout@y
\newsavebox{\semio@panel@glass@box}

\newcommand{\semio@panel@draw}[4]{%
  \IfFileExists{.semio-panel-glass/\jobname/#1.png}{%
    \semio@panel@shipout@glass{#1}{#2}{#3}{#4}%
  }{%
    \IfFileExists{.semio-panel-glass/\jobname/.ready}{%
      \semio@panel@shipout@fallback{#1}{#2}{#3}{#4}%
    }{}%
  }%
}

\newcommand{\semio@panel@shipout@glass}[4]{%
  \sbox{\semio@panel@glass@box}{%
    \begin{tikzpicture}%
      \node[
        anchor=south west,
        minimum width=#2,
        minimum height=#4,
        inner sep=\semio@chrome@padding,
        draw=semio-chrome-border-normal,
        line width=\semio@stroke@hairline,
        align=center,
        text=semio-chrome-text-normal,
        font=\SemioSans\fontsize{\semio@chrome@font@body}{\semio@chrome@font@body}\selectfont,
        path picture={%
          \node[anchor=center,inner sep=0pt] at (path picture bounding box.center) {%
            \includegraphics[width=#2,height=#4,keepaspectratio=false]{.semio-panel-glass/\jobname/#1.png}%
          };%
        },
      ] at (0,0) {%
        \expandafter\usebox\csname semio@panel@box@#3\endcsname
      };%
    \end{tikzpicture}%
  }%
  \put(\LenToUnit{\semio@panel@shipout@x},\LenToUnit{\semio@panel@shipout@y}){%
    \makebox(0,0)[bl]{\usebox{\semio@panel@glass@box}}%
  }%
}

\newcommand{\semio@panel@shipout@fallback}[4]{%
  \put(\LenToUnit{\semio@panel@shipout@x},\LenToUnit{\semio@panel@shipout@y}){%
    \makebox(0,0)[bl]{%
      \setlength{\fboxsep}{\semio@chrome@padding}%
      \setlength{\fboxrule}{\semio@stroke@hairline}%
      \fcolorbox{semio-chrome-border-normal}{semio-chrome-panel!58}{%
        \begin{minipage}[c][#4][c]{\dimexpr#2-2\fboxsep-2\fboxrule\relax}%
          \centering
          \color{semio-chrome-text-normal}%
          {\SemioSans\fontsize{\semio@chrome@font@body}{\semio@chrome@font@body}\selectfont\expandafter\usebox\csname semio@panel@box@#3\endcsname}%
        \end{minipage}%
      }%
    }%
  }%
}

\newcommand{\semio@panel@storebox}[1]{%
  \expandafter\newbox\csname semio@panel@box@#1\endcsname
  \expandafter\global\expandafter\setbox\csname semio@panel@box@#1\endcsname=\box\semio@panel@content@box
}

\newcommand{\semio@panel@add@shipout}[1]{%
  \AddToShipoutPictureFG*{\csname #1\endcsname}%
}

\def\semio@chrome@heading{}

\newcommand{\semio@chrome@heading@set}[1]{%
  \gdef\semio@chrome@heading{#1}%
}

\newcommand{\semio@chrome@heading@track}[2]{%
  \def\semio@chrome@track@level{#1}%
  \def\semio@chrome@track@part{part}%
  \def\semio@chrome@track@chapter{chapter}%
  \def\semio@chrome@track@section{section}%
  \ifx\semio@chrome@track@level\semio@chrome@track@part
    \semio@chrome@heading@set{#2}%
  \else\ifx\semio@chrome@track@level\semio@chrome@track@chapter
    \semio@chrome@heading@set{#2}%
  \else\ifx\semio@chrome@track@level\semio@chrome@track@section
    \@ifundefined{c@chapter}{%
      \semio@chrome@heading@set{#2}%
    }{%
