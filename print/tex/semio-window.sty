\cs_new_protected:Npn \semio_panel_manifest_open: {
  \bool_if:NF \l_semio_panel_manifest_open_bool {
    \bool_set_true:N \l_semio_panel_manifest_open_bool
    \immediate \openout \semio@panel@manifest = \jobname.panels
  }
}

\cs_new_protected:Npn \semio_panel_manifest_write:nnnnnn #1#2#3#4#5#6 {
  \semio_panel_manifest_open:
  \iow_now:Nx \semio@panel@manifest { #1;#2;#3;#4;#5;#6 }
}

\cs_new_protected:Npn \semio_panel_compute_pos:nnnnn #1#2#3#4#5 {
  \str_case:nn {#3} {
    { top-left } {
      \dim_set:Nn \l_semio_panel_pos_x_dim {#4}
      \dim_set:Nn \l_semio_panel_pos_y_dim { \dimexpr \paperheight - #5 - #2 \relax }
    }
    { top-right } {
      \dim_set:Nn \l_semio_panel_pos_x_dim { \dimexpr \paperwidth - #4 - #1 \relax }
      \dim_set:Nn \l_semio_panel_pos_y_dim { \dimexpr \paperheight - #5 - #2 \relax }
    }
    { bottom-left } {
      \dim_set:Nn \l_semio_panel_pos_x_dim {#4}
      \dim_set:Nn \l_semio_panel_pos_y_dim {#5}
    }
    { bottom-right } {
      \dim_set:Nn \l_semio_panel_pos_x_dim { \dimexpr \paperwidth - #4 - #1 \relax }
      \dim_set:Nn \l_semio_panel_pos_y_dim {#5}
    }
  }
}

\cs_new_protected:Npn \semio_panel_dim_pt:n #1 {
  \fp_eval:n { (#1) / 1pt }
}

\cs_new_protected:Npn \semio_panel_shipout:nnnnnnn #1#2#3#4#5#6#7 {
  \semio_panel_compute_pos:nnnnn {#2} {#4} {#5} {#6} {#7}
  \tl_set:Nx \l_tmpa_tl { \fp_eval:n { \dim_use:N \l_semio_panel_pos_x_dim / 1pt } }
  \tl_set:Nx \l_tmpb_tl { \fp_eval:n { \dim_use:N \l_semio_panel_pos_y_dim / 1pt } }
  \tl_set:Nx \l_tmpc_tl { \fp_eval:n { (#2) / 1pt } }
  \tl_set:Nx \l_tmpd_tl { \fp_eval:n { (#4) / 1pt } }
  \semio_panel_manifest_write:nnnnnn
    {#1}
    { \int_use:N \value { page } }
    { \tl_use:N \l_tmpa_tl }
    { \tl_use:N \l_tmpb_tl }
    { \tl_use:N \l_tmpc_tl }
    { \tl_use:N \l_tmpd_tl }
  \use:e { \global \semio@panel@shipout@x = \dim_use:N \l_semio_panel_pos_x_dim \relax }
  \use:e { \global \semio@panel@shipout@y = \dim_use:N \l_semio_panel_pos_y_dim \relax }
  \semio@panel@draw {#1} {#2} {#3} {#4}
}

\cs_new_eq:NN \semio@panel@shipout \semio_panel_shipout:nnnnnnn

\cs_new_protected:Npn \semio_panel_begin:n #1 {
  \tl_clear:N \l_semio_panel_id_tl
  \bool_set_false:N \l_semio_panel_height_set_bool
  \dim_set:Nn \l_semio_panel_offset_x_dim { 1cm }
  \dim_set:Nn \l_semio_panel_offset_y_dim { 1cm }
  \dim_set:Nn \l_semio_panel_width_dim { 6cm }
  \tl_set:Nn \l_semio_panel_anchor_tl { top-right }
  \keys_set:nn { semio / panel } {#1}
  \begin { lrbox } { \semio@panel@content@box }
  \begin { minipage } [ c ] { \dim_use:N \l_semio_panel_width_dim }
}

\cs_new_protected:Npn \semio_panel_capture_end: {
  \end { minipage }
  \end { lrbox }
  \bool_if:NF \l_semio_panel_height_set_bool {
    \dim_set:Nn \l_semio_panel_height_dim {
      \dimexpr \ht \semio@panel@content@box + \dp \semio@panel@content@box + 2 \semio@chrome@padding \relax
    }
  }
  \refstepcounter { semiopanel }
  \int_set:Nn \l_tmpa_int { \value { semiopanel } }
  \tl_set:Nx \l_tmpb_tl { panel-\int_use:N \l_tmpa_int }
  \tl_set:Nx \l_tmpc_tl { \dim_use:N \l_semio_panel_width_dim }
  \tl_set:Nx \l_tmpd_tl { \dim_use:N \l_semio_panel_height_dim }
  \tl_set:Nx \l_semio_panel_snap_anchor_tl { \tl_use:N \l_semio_panel_anchor_tl }
  \tl_set:Nx \l_semio_panel_snap_ox_tl { \dim_use:N \l_semio_panel_offset_x_dim }
  \tl_set:Nx \l_semio_panel_snap_oy_tl { \dim_use:N \l_semio_panel_offset_y_dim }
  \exp_args:Ne \semio@panel@storebox { \int_use:N \l_tmpa_int }
  \tl_set:Nx \l_tmpf_tl { semio@panel@shipout@\int_use:N \l_tmpa_int }
  \exp_args:Ne \cs_gset:cpx { \tl_use:N \l_tmpf_tl } {
    \semio@panel@shipout
      { \tl_use:N \l_tmpb_tl }
      { \tl_use:N \l_tmpc_tl }
      { \int_use:N \l_tmpa_int }
      { \tl_use:N \l_tmpd_tl }
      { \tl_use:N \l_semio_panel_snap_anchor_tl }
      { \tl_use:N \l_semio_panel_snap_ox_tl }
      { \tl_use:N \l_semio_panel_snap_oy_tl }
  }
  \exp_args:Ne \semio@panel@add@shipout { \tl_use:N \l_tmpf_tl }
}

\NewDocumentEnvironment { Panel } { O{} } {
  \semio_panel_begin:n {#1}
} {
  \semio_panel_capture_end:
}

\AtEndDocument {
  \bool_if:NT \l_semio_panel_manifest_open_bool {
    \immediate \closeout \semio@panel@manifest
  }
}
