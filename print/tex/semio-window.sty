% \WindowItem is routinely called from inside caller-introduced grouping
% (e.g. \makecoverpages wraps conditional rows in \bool_if:NT{...}), which
% would silently discard a *local* seq_put — so item collection uses an
% explicit, depth-indexed stack of *global* sequences instead of relying on
% ambient TeX grouping: WindowRow/WindowColumn push a fresh frame (by nesting
% depth, not by TeX group) on begin and pop it on end, so a conditional
% wrapper around \WindowItem can't lose the push, and a nested WindowRow/
% WindowColumn among a parent's siblings can't clobber the parent's frame.
\int_new:N \g_semio_window_depth_int
\int_gzero:N \g_semio_window_depth_int

\cs_new_protected:Npn \semio_window_frame_seq_ensure:N #1 {
