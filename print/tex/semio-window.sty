    \Needspace{\dimexpr
      \semio@chrome@titlebar@height
      + \semio@window@bodypad + \semio@window@bodypad
      + \semio@chrome@font@body + \semio@chrome@font@body
      + \semio@stroke@hairline + \semio@stroke@hairline
