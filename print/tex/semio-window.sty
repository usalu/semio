\cs_new_protected:Npn \semio_window_toc_seq_sanitize: {
  \int_set:Nn \l_tmpa_int { \seq_count:N \g_semio_register_toc_num_seq }
  \int_step_inline:nn { \l_tmpa_int } {
    \int_set:Nn \l_tmpb_int { \int_eval:n { \l_tmpa_int - ##1 + 1 } }
    \tl_set:Nx \l_tmpa_tl { \seq_item:Nn \g_semio_register_toc_num_seq { \int_use:N \l_tmpb_int } }
    \tl_set:Nx \l_tmpc_tl { \seq_item:Nn \g_semio_register_toc_title_seq { \int_use:N \l_tmpb_int } }
    \tl_if_in:NnTF \l_tmpa_tl { Hy@SectionAnchorHref } {
      \exp_args:Nx \seq_remove_item:Nn \g_semio_register_toc_num_seq { \int_use:N \l_tmpb_int }
      \exp_args:Nx \seq_remove_item:Nn \g_semio_register_toc_title_seq { \int_use:N \l_tmpb_int }
      \exp_args:Nx \seq_remove_item:Nn \g_semio_register_toc_label_seq { \int_use:N \l_tmpb_int }
    } {
      \tl_if_in:NnTF \l_tmpc_tl { Hy@SectionAnchorHref } {
        \exp_args:Nx \seq_remove_item:Nn \g_semio_register_toc_num_seq { \int_use:N \l_tmpb_int }
        \exp_args:Nx \seq_remove_item:Nn \g_semio_register_toc_title_seq { \int_use:N \l_tmpb_int }
        \exp_args:Nx \seq_remove_item:Nn \g_semio_register_toc_label_seq { \int_use:N \l_tmpb_int }
      } { }
    }
  }
}

\cs_new_protected:Npn \semio_window_toc_aux_load: {
  \seq_gclear:c { g_semio_register_toc_num_seq }
  \seq_gclear:c { g_semio_register_toc_title_seq }
  \seq_gclear:c { g_semio_register_toc_label_seq }
  \file_if_exist_input:n { \c_sys_jobname_str .register-toc } { }
  \int_compare:nNnT { \seq_count:c { g_semio_register_toc_num_seq } } = { 0 } {
    \str_set:Nx \l_tmpa_str { dist / \c_sys_jobname_str .register-toc }
    \semio_window_toc_aux_input:n { \l_tmpa_str }
  }
}

\cs_new_protected:Npn \semio_window_toc_render: {
  \semio_window_toc_aux_load:
  \semio_window_toc_seq_sanitize:
  \int_compare:nNnT { \seq_count:c { g_semio_register_toc_num_seq } } > { 0 } {
    \semio_window_register_body_macro_apply:n { toc }
    \group_begin:
    \ExplSyntaxOff
    \makeatletter
    % Inhaltsverzeichnis exception: half the standard cell padding (dense index).
    % Local to this group, so no other table — including the appendix list at
    % \semio_window_appendix_register_render: — is affected.
    \renewcommand{\semio@table@vtop}{\semio@table@vtop@toc}%
    \renewcommand{\semio@table@vbot}{\semio@table@vbot@toc}%
    \semio@register@window@open{\SemioTocTitle}%
    \SemioTableRegister{\semio@register@table@body}%
    \semio@register@window@close
    \clearpage
    \makeatother
    \group_end:
  }
}

\cs_new_protected:Npn \semio_toc_aux_write:n #1 {
  \iow_now:Nn \g_semio_toc_iow {#1}
}
% Flush the buffered TOC aux entries to disk in one shot, now that the whole
% document (and thus every tracked heading) has been seen. Opening here truncates
% the previous run's file only after this run's TOC has already read it.
\AtEndDocument {
  \seq_if_empty:NF \g_semio_toc_aux_seq {
    \iow_open:Nn \g_semio_toc_iow { \c_sys_jobname_str .register-toc }
    \seq_map_function:NN \g_semio_toc_aux_seq \semio_toc_aux_write:n
    \iow_close:N \g_semio_toc_iow
  }
}

