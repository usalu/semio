\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{semio-viz}[2026/08/18 v0.1.0 semio viz]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{semio-core}
\RequirePackage{semio-fonts}
\RequirePackage{semio-window}
\RequirePackage{semio-viz-data}
\RequirePackage{semio-viz-scale}
\RequirePackage{semio-viz-mark}
\RequirePackage{semio-viz-axis}
\RequirePackage{semio-viz-layout}
\usetikzlibrary{calc,arrows.meta,shapes.geometric,decorations.pathreplacing}

\providecommand{\semio@viz@frame@width}{80}
\providecommand{\semio@viz@frame@height}{40}

\ExplSyntaxOn

%region Diagnostics
\msg_new:nnn { semio-viz } { unknown-chart }
  { Unknown~viz~chart~kind~'#1'. }
\msg_new:nnn { semio-viz } { unknown-demo }
  { Unknown~viz~demo~'#1'~(not~a~mark~or~chart~kind). }
\msg_new:nnn { semio-viz } { unit-in-number }
  { Viz~key~'#1'~takes~a~plain~millimetre~number,~got~'#2'. }
%endregion Diagnostics

%region StyleVocabulary
\tikzset{
  semio~viz~picture/.style={
    x=1mm, y=1mm,
    every~node/.append~style={ outer~sep=0pt, font=\SemioSans },
  },
}
%endregion StyleVocabulary

%region Keys
\tl_new:N \l_semio_viz_title_tl
\tl_new:N \l_semio_viz_window_tl
\tl_new:N \l_semio_viz_width_tl
\tl_new:N \l_semio_viz_height_tl

\cs_new_protected:Npn \semio_viz_number_check:nn #1#2 {
  \regex_match:nnT { [a-zA-Z] } {#2}
    { \msg_error:nnnn { semio-viz } { unit-in-number } {#1} {#2} }
}

\keys_define:nn { semio / viz / figure } {
  title  .tl_set:N = \l_semio_viz_title_tl,
  window .tl_set:N = \l_semio_viz_window_tl,
  width  .code:n = {
    \semio_viz_number_check:nn { width } {#1}
    \tl_set:Nn \l_semio_viz_width_tl {#1}
  },
  height .code:n = {
    \semio_viz_number_check:nn { height } {#1}
    \tl_set:Nn \l_semio_viz_height_tl {#1}
  },
}

\cs_new_protected:Npn \semio_viz_figure_keys_reset: {
  \tl_clear:N \l_semio_viz_title_tl
  \tl_clear:N \l_semio_viz_window_tl
  \tl_set:Nn \l_semio_viz_width_tl { \semio@viz@frame@width }
  \tl_set:Nn \l_semio_viz_height_tl { \semio@viz@frame@height }
}
%endregion Keys

%region Figure
\cs_new_protected:Npn \semio_viz_figure_open:n #1 {
  \begin{Figure}[#1]
  \begin{tikzpicture}[ semio~viz~picture ]
  \useasboundingbox (0,0) rectangle ( \l_semio_viz_width_tl , \l_semio_viz_height_tl ) ;
  \fp_set:Nn \l_semio_viz_width_fp { \l_semio_viz_width_tl }
  \fp_set:Nn \l_semio_viz_height_fp { \l_semio_viz_height_tl }
}

\cs_new_protected:Npn \semio_viz_figure_begin:n #1 {
  \semio_viz_figure_keys_reset:
  \keys_set:nn { semio / viz / figure } {#1}
  \tl_set:Nx \l_tmpa_tl {
    title = { \exp_not:V \l_semio_viz_title_tl } ,
    break = false ,
    \exp_not:V \l_semio_viz_window_tl
  }
  \exp_args:NV \semio_viz_figure_open:n \l_tmpa_tl
  \bool_set_true:N \l_semio_viz_in_figure_bool
  \semio_viz_data_demo:
  \semio_viz_figure_scales:
}

\cs_new_protected:Npn \semio_viz_figure_scales: {
  \use:x {
    \exp_not:N \semio_viz_scale_define:nnnn { x } { band } { A, B, C, D, E }
      { \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_width_fp - 2 } }
    \exp_not:N \semio_viz_scale_define:nnnn { y } { linear } { 0, 10 }
      { \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_height_fp - 2 } }
    \exp_not:N \semio_viz_scale_define:nnnn { y-log } { log } { 1, 100 }
      { \fp_eval:n { \l_semio_viz_pad_fp } , \fp_eval:n { \l_semio_viz_height_fp - 2 } }
  }
}

\cs_new_protected:Npn \semio_viz_figure_end: {
  \bool_set_false:N \l_semio_viz_in_figure_bool
  \end{tikzpicture}
  \end{Figure}
}

% 🖼️ Figure window wrapping a millimetre TikZ canvas for viz recipes.
\NewDocumentEnvironment { VizFigure } { O{} }
  { \semio_viz_figure_begin:n {#1} }
  { \semio_viz_figure_end: }
%endregion Figure

%region ChartKinds
\seq_new:N \g_semio_viz_chart_kinds_seq
\prop_new:N \g_semio_viz_chart_family_prop
\prop_new:N \g_semio_viz_chart_opts_prop

\cs_new_protected:Npn \semio_viz_chart_kind_define:nnn #1#2#3 {
  \seq_if_in:NnF \g_semio_viz_chart_kinds_seq {#1}
    { \seq_gput_right:Nn \g_semio_viz_chart_kinds_seq {#1} }
  \prop_gput:Nnn \g_semio_viz_chart_family_prop {#1} {#2}
  \prop_gput:Nnn \g_semio_viz_chart_opts_prop {#1} {#3}
}

% 🏷️ Registers a chart kind as a layout family plus default keys.
\NewDocumentCommand \SemioVizChartKind { m m m } { \semio_viz_chart_kind_define:nnn {#1} {#2} {#3} }

\cs_generate_variant:Nn \semio_viz_layout:nn { VV }

\cs_new_protected:Npn \semio_viz_chart:nn #1#2 {
  \semio_viz_frame_require:n { SemioVizChart }
  \seq_if_in:NnTF \g_semio_viz_chart_kinds_seq {#1}
    {
      \prop_get:NnN \g_semio_viz_chart_family_prop {#1} \l_semio_viz_family_tl
      \prop_get:NnN \g_semio_viz_chart_opts_prop {#1} \l_tmpa_tl
      \tl_if_empty:nF {#2} { \tl_put_right:Nn \l_tmpa_tl { , #2 } }
      \semio_viz_layout:VV \l_semio_viz_family_tl \l_tmpa_tl
    }
    { \msg_error:nnn { semio-viz } { unknown-chart } {#1} }
}

\cs_new_protected:Npn \semio_viz_demo:n #1 {
  \semio_viz_frame_require:n { SemioVizDemo }
  \seq_if_in:NnTF \g_semio_viz_mark_kinds_seq {#1}
    { \semio_viz_mark_demo:n {#1} }
    {
      \seq_if_in:NnTF \g_semio_viz_chart_kinds_seq {#1}
        { \semio_viz_chart:nn {#1} { data=demo, x=cat, y=val } }
        { \msg_error:nnn { semio-viz } { unknown-demo } {#1} }
    }
}

% 📊 Draws a registered chart kind inside the current VizFigure.
\NewDocumentCommand \SemioVizChart { m O{} } { \semio_viz_chart:nn {#1} {#2} }
% 🧪 Gallery helper: mark primitive or chart kind on the demo table.
\NewDocumentCommand \SemioVizDemo { m } { \semio_viz_demo:n {#1} }
%endregion ChartKinds

\ExplSyntaxOff

\RequirePackage{semio-viz-charts}
