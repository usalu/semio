{
  "mcpServers": {
    "repo": {
      "type": "stdio",
      "command": "go",
      "args": ["run", "${workspaceFolder}${/}repo${/}cursor"],
      "env": {
        "GOWORK": "${workspaceFolder}${/}go.work"
      }
    },
    "neo4j-semio": {
      "type": "stdio",
      "command": "bash",
      "args": ["./.devcontainer/neo4j-mcp-run.sh", "semio"]
    },
    "neo4j-elements": {
      "type": "stdio",
      "command": "bash",
      "args": ["./.devcontainer/neo4j-mcp-run.sh", "elements"]
    },
    "neo4j-coda": {
      "type": "stdio",
      "command": "bash",
      "args": ["./.devcontainer/neo4j-mcp-run.sh", "coda"]
    },
    "neo4j-reuse": {
      "type": "stdio",
      "command": "bash",
      "args": ["./.devcontainer/neo4j-mcp-run.sh", "reuse"]
    }
  }
}
