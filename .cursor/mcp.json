{
  "mcpServers": {
    "repo": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "./📜️script.ts",
        "dev",
        "mcp",
        "stdio",
        "cursor"
      ]
    },
    "semio": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "./📜️script.ts",
        "dev",
        "mcp",
        "stdio",
        "os",
        "--folder",
        ".🧬semio/🔗space/os-mcp",
        "--scopes",
        "workspace.read,artifact.write,inference.execute,ui.observe,ui.control,conversation.write"
      ]
    }
  }
}
