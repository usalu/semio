            "command_line": "python - \u003c\u003c'PY'\nimport zipfile, tempfile, shutil\nfrom pathlib import Path\nroot=Path('/workspaces/semio/semio/assets/semio')\nzip_path=root/'metabolism.zip'\nkit_json=root/'kit_metabolism.json'\n\nwith tempfile.TemporaryDirectory() as td:\n    tdp=Path(td)\n    with zipfile.ZipFile(zip_path,'r') as zin:\n        zin.extractall(tdp)\n    semio_dir=tdp/'.semio'\n    if semio_dir.exists():\n        shutil.rmtree(semio_dir)\n    shutil.copy2(kit_json, tdp/'kit.json')\n\n    tmp_zip=root/'metabolism.zip.tmp'\n    with zipfile.ZipFile(tmp_zip,'w',compression=zipfile.ZIP_DEFLATED) as zout:\n        for p in sorted(tdp.rglob('*')):\n            if p.is_file():\n                zout.write(p, p.relative_to(tdp).as_posix())\n    tmp_zip.replace(zip_path)\n\nprint('rewritten metabolism.zip with kit.json and without .semio db')\nPY",
