      "commit": "503dcda1bc1de15727d922200c8d579a230ddf0c",
      "prompt": "The .windsurf/hooks.json uses \"tool.calling\" for pre_mcp_tool_use and pre_run_command, but \"tool.calling\" is not a valid hook event. Valid events are: commit.starting, commit.ended, agent.starting, agent.ended, prompt.submit, compacting, tool.starting, tool.ended, task.plan, task.starting, task.ended, code.reading, code.edited, terminal.starting, terminal.ended. Fix pre_mcp_tool_use to use tool.starting and pre_run_command to use terminal.starting.",
      "llm": "sonnet-4-5"
    }
