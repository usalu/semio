{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "incremental": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["react", "react-dom"]
  },
  "include": ["/Users/ueli/Documents/semio/framework/renderer/react/**/*.ts", "/Users/ueli/Documents/semio/framework/renderer/react/**/*.tsx"],
  "exclude": ["/Users/ueli/Documents/semio/framework/renderer/react/node_modules", "/Users/ueli/Documents/semio/framework/renderer/react/storybook-static"]
}
