// Drop detached kit `Data` (no `OWNS` parent) that still carry `IS` — stale shared argument rows after `soleOwnerKey` split.
MATCH (d:Data)
WHERE NOT ()-[:OWNS]->(d) AND EXISTS { (d)-[:IS]->(:Class|Interface|Scalar|Command) }
DETACH DELETE d;

