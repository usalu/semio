          "execution_id": "c5c36350-a15b-4e46-96ce-d1c77fd17908",
          "tool_info": {
            "edits": [
              {
                "old_string": "    public class Diff\n    {\n        [Fact]\n        public void Metabolism_Kit_Diff_DiffedKit_InverseDiff_Kit()\n        {\n            var kitOriginal = Tests.LoadAsset\u003cKit\u003e(\"kit_metabolism.json\");\n            kitOriginal.Designs = kitOriginal.Designs?.Where(d =\u003e d.Parent == null).ToList();\n\n            var kitDiff = Tests.LoadAsset\u003cKitDiff\u003e(\"diff_kit_metabolism.json\");\n            var kitDiffInverted = Tests.LoadAsset\u003cKitDiff\u003e(\"diff_kit_metabolism_inverted.json\");\n            var kitDiffed = Tests.LoadAsset\u003cKit\u003e(\"kit_metabolism_diffed.json\");\n\n            var computedDiff = ComposeDiff.GetKitDiff(kitOriginal, kitDiffed);\n            Assert.True(ComposeDiff.AreKitDiffsEqual(computedDiff, kitDiff), \"GetKitDiff: computed diff doesn't match expected diff\");\n\n            var computedInverseDiff = ComposeDiff.InverseKitDiff(kitOriginal, kitDiff);\n            Assert.True(ComposeDiff.AreKitDiffsEqual(computedInverseDiff, kitDiffInverted), \"InverseKitDiff: computed inverse diff doesn't match expected inverse diff\");\n\n            var appliedForward = ComposeDiff.ApplyKitDiff(kitOriginal, kitDiff);\n            Assert.True(ComposeDiff.AreKitsEqual(appliedForward, kitDiffed), \"ApplyKitDiff forward: applied kit doesn't match expected diffed kit\");\n\n            var appliedInverse = ComposeDiff.ApplyKitDiff(kitDiffed, kitDiffInverted);\n            Assert.True(ComposeDiff.AreKitsEqual(appliedInverse, kitOriginal), \"ApplyKitDiff inverse: applied inverse kit doesn't match original kit\");\n        }\n    }",
                "new_string": "    public class Change\n    {\n        [Fact]\n        public void Metabolism_Kit_Change_Forward_Backward_Inverse_Behavior()\n        {\n            var kitOriginal = Tests.LoadAsset\u003cKit\u003e(\"kit_metabolism.json\");\n            kitOriginal.Designs = kitOriginal.Designs?.Where(d =\u003e d.Parent == null).ToList();\n\n            var kitDiff = Tests.LoadAsset\u003cKitDiff\u003e(\"diff_kit_metabolism.json\");\n            var kitDiffInverted = Tests.LoadAsset\u003cKitDiff\u003e(\"diff_kit_metabolism_inverted.json\");\n            var kitDiffed = Tests.LoadAsset\u003cKit\u003e(\"kit_metabolism_diffed.json\");\n\n            var change = ComposeDiff.GetKitChange(kitOriginal, kitDiffed);\n            Assert.True(ComposeDiff.AreKitDiffsEqual(change.Forward, kitDiff), \"GetKitChange: forward diff doesn't match expected diff\");\n\n            Assert.True(ComposeDiff.AreKitDiffsEqual(change.Backward, kitDiffInverted), \"GetKitChange: backward diff doesn't match expected inverse diff\");\n\n            var appliedForward = ComposeDiff.ApplyKitDiff(kitOriginal, change.Forward);\n            Assert.True(ComposeDiff.AreKitsEqual(appliedForward, kitDiffed), \"ApplyKitDiff forward: applied kit doesn't match expected diffed kit\");\n\n            var appliedInverse = ComposeDiff.ApplyKitDiff(kitDiffed, change.Backward);\n            Assert.True(ComposeDiff.AreKitsEqual(appliedInverse, kitOriginal), \"ApplyKitDiff inverse: applied inverse kit doesn't match original kit\");\n        }\n    }"
              }
            ],
            "file_path": "/workspaces/semio/compose/net/Compose.Tests/Tests.cs"
          }
        }
