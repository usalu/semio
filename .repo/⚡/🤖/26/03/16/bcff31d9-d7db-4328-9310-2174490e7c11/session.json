            "command_line": "python - \u003c\u003c'PY'\nfrom pathlib import Path\nimport re\n\nroot = Path('/workspaces/semio/elements/ui')\nstories_root = root / '.storybook' / 'stories'\nmain_file = root / '.storybook' / 'main.ts'\n\nstory_files = sorted(stories_root.rglob('*.stories.tsx'))\n\ndef flattened_name(path: Path) -\u003e str:\n    stem = path.name\n    return stem\n\nname_to_paths = {}\nfor path in story_files:\n    if path.parent == stories_root:\n        continue\n    name_to_paths.setdefault(flattened_name(path), []).append(path)\n\nresolved_targets = {}\nfor name, paths in name_to_paths.items():\n    if len(paths) == 1:\n        resolved_targets[paths[0]] = stories_root / name\n        continue\n    for path in paths:\n        relative_parts = path.relative_to(stories_root).parts[:-1]\n        prefix_parts = [part for part in relative_parts if part not in {'elements', 'coda'}]\n        prefix = ''.join(part[:1].upper() + part[1:] for part in prefix_parts)\n        resolved_targets[path] = stories_root / f'{prefix}{name}'\n\nfor path in story_files:\n    text = path.read_text()\n    text = re.sub(r'title:\\s*[\"\\\"][^\"\\\"]+/([^\"\\\"]+)[\"\\\"]', lambda m: f'title: \"elements/{m.group(1)}\"', text, count=1)\n    path.write_text(text)\n\nmain_text = main_file.read_text()\nmain_text = main_text.replace('stories: [\"./stories/elements/**/*.stories.@(js|jsx|mjs|ts|tsx|mdx)\", \"./stories/coda/**/*.stories.@(js|jsx|mjs|ts|tsx|mdx)\"],', 'stories: [\"./stories/**/*.stories.@(js|jsx|mjs|ts|tsx|mdx)\"],')\nmain_file.write_text(main_text)\n\nfor source, target in resolved_targets.items():\n    if target.exists() and target.resolve() != source.resolve():\n        raise SystemExit(f'target already exists: {target}')\n\nfor source, target in resolved_targets.items():\n    target.parent.mkdir(parents=True, exist_ok=True)\n    source.rename(target)\n\nfor directory in sorted((path for path in stories_root.rglob('*') if path.is_dir()), key=lambda p: len(p.parts), reverse=True):\n    try:\n        directory.rmdir()\n    except OSError:\n        pass\nPY",
