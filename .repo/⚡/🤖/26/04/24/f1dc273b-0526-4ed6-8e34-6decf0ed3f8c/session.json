            "edits": [
              {
                "old_string": "",
                "new_string": "$d = \"c:\\git\\semio\\semio\\rs\"\n$libLines = [System.IO.File]::ReadAllLines(\"$d\\lib.rs\")\n$modLines = [System.IO.File]::ReadAllLines(\"$d\\read_module.rs\")\n$i1Lines = [System.IO.File]::ReadAllLines(\"$d\\read_impl.rs\")\n$i2Lines = [System.IO.File]::ReadAllLines(\"$d\\read_impl2.rs\")\n$i3Lines = [System.IO.File]::ReadAllLines(\"$d\\read_impl3.rs\")\n\n# Build combined content: read_module.rs + cleaned read_impl*.rs\n$combined = [System.Collections.Generic.List[string]]::new()\n\n# Add read_module.rs content\nforeach ($l in $modLines) { $combined.Add($l) }\n$combined.Add(\"\")\n\n# Add read_impl.rs content (skip first comment about inclusion, placeholder comment, and include! directive)\nforeach ($l in $i1Lines) {\n    if ($l -match '^// Live.*Included in') { continue }\n    if ($l -match '^// ---- placeholder') { continue }\n    if ($l -match 'include!\\(') { continue }\n    $combined.Add($l)\n}\n\n# Add read_impl2.rs content (skip continuation comment, NOTE comment, and include! directive)\nforeach ($l in $i2Lines) {\n    if ($l -match '^// Continuation') { continue }\n    if ($l -match '^// NOTE: read_impl3') { continue }\n    if ($l -match 'include!\\(') { continue }\n    $combined.Add($l)\n}\n\n# Add read_impl3.rs content (no cleaning needed)\nforeach ($l in $i3Lines) { $combined.Add($l) }\n\n# Build new lib.rs: replace include! lines with combined content\n$newLib = [System.Collections.Generic.List[string]]::new()\nforeach ($line in $libLines) {\n    if ($line -match 'include!\\(.*\"/read_module\\.rs\"') {\n        foreach ($c in $combined) { $newLib.Add($c) }\n        continue\n    }\n    if ($line -match 'include!\\(.*\"/read_impl\\.rs\"') {\n        continue\n    }\n    $newLib.Add($line)\n}\n\n[System.IO.File]::WriteAllLines(\"$d\\lib.rs\", $newLib.ToArray())\nWrite-Host \"Done. Replaced 2 include! directives with $($combined.Count) inlined lines. lib.rs now has $($newLib.Count) lines.\"\n"
              }
            ],
