{
  "name": "@semio-tech/compose-engine",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "compose/client/bin/engine",
  "projectType": "application",
  "targets": {
    "update": {
      "executor": "@nxlv/python:update"
    },
    "lock": {
      "executor": "@nxlv/python:lock"
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/engine",
        "command": "uv run main.py",
        "forwardAllArgs": true,
        "env": {
          "UV_PROJECT_ENVIRONMENT": ".venv"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/engine",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/engine",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/engine",
        "command": "bun ./script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/engine",
        "command": "bun ./script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/engine",
        "command": "bun ./script.ts test exhaustive",
        "forwardAllArgs": true
      }
    }
  }
}
