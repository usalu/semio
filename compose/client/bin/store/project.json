{
  "name": "@semio-tech/compose-store",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/store",
        "command": "bun script.ts build",
        "forwardAllArgs": true
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/store",
        "command": "bun script.ts dev",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/store",
        "command": "bun script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
