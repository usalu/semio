{
  "name": "@semio-tech/compose-gql",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/gql",
        "command": "bun script.ts build",
        "forwardAllArgs": true
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/gql",
        "command": "bun script.ts dev",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/gql",
        "command": "bun script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/gql",
        "command": "bun script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/gql",
        "command": "bun script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/bin/gql",
        "command": "bun script.ts test exhaustive",
        "forwardAllArgs": true
      }
    }
  }
}
