{
  "name": "@semio-tech/compose-desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/desktop",
        "command": "bunx electron-forge start",
        "env": {
          "ELECTRON_DISABLE_SANDBOX": "1"
        },
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/desktop",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/desktop",
        "command": "bun ./script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/desktop",
        "command": "bun ./script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/desktop",
        "command": "bun ./script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/desktop",
        "command": "bunx electron-forge make",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        },
        "forwardAllArgs": true
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/desktop",
        "command": "electron-forge publish",
        "forwardAllArgs": true
      }
    }
  }
}
