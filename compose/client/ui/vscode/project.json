{
  "name": "@semio-tech/compose-vscode",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/vscode",
        "command": "vite build && vite build --mode webview",
        "forwardAllArgs": true
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/vscode",
        "parallel": true,
        "commands": ["bunx vite build --watch", "bunx vite build --watch --mode webview"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/vscode",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/vscode",
        "command": "bun ./script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/vscode",
        "command": "bun ./script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/vscode",
        "command": "bun ./script.ts test exhaustive",
        "forwardAllArgs": true
      }
    }
  }
}
