{
  "name": "@semio-tech/compose-grasshopper",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/gh/Compose.Grasshopper",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/gh/Compose.Grasshopper",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/gh/Compose.Grasshopper",
        "command": "bun ./script.ts publish",
        "forwardAllArgs": true
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/ui/gh/Compose.Grasshopper",
        "command": "bun ./script.ts setup",
        "forwardAllArgs": true
      }
    }
  }
}
