{
  "name": "@semio-tech/compose-go",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/go",
        "command": "go build ./...",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/go",
        "command": "bun ./📜script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/go",
        "command": "bun ./📜script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/go",
        "command": "bun ./📜script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/go",
        "command": "bun ./📜script.ts test exhaustive",
        "forwardAllArgs": true
      }
    }
  }
}
