{
  "name": "@semio-tech/compose-js",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio-tech/compose-rs:build"],
      "options": {
        "cwd": "compose/client/lib/js",
        "command": "bunx tsc --noEmit",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio-tech/compose-rs:build"],
      "options": {
        "cwd": "compose/client/lib/js",
        "command": "bun ./📜script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio-tech/compose-rs:build"],
      "options": {
        "cwd": "compose/client/lib/js",
        "command": "bun ./📜script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio-tech/compose-rs:build"],
      "options": {
        "cwd": "compose/client/lib/js",
        "command": "bun ./📜script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio-tech/compose-rs:build"],
      "options": {
        "cwd": "compose/client/lib/js",
        "command": "bun ./📜script.ts test exhaustive",
        "forwardAllArgs": true
      }
    }
  }
}
