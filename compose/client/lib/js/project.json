{
  "name": "@semio-tech/compose-js",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio-tech/compose-rs:build"],
      "options": {
        "cwd": "compose/client/lib/js",
        "command": "bunx tsc --noEmit",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio-tech/compose-rs:build"],
      "options": {
        "cwd": "compose/client/lib/js",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["@semio-tech/compose-rs:build"],
      "options": {
        "cwd": "compose/client/lib/js",
        "command": "bun ./script.ts test-e2e",
        "forwardAllArgs": true
      }
    }
  }
}
