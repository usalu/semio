{
  "name": "@semio-tech/compose-query",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./script.ts setup",
        "cwd": "compose/client/lib/query"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/Cargo.toml", "{projectRoot}/lib.rs", "{projectRoot}/script.ts", "{workspaceRoot}/Cargo.toml", "{workspaceRoot}/Cargo.lock"],
      "outputs": ["{projectRoot}/pkg"],
      "options": {
        "cwd": "compose/client/lib/query",
        "commands": ["bun ./script.ts wasm", "bun ./script.ts build"],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/query",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
