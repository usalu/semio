{
  "name": "@semio-tech/compose-sketchpad-docs",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/sketchpad/doc",
        "command": "bun ./📜️script.ts dev --port 4321",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/sketchpad/doc",
        "command": "vite build",
        "forwardAllArgs": true
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/sketchpad/doc",
        "commands": ["vite build", "bun publish"],
        "parallel": false,
        "forwardAllArgs": true
      }
    }
  }
}
