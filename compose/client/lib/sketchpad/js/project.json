{
  "name": "@compose/sketchpad",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "compose/client/lib/sketchpad/js",
        "command": "bunx playwright install --with-deps chromium",
        "env": {
          "PLAYWRIGHT_BROWSERS_PATH": "../../../node_modules/.cache/ms-playwright"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["@compose/rs:wasm"],
      "options": {
        "cwd": "compose/client/lib/sketchpad/js",
        "command": "bun ./script.ts dev",
        "forwardAllArgs": true,
        "env": {
          "WATCHPACK_POLLING": "true",
          "CHOKIDAR_USEPOLLING": "true"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["@compose/rs:build"],
      "options": {
        "cwd": "compose/client/lib/sketchpad/js",
        "command": "vite build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/sketchpad/js",
        "commands": ["bun ./script.ts test", "bun --import ./pw-loader.mjs ../../../../node_modules/playwright/cli.js test"],
        "parallel": false,
        "forwardAllArgs": true,
        "env": {
          "COMPOSE_SKETCHPAD_RUN_EMBEDDED_TESTS": "1"
        }
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "compose/client/lib/sketchpad/js",
        "commands": ["vite build", "bun publish"],
        "parallel": false
      }
    }
  }
}
