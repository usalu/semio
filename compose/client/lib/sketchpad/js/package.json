{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "name": "@semio-tech/compose-sketchpad",
  "version": "0.1.0",
  "type": "module",
  "description": "compose ⋅ sketchpad",
  "exports": {
    ".": "./index.ts",
    "./boot": "./boot.tsx"
  },
  "dependencies": {
    "@semio-tech/framework-os-core": "workspace:*",
    "@semio-tech/framework-core": "workspace:*",
    "@semio-tech/framework-playground-core": "workspace:*",
    "@semio-tech/framework-platform-core": "workspace:*",
    "@semio-tech/framework-platform-renderer-react": "workspace:*",
    "@mdx-js/react": "^3.1.1",
    "@semio-tech/compose-js": "*",
    "@semio-tech/reasoning-mindmap-wires-react": "workspace:*",
    "@semio-tech/compose-react": "workspace:*",
    "@semio-tech/ui-react": "workspace:*",
    "fflate": "^0.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.57.0",
    "@semio-tech/semio-asset": "^1.0.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^10.1.0",
    "playwright": "^1.56.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "compose/client/lib/sketchpad/js"
  },
  "bundleKind": "ui",
  "semio": {
    "app": {
      "kind": "sketchpad",
      "aliases": [
        "sketchpad",
        "compose"
      ],
      "packageRoot": "compose/client/lib/sketchpad",
      "corePackage": "@semio-tech/compose-sketchpad",
      "definitionExport": "sketchpadPlayAppDefinition",
      "programExport": "sketchpadProgramContribution",
      "programId": "compose.sketchpad",
      "hostKind": "sketchpad",
      "port": {
        "dev": 4000,
        "env": "COMPOSE_PLAY_PORT"
      },
      "site": {
        "embedKind": "compose",
        "host": "play.semio-tech.com"
      },
      "assets": [
        "sketchpad-mdx"
      ],
      "rendererPackage": "@semio-tech/compose-sketchpad",
      "rendererExport": "sketchpadAppRenderer"
    }
  }
}
