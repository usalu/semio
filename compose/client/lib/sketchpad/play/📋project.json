{
  "name": "@semio-tech/compose-sketchpad-play",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/sketchpad/play",
        "command": "bun ./📜script.ts dev --strictPort --port 4000",
        "env": {
          "CHOKIDAR_USEPOLLING": "1"
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/sketchpad/play",
        "command": "bun ./📜script.ts build",
        "forwardAllArgs": true
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/sketchpad/play",
        "commands": ["vite build", "bun publish"],
        "parallel": false,
        "forwardAllArgs": true
      }
    }
  }
}
