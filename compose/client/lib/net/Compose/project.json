{
  "name": "@semio-tech/compose-net",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/net/Compose",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/net/Compose",
        "command": "dotnet test ../Compose.Tests/Compose.Tests.csproj",
        "forwardAllArgs": true
      }
    }
  }
}
