{
  "name": "@semio-tech/compose-py",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/py",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/py",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
