{
  "name": "@semio-tech/compose-rs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./script.ts setup"
      }
    },
    "wasm": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock",
        "{projectRoot}/lib.rs",
        "{projectRoot}/package.json",
        "{projectRoot}/.cargo/**/*",
        "{projectRoot}/script.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock"
      ],
      "outputs": ["{projectRoot}/pkg"],
      "options": {
        "cwd": "compose/client/lib/rs",
        "command": "bun ./script.ts wasm"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["wasm"],
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Cargo.lock",
        "{projectRoot}/lib.rs",
        "{projectRoot}/package.json",
        "{projectRoot}/.cargo/**/*",
        "{projectRoot}/script.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock"
      ],
      "outputs": ["{projectRoot}/pkg"],
      "options": {
        "cwd": "compose/client/lib/rs",
        "command": "bun ./script.ts build",
        "env": {
          "COMPOSE_RS_SKIP_WASM": "1"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/client/lib/rs",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
