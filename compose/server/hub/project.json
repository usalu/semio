{
  "name": "compose-hub",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/server/hub",
        "command": "bun ./script.ts setup"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/server/hub",
        "command": "bun ./script.ts build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/server/hub",
        "command": "bun ./script.ts test"
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/server/hub",
        "command": "bun ./script.ts test-e2e"
      }
    }
  }
}
