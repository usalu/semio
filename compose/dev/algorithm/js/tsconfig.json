{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "noEmit": true,
    "types": ["node", "react", "react-dom", "vitest/importMeta", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@semio-tech/compose-algorithm": ["./index.ts"],
      "@semio-tech/compose-algorithm/*": ["./*"],
      "@compose/ui": ["../ui/index.tsx"],
      "@compose/ui/*": ["../ui/*"],
      "@semio-tech/compose-js": ["../js/index.ts"],
      "@semio-tech/compose-js/*": ["../js/*"],
      "@semio-tech/compose-rs-wasm": ["../rs/pkg"],
      "@semio-tech/compose-rs-wasm/*": ["../rs/pkg/*"],
      "@semio-tech/ui-react": ["../../../../framework/ui/js/react/index.tsx"]
    }
  },
  "exclude": ["node_modules", "storybook-static"]
}
