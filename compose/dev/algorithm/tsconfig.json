{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "incremental": false,
    "noEmit": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "vitest/importMeta",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@compose/algorithm": [
        "./index.ts"
      ],
      "@compose/algorithm/*": [
        "./*"
      ],
      "@compose/ui": [
        "../ui/index.tsx"
      ],
      "@compose/ui/*": [
        "../ui/*"
      ],
      "@compose/js": [
        "../js/index.ts"
      ],
      "@compose/js/*": [
        "../js/*"
      ],
      "@compose/rs-wasm": [
        "../rs/pkg"
      ],
      "@compose/rs-wasm/*": [
        "../rs/pkg/*"
      ],
      "@ui/react": [
        "../../../ui/react/index.tsx"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "storybook-static"
  ]
}
