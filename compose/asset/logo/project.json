{
  "name": "@semio-tech/compose-logo",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/asset/logo",
        "command": "bun --watch ./script.ts generate",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "compose/asset/logo",
        "command": "bun ./script.ts generate",
        "forwardAllArgs": true
      }
    }
  }
}
