{
  "kit": "architect.harness.kit.compose.json",
  "cases": [
    {
      "name": "e2e_filter_nakagin_design",
      "tier": "e2e",
      "query": "MATCH (d:Design) WHERE d.name = \"Nakagin Capsule Tower\" RETURN d.name",
      "expect": {
        "columns": ["d.name"],
        "minRows": 1,
        "maxRows": 1,
        "rowContains": [{ "d.name": "Nakagin Capsule Tower" }]
      }
    },
    {
      "name": "e2e_list_all_design_names",
      "tier": "e2e",
      "query": "MATCH (d:Design) RETURN d.name",
      "expect": {
        "columns": ["d.name"],
        "minRows": 2,
        "valuesInclude": { "d.name": ["Nakagin Capsule Tower", "Other Pavilion"] }
      }
    },
    {
      "name": "e2e_match_type_by_name",
      "tier": "e2e",
      "query": "MATCH (t:Type) WHERE t.name = \"KindBeta\" RETURN t.name",
      "expect": {
        "columns": ["t.name"],
        "minRows": 1,
        "rowContains": [{ "t.name": "KindBeta" }]
      }
    },
    {
      "name": "e2e_filter_designs_excluding_other_pavilion",
      "tier": "e2e",
      "query": "MATCH (d:Design) WHERE d.name != \"Other Pavilion\" RETURN d.name",
      "expect": {
        "columns": ["d.name"],
        "minRows": 1,
        "maxRows": 1,
        "rowContains": [{ "d.name": "Nakagin Capsule Tower" }]
      }
    },
    {
      "name": "e2e_call_session_end",
      "tier": "e2e",
      "runtime": "empty",
      "query": "CALL sessionEnd() RETURN result",
      "expect": { "minRows": 1 }
    },
    {
      "name": "memory_two_designs_where_ne",
      "tier": "memory",
      "query": "MATCH (d:Design) WHERE d.name != \"Other Pavilion\" RETURN d.name",
      "graphqlResponses": [
        {
          "data": {
            "session": {
              "stores": {
                "edges": [
                  {
                    "node": {
                      "wip": {
                        "theKit": {
                          "kit": {
                            "hasDesigns": {
                              "edges": [
                                {
                                  "node": {
                                    "id": "c3000000-0000-4000-8000-000000000001",
                                    "hash": "des-tower-h",
                                    "name": "Nakagin Capsule Tower"
                                  }
                                },
                                {
                                  "node": {
                                    "id": "c3000000-0000-4000-8000-000000000002",
                                    "hash": "des-other-h",
                                    "name": "Other Pavilion"
                                  }
                                }
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "expect": {
        "columns": ["d.name"],
        "minRows": 1,
        "valuesInclude": { "d.name": ["Nakagin Capsule Tower"] },
        "valuesExclude": { "d.name": ["Other Pavilion"] }
      }
    },
    {
      "name": "memory_types_multi_row",
      "tier": "memory",
      "query": "MATCH (t:Type) RETURN t.name",
      "graphqlResponses": [
        {
          "data": {
            "session": {
              "stores": {
                "edges": [
                  {
                    "node": {
                      "wip": {
                        "theKit": {
                          "kit": {
                            "hasTypes": {
                              "edges": [{ "node": { "id": "ta", "hash": "ha", "name": "KindAlpha" } }, { "node": { "id": "tb", "hash": "hb", "name": "KindBeta" } }, { "node": { "id": "tg", "hash": "hg", "name": "KindGamma" } }]
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "expect": {
        "columns": ["t.name"],
        "minRows": 3,
        "valuesInclude": { "t.name": ["KindAlpha", "KindBeta", "KindGamma"] }
      }
    },
    {
      "name": "memory_call_session_end",
      "tier": "memory",
      "query": "CALL sessionEnd() RETURN result",
      "graphqlResponses": [
        {
          "data": {
            "session": {
              "end": { "ok": true, "errors": [] }
            }
          }
        }
      ],
      "expect": { "minRows": 1 }
    },
    {
      "name": "memory_call_subscription_session",
      "tier": "memory",
      "query": "CALL subscriptionSession() RETURN result",
      "graphqlResponses": [{ "data": { "session": { "id": "s1", "hash": "h1" } } }],
      "expect": { "minRows": 1 }
    },
    {
      "name": "plan_design_where_filter",
      "tier": "plan",
      "query": "MATCH (d:Design) WHERE d.name = \"Nakagin Capsule Tower\" RETURN d.name",
      "expect": { "minFilterSteps": 1 }
    },
    {
      "name": "plan_design_and_type_patterns",
      "tier": "plan",
      "query": "MATCH (d:Design), (t:Type) WHERE d.name = \"Nakagin Capsule Tower\" AND t.name = \"KindBeta\" RETURN d.name, t.name",
      "expect": { "minGraphQlSteps": 2 }
    },
    {
      "name": "plan_nakagin_shared_design_join",
      "tier": "plan",
      "query": "MATCH (d:Design)--[:HAS]->(pi:Piece), (d:Design)--[:HAS]->(cn:Connection) WHERE d.name = \"Nakagin Capsule Tower\" RETURN pi",
      "expect": { "minGraphQlSteps": 2, "joinVars": ["d"] }
    },
    {
      "name": "parse_parent_predicate_pattern",
      "tier": "parse",
      "query": "MATCH (cn:Connection)--[:PARENT]->(s:Side) RETURN s",
      "expect": { "hasReturn": true }
    }
  ]
}
