{
  "schema": "forms.form",
  "id": "building-component",
  "version": "1",
  "title": "Building Component",
  "steps": [
    {
      "id": "identity",
      "title": "Identity",
      "description": "Basic component metadata and material selection.",
      "blocks": [
        {
          "id": "name",
          "kind": "text",
          "label": "Component Name",
          "required": true,
          "placeholder": "Column A",
          "default": "Column A"
        },
        {
          "id": "description",
          "kind": "longText",
          "label": "Description",
          "placeholder": "Describe the component role",
          "default": "Primary structural column"
        },
        {
          "id": "material",
          "kind": "single",
          "label": "Material",
          "required": true,
          "options": [
            { "value": "concrete", "label": "Concrete" },
            { "value": "steel", "label": "Steel" },
            { "value": "timber", "label": "Timber" }
          ],
          "default": "concrete"
        },
        {
          "id": "tags",
          "kind": "multi",
          "label": "Tags",
          "options": [
            { "value": "structural", "label": "Structural" },
            { "value": "facade", "label": "Facade" },
            { "value": "prefab", "label": "Prefab" }
          ],
          "default": ["structural"]
        },
        {
          "id": "prefab",
          "kind": "boolean",
          "label": "Prefab",
          "default": true
        },
        {
          "id": "install-date",
          "kind": "date",
          "label": "Install Date",
          "default": "2026-06-30"
        },
        {
          "id": "accent-color",
          "kind": "color",
          "label": "Accent Color",
          "default": "#336699"
        }
      ]
    },
    {
      "id": "geometry",
      "title": "Geometry",
      "description": "Parametric geometry and dimensional controls.",
      "blocks": [
        {
          "id": "info-note",
          "kind": "note",
          "label": "Note",
          "text": "Adjust the procedural column parameters below. Values persist in the form spec and seed Try mode."
        },
        {
          "id": "count",
          "kind": "number",
          "label": "Instance Count",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 4
        },
        {
          "id": "height-factor",
          "kind": "slider",
          "label": "Height Factor",
          "min": 0,
          "max": 10,
          "step": 0.5,
          "unit": "m",
          "default": 6
        },
        {
          "id": "offset",
          "kind": "vector",
          "label": "Offset",
          "schema": "vec3",
          "step": 0.1,
          "fields": [
            { "key": "x", "label": "X", "value": 0 },
            { "key": "y", "label": "Y", "value": 0 },
            { "key": "z", "label": "Z", "value": 0 }
          ]
        },
        {
          "id": "geometry",
          "kind": "buildingComponent",
          "label": "Hexagonal Column",
          "description": "Parametric column geometry from procedural flow.",
          "required": true,
          "fixtureSlug": "hexagonal-mushroom-column",
          "params": {
            "height": 6,
            "radius": 0.5,
            "sides": 6
          }
        },
        {
          "id": "reference-image",
          "kind": "image",
          "label": "Reference",
          "src": ""
        },
        {
          "id": "spec-file",
          "kind": "file",
          "label": "Spec Sheet",
          "accept": ".pdf,.dwg"
        }
      ]
    }
  ]
}
