{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/expression",
  "title": "SpatialDeclarativeExpr",
  "$defs": {
    "pathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "field" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "index"],
          "properties": {
            "kind": { "const": "index" },
            "index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "pathRoot": { "type": "string", "enum": ["context", "event", "params"] },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root", "segments"],
      "properties": {
        "kind": { "const": "path" },
        "root": { "$ref": "#/$defs/pathRoot" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/pathSegment" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "const" },
        "value": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "var" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bindings", "in"],
      "properties": {
        "kind": { "const": "let" },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
        "in": { "$ref": "#" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "const": "exists" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "segments"],
          "properties": {
            "root": { "$ref": "#/$defs/pathRoot" },
            "segments": { "type": "array", "items": { "$ref": "#/$defs/pathSegment" } }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "const": "notEmpty" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "segments"],
          "properties": {
            "root": { "$ref": "#/$defs/pathRoot" },
            "segments": { "type": "array", "items": { "$ref": "#/$defs/pathSegment" } }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "args"],
      "properties": {
        "kind": { "const": "all" },
        "args": { "type": "array", "items": { "$ref": "#" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "args"],
      "properties": {
        "kind": { "const": "any" },
        "args": { "type": "array", "items": { "$ref": "#" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arg"],
      "properties": {
        "kind": { "const": "not" },
        "arg": { "$ref": "#" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "arg"],
      "properties": {
        "kind": { "const": "abs" },
        "arg": { "$ref": "#" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "a", "b"],
      "properties": {
        "kind": { "const": "distance" },
        "a": { "$ref": "#" },
        "b": { "$ref": "#" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "function"],
      "properties": {
        "kind": { "const": "kernel.call" },
        "function": { "type": "string", "minLength": 1 },
        "args": {
          "type": "object",
          "additionalProperties": { "$ref": "#" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operator", "left", "right"],
      "properties": {
        "kind": { "const": "binop" },
        "operator": {
          "type": "string",
          "enum": ["==", "!=", ">", "<", ">=", "<=", "+", "-", "*", "/"]
        },
        "left": { "$ref": "#" },
        "right": { "$ref": "#" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operator", "args"],
      "properties": {
        "kind": { "const": "fold" },
        "operator": { "type": "string", "enum": ["min", "max"] },
        "args": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#" }
        }
      }
    }
  ]
}
