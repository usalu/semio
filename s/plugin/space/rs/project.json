{
  "name": "@semio-tech/s-studio-rs",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "s/plugin/space/rs",
        "command": "bun ./script.ts wasm"
      },
      "outputs": ["{projectRoot}/pkg"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "s/plugin/space/rs",
        "command": "bun ./script.ts test"
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "s/plugin/space/rs",
        "command": "bun ./script.ts test quick"
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "s/plugin/space/rs",
        "command": "bun ./script.ts test long"
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "s/plugin/space/rs",
        "command": "bun ./script.ts test exhaustive"
      }
    }
  }
}
