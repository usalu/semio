{
  "name": "@dag/play",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "mathematical/graph/port/directed/dag/play",
        "command": "bun ./script.ts dev",
        "env": {
          "DAG_PLAY_PORT": "6017",
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "mathematical/graph/port/directed/dag/play",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "mathematical/graph/port/directed/dag/play",
        "command": "bun ./script.ts test",
        "env": {
          "DAG_PLAY_PORT": "6030"
        },
        "forwardAllArgs": true
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "mathematical/graph/port/directed/dag/play",
        "command": "bun ./script.ts validate",
        "env": {
          "DAG_PLAY_PORT": "6017"
        },
        "forwardAllArgs": true
      }
    }
  }
}
