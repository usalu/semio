        "{projectRoot}/🟦️.ts",
        "{projectRoot}/🧘️lean/**/*"
      ],
      "outputs": [],
      "options": {
        "cwd": "👴️leutwiler/💤️realparts-of-powers-z-n",
        "command": "repo ./📜️script.ts build lean"
      },
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "side-effecting", "reason": "mutates-workspace" }
        }
      }
    },
    "build-notes": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [
        "deps"
