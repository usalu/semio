        "{projectRoot}/📜️script.ts",
        "{projectRoot}/🟦️.ts",
        "{projectRoot}/🧘️lean/**/*"
      ],
      "outputs": [],
      "options": {
        "cwd": "👴️leutwiler/💤️realparts-of-powers-z-n",
        "command": "repo ./📜️script.ts test"
      }
    }
  }
}
