        "{projectRoot}/🟦️.ts",
        "{projectRoot}/📯️notes/**/*"
      ],
      "outputs": [
        "{projectRoot}/dist/📯️notes"
      ],
      "options": {
        "cwd": "👴️leutwiler/💤️realparts-of-powers-z-n",
        "command": "repo ./📜️script.ts build 📯️notes"
      }
    },
    "build-proof": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [
        "deps"
      ],
      "inputs": [
        "{projectRoot}/📜️script.ts",
        "{projectRoot}/🟦️.ts",
        "{projectRoot}/🏆️proof/**/*"
      ],
      "outputs": [
        "{projectRoot}/dist/🏆️proof"
      ],
      "options": {
        "cwd": "👴️leutwiler/💤️realparts-of-powers-z-n",
        "command": "repo ./📜️script.ts build 🏆️proof"
      }
    },
    "build": {
      "executor": "repo:noop",
      "dependsOn": [
        "build-lean",
        "build-notes",
        "build-proof"
      ]
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [
        "build-lean"
