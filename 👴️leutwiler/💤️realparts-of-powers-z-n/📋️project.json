{
  "name": "@leutwiler/realparts-of-powers-z-n",
  "$schema": "../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "deps": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "👴️leutwiler/💤️realparts-of-powers-z-n",
        "command": "repo ./📜️script.ts deps"
