    "agent.starting": "./semio-repo/cli/cli hook agent.starting droid",
    "code.edited": "./semio-repo/cli/cli hook code.edited droid --file \"$FILE\"",
    "code.reading": "./semio-repo/cli/cli hook code.reading droid --file \"$FILE\"",
    "compacting": "./semio-repo/cli/cli hook compacting droid",
