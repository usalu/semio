schema=shooting.fixture active-shot-id=overview-svg active-asset-id=base
camera {
  position=420,-420,320 target=0,0,40 zoom=1 fov=50
}
scene {
  background=""
  sun {
    enabled=false azimuth=45 elevation=35 intensity=2.4 color="#ffffff"
  }
  ambient {
    intensity=1.15 color="#ffffff"
  }
  shadow {
    enabled=true opacity=0.35 softness=1
  }
  material {
    color="#9aa0ab" metalness=0 roughness=1 emissive="#000000" emissive-intensity=0
  }
}
assets [id:TEXT name:TEXT url:TEXT format:TEXT origin:TUPLE orientation:TUPLE scale:VAL] {
  base Base "/mesh/base.glb" glb 0,0,0 _ _
}
shots [id:TEXT label:TEXT width:UINT height:UINT format:TEXT shape:TEXT background:TEXT camera-id:TEXT] {
  overview-svg "Overview Svg" 256 256 svg rectangle _ _
  overview-png "Overview Png" 512 512 png ellipse _ _
}
saved-cameras [id:TEXT label:TEXT camera:BLOCK] {
}
