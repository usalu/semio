{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/display",
  "title": "SpatialDisplayModel",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prompt": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["mesh", "curve", "point", "label", "entity-highlight", "linear-handle", "box-preview"]
        },
        "id": { "type": "string" },
        "role": { "type": "string" },
        "params": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
