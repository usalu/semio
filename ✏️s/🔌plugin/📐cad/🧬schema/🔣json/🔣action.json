{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spatial://schema/json/action",
  "title": "SpatialActionSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "steps"],
  "properties": {
    "schema": { "const": "spatial.action" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "label": { "type": "string" },
    "args": {
      "type": "object",
      "additionalProperties": true
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["string", "number", "boolean", "vec3", "stringArray", "unknown"]
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" },
      "minItems": 1
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "$ref": "🔣expression.json" }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "name", "value"],
          "properties": {
            "operation": { "const": "let" },
            "name": { "type": "string", "minLength": 1 },
            "value": { "$ref": "🔣expression.json" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "values"],
          "properties": {
            "operation": { "const": "setContext" },
            "values": {
              "type": "object",
              "additionalProperties": { "$ref": "🔣expression.json" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "keys"],
          "properties": {
            "operation": { "const": "deleteContext" },
            "keys": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "function"],
          "properties": {
            "operation": { "const": "kernel.call" },
            "function": { "type": "string", "minLength": 1 },
            "args": {
              "type": "object",
              "additionalProperties": { "$ref": "🔣expression.json" }
            },
            "assignTo": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "condition"],
          "properties": {
            "operation": { "const": "guard" },
            "condition": { "$ref": "🔣expression.json" },
            "message": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation"],
          "properties": {
            "operation": { "const": "return" },
            "diff": { "$ref": "🔣expression.json" },
            "data": { "$ref": "🔣expression.json" },
            "patch": { "$ref": "🔣expression.json" },
            "result": { "$ref": "🔣expression.json" }
          }
        }
      ]
    }
  }
}
