{
  "$id": "https://semio.tech/schema/s/writer/writer/diff.json",
  "title": "WriterDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "title": "WriterArtifact",
      "type": "object",
      "x-semio-state": "artifact"
    },
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "languageId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "uri": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "text": {
      "$ref": "#/$defs/WriterTextDelta",
      "x-semio-state": "artifact"
    },
    "selectedAstIds": {
      "$ref": "#/$defs/WriterStringList",
      "x-semio-state": "presence"
    },
    "editorSelection": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/WriterEditorSelection"
        }
      ],
      "x-semio-state": "presence"
    },
    "editorSettings": {
      "$ref": "#/$defs/WriterEditorSettings",
      "x-semio-state": "presence"
    },
    "formatSignal": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "lintSignal": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "cameraX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraZoom": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    },
    "treeHoveredAstId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ],
      "x-semio-state": "artifact"
    },
    "editorHoverOffset": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      ],
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "WriterEditorSelection": {
      "title": "WriterEditorSelection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "WriterEditorSettings": {
      "title": "WriterEditorSettings",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showLineNumbers",
        "fontPx",
        "lineHeight",
        "tabSize"
      ],
      "properties": {
        "showLineNumbers": {
          "type": "boolean"
        },
        "fontPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lineHeight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tabSize": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "WriterStringList": {
      "title": "WriterStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "WriterTextRangeEdit": {
      "title": "WriterTextRangeEdit",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "insert"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "insert": {
          "type": "string"
        }
      }
    },
    "WriterTextDelta": {
      "title": "WriterTextDelta",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replacement": {
          "type": "string"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WriterTextRangeEdit"
          }
        }
      }
    },
    "WriterArtifact": {
      "title": "WriterArtifact",
      "type": "object",
      "additionalProperties": true
    }
  }
}
