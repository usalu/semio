{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/writer/writer/1/any/editor/presence/mutation/replace-presence/schema.json",
  "title": "ReplacePresence",
  "type": "object",
  "properties": {
    "presence": {
      "type": "object",
      "properties": {
        "editorSelection": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          ]
        },
        "camera": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "editorSelection",
        "camera"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "presence"
  ],
  "additionalProperties": false
}
