{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/writer/writer/1/any/editor/config/mutation/replace-config.json",
  "title": "ReplaceConfig",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "editorSelection": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          ]
        },
        "formatSignal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "lintSignal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "editorSettings": {
          "type": "object",
          "properties": {
            "showLineNumbers": {
              "type": "boolean"
            },
            "fontPx": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "lineHeight": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "tabSize": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "showLineNumbers",
            "fontPx",
            "lineHeight",
            "tabSize"
          ],
          "additionalProperties": false
        },
        "engagementInput": {
          "type": "string"
        },
        "camera": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "additionalProperties": false
        },
        "locale": {
          "type": "string"
        }
      },
      "required": [
        "editorSelection",
        "formatSignal",
        "lintSignal",
        "revision",
        "editorSettings",
        "engagementInput",
        "camera",
        "locale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "config"
  ],
  "additionalProperties": false
}
