{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/writer/writer/mutation/change-language/schema.json",
  "title": "ChangeLanguage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newLanguageId"
  ],
  "properties": {
    "mutation": {
      "const": "changeLanguage"
    },
    "newLanguageId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "New Language",
          "de": "Neue Sprache"
        },
        "description": {
          "en": "Language id of the document, e.g. markdown.",
          "de": "Sprach-ID des Dokuments, z. B. markdown."
        }
      }
    }
  }
}
