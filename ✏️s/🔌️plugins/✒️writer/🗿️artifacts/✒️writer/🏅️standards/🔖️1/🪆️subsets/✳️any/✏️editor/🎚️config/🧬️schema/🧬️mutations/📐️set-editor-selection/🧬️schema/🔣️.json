{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/writer/writer/1/any/editor/config/mutation/set-editor-selection.json",
  "title": "SetEditorSelection",
  "type": "object",
  "properties": {
    "selection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "selection"
  ],
  "additionalProperties": false
}
