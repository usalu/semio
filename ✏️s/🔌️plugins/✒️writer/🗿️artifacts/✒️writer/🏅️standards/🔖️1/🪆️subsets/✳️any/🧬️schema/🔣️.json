{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/writer/writer/artifact.json",
  "title": "WriterArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "languageId",
    "uri",
    "text",
    "editorSettings",
    "formatSignal",
    "lintSignal",
    "revision",
    "engagementInput",
    "cameraX",
    "cameraY",
    "cameraZoom"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "languageId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "uri": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "text": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "editorSelection": {
      "$ref": "#/$defs/WriterEditorSelection",
      "x-semio-state": "presence"
    },
    "editorSettings": {
      "$ref": "#/$defs/WriterEditorSettings",
      "x-semio-state": "presence"
    },
    "formatSignal": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "lintSignal": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "cameraX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraZoom": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "WriterEditorSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "WriterEditorSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showLineNumbers",
        "fontPx",
        "lineHeight",
        "tabSize"
      ],
      "properties": {
        "showLineNumbers": {
          "type": "boolean"
        },
        "fontPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lineHeight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tabSize": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "WriterTextRangeEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "insert"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "insert": {
          "type": "string"
        }
      }
    },
    "WriterTextDelta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replacement": {
          "type": "string"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WriterTextRangeEdit"
          }
        }
      }
    },
    "WriterArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "languageId",
        "uri",
        "text",
        "editorSettings",
        "formatSignal",
        "lintSignal",
        "revision",
        "engagementInput",
        "cameraX",
        "cameraY",
        "cameraZoom"
      ],
      "properties": {}
    },
    "WriterChildLocalTextLaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "maximumCases",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "maximumCases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "law",
              "first",
              "second",
              "expected"
            ],
            "properties": {
              "law": {
                "enum": [
                  "cloneIdentity",
                  "instanceIsolation",
                  "abaIsolation",
                  "wireOmission"
                ]
              },
              "first": {
                "type": "string",
                "maxLength": 64
              },
              "second": {
                "type": "string",
                "maxLength": 64
              },
              "expected": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        }
      },
      "title": "WriterChildLocalTextLaw",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
