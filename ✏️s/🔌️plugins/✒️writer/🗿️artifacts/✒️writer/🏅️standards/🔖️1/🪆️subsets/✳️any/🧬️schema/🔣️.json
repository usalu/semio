{
  "$id": "https://semio.tech/schema/s/writer/writer/artifact.json",
  "title": "WriterArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "languageId",
    "uri",
    "text",
    "editorSettings",
    "formatSignal",
    "lintSignal",
    "revision",
    "engagementInput",
    "cameraX",
    "cameraY",
    "cameraZoom",
    "locale"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "languageId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "uri": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "text": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "editorSelection": {
      "$ref": "#/$defs/WriterEditorSelection",
      "x-semio-state": "presence"
    },
    "editorSettings": {
      "$ref": "#/$defs/WriterEditorSettings",
      "x-semio-state": "presence"
    },
    "formatSignal": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "lintSignal": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "cameraX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraZoom": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "WriterEditorSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "WriterEditorSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showLineNumbers",
        "fontPx",
        "lineHeight",
        "tabSize"
      ],
      "properties": {
        "showLineNumbers": {
          "type": "boolean"
        },
        "fontPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lineHeight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tabSize": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "WriterTextRangeEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "insert"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "insert": {
          "type": "string"
        }
      }
    },
    "WriterTextDelta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replacement": {
          "type": "string"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WriterTextRangeEdit"
          }
        }
      }
    },
    "WriterArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "languageId",
        "uri",
        "text",
        "editorSettings",
        "formatSignal",
        "lintSignal",
        "revision",
        "engagementInput",
        "cameraX",
        "cameraY",
        "cameraZoom",
        "locale"
      ],
      "properties": {}
    }
  }
}
