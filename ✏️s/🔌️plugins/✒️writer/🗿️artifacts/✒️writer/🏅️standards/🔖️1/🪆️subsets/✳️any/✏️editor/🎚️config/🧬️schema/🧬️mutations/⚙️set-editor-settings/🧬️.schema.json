{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Set Editor Settings",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "properties": {
        "showLineNumbers": {
          "type": "boolean"
        },
        "fontPx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "lineHeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "tabSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "showLineNumbers",
        "fontPx",
        "lineHeight",
        "tabSize"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "settings"
  ],
  "additionalProperties": false
}
