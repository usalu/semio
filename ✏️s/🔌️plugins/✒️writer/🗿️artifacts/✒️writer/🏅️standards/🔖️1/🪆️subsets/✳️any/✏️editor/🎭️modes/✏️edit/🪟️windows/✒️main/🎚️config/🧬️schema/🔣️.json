{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/writer/main-window/config/schema.json",
  "title": "WriterMainWindowConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["camera", "editorSettings"],
  "properties": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      },
      "x-semio-state": "config",
      "x-semio-owner": "window"
    },
    "editorSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showLineNumbers", "fontPx", "lineHeight", "tabSize"],
      "properties": {
        "showLineNumbers": { "type": "boolean" },
        "fontPx": { "type": "integer", "minimum": 1 },
        "lineHeight": { "type": "integer", "minimum": 1 },
        "tabSize": { "type": "integer", "minimum": 1 }
      },
      "x-semio-state": "config",
      "x-semio-owner": "window"
    }
  }
}
