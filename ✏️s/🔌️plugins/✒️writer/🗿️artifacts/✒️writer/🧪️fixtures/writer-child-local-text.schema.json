{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/writer-child-local-text-law.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "maximumCases", "cases"],
  "properties": {
    "$schema": { "type": "string", "const": "./writer-child-local-text.schema.json" },
    "schemaVersion": { "const": 1 },
    "maximumCases": { "type": "integer", "minimum": 1, "maximum": 8 },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["law", "first", "second", "expected"],
        "properties": {
          "law": { "enum": ["cloneIdentity", "instanceIsolation", "abaIsolation", "wireOmission"] },
          "first": { "type": "string", "maxLength": 64 },
          "second": { "type": "string", "maxLength": 64 },
          "expected": { "type": "string", "maxLength": 64 }
        }
      }
    }
  }
}
