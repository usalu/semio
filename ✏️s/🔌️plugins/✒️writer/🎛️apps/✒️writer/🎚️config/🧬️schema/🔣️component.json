{
  "$id": "https://semio.tech/schema/app/writer/writer/config.json",
  "title": "WriterConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedAstIds",
    "formatSignal",
    "lintSignal",
    "revision",
    "editorSettings",
    "engagementInput",
    "camera",
    "locale"
  ],
  "properties": {
    "selectedAstIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "editorSelection": {
      "$ref": "#/$defs/WriterEditorSelection",
      "x-semio-state": "config"
    },
    "formatSignal": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "lintSignal": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "editorSettings": {
      "$ref": "#/$defs/WriterEditorSettings",
      "x-semio-state": "config"
    },
    "treeHoveredAstId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "editorHoverOffset": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "#/$defs/WriterCamera",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "WriterEditorSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WriterEditorSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "showLineNumbers",
        "fontPx",
        "lineHeight",
        "tabSize"
      ],
      "properties": {
        "showLineNumbers": {
          "type": "boolean"
        },
        "fontPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "lineHeight": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tabSize": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "WriterCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        }
      }
    }
  }
}
