{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/animate/presentation/sqlite-laws.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot",
    "binary64Words",
    "malformedSql",
    "control"
  ],
  "properties": {
    "snapshot": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/animate/presentation/snapshot.json"
    },
    "binary64Words": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "malformedSql": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "string"
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectionLength",
        "largeTextBytes",
        "maxOwnedBytes",
        "tinyFileBytes"
      ],
      "properties": {
        "collectionLength": {
          "type": "integer",
          "minimum": 256
        },
        "largeTextBytes": {
          "type": "integer",
          "minimum": 65537
        },
        "maxOwnedBytes": {
          "type": "integer",
          "minimum": 1
        },
        "tinyFileBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

