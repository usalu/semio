{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/animate/presentation/mutation/create-tile/schema.json",
  "title": "CreateTile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "tile"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "tile": {
      "title": "FigureTileDraft",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crop",
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "crop": {
          "title": "FigureTileFrame",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height",
            "width",
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Crop",
              "de": "Zuschnitt"
            },
            "description": {
              "en": "Region of the source the tile shows, as fractions of the source size.",
              "de": "Bereich der Quelle, den die Kachel zeigt, als Anteile der Quellgröße."
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Tile",
          "de": "Kachel"
        },
        "description": {
          "en": "The complete tile record to add.",
          "de": "Die vollständige hinzuzufügende Kachel."
        }
      }
    }
  }
}
