{
  "base": {
    "engagementInput": "",
    "locale": "en-US"
  },
  "cases": [
    {
      "kind": "set-engagement-input",
      "mutation": {
        "SetEngagementInput": {
          "value": "2×2\nGrüße"
        }
      },
      "expected": {
        "engagementInput": "2×2\nGrüße",
        "locale": "en-US"
      }
    },
    {
      "kind": "set-locale",
      "mutation": {
        "SetLocale": {
          "value": "de-DE"
        }
      },
      "expected": {
        "engagementInput": "",
        "locale": "de-DE"
      }
    }
  ]
}
