{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/animate/presentation/mutation/replace-tiles/schema.json",
  "title": "ReplaceTiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newTiles"
  ],
  "properties": {
    "newTiles": {
      "type": "array",
      "items": {
        "title": "FigureTileDraft",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "crop",
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "crop": {
            "title": "FigureTileFrame",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "height",
              "width",
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "x-semio-ui": {
              "role": "value",
              "label": {
                "en": "Crop",
                "de": "Zuschnitt"
              },
              "description": {
                "en": "Region of the source the tile shows, as fractions of the source size.",
                "de": "Bereich der Quelle, den die Kachel zeigt, als Anteile der Quellgröße."
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New Tiles",
          "de": "Neue Kacheln"
        },
        "description": {
          "en": "All tiles in order.",
          "de": "Alle Kacheln in Reihenfolge."
        }
      }
    }
  }
}
