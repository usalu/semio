{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/animate/presentation/mutation/reorder-tiles/schema.json",
  "title": "ReorderTiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "toIndex"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tile",
          "de": "Kachel"
        },
        "description": {
          "en": "The tile this mutation addresses.",
          "de": "Die Kachel, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "tile",
          "domain": "tiles",
          "granularity": "tile"
        }
      }
    },
    "toIndex": {
      "type": "integer",
      "minimum": 0
    }
  }
}
