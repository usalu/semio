{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/animate/presentation/mutation/resize-source-frame/schema.json",
  "title": "ResizeSourceFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newFrame"
  ],
  "properties": {
    "newFrame": {
      "title": "FigureTileFrame",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "width",
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New Source Frame",
          "de": "Neuer Quellrahmen"
        },
        "description": {
          "en": "Visible region of the source, as fractions of its size.",
          "de": "Sichtbarer Bereich der Quelle als Anteile ihrer Größe."
        }
      }
    }
  }
}
