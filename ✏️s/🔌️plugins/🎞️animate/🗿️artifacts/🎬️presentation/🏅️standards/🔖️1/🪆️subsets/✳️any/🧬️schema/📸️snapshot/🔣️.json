{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/animate/presentation/snapshot.json",
  "title": "PresentationSnapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "source": {
      "title": "FigureTileSource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "kind",
        "src"
      ],
      "properties": {
        "src": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "frame": {
          "title": "FigureTileFrame",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height",
            "width",
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "sourceAspect": {
          "type": "number"
        },
        "pdfPage": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-semio-state": "artifact"
    },
    "tiles": {
      "type": "array",
      "items": {
        "title": "FigureTileDraft",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "crop",
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "crop": {
            "title": "FigureTileFrame",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "height",
              "width",
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            }
          }
        }
      },
      "x-semio-state": "artifact"
    },
    "presentation": {
      "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "animation": {
      "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    }
  },
  "required": [
    "schema",
    "source",
    "tiles",
    "presentation",
    "animation"
  ]
}
