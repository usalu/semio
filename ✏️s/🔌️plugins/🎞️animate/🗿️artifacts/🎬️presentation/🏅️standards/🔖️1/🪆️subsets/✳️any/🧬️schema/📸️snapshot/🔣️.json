{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/animate/presentation/snapshot.json",
  "title": "PresentationSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "tiles"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "source": {
      "$ref": "https://semio.tech/schema/s/animate/presentation/artifact.json#/$defs/FigureTileSource",
      "x-semio-state": "artifact"
    },
    "tiles": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/animate/presentation/artifact.json#/$defs/FigureTileDraft"
      },
      "x-semio-state": "artifact"
    }
  }
}
