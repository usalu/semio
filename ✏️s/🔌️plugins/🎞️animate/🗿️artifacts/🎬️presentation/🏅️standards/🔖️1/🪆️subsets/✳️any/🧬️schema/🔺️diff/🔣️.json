{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/animate/presentation/diff.json",
  "title": "PresentationDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "title": "PresentationArtifact",
      "type": "object",
      "x-semio-state": "artifact"
    },
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "source": {
      "$ref": "https://semio.tech/schema/s/animate/presentation/artifact.json#/$defs/FigureTileSource",
      "x-semio-state": "artifact"
    },
    "tiles": {
      "$ref": "#/$defs/PresentationTilesDelta",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "FigureTileDraftPatch": {
      "title": "FigureTileDraftPatch",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "crop": {
          "$ref": "https://semio.tech/schema/s/animate/presentation/artifact.json#/$defs/FigureTileFrame"
        }
      }
    },
    "PresentationStringList": {
      "title": "PresentationStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PresentationTilesDelta": {
      "title": "PresentationTilesDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/animate/presentation/artifact.json#/$defs/FigureTileDraft"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PresentationTilePatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PresentationTilePatchEntry": {
      "title": "PresentationTilePatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/FigureTileDraftPatch"
        }
      }
    }
  }
}
