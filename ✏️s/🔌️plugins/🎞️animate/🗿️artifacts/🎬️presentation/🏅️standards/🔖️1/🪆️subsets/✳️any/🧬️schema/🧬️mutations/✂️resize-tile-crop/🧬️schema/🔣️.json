{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/animate/presentation/mutation/resize-tile-crop/schema.json",
  "title": "ResizeTileCrop",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newCrop"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tile",
          "de": "Kachel"
        },
        "description": {
          "en": "The tile to crop.",
          "de": "Die zuzuschneidende Kachel."
        },
        "ref": {
          "kind": "tile",
          "domain": "tiles",
          "granularity": "tile"
        }
      }
    },
    "newCrop": {
      "title": "FigureTileFrame",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "width",
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New Crop",
          "de": "Neuer Zuschnitt"
        },
        "description": {
          "en": "Region of the source the tile shows, as fractions of the source size.",
          "de": "Bereich der Quelle, den die Kachel zeigt, als Anteile der Quellgröße."
        }
      }
    }
  }
}
