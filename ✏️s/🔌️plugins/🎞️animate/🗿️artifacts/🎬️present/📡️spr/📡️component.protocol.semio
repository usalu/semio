field format u8
field ordinal varint
field body bytes
record animate.present-tiles-move tag=3
field format u8
field ordinal varint
field body bytes
record animate.present-tiles-patch tag=4
field format u8
field ordinal varint
field body bytes
record animate.present-set-source tag=5
field format u8
field ordinal varint
field body bytes
record animate.present-set-tiles tag=6
field format u8
field ordinal varint
field body bytes
record animate.present-set-snapshot tag=7
field format u8
field ordinal varint
field body bytes
chain hash u64
