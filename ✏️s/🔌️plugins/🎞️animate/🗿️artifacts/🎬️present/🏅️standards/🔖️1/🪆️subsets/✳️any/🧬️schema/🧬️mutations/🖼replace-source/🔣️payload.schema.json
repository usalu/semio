{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceSource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newSource"
  ],
  "properties": {
    "newSource": {
      "title": "FigureTileSource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "kind",
        "src"
      ],
      "properties": {
        "src": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "frame": {
          "title": "FigureTileFrame",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height",
            "width",
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "sourceAspect": {
          "type": "number"
        },
        "pdfPage": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
