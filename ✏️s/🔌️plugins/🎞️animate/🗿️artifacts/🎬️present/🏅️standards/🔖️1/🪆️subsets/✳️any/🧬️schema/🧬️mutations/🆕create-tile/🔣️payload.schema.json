{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateTile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "tile"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "tile": {
      "title": "FigureTileDraft",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crop",
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "crop": {
          "title": "FigureTileFrame",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height",
            "width",
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
