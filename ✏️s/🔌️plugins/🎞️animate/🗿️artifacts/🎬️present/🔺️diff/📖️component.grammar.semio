dialect grammar
grammar present.diff
extension present
use family-scene
start diff

diff = {"source" "=" source-block}? {"tiles" "=" collection-diff}?
source-block = "source" "{" prop* frame-block? "}"
frame-block = "frame" "{" prop* "}"
collection-diff = "{" {"added" "=" list}? {"removed" "=" list}? {"moved" "=" list}? {"modified" "=" list}? "}"
props = "{" prop* "}"
prop = IDENT "=" (TEXT | FLOAT | INT | BOOL | list | map)
list = "[" value* "]"
map = "{" prop* "}"
value = TEXT | FLOAT | INT | BOOL | list | map
