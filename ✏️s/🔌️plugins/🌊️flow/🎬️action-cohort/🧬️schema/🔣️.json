{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/flow/action-cohort/schema.json",
  "title": "S Flow Action Cohort Schema Module",
  "$defs": {
    "ActionCohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "owner",
        "source",
        "routeCount",
        "retainedRoutes",
        "groups",
        "globals",
        "scanThenMonolithRoutes",
        "laws"
      ],
      "properties": {
        "schema": {
          "enum": [
            "semio.flow-note.action-cohort.v1",
            "semio.note.action-cohort.v1"
          ]
        },
        "owner": {
          "enum": [
            "FlowPlayApp",
            "NotePlayApp"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "routeCount": {
          "description": "The census: the number of command rows the owner's own command table declares. Every row is classified in exactly one group, so routeCount equals the number of routes across groups; framework-reserved actions are never app routes and never appear in a cohort.",
          "type": "integer",
          "minimum": 1
        },
        "retainedRoutes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "lanes",
              "routes"
            ],
            "properties": {
              "status": {
                "enum": [
                  "migrated",
                  "batch-only-pending-rewrite"
                ]
              },
              "lanes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "artifact",
                    "config",
                    "draft",
                    "presence",
                    "transient",
                    "child",
                    "host-only"
                  ]
                }
              },
              "routes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "blocker": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "batch-only-pending-rewrite"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "blocker": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "blocker"
                  ]
                },
                "else": {
                  "properties": {
                    "blocker": false
                  }
                }
              }
            ]
          }
        },
        "globals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "scope",
              "blocker"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "framework-process",
                  "plugin-process"
                ]
              },
              "blocker": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scanThenMonolithRoutes": {
          "type": "array",
          "maxItems": 0
        },
        "blockedSeams": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "laws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activationBeforeDecodeRejected",
            "exactCensus",
            "forgedProofRejected",
            "factoryRequiresContract",
            "hostOnlyExclusive",
            "storeLaneRequiresPreparation"
          ],
          "properties": {
            "activationBeforeDecodeRejected": {
              "const": true
            },
            "exactCensus": {
              "const": true
            },
            "forgedProofRejected": {
              "const": true
            },
            "factoryRequiresContract": {
              "const": true
            },
            "exactArtifactScalarReducer": {
              "const": true
            },
            "gridSpacingInvariantPreserved": {
              "const": true
            },
            "artifactPreparationRejectsOtherMutations": {
              "const": true
            },
            "hostOnlyExclusive": {
              "const": true
            },
            "operationFreshness": {
              "const": true
            },
            "storeLaneRequiresPreparation": {
              "const": true
            },
            "storeAuthorityOwnsDigest": {
              "const": true
            },
            "terminalWitnessRequired": {
              "const": true
            }
          }
        }
      },
      "title": "ActionCohort"
    }
  }
}
