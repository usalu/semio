{
  "$id": "https://semio.tech/schema/s/flow/flow/artifact.json",
  "title": "FlowArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "camera",
    "widgets",
    "synapses",
    "layout",
    "selectedNodeIds",
    "selectedEdgeIds",
    "selectedHandleIds",
    "previewOffNodeIds",
    "lodMode",
    "proximityDistance",
    "gridVisible",
    "gridSnapEnabled",
    "gridFactor",
    "catalogueSectionsJson",
    "automationEnabledJson",
    "contributionsJson",
    "generationJson",
    "locale"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "camera": {
      "$ref": "#/$defs/CameraJson",
      "x-semio-state": "artifact"
    },
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Widget"
      },
      "x-semio-state": "artifact"
    },
    "synapses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SynapseSpec"
      },
      "x-semio-state": "artifact"
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/WidgetLayout"
      },
      "x-semio-state": "artifact"
    },
    "selectedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "selectedEdgeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "selectedHandleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "previewOffNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "lodMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "proximityDistance": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "gridVisible": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "gridSnapEnabled": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "gridFactor": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "catalogueSectionsJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    },
    "automationEnabledJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    },
    "contributionsJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    },
    "generationJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "CameraJson": {
      "title": "CameraJson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "WidgetLayout": {
      "title": "WidgetLayout",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "SynapseSpec": {
      "title": "SynapseSpec",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "fromPort",
        "toPort"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "fromPort": {
          "type": "string"
        },
        "toPort": {
          "type": "string"
        }
      }
    },
    "Widget": {
      "title": "Widget",
      "type": "string",
      "contentMediaType": "application/json"
    }
  }
}
