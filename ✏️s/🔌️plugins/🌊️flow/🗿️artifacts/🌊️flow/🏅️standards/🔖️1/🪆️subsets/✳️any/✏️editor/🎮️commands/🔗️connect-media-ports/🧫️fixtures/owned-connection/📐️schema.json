{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contractId",
    "sourceNode",
    "sourcePort",
    "targetNode",
    "targetPort",
    "foreignPort",
    "acceptedGroups",
    "closeGrant",
    "closeSteps",
    "refusalCode",
    "acceptedOperations",
    "removals",
    "seedSource"
  ],
  "properties": {
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "sourceNode": {
      "type": "string",
      "minLength": 1
    },
    "sourcePort": {
      "type": "string",
      "minLength": 1
    },
    "targetNode": {
      "type": "string",
      "minLength": 1
    },
    "targetPort": {
      "type": "string",
      "minLength": 1
    },
    "foreignPort": {
      "type": "string",
      "minLength": 1
    },
    "acceptedGroups": {
      "type": "integer",
      "minimum": 1
    },
    "closeGrant": {
      "type": "integer",
      "minimum": 1
    },
    "closeSteps": {
      "type": "integer",
      "minimum": 1
    },
    "refusalCode": {
      "type": "string",
      "minLength": 1
    },
    "acceptedOperations": {
      "type": "integer",
      "minimum": 1
    },
    "removals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "command",
          "target",
          "remainingWidgets",
          "remainingEdges"
        ],
        "properties": {
          "command": {
            "enum": [
              "removeWidget",
              "disconnect",
              "deleteSelection"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "remainingWidgets": {
            "type": "integer",
            "minimum": 0
          },
          "remainingEdges": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "seedSource": {
      "const": "publishedDemo"
    }
  },
  "additionalProperties": false
}
