{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.flow.delete-cascade",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "scene", "targetId", "label", "expectedForwardSynapses", "expectedInverseIndices"],
  "properties": {
    "schema": {"const": "semio.flow.delete-cascade"},
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["widgets", "synapses", "layout"],
      "properties": {
        "widgets": {"type": "array", "items": {"$ref": "semio.flow.artifact-canonical#/definitions/widget"}},
        "synapses": {"type": "array", "items": {"$ref": "semio.flow.artifact-canonical#/definitions/synapse"}},
        "layout": {"type": "object", "additionalProperties": {"$ref": "semio.flow.artifact-canonical#/definitions/layout"}}
      }
    },
    "targetId": {"type": "string", "minLength": 1},
    "label": {
      "type": "object", "additionalProperties": false, "required": ["unit", "repetitions", "expectedBytes"],
      "properties": {"unit": {"type": "string"}, "repetitions": {"type": "integer", "minimum": 1}, "expectedBytes": {"const": 4800}}
    },
    "expectedForwardSynapses": {"const": ["e0", "e2", "e4"]},
    "expectedInverseIndices": {"const": [1, 3]}
  }
}
