{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.flow.grant-frontier.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "maximumTextBytes", "productionGrantBytes", "preparationGrantBytes", "canonicalVariants", "cases"],
  "properties": {
    "schema": { "const": "semio.flow.grant-frontier.v1" },
    "maximumTextBytes": { "const": 16384 },
    "productionGrantBytes": { "const": 4096 },
    "preparationGrantBytes": { "const": [1, 64, 4096] },
    "canonicalVariants": {
      "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true,
      "items": { "enum": ["Snapshot", "SetContributions", "SetPreviewOff", "SetCamera", "SetLodMode", "SetProximityDistance", "SetGridVisible", "SetGridSnapEnabled", "SetGridFactor", "SetCatalogueSections", "SetAutomationEnabled", "SetGeneration", "SetDuplicateWidgetProgress", "CancelDuplicateWidget", "SetLocale"] }
    },
    "cases": {
      "type": "array", "minItems": 6, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "unit", "repetitions", "grantBytes", "cancelAt", "expectedTextBytes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "unit": { "enum": ["a", "🌊", "\u0000"] },
          "repetitions": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "grantBytes": { "enum": [1, 3, 64, 4096] },
          "cancelAt": { "type": "integer", "minimum": 0, "maximum": 16384 },
          "expectedTextBytes": { "type": "integer", "minimum": 1, "maximum": 16384 }
        }
      }
    }
  }
}
