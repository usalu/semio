dialect protocol
protocol flow.mutations
version 1
schema flow.flow.mutations
start record
framing record

# Real `FlowMutation` op frame (`dsl::tagged_value_binary`): `format u8` (`OP_BINARY_FORMAT`) then `tag varint`, then
# the variant's `ToValue` tree without its variant name, as one framework wire value (`pack_rt::encode_wire_value`).
# Each record is one mutation kind at its wire tag; this file is the only source of those tags.
header fixed 2
field format u8
field tag varint
record create-widget tag=0
field payload bytes
record delete-widget tag=1
field payload bytes
record reorder-widgets tag=2
field payload bytes
record replace-widget tag=3
field payload bytes
record connect-widgets tag=4
field payload bytes
record disconnect-widgets tag=5
field payload bytes
record reorder-synapses tag=6
field payload bytes
record update-synapse-endpoints tag=7
field payload bytes
record move-widgets tag=8
field payload bytes
record duplicate-widget tag=9
field payload bytes
