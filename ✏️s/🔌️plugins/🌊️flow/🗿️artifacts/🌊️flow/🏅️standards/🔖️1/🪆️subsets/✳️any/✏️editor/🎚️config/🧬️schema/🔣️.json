{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/flow/flow/config/schema.json",
  "title": "FlowConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "previewOffNodeIds",
    "camera",
    "lodMode",
    "proximityDistance",
    "gridVisible",
    "gridSnapEnabled",
    "gridFactor",
    "catalogueSectionsJson",
    "automationEnabledJson",
    "contributionsJson",
    "generationJson",
    "duplicateWidgetProgressJson"
  ],
  "properties": {
    "previewOffNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "https://semio.tech/schema/s/flow/flow/artifact.json#/$defs/CameraJson",
      "x-semio-state": "config"
    },
    "lodMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "proximityDistance": {
      "type": "number",
      "x-semio-state": "config"
    },
    "gridVisible": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "gridSnapEnabled": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "gridFactor": {
      "type": "number",
      "x-semio-state": "config"
    },
    "catalogueSectionsJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "automationEnabledJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "contributionsJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "generationJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "duplicateWidgetProgressJson": {
      "type": "string",
      "x-semio-state": "config"
    }
  }
}
