{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.flow.slider-labels",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "semio.flow.slider-labels" },
    "cases": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["widget", "expectedDagName"],
        "properties": {
          "expectedDagName": { "type": "string" },
          "widget": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "id", "label", "value", "min", "max", "step"],
            "properties": {
              "kind": { "const": "inputSlider" }, "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string" }, "value": { "type": "number" },
              "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
