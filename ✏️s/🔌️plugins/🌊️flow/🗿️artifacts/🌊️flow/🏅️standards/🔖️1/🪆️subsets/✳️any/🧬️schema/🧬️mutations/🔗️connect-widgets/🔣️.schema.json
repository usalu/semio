{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConnectWidgets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from",
    "fromPort",
    "id",
    "index",
    "to",
    "toPort"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "id": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "fromPort": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "toPort": {
      "type": "string"
    }
  }
}
