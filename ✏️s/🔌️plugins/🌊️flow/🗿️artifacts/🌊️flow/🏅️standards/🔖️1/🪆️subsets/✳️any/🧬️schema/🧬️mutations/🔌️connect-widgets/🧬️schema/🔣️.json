{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/flow/flow/mutation/connect-widgets/schema.json",
  "title": "ConnectWidgets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "from",
    "fromPort",
    "id",
    "index",
    "to",
    "toPort"
  ],
  "properties": {
    "mutation": {
      "const": "connectWidgets"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "id": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Source Widget",
          "de": "Quell-Widget"
        },
        "description": {
          "en": "The widget the connection starts at.",
          "de": "Das Widget, an dem die Verbindung beginnt."
        },
        "ref": {
          "kind": "widget",
          "domain": "graph",
          "granularity": "node"
        }
      }
    },
    "fromPort": {
      "type": "string"
    },
    "to": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Target Widget",
          "de": "Ziel-Widget"
        },
        "description": {
          "en": "The widget the connection ends at.",
          "de": "Das Widget, an dem die Verbindung endet."
        },
        "ref": {
          "kind": "widget",
          "domain": "graph",
          "granularity": "node"
        }
      }
    },
    "toPort": {
      "type": "string"
    }
  }
}
