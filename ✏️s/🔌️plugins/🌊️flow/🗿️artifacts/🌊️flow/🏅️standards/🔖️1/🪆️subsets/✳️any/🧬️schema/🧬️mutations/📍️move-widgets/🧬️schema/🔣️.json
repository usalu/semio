{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/flow/flow/mutation/move-widgets/schema.json",
  "title": "MoveWidgets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "entries"
  ],
  "properties": {
    "mutation": {
      "const": "moveWidgets"
    },
    "entries": {
      "type": "array",
      "items": {
        "title": "FlowLayoutEntry",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layout": {
            "title": "WidgetLayout",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Widget Positions",
          "de": "Widget-Positionen"
        },
        "description": {
          "en": "New layout per widget.",
          "de": "Neues Layout je Widget."
        }
      }
    }
  }
}
