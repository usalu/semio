{
  "$id": "https://semio.tech/schema/app/flow/flow/config.json",
  "title": "FlowConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "previewOffNodeIds",
    "camera",
    "lodMode",
    "proximityDistance",
    "gridVisible",
    "gridSnapEnabled",
    "gridFactor",
    "catalogueSectionsJson",
    "automationEnabledJson",
    "contributionsJson",
    "generationJson",
    "locale"
  ],
  "properties": {
    "previewOffNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "#/$defs/CameraJson",
      "x-semio-state": "config"
    },
    "lodMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "proximityDistance": {
      "type": "number",
      "x-semio-state": "config"
    },
    "gridVisible": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "gridSnapEnabled": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "gridFactor": {
      "type": "number",
      "x-semio-state": "config"
    },
    "catalogueSectionsJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "automationEnabledJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "contributionsJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "generationJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "CameraJson": {
      "title": "CameraJson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
