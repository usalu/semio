      "type": "semio_s_artifact_flow_flow::FlowSnapshot",
      "schema": "s.flow.flow",
      "dialect": {
        "artifactKind": "s.flow.flow",
        "standard": "1",
        "subset": "*"
      }
    },
    {
      "type": "semio_framework_artifact_flow_flow::FlowHostSnapshot",
      "schema": "flow.host_snapshot",
      "dialect": {
        "artifactKind": "flow.host_snapshot",
        "standard": "1",
        "subset": "*"
      }
    }
