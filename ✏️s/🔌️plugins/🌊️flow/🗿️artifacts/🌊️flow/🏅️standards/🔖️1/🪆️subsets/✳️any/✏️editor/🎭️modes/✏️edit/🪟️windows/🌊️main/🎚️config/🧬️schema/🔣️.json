{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/flow/flow/main-window-config.json",
  "title": "FlowMainWindowConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["previewOffNodeIds", "camera", "lodMode", "proximityDistance", "gridVisible", "gridSnapEnabled", "gridFactor", "catalogueSectionsJson", "automationEnabledJson"],
  "properties": {
    "previewOffNodeIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "zoom": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "lodMode": { "type": "string" },
    "proximityDistance": { "type": "number", "minimum": 0 },
    "gridVisible": { "type": "boolean" },
    "gridSnapEnabled": { "type": "boolean" },
    "gridFactor": { "type": "number", "minimum": 0.5, "maximum": 50 },
    "catalogueSectionsJson": { "type": "string" },
    "automationEnabledJson": { "type": "string" }
  }
}
