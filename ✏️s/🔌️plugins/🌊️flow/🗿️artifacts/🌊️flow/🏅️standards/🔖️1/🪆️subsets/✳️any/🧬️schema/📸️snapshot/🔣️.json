{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/flow/flow/snapshot.json",
  "title": "FlowSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "camera",
    "widgets",
    "synapses",
    "layout"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "camera": {
      "$ref": "https://semio.tech/schema/s/flow/flow/artifact.json#/$defs/CameraJson",
      "x-semio-state": "artifact"
    },
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/flow/flow/artifact.json#/$defs/Widget"
      },
      "x-semio-state": "artifact"
    },
    "synapses": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/flow/flow/artifact.json#/$defs/SynapseSpec"
      },
      "x-semio-state": "artifact"
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://semio.tech/schema/s/flow/flow/artifact.json#/$defs/WidgetLayout"
      },
      "x-semio-state": "artifact"
    }
  }
}
