{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "parentContent", "before", "cases", "repeated", "denials", "parentMutations", "childMutations"],
  "properties": {
    "schema": { "const": "semio.flow.child-add-widget/v1" },
    "parentContent": { "$ref": "#/$defs/child" },
    "before": { "$ref": "#/$defs/snapshot" },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "descriptor", "position", "expectedNode"],
        "properties": {
          "id": { "enum": ["input-note", "input-slider"] },
          "descriptor": {
            "type": "object",
            "minProperties": 2,
            "maxProperties": 2,
            "additionalProperties": { "type": "string" },
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["inputNote", "inputSlider"] },
              "text": { "type": "string" },
              "label": { "type": "string" }
            }
          },
          "position": { "$ref": "#/$defs/point" },
          "expectedNode": { "$ref": "#/$defs/node" }
        }
      }
    },
    "repeated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "existingIds", "expectedId"],
      "properties": {
        "kind": { "const": "inputNote" },
        "existingIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^note_[0-9]+$" }
        },
        "expectedId": { "const": "note_3" }
      }
    },
    "denials": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["missingChild", "wrongSlot", "duplicateId", "unexpectedWidgetDelta", "unexpectedEdgeDelta", "unexpectedLayoutDelta"] }
    },
    "parentMutations": { "const": 0 },
    "childMutations": { "const": 1 }
  },
  "$defs": {
    "dialect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "standard", "subset"],
      "properties": {
        "artifactKind": { "const": "s.stdio.semio" },
        "standard": { "const": "v1" },
        "subset": { "const": "flow" }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childId", "target"],
      "properties": {
        "childId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactId", "dialect"],
          "properties": {
            "artifactId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "dialect": { "$ref": "#/$defs/dialect" }
          }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "maxLength": 256 },
        "value": { "type": "string", "maxLength": 3072 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "params", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 256 },
        "label": { "type": "string", "maxLength": 256 },
        "params": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/param" } },
        "position": { "$ref": "#/$defs/point" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "nodes", "edges"],
      "properties": {
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    }
  }
}
