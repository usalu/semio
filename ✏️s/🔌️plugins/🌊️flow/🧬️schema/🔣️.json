{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/flow/schema.json",
  "title": "S Flow Plugin Schema Module",
  "$defs": {
    "FlowSurfaceOwners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "package",
        "roles",
        "members",
        "items",
        "byteGrants",
        "maximumSteps",
        "expected"
      ],
      "properties": {
        "contract": {
          "const": "semio.flow.surface-owners/v1"
        },
        "package": {
          "const": "semio:flow"
        },
        "roles": {
          "const": [
            "editor",
            "viewer"
          ]
        },
        "members": {
          "const": "s.stdio.semio@v1/flow"
        },
        "items": {
          "const": 1
        },
        "byteGrants": {
          "const": [
            1,
            64,
            4096
          ]
        },
        "maximumSteps": {
          "const": 100000
        },
        "expected": {
          "const": {
            "factories": 2,
            "complete": true,
            "terminalEmpty": true
          }
        }
      },
      "title": "FlowSurfaceOwners"
    }
  }
}
