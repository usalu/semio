{
  "$id": "https://semio.tech/schema/app/flow/flow/presence.json",
  "title": "FlowPresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "previewOffNodeIds",
    "camera"
  ],
  "properties": {
    "previewOffNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "camera": {
      "$ref": "#/$defs/CameraJson",
      "x-semio-state": "presence"
    }
  },
  "$defs": {
    "CameraJson": {
      "title": "CameraJson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
