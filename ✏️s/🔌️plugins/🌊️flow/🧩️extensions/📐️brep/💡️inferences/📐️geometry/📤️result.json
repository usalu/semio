{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.flow-extension-brep.geometry.result",
  "title": "GeometryInferenceResult",
  "type": "object",
  "required": [
    "done",
    "cancellable",
    "phase",
    "unitsDone",
    "unitsTotal",
    "outputJson"
  ],
  "properties": {
    "done": {
      "type": "boolean"
    },
    "cancellable": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "unitsDone": {
      "type": "integer",
      "minimum": 0
    },
    "unitsTotal": {
      "type": "integer",
      "minimum": 0
    },
    "outputJson": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
