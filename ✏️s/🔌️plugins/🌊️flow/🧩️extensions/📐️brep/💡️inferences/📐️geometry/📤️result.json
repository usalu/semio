{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.flow-extension-brep.geometry.result",
  "title": "GeometryInferenceResult",
  "type": "object",
  "required": [
    "done",
    "cancellable",
    "phase",
    "unitsDone",
    "unitsTotal",
    "outputJson"
  ],
  "properties": {
    "done": {
      "type": "boolean"
    },
    "cancellable": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "unitsDone": {
      "type": "integer",
      "minimum": 0
    },
    "unitsTotal": {
      "type": "integer",
      "minimum": 0
    },
    "outputJson": {
      "type": "string"
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neuronId",
        "extensionId",
        "operatorId",
        "nodeHash",
        "inputJson"
      ],
      "properties": {
        "neuronId": {
          "type": "string",
          "minLength": 1
        },
        "extensionId": {
          "type": "string",
          "minLength": 1
        },
        "operatorId": {
          "type": "string",
          "minLength": 1
        },
        "nodeHash": {
          "type": "integer",
          "minimum": 0
        },
        "inputJson": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
