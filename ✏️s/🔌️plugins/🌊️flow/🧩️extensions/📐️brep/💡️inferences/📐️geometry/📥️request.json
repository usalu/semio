{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.flow-extension-brep.geometry.request",
  "title": "GeometryInferenceRequest",
  "type": "object",
  "required": [
    "neuronId",
    "operatorId",
    "inputJson",
    "retained"
  ],
  "properties": {
    "operatorId": {
      "type": "string",
      "pattern": "^brep\\."
    },
    "inputJson": {
      "type": "string"
    },
    "nodeHash": {
      "type": "integer",
      "minimum": 0
    },
    "budget": {
      "type": "integer",
      "minimum": 0
    },
    "wallMicros": {
      "type": "integer",
      "minimum": 0
    },
    "dependencyJson": {
      "type": "string"
    },
    "operatorVersion": {
      "type": "string"
    },
    "cancellationId": {
      "type": "string"
    },
    "inferenceSchema": {
      "const": "s.flow-extension-brep.geometry"
    },
    "resume": {
      "type": "boolean",
      "description": "Resume the same parked owner with empty inputJson and dependencyJson; operator, node hash, version and cancellation identity must match."
    },
    "retained": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "neuronId": {
      "type": "string",
      "minLength": 1
    },
    "roundUnits": {
      "type": "integer",
      "minimum": 0
    },
    "externalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neuronId",
        "extensionId",
        "operatorId",
        "nodeHash",
        "outputJson"
      ],
      "properties": {
        "neuronId": {
          "type": "string",
          "minLength": 1
        },
        "extensionId": {
          "type": "string",
          "minLength": 1
        },
        "operatorId": {
          "type": "string",
          "minLength": 1
        },
        "outputJson": {
          "type": "string"
        },
        "nodeHash": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": false,
  "description": "Canonical initial or replacement operator input and source/wiring/version dependencies. Compact resumes reuse the same parked owner and do not resend source payloads. Output handles are transient instance resources.",
  "x-semio-reads": [
    "operatorId",
    "operatorVersion",
    "inputJson",
    "dependencyJson"
  ]
}
