{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluate",
    "tessellate",
    "grant",
    "steps",
    "geometrySchema"
  ],
  "properties": {
    "evaluate": {
      "type": "object",
      "required": [
        "operatorId",
        "inputJson",
        "nodeHash"
      ],
      "additionalProperties": false,
      "properties": {
        "operatorId": {
          "const": "brep.prim3d.box"
        },
        "inputJson": {
          "type": "string"
        },
        "nodeHash": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tessellate": {
      "type": "object",
      "required": [
        "tolerance",
        "budget",
        "wallMicros",
        "chunk"
      ],
      "additionalProperties": false,
      "properties": {
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "budget": {
          "const": 1
        },
        "wallMicros": {
          "type": "integer",
          "minimum": 0
        },
        "chunk": {
          "const": 0
        }
      }
    },
    "grant": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "steps": {
      "type": "integer",
      "minimum": 1
    },
    "geometrySchema": {
      "const": "geometry"
    }
  }
}
