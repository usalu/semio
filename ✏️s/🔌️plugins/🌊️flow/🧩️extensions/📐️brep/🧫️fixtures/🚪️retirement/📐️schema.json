{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluate",
    "tessellate",
    "grant",
    "steps",
    "geometrySchema",
    "ownerIsolation",
    "bypassIdentity",
    "exactCancellation"
  ],
  "properties": {
    "bypassIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeHashes","cancellationGroup","roundUnits","compactHops","cacheMode","complete"],
      "properties": {
        "nodeHashes": {"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"type":"integer","minimum":1}},
        "cancellationGroup": {"type":"string","minLength":1},
        "roundUnits": {"const":1},
        "compactHops": {"const":8},
        "cacheMode": {"const":"bypass"},
        "complete": {"const":false}
      }
    },
    "evaluate": {
      "type": "object",
      "required": [
        "operatorId",
        "inputJson",
        "nodeHash"
      ],
      "additionalProperties": false,
      "properties": {
        "operatorId": {
          "const": "brep.prim3d.box"
        },
        "inputJson": {
          "type": "string"
        },
        "nodeHash": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tessellate": {
      "type": "object",
      "required": [
        "tolerance",
        "budget",
        "wallMicros",
        "chunk"
      ],
      "additionalProperties": false,
      "properties": {
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "budget": {
          "const": 1
        },
        "wallMicros": {
          "type": "integer",
          "minimum": 0
        },
        "chunk": {
          "const": 0
        }
      }
    },
    "grant": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "steps": {
      "type": "integer",
      "minimum": 1
    },
    "geometrySchema": {
      "const": "geometry"
    },
    "exactCancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeHashLiteral", "roundUnits", "retired", "pending", "malformed", "faultCode"],
      "properties": {
        "nodeHashLiteral": {"const": "18446744073709551613"},
        "roundUnits": {"const": 1},
        "retired": {"const": 1},
        "pending": {"const": true},
        "malformed": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}},
        "faultCode": {"const": "extension.evaluate-cancel.bad-request"}
      }
    },
    "ownerIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharedNodeHash", "roundUnits", "maximumTurns", "halfExtents", "liveOwnerMustRemainPendingAfterOtherClose", "originalReaderHops"],
      "properties": {
        "sharedNodeHash": {"type": "integer", "minimum": 1},
        "roundUnits": {"const": 1},
        "maximumTurns": {"type": "integer", "minimum": 1},
        "halfExtents": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
        "liveOwnerMustRemainPendingAfterOtherClose": {"const": true},
        "originalReaderHops": {"const": 8}
      }
    }
  }
}
