{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:flow:mesh",
  "title": "Indexed Polygon Mesh",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vertices",
    "faces"
  ],
  "properties": {
    "vertices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 100000,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      }
    },
    "faces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
