    },
    {
      "name": "scale-vertices-about-explicit-point",
      "transform": {"mode":"vertex","selection":[0,1,1],"operation":"scale","vector":[-1,2,3],"angle":0,"pivot":[1,1,1]},
      "vertices": [0,1], "pivot": [1,1,1],
