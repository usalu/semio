{
  "name": "@semio-tech/flow-extension-brep-rust",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/✏️s/🔌️plugins/🌊️flow/🧩️extensions/📐️brep/**/*.rs",
      "{projectRoot}/**/*",
      "{workspaceRoot}/✏️s/🔌️plugins/🌊️flow/🧩️extensions/📐️brep/**/🧫️fixtures/**/*"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🌊️flow/🧩️extensions/📐️brep/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🌊️flow/🧩️extensions/📐️brep/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts package",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{workspaceRoot}/✏️s/🔌️plugins/🌊️flow/🧩️extensions/📐️brep/🧩️component/📦️packages/🦀️rust/dist/flow-extension-brep.sxt"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🏪️store/**/*.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/**/*.ts"
      ]
    },
    "canonical-architecture": {
      "metadata": {
        "semio": {
          "dashboard": {
            "parameters": [
              {
                "id": "oracle-only",
                "kind": "flag",
                "args": [
                  "--oracle-only"
                ]
              }
            ]
          }
        }
      },
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts canonical-architecture",
        "cwd": "{projectRoot}"
      },
      "outputs": []
    },
    "test-mesh-oracle": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun ./📜️script.ts test-mesh-oracle",
        "forwardAllArgs": false
      },
      "outputs": []
    }
  }
}
