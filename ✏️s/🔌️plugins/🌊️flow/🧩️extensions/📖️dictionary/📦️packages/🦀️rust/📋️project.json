{
  "name": "@semio-tech/flow-extension-dictionary-rust",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/✏️s/🔌️plugins/🌊️flow/🧩️extensions/📖️dictionary/**/*.rs",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🌊️flow/🧩️extensions/📖️dictionary/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🌊️flow/🧩️extensions/📖️dictionary/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts package",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{workspaceRoot}/✏️s/🔌️plugins/🌊️flow/🧩️extensions/📖️dictionary/🧩️component/📦️packages/🦀️rust/dist/flow-extension-dictionary.sxt"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🏪️store/**/*.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/**/*.ts"
      ]
    }
  }
}
