{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/dag/dag/mutation/connect-nodes/schema.json",
  "title": "ConnectNodes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "target",
    "routeStyle",
    "properties"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "routeStyle": {
      "type": "string",
      "enum": [
        "bezier",
        "sharpSz"
      ]
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
