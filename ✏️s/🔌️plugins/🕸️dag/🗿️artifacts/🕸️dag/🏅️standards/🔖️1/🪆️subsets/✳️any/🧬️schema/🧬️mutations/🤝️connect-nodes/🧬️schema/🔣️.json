{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/dag/dag/mutation/connect-nodes/schema.json",
  "title": "ConnectNodes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "source",
    "target",
    "routeStyle",
    "properties"
  ],
  "properties": {
    "mutation": {
      "const": "connectNodes"
    },
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Source Node",
          "de": "Quellknoten"
        },
        "description": {
          "en": "The node the edge starts at.",
          "de": "Der Knoten, an dem die Kante beginnt."
        },
        "ref": {
          "kind": "node",
          "domain": "graph",
          "granularity": "node"
        }
      }
    },
    "target": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Target Node",
          "de": "Zielknoten"
        },
        "description": {
          "en": "The node the edge ends at.",
          "de": "Der Knoten, an dem die Kante endet."
        },
        "ref": {
          "kind": "node",
          "domain": "graph",
          "granularity": "node"
        }
      }
    },
    "routeStyle": {
      "type": "string",
      "enum": [
        "bezier",
        "sharpSz"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Route Style",
          "de": "Linienführung"
        },
        "options": {
          "bezier": {
            "en": "Bézier Curve",
            "de": "Bézierkurve"
          },
          "sharpSz": {
            "en": "Orthogonal S/Z",
            "de": "Orthogonales S/Z"
          }
        }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "description": "Roster position to insert at; absent appends. Inverses restore exact order with it."
    }
  }
}
