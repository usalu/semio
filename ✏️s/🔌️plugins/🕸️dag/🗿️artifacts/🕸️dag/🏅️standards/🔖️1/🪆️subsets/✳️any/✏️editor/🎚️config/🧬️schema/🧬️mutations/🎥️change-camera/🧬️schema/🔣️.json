{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/dag/dag/config/mutation/change-camera/schema.json",
  "title": "ChangeCamera",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "x",
    "y",
    "zoom"
  ],
  "properties": {
    "x": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Pan X",
          "de": "Verschiebung X"
        },
        "description": {
          "en": "Horizontal pan offset of the view.",
          "de": "Horizontale Verschiebung der Ansicht."
        },
        "step": 1,
        "precision": 1
      }
    },
    "y": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Pan Y",
          "de": "Verschiebung Y"
        },
        "description": {
          "en": "Vertical pan offset of the view.",
          "de": "Vertikale Verschiebung der Ansicht."
        },
        "step": 1,
        "precision": 1
      }
    },
    "zoom": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Zoom",
          "de": "Zoom"
        },
        "description": {
          "en": "Zoom factor of the view.",
          "de": "Zoomfaktor der Ansicht."
        },
        "step": 0.05,
        "precision": 2,
        "softMin": 0.1,
        "softMax": 8,
        "scale": "log",
        "snaps": [
          0.25,
          0.5,
          1,
          2,
          4
        ]
      }
    }
  }
}
