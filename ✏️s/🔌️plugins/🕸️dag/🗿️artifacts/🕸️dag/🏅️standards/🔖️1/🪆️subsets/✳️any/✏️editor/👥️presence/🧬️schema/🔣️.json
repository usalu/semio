  "$id": "https://semio.tech/schema/app/dag/dag/presence/schema.json",
  "title": "DagPresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cameraX",
    "cameraY",
    "cameraZoom"
  ],
  "properties": {
    "cameraX": {
      "type": "number",
      "x-semio-state": "presence"
    },
    "cameraY": {
      "type": "number",
      "x-semio-state": "presence"
    },
    "cameraZoom": {
      "type": "number",
      "x-semio-state": "presence"
    }
  }
}
