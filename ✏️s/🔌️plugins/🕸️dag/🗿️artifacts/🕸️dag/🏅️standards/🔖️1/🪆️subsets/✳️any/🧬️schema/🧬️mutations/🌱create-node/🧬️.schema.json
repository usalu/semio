{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node"
  ],
  "properties": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "abbreviation": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "operatorKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "kind": {
          "type": "string",
          "enum": [
            "computation",
            "slider",
            "select",
            "screen",
            "note",
            "image",
            "preview",
            "action",
            "export",
            "cluster",
            "appInstance"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
