dialect grammar
grammar dag.op
extension dag
use family-graph
start mutation

mutation = op-line+
op-line = nodes-add | nodes-remove | nodes-move | nodes-patch | edges-add | edges-remove | edges-move | edges-patch | set-nodes | set-edges | set-snapshot
nodes-add = "nodes-add" "index" "=" INT node-block
nodes-remove = "nodes-remove" "id" "=" IDENT
nodes-move = "nodes-move" "id" "=" IDENT "to" "=" INT
nodes-patch = "nodes-patch" "id" "=" IDENT node-patch-block
edges-add = "edges-add" "index" "=" INT edge-block
edges-remove = "edges-remove" "id" "=" IDENT
edges-move = "edges-move" "id" "=" IDENT "to" "=" INT
edges-patch = "edges-patch" "id" "=" IDENT edge-patch-block
set-nodes = "set-nodes" nodes-table
set-edges = "set-edges" edges-table
set-snapshot = "set-snapshot" snapshot-block
node-block = "node" node-kind
node-patch-block = "patch" node-patch-fields
node-patch-fields = ("name" "=" TEXT)? ("x" "=" FLOAT)? ("y" "=" FLOAT)? ("width" "=" FLOAT)? ("height" "=" FLOAT)?
edge-block = "edge" "id" "=" IDENT "source" "=" wire-endpoint "target" "=" wire-endpoint route-style edge-props?
edge-patch-block = "patch" edge-patch-fields
edge-patch-fields = ("source" "=" wire-endpoint)? ("target" "=" wire-endpoint)?
document-block = "document" schema-line nodes-table edges-table
nodes-table = "nodes" node-table
edges-table = "edges" edge-table
schema-line = "schema=" IDENT
node-table = "[" node-columns "]" "{" node-row* "}"
edge-table = "[" edge-columns "]" "{" edge-row* "}"
node-columns = column+
edge-columns = column+
column = IDENT ":" IDENT
node-row = IDENT
edge-row = IDENT TEXT TEXT route-style edge-props?
route-style = IDENT
edge-props = "{" edge-field* "}"
edge-field = "weight" "=" (FLOAT | INT) | "kind" "=" (TEXT | IDENT) | "label" "=" TEXT | "id" "=" IDENT
chain = wire-endpoint {ARROW wire-endpoint}+ | wire-endpoint {DASHARROW wire-endpoint}+
