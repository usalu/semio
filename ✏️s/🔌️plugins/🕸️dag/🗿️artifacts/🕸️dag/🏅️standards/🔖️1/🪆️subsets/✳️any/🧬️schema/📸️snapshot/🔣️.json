{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/dag/dag/snapshot.json",
  "title": "DagSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/dag/dag/artifact.json#/$defs/DagNodeSpec"
      },
      "x-semio-state": "artifact"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/dag/dag/artifact.json#/$defs/DagFixtureEdge"
      },
      "x-semio-state": "artifact"
    }
  }
}
