{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/dag/dag/presence/mutation/replace-presence/schema.json",
  "title": "ReplacePresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "presence"
  ],
  "properties": {
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cameraX",
        "cameraY",
        "cameraZoom"
      ],
      "properties": {
        "cameraX": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Camera X",
              "de": "Kamera X"
            },
            "description": {
              "en": "Horizontal centre of the view.",
              "de": "Horizontaler Mittelpunkt der Ansicht."
            },
            "step": 1,
            "precision": 2
          }
        },
        "cameraY": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Camera Y",
              "de": "Kamera Y"
            },
            "description": {
              "en": "Vertical centre of the view.",
              "de": "Vertikaler Mittelpunkt der Ansicht."
            },
            "step": 1,
            "precision": 2
          }
        },
        "cameraZoom": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Camera Zoom",
              "de": "Kamerazoom"
            },
            "description": {
              "en": "Magnification of the view; 1 is actual size.",
              "de": "Vergrößerung der Ansicht; 1 ist Originalgröße."
            },
            "step": 0.1,
            "precision": 2
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Presence",
          "de": "Präsenz"
        },
        "description": {
          "en": "Camera this participant shares with others.",
          "de": "Kamera, die diese Person mit anderen teilt."
        }
      }
    }
  }
}
