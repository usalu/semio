{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cameraX",
        "cameraY",
        "cameraZoom",
        "locale"
      ],
      "properties": {
        "cameraX": {
          "type": "number"
        },
        "cameraY": {
          "type": "number"
        },
        "cameraZoom": {
          "type": "number"
        },
        "locale": {
          "type": "string"
        }
      }
    }
  }
}
