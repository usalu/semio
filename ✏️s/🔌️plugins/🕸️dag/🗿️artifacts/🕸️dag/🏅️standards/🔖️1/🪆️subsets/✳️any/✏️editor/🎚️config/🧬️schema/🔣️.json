{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/dag/dag/config/schema.json",
  "title": "DagConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cameraX",
    "cameraY",
    "cameraZoom",
    "locale"
  ],
  "properties": {
    "cameraX": {
      "type": "number",
      "x-semio-state": "config"
    },
    "cameraY": {
      "type": "number",
      "x-semio-state": "config"
    },
    "cameraZoom": {
      "type": "number",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  }
}
