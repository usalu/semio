{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/dag/dag/diff.json",
  "title": "DagDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "title": "DagArtifact",
      "type": "object",
      "x-semio-state": "artifact"
    },
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "nodes": {
      "$ref": "#/$defs/DagNodesDelta",
      "x-semio-state": "artifact"
    },
    "edges": {
      "$ref": "#/$defs/DagEdgesDelta",
      "x-semio-state": "artifact"
    },
    "setNodes": {
      "$ref": "#/$defs/DagNodeSpecList",
      "x-semio-state": "artifact"
    },
    "setEdges": {
      "$ref": "#/$defs/DagFixtureEdgeList",
      "x-semio-state": "artifact"
    },
    "selectedNodeIds": {
      "$ref": "#/$defs/DagStringList",
      "x-semio-state": "presence"
    },
    "camera": {
      "$ref": "https://semio.tech/schema/s/dag/dag/artifact.json#/$defs/DagCamera",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "DagNodeSpecList": {
      "title": "DagNodeSpecList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/dag/dag/artifact.json#/$defs/DagNodeSpec"
          }
        }
      }
    },
    "DagFixtureEdgeList": {
      "title": "DagFixtureEdgeList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/dag/dag/artifact.json#/$defs/DagFixtureEdge"
          }
        }
      }
    },
    "DagStringList": {
      "title": "DagStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DagNodesDelta": {
      "title": "DagNodesDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/dag/dag/artifact.json#/$defs/DagNodeSpec"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DagNodePatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DagEdgesDelta": {
      "title": "DagEdgesDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/dag/dag/artifact.json#/$defs/DagFixtureEdge"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DagEdgePatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DagNodePatchEntry": {
      "title": "DagNodePatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/DagNodePatch"
        }
      }
    },
    "DagEdgePatchEntry": {
      "title": "DagEdgePatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/DagEdgePatch"
        }
      }
    },
    "DagNodePatch": {
      "title": "DagNodePatch",
      "type": "object",
      "additionalProperties": true
    },
    "DagEdgePatch": {
      "title": "DagEdgePatch",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    }
  }
}
