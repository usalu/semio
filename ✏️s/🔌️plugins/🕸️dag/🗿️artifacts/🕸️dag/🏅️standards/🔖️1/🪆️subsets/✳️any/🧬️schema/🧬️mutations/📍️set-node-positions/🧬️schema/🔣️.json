{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/dag/dag/mutation/set-node-positions/schema.json",
  "title": "SetNodePositions",
  "description": "The `set-node-positions` mutation record — absolute canvas positions of a set of nodes in one row: the exact undo of a `move-nodes` drag.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "positions"
  ],
  "properties": {
    "mutation": {
      "const": "setNodePositions"
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "x-semio-ui": {
              "widget": "reference",
              "role": "target",
              "label": {
                "en": "Node",
                "de": "Knoten"
              },
              "description": {
                "en": "The node placed at this position.",
                "de": "Der Knoten, der an dieser Position platziert wird."
              },
              "ref": {
                "kind": "node",
                "domain": "graph",
                "granularity": "node"
              },
              "order": 10
            }
          },
          "x": {
            "type": "number",
            "x-semio-ui": {
              "widget": "stepper",
              "role": "value",
              "label": {
                "en": "Position X",
                "de": "Position X"
              },
              "step": 1,
              "precision": 1,
              "order": 20
            }
          },
          "y": {
            "type": "number",
            "x-semio-ui": {
              "widget": "stepper",
              "role": "value",
              "label": {
                "en": "Position Y",
                "de": "Position Y"
              },
              "step": 1,
              "precision": 1,
              "order": 30
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Positions",
          "de": "Positionen"
        },
        "description": {
          "en": "One absolute canvas position per node; each node at most once.",
          "de": "Eine absolute Zeichenflächenposition pro Knoten; jeder Knoten höchstens einmal."
        },
        "group": "target",
        "order": 10
      }
    }
  },
  "x-semio-invariant": [
    {
      "id": "unique-node-ids",
      "description": {
        "en": "Every position names a different node.",
        "de": "Jede Position nennt einen anderen Knoten."
      }
    }
  ]
}
