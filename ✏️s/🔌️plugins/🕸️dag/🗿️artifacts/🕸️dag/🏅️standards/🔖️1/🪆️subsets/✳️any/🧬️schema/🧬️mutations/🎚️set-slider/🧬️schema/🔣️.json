{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/dag/dag/mutation/set-slider/schema.json",
  "title": "SetSlider",
  "description": "The `set-slider` mutation record — the absolute value, minimum or maximum one slider node holds after a scrub or an inspector edit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "field",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setSlider"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Slider",
          "de": "Schieberegler"
        },
        "description": {
          "en": "The slider node this mutation sets.",
          "de": "Der Schiebereglerknoten, den diese Mutation setzt."
        },
        "ref": {
          "kind": "node",
          "domain": "graph",
          "granularity": "node"
        },
        "group": "target",
        "order": 10
      }
    },
    "field": {
      "enum": [
        "value",
        "min",
        "max"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Field",
          "de": "Feld"
        },
        "description": {
          "en": "Which slider number this mutation sets.",
          "de": "Welche Zahl des Schiebereglers diese Mutation setzt."
        },
        "options": {
          "value": {
            "en": "Value",
            "de": "Wert"
          },
          "min": {
            "en": "Minimum",
            "de": "Minimum"
          },
          "max": {
            "en": "Maximum",
            "de": "Maximum"
          }
        },
        "group": "value",
        "order": 20
      }
    },
    "value": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Number",
          "de": "Zahl"
        },
        "description": {
          "en": "The number the field holds afterwards; a value outside the slider's range is clamped into it.",
          "de": "Die Zahl, die das Feld danach hält; ein Wert außerhalb des Bereichs des Schiebereglers wird darauf begrenzt."
        },
        "step": 0.1,
        "precision": 3,
        "group": "value",
        "order": 30
      }
    }
  }
}
