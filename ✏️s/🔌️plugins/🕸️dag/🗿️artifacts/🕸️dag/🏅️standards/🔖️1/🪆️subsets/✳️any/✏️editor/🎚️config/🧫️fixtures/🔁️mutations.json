[
  {
    "kind": "replace-config",
    "mutation": {
      "mutation": "replaceConfig",
      "payload": {
        "config": {
          "cameraX": 1.0,
          "cameraY": 2.0,
          "cameraZoom": 3.0,
          "locale": "de-DE"
        }
      }
    },
    "base": {
      "cameraX": 1.0,
      "cameraY": 2.0,
      "cameraZoom": 3.0,
      "locale": "en-US"
    },
    "after": {
      "cameraX": 1.0,
      "cameraY": 2.0,
      "cameraZoom": 3.0,
      "locale": "de-DE"
    }
  },
  {
    "kind": "change-camera",
    "mutation": {
      "mutation": "changeCamera",
      "payload": {
        "x": 9.0,
        "y": 8.0,
        "zoom": 7.0
      }
    },
    "base": {
      "cameraX": 1.0,
      "cameraY": 2.0,
      "cameraZoom": 3.0,
      "locale": "en-US"
    },
    "after": {
      "cameraX": 9.0,
      "cameraY": 8.0,
      "cameraZoom": 7.0,
      "locale": "en-US"
    }
  },
  {
    "kind": "change-locale",
    "mutation": {
      "mutation": "changeLocale",
      "payload": {
        "value": "de-DE"
      }
    },
    "base": {
      "cameraX": 1.0,
      "cameraY": 2.0,
      "cameraZoom": 3.0,
      "locale": "en-US"
    },
    "after": {
      "cameraX": 1.0,
      "cameraY": 2.0,
      "cameraZoom": 3.0,
      "locale": "de-DE"
    }
  }
]
