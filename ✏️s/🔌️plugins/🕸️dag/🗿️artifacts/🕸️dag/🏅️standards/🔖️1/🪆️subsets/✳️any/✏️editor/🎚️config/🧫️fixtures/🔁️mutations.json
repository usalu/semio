[
  {
    "kind": "replace-config",
    "mutation": {
      "mutation": "replaceConfig",
      "payload": {
        "config": {
          "cameraX": 1,
          "cameraY": 2,
          "cameraZoom": 3
        }
      }
    },
    "base": {
      "cameraX": 1,
      "cameraY": 2,
      "cameraZoom": 3
    },
    "after": {
      "cameraX": 1,
      "cameraY": 2,
      "cameraZoom": 3
    }
  },
  {
    "kind": "change-camera",
    "mutation": {
      "mutation": "changeCamera",
      "payload": {
        "x": 9,
        "y": 8,
        "zoom": 7
      }
    },
    "base": {
      "cameraX": 1,
      "cameraY": 2,
      "cameraZoom": 3
    },
    "after": {
      "cameraX": 9,
      "cameraY": 8,
      "cameraZoom": 7
    }
  }
]
