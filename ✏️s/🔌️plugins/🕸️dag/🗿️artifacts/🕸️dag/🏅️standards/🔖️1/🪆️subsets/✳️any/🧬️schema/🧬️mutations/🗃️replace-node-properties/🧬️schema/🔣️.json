{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/dag/dag/mutation/replace-node-properties/schema.json",
  "title": "ReplaceNodeProperties",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newProperties"
  ],
  "properties": {
    "mutation": {
      "const": "replaceNodeProperties"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The node to change.",
          "de": "Der zu ändernde Knoten."
        },
        "ref": {
          "kind": "node",
          "domain": "graph",
          "granularity": "node"
        }
      }
    },
    "newProperties": {
      "type": "object",
      "additionalProperties": true,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New Properties",
          "de": "Neue Eigenschaften"
        },
        "description": {
          "en": "Kind-specific fields of the node.",
          "de": "Artspezifische Felder des Knotens."
        }
      }
    }
  }
}
