{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/dag/dag/mutation/create-node/schema.json",
  "title": "CreateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "node"
  ],
  "properties": {
    "mutation": {
      "const": "createNode"
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "abbreviation": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Abbreviation",
              "de": "Abkürzung"
            },
            "description": {
              "en": "Short name shown on the node.",
              "de": "Auf dem Knoten angezeigter Kurzname."
            }
          }
        },
        "icon": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Icon",
              "de": "Symbol"
            },
            "description": {
              "en": "Icon id shown on the node.",
              "de": "Auf dem Knoten angezeigte Symbol-ID."
            }
          }
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "operatorKind": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Operator Kind",
              "de": "Operatorart"
            },
            "description": {
              "en": "Operator a computation node evaluates; empty for none.",
              "de": "Operator, den ein Berechnungsknoten auswertet; leer für keinen."
            }
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "kind": {
          "type": "string",
          "enum": [
            "computation",
            "slider",
            "select",
            "screen",
            "note",
            "image",
            "preview",
            "action",
            "export",
            "cluster",
            "appInstance"
          ],
          "x-semio-ui": {
            "widget": "select",
            "role": "value",
            "label": {
              "en": "Node Kind",
              "de": "Knotenart"
            },
            "options": {
              "computation": {
                "en": "Computation",
                "de": "Berechnung"
              },
              "slider": {
                "en": "Slider",
                "de": "Schieberegler"
              },
              "select": {
                "en": "Select",
                "de": "Auswahl"
              },
              "screen": {
                "en": "Screen",
                "de": "Bildschirm"
              },
              "note": {
                "en": "Note",
                "de": "Notiz"
              },
              "image": {
                "en": "Image",
                "de": "Bild"
              },
              "preview": {
                "en": "Preview",
                "de": "Vorschau"
              },
              "action": {
                "en": "Action",
                "de": "Aktion"
              },
              "export": {
                "en": "Export",
                "de": "Export"
              },
              "cluster": {
                "en": "Cluster",
                "de": "Cluster"
              },
              "appInstance": {
                "en": "App Instance",
                "de": "App-Instanz"
              }
            }
          }
        }
      },
      "additionalProperties": true,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The complete node record to add.",
          "de": "Der vollständige hinzuzufügende Knoten."
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "description": "Roster position to insert at; absent appends. Inverses restore exact order with it."
    }
  }
}
