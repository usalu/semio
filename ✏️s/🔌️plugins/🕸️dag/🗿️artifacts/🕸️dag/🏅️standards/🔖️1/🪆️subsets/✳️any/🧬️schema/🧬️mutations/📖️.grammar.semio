dialect grammar
grammar dag.mutation
extension dag
use family-graph
start mutation

mutation = op-line+
op-line = create-node | delete-node | rename-node | change-node-name | move-node | resize-node
        | change-node-icon | change-node-abbreviation | change-node-operator-kind
        | replace-node-kind | replace-node-properties | reorder-nodes | connect-nodes | disconnect-nodes

create-node = "create-node" "node" "=" JSON
delete-node = "delete-node" "id" "=" IDENT
rename-node = "rename-node" "id" "=" IDENT "new-id" "=" IDENT
change-node-name = "change-node-name" "id" "=" IDENT "new-name" "=" TEXT
move-node = "move-node" "id" "=" IDENT "x" "=" FLOAT "y" "=" FLOAT
resize-node = "resize-node" "id" "=" IDENT "width" "=" FLOAT "height" "=" FLOAT
change-node-icon = "change-node-icon" "id" "=" IDENT "new-icon" "=" TEXT
change-node-abbreviation = "change-node-abbreviation" "id" "=" IDENT "new-abbreviation" "=" TEXT
change-node-operator-kind = "change-node-operator-kind" "id" "=" IDENT ("new-operator-kind" "=" TEXT)?
replace-node-kind = "replace-node-kind" "id" "=" IDENT "new-kind" "=" JSON
replace-node-properties = "replace-node-properties" "id" "=" IDENT "new-properties" "=" JSON
reorder-nodes = "reorder-nodes" "order" "=" "[" IDENT* "]"
connect-nodes = "connect-nodes" "id" "=" IDENT "source" "=" wire-endpoint "target" "=" wire-endpoint route-style edge-props?
disconnect-nodes = "disconnect-nodes" "id" "=" IDENT

wire-endpoint = IDENT
route-style = IDENT
edge-props = "{" edge-field* "}"
edge-field = "weight" "=" (FLOAT | INT) | "kind" "=" (TEXT | IDENT) | "label" "=" TEXT | "id" "=" IDENT
