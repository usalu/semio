dialect grammar
grammar dag.diff
extension dag
use family-scene
start diff

artifact-mark = "dag.dag-diff"
diff = artifact-mark diff-body
diff-body = diff-line*
diff-line = document-replace | set-nodes-replace | set-edges-replace | nodes-collection | edges-collection
document-replace = "document" document-block
set-nodes-replace = "set-nodes" nodes-table
set-edges-replace = "set-edges" edges-table
nodes-collection = "nodes" collection-block
edges-collection = "edges" collection-block
document-block = schema-line nodes-table edges-table
nodes-table = "nodes" node-table
edges-table = "edges" edge-table
schema-line = "schema=" IDENT
node-table = "[" node-columns "]" "{" node-row* "}"
edge-table = "[" edge-columns "]" "{" edge-row* "}"
node-columns = column+
edge-columns = column+
column = IDENT ":" IDENT
node-row = IDENT
edge-row = IDENT TEXT TEXT route-style edge-props?
route-style = IDENT
edge-props = "{" edge-field* "}"
edge-field = "weight" "=" FLOAT | "weight" "=" INT | "kind" "=" TEXT | "kind" "=" IDENT | "label" "=" TEXT | "id" "=" IDENT
collection-block = "{" collection-line* "}"
collection-line = "added" node-table | "removed" id-list | "modified" patch-list
id-list = "[" IDENT* "]"
patch-list = "[" patch-entry* "]"
patch-entry = IDENT patch-block
patch-block = "{" patch-field* "}"
patch-field = "name" "=" TEXT | "x" "=" FLOAT | "y" "=" FLOAT | "source" "=" wire-endpoint | "target" "=" wire-endpoint
