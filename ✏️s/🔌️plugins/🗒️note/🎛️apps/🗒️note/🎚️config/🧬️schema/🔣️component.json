{
  "$id": "https://semio.tech/schema/app/note/note/config.json",
  "title": "NoteConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedBlockIds",
    "engagementInput",
    "camera",
    "activeUtilityId",
    "locale"
  ],
  "properties": {
    "selectedBlockIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "hoveredBlockId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "#/$defs/NoteCamera",
      "x-semio-state": "config"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "NoteCamera": {
      "title": "NoteCamera",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        }
      }
    }
  }
}
