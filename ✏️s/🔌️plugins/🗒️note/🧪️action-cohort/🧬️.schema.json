{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.note.action-cohort.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "source", "routeCount", "retainedRoutes", "frameworkOwnedRoutes", "groups", "globals", "scanThenMonolithRoutes", "blockedSeams", "materialization", "laws"],
  "properties": {
    "schema": { "const": "semio.note.action-cohort.v1" },
    "owner": { "const": "NotePlayApp" },
    "source": { "type": "string", "minLength": 1 },
    "routeCount": { "const": 36 },
    "retainedRoutes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "frameworkOwnedRoutes": { "type": "array", "maxItems": 0 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "lanes", "routes"],
        "properties": {
          "status": { "enum": ["Migrated", "BatchOnlyPendingRewrite"] },
          "lanes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["Artifact", "Config", "Draft", "Presence", "Transient", "Child", "HostOnly"] }
          },
          "routes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "blocker": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "BatchOnlyPendingRewrite" } } },
            "then": { "properties": { "blocker": { "type": "string", "minLength": 1 } }, "required": ["blocker"] },
            "else": { "properties": { "blocker": false } }
          }
        ]
      }
    },
    "globals": { "type": "array", "maxItems": 0 },
    "scanThenMonolithRoutes": { "type": "array", "maxItems": 0 },
    "blockedSeams": {
      "type": "array",
      "maxItems": 0,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stringChunkBytes", "typedTextOwnerPresent", "typedTextOwnerAbsent", "cancelDuringMetadataCopy", "nestedSnapshotRoot", "nestedBlockTree", "assetMapCursor", "linkedArtifactCursor", "progressPreview", "abandonmentTerminalEmptiness"],
      "properties": {
        "stringChunkBytes": { "const": 1024 },
        "typedTextOwnerPresent": { "const": true },
        "typedTextOwnerAbsent": { "const": true },
        "cancelDuringMetadataCopy": { "const": true },
        "nestedSnapshotRoot": { "const": true },
        "nestedBlockTree": { "const": true },
        "assetMapCursor": { "const": true },
        "linkedArtifactCursor": { "const": true },
        "progressPreview": { "const": true },
        "abandonmentTerminalEmptiness": { "const": true }
      }
    },
    "laws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationBeforeDecodeRejected", "exactCensus", "forgedProofRejected", "factoryRequiresContract", "exactArtifactScalarReducer", "gridSpacingInvariantPreserved", "artifactPreparationRejectsOtherMutations", "hostOnlyExclusive", "operationFreshness", "storeAuthorityOwnsDigest", "storeLaneRequiresPreparation", "terminalWitnessRequired"],
      "properties": {
        "activationBeforeDecodeRejected": { "const": true },
        "exactCensus": { "const": true },
        "forgedProofRejected": { "const": true },
        "factoryRequiresContract": { "const": true },
        "exactArtifactScalarReducer": { "const": true },
        "gridSpacingInvariantPreserved": { "const": true },
        "artifactPreparationRejectsOtherMutations": { "const": true },
        "hostOnlyExclusive": { "const": true },
        "operationFreshness": { "const": true },
        "storeAuthorityOwnsDigest": { "const": true },
        "storeLaneRequiresPreparation": { "const": true },
        "terminalWitnessRequired": { "const": true }
      }
    }
  }
}
