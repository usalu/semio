{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/note/note/config/schema.json",
  "title": "NoteConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engagementInput",
    "camera",
    "activeUtilityId"
  ],
  "properties": {
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "#/$defs/NoteCamera",
      "x-semio-state": "config"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "NoteCamera": {
      "title": "NoteCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        }
      }
    }
  }
}
