{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/note/note/snapshot.json",
  "title": "NoteSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "blocks",
    "assets"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/note/note/artifact.json#/$defs/NoteBlockNode"
      },
      "x-semio-state": "artifact"
    },
    "gridVisible": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "gridSpacing": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "gridSubdivisions": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "gridOpacity": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "snapEnabled": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "snapGridSpacing": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "pencilWidth": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "eraserRadius": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://semio.tech/schema/s/note/note/artifact.json#/$defs/NoteImageAsset"
      },
      "x-semio-state": "artifact"
    }
  }
}
