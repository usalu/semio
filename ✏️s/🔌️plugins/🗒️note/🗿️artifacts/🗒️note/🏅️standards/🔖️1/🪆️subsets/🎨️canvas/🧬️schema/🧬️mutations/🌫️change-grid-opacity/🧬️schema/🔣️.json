{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/note/note/1/canvas/mutation/change-grid-opacity/schema.json",
  "title": "ChangeGridOpacity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "changeGridOpacity"
    },
    "newOpacity": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Grid opacity",
          "de": "Rasterdeckkraft"
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "snaps": [
          0,
          0.25,
          0.5,
          0.75,
          1
        ],
        "group": "grid",
        "order": 10
      }
    }
  }
}
