{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/note/note/composite-window-diff.json",
  "title": "NoteCompositeWindowDiff",
  "$defs": {
    "NoteCompositeWindowConfigDiff": {
      "title": "NoteCompositeWindowConfigDiff",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "camera": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "zoom"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "format": "double"
                },
                "y": {
                  "type": "number",
                  "format": "double"
                },
                "zoom": {
                  "type": "number",
                  "format": "double"
                }
              }
            }
          ]
        }
      }
    },
    "NoteCompositeWindowTransientDiff": {
      "title": "NoteCompositeWindowTransientDiff",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "engagementInput": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "inkTool": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
