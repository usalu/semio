{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/note/note/1/block/mutation/duplicate-block/schema.json",
  "title": "DuplicateBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "sourceId",
    "block"
  ],
  "properties": {
    "mutation": {
      "const": "duplicateBlock"
    },
    "sourceId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Source block",
          "de": "Quellblock"
        },
        "description": {
          "en": "The block to copy.",
          "de": "Der zu kopierende Block."
        },
        "ref": {
          "kind": "block",
          "domain": "blocks",
          "granularity": "block"
        },
        "group": "target",
        "order": 10
      }
    },
    "block": {
      "$ref": "#/$defs/NoteBlockNode",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Block",
          "de": "Block"
        },
        "description": {
          "en": "The copy with its new id.",
          "de": "Die Kopie mit ihrer neuen ID."
        },
        "group": "record",
        "order": 20
      }
    }
  },
  "$defs": {
    "NoteBlockNode": {
      "title": "NoteBlockNode",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Kind",
              "de": "Art"
            },
            "description": {
              "en": "text, image, table, math, stroke or group.",
              "de": "text (Text), image (Bild), table (Tabelle), math (Formel), stroke (Strich) oder group (Gruppe)."
            },
            "group": "kind",
            "order": 10
          }
        }
      }
    }
  }
}
