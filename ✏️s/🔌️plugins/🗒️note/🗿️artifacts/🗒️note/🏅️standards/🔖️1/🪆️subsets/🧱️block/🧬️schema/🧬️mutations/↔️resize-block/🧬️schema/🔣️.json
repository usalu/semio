{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/note/note/1/block/mutation/resize-block/schema.json",
  "title": "ResizeBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newHeight",
    "newWidth"
  ],
  "properties": {
    "mutation": {
      "const": "resizeBlock"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Block",
          "de": "Block"
        },
        "description": {
          "en": "The block this mutation addresses.",
          "de": "Der Block, den diese Mutation adressiert."
        },
        "ref": {
          "kind": "block",
          "domain": "blocks",
          "granularity": "block"
        },
        "group": "target",
        "order": 10
      }
    },
    "newWidth": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Width",
          "de": "Breite"
        },
        "step": 1,
        "precision": 1,
        "snapSource": {
          "snapshot": "/snapGridSpacing"
        },
        "group": "size",
        "order": 20
      }
    },
    "newHeight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Height",
          "de": "Höhe"
        },
        "step": 1,
        "precision": 1,
        "snapSource": {
          "snapshot": "/snapGridSpacing"
        },
        "group": "size",
        "order": 30
      }
    }
  }
}
