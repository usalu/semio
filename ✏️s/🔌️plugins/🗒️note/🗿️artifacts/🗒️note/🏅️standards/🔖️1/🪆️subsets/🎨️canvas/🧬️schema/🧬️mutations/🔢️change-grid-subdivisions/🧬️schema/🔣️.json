{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/note/note/1/canvas/mutation/change-grid-subdivisions/schema.json",
  "title": "ChangeGridSubdivisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "changeGridSubdivisions"
    },
    "newSubdivisions": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Grid subdivisions",
          "de": "Rasterunterteilungen"
        },
        "description": {
          "en": "Minor lines between two major grid lines.",
          "de": "Nebenlinien zwischen zwei Hauptrasterlinien."
        },
        "step": 1,
        "precision": 0,
        "softMin": 1,
        "softMax": 16,
        "group": "grid",
        "order": 10
      }
    }
  }
}
