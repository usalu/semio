{
  "$id": "https://semio.tech/schema/s/note/note/artifact.json",
  "title": "NoteArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "blocks",
    "assets",
    "selectedBlockIds",
    "activeUtilityId",
    "engagementInput",
    "cameraX",
    "cameraY",
    "cameraZoom",
    "locale"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NoteBlockNode"
      },
      "x-semio-state": "artifact"
    },
    "gridVisible": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "gridSpacing": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "gridSubdivisions": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "gridOpacity": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "snapEnabled": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "snapGridSpacing": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "pencilWidth": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "eraserRadius": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/NoteImageAsset"
      },
      "x-semio-state": "artifact"
    },
    "selectedBlockIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "cameraX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraZoom": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    },
    "hoveredBlockId": {
      "type": "string",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "NoteBlockNode": {
      "title": "NoteBlockNode",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        }
      }
    },
    "NoteImageAsset": {
      "title": "NoteImageAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "data"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
