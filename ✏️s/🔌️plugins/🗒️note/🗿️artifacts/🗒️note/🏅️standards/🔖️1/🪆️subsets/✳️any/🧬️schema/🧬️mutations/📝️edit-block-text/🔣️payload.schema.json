{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EditBlockText",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newParagraphs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "newParagraphs": {
      "type": "array",
      "items": {
        "title": "NoteTextParagraph",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runs"
        ],
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "title": "NoteTextRun",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "bold": {
                  "type": "boolean"
                },
                "italic": {
                  "type": "boolean"
                },
                "underline": {
                  "type": "boolean"
                },
                "link": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
