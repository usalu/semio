  "comparisonProfiles": [
    {
      "id": "semantic-note-dxf-ink-v1",
      "description": "note→DXF compared by the SET of Line entities' (start,end) coordinate pairs the Ink blocks produce. Layer name, group codes and entity order are writer freedom. Position/rotation/visibility/lock/width are NOT carried by this serializer and are out of this profile's scope by construction.",
      "tolerance": 1e-9,
      "arrays": "set",
      "ignoreKeys": [
        "layer",
        "unknownGroupCodes"
      ]
    },
    {
      "id": "semantic-note-svg-drawing-v1",
      "description": "note→SVG compared by each surviving (visible) block's kind, its <g transform=\"…\"> translate+rotate, and kind-specific content: Ink path d + stroke-width, Text joined value, Image mime+bytes when a referenced asset exists, Table/Math/Group outline width/height. Style ids, path command formatting and XML attribute order are writer freedom.",
      "tolerance": 1e-9,
      "ignoreKeys": [
        "styleId",
        "id"
      ]
    },
    {
      "id": "semantic-note-pdf-text-v1",
      "description": "note→PDF compared by the single page's extracted text stream (title + space-joined Text block runs, in document order) and page width/height. Object numbers, xref layout, compression and PDF producer metadata are writer freedom.",
      "ignoreKeys": [
        "objectNumber",
        "xrefOffset",
        "producer",
        "creationDate",
        "modificationDate",
        "documentId",
        "fileSize",
        "byteLength",
        "generation",
        "streamFilter",
        "streamLength"
      ]
    }
  ],
