{
  "name": "@semio-tech/note-note-rs",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:artifact",
    "family:note"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🗒️note/🗿️artifacts/🗒️note/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🗒️note/🗿️artifacts/🗒️note/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🗒️note/🗿️artifacts/🗒️note/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "dependsOn": [
        {
          "projects": [
            "@semio-tech/note-plugin"
          ],
          "target": "component-dev"
        }
      ]
    },
    "verify-note-empty-config-ownership": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/🗒️note/🗿️artifacts/🗒️note/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts verify note-empty-config-ownership",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "note-empty-config-ownership"
          ]
        }
      }
    },
    "verify-sqlite-snapshot-guest": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/🗒️note/🗿️artifacts/🗒️note/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts verify sqlite-snapshot-guest",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "note-sqlite-snapshot-guest"
          ]
        }
      },
      "dependsOn": [
        {
          "projects": [
            "@semio-tech/note-plugin"
          ],
          "target": "component-dev"
        }
      ]
    },
    "verify-snapshot-guest": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/🗒️note/🗿️artifacts/🗒️note/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts verify snapshot-guest",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "note-snapshot-guest"
          ]
        }
      },
      "dependsOn": [
        {
          "projects": [
            "@semio-tech/note-plugin"
          ],
          "target": "component-dev"
        }
      ]
    }
  }
}
