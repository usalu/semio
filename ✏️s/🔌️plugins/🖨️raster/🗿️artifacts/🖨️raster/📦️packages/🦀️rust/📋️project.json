{
  "name": "@semio-tech/raster-raster-rs",
  "$schema": "../../../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:artifact",
    "family:raster"
  ],
  "namedInputs": {
    "nativeSources": [
      "{workspaceRoot}/✏️s/🔌️plugins/🖨️raster/🗿️artifacts/🖨️raster/**/*.{ts,tsx,json,semio,wit,sql}",
      "{workspaceRoot}/✏️s/🔌️plugins/🖨️raster/🗿️artifacts/🖨️raster/🏅️standards/🔖️1/🪆️subsets/✳️any/🚪️io/🪶️sqlite/📸️snapshot/🧪️tests/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🖨️raster/🗿️artifacts/🖨️raster/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "repo:script",
      "options": {
        "cwd": "✏️s/🔌️plugins/🖨️raster/🗿️artifacts/🖨️raster/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "✏️s/🔌️plugins/🖨️raster/🗿️artifacts/🖨️raster/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-snapshot-sqlite": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🦀️.rs",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🖨️raster/🗿️artifacts/🖨️raster/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite"
      }
    },
    "test-snapshot-sqlite-source": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🦀️.rs",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🖨️raster/🗿️artifacts/🖨️raster/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite source"
      }
    },
    "test-snapshot-sqlite-native": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🦀️.rs",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🖨️raster/🗿️artifacts/🖨️raster/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite native"
      }
    }
  }
}
