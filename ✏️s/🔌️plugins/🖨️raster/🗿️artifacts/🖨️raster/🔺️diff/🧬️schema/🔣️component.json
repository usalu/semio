{
  "$id": "https://semio.tech/schema/s/raster/raster/diff.json",
  "title": "RasterDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "title": "RasterArtifact",
      "type": "object",
      "x-semio-state": "persistent"
    },
    "schema": {
      "type": "string",
      "x-semio-state": "persistent"
    },
    "id": {
      "type": "string",
      "x-semio-state": "persistent"
    },
    "title": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ],
      "x-semio-state": "persistent"
    },
    "layers": {
      "$ref": "#/$defs/RasterLayersDelta",
      "x-semio-state": "persistent"
    },
    "assets": {
      "$ref": "#/$defs/RasterAssetsDelta",
      "x-semio-state": "persistent"
    },
    "selectedIds": {
      "$ref": "#/$defs/RasterStringList",
      "x-semio-state": "shared-ui"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "brushSize": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "brushOpacity": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "compositeViewport": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/RasterViewportSize"
        }
      ],
      "x-semio-state": "local-ui"
    },
    "cameraX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "cameraY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "cameraZoom": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "hoveredId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ],
      "x-semio-state": "preview"
    }
  },
  "$defs": {
    "RasterImageAsset": {
      "title": "RasterImageAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "data"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "RasterLayerNode": {
      "title": "RasterLayerNode",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        }
      }
    },
    "RasterViewportSize": {
      "title": "RasterViewportSize",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "RasterStringList": {
      "title": "RasterStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RasterAssetsDelta": {
      "title": "RasterAssetsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/RasterImageAsset"
              }
            ]
          }
        }
      }
    },
    "RasterLayerPatch": {
      "title": "RasterLayerPatch",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "format": "float"
        },
        "blendMode": {
          "type": "string"
        },
        "transformX": {
          "type": "number",
          "format": "double"
        },
        "transformY": {
          "type": "number",
          "format": "double"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "adjustmentKind": {
          "type": "string"
        }
      }
    },
    "RasterLayerPatchEntry": {
      "title": "RasterLayerPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/RasterLayerPatch"
        }
      }
    },
    "RasterLayersDelta": {
      "title": "RasterLayersDelta",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RasterLayerNode"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RasterLayerPatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
