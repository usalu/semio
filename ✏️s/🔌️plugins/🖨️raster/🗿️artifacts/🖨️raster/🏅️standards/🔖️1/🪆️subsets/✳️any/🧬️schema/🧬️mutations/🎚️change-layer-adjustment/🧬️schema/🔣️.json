{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/raster/raster/mutation/change-layer-adjustment-kind/schema.json",
  "title": "ChangeLayerAdjustmentKind",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layerId",
    "newAdjustmentKind"
  ],
  "properties": {
    "mutation": {
      "const": "changeLayerAdjustmentKind"
    },
    "layerId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "description": {
          "en": "The layer this mutation addresses.",
          "de": "Die Ebene, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "layer",
          "domain": "layers",
          "granularity": "layer"
        },
        "group": "target",
        "order": 10
      }
    },
    "newAdjustmentKind": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Adjustment",
          "de": "Korrektur"
        },
        "description": {
          "en": "For example brightnessContrast, levels or curves.",
          "de": "Zum Beispiel brightnessContrast (Helligkeit/Kontrast), levels (Tonwerte) oder curves (Gradationskurven)."
        },
        "group": "adjustment",
        "order": 20
      }
    }
  }
}
