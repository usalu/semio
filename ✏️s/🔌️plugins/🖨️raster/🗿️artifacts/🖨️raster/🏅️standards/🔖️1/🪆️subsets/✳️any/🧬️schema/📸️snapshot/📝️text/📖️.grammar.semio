dialect grammar
grammar raster.document
extension raster
use family-scene
start document

# Real grammar for `RasterSnapshot::print_dsl`/`parse_dsl`: the derived spec-driven text of
# `RasterPackRecord` (📸️snapshot/🦀️.rs), the same record the pack encodes. Each layer is its
# first-party JSON text (a quoted string); each asset row carries its map key, the composed
# `s.stdio.semio@v1/image` child handle and that child's own pack bytes as base64 (`""` when the
# handle carries no materialization).
# Fields are space-separated `key=value` tokens in any order; an absent optional field is omitted.
artifact-mark = "semio raster.raster.dsl v1"
document = artifact-mark field*
field = {"schema" "=" TEXT} | {"id" "=" TEXT} | {"title" "=" TEXT} | {"layers" "=" "[" TEXT* "]"} | {"assets" "=" "[" asset-row* "]"}
asset-row = asset-field+
asset-field = {"key" "=" TEXT} | {"child" "=" child-handle} | {"content" "=" TEXT}
child-handle = {"child_id" "=" TEXT} {"target" "=" TEXT}
