{
  "$id": "https://semio.tech/schema/app/raster/raster/presence.json",
  "title": "RasterPresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brushSize",
    "brushOpacity",
    "camera",
    "activeUtilityId"
  ],
  "properties": {
    "brushSize": {
      "type": "number",
      "format": "double",
      "x-semio-state": "presence"
    },
    "brushOpacity": {
      "type": "number",
      "format": "double",
      "x-semio-state": "presence"
    },
    "camera": {
      "$ref": "#/$defs/RasterCamera",
      "x-semio-state": "presence"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "presence"
    }
  },
  "$defs": {
    "RasterCamera": {
      "title": "RasterCamera",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
