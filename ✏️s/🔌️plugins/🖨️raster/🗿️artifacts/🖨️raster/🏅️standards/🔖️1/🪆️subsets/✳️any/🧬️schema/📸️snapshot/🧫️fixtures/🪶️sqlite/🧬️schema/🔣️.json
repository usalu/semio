{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "transform",
    "mask",
    "child",
    "parameter",
    "float64Words",
    "float32Words",
    "depth",
    "intrinsicBytes",
    "cancelAfter",
    "mapCapacity"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "transform": {
      "$ref": "#/definitions/transform"
    },
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "linked",
        "invert",
        "width",
        "height",
        "imageKey",
        "transform"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "linked": {
          "type": "boolean"
        },
        "invert": {
          "type": "boolean"
        },
        "width": {
          "$ref": "#/definitions/u32"
        },
        "height": {
          "$ref": "#/definitions/u32"
        },
        "imageKey": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/definitions/transform"
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "childId",
        "target"
      ],
      "properties": {
        "childId": {
          "type": "string"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dialect",
            "artifactId"
          ],
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "dialect": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifactKind",
                "standard",
                "subset"
              ],
              "properties": {
                "artifactKind": {
                  "type": "string"
                },
                "standard": {
                  "type": "string"
                },
                "subset": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "parameter": {
      "$ref": "#/definitions/value"
    },
    "float64Words": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "float32Words": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}$"
      }
    },
    "depth": {
      "type": "integer",
      "const": 256
    },
    "intrinsicBytes": {
      "type": "integer",
      "const": 100000
    },
    "cancelAfter": {
      "type": "integer",
      "const": 65536
    },
    "mapCapacity": {
      "type": "integer",
      "const": 64
    }
  },
  "definitions": {
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "a",
        "b",
        "c",
        "d"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "a": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "c": {
          "type": "number"
        },
        "d": {
          "type": "number"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "signed"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "unsigned"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/definitions/value"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
