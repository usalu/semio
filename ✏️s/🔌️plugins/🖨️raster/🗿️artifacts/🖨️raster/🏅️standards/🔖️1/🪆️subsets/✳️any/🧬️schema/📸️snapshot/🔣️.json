{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/raster/raster/snapshot.json",
  "title": "RasterSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "layers"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "id": { "type": "string", "x-semio-state": "artifact" },
    "title": { "type": "string", "x-semio-state": "artifact" },
    "layers": {
      "type": "array",
      "items": { "$ref": "https://semio.tech/schema/s/raster/raster/artifact.json#/$defs/RasterLayerNode" },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": { "$ref": "https://semio.tech/schema/os/store/child.json" },
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.image"
    }
  }
}
