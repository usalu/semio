{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Move Layer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layerId",
    "targetRowId",
    "dropPosition"
  ],
  "properties": {
    "layerId": {
      "type": "string",
      "minLength": 1
    },
    "targetRowId": {
      "type": "string",
      "minLength": 1
    },
    "dropPosition": {
      "enum": [
        "before",
        "after",
        "inside"
      ]
    }
  }
}
