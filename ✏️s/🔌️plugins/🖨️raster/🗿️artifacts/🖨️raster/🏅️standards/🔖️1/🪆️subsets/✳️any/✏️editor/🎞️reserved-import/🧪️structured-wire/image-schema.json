{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cases",
    "errors"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "base64",
          "width",
          "height",
          "colorspace",
          "bitDepth",
          "rgba",
          "metadata"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "base64": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "colorspace": {
            "const": "rgba"
          },
          "bitDepth": {
            "const": 8
          },
          "rgba": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "metadata": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "text",
          "codec",
          "kind",
          "index",
          "byte"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "codec": {
            "const": "base64"
          },
          "kind": {
            "const": "invalidByte"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "byte": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
