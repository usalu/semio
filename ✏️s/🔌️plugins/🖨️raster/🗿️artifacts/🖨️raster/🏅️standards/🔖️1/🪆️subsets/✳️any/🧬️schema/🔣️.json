{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/raster/raster/artifact.json",
  "title": "RasterArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "layers",
    "assets"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RasterLayerNode"
      },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://semio.tech/schema/os/store/child.json"
      },
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.image"
    }
  },
  "$defs": {
    "RasterImageAsset": {
      "title": "RasterImageAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "data"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "RasterLayerNode": {
      "title": "RasterLayerNode",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "name", "visible", "opacity", "blendMode", "transform"],
          "properties": {
            "kind": { "const": "pixel" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "visible": { "type": "boolean" },
            "opacity": { "type": "number" },
            "blendMode": { "type": "string" },
            "transform": { "$ref": "#/$defs/RasterTransform" },
            "mask": { "$ref": "#/$defs/RasterLayerMask" },
            "width": { "type": "integer", "minimum": 0 },
            "height": { "type": "integer", "minimum": 0 },
            "imageKey": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "name", "visible", "opacity", "blendMode", "transform", "children"],
          "properties": {
            "kind": { "const": "group" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "visible": { "type": "boolean" },
            "opacity": { "type": "number" },
            "blendMode": { "type": "string" },
            "transform": { "$ref": "#/$defs/RasterTransform" },
            "mask": { "$ref": "#/$defs/RasterLayerMask" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/RasterLayerNode" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "name", "visible", "opacity", "blendMode", "transform", "adjustmentKind", "params"],
          "properties": {
            "kind": { "const": "adjustment" },
            "id": { "type": "string" },
            "name": { "type": "string" },
            "visible": { "type": "boolean" },
            "opacity": { "type": "number" },
            "blendMode": { "type": "string" },
            "transform": { "$ref": "#/$defs/RasterTransform" },
            "adjustmentKind": { "type": "string" },
            "params": {
              "type": "object",
              "additionalProperties": { "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/DslValue" }
            }
          }
        }
      ]
    },
    "RasterTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "scaleX", "scaleY", "rotation"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "rotation": { "type": "number" }
      }
    },
    "RasterLayerMask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "linked", "invert"],
      "properties": {
        "enabled": { "type": "boolean" },
        "linked": { "type": "boolean" },
        "invert": { "type": "boolean" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 }
      }
    },
    "RasterViewportSize": {
      "title": "RasterViewportSize",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
