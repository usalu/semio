{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/raster/raster/artifact.json",
  "title": "RasterArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "layers",
    "assets"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RasterLayerNode"
      },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child.json"
      },
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.image"
    }
  },
  "$defs": {
    "RasterImageAsset": {
      "title": "RasterImageAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "data"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "RasterLayerNode": {
      "title": "RasterLayerNode",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "name",
            "visible",
            "locked",
            "opacity",
            "blendMode",
            "transform"
          ],
          "properties": {
            "kind": {
              "const": "pixel"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            },
            "opacity": {
              "type": "number"
            },
            "blendMode": {
              "type": "string"
            },
            "transform": {
              "$ref": "#/$defs/RasterTransform"
            },
            "mask": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RasterLayerMask"
                },
                {
                  "type": "null"
                }
              ]
            },
            "width": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "height": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "imageKey": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "name",
            "visible",
            "locked",
            "opacity",
            "blendMode",
            "transform",
            "children"
          ],
          "properties": {
            "kind": {
              "const": "group"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            },
            "opacity": {
              "type": "number"
            },
            "blendMode": {
              "type": "string"
            },
            "transform": {
              "$ref": "#/$defs/RasterTransform"
            },
            "mask": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RasterLayerMask"
                },
                {
                  "type": "null"
                }
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RasterLayerNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "name",
            "visible",
            "locked",
            "opacity",
            "blendMode",
            "transform",
            "adjustmentKind",
            "params"
          ],
          "properties": {
            "kind": {
              "const": "adjustment"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "visible": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            },
            "opacity": {
              "type": "number"
            },
            "blendMode": {
              "type": "string"
            },
            "transform": {
              "$ref": "#/$defs/RasterTransform"
            },
            "adjustmentKind": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/DslValue"
              }
            }
          }
        }
      ]
    },
    "RasterTransform": {
      "type": "object",
      "description": "Full affine placement: [a,b,c,d,x,y], retaining shear and reflection without a TRS approximation.",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "a",
        "b",
        "c",
        "d"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "a": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "c": {
          "type": "number"
        },
        "d": {
          "type": "number"
        }
      }
    },
    "RasterLayerMask": {
      "type": "object",
      "additionalProperties": false,
      "description": "An absent imageKey is a constant reveal mask. Image coverage is sRGB luminance multiplied by alpha. A linked transform is relative to the layer center; an unlinked transform is relative to its parent.",
      "required": [
        "enabled",
        "linked",
        "invert",
        "transform"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "linked": {
          "type": "boolean"
        },
        "invert": {
          "type": "boolean"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 16384
        },
        "imageKey": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "transform": {
          "$ref": "#/$defs/RasterTransform"
        }
      }
    },
    "RasterViewportSize": {
      "title": "RasterViewportSize",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
