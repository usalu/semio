{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/raster/raster/mutation/change-layer-transform/schema.json",
  "title": "Change Layer Transform",
  "description": "Replaces the complete invertible affine transform of a pixel or group layer against its exact expected transform.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layerId",
    "expected",
    "transform"
  ],
  "properties": {
    "mutation": {
      "const": "changeLayerTransform"
    },
    "layerId": {
      "type": "string",
      "minLength": 1,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "description": {
          "en": "The layer this mutation addresses.",
          "de": "Die Ebene, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "layer",
          "domain": "layers",
          "granularity": "layer"
        },
        "group": "target",
        "order": 10
      }
    },
    "expected": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/raster/raster/artifact.json#/$defs/RasterTransform",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Expected placement",
          "de": "Erwartete Platzierung"
        },
        "description": {
          "en": "Value the layer must hold now; the edit is refused on a mismatch.",
          "de": "Wert, den die Ebene jetzt haben muss; sonst wird die Bearbeitung abgelehnt."
        },
        "group": "matrix",
        "order": 20
      }
    },
    "transform": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/raster/raster/artifact.json#/$defs/RasterTransform",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Placement",
          "de": "Platzierung"
        },
        "group": "matrix",
        "order": 30
      }
    }
  }
}
