{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/raster/raster/diff.json",
  "title": "RasterDiff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/raster/raster/artifact.json"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    },
    "schema": {
      "type": [
        "string",
        "null"
      ],
      "x-semio-state": "artifact"
    },
    "id": {
      "type": [
        "string",
        "null"
      ],
      "x-semio-state": "artifact"
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "x-semio-state": "artifact"
    },
    "layers": {
      "anyOf": [
        {
          "$ref": "#/$defs/RasterLayersDelta"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    },
    "assets": {
      "anyOf": [
        {
          "$ref": "#/$defs/RasterAssetsDelta"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    },
    "pixels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RasterPixelRegion"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "RasterAssetsDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/snapshot.json"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "RasterLayersDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed",
        "inserted",
        "moved",
        "modified"
      ],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RasterLayerRemoval"
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RasterLayerInsertion"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RasterLayerRelocation"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RasterLayerModification"
          }
        }
      }
    },
    "RasterLayerAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "parentId": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RasterLayerRemoval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "parentId": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RasterLayerInsertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "layer"
      ],
      "properties": {
        "parentId": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "layer": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/raster/raster/artifact.json#/$defs/RasterLayerNode"
        }
      }
    },
    "RasterLayerRelocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/RasterLayerAddress"
        },
        "to": {
          "$ref": "#/$defs/RasterLayerAddress"
        }
      }
    },
    "RasterLayerModification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/RasterLayerPatch"
        }
      }
    },
    "RasterLayerPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "visible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "opacity": {
          "type": [
            "number",
            "null"
          ]
        },
        "blendMode": {
          "type": [
            "string",
            "null"
          ]
        },
        "transformX": {
          "type": [
            "number",
            "null"
          ]
        },
        "transformY": {
          "type": [
            "number",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "adjustmentKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "maskContent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mask"
          ],
          "properties": {
            "mask": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "https://json.schemas.assets.semio-tech.com/s/raster/raster/artifact.json#/$defs/RasterLayerMask"
                }
              ]
            }
          }
        },
        "pixelContent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "imageKey",
            "width",
            "height"
          ],
          "properties": {
            "imageKey": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "width": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 16384
            }
          }
        },
        "transform": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/raster/raster/artifact.json#/$defs/RasterTransform"
        },
        "adjustmentParameters": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/RasterAdjustmentParameter"
          },
          "not": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "properties": {
                    "parameter": {
                      "const": "brightness"
                    }
                  }
                }
              },
              {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "properties": {
                    "parameter": {
                      "const": "contrast"
                    }
                  }
                }
              }
            ]
          }
        },
        "locked": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "transform",
              "transformX"
            ],
            "properties": {
              "transform": {
                "type": "object"
              },
              "transformX": {
                "type": "number"
              }
            }
          },
          {
            "required": [
              "transform",
              "transformY"
            ],
            "properties": {
              "transform": {
                "type": "object"
              },
              "transformY": {
                "type": "number"
              }
            }
          }
        ]
      }
    },
    "RasterAdjustmentParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter",
        "value"
      ],
      "properties": {
        "parameter": {
          "enum": [
            "brightness",
            "contrast"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "RasterPixelRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layerId",
        "target",
        "x",
        "y",
        "width",
        "height",
        "samples"
      ],
      "properties": {
        "layerId": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
