{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/raster/raster/mutation/add-layer-asset/schema.json",
  "title": "AddLayerAsset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "asset",
    "assetId"
  ],
  "properties": {
    "mutation": {
      "const": "addLayerAsset"
    },
    "assetId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Asset ID",
          "de": "Asset-ID"
        },
        "description": {
          "en": "Unique key the layers use to show this image.",
          "de": "Eindeutiger Schlüssel, mit dem Ebenen dieses Bild zeigen."
        },
        "group": "identity",
        "order": 10
      }
    },
    "asset": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/snapshot.json"
    }
  }
}
