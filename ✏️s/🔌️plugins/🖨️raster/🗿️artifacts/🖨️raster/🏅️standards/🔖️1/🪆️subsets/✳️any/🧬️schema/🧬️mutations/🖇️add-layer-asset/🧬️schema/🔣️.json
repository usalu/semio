{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/raster/raster/mutation/add-layer-asset/schema.json",
  "title": "AddLayerAsset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "asset",
    "assetId"
  ],
  "properties": {
    "mutation": {
      "const": "addLayerAsset"
    },
    "assetId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Asset ID",
          "de": "Asset-ID"
        },
        "description": {
          "en": "Unique key the layers use to show this image.",
          "de": "Eindeutiger Schlüssel, mit dem Ebenen dieses Bild zeigen."
        },
        "group": "identity",
        "order": 10
      }
    },
    "asset": {
      "title": "RasterImageAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "mime"
      ],
      "properties": {
        "mime": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Media type",
              "de": "Medientyp"
            },
            "description": {
              "en": "For example image/png.",
              "de": "Zum Beispiel image/png."
            },
            "group": "source",
            "order": 10
          }
        },
        "data": {
          "type": "string",
          "contentEncoding": "base64",
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Bytes",
              "de": "Bytes"
            },
            "description": {
              "en": "Image bytes, Base64-encoded.",
              "de": "Bildbytes, Base64-kodiert."
            },
            "group": "source",
            "order": 20,
            "widget": "multiline"
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Image",
          "de": "Bild"
        },
        "description": {
          "en": "The encoded image to store.",
          "de": "Das zu speichernde kodierte Bild."
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
