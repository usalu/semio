{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/raster/raster/mutation/create-layer/schema.json",
  "title": "CreateLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "layer"
  ],
  "properties": {
    "parentId": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "layer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Pixel"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Group"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Adjustment"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
