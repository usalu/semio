{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/raster/raster/config/schema.json",
  "title": "RasterConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brushSize",
    "brushOpacity",
    "camera",
    "brushColor",
    "brushHardness"
  ],
  "properties": {
    "brushSize": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "brushOpacity": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "compositeViewport": {
      "$ref": "#/$defs/RasterConfigViewportSize",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "#/$defs/RasterCamera",
      "x-semio-state": "config"
    },
    "brushColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "x-semio-state": "config"
    },
    "brushHardness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "RasterCamera": {
      "title": "RasterCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "RasterConfigViewportSize": {
      "title": "RasterConfigViewportSize",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
