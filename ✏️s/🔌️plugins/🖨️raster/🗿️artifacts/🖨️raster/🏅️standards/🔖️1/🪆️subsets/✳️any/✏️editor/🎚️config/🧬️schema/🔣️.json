{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/raster/raster/config/schema.json",
  "title": "RasterConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brushSize",
    "brushOpacity",
    "camera",
    "brushColor",
    "brushHardness",
    "paintTarget",
    "maskValue",
    "fillTolerance"
  ],
  "properties": {
    "brushSize": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "brushOpacity": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "compositeViewport": {
      "$ref": "#/$defs/RasterConfigViewportSize",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "#/$defs/RasterCamera",
      "x-semio-state": "config"
    },
    "brushColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "x-semio-state": "config"
    },
    "brushHardness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-state": "config"
    },
    "paintTarget": {
      "type": "string",
      "enum": [
        "pixels",
        "mask"
      ],
      "x-semio-state": "config"
    },
    "maskValue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-state": "config"
    },
    "fillTolerance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-state": "config"
    },
    "pixelSelection": {
      "$ref": "#/$defs/RasterPixelSelection",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "RasterCamera": {
      "title": "RasterCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "RasterConfigViewportSize": {
      "title": "RasterConfigViewportSize",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "RasterPixelSelection": {
      "title": "RasterPixelSelection",
      "description": "Completed coverage in intrinsic target coordinates. Absent means unrestricted; an empty spans array means no selected pixels. Image content revisions do not change completed coverage.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layerId",
        "target",
        "width",
        "height",
        "spans"
      ],
      "properties": {
        "layerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target": {
          "type": "string",
          "enum": [
            "pixels",
            "mask"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "spans": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "length",
              "coverage"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777215
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216
              },
              "coverage": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      }
    }
  }
}
