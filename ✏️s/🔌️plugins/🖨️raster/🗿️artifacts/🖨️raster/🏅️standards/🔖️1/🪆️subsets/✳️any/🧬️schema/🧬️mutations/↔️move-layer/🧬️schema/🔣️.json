{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/raster/raster/mutation/move-layer/schema.json",
  "title": "MoveLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layerId",
    "newX",
    "newY"
  ],
  "properties": {
    "mutation": {
      "const": "moveLayer"
    },
    "layerId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "description": {
          "en": "The layer this mutation addresses.",
          "de": "Die Ebene, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "layer",
          "domain": "layers",
          "granularity": "layer"
        },
        "group": "target",
        "order": 10
      }
    },
    "newX": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "X",
          "de": "X"
        },
        "unit": "px",
        "step": 1,
        "precision": 1,
        "group": "position",
        "order": 20
      }
    },
    "newY": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Y",
          "de": "Y"
        },
        "unit": "px",
        "step": 1,
        "precision": 1,
        "group": "position",
        "order": 30
      }
    }
  }
}
