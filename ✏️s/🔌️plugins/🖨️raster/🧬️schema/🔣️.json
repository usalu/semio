{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/raster/schema.json",
  "$defs": {
    "RasterPublicationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "closePageBytes",
        "owners",
        "laws"
      ],
      "properties": {
        "schema": {
          "const": "semio.raster.publication-authority.v1"
        },
        "closePageBytes": {
          "const": 16384
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "source",
              "groups"
            ],
            "properties": {
              "owner": {
                "enum": [
                  "RasterPlayApp"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "groups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "lanes",
                    "routes"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "migrated",
                        "batch-only-pending-rewrite"
                      ]
                    },
                    "lanes": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "artifact",
                          "config",
                          "draft",
                          "presence",
                          "transient",
                          "child",
                          "host-only"
                        ]
                      }
                    },
                    "routes": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "blocker": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "batch-only-pending-rewrite"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "blocker": {}
                        },
                        "required": [
                          "blocker"
                        ]
                      },
                      "else": {
                        "properties": {
                          "blocker": {}
                        },
                        "not": {
                          "required": [
                            "blocker"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "laws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activationBeforeDecode",
            "contractBijection",
            "hostOnlyExclusive",
            "storeAuthorityRequired",
            "operationOwnedCursor",
            "boundedProgress",
            "cancellation",
            "freshnessValidation",
            "exactOwnerReturn",
            "incrementalClose",
            "terminalEmpty"
          ],
          "properties": {
            "activationBeforeDecode": {
              "const": true
            },
            "contractBijection": {
              "const": true
            },
            "hostOnlyExclusive": {
              "const": true
            },
            "storeAuthorityRequired": {
              "const": true
            },
            "operationOwnedCursor": {
              "const": true
            },
            "boundedProgress": {
              "const": true
            },
            "cancellation": {
              "const": true
            },
            "freshnessValidation": {
              "const": true
            },
            "exactOwnerReturn": {
              "const": true
            },
            "incrementalClose": {
              "const": true
            },
            "terminalEmpty": {
              "const": true
            }
          }
        }
      },
      "title": "RasterPublicationAuthority",
      "description": "🖨️ The publication-authority census of the one Raster play app: its close-page byte budget, owner groups, lane/status vocabulary and the retained-command laws the app is measured against."
    }
  }
}
