{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/bim/model/mutation/mirror-elements/schema.json",
  "title": "MirrorElements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "ids",
    "line_start",
    "line_end"
  ],
  "x-semio-inverse-rows": {
    "fixed": 1,
    "perTarget": {
      "ids": 2
    }
  },
  "properties": {
    "mutation": {
      "const": "mirrorElements"
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Elements",
          "de": "Elemente"
        },
        "description": {
          "en": "Elements to act on; unknown ids refuse the whole call, openings are acted on with their host.",
          "de": "Zu bearbeitende Elemente; unbekannte Ids verweigern den ganzen Aufruf, Öffnungen werden mit ihrem Host bearbeitet."
        },
        "ref": {
          "kind": "element"
        },
        "group": "target",
        "order": 10
      }
    },
    "line_start": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/Point2",
      "x-semio-ui": {
        "widget": "record",
        "role": "value",
        "label": {
          "en": "Mirror line start (m)",
          "de": "Spiegellinie Anfang (m)"
        },
        "group": "line",
        "order": 20
      }
    },
    "line_end": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/Point2",
      "x-semio-ui": {
        "widget": "record",
        "role": "value",
        "label": {
          "en": "Mirror line end (m)",
          "de": "Spiegellinie Ende (m)"
        },
        "group": "line",
        "order": 30
      }
    },
    "prefix": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "identity",
        "label": {
          "en": "Id prefix",
          "de": "Id-Präfix"
        },
        "description": {
          "en": "When set, the mirror images are created as copies with ids minted from this prefix and the originals stay; when empty, the elements are mirrored where they stand.",
          "de": "Wenn gesetzt, werden die Spiegelbilder als Kopien mit Ids aus diesem Präfix angelegt und die Originale bleiben; wenn leer, werden die Elemente an Ort und Stelle gespiegelt."
        },
        "group": "identity",
        "order": 40
      }
    }
  }
}
