{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/bim/model/mutation/offset-wall/schema.json",
  "title": "OffsetWall",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "new_id",
    "distance"
  ],
  "properties": {
    "mutation": {
      "const": "offsetWall"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "new_id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "identity",
        "label": {
          "en": "New wall id",
          "de": "Id der neuen Wand"
        },
        "group": "identity",
        "order": 20
      }
    },
    "distance": {
      "type": "number",
      "x-semio-ui": {
        "widget": "number",
        "role": "value",
        "label": {
          "en": "Distance (m, left positive)",
          "de": "Abstand (m, links positiv)"
        },
        "group": "value",
        "order": 30
      }
    }
  }
}
