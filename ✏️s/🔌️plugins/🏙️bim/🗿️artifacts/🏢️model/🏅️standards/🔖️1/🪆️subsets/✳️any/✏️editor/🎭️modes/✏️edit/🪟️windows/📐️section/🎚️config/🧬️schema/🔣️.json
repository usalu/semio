{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/bim/model/section-window-config/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "startX",
    "startY",
    "endX",
    "endY",
    "depth",
    "framed",
    "viewport"
  ],
  "properties": {
    "startX": {
      "type": "number"
    },
    "startY": {
      "type": "number"
    },
    "endX": {
      "type": "number"
    },
    "endY": {
      "type": "number"
    },
    "depth": {
      "type": "number"
    },
    "framed": {
      "type": "boolean"
    },
    "viewport": {
      "$ref": "https://json.schemas.assets.semio-tech.com/framework/ui/viewport/2d"
    }
  }
}
