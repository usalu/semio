semio bim.model.dsl v1
schema="s.bim.model@1"
project {
  name="Family House" description="Detached single-family house with basement, two storeys and a pitched attic roof." author=semio organization=semio phase-names=[ Design Permit Construction ]
}
materials={
  m-brick={ name="Clay Block" category=masonry density=800 conductivity=0.14 specific-heat=1000
  color {
    r=0.7 g=0.35 b=0.25
  }
  } m-concrete={ name="Reinforced Concrete" category=concrete density=2400 conductivity=2.3 specific-heat=1000
  color {
    r=0.62 g=0.62 b=0.6
  }
  } m-glass={ name="Float Glass" category=glass density=2500 conductivity=1 specific-heat=750
  color {
    r=0.65 g=0.85 b=0.9
  }
  } m-insulation={ name="Mineral Wool" category=insulation density=40 conductivity=0.035 specific-heat=1030
  color {
    r=0.95 g=0.85 b=0.35
  }
  } m-membrane={ name="Bitumen Membrane" category=membrane density=1100 conductivity=0.17 specific-heat=1000
  color {
    r=0.15 g=0.15 b=0.15
  }
  } m-plaster={ name="Lime Gypsum Plaster" category=finish density=1400 conductivity=0.7 specific-heat=1000
  color {
    r=0.92 g=0.92 b=0.88
  }
  } m-screed={ name="Cement Screed" category=finish density=2000 conductivity=1.4 specific-heat=1000
  color {
    r=0.75 g=0.75 b=0.72
  }
  } m-steel={ name="Structural Steel" category=metal density=7850 conductivity=50 specific-heat=450
  color {
    r=0.55 g=0.58 b=0.62
  }
  } m-tile={ name="Clay Roof Tile" category=masonry density=1900 conductivity=1 specific-heat=900
  color {
    r=0.65 g=0.25 b=0.15
  }
  } m-timber={ name="Spruce Timber" category=wood density=450 conductivity=0.13 specific-heat=1600
  color {
    r=0.8 g=0.62 b=0.4
  }
  }
}
wall-types={
  wt-attic-34={ name="Attic Knee Wall 34"
  layers [material:TEXT thickness:NUM function:ENUM] {
    m-plaster 0.016 finish
    m-timber 0.1 structure
    m-insulation 0.2 insulation
    m-timber 0.024 finish
  }
  } wt-base-25={ name="Basement Bearing Wall 25"
  layers [material:TEXT thickness:NUM function:ENUM] {
