      "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/snapshot.json#/$defs/Restraints"
    },
    "StructuralSupport": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/snapshot.json#/$defs/StructuralSupport"
    },
    "LoadCase": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/snapshot.json#/$defs/LoadCase"
    },
    "StructuralLoad": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/snapshot.json#/$defs/StructuralLoad"
    }
  }
}
