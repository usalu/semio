  "$defs": {
    "OptionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DesignOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "name",
        "primary"
      ],
      "properties": {
        "group": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "boolean"
        }
      }
    },
    "Workset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "default_visible"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "default_visible": {
          "type": "boolean"
        }
      }
    },
    "ElementMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string"
        }
      }
    },
    "Restraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "rx",
        "ry",
        "rz"
      ],
      "properties": {
        "x": {
          "type": "boolean"
        },
        "y": {
          "type": "boolean"
        },
        "z": {
          "type": "boolean"
        },
        "rx": {
          "type": "boolean"
        },
        "ry": {
          "type": "boolean"
        },
        "rz": {
          "type": "boolean"
        }
      }
    },
    "StructuralSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "member",
        "location",
        "offset",
        "restraints"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "member": {
          "type": "string"
        },
        "location": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/StructuralLocation"
        },
        "offset": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/Point3"
        },
        "restraints": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/Restraints"
        }
      }
    },
    "LoadCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "factor"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "factor": {
          "type": "number"
        }
      }
    },
    "StructuralLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "load_case",
        "member",
        "location",
        "force",
        "moment"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "load_case": {
          "type": "string"
        },
        "member": {
          "type": "string"
        },
        "location": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/StructuralLocation"
        },
        "force": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/Point3"
        },
        "moment": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/Point3"
        }
      }
    },
    "StructuralLocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Point"
          ],
          "properties": {
            "Point": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/PointLocation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Line"
          ],
          "properties": {
            "Line": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/LineLocation"
            }
          }
        },
        {
          "const": "Area"
        }
      ]
    },
    "PointLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station"
      ],
      "properties": {
        "station": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "LineLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
