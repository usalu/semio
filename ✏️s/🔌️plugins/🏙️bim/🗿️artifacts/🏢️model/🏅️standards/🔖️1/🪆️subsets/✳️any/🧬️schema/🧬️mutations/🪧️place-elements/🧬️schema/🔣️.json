      "additionalProperties": {
        "$ref": "#/$defs/Placement"
      },
      "x-semio-ui": {
        "widget": "record",
        "role": "value",
        "label": {
          "en": "Placements",
          "de": "Platzierungen"
        },
        "description": {
          "en": "Element id to its absolute placement fields.",
