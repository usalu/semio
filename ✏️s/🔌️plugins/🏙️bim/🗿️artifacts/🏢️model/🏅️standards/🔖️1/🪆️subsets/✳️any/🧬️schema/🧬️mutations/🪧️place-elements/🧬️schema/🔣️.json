{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/bim/model/mutation/place-elements/schema.json",
  "title": "PlaceElements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "placements"
  ],
