              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/Point2"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Space"
          ],
          "properties": {
            "Space": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "boundary"
              ],
              "properties": {
                "boundary": {
                  "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/SpaceBoundary"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Grid"
          ],
          "properties": {
            "Grid": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/Point2"
