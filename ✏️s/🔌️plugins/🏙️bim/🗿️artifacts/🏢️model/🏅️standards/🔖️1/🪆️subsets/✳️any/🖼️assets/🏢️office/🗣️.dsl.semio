    x=12 y=14
  }
  }
}
storeys={
  st-0={ building=bldg-1 name="Ground Floor" level=0 height=4 } st-1={ building=bldg-1 name="First Floor" level=1 height=3.8 } st-2={ building=bldg-1 name="Second Floor" level=2 height=3.8 } st-3={ building=bldg-1 name="Third Floor" level=3 height=3.8 } st-r={ building=bldg-1 name=Roof level=4 height=1.2 }
