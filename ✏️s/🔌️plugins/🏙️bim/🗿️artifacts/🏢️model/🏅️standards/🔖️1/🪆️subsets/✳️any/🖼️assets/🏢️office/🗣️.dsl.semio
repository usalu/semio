semio bim.model.dsl v1
schema="s.bim.model@1"
project {
  name="Office Building" description="Four-storey office building on a six metre structural grid with two escape stair cores and a curtain wall façade." author=semio organization=semio phase-names=[ Design Permit Construction ]
}
materials={
  m-ceramic={ name="Ceramic Tile" category=finish density=2000 conductivity=1 specific-heat=840
  color {
    r=0.88 g=0.88 b=0.85
  }
  } m-concrete={ name="Reinforced Concrete" category=concrete density=2400 conductivity=2.3 specific-heat=1000
  color {
    r=0.62 g=0.62 b=0.6
  }
  } m-glass={ name="Float Glass" category=glass density=2500 conductivity=1 specific-heat=750
  color {
    r=0.65 g=0.85 b=0.9
  }
  } m-gravel={ name="Ballast Gravel" category=other density=1800 conductivity=0.7 specific-heat=840
  color {
    r=0.6 g=0.58 b=0.55
  }
  } m-insulation={ name="Mineral Wool" category=insulation density=40 conductivity=0.035 specific-heat=1030
  color {
    r=0.95 g=0.85 b=0.35
  }
  } m-membrane={ name="Bitumen Membrane" category=membrane density=1100 conductivity=0.17 specific-heat=1000
  color {
    r=0.15 g=0.15 b=0.15
  }
  } m-oak={ name="Oak Parquet" category=finish density=700 conductivity=0.17 specific-heat=1600
  color {
    r=0.62 g=0.45 b=0.28
  }
  } m-paint={ name="Interior Paint" category=finish density=1300 conductivity=0.8 specific-heat=1000
  color {
    r=0.96 g=0.95 b=0.92
  }
  } m-plaster={ name="Lime Gypsum Plaster" category=finish density=1400 conductivity=0.7 specific-heat=1000
  color {
    r=0.92 g=0.92 b=0.88
  }
  } m-screed={ name="Cement Screed" category=finish density=2000 conductivity=1.4 specific-heat=1000
  color {
    r=0.75 g=0.75 b=0.72
  }
  } m-steel={ name="Structural Steel" category=metal density=7850 conductivity=50 specific-heat=450
  color {
    r=0.55 g=0.58 b=0.62
  }
  }
}
wall-types={
  wt-core-25={ name="Core Wall 25"
  layers [material:TEXT thickness:NUM function:ENUM] {
    m-concrete 0.25 structure
  }
  } wt-infill-34={ name="Infill Wall 34"
  layers [material:TEXT thickness:NUM function:ENUM] {
    m-plaster 0.015 finish
    m-concrete 0.15 structure
    m-insulation 0.16 insulation
    m-plaster 0.015 finish
  }
  } wt-parapet-25={ name="Parapet 25"
  layers [material:TEXT thickness:NUM function:ENUM] {
    m-concrete 0.19 structure
    m-insulation 0.06 insulation
  }
  }
}
slab-types={
  sl-floor={ name="Office Floor 36"
  layers [material:TEXT thickness:NUM function:ENUM] {
    m-screed 0.08 finish
    m-concrete 0.28 structure
  }
  } sl-ground={ name="Ground Slab 56"
  layers [material:TEXT thickness:NUM function:ENUM] {
    m-screed 0.07 finish
    m-insulation 0.14 insulation
    m-concrete 0.35 structure
  }
  }
}
roof-types={
  rt-flat={ name="Flat Roof 55"
  layers [material:TEXT thickness:NUM function:ENUM] {
    m-gravel 0.05 finish
    m-membrane 0.01 membrane
    m-insulation 0.24 insulation
    m-concrete 0.25 structure
  }
  }
}
column-types={
  ct-rc-400={ name="RC Column 400" material=m-concrete
  profile {
    rectangle width=0.4 depth=0.4
  }
  } ct-rc-500={ name="RC Column 500" material=m-concrete
  profile {
    rectangle width=0.5 depth=0.5
  }
  }
}
beam-types={
  bt-hea-300={ name="HEA 300 (profile family)" material=m-steel
  profile {
    family family=fam-hea-300
  }
  } bt-rc-primary={ name="RC Beam 400x600" material=m-concrete
  profile {
    rectangle width=0.4 depth=0.6
  }
  } bt-rc-secondary={ name="RC Beam 300x500" material=m-concrete
  profile {
    rectangle width=0.3 depth=0.5
  }
  }
}
window-types={
  wn-ribbon={ name="Ribbon Window" width=3 height=1.6 sill=0.85 frame-width=0.07 frame-depth=0.08 panes=3 material=m-steel u-value=1.3 g-value=0.45 frame-fraction=0.2 }
}
door-types={
  dr-core={ name="Fire Door" width=0.9 height=2.1 frame-width=0.07 frame-depth=0.08 leaves=single swing=left material=m-steel u-value=1.8 } dr-glass={ name="Glass Entrance Door" width=1.8 height=2.4 frame-width=0.07 frame-depth=0.08 leaves=double swing=left material=m-steel u-value=1.4 }
}
curtain-wall-types={
  cwt-facade={ name="Curtain wall 1.5 x 1.3" panel-material=m-glass mullion-material=m-steel
  u-grid {
    spacing spacing=1.5
  }
  v-grid {
    spacing spacing=1.3
  }
  interior-mullion {
    rectangle width=0.05 depth=0.15
  }
  border-mullion {
    rectangle width=0.05 depth=0.15
  }
  panel {
    glass
  }
  }
}
sites={
  site-1={ name="Plot Zurich" latitude=47.391 longitude=8.488 elevation=408 true-north=0.12
  boundary [x:NUM y:NUM] {
    0 0
    56 0
    56 48
    0 48
  }
  }
}
