{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/bim/model/mutation/rotate-elements/schema.json",
  "title": "RotateElements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "ids",
    "pivot",
    "angle"
  ],
  "properties": {
    "mutation": {
      "const": "rotateElements"
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Elements",
          "de": "Elemente"
        },
        "description": {
          "en": "Elements to act on; unknown ids refuse the whole call.",
          "de": "Zu bearbeitende Elemente; unbekannte Ids verweigern den ganzen Aufruf."
        },
        "ref": {
          "kind": "element"
        },
        "group": "target",
        "order": 10
      }
    },
    "pivot": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/bim/model/artifact.json#/$defs/Point2",
      "x-semio-ui": {
        "widget": "record",
        "role": "value",
        "label": {
          "en": "Pivot (m)",
          "de": "Drehpunkt (m)"
        },
        "group": "rotation",
        "order": 20
      }
    },
    "angle": {
      "type": "number",
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "Angle",
          "de": "Winkel"
        },
        "description": {
          "en": "Counter-clockwise rotation about the pivot.",
          "de": "Drehung gegen den Uhrzeigersinn um den Drehpunkt."
        },
        "unit": "rad",
        "displayUnit": "deg",
        "displayFactor": 57.29577951308232,
        "step": 0.017453292519943295,
        "precision": 4,
        "softMin": -3.141592653589793,
        "softMax": 3.141592653589793,
        "snaps": [
          -3.141592653589793,
          -1.5707963267948966,
          0,
          1.5707963267948966,
          3.141592653589793
        ],
        "group": "rotation",
        "order": 30
      }
    }
  }
}
