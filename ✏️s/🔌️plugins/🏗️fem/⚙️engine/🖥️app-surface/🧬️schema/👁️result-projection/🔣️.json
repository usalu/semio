{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.semio-tech.com/fem/result-projection",
  "title": "FEM Result Projection Laws",
  "description": "Static views project displacements, modal views project normalized eigenvectors with sqrt(lambda)/(2*pi) in Hz, and buckling views project normalized eigenvectors with lambda as the reference-load multiplier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "mode", "index", "eigenvalue", "modeShape", "displayValue"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["static", "modal", "buckling"] },
          "index": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "eigenvalue": { "type": "number" },
          "modeShape": { "type": "boolean" },
          "displayValue": { "type": ["number", "null"] }
        }
      }
    }
  }
}
