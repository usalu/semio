{
  "$id": "https://semio.tech/schema/app/fem/3d/config.json",
  "title": "Fem3dConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resultMode",
    "resultModeIndex",
    "camera"
  ],
  "properties": {
    "resultSourceId": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "resultMode": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "resultModeIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "local-ui"
    },
    "camera": {
      "$ref": "#/$defs/FemCamera",
      "x-semio-state": "local-ui"
    }
  },
  "$defs": {
    "FemCamera": {
      "title": "FemCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json"
      ],
      "properties": {
        "json": {
          "type": "string",
          "contentMediaType": "application/json"
        }
      }
    }
  }
}
