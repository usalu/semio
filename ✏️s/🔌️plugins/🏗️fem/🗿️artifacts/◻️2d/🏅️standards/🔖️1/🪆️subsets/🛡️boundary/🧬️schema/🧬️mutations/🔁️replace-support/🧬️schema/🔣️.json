{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/2d/1/boundary/mutation/replace-support/schema.json",
  "title": "ReplaceSupport",
  "description": "The `replace-support` mutation payload as it travels the wire: internally tagged with `\"mutation\": \"replaceSupport\"`, camelCase throughout. Its hard bounds and `x-semio-invariant` entries state exactly the payload-intrinsic breaches `mutations::guards` refuses as `mutation.invariant`, so every such payload fails this schema; refusals that depend on the base (a missing, duplicate or still-referenced target) belong to the diff alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newSupport"
  ],
  "properties": {
    "mutation": {
      "const": "replaceSupport",
      "description": "The internally tagged discriminator `#[value(tag = \"mutation\")]` puts on the wire.",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Support",
          "de": "Lager"
        },
        "ref": {
          "kind": "support",
          "domain": "fem2d",
          "granularity": "support"
        },
        "group": "target",
        "order": 20
      }
    },
    "newSupport": {
      "title": "FemSupport",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "fixed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "nodeId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Node",
              "de": "Knoten"
            },
            "ref": {
              "kind": "node",
              "domain": "fem2d",
              "granularity": "node"
            },
            "group": "target",
            "order": 20
          }
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Tx",
              "Ty",
              "Tz",
              "Rx",
              "Ry",
              "Rz"
            ],
            "x-semio-ui": {
              "options": {
                "Tx": {
                  "en": "Translation X",
                  "de": "Verschiebung x"
                },
                "Ty": {
                  "en": "Translation Y",
                  "de": "Verschiebung y"
                },
                "Tz": {
                  "en": "Translation Z",
                  "de": "Verschiebung z"
                },
                "Rx": {
                  "en": "Rotation about X",
                  "de": "Verdrehung um x"
                },
                "Ry": {
                  "en": "Rotation about Y",
                  "de": "Verdrehung um y"
                },
                "Rz": {
                  "en": "Rotation about Z",
                  "de": "Verdrehung um z"
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Fixed degrees of freedom",
              "de": "Gesperrte Freiheitsgrade"
            },
            "group": "record",
            "order": 30
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New support",
          "de": "Neues Lager"
        },
        "group": "record",
        "order": 30
      }
    }
  }
}
