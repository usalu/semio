{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/fem/fem2d/snapshot.json",
  "title": "Fem2dSnapshot",
  "description": "A fem2d structural document: eight id-keyed collections and one inseparable analysis-settings facet. Every record `$def` below carries the fields the Rust struct declares AND, where the vocabulary enforces one, the bound that makes the value admissible — annotated with the `mutations::guards` function that raises it, so a reader can get from the document invariant to the code that keeps it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes",
    "elements",
    "regions",
    "materials",
    "sections",
    "supports",
    "loadCases",
    "combinations",
    "analysis"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem2d/artifact.json#/$defs/FemNode"
      },
      "x-semio-state": "artifact"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem2d/artifact.json#/$defs/FemElement"
      },
      "x-semio-state": "artifact"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem2d/artifact.json#/$defs/FemRegion"
      },
      "x-semio-state": "artifact"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem2d/artifact.json#/$defs/FemMaterial"
      },
      "x-semio-state": "artifact"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem2d/artifact.json#/$defs/FemSection"
      },
      "x-semio-state": "artifact"
    },
    "supports": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem2d/artifact.json#/$defs/FemSupport"
      },
      "x-semio-state": "artifact"
    },
    "loadCases": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem2d/artifact.json#/$defs/FemLoadCase"
      },
      "x-semio-state": "artifact"
    },
    "combinations": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem2d/artifact.json#/$defs/FemCombination"
      },
      "x-semio-state": "artifact"
    },
    "analysis": {
      "$ref": "#/$defs/FemAnalysisSettings",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "FemAnalysisSettings": {
      "title": "FemAnalysisSettings",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modalCount",
        "bucklingCount",
        "deformationScale"
      ],
      "properties": {
        "modalCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "x-semio-invariant": "mutations::guards::analysis_bounds — at least one modal mode"
        },
        "bucklingCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "x-semio-invariant": "mutations::guards::analysis_bounds — at least one buckling mode"
        },
        "deformationScale": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-invariant": "mutations::guards::analysis_bounds — a positive deformation exaggeration"
        }
      }
    }
  }
}
