{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/fem2d/artifact.json",
  "title": "Fem2dArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes",
    "elements",
    "regions",
    "materials",
    "sections",
    "supports",
    "loadCases",
    "combinations",
    "analysis"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FemNode"
      },
      "x-semio-state": "artifact"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FemElement"
      },
      "x-semio-state": "artifact"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FemRegion"
      },
      "x-semio-state": "artifact"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FemMaterial"
      },
      "x-semio-state": "artifact"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FemSection"
      },
      "x-semio-state": "artifact"
    },
    "supports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FemSupport"
      },
      "x-semio-state": "artifact"
    },
    "loadCases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FemLoadCase"
      },
      "x-semio-state": "artifact"
    },
    "combinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FemCombination"
      },
      "x-semio-state": "artifact"
    },
    "analysis": {
      "$ref": "#/$defs/FemAnalysisSettings",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "FemAnalysisSettings": {
      "title": "FemAnalysisSettings",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modalCount",
        "bucklingCount",
        "deformationScale"
      ],
      "properties": {
        "modalCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bucklingCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deformationScale": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "FemNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "format": "double",
          "x-semio-invariant": [
            {
              "id": "node-coordinate-finite",
              "description": {
                "en": "A node coordinate is finite.",
                "de": "Eine Knotenkoordinate ist endlich."
              }
            }
          ]
        },
        "y": {
          "type": "number",
          "format": "double",
          "x-semio-invariant": [
            {
              "id": "node-coordinate-finite",
              "description": {
                "en": "A node coordinate is finite.",
                "de": "Eine Knotenkoordinate ist endlich."
              }
            }
          ]
        }
      },
      "title": "FemNode"
    },
    "FemElement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "start",
            "end",
            "materialId",
            "sectionId"
          ],
          "properties": {
            "kind": {
              "const": "bar"
            },
            "id": {
              "type": "string"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "materialId": {
              "type": "string"
            },
            "sectionId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "start",
            "end",
            "materialId",
            "sectionId"
          ],
          "properties": {
            "kind": {
              "const": "beam"
            },
            "id": {
              "type": "string"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "materialId": {
              "type": "string"
            },
            "sectionId": {
              "type": "string"
            }
          }
        }
      ],
      "title": "FemElement"
    },
    "FemRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "outline",
        "holes",
        "thickness",
        "materialId",
        "meshSize"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "x-semio-invariant": [
            {
              "id": "region-outline-encloses-area",
              "description": {
                "en": "The outline has at least three points and encloses a non-zero area.",
                "de": "Der Umriss hat mindestens drei Punkte und umschließt eine Fläche ungleich null."
              }
            }
          ]
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3
          },
          "x-semio-invariant": [
            {
              "id": "region-holes-inside-outline",
              "description": {
                "en": "Every hole is a real polygon lying inside the outline.",
                "de": "Jedes Loch ist ein echtes Polygon, das innerhalb des Umrisses liegt."
              }
            }
          ]
        },
        "thickness": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-invariant": [
            {
              "id": "region-thickness-positive",
              "description": {
                "en": "The thickness is positive.",
                "de": "Die Dicke ist positiv."
              }
            }
          ]
        },
        "materialId": {
          "type": "string"
        },
        "meshSize": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-invariant": [
            {
              "id": "region-mesh-size-positive",
              "description": {
                "en": "The mesh size is positive.",
                "de": "Die Netzgröße ist positiv."
              }
            }
          ]
        }
      },
      "title": "FemRegion"
    },
    "FemMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "e",
        "nu",
        "rho"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "e": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-invariant": [
            {
              "id": "material-youngs-modulus-positive",
              "description": {
                "en": "Young's modulus is positive.",
                "de": "Der Elastizitätsmodul ist positiv."
              }
            }
          ]
        },
        "nu": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 0.5,
          "x-semio-invariant": [
            {
              "id": "material-poisson-ratio-admissible",
              "description": {
                "en": "The Poisson ratio lies in the admissible open interval.",
                "de": "Die Querdehnzahl liegt im zulässigen offenen Intervall."
              }
            }
          ]
        },
        "rho": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-invariant": [
            {
              "id": "material-density-positive",
              "description": {
                "en": "The density is positive.",
                "de": "Die Dichte ist positiv."
              }
            }
          ]
        }
      },
      "title": "FemMaterial"
    },
    "FemSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "area",
        "iy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "area": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-invariant": [
            {
              "id": "section-area-positive",
              "description": {
                "en": "The section area is positive.",
                "de": "Die Querschnittsfläche ist positiv."
              }
            }
          ]
        },
        "iy": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-invariant": [
            {
              "id": "section-second-moment-positive",
              "description": {
                "en": "The second moment of area is positive.",
                "de": "Das Flächenträgheitsmoment ist positiv."
              }
            }
          ]
        }
      },
      "title": "FemSection"
    },
    "FemSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "fixed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Tx",
              "Ty",
              "Tz",
              "Rx",
              "Ry",
              "Rz"
            ]
          }
        }
      },
      "title": "FemSupport"
    },
    "FemLoadCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "loads",
        "selfWeight"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "loads": {
          "type": "array",
          "items": {
            "title": "FemLoad",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "nodeId",
                  "dof",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "nodal"
                  },
                  "id": {
                    "type": "string"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "dof": {
                    "type": "string",
                    "enum": [
                      "Tx",
                      "Ty",
                      "Tz",
                      "Rx",
                      "Ry",
                      "Rz"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "format": "double"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "elementId",
                  "wx",
                  "wy"
                ],
                "properties": {
                  "kind": {
                    "const": "memberUdl"
                  },
                  "id": {
                    "type": "string"
                  },
                  "elementId": {
                    "type": "string"
                  },
                  "wx": {
                    "type": "number",
                    "format": "double"
                  },
                  "wy": {
                    "type": "number",
                    "format": "double"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "regionId",
                  "pressure"
                ],
                "properties": {
                  "kind": {
                    "const": "area"
                  },
                  "id": {
                    "type": "string"
                  },
                  "regionId": {
                    "type": "string"
                  },
                  "pressure": {
                    "type": "number",
                    "format": "double"
                  }
                }
              }
            ]
          }
        },
        "selfWeight": {
          "type": "boolean"
        }
      },
      "title": "FemLoadCase"
    },
    "FemCombination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "terms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "terms": {
          "type": "array",
          "items": {
            "title": "FemCombinationTerm",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "caseId",
              "factor"
            ],
            "properties": {
              "caseId": {
                "type": "string"
              },
              "factor": {
                "type": "number",
                "format": "double"
              }
            }
          }
        }
      },
      "title": "FemCombination"
    }
  }
}
