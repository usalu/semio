{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/fem/2d/model-window-config/schema.json",
  "$ref": "#/$defs/Fem2dModelWindowConfig",
  "$defs": {
    "Fem2dModelWindowConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "gumball"
      ],
      "properties": {
        "camera": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/ui/viewport/2d"
        },
        "gumball": {
          "$ref": "#/$defs/Fem2dGumballConfig"
        }
      }
    },
    "Fem2dGumballConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moveAxes",
        "rotate",
        "scaleAxes",
        "scaleUniform"
      ],
      "properties": {
        "moveAxes": {
          "type": "boolean"
        },
        "rotate": {
          "type": "boolean"
        },
        "scaleAxes": {
          "type": "boolean"
        },
        "scaleUniform": {
          "type": "boolean"
        }
      }
    }
  }
}
