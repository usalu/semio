{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateElement",
  "description": "The `create-element` mutation payload as it travels the wire: internally tagged with `\"mutation\": \"createElement\"`, camelCase throughout. Structural only — the plausibility and geometry bounds this kind enforces live in the SNAPSHOT schema, because they are properties of a valid document rather than of a well-formed payload; each is annotated there with the `mutations::guards` function that raises them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "element"
  ],
  "properties": {
    "mutation": {
