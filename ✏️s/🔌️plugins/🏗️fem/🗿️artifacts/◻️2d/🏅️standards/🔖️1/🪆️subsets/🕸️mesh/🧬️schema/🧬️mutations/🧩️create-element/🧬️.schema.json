            },
            "end": {
              "type": "string"
            },
            "materialId": {
              "type": "string"
            },
            "sectionId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "start",
            "end",
            "materialId",
            "sectionId"
          ],
          "properties": {
            "kind": {
              "const": "beam"
            },
            "id": {
              "type": "string"
            },
            "start": {
