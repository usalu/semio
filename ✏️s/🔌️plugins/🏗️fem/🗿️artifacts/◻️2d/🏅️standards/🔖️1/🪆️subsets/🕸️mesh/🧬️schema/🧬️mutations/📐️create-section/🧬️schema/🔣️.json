{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/2d/1/mesh/mutation/create-section/schema.json",
  "title": "CreateSection",
  "description": "The `create-section` mutation payload as it travels the wire: internally tagged with `\"mutation\": \"createSection\"`, camelCase throughout. Its hard bounds and `x-semio-invariant` entries state exactly the payload-intrinsic breaches `mutations::guards` refuses as `mutation.invariant`, so every such payload fails this schema; refusals that depend on the base (a missing, duplicate or still-referenced target) belong to the diff alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "section"
  ],
  "properties": {
    "mutation": {
      "const": "createSection",
      "description": "The internally tagged discriminator `#[value(tag = \"mutation\")]` puts on the wire.",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "section": {
      "title": "FemSection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "area",
        "iy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Bezeichnung"
            },
            "group": "identity",
            "order": 20
          }
        },
        "area": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Cross-sectional area",
              "de": "Querschnittsfläche"
            },
            "unit": "m²",
            "displayUnit": "cm²",
            "displayFactor": 10000.0,
            "step": 0.0001,
            "precision": 2,
            "group": "section",
            "order": 30
          }
        },
        "iy": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Second moment of area Iy",
              "de": "Flächenträgheitsmoment Iy"
            },
            "unit": "m⁴",
            "displayUnit": "cm⁴",
            "displayFactor": 100000000.0,
            "step": 1e-08,
            "precision": 1,
            "group": "section",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Cross-section",
          "de": "Querschnitt"
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
