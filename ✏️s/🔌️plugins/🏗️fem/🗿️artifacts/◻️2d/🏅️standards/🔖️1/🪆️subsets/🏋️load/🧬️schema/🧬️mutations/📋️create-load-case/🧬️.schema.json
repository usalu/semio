{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateLoadCase",
  "description": "The `create-load-case` mutation payload as it travels the wire: internally tagged with `\"mutation\": \"createLoadCase\"`, camelCase throughout. Structural only — the plausibility and geometry bounds this kind enforces live in the SNAPSHOT schema, because they are properties of a valid document rather than of a well-formed payload; each is annotated there with the `mutations::guards` function that raises them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "loadCase"
  ],
  "properties": {
    "mutation": {
      "const": "createLoadCase",
      "description": "The internally tagged discriminator `#[value(tag = \"mutation\")]` puts on the wire."
    },
    "loadCase": {
      "title": "FemLoadCase",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "loads",
        "selfWeight"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "loads": {
          "type": "array",
          "items": {
            "title": "FemLoad",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "nodeId",
                  "dof",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "nodal"
                  },
                  "id": {
                    "type": "string"
                  },
                  "nodeId": {
                    "type": "string"
                  },
                  "dof": {
                    "type": "string",
                    "enum": [
                      "Tx",
                      "Ty",
                      "Tz",
                      "Rx",
                      "Ry",
                      "Rz"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "format": "double"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "elementId",
                  "wx",
                  "wy"
                ],
                "properties": {
                  "kind": {
                    "const": "memberUdl"
                  },
                  "id": {
                    "type": "string"
                  },
                  "elementId": {
                    "type": "string"
                  },
                  "wx": {
                    "type": "number",
                    "format": "double"
                  },
                  "wy": {
                    "type": "number",
                    "format": "double"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "regionId",
                  "pressure"
                ],
                "properties": {
                  "kind": {
                    "const": "area"
                  },
                  "id": {
                    "type": "string"
                  },
                  "regionId": {
                    "type": "string"
                  },
                  "pressure": {
                    "type": "number",
                    "format": "double"
                  }
                }
              }
            ]
          }
        },
        "selfWeight": {
          "type": "boolean"
        }
      }
    }
  }
}
