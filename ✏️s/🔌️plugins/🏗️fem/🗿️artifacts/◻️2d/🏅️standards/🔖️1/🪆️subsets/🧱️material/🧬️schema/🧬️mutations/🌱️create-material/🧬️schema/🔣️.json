{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/2d/1/material/mutation/create-material/schema.json",
  "title": "CreateMaterial",
  "description": "The `create-material` mutation payload as it travels the wire: internally tagged with `\"mutation\": \"createMaterial\"`, camelCase throughout. Its hard bounds and `x-semio-invariant` entries state exactly the payload-intrinsic breaches `mutations::guards` refuses as `mutation.invariant`, so every such payload fails this schema; refusals that depend on the base (a missing, duplicate or still-referenced target) belong to the diff alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "material"
  ],
  "properties": {
    "mutation": {
      "const": "createMaterial",
      "description": "The internally tagged discriminator `#[value(tag = \"mutation\")]` puts on the wire.",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "material": {
      "title": "FemMaterial",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "e",
        "nu",
        "rho"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Bezeichnung"
            },
            "group": "identity",
            "order": 20
          }
        },
        "e": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Young's modulus",
              "de": "Elastizitätsmodul"
            },
            "unit": "Pa",
            "displayUnit": "GPa",
            "displayFactor": 1e-09,
            "step": 1000000000.0,
            "precision": 1,
            "group": "material",
            "order": 30
          }
        },
        "nu": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 0.5,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Poisson's ratio",
              "de": "Querdehnzahl"
            },
            "step": 0.01,
            "precision": 3,
            "softMin": 0,
            "softMax": 0.49,
            "group": "material",
            "order": 40
          }
        },
        "rho": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Density",
              "de": "Dichte"
            },
            "unit": "kg/m³",
            "step": 10,
            "precision": 0,
            "group": "material",
            "order": 50
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Material",
          "de": "Material"
        },
        "group": "record",
        "order": 20
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0,
      "description": "Zero-based insertion position among the siblings; absent or past the end appends.",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "step": 1,
        "precision": 0,
        "group": "placement",
        "order": 900
      }
    }
  }
}
