{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/fem/2d/config/schema.json",
  "title": "Fem2dConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resultMode",
    "resultModeIndex",
    "camera"
  ],
  "properties": {
    "resultSourceId": {
