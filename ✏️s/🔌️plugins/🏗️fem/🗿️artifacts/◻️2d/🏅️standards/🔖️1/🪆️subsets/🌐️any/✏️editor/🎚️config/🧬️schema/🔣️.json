    "resultMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "resultModeIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "https://semio.tech/schema/s/fem/fem2d/artifact.json#/$defs/FemCamera",
      "x-semio-state": "config"
    }
  }
}
