{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateRegion",
  "description": "The `create-region` mutation payload as it travels the wire: internally tagged with `\"mutation\": \"createRegion\"`, camelCase throughout. Structural only — the plausibility and geometry bounds this kind enforces live in the SNAPSHOT schema, because they are properties of a valid document rather than of a well-formed payload; each is annotated there with the `mutations::guards` function that raises them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "region"
  ],
  "properties": {
    "mutation": {
      "const": "createRegion",
      "description": "The internally tagged discriminator `#[value(tag = \"mutation\")]` puts on the wire."
    },
    "region": {
      "title": "FemRegion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "outline",
        "holes",
        "thickness",
        "materialId",
        "meshSize"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "thickness": {
          "type": "number",
          "format": "double"
        },
        "materialId": {
          "type": "string"
        },
        "meshSize": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
