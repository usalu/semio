                "properties": {
                  "kind": {
                    "const": "memberUdl",
                    "x-semio-ui": {
                      "widget": "hidden",
                      "role": "discriminator",
                      "label": {
                        "en": "Load type",
                        "de": "Lastart"
                      }
                    }
                  },
                  "id": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "text",
                      "role": "value",
                      "label": {
                        "en": "ID",
                        "de": "ID"
                      },
                      "description": {
                        "en": "Unique id of the record.",
                        "de": "Eindeutige ID des Eintrags."
                      },
                      "group": "identity",
                      "order": 20
                    }
                  },
                  "elementId": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "reference",
                      "role": "target",
                      "label": {
                        "en": "Element",
                        "de": "Element"
                      },
                      "ref": {
                        "kind": "element",
                        "domain": "fem2d",
                        "granularity": "element"
                      },
                      "group": "target",
                      "order": 30
                    }
                  },
                  "wx": {
                    "type": "number",
                    "format": "double",
                    "x-semio-ui": {
                      "widget": "stepper",
                      "role": "value",
                      "label": {
                        "en": "Load wx (along)",
                        "de": "Streckenlast wx (längs)"
                      },
                      "description": {
                        "en": "Uniform load along the member axis (local x).",
                        "de": "Gleichmäßig verteilte Last in Stabachsrichtung (lokal x)."
                      },
                      "unit": "N/m",
                      "displayUnit": "kN/m",
                      "displayFactor": 0.001,
                      "step": 100,
                      "precision": 2,
                      "group": "load",
                      "order": 40
                    }
                  },
                  "wy": {
                    "type": "number",
                    "format": "double",
                    "x-semio-ui": {
                      "widget": "stepper",
                      "role": "value",
                      "label": {
                        "en": "Load wy (across)",
                        "de": "Streckenlast wy (quer)"
                      },
                      "description": {
                        "en": "Uniform load across the member axis (local y).",
                        "de": "Gleichmäßig verteilte Last quer zur Stabachse (lokal y)."
                      },
                      "unit": "N/m",
                      "displayUnit": "kN/m",
                      "displayFactor": 0.001,
                      "step": 100,
                      "precision": 2,
                      "group": "load",
                      "order": 50
                    }
                  }
                },
                "x-semio-ui": {
                  "label": {
                    "en": "Uniform member load",
                    "de": "Gleichstreckenlast"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "regionId",
                  "pressure"
                ],
                "properties": {
                  "kind": {
                    "const": "area",
                    "x-semio-ui": {
                      "widget": "hidden",
                      "role": "discriminator",
                      "label": {
                        "en": "Load type",
                        "de": "Lastart"
                      }
                    }
                  },
                  "id": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "text",
                      "role": "value",
                      "label": {
                        "en": "ID",
                        "de": "ID"
                      },
                      "description": {
                        "en": "Unique id of the record.",
                        "de": "Eindeutige ID des Eintrags."
                      },
                      "group": "identity",
                      "order": 20
                    }
                  },
                  "regionId": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "reference",
                      "role": "target",
                      "label": {
                        "en": "Plate region",
                        "de": "Scheibenbereich"
                      },
                      "ref": {
                        "kind": "region",
                        "domain": "fem2d",
                        "granularity": "region"
                      },
                      "group": "target",
                      "order": 30
                    }
                  },
                  "pressure": {
                    "type": "number",
                    "format": "double",
                    "x-semio-ui": {
                      "widget": "stepper",
                      "role": "value",
                      "label": {
                        "en": "Area load",
                        "de": "Flächenlast"
                      },
                      "description": {
                        "en": "Uniform pressure on the plate region.",
                        "de": "Gleichmäßige Flächenlast auf den Scheibenbereich."
                      },
                      "unit": "Pa",
                      "displayUnit": "kN/m²",
                      "displayFactor": 0.001,
                      "step": 100,
                      "precision": 2,
                      "group": "load",
                      "order": 40
                    }
                  }
                },
                "x-semio-ui": {
                  "label": {
                    "en": "Area load",
                    "de": "Flächenlast"
                  }
                }
              }
            ]
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Loads",
              "de": "Lasten"
            },
            "group": "record",
            "order": 30
          }
        },
        "selfWeight": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Self weight",
              "de": "Eigengewicht"
            },
            "description": {
              "en": "Includes the structure's self weight in this load case.",
              "de": "Berücksichtigt das Eigengewicht des Tragwerks in diesem Lastfall."
            },
            "group": "value",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "group": "record",
        "order": 20
      }
