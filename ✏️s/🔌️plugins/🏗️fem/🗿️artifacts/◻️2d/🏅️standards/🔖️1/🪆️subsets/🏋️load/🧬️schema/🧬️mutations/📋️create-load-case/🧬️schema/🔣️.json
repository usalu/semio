{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/2d/1/load/mutation/create-load-case/schema.json",
  "title": "CreateLoadCase",
  "description": "The `create-load-case` mutation payload as it travels the wire: internally tagged with `\"mutation\": \"createLoadCase\"`, camelCase throughout. Its hard bounds and `x-semio-invariant` entries state exactly the payload-intrinsic breaches `mutations::guards` refuses as `mutation.invariant`, so every such payload fails this schema; refusals that depend on the base (a missing, duplicate or still-referenced target) belong to the diff alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "loadCase"
  ],
  "properties": {
    "mutation": {
      "const": "createLoadCase",
      "description": "The internally tagged discriminator `#[value(tag = \"mutation\")]` puts on the wire.",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "loadCase": {
      "title": "FemLoadCase",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "loads",
        "selfWeight"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Bezeichnung"
            },
            "group": "identity",
            "order": 20
          }
        },
        "loads": {
          "type": "array",
          "items": {
            "title": "FemLoad",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "nodeId",
                  "dof",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "nodal",
                    "x-semio-ui": {
                      "widget": "hidden",
                      "role": "discriminator",
                      "label": {
                        "en": "Load type",
                        "de": "Lastart"
                      }
                    }
                  },
                  "id": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "text",
                      "role": "value",
                      "label": {
                        "en": "ID",
                        "de": "ID"
                      },
                      "description": {
                        "en": "Unique id of the record.",
                        "de": "Eindeutige ID des Eintrags."
                      },
                      "group": "identity",
                      "order": 20
                    }
                  },
                  "nodeId": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "reference",
                      "role": "target",
                      "label": {
                        "en": "Node",
                        "de": "Knoten"
                      },
                      "ref": {
                        "kind": "node",
                        "domain": "fem2d",
                        "granularity": "node"
                      },
                      "group": "target",
                      "order": 30
                    }
                  },
                  "dof": {
                    "type": "string",
                    "enum": [
                      "Tx",
                      "Ty",
                      "Tz",
                      "Rx",
                      "Ry",
                      "Rz"
                    ],
                    "x-semio-ui": {
                      "widget": "select",
                      "role": "value",
                      "label": {
                        "en": "Degree of freedom",
                        "de": "Freiheitsgrad"
                      },
                      "options": {
                        "Tx": {
                          "en": "Translation X",
                          "de": "Verschiebung x"
                        },
                        "Ty": {
                          "en": "Translation Y",
                          "de": "Verschiebung y"
                        },
                        "Tz": {
                          "en": "Translation Z",
                          "de": "Verschiebung z"
                        },
                        "Rx": {
                          "en": "Rotation about X",
                          "de": "Verdrehung um x"
                        },
                        "Ry": {
                          "en": "Rotation about Y",
                          "de": "Verdrehung um y"
