{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/3d/1/mesh/mutation/change-section/schema.json",
  "title": "ChangeSection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "patch"
  ],
  "properties": {
    "mutation": {
      "const": "changeSection"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Cross-section",
          "de": "Querschnitt"
        },
        "ref": {
          "kind": "section",
          "domain": "fem3d",
          "granularity": "section"
        },
        "group": "target",
        "order": 10
      }
    },
    "patch": {
      "title": "Fem3dSectionPatch",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Bezeichnung"
            },
            "group": "identity",
            "order": 20
          }
        },
        "area": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Cross-sectional area",
              "de": "Querschnittsfläche"
            },
            "unit": "m²",
            "displayUnit": "cm²",
            "displayFactor": 10000.0,
            "step": 0.0001,
            "precision": 2,
            "group": "section",
            "order": 30
          }
        },
        "iy": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Second moment of area Iy",
              "de": "Flächenträgheitsmoment Iy"
            },
            "unit": "m⁴",
            "displayUnit": "cm⁴",
            "displayFactor": 100000000.0,
            "step": 1E-08,
            "precision": 1,
            "group": "section",
            "order": 40
          }
        },
        "iz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Second moment of area Iz",
              "de": "Flächenträgheitsmoment Iz"
            },
            "unit": "m⁴",
            "displayUnit": "cm⁴",
            "displayFactor": 100000000.0,
            "step": 1E-08,
            "precision": 1,
            "group": "section",
            "order": 50
          }
        },
        "j": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Torsion constant",
              "de": "Torsionsflächenmoment"
            },
            "description": {
              "en": "Saint-Venant torsion constant I_T.",
              "de": "Torsionsflächenmoment 2. Grades I_T nach Saint-Venant."
            },
            "unit": "m⁴",
            "displayUnit": "cm⁴",
            "displayFactor": 100000000.0,
            "step": 1E-08,
            "precision": 1,
            "group": "section",
            "order": 60
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New cross-section",
          "de": "Neuer Querschnitt"
        },
        "group": "record",
        "order": 20
      }
    }
  },
  "description": "Changes only supplied section fields while preserving stable identity and independent concurrent edits. Omitted fields remain untouched; null values are refused."
}
