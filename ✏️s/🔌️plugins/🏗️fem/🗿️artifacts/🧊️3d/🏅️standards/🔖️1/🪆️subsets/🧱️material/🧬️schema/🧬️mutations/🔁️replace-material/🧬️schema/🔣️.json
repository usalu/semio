{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/3d/1/material/mutation/replace-material/schema.json",
  "title": "ReplaceMaterial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newMaterial"
  ],
  "properties": {
    "mutation": {
      "const": "replaceMaterial"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Material",
          "de": "Material"
        },
        "ref": {
          "kind": "material",
          "domain": "fem3d",
          "granularity": "material"
        },
        "group": "target",
        "order": 10
      }
    },
    "newMaterial": {
      "title": "FemMaterial",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "e",
        "g",
        "id",
        "name",
        "nu",
        "rho"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Bezeichnung"
            },
            "group": "identity",
            "order": 20
          }
        },
        "e": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Young's modulus",
              "de": "Elastizitätsmodul"
            },
            "unit": "Pa",
            "displayUnit": "GPa",
            "displayFactor": 1e-09,
            "step": 1000000000.0,
            "precision": 1,
            "group": "material",
            "order": 30
          }
        },
        "g": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Shear modulus",
              "de": "Schubmodul"
            },
            "unit": "Pa",
            "displayUnit": "GPa",
            "displayFactor": 1e-09,
            "step": 1000000000.0,
            "precision": 1,
            "group": "material",
            "order": 40
          }
        },
        "nu": {
          "type": "number",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 0.5,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Poisson's ratio",
              "de": "Querdehnzahl"
            },
            "step": 0.01,
            "precision": 3,
            "softMin": 0,
            "softMax": 0.49,
            "group": "material",
            "order": 50
          }
        },
        "rho": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Density",
              "de": "Dichte"
            },
            "unit": "kg/m³",
            "step": 10,
            "precision": 0,
            "group": "material",
            "order": 60
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New material",
          "de": "Neues Material"
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
