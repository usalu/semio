{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/3d/1/boundary/mutation/create-support/schema.json",
  "title": "CreateSupport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "support"
  ],
  "properties": {
    "mutation": {
      "const": "createSupport"
    },
    "support": {
      "title": "FemSupport",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed",
        "id",
        "nodeId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "nodeId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Node",
              "de": "Knoten"
            },
            "ref": {
              "kind": "node",
              "domain": "fem3d",
              "granularity": "node"
            },
            "group": "target",
            "order": 20
          }
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Tx",
              "Ty",
              "Tz",
              "Rx",
              "Ry",
              "Rz"
            ],
            "x-semio-ui": {
              "options": {
                "Tx": {
                  "en": "Translation X",
                  "de": "Verschiebung x"
                },
                "Ty": {
                  "en": "Translation Y",
                  "de": "Verschiebung y"
                },
                "Tz": {
                  "en": "Translation Z",
                  "de": "Verschiebung z"
                },
                "Rx": {
                  "en": "Rotation about X",
                  "de": "Verdrehung um x"
                },
                "Ry": {
                  "en": "Rotation about Y",
                  "de": "Verdrehung um y"
                },
                "Rz": {
                  "en": "Rotation about Z",
                  "de": "Verdrehung um z"
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Fixed degrees of freedom",
              "de": "Gesperrte Freiheitsgrade"
            },
            "group": "record",
            "order": 30
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Support",
          "de": "Lager"
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
