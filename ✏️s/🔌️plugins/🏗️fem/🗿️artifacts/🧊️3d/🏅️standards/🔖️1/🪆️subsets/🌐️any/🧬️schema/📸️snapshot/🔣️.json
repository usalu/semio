{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/fem/fem3d/snapshot.json",
  "title": "Fem3dSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodes",
    "elements",
    "materials",
    "sections",
    "solids",
    "supports",
    "loadCases",
    "combinations",
    "analysis"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem3d/artifact.json#/$defs/FemNode"
      },
      "x-semio-state": "artifact"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem3d/artifact.json#/$defs/FemElement"
      },
      "x-semio-state": "artifact"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem3d/artifact.json#/$defs/FemMaterial"
      },
      "x-semio-state": "artifact"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem3d/artifact.json#/$defs/FemSection"
      },
      "x-semio-state": "artifact"
    },
    "solids": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem3d/artifact.json#/$defs/FemSolid"
      },
      "x-semio-state": "artifact"
    },
    "supports": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem3d/artifact.json#/$defs/FemSupport"
      },
      "x-semio-state": "artifact"
    },
    "loadCases": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem3d/artifact.json#/$defs/FemLoadCase"
      },
      "x-semio-state": "artifact"
    },
    "combinations": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/fem/fem3d/artifact.json#/$defs/FemCombination"
      },
      "x-semio-state": "artifact"
    },
    "analysis": {
      "$ref": "https://semio.tech/schema/s/fem/fem3d/artifact.json#/$defs/FemAnalysisSettings",
      "x-semio-state": "artifact"
    }
  }
}
