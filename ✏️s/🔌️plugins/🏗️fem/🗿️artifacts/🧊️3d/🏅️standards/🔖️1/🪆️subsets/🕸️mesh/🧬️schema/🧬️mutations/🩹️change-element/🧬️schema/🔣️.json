{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/3d/1/mesh/mutation/change-element/schema.json",
  "title": "ChangeElement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "patch"
  ],
  "properties": {
    "mutation": {
      "const": "changeElement"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Element",
          "de": "Element"
        },
        "ref": {
          "kind": "element",
          "domain": "fem3d",
          "granularity": "element"
        },
        "group": "target",
        "order": 10
      }
    },
    "patch": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "kind": {
          "x-semio-ui": {
            "widget": "hidden",
            "role": "discriminator",
            "label": {
              "en": "Element type",
              "de": "Elementtyp"
            }
          },
          "type": "string",
          "enum": [
            "bar",
            "frame"
          ]
        },
        "start": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Start node",
              "de": "Anfangsknoten"
            },
            "ref": {
              "kind": "node",
              "domain": "fem3d",
              "granularity": "node"
            },
            "group": "target",
            "order": 30
          }
        },
        "end": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "End node",
              "de": "Endknoten"
            },
            "ref": {
              "kind": "node",
              "domain": "fem3d",
              "granularity": "node"
            },
            "group": "target",
            "order": 40
          }
        },
        "materialId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Material",
              "de": "Material"
            },
            "ref": {
              "kind": "material",
              "domain": "fem3d",
              "granularity": "material"
            },
            "group": "target",
            "order": 50
          }
        },
        "sectionId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Cross-section",
              "de": "Querschnitt"
            },
            "ref": {
              "kind": "section",
              "domain": "fem3d",
              "granularity": "section"
            },
            "group": "target",
            "order": 60
          }
        },
        "roll": {
          "type": "number",
          "x-semio-ui": {
            "widget": "dial",
            "role": "value",
            "label": {
              "en": "Roll angle",
              "de": "Verdrehwinkel"
            },
            "description": {
              "en": "Rotation of the section axes about the member axis.",
              "de": "Drehung der Querschnittshauptachsen um die Stabachse."
            },
            "unit": "rad",
            "displayUnit": "deg",
            "displayFactor": 57.29577951308232,
            "step": 0.017453292519943295,
            "softMin": -3.141592653589793,
            "softMax": 3.141592653589793,
            "snaps": [
              -3.141592653589793,
              -1.5707963267948966,
              0,
              1.5707963267948966,
              3.141592653589793
            ],
            "group": "geometry",
            "order": 70
          }
        }
      },
      "allOf": [
        {
          "then": {
            "not": {
              "required": [
                "roll"
              ]
            }
          },
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "bar"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Changes only supplied element fields. Variant is omitted for ordinary scalar or reference edits."
}
