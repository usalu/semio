{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/3d/1/load/mutation/create-load-case/schema.json",
  "title": "CreateLoadCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "loadCase"
  ],
  "properties": {
    "mutation": {
      "const": "createLoadCase"
    },
    "loadCase": {
      "title": "FemLoadCase",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "loads",
        "name",
        "selfWeight"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Bezeichnung"
            },
            "group": "identity",
            "order": 20
          }
        },
        "loads": {
          "type": "array",
          "items": {
            "title": "FemLoad",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dof",
                  "id",
                  "kind",
                  "nodeId",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "nodal",
                    "x-semio-ui": {
                      "widget": "hidden",
                      "role": "discriminator",
                      "label": {
                        "en": "Load type",
                        "de": "Lastart"
                      }
                    }
                  },
                  "id": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "text",
                      "role": "value",
                      "label": {
                        "en": "ID",
                        "de": "ID"
                      },
                      "description": {
                        "en": "Unique id of the record.",
                        "de": "Eindeutige ID des Eintrags."
                      },
                      "group": "identity",
                      "order": 20
                    }
                  },
                  "nodeId": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "reference",
                      "role": "target",
                      "label": {
                        "en": "Node",
                        "de": "Knoten"
                      },
                      "ref": {
                        "kind": "node",
                        "domain": "fem3d",
                        "granularity": "node"
                      },
                      "group": "target",
                      "order": 30
                    }
                  },
                  "dof": {
                    "type": "string",
                    "enum": [
                      "Tx",
                      "Ty",
                      "Tz",
                      "Rx",
                      "Ry",
                      "Rz"
                    ],
                    "x-semio-ui": {
                      "widget": "select",
                      "role": "value",
                      "label": {
                        "en": "Degree of freedom",
                        "de": "Freiheitsgrad"
                      },
                      "options": {
                        "Tx": {
                          "en": "Translation X",
                          "de": "Verschiebung x"
                        },
                        "Ty": {
                          "en": "Translation Y",
                          "de": "Verschiebung y"
                        },
                        "Tz": {
                          "en": "Translation Z",
                          "de": "Verschiebung z"
                        },
                        "Rx": {
                          "en": "Rotation about X",
                          "de": "Verdrehung um x"
                        },
                        "Ry": {
                          "en": "Rotation about Y",
                          "de": "Verdrehung um y"
                        },
                        "Rz": {
                          "en": "Rotation about Z",
                          "de": "Verdrehung um z"
                        }
                      },
                      "group": "load",
                      "order": 40
                    }
                  },
                  "value": {
                    "type": "number",
                    "x-semio-ui": {
                      "widget": "stepper",
                      "role": "value",
                      "label": {
                        "en": "Load value",
                        "de": "Lastwert"
                      },
                      "description": {
                        "en": "Force in N on a translation, moment in N·m on a rotation.",
                        "de": "Kraft in N bei einer Verschiebung, Moment in N·m bei einer Verdrehung."
                      },
                      "step": 100,
                      "precision": 2,
                      "group": "load",
                      "order": 50
                    }
                  }
                },
                "x-semio-ui": {
                  "label": {
                    "en": "Nodal load",
                    "de": "Knotenlast"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "elementId",
                  "id",
                  "kind",
                  "wx",
                  "wy",
                  "wz"
                ],
                "properties": {
                  "kind": {
                    "const": "memberUdl",
                    "x-semio-ui": {
                      "widget": "hidden",
                      "role": "discriminator",
                      "label": {
                        "en": "Load type",
                        "de": "Lastart"
                      }
                    }
                  },
                  "id": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "text",
                      "role": "value",
                      "label": {
                        "en": "ID",
                        "de": "ID"
                      },
                      "description": {
                        "en": "Unique id of the record.",
                        "de": "Eindeutige ID des Eintrags."
                      },
                      "group": "identity",
                      "order": 20
                    }
                  },
                  "elementId": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "reference",
                      "role": "target",
                      "label": {
                        "en": "Element",
                        "de": "Element"
                      },
                      "ref": {
                        "kind": "element",
                        "domain": "fem3d",
                        "granularity": "element"
                      },
                      "group": "target",
                      "order": 30
                    }
                  },
                  "wx": {
                    "type": "number",
                    "x-semio-ui": {
                      "widget": "stepper",
                      "role": "value",
                      "label": {
                        "en": "Load wx",
                        "de": "Streckenlast wx"
                      },
                      "description": {
                        "en": "Uniform member load component in global X.",
                        "de": "Komponente der Gleichstreckenlast in globaler x-Richtung."
                      },
                      "unit": "N/m",
                      "displayUnit": "kN/m",
                      "displayFactor": 0.001,
                      "step": 100,
                      "precision": 2,
                      "group": "load",
                      "order": 40
                    }
                  },
                  "wy": {
                    "type": "number",
                    "x-semio-ui": {
                      "widget": "stepper",
                      "role": "value",
                      "label": {
                        "en": "Load wy",
                        "de": "Streckenlast wy"
                      },
                      "description": {
                        "en": "Uniform member load component in global Y.",
                        "de": "Komponente der Gleichstreckenlast in globaler y-Richtung."
                      },
                      "unit": "N/m",
                      "displayUnit": "kN/m",
                      "displayFactor": 0.001,
                      "step": 100,
                      "precision": 2,
                      "group": "load",
                      "order": 50
                    }
                  },
                  "wz": {
                    "type": "number",
                    "x-semio-ui": {
                      "widget": "stepper",
                      "role": "value",
                      "label": {
                        "en": "Load wz",
                        "de": "Streckenlast wz"
                      },
                      "description": {
                        "en": "Uniform member load component in global Z.",
                        "de": "Komponente der Gleichstreckenlast in globaler z-Richtung."
                      },
                      "unit": "N/m",
                      "displayUnit": "kN/m",
                      "displayFactor": 0.001,
                      "step": 100,
                      "precision": 2,
                      "group": "load",
                      "order": 60
                    }
                  }
                },
                "x-semio-ui": {
                  "label": {
                    "en": "Uniform member load",
                    "de": "Gleichstreckenlast"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind",
                  "pressure",
                  "solidId"
                ],
                "properties": {
                  "kind": {
                    "const": "area",
                    "x-semio-ui": {
                      "widget": "hidden",
                      "role": "discriminator",
                      "label": {
                        "en": "Load type",
                        "de": "Lastart"
                      }
                    }
                  },
                  "id": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "text",
                      "role": "value",
                      "label": {
                        "en": "ID",
                        "de": "ID"
                      },
                      "description": {
                        "en": "Unique id of the record.",
                        "de": "Eindeutige ID des Eintrags."
                      },
                      "group": "identity",
                      "order": 20
                    }
                  },
                  "solidId": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "reference",
                      "role": "target",
                      "label": {
                        "en": "Solid",
                        "de": "Volumenkörper"
                      },
                      "ref": {
                        "kind": "solid",
                        "domain": "fem3d",
                        "granularity": "solid"
                      },
                      "group": "target",
                      "order": 30
                    }
                  },
                  "pressure": {
                    "type": "number",
                    "x-semio-ui": {
                      "widget": "stepper",
                      "role": "value",
                      "label": {
                        "en": "Area load",
                        "de": "Flächenlast"
                      },
                      "description": {
                        "en": "Uniform pressure on the top face of the solid.",
                        "de": "Gleichmäßige Flächenlast auf die Oberseite des Volumenkörpers."
                      },
                      "unit": "Pa",
                      "displayUnit": "kN/m²",
                      "displayFactor": 0.001,
                      "step": 100,
                      "precision": 2,
                      "group": "load",
                      "order": 40
                    }
                  }
                },
                "x-semio-ui": {
                  "label": {
                    "en": "Area load",
                    "de": "Flächenlast"
                  }
                }
              }
            ]
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Loads",
              "de": "Lasten"
            },
            "group": "record",
            "order": 30
          }
        },
        "selfWeight": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Self weight",
              "de": "Eigengewicht"
            },
            "description": {
              "en": "Includes the structure's self weight in this load case.",
              "de": "Berücksichtigt das Eigengewicht des Tragwerks in diesem Lastfall."
            },
            "group": "value",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0,
      "description": "Zero-based insertion position among the siblings; absent or past the end appends.",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "step": 1,
        "precision": 0,
        "group": "placement",
        "order": 900
      }
    }
  }
}
