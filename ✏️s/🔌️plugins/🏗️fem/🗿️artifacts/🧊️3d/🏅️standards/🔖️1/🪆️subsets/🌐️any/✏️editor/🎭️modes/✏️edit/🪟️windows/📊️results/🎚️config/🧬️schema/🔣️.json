{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/app/fem/3d/results-window-config/schema.json",
  "$ref": "#/$defs/Fem3dResultsWindowConfig",
  "$defs": {
    "Fem3dResultsWindowConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "resultMode",
        "resultModeIndex",
        "animation"
      ],
      "properties": {
        "camera": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/ui/viewport/3d"
        },
        "resultSourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultMode": {
          "$ref": "https://json.schemas.assets.semio-tech.com/fem/result-mode/schema.json"
        },
        "resultModeIndex": {
          "type": "integer",
          "minimum": 0
        },
        "animation": {
          "$ref": "https://json.schemas.assets.semio-tech.com/fem/results-animation/schema.json"
        }
      }
    }
  }
}
