{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/app/fem/3d/model-window-config/schema.json",
  "$ref": "#/$defs/Fem3dModelWindowConfig",
  "$defs": {
    "Fem3dModelWindowConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera",
        "gumball"
      ],
      "properties": {
        "camera": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/ui/viewport/3d"
        },
        "gumball": {
          "$ref": "#/$defs/Fem3dGumballConfig"
        }
      }
    },
    "Fem3dGumballConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moveAxes",
        "movePlanes",
        "rotate",
        "scaleAxes",
        "scaleUniform"
      ],
      "properties": {
        "moveAxes": {
          "type": "boolean"
        },
        "movePlanes": {
          "type": "boolean"
        },
        "rotate": {
          "type": "boolean"
        },
        "scaleAxes": {
          "type": "boolean"
        },
        "scaleUniform": {
          "type": "boolean"
        }
      }
    }
  }
}
