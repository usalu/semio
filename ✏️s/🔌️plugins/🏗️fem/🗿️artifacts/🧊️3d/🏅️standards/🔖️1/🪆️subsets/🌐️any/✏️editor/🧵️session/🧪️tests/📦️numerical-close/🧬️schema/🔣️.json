{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "model",
          "nodeIds",
          "before",
          "patch",
          "expected"
        ],
        "properties": {
          "lane": {
            "enum": [
              14,
              19,
              20,
              21
            ]
          },
          "model": {
            "type": "boolean"
          },
          "nodeIds": {
            "type": "boolean"
          },
          "before": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lane",
              "complete"
            ],
            "properties": {
              "lane": {
                "type": "integer",
                "minimum": 0,
                "maximum": 22
              },
              "complete": {
                "type": "boolean"
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lane",
              "complete"
            ],
            "properties": {
              "lane": {
                "type": "integer",
                "minimum": 0,
                "maximum": 22
              },
              "complete": {
                "type": "boolean"
              }
            }
          },
          "patch": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "path",
                "value"
              ],
              "properties": {
                "op": {
                  "const": "replace"
                },
                "path": {
                  "const": "/lane"
                },
                "value": {
                  "type": "integer",
                  "minimum": 15,
                  "maximum": 22
                }
              }
            }
          }
        }
      }
    }
  }
}

