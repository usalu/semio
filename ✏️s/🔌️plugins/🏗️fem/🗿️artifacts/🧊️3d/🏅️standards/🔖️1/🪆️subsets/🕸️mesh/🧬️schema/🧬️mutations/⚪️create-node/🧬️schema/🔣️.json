{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/3d/1/mesh/mutation/create-node/schema.json",
  "title": "CreateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "node"
  ],
  "properties": {
    "mutation": {
      "const": "createNode"
    },
    "node": {
      "title": "FemNode",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "z"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "x": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
