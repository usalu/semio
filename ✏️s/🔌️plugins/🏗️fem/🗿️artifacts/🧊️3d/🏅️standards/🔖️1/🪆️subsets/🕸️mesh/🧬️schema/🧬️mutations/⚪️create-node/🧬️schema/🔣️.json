        },
        "y": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Y",
              "de": "Y"
            },
            "unit": "m",
            "step": 0.1,
            "precision": 3,
            "group": "position",
            "order": 30
          }
        },
        "z": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Z",
              "de": "Z"
            },
            "unit": "m",
            "step": 0.1,
            "precision": 3,
            "group": "position",
            "order": 40
          }
        }
