{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/3d/1/analysis/mutation/update-analysis-settings/schema.json",
  "title": "UpdateAnalysisSettings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "settings"
  ],
  "properties": {
    "mutation": {
      "const": "updateAnalysisSettings"
    },
    "settings": {
      "title": "FemAnalysisSettings",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucklingCount",
        "deformationScale",
        "modalCount"
      ],
      "properties": {
        "modalCount": {
          "type": "integer",
          "minimum": 1,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Number of vibration modes",
              "de": "Anzahl Eigenformen"
            },
            "step": 1,
            "precision": 0,
            "group": "analysis",
            "order": 10
          }
        },
        "bucklingCount": {
          "type": "integer",
          "minimum": 1,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Number of buckling modes",
              "de": "Anzahl Knickformen"
            },
            "step": 1,
            "precision": 0,
            "group": "analysis",
            "order": 20
          }
        },
        "deformationScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Deformation scale",
              "de": "Verformungsmaßstab"
            },
            "description": {
              "en": "Magnification the deformed shape is drawn with.",
              "de": "Überhöhung, mit der die Verformungsfigur gezeichnet wird."
            },
            "step": 1,
            "precision": 1,
            "group": "analysis",
            "order": 30
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Analysis settings",
          "de": "Analyseeinstellungen"
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
