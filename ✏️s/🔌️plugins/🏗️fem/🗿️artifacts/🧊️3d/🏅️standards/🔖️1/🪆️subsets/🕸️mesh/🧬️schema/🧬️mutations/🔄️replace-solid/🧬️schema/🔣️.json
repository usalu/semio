{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/fem/3d/1/mesh/mutation/replace-solid/schema.json",
  "title": "ReplaceSolid",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newSolid"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "newSolid": {
      "title": "FemSolid",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "baseZ",
        "height",
        "holes",
        "id",
        "layers",
        "materialId",
        "meshSize",
        "name",
        "outline"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "axis": {
          "type": "string",
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "baseZ": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "layers": {
          "type": "integer",
          "minimum": 0
        },
        "meshSize": {
          "type": "number"
        },
        "materialId": {
          "type": "string"
        }
      }
    }
  }
}
