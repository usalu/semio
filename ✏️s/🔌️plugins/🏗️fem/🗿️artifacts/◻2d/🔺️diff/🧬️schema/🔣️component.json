      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "resultModeIndex": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "shared-ui"
    },
    "camera": {
      "$ref": "#/$defs/FemCamera",
      "x-semio-state": "local-ui"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "solverResultsJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "preview"
    },
    "meshPreviewJson": {
      "type": "string",
      "contentMediaType": "application/json",
