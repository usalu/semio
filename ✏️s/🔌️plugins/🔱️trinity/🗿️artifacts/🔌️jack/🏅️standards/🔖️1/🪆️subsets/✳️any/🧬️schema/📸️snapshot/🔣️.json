{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/trinity/jack/snapshot.json",
  "title": "JackSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "manifest", "camera", "content"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "name": { "type": "string", "x-semio-state": "artifact" },
    "manifestId": { "type": "string", "x-semio-state": "artifact" },
    "manifest": { "$ref": "https://semio.tech/schema/s/trinity/jack/artifact.json#/$defs/Manifest", "x-semio-state": "artifact" },
    "camera": { "$ref": "https://semio.tech/schema/s/trinity/jack/artifact.json#/$defs/Camera", "x-semio-state": "artifact" },
    "content": {
      "$ref": "https://semio.tech/schema/os/store/child.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "rootNodeId": { "type": "string", "x-semio-state": "artifact" }
  }
}
