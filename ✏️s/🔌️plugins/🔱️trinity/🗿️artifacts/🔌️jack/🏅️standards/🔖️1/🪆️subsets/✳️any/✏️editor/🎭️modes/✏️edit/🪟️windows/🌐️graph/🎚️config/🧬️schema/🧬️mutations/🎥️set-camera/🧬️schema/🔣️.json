{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/trinity/jack/graph-window/config/mutation/set-camera/schema.json",
  "title": "Set Camera",
  "type": "object",
  "properties": {
    "kind": {
      "const": "set-camera"
    },
    "camera": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "kind",
    "camera"
  ],
  "additionalProperties": false
}
