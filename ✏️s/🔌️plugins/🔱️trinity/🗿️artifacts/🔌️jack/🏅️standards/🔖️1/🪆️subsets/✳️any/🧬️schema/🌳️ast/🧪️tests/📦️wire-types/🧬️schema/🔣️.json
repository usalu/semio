{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "value",
          "accept"
        ],
        "properties": {
          "id": {
            "enum": [
              "jack-query-result-valid-table",
              "jack-query-result-invalid-kind",
              "jack-query-result-invalid-row"
            ]
          },
          "name": {
            "const": "QueryResult"
          },
          "value": {},
          "accept": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
