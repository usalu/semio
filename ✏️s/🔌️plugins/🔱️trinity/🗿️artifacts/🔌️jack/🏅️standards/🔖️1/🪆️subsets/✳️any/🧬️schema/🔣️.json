{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/trinity/jack/artifact.json",
  "title": "JackArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "manifest", "camera", "content"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "name": { "type": "string", "x-semio-state": "artifact" },
    "manifestId": { "type": "string", "x-semio-state": "artifact" },
    "manifest": { "$ref": "#/$defs/Manifest", "x-semio-state": "artifact" },
    "camera": { "$ref": "#/$defs/Camera", "x-semio-state": "artifact" },
    "content": {
      "$ref": "https://semio.tech/schema/os/store/child.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.graph"
    },
    "rootNodeId": { "type": "string", "x-semio-state": "artifact" }
  },
  "$defs": {
    "Camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number" }
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeKinds", "edgeKinds", "portKinds"],
      "properties": {
        "nodeKinds": { "type": "array", "items": { "$ref": "#/$defs/ManifestKind" } },
        "edgeKinds": { "type": "array", "items": { "$ref": "#/$defs/ManifestKind" } },
        "portKinds": { "type": "array", "items": { "$ref": "#/$defs/ManifestPortKind" } }
      }
    },
    "ManifestKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string" } }
    },
    "ManifestPortKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction"],
      "properties": {
        "name": { "type": "string" },
        "direction": { "type": "string" }
      }
    }
  }
}
