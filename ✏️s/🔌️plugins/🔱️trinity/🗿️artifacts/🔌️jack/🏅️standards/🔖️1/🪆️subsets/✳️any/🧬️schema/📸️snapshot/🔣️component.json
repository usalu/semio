{
  "$id": "https://semio.tech/schema/s/trinity/jack/snapshot.json",
  "title": "JackSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "manifest",
    "camera",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "name": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "manifestId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "manifest": {
      "$ref": "#/$defs/Manifest",
      "x-semio-state": "artifact"
    },
    "camera": {
      "$ref": "#/$defs/Camera",
      "x-semio-state": "artifact"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "x-semio-state": "artifact"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "x-semio-state": "artifact"
    },
    "rootNodeId": {
      "type": "string",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "Camera": {
      "title": "Camera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "Node": {
      "title": "Node",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "x",
        "y",
        "width",
        "height",
        "properties",
        "ports"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        }
      }
    },
    "Port": {
      "title": "Port",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "direction",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Edge": {
      "title": "Edge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Manifest": {
      "title": "Manifest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeKinds",
        "edgeKinds",
        "portKinds"
      ],
      "properties": {
        "nodeKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestKind"
          }
        },
        "edgeKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestKind"
          }
        },
        "portKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestPortKind"
          }
        }
      }
    },
    "ManifestKind": {
      "title": "ManifestKind",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "ManifestPortKind": {
      "title": "ManifestPortKind",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        }
      }
    }
  }
}
