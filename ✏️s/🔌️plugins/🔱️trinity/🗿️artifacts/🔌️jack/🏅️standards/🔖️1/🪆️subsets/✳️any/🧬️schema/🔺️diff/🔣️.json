{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/trinity/jack/diff.json",
  "title": "JackDiff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "manifestId", "manifest", "camera", "content", "rootNodeId"],
  "properties": {
    "schema": { "type": ["string", "null"], "x-semio-state": "artifact" },
    "name": { "type": ["string", "null"], "x-semio-state": "artifact" },
    "manifestId": { "type": ["string", "null"], "x-semio-state": "artifact" },
    "manifest": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "https://semio.tech/schema/s/trinity/jack/artifact.json#/$defs/Manifest" }
      ],
      "x-semio-state": "artifact"
    },
    "camera": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "https://semio.tech/schema/s/trinity/jack/artifact.json#/$defs/Camera" }
      ],
      "x-semio-state": "artifact"
    },
    "content": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "https://semio.tech/schema/os/store/child.json" }
      ],
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.graph"
    },
    "rootNodeId": { "type": ["string", "null"], "x-semio-state": "artifact" }
  }
}
