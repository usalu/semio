{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/trinity/jack/mutation/create-edge/schema.json",
  "title": "CreateEdge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "edge"
  ],
  "properties": {
    "mutation": {
      "const": "createEdge"
    },
    "edge": {
      "title": "CreateEdgeEdge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^[^@]+@.+$",
          "x-semio-ui": {
            "widget": "reference",
            "role": "value",
            "label": {
              "en": "Source Node",
              "de": "Quellknoten"
            },
            "description": {
              "en": "The node the connection starts at.",
              "de": "Der Knoten, an dem die Verbindung beginnt."
            },
            "ref": {
              "kind": "node",
              "domain": "ast",
              "granularity": "node"
            }
          }
        },
        "target": {
          "type": "string",
          "pattern": "^[^@]+@.+$",
          "x-semio-ui": {
            "widget": "reference",
            "role": "value",
            "label": {
              "en": "Target Node",
              "de": "Zielknoten"
            },
            "description": {
              "en": "The node the connection ends at.",
              "de": "Der Knoten, an dem die Verbindung endet."
            },
            "ref": {
              "kind": "node",
              "domain": "ast",
              "granularity": "node"
            }
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
