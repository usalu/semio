{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/trinity/jack/mutation/create-node/schema.json",
  "title": "CreateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "node"
  ],
  "properties": {
    "mutation": {
      "const": "createNode"
    },
    "node": {
      "title": "CreateNodeNode",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "x",
        "y",
        "width",
        "height",
        "properties",
        "ports"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "ports": {
          "type": "array",
          "items": {
            "title": "CreateNodePort",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "direction",
              "properties"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "in",
                  "out"
                ],
                "x-semio-ui": {
                  "widget": "segmented",
                  "role": "value",
                  "label": {
                    "en": "Direction",
                    "de": "Richtung"
                  },
                  "options": {
                    "in": {
                      "en": "Input",
                      "de": "Eingang"
                    },
                    "out": {
                      "en": "Output",
                      "de": "Ausgang"
                    }
                  }
                }
              },
              "properties": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Ports",
              "de": "Ports"
            },
            "description": {
              "en": "Input and output ports of the node.",
              "de": "Ein- und Ausgangsports des Knotens."
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The complete node record to add.",
          "de": "Der vollständige hinzuzufügende Knoten."
        }
      }
    }
  }
}
