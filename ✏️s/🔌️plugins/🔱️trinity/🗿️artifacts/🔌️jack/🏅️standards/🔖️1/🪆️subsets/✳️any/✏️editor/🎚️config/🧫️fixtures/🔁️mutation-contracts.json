      }
    },
    {
      "kind": "set-query",
      "mutation": {
        "SetQuery": {
          "value": "MATCH (n) RETURN n"
        }
      },
      "expected": {
        "jackQuery": "MATCH (n) RETURN n"
      }
    }
  ]
}

