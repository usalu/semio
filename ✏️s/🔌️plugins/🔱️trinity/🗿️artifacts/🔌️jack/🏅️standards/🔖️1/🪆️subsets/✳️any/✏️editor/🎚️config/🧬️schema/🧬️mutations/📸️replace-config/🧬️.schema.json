{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Replace Config",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "camera": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "additionalProperties": false
        },
        "activeFixtureId": {
          "type": "string"
        },
        "jackQuery": {
          "type": "string"
        },
        "jackResultJson": {
          "type": "string"
        },
        "editorEngagementInput": {
          "type": "string"
        },
        "graphEngagementInput": {
          "type": "string"
        },
        "resultsEngagementInput": {
          "type": "string"
        },
        "reorganizeEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "editorSelection": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "lodModeByWindow": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "locale": {
          "type": "string"
        }
      },
      "required": [
        "camera",
        "activeFixtureId",
        "jackQuery",
        "jackResultJson",
        "editorEngagementInput",
        "graphEngagementInput",
        "resultsEngagementInput",
        "reorganizeEpoch",
        "editorSelection",
        "lodModeByWindow",
        "revision",
        "locale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "config"
  ],
  "additionalProperties": false
}
