{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JackGraphWindowConfigMutation",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "camera"
      ],
      "properties": {
        "kind": {
          "const": "set-camera"
        },
        "camera": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "zoom"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "zoom": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "set-lod-mode"
        },
        "value": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  ]
}
