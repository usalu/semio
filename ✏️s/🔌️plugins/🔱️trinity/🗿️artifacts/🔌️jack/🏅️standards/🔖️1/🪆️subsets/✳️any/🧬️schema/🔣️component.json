{
  "$id": "https://semio.tech/schema/s/trinity/jack/artifact.json",
  "title": "JackArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "manifest",
    "camera",
    "nodes",
    "edges",
    "selectedNodeIds",
    "activeFixtureId",
    "jackQuery",
    "lodModeByWindow",
    "viewportCamera",
    "jackResultJson",
    "editorEngagementInput",
    "graphEngagementInput",
    "resultsEngagementInput",
    "reorganizeEpoch",
    "revision",
    "locale"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "persistent"
    },
    "name": {
      "type": "string",
      "x-semio-state": "persistent"
    },
    "manifestId": {
      "type": "string",
      "x-semio-state": "persistent"
    },
    "manifest": {
      "$ref": "#/$defs/Manifest",
      "x-semio-state": "persistent"
    },
    "camera": {
      "$ref": "#/$defs/Camera",
      "x-semio-state": "persistent"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "x-semio-state": "persistent"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "x-semio-state": "persistent"
    },
    "rootNodeId": {
      "type": "string",
      "x-semio-state": "persistent"
    },
    "selectedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "shared-ui"
    },
    "activeFixtureId": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "jackQuery": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "lodModeByWindow": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-semio-state": "shared-ui"
    },
    "viewportCamera": {
      "$ref": "#/$defs/Camera",
      "x-semio-state": "local-ui"
    },
    "jackResultJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "local-ui"
    },
    "editorEngagementInput": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "graphEngagementInput": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "resultsEngagementInput": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "reorganizeEpoch": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "local-ui"
    },
    "editorSelection": {
      "$ref": "#/$defs/JackEditorSelection",
      "x-semio-state": "local-ui"
    },
    "revision": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "local-ui"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "local-ui"
    }
  },
  "$defs": {
    "Camera": {
      "title": "Camera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "Node": {
      "title": "Node",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "x",
        "y",
        "width",
        "height",
        "properties",
        "ports"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        }
      }
    },
    "Port": {
      "title": "Port",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "direction",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Edge": {
      "title": "Edge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Manifest": {
      "title": "Manifest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeKinds",
        "edgeKinds",
        "portKinds"
      ],
      "properties": {
        "nodeKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestKind"
          }
        },
        "edgeKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestKind"
          }
        },
        "portKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestPortKind"
          }
        }
      }
    },
    "ManifestKind": {
      "title": "ManifestKind",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "ManifestPortKind": {
      "title": "ManifestPortKind",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        }
      }
    },
    "JackEditorSelection": {
      "title": "JackEditorSelection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "format": "int64"
        },
        "end": {
          "type": "integer",
          "format": "int64"
        }
      }
    }
  }
}
