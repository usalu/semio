    {
      "name": "a broken document reports a parse error and recovers",
      "steps": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "initialize",
            "params": {}
          },
          "expect": [
            {
              "id": 1,
              "result": {
                "capabilities": {
                  "hoverProvider": true
                }
              }
            }
          ]
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "textDocument/didOpen",
            "params": {
              "textDocument": {
                "uri": "file:///query.jack",
                "languageId": "jack",
                "version": 1,
                "text": "MATCH (a:Piece RETURN a"
              }
            }
          },
          "expect": [
            {
              "jsonrpc": "2.0",
              "method": "textDocument/publishDiagnostics",
              "params": {
                "uri": "file:///query.jack",
                "version": 1,
                "diagnostics": [
                  {
                    "range": {
                      "start": {
                        "line": 0,
                        "character": 0
                      },
                      "end": {
                        "line": 0,
                        "character": 23
                      }
                    },
                    "severity": 1,
                    "code": "jack/parse-error",
                    "source": "jack",
                    "message": {
                      "$any": true
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "textDocument/didChange",
            "params": {
              "textDocument": {
                "uri": "file:///query.jack",
                "version": 2
              },
              "contentChanges": [
                {
                  "range": {
                    "start": {
                      "line": 0,
                      "character": 14
                    },
                    "end": {
                      "line": 0,
                      "character": 14
                    }
                  },
                  "text": ")"
                }
              ]
            }
          },
          "expect": [
            {
              "method": "textDocument/publishDiagnostics",
              "params": {
                "uri": "file:///query.jack",
                "version": 2,
                "diagnostics": []
              }
            }
          ]
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "textDocument/didChange",
            "params": {
              "textDocument": {
                "uri": "file:///query.jack",
                "version": 3
              },
              "contentChanges": [
                {
                  "text": "MATCH (a:Piece RETURN a"
                }
              ]
            }
          },
          "expect": [
            {
              "method": "textDocument/publishDiagnostics",
              "params": {
                "version": 3,
                "diagnostics": [
                  {
                    "code": "jack/parse-error"
                  }
                ]
              }
            }
          ]
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "textDocument/didClose",
            "params": {
              "textDocument": {
                "uri": "file:///query.jack"
              }
            }
          },
          "expect": [
            {
              "method": "textDocument/publishDiagnostics",
              "params": {
                "uri": "file:///query.jack",
                "diagnostics": []
              }
            }
          ]
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "method": "textDocument/didClose",
            "params": {
              "textDocument": {
                "uri": "file:///query.jack"
              }
            }
          },
          "expect": []
        }
      ]
    },
