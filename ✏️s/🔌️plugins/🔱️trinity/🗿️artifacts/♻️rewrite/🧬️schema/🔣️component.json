{
  "$id": "https://semio.tech/schema/s/trinity/rewrite/artifact.json",
  "title": "RewriteArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "beforeFixtureJson",
    "lhsJson",
    "rhsJson",
    "parameterBindings",
    "ruleLayout",
    "selectedNodeIds",
    "activeHoverVar",
    "activeSelectVar",
    "lodModeByWindow",
    "beforePaneCamera",
    "reorganizeEpoch",
    "hoverEpoch",
    "selectEpoch",
    "locale"
  ],
  "properties": {
    "beforeFixtureJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "persistent"
    },
    "lhsJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "persistent"
    },
    "rhsJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "persistent"
    },
    "parameterBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PropertyValue"
      },
      "x-semio-state": "persistent"
    },
    "ruleLayout": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/LayoutPoint"
      },
      "x-semio-state": "persistent"
    },
    "selectedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "shared-ui"
    },
    "activeHoverVar": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "activeSelectVar": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "lodModeByWindow": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-semio-state": "shared-ui"
    },
    "beforePaneCamera": {
      "$ref": "#/$defs/Camera",
      "x-semio-state": "local-ui"
    },
    "reorganizeEpoch": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "local-ui"
    },
    "hoverEpoch": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "local-ui"
    },
    "selectEpoch": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "local-ui"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "local-ui"
    }
  },
  "$defs": {
    "PropertyValue": {
      "title": "PropertyValue",
      "description": "JSON-equivalent property value."
    },
    "LayoutPoint": {
      "title": "LayoutPoint",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "Camera": {
      "title": "Camera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
