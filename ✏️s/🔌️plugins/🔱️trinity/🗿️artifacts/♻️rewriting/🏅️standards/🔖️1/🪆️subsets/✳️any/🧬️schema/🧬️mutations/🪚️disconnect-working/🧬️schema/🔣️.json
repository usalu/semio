{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/trinity/rewriting/mutation/disconnect-working-edges/schema.json",
  "title": "DisconnectWorkingEdges",
  "description": "Edges of the working (before) graph cut by id. Edges the graph lacks are skipped (`mutation.partial`); none present is `mutation.target-missing`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "targets"
  ],
  "properties": {
    "mutation": {
      "const": "disconnectWorkingEdges"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Edges",
          "de": "Kanten"
        },
        "description": {
          "en": "Working-graph edges to cut; ones the graph lacks are skipped.",
          "de": "Zu trennende Kanten des Arbeitsgraphen; im Graphen fehlende werden übersprungen."
        },
        "ref": {
          "kind": "edge",
          "domain": "graph",
          "granularity": "edge"
        },
        "group": "target",
        "order": 10
      }
    }
  }
}
