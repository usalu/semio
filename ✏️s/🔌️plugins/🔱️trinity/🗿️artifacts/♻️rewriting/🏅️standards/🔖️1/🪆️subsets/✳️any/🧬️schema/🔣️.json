{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/trinity/rewriting/artifact.json",
  "title": "RewritingArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "beforeFixtureJson",
    "lhsJson",
    "rhsJson",
    "parameterBindings",
    "ruleLayout"
  ],
  "properties": {
    "beforeFixtureJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "artifact"
    },
    "lhsJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "artifact"
    },
    "rhsJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "artifact"
    },
    "parameterBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/DslValue"
      },
      "x-semio-state": "artifact"
    },
    "ruleLayout": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/LayoutPoint"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "LayoutPoint": {
      "title": "LayoutPoint",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
