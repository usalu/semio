{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/trinity/rewriting/artifact.json",
  "title": "Rewriting Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workingGraph",
    "lhs",
    "rhs",
    "parameterBindings",
    "ruleLayout"
  ],
  "properties": {
    "workingGraph": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/trinity/jack/snapshot.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "lhs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "$ref": "#/$defs/Pattern"
        },
        "whereClause": {
          "type": "string"
        }
      },
      "x-semio-state": "artifact"
    },
    "rhs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "delete",
        "set",
        "merge",
        "parameters"
      ],
      "properties": {
        "create": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pattern"
          }
        },
        "delete": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "set": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "var",
              "prop",
              "value"
            ],
            "properties": {
              "var": {
                "type": "string"
              },
              "prop": {
                "type": "string"
              },
              "value": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/graph/manifest/property-value.json"
              }
            }
          }
        },
        "merge": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pattern"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "default"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "default": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/graph/manifest/property-value.json"
              }
            }
          }
        }
      },
      "x-semio-state": "artifact"
    },
    "parameterBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://json.schemas.assets.semio-tech.com/framework/graph/manifest/property-value.json"
      },
      "x-semio-state": "artifact"
    },
    "ruleLayout": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/LayoutPoint"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "Pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leftVar",
        "leftKind"
      ],
      "properties": {
        "leftVar": {
          "type": "string"
        },
        "leftKind": {
          "type": "string"
        },
        "edgeVar": {
          "type": "string"
        },
        "edgeKind": {
          "type": "string"
        },
        "rightVar": {
          "type": "string"
        },
        "rightKind": {
          "type": "string"
        }
      }
    },
    "LayoutPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/Binary64"
        },
        "y": {
          "$ref": "#/$defs/Binary64"
        }
      }
    },
    "Binary64": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bits"
      ],
      "properties": {
        "bits": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      }
    }
  }
}
