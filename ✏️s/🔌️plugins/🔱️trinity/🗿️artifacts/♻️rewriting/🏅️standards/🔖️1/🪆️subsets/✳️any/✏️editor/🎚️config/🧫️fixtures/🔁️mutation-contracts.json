{
  "base": {
    "beforePaneCamera": {
      "x": 1,
      "y": 2,
      "zoom": 2
    },
    "lodModeByWindow": {
      "main": "compact"
    }
  },
  "cases": [
    {
      "kind": "replace-config",
      "mutation": {
        "ReplaceConfig": {
          "config": {
            "beforePaneCamera": {
              "x": 1,
              "y": 2,
              "zoom": 2
            },
            "lodModeByWindow": {
              "main": "compact"
            }
          }
        }
      },
      "expected": {
        "beforePaneCamera": {
          "x": 1,
          "y": 2,
          "zoom": 2
        },
        "lodModeByWindow": {
          "main": "compact"
        }
      }
    },
    {
      "kind": "set-before-pane-camera",
      "mutation": {
        "SetBeforePaneCamera": {
          "camera": {
            "x": 4.5,
            "y": 6.5,
            "zoom": 3.5
          }
        }
      },
      "expected": {
        "beforePaneCamera": {
          "x": 4.5,
          "y": 6.5,
          "zoom": 3.5
        },
        "lodModeByWindow": {
          "main": "compact"
        }
      }
    },
    {
      "kind": "set-lod-mode",
      "mutation": {
        "SetLodMode": {
          "value": "expanded",
          "window_id": "detail"
        }
      },
      "expected": {
        "beforePaneCamera": {
          "x": 1,
          "y": 2,
          "zoom": 2
        },
        "lodModeByWindow": {
          "main": "compact",
          "detail": "expanded"
        }
      }
    }
  ]
}
