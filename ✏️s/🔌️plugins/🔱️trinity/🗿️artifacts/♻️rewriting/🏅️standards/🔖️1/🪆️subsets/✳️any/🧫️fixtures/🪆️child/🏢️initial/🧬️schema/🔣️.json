{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/trinity/rewriting/initial-owner.json",
  "title": "Rewriting Independent Jack Demo Initial Owner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "rootNodeId",
    "child"
  ],
  "properties": {
    "query": {
      "const": "MATCH (a:Piece)-[r:Connection]->(b:Piece) WHERE a.name = 'b' AND b.name != 'b' RETURN a.name, b.name, b.label"
    },
    "rootNodeId": {
      "const": "7dc5b737-3b6b-4068-b315-b7bacc91c2e1"
    },
    "child": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/trinity/rewriting/typed-graph-child.json"
    }
  }
}
