{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.test.jack-flat-position-retained-child",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "authority",
    "cases",
    "refusal",
    "refusalKind"
  ],
  "properties": {
    "contractId": {
      "const": "jack-flat-position-retained-child"
    },
    "authority": {
      "const": "rawEndpointComponents"
    },
    "refusalKind": {
      "const": "invalidValue"
    },
    "refusal": {
      "const": {
        "key": "u",
        "value": {
          "kind": "str",
          "value": "number"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "properties",
          "expected"
        ],
        "properties": {
          "name": {
            "enum": [
              "missingOffsets",
              "finiteOffsets"
            ]
          },
          "properties": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "enum": [
                    "u",
                    "v"
                  ]
                },
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "lexeme"
                  ],
                  "properties": {
                    "kind": {
                      "const": "float"
                    },
                    "lexeme": {
                      "enum": [
                        "3.5",
                        "-2.25"
                      ]
                    }
                  }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b"
            ],
            "properties": {
              "a": {
                "$ref": "#/definitions/uv"
              },
              "b": {
                "$ref": "#/definitions/uv"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "uv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "u",
        "v"
      ],
      "properties": {
        "u": {
          "type": "number"
        },
        "v": {
          "type": "number"
        }
      }
    }
  }
}
