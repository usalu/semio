    },
    "reorganizeEpoch": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "PropertyValue": {
      "title": "PropertyValue",
      "description": "JSON-equivalent property value."
