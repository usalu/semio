            "$ref": "#/$defs/LayoutPoint"
          }
        ]
      },
      "x-semio-state": "artifact"
    },
    "lodModeByWindow": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string"
          }
        ]
      },
      "x-semio-state": "presence"
    },
    "beforePaneCamera": {
      "$ref": "#/$defs/Camera",
