{
  "$id": "https://semio.tech/schema/app/trinity/jack/presence.json",
  "title": "JackPresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedNodeIds",
    "activeFixtureId",
    "jackQuery",
    "camera",
    "lodModeByWindow"
  ],
  "properties": {
    "selectedNodeIds": {
      "type": "array",
      "items": { "type": "string" },
      "x-semio-state": "presence"
    },
    "activeFixtureId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "jackQuery": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "camera": {
      "$ref": "#/$defs/Camera",
      "x-semio-state": "presence"
    },
    "lodModeByWindow": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "x-semio-state": "presence"
    }
  },
  "$defs": {
    "Camera": {
      "title": "Camera",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number", "format": "double" },
        "y": { "type": "number", "format": "double" },
        "zoom": { "type": "number", "format": "double" }
      }
    }
  }
}
