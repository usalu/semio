{
  "$id": "https://semio.tech/schema/app/trinity/jack/config.json",
  "title": "JackConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera",
    "activeFixtureId",
    "jackQuery",
    "jackResultJson",
    "editorEngagementInput",
    "graphEngagementInput",
    "resultsEngagementInput",
    "reorganizeEpoch",
    "lodModeByWindow",
    "revision",
    "locale"
  ],
  "properties": {
    "camera": {
      "$ref": "#/$defs/Camera",
      "x-semio-state": "config"
    },
    "activeFixtureId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "jackQuery": {
      "type": "string",
      "x-semio-state": "config"
    },
    "jackResultJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    },
    "editorEngagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "graphEngagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "resultsEngagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "reorganizeEpoch": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "config"
    },
    "editorSelection": {
      "$ref": "#/$defs/JackEditorSelection",
      "x-semio-state": "config"
    },
    "lodModeByWindow": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "x-semio-state": "config"
    },
    "revision": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "Camera": {
      "title": "Camera",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number", "format": "double" },
        "y": { "type": "number", "format": "double" },
        "zoom": { "type": "number", "format": "double" }
      }
    },
    "JackEditorSelection": {
      "title": "JackEditorSelection",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "format": "int64" },
        "end": { "type": "integer", "format": "int64" }
      }
    }
  }
}
