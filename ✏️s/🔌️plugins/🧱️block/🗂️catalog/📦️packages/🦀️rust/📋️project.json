{
  "name": "@semio-tech/block-catalog-rs",
  "$schema": "../../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:plugin",
    "family:block"
  ],
  "namedInputs": {
    "nativeSources": [
      "{workspaceRoot}/✏️s/🔌️plugins/🧱️block/**/*.{ts,tsx,json,semio,wit,sql}",
      "{workspaceRoot}/✏️s/🔌️plugins/🧱️block/🗂️catalog/🧪️tests/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🧱️block/🗂️catalog/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "repo:script",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🧱️block/🗂️catalog/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🧱️block/🗂️catalog/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "conformance": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/✏️s/🔌️plugins/🧱️block/Cargo.lock"
      ],
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🧱️block/🗂️catalog/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts conformance",
        "forwardAllArgs": true
      }
    }
  }
}
