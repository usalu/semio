{
  "name": "@semio-tech/block-shared-rs",
  "$schema": "../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:plugin",
    "family:block"
  ],
  "targets": {
    "build": {
      "executor": "repo:script",
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🧱️block/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "repo:script",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🧱️block/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "✏️s/🔌️plugins/🧱️block/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test --features test-serde",
        "forwardAllArgs": true
      }
    }
  }
}
