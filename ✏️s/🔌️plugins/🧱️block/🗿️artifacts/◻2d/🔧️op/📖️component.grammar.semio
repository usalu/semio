dialect grammar
grammar block.block2d.op
extension block2d
use family-scene
start operation

artifact-mark = "block.2d-op"
operation = artifact-mark mesh-op+
mesh-op = "add-vertex" vtx-field+ | "set-face" face-field+ | "transform-mesh" xfm-field+ | "merge-solid" merge-field+ | "extrude-loop" loop-field+
loop-field = "loop" "=" list | "height" "=" FLOAT
vtx-field = "x" "=" FLOAT | "y" "=" FLOAT | "z" "=" FLOAT
face-field = "index" "=" INT | "loop" "=" list
xfm-field = "axis" "=" IDENT | "angle" "=" FLOAT
merge-field = "target" "=" IDENT | "source" "=" IDENT
list = "[" INT* "]"
layer = IDENT "@" FLOAT FLOAT FLOAT?
