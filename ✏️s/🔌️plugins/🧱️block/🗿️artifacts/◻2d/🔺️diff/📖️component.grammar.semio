dialect grammar
grammar block.block2d.diff
extension block2d
use family-scene
start diff

artifact-mark = "block.2d-diff"
diff = artifact-mark mesh-change+
mesh-change = "add-vertex" vtx+ | "drop-face" INT | "transform" xfm+ | "extrude-loop" loop+
loop = "loop" "=" list | "height" "=" FLOAT
list = "[" INT* "]"
vtx = "x" "=" FLOAT | "y" "=" FLOAT | "z" "=" FLOAT
xfm = "axis" "=" IDENT | "delta" "=" FLOAT
layer = IDENT "@" FLOAT FLOAT
