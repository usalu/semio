    "newDirection",
    "newPosition"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "newPosition": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "newDirection": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
