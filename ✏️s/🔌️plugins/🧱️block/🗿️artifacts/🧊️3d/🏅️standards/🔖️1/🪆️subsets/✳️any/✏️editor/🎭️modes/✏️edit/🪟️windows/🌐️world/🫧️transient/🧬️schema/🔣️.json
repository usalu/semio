{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/block/3d/world-window/transient/schema.json",
  "title": "Block3dWorldWindowTransient",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "brushPreview": {
      "anyOf": [
        { "$ref": "#/$defs/Block3dBrushPreview" },
        { "type": "null" }
      ],
      "x-semio-state": "ephemeral-local-window"
    }
  },
  "$defs": {
    "Block3dBrushPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "direction"],
      "properties": {
        "position": { "$ref": "#/$defs/Vec3" },
        "direction": { "$ref": "#/$defs/Vec3" }
      }
    },
    "Vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
