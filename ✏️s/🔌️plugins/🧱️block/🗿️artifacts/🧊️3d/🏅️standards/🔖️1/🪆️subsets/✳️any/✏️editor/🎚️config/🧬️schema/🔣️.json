{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/block/3d/config/schema.json",
  "title": "Block3dConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedIds",
    "wantedTags",
    "windows",
    "brushRadius",
    "brushFlip"
  ],
  "properties": {
    "selectedIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "activeRepresentationId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "wantedTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "windows": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/block/block3d/artifact.json#/$defs/Block3dWindowView"
      },
      "x-semio-state": "config"
    },
    "brushVortexKindId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "brushRadius": {
      "type": "number",
      "x-semio-state": "config"
    },
    "brushFlip": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "brushPreview": {
      "$ref": "https://semio.tech/schema/s/block/block3d/artifact.json#/$defs/Block3dBrushPreview",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "https://semio.tech/schema/s/block/block3d/artifact.json#/$defs/BlockCamera3d",
      "x-semio-state": "config"
    },
    "hoveredVortexFullId": {
      "type": "string",
      "x-semio-state": "config"
    }
  }
}
