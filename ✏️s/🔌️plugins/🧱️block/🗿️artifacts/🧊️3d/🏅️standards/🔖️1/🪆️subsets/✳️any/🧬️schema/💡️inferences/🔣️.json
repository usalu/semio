{
  "$id": "https://semio.tech/schema/s/block/block3d/inference.json",
  "title": "Block3dInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["bounds"],
  "properties": {
    "bounds": {
      "$ref": "#/$defs/Block3dBounds",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "BoundingBox3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "max": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
      }
    },
    "Block3dBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundingBox", "vertexCount"],
      "properties": {
        "boundingBox": { "anyOf": [{ "$ref": "#/$defs/BoundingBox3d" }, { "type": "null" }] },
        "vertexCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
