{
  "$id": "https://semio.tech/schema/app/block/3d/config.json",
  "title": "Block3dConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedIds",
    "wantedTags",
    "locale",
    "windows",
    "brushRadius",
    "brushFlip"
  ],
  "properties": {
    "selectedIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "activeRepresentationId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "wantedTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    },
    "windows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block3dWindowView"
      },
      "x-semio-state": "config"
    },
    "brushVortexKindId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "brushRadius": {
      "type": "number",
      "x-semio-state": "config"
    },
    "brushFlip": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "brushPreview": {
      "$ref": "#/$defs/Block3dBrushPreview",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "#/$defs/BlockCamera3d",
      "x-semio-state": "config"
    },
    "hoveredVortexFullId": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "Block3dWindowView": {
      "title": "Block3dWindowView",
      "type": "object",
      "additionalProperties": true
    },
    "Block3dBrushPreview": {
      "title": "Block3dBrushPreview",
      "type": "object",
      "additionalProperties": true
    },
    "BlockCamera3d": {
      "title": "BlockCamera3d",
      "type": "object",
      "additionalProperties": true
    }
  }
}
