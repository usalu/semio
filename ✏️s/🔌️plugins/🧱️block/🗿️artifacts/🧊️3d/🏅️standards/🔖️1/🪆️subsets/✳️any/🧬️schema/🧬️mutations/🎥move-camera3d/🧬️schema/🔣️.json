{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block3d/mutation/move-camera3d/schema.json",
  "title": "MoveCamera3d",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newPosition",
    "newTarget"
  ],
  "properties": {
    "mutation": {
      "const": "moveCamera3d"
    },
    "newPosition": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Camera position",
          "de": "Kameraposition"
        },
        "group": "camera",
        "order": 10
      }
    },
    "newTarget": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Camera target",
          "de": "Kameraziel"
        },
        "description": {
          "en": "Point the camera looks at.",
          "de": "Punkt, auf den die Kamera blickt."
        },
        "group": "camera",
        "order": 20
      }
    }
  }
}
