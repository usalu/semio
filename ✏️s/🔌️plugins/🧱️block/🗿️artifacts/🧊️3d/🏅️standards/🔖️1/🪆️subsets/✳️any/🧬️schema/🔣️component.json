    },
    "brushVortexKindId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "brushRadius": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "brushFlip": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "brushPreview": {
      "$ref": "#/$defs/Block3dBrushPreview",
      "x-semio-state": "artifact"
    },
    "camera": {
      "$ref": "#/$defs/BlockCamera3d",
      "x-semio-state": "config"
    },
    "hoveredVortexFullId": {
      "type": "string",
      "x-semio-state": "artifact"
    }
