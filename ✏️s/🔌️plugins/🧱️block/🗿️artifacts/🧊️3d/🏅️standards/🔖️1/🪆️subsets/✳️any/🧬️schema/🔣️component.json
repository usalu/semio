        "$ref": "#/$defs/BlockAttribute"
      },
      "x-semio-state": "artifact"
    },
    "authors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlockAuthor"
      },
      "x-semio-state": "artifact"
    },
    "camera3d": {
      "$ref": "#/$defs/BlockCamera3d",
      "x-semio-state": "artifact"
    },
    "meta": {
