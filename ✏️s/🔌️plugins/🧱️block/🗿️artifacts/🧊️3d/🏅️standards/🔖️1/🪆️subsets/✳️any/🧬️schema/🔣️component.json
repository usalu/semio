      "x-semio-state": "presence"
    },
    "activeRepresentationId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "wantedTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    },
    "windows": {
      "type": "array",
