{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block3d/mutation/create-vortex/schema.json",
  "title": "CreateVortex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "vortex"
  ],
  "properties": {
    "mutation": {
      "const": "createVortex"
    },
    "vortex": {
      "title": "Block3dVortexTemplate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "id",
        "position",
        "radius",
        "vortexKind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "vortexKind": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Vortex kind",
              "de": "Wirbelart"
            },
            "ref": {
              "kind": "vortexKind"
            },
            "group": "target",
            "order": 20
          }
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Position",
              "de": "Position"
            },
            "group": "geometry",
            "order": 30,
            "step": 0.1,
            "snapSource": {
              "step": true
            }
          }
        },
        "direction": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Direction",
              "de": "Richtung"
            },
            "description": {
              "en": "Outward connection direction.",
              "de": "Nach außen gerichtete Verbindungsrichtung."
            },
            "group": "geometry",
            "order": 40
          }
        },
        "radius": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Radius",
              "de": "Radius"
            },
            "step": 0.01,
            "precision": 3,
            "group": "geometry",
            "order": 50
          }
        },
        "label": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Label",
              "de": "Bezeichnung"
            },
            "group": "value",
            "order": 60
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Vortex",
          "de": "Wirbel"
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based slot to insert at; appended when omitted.",
          "de": "Nullbasierter Platz zum Einfügen; angehängt, wenn weggelassen."
        },
        "step": 1,
        "precision": 0,
        "group": "placement",
        "order": 900
      }
    }
  }
}
