{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block2d/artifact.json",
  "title": "Block2dArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nodeKind"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "nodeKind": {
      "$ref": "#/$defs/BlockKindIdentity",
      "x-semio-state": "artifact"
    },
    "presentation": {
      "$ref": "#/$defs/Block2dPresentation",
      "x-semio-state": "artifact"
    },
    "handleKinds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block2dHandleKind"
      },
      "x-semio-state": "artifact"
    },
    "handles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block2dHandleTemplate"
      },
      "x-semio-state": "artifact"
    },
    "compatibility": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlockCompatibilityRule"
      },
      "x-semio-state": "artifact"
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlockAttribute"
      },
      "x-semio-state": "artifact"
    },
    "authors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlockAuthor"
      },
      "x-semio-state": "artifact"
    },
    "camera2d": {
      "$ref": "#/$defs/BlockCamera2d",
      "x-semio-state": "artifact"
    },
    "meta": {
      "$ref": "#/$defs/BlockMeta",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "Binary64Word": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bits": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "required": [
        "bits"
      ]
    },
    "Binary64Transport": {
      "anyOf": [
        {
          "$ref": "#/$defs/Binary64Word"
        },
        {
          "type": "number"
        }
      ]
    },
    "BlockVector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Binary64Transport"
      }
    },
    "BlockVector4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/Binary64Transport"
      }
    },
    "BlockKindIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "label"
      ]
    },
    "BlockAttribute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "definition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "BlockAuthor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "BlockCompatibilityRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "bidirectional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ]
    },
    "BlockRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "meshUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lod": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BlockAttribute"
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "BlockCamera2d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "y": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "zoom": {
          "$ref": "#/$defs/Binary64Transport"
        }
      },
      "required": []
    },
    "BlockCamera3d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/BlockVector3"
        },
        "target": {
          "$ref": "#/$defs/BlockVector3"
        },
        "zoom": {
          "$ref": "#/$defs/Binary64Transport"
        }
      },
      "required": []
    },
    "BlockMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "required": []
    },
    "Block2dPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "iconKind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Block2dHandleKind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "defaultWireKind": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "label",
        "color",
        "defaultWireKind"
      ]
    },
    "Block2dHandleTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "handleKind": {
          "type": "string"
        },
        "angle": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "radius": {
          "$ref": "#/$defs/Binary64Transport"
        }
      },
      "required": [
        "id",
        "handleKind",
        "angle",
        "radius"
      ]
    }
  }
}
