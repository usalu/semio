field payload bytes
record change-handle-kind-color tag=11
field payload bytes
record change-handle-kind-default-wire-kind tag=12
field payload bytes
record create-handle tag=13
field payload bytes
record delete-handle tag=14
field payload bytes
record move-handle tag=15
