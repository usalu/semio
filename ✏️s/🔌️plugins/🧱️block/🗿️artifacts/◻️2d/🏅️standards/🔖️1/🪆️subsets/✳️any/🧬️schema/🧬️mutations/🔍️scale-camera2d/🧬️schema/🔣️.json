{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block2d/mutation/scale-camera2d/schema.json",
  "title": "ScaleCamera2d",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newZoom"
  ],
  "properties": {
    "mutation": {
      "const": "scaleCamera2d"
    },
    "newZoom": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Zoom",
          "de": "Zoom"
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0.1,
        "softMax": 10,
        "scale": "log",
        "snaps": [
          0.25,
          0.5,
          1,
          2,
          4
        ],
        "group": "camera",
        "order": 10
      }
    }
  }
}
