{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block2d/mutation/create-handle/schema.json",
  "title": "CreateHandle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "handle"
  ],
  "properties": {
    "mutation": {
      "const": "createHandle"
    },
    "handle": {
      "title": "Block2dHandleTemplate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle",
        "handleKind",
        "id",
        "radius"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "handleKind": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Handle kind",
              "de": "Griffart"
            },
            "ref": {
              "kind": "handleKind",
              "domain": "handle",
              "granularity": "handleKind"
            },
            "group": "target",
            "order": 20
          }
        },
        "angle": {
          "type": "number",
          "x-semio-ui": {
            "widget": "dial",
            "role": "value",
            "label": {
              "en": "Angle",
              "de": "Winkel"
            },
            "description": {
              "en": "Position on the node rim, counter-clockwise.",
              "de": "Lage auf dem Knotenrand, gegen den Uhrzeigersinn."
            },
            "unit": "rad",
            "displayUnit": "deg",
            "displayFactor": 57.29577951308232,
            "step": 0.017453292519943295,
            "softMin": -3.141592653589793,
            "softMax": 3.141592653589793,
            "snaps": [
              -3.141592653589793,
              -1.5707963267948966,
              0,
              1.5707963267948966,
              3.141592653589793
            ],
            "group": "geometry",
            "order": 30
          }
        },
        "radius": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Radius",
              "de": "Radius"
            },
            "step": 0.01,
            "precision": 2,
            "group": "geometry",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Handle",
          "de": "Griff"
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
