{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block2d/mutation/move-camera2d/schema.json",
  "title": "MoveCamera2d",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newX",
    "newY"
  ],
  "properties": {
    "mutation": {
      "const": "moveCamera2d"
    },
    "newX": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Camera X",
          "de": "Kamera X"
        },
        "step": 1,
        "precision": 2,
        "group": "camera",
        "order": 10
      }
    },
    "newY": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Camera Y",
          "de": "Kamera Y"
        },
        "step": 1,
        "precision": 2,
        "group": "camera",
        "order": 20
      }
    }
  }
}
