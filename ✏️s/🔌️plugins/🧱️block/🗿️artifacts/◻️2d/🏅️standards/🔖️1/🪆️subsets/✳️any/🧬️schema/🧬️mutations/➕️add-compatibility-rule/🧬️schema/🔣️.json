{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block2d/mutation/add-compatibility-rule/schema.json",
  "title": "AddCompatibilityRule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "rule"
  ],
  "properties": {
    "mutation": {
      "const": "addCompatibilityRule"
    },
    "rule": {
      "title": "BlockCompatibilityRule",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bidirectional",
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "source": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Source handle kind",
              "de": "Quell-Griffart"
            },
            "ref": {
              "kind": "handleKind",
              "domain": "handle",
              "granularity": "handleKind"
            },
            "group": "target",
            "order": 20
          }
        },
        "target": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Target handle kind",
              "de": "Ziel-Griffart"
            },
            "ref": {
              "kind": "handleKind",
              "domain": "handle",
              "granularity": "handleKind"
            },
            "group": "target",
            "order": 30
          }
        },
        "bidirectional": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Bidirectional",
              "de": "Beidseitig"
            },
            "description": {
              "en": "The rule also allows the reverse direction.",
              "de": "Die Regel erlaubt auch die Gegenrichtung."
            },
            "group": "kind",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Compatibility rule",
          "de": "Kompatibilitätsregel"
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based slot to insert at; appended when omitted.",
          "de": "Nullbasierter Platz zum Einfügen; angehängt, wenn weggelassen."
        },
        "step": 1,
        "precision": 0,
        "group": "placement",
        "order": 900
      }
    }
  }
}
