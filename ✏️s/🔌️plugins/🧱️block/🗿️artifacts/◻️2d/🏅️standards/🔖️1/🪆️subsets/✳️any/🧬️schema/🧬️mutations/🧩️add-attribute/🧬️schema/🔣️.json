{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block2d/mutation/add-attribute/schema.json",
  "title": "AddAttribute",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "attribute"
  ],
  "properties": {
    "mutation": {
      "const": "addAttribute"
    },
    "attribute": {
      "title": "BlockAttribute",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Key",
              "de": "Schlüssel"
            },
            "group": "metadata",
            "order": 10
          }
        },
        "value": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Value",
              "de": "Wert"
            },
            "group": "metadata",
            "order": 20
          }
        },
        "definition": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Definition",
              "de": "Definition"
            },
            "description": {
              "en": "Name or URI of the attribute's definition.",
              "de": "Name oder URI der Attributdefinition."
            },
            "group": "metadata",
            "order": 30
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Attribute",
          "de": "Attribut"
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based slot to insert at; appended when omitted.",
          "de": "Nullbasierter Platz zum Einfügen; angehängt, wenn weggelassen."
        },
        "step": 1,
        "precision": 0,
        "group": "placement",
        "order": 900
      }
    }
  }
}
