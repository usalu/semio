{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block5d/mutation/create-representation/schema.json",
  "title": "CreateRepresentation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "representation"
  ],
  "properties": {
    "mutation": {
      "const": "createRepresentation"
    },
    "representation": {
      "title": "BlockRepresentation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attributes",
        "description",
        "id",
        "name",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Name"
            },
            "group": "identity",
            "order": 20
          }
        },
        "meshUrl": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Mesh URL",
              "de": "Mesh-URL"
            },
            "group": "source",
            "order": 30
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Tags",
              "de": "Schlagwörter"
            },
            "group": "record",
            "order": 40
          }
        },
        "lod": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Level of detail",
              "de": "Detailstufe"
            },
            "group": "source",
            "order": 50
          }
        },
        "description": {
          "type": "string",
          "x-semio-ui": {
            "widget": "multiline",
            "role": "value",
            "label": {
              "en": "Description",
              "de": "Beschreibung"
            },
            "group": "value",
            "order": 60
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "title": "BlockAttribute",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Key",
                    "de": "Schlüssel"
                  },
                  "group": "metadata",
                  "order": 10
                }
              },
              "value": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Value",
                    "de": "Wert"
                  },
                  "group": "metadata",
                  "order": 20
                }
              },
              "definition": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Definition",
                    "de": "Definition"
                  },
                  "description": {
                    "en": "Name or URI of the attribute's definition.",
                    "de": "Name oder URI der Attributdefinition."
                  },
                  "group": "metadata",
                  "order": 30
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Attributes",
              "de": "Attribute"
            },
            "group": "record",
            "order": 70
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Representation",
          "de": "Darstellung"
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based slot to insert at; appended when omitted.",
          "de": "Nullbasierter Platz zum Einfügen; angehängt, wenn weggelassen."
        },
        "step": 1,
        "precision": 0,
        "group": "placement",
        "order": 900
      }
    }
  }
}
