dialect grammar
grammar block.block5d.op
extension block5d
use family-scene
start mutation

artifact-mark = "block.5d-op"
mutation = artifact-mark op+
op = "rename-part-kind" field*
   | "change-part-kind-label" field*
   | "change-part-kind-variant" field*
   | "change-part-kind-description" field*
   | "change-part-kind-icon" field*
   | "change-part-kind-unit" field*
   | "update-part-2d" field*
   | "update-part-3d" field*
   | "create-representation" field*
   | "delete-representation" field*
   | "rename-representation" field*
   | "change-representation-mesh-url" field*
   | "change-representation-lod" field*
   | "change-representation-description" field*
   | "add-representation-tag" field*
   | "remove-representation-tag" field*
   | "add-representation-attribute" field*
   | "remove-representation-attribute" field*
   | "create-grip-kind" field*
   | "delete-grip-kind" field*
   | "rename-grip-kind" field*
   | "change-grip-kind-label" field*
   | "change-grip-kind-color" field*
   | "change-grip-kind-default-rope-kind" field*
   | "create-grip" field*
   | "delete-grip" field*
   | "move-grip-2d" field*
   | "move-grip-3d" field*
   | "resize-grip-3d" field*
   | "change-grip-grip-kind" field*
   | "add-compatibility-rule" field*
   | "remove-compatibility-rule" field*
   | "add-attribute" field*
   | "remove-attribute" field*
   | "add-author" field*
   | "remove-author" field*
   | "move-camera2d" field*
   | "scale-camera2d" field*
   | "move-camera3d" field*
   | "scale-camera3d" field*
   | "change-meta-description" field*
field = IDENT "=" (STRING | FLOAT | INT | BOOL | IDENT)
