{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block5d/artifact.json",
  "title": "Block5dArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "partKind"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "partKind": {
      "$ref": "#/$defs/BlockKindIdentity",
      "x-semio-state": "artifact"
    },
    "part2d": {
      "$ref": "#/$defs/Block5dPart2d",
      "x-semio-state": "artifact"
    },
    "part3d": {
      "$ref": "#/$defs/Block5dPart3d",
      "x-semio-state": "artifact"
    },
    "representations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlockRepresentation"
      },
      "x-semio-state": "artifact"
    },
    "gripKinds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block5dGripKind"
      },
      "x-semio-state": "artifact"
    },
    "grips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block5dGripTemplate"
      },
      "x-semio-state": "artifact"
    },
    "compatibility": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlockCompatibilityRule"
      },
      "x-semio-state": "artifact"
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlockAttribute"
      },
      "x-semio-state": "artifact"
    },
    "authors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BlockAuthor"
      },
      "x-semio-state": "artifact"
    },
    "camera2d": {
      "$ref": "#/$defs/BlockCamera2d",
      "x-semio-state": "artifact"
    },
    "camera3d": {
      "$ref": "#/$defs/BlockCamera3d",
      "x-semio-state": "artifact"
    },
    "meta": {
      "$ref": "#/$defs/BlockMeta",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "BlockKindIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "label"
      ]
    },
    "Block5dPart2d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "iconKind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": []
    },
    "Block5dPart3d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orientation": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockVector4"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockVector3"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": []
    },
    "BlockRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "meshUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lod": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BlockAttribute"
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Block5dGripKind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "defaultRopeKind": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "label",
        "color",
        "defaultRopeKind"
      ]
    },
    "Block5dGripTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "gripKind": {
          "type": "string"
        },
        "angle": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "radius2d": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "position": {
          "$ref": "#/$defs/BlockVector3"
        },
        "direction": {
          "$ref": "#/$defs/BlockVector3"
        },
        "radius3d": {
          "$ref": "#/$defs/Binary64Transport"
        }
      },
      "required": [
        "id",
        "gripKind"
      ]
    },
    "BlockCompatibilityRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "bidirectional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ]
    },
    "BlockAttribute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "definition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "BlockAuthor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "BlockCamera2d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "y": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "zoom": {
          "$ref": "#/$defs/Binary64Transport"
        }
      },
      "required": []
    },
    "BlockCamera3d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/BlockVector3"
        },
        "target": {
          "$ref": "#/$defs/BlockVector3"
        },
        "zoom": {
          "$ref": "#/$defs/Binary64Transport"
        }
      },
      "required": []
    },
    "BlockMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "required": []
    },
    "Binary64Word": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bits": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "required": [
        "bits"
      ]
    },
    "Binary64Transport": {
      "anyOf": [
        {
          "$ref": "#/$defs/Binary64Word"
        },
        {
          "type": "number"
        }
      ]
    },
    "BlockVector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Binary64Transport"
      }
    },
    "BlockVector4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/Binary64Transport"
      }
    }
  }
}
