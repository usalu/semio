    "partKind",
    "part2d",
    "part3d",
    "representations",
    "gripKinds",
    "grips",
    "compatibility",
    "attributes",
    "authors",
    "camera2d",
    "camera3d",
    "meta"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "partKind": {
      "$ref": "https://semio.tech/schema/s/block/block5d/artifact.json#/$defs/BlockKindIdentity",
      "x-semio-state": "artifact"
    },
    "part2d": {
      "$ref": "https://semio.tech/schema/s/block/block5d/artifact.json#/$defs/Block5dPart2d",
      "x-semio-state": "artifact"
