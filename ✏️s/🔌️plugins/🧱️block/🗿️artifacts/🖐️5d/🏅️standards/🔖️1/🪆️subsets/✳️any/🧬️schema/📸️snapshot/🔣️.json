{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/block/block5d/snapshot.json",
  "title": "Block5dSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
