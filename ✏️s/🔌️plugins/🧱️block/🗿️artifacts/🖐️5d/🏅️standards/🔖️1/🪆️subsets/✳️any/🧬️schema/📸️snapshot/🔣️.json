    "part3d": {
      "$ref": "https://semio.tech/schema/s/block/block5d/artifact.json#/$defs/Block5dPart3d",
      "x-semio-state": "artifact"
    },
    "representations": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/block/block5d/artifact.json#/$defs/BlockRepresentation"
      },
      "x-semio-state": "artifact"
    },
    "gripKinds": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/block/block5d/artifact.json#/$defs/Block5dGripKind"
      },
      "x-semio-state": "artifact"
    },
    "grips": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/block/block5d/artifact.json#/$defs/Block5dGripTemplate"
      },
      "x-semio-state": "artifact"
