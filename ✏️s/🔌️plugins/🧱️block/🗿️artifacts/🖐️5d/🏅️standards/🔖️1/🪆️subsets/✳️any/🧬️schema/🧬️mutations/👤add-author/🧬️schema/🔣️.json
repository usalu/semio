{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/block/block5d/mutation/add-author/schema.json",
  "title": "AddAuthor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "author"
  ],
  "properties": {
    "mutation": {
      "const": "addAuthor"
    },
    "author": {
