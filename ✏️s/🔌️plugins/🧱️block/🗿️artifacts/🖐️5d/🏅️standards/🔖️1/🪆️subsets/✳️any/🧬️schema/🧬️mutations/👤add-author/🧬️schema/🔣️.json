      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Name"
            },
            "group": "identity",
            "order": 20
          }
        },
        "email": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Email",
              "de": "E-Mail"
            },
            "group": "identity",
            "order": 30
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Author",
          "de": "Autor"
