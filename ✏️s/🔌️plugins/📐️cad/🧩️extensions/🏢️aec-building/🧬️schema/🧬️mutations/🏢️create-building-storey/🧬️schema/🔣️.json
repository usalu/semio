{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/aec-building/mutation/create-building-storey/schema.json",
  "title": "CreateBuildingStorey",
  "type": "object",
  "properties": {
    "storeyId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Storey ID",
          "de": "Geschoss-ID"
        },
        "description": {
          "en": "Id of the new storey.",
          "de": "ID des neuen Geschosses."
        },
        "group": "identity",
        "order": 10
      }
    },
    "levelIndex": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Level",
          "de": "Geschossebene"
        },
        "description": {
          "en": "0 is the ground floor; negative levels lie below ground.",
          "de": "0 ist das Erdgeschoss; negative Ebenen liegen unter Gelände."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "storeyName": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Storey name",
          "de": "Geschossbezeichnung"
        },
        "group": "identity",
        "order": 30
      }
    }
  },
  "required": [
    "storeyId",
    "levelIndex",
    "storeyName"
  ],
  "additionalProperties": false
}
