{
  "name": "@semio-tech/cad-js",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": ["{workspaceRoot}/✏️s/🔌️plugins/📐️cad/🔨️modules/**/*.ts", "{workspaceRoot}/✏️s/🔌️plugins/📐️cad/🔨️modules/**/*.tsx", "{projectRoot}/**/*"]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "✏️s/🔌️plugins/📐️cad/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "env": {
          "CAD_JS_RENDERER_PLAY_PORT": "6041"
        },
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "✏️s/🔌️plugins/📐️cad/📦️packages/🟦️typescript",
