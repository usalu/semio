{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/mutation/change-reference-locked/schema.json",
  "title": "ChangeReferenceLocked",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "modelDefinitionId",
    "newLocked",
    "referenceId"
  ],
  "properties": {
    "mutation": {
      "const": "changeReferenceLocked"
    },
    "modelDefinitionId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Model definition",
          "de": "Modelldefinition"
        },
        "description": {
          "en": "Id of the model the reference belongs to, e.g. aec.building.",
          "de": "ID des Modells, zu dem die Referenz gehört, z. B. aec.building."
        },
        "group": "target",
        "order": 10
      }
    },
    "referenceId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Reference",
          "de": "Referenz"
        },
        "description": {
          "en": "The reference image this mutation addresses.",
          "de": "Das Referenzbild, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "reference"
        },
        "group": "target",
        "order": 20
      }
    },
    "newLocked": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Locked",
          "de": "Gesperrt"
        },
        "group": "state",
        "order": 30
      }
    }
  }
}
