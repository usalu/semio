{
  "schema": "spatial.interaction",
  "id": "building.building.placeRailing",
  "version": "1.0.0",
  "label": {
    "native": { "en": "Place Railing", "de": "Geländer platzieren" },
    "reuse": { "en": "Place Railing", "de": "Geländer platzieren" }
  },
  "key": "g",
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": [
      "idle",
      "committed"
    ],
    "groundPointerMoveStates": [
      "first_point",
      "second_point"
    ],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "first_point",
                "key": "s",
                "label": {
                  "native": { "en": "Start", "de": "Start" },
                  "reuse": { "en": "Start", "de": "Start" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": {}
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "first_point",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "second_point",
                "label": {
                  "native": { "en": "Start Point", "de": "Startpunkt" },
                  "reuse": { "en": "Start Point", "de": "Startpunkt" }
                },
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "start"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "second_point",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "committed",
                "label": {
                  "native": { "en": "End Point", "de": "Endpunkt" },
                  "reuse": { "en": "End Point", "de": "Endpunkt" }
                },
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "end"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "first_point",
        "items": [
          {
            "kind": "label",
            "id": "hint-first",
            "role": "prompt",
            "text": {
              "native": { "en": "Place Railing: click start point", "de": "Geländer platzieren: Startpunkt anklicken" },
              "reuse": { "en": "Place Railing: click start point", "de": "Geländer platzieren: Startpunkt anklicken" }
            },
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "point",
            "id": "cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      },
      {
        "state": "second_point",
        "items": [
          {
            "kind": "label",
            "id": "hint-second",
            "role": "prompt",
            "text": {
              "native": { "en": "Place Railing: click end point", "de": "Geländer platzieren: Endpunkt anklicken" },
              "reuse": { "en": "Place Railing: click end point", "de": "Geländer platzieren: Endpunkt anklicken" }
            },
            "position": {
              "kind": "const",
              "value": [
                0,
                0.25,
                1.55
              ]
            }
          },
          {
            "kind": "point",
            "id": "anchor-a",
            "role": "anchor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "points"
                },
                {
                  "kind": "field",
                  "name": "start"
                }
              ]
            }
          },
          {
            "kind": "point",
            "id": "cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "footprint-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "points"
                },
                {
                  "kind": "field",
                  "name": "start"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      },
      {
        "state": "committed",
        "items": [
          {
            "kind": "label",
            "id": "hint-commit",
            "role": "prompt",
            "text": {
              "native": { "en": "Place Railing: Accept to create", "de": "Geländer platzieren: Zum Erstellen bestätigen" },
              "reuse": { "en": "Place Railing: Accept to create", "de": "Geländer platzieren: Zum Erstellen bestätigen" }
            },
            "position": {
              "kind": "const",
              "value": [
                0,
                0.2,
                1.55
              ]
            }
          },
          {
            "kind": "segment",
            "id": "preview-final",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "points"
                },
                {
                  "kind": "field",
                  "name": "start"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "points"
                },
                {
                  "kind": "field",
                  "name": "end"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "fromStates": [
      "committed"
    ],
    "operation": {
      "kind": "action",
      "action": "curve.line",
      "params": {
        "typology": {
          "kind": "const",
          "value": "building.building.railing"
        },
        "p0": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "points"
            },
            {
              "kind": "field",
              "name": "start"
            }
          ]
        },
        "p1": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "points"
            },
            {
              "kind": "field",
              "name": "end"
            }
          ]
        }
      }
    }
  },
  "produces": {
    "typology": "building.building.railing"
  }
}
