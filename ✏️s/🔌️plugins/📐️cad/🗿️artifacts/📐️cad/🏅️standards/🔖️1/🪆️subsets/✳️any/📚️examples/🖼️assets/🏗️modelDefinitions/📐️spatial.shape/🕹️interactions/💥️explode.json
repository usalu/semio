{
  "schema": "spatial.interaction",
  "id": "edit.explode",
  "version": "1.0.0",
  "label": {
    "native": { "en": "Explode", "de": "Zerlegen" },
    "reuse": { "en": "Explode", "de": "Zerlegen" }
  },
  "interaction": {
    "spatialGroundPick": false,
    "pickDisabledStates": ["idle", "committed"],
    "groundPointerMoveStates": [],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "select_objects_to_explode",
                "key": "s",
                "label": {
                  "native": { "en": "Start", "de": "Start" },
                  "reuse": { "en": "Start", "de": "Start" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [0, 0, 0]
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_objects_to_explode",
        "selection": {
          "accept": ["wire", "shell", "solid"],
          "multiple": true,
          "prompt": {
            "native": { "en": "Select objects to explode", "de": "Zu zerlegende Objekte auswählen" },
            "reuse": { "en": "Select objects to explode", "de": "Zu zerlegende Objekte auswählen" }
          }
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_objects_to_explode",
                "key": "s",
                "label": {
                  "native": { "en": "Select", "de": "Auswählen" },
                  "reuse": { "en": "Select", "de": "Auswählen" }
                },
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "targets"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "committed",
                "key": "Enter",
                "label": {
                  "native": { "en": "Finish", "de": "Fertig" },
                  "reuse": { "en": "Finish", "de": "Fertig" }
                }
              }
            ]
          },
          {
            "event": "contextmenu",
            "transitions": [
              {
                "target": "committed",
                "key": "RightClick",
                "label": {
                  "native": { "en": "Finish", "de": "Fertig" },
                  "reuse": { "en": "Finish", "de": "Fertig" }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "select_objects_to_explode",
        "items": [
          {
            "kind": "label",
            "id": "select_objects_to_explode-prompt",
            "role": "prompt",
            "text": {
              "native": { "en": "Select objects to explode", "de": "Zu zerlegende Objekte auswählen" },
              "reuse": { "en": "Select objects to explode", "de": "Zu zerlegende Objekte auswählen" }
            },
            "position": {
              "kind": "const",
              "value": [0, 0.25, 1.55]
            }
          },
          {
            "kind": "preview",
            "id": "select_objects_to_explode-preview",
            "role": "preview",
            "previewKind": "explode-selection",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "fromStates": ["ready"],
    "operation": {
      "kind": "action",
      "action": "command.finish",
      "params": {
        "commandId": {
          "kind": "const",
          "value": "edit.explode"
        },
        "resultKind": {
          "kind": "const",
          "value": "explode"
        }
      }
    }
  },
  "key": "7",
  "produces": {
    "typology": "spatial.shape.edit.explode"
  }
}
