{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/artifact.json",
  "title": "CadArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "drawings",
    "breps",
    "referencesByModelDefinitionId",
    "nodes"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "shapeModel": {
      "$ref": "#/$defs/CadModelChild",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "buildingModel": {
      "$ref": "#/$defs/CadModelChild",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "energyModel": {
      "$ref": "#/$defs/CadModelChild",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "structureClassicModel": {
      "$ref": "#/$defs/CadModelChild",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "drawings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadDrawingChild"
      },
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "breps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadBrepChild"
      },
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "referencesByModelDefinitionId": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CadReferenceList"
      },
      "x-semio-state": "artifact"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadNode"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "CadNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "CadReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceUrl",
        "mediaKind",
        "origin",
        "orientation",
        "scale",
        "widthWorld",
        "hidden",
        "locked",
        "opacity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "mediaKind": {
          "type": "string"
        },
        "origin": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "orientation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "scale": {
          "type": [
            "number",
            "null"
          ]
        },
        "widthWorld": {
          "type": "number"
        },
        "hidden": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "opacity": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "CadReferenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadReference"
      }
    },
    "CadNodePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CadNodeModification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/CadNodePatch"
        }
      }
    },
    "CadNodesDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed",
        "inserted",
        "moved",
        "modified"
      ],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadNodeRemoval"
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadNodeInsertion"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadNodeRelocation"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadNodeModification"
          }
        }
      }
    },
    "CadNodeRemoval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CadNodeRelocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CadModelChild": {
      "allOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child/schema.json"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "object",
              "properties": {
                "dialect": {
                  "type": "object",
                  "properties": {
                    "artifactKind": {
                      "const": "s.stdio.semio"
                    },
                    "standard": {
                      "const": "v1"
                    },
                    "subset": {
                      "const": "model"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "CadDrawingChild": {
      "allOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child/schema.json"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "object",
              "properties": {
                "dialect": {
                  "type": "object",
                  "properties": {
                    "artifactKind": {
                      "const": "s.stdio.semio"
                    },
                    "standard": {
                      "const": "v1"
                    },
                    "subset": {
                      "const": "drawing"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "CadBrepChild": {
      "allOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child/schema.json"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "object",
              "properties": {
                "dialect": {
                  "type": "object",
                  "properties": {
                    "artifactKind": {
                      "const": "s.stdio.semio"
                    },
                    "standard": {
                      "const": "v1"
                    },
                    "subset": {
                      "const": "brep"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "CadDrawingsDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed",
        "inserted",
        "moved"
      ],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadDrawingRemoval"
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadDrawingInsertion"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadDrawingRelocation"
          }
        }
      }
    },
    "CadDrawingRemoval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CadDrawingRelocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CadBrepsDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed",
        "inserted",
        "moved"
      ],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadBrepRemoval"
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadBrepInsertion"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadBrepRelocation"
          }
        }
      }
    },
    "CadBrepRemoval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CadBrepRelocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CadModelSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child"
      ],
      "properties": {
        "child": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/CadModelChild"
            }
          ]
        }
      }
    },
    "CadOrientationSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          ]
        }
      }
    },
    "CadScaleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "CadOpacitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "CadReferencePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "mediaKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "orientation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/CadOrientationSet"
            }
          ]
        },
        "scale": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/CadScaleSet"
            }
          ]
        },
        "widthWorld": {
          "type": [
            "number",
            "null"
          ]
        },
        "hidden": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "locked": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "opacity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/CadOpacitySet"
            }
          ]
        }
      }
    },
    "CadReferenceModification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/CadReferencePatch"
        }
      }
    },
    "CadReferencesDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed",
        "inserted",
        "moved",
        "modified"
      ],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadReferenceRemoval"
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadReferenceInsertion"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadReferenceRelocation"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadReferenceModification"
          }
        }
      }
    },
    "CadReferenceRemoval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CadReferenceRelocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CadNodeInsertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "row"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "$ref": "#/$defs/CadNode"
        }
      }
    },
    "CadReferenceInsertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "row"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "$ref": "#/$defs/CadReference"
        }
      }
    },
    "CadDrawingInsertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "row"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "$ref": "#/$defs/CadDrawingChild"
        }
      }
    },
    "CadBrepInsertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "row"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "$ref": "#/$defs/CadBrepChild"
        }
      }
    }
  }
}
