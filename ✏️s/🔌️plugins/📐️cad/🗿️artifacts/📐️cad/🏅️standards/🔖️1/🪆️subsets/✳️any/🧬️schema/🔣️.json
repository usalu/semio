{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/cad/cad/artifact.json",
  "title": "CadArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "objects",
    "buildingObjects",
    "energyObjects",
    "structureClassicObjects",
    "referencesByModelDefinitionId",
    "nodes",
    "activeModelDefinitionId"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadObject"
      },
      "x-semio-state": "artifact"
    },
    "buildingObjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadObject"
      },
      "x-semio-state": "artifact"
    },
    "energyObjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadObject"
      },
      "x-semio-state": "artifact"
    },
    "structureClassicObjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadObject"
      },
      "x-semio-state": "artifact"
    },
    "referencesByModelDefinitionId": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CadReferenceList"
      },
      "x-semio-state": "artifact"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadNode"
      },
      "x-semio-state": "artifact"
    },
    "shapeGeometry": {
      "$ref": "#/$defs/CadGeometry",
      "x-semio-state": "artifact"
    },
    "buildingGeometry": {
      "$ref": "#/$defs/CadGeometry",
      "x-semio-state": "artifact"
    },
    "energyGeometry": {
      "$ref": "#/$defs/CadGeometry",
      "x-semio-state": "artifact"
    },
    "structureClassicGeometry": {
      "$ref": "#/$defs/CadGeometry",
      "x-semio-state": "artifact"
    },
    "activeModelDefinitionId": {
      "type": "string",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "CadObject": {
      "title": "CadObject",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "CadNode": {
      "title": "CadNode",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "CadReferenceList": {
      "title": "CadReferenceList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "CadGeometry": {
      "title": "CadGeometry",
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "CadCamera": {
      "title": "CadCamera",
      "type": "object",
      "additionalProperties": true,
      "properties": {}
    },
    "CadStringList": {
      "title": "CadStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CadObjectsDelta": {
      "title": "CadObjectsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadObject"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CadNodesDelta": {
      "title": "CadNodesDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadNode"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CadRetainedJobs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "owner",
        "documentSchema",
        "payloadSchema",
        "routeCount",
        "excludedFrameworkRoutes",
        "activation",
        "limits",
        "admittedRoutes",
        "routes",
        "laws",
        "hostileSourceMutations"
      ],
      "properties": {
        "owner": {
          "const": "CadPlayApp"
        },
        "documentSchema": {
          "const": "cad.scene"
        },
        "payloadSchema": {
          "const": "cad.scene.tool-command.v1"
        },
        "routeCount": {
          "const": 38
        },
        "excludedFrameworkRoutes": {
          "const": []
        },
        "activation": {
          "const": {
            "controller": "s.cad.cad@1/*#editor",
            "factory": "CadRetainedCommandJobFactory",
            "proofRows": 22,
            "closeItems": 1,
            "closeBytes": 4096
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rawBytes",
            "decodedItems",
            "workItems",
            "outputBytes",
            "stepMicros",
            "closePageBytes"
          ],
          "properties": {
            "rawBytes": {
              "const": 8192
            },
            "decodedItems": {
              "const": 64
            },
            "workItems": {
              "const": 1
            },
            "outputBytes": {
              "const": 16384
            },
            "stepMicros": {
              "const": 7500
            },
            "closePageBytes": {
              "const": 16384
            }
          }
        },
        "admittedRoutes": {
          "const": [
            "addNode",
            "renameNode",
            "patchCadPlayReference",
            "focusModelDefinition",
            "setCamera",
            "setProjection",
            "setProjectionParam",
            "setDislocateOption",
            "setNodeSelection",
            "setReferenceSelection",
            "referenceHover",
            "engagementInput",
            "engagementPossibleSelect",
            "engagementRepeatLast",
            "engagementAbort",
            "worldPointerMove",
            "toggleSun",
            "setSunAzimuth",
            "setSunElevation",
            "setSunIntensity",
            "setContributions",
            "loadRawRequest"
          ]
        },
        "routes": {
          "type": "array",
          "minItems": 38,
          "maxItems": 38,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "intendedLanes",
              "disposition",
              "blocker"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "intendedLanes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "artifact",
                    "config",
                    "child",
                    "hostEffect",
                    "hostDownload"
                  ]
                }
              },
              "disposition": {
                "enum": [
                  "migrated",
                  "batchOnlyPendingRewrite"
                ]
              },
              "blocker": {
                "enum": [
                  "none",
                  "artifactPreparationFactoryMissing",
                  "configPreparationFactoryMissing",
                  "childPublicationUnavailable",
                  "persistentDecodeJobMissing",
                  "persistentSerializationJobMissing"
                ]
              }
            }
          }
        },
        "laws": {
          "const": [
            "ownerLocal",
            "progress",
            "cancel",
            "freshness",
            "ackBeforeClose",
            "incrementalClose",
            "terminalEmpty"
          ]
        },
        "hostileSourceMutations": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "mutation",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "mutation": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "const": "rejected"
              }
            }
          }
        },
        "$schema": {
          "const": "../🧬️schema/🔣️.json#/$defs/CadRetainedJobs"
        }
      },
      "title": "CadRetainedJobs",
      "description": "📐️ The retained interactive-job census of the CAD editor: activation rows, route table and byte budgets.",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
