dialect grammar
grammar cad.document
extension cad
use family-scene
start document

artifact-mark = "cad.cad"
document = artifact-mark doc-body
doc-body = schema-field id-field? active-model-field? references-block? geometry-block* object-table* nodes-table?
schema-field = "schema" "=" {IDENT | TEXT}
id-field = "id" "=" {IDENT | TEXT}
active-model-field = "active-model-definition-id" "=" {IDENT | TEXT}
references-block = "references-by-model-definition-id" "=" reference-map
reference-map = "{" reference-entry* "}"
reference-entry = IDENT "=" reference-list
reference-list = "[" reference-row* "]"
reference-row = "id" "=" IDENT "source-url" "=" TEXT "media-kind" "=" IDENT "origin" "=" coord-tuple "scale" "=" {FLOAT | INT} "width-world" "=" {FLOAT | INT} "hidden" "=" BOOL "locked" "=" BOOL "opacity" "=" {FLOAT | INT}
coord-tuple = "@" {FLOAT | INT} "," {FLOAT | INT} "," {FLOAT | INT} | {FLOAT | INT} "," {FLOAT | INT} "," {FLOAT | INT} | CRD | TUPLE
geometry-block = geometry-name geometry-body
geometry-name = "shape-geometry" | "building-geometry" | "energy-geometry" | "structure-classic-geometry"
geometry-body = "{" brep-block "}"
brep-block = anchors-table? vertices-table? edges-table? wires-table? faces-table? shells-table? solids-table?
anchors-table = "anchors" "=" "[" anchor-row* "]"
anchor-row = "{" "id" "=" TEXT "position" "=" coord-list "}"
coord-list = "[" {FLOAT | INT} {FLOAT | INT} {FLOAT | INT} "]"
vertices-table = "vertices" "=" "[" vertex-row* "]"
vertex-row = "id" "=" IDENT "position" "=" coord-tuple
edges-table = "edges" "=" "[" edge-row* "]"
edge-row = "id" "=" IDENT "vertex-ids" "=" "[" IDENT* "]" curve-block
curve-block = "curve" "{" "kind" "=" IDENT "}"
wires-table = "wires" "=" "[" wire-row* "]"
wire-row = "id" "=" IDENT "edge-ids" "=" "[" IDENT* "]"
faces-table = "faces" "=" "[" face-row* "]"
face-row = "id" "=" IDENT "wire-ids" "=" "[" IDENT* "]" surface-block
surface-block = "surface" "{" "kind" "=" IDENT "origin" "=" coord-tuple "normal" "=" direction-tuple "}"
direction-tuple = "^" {FLOAT | INT} "," {FLOAT | INT} "," {FLOAT | INT}
shells-table = "shells" "=" "[" shell-row* "]"
shell-row = "id" "=" IDENT "face-ids" "=" "[" IDENT* "]"
solids-table = "solids" "=" "[" solid-row* "]"
solid-row = "id" "=" IDENT "shell-ids" "=" "[" IDENT* "]"
object-table = object-table-name typed-object-table
object-table-name = "objects" | "building-objects" | "energy-objects" | "structure-classic-objects"
typed-object-table = "[" object-columns "]" "{" object-row* "}"
object-columns = column+
column = IDENT ":" IDENT
object-row = object-cells
object-cells = IDENT {TEXT | IDENT} {TEXT | IDENT} BOOL BOOL coord-tuple orientation-tuple scale-tuple {TEXT | IDENT} extent-tuple {TEXT | IDENT} primitive-list
orientation-tuple = {FLOAT | INT} "," {FLOAT | INT} "," {FLOAT | INT} "," {FLOAT | INT} | TUPLE
scale-tuple = {FLOAT | INT} "," {FLOAT | INT} "," {FLOAT | INT} | TUPLE
extent-tuple = {FLOAT | INT} "," {FLOAT | INT} "," {FLOAT | INT} | TUPLE
primitive-list = "[" primitive-field* "]" | LIST
primitive-field = {"slot" "=" IDENT} | {"primitive-id" "=" IDENT} | {"kind" "=" IDENT}
nodes-table = "nodes" "[" node-columns "]" "{" node-row* "}"
node-columns = column+
node-row = IDENT {TEXT | IDENT} IDENT
