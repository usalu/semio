{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/mutation/scale-selection/schema.json",
  "title": "ScaleSelection",
  "description": "The `scale-selection` mutation record — internally tagged `\"mutation\": \"scaleSelection\"`: one pane's objects scaled in place by one relative factor per axis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "pane",
    "targets",
    "factors"
  ],
  "properties": {
    "mutation": {
      "const": "scaleSelection",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "pane": {
      "enum": [
        "shape",
        "building",
        "energy",
        "structure-classic"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Model",
          "de": "Modell"
        },
        "description": {
          "en": "The model pane the objects live in.",
          "de": "Der Modellbereich, in dem die Objekte liegen."
        },
        "options": {
          "shape": {
            "en": "Shape",
            "de": "Form"
          },
          "building": {
            "en": "Building",
            "de": "Gebäude"
          },
          "energy": {
            "en": "Energy",
            "de": "Energie"
          },
          "structure-classic": {
            "en": "Structure (classic)",
            "de": "Tragwerk (klassisch)"
          }
        },
        "group": "target",
        "order": 5
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Objects",
          "de": "Objekte"
        },
        "description": {
          "en": "Objects to scale in place; ones the pane lacks are skipped.",
          "de": "Zu skalierende Objekte; im Bereich fehlende werden übersprungen."
        },
        "ref": {
          "kind": "object",
          "domain": "cad",
          "granularity": "object"
        },
        "group": "target",
        "order": 10
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Factors",
          "de": "Faktoren"
        },
        "description": {
          "en": "Factor per axis each object's scale is multiplied by.",
          "de": "Faktor je Achse, mit dem die Skalierung jedes Objekts multipliziert wird."
        },
        "step": 0.1,
        "precision": 3,
        "group": "scale",
        "order": 20
      }
    }
  }
}
