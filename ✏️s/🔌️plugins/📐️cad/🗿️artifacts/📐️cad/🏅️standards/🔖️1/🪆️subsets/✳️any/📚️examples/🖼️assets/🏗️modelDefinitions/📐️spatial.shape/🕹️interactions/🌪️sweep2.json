{
  "schema": "spatial.interaction",
  "id": "surface.sweep2",
  "version": "1.0.0",
  "label": {
    "native": { "en": "Sweep2", "de": "Sweep (2 Schienen)" },
    "reuse": { "en": "Sweep2", "de": "Sweep (2 Schienen)" }
  },
  "interaction": {
    "spatialGroundPick": false,
    "pickDisabledStates": ["idle", "committed"],
    "groundPointerMoveStates": [],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "select_first_rail",
                "key": "s",
                "label": {
                  "native": { "en": "Start", "de": "Start" },
                  "reuse": { "en": "Start", "de": "Start" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [0, 0, 0]
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_first_rail",
        "selection": {
          "accept": ["wire", "edge"],
          "multiple": true,
          "prompt": {
            "native": { "en": "Select first rail", "de": "Erste Schiene auswählen" },
            "reuse": { "en": "Select first rail", "de": "Erste Schiene auswählen" }
          }
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_second_rail",
                "key": "s",
                "label": {
                  "native": { "en": "Select", "de": "Auswählen" },
                  "reuse": { "en": "Select", "de": "Auswählen" }
                },
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "targets"
                      },
                      "key": {
                        "kind": "const",
                        "value": "railA"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_second_rail",
        "selection": {
          "accept": ["wire", "edge"],
          "multiple": true,
          "prompt": {
            "native": { "en": "Select second rail", "de": "Zweite Schiene auswählen" },
            "reuse": { "en": "Select second rail", "de": "Zweite Schiene auswählen" }
          }
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_cross_section_curves",
                "key": "s",
                "label": {
                  "native": { "en": "Select", "de": "Auswählen" },
                  "reuse": { "en": "Select", "de": "Auswählen" }
                },
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "targets"
                      },
                      "key": {
                        "kind": "const",
                        "value": "railB"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_cross_section_curves",
        "selection": {
          "accept": ["wire", "edge"],
          "multiple": true,
          "prompt": {
            "native": { "en": "Select cross-section curves", "de": "Querschnittskurven auswählen" },
            "reuse": { "en": "Select cross-section curves", "de": "Querschnittskurven auswählen" }
          }
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_cross_section_curves",
                "key": "s",
                "label": {
                  "native": { "en": "Select", "de": "Auswählen" },
                  "reuse": { "en": "Select", "de": "Auswählen" }
                },
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "sections"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "sweep2_options_dialog",
                "key": "Enter",
                "label": {
                  "native": { "en": "Finish", "de": "Fertig" },
                  "reuse": { "en": "Finish", "de": "Fertig" }
                }
              }
            ]
          },
          {
            "event": "contextmenu",
            "transitions": [
              {
                "target": "sweep2_options_dialog",
                "key": "RightClick",
                "label": {
                  "native": { "en": "Finish", "de": "Fertig" },
                  "reuse": { "en": "Finish", "de": "Fertig" }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "sweep2_options_dialog",
        "on": [
          {
            "event": "dialog.ok",
            "transitions": [
              {
                "target": "committed",
                "key": "o",
                "label": {
                  "native": { "en": "OK", "de": "OK" },
                  "reuse": { "en": "OK", "de": "OK" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "dialogAccepted"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": true
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "select_first_rail",
        "items": [
          {
            "kind": "label",
            "id": "select_first_rail-prompt",
            "role": "prompt",
            "text": {
              "native": { "en": "Select first rail", "de": "Erste Schiene auswählen" },
              "reuse": { "en": "Select first rail", "de": "Erste Schiene auswählen" }
            },
            "position": {
              "kind": "const",
              "value": [0, 0.25, 1.55]
            }
          },
          {
            "kind": "preview",
            "id": "select_first_rail-preview",
            "role": "preview",
            "previewKind": "rail",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "state": "select_second_rail",
        "items": [
          {
            "kind": "label",
            "id": "select_second_rail-prompt",
            "role": "prompt",
            "text": {
              "native": { "en": "Select second rail", "de": "Zweite Schiene auswählen" },
              "reuse": { "en": "Select second rail", "de": "Zweite Schiene auswählen" }
            },
            "position": {
              "kind": "const",
              "value": [0, 0.25, 1.55]
            }
          },
          {
            "kind": "preview",
            "id": "select_second_rail-preview",
            "role": "preview",
            "previewKind": "rail",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "state": "select_cross_section_curves",
        "items": [
          {
            "kind": "label",
            "id": "select_cross_section_curves-prompt",
            "role": "prompt",
            "text": {
              "native": { "en": "Select cross-section curves", "de": "Querschnittskurven auswählen" },
              "reuse": { "en": "Select cross-section curves", "de": "Querschnittskurven auswählen" }
            },
            "position": {
              "kind": "const",
              "value": [0, 0.25, 1.55]
            }
          },
          {
            "kind": "preview",
            "id": "select_cross_section_curves-preview",
            "role": "preview",
            "previewKind": "cross-sections",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "sections"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "state": "sweep2_options_dialog",
        "items": [
          {
            "kind": "label",
            "id": "sweep2_options_dialog-prompt",
            "role": "prompt",
            "text": {
              "native": { "en": "Sweep2 options", "de": "Sweep2-Optionen" },
              "reuse": { "en": "Sweep2 options", "de": "Sweep2-Optionen" }
            },
            "position": {
              "kind": "const",
              "value": [0, 0.25, 1.55]
            }
          },
          {
            "kind": "preview",
            "id": "sweep2_options_dialog-preview",
            "role": "preview",
            "previewKind": "dialog",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
