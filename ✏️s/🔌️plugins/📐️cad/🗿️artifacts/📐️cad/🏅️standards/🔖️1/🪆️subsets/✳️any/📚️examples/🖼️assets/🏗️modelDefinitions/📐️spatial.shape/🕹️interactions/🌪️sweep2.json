                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "fromStates": ["ready"],
    "operation": {
      "kind": "action",
      "action": "command.finish",
      "params": {
        "commandId": {
          "kind": "const",
          "value": "surface.sweep2"
        },
        "resultKind": {
          "kind": "const",
          "value": "sweptSurface"
        }
      }
    }
  },
  "key": "q",
  "produces": {
    "typology": "spatial.shape.surface.sweep2"
  }
}
