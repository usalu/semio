{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceReferenceMedia",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelDefinitionId",
    "newMediaKind",
    "newSourceUrl",
    "referenceId"
  ],
  "properties": {
    "modelDefinitionId": {
      "type": "string"
    },
    "referenceId": {
      "type": "string"
    },
    "newSourceUrl": {
      "type": "string"
    },
    "newMediaKind": {
      "type": "string"
    },
    "newOrientation": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "newScale": {
      "type": "number"
    },
    "newOpacity": {
      "type": "number"
    }
  }
}
