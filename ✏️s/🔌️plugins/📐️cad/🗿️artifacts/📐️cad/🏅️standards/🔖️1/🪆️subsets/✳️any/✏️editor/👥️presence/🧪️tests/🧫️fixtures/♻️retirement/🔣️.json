{
  "grant": {
    "maximumItems": 1,
    "maximumBytes": 4096
  },
  "cases": [
    {
      "name": "empty",
      "engagementStep": {
        "unit": "",
        "repeat": 0
      },
      "engagementPane": null,
      "expectedBytes": 0
    },
    {
      "name": "default",
      "engagementStep": {
        "unit": "Idle",
        "repeat": 1
      },
      "engagementPane": null,
      "expectedBytes": 4
    },
    {
      "name": "large-unicode",
      "engagementStep": {
        "unit": "🧵",
        "repeat": 2048
      },
      "engagementPane": {
        "unit": "ä",
        "repeat": 4096
      },
      "expectedBytes": 16384
    }
  ],
  "storeCases": [
    {
      "name": "local-only",
      "local": "default",
      "peers": [],
      "sharedRoot": false,
      "expectedBytes": 4
    },
    {
      "name": "nonempty-shared-roster",
      "local": "large-unicode",
      "peers": [
        {
          "actor": "peer-a",
          "presence": "default"
        },
        {
          "actor": "peer-b",
          "presence": "large-unicode"
        }
      ],
      "sharedRoot": true,
      "expectedBytes": 32784
    }
  ]
}
