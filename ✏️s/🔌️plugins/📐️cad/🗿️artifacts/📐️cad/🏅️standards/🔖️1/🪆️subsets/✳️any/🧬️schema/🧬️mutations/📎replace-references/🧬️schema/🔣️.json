{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/mutation/replace-references/schema.json",
  "title": "ReplaceReferences",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "modelDefinitionId",
    "references"
  ],
  "properties": {
    "mutation": {
      "const": "replaceReferences"
    },
    "modelDefinitionId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Model definition",
          "de": "Modelldefinition"
        },
        "description": {
          "en": "Id of the model the reference belongs to, e.g. aec.building.",
          "de": "ID des Modells, zu dem die Referenz gehört, z. B. aec.building."
        },
        "group": "target",
        "order": 10
      }
    },
    "references": {
      "type": "array",
      "items": {
        "title": "CadReference",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hidden",
          "id",
          "locked",
          "mediaKind",
          "origin",
          "sourceUrl",
          "widthWorld"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-semio-ui": {
              "widget": "text",
              "role": "value",
              "label": {
                "en": "ID",
                "de": "ID"
              },
              "description": {
                "en": "Unique reference id in this model.",
                "de": "Eindeutige Referenz-ID in diesem Modell."
              },
              "group": "identity",
              "order": 10
            }
          },
          "sourceUrl": {
            "type": "string",
            "x-semio-ui": {
              "widget": "text",
              "role": "value",
              "label": {
                "en": "Source URL",
                "de": "Quell-URL"
              },
              "description": {
                "en": "Address of the file, e.g. an https or data URL.",
                "de": "Adresse der Datei, z. B. eine https- oder data-URL."
              },
              "group": "source",
              "order": 20
            }
          },
          "mediaKind": {
            "type": "string",
            "x-semio-ui": {
              "widget": "text",
              "role": "value",
              "label": {
                "en": "Media kind",
                "de": "Medienart"
              },
              "description": {
                "en": "For example image or drawing.",
                "de": "Zum Beispiel image (Bild) oder drawing (Zeichnung)."
              },
              "group": "source",
              "order": 30
            }
          },
          "origin": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "x-semio-ui": {
              "widget": "vector",
              "role": "value",
              "label": {
                "en": "Origin",
                "de": "Ursprung"
              },
              "step": 0.1,
              "group": "pose",
              "order": 40,
              "snapSource": {
                "step": true
              }
            }
          },
          "orientation": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4,
            "x-semio-ui": {
              "widget": "vector",
              "role": "value",
              "label": {
                "en": "Orientation",
                "de": "Orientierung"
              },
              "description": {
                "en": "Unit quaternion (x, y, z, w); (0, 0, 0, 1) is no rotation.",
                "de": "Einheitsquaternion (x, y, z, w); (0, 0, 0, 1) ist keine Drehung."
              },
              "step": 0.01,
              "group": "pose",
              "order": 50
            }
          },
          "scale": {
            "type": [
              "number",
              "null"
            ],
            "x-semio-ui": {
              "widget": "slider",
              "role": "value",
              "label": {
                "en": "Scale",
                "de": "Skalierung"
              },
              "description": {
                "en": "Uniform factor applied to the image plane.",
                "de": "Einheitlicher Faktor für die Bildebene."
              },
              "step": 0.01,
              "precision": 2,
              "softMin": 0.1,
              "softMax": 10,
              "scale": "log",
              "snaps": [
                0.25,
                0.5,
                1,
                2,
                4
              ],
              "group": "pose",
              "order": 60
            }
          },
          "widthWorld": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-semio-ui": {
              "widget": "stepper",
              "role": "value",
              "label": {
                "en": "Width",
                "de": "Breite"
              },
              "description": {
                "en": "Width of the reference plane in the world.",
                "de": "Breite der Referenzebene in der Welt."
              },
              "step": 0.1,
              "precision": 3,
              "group": "geometry",
              "order": 70
            }
          },
          "hidden": {
            "type": "boolean",
            "x-semio-ui": {
              "widget": "toggle",
              "role": "value",
              "label": {
                "en": "Hidden",
                "de": "Ausgeblendet"
              },
              "group": "state",
              "order": 80
            }
          },
          "locked": {
            "type": "boolean",
            "x-semio-ui": {
              "widget": "toggle",
              "role": "value",
              "label": {
                "en": "Locked",
                "de": "Gesperrt"
              },
              "group": "state",
              "order": 90
            }
          },
          "opacity": {
            "type": [
              "number",
              "null"
            ],
            "x-semio-ui": {
              "widget": "slider",
              "role": "value",
              "label": {
                "en": "Opacity",
                "de": "Deckkraft"
              },
              "displayUnit": "%",
              "displayFactor": 100,
              "step": 0.01,
              "precision": 2,
              "softMin": 0,
              "softMax": 1,
              "snaps": [
                0,
                0.25,
                0.5,
                0.75,
                1
              ],
              "group": "appearance",
              "order": 100
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "References",
          "de": "Referenzen"
        },
        "description": {
          "en": "The complete reference list of the model.",
          "de": "Die vollständige Referenzliste des Modells."
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
