{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/mutation/rotate-selection/schema.json",
  "title": "RotateSelection",
  "description": "The `rotate-selection` mutation record — internally tagged `\"mutation\": \"rotateSelection\"`: one pane's objects turned in place about one world axis by one relative angle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "pane",
    "targets",
    "axis",
    "angle"
  ],
  "x-semio-invariant": [
    {
      "id": "axis-nonzero",
      "description": {
        "en": "The rotation axis has a non-zero length.",
        "de": "Die Drehachse hat eine von null verschiedene Länge."
      }
    }
  ],
  "properties": {
    "mutation": {
      "const": "rotateSelection",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "pane": {
      "enum": [
        "shape",
        "building",
        "energy",
        "structure-classic"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Model",
          "de": "Modell"
        },
        "description": {
          "en": "The model pane the objects live in.",
          "de": "Der Modellbereich, in dem die Objekte liegen."
        },
        "options": {
          "shape": {
            "en": "Shape",
            "de": "Form"
          },
          "building": {
            "en": "Building",
            "de": "Gebäude"
          },
          "energy": {
            "en": "Energy",
            "de": "Energie"
          },
          "structure-classic": {
            "en": "Structure (classic)",
            "de": "Tragwerk (klassisch)"
          }
        },
        "group": "target",
        "order": 5
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Objects",
          "de": "Objekte"
        },
        "description": {
          "en": "Objects to turn in place; ones the pane lacks are skipped.",
          "de": "Zu drehende Objekte; im Bereich fehlende werden übersprungen."
        },
        "ref": {
          "kind": "object",
          "domain": "cad",
          "granularity": "object"
        },
        "group": "target",
        "order": 10
      }
    },
    "axis": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Axis",
          "de": "Achse"
        },
        "description": {
          "en": "World axis to turn about; its length is ignored.",
          "de": "Weltachse der Drehung; ihre Länge spielt keine Rolle."
        },
        "step": 0.1,
        "precision": 3,
        "group": "rotation",
        "order": 20
      }
    },
    "angle": {
      "type": "number",
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "Angle",
          "de": "Winkel"
        },
        "description": {
          "en": "Right-handed rotation about the axis.",
          "de": "Rechtshändige Drehung um die Achse."
        },
        "unit": "rad",
        "displayUnit": "deg",
        "displayFactor": 57.29577951308232,
        "step": 0.017453292519943295,
        "softMin": -3.141592653589793,
        "softMax": 3.141592653589793,
        "snaps": [
          -3.141592653589793,
          -1.5707963267948966,
          0,
          1.5707963267948966,
          3.141592653589793
        ],
        "group": "rotation",
        "order": 30
      }
    }
  }
}
