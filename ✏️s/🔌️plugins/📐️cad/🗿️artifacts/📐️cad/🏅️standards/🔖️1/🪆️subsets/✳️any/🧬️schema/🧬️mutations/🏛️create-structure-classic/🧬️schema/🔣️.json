{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/mutation/create-structure-classic-model/schema.json",
  "title": "CreateStructureClassicModel",
  "x-semio-invariant": [
    {
      "id": "child-identity",
      "description": {
        "en": "A composed child's id equals its target artifact id, and the target uses the s.stdio.semio@v1 dialect of the expected subset.",
        "de": "Die Id eines eingebetteten Kindes entspricht der Artefakt-Id seines Ziels, und das Ziel verwendet den Dialekt s.stdio.semio@v1 des erwarteten Subsets."
      }
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "childId",
    "target"
  ],
  "properties": {
    "mutation": {
      "const": "createStructureClassicModel"
    },
    "childId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Child ID",
          "de": "Kind-ID"
        },
        "description": {
          "en": "Id of the child model document this slot holds.",
          "de": "ID des Kind-Modelldokuments in diesem Platz."
        },
        "group": "identity",
        "order": 10
      }
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Target artifact",
          "de": "Zielartefakt"
        },
        "description": {
          "en": "Reference URI of the child model artifact (id!type@version/subset).",
          "de": "Referenz-URI des Kind-Modellartefakts (id!typ@version/teilmenge)."
        },
        "group": "identity",
        "order": 20
      }
    }
  }
}
