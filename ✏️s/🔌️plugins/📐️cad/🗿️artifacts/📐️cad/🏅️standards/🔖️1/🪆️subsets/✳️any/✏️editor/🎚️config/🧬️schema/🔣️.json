{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/cad/cad/config/schema.json",
  "title": "CadConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedNodeIds",
    "engagementInput",
    "engagementStep",
    "engagementPreviewGeneration",
    "contributionsJson"
  ],
  "properties": {
    "selectedNodeIds": {
      "type": "array",
      "items": { "type": "string" },
      "x-semio-state": "config"
    },
    "hoveredReferenceId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "engagementStep": {
      "type": "string",
      "x-semio-state": "config"
    },
    "activeExampleId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "selectedReferenceModelDefinitionId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "selectedReferenceId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "engagementPane": {
      "type": "string",
      "x-semio-state": "config"
    },
    "engagementSessionJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "engagementPreviewOperationJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    },
    "engagementPreviewGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "x-semio-state": "config"
    },
    "lastFinalizedInteractionId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "contributionsJson": {
      "type": "string",
      "x-semio-state": "config"
    }
  }
}
