dialect grammar
grammar cad.op
extension cad
use family-scene
start mutation

mutation = op-line+
op-line = create-shape-model | delete-shape-model | create-building-model | delete-building-model | create-energy-model | delete-energy-model | create-structure-classic-model | delete-structure-classic-model | create-drawing | delete-drawing | create-node | delete-node | rename-node | change-reference-hidden | change-reference-locked | change-reference-width | move-reference | replace-reference-media | replace-references | change-active-model-definition
create-shape-model = "create-shape-model" "child-id" "=" IDENT "target" "=" TEXT
delete-shape-model = "delete-shape-model"
create-building-model = "create-building-model" "child-id" "=" IDENT "target" "=" TEXT
delete-building-model = "delete-building-model"
create-energy-model = "create-energy-model" "child-id" "=" IDENT "target" "=" TEXT
delete-energy-model = "delete-energy-model"
create-structure-classic-model = "create-structure-classic-model" "child-id" "=" IDENT "target" "=" TEXT
delete-structure-classic-model = "delete-structure-classic-model"
create-drawing = "create-drawing" "child-id" "=" IDENT "target" "=" TEXT
delete-drawing = "delete-drawing" "child-id" "=" IDENT
create-node = "create-node" node-block
delete-node = "delete-node" "node-id" "=" IDENT
rename-node = "rename-node" "node-id" "=" IDENT "new-label" "=" TEXT
change-reference-hidden = "change-reference-hidden" "model-definition-id" "=" IDENT "reference-id" "=" IDENT "new-hidden" "=" BOOL
change-reference-locked = "change-reference-locked" "model-definition-id" "=" IDENT "reference-id" "=" IDENT "new-locked" "=" BOOL
change-reference-width = "change-reference-width" "model-definition-id" "=" IDENT "reference-id" "=" IDENT "new-width-world" "=" FLOAT
move-reference = "move-reference" "model-definition-id" "=" IDENT "reference-id" "=" IDENT "new-origin" "=" coord-tuple
replace-reference-media = "replace-reference-media" "model-definition-id" "=" IDENT "reference-id" "=" IDENT "new-source-url" "=" TEXT "new-media-kind" "=" IDENT new-orientation-field? new-scale-field? new-opacity-field?
replace-references = "replace-references" "model-definition-id" "=" IDENT reference-list-block
change-active-model-definition = "change-active-model-definition" "new-model-definition-id" "=" IDENT
node-block = "node" "id" "=" IDENT "label" "=" TEXT "kind" "=" IDENT
new-orientation-field = "new-orientation" "=" orientation-tuple
new-scale-field = "new-scale" "=" FLOAT
new-opacity-field = "new-opacity" "=" FLOAT
reference-list-block = "references" reference-list
reference-list = "[" reference-row* "]"
reference-row = "id" "=" IDENT "source-url" "=" TEXT "media-kind" "=" IDENT "origin" "=" coord-tuple orientation-field? reference-scale-field? "width-world" "=" FLOAT "hidden" "=" BOOL "locked" "=" BOOL opacity-field?
orientation-field = "orientation" "=" orientation-tuple
reference-scale-field = "scale" "=" FLOAT
opacity-field = "opacity" "=" FLOAT
coord-tuple = CRD | TUPLE
orientation-tuple = TUPLE
