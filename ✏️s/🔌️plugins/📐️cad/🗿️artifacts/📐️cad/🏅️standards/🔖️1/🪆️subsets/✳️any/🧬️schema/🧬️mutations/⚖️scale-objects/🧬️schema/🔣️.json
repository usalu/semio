{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/mutation/scale-objects/schema.json",
  "title": "ScaleObjects",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "pane",
    "placements"
  ],
  "properties": {
    "mutation": {
      "const": "scaleObjects"
    },
    "pane": {
      "enum": [
        "shape",
        "building",
        "energy",
        "structure-classic"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Model",
          "de": "Modell"
        },
        "description": {
          "en": "The model pane the objects live in.",
          "de": "Der Modellbereich, in dem die Objekte liegen."
        },
        "options": {
          "shape": {
            "en": "Shape",
            "de": "Form"
          },
          "building": {
            "en": "Building",
            "de": "Gebäude"
          },
          "energy": {
            "en": "Energy",
            "de": "Energie"
          },
          "structure-classic": {
            "en": "Structure (classic)",
            "de": "Tragwerk (klassisch)"
          }
        },
        "group": "target",
        "order": 5
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "title": "CadObjectScale",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objectId",
          "newScale"
        ],
        "properties": {
          "objectId": {
            "type": "string",
            "x-semio-ui": {
              "widget": "reference",
              "role": "target",
              "label": {
                "en": "Object",
                "de": "Objekt"
              },
              "description": {
                "en": "The object this mutation addresses.",
                "de": "Das Objekt, das diese Mutation adressiert."
              },
              "ref": {
                "kind": "object",
                "domain": "cad",
                "granularity": "object"
              },
              "group": "target",
              "order": 10
            }
          },
          "newScale": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "x-semio-ui": {
              "widget": "vector",
              "role": "value",
              "label": {
                "en": "Scale",
                "de": "Skalierung"
              },
              "description": {
                "en": "Absolute final factor per axis; zero is refused.",
                "de": "Absoluter End-Faktor je Achse; null wird abgelehnt."
              },
              "step": 0.1,
              "group": "pose",
              "order": 20
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Placements",
          "de": "Platzierungen"
        },
        "description": {
          "en": "One absolute scale per scaled object.",
          "de": "Eine absolute Skalierung je skaliertem Objekt."
        },
        "group": "placement",
        "order": 20
      }
    }
  }
}
