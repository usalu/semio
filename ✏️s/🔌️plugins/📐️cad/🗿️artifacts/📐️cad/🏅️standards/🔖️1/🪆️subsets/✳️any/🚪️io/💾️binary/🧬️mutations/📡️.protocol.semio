record delete-structure-classic-model tag=7
field payload bytes
record create-drawing tag=8
field child-id utf8
field target bytes
field index varint optional
record delete-drawing tag=9
field child-id utf8
record create-node tag=10
field node bytes
field index varint optional
record delete-node tag=11
field node-id utf8
record rename-node tag=12
field node-id utf8
field new-label utf8
record change-reference-hidden tag=13
field model-definition-id utf8
field reference-id utf8
field new-hidden u8
record change-reference-locked tag=14
