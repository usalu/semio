{
  "schema": "spatial.interaction",
  "id": "curve.polyline",
  "version": "1.0.0",
  "label": {
    "native": { "en": "Polyline", "de": "Polylinie" },
    "reuse": { "en": "Polyline", "de": "Polylinie" }
  },
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": ["idle", "committed"],
    "groundPointerMoveStates": ["start_of_polyline", "next_point_of_polyline"],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null,
    "lengthEntry": [
      {
        "state": "next_point_of_polyline",
        "anchor": "points.@last",
        "field": "cursor",
        "control": "stepper",
        "min": 0,
        "step": 0.1,
        "unit": "m"
      }
    ]
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "start_of_polyline",
                "key": "s",
                "label": {
                  "native": { "en": "Start", "de": "Start" },
                  "reuse": { "en": "Start", "de": "Start" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [0, 0, 0]
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "start_of_polyline",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "next_point_of_polyline",
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "next_point_of_polyline",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "next_point_of_polyline",
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "close",
            "transitions": [
              {
                "target": "committed",
                "key": "c",
                "label": {
                  "native": { "en": "Close", "de": "Schließen" },
                  "reuse": { "en": "Close", "de": "Schließen" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "closed"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": true
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "committed",
                "key": "Enter",
                "label": {
                  "native": { "en": "Finish", "de": "Fertig" },
                  "reuse": { "en": "Finish", "de": "Fertig" }
                }
              }
            ]
          },
          {
            "event": "contextmenu",
            "transitions": [
              {
                "target": "committed",
                "key": "RightClick",
                "label": {
                  "native": { "en": "Finish", "de": "Fertig" },
                  "reuse": { "en": "Finish", "de": "Fertig" }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "start_of_polyline",
        "items": [
          {
            "kind": "label",
            "id": "start_of_polyline-prompt",
            "role": "prompt",
            "text": {
              "native": { "en": "Start of polyline", "de": "Anfang der Polylinie" },
              "reuse": { "en": "Start of polyline", "de": "Anfang der Polylinie" }
            },
            "position": {
              "kind": "const",
              "value": [0, 0.25, 1.55]
            }
          },
          {
            "kind": "preview",
            "id": "start_of_polyline-preview",
            "role": "preview",
            "previewKind": "point",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "start_of_polyline-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "start_of_polyline-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "prevPoint"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      },
      {
        "state": "next_point_of_polyline",
        "items": [
          {
            "kind": "label",
            "id": "next_point_of_polyline-prompt",
            "role": "prompt",
            "text": {
              "native": { "en": "Next point of polyline", "de": "Nächster Punkt der Polylinie" },
              "reuse": { "en": "Next point of polyline", "de": "Nächster Punkt der Polylinie" }
            },
            "position": {
              "kind": "const",
              "value": [0, 0.25, 1.55]
            }
          },
          {
            "kind": "preview",
            "id": "next_point_of_polyline-preview",
            "role": "preview",
            "previewKind": "polyline",
            "params": {
              "cursor": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "cursor"
                  }
                ]
              },
              "prevPoint": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "prevPoint"
                  }
                ]
              },
              "points": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "points"
                  }
                ]
              },
              "targets": {
                "kind": "path",
                "root": "context",
                "segments": [
                  {
                    "kind": "field",
                    "name": "targets"
                  }
                ]
              }
            }
          },
          {
            "kind": "point",
            "id": "next_point_of_polyline-cursor",
            "role": "cursor",
            "position": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          },
          {
            "kind": "segment",
            "id": "next_point_of_polyline-rubber",
            "role": "preview",
            "from": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "prevPoint"
                }
              ]
            },
            "to": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "cursor"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "fromStates": ["ready"],
    "operation": {
      "kind": "action",
      "action": "curve.polyline",
      "params": {
        "points": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "points"
            }
          ]
        }
      }
    }
  },
  "key": "p",
  "produces": {
    "typology": "spatial.shape.curve.polyline"
  }
}
