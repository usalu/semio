{
  "schema": "spatial.interaction",
  "id": "feature.offsetSurface",
  "version": "1.0.0",
  "label": {
    "native": { "en": "OffsetSurface", "de": "Fläche versetzen" },
    "reuse": { "en": "OffsetSurface", "de": "Fläche versetzen" }
  },
  "key": "o",
  "interaction": {
    "spatialGroundPick": false,
    "pickDisabledStates": ["idle", "selectSurface", "setDistance", "committed"],
    "groundPointerMoveStates": [],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null
  },
  "requires": {
    "kernel": {
      "operations": ["face.resolveIds", "face.offset", "entity.tessellate"]
    }
  },
  "guards": [
    {
      "name": "hasSurfaceAndDistance",
      "expr": {
        "kind": "all",
        "args": [
          {
            "kind": "exists",
            "target": {
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "surfaceId"
                }
              ]
            }
          },
          {
            "kind": "exists",
            "target": {
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "distance"
                }
              ]
            }
          },
          {
            "kind": "binop",
            "operation": "!=",
            "left": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "distance"
                }
              ]
            },
            "right": {
              "kind": "const",
              "value": 0
            }
          }
        ]
      }
    }
  ],
  "machine": {
    "initial": "selectSurface",
    "states": [
      {
        "name": "selectSurface",
        "selection": {
          "accept": ["face"],
          "multiple": false,
          "prompt": {
            "native": { "en": "Pick face", "de": "Seitenfläche wählen" },
            "reuse": { "en": "Pick face", "de": "Seitenfläche wählen" }
          }
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "setDistance",
                "key": "i",
                "label": {
                  "native": { "en": "Pick surface", "de": "Fläche wählen" },
                  "reuse": { "en": "Pick surface", "de": "Fläche wählen" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "surfaceId"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        },
                        {
                          "kind": "index",
                          "index": 0
                        },
                        {
                          "kind": "field",
                          "name": "id"
                        }
                      ]
                    }
                  },
                  {
                    "mutation": "kernel.query",
                    "query": "face.resolveIds",
                    "assignTo": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "resolvedFaceIds"
                        }
                      ]
                    },
                    "params": {
                      "kind": "face.resolveIds",
                      "faceId": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          },
                          {
                            "kind": "index",
                            "index": 0
                          },
                          {
                            "kind": "field",
                            "name": "id"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "selectSurface",
                "key": "x",
                "label": {
                  "native": { "en": "Cancel", "de": "Abbrechen" },
                  "reuse": { "en": "Cancel", "de": "Abbrechen" }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "setDistance",
        "on": [
          {
            "event": "set.distance",
            "transitions": [
              {
                "key": "n",
                "label": {
                  "native": { "en": "Apply offset", "de": "Versatz anwenden" },
                  "reuse": { "en": "Apply offset", "de": "Versatz anwenden" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "distance"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "value"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "committed",
                "guard": "hasSurfaceAndDistance",
                "key": "Enter",
                "label": {
                  "native": { "en": "Commit offset", "de": "Versatz übernehmen" },
                  "reuse": { "en": "Commit offset", "de": "Versatz übernehmen" }
                }
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "selectSurface",
                "key": "x",
                "label": {
                  "native": { "en": "Cancel", "de": "Abbrechen" },
                  "reuse": { "en": "Cancel", "de": "Abbrechen" }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "setDistance",
        "items": [
          {
            "kind": "entity-highlight",
            "id": "surface",
            "role": "semantic-selection",
            "geometryEntityKind": "face",
            "entityId": {
              "kind": "path",
              "root": "context",
              "segments": [
                {
                  "kind": "field",
                  "name": "surfaceId"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "commit": {
    "when": "hasSurfaceAndDistance",
    "fromStates": ["setDistance", "committed"],
    "operation": {
      "kind": "action",
      "action": "feature.offsetFaces",
      "params": {
        "faceIds": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "resolvedFaceIds"
            }
          ]
        },
        "distance": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "distance"
            }
          ]
        }
      }
    }
  },
  "produces": {
    "typology": "spatial.shape.feature.offset-surface"
  }
}
