{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/mutation/move-reference/schema.json",
  "title": "MoveReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelDefinitionId",
    "newOrigin",
    "referenceId"
  ],
  "properties": {
    "modelDefinitionId": {
      "type": "string"
    },
    "referenceId": {
      "type": "string"
    },
    "newOrigin": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
