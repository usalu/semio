{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/mutation/move-reference/schema.json",
  "title": "MoveReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "modelDefinitionId",
    "newOrigin",
    "referenceId"
  ],
  "properties": {
    "mutation": {
      "const": "moveReference"
    },
    "modelDefinitionId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Model definition",
          "de": "Modelldefinition"
        },
        "description": {
          "en": "Id of the model the reference belongs to, e.g. aec.building.",
          "de": "ID des Modells, zu dem die Referenz gehört, z. B. aec.building."
        },
        "group": "target",
        "order": 10
      }
    },
    "referenceId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Reference",
          "de": "Referenz"
        },
        "description": {
          "en": "The reference image this mutation addresses.",
          "de": "Das Referenzbild, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "reference"
        },
        "group": "target",
        "order": 20
      }
    },
    "newOrigin": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Origin",
          "de": "Ursprung"
        },
        "description": {
          "en": "Absolute final origin in the world.",
          "de": "Absoluter Endursprung in der Welt."
        },
        "step": 0.1,
        "group": "pose",
        "order": 30,
        "snapSource": {
          "step": true
        }
      }
    }
  }
}
