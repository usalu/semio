  "commit": {
    "when": "hasConstructMode",
    "fromStates": ["committed"],
    "operation": {
      "kind": "action",
      "action": "energy.energy.constructRoofFrom2PointsAndHeight",
      "params": {
        "typology": {
          "kind": "const",
          "value": "energy.energy.roof"
        },
        "constructMode": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "constructMode"
            }
          ]
        },
        "pointA": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "pointA"
            }
          ]
        },
        "pointB": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "pointB"
            }
          ]
        },
        "height": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "height"
            }
          ]
        },
        "wireId": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "wireId"
            }
          ]
        },
        "wireIds": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "wireIds"
            }
          ]
        },
        "curves": {
          "kind": "path",
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "curves"
            }
          ]
        },
        "points": {
