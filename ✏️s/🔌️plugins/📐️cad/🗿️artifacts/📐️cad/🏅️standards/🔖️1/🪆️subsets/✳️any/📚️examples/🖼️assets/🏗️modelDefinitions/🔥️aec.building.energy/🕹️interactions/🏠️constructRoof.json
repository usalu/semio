            "text": {
              "native": { "en": "Construct Roof: set height (Apply height or Accept)", "de": "Dach konstruieren: Höhe festlegen (Höhe übernehmen oder bestätigen)" },
              "reuse": { "en": "Construct Roof: set height (Apply height or Accept)", "de": "Dach konstruieren: Höhe festlegen (Höhe übernehmen oder bestätigen)" }
