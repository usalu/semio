{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/cad/cad/mutation/create-object/schema.json",
  "title": "CreateObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "object",
    "pane",
    "primitives"
  ],
  "properties": {
    "mutation": {
      "const": "createObject"
    },
    "pane": {
      "enum": [
        "shape",
        "building",
        "energy",
        "structure-classic"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Model",
          "de": "Modell"
        },
        "description": {
          "en": "The model pane the objects live in.",
          "de": "Der Modellbereich, in dem die Objekte liegen."
        },
        "options": {
          "shape": {
            "en": "Shape",
            "de": "Form"
          },
          "building": {
            "en": "Building",
            "de": "Gebäude"
          },
          "energy": {
            "en": "Energy",
            "de": "Energie"
          },
          "structure-classic": {
            "en": "Structure (classic)",
            "de": "Tragwerk (klassisch)"
          }
        },
        "group": "target",
        "order": 5
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Index",
          "de": "Index"
        },
        "description": {
          "en": "Position in the list; the end when omitted.",
          "de": "Position in der Liste; ohne Angabe am Ende."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 20
      }
    },
    "object": {
      "title": "CadObjectSpec",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "locked",
        "origin",
        "typology",
        "visible"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique object id in this pane.",
              "de": "Eindeutige Objekt-ID in diesem Bereich."
            },
            "group": "identity",
            "order": 10
          }
        },
        "label": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Label",
              "de": "Bezeichnung"
            },
            "group": "identity",
            "order": 20
          }
        },
        "typology": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Typology",
              "de": "Typologie"
            },
            "description": {
              "en": "Building element typology, e.g. building.building.wall.",
              "de": "Bauteiltypologie, z. B. building.building.wall."
            },
            "group": "kind",
            "order": 30
          }
        },
        "visible": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Visible",
              "de": "Sichtbar"
            },
            "group": "state",
            "order": 40
          }
        },
        "locked": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Locked",
              "de": "Gesperrt"
            },
            "group": "state",
            "order": 50
          }
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Origin",
              "de": "Ursprung"
            },
            "step": 0.1,
            "group": "pose",
            "order": 60,
            "snapSource": {
              "step": true
            }
          }
        },
        "orientation": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Orientation",
              "de": "Orientierung"
            },
            "description": {
              "en": "Unit quaternion (x, y, z, w); (0, 0, 0, 1) is no rotation.",
              "de": "Einheitsquaternion (x, y, z, w); (0, 0, 0, 1) ist keine Drehung."
            },
            "step": 0.01,
            "group": "pose",
            "order": 70
          }
        },
        "scale": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Scale",
              "de": "Skalierung"
            },
            "description": {
              "en": "Factor per axis (x, y, z).",
              "de": "Faktor je Achse (x, y, z)."
            },
            "step": 0.1,
            "group": "pose",
            "order": 80
          }
        },
        "meshUrl": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Mesh URL",
              "de": "Mesh-URL"
            },
            "description": {
              "en": "Address of the file, e.g. an https or data URL.",
              "de": "Adresse der Datei, z. B. eine https- oder data-URL."
            },
            "group": "source",
            "order": 90
          }
        },
        "extent": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Extent",
              "de": "Ausdehnung"
            },
            "description": {
              "en": "Size of the bounding box along x, y and z.",
              "de": "Größe des Hüllquaders entlang x, y und z."
            },
            "step": 0.1,
            "group": "geometry",
            "order": 100
          }
        },
        "solidHandle": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Solid",
              "de": "Volumenkörper"
            },
            "description": {
              "en": "Handle of the boundary-representation solid.",
              "de": "Handle des Volumenkörpers in Begrenzungsflächendarstellung."
            },
            "group": "source",
            "order": 110
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The authored fields of the new object.",
          "de": "Die festgelegten Felder des neuen Objekts."
        },
        "group": "record",
        "order": 30
      }
    },
    "primitives": {
      "type": "array",
      "items": {
        "title": "CadObjectPrimitive",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "primitiveId",
          "slot"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "x-semio-ui": {
              "widget": "text",
              "role": "value",
              "label": {
                "en": "Slot",
                "de": "Platz"
              },
              "group": "identity",
              "order": 10
            }
          },
          "primitiveId": {
            "type": "string",
            "x-semio-ui": {
              "widget": "text",
              "role": "value",
              "label": {
                "en": "Primitive ID",
                "de": "Grundkörper-ID"
              },
              "group": "identity",
              "order": 20
            }
          },
          "kind": {
            "type": "string",
            "x-semio-ui": {
              "widget": "text",
              "role": "value",
              "label": {
                "en": "Kind",
                "de": "Art"
              },
              "group": "kind",
              "order": 30
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Primitives",
          "de": "Grundkörper"
        },
        "description": {
          "en": "Geometry slots of the object; empty uses its solid.",
          "de": "Geometrieplätze des Objekts; leer nutzt seinen Volumenkörper."
        },
        "group": "record",
        "order": 40
      }
    }
  }
}
