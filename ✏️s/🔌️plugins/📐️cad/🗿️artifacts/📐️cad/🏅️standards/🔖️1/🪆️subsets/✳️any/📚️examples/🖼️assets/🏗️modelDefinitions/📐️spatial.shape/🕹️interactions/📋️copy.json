{
  "schema": "spatial.interaction",
  "id": "transform.copy",
  "version": "1.0.0",
  "label": {
    "native": { "en": "Copy", "de": "Kopieren" },
    "reuse": { "en": "Copy", "de": "Kopieren" }
  },
  "guards": [
    {
      "name": "hasCopyFrom",
      "expr": {
        "kind": "exists",
        "target": {
          "root": "context",
          "segments": [
            {
              "kind": "field",
              "name": "from"
            }
          ]
        }
      }
    },
    {
      "name": "noCopyFrom",
      "expr": {
        "kind": "not",
        "arg": {
          "kind": "exists",
          "target": {
            "root": "context",
            "segments": [
              {
                "kind": "field",
                "name": "from"
              }
            ]
          }
        }
      }
    }
  ],
  "interaction": {
    "spatialGroundPick": true,
    "pickDisabledStates": ["idle", "committed"],
    "groundPointerMoveStates": ["point_to_copy_from", "point_to_copy_to"],
    "heightDragStates": [],
    "verticalRodStates": [],
    "heightConfirmState": null,
    "lengthEntry": [
      {
        "state": "point_to_copy_to",
        "anchor": "from",
        "field": "cursor",
        "control": "stepper",
        "min": 0,
        "step": 0.1,
        "unit": "m"
      }
    ]
  },
  "machine": {
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "on": [
          {
            "event": "start",
            "transitions": [
              {
                "target": "select_objects_to_copy",
                "key": "s",
                "label": {
                  "native": { "en": "Start", "de": "Start" },
                  "reuse": { "en": "Start", "de": "Start" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [0, 0, 0]
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "points"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "targets"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": []
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "free"
                    }
                  },
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cplaneNormal"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": [0, 0, 1]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "select_objects_to_copy",
        "selection": {
          "accept": ["vertex", "edge", "wire", "face", "shell", "solid"],
          "multiple": true,
          "prompt": {
            "native": { "en": "Select objects to copy", "de": "Zu kopierende Objekte auswählen" },
            "reuse": { "en": "Select objects to copy", "de": "Zu kopierende Objekte auswählen" }
          }
        },
        "on": [
          {
            "event": "selection.changed",
            "transitions": [
              {
                "target": "select_objects_to_copy",
                "key": "s",
                "label": {
                  "native": { "en": "Select", "de": "Auswählen" },
                  "reuse": { "en": "Select", "de": "Auswählen" }
                },
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addSelection",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "targets"
                      },
                      "targets": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "targets"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "target": "point_to_copy_from",
                "key": "Enter",
                "label": {
                  "native": { "en": "Finish", "de": "Fertig" },
                  "reuse": { "en": "Finish", "de": "Fertig" }
                }
              }
            ]
          },
          {
            "event": "contextmenu",
            "transitions": [
              {
                "target": "point_to_copy_from",
                "key": "RightClick",
                "label": {
                  "native": { "en": "Finish", "de": "Fertig" },
                  "reuse": { "en": "Finish", "de": "Fertig" }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "point_to_copy_from",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "cursor"
                        }
                      ]
                    },
                    "value": {
                      "kind": "path",
                      "root": "event",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "point"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.free",
            "transitions": [
              {
                "key": "f",
                "label": {
                  "native": { "en": "Free", "de": "Frei" },
                  "reuse": { "en": "Free", "de": "Frei" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "free"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.normal",
            "transitions": [
              {
                "key": "n",
                "label": {
                  "native": { "en": "Normal", "de": "Normal" },
                  "reuse": { "en": "Normal", "de": "Normal" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "normal"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.vertical",
            "transitions": [
              {
                "key": "v",
                "label": {
                  "native": { "en": "Vertical", "de": "Vertikal" },
                  "reuse": { "en": "Vertical", "de": "Vertikal" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "vertical"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "confirm",
            "transitions": [
              {
                "guard": "hasCopyFrom",
                "target": "point_to_copy_to",
                "key": "Enter",
                "label": {
                  "native": { "en": "Source point picked", "de": "Quellpunkt gewählt" },
                  "reuse": { "en": "Source point picked", "de": "Quellpunkt gewählt" }
                }
              },
              {
                "guard": "noCopyFrom",
                "target": "point_to_copy_to",
                "key": "Enter",
                "label": {
                  "native": { "en": "Use selection center", "de": "Auswahlmitte verwenden" },
                  "reuse": { "en": "Use selection center", "de": "Auswahlmitte verwenden" }
                },
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.selectionBboxCenter",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "from"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "point_to_copy_to",
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "from"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "idle",
                "key": "x",
                "label": {
                  "native": { "en": "Cancel", "de": "Abbrechen" },
                  "reuse": { "en": "Cancel", "de": "Abbrechen" }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "point_to_copy_to",
        "on": [
          {
            "event": "pointer.move",
            "transitions": [
              {
                "transient": true,
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.constrainMoveCursor",
                    "params": {
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.free",
            "transitions": [
              {
                "key": "f",
                "label": {
                  "native": { "en": "Free", "de": "Frei" },
                  "reuse": { "en": "Free", "de": "Frei" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "free"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.normal",
            "transitions": [
              {
                "key": "n",
                "label": {
                  "native": { "en": "Normal", "de": "Normal" },
                  "reuse": { "en": "Normal", "de": "Normal" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "normal"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "mode.vertical",
            "transitions": [
              {
                "key": "v",
                "label": {
                  "native": { "en": "Vertical", "de": "Vertikal" },
                  "reuse": { "en": "Vertical", "de": "Vertikal" }
                },
                "effects": [
                  {
                    "mutation": "assign",
                    "target": {
                      "root": "context",
                      "segments": [
                        {
                          "kind": "field",
                          "name": "moveMode"
                        }
                      ]
                    },
                    "value": {
                      "kind": "const",
                      "value": "vertical"
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "undo.pick",
            "transitions": [
              {
                "target": "point_to_copy_from",
                "key": "u",
                "label": {
                  "native": { "en": "Undo pick", "de": "Auswahl rückgängig" },
                  "reuse": { "en": "Undo pick", "de": "Auswahl rückgängig" }
                },
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.undoPick",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "clearKeys": {
                        "kind": "const",
                        "value": ["from", "to"]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "pointer.down",
            "transitions": [
              {
                "target": "committed",
                "effects": [
                  {
                    "mutation": "action",
                    "action": "command.addPoint",
                    "params": {
                      "field": {
                        "kind": "const",
                        "value": "points"
                      },
                      "key": {
                        "kind": "const",
                        "value": "to"
                      },
                      "point": {
                        "kind": "path",
                        "root": "event",
                        "segments": [
                          {
                            "kind": "field",
                            "name": "point"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "event": "cancel",
            "transitions": [
              {
                "target": "idle",
                "key": "x",
                "label": {
                  "native": { "en": "Cancel", "de": "Abbrechen" },
                  "reuse": { "en": "Cancel", "de": "Abbrechen" }
                }
              }
            ]
          }
        ]
      },
      {
        "name": "committed",
        "final": true
      }
    ]
  },
  "display": {
    "states": [
      {
        "state": "select_objects_to_copy",
