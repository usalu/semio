{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/cad/cad/presence/schema.json",
  "title": "CadPresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedObjectIds",
    "selectedNodeIds",
    "componentSelectionMode",
    "componentSelectionIds",
    "componentSelectionTargetsMesh",
    "componentSelectionTargetsVertex",
    "componentSelectionTargetsEdge",
    "componentSelectionTargetsFace",
    "cameraPosition",
    "cameraTarget",
    "cameraZoom",
    "cameraFov",
    "engagementStep"
  ],
  "properties": {
    "selectedObjectIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "selectedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "hoveredObjectId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "hoveredTargetObjectId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "hoveredTargetMode": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "hoveredTargetId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "presence"
    },
    "activeObjectId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "componentSelectionMode": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "componentSelectionIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-state": "presence"
    },
    "componentSelectionTargetsMesh": {
      "type": "boolean",
      "x-semio-state": "presence"
    },
    "componentSelectionTargetsVertex": {
      "type": "boolean",
      "x-semio-state": "presence"
    },
    "componentSelectionTargetsEdge": {
      "type": "boolean",
      "x-semio-state": "presence"
    },
    "componentSelectionTargetsFace": {
      "type": "boolean",
      "x-semio-state": "presence"
    },
    "cameraPosition": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-state": "presence"
    },
    "cameraTarget": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-state": "presence"
    },
    "cameraZoom": {
      "type": "number",
      "x-semio-state": "presence"
    },
    "cameraFov": {
      "type": "number",
      "x-semio-state": "presence"
    },
    "engagementStep": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "engagementPane": {
      "type": "string",
      "x-semio-state": "presence"
    }
  },
  "definitions": {
    "cadPresenceRetirementLawsText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "repeat"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "repeat": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "CadPresenceRetirementLaws": {
      "title": "CadPresenceRetirementLaws",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant",
        "cases",
        "storeCases"
      ],
      "properties": {
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumItems",
            "maximumBytes"
          ],
          "properties": {
            "maximumItems": {
              "const": 1
            },
            "maximumBytes": {
              "const": 4096
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "engagementStep",
              "engagementPane",
              "expectedBytes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "engagementStep": {
                "$ref": "#/definitions/cadPresenceRetirementLawsText"
              },
              "engagementPane": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/definitions/cadPresenceRetirementLawsText"
                  }
                ]
              },
              "expectedBytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "storeCases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "local",
              "peers",
              "sharedRoot",
              "expectedBytes"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "local": {
                "type": "string"
              },
              "peers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "actor",
                    "presence"
                  ],
                  "properties": {
                    "actor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "presence": {
                      "type": "string"
                    }
                  }
                }
              },
              "sharedRoot": {
                "type": "boolean"
              },
              "expectedBytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "description": "📐️ The presence-retirement laws of the CAD editor: the grant bound, the utility/step/pane retirement cases and the shared-store cases.",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
