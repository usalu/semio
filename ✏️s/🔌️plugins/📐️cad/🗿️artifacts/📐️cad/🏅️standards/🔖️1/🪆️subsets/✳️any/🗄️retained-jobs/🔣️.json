    { "id": "referenceHover", "intendedLanes": ["config"], "disposition": "migrated", "blocker": "none" },
    { "id": "engagementInput", "intendedLanes": ["config"], "disposition": "migrated", "blocker": "none" },
    { "id": "engagementPossibleSelect", "intendedLanes": ["config"], "disposition": "migrated", "blocker": "none" },
    { "id": "engagementRepeatLast", "intendedLanes": ["config"], "disposition": "migrated", "blocker": "none" },
