    { "id": "addNode", "intendedLanes": ["artifact", "config"], "disposition": "migrated", "blocker": "none" },
    { "id": "renameNode", "intendedLanes": ["artifact"], "disposition": "migrated", "blocker": "none" },
    { "id": "translateSelection", "intendedLanes": ["child"], "disposition": "batchOnlyPendingRewrite", "blocker": "childPublicationUnavailable" },
    { "id": "rotateSelection", "intendedLanes": ["child"], "disposition": "batchOnlyPendingRewrite", "blocker": "childPublicationUnavailable" },
    { "id": "scaleSelection", "intendedLanes": ["child"], "disposition": "batchOnlyPendingRewrite", "blocker": "childPublicationUnavailable" },
