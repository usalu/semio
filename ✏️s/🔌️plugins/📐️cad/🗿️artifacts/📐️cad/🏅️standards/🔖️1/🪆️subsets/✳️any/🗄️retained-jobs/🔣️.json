  "laws": ["ownerLocal", "progress", "cancel", "freshness", "ackBeforeClose", "incrementalClose", "terminalEmpty"],
  "hostileSourceMutations": [
    { "id": "oldReducerAlias", "mutation": "replace CadRetainedCommandJobFactory with BoundedFirstStepCommandJobFactory", "expected": "rejected" },
    { "id": "serializationPromoted", "mutation": "mark saveCurrent migrated without a persistent serialization job", "expected": "rejected" },
    { "id": "configPreparationRemoved", "mutation": "remove the config preparation factory while config routes remain migrated", "expected": "rejected" },
    { "id": "publicationLaneBroadened", "mutation": "replace HostOnly with Config for loadRawRequest", "expected": "rejected" },
    { "id": "frameworkRoutePublicationRemoved", "mutation": "remove setActiveUtility from the app-owned retained factory", "expected": "rejected" },
    { "id": "closePageRaised", "mutation": "increase closePageBytes above 16384", "expected": "rejected" }
