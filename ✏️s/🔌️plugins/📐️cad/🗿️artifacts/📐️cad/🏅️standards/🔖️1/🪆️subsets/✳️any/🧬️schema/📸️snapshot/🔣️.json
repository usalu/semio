{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/cad/cad/snapshot.json",
  "title": "CadSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "drawings",
    "referencesByModelDefinitionId",
    "nodes"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "shapeModel": {
      "$ref": "#/$defs/CadModelChild",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "buildingModel": {
      "$ref": "#/$defs/CadModelChild",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "energyModel": {
      "$ref": "#/$defs/CadModelChild",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "structureClassicModel": {
      "$ref": "#/$defs/CadModelChild",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "drawings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CadDrawingChild"
      },
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "referencesByModelDefinitionId": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadReferenceList"
      },
      "x-semio-state": "artifact"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadNode"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "CadModelChild": {
      "allOf": [
        {
          "$ref": "https://semio.tech/schema/os/store/child.json"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "object",
              "properties": {
                "dialect": {
                  "type": "object",
                  "properties": {
                    "artifactKind": {
                      "const": "s.stdio.semio"
                    },
                    "standard": {
                      "const": "v1"
                    },
                    "subset": {
                      "const": "model"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "CadDrawingChild": {
      "allOf": [
        {
          "$ref": "https://semio.tech/schema/os/store/child.json"
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "object",
              "properties": {
                "dialect": {
                  "type": "object",
                  "properties": {
                    "artifactKind": {
                      "const": "s.stdio.semio"
                    },
                    "standard": {
                      "const": "v1"
                    },
                    "subset": {
                      "const": "drawing"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
