{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/cad/cad/snapshot.json",
  "title": "CadSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "objects",
    "buildingObjects",
    "energyObjects",
    "structureClassicObjects",
    "referencesByModelDefinitionId",
    "nodes",
    "activeModelDefinitionId"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadObject"
      },
      "x-semio-state": "artifact"
    },
    "buildingObjects": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadObject"
      },
      "x-semio-state": "artifact"
    },
    "energyObjects": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadObject"
      },
      "x-semio-state": "artifact"
    },
    "structureClassicObjects": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadObject"
      },
      "x-semio-state": "artifact"
    },
    "referencesByModelDefinitionId": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadReferenceList"
      },
      "x-semio-state": "artifact"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadNode"
      },
      "x-semio-state": "artifact"
    },
    "shapeGeometry": {
      "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadGeometry",
      "x-semio-state": "artifact"
    },
    "buildingGeometry": {
      "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadGeometry",
      "x-semio-state": "artifact"
    },
    "energyGeometry": {
      "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadGeometry",
      "x-semio-state": "artifact"
    },
    "structureClassicGeometry": {
      "$ref": "https://semio.tech/schema/s/cad/cad/artifact.json#/$defs/CadGeometry",
      "x-semio-state": "artifact"
    },
    "activeModelDefinitionId": {
      "type": "string",
      "x-semio-state": "artifact"
    }
  }
}
