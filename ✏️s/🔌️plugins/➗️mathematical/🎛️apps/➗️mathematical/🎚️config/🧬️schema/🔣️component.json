{
  "$id": "https://semio.tech/schema/app/mathematical/mathematical/config.json",
  "title": "MathematicalConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["camera", "locale"],
  "properties": {
    "camera": {
      "$ref": "#/$defs/MathematicalCamera",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "MathematicalCamera": {
      "title": "MathematicalCamera",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number", "format": "double" },
        "y": { "type": "number", "format": "double" },
        "zoom": { "type": "number", "format": "double" }
      }
    }
  }
}
