{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/equation/equation/config/schema.json",
  "title": "EquationConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera"
  ],
  "properties": {
    "camera": {
      "$ref": "#/$defs/EquationCamera",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "EquationCamera": {
      "title": "EquationCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
