(* ebnf mathematical.equation.snapshot *)
(* ISO-14977-style mirror of the normative 📖️.grammar.semio (same production names,
   kebab-case -> "space case"). *)
artifact mark = 'semio mathematical.equation.dsl v1' ;
document = artifact mark, { field } ;
field = 'notation', '=', child handle
      | 'results', '=', child handle
      | 'computed', '=', child handle
      | 'equation', '=', value
      | 'graph', '=', value
      | 'geometry', '=', value ;
child handle = 'child_id', '=', text, 'target', '=', text ;

(* Framework dialect-primitive terminals: text = bare word | quoted string; value = a dynamic
   JSON-equivalent literal as printed by the derived text engine. *)
