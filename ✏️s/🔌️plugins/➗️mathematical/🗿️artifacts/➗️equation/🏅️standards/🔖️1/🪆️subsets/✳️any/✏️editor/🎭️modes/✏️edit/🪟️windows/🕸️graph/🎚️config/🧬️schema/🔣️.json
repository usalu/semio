{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/mathematical/equation/graph-window/config/schema.json",
  "title": "EquationGraphWindowConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["camera"],
  "properties": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      },
      "x-semio-state": "config",
      "x-semio-owner": "window"
    }
  }
}
