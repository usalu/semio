dialect grammar
grammar equation.snapshot
extension equation
use family-scene
start document

# Real grammar for `EquationSnapshot::print_dsl`/`parse_dsl`: the derived spec-driven text of
# `EquationPackRecord` (📸️snapshot/💾️binary/🦀️.rs), the same record the pack encodes: the three
# composed child handles plus the authored `equation` and the live `graph`/`geometry` scene their
# shared `EquationWorkingScene` owns, each as a dynamic value literal (`{ key=value … }`, `[ … ]`).
# Fields are space-separated `key=value` tokens in any order; an absent optional field is omitted.
artifact-mark = "semio mathematical.equation.dsl v1"
document = artifact-mark field*
field = {"notation" "=" child-handle} | {"results" "=" child-handle} | {"computed" "=" child-handle} | {"equation" "=" VALUE} | {"graph" "=" VALUE} | {"geometry" "=" VALUE}
child-handle = {"child_id" "=" TEXT} {"target" "=" TEXT}
