{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/mathematical/equation/graph-window/config/mutation/set-camera/schema.json",
  "title": "SetCamera",
  "type": "object",
  "required": [
    "kind",
    "camera"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "set-camera"
    },
    "camera": {
      "type": "object",
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
