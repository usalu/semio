{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/mathematical/equation/1/equation/mutation/change-coefficient/schema.json",
  "title": "ChangeCoefficient",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "denom",
    "label",
    "numer"
  ],
  "properties": {
    "label": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Coefficient",
          "de": "Koeffizient"
        },
        "description": {
          "en": "Label of the numeric leaf in the equation tree.",
          "de": "Kennzeichen des Zahlenblatts im Gleichungsbaum."
        },
        "step": 1,
        "precision": 0
      }
    },
    "numer": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Numerator",
          "de": "Zähler"
        },
        "description": {
          "en": "Integer as a decimal string.",
          "de": "Ganzzahl als Dezimalzeichenkette."
        }
      }
    },
    "denom": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Denominator",
          "de": "Nenner"
        },
        "description": {
          "en": "Integer as a decimal string; 1 for a plain integer.",
          "de": "Ganzzahl als Dezimalzeichenkette; 1 für eine einfache Ganzzahl."
        }
      }
    }
  }
}
