{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/mathematical/equation/1/graph/mutation/replace-graph/schema.json",
  "title": "ReplaceGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph"
  ],
  "properties": {
    "graph": {
      "title": "EquationGraph",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "directed",
        "edges",
        "nodes"
      ],
      "properties": {
        "directed": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Directed",
              "de": "Gerichtet"
            },
            "description": {
              "en": "Edges point from source to target.",
              "de": "Kanten zeigen von der Quelle zum Ziel."
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "title": "EquationNode",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "x",
              "y"
            ],
            "properties": {
              "id": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Node Id",
                    "de": "Knoten-ID"
                  },
                  "description": {
                    "en": "Identity of the node; no other node may carry it.",
                    "de": "Identität des Knotens; kein anderer Knoten darf sie tragen."
                  }
                }
              },
              "label": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Label",
                    "de": "Beschriftung"
                  },
                  "description": {
                    "en": "Text shown on the node.",
                    "de": "Text, der am Knoten angezeigt wird."
                  }
                }
              },
              "x": {
                "type": "number",
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Position X",
                    "de": "Position X"
                  },
                  "description": {
                    "en": "Horizontal canvas position of the node.",
                    "de": "Horizontale Zeichenflächenposition des Knotens."
                  },
                  "step": 1,
                  "precision": 2
                }
              },
              "y": {
                "type": "number",
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Position Y",
                    "de": "Position Y"
                  },
                  "description": {
                    "en": "Vertical canvas position of the node.",
                    "de": "Vertikale Zeichenflächenposition des Knotens."
                  },
                  "step": 1,
                  "precision": 2
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Nodes",
              "de": "Knoten"
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "title": "EquationEdge",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Connection Id",
                    "de": "Verbindungs-ID"
                  },
                  "description": {
                    "en": "Identity of the connection; no other connection may carry it.",
                    "de": "Identität der Verbindung; keine andere Verbindung darf sie tragen."
                  }
                }
              },
              "source": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "reference",
                  "role": "value",
                  "label": {
                    "en": "Source Node",
                    "de": "Quellknoten"
                  },
                  "description": {
                    "en": "The node the connection starts at.",
                    "de": "Der Knoten, an dem die Verbindung beginnt."
                  },
                  "ref": {
                    "kind": "node"
                  }
                }
              },
              "target": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "reference",
                  "role": "value",
                  "label": {
                    "en": "Target Node",
                    "de": "Zielknoten"
                  },
                  "description": {
                    "en": "The node the connection ends at.",
                    "de": "Der Knoten, an dem die Verbindung endet."
                  },
                  "ref": {
                    "kind": "node"
                  }
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Edges",
              "de": "Kanten"
            }
          }
        },
        "algorithm": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Algorithm",
              "de": "Algorithmus"
            },
            "description": {
              "en": "Graph algorithm to run, e.g. bfs or dfs.",
              "de": "Auszuführender Graphalgorithmus, z. B. bfs oder dfs."
            }
          }
        },
        "algorithmSeed": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Algorithm Seed",
              "de": "Algorithmus-Startwert"
            },
            "description": {
              "en": "Input of the algorithm, e.g. the start node id.",
              "de": "Eingabe des Algorithmus, z. B. die ID des Startknotens."
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Graph",
          "de": "Graph"
        },
        "description": {
          "en": "The complete graph record.",
          "de": "Der vollständige Graph."
        }
      }
    }
  }
}
