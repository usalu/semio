{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/mathematical/equation/1/graph/mutation/replace-graph/schema.json",
  "title": "ReplaceGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph"
  ],
  "properties": {
    "graph": {
      "title": "EquationGraph",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "directed",
        "edges",
        "nodes"
      ],
      "properties": {
        "directed": {
          "type": "boolean"
        },
        "nodes": {
          "type": "array",
          "items": {
            "title": "EquationNode",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "x",
              "y"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "title": "EquationEdge",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "algorithm": {
          "type": "string"
        },
        "algorithmSeed": {
          "type": "string"
        }
      }
    }
  }
}
