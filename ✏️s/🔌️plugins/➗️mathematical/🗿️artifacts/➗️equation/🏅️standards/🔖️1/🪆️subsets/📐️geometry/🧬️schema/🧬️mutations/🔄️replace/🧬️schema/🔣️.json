{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/mathematical/equation/1/geometry/mutation/replace-points/schema.json",
  "title": "ReplacePoints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "points"
  ],
  "properties": {
    "points": {
      "type": "array",
      "items": {
        "title": "EquationPoint",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Points",
          "de": "Punkte"
        },
        "description": {
          "en": "All points of the geometry in order.",
          "de": "Alle Punkte der Geometrie in Reihenfolge."
        }
      }
    }
  }
}
