{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/mathematical/equation/1/geometry/mutation/replace-points/schema.json",
  "title": "ReplacePoints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "points"
  ],
  "properties": {
    "points": {
      "type": "array",
      "items": {
        "title": "EquationPoint",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number",
            "x-semio-ui": {
              "widget": "stepper",
              "role": "value",
              "label": {
                "en": "X",
                "de": "X"
              },
              "description": {
                "en": "Horizontal coordinate of the point.",
                "de": "Horizontale Koordinate des Punkts."
              },
              "step": 1,
              "precision": 2
            }
          },
          "y": {
            "type": "number",
            "x-semio-ui": {
              "widget": "stepper",
              "role": "value",
              "label": {
                "en": "Y",
                "de": "Y"
              },
              "description": {
                "en": "Vertical coordinate of the point.",
                "de": "Vertikale Koordinate des Punkts."
              },
              "step": 1,
              "precision": 2
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Points",
          "de": "Punkte"
        },
        "description": {
          "en": "All points of the geometry in order.",
          "de": "Alle Punkte der Geometrie in Reihenfolge."
        }
      }
    }
  }
}
