{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/mathematical/equation/1/graph/mutation/update-graph-algorithm/schema.json",
  "title": "UpdateGraphAlgorithm",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newAlgorithm"
  ],
  "properties": {
    "newAlgorithm": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "New Algorithm",
          "de": "Neuer Algorithmus"
        },
        "description": {
          "en": "Graph algorithm to run, e.g. bfs or dfs.",
          "de": "Auszuführender Graphalgorithmus, z. B. bfs oder dfs."
        }
      }
    },
    "newAlgorithmSeed": {
      "type": [
        "string",
        "null"
      ],
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "New Algorithm Seed",
          "de": "Neuer Algorithmus-Startwert"
        },
        "description": {
          "en": "Input of the algorithm, e.g. the start node id; empty for none.",
          "de": "Eingabe des Algorithmus, z. B. die ID des Startknotens; leer für keine."
        }
      }
    }
  }
}
