dialect protocol
protocol s.mathematical.equation.mutations
version 1
schema s.mathematical.equation
start record

record ChangeGraphDirected tag 0
  field new_directed u8

record UpdateGraphAlgorithm tag 1
  field new_algorithm utf8
  field new_algorithm_seed utf8 optional

record CreateNode tag 3
  field id utf8
  field label utf8
  field x f64
  field y f64
  field index varint optional

record DeleteNode tag 4
  field id utf8

record DeleteNodes tag 5
  field ids utf8 varint

record ChangeNodeLabel tag 6
  field id utf8
  field new_label utf8

record MoveNode tag 7
  field id utf8
  field x f64
  field y f64

record ConnectNodes tag 8
  field id utf8
  field source utf8
  field target utf8
  field index varint optional

record DisconnectNodes tag 9
  field id utf8

record InsertPoint tag 11
  field index varint
  field x f64
  field y f64

record RemovePoint tag 12
  field index varint

record MovePoints tag 13
  field indices varint varint
  field dx f64
  field dy f64

record ChangeCoefficient tag 14
  field label varint
  field numer utf8
  field denom utf8

record MoveNodes tag 15
  field ids utf8 varint
  field dx f64
  field dy f64

record SetNodePositions tag 16
  field positions bytes varint

record SetPointPositions tag 17
  field positions bytes varint
