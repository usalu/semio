{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/mathematical/equation/1/graph/mutation/connect-nodes/schema.json",
  "title": "ConnectNodes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "target"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Source Node",
          "de": "Quellknoten"
        },
        "description": {
          "en": "The node the connection starts at.",
          "de": "Der Knoten, an dem die Verbindung beginnt."
        },
        "ref": {
          "kind": "node"
        }
      }
    },
    "target": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Target Node",
          "de": "Zielknoten"
        },
        "description": {
          "en": "The node the connection ends at.",
          "de": "Der Knoten, an dem die Verbindung endet."
        },
        "ref": {
          "kind": "node"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "description": "Roster position to insert at; absent appends. Inverses restore exact order with it."
    }
  }
}
