{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/mathematical/equation/1/graph/mutation/connect-nodes/schema.json",
  "title": "ConnectNodes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "target"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "description": "Roster position to insert at; absent appends. Inverses restore exact order with it."
    }
  }
}
