{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/equation/equation/diff.json",
  "title": "EquationDiff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "directed": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "algorithm": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "algorithmSeed": {
      "$ref": "#/$defs/EquationOptionalSeed",
      "x-semio-state": "artifact"
    },
    "nodes": {
      "$ref": "#/$defs/EquationNodesDelta",
      "x-semio-state": "artifact"
    },
    "edges": {
      "$ref": "#/$defs/EquationEdgesDelta",
      "x-semio-state": "artifact"
    },
    "points": {
      "$ref": "#/$defs/EquationPointsDelta",
      "x-semio-state": "artifact"
    },
    "equation": {
      "$ref": "#/$defs/EquationExprDiff",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "EquationOptionalSeed": {
      "title": "EquationOptionalSeed",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "EquationNodesDelta": {
      "title": "EquationNodesDelta",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationNodeRemoval"
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationNodeInsertion"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationNodeRelocation"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationNodesModification"
          }
        }
      },
      "required": []
    },
    "EquationNodesModification": {
      "title": "EquationNodesModification",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/EquationNodePatch"
        }
      }
    },
    "EquationNodeRemoval": {
      "title": "EquationNodeRemoval",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "EquationNodeInsertion": {
      "title": "EquationNodeInsertion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "row"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "row": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/equation/equation/artifact.json#/$defs/node"
        }
      }
    },
    "EquationNodeRelocation": {
      "title": "EquationNodeRelocation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "EquationNodePatch": {
      "title": "EquationNodePatch",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": []
    },
    "EquationEdgesDelta": {
      "title": "EquationEdgesDelta",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationEdgeRemoval"
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationEdgeInsertion"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationEdgeRelocation"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationEdgesModification"
          }
        }
      },
      "required": []
    },
    "EquationEdgesModification": {
      "title": "EquationEdgesModification",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/EquationEdgePatch"
        }
      }
    },
    "EquationEdgeRemoval": {
      "title": "EquationEdgeRemoval",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "EquationEdgeInsertion": {
      "title": "EquationEdgeInsertion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "row"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "row": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/equation/equation/artifact.json#/$defs/edge"
        }
      }
    },
    "EquationEdgeRelocation": {
      "title": "EquationEdgeRelocation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "EquationEdgePatch": {
      "title": "EquationEdgePatch",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": []
    },
    "EquationPointsDelta": {
      "title": "EquationPointsDelta",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationPointEdit"
          }
        }
      },
      "required": [
        "edits"
      ]
    },
    "EquationPointEdit": {
      "oneOf": [
        {
          "title": "EquationPointInsert",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "insert"
            },
            "at": {
              "type": "integer",
              "minimum": 0
            },
            "point": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/equation/equation/artifact.json#/$defs/point"
            }
          },
          "required": [
            "op",
            "at",
            "point"
          ]
        },
        {
          "title": "EquationPointRemove",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "remove"
            },
            "at": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "at"
          ]
        },
        {
          "title": "EquationPointSet",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "set"
            },
            "at": {
              "type": "integer",
              "minimum": 0
            },
            "point": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/equation/equation/artifact.json#/$defs/point"
            }
          },
          "required": [
            "op",
            "at",
            "point"
          ]
        }
      ]
    },
    "EquationExprDiff": {
      "title": "EquationExprDiff",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EquationKindPatch"
          }
        },
        "nextLabel": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "kinds"
      ]
    },
    "EquationKindPatch": {
      "title": "EquationKindPatch",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json"
        }
      },
      "required": [
        "label",
        "kind"
      ]
    }
  }
}
