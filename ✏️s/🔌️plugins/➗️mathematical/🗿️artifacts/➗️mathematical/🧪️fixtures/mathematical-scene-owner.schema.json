{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/mathematical-scene-owner-law.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "ownedSlots", "maximumCases", "cases"],
  "properties": {
    "$schema": { "type": "string", "const": "./mathematical-scene-owner.schema.json" },
    "schemaVersion": { "const": 1 },
    "ownedSlots": { "const": 3 },
    "maximumCases": { "type": "integer", "minimum": 1, "maximum": 8 },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["law", "leftDirected", "rightDirected"],
        "properties": {
          "law": { "enum": ["tripleIdentity", "instanceIsolation", "abaIsolation", "wireOmission", "boundedClose"] },
          "leftDirected": { "type": "boolean" },
          "rightDirected": { "type": "boolean" }
        }
      }
    }
  }
}
