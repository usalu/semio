{
  "$schema": "./mathematical-retained-command.schema.json",
  "schemaVersion": 1,
  "contract": {
    "rawBytes": 65536,
    "wirePageBytes": 2048,
    "workItems": 65536,
    "durationMillis": 7500,
    "maximumStepMillis": 8,
    "checkpointBytes": 40,
    "closeItems": 1
  },
  "actions": ["setDocument", "setAlgorithm", "setDirected", "nodeGraphEdit", "nodeGraphViewport", "setPoints", "setLocale"],
  "hostileCases": [
    { "law": "nodes", "maximum": 256, "maximumPlusOneAccepted": false },
    { "law": "edges", "maximum": 512, "maximumPlusOneAccepted": false },
    { "law": "points", "maximum": 1024, "maximumPlusOneAccepted": false },
    { "law": "editJsonBytes", "maximum": 8192, "maximumPlusOneAccepted": false },
    { "law": "editOperations", "maximum": 16, "maximumPlusOneAccepted": false },
    { "law": "deleteIds", "maximum": 256, "maximumPlusOneAccepted": false },
    { "law": "textBytes", "maximum": 256, "maximumPlusOneAccepted": false },
    { "law": "localeBytes", "maximum": 64, "maximumPlusOneAccepted": false },
    { "law": "registrationIdentity", "maximum": 7, "maximumPlusOneAccepted": false },
    { "law": "interruptionReplay", "maximum": 65536, "maximumPlusOneAccepted": false },
    { "law": "checkpointIdentity", "maximum": 40, "maximumPlusOneAccepted": false },
    { "law": "cancelBefore", "maximum": 1, "maximumPlusOneAccepted": false },
    { "law": "cancelAfter", "maximum": 1, "maximumPlusOneAccepted": false },
    { "law": "repeatedClose", "maximum": 1, "maximumPlusOneAccepted": false }
  ]
}
