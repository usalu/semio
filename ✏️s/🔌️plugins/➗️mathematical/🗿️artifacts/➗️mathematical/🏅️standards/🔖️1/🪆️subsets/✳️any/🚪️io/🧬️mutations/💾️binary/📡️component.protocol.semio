dialect protocol
protocol s.mathematical.mathematical.mutations
version 1
schema s.mathematical.mathematical
start record

record ChangeGraphDirected tag 1
  field new_directed u8

record UpdateGraphAlgorithm tag 2
  field new_algorithm utf8
  field new_algorithm_seed utf8

record ReplaceGraph tag 3
  field graph bytes

record CreateNode tag 4
  field id utf8
  field label utf8
  field x f64
  field y f64

record DeleteNode tag 5
  field id utf8

record DeleteNodes tag 6
  field ids utf8 varint

record ChangeNodeLabel tag 7
  field id utf8
  field new_label utf8

record MoveNode tag 8
  field id utf8
  field x f64
  field y f64

record ConnectNodes tag 9
  field id utf8
  field source utf8
  field target utf8

record DisconnectNodes tag 10
  field id utf8

record ReplacePoints tag 11
  field points bytes varint

record InsertPoint tag 12
  field index varint
  field x f64
  field y f64

record RemovePoint tag 13
  field index varint

record MovePoint tag 14
  field index varint
  field x f64
  field y f64
