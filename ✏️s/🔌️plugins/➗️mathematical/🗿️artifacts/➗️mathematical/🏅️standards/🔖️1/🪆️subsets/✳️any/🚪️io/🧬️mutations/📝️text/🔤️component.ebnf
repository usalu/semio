(* ebnf mathematical.mathematical.mutations *)
(* Below: ISO-14977-style mirror of the normative 📖️component.grammar.semio (same production
   names, kebab-case -> "space case"). This facet's .semio defines no header/body/payload
   envelope (`start line`); the two lines above are preserved verbatim from the prior
   identity fix for traceability but are not referenced below. *)
document = header, body ;
header = 'schema', space, 'mathematical.mathematical.mutations', newline ;

line = change graph directed
     | update graph algorithm
     | replace graph
     | create node
     | delete node
     | delete nodes
     | change node label
     | move node
     | connect nodes
     | disconnect nodes
     | replace points
     | insert point
     | remove point
     | move point ;
change graph directed = 'change-graph-directed', space, boolean ;
update graph algorithm = 'update-graph-algorithm', space, text, space, [ text ] ;
replace graph = 'replace-graph', space, block ;
create node = 'create-node', space, id, space, text, space, number, space, number ;
delete node = 'delete-node', space, id ;
delete nodes = 'delete-nodes', space, block ;
change node label = 'change-node-label', space, id, space, text ;
move node = 'move-node', space, id, space, number, space, number ;
connect nodes = 'connect-nodes', space, id, space, text, space, text ;
disconnect nodes = 'disconnect-nodes', space, id ;
replace points = 'replace-points', space, block ;
insert point = 'insert-point', space, number, space, number, space, number ;
remove point = 'remove-point', space, number ;
move point = 'move-point', space, number, space, number, space, number ;
id = octet, { octet } ;
number = octet, { octet } ;
text = octet, { octet } ;
boolean = 'true'
     | 'false' ;
block = '{', newline, octet, { octet }, '}' ;

(* Framework dialect-primitive terminals, given one concrete definition each for a
   self-contained mirror (not defined in the .semio itself — ticket-reported deviation). *)
newline = [ '\r' ], '\n' ;
octet = ? any single raw byte ? ;
space = ' ' ;
