{
  "$id": "https://semio.tech/schema/s/mathematical/mathematical/snapshot.json",
  "title": "MathematicalSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph", "geometry"],
  "properties": {
    "graph": {
      "$ref": "#/$defs/MathematicalGraph",
      "x-semio-state": "artifact"
    },
    "geometry": {
      "$ref": "#/$defs/MathematicalGeometry",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "MathematicalGraph": {
      "title": "MathematicalGraph",
      "type": "object",
      "additionalProperties": false,
      "required": ["directed", "nodes", "edges", "algorithm"],
      "properties": {
        "directed": { "type": "boolean" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/MathematicalNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/MathematicalEdge" }
        },
        "algorithm": { "type": "string" },
        "algorithmSeed": { "type": "string" }
      }
    },
    "MathematicalNode": {
      "title": "MathematicalNode",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "x", "y"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "x": { "type": "number", "format": "double" },
        "y": { "type": "number", "format": "double" }
      }
    },
    "MathematicalEdge": {
      "title": "MathematicalEdge",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" }
      }
    },
    "MathematicalPoint": {
      "title": "MathematicalPoint",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "format": "double" },
        "y": { "type": "number", "format": "double" }
      }
    },
    "MathematicalGeometry": {
      "title": "MathematicalGeometry",
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/MathematicalPoint" }
        }
      }
    }
  }
}
