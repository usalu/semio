{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplacePoints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "points"
  ],
  "properties": {
    "points": {
      "type": "array",
      "items": {
        "title": "MathematicalPoint",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    }
  }
}
