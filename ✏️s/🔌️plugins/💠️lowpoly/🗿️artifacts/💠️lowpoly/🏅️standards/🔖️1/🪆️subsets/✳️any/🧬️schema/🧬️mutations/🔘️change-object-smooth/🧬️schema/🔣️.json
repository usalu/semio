{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/mutation/change-object-smooth-shading/schema.json",
  "title": "ChangeObjectSmoothShading",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newSmoothShading"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The object to shade.",
          "de": "Das zu schattierende Objekt."
        },
        "ref": {
          "kind": "object",
          "domain": "mesh",
          "granularity": "object"
        }
      }
    },
    "newSmoothShading": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Smooth Shading",
          "de": "Glatte Schattierung"
        },
        "description": {
          "en": "Interpolates normals across faces.",
          "de": "Interpoliert Normalen über Flächen hinweg."
        }
      }
    }
  }
}
