{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/mutation/edit-paint-layer/schema.json",
  "title": "EditPaintLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layerIndex",
    "objectId",
    "runs"
  ],
  "properties": {
    "objectId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The object that owns the paint layer.",
          "de": "Das Objekt, dem die Malebene gehört."
        },
        "ref": {
          "kind": "object",
          "domain": "mesh",
          "granularity": "object"
        }
      }
    },
    "layerIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Layer Index",
          "de": "Ebenenindex"
        },
        "description": {
          "en": "Position of the paint layer, counted from the bottom.",
          "de": "Position der Malebene, von unten gezählt."
        },
        "step": 1,
        "precision": 0
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "title": "PixelRun",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bytes",
          "offset"
        ],
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "x-semio-ui": {
              "widget": "stepper",
              "role": "value",
              "label": {
                "en": "Byte Offset",
                "de": "Byte-Versatz"
              },
              "description": {
                "en": "Start of the run in the layer's RGBA buffer.",
                "de": "Beginn des Laufs im RGBA-Puffer der Ebene."
              },
              "step": 1,
              "precision": 0
            }
          },
          "bytes": {
            "type": "string",
            "contentEncoding": "base64",
            "x-semio-ui": {
              "widget": "text",
              "role": "value",
              "label": {
                "en": "Bytes",
                "de": "Bytes"
              },
              "description": {
                "en": "RGBA bytes of the run, base64-encoded.",
                "de": "RGBA-Bytes des Laufs, Base64-kodiert."
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Pixel Runs",
          "de": "Pixelläufe"
        },
        "description": {
          "en": "Contiguous RGBA byte runs written into the layer.",
          "de": "Zusammenhängende RGBA-Bytefolgen, die in die Ebene geschrieben werden."
        }
      }
    }
  }
}
