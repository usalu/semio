{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/mutation/change-paint-layer-blend-mode/schema.json",
  "title": "ChangePaintLayerBlendMode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "newBlendMode",
    "objectId"
  ],
  "properties": {
    "objectId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The object that owns the paint layer.",
          "de": "Das Objekt, dem die Malebene gehört."
        },
        "ref": {
          "kind": "object",
          "domain": "mesh",
          "granularity": "object"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Layer Index",
          "de": "Ebenenindex"
        },
        "description": {
          "en": "Position of the paint layer, counted from the bottom.",
          "de": "Position der Malebene, von unten gezählt."
        },
        "step": 1,
        "precision": 0
      }
    },
    "newBlendMode": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "New Blend Mode",
          "de": "Neue Füllmethode"
        },
        "description": {
          "en": "How the layer combines with the layers below, e.g. normal or multiply.",
          "de": "Wie die Ebene mit den darunterliegenden Ebenen verrechnet wird, z. B. normal oder multiply."
        }
      }
    }
  }
}
