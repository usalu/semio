{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/mutation/insert-paint-layer/schema.json",
  "title": "InsertPaintLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "layer",
    "objectId"
  ],
  "properties": {
    "objectId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The object that receives the paint layer.",
          "de": "Das Objekt, das die Malebene aufnimmt."
        },
        "ref": {
          "kind": "object",
          "domain": "mesh",
          "granularity": "object"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "layer": {
      "title": "LowpolyPaintLayer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blendMode",
        "name",
        "opacity",
        "pixels",
        "visible"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number"
        },
        "blendMode": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Blend Mode",
              "de": "Füllmethode"
            },
            "description": {
              "en": "How the layer combines with the layers below, e.g. normal or multiply.",
              "de": "Wie die Ebene mit den darunterliegenden Ebenen verrechnet wird, z. B. normal oder multiply."
            }
          }
        },
        "pixels": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Paint Layer",
          "de": "Malebene"
        },
        "description": {
          "en": "The complete paint layer record to insert.",
          "de": "Die vollständige einzufügende Malebene."
        }
      }
    }
  }
}
