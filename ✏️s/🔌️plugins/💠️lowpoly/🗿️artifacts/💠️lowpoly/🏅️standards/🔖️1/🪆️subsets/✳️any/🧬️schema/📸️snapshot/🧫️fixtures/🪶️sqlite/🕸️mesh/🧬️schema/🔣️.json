{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false, "required": ["version", "source", "binary32Words", "mesh"],
  "properties": {
    "version": {"const": 1}, "source": {"type": "string"}, "binary32Words": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/b32"}},
    "mesh": {"type": "object", "additionalProperties": false, "required": ["vertices", "halfedges", "faces", "uvSeams", "attributes", "materials", "textures"], "properties": {
      "vertices": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["position", "normal", "halfedge"], "properties": {"position": {"$ref": "#/$defs/vector3"}, "normal": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/vector3"}]}, "halfedge": {"$ref": "#/$defs/optionalIndex"}}}},
      "halfedges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["vertex", "twin", "next", "face", "uv"], "properties": {"vertex": {"$ref": "#/$defs/index"}, "twin": {"$ref": "#/$defs/optionalIndex"}, "next": {"$ref": "#/$defs/index"}, "face": {"$ref": "#/$defs/optionalIndex"}, "uv": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/b32"}}}}},
      "faces": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["halfedge", "smooth", "flipped"], "properties": {"halfedge": {"$ref": "#/$defs/index"}, "smooth": {"type": "boolean"}, "flipped": {"type": "boolean"}}}},
      "uvSeams": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/index"}},
      "attributes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "domain", "semantic", "interpolation", "values", "indices"], "properties": {"name": {"type": "string"}, "domain": {"enum": ["vertex", "corner", "face", "edge"]}, "semantic": {"enum": ["normal", "uv", "color", "material", "custom"]}, "interpolation": {"enum": ["linear", "nearest", "constant"]}, "values": {"type": "array", "items": {"$ref": "#/$defs/value"}}, "indices": {"anyOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/index"}}]}}}},
      "materials": {"type": "array", "items": {"$ref": "#/$defs/member"}},
      "textures": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "mime", "bytes"], "properties": {"name": {"type": "string"}, "mime": {"type": "string"}, "bytes": {"$ref": "#/$defs/octets"}}}}
    }}
  },
  "$defs": {
    "b32": {"type": "string", "pattern": "^[0-9a-f]{8}$"}, "b64": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "index": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "optionalIndex": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/index"}]},
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/b32"}},
    "octets": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "member": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string"}, "value": {"$ref": "#/$defs/value"}}},
    "value": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "null"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "boolean"}, "value": {"type": "boolean"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "unsigned"}, "value": {"$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/U64"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "signed"}, "value": {"type": "string", "pattern": "^(0|-?([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])|-9223372036854775808)$"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "float"}, "value": {"$ref": "#/$defs/b64"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "text"}, "value": {"type": "string"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "bytes"}, "value": {"$ref": "#/$defs/octets"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "items"], "properties": {"kind": {"const": "array"}, "items": {"type": "array", "items": {"$ref": "#/$defs/value"}}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "members"], "properties": {"kind": {"const": "object"}, "members": {"type": "array", "items": {"$ref": "#/$defs/member"}}}}
    ]}
  }
}
