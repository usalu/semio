{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/mutation/rename-object/schema.json",
  "title": "RenameObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newName"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The object this mutation addresses.",
          "de": "Das Objekt, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "object",
          "domain": "mesh",
          "granularity": "object"
        }
      }
    },
    "newName": {
      "type": "string"
    }
  }
}
