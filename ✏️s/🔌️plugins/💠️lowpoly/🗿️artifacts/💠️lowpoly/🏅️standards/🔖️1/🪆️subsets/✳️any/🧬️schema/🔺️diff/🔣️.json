  "$defs": {
    "LowpolyStringList": {
      "title": "LowpolyStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LowpolyObjectsDelta": {
      "title": "LowpolyObjectsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched",
        "reordered"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/lowpoly/lowpoly/artifact.json#/$defs/LowpolyObject"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LowpolyObjectPatchEntry"
          }
        },
        "reordered": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "LowpolyObjectPatchEntry": {
      "title": "LowpolyObjectPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch",
        "paintLayers"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/LowpolyObjectPatch"
        },
        "paintLayers": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/LowpolyPaintLayersDelta"
            }
          ]
        }
      }
    },
    "LowpolyObjectPatch": {
      "title": "LowpolyObjectPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "smoothShading",
        "transform",
        "mesh"
      ],
      "properties": {
        "name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "smoothShading": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "transform": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://semio.tech/schema/s/lowpoly/lowpoly/artifact.json#/$defs/LowpolyTransform"
            }
          ]
        },
        "mesh": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://semio.tech/schema/s/lowpoly/lowpoly/artifact.json#/$defs/LowpolyMeshHandle"
            }
          ]
        }
      }
    },
    "LowpolyPaintLayersDelta": {
      "title": "LowpolyPaintLayersDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched",
        "strokes"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LowpolyIndexedPaintLayer"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LowpolyIndexedPaintLayerPatch"
          }
        },
        "strokes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LowpolyPaintStrokeAt"
          }
        }
      }
    },
    "LowpolyIndexedPaintLayer": {
      "title": "LowpolyIndexedPaintLayer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "layer"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "layer": {
          "$ref": "https://semio.tech/schema/s/lowpoly/lowpoly/artifact.json#/$defs/LowpolyPaintLayer"
        }
      }
    },
    "LowpolyIndexedPaintLayerPatch": {
      "title": "LowpolyIndexedPaintLayerPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "patch"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "patch": {
          "$ref": "#/$defs/LowpolyPaintLayerPatch"
        }
      }
    },
    "LowpolyPaintLayerPatch": {
      "title": "LowpolyPaintLayerPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "visible",
        "opacity",
        "blendMode"
      ],
      "properties": {
        "name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "visible": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "opacity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        },
        "blendMode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "LowpolyPaintStrokeAt": {
      "title": "LowpolyPaintStrokeAt",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layerIndex",
        "runs"
      ],
      "properties": {
        "layerIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PixelRun"
          }
        }
      }
    },
    "PixelRun": {
      "title": "PixelRun",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "bytes"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bytes": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "LowpolyArtifact": {
      "title": "LowpolyArtifact",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "objects"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/lowpoly/lowpoly/artifact.json#/$defs/LowpolyObject"
          }
        }
      }
    }
  }
