{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/diff.json",
  "title": "LowpolyDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "schema",
    "objects"
  ],
  "properties": {
    "schema": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ],
      "x-semio-state": "artifact"
    },
    "objects": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/LowpolyObjectsDelta"
        }
      ],
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "LowpolyObjectsDelta": {
      "title": "LowpolyObjectsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched",
        "reordered"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/artifact.json#/$defs/LowpolyObject"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LowpolyObjectPatchEntry"
          }
        },
        "reordered": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    "LowpolyObjectPatchEntry": {
      "title": "LowpolyObjectPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch",
        "paintLayers",
        "meshMotions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/LowpolyObjectPatch"
        },
        "paintLayers": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/LowpolyPaintLayersDelta"
            }
          ]
        },
        "meshMotions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LowpolyMeshMotion"
          }
        }
      }
    },
    "LowpolyObjectPatch": {
      "title": "LowpolyObjectPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "smoothShading",
        "position",
        "rotation",
        "scale",
        "mesh"
      ],
      "properties": {
        "name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "smoothShading": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "mesh": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child/schema.json",
              "x-semio-child-kind": "s.stdio.semio.mesh"
            }
          ]
        },
        "meshContent": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "meshState": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/mesh/schema.json"
                    }
                  ]
                }
              }
            }
          ]
        },
        "position": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        },
        "rotation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        },
        "scale": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        }
      }
    },
    "LowpolyPaintLayerPatch": {
      "title": "LowpolyPaintLayerPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "visible",
        "opacity",
        "blendMode"
      ],
      "properties": {
        "name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "visible": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "opacity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        },
        "blendMode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "PixelRun": {
      "title": "PixelRun",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "bytes"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "bytes": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "LowpolyPaintLayersDelta": {
      "title": "LowpolyPaintLayersDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edits"
      ],
      "properties": {
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LowpolyPaintEdit"
          }
        }
      }
    },
    "LowpolyPaintEdit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "index",
            "layer"
          ],
          "properties": {
            "op": {
              "const": "insert"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "layer": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/artifact.json#/$defs/LowpolyPaintLayer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "index"
          ],
          "properties": {
            "op": {
              "const": "remove"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "index",
            "layer"
          ],
          "properties": {
            "op": {
              "const": "replace"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "layer": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/artifact.json#/$defs/LowpolyPaintLayer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "index",
            "patch"
          ],
          "properties": {
            "op": {
              "const": "patch"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "patch": {
              "$ref": "#/$defs/LowpolyPaintLayerPatch"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "index",
            "runs"
          ],
          "properties": {
            "op": {
              "const": "stroke"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PixelRun"
              }
            }
          }
        }
      ]
    },
    "LowpolyMeshMotion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "motion",
            "vertexIds",
            "offset"
          ],
          "properties": {
            "motion": {
              "const": "offset"
            },
            "vertexIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "offset": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "motion",
            "vertexIds",
            "pivot",
            "axis",
            "angle"
          ],
          "properties": {
            "motion": {
              "const": "turn"
            },
            "vertexIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "pivot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "axis": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "angle": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "motion",
            "vertexIds",
            "pivot",
            "factor"
          ],
          "properties": {
            "motion": {
              "const": "stretch"
            },
            "vertexIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "pivot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "factor": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      ]
    }
  }
}
