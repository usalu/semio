{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/lowpoly/lowpoly/mutation/create-object/schema.json",
  "title": "CreateObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "object"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "object": {
      "title": "LowpolyObject",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "paintLayers",
        "smoothShading",
        "transform",
        "mesh"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mesh": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "title": "LowpolyMeshHandle",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "childId",
                "target"
              ],
              "properties": {
                "childId": {
                  "type": "string",
                  "x-semio-ui": {
                    "widget": "text",
                    "role": "value",
                    "label": {
                      "en": "Child ID",
                      "de": "Kind-ID"
                    },
                    "description": {
                      "en": "Id of the child slot in this document.",
                      "de": "ID des Kind-Slots in diesem Dokument."
                    }
                  }
                },
                "target": {
                  "title": "ArtifactRef",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifactId",
                    "dialect"
                  ],
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "x-semio-ui": {
                        "widget": "text",
                        "role": "value",
                        "label": {
                          "en": "Artifact ID",
                          "de": "Artefakt-ID"
                        },
                        "description": {
                          "en": "Document id of the child artifact.",
                          "de": "Dokument-ID des Kind-Artefakts."
                        }
                      }
                    },
                    "dialect": {
                      "title": "ArtifactDialect",
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "artifactKind",
                        "standard",
                        "subset"
                      ],
                      "properties": {
                        "artifactKind": {
                          "type": "string",
                          "x-semio-ui": {
                            "widget": "text",
                            "role": "value",
                            "label": {
                              "en": "Artifact Kind",
                              "de": "Artefaktart"
                            },
                            "description": {
                              "en": "Kind id of the artifact, e.g. s.stdio.semio.",
                              "de": "Art-ID des Artefakts, z. B. s.stdio.semio."
                            }
                          }
                        },
                        "standard": {
                          "type": "string",
                          "x-semio-ui": {
                            "widget": "text",
                            "role": "value",
                            "label": {
                              "en": "Standard",
                              "de": "Standard"
                            },
                            "description": {
                              "en": "Standard version of the artifact kind.",
                              "de": "Standardversion der Artefaktart."
                            }
                          }
                        },
                        "subset": {
                          "type": "string",
                          "x-semio-ui": {
                            "widget": "text",
                            "role": "value",
                            "label": {
                              "en": "Subset",
                              "de": "Teilmenge"
                            },
                            "description": {
                              "en": "Subset of the standard the artifact uses.",
                              "de": "Vom Artefakt verwendete Teilmenge des Standards."
                            }
                          }
                        }
                      },
                      "x-semio-ui": {
                        "role": "value",
                        "label": {
                          "en": "Dialect",
                          "de": "Dialekt"
                        },
                        "description": {
                          "en": "Artifact kind, standard and subset of the child.",
                          "de": "Artefaktart, Standard und Teilmenge des Kindes."
                        }
                      }
                    }
                  },
                  "x-semio-ui": {
                    "role": "value",
                    "label": {
                      "en": "Target",
                      "de": "Ziel"
                    },
                    "description": {
                      "en": "Artifact the mesh child points at.",
                      "de": "Artefakt, auf das das Netz-Kind verweist."
                    }
                  }
                }
              }
            }
          ],
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Mesh",
              "de": "Netz"
            },
            "description": {
              "en": "Owned mesh child of the object; empty for none.",
              "de": "Eigenes Netz-Kind des Objekts; leer für keines."
            }
          }
        },
        "transform": {
          "title": "LowpolyTransform",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "rotation",
            "scale"
          ],
          "properties": {
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "rotation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "scale": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "smoothShading": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Smooth Shading",
              "de": "Glatte Schattierung"
            },
            "description": {
              "en": "Interpolates normals across faces.",
              "de": "Interpoliert Normalen über Flächen hinweg."
            }
          }
        },
        "meshContent": {
          "type": "string",
          "x-semio-ui": {
            "widget": "multiline",
            "role": "value",
            "label": {
              "en": "Mesh Content",
              "de": "Netzinhalt"
            },
            "description": {
              "en": "Mesh content set together with the mesh child.",
              "de": "Zusammen mit dem Netz-Kind gesetzter Netzinhalt."
            }
          }
        },
        "paintLayers": {
          "type": "array",
          "items": {
            "title": "LowpolyPaintLayer",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "blendMode",
              "name",
              "opacity",
              "pixels",
              "visible"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "visible": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number"
              },
              "blendMode": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Blend Mode",
                    "de": "Füllmethode"
                  },
                  "description": {
                    "en": "How the layer combines with the layers below, e.g. normal or multiply.",
                    "de": "Wie die Ebene mit den darunterliegenden Ebenen verrechnet wird, z. B. normal oder multiply."
                  }
                }
              },
              "pixels": {
                "type": "string",
                "contentEncoding": "base64"
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Paint Layers",
              "de": "Malebenen"
            },
            "description": {
              "en": "Paint layers from bottom to top.",
              "de": "Malebenen von unten nach oben."
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The complete object record to add.",
          "de": "Das vollständige hinzuzufügende Objekt."
        }
      }
    }
  }
}
