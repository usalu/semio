{
  "$id": "https://semio.tech/schema/s/lowpoly/lowpoly/inference.json",
  "title": "LowpolyInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["objectCount", "bounds"],
  "properties": {
    "objectCount": {
      "type": "integer",
      "minimum": 0,
      "x-semio-derived": true
    },
    "bounds": {
      "oneOf": [{ "$ref": "#/$defs/LowpolyBounds" }, { "type": "null" }],
      "x-semio-derived": true
    }
  },
  "$defs": {
    "LowpolyBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "max": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
      }
    }
  }
}
