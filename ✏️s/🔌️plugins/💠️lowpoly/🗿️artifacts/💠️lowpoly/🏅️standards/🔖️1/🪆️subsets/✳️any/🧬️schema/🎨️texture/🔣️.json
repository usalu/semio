{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://s.lowpoly/CanonicalPaintPixels",
  "title": "Canonical Lowpoly Paint Pixels",
  "type": "array",
  "items": {
    "type": "integer",
    "minimum": 0,
    "maximum": 255
  },
  "oneOf": [
    {
      "maxItems": 0
    },
    {
      "minItems": 262144,
      "maxItems": 262144
    }
  ],
  "definitions": {
    "Layout": {
      "const": {
        "version": 1,
        "width": 256,
        "height": 256,
        "channels": 4,
        "explicitBytes": 262144,
        "emptyRgba": [
          255,
          255,
          255,
          255
        ]
      }
    }
  }
}
