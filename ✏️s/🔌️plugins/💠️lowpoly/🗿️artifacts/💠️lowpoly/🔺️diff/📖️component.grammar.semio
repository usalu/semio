dialect grammar
grammar lowpoly.diff
extension lowpoly
use family-scene
start diff

diff = {"objects" "=" objects-collection-diff}? {"paint-layers" "=" paint-layers-collection-diff}? {"projection" "=" projection-block}?
objects-collection-diff = "{" objects-diff-field* "}"
objects-diff-field = {"added" "=" "[" object* "]"} | {"removed" "=" "[" IDENT* "]"} | {"moved" "=" "[" move-entry* "]"} | {"modified" "=" "[" object-mod* "]"}
paint-layers-collection-diff = "{" paint-layers-diff-field* "}"
paint-layers-diff-field = {"object-id" "=" IDENT} | {"added" "=" "[" paint-layer* "]"} | {"removed" "=" "[" INT* "]"} | {"moved" "=" "[" paint-move-entry* "]"} | {"modified" "=" "[" paint-layer-mod* "]"}
move-entry = "{" "id" "=" IDENT "to-index" "=" INT "}"
paint-move-entry = "{" "index" "=" INT "to-index" "=" INT "}"
object-mod = "{" "id" "=" IDENT object-patch-field* "}"
object-patch-field = {"name" "=" TEXT} | {"smooth-shading" "=" BOOL} | mesh | object-transform
paint-layer-mod = "{" "index" "=" INT paint-layer-patch-field* "}"
paint-layer-patch-field = {"name" "=" TEXT} | {"visible" "=" BOOL} | {"opacity" "=" FLOAT} | {"blend-mode" "=" IDENT}
object = "{" object-field* "}"
object-field = {"id" "=" IDENT} | {"name" "=" TEXT} | {"smooth-shading" "=" BOOL} | mesh | object-transform | paint-layers
object-transform = "transform" "{" transform-field* "}"
transform-field = {"position" "=" VEC3} | {"rotation" "=" VEC3} | {"scale" "=" VEC3}
mesh = "mesh" "{" vertices halfedges faces "}"
vertices = "vertices" "[" vertex* "]" | "vertices" "{" vertex* "}"
vertex = "{" {"position" "=" VEC3} {"normal" "=" VEC3}? {"halfedge" "=" INT}? "}"
halfedges = "halfedges" "[" halfedge* "]" | "halfedges" "{" halfedge* "}"
halfedge = "{" {"vertex" "=" INT} {"next" "=" INT} {"twin" "=" INT}? {"face" "=" INT}? {"u" "=" FLOAT}? {"v" "=" FLOAT}? "}"
faces = "faces" "[" face* "]" | "faces" "{" face* "}"
face = "{" {"halfedge" "=" INT} {"smooth" "=" BOOL}? {"flipped" "=" BOOL}? "}"
paint-layers = "paint-layers" "=" "[" paint-layer* "]" | "paint-layers" "{" paint-layer* "}"
paint-layer = "{" paint-layer-field* "}"
paint-layer-field = {"name" "=" TEXT} | {"visible" "=" BOOL} | {"opacity" "=" FLOAT} | {"blend-mode" "=" IDENT} | {"pixels" "=" TEXT}
projection-block = "projection" "{" schema-line? objects-field? scene-compose? "}"
schema-line = "schema" "=" IDENT
objects-field = "objects" "=" "[" object* "]" | "objects" "=" object*
scene-compose = "scene" "{" layer* "}"
