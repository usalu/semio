{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.dev/schema/lowpoly-interactive-job-partition-v1.json",
  "title": "Lowpoly Interactive Job Partition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "maximumPollMicros",
    "maximumRawBytes",
    "maximumWorkItems",
    "artifactStoreMaximumBytes",
    "configStoreMaximumBytes",
    "routes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owner": {
      "const": "LowpolyPlayApp"
    },
    "maximumPollMicros": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8000
    },
    "maximumRawBytes": {
      "const": 16384
    },
    "maximumWorkItems": {
      "const": 258
    },
    "artifactStoreMaximumBytes": {
      "const": 16777216
    },
    "configStoreMaximumBytes": {
      "const": 16384
    },
    "routes": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "toolId",
          "classification",
          "lanes",
          "preparation",
          "blocker"
        ],
        "properties": {
          "toolId": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "Migrated",
              "BatchOnlyPendingRewrite"
            ]
          },
          "lanes": {
            "type": "array",
            "uniqueItems": true,
              "items": {
                "enum": [
                  "HostOnly",
                  "Artifact",
                  "Config",
                  "Transient"
                ]
              },
              "maxItems": 2
          },
          "preparation": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "Artifact",
                "Config"
              ]
            },
            "maxItems": 1
          },
          "blocker": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "Migrated"
                }
              }
            },
          "then": {
            "properties": {
              "lanes": {
                "type": "array",
                "minItems": 1
              },
              "preparation": {
                "type": "array"
              },
              "blocker": {
                "type": "null"
              }
            },
            "oneOf": [
              {
                "properties": {
                  "lanes": {
                    "const": [
                      "Artifact"
                    ]
                  },
                  "preparation": {
                    "const": [
                      "Artifact"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "lanes": {
                    "const": [
                      "Config"
                    ]
                  },
                  "preparation": {
                    "const": [
                      "Config"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "lanes": {
                    "const": [
                      "HostOnly"
                    ]
                  },
                  "preparation": {
                    "const": []
                  }
                }
              },
              {
                "properties": {
                  "lanes": {
                    "const": [
                      "Transient"
                    ]
                  },
                  "preparation": {
                    "const": []
                  }
                }
              },
              {
                "properties": {
                  "lanes": {
                    "const": [
                      "Config",
                      "Transient"
                    ]
                  },
                  "preparation": {
                    "const": [
                      "Config"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "lanes": {
                    "const": [
                      "Artifact",
                      "Transient"
                    ]
                  },
                  "preparation": {
                    "const": [
                      "Artifact"
                    ]
                  }
                }
              }
            ]
          }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "BatchOnlyPendingRewrite"
                }
              }
            },
            "then": {
            "properties": {
              "lanes": {
                "type": "array",
                "maxItems": 0
              },
              "preparation": {
                "type": "array",
                "maxItems": 0
              },
                "blocker": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
