{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/lowpoly/schema.json",
  "$defs": {
    "LowpolyInteractiveJobPartition": {
      "title": "LowpolyInteractiveJobPartition",
      "description": "💠️ The interactive-job partition of the Lowpoly play app: 47 classified routes, the retained byte/work budgets, and the eight `oneOf` lane→preparation signatures a `Migrated` route may carry. The eighth arm (`[\"Artifact\",\"Config\",\"Transient\"]`→`[\"Artifact\",\"Config\"]`) is what makes `addPrimitive` representable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "owner",
        "maximumPollMicros",
        "maximumRawBytes",
        "maximumWorkItems",
        "artifactStoreMaximumBytes",
        "configStoreMaximumBytes",
        "routes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "owner": {
          "const": "LowpolyPlayApp"
        },
        "maximumPollMicros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8000
        },
        "maximumRawBytes": {
          "const": 16384
        },
        "maximumWorkItems": {
          "const": 258
        },
        "artifactStoreMaximumBytes": {
          "const": 16777216
        },
        "configStoreMaximumBytes": {
          "const": 16384
        },
        "routes": {
          "type": "array",
          "minItems": 47,
          "maxItems": 47,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "toolId",
              "classification",
              "lanes",
              "preparation",
              "blocker"
            ],
            "properties": {
              "toolId": {
                "type": "string",
                "minLength": 1
              },
              "classification": {
                "enum": [
                  "migrated",
                  "batch-only-pending-rewrite"
                ]
              },
              "lanes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "host-only",
                    "artifact",
                    "config",
                    "transient"
                  ]
                },
                "maxItems": 3
              },
              "preparation": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "Artifact",
                    "Config"
                  ]
                },
                "maxItems": 2
              },
              "blocker": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "classification": {
                      "const": "migrated"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "lanes": {
                      "type": "array",
                      "minItems": 1
                    },
                    "preparation": {
                      "type": "array"
                    },
                    "blocker": {
                      "type": "null"
                    }
                  },
                  "oneOf": [
                    {
                      "properties": {
                        "lanes": {
                          "const": [
                            "artifact"
                          ]
                        },
                        "preparation": {
                          "const": [
                            "Artifact"
                          ]
                        }
                      }
                    },
                    {
                      "properties": {
                        "lanes": {
                          "const": [
                            "config"
                          ]
                        },
                        "preparation": {
                          "const": [
                            "Config"
                          ]
                        }
                      }
                    },
                    {
                      "properties": {
                        "lanes": {
                          "const": [
                            "host-only"
                          ]
                        },
                        "preparation": {
                          "const": []
                        }
                      }
                    },
                    {
                      "properties": {
                        "lanes": {
                          "const": [
                            "transient"
                          ]
                        },
                        "preparation": {
                          "const": []
                        }
                      }
                    },
                    {
                      "properties": {
                        "lanes": {
                          "const": [
                            "config",
                            "transient"
                          ]
                        },
                        "preparation": {
                          "const": [
                            "Config"
                          ]
                        }
                      }
                    },
                    {
                      "properties": {
                        "lanes": {
                          "const": [
                            "artifact",
                            "transient"
                          ]
                        },
                        "preparation": {
                          "const": [
                            "Artifact"
                          ]
                        }
                      }
                    },
                    {
                      "properties": {
                        "lanes": {
                          "const": [
                            "artifact",
                            "config"
                          ]
                        },
                        "preparation": {
                          "const": [
                            "Artifact",
                            "Config"
                          ]
                        }
                      }
                    },
                    {
                      "properties": {
                        "lanes": {
                          "const": [
                            "artifact",
                            "config",
                            "transient"
                          ]
                        },
                        "preparation": {
                          "const": [
                            "Artifact",
                            "Config"
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "classification": {
                      "const": "batch-only-pending-rewrite"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "lanes": {
                      "type": "array",
                      "maxItems": 0
                    },
                    "preparation": {
                      "type": "array",
                      "maxItems": 0
                    },
                    "blocker": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
