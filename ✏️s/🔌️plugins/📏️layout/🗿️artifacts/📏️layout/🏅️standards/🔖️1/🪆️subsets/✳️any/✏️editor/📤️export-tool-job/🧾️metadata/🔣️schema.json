{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "base",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.layout.export-metadata.tests/v1"
    },
    "base": {
      "type": "object",
      "required": [
        "name",
        "documentId",
        "pageId",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "pageId": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "png",
              "svg",
              "pdf",
              "step",
              "idml",
              "package"
            ]
          },
          "pageId": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          },
          "accept": {
            "type": "boolean"
          },
          "cancel": {
            "type": "boolean"
          },
          "denied": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
