{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "fonts",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fonts": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "size",
          "hash"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "text",
        "preferred",
        "missingScalar"
      ]
    }
  }
}
