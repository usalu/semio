{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/create-story/schema.json",
  "title": "CreateStory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "story"
  ],
  "properties": {
    "story": {
      "title": "TextStory",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "id",
        "styleRuns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "content": {
          "type": "string",
          "x-semio-ui": {
            "widget": "multiline",
            "role": "value",
            "label": {
              "en": "Text",
              "de": "Text"
            },
            "group": "text",
            "order": 20
          }
        },
        "styleRuns": {
          "type": "array",
          "items": {
            "title": "TextStyleRun",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "end",
              "start"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Start",
                    "de": "Beginn"
                  },
                  "description": {
                    "en": "First character offset of the run.",
                    "de": "Zeichenposition, an der der Bereich beginnt."
                  },
                  "step": 1,
                  "precision": 0,
                  "group": "range",
                  "order": 10
                }
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "End",
                    "de": "Ende"
                  },
                  "description": {
                    "en": "Character offset after the run.",
                    "de": "Zeichenposition nach dem Bereich."
                  },
                  "step": 1,
                  "precision": 0,
                  "group": "range",
                  "order": 20
                }
              },
              "paragraphStyleId": {
                "type": [
                  "string",
                  "null"
                ],
                "x-semio-ui": {
                  "widget": "reference",
                  "role": "target",
                  "label": {
                    "en": "Paragraph style",
                    "de": "Absatzformat"
                  },
                  "ref": {
                    "kind": "paragraphStyle"
                  },
                  "group": "target",
                  "order": 30
                }
              },
              "characterStyleId": {
                "type": [
                  "string",
                  "null"
                ],
                "x-semio-ui": {
                  "widget": "reference",
                  "role": "target",
                  "label": {
                    "en": "Character style",
                    "de": "Zeichenformat"
                  },
                  "ref": {
                    "kind": "characterStyle"
                  },
                  "group": "target",
                  "order": 40
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Style runs",
              "de": "Formatbereiche"
            },
            "group": "record",
            "order": 30
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Story",
          "de": "Textfluss"
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Index",
          "de": "Index"
        },
        "description": {
          "en": "Position in the list; empty appends at the end.",
          "de": "Position in der Liste; leer hängt am Ende an."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 20
      }
    }
  }
}
