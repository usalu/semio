{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semio:layout-paragraph-turn:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "glyph",
    "color",
    "italic",
    "rotation",
    "center"
  ],
  "properties": {
    "source": {
      "type": "integer",
      "minimum": 0
    },
    "glyph": {
      "type": "integer",
      "minimum": 0
    },
    "color": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "italic": {
      "type": "boolean"
    },
    "rotation": {
      "type": "number"
    },
    "center": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    }
  }
}
