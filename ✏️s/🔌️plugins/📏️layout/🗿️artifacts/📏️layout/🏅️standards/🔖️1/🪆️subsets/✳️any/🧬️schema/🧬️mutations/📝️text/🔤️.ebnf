(* ebnf layout.layout.mutations *)
(* Below: ISO-14977-style mirror of the normative 📖️.grammar.semio (same production
   names, kebab-case -> "space case"). This facet's .semio defines no header/body/payload
   envelope (`start line`); the two lines above are preserved verbatim from the prior
   identity fix for traceability but are not referenced below. *)
document = header, body ;
header = 'schema', space, 'layout.layout.mutations', newline ;

line = rename layout
     | change print target
     | change data fields
     | create page
     | delete page
     | rename page
     | change page width
     | change page height
     | update page margins
     | update page columns
     | reorder pages
     | create story
     | delete story
     | edit story
     | create link
     | delete link
     | change link path
     | create frame
     | delete frame
     | move frame
     | resize frame
     | rotate frame
     | change frame fill
     | change frame stroke
     | change frame wrap mode
     | change frame columns
     | update grid
     | set frame flags
     | update paragraph style
     | update text frame
     | update layer
     | create character style
     | delete character style
     | update character style
     | update parent page
     | update spread
     | set page parent
     | set page guides
     | set story runs
     | update link
     | set page overrides
     | create layer
     | set frame layer
     | set drawing text
     | reorder frame
     | drag frames
     | rotate frames
     | scale frames ;
rename layout = 'rename-layout', space, text ;
change print target = 'change-print-target', space, [ text ] ;
change data fields = 'change-data-fields', space, [ text ] ;
create page = 'create-page', space, block, space, [ number ] ;
delete page = 'delete-page', space, id ;
rename page = 'rename-page', space, id, space, text ;
change page width = 'change-page-width', space, id, space, number ;
change page height = 'change-page-height', space, id, space, number ;
update page margins = 'update-page-margins', space, id, space, number, space, number, space, number, space, number ;
update page columns = 'update-page-columns', space, id, space, number, space, number ;
reorder pages = 'reorder-pages', space, id, space, number ;
create story = 'create-story', space, block, space, [ number ] ;
delete story = 'delete-story', space, id ;
edit story = 'edit-story', space, id, space, text ;
create link = 'create-link', space, block, space, [ number ] ;
delete link = 'delete-link', space, id ;
change link path = 'change-link-path', space, id, space, text ;
create frame = 'create-frame', space, id, space, block, space, [ number ], space, [ id ] ;
delete frame = 'delete-frame', space, id, space, id ;
move frame = 'move-frame', space, id, space, id, space, number, space, number ;
resize frame = 'resize-frame', space, id, space, id, space, number, space, number ;
rotate frame = 'rotate-frame', space, id, space, id, space, number ;
change frame fill = 'change-frame-fill', space, id, space, id, space, [ block ] ;
change frame stroke = 'change-frame-stroke', space, id, space, id, space, [ block ] ;
change frame wrap mode = 'change-frame-wrap-mode', space, id, space, id, space, text ;
change frame columns = 'change-frame-columns', space, id, space, id, space, number ;
update grid = 'update-grid', space, number, space, number, space, boolean ;
update paragraph style = 'update-paragraph-style', space, id, space, text, space, text, space, number, space, number, space, number, space, number, space, text ;
update text frame = 'update-text-frame', space, id, space, id, space, text, space, text, space, number, space, number, space, number, space, number ;
update layer = 'update-layer', space, id, space, id, space, text, space, boolean, space, boolean ;
create character style = 'create-character-style', space, id, space, [ text ] ;
delete character style = 'delete-character-style', space, id ;
update character style = 'update-character-style', space, id, space, [ text ], space, [ text ], space, [ number ], space, [ number ], space, [ boolean ], space, [ block ], space, [ number ] ;
update parent page = 'update-parent-page', space, id, space, text, space, number, space, number ;
update spread = 'update-spread', space, id, space, text ;
set page parent = 'set-page-parent', space, id, space, [ id ] ;
set frame flags = 'set-frame-flags', space, id, space, id, space, [ boolean ], space, [ boolean ] ;
id = octet, { octet } ;
number = octet, { octet } ;
text = octet, { octet } ;
boolean = 'true'
     | 'false' ;
block = '{', newline, octet, { octet }, '}' ;

(* Framework dialect-primitive terminals, given one concrete definition each for a
   self-contained mirror (not defined in the .semio itself — ticket-reported deviation). *)
newline = [ '\r' ], '\n' ;
octet = ? any single raw byte ? ;
space = ' ' ;
set page guides = 'set-page-guides', space, id, space, block ;
set story runs = 'set-story-runs', space, id, space, block ;
update link = 'update-link', space, id, space, number, space, number, space, number, space, [ text ] ;
set page overrides = 'set-page-overrides', space, id, space, block ;
create layer = 'create-layer', space, id, space, id, space, text, space, [ boolean ] ;
set frame layer = 'set-frame-layer', space, id, space, id, space, id ;
set drawing text = 'set-drawing-text', space, number, space, text ;
reorder frame = 'reorder-frame', space, id, space, id, space, boolean ;
drag frames = 'drag-frames', space, id, space, block, space, number, space, number ;
rotate frames = 'rotate-frames', space, id, space, block, space, number, space, number, space, number ;
scale frames = 'scale-frames', space, id, space, block, space, number, space, number, space, number, space, number ;
