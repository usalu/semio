{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageId",
    "frame"
  ],
  "properties": {
    "pageId": {
      "type": "string"
    },
    "frame": {
      "$ref": "#/$defs/Frame"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "layerId": {
      "type": "string"
    }
  },
  "$defs": {
    "Frame": {
      "title": "Frame",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    }
  }
}
