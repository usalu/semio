{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/set-page-parent/schema.json",
  "title": "SetPageParent",
  "type": "object",
  "additionalProperties": false,
  "required": [
