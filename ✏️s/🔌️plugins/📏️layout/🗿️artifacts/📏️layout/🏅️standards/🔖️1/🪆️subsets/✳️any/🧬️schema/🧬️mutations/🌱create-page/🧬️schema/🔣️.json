{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/create-page/schema.json",
  "title": "CreatePage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "page"
  ],
  "properties": {
    "page": {
      "$ref": "#/$defs/Page",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Index",
          "de": "Index"
        },
        "description": {
          "en": "Position in the list; empty appends at the end.",
          "de": "Position in der Liste; leer hängt am Ende an."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 20
      }
    }
  },
  "$defs": {
    "Page": {
      "title": "Page",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Name"
            },
            "group": "identity",
            "order": 20
          }
        },
        "width": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Width",
              "de": "Breite"
            },
            "unit": "mm",
            "step": 1,
            "precision": 1,
            "group": "geometry",
            "order": 30
          }
        },
        "height": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Height",
              "de": "Höhe"
            },
            "unit": "mm",
            "step": 1,
            "precision": 1,
            "group": "geometry",
            "order": 40
          }
        }
      }
    }
  }
}
