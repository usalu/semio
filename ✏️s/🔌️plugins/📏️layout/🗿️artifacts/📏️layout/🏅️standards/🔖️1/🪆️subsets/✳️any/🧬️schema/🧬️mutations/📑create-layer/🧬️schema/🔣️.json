{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/create-layer/schema.json",
  "title": "CreateLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageId",
    "id",
    "name"
  ],
  "properties": {
    "pageId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "ref": {
          "kind": "page"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Layer ID",
          "de": "Ebenen-ID"
        },
        "description": {
          "en": "Id of the new layer.",
          "de": "ID der neuen Ebene."
        },
        "group": "identity",
        "order": 20
      }
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Layer name",
          "de": "Ebenenname"
        },
        "group": "identity",
        "order": 30
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based stacking position among the page's layers; empty or past the end appends.",
          "de": "Nullbasierte Stapelposition unter den Ebenen der Seite; leer oder dahinter hängt an."
        },
        "step": 1,
        "precision": 0,
        "group": "placement",
        "order": 35
      }
    },
    "remove": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Remove layer",
          "de": "Ebene entfernen"
        },
        "description": {
          "en": "On removes the named empty layer instead of creating it; this is the inverse step.",
          "de": "Ein entfernt die genannte leere Ebene, statt sie anzulegen; das ist der Umkehrschritt."
        },
        "group": "state",
        "order": 40
      }
    }
  }
}
