{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangeFrameFill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frameId",
    "pageId"
  ],
  "properties": {
    "pageId": {
      "type": "string"
    },
    "frameId": {
      "type": "string"
    },
    "newFill": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    }
  }
}
