{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layout Bounded Output Text Fragment Cases",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "capacity",
          "parts",
          "accepted",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8192
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accepted": {
            "type": "boolean"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    }
  }
}
