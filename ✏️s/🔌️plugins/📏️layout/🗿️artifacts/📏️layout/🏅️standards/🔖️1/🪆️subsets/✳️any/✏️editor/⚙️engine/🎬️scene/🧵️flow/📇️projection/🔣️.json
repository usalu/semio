{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayoutFlowProjectionGrant",
  "type": "object",
  "required": [
    "maximumSourceItems",
    "maximumCapacityBytes",
    "maximumCopyBytes",
    "maximumDepth"
  ],
  "additionalProperties": false,
  "properties": {
    "maximumSourceItems": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "maximumCapacityBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maximumCopyBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maximumDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "description": "One advance performs at most one source scalar/header/hash/compare or fixed structural index operation, or reserves one original metadata block. No strings or source frames are copied. Output ordinals use the flow frame u32 schema."
}
