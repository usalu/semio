{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/edit-story/schema.json",
  "title": "EditStory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "offset",
    "delete",
    "insert"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Story",
          "de": "Textfluss"
        },
        "ref": {
          "kind": "story"
        },
        "group": "target",
        "order": 10
      }
    },
    "offset": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Offset",
          "de": "Position"
        },
        "group": "splice",
        "order": 20,
        "step": 1,
        "precision": 0
      }
    },
    "delete": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Delete",
          "de": "Löschen"
        },
        "group": "splice",
        "order": 30,
        "step": 1,
        "precision": 0
      }
    },
    "insert": {
      "type": "string",
      "x-semio-ui": {
        "widget": "multiline",
        "role": "value",
        "label": {
          "en": "Insert",
          "de": "Einfügen"
        },
        "group": "splice",
        "order": 40
      }
    }
  }
}
