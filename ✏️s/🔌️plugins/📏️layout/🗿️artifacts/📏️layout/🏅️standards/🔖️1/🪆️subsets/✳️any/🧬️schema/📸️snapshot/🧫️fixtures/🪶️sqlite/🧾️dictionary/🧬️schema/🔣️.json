{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "valueKinds",
    "floatWords",
    "dictionary",
    "tables",
    "refusals",
    "absence",
    "empty",
    "memberNull",
    "allocation",
    "retirementRefund",
    "nativePreflight",
    "liveVcs"
  ],
  "properties": {
    "schema": {
      "const": "layout.form-dictionary/v1"
    },
    "valueKinds": {
      "const": [
        "null",
        "boolean",
        "unsigned",
        "signed",
        "float",
        "text",
        "bytes",
        "array",
        "object"
      ]
    },
    "floatWords": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "dictionary": {
      "$ref": "#/$defs/dictionary"
    },
    "tables": {
      "const": [
        "layout_form_dictionary",
        "layout_dictionary_entry",
        "layout_dictionary_value",
        "layout_dictionary_boolean",
        "layout_dictionary_unsigned",
        "layout_dictionary_signed",
        "layout_dictionary_float",
        "layout_dictionary_text",
        "layout_dictionary_bytes",
        "layout_dictionary_array",
        "layout_dictionary_member"
      ]
    },
    "refusals": {
      "const": [
        "duplicateQuestionId",
        "orphanValue",
        "sparseOrdinal",
        "wrongScalarKind",
        "sharedValueOwner"
      ]
    },
    "absence": {
      "const": "noDictionaryRow"
    },
    "empty": {
      "const": "dictionaryRowWithoutEntries"
    },
    "memberNull": {
      "const": "entryWithNullValue"
    },
    "allocation": {
      "const": "fullConcreteRequests"
    },
    "retirementRefund": {
      "const": false
    },
    "nativePreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "encodings",
        "scratchOwnership",
        "copiedOwnerFields",
        "forecastCeilings",
        "ownedAllowance",
        "literal",
        "repeat",
        "utf8Bytes",
        "cancelAfterBytes"
      ],
      "properties": {
        "schema": {
          "const": "layout.borrowed-native/v1"
        },
        "encodings": {
          "const": [
            "binary",
            "text"
          ]
        },
        "scratchOwnership": {
          "const": "paidFrontiersOnly"
        },
        "copiedOwnerFields": {
          "const": false
        },
        "forecastCeilings": {
          "const": [
            "maxFileBytes",
            "maxValueBytes"
          ]
        },
        "ownedAllowance": {
          "const": "maxAllocationBytes"
        },
        "literal": {
          "const": "é語🧾"
        },
        "repeat": {
          "const": 14564
        },
        "utf8Bytes": {
          "const": 131076
        },
        "cancelAfterBytes": {
          "const": 65536
        }
      }
    },
    "liveVcs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "producer",
        "consumer",
        "output",
        "input",
        "wire",
        "payloadSchema",
        "questionIds",
        "flow",
        "failureBeforeDispatch",
        "completedOwner"
      ],
      "properties": {
        "schema": {
          "const": "forms.layout.intrinsic-vcs/v1"
        },
        "producer": {
          "const": "FormsPlayApp"
        },
        "consumer": {
          "const": "LayoutPlayApp"
        },
        "output": {
          "const": "dictionary:out"
        },
        "input": {
          "const": "fields:in"
        },
        "wire": {
          "const": "intrinsic"
        },
        "payloadSchema": {
          "const": "form.dictionary"
        },
        "questionIds": {
          "const": [
            "null",
            "flag",
            "wide",
            "signed",
            "word",
            "literal\u0000語",
            "octets",
            "ordered",
            "unknown",
            "word0",
            "word1",
            "word2",
            "word3",
            "word4",
            "word5",
            "word6",
            "word7"
          ]
        },
        "flow": {
          "const": [
            "registeredEditor",
            "documentPackLoad",
            "produceMedia",
            "wirePackRoundTrip",
            "consumeMedia",
            "reservedImportJob",
            "documentEmit",
            "typedTargetSnapshot"
          ]
        },
        "failureBeforeDispatch": {
          "const": "unchangedRevision"
        },
        "completedOwner": {
          "const": "terminalEmpty"
        }
      }
    }
  },
  "$defs": {
    "dictionary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "value"
      ],
      "properties": {
        "questionId": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "unsigned"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "signed"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/member"
              }
            }
          }
        }
      ]
    }
  }
}
