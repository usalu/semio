{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/update-layer/schema.json",
  "title": "UpdateLayer",
  "type": "object",
  "additionalProperties": false,
  "required": ["pageId", "layerId", "name", "visible", "locked"],
  "properties": {
    "pageId": { "type": "string", "x-semio-ui": { "widget": "reference", "role": "target", "label": { "en": "Page", "de": "Seite" }, "ref": { "kind": "page" }, "group": "target", "order": 10 } },
    "layerId": { "type": "string", "x-semio-ui": { "widget": "reference", "role": "target", "label": { "en": "Layer", "de": "Ebene" }, "ref": { "kind": "layer" }, "group": "target", "order": 20 } },
    "name": { "type": "string", "minLength": 1, "x-semio-ui": { "widget": "text", "role": "value", "label": { "en": "Layer name", "de": "Ebenenname" }, "group": "identity", "order": 30 } },
    "visible": { "type": "boolean", "x-semio-ui": { "widget": "toggle", "role": "value", "label": { "en": "Visible", "de": "Sichtbar" }, "group": "state", "order": 40 } },
    "locked": { "type": "boolean", "x-semio-ui": { "widget": "toggle", "role": "value", "label": { "en": "Locked", "de": "Gesperrt" }, "group": "state", "order": 50 } }
  }
}
