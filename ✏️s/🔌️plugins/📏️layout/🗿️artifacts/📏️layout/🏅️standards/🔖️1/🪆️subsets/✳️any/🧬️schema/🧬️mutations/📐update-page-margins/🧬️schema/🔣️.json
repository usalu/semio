{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/update-page-margins/schema.json",
  "title": "UpdatePageMargins",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bottom",
    "id",
    "left",
    "right",
    "top"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "ref": {
          "kind": "page"
        },
        "group": "target",
        "order": 10
      }
    },
    "top": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Top margin",
          "de": "Rand oben"
        },
        "unit": "mm",
        "step": 1,
        "precision": 1,
        "group": "margins",
        "order": 20
      }
    },
    "right": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Right margin",
          "de": "Rand rechts"
        },
        "unit": "mm",
        "step": 1,
        "precision": 1,
        "group": "margins",
        "order": 30
      }
    },
    "bottom": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Bottom margin",
          "de": "Rand unten"
        },
        "unit": "mm",
        "step": 1,
        "precision": 1,
        "group": "margins",
        "order": 40
      }
    },
    "left": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Left margin",
          "de": "Rand links"
        },
        "unit": "mm",
        "step": 1,
        "precision": 1,
        "group": "margins",
        "order": 50
      }
    }
  }
}
