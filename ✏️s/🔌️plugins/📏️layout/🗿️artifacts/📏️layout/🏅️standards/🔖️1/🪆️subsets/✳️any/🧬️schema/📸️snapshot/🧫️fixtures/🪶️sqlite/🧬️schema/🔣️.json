{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "float64Bits",
    "float32Bits",
    "maximumU64",
    "maximumU32",
    "childIdentity",
    "imageArtifactKind",
    "imageArtifactRef",
    "drawingSchema",
    "columns",
    "query",
    "componentNodes",
    "componentDepth",
    "intrinsicBytes",
    "cancelAfter"
  ],
  "properties": {
    "schema": {
      "const": "layout.snapshot.sqlite/v1"
    },
    "float64Bits": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "float32Bits": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}$"
      }
    },
    "maximumU64": {
      "const": "18446744073709551615"
    },
    "maximumU32": {
      "const": 4294967295
    },
    "childIdentity": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "imageArtifactKind": {
      "type": "string"
    },
    "imageArtifactRef": {
      "type": "string"
    },
    "drawingSchema": {
      "type": "string"
    },
    "columns": {
      "const": [
        "artifact_kind",
        "artifact_ref"
      ]
    },
    "query": {
      "type": "string"
    },
    "componentNodes": {
      "const": 1024
    },
    "componentDepth": {
      "const": 256
    },
    "intrinsicBytes": {
      "const": 100000
    },
    "cancelAfter": {
      "const": 256
    }
  }
}
