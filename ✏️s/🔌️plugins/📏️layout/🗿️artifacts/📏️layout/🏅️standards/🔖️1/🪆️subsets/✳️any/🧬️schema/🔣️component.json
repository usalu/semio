{
  "$id": "https://semio.tech/schema/s/layout/layout/artifact.json",
  "title": "LayoutArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "grid",
    "paragraphStyles",
    "characterStyles",
    "stories",
    "links",
    "parentPages",
    "spreads",
    "pages",
    "selectedIds",
    "activePageId",
    "engagementInput",
    "cameraX",
    "cameraY",
    "cameraZoom",
    "previewCameraX",
    "previewCameraY",
    "previewCameraZoom",
    "dropPreview",
    "locale"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "name": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "grid": {
      "$ref": "#/$defs/GridSettings",
      "x-semio-state": "artifact"
    },
    "paragraphStyles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParagraphStyle"
      },
      "x-semio-state": "artifact"
    },
    "characterStyles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CharacterStyle"
      },
      "x-semio-state": "artifact"
    },
    "stories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TextStory"
      },
      "x-semio-state": "artifact"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImageLink"
      },
      "x-semio-state": "artifact"
    },
    "parentPages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParentPage"
      },
      "x-semio-state": "artifact"
    },
    "spreads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Spread"
      },
      "x-semio-state": "artifact"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Page"
      },
      "x-semio-state": "artifact"
    },
    "printTarget": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "dataFieldsJson": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "selectedIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "activePageId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "cameraX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraZoom": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "previewCameraX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "previewCameraY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "previewCameraZoom": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "dropPreview": {
      "$ref": "#/$defs/LayoutDropPreviewState",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    },
    "hoveredId": {
      "type": "string",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "GridSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineGrid",
        "baselineOffset",
        "snapToBaseline"
      ],
      "properties": {
        "baselineGrid": {
          "type": "number"
        },
        "baselineOffset": {
          "type": "number"
        },
        "snapToBaseline": {
          "type": "boolean"
        }
      }
    },
    "LayoutDropPreviewState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "x",
        "y"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "LayoutStringList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ParagraphStyle": {
      "type": "object",
      "additionalProperties": true
    },
    "CharacterStyle": {
      "type": "object",
      "additionalProperties": true
    },
    "TextStory": {
      "type": "object",
      "additionalProperties": true
    },
    "ImageLink": {
      "type": "object",
      "additionalProperties": true
    },
    "ParentPage": {
      "type": "object",
      "additionalProperties": true
    },
    "Spread": {
      "type": "object",
      "additionalProperties": true
    },
    "Page": {
      "type": "object",
      "additionalProperties": true
    },
    "LayoutArtifact": {
      "type": "object",
      "additionalProperties": true
    },
    "LayoutParagraphStylesDelta": {
      "type": "object",
      "additionalProperties": true
    },
    "LayoutCharacterStylesDelta": {
      "type": "object",
      "additionalProperties": true
    },
    "LayoutStoriesDelta": {
      "type": "object",
      "additionalProperties": true
    },
    "LayoutLinksDelta": {
      "type": "object",
      "additionalProperties": true
    },
    "LayoutParentPagesDelta": {
      "type": "object",
      "additionalProperties": true
    },
    "LayoutSpreadsDelta": {
      "type": "object",
      "additionalProperties": true
    },
    "LayoutPagesDelta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
