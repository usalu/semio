{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/update-character-style/schema.json",
  "title": "UpdateCharacterStyle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Character style",
          "de": "Zeichenformat"
        },
        "ref": {
          "kind": "characterStyle"
        },
        "group": "target",
        "order": 10
      }
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Style name",
          "de": "Formatname"
        },
        "description": {
          "en": "Empty leaves the style unnamed.",
          "de": "Leer lässt das Format unbenannt."
        },
        "group": "identity",
        "order": 20
      }
    },
    "fontFamily": {
      "type": [
        "string",
        "null"
      ],
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Font family",
          "de": "Schriftfamilie"
        },
        "description": {
          "en": "Empty inherits the paragraph style.",
          "de": "Leer übernimmt das Absatzformat."
        },
        "group": "type",
        "order": 30
      }
    },
    "fontSize": {
      "type": [
        "number",
        "null"
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Font size",
          "de": "Schriftgrad"
        },
        "description": {
          "en": "Empty inherits the paragraph style.",
          "de": "Leer übernimmt das Absatzformat."
        },
        "unit": "pt",
        "step": 0.5,
        "precision": 1,
        "group": "type",
        "order": 40
      }
    },
    "fontWeight": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Font weight",
          "de": "Schriftstärke"
        },
        "description": {
          "en": "CSS weight, e.g. 400 regular, 700 bold; empty inherits the paragraph style.",
          "de": "CSS-Stärke, z. B. 400 normal, 700 fett; leer übernimmt das Absatzformat."
        },
        "step": 100,
        "precision": 0,
        "group": "type",
        "order": 50
      }
    },
    "italic": {
      "type": [
        "boolean",
        "null"
      ],
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Italic",
          "de": "Kursiv"
        },
        "description": {
          "en": "Empty inherits the paragraph style.",
          "de": "Leer übernimmt das Absatzformat."
        },
        "group": "type",
        "order": 60
      }
    },
    "color": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Text color",
          "de": "Textfarbe"
        },
        "description": {
          "en": "RGBA, each channel 0 to 1; empty inherits the paragraph style.",
          "de": "RGBA, jeder Kanal 0 bis 1; leer übernimmt das Absatzformat."
        },
        "group": "appearance",
        "order": 70
      }
    },
    "tracking": {
      "type": [
        "number",
        "null"
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Tracking",
          "de": "Laufweite"
        },
        "description": {
          "en": "Empty inherits the paragraph style.",
          "de": "Leer übernimmt das Absatzformat."
        },
        "step": 1,
        "precision": 0,
        "group": "type",
        "order": 80
      }
    }
  }
}
