{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/update-page-columns/schema.json",
  "title": "UpdatePageColumns",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "count",
    "gutter",
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "ref": {
          "kind": "page"
        },
        "group": "target",
        "order": 10
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Columns",
          "de": "Spalten"
        },
        "step": 1,
        "precision": 0,
        "group": "columns",
        "order": 20
      }
    },
    "gutter": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Gutter",
          "de": "Spaltenabstand"
        },
        "unit": "mm",
        "step": 1,
        "precision": 1,
        "group": "columns",
        "order": 30
      }
    }
  }
}
