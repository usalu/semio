{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/change-page-width/schema.json",
  "title": "ChangePageWidth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newWidth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "ref": {
          "kind": "page"
        },
        "group": "target",
        "order": 10
      }
    },
    "newWidth": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Width",
          "de": "Breite"
        },
        "unit": "mm",
        "step": 1,
        "precision": 1,
        "group": "geometry",
        "order": 20
      }
    }
  }
}
