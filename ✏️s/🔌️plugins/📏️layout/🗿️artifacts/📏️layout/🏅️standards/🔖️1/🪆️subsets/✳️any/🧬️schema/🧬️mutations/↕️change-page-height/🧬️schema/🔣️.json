{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/layout/mutation/change-page-height/schema.json",
  "title": "ChangePageHeight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newHeight"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "ref": {
          "kind": "page"
        },
        "group": "target",
        "order": 10
      }
    },
    "newHeight": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Height",
          "de": "Höhe"
        },
        "unit": "mm",
        "step": 1,
        "precision": 1,
        "group": "geometry",
        "order": 20
      }
    }
  }
}
