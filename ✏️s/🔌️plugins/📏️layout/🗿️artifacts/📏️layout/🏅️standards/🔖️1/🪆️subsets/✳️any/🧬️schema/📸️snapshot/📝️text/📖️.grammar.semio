dialect grammar
grammar layout.document
extension layout
use family-scene
start document

# Real grammar for `LayoutSnapshot::print_dsl`/`parse_dsl`
# (📸️snapshot/🦀️.rs's `print_layout_snapshot_body`/`parse_layout_snapshot_body`,
# lines 150-214) — a hand-rolled `key=<hex-or-json-hex>` line codec, one line per field: scalar
# fields are `enc_str` (hex UTF-8 bytes); every collection/nested-record field
# (`grid`/`paragraphStyles`/`characterStyles`/`stories`/`links`/`parentPages`/`spreads`/`pages`/
# `printTarget`/`dataFieldsJson`/`backgroundDrawing`/`referencedModel`) is JSON-serialized THEN
# hex-encoded (`enc_json`, lines 141-146). This REPLACES the stale, cross-plugin copy-pasted
# "canvas layer" template (`layers { shape/path/text { canvas-field* } }`,
# `add-layer`/`set-stroke`/`move-layer`/`set-fill`) this file previously carried — see
# `.🧬semio/…/STUBS-AND-PLACEHOLDERS-COMPLETION/📓️grammar-envelope-transcription.md` for how that
# mismatch was discovered. Confirmed against this facet's own test suite
# (📝️text/🦀️.rs:129-137, `parse_dsl_reports_hand_rolled_codec_errors`, whose own doc
# comment calls out the OLD `dsl::` derive-engine grammar as gone, replaced by this hand-rolled
# codec) and its 14-field round trip test coverage.
artifact-mark = "semio layout.layout.dsl v1"
document = artifact-mark schema-line name-line grid-line paragraph-styles-line character-styles-line stories-line links-line parent-pages-line spreads-line pages-line print-target-line data-fields-json-line background-drawing-line referenced-model-line

schema-line = "schema" "=" hex
name-line = "name" "=" hex
grid-line = "grid" "=" json-hex
paragraph-styles-line = "paragraphStyles" "=" json-hex
character-styles-line = "characterStyles" "=" json-hex
stories-line = "stories" "=" json-hex
links-line = "links" "=" json-hex
parent-pages-line = "parentPages" "=" json-hex
spreads-line = "spreads" "=" json-hex
pages-line = "pages" "=" json-hex
print-target-line = "printTarget" "=" json-hex
data-fields-json-line = "dataFieldsJson" "=" json-hex
background-drawing-line = "backgroundDrawing" "=" json-hex
referenced-model-line = "referencedModel" "=" json-hex

# `json-hex` = a JSON-serialized value (any shape — object/array/string/number/null), then
# hex-encoded exactly like a bare scalar (`enc_json` composes `enc_str` over
# `serde_json::to_string`) — NOT the `[0]`/`[1,...]` option-tag bracket convention
# `raster.document`/`playbook.playbook` use for their own `Option<T>` fields; an absent
# `Option<T>` here is simply the hex encoding of the JSON literal `null`.
json-hex = hex

# `hex` (bare, deliberately not defined as a local production) is the framework's built-in `hex`
# macro — every hex-encoded leaf string is lowercase-hex UTF-8 bytes.
