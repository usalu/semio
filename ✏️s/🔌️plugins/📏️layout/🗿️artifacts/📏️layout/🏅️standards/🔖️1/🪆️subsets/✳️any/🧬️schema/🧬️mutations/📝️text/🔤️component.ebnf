(* ebnf layout.layout.mutations *)
(* Below: ISO-14977-style mirror of the normative 📖️component.grammar.semio (same production
   names, kebab-case -> "space case"). This facet's .semio defines no header/body/payload
   envelope (`start line`); the two lines above are preserved verbatim from the prior
   identity fix for traceability but are not referenced below. *)
document = header, body ;
header = 'schema', space, 'layout.layout.mutations', newline ;

line = rename layout
     | change print target
     | change data fields
     | create page
     | delete page
     | rename page
     | change page width
     | change page height
     | update page margins
     | update page columns
     | reorder pages
     | create story
     | delete story
     | edit story
     | create link
     | delete link
     | change link path
     | create frame
     | delete frame
     | move frame
     | resize frame
     | change frame fill
     | change frame stroke
     | change frame wrap mode
     | change frame columns ;
rename layout = 'rename-layout', space, text ;
change print target = 'change-print-target', space, [ text ] ;
change data fields = 'change-data-fields', space, [ text ] ;
create page = 'create-page', space, block, space, [ number ] ;
delete page = 'delete-page', space, id ;
rename page = 'rename-page', space, id, space, text ;
change page width = 'change-page-width', space, id, space, number ;
change page height = 'change-page-height', space, id, space, number ;
update page margins = 'update-page-margins', space, id, space, number, space, number, space, number, space, number ;
update page columns = 'update-page-columns', space, id, space, number, space, number ;
reorder pages = 'reorder-pages', space, id, space, number ;
create story = 'create-story', space, block, space, [ number ] ;
delete story = 'delete-story', space, id ;
edit story = 'edit-story', space, id, space, text ;
create link = 'create-link', space, block, space, [ number ] ;
delete link = 'delete-link', space, id ;
change link path = 'change-link-path', space, id, space, text ;
create frame = 'create-frame', space, id, space, block, space, [ number ], space, [ id ] ;
delete frame = 'delete-frame', space, id, space, id ;
move frame = 'move-frame', space, id, space, id, space, number, space, number ;
resize frame = 'resize-frame', space, id, space, id, space, number, space, number ;
change frame fill = 'change-frame-fill', space, id, space, id, space, [ block ] ;
change frame stroke = 'change-frame-stroke', space, id, space, id, space, [ block ] ;
change frame wrap mode = 'change-frame-wrap-mode', space, id, space, id, space, text ;
change frame columns = 'change-frame-columns', space, id, space, id, space, number ;
id = octet, { octet } ;
number = octet, { octet } ;
text = octet, { octet } ;
boolean = 'true'
     | 'false' ;
block = '{', newline, octet, { octet }, '}' ;

(* Framework dialect-primitive terminals, given one concrete definition each for a
   self-contained mirror (not defined in the .semio itself — ticket-reported deviation). *)
newline = [ '\r' ], '\n' ;
octet = ? any single raw byte ? ;
space = ' ' ;
