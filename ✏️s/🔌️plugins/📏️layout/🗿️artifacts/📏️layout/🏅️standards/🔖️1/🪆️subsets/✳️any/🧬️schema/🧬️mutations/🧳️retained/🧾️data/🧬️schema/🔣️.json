{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retained Layout Data Fields Semantic Cases",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "before",
          "after",
          "changed",
          "plan"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "before": {
            "anyOf": [
              {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/question-dictionary.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/question-dictionary.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "changed": {
            "type": "boolean"
          },
          "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "removed",
              "inserted",
              "moved"
            ],
            "properties": {
              "removed": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "inserted": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "moved": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "to": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
