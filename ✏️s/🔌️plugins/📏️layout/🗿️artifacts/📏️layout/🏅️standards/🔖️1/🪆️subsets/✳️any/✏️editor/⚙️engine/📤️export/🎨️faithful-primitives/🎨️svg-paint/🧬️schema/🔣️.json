{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayoutSvgPaint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slot",
    "color"
  ],
  "properties": {
    "slot": {
      "enum": [
        "fill",
        "stroke"
      ]
    },
    "color": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      ]
    }
  }
}
