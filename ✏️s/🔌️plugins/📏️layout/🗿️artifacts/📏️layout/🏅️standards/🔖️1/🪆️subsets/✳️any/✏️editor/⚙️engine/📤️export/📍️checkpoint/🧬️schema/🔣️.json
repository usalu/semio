{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Layout Export Replay Milestones",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "replay",
          "checkpointAt",
          "expectedCommitted"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "stage",
                "rawBytes",
                "encodedBytes",
                "publishedChunks"
              ],
              "additionalProperties": false,
              "properties": {
                "stage": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "rawBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                },
                "encodedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                },
                "publishedChunks": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16384
                }
              }
            }
          },
          "replay": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "stage",
                "rawBytes",
                "encodedBytes",
                "publishedChunks"
              ],
              "additionalProperties": false,
              "properties": {
                "stage": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "rawBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                },
                "encodedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                },
                "publishedChunks": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16384
                }
              }
            }
          },
          "checkpointAt": {
            "type": "integer",
            "minimum": 0
          },
          "expectedCommitted": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
