        ]
      ]
    },
    {
      "name": "rotated viewport preserves independent axis scales",
      "source": {
        "kind": "page",
        "page": 0
      },
      "placement": "canvas",
      "canvas": {
        "width": 200,
        "height": 100
      },
      "target": {
        "x": 10,
        "y": 20,
        "rotation": 1.5707963267948966,
        "width": 400,
        "height": 300
      },
      "path": [
        [
          20,
          10
        ],
        [
          180,
          90
