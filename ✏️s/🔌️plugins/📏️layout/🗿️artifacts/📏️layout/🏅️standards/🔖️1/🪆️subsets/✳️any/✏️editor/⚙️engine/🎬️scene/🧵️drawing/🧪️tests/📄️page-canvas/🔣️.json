{
  "schema": "layout.page-drawing.v1",
  "cases": [
    {
      "name": "page viewport preserves white margins",
      "source": {
        "kind": "page",
        "page": 0
      },
      "placement": "canvas",
      "canvas": {
        "width": 200,
        "height": 100
      },
      "target": {
        "x": 10,
        "y": 20,
        "rotation": 0,
        "width": 400,
        "height": 300
      },
      "path": [
        [
          20,
          10
        ],
        [
          180,
          90
        ]
      ],
      "expectedAffine": {
        "xx": 2,
        "xy": 0,
        "yx": 0,
        "yy": 3,
        "dx": 10,
        "dy": 20
      },
      "expectedPoints": [
        [
          50,
          50
        ],
        [
          370,
          290
        ]
      ]
    },
    {
