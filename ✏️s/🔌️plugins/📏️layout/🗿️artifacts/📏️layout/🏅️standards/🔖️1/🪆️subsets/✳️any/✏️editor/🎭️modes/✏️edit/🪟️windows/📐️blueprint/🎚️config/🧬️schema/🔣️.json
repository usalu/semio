{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layout.windowconfig",
  "title": "Layout Window Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["activePageId", "activeUtility", "camera"],
  "properties": {
    "activePageId": { "type": "string" },
    "activeUtility": { "type": "string" },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "$defs": {
    "Update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "patch"],
      "properties": {
        "kind": { "const": "update" },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "activePageId": { "anyOf": [{ "$ref": "#/properties/activePageId" }, { "type": "null" }] },
            "activeUtility": { "anyOf": [{ "$ref": "#/properties/activeUtility" }, { "type": "null" }] },
            "camera": { "anyOf": [{ "$ref": "#/properties/camera" }, { "type": "null" }] }
          }
        }
      }
    }
  }
}
