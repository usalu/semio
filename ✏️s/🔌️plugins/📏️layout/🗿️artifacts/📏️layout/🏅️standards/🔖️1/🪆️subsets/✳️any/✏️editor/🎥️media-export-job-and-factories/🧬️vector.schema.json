{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "2d.layout",
  "title": "Layout Vector Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "svg"
  ],
  "properties": {
    "schema": {
      "const": "2d.layout"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "frontierRevision"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "frontierRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "svg": {
      "type": "string",
      "minLength": 1
    }
  }
}
