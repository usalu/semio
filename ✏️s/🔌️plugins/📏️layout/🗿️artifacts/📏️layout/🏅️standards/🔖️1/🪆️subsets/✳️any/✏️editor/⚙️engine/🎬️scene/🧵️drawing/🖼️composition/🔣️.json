{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayoutDrawingComposition",
  "description": "The two-pass borrowed Drawing plan is consumed one funded command, payload slice, exact outline extent or primitive publication at a time. Source labels are copied once in bounded UTF-8 slices and then retained at stable original pointers; each label is shaped once and reused after page fitting. Path geometry stays local with a separate affine so stroke scaling is preserved. Raster payloads become data URLs through bounded source byte reads. All buffers and cursor ancestry retire through original quoted owners.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "placement",
    "target",
    "tolerance"
  ],
  "properties": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "document"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "page"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "placement": {
      "enum": [
        "content",
        "canvas"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height",
        "rotation"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "type": "number"
        }
      }
    },
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "$defs": {
    "publication": {
      "enum": [
        "progress",
        "path",
        "glyph",
        "image",
        "done"
      ]
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "properties": {
        "copyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
