{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/layout/layout/snapshot.json",
  "title": "LayoutSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "grid",
    "paragraphStyles",
    "characterStyles",
    "stories",
    "links",
    "parentPages",
    "spreads",
    "pages",
    "printTarget"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "name": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "grid": {
      "$ref": "#/$defs/GridSettings",
      "x-semio-state": "artifact"
    },
    "paragraphStyles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParagraphStyle"
      },
      "x-semio-state": "artifact"
    },
    "characterStyles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CharacterStyle"
      },
      "x-semio-state": "artifact"
    },
    "stories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TextStory"
      },
      "x-semio-state": "artifact"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImageLink"
      },
      "x-semio-state": "artifact"
    },
    "parentPages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParentPage"
      },
      "x-semio-state": "artifact"
    },
    "spreads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Spread"
      },
      "x-semio-state": "artifact"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Page"
      },
      "x-semio-state": "artifact"
    },
    "printTarget": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    },
    "dataFieldsJson": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "backgroundDrawing": {
      "$ref": "#/$defs/LayoutDrawingChild",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio",
      "x-semio-child-standard": "v1",
      "x-semio-child-subset": "drawing"
    },
    "referencedModel": {
      "$ref": "https://semio.tech/schema/os/store/link.json",
      "x-semio-state": "artifact",
      "x-semio-link-roles": [
        "model"
      ]
    }
  },
  "$defs": {
    "GridSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineGrid",
        "baselineOffset",
        "snapToBaseline"
      ],
      "properties": {
        "baselineGrid": {
          "type": "number"
        },
        "baselineOffset": {
          "type": "number"
        },
        "snapToBaseline": {
          "type": "boolean"
        }
      }
    },
    "ParagraphStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fontFamily",
        "fontSize",
        "fontWeight",
        "leading",
        "tracking",
        "alignment"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string"
        },
        "fontSize": {
          "type": "number"
        },
        "fontWeight": {
          "type": "integer",
          "minimum": 0
        },
        "leading": {
          "type": "number"
        },
        "tracking": {
          "type": "number"
        },
        "alignment": {
          "type": "string"
        }
      }
    },
    "CharacterStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fontFamily",
        "fontSize",
        "fontWeight",
        "italic",
        "color",
        "tracking"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fontFamily": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "fontWeight": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "italic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "tracking": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TextStyleRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "paragraphStyleId",
        "characterStyleId"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "paragraphStyleId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "characterStyleId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TextStory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "styleRuns"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "styleRuns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextStyleRun"
          }
        }
      }
    },
    "ImageLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "hash",
        "width",
        "height",
        "dpi",
        "colorProfile",
        "state",
        "proxyDataUrl"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "dpi": {
          "type": "integer",
          "minimum": 0
        },
        "colorProfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "proxyDataUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LayoutBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h",
        "rotation"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "rotation": {
          "type": "number"
        }
      }
    },
    "LayoutRect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    },
    "PageMargins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "type": "number"
        },
        "right": {
          "type": "number"
        },
        "bottom": {
          "type": "number"
        },
        "left": {
          "type": "number"
        }
      }
    },
    "PageColumns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "gutter"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "gutter": {
          "type": "number"
        }
      }
    },
    "Layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "visible",
        "locked",
        "objectIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "objectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Frame": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "layerId",
            "bounds",
            "locked",
            "visible",
            "fill",
            "stroke"
          ],
          "properties": {
            "kind": {
              "const": "rect"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": "string"
            },
            "bounds": {
              "$ref": "#/$defs/LayoutBounds"
            },
            "locked": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "visible": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fill": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "stroke": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "layerId",
            "bounds",
            "locked",
            "visible",
            "storyId",
            "threadNext",
            "columns",
            "inset",
            "wrapMode"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": "string"
            },
            "bounds": {
              "$ref": "#/$defs/LayoutBounds"
            },
            "locked": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "visible": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "storyId": {
              "type": "string"
            },
            "threadNext": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "columns": {
              "type": "integer",
              "minimum": 0
            },
            "inset": {
              "$ref": "#/$defs/LayoutRect"
            },
            "wrapMode": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "layerId",
            "bounds",
            "locked",
            "visible",
            "linkId"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "id": {
              "type": "string"
            },
            "layerId": {
              "type": "string"
            },
            "bounds": {
              "$ref": "#/$defs/LayoutBounds"
            },
            "locked": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "visible": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "linkId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "PageOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "bounds",
        "visible",
        "locked"
      ],
      "properties": {
        "objectId": {
          "type": "string"
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayoutBounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "locked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ParentPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "width",
        "height",
        "layerIds",
        "layers",
        "frames"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "layerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Layer"
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Frame"
          }
        }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "spreadId",
        "parentPageId",
        "width",
        "height",
        "margins",
        "columns",
        "guides",
        "layerIds",
        "layers",
        "frames",
        "overrides"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "spreadId": {
          "type": "string"
        },
        "parentPageId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "margins": {
          "$ref": "#/$defs/PageMargins"
        },
        "columns": {
          "$ref": "#/$defs/PageColumns"
        },
        "guides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LayoutRect"
          }
        },
        "layerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Layer"
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Frame"
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PageOverride"
          }
        }
      }
    },
    "Spread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "pageIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pageIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LayoutDrawingChild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "content"
      ],
      "properties": {
        "handle": {
          "$ref": "https://semio.tech/schema/os/store/child.json"
        },
        "content": {
          "$ref": "https://semio.tech/schema/s/stdio/semio/v1/drawing/snapshot.json"
        }
      }
    }
  }
}
