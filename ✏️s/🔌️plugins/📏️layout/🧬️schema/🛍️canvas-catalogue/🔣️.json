{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/layout/canvas-catalogue/transport/schema.json",
  "title": "Layout Canvas Catalogue Renderer Transport",
  "description": "The renderer forwards camelCase geometry and opaque catalogue data; the Layout action bridge independently admits catalogue kinds and payload JSON.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "canvasDragOver"
        },
        "args": {
          "type": "object",
          "required": [
            "surfaceId",
            "x",
            "y",
            "width",
            "height",
            "types"
          ],
          "additionalProperties": false,
          "properties": {
            "surfaceId": {
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "canvasDrop"
        },
        "args": {
          "type": "object",
          "required": [
            "surfaceId",
            "x",
            "y",
            "width",
            "height",
            "dragData"
          ],
          "additionalProperties": false,
          "properties": {
            "surfaceId": {
              "type": "string"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "dragData": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
