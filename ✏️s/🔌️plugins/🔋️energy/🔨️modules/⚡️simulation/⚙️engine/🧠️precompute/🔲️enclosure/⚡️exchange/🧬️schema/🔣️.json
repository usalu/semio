{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retained Diffuse Gray Enclosure Exchange",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "tolerance",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "semio.energy.enclosure.exchange/v1"
    },
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "areas",
          "emissivities",
          "view",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "emissivities": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "view": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "expected": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "enum": [
                  "Dimensions",
                  "InvalidArea",
                  "InvalidEmissivity",
                  "InvalidViewFactor",
                  "NonReciprocal",
                  "Singular"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
