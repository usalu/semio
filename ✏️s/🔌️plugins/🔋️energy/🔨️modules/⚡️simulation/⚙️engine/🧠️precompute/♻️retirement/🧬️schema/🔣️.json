{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "bodyBytes",
    "cutoffs",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "semio.energy.precompute.retirement/v1"
    },
    "bodyBytes": {
      "type": "integer",
      "minimum": 1
    },
    "cutoffs": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "model",
          "complete"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "model": {
            "enum": [
              "empty",
              "single",
              "600"
            ]
          },
          "complete": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
