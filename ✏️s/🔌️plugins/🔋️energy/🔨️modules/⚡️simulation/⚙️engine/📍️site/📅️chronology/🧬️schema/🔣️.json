{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema",
    "requirements",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.energy.weather-chronology/v1"
    },
    "requirements": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "calendar",
          "records",
          "admitted",
          "queries"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "calendar": {
            "enum": [
              "ActualDates",
              "TypicalYear"
            ]
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "admitted": {
            "type": "boolean"
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "hour",
                "policy",
                "expected"
              ],
              "properties": {
                "date": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "integer"
                  }
                },
                "hour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23
                },
                "policy": {
                  "enum": [
                    "Continuous",
                    "RepeatDay"
                  ]
                },
                "expected": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
