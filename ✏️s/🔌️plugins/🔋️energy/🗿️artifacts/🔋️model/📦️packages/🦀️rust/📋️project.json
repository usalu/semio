{
  "name": "@semio-tech/energy-model-rs",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:artifact",
    "family:energy"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🔋️energy/🗿️artifacts/🔋️model/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🔋️energy/🗿️artifacts/🔋️model/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🔋️energy/🗿️artifacts/🔋️model/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-bestest-regenerate": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/../../🏅️standards/🔖️1/🪆️subsets/✳️any/🧫️fixtures",
        "{projectRoot}/../../🏅️standards/🔖️1/🪆️subsets/✳️any/🖼️assets"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🔋️energy/🗿️artifacts/🔋️model/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test --lib bestest::tests::regenerate_bestest_fixtures -- --nocapture",
        "env": {
          "SEMIO_ENERGY_BESTEST_REGENERATE": "1"
        }
      }
    },
    "test-snapshot-sqlite": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{projectRoot}/../../🏅️standards/**/*", "{projectRoot}/../../🦀️.rs", "{projectRoot}/../../🟦️.ts", "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*", "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"],
      "options": {"cwd":"✏️s/🔌️plugins/🔋️energy/🗿️artifacts/🔋️model/📦️packages/🦀️rust", "command":"bun ./📜️script.ts test-snapshot-sqlite", "forwardAllArgs":true}
    },
    "test-snapshot-sqlite-native": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{projectRoot}/../../🏅️standards/**/*", "{projectRoot}/../../🦀️.rs", "{projectRoot}/../../🟦️.ts", "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*", "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"],
      "options": {"cwd":"✏️s/🔌️plugins/🔋️energy/🗿️artifacts/🔋️model/📦️packages/🦀️rust", "command":"bun ./📜️script.ts test-snapshot-sqlite native", "forwardAllArgs":true}
    },
    "test-snapshot-sqlite-source": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{projectRoot}/../../🏅️standards/**/*", "{projectRoot}/../../🦀️.rs", "{projectRoot}/../../🟦️.ts", "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*", "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"],
      "options": {"cwd":"✏️s/🔌️plugins/🔋️energy/🗿️artifacts/🔋️model/📦️packages/🦀️rust", "command":"bun ./📜️script.ts test-snapshot-sqlite source", "forwardAllArgs":true}
    },
    "canonical-architecture": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/🔋️energy/🗿️artifacts/🔋️model/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts canonical-architecture",
        "forwardAllArgs": true
      }
    }
  }
}
