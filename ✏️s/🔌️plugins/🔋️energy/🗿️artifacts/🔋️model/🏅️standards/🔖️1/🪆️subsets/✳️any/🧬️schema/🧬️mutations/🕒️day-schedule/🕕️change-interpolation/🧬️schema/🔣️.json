{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-daily-schedule-interpolation/schema.json",
  "title": "ChangeDailyScheduleInterpolation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newInterpolation"
  ],
  "properties": {
    "mutation": {
