{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-room-air-model-assignment/schema.json",
  "title": "CreateRoomAirModelAssignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "zoneId",
    "model"
  ],
  "properties": {
    "mutation": {
      "const": "createRoomAirModelAssignment"
    },
    "zoneId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "Zone the room air model applies to, by id.",
          "de": "Zone, für die das Raumluftmodell gilt, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "model": {
      "enum": [
        "WellMixed",
        "OneNodeDisplacement",
        "TwoNodeBuoyancy",
        "UnderFloorAirDistribution"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Room air model",
          "de": "Raumluftmodell"
        },
        "options": {
          "WellMixed": {
            "en": "Well mixed",
            "de": "Vollständig durchmischt"
          },
          "OneNodeDisplacement": {
            "en": "One-node displacement",
            "de": "Quelllüftung, Einknotenmodell"
          },
          "TwoNodeBuoyancy": {
            "en": "Two-node buoyancy",
            "de": "Thermischer Auftrieb, Zweiknotenmodell"
          },
          "UnderFloorAirDistribution": {
            "en": "Underfloor air distribution",
            "de": "Unterflur-Luftverteilung"
          }
        },
        "group": "airflow",
        "order": 20
      }
    }
  }
}
