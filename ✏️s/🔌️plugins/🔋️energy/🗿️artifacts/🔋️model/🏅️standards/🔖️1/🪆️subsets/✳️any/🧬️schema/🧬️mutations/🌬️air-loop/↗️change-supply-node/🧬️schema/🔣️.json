{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-air-loop-supply-node/schema.json",
  "title": "ChangeAirLoopSupplyNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newSupplyNodeId"
  ],
  "properties": {
    "mutation": {
      "const": "changeAirLoopSupplyNode"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Air loop",
          "de": "Luftkreislauf"
        },
        "description": {
          "en": "The air loop this mutation changes, by id.",
          "de": "Luftkreislauf, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "airLoop"
        },
        "group": "target",
        "order": 10
      }
    },
    "newSupplyNodeId": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Supply air node",
          "de": "Zuluftknoten"
        },
        "description": {
          "en": "Node number of the supply air outlet.",
          "de": "Knotennummer des Zuluftaustritts."
        },
        "step": 1,
        "precision": 0,
        "group": "network",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateModelAirLoop",
    "branchType": "ModelSystemState",
    "branch": "systems",
    "collection": "air_loops",
    "field": "supply_node_id",
    "input": "new_supply_node_id",
    "key": "id",
    "labels": {
      "en": "Change air loop: Supply air node",
      "de": "Zuluftknoten ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "air-loop",
      "kind": "change-air-loop-supply-node",
      "record": "ChangedAirLoopSupplyNode"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Supply air node violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed air loop does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The air loop already carries this supply air node value."
      }
    }
  }
}
