{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-air-loop-return-node/schema.json",
  "title": "ChangeAirLoopReturnNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newReturnNodeId"
  ],
  "properties": {
    "mutation": {
      "const": "changeAirLoopReturnNode"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Air loop",
          "de": "Luftkreislauf"
        },
        "description": {
          "en": "The air loop this mutation changes, by id.",
          "de": "Luftkreislauf, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "airLoop"
        },
        "group": "target",
        "order": 10
      }
    },
    "newReturnNodeId": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Return air node",
          "de": "Rückluftknoten"
        },
        "description": {
          "en": "Node number of the return air inlet.",
          "de": "Knotennummer des Rücklufteintritts."
        },
        "step": 1,
        "precision": 0,
        "group": "network",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateModelAirLoop",
    "branchType": "ModelSystemState",
    "branch": "systems",
    "collection": "air_loops",
    "field": "return_node_id",
    "input": "new_return_node_id",
    "key": "id",
    "labels": {
      "en": "Change air loop: Return air node",
      "de": "Rückluftknoten ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "air-loop",
      "kind": "change-air-loop-return-node",
      "record": "ChangedAirLoopReturnNode"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Return air node violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed air loop does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The air loop already carries this return air node value."
      }
    }
  }
