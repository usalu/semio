{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/connect-referenced-model/schema.json",
  "title": "ConnectReferencedModel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "link"
  ],
  "properties": {
    "mutation": {
      "const": "connectReferencedModel"
    },
    "link": {
      "$ref": "https://json.schemas.assets.semio-tech.com/framework/schema/artifact-reference/link/schema.json",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Referenced model",
          "de": "Referenziertes Modell"
        },
        "description": {
          "en": "Complete target identity, history pin and relationship role.",
          "de": "Vollständige Zielidentität, Geschichtsfixierung und Beziehungsrolle."
        },
        "group": "source",
        "order": 10
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "root-link",
    "field": "referenced_model",
    "intent": "attach",
    "attach": "ConnectReferencedModel",
    "detach": "DisconnectReferencedModel",
    "labels": {
      "en": "Connect referenced model",
      "de": "Referenziertes Modell verbinden"
    },
    "semantics": {
      "verb": "connect",
      "entity": "referenced-model",
      "kind": "connect-referenced-model",
      "record": "ConnectedReferencedModel"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The complete original artifact link must retain valid target, pin and role identities."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "This original link slot already carries the requested target, pin and role."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The original link slot is empty."
      }
    },
    "input": "link"
  }
}
