{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/remove-output-variable/schema.json",
  "title": "RemoveOutputVariable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "name",
    "key"
  ],
  "properties": {
    "mutation": {
      "const": "removeOutputVariable"
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Variable name",
          "de": "Variablenname"
        },
        "description": {
          "en": "Output variable to report, e.g. Zone Mean Air Temperature.",
          "de": "Zu berichtende Ausgabevariable, z. B. Zone Mean Air Temperature."
        },
        "group": "output",
        "order": 10
      }
    },
    "key": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Key value",
          "de": "Schlüsselwert"
        },
        "description": {
          "en": "Object the variable reports for, e.g. a zone name.",
          "de": "Objekt, für das die Variable berichtet, z. B. ein Zonenname."
        },
        "group": "output",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "output-variable-row",
    "intent": "remove",
    "identity": [
      "name",
      "key"
    ],
    "row": "StateOutputVariableSpec",
    "branchType": "ModelOutputState",
    "branch": "outputs",
    "collection": "output_variables",
    "labels": {
      "en": "Remove output variable",
      "de": "Ausgabevariable entfernen"
    },
    "semantics": {
      "verb": "remove",
      "entity": "output-variable",
      "kind": "remove-output-variable",
      "record": "RemovedOutputVariable"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "An output variable name must not be blank."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "The output variable is already registered for this key."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The output registration or insertion position is absent."
      },
      "unchanged": {
        "level": "info",
        "code": "mutation.no-change",
        "message": "The output registration is unchanged."
      }
    }
  }
}
