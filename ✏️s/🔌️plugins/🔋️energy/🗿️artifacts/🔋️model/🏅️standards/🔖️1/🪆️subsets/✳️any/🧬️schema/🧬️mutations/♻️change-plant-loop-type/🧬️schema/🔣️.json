{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-plant-loop-type/schema.json",
  "title": "ChangePlantLoopType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newLoopType"
  ],
  "properties": {
    "mutation": {
      "const": "changePlantLoopType"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plant loop",
          "de": "Anlagenkreislauf"
        },
        "description": {
          "en": "The plant loop this mutation changes, by id.",
          "de": "Anlagenkreislauf, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "plantLoop"
        },
        "group": "target",
        "order": 10
      }
    },
    "newLoopType": {
      "enum": [
        "Heating",
        "Cooling",
        "Condenser"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Loop type",
          "de": "Kreislauftyp"
        },
        "options": {
          "Heating": {
            "en": "Heating",
            "de": "Heizung"
          },
          "Cooling": {
            "en": "Cooling",
            "de": "Kühlung"
          },
          "Condenser": {
            "en": "Condenser",
            "de": "Rückkühlung"
          }
        },
        "group": "plant",
        "order": 20
      }
    }
  }
}
