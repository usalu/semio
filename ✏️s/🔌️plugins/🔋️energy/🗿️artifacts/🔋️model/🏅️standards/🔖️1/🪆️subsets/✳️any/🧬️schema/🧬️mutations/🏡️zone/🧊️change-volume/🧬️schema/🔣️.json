{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-zone-volume/schema.json",
  "title": "ChangeZoneVolume",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newVolumeM3"
  ],
  "properties": {
    "mutation": {
      "const": "changeZoneVolume"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The zone this mutation changes, by id.",
          "de": "Zone, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newVolumeM3": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Air volume",
          "de": "Luftvolumen"
        },
        "unit": "m³",
        "step": 0.1,
        "precision": 1,
        "group": "geometry",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateZone",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "zones",
    "field": "volume_m3",
    "input": "new_volume_m3",
    "key": "id",
    "labels": {
      "en": "Change zone volume",
      "de": "Zonenvolumen ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "zone",
      "kind": "change-zone-volume",
      "record": "ChangedZoneVolume"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A zone volume must be positive and finite."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed zone does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The zone already has this volume."
      }
    }
  }
}
