{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-weekly-schedule/schema.json",
  "title": "CreateWeeklySchedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "dailyScheduleIds"
  ],
  "properties": {
    "mutation": {
      "const": "createWeeklySchedule"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new weekly schedule is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "dailyScheduleIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 7,
      "maxItems": 7,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Daily schedules",
          "de": "Tageszeitpläne"
        },
        "description": {
          "en": "Seven daily profiles by id, Sunday through Saturday. Slot 0 is Sunday and slot 6 is Saturday.",
          "de": "Sieben Tagesprofile per ID, Sonntag bis Samstag. Platz 0 ist Sonntag, Platz 6 ist Samstag."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 30
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateWeeklySchedule",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "daily_schedule_ids",
        "input": "daily_schedule_ids",
        "storage": "fixed-array",
        "length": 7
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateWeeklySchedule",
    "branchType": "StateScheduleSet",
    "branch": "outputs",
    "nested": "schedules",
    "collection": "weekly",
    "key": "id",
    "inverse": "DeleteWeeklySchedule",
    "labels": {
      "en": "Create weekly schedule",
      "de": "Wochenzeitplan erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "schedule",
      "kind": "create-weekly-schedule",
      "record": "CreatedWeeklySchedule"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The schedule requires finite values and a positive timestep."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "A schedule with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The insertion rank is past the end of this schedule collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The schedule creation makes no change."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The referenced daily schedule does not exist."
      }
    },
    "validationBeforeRank": false,
    "defaultRank": "explicit",
    "identityCollections": [
      "ConstantSchedules",
      "DailySchedules",
      "WeeklySchedules",
      "AnnualSchedules",
      "TimeSeriesSchedules"
    ],
    "rules": [
      {
        "input": "daily_schedule_ids",
        "kind": "reference",
        "storage": "array",
        "collections": [
          "DailySchedules"
        ],
        "target": "input"
      }
    ],
    "scalarOrder": "before-rules"
  }
}
