{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-fenestration-vlt/schema.json",
  "title": "ChangeFenestrationVlt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newVlt"
  ],
  "properties": {
    "mutation": {
      "const": "changeFenestrationVlt"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The window this mutation changes, by id.",
          "de": "Fenster, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "fenestration",
          "domain": "energyModel",
          "granularity": "fenestration"
        },
        "group": "target",
        "order": 10
      }
    },
    "newVlt": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Visible transmittance",
          "de": "Lichttransmissionsgrad"
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "optics",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateFenestration",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "fenestrations",
    "field": "vlt",
    "input": "new_vlt",
    "key": "id",
    "labels": {
      "en": "Change fenestration: Visible transmittance",
      "de": "Lichttransmissionsgrad ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "fenestration",
      "kind": "change-fenestration-vlt",
      "record": "ChangedFenestrationVlt"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Visible transmittance violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed fenestration does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The fenestration already carries this visible transmittance value."
      }
    }
  }
}
