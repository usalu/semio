{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-surface-construction/schema.json",
  "title": "ChangeSurfaceConstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newConstructionId"
  ],
  "properties": {
    "mutation": {
      "const": "changeSurfaceConstruction"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Surface",
          "de": "Oberfläche"
        },
        "description": {
          "en": "The surface this mutation changes, by id.",
          "de": "Oberfläche, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "surface",
          "domain": "energyModel",
          "granularity": "surface"
        },
        "group": "target",
        "order": 10
      }
    },
    "newConstructionId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Construction",
          "de": "Konstruktion"
        },
        "description": {
          "en": "Layered construction of the surface, by id.",
          "de": "Schichtaufbau der Oberfläche, per ID."
        },
        "ref": {
          "kind": "construction",
          "domain": "energyModel",
          "granularity": "construction"
        },
        "group": "construction",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "reference-row",
    "references": [
      "Constructions"
    ],
    "row": "StateSurface",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "surfaces",
    "field": "construction_id",
    "input": "new_construction_id",
    "key": "id",
    "labels": {
      "en": "Change surface: Construction",
      "de": "Konstruktion ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "surface",
      "kind": "change-surface-construction",
      "record": "ChangedSurfaceConstruction"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Construction violates its authored identifier bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed surface does not exist."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The referenced construction does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The surface already carries this construction reference."
      }
    },
    "referenceTarget": "key"
  }
}
