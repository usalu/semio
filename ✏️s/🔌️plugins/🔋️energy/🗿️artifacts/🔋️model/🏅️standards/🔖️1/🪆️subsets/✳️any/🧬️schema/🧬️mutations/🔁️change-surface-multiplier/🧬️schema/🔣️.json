{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-surface-multiplier/schema.json",
  "title": "ChangeSurfaceMultiplier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newMultiplier"
  ],
  "properties": {
    "mutation": {
      "const": "changeSurfaceMultiplier"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Surface",
          "de": "Oberfläche"
        },
        "description": {
          "en": "The surface this mutation changes, by id.",
          "de": "Oberfläche, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "surface",
          "domain": "energyModel",
          "granularity": "surface"
        },
        "group": "target",
        "order": 10
      }
    },
    "newMultiplier": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Multiplier",
          "de": "Multiplikator"
        },
        "description": {
          "en": "Number of identical instances this object stands for; at least 1.",
          "de": "Anzahl gleicher Exemplare, die dieses Objekt vertritt; mindestens 1."
        },
        "step": 1,
        "precision": 0,
        "group": "geometry",
        "order": 20
      }
    }
  }
}
