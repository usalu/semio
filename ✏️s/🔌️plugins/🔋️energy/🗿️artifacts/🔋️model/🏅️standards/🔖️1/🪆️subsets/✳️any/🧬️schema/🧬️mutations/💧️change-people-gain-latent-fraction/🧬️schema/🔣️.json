{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-people-gain-latent-fraction/schema.json",
  "title": "ChangePeopleGainLatentFraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newLatentFraction"
  ],
  "properties": {
    "mutation": {
      "const": "changePeopleGainLatentFraction"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "People gain",
          "de": "Personenwärmegewinn"
        },
        "description": {
          "en": "The people gain this mutation changes, by id.",
          "de": "Personenwärmegewinn, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "peopleGain",
          "domain": "energyModel",
          "granularity": "load"
        },
        "group": "target",
        "order": 10
      }
    },
    "newLatentFraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Latent fraction",
          "de": "Latenter Anteil"
        },
        "description": {
          "en": "Share of the heat output released as moisture.",
          "de": "Anteil der Wärmeabgabe als latente Wärme (Feuchte)."
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "softMin": 0,
        "softMax": 1,
        "group": "gains",
        "order": 20
      }
    }
  }
}
