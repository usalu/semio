{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-daylight-zone-window-transmittance/schema.json",
  "title": "ChangeDaylightZoneWindowTransmittance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newWindowTransmittance"
  ],
  "properties": {
    "mutation": {
      "const": "changeDaylightZoneWindowTransmittance"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Daylight zone",
          "de": "Tageslichtzone"
        },
        "description": {
          "en": "The daylight zone this mutation changes, by id.",
          "de": "Tageslichtzone, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "daylightZone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newWindowTransmittance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Window transmittance",
          "de": "Fenstertransmissionsgrad"
        },
        "description": {
          "en": "Visible transmittance of the daylight apertures.",
          "de": "Lichttransmissionsgrad der Tageslichtöffnungen."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "daylight",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateDaylightZoneConfig",
    "branchType": "ModelLoadState",
    "branch": "loads",
    "collection": "daylight_zones",
    "field": "window_transmittance",
    "input": "new_window_transmittance",
    "key": "id",
    "labels": {
      "en": "Change daylight zone: Window transmittance",
      "de": "Fenstertransmissionsgrad ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "daylight-zone",
      "kind": "change-daylight-zone-window-transmittance",
      "record": "ChangedDaylightZoneWindowTransmittance"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Window transmittance violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed daylight zone does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The daylight zone already carries this window transmittance value."
      }
    }
  }
}
