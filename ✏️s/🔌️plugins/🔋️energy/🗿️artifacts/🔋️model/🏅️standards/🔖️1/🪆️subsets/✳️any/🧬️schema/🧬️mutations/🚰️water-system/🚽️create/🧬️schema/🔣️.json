{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-water-system/schema.json",
  "title": "CreateWaterSystem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "fixtureCount",
    "peakFlowLS",
    "scheduleId"
  ],
  "properties": {
    "mutation": {
      "const": "createWaterSystem"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new water system is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "fixtureCount": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Fixtures",
          "de": "Anzahl Entnahmestellen"
        },
        "step": 1,
        "precision": 0,
        "group": "capacity",
        "order": 30
      }
    },
    "peakFlowLS": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Peak flow",
          "de": "Spitzenvolumenstrom"
        },
        "unit": "L/s",
        "step": 0.01,
        "precision": 2,
        "group": "capacity",
        "order": 40
      },
      "exclusiveMinimum": 0
    },
    "scheduleId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Schedule",
          "de": "Zeitplan"
        },
        "description": {
          "en": "Fraction schedule scaling the design value over time, by id.",
          "de": "Anteilszeitplan, der den Bemessungswert zeitlich skaliert, per ID."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 50
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateWaterSystemConfig",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "fixture_count",
        "input": "fixture_count",
        "storage": "fixed"
      },
      {
        "field": "peak_flow_l_s",
        "input": "peak_flow_l_s",
        "storage": "fixed"
      },
      {
        "field": "schedule_id",
        "input": "schedule_id",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateWaterSystemConfig",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "water_systems",
    "key": "id",
    "inverse": "DeleteWaterSystem",
    "labels": {
      "en": "Create Water System at index",
      "de": "Wasseranlage an Index erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "water-system",
      "kind": "create-water-system",
      "record": "CreatedWaterSystem"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored row violates its declared field bounds."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "An object with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The authored insertion rank is past the end of the collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The creation makes no change."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The original referenced entity does not exist."
      }
    },
    "validationBeforeRank": false,
    "rules": [
      {
        "input": "schedule_id",
        "kind": "reference",
        "storage": "direct",
        "collections": [
          "ConstantSchedules",
          "DailySchedules",
          "WeeklySchedules",
          "AnnualSchedules",
          "TimeSeriesSchedules"
        ],
        "target": "input"
      }
    ],
    "defaultRank": "explicit",
    "scalarOrder": "after-rules"
  }
}
