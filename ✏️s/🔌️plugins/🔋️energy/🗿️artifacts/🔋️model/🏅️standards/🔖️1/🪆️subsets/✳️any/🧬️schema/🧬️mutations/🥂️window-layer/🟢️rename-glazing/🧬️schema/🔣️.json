{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/rename-glazing-material/schema.json",
  "title": "RenameGlazingMaterial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newName"
  ],
  "properties": {
    "mutation": {
      "const": "renameGlazingMaterial"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Glazing material",
          "de": "Verglasungsmaterial"
        },
        "description": {
          "en": "The glazing material to rename, by id.",
          "de": "Verglasungsmaterial, das diese Mutation umbenennt, per ID."
        },
        "ref": {
          "kind": "glazingMaterial",
          "domain": "energyModel",
          "granularity": "glazingMaterial"
        },
        "group": "target",
        "order": 10
      }
    },
    "newName": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 20
      },
      "minLength": 1
    }
  },
  "x-semio-energy-operation": {
    "category": "name-row",
    "row": "StateGlazingMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "glazing_materials",
    "field": "name",
    "input": "new_name",
    "key": "id",
    "unique": false,
    "labels": {
      "en": "Rename glazing material",
      "de": "Glasmaterial umbenennen"
    },
    "semantics": {
      "verb": "rename",
      "entity": "glazing-material",
      "kind": "rename-glazing-material",
      "record": "RenamedGlazingMaterial"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A glazing material name must not be blank."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "Another glazing material already has this name."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed glazing material does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The glazing material already has this name."
      }
    }
  }
}
