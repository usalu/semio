{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-water-system-schedule/schema.json",
  "title": "ChangeWaterSystemSchedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newScheduleId"
  ],
  "properties": {
    "mutation": {
      "const": "changeWaterSystemSchedule"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Water system",
          "de": "Wasseranlage"
        },
        "description": {
          "en": "The water system this mutation changes, by id.",
          "de": "Wasseranlage, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "waterSystem"
        },
        "group": "target",
        "order": 10
      }
    },
    "newScheduleId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Schedule",
          "de": "Zeitplan"
        },
        "description": {
          "en": "Fraction schedule scaling the design value over time, by id.",
          "de": "Anteilszeitplan, der den Bemessungswert zeitlich skaliert, per ID."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "reference-row",
    "references": [
      "ConstantSchedules",
      "DailySchedules",
      "WeeklySchedules",
      "AnnualSchedules",
      "TimeSeriesSchedules"
    ],
    "row": "StateWaterSystemConfig",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "water_systems",
    "field": "schedule_id",
    "input": "new_schedule_id",
    "key": "id",
    "labels": {
      "en": "Change water system: Schedule",
      "de": "Zeitplan ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "water-system",
      "kind": "change-water-system-schedule",
      "record": "ChangedWaterSystemSchedule"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Schedule violates its authored identifier bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed water system does not exist."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The referenced schedule does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The water system already carries this schedule reference."
      }
    },
    "referenceTarget": "input"
  }
