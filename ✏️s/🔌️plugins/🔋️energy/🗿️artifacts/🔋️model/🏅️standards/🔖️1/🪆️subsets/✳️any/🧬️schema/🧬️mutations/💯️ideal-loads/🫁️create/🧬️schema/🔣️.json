{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-ideal-loads-system/schema.json",
  "title": "CreateIdealLoadsSystem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "zoneId",
    "maxHeatingSupplyAirTempC",
    "minCoolingSupplyAirTempC",
    "maxHeatingCapacityPresent",
    "maxHeatingCapacityW",
    "maxCoolingCapacityPresent",
    "maxCoolingCapacityW",
    "outdoorAirPerPersonM3S",
    "outdoorAirPerAreaM3SM2"
  ],
  "properties": {
    "mutation": {
      "const": "createIdealLoadsSystem"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; empty appends (or keeps id order).",
          "de": "Einfügeposition in der Modellliste; leer hängt an (oder behält die ID-Reihenfolge)."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 5
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new ideal loads system is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 10
      }
    },
    "zoneId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "Assigned zone, by id.",
          "de": "Zugeordnete Zone, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "assignment",
        "order": 20
      }
    },
    "maxHeatingSupplyAirTempC": {
      "type": "number",
      "minimum": -100,
      "maximum": 200,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Maximum heating supply air temperature",
          "de": "Maximale Heizzulufttemperatur"
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "group": "control",
        "order": 30
      }
    },
    "minCoolingSupplyAirTempC": {
      "type": "number",
      "minimum": -100,
      "maximum": 200,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Minimum cooling supply air temperature",
          "de": "Minimale Kühlzulufttemperatur"
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "group": "control",
        "order": 40
      }
    },
    "maxHeatingCapacityPresent": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Limit heating capacity",
          "de": "Heizleistung begrenzen"
        },
        "description": {
          "en": "Off means unlimited; the heating capacity is then 0.",
          "de": "Aus bedeutet unbegrenzt; die Heizleistung ist dann 0."
        },
        "group": "capacity",
        "order": 50
      }
    },
    "maxHeatingCapacityW": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Maximum heating capacity",
          "de": "Maximale Heizleistung"
        },
        "description": {
          "en": "Only while the heating capacity is limited.",
          "de": "Nur solange die Heizleistung begrenzt ist."
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 60
      }
    },
    "maxCoolingCapacityPresent": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Limit cooling capacity",
          "de": "Kühlleistung begrenzen"
        },
        "description": {
          "en": "Off means unlimited; the cooling capacity is then 0.",
          "de": "Aus bedeutet unbegrenzt; die Kühlleistung ist dann 0."
        },
        "group": "capacity",
        "order": 70
      }
    },
    "maxCoolingCapacityW": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Maximum cooling capacity",
          "de": "Maximale Kühlleistung"
        },
        "description": {
          "en": "Only while the cooling capacity is limited.",
          "de": "Nur solange die Kühlleistung begrenzt ist."
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 80
      }
    },
    "outdoorAirPerPersonM3S": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Outdoor air per person",
          "de": "Außenluftrate pro Person"
        },
        "unit": "m³/s",
        "displayUnit": "m³/h",
        "displayFactor": 3600,
        "step": 0.0002777777777777778,
        "precision": 1,
        "group": "ventilation",
        "order": 90
      }
    },
    "outdoorAirPerAreaM3SM2": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Outdoor air per floor area",
          "de": "Außenluftrate pro Geschossfläche"
        },
        "unit": "m³/(s·m²)",
        "displayUnit": "m³/(h·m²)",
        "displayFactor": 3600,
        "step": 2.777777777777778e-05,
        "precision": 2,
        "group": "ventilation",
        "order": 100
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "maxHeatingCapacityPresent": {
            "const": false
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "maxHeatingCapacityW": {
            "const": 0
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "maxHeatingCapacityW": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "maxCoolingCapacityPresent": {
            "const": false
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "maxCoolingCapacityW": {
            "const": 0
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "maxCoolingCapacityW": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  ],
  "x-semio-energy-row-birth": {
    "row": "StateIdealLoadsSystem",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "zone_id",
        "input": "zone_id",
        "storage": "fixed"
      },
      {
        "field": "max_heating_supply_air_temp_c",
        "input": "max_heating_supply_air_temp_c",
        "storage": "fixed"
      },
      {
        "field": "min_cooling_supply_air_temp_c",
        "input": "min_cooling_supply_air_temp_c",
        "storage": "fixed"
      },
      {
        "field": "max_heating_capacity_w",
        "input": "max_heating_capacity_w",
        "storage": "optional-number",
        "presence": "max_heating_capacity_present"
      },
      {
        "field": "max_cooling_capacity_w",
        "input": "max_cooling_capacity_w",
        "storage": "optional-number",
        "presence": "max_cooling_capacity_present"
      },
      {
        "field": "outdoor_air_per_person_m3_s",
        "input": "outdoor_air_per_person_m3_s",
        "storage": "fixed"
      },
      {
        "field": "outdoor_air_per_area_m3_s_m2",
        "input": "outdoor_air_per_area_m3_s_m2",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateIdealLoadsSystem",
    "branchType": "ModelControlState",
    "branch": "controls",
    "collection": "ideal_loads",
    "key": "id",
    "inverse": "DeleteIdealLoadsSystem",
    "labels": {
      "en": "Create ideal loads system",
      "de": "Ideallastsystem erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "ideal-loads-system",
      "kind": "create-ideal-loads-system",
      "record": "CreatedIdealLoadsSystem"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The supply temperatures, air rates and optional capacities must lie in their authored ranges."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "An ideal loads system with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The insertion rank is past the end of the ideal loads collection."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The referenced zone does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The ideal loads creation makes no change."
      }
    },
    "validationBeforeRank": true,
    "defaultRank": "append",
    "rules": [
      {
        "input": "zone_id",
        "kind": "reference",
        "storage": "direct",
        "collections": [
          "Zones"
        ],
        "target": "input"
      },
      {
        "input": "max_heating_capacity_w",
        "presence": "max_heating_capacity_present",
        "kind": "optional-positive-number"
      },
      {
        "input": "max_cooling_capacity_w",
        "presence": "max_cooling_capacity_present",
        "kind": "optional-positive-number"
      }
    ],
    "scalarOrder": "after-rules"
  }
}
