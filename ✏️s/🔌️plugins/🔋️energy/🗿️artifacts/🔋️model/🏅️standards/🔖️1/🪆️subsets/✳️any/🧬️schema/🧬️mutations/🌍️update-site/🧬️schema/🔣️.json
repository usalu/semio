{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/update-site/schema.json",
  "title": "UpdateSite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "latitudeDeg",
    "longitudeDeg",
    "elevationM",
    "timeZoneHours",
    "northAxisDeg"
  ],
  "properties": {
    "mutation": {
      "const": "updateSite"
    },
    "latitudeDeg": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Latitude",
          "de": "Breitengrad"
        },
        "description": {
          "en": "North positive, −90 to 90.",
          "de": "Nord positiv, −90 bis 90."
        },
        "unit": "deg",
        "step": 0.001,
        "precision": 3,
        "softMin": -90,
        "softMax": 90,
        "group": "site",
        "order": 10
      }
    },
    "longitudeDeg": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Longitude",
          "de": "Längengrad"
        },
        "description": {
          "en": "East positive, −180 to 180.",
          "de": "Ost positiv, −180 bis 180."
        },
        "unit": "deg",
        "step": 0.001,
        "precision": 3,
        "softMin": -180,
        "softMax": 180,
        "group": "site",
        "order": 20
      }
    },
    "elevationM": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Elevation",
          "de": "Höhe über NN"
        },
        "unit": "m",
        "step": 1,
        "precision": 0,
        "group": "site",
        "order": 30
      }
    },
    "timeZoneHours": {
      "type": "number",
      "minimum": -12,
      "maximum": 14,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Time zone",
          "de": "Zeitzone"
        },
        "description": {
          "en": "Offset from UTC.",
          "de": "Abweichung von UTC."
        },
        "unit": "h",
        "step": 0.5,
        "precision": 1,
        "softMin": -12,
        "softMax": 14,
        "group": "site",
        "order": 40
      }
    },
    "northAxisDeg": {
      "type": "number",
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "North axis",
          "de": "Nordachse"
        },
        "description": {
          "en": "Angle from true north to the building's north axis, clockwise.",
          "de": "Winkel von geografisch Nord zur Nordachse des Gebäudes, im Uhrzeigersinn."
        },
        "unit": "deg",
        "step": 1,
        "precision": 1,
        "softMin": 0,
        "softMax": 360,
        "snaps": [
          0,
          90,
          180,
          270,
          360
        ],
        "group": "site",
        "order": 50
      }
    }
  }
}
