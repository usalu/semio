{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-fault-type/schema.json",
  "title": "ChangeFaultType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newFaultType"
  ],
  "properties": {
    "mutation": {
      "const": "changeFaultType"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Fault",
          "de": "Fehler"
        },
        "description": {
          "en": "The fault this mutation changes, by id.",
          "de": "Fehler, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "fault"
        },
        "group": "target",
        "order": 10
      }
    },
    "newFaultType": {
      "enum": [
        "SensorBias",
        "CoilFouling",
        "DamperStuck",
        "ChillerFouling",
        "BoilerEfficiencyDegradation"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Fault type",
          "de": "Fehlertyp"
        },
        "options": {
          "SensorBias": {
            "en": "Sensor bias",
            "de": "Sensorabweichung"
          },
          "CoilFouling": {
            "en": "Coil fouling",
            "de": "Registerverschmutzung"
          },
          "DamperStuck": {
            "en": "Stuck damper",
            "de": "Klemmende Klappe"
          },
          "ChillerFouling": {
            "en": "Chiller fouling",
            "de": "Verschmutzung der Kältemaschine"
          },
          "BoilerEfficiencyDegradation": {
            "en": "Boiler efficiency degradation",
            "de": "Wirkungsgradverlust des Kessels"
          }
        },
        "group": "fault",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "enum-row",
    "row": "StateFaultDefinition",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "faults",
    "field": "fault_type",
    "input": "new_fault_type",
    "key": "id",
    "labels": {
      "en": "Change fault: Fault type",
      "de": "Fehlertyp ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "fault",
      "kind": "change-fault-type",
      "record": "ChangedFaultType"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Fault type violates its authored choices."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed fault does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The fault already carries this fault type value."
      }
    }
  }
}
