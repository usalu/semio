{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-solar-thermal-system-efficiency/schema.json",
  "title": "ChangeSolarThermalSystemEfficiency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newEfficiency"
  ],
  "properties": {
    "mutation": {
      "const": "changeSolarThermalSystemEfficiency"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Solar thermal system",
          "de": "Solarthermieanlage"
        },
        "description": {
          "en": "The solar thermal system this mutation changes, by id.",
          "de": "Solarthermieanlage, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "solarThermalSystem"
        },
        "group": "target",
        "order": 10
      }
    },
    "newEfficiency": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Collector efficiency",
          "de": "Kollektorwirkungsgrad"
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.001,
        "precision": 1,
        "softMin": 0.001,
        "softMax": 1,
        "group": "efficiency",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateSolarThermalConfig",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "solar_thermal_systems",
    "field": "efficiency",
    "input": "new_efficiency",
    "key": "id",
    "labels": {
      "en": "Change solar thermal system: Collector efficiency",
      "de": "Kollektorwirkungsgrad ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "solar-thermal-system",
      "kind": "change-solar-thermal-system-efficiency",
      "record": "ChangedSolarThermalSystemEfficiency"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Collector efficiency violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed solar thermal system does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The solar thermal system already carries this collector efficiency value."
      }
    }
