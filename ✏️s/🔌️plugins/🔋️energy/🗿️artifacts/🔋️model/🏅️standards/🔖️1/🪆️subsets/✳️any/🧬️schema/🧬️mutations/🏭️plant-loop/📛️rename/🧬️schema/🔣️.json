{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/rename-plant-loop/schema.json",
  "title": "RenamePlantLoop",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newName"
  ],
  "properties": {
    "mutation": {
      "const": "renamePlantLoop"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plant loop",
          "de": "Anlagenkreislauf"
        },
        "description": {
          "en": "The plant loop to rename, by id.",
          "de": "Anlagenkreislauf, den diese Mutation umbenennt, per ID."
        },
        "ref": {
          "kind": "plantLoop"
        },
        "group": "target",
        "order": 10
      }
    },
    "newName": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 20
      },
      "minLength": 1
    }
  },
  "x-semio-energy-operation": {
    "category": "name-row",
    "row": "StatePlantLoopConfig",
    "branchType": "ModelSystemState",
    "branch": "systems",
    "collection": "plant_loops",
    "field": "name",
    "input": "new_name",
    "key": "id",
    "unique": true,
    "labels": {
      "en": "Rename plant loop",
      "de": "Anlagenkreislauf umbenennen"
    },
    "semantics": {
      "verb": "rename",
      "entity": "plant-loop",
      "kind": "rename-plant-loop",
      "record": "RenamedPlantLoop"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A plant loop name must not be blank."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "Another plant loop already has this name."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed plant loop does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The plant loop already has this name."
      }
    }
  }
}
