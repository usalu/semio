{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-battery-round-trip-efficiency/schema.json",
  "title": "ChangeBatteryRoundTripEfficiency",
  "type": "object",
