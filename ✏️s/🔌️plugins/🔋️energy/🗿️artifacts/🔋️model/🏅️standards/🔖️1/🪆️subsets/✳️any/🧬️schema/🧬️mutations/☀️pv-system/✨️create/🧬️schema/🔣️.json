{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-pv-system/schema.json",
  "title": "CreatePvSystem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "dcCapacityW",
    "areaM2",
    "tiltDeg",
    "azimuthDeg",
    "moduleEfficiency",
    "inverterEfficiency",
    "temperatureCoefficient",
    "faimanHeatLossConstantWM2k",
    "faimanHeatLossWindWSM3k",
    "mounting"
  ],
  "properties": {
    "mutation": {
      "const": "createPvSystem"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new PV system is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "dcCapacityW": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "DC rated power",
          "de": "DC-Nennleistung"
        },
        "unit": "W",
        "displayUnit": "kWp",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 30
      },
      "exclusiveMinimum": 0
    },
    "areaM2": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Aperture area",
          "de": "Aperturfläche"
        },
        "unit": "m²",
        "step": 0.1,
        "precision": 2,
        "group": "geometry",
        "order": 40
      },
      "exclusiveMinimum": 0
    },
    "tiltDeg": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Tilt",
          "de": "Neigung"
        },
        "description": {
          "en": "Angle from horizontal: 0 is flat, 90 is vertical.",
          "de": "Winkel zur Horizontalen: 0 ist waagerecht, 90 senkrecht."
        },
        "unit": "deg",
        "step": 1,
        "precision": 0,
        "softMin": 0,
        "softMax": 90,
        "snaps": [
          0,
          15,
          30,
          45,
          60,
          75,
          90
        ],
        "group": "orientation",
        "order": 50
      },
      "minimum": 0,
      "maximum": 90
    },
    "azimuthDeg": {
      "type": "number",
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "Azimuth",
          "de": "Azimut"
        },
        "description": {
          "en": "Compass bearing the collector faces: 0 north, 90 east, 180 south, 270 west.",
          "de": "Himmelsrichtung der Ausrichtung: 0 Nord, 90 Ost, 180 Süd, 270 West."
        },
        "unit": "deg",
        "step": 1,
        "precision": 0,
        "softMin": 0,
        "softMax": 360,
        "snaps": [
          0,
          90,
          180,
          270,
          360
        ],
        "group": "orientation",
        "order": 60
      },
      "minimum": 0,
      "maximum": 360
    },
    "moduleEfficiency": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Module efficiency",
          "de": "Modulwirkungsgrad"
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.001,
        "precision": 1,
        "softMin": 0.001,
        "softMax": 1,
        "group": "efficiency",
        "order": 70
      },
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "inverterEfficiency": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Inverter efficiency",
          "de": "Wechselrichterwirkungsgrad"
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.001,
        "precision": 1,
        "softMin": 0.001,
        "softMax": 1,
        "group": "efficiency",
        "order": 80
      },
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "faimanHeatLossWindWSM3k": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wind heat loss",
          "de": "Windwärmeverlust"
        },
        "group": "thermal",
        "order": 20,
        "displayUnit": "W·s/(m³·K)",
        "precision": 2
      },
      "minimum": 0
    },
    "mounting": {
      "type": "string",
      "enum": [
        "OpenRack",
        "CloseRoof",
        "InsulatedBack"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Mounting",
          "de": "Montage"
        },
        "group": "thermal",
        "order": 20,
        "options": {
          "OpenRack": {
            "en": "Open rack",
            "de": "Offenes Gestell"
          },
          "CloseRoof": {
            "en": "Close roof mount",
            "de": "Dachnahe Montage"
          },
          "InsulatedBack": {
            "en": "Insulated back",
            "de": "Rückseitig gedämmt"
          }
        }
      }
    },
    "faimanHeatLossConstantWM2k": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Constant heat loss",
          "de": "Konstanter Wärmeverlust"
        },
        "group": "thermal",
        "order": 20,
        "displayUnit": "W/(m²·K)",
        "precision": 2
      },
      "exclusiveMinimum": 0
    },
    "temperatureCoefficient": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Temperature coefficient",
          "de": "Temperaturkoeffizient"
        },
        "group": "thermal",
        "order": 20,
        "displayUnit": "%/K",
        "displayFactor": 100,
        "step": 0.0001,
        "precision": 2
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StatePvSystemAssignment",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "dc_capacity_w",
        "input": "dc_capacity_w",
        "storage": "fixed"
      },
      {
        "field": "area_m2",
        "input": "area_m2",
        "storage": "fixed"
      },
      {
        "field": "tilt_deg",
        "input": "tilt_deg",
        "storage": "fixed"
      },
      {
        "field": "azimuth_deg",
        "input": "azimuth_deg",
        "storage": "fixed"
      },
      {
        "field": "module_efficiency",
        "input": "module_efficiency",
        "storage": "fixed"
      },
      {
        "field": "inverter_efficiency",
        "input": "inverter_efficiency",
        "storage": "fixed"
      },
      {
        "field": "temperature_coefficient",
        "input": "temperature_coefficient",
        "storage": "fixed"
      },
      {
        "field": "faiman_heat_loss_constant_w_m2k",
        "input": "faiman_heat_loss_constant_w_m2k",
        "storage": "fixed"
      },
      {
        "field": "faiman_heat_loss_wind_w_s_m3k",
        "input": "faiman_heat_loss_wind_w_s_m3k",
        "storage": "fixed"
      },
      {
        "field": "mounting",
        "input": "mounting",
        "storage": "sealed-copy"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StatePvSystemAssignment",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "pv_systems",
    "key": "id",
    "inverse": "DeletePvSystem",
    "labels": {
      "en": "Create photovoltaic system",
      "de": "Photovoltaikanlage erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "pv-system",
      "kind": "create-pv-system",
      "record": "CreatedPvSystem"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored row violates its declared field bounds."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "An object with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The authored insertion rank is past the end of the collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The creation makes no change."
      }
    },
    "validationBeforeRank": false,
    "defaultRank": "explicit"
  }
}
