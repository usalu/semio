{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-fenestration-surface/schema.json",
  "title": "ChangeFenestrationSurface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newSurfaceId"
  ],
  "properties": {
    "mutation": {
      "const": "changeFenestrationSurface"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The window this mutation changes, by id.",
          "de": "Fenster, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "fenestration",
          "domain": "energyModel",
          "granularity": "fenestration"
        },
        "group": "target",
        "order": 10
      }
    },
    "newSurfaceId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Host surface",
          "de": "Trägerfläche"
        },
        "description": {
          "en": "Surface the window sits in, by id.",
          "de": "Oberfläche, in der das Fenster sitzt, per ID."
        },
        "ref": {
          "kind": "surface",
          "domain": "energyModel",
          "granularity": "surface"
        },
        "group": "assignment",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "reference-row",
    "references": [
      "Surfaces"
    ],
    "row": "StateFenestration",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "fenestrations",
    "field": "surface_id",
    "input": "new_surface_id",
    "key": "id",
    "labels": {
      "en": "Change fenestration: Host surface",
      "de": "Trägerfläche ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "fenestration",
      "kind": "change-fenestration-surface",
      "record": "ChangedFenestrationSurface"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Host surface violates its authored identifier bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed fenestration does not exist."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The referenced host surface does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The fenestration already carries this host surface reference."
      }
    },
    "referenceTarget": "key"
  }
}
