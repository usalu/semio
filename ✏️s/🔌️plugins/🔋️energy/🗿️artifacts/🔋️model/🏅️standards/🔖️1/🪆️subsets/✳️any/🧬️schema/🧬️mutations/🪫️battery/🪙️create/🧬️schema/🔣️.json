{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-battery/schema.json",
  "title": "CreateBattery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "capacityKwh",
    "maxChargeW",
    "maxDischargeW",
    "roundTripEfficiency"
  ],
  "properties": {
    "mutation": {
      "const": "createBattery"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new battery is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "capacityKwh": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Storage capacity",
          "de": "Speicherkapazität"
        },
        "unit": "kWh",
        "step": 0.5,
        "precision": 1,
        "group": "capacity",
        "order": 30
      },
      "exclusiveMinimum": 0
    },
    "maxChargeW": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Maximum charge power",
          "de": "Maximale Ladeleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 40
      },
      "exclusiveMinimum": 0
    },
    "maxDischargeW": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Maximum discharge power",
          "de": "Maximale Entladeleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 50
      },
      "exclusiveMinimum": 0
    },
    "roundTripEfficiency": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Round-trip efficiency",
          "de": "Zyklenwirkungsgrad"
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.001,
        "precision": 1,
        "softMin": 0.001,
        "softMax": 1,
        "group": "efficiency",
        "order": 60
      },
      "exclusiveMinimum": 0,
      "maximum": 1
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateBatteryAssignment",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "capacity_kwh",
        "input": "capacity_kwh",
        "storage": "fixed"
      },
      {
        "field": "max_charge_w",
        "input": "max_charge_w",
        "storage": "fixed"
      },
      {
        "field": "max_discharge_w",
        "input": "max_discharge_w",
        "storage": "fixed"
      },
      {
        "field": "round_trip_efficiency",
        "input": "round_trip_efficiency",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateBatteryAssignment",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "battery_storage",
    "key": "id",
    "inverse": "DeleteBattery",
    "labels": {
      "en": "Create battery",
      "de": "Batterie erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "battery",
      "kind": "create-battery",
      "record": "CreatedBattery"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored row violates its declared field bounds."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "An object with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The authored insertion rank is past the end of the collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The creation makes no change."
      }
    },
    "validationBeforeRank": false,
    "defaultRank": "explicit"
  }
}
