        "label": {
          "en": "Setpoint manager",
          "de": "Sollwertführung"
        },
        "description": {
          "en": "The setpoint manager to rename, by id.",
          "de": "Sollwertführung, die diese Mutation umbenennt, per ID."
        },
        "ref": {
          "kind": "setpointManager"
        },
        "group": "target",
        "order": 10
      }
    },
    "newName": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 20
      },
      "minLength": 1
    }
  },
  "x-semio-energy-operation": {
