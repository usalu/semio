{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-plant-loop-design-flow/schema.json",
  "title": "ChangePlantLoopDesignFlow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newDesignFlowKgS"
  ],
  "properties": {
    "mutation": {
      "const": "changePlantLoopDesignFlow"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plant loop",
          "de": "Anlagenkreislauf"
        },
        "description": {
          "en": "The plant loop this mutation changes, by id.",
          "de": "Anlagenkreislauf, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "plantLoop"
        },
        "group": "target",
        "order": 10
      }
    },
    "newDesignFlowKgS": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Design mass flow",
          "de": "Bemessungsmassenstrom"
        },
        "unit": "kg/s",
        "step": 0.01,
        "precision": 2,
        "group": "plant",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StatePlantLoopConfig",
    "branchType": "ModelSystemState",
    "branch": "systems",
    "collection": "plant_loops",
    "field": "design_flow_kg_s",
    "input": "new_design_flow_kg_s",
    "key": "id",
    "labels": {
      "en": "Change plant loop: Design mass flow",
      "de": "Bemessungsmassenstrom ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "plant-loop",
      "kind": "change-plant-loop-design-flow",
      "record": "ChangedPlantLoopDesignFlow"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Design mass flow violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed plant loop does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The plant loop already carries this design mass flow value."
      }
    }
  }
}
