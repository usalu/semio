{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-shw-system-heater-capacity/schema.json",
  "title": "ChangeShwSystemHeaterCapacity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newHeaterCapacityW"
  ],
  "properties": {
    "mutation": {
      "const": "changeShwSystemHeaterCapacity"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Service hot water system",
          "de": "Trinkwarmwasseranlage"
        },
        "description": {
          "en": "The service hot water system this mutation changes, by id.",
          "de": "Trinkwarmwasseranlage, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "serviceHotWaterSystem"
        },
        "group": "target",
        "order": 10
      }
    },
    "newHeaterCapacityW": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Heater capacity",
          "de": "Heizleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateShwSystemConfig",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "shw_systems",
    "field": "heater_capacity_w",
    "input": "new_heater_capacity_w",
    "key": "id",
    "labels": {
      "en": "Change service hot water system: Heater capacity",
      "de": "Heizleistung ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "service-hot-water-system",
      "kind": "change-shw-system-heater-capacity",
      "record": "ChangedShwSystemHeaterCapacity"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Heater capacity violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed service hot water system does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The service hot water system already carries this heater capacity value."
      }
    }
  }
}
