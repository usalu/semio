{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-daylight-zone-window-transmittance/schema.json",
  "title": "ChangeDaylightZoneWindowTransmittance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newWindowTransmittance"
  ],
  "properties": {
    "mutation": {
      "const": "changeDaylightZoneWindowTransmittance"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Daylight zone",
          "de": "Tageslichtzone"
        },
        "description": {
          "en": "The daylight zone this mutation changes, by id.",
          "de": "Tageslichtzone, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "daylightZone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newWindowTransmittance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Window transmittance",
          "de": "Fenstertransmissionsgrad"
        },
        "description": {
          "en": "Visible transmittance of the daylight apertures.",
          "de": "Lichttransmissionsgrad der Tageslichtöffnungen."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "daylight",
        "order": 20
      }
    }
  }
}
