{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/rename-shading-surface/schema.json",
  "title": "RenameShadingSurface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newName"
  ],
  "properties": {
    "mutation": {
      "const": "renameShadingSurface"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Shading surface",
          "de": "Verschattungsfläche"
        },
        "description": {
          "en": "The shading surface to rename, by id.",
          "de": "Verschattungsfläche, die diese Mutation umbenennt, per ID."
        },
        "ref": {
          "kind": "shadingSurface",
          "domain": "energyModel",
          "granularity": "shading"
        },
        "group": "target",
        "order": 10
      }
    },
    "newName": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 20
      },
      "minLength": 1
    }
  },
  "x-semio-energy-operation": {
    "category": "name-row",
    "row": "StateShadingSurface",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "shading_surfaces",
    "field": "name",
    "input": "new_name",
    "key": "id",
    "unique": true,
    "labels": {
      "en": "Rename shading surface",
      "de": "Verschattungsfläche umbenennen"
    },
    "semantics": {
      "verb": "rename",
      "entity": "shading-surface",
      "kind": "rename-shading-surface",
      "record": "RenamedShadingSurface"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A shading surface name must not be blank."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "Another shading surface already has this name."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed shading surface does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The shading surface already has this name."
      }
    }
  }
}
