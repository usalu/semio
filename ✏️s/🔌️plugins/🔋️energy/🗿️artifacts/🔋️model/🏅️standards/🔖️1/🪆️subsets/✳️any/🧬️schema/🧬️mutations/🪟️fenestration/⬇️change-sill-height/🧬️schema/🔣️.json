{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-fenestration-sill-height/schema.json",
  "title": "ChangeFenestrationSillHeight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newSillHeightM"
  ],
  "properties": {
    "mutation": {
      "const": "changeFenestrationSillHeight"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The window this mutation changes, by id.",
          "de": "Fenster, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "fenestration",
          "domain": "energyModel",
          "granularity": "fenestration"
        },
        "group": "target",
        "order": 10
      }
    },
    "newSillHeightM": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Sill height",
          "de": "Brüstungshöhe"
        },
        "unit": "m",
        "step": 0.01,
        "precision": 2,
        "group": "geometry",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateFenestration",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "fenestrations",
    "field": "sill_height_m",
    "input": "new_sill_height_m",
    "key": "id",
    "labels": {
      "en": "Change fenestration: Sill height",
      "de": "Brüstungshöhe ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "fenestration",
      "kind": "change-fenestration-sill-height",
      "record": "ChangedFenestrationSillHeight"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Sill height violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed fenestration does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The fenestration already carries this sill height value."
      }
    }
  }
}
