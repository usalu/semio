{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-run-year/schema.json",
  "title": "ChangeRunYear",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newYear"
  ],
  "properties": {
    "mutation": {
      "const": "changeRunYear"
    },
    "newYear": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Year",
          "de": "Jahr"
        },
        "description": {
          "en": "Calendar year that fixes the weekdays.",
          "de": "Kalenderjahr, das die Wochentage festlegt."
        },
        "step": 1,
        "precision": 0,
        "group": "calendar",
        "order": 50
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-field",
    "scope": "run_period",
    "field": "year",
    "input": "new_year",
    "labels": {
      "en": "Change year",
      "de": "Jahr ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "run",
      "kind": "change-run-year",
      "record": "ChangedRunYear"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored year is outside its admissible range."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The year is unchanged."
      },
      "context": {
        "level": "error",
        "code": "mutation.target-mismatch",
        "message": "The authored value does not form a valid calendar interval."
      }
    },
    "calendarInterval": true
  }
}
