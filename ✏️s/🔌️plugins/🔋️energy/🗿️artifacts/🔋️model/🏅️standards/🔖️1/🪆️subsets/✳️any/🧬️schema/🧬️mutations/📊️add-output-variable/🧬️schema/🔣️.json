{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/energy/model/mutation/add-output-variable/schema.json",
  "title": "AddOutputVariable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "key",
    "reportingFrequency"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "reportingFrequency": {
      "enum": [
        "Timestep",
        "Hourly",
        "Daily",
        "Monthly",
        "RunPeriod"
      ]
    }
  }
}
