{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-infiltration-method/schema.json",
  "title": "ChangeInfiltrationMethod",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newMethod"
  ],
  "properties": {
    "mutation": {
      "const": "changeInfiltrationMethod"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Infiltration",
          "de": "Infiltration"
        },
        "description": {
          "en": "The infiltration this mutation changes, by id.",
          "de": "Infiltration, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "infiltration",
          "domain": "energyModel",
          "granularity": "load"
        },
        "group": "target",
        "order": 10
      }
    },
    "newMethod": {
      "enum": [
        "ScheduledAch",
        "PerExteriorArea",
        "EffectiveLeakageArea",
        "WindAndStack"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Method",
          "de": "Methode"
        },
        "description": {
          "en": "Which of the parameters below drive the infiltration flow.",
          "de": "Welche der folgenden Parameter den Infiltrationsvolumenstrom bestimmen."
        },
        "options": {
          "ScheduledAch": {
            "en": "Scheduled air change rate",
            "de": "Luftwechsel nach Zeitplan"
          },
          "PerExteriorArea": {
            "en": "Per exterior area",
            "de": "Pro Außenfläche"
          },
          "EffectiveLeakageArea": {
            "en": "Effective leakage area",
            "de": "Effektive Leckagefläche"
          },
          "WindAndStack": {
            "en": "Wind and stack",
            "de": "Wind und thermischer Auftrieb"
          }
        },
        "group": "infiltration",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "enum-row",
    "row": "StateInfiltration",
    "branchType": "ModelLoadState",
    "branch": "loads",
    "collection": "infiltrations",
    "field": "method",
    "input": "new_method",
    "key": "id",
    "labels": {
      "en": "Change infiltration: Method",
      "de": "Methode ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "infiltration",
      "kind": "change-infiltration-method",
      "record": "ChangedInfiltrationMethod"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Method violates its authored choices."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed infiltration does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The infiltration already carries this method value."
      }
    }
  }
}
