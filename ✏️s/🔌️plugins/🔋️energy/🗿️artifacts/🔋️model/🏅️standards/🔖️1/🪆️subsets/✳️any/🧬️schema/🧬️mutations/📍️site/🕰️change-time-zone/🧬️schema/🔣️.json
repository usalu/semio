{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-site-time-zone/schema.json",
  "title": "ChangeSiteTimeZone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newTimeZoneHours"
  ],
  "properties": {
    "mutation": {
      "const": "changeSiteTimeZone"
    },
    "newTimeZoneHours": {
      "type": "number",
      "minimum": -12,
      "maximum": 14,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Time zone",
          "de": "Zeitzone"
        },
        "description": {
          "en": "Offset from UTC, -12 to 14 h.",
          "de": "Abweichung von UTC, -12 bis 14 h."
        },
        "unit": "h",
        "step": 0.25,
        "precision": 2,
        "softMin": -12,
        "softMax": 14,
        "group": "site",
        "order": 10
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-field",
    "scope": "site",
    "field": "time_zone_hours",
    "input": "new_time_zone_hours",
    "labels": {
      "en": "Change time zone hours",
      "de": "Zeitzone ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "site",
      "kind": "change-site-time-zone",
      "record": "ChangedSiteTimeZone"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored time zone hours is outside its admissible range."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The time zone hours is unchanged."
      }
    }
  }
}
