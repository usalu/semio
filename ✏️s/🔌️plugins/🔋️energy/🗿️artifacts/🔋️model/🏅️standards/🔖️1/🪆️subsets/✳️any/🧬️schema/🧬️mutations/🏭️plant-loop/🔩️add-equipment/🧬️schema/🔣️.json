{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/add-plant-loop-equipment/schema.json",
  "title": "AddPlantLoopEquipment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "equipmentId"
  ],
  "properties": {
    "mutation": {
      "const": "addPlantLoopEquipment"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the list; empty keeps id order.",
          "de": "Einfügeposition in der Liste; leer behält die ID-Reihenfolge."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 5
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plant loop",
          "de": "Anlagenkreislauf"
        },
        "description": {
          "en": "The plant loop this mutation changes, by id.",
          "de": "Anlagenkreislauf, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "plantLoop"
        },
        "group": "target",
        "order": 10
      }
    },
    "equipmentId": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plant component",
          "de": "Anlagenkomponente"
        },
        "description": {
          "en": "Component to add to the loop, by id.",
          "de": "Dem Kreislauf hinzuzufügende Komponente, per ID."
        },
        "ref": {
          "kind": "plantComponent"
        },
        "group": "member",
        "order": 20
      }
    }
  }
}
