{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-constant-schedule/schema.json",
  "title": "CreateConstantSchedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "createConstantSchedule"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new constant schedule is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "value": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Value",
          "de": "Wert"
        },
        "step": 0.01,
        "precision": 2,
        "group": "values",
        "order": 30
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateConstantSchedule",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "value",
        "input": "value",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateConstantSchedule",
    "branchType": "StateScheduleSet",
    "branch": "outputs",
    "nested": "schedules",
    "collection": "constants",
    "key": "id",
    "inverse": "DeleteConstantSchedule",
    "labels": {
      "en": "Create schedule",
      "de": "Zeitplan erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "schedule",
      "kind": "create-constant-schedule",
      "record": "CreatedConstantSchedule"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The schedule requires finite values and a positive timestep."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "A schedule with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The insertion rank is past the end of this schedule collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The schedule creation makes no change."
      }
    },
    "validationBeforeRank": false,
    "defaultRank": "explicit",
    "identityCollections": [
      "ConstantSchedules",
      "DailySchedules",
      "WeeklySchedules",
      "AnnualSchedules",
      "TimeSeriesSchedules"
    ]
  }
}
