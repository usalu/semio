{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-ground-deep/schema.json",
  "title": "ChangeGroundDeep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newTemperatureC"
  ],
  "properties": {
    "mutation": {
      "const": "changeGroundDeep"
    },
    "newTemperatureC": {
      "type": "number",
      "minimum": -273.15,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Deep ground temperature",
          "de": "Erdreichtemperatur in der Tiefe"
        },
        "description": {
          "en": "Constant over the year.",
          "de": "Über das Jahr konstant."
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "softMin": -20,
        "softMax": 40,
        "group": "ground",
        "order": 10
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-field",
    "scope": "ground_temperature",
    "field": "deep_c",
    "input": "new_temperature_c",
    "labels": {
      "en": "Change deep c",
      "de": "Tiefe Bodentemperatur ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "ground",
      "kind": "change-ground-deep",
      "record": "ChangedGroundDeep"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored deep c is outside its admissible range."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The deep c is unchanged."
      }
    }
  }
}
