{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-zone-equipment/schema.json",
  "title": "CreateZoneEquipment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "zoneId",
    "equipmentType",
    "priority",
    "heatingCapacityW",
    "coolingCapacityW"
  ],
  "properties": {
    "mutation": {
      "const": "createZoneEquipment"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; empty appends (or keeps id order).",
          "de": "Einfügeposition in der Modellliste; leer hängt an (oder behält die ID-Reihenfolge)."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 5
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new zone equipment is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 10
      }
    },
    "zoneId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "Assigned zone, by id.",
          "de": "Zugeordnete Zone, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "assignment",
        "order": 20
      }
    },
    "equipmentType": {
      "enum": [
        "Baseboard",
        "Radiant",
        "FanCoil",
        "Ptac",
        "VrfTerminal",
        "Erv",
        "UnitHeater",
        "WaterToAirHp"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Equipment type",
          "de": "Gerätetyp"
        },
        "options": {
          "Baseboard": {
            "en": "Baseboard heater",
            "de": "Sockelleistenheizung"
          },
          "Radiant": {
            "en": "Radiant system",
            "de": "Flächenheizung/-kühlung"
          },
          "FanCoil": {
            "en": "Fan coil unit",
            "de": "Gebläsekonvektor"
          },
          "Ptac": {
            "en": "Packaged terminal air conditioner",
            "de": "Kompaktklimagerät"
          },
          "VrfTerminal": {
            "en": "VRF terminal unit",
            "de": "VRF-Inneneinheit"
          },
          "Erv": {
            "en": "Energy recovery ventilator",
            "de": "Lüftungsgerät mit Wärmerückgewinnung"
          },
          "UnitHeater": {
            "en": "Unit heater",
            "de": "Lufterhitzer"
          },
          "WaterToAirHp": {
            "en": "Water-to-air heat pump",
            "de": "Wasser-Luft-Wärmepumpe"
          }
        },
        "group": "equipment",
        "order": 30
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Priority",
          "de": "Priorität"
        },
        "description": {
          "en": "Load allocation order; 1 is served first.",
          "de": "Reihenfolge der Lastverteilung; 1 wird zuerst bedient."
        },
        "step": 1,
        "precision": 0,
        "softMin": 1,
        "group": "equipment",
        "order": 40
      }
    },
    "heatingCapacityW": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Heating capacity",
          "de": "Heizleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 50
      }
    },
    "coolingCapacityW": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Cooling capacity",
          "de": "Kühlleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 60
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateZoneEquipmentAssignment",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "zone_id",
        "input": "zone_id",
        "storage": "fixed"
      },
      {
        "field": "equipment_type",
        "input": "equipment_type",
        "storage": "sealed-copy"
      },
      {
        "field": "priority",
        "input": "priority",
        "storage": "fixed"
      },
      {
        "field": "heating_capacity_w",
        "input": "heating_capacity_w",
        "storage": "fixed"
      },
      {
        "field": "cooling_capacity_w",
        "input": "cooling_capacity_w",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateZoneEquipmentAssignment",
    "branchType": "ModelControlState",
    "branch": "controls",
    "collection": "zone_equipment",
    "key": "id",
    "inverse": "DeleteZoneEquipment",
    "labels": {
      "en": "Create zone equipment",
      "de": "Zonengerät erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "zone-equipment",
      "kind": "create-zone-equipment",
      "record": "CreatedZoneEquipment"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored row violates its declared field bounds."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "An object with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The authored insertion rank is past the end of the collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The creation makes no change."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The original referenced entity does not exist."
      }
    },
    "validationBeforeRank": true,
    "rules": [
      {
        "input": "zone_id",
        "kind": "reference",
        "storage": "direct",
        "collections": [
          "Zones"
        ],
        "target": "input"
      }
    ],
    "defaultRank": "append",
    "scalarOrder": "after-rules"
  }
}
