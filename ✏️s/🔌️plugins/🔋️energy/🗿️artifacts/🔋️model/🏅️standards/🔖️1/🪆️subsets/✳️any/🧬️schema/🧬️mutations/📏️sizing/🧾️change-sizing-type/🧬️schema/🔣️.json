{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-sizing-object-sizing-type/schema.json",
  "title": "ChangeSizingObjectSizingType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newSizingType"
  ],
  "properties": {
    "mutation": {
      "const": "changeSizingObjectSizingType"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Sizing object",
          "de": "Auslegungsobjekt"
        },
        "description": {
          "en": "The sizing object this mutation changes, by id.",
          "de": "Auslegungsobjekt, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "sizingObject"
        },
        "group": "target",
        "order": 10
      }
    },
    "newSizingType": {
      "enum": [
        "Heating",
        "Cooling",
        "OutdoorAir"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Sizing type",
          "de": "Auslegungsart"
        },
        "options": {
          "Heating": {
            "en": "Heating",
            "de": "Heizung"
          },
          "Cooling": {
            "en": "Cooling",
            "de": "Kühlung"
          },
          "OutdoorAir": {
            "en": "Outdoor air",
            "de": "Außenluft"
          }
        },
        "group": "sizing",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "enum-row",
    "row": "StateSizingObject",
    "branchType": "ModelOutputState",
    "branch": "outputs",
    "collection": "sizing_objects",
    "field": "sizing_type",
    "input": "new_sizing_type",
    "key": "id",
    "labels": {
      "en": "Change sizing object: Sizing type",
      "de": "Auslegungsart ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "sizing-object",
      "kind": "change-sizing-object-sizing-type",
      "record": "ChangedSizingObjectSizingType"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Sizing type violates its authored choices."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed sizing object does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The sizing object already carries this sizing type value."
      }
    }
  }
}
