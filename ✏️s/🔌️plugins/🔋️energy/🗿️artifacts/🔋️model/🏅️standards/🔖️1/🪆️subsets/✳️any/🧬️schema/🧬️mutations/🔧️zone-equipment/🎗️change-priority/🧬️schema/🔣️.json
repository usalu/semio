{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-zone-equipment-priority/schema.json",
  "title": "ChangeZoneEquipmentPriority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newPriority"
  ],
  "properties": {
    "mutation": {
      "const": "changeZoneEquipmentPriority"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone equipment",
          "de": "Zonengerät"
        },
        "description": {
          "en": "The zone equipment this mutation changes, by id.",
          "de": "Zonengerät, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "zoneEquipment"
        },
        "group": "target",
        "order": 10
      }
    },
    "newPriority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Priority",
          "de": "Priorität"
        },
        "description": {
          "en": "Load allocation order; 1 is served first.",
          "de": "Reihenfolge der Lastverteilung; 1 wird zuerst bedient."
        },
        "step": 1,
        "precision": 0,
        "softMin": 1,
        "group": "equipment",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateZoneEquipmentAssignment",
    "branchType": "ModelControlState",
    "branch": "controls",
    "collection": "zone_equipment",
    "field": "priority",
    "input": "new_priority",
    "key": "id",
    "labels": {
      "en": "Change zone equipment: Priority",
      "de": "Priorität ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "zone-equipment",
      "kind": "change-zone-equipment-priority",
      "record": "ChangedZoneEquipmentPriority"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Priority violates its authored choices."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed zone equipment does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The zone equipment already carries this priority value."
      }
    }
  }
}
