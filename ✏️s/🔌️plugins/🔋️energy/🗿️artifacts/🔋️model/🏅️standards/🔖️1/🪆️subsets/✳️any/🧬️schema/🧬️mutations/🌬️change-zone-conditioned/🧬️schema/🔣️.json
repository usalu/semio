{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-zone-conditioned/schema.json",
  "title": "ChangeZoneConditioned",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newConditioned"
  ],
  "properties": {
    "mutation": {
      "const": "changeZoneConditioned"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The zone this mutation changes, by id.",
          "de": "Zone, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newConditioned": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Conditioned",
          "de": "Konditioniert"
        },
        "description": {
          "en": "Heated or cooled by the HVAC system.",
          "de": "Von der Anlagentechnik beheizt oder gekühlt."
        },
        "group": "thermal",
        "order": 20
      }
    }
  }
}
