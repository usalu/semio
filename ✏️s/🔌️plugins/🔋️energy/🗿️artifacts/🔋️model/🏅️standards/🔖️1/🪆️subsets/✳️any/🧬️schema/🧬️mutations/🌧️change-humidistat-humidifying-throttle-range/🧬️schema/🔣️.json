{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-humidistat-humidifying-throttle-range/schema.json",
  "title": "ChangeHumidistatHumidifyingThrottleRange",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newHumidifyingThrottleRange"
  ],
  "properties": {
    "mutation": {
      "const": "changeHumidistatHumidifyingThrottleRange"
    },
    "id": {
