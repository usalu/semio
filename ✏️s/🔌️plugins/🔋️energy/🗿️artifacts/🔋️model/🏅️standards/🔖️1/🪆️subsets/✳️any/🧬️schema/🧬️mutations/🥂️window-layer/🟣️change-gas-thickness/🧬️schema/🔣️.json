{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-gas-material-thickness/schema.json",
  "title": "ChangeGasMaterialThickness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newThicknessM"
  ],
  "properties": {
    "mutation": {
      "const": "changeGasMaterialThickness"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Gas gap",
          "de": "Gasfüllung"
        },
        "description": {
          "en": "The gas gap this mutation changes, by id.",
          "de": "Gasfüllung, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "gasMaterial",
          "domain": "energyModel",
          "granularity": "gasMaterial"
        },
        "group": "target",
        "order": 10
      }
    },
    "newThicknessM": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Gap width",
          "de": "Scheibenabstand"
        },
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "step": 0.001,
        "precision": 1,
        "group": "geometry",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateGasMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "gas_materials",
    "field": "thickness_m",
    "input": "new_thickness_m",
    "key": "id",
    "labels": {
      "en": "Change gas material: Gap width",
      "de": "Scheibenabstand ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "gas-material",
      "kind": "change-gas-material-thickness",
      "record": "ChangedGasMaterialThickness"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Gap width violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed gas material does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The gas material already carries this gap width value."
      }
    }
  }
}
