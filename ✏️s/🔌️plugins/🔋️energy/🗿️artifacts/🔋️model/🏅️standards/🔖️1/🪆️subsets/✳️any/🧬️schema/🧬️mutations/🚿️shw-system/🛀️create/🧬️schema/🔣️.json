{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-shw-system/schema.json",
  "title": "CreateShwSystem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "heaterCapacityW",
    "storageVolumeM3",
    "setpointC",
    "scheduleId"
  ],
  "properties": {
    "mutation": {
      "const": "createShwSystem"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new service hot water system is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "heaterCapacityW": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Heater capacity",
          "de": "Heizleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 30
      },
      "exclusiveMinimum": 0
    },
    "storageVolumeM3": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Storage volume",
          "de": "Speichervolumen"
        },
        "unit": "m³",
        "displayUnit": "L",
        "displayFactor": 1000,
        "step": 0.01,
        "precision": 0,
        "group": "capacity",
        "order": 40
      },
      "exclusiveMinimum": 0
    },
    "setpointC": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Tank setpoint",
          "de": "Speichersolltemperatur"
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "group": "control",
        "order": 50
      },
      "minimum": 0,
      "maximum": 100
    },
    "scheduleId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Schedule",
          "de": "Zeitplan"
        },
        "description": {
          "en": "Fraction schedule scaling the design value over time, by id.",
          "de": "Anteilszeitplan, der den Bemessungswert zeitlich skaliert, per ID."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 60
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateShwSystemConfig",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "heater_capacity_w",
        "input": "heater_capacity_w",
        "storage": "fixed"
      },
      {
        "field": "storage_volume_m3",
        "input": "storage_volume_m3",
        "storage": "fixed"
      },
      {
        "field": "setpoint_c",
        "input": "setpoint_c",
        "storage": "fixed"
      },
      {
        "field": "schedule_id",
        "input": "schedule_id",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateShwSystemConfig",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "shw_systems",
    "key": "id",
    "inverse": "DeleteShwSystem",
    "labels": {
      "en": "Create Shw System at index",
      "de": "Trinkwarmwasseranlage an Index erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "service-hot-water-system",
      "kind": "create-shw-system",
      "record": "CreatedShwSystem"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored row violates its declared field bounds."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "An object with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The authored insertion rank is past the end of the collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The creation makes no change."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The original referenced entity does not exist."
      }
    },
    "validationBeforeRank": false,
    "rules": [
      {
        "input": "schedule_id",
        "kind": "reference",
        "storage": "direct",
        "collections": [
          "ConstantSchedules",
          "DailySchedules",
          "WeeklySchedules",
          "AnnualSchedules",
          "TimeSeriesSchedules"
        ],
        "target": "input"
      }
    ],
    "defaultRank": "explicit",
    "scalarOrder": "after-rules"
  }
}
