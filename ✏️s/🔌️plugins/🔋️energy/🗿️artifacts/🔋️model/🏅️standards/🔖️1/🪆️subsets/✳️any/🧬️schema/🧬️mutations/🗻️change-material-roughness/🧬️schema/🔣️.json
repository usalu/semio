{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-material-roughness/schema.json",
  "title": "ChangeMaterialRoughness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newRoughness"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "newRoughness": {
      "enum": [
        "VeryRough",
        "Rough",
        "MediumRough",
        "MediumSmooth",
        "Smooth",
        "VerySmooth"
      ]
    }
  }
}
