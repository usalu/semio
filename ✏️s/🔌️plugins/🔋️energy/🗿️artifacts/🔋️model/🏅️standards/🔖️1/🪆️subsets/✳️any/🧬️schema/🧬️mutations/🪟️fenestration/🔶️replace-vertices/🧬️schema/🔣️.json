{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/replace-fenestration-vertices/schema.json",
  "title": "ReplaceFenestrationVertices",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newVerticesM"
  ],
  "properties": {
    "mutation": {
      "const": "replaceFenestrationVertices"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The window this mutation changes, by id.",
          "de": "Fenster, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "fenestration",
          "domain": "energyModel",
          "granularity": "fenestration"
        },
        "group": "target",
        "order": 10
      }
    },
    "newVerticesM": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "array",
          "minItems": 3
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Vertices",
          "de": "Eckpunkte"
        },
        "description": {
          "en": "Aperture polygon in the host surface's plane, counter-clockwise seen from outside; empty derives the rectangle from area, height and sill height.",
          "de": "Öffnungspolygon in der Ebene der Trägerfläche, von außen gesehen gegen den Uhrzeigersinn; leer leitet das Rechteck aus Fläche, Höhe und Brüstungshöhe ab."
        },
        "unit": "m",
        "group": "geometry",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "owned-row",
    "row": "StateFenestration",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "fenestrations",
    "field": "vertices_m",
    "input": "new_vertices_m",
    "key": "id",
    "validation": "host-plane",
    "labels": {
      "en": "Replace fenestration polygon",
      "de": "Fensterpolygon ersetzen"
    },
    "semantics": {
      "verb": "replace",
      "entity": "fenestration",
      "kind": "replace-fenestration-vertices",
      "record": "ReplacedFenestrationVertices"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "An aperture is empty or contains at least three finite original points."
      },
      "context": {
        "level": "error",
        "code": "mutation.target-mismatch",
        "message": "Every aperture point must lie in the original host surface plane."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed original fenestration does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The original fenestration already has this polygon."
      }
    }
  }
}
