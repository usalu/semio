{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-people-gain/schema.json",
  "title": "CreatePeopleGain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "zoneId",
    "scheduleId",
    "activityScheduleId",
    "peoplePerArea",
    "sensibleFraction",
    "latentFraction",
    "radiantFraction"
  ],
  "properties": {
    "mutation": {
      "const": "createPeopleGain"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new people gain is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "zoneId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "Assigned zone, by id.",
          "de": "Zugeordnete Zone, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "assignment",
        "order": 30
      }
    },
    "scheduleId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Schedule",
          "de": "Zeitplan"
        },
        "description": {
          "en": "Fraction schedule scaling the design value over time, by id.",
          "de": "Anteilszeitplan, der den Bemessungswert zeitlich skaliert, per ID."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 40
      }
    },
    "activityScheduleId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Activity schedule",
          "de": "Aktivitätszeitplan"
        },
        "description": {
          "en": "Metabolic heat per person over time, by id.",
          "de": "Wärmeabgabe je Person im Zeitverlauf, per ID."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 50
      }
    },
    "peoplePerArea": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "People per area",
          "de": "Personen pro Fläche"
        },
        "description": {
          "en": "Occupant density per m² floor area.",
          "de": "Belegungsdichte je m² Geschossfläche."
        },
        "unit": "1/m²",
        "step": 0.01,
        "precision": 3,
        "group": "gains",
        "order": 60
      }
    },
    "sensibleFraction": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Sensible fraction",
          "de": "Sensibler Anteil"
        },
        "description": {
          "en": "Share of the heat output released as sensible heat.",
          "de": "Anteil der Wärmeabgabe als sensible Wärme."
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "softMin": 0,
        "softMax": 1,
        "group": "gains",
        "order": 70
      }
    },
    "latentFraction": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Latent fraction",
          "de": "Latenter Anteil"
        },
        "description": {
          "en": "Share of the heat output released as moisture.",
          "de": "Anteil der Wärmeabgabe als latente Wärme (Feuchte)."
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "softMin": 0,
        "softMax": 1,
        "group": "gains",
        "order": 80
      }
    },
    "radiantFraction": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Radiant fraction",
          "de": "Strahlungsanteil"
        },
        "description": {
          "en": "Share of the heat output released as long-wave radiation.",
          "de": "Anteil der Wärmeabgabe als langwellige Strahlung."
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "softMin": 0,
        "softMax": 1,
        "group": "gains",
        "order": 90
      }
    }
  }
}
