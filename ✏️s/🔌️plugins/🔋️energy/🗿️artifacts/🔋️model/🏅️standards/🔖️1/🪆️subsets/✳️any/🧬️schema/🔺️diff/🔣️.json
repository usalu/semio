{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/energy/model/diff.json",
  "title": "EnergyModelDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "$ref": "#/$defs/EnergyModelArtifact",
      "x-semio-state": "artifact"
    },
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "model": {
      "type": "object",
      "x-semio-state": "artifact"
    },
    "structure": {
      "type": "object",
      "x-semio-state": "artifact"
    },
    "zones": {
      "type": "object",
      "x-semio-state": "artifact"
    },
    "referencedModel": {
      "$ref": "#/$defs/EnergyLinkSlotDelta",
      "x-semio-state": "artifact"
    },
    "weatherLink": {
      "$ref": "#/$defs/EnergyLinkSlotDelta",
      "x-semio-state": "artifact"
    },
    "resultsJson": {
      "type": "string",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "EnergyLinkSlotDelta": {
      "title": "EnergyLinkSlotDelta",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "detached"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "link"
          ],
          "properties": {
            "kind": {
              "const": "attached"
            },
            "link": {
              "type": "object"
            }
          }
        }
      ]
    },
    "EnergyModelArtifact": {
      "title": "EnergyModelArtifact",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "model",
        "structure",
        "zones",
        "resultsJson"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "model": {
          "type": "object"
        },
        "structure": {
          "type": "object"
        },
        "zones": {
          "type": "object"
        },
        "referencedModel": {},
        "weatherLink": {},
        "resultsJson": {
          "type": "string"
        }
      }
    }
  }
}
