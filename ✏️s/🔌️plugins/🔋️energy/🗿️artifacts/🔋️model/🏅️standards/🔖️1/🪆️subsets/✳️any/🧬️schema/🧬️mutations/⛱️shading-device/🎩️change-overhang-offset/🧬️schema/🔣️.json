{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-fenestration-overhang-offset/schema.json",
  "title": "ChangeFenestrationOverhangOffset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newOverhangOffsetM"
  ],
  "properties": {
    "mutation": {
      "const": "changeFenestrationOverhangOffset"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The window this mutation changes, by id.",
          "de": "Fenster, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "fenestration",
          "domain": "energyModel",
          "granularity": "fenestration"
        },
        "group": "target",
        "order": 10
      }
    },
    "newOverhangOffsetM": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Overhang offset",
          "de": "Überstandsabstand"
        },
        "description": {
          "en": "Height of the overhang above the window head.",
          "de": "Höhe des Überstands über dem Fenstersturz."
        },
        "unit": "m",
        "step": 0.01,
        "precision": 2,
        "group": "shading",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateFenestration",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "fenestrations",
    "field": "overhang_offset_m",
    "input": "new_overhang_offset_m",
    "key": "id",
    "labels": {
      "en": "Change fenestration: Overhang offset",
      "de": "Überstandsabstand ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "fenestration",
      "kind": "change-fenestration-overhang-offset",
      "record": "ChangedFenestrationOverhangOffset"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Overhang offset violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed fenestration does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The fenestration already carries this overhang offset value."
      }
    }
  }
}
