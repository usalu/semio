{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-pv-system-tilt/schema.json",
  "title": "ChangePvSystemTilt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newTiltDeg"
  ],
  "properties": {
    "mutation": {
      "const": "changePvSystemTilt"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "PV system",
          "de": "PV-Anlage"
        },
        "description": {
          "en": "The PV system this mutation changes, by id.",
          "de": "PV-Anlage, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "pvSystem"
        },
        "group": "target",
        "order": 10
      }
    },
    "newTiltDeg": {
      "type": "number",
      "minimum": 0,
      "maximum": 90,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Tilt",
          "de": "Neigung"
        },
        "description": {
          "en": "Angle from horizontal: 0 is flat, 90 is vertical.",
          "de": "Winkel zur Horizontalen: 0 ist waagerecht, 90 senkrecht."
        },
        "unit": "deg",
        "step": 1,
        "precision": 0,
        "softMin": 0,
        "softMax": 90,
        "snaps": [
          0,
          15,
          30,
          45,
          60,
          75,
          90
        ],
        "group": "orientation",
        "order": 20
      }
    }
  }
}
