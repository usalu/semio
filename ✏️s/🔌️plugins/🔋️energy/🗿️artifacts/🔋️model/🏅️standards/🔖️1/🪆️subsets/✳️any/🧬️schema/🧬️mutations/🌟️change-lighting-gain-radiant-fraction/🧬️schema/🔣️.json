{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-lighting-gain-radiant-fraction/schema.json",
  "title": "ChangeLightingGainRadiantFraction",
  "type": "object",
