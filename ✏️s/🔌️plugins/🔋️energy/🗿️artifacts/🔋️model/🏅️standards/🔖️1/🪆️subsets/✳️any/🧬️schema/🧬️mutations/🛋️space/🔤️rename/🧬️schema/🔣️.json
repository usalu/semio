{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/rename-space/schema.json",
  "title": "RenameSpace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newName"
  ],
  "properties": {
    "mutation": {
      "const": "renameSpace"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Space",
          "de": "Raum"
        },
        "description": {
          "en": "The space to rename, by id.",
          "de": "Raum, den diese Mutation umbenennt, per ID."
        },
        "ref": {
          "kind": "space",
          "domain": "energyModel",
          "granularity": "space"
        },
        "group": "target",
        "order": 10
      }
    },
    "newName": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 20
      },
      "minLength": 1
    }
  },
  "x-semio-energy-operation": {
    "category": "name-row",
    "row": "StateSpace",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "spaces",
    "field": "name",
    "input": "new_name",
    "key": "id",
    "unique": true,
    "labels": {
      "en": "Rename space",
      "de": "Raum umbenennen"
    },
    "semantics": {
      "verb": "rename",
      "entity": "space",
      "kind": "rename-space",
      "record": "RenamedSpace"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A space name must not be blank."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "Another space already has this name."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed space does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The space already has this name."
      }
    }
  }
}
