{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-pv-system-inverter-efficiency/schema.json",
  "title": "ChangePvSystemInverterEfficiency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newInverterEfficiency"
  ],
  "properties": {
    "mutation": {
      "const": "changePvSystemInverterEfficiency"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "PV system",
          "de": "PV-Anlage"
        },
        "description": {
          "en": "The PV system this mutation changes, by id.",
          "de": "PV-Anlage, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "pvSystem"
        },
        "group": "target",
        "order": 10
      }
    },
    "newInverterEfficiency": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Inverter efficiency",
          "de": "Wechselrichterwirkungsgrad"
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.001,
        "precision": 1,
        "softMin": 0.001,
        "softMax": 1,
        "group": "efficiency",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StatePvSystemAssignment",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "pv_systems",
    "field": "inverter_efficiency",
    "input": "new_inverter_efficiency",
    "key": "id",
    "labels": {
      "en": "Change pv system: Inverter efficiency",
      "de": "Wechselrichterwirkungsgrad ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "pv-system",
      "kind": "change-pv-system-inverter-efficiency",
      "record": "ChangedPvSystemInverterEfficiency"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Inverter efficiency violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed pv system does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The pv system already carries this inverter efficiency value."
      }
    }
  }
}
