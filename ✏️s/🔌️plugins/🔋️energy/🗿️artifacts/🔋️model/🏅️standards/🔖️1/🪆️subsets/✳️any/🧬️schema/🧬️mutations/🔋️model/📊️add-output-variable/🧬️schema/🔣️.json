{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/add-output-variable/schema.json",
  "title": "AddOutputVariable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "name",
    "key",
    "reportingFrequency"
  ],
  "properties": {
    "mutation": {
      "const": "addOutputVariable"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; empty appends (or keeps id order).",
          "de": "Einfügeposition in der Modellliste; leer hängt an (oder behält die ID-Reihenfolge)."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 5
      }
    },
    "name": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Variable name",
          "de": "Variablenname"
        },
        "description": {
          "en": "Output variable to report, e.g. Zone Mean Air Temperature.",
          "de": "Zu berichtende Ausgabevariable, z. B. Zone Mean Air Temperature."
        },
        "group": "output",
        "order": 10
      }
    },
    "key": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Key value",
          "de": "Schlüsselwert"
        },
        "description": {
          "en": "Object the variable reports for, e.g. a zone name.",
          "de": "Objekt, für das die Variable berichtet, z. B. ein Zonenname."
        },
        "group": "output",
        "order": 20
      }
    },
    "reportingFrequency": {
      "enum": [
        "Timestep",
        "Hourly",
        "Daily",
        "Monthly",
        "RunPeriod"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Reporting frequency",
          "de": "Berichtsintervall"
        },
        "options": {
          "Timestep": {
            "en": "Every timestep",
            "de": "Jeder Zeitschritt"
          },
          "Hourly": {
            "en": "Hourly",
            "de": "Stündlich"
          },
          "Daily": {
            "en": "Daily",
            "de": "Täglich"
          },
          "Monthly": {
            "en": "Monthly",
            "de": "Monatlich"
          },
          "RunPeriod": {
            "en": "Run period",
            "de": "Simulationszeitraum"
          }
        },
        "group": "output",
        "order": 30
      }
    }
  }
}
