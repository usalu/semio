{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-material/schema.json",
  "title": "CreateMaterial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "name",
    "roughness",
    "thicknessM",
    "conductivityWMK",
    "densityKgM3",
    "specificHeatJKgK",
    "thermalAbsorptance",
    "solarAbsorptance",
    "visibleAbsorptance"
  ],
  "properties": {
    "mutation": {
      "const": "createMaterial"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new material is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 30
      }
    },
    "roughness": {
      "enum": [
        "VeryRough",
        "Rough",
        "MediumRough",
        "MediumSmooth",
        "Smooth",
        "VerySmooth"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Roughness",
          "de": "Rauigkeit"
        },
        "description": {
          "en": "Outside surface roughness; scales forced convection.",
          "de": "Rauigkeit der Außenoberfläche; skaliert die erzwungene Konvektion."
        },
        "options": {
          "VeryRough": {
            "en": "Very rough",
            "de": "Sehr rau"
          },
          "Rough": {
            "en": "Rough",
            "de": "Rau"
          },
          "MediumRough": {
            "en": "Medium rough",
            "de": "Mittelrau"
          },
          "MediumSmooth": {
            "en": "Medium smooth",
            "de": "Mittelglatt"
          },
          "Smooth": {
            "en": "Smooth",
            "de": "Glatt"
          },
          "VerySmooth": {
            "en": "Very smooth",
            "de": "Sehr glatt"
          }
        },
        "group": "thermal",
        "order": 40
      }
    },
    "thicknessM": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Thickness",
          "de": "Dicke"
        },
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "step": 0.001,
        "precision": 1,
        "group": "geometry",
        "order": 50
      },
      "exclusiveMinimum": 0
    },
    "conductivityWMK": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Thermal conductivity",
          "de": "Wärmeleitfähigkeit"
        },
        "unit": "W/(m·K)",
        "step": 0.001,
        "precision": 3,
        "group": "thermal",
        "order": 60
      },
      "exclusiveMinimum": 0
    },
    "densityKgM3": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Density",
          "de": "Rohdichte"
        },
        "unit": "kg/m³",
        "step": 1,
        "precision": 0,
        "group": "thermal",
        "order": 70
      },
      "exclusiveMinimum": 0
    },
    "specificHeatJKgK": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Specific heat capacity",
          "de": "Spezifische Wärmekapazität"
        },
        "unit": "J/(kg·K)",
        "step": 10,
        "precision": 0,
        "group": "thermal",
        "order": 80
      },
      "exclusiveMinimum": 0
    },
    "thermalAbsorptance": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Thermal absorptance",
          "de": "Thermischer Absorptionsgrad"
        },
        "description": {
          "en": "Long-wave absorptance, equal to the emissivity.",
          "de": "Langwelliger Absorptionsgrad, gleich dem Emissionsgrad."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "optics",
        "order": 90
      },
      "minimum": 0,
      "maximum": 1
    },
    "solarAbsorptance": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Solar absorptance",
          "de": "Solarer Absorptionsgrad"
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "optics",
        "order": 100
      },
      "minimum": 0,
      "maximum": 1
    },
    "visibleAbsorptance": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Visible absorptance",
          "de": "Sichtbarer Absorptionsgrad"
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "optics",
        "order": 110
      },
      "minimum": 0,
      "maximum": 1
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateMaterial",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "name",
        "input": "name",
        "storage": "sealed"
      },
      {
        "field": "roughness",
        "input": "roughness",
        "storage": "sealed-copy"
      },
      {
        "field": "thickness_m",
        "input": "thickness_m",
        "storage": "fixed"
      },
      {
        "field": "conductivity_w_m_k",
        "input": "conductivity_w_m_k",
        "storage": "fixed"
      },
      {
        "field": "density_kg_m3",
        "input": "density_kg_m3",
        "storage": "fixed"
      },
      {
        "field": "specific_heat_j_kg_k",
        "input": "specific_heat_j_kg_k",
        "storage": "fixed"
      },
      {
        "field": "thermal_absorptance",
        "input": "thermal_absorptance",
        "storage": "fixed"
      },
      {
        "field": "solar_absorptance",
        "input": "solar_absorptance",
        "storage": "fixed"
      },
      {
        "field": "visible_absorptance",
        "input": "visible_absorptance",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "materials",
    "key": "id",
    "inverse": "DeleteMaterial",
    "labels": {
      "en": "Create Material at index",
      "de": "Material an Index erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "material",
      "kind": "create-material",
      "record": "CreatedMaterial"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored row violates its declared field bounds."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "An object with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The authored insertion rank is past the end of the collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The creation makes no change."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The original referenced entity does not exist."
      }
    },
    "validationBeforeRank": false,
    "defaultRank": "explicit",
    "name": "name",
    "nameValidation": "verbatim",
    "unique": false
  }
}
