{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-ground-temperature-shallow/schema.json",
  "title": "ChangeGroundTemperatureShallow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "month",
    "newTemperatureC"
  ],
  "properties": {
    "mutation": {
      "const": "changeGroundTemperatureShallow"
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Month",
          "de": "Monat"
        },
        "description": {
          "en": "Calendar month, 1 = January.",
          "de": "Kalendermonat, 1 = Januar."
        },
        "step": 1,
        "precision": 0,
        "softMin": 1,
        "softMax": 12,
        "group": "ground",
        "order": 10
      }
    },
    "newTemperatureC": {
      "type": "number",
      "minimum": -273.15,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Shallow ground temperature",
          "de": "Oberflächennahe Erdreichtemperatur"
        },
        "description": {
          "en": "Monthly value near the surface.",
          "de": "Monatswert nahe der Oberfläche."
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "softMin": -20,
        "softMax": 40,
        "group": "ground",
        "order": 20
      }
    }
  }
}
