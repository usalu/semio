{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-humidistat/schema.json",
  "title": "CreateHumidistat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "zoneId",
    "humidifyingSetpointScheduleId",
    "dehumidifyingSetpointScheduleId",
    "humidifyingThrottleRange",
    "dehumidifyingThrottleRange"
  ],
  "properties": {
    "mutation": {
      "const": "createHumidistat"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new humidistat is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 10
      }
    },
    "zoneId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "Assigned zone, by id.",
          "de": "Zugeordnete Zone, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "assignment",
        "order": 20
      }
    },
    "humidifyingSetpointScheduleId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Humidifying setpoint schedule",
          "de": "Befeuchtungs-Sollwertzeitplan"
        },
        "description": {
          "en": "Relative-humidity floor over time, by id.",
          "de": "Untere Sollgrenze der relativen Feuchte im Zeitverlauf, per ID."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 30
      }
    },
    "dehumidifyingSetpointScheduleId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Dehumidifying setpoint schedule",
          "de": "Entfeuchtungs-Sollwertzeitplan"
        },
        "description": {
          "en": "Relative-humidity ceiling over time, by id.",
          "de": "Obere Sollgrenze der relativen Feuchte im Zeitverlauf, per ID."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 40
      }
    },
    "humidifyingThrottleRange": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Humidifying throttle range",
          "de": "Befeuchtungs-Proportionalbereich"
        },
        "description": {
          "en": "Band of relative humidity (as a fraction of saturation, shown in %) over which humidification ramps from off to full.",
          "de": "Band der relativen Feuchte (als Anteil der Sättigung, in % angezeigt), in dem die Befeuchtung von null auf voll ansteigt."
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "group": "control",
        "order": 50
      }
    },
    "dehumidifyingThrottleRange": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Dehumidifying throttle range",
          "de": "Entfeuchtungs-Proportionalbereich"
        },
        "description": {
          "en": "Band of relative humidity (as a fraction of saturation, shown in %) over which dehumidification ramps from off to full.",
          "de": "Band der relativen Feuchte (als Anteil der Sättigung, in % angezeigt), in dem die Entfeuchtung von null auf voll ansteigt."
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "group": "control",
        "order": 60
      }
    }
  }
}
