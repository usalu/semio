{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-battery/schema.json",
  "title": "CreateBattery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "capacityKwh",
    "maxChargeW",
    "maxDischargeW",
    "roundTripEfficiency"
  ],
  "properties": {
    "mutation": {
      "const": "createBattery"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new battery is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "capacityKwh": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Storage capacity",
          "de": "Speicherkapazität"
        },
        "unit": "kWh",
        "step": 0.5,
        "precision": 1,
        "group": "capacity",
        "order": 30
      }
    },
    "maxChargeW": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Maximum charge power",
          "de": "Maximale Ladeleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 40
      }
    },
    "maxDischargeW": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Maximum discharge power",
          "de": "Maximale Entladeleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 50
      }
    },
    "roundTripEfficiency": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Round-trip efficiency",
          "de": "Zyklenwirkungsgrad"
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.001,
        "precision": 1,
        "softMin": 0.001,
        "softMax": 1,
        "group": "efficiency",
        "order": 60
      }
    }
  }
}
