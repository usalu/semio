{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-pv-system-mounting/schema.json",
  "title": "ChangePvSystemMounting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newMounting"
  ],
  "properties": {
    "mutation": {
      "const": "changePvSystemMounting"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "PV system",
          "de": "PV-Anlage"
        },
        "ref": {
          "kind": "pvSystem"
        }
      }
    },
    "newMounting": {
      "type": "string",
      "enum": [
        "OpenRack",
        "CloseRoof",
        "InsulatedBack"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Mounting",
          "de": "Montage"
        },
        "group": "thermal",
        "order": 20,
        "options": {
          "OpenRack": {
            "en": "Open rack",
            "de": "Offenes Gestell"
          },
          "CloseRoof": {
            "en": "Close roof mount",
            "de": "Dachnahe Montage"
          },
          "InsulatedBack": {
            "en": "Insulated back",
            "de": "Rückseitig gedämmt"
          }
        }
      }
    }
  }
}
