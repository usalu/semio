  "_comment": "🎚️ The config state lane of `s.energy.model`'s editor (✏️editor/🎚️config): its mutation vocabulary `EnergyModelConfigMutation` over `EnergyModelConfig`, measured by the plugin bridge on the surface coordinate, claimed by `../../🧪️tests/🎚️mutate-energy-model-1-any-editor-config` and backed by one committed vector per declared outcome class.",
  "oracles": [],
  "noOracleDecisions": [
    {
      "id": "energy-model-1-any-editor-config-state-lane-semantics",
      "capabilities": [
        "energy-model-1-any-editor-config-mutate"
      ],
      "rationale": "`EnergyModelConfigMutation` is the config state lane of `s.energy.model`'s ✏️editor/🎚️config surface: it holds the simulation settings (zone and system timesteps, warm-up days) and the per-surface result field the 3d window colours by. This is this repository's own editor state record, not a published format, so no third party implements it. What is under test is that each kind (`change-simulation-settings`, `change-result-field`) changes exactly its own part of `EnergyModelConfig`, that a kind declaring `no-op` leaves a record that already holds its value untouched with a warned `mutation.no-op`, and that every kind's computed inverse, read off the pre-mutation record, restores it exactly. Confidence comes from one committed, handcrafted (before, mutation, after, diff, outcome) vector per kind and declared outcome class under `../🧫️fixtures/`, exercised end to end through the production dispatch bridge, and from the inverse law as a metamorphic property.",
      "substitutes": [
        "specification-vectors",
        "metamorphic-laws"
      ],
      "coversMutations": true,
      "referenceSurvey": {
        "ecosystemsSearched": [
          "npm",
          "crates.io"
        ],
        "candidatesConsidered": [
          {
            "package": "electron-store",
            "ecosystem": "npm",
            "verdict": "cannot-express-the-mutation",
            "reason": "A persisted key-value store for desktop settings; it has no model of this surface's typed config record, its per-kind setters, their no-op guard or the inverse each kind computes."
          },
          {
            "package": "confy",
            "ecosystem": "crates.io",
            "verdict": "cannot-express-the-mutation",
            "reason": "Loads and stores a whole configuration struct on disk; it defines no typed config mutations and neither their no-op nor their inverse behaviour."
          }
        ],
        "whyNoneQualifies": "`EnergyModelConfig` is a state record defined by this repository with its own typed mutation vocabulary; generic state containers can hold its values but cannot adjudicate what each kind must change, when it is a no-op, or what its inverse is."
      }
    }
  ],
