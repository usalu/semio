{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-pv-system-dc-capacity/schema.json",
  "title": "ChangePvSystemDcCapacity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newDcCapacityW"
  ],
  "properties": {
    "mutation": {
      "const": "changePvSystemDcCapacity"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "PV system",
          "de": "PV-Anlage"
        },
        "description": {
          "en": "The PV system this mutation changes, by id.",
          "de": "PV-Anlage, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "pvSystem"
        },
        "group": "target",
        "order": 10
      }
    },
    "newDcCapacityW": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "DC rated power",
          "de": "DC-Nennleistung"
        },
        "unit": "W",
        "displayUnit": "kWp",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StatePvSystemAssignment",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "pv_systems",
    "field": "dc_capacity_w",
    "input": "new_dc_capacity_w",
    "key": "id",
    "labels": {
      "en": "Change pv system: DC rated power",
      "de": "DC-Nennleistung ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "pv-system",
      "kind": "change-pv-system-dc-capacity",
      "record": "ChangedPvSystemDcCapacity"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "DC rated power violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed pv system does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The pv system already carries this dc rated power value."
      }
    }
  }
}
