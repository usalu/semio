{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-lighting-gain-visible-fraction/schema.json",
  "title": "ChangeLightingGainVisibleFraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newVisibleFraction"
  ],
  "properties": {
    "mutation": {
      "const": "changeLightingGainVisibleFraction"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Lighting gain",
          "de": "Beleuchtungswärmegewinn"
        },
        "description": {
          "en": "The lighting gain this mutation changes, by id.",
          "de": "Beleuchtungswärmegewinn, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "lightingGain",
          "domain": "energyModel",
          "granularity": "load"
        },
        "group": "target",
        "order": 10
      }
    },
    "newVisibleFraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Visible fraction",
          "de": "Sichtbarer Anteil"
        },
        "description": {
          "en": "Share of the lighting power emitted as visible light.",
          "de": "Anteil der Beleuchtungsleistung, der als sichtbares Licht abgegeben wird."
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "softMin": 0,
        "softMax": 1,
        "group": "gains",
        "order": 20
      }
    }
  }
}
