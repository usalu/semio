{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateFault",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "id",
    "targetEquipmentId",
    "faultType",
    "severity",
    "startScheduleId"
  ],
  "properties": {
    "index": {
      "type": "integer"
    },
    "id": {
      "type": "integer"
    },
    "targetEquipmentId": {
      "type": "integer"
    },
    "faultType": {
      "enum": [
        "SensorBias",
        "CoilFouling",
        "DamperStuck",
        "ChillerFouling",
        "BoilerEfficiencyDegradation"
      ]
    },
    "severity": {
      "type": "number"
    },
    "startScheduleId": {
      "type": "integer"
    }
  }
}
