{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-ground-shallow/schema.json",
  "title": "ChangeGroundShallow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "month",
    "newTemperatureC"
  ],
  "properties": {
    "mutation": {
      "const": "changeGroundShallow"
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Month",
          "de": "Monat"
        },
        "description": {
          "en": "Calendar month, 1 = January.",
          "de": "Kalendermonat, 1 = Januar."
        },
        "step": 1,
        "precision": 0,
        "softMin": 1,
        "softMax": 12,
        "group": "ground",
        "order": 10
      }
    },
    "newTemperatureC": {
      "type": "number",
      "minimum": -273.15,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Shallow ground temperature",
          "de": "Oberflächennahe Erdreichtemperatur"
        },
        "description": {
          "en": "Monthly value near the surface.",
          "de": "Monatswert nahe der Oberfläche."
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "softMin": -20,
        "softMax": 40,
        "group": "ground",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "slot-field",
    "scope": "ground_temperature",
    "field": "shallow_c",
    "input": "new_temperature_c",
    "index": "month",
    "slotCount": 12,
    "slotBase": 1,
    "labels": {
      "en": "Change monthly ground temperature",
      "de": "Monatliche oberflächennahe Bodentemperatur ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "ground-temperature",
      "kind": "change-ground-shallow",
      "record": "ChangedMonthlyGroundTemperature"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The original month and finite ground temperature must satisfy their authored limits."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "This original month already carries the requested ground temperature."
      }
    }
  }
}
