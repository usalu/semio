{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/energy/model/config/schema.json",
  "title": "EnergyModelConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneTimestepMinutes",
    "systemTimestepMinutes",
    "warmupDays"
  ],
  "properties": {
    "zoneTimestepMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 60,
      "x-semio-state": "config"
    },
    "systemTimestepMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 60,
      "x-semio-state": "config"
    },
    "warmupDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365,
      "default": 7,
      "x-semio-state": "config"
    }
  }
}
