{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-fenestration-height/schema.json",
  "title": "ChangeFenestrationHeight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newHeightM"
  ],
  "properties": {
    "mutation": {
      "const": "changeFenestrationHeight"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The window this mutation changes, by id.",
          "de": "Fenster, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "fenestration",
          "domain": "energyModel",
          "granularity": "fenestration"
        },
        "group": "target",
        "order": 10
      }
    },
    "newHeightM": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Height",
          "de": "Höhe"
        },
        "unit": "m",
        "step": 0.01,
        "precision": 2,
        "group": "geometry",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateFenestration",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "fenestrations",
    "field": "height_m",
    "input": "new_height_m",
    "key": "id",
    "labels": {
      "en": "Change fenestration: Height",
      "de": "Höhe ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "fenestration",
      "kind": "change-fenestration-height",
      "record": "ChangedFenestrationHeight"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Height violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed fenestration does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The fenestration already carries this height value."
      }
    }
  }
}
