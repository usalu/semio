{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-plant-loop-supply-temperature/schema.json",
  "title": "ChangePlantLoopSupplyTemperature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newSupplyTemperatureC"
  ],
  "properties": {
    "mutation": {
      "const": "changePlantLoopSupplyTemperature"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plant loop",
          "de": "Anlagenkreislauf"
        },
        "description": {
          "en": "The plant loop this mutation changes, by id.",
          "de": "Anlagenkreislauf, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "plantLoop"
        },
        "group": "target",
        "order": 10
      }
    },
    "newSupplyTemperatureC": {
      "type": "number",
      "minimum": -100,
      "maximum": 300,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Supply temperature",
          "de": "Vorlauftemperatur"
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "group": "plant",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StatePlantLoopConfig",
    "branchType": "ModelSystemState",
    "branch": "systems",
    "collection": "plant_loops",
    "field": "supply_temperature_c",
    "input": "new_supply_temperature_c",
    "key": "id",
    "labels": {
      "en": "Change plant loop: Supply temperature",
      "de": "Vorlauftemperatur ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "plant-loop",
      "kind": "change-plant-loop-supply-temperature",
      "record": "ChangedPlantLoopSupplyTemperature"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Supply temperature violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed plant loop does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The plant loop already carries this supply temperature value."
      }
    }
  }
}
