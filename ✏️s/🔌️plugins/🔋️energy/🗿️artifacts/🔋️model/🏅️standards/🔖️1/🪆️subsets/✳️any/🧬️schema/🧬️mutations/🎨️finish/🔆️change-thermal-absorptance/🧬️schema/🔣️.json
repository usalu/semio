{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-material-thermal-absorptance/schema.json",
  "title": "ChangeMaterialThermalAbsorptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newThermalAbsorptance"
  ],
  "properties": {
    "mutation": {
      "const": "changeMaterialThermalAbsorptance"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Material",
          "de": "Material"
        },
        "description": {
          "en": "The material this mutation changes, by id.",
          "de": "Material, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "material",
          "domain": "energyModel",
          "granularity": "material"
        },
        "group": "target",
        "order": 10
      }
    },
    "newThermalAbsorptance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Thermal absorptance",
          "de": "Thermischer Absorptionsgrad"
        },
        "description": {
          "en": "Long-wave absorptance, equal to the emissivity.",
          "de": "Langwelliger Absorptionsgrad, gleich dem Emissionsgrad."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "optics",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "materials",
    "field": "thermal_absorptance",
    "input": "new_thermal_absorptance",
    "key": "id",
    "labels": {
      "en": "Change material: Thermal absorptance",
      "de": "Thermischer Absorptionsgrad ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "material",
      "kind": "change-material-thermal-absorptance",
      "record": "ChangedMaterialThermalAbsorptance"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Thermal absorptance violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed material does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The material already carries this thermal absorptance value."
      }
    }
  }
}
