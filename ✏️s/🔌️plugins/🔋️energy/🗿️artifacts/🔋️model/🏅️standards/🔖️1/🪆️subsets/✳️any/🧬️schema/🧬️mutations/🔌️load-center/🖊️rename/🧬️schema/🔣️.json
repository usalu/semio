{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/rename-electrical-load-center/schema.json",
  "title": "RenameElectricalLoadCenter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newName"
  ],
  "properties": {
    "mutation": {
      "const": "renameElectricalLoadCenter"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Electrical load center",
          "de": "Stromverteiler"
        },
        "description": {
          "en": "The electrical load center to rename, by id.",
          "de": "Stromverteiler, den diese Mutation umbenennt, per ID."
        },
        "ref": {
          "kind": "electricalLoadCenter"
        },
        "group": "target",
        "order": 10
      }
    },
    "newName": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 20
      },
      "minLength": 1
    }
  },
  "x-semio-energy-operation": {
    "category": "name-row",
    "row": "StateElectricalLoadCenter",
    "branchType": "ModelSystemState",
    "branch": "systems",
    "collection": "electrical_load_centers",
    "field": "name",
    "input": "new_name",
    "key": "id",
    "unique": true,
    "labels": {
      "en": "Rename electrical load center",
      "de": "Elektrische Lastzentrale umbenennen"
    },
    "semantics": {
      "verb": "rename",
      "entity": "electrical-load-center",
      "kind": "rename-electrical-load-center",
      "record": "RenamedElectricalLoadCenter"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A electrical load center name must not be blank."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "Another electrical load center already has this name."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed electrical load center does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The electrical load center already has this name."
      }
    }
  }
}
