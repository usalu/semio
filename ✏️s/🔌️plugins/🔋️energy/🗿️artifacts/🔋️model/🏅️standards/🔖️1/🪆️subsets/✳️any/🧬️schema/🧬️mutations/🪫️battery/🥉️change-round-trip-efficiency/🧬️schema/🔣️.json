{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-battery-round-trip-efficiency/schema.json",
  "title": "ChangeBatteryRoundTripEfficiency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newRoundTripEfficiency"
  ],
  "properties": {
    "mutation": {
      "const": "changeBatteryRoundTripEfficiency"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Battery",
          "de": "Batterie"
        },
        "description": {
          "en": "The battery this mutation changes, by id.",
          "de": "Batterie, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "battery"
        },
        "group": "target",
        "order": 10
      }
    },
    "newRoundTripEfficiency": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Round-trip efficiency",
          "de": "Zyklenwirkungsgrad"
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.001,
        "precision": 1,
        "softMin": 0.001,
        "softMax": 1,
        "group": "efficiency",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateBatteryAssignment",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "battery_storage",
    "field": "round_trip_efficiency",
    "input": "new_round_trip_efficiency",
    "key": "id",
    "labels": {
      "en": "Change battery: Round-trip efficiency",
      "de": "Zyklenwirkungsgrad ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "battery",
      "kind": "change-battery-round-trip-efficiency",
      "record": "ChangedBatteryRoundTripEfficiency"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Round-trip efficiency violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed battery does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The battery already carries this round-trip efficiency value."
      }
    }
