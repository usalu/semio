{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/reorder-construction-layers/schema.json",
  "title": "ReorderConstructionLayers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newLayerMaterialIds"
  ],
  "properties": {
    "mutation": {
      "const": "reorderConstructionLayers"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Construction",
          "de": "Konstruktion"
        },
        "description": {
          "en": "The construction this mutation changes, by id.",
          "de": "Konstruktion, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "construction",
          "domain": "energyModel",
          "granularity": "construction"
        },
        "group": "target",
        "order": 10
      }
    },
    "newLayerMaterialIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Layers",
          "de": "Schichten"
        },
        "description": {
          "en": "The same layer materials in their new order by id, outside layer first.",
          "de": "Dieselben Schichtmaterialien in neuer Reihenfolge per ID, äußere Schicht zuerst."
        },
        "ref": {
          "kind": [
            "material",
            "glazingMaterial",
            "gasMaterial"
          ],
          "domain": "energyModel"
        },
        "group": "construction",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "owned-row",
    "row": "StateConstruction",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "constructions",
    "field": "layer_material_ids",
    "input": "new_layer_material_ids",
    "key": "id",
    "validation": "permutation",
    "labels": {
      "en": "Reorder construction layers",
      "de": "Bauteilschichten umordnen"
    },
    "semantics": {
      "verb": "reorder",
      "entity": "construction-layer",
      "kind": "reorder-layers",
      "record": "ReorderedConstructionLayers"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored layer order is not valid."
      },
      "context": {
        "level": "error",
        "code": "mutation.target-mismatch",
        "message": "Layers can be reordered while preserving the exact original material multiset."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed construction does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "This construction already holds its layers in that order."
      }
    }
  }
}
