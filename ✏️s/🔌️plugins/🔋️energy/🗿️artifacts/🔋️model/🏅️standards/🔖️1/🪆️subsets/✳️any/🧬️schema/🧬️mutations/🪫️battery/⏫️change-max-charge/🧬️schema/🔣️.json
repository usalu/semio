{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-battery-max-charge/schema.json",
  "title": "ChangeBatteryMaxCharge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newMaxChargeW"
  ],
  "properties": {
    "mutation": {
      "const": "changeBatteryMaxCharge"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Battery",
          "de": "Batterie"
        },
        "description": {
          "en": "The battery this mutation changes, by id.",
          "de": "Batterie, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "battery"
        },
        "group": "target",
        "order": 10
      }
    },
    "newMaxChargeW": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Maximum charge power",
          "de": "Maximale Ladeleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateBatteryAssignment",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "battery_storage",
    "field": "max_charge_w",
    "input": "new_max_charge_w",
    "key": "id",
    "labels": {
      "en": "Change battery: Maximum charge power",
      "de": "Maximale Ladeleistung ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "battery",
      "kind": "change-battery-max-charge",
      "record": "ChangedBatteryMaxCharge"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Maximum charge power violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed battery does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The battery already carries this maximum charge power value."
      }
    }
  }
}
