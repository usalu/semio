{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-lighting-gain-return-air-fraction/schema.json",
  "title": "ChangeLightingGainReturnAirFraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newReturnAirFraction"
  ],
  "properties": {
    "mutation": {
      "const": "changeLightingGainReturnAirFraction"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Lighting gain",
          "de": "Beleuchtungswärmegewinn"
        },
        "description": {
          "en": "The lighting gain this mutation changes, by id.",
          "de": "Beleuchtungswärmegewinn, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "lightingGain",
          "domain": "energyModel",
          "granularity": "load"
        },
        "group": "target",
        "order": 10
      }
    },
    "newReturnAirFraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Return-air fraction",
          "de": "Rückluftanteil"
        },
        "description": {
          "en": "Share of the lighting heat carried off by the return air.",
          "de": "Anteil der Beleuchtungswärme, der mit der Rückluft abgeführt wird."
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "softMin": 0,
        "softMax": 1,
        "group": "gains",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateLightingGain",
    "branchType": "ModelLoadState",
    "branch": "loads",
    "collection": "lighting",
    "field": "return_air_fraction",
    "input": "new_return_air_fraction",
    "key": "id",
    "labels": {
      "en": "Change lighting gain: Return-air fraction",
      "de": "Rückluftanteil ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "lighting-gain",
      "kind": "change-lighting-gain-return-air-fraction",
      "record": "ChangedLightingGainReturnAirFraction"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Return-air fraction violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed lighting gain does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The lighting gain already carries this return-air fraction value."
      }
    }
  }
}
