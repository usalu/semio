{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-run-start-day/schema.json",
  "title": "ChangeRunStartDay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newStartDay"
  ],
  "properties": {
    "mutation": {
      "const": "changeRunStartDay"
    },
    "newStartDay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Start day",
          "de": "Starttag"
        },
        "step": 1,
        "precision": 0,
        "softMin": 1,
        "softMax": 31,
        "group": "calendar",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-field",
    "scope": "run_period",
    "field": "start_day",
    "input": "new_start_day",
    "labels": {
      "en": "Change start day",
      "de": "Starttag ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "run",
      "kind": "change-run-start-day",
      "record": "ChangedRunStartDay"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored start day is outside its admissible range."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The start day is unchanged."
      },
      "context": {
        "level": "error",
        "code": "mutation.target-mismatch",
        "message": "The authored value does not form a valid calendar interval."
      }
    },
    "calendarInterval": true
  }
}
