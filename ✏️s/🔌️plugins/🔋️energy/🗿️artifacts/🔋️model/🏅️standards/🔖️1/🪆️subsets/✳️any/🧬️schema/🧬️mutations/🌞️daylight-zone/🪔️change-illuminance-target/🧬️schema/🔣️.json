{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-daylight-zone-illuminance-target/schema.json",
  "title": "ChangeDaylightZoneIlluminanceTarget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newIlluminanceTargetLux"
  ],
  "properties": {
    "mutation": {
      "const": "changeDaylightZoneIlluminanceTarget"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Daylight zone",
          "de": "Tageslichtzone"
        },
        "description": {
          "en": "The daylight zone this mutation changes, by id.",
          "de": "Tageslichtzone, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "daylightZone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newIlluminanceTargetLux": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Illuminance target",
          "de": "Soll-Beleuchtungsstärke"
        },
        "unit": "lx",
        "step": 10,
        "precision": 0,
        "group": "daylight",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateDaylightZoneConfig",
    "branchType": "ModelLoadState",
    "branch": "loads",
    "collection": "daylight_zones",
    "field": "illuminance_target_lux",
    "input": "new_illuminance_target_lux",
    "key": "id",
    "labels": {
      "en": "Change daylight zone: Illuminance target",
      "de": "Soll-Beleuchtungsstärke ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "daylight-zone",
      "kind": "change-daylight-zone-illuminance-target",
      "record": "ChangedDaylightZoneIlluminanceTarget"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Illuminance target violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed daylight zone does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The daylight zone already carries this illuminance target value."
      }
    }
  }
}
