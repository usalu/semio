{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/rename-thermal-enclosure/schema.json",
  "title": "RenameThermalEnclosure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newName"
  ],
  "properties": {
    "mutation": {
      "const": "renameThermalEnclosure"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Thermal enclosure",
          "de": "Zonenverbund"
        },
        "description": {
          "en": "The thermal enclosure to rename, by id.",
          "de": "Zonenverbund, den diese Mutation umbenennt, per ID."
        },
        "ref": {
          "kind": "thermalEnclosure"
        },
        "group": "target",
        "order": 10
      }
    },
    "newName": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 20
      },
      "minLength": 1
    }
  },
  "x-semio-energy-operation": {
    "category": "name-row",
    "row": "StateThermalEnclosure",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "thermal_enclosures",
    "field": "name",
    "input": "new_name",
    "key": "id",
    "unique": true,
    "labels": {
      "en": "Rename thermal enclosure",
      "de": "Thermische Hülle umbenennen"
    },
    "semantics": {
      "verb": "rename",
      "entity": "thermal-enclosure",
      "kind": "rename-thermal-enclosure",
      "record": "RenamedThermalEnclosure"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A thermal enclosure name must not be blank."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "Another thermal enclosure already has this name."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed thermal enclosure does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The thermal enclosure already has this name."
      }
    }
  }
}
