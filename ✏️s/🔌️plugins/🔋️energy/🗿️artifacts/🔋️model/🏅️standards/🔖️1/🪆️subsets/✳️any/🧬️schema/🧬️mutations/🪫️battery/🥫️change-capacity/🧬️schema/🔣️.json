{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-battery-capacity/schema.json",
  "title": "ChangeBatteryCapacity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newCapacityKwh"
  ],
  "properties": {
    "mutation": {
      "const": "changeBatteryCapacity"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Battery",
          "de": "Batterie"
        },
        "description": {
          "en": "The battery this mutation changes, by id.",
          "de": "Batterie, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "battery"
        },
        "group": "target",
        "order": 10
      }
    },
    "newCapacityKwh": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Storage capacity",
          "de": "Speicherkapazität"
        },
        "unit": "kWh",
        "step": 0.5,
        "precision": 1,
        "group": "capacity",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateBatteryAssignment",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "battery_storage",
    "field": "capacity_kwh",
    "input": "new_capacity_kwh",
    "key": "id",
    "labels": {
      "en": "Change battery: Storage capacity",
      "de": "Speicherkapazität ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "battery",
      "kind": "change-battery-capacity",
      "record": "ChangedBatteryCapacity"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Storage capacity violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed battery does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The battery already carries this storage capacity value."
      }
    }
  }
}
