{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-gas-material-gas/schema.json",
  "title": "ChangeGasMaterialGas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newGas"
  ],
  "properties": {
    "mutation": {
      "const": "changeGasMaterialGas"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Gas gap",
          "de": "Gasfüllung"
        },
        "description": {
          "en": "The gas gap this mutation changes, by id.",
          "de": "Gasfüllung, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "gasMaterial",
          "domain": "energyModel",
          "granularity": "gasMaterial"
        },
        "group": "target",
        "order": 10
      }
    },
    "newGas": {
      "enum": [
        "Air",
        "Argon",
        "Krypton",
        "Xenon"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Fill gas",
          "de": "Füllgas"
        },
        "options": {
          "Air": {
            "en": "Air",
            "de": "Luft"
          },
          "Argon": {
            "en": "Argon",
            "de": "Argon"
          },
          "Krypton": {
            "en": "Krypton",
            "de": "Krypton"
          },
          "Xenon": {
            "en": "Xenon",
            "de": "Xenon"
          }
        },
        "group": "thermal",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "enum-row",
    "row": "StateGasMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "gas_materials",
    "field": "gas",
    "input": "new_gas",
    "key": "id",
    "labels": {
      "en": "Change gas material: Fill gas",
      "de": "Füllgas ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "gas-material",
      "kind": "change-gas-material-gas",
      "record": "ChangedGasMaterialGas"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Fill gas violates its authored choices."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed gas material does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The gas material already carries this fill gas value."
      }
    }
  }
}
