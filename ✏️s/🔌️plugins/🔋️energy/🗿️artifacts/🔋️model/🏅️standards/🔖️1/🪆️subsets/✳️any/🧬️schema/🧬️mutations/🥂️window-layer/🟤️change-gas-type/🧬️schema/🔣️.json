{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-gas-material-gas/schema.json",
  "title": "ChangeGasMaterialGas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newGas"
  ],
  "properties": {
    "mutation": {
      "const": "changeGasMaterialGas"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Gas gap",
          "de": "Gasfüllung"
        },
        "description": {
          "en": "The gas gap this mutation changes, by id.",
          "de": "Gasfüllung, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "gasMaterial",
          "domain": "energyModel",
          "granularity": "gasMaterial"
        },
        "group": "target",
        "order": 10
      }
    },
    "newGas": {
      "enum": [
        "Air",
        "Argon",
        "Krypton",
        "Xenon"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Fill gas",
          "de": "Füllgas"
        },
        "options": {
          "Air": {
            "en": "Air",
            "de": "Luft"
          },
          "Argon": {
            "en": "Argon",
            "de": "Argon"
          },
          "Krypton": {
            "en": "Krypton",
            "de": "Krypton"
          },
          "Xenon": {
            "en": "Xenon",
            "de": "Xenon"
          }
        },
        "group": "thermal",
        "order": 20
      }
    }
  }
}
