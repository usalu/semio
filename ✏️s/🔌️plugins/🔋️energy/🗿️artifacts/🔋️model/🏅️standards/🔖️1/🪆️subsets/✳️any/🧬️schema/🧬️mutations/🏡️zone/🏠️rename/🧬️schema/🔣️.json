{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/rename-zone/schema.json",
  "title": "RenameZone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newName"
  ],
  "properties": {
    "mutation": {
      "const": "renameZone"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The zone to rename, by id.",
          "de": "Zone, die diese Mutation umbenennt, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newName": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 20
      },
      "minLength": 1
    }
  },
  "x-semio-energy-operation": {
    "category": "name-row",
    "row": "StateZone",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "zones",
    "field": "name",
    "input": "new_name",
    "key": "id",
    "unique": true,
    "labels": {
      "en": "Rename zone",
      "de": "Zone umbenennen"
    },
    "semantics": {
      "verb": "rename",
      "entity": "zone",
      "kind": "rename-zone",
      "record": "RenamedZone"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A zone name must not be blank."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "Another zone already has this name."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed zone does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The zone already has this name."
      }
    }
  }
}
