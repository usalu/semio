{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-people-gain-radiant-fraction/schema.json",
  "title": "ChangePeopleGainRadiantFraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newRadiantFraction"
  ],
  "properties": {
    "mutation": {
      "const": "changePeopleGainRadiantFraction"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "People gain",
          "de": "Personenwärmegewinn"
        },
        "description": {
          "en": "The people gain this mutation changes, by id.",
          "de": "Personenwärmegewinn, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "peopleGain",
          "domain": "energyModel",
          "granularity": "load"
        },
        "group": "target",
        "order": 10
      }
    },
    "newRadiantFraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Radiant fraction",
          "de": "Strahlungsanteil"
        },
        "description": {
          "en": "Share of the heat output released as long-wave radiation.",
          "de": "Anteil der Wärmeabgabe als langwellige Strahlung."
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "softMin": 0,
        "softMax": 1,
        "group": "gains",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StatePeopleGain",
    "branchType": "ModelLoadState",
    "branch": "loads",
    "collection": "people",
    "field": "radiant_fraction",
    "input": "new_radiant_fraction",
    "key": "id",
    "labels": {
      "en": "Change people gain: Radiant fraction",
      "de": "Strahlungsanteil ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "people-gain",
      "kind": "change-people-gain-radiant-fraction",
      "record": "ChangedPeopleGainRadiantFraction"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Radiant fraction violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed people gain does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The people gain already carries this radiant fraction value."
      }
    }
  }
}
