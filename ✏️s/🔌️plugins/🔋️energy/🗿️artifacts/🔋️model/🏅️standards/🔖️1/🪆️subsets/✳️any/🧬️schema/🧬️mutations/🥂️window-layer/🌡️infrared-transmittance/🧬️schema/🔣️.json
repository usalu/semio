{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-glazing-material-infrared-transmittance/schema.json",
  "title": "ChangeGlazingMaterialInfraredTransmittance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newInfraredTransmittance"
  ],
  "properties": {
    "mutation": {
      "const": "changeGlazingMaterialInfraredTransmittance"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Glazing material",
          "de": "Verglasungsmaterial"
        },
        "description": {
          "en": "The glazing material this mutation changes, by id.",
          "de": "Verglasungsmaterial, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "glazingMaterial",
          "domain": "energyModel",
          "granularity": "glazingMaterial"
        },
        "group": "target",
        "order": 10
      }
    },
    "newInfraredTransmittance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Infrared transmittance",
          "de": "Infraroter Transmissionsgrad"
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "optics",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateGlazingMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "glazing_materials",
    "field": "infrared_transmittance",
    "input": "new_infrared_transmittance",
    "key": "id",
    "labels": {
      "en": "Infrared transmittance",
      "de": "Infraroter Transmissionsgrad"
    },
    "semantics": {
      "verb": "change",
      "entity": "glazing-material",
      "kind": "change-glazing-material-infrared-transmittance",
      "record": "ChangedGlazingMaterialInfraredTransmittance"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "An optical fraction must be finite and lie in 0..=1."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed glazing material does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The optical field already has this value."
      }
    }
  }
}
