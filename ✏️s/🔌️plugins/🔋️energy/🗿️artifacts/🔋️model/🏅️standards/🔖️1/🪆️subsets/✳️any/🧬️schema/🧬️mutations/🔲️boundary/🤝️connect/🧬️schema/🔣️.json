{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/connect-surfaces/schema.json",
  "title": "ConnectSurfaces",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "surfaceAId",
    "surfaceBId"
  ],
  "properties": {
    "mutation": {
      "const": "connectSurfaces"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; empty appends (or keeps id order).",
          "de": "Einfügeposition in der Modellliste; leer hängt an (oder behält die ID-Reihenfolge)."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 5
      }
    },
    "surfaceAId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Surface A",
          "de": "Oberfläche A"
        },
        "description": {
          "en": "First surface of the adjacency pair, by id.",
          "de": "Erste Oberfläche des Nachbarschaftspaars, per ID."
        },
        "ref": {
          "kind": "surface",
          "domain": "energyModel",
          "granularity": "surface"
        },
        "group": "assignment",
        "order": 10
      }
    },
    "surfaceBId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Surface B",
          "de": "Oberfläche B"
        },
        "description": {
          "en": "Second surface of the adjacency pair, by id.",
          "de": "Zweite Oberfläche des Nachbarschaftspaars, per ID."
        },
        "ref": {
          "kind": "surface",
          "domain": "energyModel",
          "granularity": "surface"
        },
        "group": "assignment",
        "order": 20
      }
    }
  },
  "x-semio-invariant": [
    {
      "id": "distinct-surfaces",
      "description": {
        "en": "Surface A and surface B are two different surfaces.",
        "de": "Oberfläche A und Oberfläche B sind zwei verschiedene Oberflächen."
      }
    }
  ]
}
