{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-glazing-material-conductivity/schema.json",
  "title": "ChangeGlazingMaterialConductivity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newConductivityWMK"
  ],
  "properties": {
    "mutation": {
      "const": "changeGlazingMaterialConductivity"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Glazing material",
          "de": "Verglasungsmaterial"
        },
        "description": {
          "en": "The glazing material this mutation changes, by id.",
          "de": "Verglasungsmaterial, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "glazingMaterial",
          "domain": "energyModel",
          "granularity": "glazingMaterial"
        },
        "group": "target",
        "order": 10
      }
    },
    "newConductivityWMK": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Thermal conductivity",
          "de": "Wärmeleitfähigkeit"
        },
        "unit": "W/(m·K)",
        "step": 0.001,
        "precision": 3,
        "group": "thermal",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateGlazingMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "glazing_materials",
    "field": "conductivity_w_m_k",
    "input": "new_conductivity_w_m_k",
    "key": "id",
    "labels": {
      "en": "Change glazing material: Thermal conductivity",
      "de": "Wärmeleitfähigkeit ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "glazing-material",
      "kind": "change-glazing-material-conductivity",
      "record": "ChangedGlazingMaterialConductivity"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Thermal conductivity violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed glazing material does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The glazing material already carries this thermal conductivity value."
      }
    }
  }
}
