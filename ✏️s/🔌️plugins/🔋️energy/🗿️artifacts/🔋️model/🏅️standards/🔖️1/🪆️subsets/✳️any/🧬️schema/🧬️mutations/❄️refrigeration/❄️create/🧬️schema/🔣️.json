{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-refrigeration-system/schema.json",
  "title": "CreateRefrigerationSystem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "caseCount",
    "designLoadW",
    "defrostScheduleId"
  ],
  "properties": {
    "mutation": {
      "const": "createRefrigerationSystem"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new refrigeration system is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "caseCount": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Display cases",
          "de": "Anzahl Kühlmöbel"
        },
        "step": 1,
        "precision": 0,
        "group": "capacity",
        "order": 30
      }
    },
    "designLoadW": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Design load",
          "de": "Auslegungslast"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 40
      },
      "exclusiveMinimum": 0
    },
    "defrostScheduleId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Defrost schedule",
          "de": "Abtauzeitplan"
        },
        "description": {
          "en": "When the display cases defrost, by id.",
          "de": "Wann die Kühlmöbel abtauen, per ID."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 50
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateRefrigerationConfig",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "case_count",
        "input": "case_count",
        "storage": "fixed"
      },
      {
        "field": "design_load_w",
        "input": "design_load_w",
        "storage": "fixed"
      },
      {
        "field": "defrost_schedule_id",
        "input": "defrost_schedule_id",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateRefrigerationConfig",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "refrigeration_systems",
    "key": "id",
    "inverse": "DeleteRefrigerationSystem",
    "labels": {
      "en": "Create Refrigeration System at index",
      "de": "Kälteanlage an Index erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "refrigeration-system",
      "kind": "create-refrigeration-system",
      "record": "CreatedRefrigerationSystem"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored row violates its declared field bounds."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "An object with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The authored insertion rank is past the end of the collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The creation makes no change."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The original referenced entity does not exist."
      }
    },
    "validationBeforeRank": false,
    "rules": [
      {
        "input": "defrost_schedule_id",
        "kind": "reference",
        "storage": "direct",
        "collections": [
          "ConstantSchedules",
          "DailySchedules",
          "WeeklySchedules",
          "AnnualSchedules",
          "TimeSeriesSchedules"
        ],
        "target": "input"
      }
    ],
    "defaultRank": "explicit",
    "scalarOrder": "after-rules"
  }
}
