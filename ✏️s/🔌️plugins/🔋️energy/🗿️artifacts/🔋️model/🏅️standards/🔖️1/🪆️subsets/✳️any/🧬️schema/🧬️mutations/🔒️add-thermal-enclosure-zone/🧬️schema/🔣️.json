        },
        "ref": {
          "kind": "thermalEnclosure"
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the member list; 0 is first.",
          "de": "Einfügeposition in der Mitgliederliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 20
      }
    },
    "zoneId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "Zone to add, by id.",
          "de": "Hinzuzufügende Zone, per ID."
