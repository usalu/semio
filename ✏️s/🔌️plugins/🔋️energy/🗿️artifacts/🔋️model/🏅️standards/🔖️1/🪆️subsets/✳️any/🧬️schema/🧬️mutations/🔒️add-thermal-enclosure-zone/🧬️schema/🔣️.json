{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/add-thermal-enclosure-zone/schema.json",
  "title": "AddThermalEnclosureZone",
  "type": "object",
  "additionalProperties": false,
  "required": [
