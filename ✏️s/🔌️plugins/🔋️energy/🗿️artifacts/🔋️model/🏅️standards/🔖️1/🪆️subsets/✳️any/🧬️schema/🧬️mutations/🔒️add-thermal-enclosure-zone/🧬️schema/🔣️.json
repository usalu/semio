    "id",
    "index",
    "zoneId"
  ],
  "properties": {
    "mutation": {
      "const": "addThermalEnclosureZone"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Thermal enclosure",
          "de": "Zonenverbund"
        },
        "description": {
          "en": "The thermal enclosure this mutation changes, by id.",
