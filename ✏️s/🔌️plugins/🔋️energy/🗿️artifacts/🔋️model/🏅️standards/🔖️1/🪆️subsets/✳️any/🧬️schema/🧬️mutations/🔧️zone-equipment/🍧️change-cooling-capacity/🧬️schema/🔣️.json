{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-zone-equipment-cooling-capacity/schema.json",
  "title": "ChangeZoneEquipmentCoolingCapacity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newCoolingCapacityW"
  ],
  "properties": {
    "mutation": {
      "const": "changeZoneEquipmentCoolingCapacity"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone equipment",
          "de": "Zonengerät"
        },
        "description": {
          "en": "The zone equipment this mutation changes, by id.",
          "de": "Zonengerät, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "zoneEquipment"
        },
        "group": "target",
        "order": 10
      }
    },
    "newCoolingCapacityW": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Cooling capacity",
          "de": "Kühlleistung"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateZoneEquipmentAssignment",
    "branchType": "ModelControlState",
    "branch": "controls",
    "collection": "zone_equipment",
    "field": "cooling_capacity_w",
    "input": "new_cooling_capacity_w",
    "key": "id",
    "labels": {
      "en": "Change zone equipment: Cooling capacity",
      "de": "Kühlleistung ändern"
