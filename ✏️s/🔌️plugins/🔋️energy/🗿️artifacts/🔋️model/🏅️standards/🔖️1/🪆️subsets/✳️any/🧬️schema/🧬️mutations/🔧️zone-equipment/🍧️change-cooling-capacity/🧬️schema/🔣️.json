    "semantics": {
      "verb": "change",
      "entity": "zone-equipment",
      "kind": "change-zone-equipment-cooling-capacity",
      "record": "ChangedZoneEquipmentCoolingCapacity"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Cooling capacity violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed zone equipment does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The zone equipment already carries this cooling capacity value."
      }
    }
