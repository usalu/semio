{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-refrigeration-system-design-load/schema.json",
  "title": "ChangeRefrigerationSystemDesignLoad",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newDesignLoadW"
  ],
  "properties": {
    "mutation": {
      "const": "changeRefrigerationSystemDesignLoad"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Refrigeration system",
          "de": "Kälteanlage"
        },
        "description": {
          "en": "The refrigeration system this mutation changes, by id.",
          "de": "Kälteanlage, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "refrigerationSystem"
        },
        "group": "target",
        "order": 10
      }
    },
    "newDesignLoadW": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Design load",
          "de": "Auslegungslast"
        },
        "unit": "W",
        "displayUnit": "kW",
        "displayFactor": 0.001,
        "step": 100,
        "precision": 2,
        "group": "capacity",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateRefrigerationConfig",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "refrigeration_systems",
    "field": "design_load_w",
    "input": "new_design_load_w",
    "key": "id",
    "labels": {
      "en": "Change refrigeration system: Design load",
      "de": "Auslegungslast ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "refrigeration-system",
      "kind": "change-refrigeration-system-design-load",
      "record": "ChangedRefrigerationSystemDesignLoad"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Design load violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed refrigeration system does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The refrigeration system already carries this design load value."
      }
    }
  }
