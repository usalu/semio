{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/energy/model/inference.json",
  "title": "EnergyModelInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "$ref": "#/$defs/EnergyModelEntries",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "EnergyModelEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryCount",
        "byteSize",
        "contentDigest"
      ],
      "properties": {
        "entryCount": {
          "type": "integer"
        },
        "byteSize": {
          "type": "integer"
        },
        "contentDigest": {
          "type": "string"
        }
      }
    }
  }
}
