  "$defs": {
    "RenameModel": {
      "title": "RenameModel",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "newName"
      ],
      "properties": {
        "mutation": {
          "const": "rename-model"
        },
        "newName": {
          "type": "string"
        }
      }
    },
    "ChangeModelVersion": {
      "title": "ChangeModelVersion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "newVersion"
      ],
      "properties": {
        "mutation": {
          "const": "change-model-version"
        },
        "newVersion": {
          "type": "string"
        }
      }
    },
    "UpdateSite": {
      "title": "UpdateSite",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "latitudeDeg",
        "longitudeDeg",
        "elevationM",
        "timeZoneHours",
        "northAxisDeg"
      ],
      "properties": {
        "mutation": {
          "const": "update-site"
        },
        "latitudeDeg": {
          "type": "number"
        },
        "longitudeDeg": {
          "type": "number"
        },
        "elevationM": {
          "type": "number"
        },
        "timeZoneHours": {
          "type": "number"
        },
        "northAxisDeg": {
          "type": "number"
        }
      }
    },
    "UpdateGroundTemperature": {
      "title": "UpdateGroundTemperature",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "buildingSurfaceC",
        "shallowC",
        "deepC"
      ],
      "properties": {
        "mutation": {
          "const": "update-ground-temperature"
        },
        "buildingSurfaceC": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "shallowC": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "deepC": {
          "type": "number"
        }
      }
    },
    "UpdateRunPeriod": {
      "title": "UpdateRunPeriod",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "startMonth",
        "startDay",
        "endMonth",
        "endDay",
        "year"
      ],
      "properties": {
        "mutation": {
          "const": "update-run-period"
        },
        "startMonth": {
          "type": "integer"
        },
        "startDay": {
          "type": "integer"
        },
        "endMonth": {
          "type": "integer"
        },
        "endDay": {
          "type": "integer"
        },
        "year": {
          "type": "integer"
        }
      }
    },
    "ReplaceAirflowNetwork": {
      "title": "ReplaceAirflowNetwork",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "present",
        "zoneIds",
        "nodeIds",
        "outdoorNodeId",
        "linkIds"
      ],
      "properties": {
        "mutation": {
          "const": "replace-airflow-network"
