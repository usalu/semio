    },
    {
      "$ref": "#/$defs/UpdateSite"
    },
    {
      "$ref": "#/$defs/UpdateGroundTemperature"
    },
    {
      "$ref": "#/$defs/UpdateRunPeriod"
    },
    {
      "$ref": "#/$defs/ReplaceAirflowNetwork"
    },
    {
      "$ref": "#/$defs/AddOutputVariable"
    },
    {
      "$ref": "#/$defs/RemoveOutputVariable"
    },
    {
      "$ref": "#/$defs/BindWeatherFile"
    },
    {
      "$ref": "#/$defs/UnbindWeatherFile"
    },
    {
      "$ref": "#/$defs/ConnectReferencedModel"
    },
    {
      "$ref": "#/$defs/DisconnectReferencedModel"
    },
    {
      "$ref": "#/$defs/RenameZone"
    },
    {
      "$ref": "#/$defs/ChangeZoneVolume"
    },
    {
      "$ref": "#/$defs/ChangeZoneMultiplier"
    },
    {
