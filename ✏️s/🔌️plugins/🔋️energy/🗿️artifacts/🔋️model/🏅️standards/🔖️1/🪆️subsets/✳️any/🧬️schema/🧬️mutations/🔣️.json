      "title": "ChangeZoneMultiplier",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "id",
        "newMultiplier"
      ],
      "properties": {
        "mutation": {
          "const": "change-zone-multiplier"
        },
        "id": {
          "type": "integer"
        },
