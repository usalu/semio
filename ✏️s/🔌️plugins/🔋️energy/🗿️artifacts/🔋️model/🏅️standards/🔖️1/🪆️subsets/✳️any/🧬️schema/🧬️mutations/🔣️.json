        "targetUri": {
          "type": "string"
        }
      }
    },
    "DisconnectReferencedModel": {
      "title": "DisconnectReferencedModel",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation"
      ],
      "properties": {
        "mutation": {
          "const": "disconnect-referenced-model"
        }
      }
    },
