        "present": {
          "type": "boolean"
        },
        "zoneIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "outdoorNodeId": {
          "type": "integer"
        },
        "linkIds": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "AddOutputVariable": {
      "title": "AddOutputVariable",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "name",
        "key",
        "reportingFrequency"
      ],
      "properties": {
        "mutation": {
          "const": "add-output-variable"
        },
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "reportingFrequency": {
          "enum": [
            "Timestep",
            "Hourly",
            "Daily",
            "Monthly",
            "RunPeriod"
          ]
        }
      }
    },
    "RemoveOutputVariable": {
      "title": "RemoveOutputVariable",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "name",
