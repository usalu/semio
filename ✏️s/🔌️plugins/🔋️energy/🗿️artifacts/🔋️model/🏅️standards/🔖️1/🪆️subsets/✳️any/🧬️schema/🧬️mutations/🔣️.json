      "title": "RenameZone",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "id",
        "newName"
      ],
      "properties": {
        "mutation": {
          "const": "rename-zone"
        },
        "id": {
          "type": "integer"
        },
        "newName": {
          "type": "string"
        }
      }
    },
    "ChangeZoneVolume": {
      "title": "ChangeZoneVolume",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "id",
        "newVolumeM3"
