      }
    },
    "UnbindWeatherFile": {
      "title": "UnbindWeatherFile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation"
      ],
      "properties": {
        "mutation": {
          "const": "unbind-weather-file"
        }
      }
    },
