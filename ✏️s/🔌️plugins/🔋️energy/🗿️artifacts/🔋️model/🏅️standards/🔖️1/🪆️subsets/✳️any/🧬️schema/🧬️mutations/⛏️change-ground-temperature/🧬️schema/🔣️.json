{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-ground-temperature-deep/schema.json",
  "title": "ChangeGroundTemperatureDeep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newTemperatureC"
  ],
  "properties": {
    "mutation": {
      "const": "changeGroundTemperatureDeep"
    },
    "newTemperatureC": {
      "type": "number",
      "minimum": -273.15,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Deep ground temperature",
          "de": "Erdreichtemperatur in der Tiefe"
        },
        "description": {
          "en": "Constant over the year.",
          "de": "Über das Jahr konstant."
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "softMin": -20,
        "softMax": 40,
        "group": "ground",
        "order": 10
      }
    }
  }
}
