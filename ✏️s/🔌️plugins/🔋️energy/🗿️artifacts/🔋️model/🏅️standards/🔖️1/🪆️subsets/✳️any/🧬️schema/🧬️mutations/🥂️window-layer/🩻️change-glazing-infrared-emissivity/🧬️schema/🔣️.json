{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-glazing-material-infrared-emissivity/schema.json",
  "title": "ChangeGlazingMaterialInfraredEmissivity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newInfraredEmissivityFront",
    "newInfraredEmissivityBack"
  ],
  "properties": {
    "mutation": {
      "const": "changeGlazingMaterialInfraredEmissivity"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Glazing material",
          "de": "Verglasungsmaterial"
        },
        "description": {
          "en": "The glazing material this mutation changes, by id.",
          "de": "Verglasungsmaterial, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "glazingMaterial",
          "domain": "energyModel",
          "granularity": "glazingMaterial"
        },
        "group": "target",
        "order": 10
      }
    },
    "newInfraredEmissivityFront": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Front infrared emissivity",
          "de": "Infrarot-Emissionsgrad außen"
        },
        "description": {
          "en": "Long-wave emissivity of the outside-facing side.",
          "de": "Langwelliger Emissionsgrad der nach außen gewandten Seite."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "optics",
        "order": 20
      }
    },
    "newInfraredEmissivityBack": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Back infrared emissivity",
          "de": "Infrarot-Emissionsgrad innen"
        },
        "description": {
          "en": "Long-wave emissivity of the inside-facing side.",
          "de": "Langwelliger Emissionsgrad der nach innen gewandten Seite."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "optics",
        "order": 30
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "facet-row",
    "facet": "fixed-pair",
    "row": "StateGlazingMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "glazing_materials",
    "field": "infrared_emissivity_front",
    "pairedField": "infrared_emissivity_back",
    "input": "new_infrared_emissivity_front",
    "upper": "new_infrared_emissivity_back",
    "key": "id",
    "labels": {
      "en": "Change glazing infrared emissivities",
      "de": "Infrarot-Emissionsgrade der Verglasung ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "glazing-optical-facet",
      "kind": "change-infrared-emissivity",
      "record": "ChangedGlazingInfraredEmissivities"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Both finite infrared emissivities lie between zero and one."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed glazing material does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "This glazing already carries both infrared emissivities."
      }
    }
  }
}
