    "newSupplyTemperatureC": {
      "type": "number",
      "minimum": -100,
      "maximum": 300,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Supply temperature",
          "de": "Vorlauftemperatur"
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "group": "plant",
        "order": 20
