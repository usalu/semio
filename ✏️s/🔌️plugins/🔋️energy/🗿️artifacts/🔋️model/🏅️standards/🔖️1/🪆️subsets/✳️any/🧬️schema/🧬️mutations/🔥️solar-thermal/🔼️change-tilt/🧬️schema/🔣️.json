{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-solar-thermal-system-tilt/schema.json",
  "title": "ChangeSolarThermalSystemTilt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newTiltDeg"
  ],
  "properties": {
    "mutation": {
      "const": "changeSolarThermalSystemTilt"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Solar thermal system",
          "de": "Solarthermieanlage"
        },
        "description": {
          "en": "The solar thermal system this mutation changes, by id.",
          "de": "Solarthermieanlage, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "solarThermalSystem"
        },
        "group": "target",
        "order": 10
      }
    },
    "newTiltDeg": {
      "type": "number",
      "minimum": 0,
      "maximum": 90,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Tilt",
          "de": "Neigung"
        },
        "description": {
          "en": "Angle from horizontal: 0 is flat, 90 is vertical.",
          "de": "Winkel zur Horizontalen: 0 ist waagerecht, 90 senkrecht."
        },
        "unit": "deg",
        "step": 1,
        "precision": 0,
        "softMin": 0,
        "softMax": 90,
        "snaps": [
          0,
          15,
          30,
          45,
          60,
          75,
          90
        ],
        "group": "orientation",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateSolarThermalConfig",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "solar_thermal_systems",
    "field": "tilt_deg",
    "input": "new_tilt_deg",
    "key": "id",
    "labels": {
      "en": "Change solar thermal system: Tilt",
      "de": "Neigung ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "solar-thermal-system",
      "kind": "change-solar-thermal-system-tilt",
      "record": "ChangedSolarThermalSystemTilt"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Tilt violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed solar thermal system does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The solar thermal system already carries this tilt value."
      }
    }
  }
}
