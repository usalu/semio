{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-site-longitude/schema.json",
  "title": "ChangeSiteLongitude",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newLongitudeDeg"
  ],
  "properties": {
    "mutation": {
      "const": "changeSiteLongitude"
    },
    "newLongitudeDeg": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Longitude",
          "de": "Längengrad"
        },
        "description": {
          "en": "East positive, -180 to 180.",
          "de": "Ost positiv, -180 bis 180."
        },
        "unit": "deg",
        "step": 0.001,
        "precision": 3,
        "softMin": -180,
        "softMax": 180,
        "group": "site",
        "order": 10
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-field",
    "scope": "site",
    "field": "longitude_deg",
    "input": "new_longitude_deg",
    "labels": {
      "en": "Change longitude deg",
      "de": "Längengrad ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "site",
      "kind": "change-site-longitude",
      "record": "ChangedSiteLongitude"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored longitude deg is outside its admissible range."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The longitude deg is unchanged."
      }
    }
  }
}
