    "faults",
    "output_variables",
    "sizing_objects",
    "daylight_zones",
    "room_air_models",
    "ground_temperature",
    "run_period",
    "schedules"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "site": {
      "$ref": "#/$defs/Site"
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Zone"
      }
    },
    "spaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Space"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Surface"
      }
    },
    "fenestrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Fenestration"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Material"
      }
    },
    "glazing_materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GlazingMaterial"
      }
    },
    "gas_materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GasMaterial"
      }
    },
    "constructions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Construction"
      }
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PeopleGain"
      }
    },
    "lighting": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LightingGain"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EquipmentGain"
      }
    },
    "thermostats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Thermostat"
      }
    },
    "humidistats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Humidistat"
      }
    },
    "setpoint_managers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SetpointManager"
      }
    },
    "ideal_loads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IdealLoadsSystem"
      }
    },
    "zone_equipment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ZoneEquipmentAssignment"
      }
    },
    "air_loops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModelAirLoop"
      }
    },
    "plant_loops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlantLoopConfig"
      }
    },
    "outdoor_air_systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutdoorAirSystem"
      }
    },
    "infiltrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Infiltration"
      }
    },
    "mechanical_ventilations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MechanicalVentilation"
      }
    },
    "shading_surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShadingSurface"
      }
    },
    "space_lists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SpaceList"
      }
    },
    "thermal_enclosures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ThermalEnclosure"
      }
    },
    "adjacency_pairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AdjacencyPair"
      }
    },
    "airflow_network": {
      "anyOf": [
        {
          "$ref": "#/$defs/AirflowNetworkDefinition"
        },
        {
          "type": "null"
        }
      ]
    },
    "electrical_load_centers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ElectricalLoadCenter"
      }
    },
    "pv_systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PvSystemAssignment"
      }
    },
    "battery_storage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BatteryAssignment"
      }
    },
    "shw_systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShwSystemConfig"
      }
    },
    "solar_thermal_systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SolarThermalConfig"
      }
    },
    "refrigeration_systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RefrigerationConfig"
      }
    },
    "water_systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WaterSystemConfig"
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FaultDefinition"
      }
    },
    "output_variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputVariableSpec"
      }
    },
    "sizing_objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SizingObject"
      }
    },
    "daylight_zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DaylightZoneConfig"
      }
    },
    "room_air_models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoomAirModelAssignment"
      }
    },
    "ground_temperature": {
      "$ref": "#/$defs/GroundTemperatureConfig"
    },
    "run_period": {
      "$ref": "#/$defs/RunPeriod"
    },
    "schedules": {
      "$ref": "#/$defs/ScheduleSet"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/model.json",
  "title": "EnergyModel",
  "$defs": {
    "ScheduleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constants",
        "daily",
        "weekly",
        "annual",
        "time_series"
      ],
      "properties": {
        "constants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConstantSchedule"
          }
        },
        "daily": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DailySchedule"
          }
        },
        "weekly": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WeeklySchedule"
          }
        },
        "annual": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnnualSchedule"
          }
        },
        "time_series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeSeriesSchedule"
          }
        }
      }
    },
    "TimeSeriesSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "values",
        "timestep_seconds"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "timestep_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AnnualSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rules",
        "default_daily_schedule_id",
        "holiday_daily_schedule_id",
        "holiday_dates"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompactScheduleRule"
          }
        },
        "default_daily_schedule_id": {
          "type": "integer",
          "minimum": 0
        },
        "holiday_daily_schedule_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "holiday_dates": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "CompactScheduleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_month",
        "start_day",
        "end_month",
        "end_day",
        "daily_schedule_id"
      ],
      "properties": {
        "start_month": {
          "type": "integer",
          "minimum": 0
        },
        "start_day": {
          "type": "integer",
          "minimum": 0
        },
        "end_month": {
          "type": "integer",
          "minimum": 0
        },
        "end_day": {
          "type": "integer",
          "minimum": 0
        },
        "daily_schedule_id": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WeeklySchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "daily_schedule_ids"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "daily_schedule_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 7,
          "maxItems": 7
        }
      }
    },
    "DailySchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hourly_values",
        "interpolation",
        "limits"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "hourly_values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 24,
          "maxItems": 24
        },
        "interpolation": {
          "enum": [
            "Continuous",
            "Discrete"
          ]
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduleLimits"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ScheduleLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "ConstantSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "number"
        }
      }
    },
    "RunPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_month",
        "start_day",
        "end_month",
        "end_day",
        "year"
      ],
      "properties": {
        "start_month": {
          "type": "integer",
          "minimum": 0
        },
        "start_day": {
          "type": "integer",
          "minimum": 0
        },
        "end_month": {
          "type": "integer",
          "minimum": 0
        },
        "end_day": {
          "type": "integer",
          "minimum": 0
        },
        "year": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "GroundTemperatureConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "building_surface_c",
        "shallow_c",
        "deep_c"
      ],
      "properties": {
        "building_surface_c": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 12,
          "maxItems": 12
        },
        "shallow_c": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 12,
          "maxItems": 12
        },
        "deep_c": {
          "type": "number"
        }
      }
    },
    "RoomAirModelAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "model"
      ],
      "properties": {
        "zone_id": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "enum": [
            "WellMixed",
            "OneNodeDisplacement",
            "TwoNodeBuoyancy",
            "UnderFloorAirDistribution"
          ]
        }
      }
    },
    "DaylightZoneConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "zone_id",
        "illuminance_target_lux",
        "glare_limit",
        "window_transmittance"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "zone_id": {
          "type": "integer",
          "minimum": 0
        },
        "illuminance_target_lux": {
          "type": "number"
        },
        "glare_limit": {
          "type": "number"
        },
        "window_transmittance": {
          "type": "number"
        }
      }
    },
    "SizingObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "zone_id",
        "sizing_type",
        "design_day_type"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "zone_id": {
          "type": "integer",
          "minimum": 0
        },
        "sizing_type": {
          "enum": [
            "Heating",
            "Cooling",
            "OutdoorAir"
          ]
        },
        "design_day_type": {
          "enum": [
            "Heating",
            "Cooling"
          ]
        }
      }
    },
    "OutputVariableSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key",
        "reporting_frequency"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "reporting_frequency": {
          "enum": [
            "Timestep",
            "Hourly",
            "Daily",
            "Monthly",
            "RunPeriod"
          ]
        }
      }
    },
    "FaultDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_equipment_id",
        "fault_type",
        "severity",
        "start_schedule_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "target_equipment_id": {
          "type": "integer",
          "minimum": 0
        },
        "fault_type": {
          "enum": [
            "SensorBias",
            "CoilFouling",
            "DamperStuck",
            "ChillerFouling",
            "BoilerEfficiencyDegradation"
          ]
        },
        "severity": {
          "type": "number"
        },
        "start_schedule_id": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WaterSystemConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixture_count",
        "peak_flow_l_s",
        "schedule_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "peak_flow_l_s": {
          "type": "number"
        },
        "schedule_id": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "RefrigerationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_count",
        "design_load_w",
        "defrost_schedule_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "design_load_w": {
          "type": "number"
        },
        "defrost_schedule_id": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "SolarThermalConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "collector_area_m2",
        "efficiency",
        "storage_volume_m3",
        "tilt_deg",
        "azimuth_deg"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "collector_area_m2": {
          "type": "number"
        },
        "efficiency": {
          "type": "number"
        },
        "storage_volume_m3": {
          "type": "number"
        },
        "tilt_deg": {
          "type": "number"
        },
        "azimuth_deg": {
          "type": "number"
        }
      }
    },
    "ShwSystemConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heater_capacity_w",
        "storage_volume_m3",
        "setpoint_c",
        "schedule_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "heater_capacity_w": {
          "type": "number"
        },
        "storage_volume_m3": {
          "type": "number"
        },
        "setpoint_c": {
          "type": "number"
        },
        "schedule_id": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "BatteryAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capacity_kwh",
        "max_charge_w",
        "max_discharge_w",
        "round_trip_efficiency"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "capacity_kwh": {
          "type": "number"
        },
        "max_charge_w": {
          "type": "number"
        },
        "max_discharge_w": {
          "type": "number"
        },
        "round_trip_efficiency": {
          "type": "number"
        }
      }
    },
    "PvSystemAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dc_capacity_w",
        "area_m2",
        "tilt_deg",
        "azimuth_deg",
        "module_efficiency",
        "inverter_efficiency",
        "temperature_coefficient",
        "faiman_heat_loss_constant_w_m2k",
        "faiman_heat_loss_wind_w_s_m3k",
        "mounting"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "dc_capacity_w": {
          "type": "number"
        },
        "area_m2": {
          "type": "number"
        },
        "tilt_deg": {
          "type": "number"
        },
        "azimuth_deg": {
          "type": "number"
        },
        "module_efficiency": {
          "type": "number"
        },
        "inverter_efficiency": {
          "type": "number"
        },
        "temperature_coefficient": {
          "type": "number"
        },
        "faiman_heat_loss_constant_w_m2k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "faiman_heat_loss_wind_w_s_m3k": {
          "type": "number",
          "minimum": 0
        },
        "mounting": {
          "type": "string",
          "enum": [
            "OpenRack",
            "CloseRoof",
            "InsulatedBack"
          ]
        }
      }
    },
    "ElectricalLoadCenter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "generator_ids",
        "pv_ids",
        "battery_ids"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "generator_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "pv_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "battery_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "AirflowNetworkDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_node_ids",
        "outdoor_node_id",
        "link_ids"
      ],
      "properties": {
        "zone_node_ids": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "outdoor_node_id": {
          "type": "integer",
          "minimum": 0
        },
        "link_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "AdjacencyPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_a_id",
        "surface_b_id"
      ],
      "properties": {
        "surface_a_id": {
          "type": "integer",
          "minimum": 0
