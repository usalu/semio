    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zoneTimestepMinutes",
        "systemTimestepMinutes",
        "warmupDays",
        "resultField"
      ],
      "properties": {
        "zoneTimestepMinutes": {
          "const": 60
        },
        "systemTimestepMinutes": {
          "const": 60
        },
        "warmupDays": {
          "const": 7
        },
        "resultField": {
          "const": "conductionLoss"
        }
      }
    },
    "cancelStages": {
      "const": [
        0,
        3,
        6
      ]
    }
  }
}
