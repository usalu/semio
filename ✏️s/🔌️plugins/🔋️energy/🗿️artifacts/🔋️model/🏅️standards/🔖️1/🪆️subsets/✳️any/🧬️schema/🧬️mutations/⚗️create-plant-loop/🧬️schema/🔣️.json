{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/energy/model/1/any/mutation/create-plant-loop.json",
  "title": "CreatePlantLoop",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "loopType",
    "supplyTemperatureC",
    "returnTemperatureC",
    "designFlowKgS",
    "equipmentIds"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "loopType": {
      "enum": [
        "Heating",
        "Cooling",
        "Condenser"
      ]
    },
    "supplyTemperatureC": {
      "type": "number"
    },
    "returnTemperatureC": {
      "type": "number"
    },
    "designFlowKgS": {
      "type": "number"
    },
    "equipmentIds": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}
