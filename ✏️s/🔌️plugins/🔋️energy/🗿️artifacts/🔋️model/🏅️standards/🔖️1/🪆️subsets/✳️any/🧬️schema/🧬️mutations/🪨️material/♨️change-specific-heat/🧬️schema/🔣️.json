{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-material-specific-heat/schema.json",
  "title": "ChangeMaterialSpecificHeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newSpecificHeatJKgK"
  ],
  "properties": {
    "mutation": {
      "const": "changeMaterialSpecificHeat"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Material",
          "de": "Material"
        },
        "description": {
          "en": "The material this mutation changes, by id.",
          "de": "Material, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "material",
          "domain": "energyModel",
          "granularity": "material"
        },
        "group": "target",
        "order": 10
      }
    },
    "newSpecificHeatJKgK": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Specific heat capacity",
          "de": "Spezifische Wärmekapazität"
        },
        "unit": "J/(kg·K)",
        "step": 10,
        "precision": 0,
        "group": "thermal",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "materials",
    "field": "specific_heat_j_kg_k",
    "input": "new_specific_heat_j_kg_k",
    "key": "id",
    "labels": {
      "en": "Change material: Specific heat capacity",
      "de": "Spezifische Wärmekapazität ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "material",
      "kind": "change-material-specific-heat",
      "record": "ChangedMaterialSpecificHeat"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Specific heat capacity violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed material does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The material already carries this specific heat capacity value."
      }
    }
  }
}
