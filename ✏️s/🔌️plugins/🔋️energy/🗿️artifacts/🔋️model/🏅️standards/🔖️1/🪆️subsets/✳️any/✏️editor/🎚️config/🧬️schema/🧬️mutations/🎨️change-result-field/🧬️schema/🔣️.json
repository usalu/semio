{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/energy/model/config/mutation/change-result-field/schema.json",
  "title": "ChangeResultField",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "field"
  ],
  "properties": {
    "field": {
      "type": "string",
      "enum": [
        "conductionLoss",
        "conductionGain",
        "solarTransmitted",
        "solarAbsorbed"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Result field",
          "de": "Ergebnisgröße"
        },
        "description": {
          "en": "Surface result that colours the model.",
          "de": "Flächenergebnis, nach dem das Modell eingefärbt wird."
        },
        "options": {
          "conductionLoss": {
            "en": "Conduction loss",
            "de": "Transmissionswärmeverlust"
          },
          "conductionGain": {
            "en": "Conduction gain",
            "de": "Transmissionswärmegewinn"
          },
          "solarTransmitted": {
            "en": "Transmitted solar",
            "de": "Transmittierte Solarstrahlung"
          },
          "solarAbsorbed": {
            "en": "Absorbed solar",
            "de": "Absorbierte Solarstrahlung"
          }
        },
        "group": "display",
        "order": 10
      }
    }
  }
}
