        "label": {
          "en": "Material",
          "de": "Material"
        },
        "description": {
          "en": "The material to delete, by id.",
          "de": "Material, das diese Mutation löscht, per ID."
        },
        "ref": {
          "kind": "material",
          "domain": "energyModel",
          "granularity": "material"
        },
        "group": "target",
        "order": 10
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "delete-row",
    "row": "StateMaterial",
    "branchType": "ModelMaterialState",
    "branch": "materials",
    "collection": "materials",
    "key": "id",
    "inverse": "CreateMaterial",
    "restriction": {
      "row": "StateConstruction",
      "branch": "materials",
      "collection": "constructions",
      "field": "layer_material_ids",
      "storage": "shared-array",
      "kind": "references"
    },
    "labels": {
