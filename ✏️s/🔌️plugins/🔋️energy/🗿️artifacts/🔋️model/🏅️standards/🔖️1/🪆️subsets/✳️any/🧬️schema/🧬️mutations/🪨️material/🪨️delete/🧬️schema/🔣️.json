{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/delete-material/schema.json",
  "title": "DeleteMaterial",
  "type": "object",
  "additionalProperties": false,
  "required": [
