      "de": "Material löschen"
    },
    "semantics": {
      "verb": "delete",
      "entity": "material",
      "kind": "delete-material",
      "record": "DeletedMaterial"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
