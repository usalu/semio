{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/replace-daily-schedule-hourly-values/schema.json",
  "title": "ReplaceDailyScheduleHourlyValues",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newHourlyValues"
  ],
  "properties": {
    "mutation": {
      "const": "replaceDailyScheduleHourlyValues"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Daily schedule",
          "de": "Tageszeitplan"
        },
        "description": {
          "en": "The daily schedule this mutation changes, by id.",
          "de": "Tageszeitplan, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "dailySchedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "target",
        "order": 10
      }
    },
    "newHourlyValues": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 24,
      "maxItems": 24,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Hourly values",
          "de": "Stundenwerte"
        },
        "description": {
          "en": "Twenty-four values, one per hour of the day.",
          "de": "Vierundzwanzig Werte, einer je Tagesstunde."
        },
        "group": "values",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "fixed-row",
    "row": "StateDailySchedule",
    "branchType": "StateScheduleSet",
    "branch": "outputs",
    "nested": "schedules",
    "collection": "daily",
    "field": "hourly_values",
    "input": "new_hourly_values",
    "key": "id",
    "labels": {
      "en": "Replace hourly schedule values",
      "de": "Stundenwerte des Zeitplans ersetzen"
    },
    "semantics": {
      "verb": "replace",
      "entity": "daily-schedule",
      "kind": "replace-daily-schedule-hourly-values",
      "record": "ReplacedDailyScheduleHourlyValues"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Every hourly schedule value must be finite."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed daily schedule does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The daily schedule already holds these hourly values."
      }
    }
  }
}
