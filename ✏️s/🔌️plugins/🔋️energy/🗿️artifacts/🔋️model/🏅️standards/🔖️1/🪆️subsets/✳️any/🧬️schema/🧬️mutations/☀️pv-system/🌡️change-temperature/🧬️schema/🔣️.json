{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-pv-system-temperature-coefficient/schema.json",
  "title": "ChangePvSystemTemperatureCoefficient",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newTemperatureCoefficient"
  ],
  "properties": {
    "mutation": {
      "const": "changePvSystemTemperatureCoefficient"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "PV system",
          "de": "PV-Anlage"
        },
        "ref": {
          "kind": "pvSystem"
        }
      }
    },
    "newTemperatureCoefficient": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Temperature coefficient",
          "de": "Temperaturkoeffizient"
        },
        "group": "thermal",
        "order": 20,
        "displayUnit": "%/K",
        "displayFactor": 100,
        "step": 0.0001,
        "precision": 2
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StatePvSystemAssignment",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "pv_systems",
    "field": "temperature_coefficient",
    "input": "new_temperature_coefficient",
    "key": "id",
    "labels": {
      "en": "Change pv system: Temperature coefficient",
      "de": "Temperaturkoeffizient ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "pv-system",
      "kind": "change-pv-system-temperature-coefficient",
      "record": "ChangedPvSystemTemperatureCoefficient"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Temperature coefficient violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed pv system does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The pv system already carries this temperature coefficient value."
      }
    }
  }
}
