{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-zone-equipment-type/schema.json",
  "title": "ChangeZoneEquipmentType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newEquipmentType"
  ],
  "properties": {
    "mutation": {
      "const": "changeZoneEquipmentType"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone equipment",
          "de": "Zonengerät"
        },
        "description": {
          "en": "The zone equipment this mutation changes, by id.",
          "de": "Zonengerät, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "zoneEquipment"
        },
        "group": "target",
        "order": 10
      }
    },
    "newEquipmentType": {
      "enum": [
        "Baseboard",
        "Radiant",
        "FanCoil",
        "Ptac",
        "VrfTerminal",
        "Erv",
        "UnitHeater",
        "WaterToAirHp"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Equipment type",
          "de": "Gerätetyp"
        },
        "options": {
          "Baseboard": {
            "en": "Baseboard heater",
            "de": "Sockelleistenheizung"
          },
          "Radiant": {
            "en": "Radiant system",
            "de": "Flächenheizung/-kühlung"
          },
          "FanCoil": {
            "en": "Fan coil unit",
            "de": "Gebläsekonvektor"
          },
          "Ptac": {
            "en": "Packaged terminal air conditioner",
            "de": "Kompaktklimagerät"
          },
          "VrfTerminal": {
            "en": "VRF terminal unit",
            "de": "VRF-Inneneinheit"
          },
          "Erv": {
            "en": "Energy recovery ventilator",
            "de": "Lüftungsgerät mit Wärmerückgewinnung"
          },
          "UnitHeater": {
            "en": "Unit heater",
            "de": "Lufterhitzer"
          },
          "WaterToAirHp": {
            "en": "Water-to-air heat pump",
            "de": "Wasser-Luft-Wärmepumpe"
          }
        },
        "group": "equipment",
        "order": 20
      }
    }
  }
}
