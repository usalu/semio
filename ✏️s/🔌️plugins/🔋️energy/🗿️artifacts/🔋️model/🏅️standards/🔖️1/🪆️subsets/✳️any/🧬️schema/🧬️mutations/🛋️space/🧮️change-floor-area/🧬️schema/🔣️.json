{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-space-floor-area/schema.json",
  "title": "ChangeSpaceFloorArea",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newFloorAreaM2"
  ],
  "properties": {
    "mutation": {
      "const": "changeSpaceFloorArea"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Space",
          "de": "Raum"
        },
        "description": {
          "en": "The space this mutation changes, by id.",
          "de": "Raum, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "space",
          "domain": "energyModel",
          "granularity": "space"
        },
        "group": "target",
        "order": 10
      }
    },
    "newFloorAreaM2": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Floor area",
          "de": "Geschossfläche"
        },
        "unit": "m²",
        "step": 0.1,
        "precision": 2,
        "group": "geometry",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateSpace",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "spaces",
    "field": "floor_area_m2",
    "input": "new_floor_area_m2",
    "key": "id",
    "labels": {
      "en": "Change space: Floor area",
      "de": "Geschossfläche ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "space",
      "kind": "change-space-floor-area",
      "record": "ChangedSpaceFloorArea"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Floor area violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed space does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The space already carries this floor area value."
      }
    }
  }
}
