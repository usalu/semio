        "ref": {
          "kind": "humidistat"
        },
        "group": "target",
        "order": 10
      }
    },
    "newZoneId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "Assigned zone, by id.",
          "de": "Zugeordnete Zone, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "assignment",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "reference-row",
    "references": [
      "Zones"
    ],
    "row": "StateHumidistat",
