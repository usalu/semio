      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The referenced zone does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The humidistat already carries this zone reference."
      }
