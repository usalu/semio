{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-outdoor-air-system-economizer-enabled/schema.json",
  "title": "ChangeOutdoorAirSystemEconomizerEnabled",
  "type": "object",
  "additionalProperties": false,
