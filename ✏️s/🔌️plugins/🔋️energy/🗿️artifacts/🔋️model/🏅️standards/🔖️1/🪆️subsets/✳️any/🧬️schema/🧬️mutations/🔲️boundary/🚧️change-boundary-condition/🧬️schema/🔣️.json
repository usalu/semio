{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-surface-boundary-condition/schema.json",
  "title": "ChangeSurfaceBoundaryCondition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newBoundary",
    "newInterzoneSurfaceId"
  ],
  "properties": {
    "mutation": {
      "const": "changeSurfaceBoundaryCondition"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Surface",
          "de": "Oberfläche"
        },
        "description": {
          "en": "The surface this mutation changes, by id.",
          "de": "Oberfläche, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "surface",
          "domain": "energyModel",
          "granularity": "surface"
        },
        "group": "target",
        "order": 10
      }
    },
    "newBoundary": {
      "enum": [
        "OutdoorAir",
        "Ground",
        "OtherSideTemperature",
        "Adiabatic",
        "Interzone"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Outside boundary condition",
          "de": "Außenrandbedingung"
        },
        "options": {
          "OutdoorAir": {
            "en": "Outdoor air",
            "de": "Außenluft"
          },
          "Ground": {
            "en": "Ground",
            "de": "Erdreich"
          },
          "OtherSideTemperature": {
            "en": "Other-side temperature",
            "de": "Temperatur der Gegenseite"
          },
          "Adiabatic": {
            "en": "Adiabatic",
            "de": "Adiabat"
          },
          "Interzone": {
            "en": "Adjacent zone",
            "de": "Nachbarzone"
          }
        },
        "group": "boundary",
        "order": 20
      }
    },
    "newInterzoneSurfaceId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Interzone partner surface",
          "de": "Partnerfläche der Nachbarzone"
        },
        "description": {
          "en": "Required for the adjacent-zone boundary, empty for every other one.",
          "de": "Erforderlich bei der Randbedingung Nachbarzone, sonst leer."
        },
        "ref": {
          "kind": "surface",
          "domain": "energyModel",
          "granularity": "surface"
        },
        "group": "boundary",
        "order": 30
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "newBoundary": {
            "const": "Interzone"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "newInterzoneSurfaceId": {
            "type": "integer"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "newInterzoneSurfaceId": {
            "type": "null"
          }
        }
      }
    }
  ],
  "x-semio-energy-operation": {
    "category": "facet-row",
    "facet": "surface-boundary",
    "row": "StateSurface",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "surfaces",
    "field": "outside_boundary_condition",
    "input": "new_boundary",
    "partner": "new_interzone_surface_id",
    "key": "id",
    "references": [
      "Surfaces"
    ],
    "referenceTarget": "key",
    "labels": {
      "en": "Change surface boundary condition",
      "de": "Oberflächenrandbedingung ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "surface",
      "kind": "change-surface-boundary-condition",
      "record": "ChangedSurfaceBoundaryCondition"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Only an interzone boundary carries exactly one partner surface."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "An interzone partner must be another existing surface."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed surface does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "This surface already carries the boundary condition."
      }
    }
  }
}
