{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-zone/schema.json",
  "title": "CreateZone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "name",
    "volumeM3",
    "multiplier",
    "conditioned",
    "partOfTotalFloorArea"
  ],
  "properties": {
    "mutation": {
      "const": "createZone"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; empty appends (or keeps id order).",
          "de": "Einfügeposition in der Modellliste; leer hängt an (oder behält die ID-Reihenfolge)."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 5
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new zone is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 10
      }
    },
    "name": {
      "type": "string",
      "pattern": "[^\\t\\n\\u000B\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "group": "identity",
        "order": 20
      }
    },
    "volumeM3": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Air volume",
          "de": "Luftvolumen"
        },
        "unit": "m³",
        "step": 0.1,
        "precision": 1,
        "group": "geometry",
        "order": 30
      }
    },
    "multiplier": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Multiplier",
          "de": "Multiplikator"
        },
        "description": {
          "en": "Number of identical instances this object stands for; at least 1.",
          "de": "Anzahl gleicher Exemplare, die dieses Objekt vertritt; mindestens 1."
        },
        "step": 1,
        "precision": 0,
        "group": "geometry",
        "order": 40
      }
    },
    "conditioned": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Conditioned",
          "de": "Konditioniert"
        },
        "description": {
          "en": "Heated or cooled by the HVAC system.",
          "de": "Von der Anlagentechnik beheizt oder gekühlt."
        },
        "group": "thermal",
        "order": 50
      }
    },
    "partOfTotalFloorArea": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Counts toward total floor area",
          "de": "Zählt zur Gesamtgeschossfläche"
        },
        "group": "geometry",
        "order": 60
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateZone",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "name",
        "input": "name",
        "storage": "sealed"
      },
      {
        "field": "volume_m3",
        "input": "volume_m3",
        "storage": "fixed"
      },
      {
        "field": "multiplier",
        "input": "multiplier",
        "storage": "fixed"
      },
      {
        "field": "conditioned",
        "input": "conditioned",
        "storage": "fixed"
      },
      {
        "field": "part_of_total_floor_area",
        "input": "part_of_total_floor_area",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateZone",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "zones",
    "key": "id",
    "name": "name",
    "inverse": "DeleteZone",
    "unique": true,
    "labels": {
      "en": "Create zone",
      "de": "Zone erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "zone",
      "kind": "create-zone",
      "record": "CreatedZone"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A zone needs a nonblank name, a positive finite volume and at least one instance."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "A zone with this identity or name already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The authored insertion rank is past the end of the zone collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The zone creation makes no change."
      }
    },
    "validationBeforeRank": true,
    "defaultRank": "id-order",
    "nameValidation": "nonblank"
  }
}
