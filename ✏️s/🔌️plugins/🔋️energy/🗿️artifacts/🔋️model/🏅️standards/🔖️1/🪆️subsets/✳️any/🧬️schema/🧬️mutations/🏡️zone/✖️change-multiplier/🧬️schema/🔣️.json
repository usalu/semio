{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-zone-multiplier/schema.json",
  "title": "ChangeZoneMultiplier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newMultiplier"
  ],
  "properties": {
    "mutation": {
      "const": "changeZoneMultiplier"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The zone this mutation changes, by id.",
          "de": "Zone, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newMultiplier": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Multiplier",
          "de": "Multiplikator"
        },
        "description": {
          "en": "Number of identical instances this object stands for; at least 1.",
          "de": "Anzahl gleicher Exemplare, die dieses Objekt vertritt; mindestens 1."
        },
        "step": 1,
        "precision": 0,
        "group": "geometry",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateZone",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "zones",
    "field": "multiplier",
    "input": "new_multiplier",
    "key": "id",
    "labels": {
      "en": "Change zone multiplier",
      "de": "Zonenmultiplikator ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "zone",
      "kind": "change-zone-multiplier",
      "record": "ChangedZoneMultiplier"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "A zone needs at least one instance."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed zone does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The zone already has this multiplier."
      }
    }
  }
}
