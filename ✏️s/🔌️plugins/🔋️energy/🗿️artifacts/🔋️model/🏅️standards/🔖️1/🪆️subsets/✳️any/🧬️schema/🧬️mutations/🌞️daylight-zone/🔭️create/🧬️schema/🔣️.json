{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-daylight-zone/schema.json",
  "title": "CreateDaylightZone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "zoneId",
    "illuminanceTargetLux",
    "glareLimit",
    "windowTransmittance"
  ],
  "properties": {
    "mutation": {
      "const": "createDaylightZone"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; empty appends (or keeps id order).",
          "de": "Einfügeposition in der Modellliste; leer hängt an (oder behält die ID-Reihenfolge)."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 5
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new daylight zone is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 10
      }
    },
    "zoneId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "Assigned zone, by id.",
          "de": "Zugeordnete Zone, per ID."
        },
        "ref": {
          "kind": "zone",
          "domain": "energyModel",
          "granularity": "zone"
        },
        "group": "assignment",
        "order": 20
      }
    },
    "illuminanceTargetLux": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Illuminance target",
          "de": "Soll-Beleuchtungsstärke"
        },
        "unit": "lx",
        "step": 10,
        "precision": 0,
        "group": "daylight",
        "order": 30
      }
    },
    "glareLimit": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Glare limit",
          "de": "Blendungsgrenzwert"
        },
        "description": {
          "en": "Largest acceptable simplified glare index, 0 to 1; higher means more glare.",
          "de": "Größter zulässiger vereinfachter Blendungsindex, 0 bis 1; höher bedeutet mehr Blendung."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0.01,
        "softMax": 1,
        "group": "daylight",
        "order": 40
      }
    },
    "windowTransmittance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Window transmittance",
          "de": "Fenstertransmissionsgrad"
        },
        "description": {
          "en": "Visible transmittance of the daylight apertures.",
          "de": "Lichttransmissionsgrad der Tageslichtöffnungen."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "group": "daylight",
        "order": 50
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateDaylightZoneConfig",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "zone_id",
        "input": "zone_id",
        "storage": "fixed"
      },
      {
        "field": "illuminance_target_lux",
        "input": "illuminance_target_lux",
        "storage": "fixed"
      },
      {
        "field": "glare_limit",
        "input": "glare_limit",
        "storage": "fixed"
      },
      {
        "field": "window_transmittance",
        "input": "window_transmittance",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateDaylightZoneConfig",
    "branchType": "ModelLoadState",
    "branch": "loads",
    "collection": "daylight_zones",
    "key": "id",
    "inverse": "DeleteDaylightZone",
    "labels": {
      "en": "Create daylight zone",
      "de": "Tageslichtzone erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "daylight-zone",
      "kind": "create-daylight-zone",
      "record": "CreatedDaylightZone"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The authored row violates its declared field bounds."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "An object with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The authored insertion rank is past the end of the collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The creation makes no change."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The original referenced entity does not exist."
      }
    },
    "validationBeforeRank": true,
    "rules": [
      {
        "input": "zone_id",
        "kind": "reference",
        "storage": "direct",
        "collections": [
          "Zones"
        ],
        "target": "input"
      }
    ],
    "defaultRank": "append",
    "scalarOrder": "after-rules"
  }
}
