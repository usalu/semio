      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Holiday daily schedule",
          "de": "Feiertags-Tageszeitplan"
