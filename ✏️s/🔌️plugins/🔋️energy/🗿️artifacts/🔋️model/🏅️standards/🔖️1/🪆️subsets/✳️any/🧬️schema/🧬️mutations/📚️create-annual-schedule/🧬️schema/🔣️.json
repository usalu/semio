{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-annual-schedule/schema.json",
  "title": "CreateAnnualSchedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "defaultDailyScheduleId",
    "holidayDailyScheduleId"
