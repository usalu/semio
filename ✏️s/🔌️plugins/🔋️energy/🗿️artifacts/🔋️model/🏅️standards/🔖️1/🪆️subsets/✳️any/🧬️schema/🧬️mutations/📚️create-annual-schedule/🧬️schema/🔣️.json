        "description": {
          "en": "Daily profile of the holidays, by id; empty means none.",
          "de": "Tagesprofil der Feiertage, per ID; leer bedeutet keiner."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
