{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-annual-schedule/schema.json",
  "title": "CreateAnnualSchedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "defaultDailyScheduleId",
    "holidayDailyScheduleId"
  ],
  "properties": {
    "mutation": {
      "const": "createAnnualSchedule"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new annual schedule is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "defaultDailyScheduleId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Default daily schedule",
          "de": "Standard-Tageszeitplan"
        },
        "description": {
          "en": "Daily profile of every day no rule covers, by id.",
          "de": "Tagesprofil für jeden Tag ohne Regel, per ID."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 30
      }
    },
    "holidayDailyScheduleId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Holiday daily schedule",
          "de": "Feiertags-Tageszeitplan"
        },
        "description": {
          "en": "Daily profile of the holidays, by id; empty means none.",
          "de": "Tagesprofil der Feiertage, per ID; leer bedeutet keiner."
        },
        "ref": {
          "kind": "schedule",
          "domain": "energyModel",
          "granularity": "schedule"
        },
        "group": "schedule",
        "order": 40
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateAnnualSchedule",
    "recreation": "separate-intents",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "rules",
        "storage": "empty-vector",
        "item": "crate::schedule::CompactScheduleRule"
      },
      {
        "field": "default_daily_schedule_id",
        "input": "default_daily_schedule_id",
        "storage": "fixed"
      },
      {
        "field": "holiday_daily_schedule_id",
        "input": "holiday_daily_schedule_id",
        "storage": "sealed"
      },
      {
        "field": "holiday_dates",
        "storage": "empty-vector",
        "item": "(u16,u8,u8)"
      }
    ]
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateAnnualSchedule",
    "branchType": "StateScheduleSet",
    "branch": "outputs",
    "nested": "schedules",
    "collection": "annual",
    "key": "id",
    "inverse": "DeleteAnnualSchedule",
    "labels": {
      "en": "Create annual schedule",
      "de": "Jahreszeitplan erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "schedule",
      "kind": "create-annual-schedule",
      "record": "CreatedAnnualSchedule"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The schedule requires finite values and a positive timestep."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "A schedule with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The insertion rank is past the end of this schedule collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The schedule creation makes no change."
      },
      "reference": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The referenced daily schedule does not exist."
      }
    },
    "validationBeforeRank": false,
    "defaultRank": "explicit",
    "identityCollections": [
      "ConstantSchedules",
      "DailySchedules",
      "WeeklySchedules",
      "AnnualSchedules",
      "TimeSeriesSchedules"
    ],
    "rules": [
      {
        "input": "default_daily_schedule_id",
        "kind": "reference",
        "storage": "direct",
        "collections": [
          "DailySchedules"
        ],
        "target": "input"
      },
      {
        "input": "holiday_daily_schedule_id",
        "kind": "reference",
        "storage": "optional",
        "collections": [
          "DailySchedules"
        ],
        "target": "input"
      }
    ],
    "scalarOrder": "before-rules"
  }
}
