{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-plant-loop-type/schema.json",
  "title": "ChangePlantLoopType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newLoopType"
  ],
  "properties": {
    "mutation": {
      "const": "changePlantLoopType"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plant loop",
          "de": "Anlagenkreislauf"
        },
        "description": {
          "en": "The plant loop this mutation changes, by id.",
          "de": "Anlagenkreislauf, den diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "plantLoop"
        },
        "group": "target",
        "order": 10
      }
    },
    "newLoopType": {
      "enum": [
        "Heating",
        "Cooling",
        "Condenser"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Loop type",
          "de": "Kreislauftyp"
        },
        "options": {
          "Heating": {
            "en": "Heating",
            "de": "Heizung"
          },
          "Cooling": {
            "en": "Cooling",
            "de": "Kühlung"
          },
          "Condenser": {
            "en": "Condenser",
            "de": "Rückkühlung"
          }
        },
        "group": "plant",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "enum-row",
    "row": "StatePlantLoopConfig",
    "branchType": "ModelSystemState",
    "branch": "systems",
    "collection": "plant_loops",
    "field": "loop_type",
    "input": "new_loop_type",
    "key": "id",
    "labels": {
      "en": "Change plant loop: Loop type",
      "de": "Kreislauftyp ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "plant-loop",
      "kind": "change-plant-loop-type",
      "record": "ChangedPlantLoopType"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Loop type violates its authored choices."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed plant loop does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The plant loop already carries this loop type value."
      }
    }
  }
}
