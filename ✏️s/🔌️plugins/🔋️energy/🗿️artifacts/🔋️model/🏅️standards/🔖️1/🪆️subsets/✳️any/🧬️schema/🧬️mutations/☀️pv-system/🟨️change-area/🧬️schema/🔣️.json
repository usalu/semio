{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-pv-system-area/schema.json",
  "title": "ChangePvSystemArea",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newAreaM2"
  ],
  "properties": {
    "mutation": {
      "const": "changePvSystemArea"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "PV system",
          "de": "PV-Anlage"
        },
        "description": {
          "en": "The PV system this mutation changes, by id.",
          "de": "PV-Anlage, die diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "pvSystem"
        },
        "group": "target",
        "order": 10
      }
    },
    "newAreaM2": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Aperture area",
          "de": "Aperturfläche"
        },
        "unit": "m²",
        "step": 0.1,
        "precision": 2,
        "group": "geometry",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StatePvSystemAssignment",
    "branchType": "ModelGenerationState",
    "branch": "generation",
    "collection": "pv_systems",
    "field": "area_m2",
    "input": "new_area_m2",
    "key": "id",
    "labels": {
      "en": "Change pv system: Aperture area",
      "de": "Aperturfläche ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "pv-system",
      "kind": "change-pv-system-area",
      "record": "ChangedPvSystemArea"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "Aperture area violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed pv system does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The pv system already carries this aperture area value."
      }
    }
  }
}
