{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/create-time-series-schedule/schema.json",
  "title": "CreateTimeSeriesSchedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "id",
    "values",
    "timestepSeconds"
  ],
  "properties": {
    "mutation": {
      "const": "createTimeSeriesSchedule"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Insertion position in the model's list; 0 is first.",
          "de": "Einfügeposition in der Modellliste; 0 ist die erste."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "ID",
          "de": "ID"
        },
        "description": {
          "en": "Id the new time series schedule is created under; later mutations address it by this id.",
          "de": "ID, unter der das neue Objekt angelegt wird; spätere Mutationen adressieren es darüber."
        },
        "step": 1,
        "precision": 0,
        "group": "identity",
        "order": 20
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Values",
          "de": "Werte"
        },
        "description": {
          "en": "One value per timestep.",
          "de": "Ein Wert je Zeitschritt."
        },
        "group": "values",
        "order": 30
      }
    },
    "timestepSeconds": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Timestep",
          "de": "Zeitschritt"
        },
        "description": {
          "en": "Duration each value holds.",
          "de": "Dauer, für die jeder Wert gilt."
        },
        "unit": "s",
        "step": 60,
        "precision": 0,
        "group": "values",
        "order": 40
      }
    }
  },
  "x-semio-energy-row-birth": {
    "row": "StateTimeSeriesSchedule",
    "fields": [
      {
        "field": "id",
        "input": "id",
        "storage": "fixed"
      },
      {
        "field": "values",
        "input": "values",
        "storage": "sealed"
      },
      {
        "field": "timestep_seconds",
        "input": "timestep_seconds",
        "storage": "fixed"
      }
    ],
    "recreation": "exact"
  },
  "x-semio-energy-operation": {
    "category": "create-row",
    "row": "StateTimeSeriesSchedule",
    "branchType": "StateScheduleSet",
    "branch": "outputs",
    "nested": "schedules",
    "collection": "time_series",
    "key": "id",
    "inverse": "DeleteTimeSeriesSchedule",
    "labels": {
      "en": "Create schedule",
      "de": "Zeitplan erstellen"
    },
    "semantics": {
      "verb": "create",
      "entity": "schedule",
      "kind": "create-time-series-schedule",
      "record": "CreatedTimeSeriesSchedule"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "The schedule requires finite values and a positive timestep."
      },
      "duplicate": {
        "level": "fatal",
        "code": "mutation.duplicate-id",
        "message": "A schedule with this identity already exists."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The insertion rank is past the end of this schedule collection."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The schedule creation makes no change."
      }
    },
    "validationBeforeRank": false,
    "defaultRank": "explicit",
    "identityCollections": [
      "ConstantSchedules",
      "DailySchedules",
      "WeeklySchedules",
      "AnnualSchedules",
      "TimeSeriesSchedules"
    ],
    "rules": [
      {
        "input": "values",
        "kind": "finite-values"
      }
    ],
    "scalarOrder": "before-rules"
  }
}
