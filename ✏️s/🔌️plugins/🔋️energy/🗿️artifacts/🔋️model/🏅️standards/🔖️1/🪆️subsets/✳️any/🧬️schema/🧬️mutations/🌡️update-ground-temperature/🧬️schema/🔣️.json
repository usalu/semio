{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/update-ground-temperature/schema.json",
  "title": "UpdateGroundTemperature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "buildingSurfaceC",
    "shallowC",
    "deepC"
  ],
  "properties": {
    "mutation": {
      "const": "updateGroundTemperature"
    },
    "buildingSurfaceC": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 12,
      "maxItems": 12,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Building surface ground temperatures",
          "de": "Erdreichtemperaturen unter dem Gebäude"
        },
        "description": {
          "en": "Twelve monthly values, January first.",
          "de": "Zwölf Monatswerte, Januar zuerst."
        },
        "unit": "°C",
        "group": "ground",
        "order": 10
      }
    },
    "shallowC": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 12,
      "maxItems": 12,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Shallow ground temperatures",
          "de": "Oberflächennahe Erdreichtemperaturen"
        },
        "description": {
          "en": "Twelve monthly values, January first.",
          "de": "Zwölf Monatswerte, Januar zuerst."
        },
        "unit": "°C",
        "group": "ground",
        "order": 20
      }
    },
    "deepC": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Deep ground temperature",
          "de": "Erdreichtemperatur in der Tiefe"
        },
        "unit": "°C",
        "step": 0.5,
        "precision": 1,
        "group": "ground",
        "order": 30
      }
    }
  }
}
