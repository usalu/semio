{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/energy/model/mutation/change-fenestration-u-value/schema.json",
  "title": "ChangeFenestrationUValue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newUValueWM2k"
  ],
  "properties": {
    "mutation": {
      "const": "changeFenestrationUValue"
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The window this mutation changes, by id.",
          "de": "Fenster, das diese Mutation ändert, per ID."
        },
        "ref": {
          "kind": "fenestration",
          "domain": "energyModel",
          "granularity": "fenestration"
        },
        "group": "target",
        "order": 10
      }
    },
    "newUValueWM2k": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "U-value",
          "de": "U-Wert"
        },
        "description": {
          "en": "Thermal transmittance of the whole window.",
          "de": "Wärmedurchgangskoeffizient des gesamten Fensters."
        },
        "unit": "W/(m²·K)",
        "step": 0.01,
        "precision": 2,
        "group": "thermal",
        "order": 20
      }
    }
  },
  "x-semio-energy-operation": {
    "category": "scalar-row",
    "row": "StateFenestration",
    "branchType": "ModelGeometryState",
    "branch": "geometry",
    "collection": "fenestrations",
    "field": "u_value_w_m2k",
    "input": "new_u_value_w_m2k",
    "key": "id",
    "labels": {
      "en": "Change fenestration: U-value",
      "de": "U-Wert ändern"
    },
    "semantics": {
      "verb": "change",
      "entity": "fenestration",
      "kind": "change-fenestration-u-value",
      "record": "ChangedFenestrationUValue"
    },
    "diagnostics": {
      "invalid": {
        "level": "fatal",
        "code": "mutation.invariant",
        "message": "U-value violates its authored bounds."
      },
      "missing": {
        "level": "error",
        "code": "mutation.target-missing",
        "message": "The addressed fenestration does not exist."
      },
      "unchanged": {
        "level": "warning",
        "code": "mutation.no-op",
        "message": "The fenestration already carries this u-value value."
      }
    }
  }
}
