{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/norm-artifact-package-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["definition_version", "id", "artifact", "directory", "rust_package", "nx_project", "dependencies"],
  "properties": {
    "definition_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^s\\.norm\\.[a-z0-9]+$" },
    "artifact": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "directory": { "type": "string", "minLength": 1 },
    "rust_package": { "type": "string", "pattern": "^semio-s-artifact-norm-[a-z0-9]+$" },
    "nx_project": { "type": "string", "pattern": "^@semio-tech/norm-[a-z0-9]+-rs$" },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
