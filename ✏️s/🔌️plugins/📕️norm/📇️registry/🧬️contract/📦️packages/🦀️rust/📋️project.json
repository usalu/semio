{
  "name": "@semio-tech/norm-artifact-contract-rs",
  "$schema": "../../../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:contract",
    "family:norm"
  ],
  "namedInputs": {
    "nativeSources": [
      "{workspaceRoot}/✏️s/🔌️plugins/📕️norm/⚖️compliance/**/*.rs",
      "{workspaceRoot}/✏️s/🔌️plugins/📕️norm/🪟️results/🎚️config/**/*",
      "{workspaceRoot}/✏️s/🔌️plugins/📕️norm/🖥️app-surface/**/*.rs",
      "{workspaceRoot}/✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "repo:script",
      "options": {
        "cwd": "✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-byte-property": {
      "executor": "repo:script",
      "options": {
        "cwd": "✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-byte-property",
        "forwardAllArgs": true
      }
    },
    "test-definition-ownership": {
      "executor": "repo:script",
      "cache": false,
      "inputs": [
        "production",
        "^production",
        "nativeSources"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-definition-ownership",
        "forwardAllArgs": true
      }
    }
  }
}
