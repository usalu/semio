{
  "name": "@semio-tech/norm-artifact-contract-rs",
  "$schema": "../../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:contract",
    "family:norm"
  ],
  "namedInputs": {
    "nativeSources": [
      "{workspaceRoot}/✏️s/🔌️plugins/📕️norm/⚖️compliance/**/*.rs",
      "{workspaceRoot}/✏️s/🔌️plugins/📕️norm/🪟️results/🎚️config/**/*",
      "{workspaceRoot}/✏️s/🔌️plugins/📕️norm/🖥️app-surface/**/*.rs",
      "{workspaceRoot}/✏️s/🔌️plugins/📕️norm/🗿️artifacts/🦀️.rs",
      "{workspaceRoot}/✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/📕️norm/📇️registry/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
