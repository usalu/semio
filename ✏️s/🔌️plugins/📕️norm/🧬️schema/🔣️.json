{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/schema.json",
  "$defs": {
    "NormRetainedPublicationContract": {
      "title": "NormRetainedPublicationContract",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolId",
        "lanes"
      ],
      "properties": {
        "toolId": {
          "type": "string"
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "host-only",
              "artifact",
              "config",
              "draft",
              "presence",
              "transient",
              "child"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "NormRetainedRoute": {
      "title": "NormRetainedRoute",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "emittedLanes",
        "publicationLanes",
        "execution",
        "admission",
        "reducer"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "emittedLanes": {
          "type": "array",
          "items": {
            "enum": [
              "artifact",
              "config",
              "draft",
              "presence",
              "transient",
              "child",
              "host"
            ]
          },
          "uniqueItems": true
        },
        "publicationLanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "host-only",
              "artifact",
              "config",
              "draft",
              "presence",
              "transient",
              "child"
            ]
          },
          "uniqueItems": true
        },
        "execution": {
          "enum": [
            "bounded",
            "resumable",
            "placeholder"
          ]
        },
        "admission": {
          "const": "migrated"
        },
        "reducer": {
          "type": "string",
          "minLength": 24
        }
      }
    },
    "NormRetainedApp": {
      "title": "NormRetainedApp",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "controller",
        "documentSchema"
      ],
      "properties": {
        "variant": {
          "type": "string"
        },
        "controller": {
          "type": "string"
        },
        "documentSchema": {
          "type": "string"
        }
      }
    },
    "NormArtifactPackageDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_version",
        "id",
        "artifact",
        "directory",
        "rust_package",
        "nx_project",
        "dependencies"
      ],
      "properties": {
        "definition_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^s\\.norm\\.[a-z0-9]+$"
        },
        "artifact": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "rust_package": {
          "type": "string",
          "pattern": "^semio-s-artifact-norm-[a-z0-9]+$"
        },
        "nx_project": {
          "type": "string",
          "pattern": "^@semio-tech/norm-[a-z0-9]+-rs$"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "title": "NormArtifactPackageDefinition",
      "description": "📕️ One norm artifact package definition row: its scope id, artifact slug, directory, Rust package, nx project and declared dependencies."
    }
  },
  "$ref": "#/$defs/NormRetainedRoute"
}
