{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/compliance/design-case/mutations.json",
  "title": "DesignCaseMutations",
  "description": "Payloads of the four shared design-case mutation kinds; every artifact leaf payload schema is a $ref to one definition. Row types are the definitions of ../🔣️.json (CaseRow, CaseNumber, CaseText).",
  "definitions": {
    "AddCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "case"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Position",
              "de": "Position"
            },
            "step": 1,
            "precision": 0,
            "group": "target",
            "order": 10
          }
        },
        "case": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/compliance/design-case/schema.json#/definitions/CaseRow",
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Design case",
              "de": "Bemessungsfall"
            },
            "group": "record",
            "order": 20
          }
        }
      }
    },
    "ChangeCaseNumber": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "key",
        "value"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Design case",
              "de": "Bemessungsfall"
            },
            "ref": {
              "kind": "case"
            },
            "group": "target",
            "order": 10
          }
        },
        "key": {
          "type": "string",
          "x-semio-ui": {
            "role": "target",
            "label": {
              "en": "Input",
              "de": "Eingabe"
            },
            "group": "target",
            "order": 20
          }
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Value (empty removes the input)",
              "de": "Wert (leer entfernt die Eingabe)"
            },
            "group": "value",
            "order": 30
          }
        }
      }
    },
    "ChangeCaseText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "key",
        "value"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Design case",
              "de": "Bemessungsfall"
            },
            "ref": {
              "kind": "case"
            },
            "group": "target",
            "order": 10
          }
        },
        "key": {
          "type": "string",
          "x-semio-ui": {
            "role": "target",
            "label": {
              "en": "Input",
              "de": "Eingabe"
            },
            "group": "target",
            "order": 20
          }
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Value (empty removes the input)",
              "de": "Wert (leer entfernt die Eingabe)"
            },
            "group": "value",
            "order": 30
          }
        }
      }
    },
    "RemoveCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "target",
            "label": {
              "en": "Position",
              "de": "Position"
            },
            "step": 1,
            "precision": 0,
            "group": "target",
            "order": 10
          }
        }
      }
    }
  }
}
