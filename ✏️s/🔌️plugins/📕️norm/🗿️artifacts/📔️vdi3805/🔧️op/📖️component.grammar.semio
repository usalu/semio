dialect grammar
grammar vdi3805.op
extension vdi3805
use family-sheet
start operation

artifact-mark = "norm.vdi3805-op"
operation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("vdi3805-basis" | "vdi3805-combination" | "vdi3805-partial-factor" | "vdi3805-verdict" | "vdi3805-annex" | "vdi3805-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
