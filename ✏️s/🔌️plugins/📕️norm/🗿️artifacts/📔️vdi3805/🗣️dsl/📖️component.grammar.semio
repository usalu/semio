dialect grammar
grammar vdi3805.document
extension vdi3805
use family-sheet
start document

artifact-mark = "norm.vdi3805"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("vdi3805-basis" | "vdi3805-combination" | "vdi3805-partial-factor" | "vdi3805-verdict" | "vdi3805-annex" | "vdi3805-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
