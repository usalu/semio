dialect grammar
grammar vdi3805.diff
extension vdi3805
use family-sheet
start diff

artifact-mark = "norm.vdi3805-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("vdi3805-basis" | "vdi3805-combination" | "vdi3805-partial-factor" | "vdi3805-verdict" | "vdi3805-annex" | "vdi3805-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
