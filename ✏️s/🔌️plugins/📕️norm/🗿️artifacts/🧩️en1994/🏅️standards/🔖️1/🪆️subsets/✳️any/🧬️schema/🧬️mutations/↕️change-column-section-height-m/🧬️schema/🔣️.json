{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1994/mutation/change-column-section-height-m/schema.json",
  "title": "ChangeColumnSectionHeightM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newSectionHeightM"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Composite column",
          "de": "Verbundstütze"
        },
        "description": {
          "en": "The composite column this mutation addresses, by id.",
          "de": "Das adressierte Element (Verbundstütze), per Kennung."
        },
        "ref": {
          "kind": "column"
        },
        "group": "target",
        "order": 10
      }
    },
    "newSectionHeightM": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Height of the encased I-section (0 = equivalent section from the area)",
          "de": "Höhe des einbetonierten I-Profils (0 = Ersatzquerschnitt aus der Fläche)"
        },
        "unit": "m",
        "step": 0.01,
        "precision": 3,
        "group": "column",
        "order": 20
      }
    }
  }
}
