{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1994/mutation/change-column-introduced-force-n/schema.json",
  "title": "ChangeColumnIntroducedForceN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newIntroducedForceN"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Composite column",
          "de": "Verbundstütze"
        },
        "description": {
          "en": "The composite column this mutation addresses, by id.",
          "de": "Das adressierte Element (Verbundstütze), per Kennung."
        },
        "ref": {
          "kind": "column"
        },
        "group": "target",
        "order": 10
      }
    },
    "newIntroducedForceN": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Force introduced into the concrete (0 = from the actions)",
          "de": "in den Beton eingeleitete Kraft (0 = aus den Einwirkungen)"
        },
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "step": 1000,
        "precision": 1,
        "group": "column",
        "order": 20
      }
    }
  }
}
