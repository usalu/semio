cases [id:TEXT label-en:TEXT label-de:TEXT entry-id:TEXT numbers:TABLE texts:TABLE] {
  case-c94-01 "Headed stud resistance with profiled sheeting" "Dübeltragfähigkeit mit Profilblech" C94-01 [ {id=b_0 value=0.1} {id=d_stud value=0.019} {id=fck value=25000000} {id=fu_stud value=450000000} {id=gamma_v value=1.25} {id=h_p value=0.06} {id=h_sc value=0.125} {id=n_r value=1} {id=p_ed value=60000} {id=t_sheet value=0.001} ] [ {id=ribs value=transverse} ]
  case-c94-02 "Patch loading of a web with bending interaction" "Lasteinleitung in den Steg mit Biegeinteraktion" C94-02 [ {id=a_panel value=2} {id=b_f value=0.2} {id=f_ed value=150000} {id=fyf value=355000000} {id=fyw value=355000000} {id=gamma_m1 value=1} {id=h_w value=0.5} {id=m_ed value=100000} {id=m_rd value=400000} {id=s_s value=0.1} {id=t_f value=0.015} {id=t_w value=0.01} ] [ ]
  case-c94-03 "Load introduction into a composite column" "Lasteinleitung in eine Verbundstütze" C94-03 [ {id=d_min value=0.3} {id=l_col value=3.5} {id=n_intro value=150000} {id=p_rd value=80000} {id=perimeter value=1.2} ] [ {id=kind value=concrete_encased} ]
  case-c94-04 "Deflection of a simply supported composite beam" "Durchbiegung eines Verbundträgers als Einfeldträger" C94-04 [ {id=g_line value=10000} {id=i_long value=0.0004} {id=i_short value=0.0006} {id=l_span value=8} {id=q_line value=15000} {id=span_ratio value=250} ] [ ]
  case-c94-05 "Deflection of a two-span composite beam" "Durchbiegung eines zweifeldrigen Verbundträgers" C94-05 [ {id=g_line value=10000} {id=i_long value=0.0004} {id=i_short value=0.0006} {id=l_span value=8} {id=q_line value=15000} {id=span_ratio value=250} ] [ ]
  case-c94-06 "Steel strength at elevated temperature" "Stahlfestigkeit bei erhöhter Temperatur" C94-06 [ {id=fy value=355000000} {id=sigma_ed value=100000000} {id=theta_a value=550} ] [ ]
  case-c94-07 "Sagging plastic moment resistance with full shear connection" "Plastische Momententragfähigkeit im Feld bei vollständiger Verdübelung" C94-07 [ {id=b_eff value=2} {id=fck value=25000000} {id=fyd value=355000000} {id=gamma_c value=1.5} {id=h_c value=0.12} {id=m_ed value=100000} {id=sec_a value=0.0085} {id=sec_b value=0.18} {id=sec_h value=0.4} {id=sec_iy value=0.000231} {id=sec_tf value=0.0135} {id=sec_tw value=0.0086} {id=ys value=0.15} ] [ ]
  case-c94-08 "Hogging plastic moment resistance" "Plastische Momententragfähigkeit über der Stütze" C94-08 [ {id=as_rebar value=0.004} {id=fsd value=435000000} {id=fyd value=355000000} {id=m_ed value=100000} {id=sec_a value=0.0085} {id=sec_b value=0.18} {id=sec_h value=0.4} {id=sec_iy value=0.000231} {id=sec_tf value=0.0135} {id=sec_tw value=0.0086} {id=y_r value=0.04} {id=ys value=0.15} ] [ ]
