{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1994/mutation/change-beam-construction/schema.json",
  "title": "ChangeBeamConstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "newConstruction"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Composite beam",
          "de": "Verbundträger"
        },
        "description": {
          "en": "Zero-based position of the composite beam in its list.",
          "de": "Nullbasierte Position des Verbundträgers in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "newConstruction": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Construction method",
          "de": "Herstellungsart"
        },
        "description": {
          "en": "propped or unpropped construction.",
          "de": "propped (mit Montageunterstützung) oder unpropped (ohne Montageunterstützung)."
        },
        "group": "beam",
        "order": 20
      }
    }
  }
}
