{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1994/mutation/change-beam-construction/schema.json",
  "title": "ChangeBeamConstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newConstruction"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Composite beam",
          "de": "Verbundträger"
        },
        "description": {
          "en": "The composite beam this mutation addresses, by id.",
          "de": "Das adressierte Element (Verbundträger), per Kennung."
        },
        "ref": {
          "kind": "beam"
        },
        "group": "target",
        "order": 10
      }
    },
    "newConstruction": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1994/snapshot.json#/$defs/ConstructionMethod",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Construction method",
          "de": "Herstellungsart"
        },
        "description": {
          "en": "propped or unpropped construction.",
          "de": "propped (mit Montageunterstützung) oder unpropped (ohne Montageunterstützung)."
        },
        "group": "beam",
        "order": 20
      }
    }
  }
}
