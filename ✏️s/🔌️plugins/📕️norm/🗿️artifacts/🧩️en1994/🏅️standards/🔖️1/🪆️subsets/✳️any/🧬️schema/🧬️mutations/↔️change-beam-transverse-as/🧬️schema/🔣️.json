{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1994/mutation/change-beam-transverse-as/schema.json",
  "title": "ChangeBeamTransverseAs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newTransverseAsM2PerM"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Composite beam",
          "de": "Verbundträger"
        },
        "description": {
