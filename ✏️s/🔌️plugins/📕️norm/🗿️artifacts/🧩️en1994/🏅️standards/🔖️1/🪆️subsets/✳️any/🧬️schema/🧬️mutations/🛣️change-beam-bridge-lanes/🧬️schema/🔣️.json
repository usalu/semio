{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1994/mutation/change-beam-bridge-lanes/schema.json",
  "title": "ChangeBeamBridgeLanes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newBridgeLanes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Composite beam",
          "de": "Verbundträger"
        },
        "description": {
          "en": "The composite beam this mutation addresses, by id.",
          "de": "Das adressierte Element (Verbundträger), per Kennung."
