    "newBridgeLanes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Notional lanes loading the girder (0 = from the girder spacing)",
          "de": "rechnerische Fahrstreifen am Träger (0 = aus dem Trägerabstand)"
        },
        "step": 1,
        "precision": 0,
        "group": "beam",
        "order": 20
      }
