{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1994/mutation/change-slab-action-xm/schema.json",
  "title": "ChangeSlabActionXM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slabId",
    "id",
    "newXM"
  ],
  "properties": {
    "slabId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Slab",
          "de": "Decke"
        },
        "description": {
          "en": "The slab this mutation addresses, by id.",
          "de": "Das adressierte Element (Decke), per Kennung."
        },
        "ref": {
          "kind": "slab"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Slab action",
          "de": "Deckeneinwirkung"
        },
        "description": {
          "en": "The slab action this mutation addresses, by id.",
          "de": "Das adressierte Element (Deckeneinwirkung), per Kennung."
        },
        "ref": {
          "kind": "action"
        },
        "group": "target",
        "order": 20
      }
    },
    "newXM": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Slab position of the point force along the span",
          "de": "Deckeneinwirkung: Position der Einzellast entlang der Spannweite"
        },
        "widget": "stepper",
        "unit": "m",
        "step": 0.05,
        "precision": 2,
        "role": "value",
        "group": "value",
        "order": 30
      }
    }
  }
}
