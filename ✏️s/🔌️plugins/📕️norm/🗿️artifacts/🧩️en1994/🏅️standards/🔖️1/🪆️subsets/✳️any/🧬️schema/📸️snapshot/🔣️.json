        "support": {
          "type": "string"
        },
        "construction": {
          "type": "string"
        },
        "steel": {
          "$ref": "#/definitions/SteelSection"
        },
        "slabThicknessM": {
          "type": "number"
        },
        "concreteFCkPa": {
          "type": "number"
        },
        "concreteECmPa": {
          "type": "number"
        },
        "sheeting": {
          "$ref": "#/definitions/ProfiledSheeting"
        },
        "studs": {
          "$ref": "#/definitions/HeadedStuds"
        },
