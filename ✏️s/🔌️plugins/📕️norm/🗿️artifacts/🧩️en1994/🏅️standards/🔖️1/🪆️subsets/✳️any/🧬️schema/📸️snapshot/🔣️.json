        "steelFYPa": {
          "type": "number"
        },
        "concreteAM2": {
          "type": "number"
        },
        "concreteFCkPa": {
          "type": "number"
        },
        "reinforcementAsM2": {
          "type": "number"
        },
        "reinforcementFYkPa": {
          "type": "number"
        },
        "iM4": {
          "type": "number"
