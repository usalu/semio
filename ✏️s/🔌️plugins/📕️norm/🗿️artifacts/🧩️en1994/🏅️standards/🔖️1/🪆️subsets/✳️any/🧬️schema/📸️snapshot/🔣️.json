    "annex",
    "structureKind",
    "steelFYPa",
    "beams",
    "columns",
    "slabs",
    "fireRating",
    "insulationThicknessM",
    "fatigueDetail"
  ],
  "properties": {
    "annex": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "structureKind": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "steelFYPa": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "beams": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CompositeBeam"
      },
      "x-semio-state": "artifact"
    },
    "columns": {
      "type": "array",
