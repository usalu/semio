{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1994/snapshot.json",
  "title": "En1994Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex",
    "structureKind",
    "steelFYPa",
    "beams",
    "columns",
    "slabs",
    "fireRating",
    "insulationThicknessM",
    "fatigueDetail"
  ],
  "properties": {
    "annex": {
      "$ref": "#/$defs/AnnexChoice",
      "x-semio-state": "artifact"
    },
    "structureKind": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "steelFYPa": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "beams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CompositeBeam"
      },
      "x-semio-state": "artifact"
    },
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CompositeColumn"
      },
      "x-semio-state": "artifact"
    },
    "slabs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CompositeSlab"
      },
      "x-semio-state": "artifact"
    },
    "fireRating": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "insulationThicknessM": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "fatigueDetail": {
      "type": "string",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "CharacteristicAction": {
      "title": "CharacteristicAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "category",
        "stage",
        "qAreaPa",
        "fKN",
        "deltaSigmaKPa",
        "deltaTauKPa"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Action category",
              "de": "Einwirkungskategorie"
            },
            "description": {
              "en": "self_steel, wet_concrete, finishes, A–H, flm3 …",
              "de": "self_steel, wet_concrete, finishes, A–H, flm3 …"
            },
            "widget": "text"
          }
        },
        "stage": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Construction stage",
              "de": "Bauzustand"
            },
            "description": {
              "en": "construction or composite.",
              "de": "construction (Bauzustand) oder composite (Verbundzustand)."
            },
            "widget": "text"
          }
        },
        "qAreaPa": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Action",
              "de": "Einwirkung"
            },
            "description": {
              "en": "Zero-based position of the characteristic action in the member's list.",
              "de": "Nullbasierte Position der charakteristischen Einwirkung in der Liste des Bauteils."
            },
            "step": 1,
            "precision": 0
          }
        },
        "fKN": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Concentrated force F_k",
              "de": "Einzellast F_k"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        },
        "deltaSigmaKPa": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Stress range Δσ_k",
              "de": "Spannungsschwingbreite Δσ_k"
            },
            "widget": "stepper",
            "unit": "Pa",
            "displayUnit": "N/mm²",
            "displayFactor": 1e-06,
            "precision": 1
          }
        },
        "deltaTauKPa": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Shear stress range Δτ_k",
              "de": "Schubspannungsschwingbreite Δτ_k"
            },
            "widget": "stepper",
            "unit": "Pa",
            "displayUnit": "N/mm²",
            "displayFactor": 1e-06,
            "precision": 1
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "SteelSection": {
      "title": "SteelSection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designation",
        "heightM",
        "widthM",
        "twM",
        "tfM",
        "aM2",
        "wPlYM3",
        "iYM4",
        "aVM2"
      ],
      "properties": {
        "designation": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Section designation",
              "de": "Profilbezeichnung"
            },
            "widget": "text"
          }
        },
        "heightM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Section depth h",
              "de": "Profilhöhe h"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "widthM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Flange width b",
              "de": "Flanschbreite b"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "twM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Web thickness t_w",
              "de": "Stegdicke t_w"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "tfM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Flange thickness t_f",
              "de": "Flanschdicke t_f"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "aM2": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Cross-sectional area A_a",
              "de": "Querschnittsfläche A_a"
            },
            "widget": "stepper",
            "unit": "m²",
            "displayUnit": "cm²",
            "displayFactor": 10000.0,
            "precision": 2
          }
        },
        "wPlYM3": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Plastic section modulus W_pl,y",
              "de": "Plastisches Widerstandsmoment W_pl,y"
            },
            "widget": "stepper",
            "unit": "m³",
            "displayUnit": "cm³",
            "displayFactor": 1000000.0,
            "precision": 0
          }
        },
        "iYM4": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Second moment of area I_y",
              "de": "Flächenträgheitsmoment I_y"
            },
            "widget": "stepper",
            "unit": "m⁴",
            "displayUnit": "cm⁴",
            "displayFactor": 100000000.0,
            "precision": 0
          }
        },
        "aVM2": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Shear area A_v",
              "de": "Schubfläche A_v"
            },
            "widget": "stepper",
            "unit": "m²",
            "displayUnit": "cm²",
            "displayFactor": 10000.0,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "ProfiledSheeting": {
      "title": "ProfiledSheeting",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "heightM",
        "ribWidthM",
        "thicknessM",
        "ribsParallelToBeam"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Profile type",
              "de": "Profilform"
            },
            "description": {
              "en": "trapezoidal or re-entrant.",
              "de": "trapezförmig oder hinterschnitten."
            },
            "widget": "text"
          }
        },
        "heightM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Profile height h_p",
              "de": "Profilhöhe h_p"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "ribWidthM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Rib width b₀",
              "de": "Rippenbreite b₀"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "thicknessM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Sheet thickness t",
              "de": "Blechdicke t"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "ribsParallelToBeam": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Ribs parallel to the beam",
              "de": "Rippen parallel zum Träger"
            },
            "widget": "toggle"
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "HeadedStuds": {
      "title": "HeadedStuds",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diameterM",
        "heightM",
        "fUPa",
        "countPerRib",
        "spacingM",
        "totalCount"
      ],
      "properties": {
        "diameterM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Shank diameter of the headed stud d",
              "de": "Schaftdurchmesser des Kopfbolzendübels d"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.001,
            "precision": 0
          }
        },
        "heightM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Stud height h_sc",
              "de": "Dübelhöhe h_sc"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "fUPa": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Ultimate tensile strength of the stud f_u",
              "de": "Zugfestigkeit des Kopfbolzendübels f_u"
            },
            "unit": "Pa",
            "displayUnit": "N/mm²",
            "displayFactor": 1e-06,
            "step": 5000000.0,
            "precision": 0
          }
        },
        "countPerRib": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Studs per rib n_r",
              "de": "Dübel je Rippe n_r"
            },
            "widget": "stepper",
            "step": 1,
            "precision": 0
          },
          "maximum": 4294967295
        },
        "spacingM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Headed stud spacing e_L",
              "de": "Dübelabstand in Längsrichtung e_L"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.005,
            "precision": 0
          }
        },
        "totalCount": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Number of headed studs n",
              "de": "Anzahl der Kopfbolzendübel n"
            },
            "step": 1,
            "precision": 0
          },
          "maximum": 4294967295
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "CompositeBeam": {
      "title": "CompositeBeam",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "spanM",
        "spacingM",
        "support",
        "construction",
        "steel",
        "slabThicknessM",
        "concreteFCkPa",
        "concreteECmPa",
        "sheeting",
        "studs",
        "transverseAsM2PerM",
        "ltbLengthM",
        "asHoggingM2PerM",
        "barSpacingM",
        "wkLimitM",
        "nCycles",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "spanM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Beam span L",
              "de": "Stützweite des Trägers L"
            },
            "unit": "m",
            "step": 0.05,
            "precision": 2
          }
        },
        "spacingM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Headed stud spacing e_L",
              "de": "Dübelabstand in Längsrichtung e_L"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.005,
            "precision": 0
          }
        },
        "support": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Support conditions",
              "de": "Lagerungsbedingungen"
            },
            "description": {
              "en": "simply_supported or continuous_2_span.",
              "de": "simply_supported (Einfeldträger) oder continuous_2_span (Zweifeldträger)."
            },
            "widget": "text"
          }
        },
        "construction": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Construction method",
              "de": "Herstellungsart"
            },
            "description": {
              "en": "propped or unpropped construction.",
              "de": "propped (mit Montageunterstützung) oder unpropped (ohne Montageunterstützung)."
            }
          }
        },
        "steel": {
          "$ref": "#/$defs/SteelSection",
          "x-semio-ui": {
            "label": {
              "en": "Steel section",
              "de": "Stahlprofil"
            }
          }
        },
        "slabThicknessM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Concrete flange thickness h_c",
              "de": "Dicke des Betongurts h_c"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.005,
            "precision": 0
          }
        },
        "concreteFCkPa": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Concrete strength f_ck",
              "de": "Betondruckfestigkeit f_ck"
            },
            "widget": "stepper",
            "unit": "Pa",
            "displayUnit": "N/mm²",
            "displayFactor": 1e-06,
            "precision": 1
          }
        },
        "concreteECmPa": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Concrete modulus E_cm",
              "de": "Elastizitätsmodul des Betons E_cm"
            },
            "widget": "stepper",
            "unit": "Pa",
            "displayUnit": "N/mm²",
            "displayFactor": 1e-06,
            "precision": 1
          }
        },
        "sheeting": {
          "$ref": "#/$defs/ProfiledSheeting",
          "x-semio-ui": {
            "label": {
              "en": "Profiled steel sheeting",
              "de": "Profilblech"
            }
          }
        },
        "studs": {
          "$ref": "#/$defs/HeadedStuds",
          "x-semio-ui": {
            "label": {
              "en": "Headed stud shear connectors",
              "de": "Kopfbolzendübel"
            }
          }
        },
        "transverseAsM2PerM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Transverse reinforcement A_sf/s_f",
              "de": "Querbewehrung A_sf/s_f"
            },
            "unit": "m²/m",
            "displayUnit": "cm²/m",
            "displayFactor": 10000,
            "step": 1e-05,
            "precision": 2
          }
        },
        "ltbLengthM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Lateral-torsional buckling length L_LT",
              "de": "Kipplänge L_LT"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "asHoggingM2PerM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Hogging reinforcement A_s",
              "de": "Stützbewehrung A_s"
            },
            "widget": "stepper",
            "unit": "m²/m",
            "displayUnit": "cm²/m",
            "displayFactor": 10000.0,
            "precision": 2
          }
        },
        "barSpacingM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Bar spacing s",
              "de": "Stababstand s"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "wkLimitM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Crack width limit w_k",
              "de": "Grenzwert der Rissbreite w_k"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "nCycles": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Number of stress cycles N",
              "de": "Lastspielzahl N"
            },
            "widget": "stepper",
            "precision": 0
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacteristicAction"
          },
          "x-semio-ui": {
            "label": {
              "en": "Characteristic actions",
              "de": "Charakteristische Einwirkungen"
            }
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "CompositeColumn": {
      "title": "CompositeColumn",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "lengthM",
        "outerSizeM",
        "wallThicknessM",
        "steelAM2",
        "steelFYPa",
        "concreteAM2",
        "concreteFCkPa",
        "reinforcementAsM2",
        "reinforcementFYkPa",
        "iM4",
        "bucklingCurve",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Column type",
              "de": "Stützentyp"
            },
            "description": {
              "en": "encased, concrete_filled or partially_encased (EN 1994-1-1 Figure 6.17).",
              "de": "encased (vollständig einbetoniert), concrete_filled (ausbetoniertes Hohlprofil) oder partially_encased (teilweise einbetoniert) nach EN 1994-1-1 Bild 6.17."
            }
          }
        },
        "lengthM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Column length L",
              "de": "Stützenlänge L"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "outerSizeM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Outer diameter or side length",
              "de": "Außendurchmesser oder Seitenlänge"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "wallThicknessM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Wall thickness t",
              "de": "Wanddicke t"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "steelAM2": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Steel area A_a",
              "de": "Stahlfläche A_a"
            },
            "widget": "stepper",
            "unit": "m²",
            "displayUnit": "cm²",
            "displayFactor": 10000.0,
            "precision": 2
          }
        },
        "steelFYPa": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Yield strength of structural steel f_y",
              "de": "Streckgrenze des Baustahls f_y"
            },
            "unit": "Pa",
            "displayUnit": "N/mm²",
            "displayFactor": 1e-06,
            "step": 5000000.0,
            "precision": 0
          }
        },
        "concreteAM2": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Concrete area A_c",
              "de": "Betonfläche A_c"
            },
            "widget": "stepper",
