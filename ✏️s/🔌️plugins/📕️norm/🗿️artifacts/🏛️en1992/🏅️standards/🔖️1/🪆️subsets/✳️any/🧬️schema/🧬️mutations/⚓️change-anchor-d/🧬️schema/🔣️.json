{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/mutation/change-anchor-d/schema.json",
  "title": "ChangeAnchorD",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchorId",
    "newD"
  ],
  "properties": {
    "anchorId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Anchor",
          "de": "Dübel"
        },
        "description": {
          "en": "The anchor this mutation addresses, by id.",
          "de": "Das adressierte Element (Dübel), per Kennung."
        },
        "ref": {
          "kind": "anchor"
        },
        "group": "target",
        "order": 10
      }
    },
    "newD": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Anchor diameter d",
          "de": "Dübeldurchmesser d"
        },
        "widget": "stepper",
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "precision": 1,
        "step": 0.001,
        "snaps": [
          0.006,
          0.008,
          0.01,
          0.012,
          0.016,
          0.02,
          0.024,
          0.027,
          0.03
        ],
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
