{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/mutation/change-member-bearing-width/schema.json",
  "title": "ChangeMemberBearingWidth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memberId",
    "newValue"
  ],
  "properties": {
    "memberId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Member",
          "de": "Bauteil"
        },
        "description": {
          "en": "The reinforced concrete member this mutation addresses.",
          "de": "Das Stahlbetonbauteil, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "member"
        },
        "group": "target",
        "order": 10
      }
    },
    "newValue": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Bearing plate width a (0 = not given)",
          "de": "Auflagerplattenbreite a (0 = nicht angegeben)"
        },
        "snaps": [
          0.5,
          0.8
        ],
        "group": "member",
        "order": 20,
        "unit": "m",
        "precision": 0,
        "step": 0.005
      }
    }
  }
}
