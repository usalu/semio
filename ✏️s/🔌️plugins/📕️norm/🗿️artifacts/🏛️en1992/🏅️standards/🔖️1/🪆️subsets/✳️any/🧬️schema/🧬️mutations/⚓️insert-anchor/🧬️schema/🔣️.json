{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/mutation/insert-anchor/schema.json",
  "title": "InsertAnchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "anchor"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "anchor": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/snapshot.json#/$defs/Anchor",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Anchor",
          "de": "Dübel"
        },
        "description": {
          "en": "The complete anchor record (EN 1992-4) to insert.",
          "de": "Der vollständige einzufügende Dübeldatensatz (EN 1992-4)."
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
