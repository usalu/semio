{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/mutation/change-anchor-as/schema.json",
  "title": "ChangeAnchorAs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchorId",
    "newValue"
  ],
  "properties": {
    "anchorId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Anchor",
          "de": "Dübel"
        },
        "description": {
          "en": "The post-installed anchor this mutation addresses.",
          "de": "Der Dübel, den diese Mutation adressiert."
        },
        "ref": {
          "kind": "anchor"
        },
        "group": "target",
        "order": 10
      }
    },
    "newValue": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Stressed cross-section A_s",
          "de": "Spannungsquerschnitt A_s"
        },
        "unit": "m²",
        "displayUnit": "cm²",
        "displayFactor": 10000,
        "step": 1e-06,
        "precision": 2,
        "group": "anchor",
        "order": 20
      }
    }
  }
}
