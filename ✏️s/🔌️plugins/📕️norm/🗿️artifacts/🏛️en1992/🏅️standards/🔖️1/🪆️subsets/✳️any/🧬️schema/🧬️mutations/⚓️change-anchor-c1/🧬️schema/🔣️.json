{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/mutation/change-anchor-c1/schema.json",
  "title": "ChangeAnchorC1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchorId",
    "newC1"
  ],
  "properties": {
    "anchorId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Anchor",
          "de": "Dübel"
        },
        "description": {
          "en": "The anchor this mutation addresses, by id.",
          "de": "Das adressierte Element (Dübel), per Kennung."
        },
        "ref": {
          "kind": "anchor"
        },
        "group": "target",
        "order": 10
      }
    },
    "newC1": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Edge distance c₁",
          "de": "Randabstand c₁"
        },
        "widget": "stepper",
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "precision": 1,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
