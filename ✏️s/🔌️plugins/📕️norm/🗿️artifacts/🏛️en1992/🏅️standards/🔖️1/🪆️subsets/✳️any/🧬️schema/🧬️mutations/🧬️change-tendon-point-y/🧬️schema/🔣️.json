{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/mutation/change-tendon-point-y/schema.json",
  "title": "ChangeTendonPointY",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memberId",
    "tendonPointId",
    "newY"
  ],
  "properties": {
    "memberId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Member",
          "de": "Bauteil"
        },
        "description": {
          "en": "The member this mutation addresses, by id.",
          "de": "Das adressierte Element (Bauteil), per Kennung."
        },
        "ref": {
          "kind": "member"
        },
        "group": "target",
        "order": 10
      }
    },
    "tendonPointId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tendon point",
          "de": "Spanngliedpunkt"
        },
        "description": {
          "en": "The tendon point this mutation addresses, by id.",
          "de": "Das adressierte Element (Spanngliedpunkt), per Kennung."
        },
        "ref": {
          "kind": "tendon-point"
        },
        "group": "target",
        "order": 20
      }
    },
    "newY": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Coordinate y",
          "de": "Koordinate y"
        },
        "widget": "stepper",
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "precision": 1,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 30
      }
