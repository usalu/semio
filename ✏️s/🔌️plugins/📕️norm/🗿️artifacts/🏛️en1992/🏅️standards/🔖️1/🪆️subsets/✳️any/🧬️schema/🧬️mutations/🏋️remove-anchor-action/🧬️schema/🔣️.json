{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/mutation/remove-anchor-action/schema.json",
  "title": "RemoveAnchorAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchorId",
    "index"
  ],
  "properties": {
    "anchorId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Anchor",
          "de": "Dübel"
        },
        "description": {
          "en": "The anchor this mutation addresses, by id.",
          "de": "Das adressierte Element (Dübel), per Kennung."
        },
        "ref": {
          "kind": "anchor"
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "target",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based position of the anchor action to remove.",
          "de": "Nullbasierte Position des zu entfernenden Elements (Dübeleinwirkung)."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  }
}
