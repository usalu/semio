    "Stirrups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diameter",
        "spacing",
        "legs"
      ],
      "properties": {
        "diameter": {
          "type": "number"
        },
        "spacing": {
          "type": "number"
        },
        "legs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PunchingSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columnWidth",
        "columnDepth",
        "columnPosition",
        "asw"
      ],
      "properties": {
        "columnWidth": {
          "type": "number"
        },
        "columnDepth": {
          "type": "number"
        },
        "columnPosition": {
          "type": "string"
        },
        "asw": {
          "type": "number"
        }
      }
    },
    "PrestressSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "force",
        "area",
        "eccentricity",
        "lossRatio"
      ],
      "properties": {
        "force": {
          "type": "number"
        },
        "area": {
          "type": "number"
        },
        "eccentricity": {
          "type": "number"
        },
        "lossRatio": {
          "type": "number"
        }
