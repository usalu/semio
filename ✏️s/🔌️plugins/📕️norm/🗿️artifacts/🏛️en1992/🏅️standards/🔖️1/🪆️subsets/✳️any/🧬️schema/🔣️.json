    "RcMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelEn",
        "labelDe",
        "kind",
        "concreteGradeId",
        "reinforcementGradeId",
        "prestressSteelId",
        "exposure",
        "width",
        "height",
        "effectiveDepth",
        "cover",
        "span",
        "support",
        "bucklingLength",
        "longitudinal",
        "actions",
        "useFem",
        "udl",
        "deflectionSensitive",
        "hdOverH",
        "liquidSigmaS",
        "liquidRhoPEff",
        "liquidFCtEff",
