        "labelEn": {
          "type": "string"
        },
        "labelDe": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "concreteGradeId": {
          "type": "string"
        },
        "reinforcementGradeId": {
          "type": "string"
        },
        "prestressSteelId": {
          "type": "string"
        },
        "exposure": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "effectiveDepth": {
          "type": "number"
        },
        "cover": {
          "type": "number"
        },
        "span": {
          "type": "number"
        },
        "support": {
          "type": "string"
        },
        "bucklingLength": {
          "type": "number"
        },
        "longitudinal": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BarLayer"
          }
        },
        "stirrups": {
          "anyOf": [
            {
              "$ref": "#/definitions/Stirrups"
            },
            {
              "type": "null"
            }
          ]
        },
        "punching": {
          "anyOf": [
            {
              "$ref": "#/definitions/PunchingSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "prestress": {
          "anyOf": [
            {
              "$ref": "#/definitions/PrestressSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "fire": {
          "anyOf": [
            {
              "$ref": "#/definitions/FireSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoadCaseActions"
          }
        },
        "useFem": {
          "type": "boolean"
        },
        "udl": {
          "type": "number"
        },
        "tightness": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hdOverH": {
          "type": "number"
        },
        "liquidSigmaS": {
          "type": "number"
        },
        "liquidRhoPEff": {
          "type": "number"
        },
        "liquidFCtEff": {
          "type": "number"
        },
        "liquidSRMax": {
          "type": "number"
        },
        "bridgeSigmaC": {
