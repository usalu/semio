        "epsC2",
        "epsCu2",
        "epsC3",
        "epsCu3",
        "nParabola"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fCk": {
          "type": "number"
        },
        "fCkCube": {
          "type": "number"
        },
        "fCm": {
          "type": "number"
        },
        "fCtm": {
          "type": "number"
        },
        "fCtk005": {
          "type": "number"
        },
        "eCm": {
          "type": "number"
        },
        "epsC2": {
          "type": "number"
        },
        "epsCu2": {
          "type": "number"
        },
        "epsC3": {
          "type": "number"
        },
        "epsCu3": {
          "type": "number"
        },
        "nParabola": {
          "type": "number"
        }
      }
    },
    "ReinforcementGrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fYk",
        "eS",
        "k",
        "epsUk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fYk": {
          "type": "number"
        },
        "eS": {
          "type": "number"
        },
        "k": {
          "type": "number"
        },
        "epsUk": {
          "type": "number"
        }
      }
