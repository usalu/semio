{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/artifact.json",
  "title": "En1992Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex",
    "title",
    "designWorkingLifeYears",
    "deltaCDev",
    "cementType",
    "concreteGrades",
    "reinforcementGrades",
    "prestressSteels",
    "members",
    "anchors"
  ],
  "properties": {
    "annex": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "designWorkingLifeYears": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "deltaCDev": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "cementType": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "concreteGrades": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ConcreteGrade"
      },
      "x-semio-state": "artifact"
    },
    "reinforcementGrades": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReinforcementGrade"
      },
      "x-semio-state": "artifact"
    },
    "prestressSteels": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PrestressSteel"
      },
      "x-semio-state": "artifact"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RcMember"
      },
      "x-semio-state": "artifact"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Anchor"
      },
      "x-semio-state": "artifact"
    }
  },
  "definitions": {
