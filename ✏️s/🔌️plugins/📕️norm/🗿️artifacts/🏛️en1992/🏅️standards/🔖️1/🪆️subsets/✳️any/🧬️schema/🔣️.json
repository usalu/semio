      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "gKLine": {
          "type": "number"
        },
        "qKLine": {
          "type": "number"
        },
        "pointForce": {
          "type": "number"
        },
        "mK": {
          "type": "number"
        },
        "nK": {
          "type": "number"
        },
        "vK": {
          "type": "number"
        },
        "tK": {
          "type": "number"
        },
        "vKPunch": {
          "type": "number"
        }
      }
