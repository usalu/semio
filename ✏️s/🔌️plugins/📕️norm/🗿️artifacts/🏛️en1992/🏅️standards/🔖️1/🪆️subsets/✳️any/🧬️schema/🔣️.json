        "name",
        "fPk",
        "fP01k"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fPk": {
          "type": "number"
        },
        "fP01k": {
          "type": "number"
        }
      }
    },
    "BarLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "diameter",
        "count",
        "position",
        "anchorageLength",
        "lapLength",
        "bondCondition",
        "aggregateSize"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "diameter": {
          "type": "number"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "type": "string"
        },
        "anchorageLength": {
          "type": "number"
        },
        "lapLength": {
          "type": "number"
        },
        "bondCondition": {
          "type": "string"
        },
