    "FireSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "axisDistance"
      ],
      "properties": {
        "rating": {
          "type": "string"
        },
        "axisDistance": {
          "type": "number"
        }
      }
    },
    "LoadCaseActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "category",
        "source",
        "gKLine",
        "qKLine",
        "pointForce",
        "mK",
        "nK",
        "vK",
        "tK",
        "vKPunch"
