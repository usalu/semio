{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/mutation/change-anchor-head-diameter/schema.json",
  "title": "ChangeAnchorHeadDiameter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchorId",
    "newHeadDiameter"
  ],
  "properties": {
    "anchorId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Anchor",
          "de": "Dübel"
        },
        "description": {
          "en": "The anchor this mutation addresses, by id.",
          "de": "Das adressierte Element (Dübel), per Kennung."
        },
        "ref": {
          "kind": "anchor"
        },
        "group": "target",
        "order": 10
      }
    },
    "newHeadDiameter": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Anchor head diameter d_h (0 = derived 2 d)",
          "de": "Ankerkopfdurchmesser d_h (0 = abgeleitet 2 d)"
        },
        "widget": "stepper",
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "precision": 1,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
