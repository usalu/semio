{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/mutation/reorder-members/schema.json",
  "title": "ReorderMembers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fromIndex",
    "toIndex"
  ],
  "properties": {
    "fromIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "From position",
          "de": "Von Position"
        },
        "description": {
          "en": "Zero-based position of the member to move in its list.",
          "de": "Nullbasierte Position des zu verschiebenden Bauteils in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "toIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "To position",
          "de": "Nach Position"
        },
        "description": {
          "en": "Zero-based target position; a larger value moves the member to the end.",
          "de": "Nullbasierte Zielposition; ein größerer Wert verschiebt das Bauteil ans Ende."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  }
}
