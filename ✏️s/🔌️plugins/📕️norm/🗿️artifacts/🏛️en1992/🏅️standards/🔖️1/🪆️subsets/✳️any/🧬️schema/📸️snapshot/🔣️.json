            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
