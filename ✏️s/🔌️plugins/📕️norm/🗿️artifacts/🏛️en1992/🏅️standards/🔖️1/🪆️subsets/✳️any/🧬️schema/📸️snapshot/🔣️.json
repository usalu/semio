        "position": {
          "type": "string"
        },
        "anchorageLength": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Anchorage length l_bd",
              "de": "Verankerungslänge l_bd"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "lapLength": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Lap length l₀",
              "de": "Übergreifungslänge l₀"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "bondCondition": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Bond condition",
              "de": "Verbundbedingung"
            },
            "description": {
              "en": "good or poor (EN 1992-1-1 8.4.2).",
              "de": "gut oder mäßig (EN 1992-1-1 8.4.2)."
