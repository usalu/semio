    "BarLayer": {
      "title": "BarLayer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "diameter",
        "count",
        "position",
        "anchorageLength",
        "lapLength",
        "bondCondition",
        "aggregateSize"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "diameter": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Bar diameter Ø",
              "de": "Stabdurchmesser Ø"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.001,
            "precision": 0
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Number of bars n",
              "de": "Stabanzahl n"
            },
            "step": 1,
            "precision": 0
          },
          "maximum": 4294967295
