      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fCk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fCk": {
          "type": "number"
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "ReinforcementGrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fYk",
        "eS",
        "ductility",
        "k",
        "epsUk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fYk": {
          "type": "number"
        },
        "eS": {
          "type": "number"
        },
        "ductility": {
          "type": "string",
          "enum": [
            "a",
            "b",
            "c"
          ]
        },
        "k": {
          "type": "number"
        },
        "epsUk": {
          "type": "number"
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "PrestressSteel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "fPk",
        "fP01k"
