{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1992/snapshot.json",
  "title": "En1992Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex",
    "title",
    "designWorkingLifeYears",
    "deltaCDev",
    "cementType",
    "concreteGrades",
    "reinforcementGrades",
    "prestressSteels",
    "members",
    "anchors"
  ],
  "properties": {
    "annex": {
      "x-semio-state": "artifact",
      "$ref": "#/$defs/AnnexChoice"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "designWorkingLifeYears": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "deltaCDev": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "cementType": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "concreteGrades": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConcreteGrade"
      },
      "x-semio-state": "artifact"
    },
    "reinforcementGrades": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReinforcementGrade"
      },
      "x-semio-state": "artifact"
    },
    "prestressSteels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PrestressSteel"
      },
      "x-semio-state": "artifact"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RcMember"
      },
      "x-semio-state": "artifact"
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Anchor"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
