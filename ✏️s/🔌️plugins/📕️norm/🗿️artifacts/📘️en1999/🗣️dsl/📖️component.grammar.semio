dialect grammar
grammar en1999.document
extension en1999
use family-sheet
start document

document = header assign*
header = "semio" IDENT "v" INT
assign = ("n-ed-kn" | "m-ed-knm" | "a-mm2" | "w-el-mm3" | "alloy" | "chi" | "i-t-mm4" | "l-cr-mm" | "theta-c" | "delta-sigma-ed" | "delta-sigma-c" | "fatigue-m" | "n-cycles" | "v-weld-ed-kn" | "weld-throat-mm" | "weld-length-mm" | "beta-w" | "sheet-b-mm" | "sheet-t-mm" | "sheet-k-sigma" | "sheet-w-el-mm3" | "sheet-m-ed-knm" | "shell-t-mm" | "shell-r-mm" | "sigma-ed-shell-mpa" | "annex" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | UNITNUM | IDENT
UNITNUM = FLOAT UNIT | INT UNIT
UNIT = IDENT
