dialect grammar
grammar en1999.diff
extension en1999
use family-sheet
start diff

artifact-mark = "norm.en1999-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("en1999-basis" | "en1999-combination" | "en1999-partial-factor" | "en1999-verdict" | "en1999-annex" | "en1999-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
