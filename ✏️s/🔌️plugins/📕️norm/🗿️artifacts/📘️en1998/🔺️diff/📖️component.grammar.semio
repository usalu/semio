dialect grammar
grammar en1998.diff
extension en1998
use family-sheet
start diff

artifact-mark = "norm.en1998-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("en1998-basis" | "en1998-combination" | "en1998-partial-factor" | "en1998-verdict" | "en1998-annex" | "en1998-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
