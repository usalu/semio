dialect grammar
grammar en1998.document
extension en1998
use family-sheet
start document

artifact-mark = "norm.en1998"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("en1998-basis" | "en1998-combination" | "en1998-partial-factor" | "en1998-verdict" | "en1998-annex" | "en1998-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
