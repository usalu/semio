dialect grammar
grammar en1998.op
extension en1998
use family-sheet
start operation

artifact-mark = "norm.en1998-op"
operation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("en1998-basis" | "en1998-combination" | "en1998-partial-factor" | "en1998-verdict" | "en1998-annex" | "en1998-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
