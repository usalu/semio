dialect grammar
grammar en1996.op
extension en1996
use family-sheet
start mutation

artifact-mark = "norm.en1996-op"
mutation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("en1996-basis" | "en1996-combination" | "en1996-partial-factor" | "en1996-verdict" | "en1996-annex" | "en1996-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
