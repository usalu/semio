        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "newMortarClass": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/snapshot.json#/$defs/MortarClass",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Mortar strength class",
          "de": "Mörtelklasse"
        },
        "description": {
          "en": "M1, M2_5, M5, M10, M15 or M20 (f_m in N/mm²).",
          "de": "M1, M2_5, M5, M10, M15 oder M20 (f_m in N/mm²)."
        },
        "group": "material",
        "order": 20
      }
    }
