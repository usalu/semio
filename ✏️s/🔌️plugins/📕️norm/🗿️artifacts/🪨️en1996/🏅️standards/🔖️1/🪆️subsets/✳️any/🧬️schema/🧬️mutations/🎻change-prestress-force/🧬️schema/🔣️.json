{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-prestress-force/schema.json",
  "title": "ChangePrestressForce",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "id",
    "newForceN"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tendon",
          "de": "Spannglied"
        },
        "description": {
          "en": "The tendon this mutation addresses, by id.",
          "de": "Das adressierte Element (Spannglied), per Kennung."
        },
        "ref": {
          "kind": "prestress"
        },
        "group": "target",
        "order": 20
      }
    },
    "newForceN": {
      "type": "number",
      "maximum": 1000000000000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Initial prestressing force P0",
          "de": "Anfängliche Vorspannkraft P0"
        },
        "unit": "N",
        "step": 1000,
        "precision": 0,
        "group": "prestress",
        "order": 30,
        "displayUnit": "kN",
        "displayFactor": 0.001
      }
    }
  }
}
