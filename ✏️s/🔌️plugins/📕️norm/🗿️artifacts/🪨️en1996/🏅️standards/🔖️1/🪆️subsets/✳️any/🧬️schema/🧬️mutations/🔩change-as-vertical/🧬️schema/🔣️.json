{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-as-vertical/schema.json",
  "title": "ChangeAsVertical",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newAsVerticalM2"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "newAsVerticalM2": {
      "type": "number",
      "maximum": 100000000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Vertical reinforcement area A_s",
          "de": "Querschnitt der vertikalen Bewehrung A_s"
        },
        "unit": "m²",
        "displayUnit": "cm²",
        "displayFactor": 10000,
        "step": 0.000001,
        "precision": 2,
        "group": "reinforcement",
        "order": 20
      }
    }
  }
}
