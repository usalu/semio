{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-unit-fb/schema.json",
  "title": "ChangeUnitFb",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newFBPa"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "newFBPa": {
      "type": "number",
      "maximum": 1000000000000,
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Normalised compressive strength of the unit f_b",
          "de": "Normierte Steindruckfestigkeit f_b"
        },
        "unit": "Pa",
        "displayUnit": "N/mm²",
        "displayFactor": 0.000001,
        "step": 500000,
        "precision": 1,
        "group": "material",
        "order": 20
      }
    }
  }
}
