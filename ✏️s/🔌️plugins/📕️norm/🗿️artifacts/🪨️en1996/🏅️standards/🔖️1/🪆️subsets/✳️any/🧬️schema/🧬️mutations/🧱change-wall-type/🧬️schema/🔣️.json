{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-wall-type/schema.json",
  "title": "ChangeWallType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "newWallType"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "Zero-based position of the wall in its list.",
          "de": "Nullbasierte Position der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "newWallType": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/snapshot.json#/$defs/WallType",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Wall type",
          "de": "Wandart"
        },
        "description": {
          "en": "LoadBearing, Shear or NonLoadBearing.",
          "de": "LoadBearing (tragend), Shear (aussteifend) oder NonLoadBearing (nichttragend)."
        },
        "group": "geometry",
        "order": 20
      }
    }
  }
}
