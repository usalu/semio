{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-confined-position/schema.json",
  "title": "ChangeConfinedPosition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "id",
    "newPositionM"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Confining element",
          "de": "Einfassungselement"
        },
        "description": {
          "en": "The confining element this mutation addresses, by id.",
          "de": "Das adressierte Element (Einfassungselement), per Kennung."
        },
        "ref": {
          "kind": "confined"
        },
        "group": "target",
        "order": 20
      }
    },
    "newPositionM": {
      "type": "number",
      "maximum": 10000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Column position x",
          "de": "Stützenlage x"
        },
        "unit": "m",
        "step": 0.05,
        "precision": 2,
        "group": "confined",
        "order": 30
      }
    }
  }
}
