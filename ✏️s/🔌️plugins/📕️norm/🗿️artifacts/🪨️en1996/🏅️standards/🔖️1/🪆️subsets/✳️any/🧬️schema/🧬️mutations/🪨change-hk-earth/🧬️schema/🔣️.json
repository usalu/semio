{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-hk-earth/schema.json",
  "title": "ChangeHKEarth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "id",
    "newHKEarthN"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "description": {
          "en": "The load case this mutation addresses, by id.",
          "de": "Das adressierte Element (Lastfall), per Kennung."
        },
        "ref": {
          "kind": "load-case"
        },
        "group": "target",
        "order": 20
      }
    },
    "newHKEarthN": {
      "type": "number",
      "maximum": 1000000000000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Characteristic earth pressure resultant H_k",
          "de": "Charakteristische Erddruckresultierende H_k"
        },
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "step": 1000,
        "precision": 1,
        "group": "actions",
        "order": 30
      }
    }
  }
}
