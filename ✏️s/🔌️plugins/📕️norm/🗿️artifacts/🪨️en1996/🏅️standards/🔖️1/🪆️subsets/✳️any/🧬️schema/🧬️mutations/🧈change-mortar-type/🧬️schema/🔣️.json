        "role": "value",
        "label": {
          "en": "Mortar type",
          "de": "Mörtelart"
        },
        "description": {
          "en": "GeneralPurpose, ThinLayer or Lightweight.",
          "de": "GeneralPurpose (Normalmauermörtel), ThinLayer (Dünnbettmörtel) oder Lightweight (Leichtmauermörtel)."
