    "newBearingLengthM": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Bearing length of the concentrated load",
          "de": "Auflagerlänge der Einzellast"
        },
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "step": 0.005,
        "precision": 0,
        "group": "actions",
        "order": 40
      }
