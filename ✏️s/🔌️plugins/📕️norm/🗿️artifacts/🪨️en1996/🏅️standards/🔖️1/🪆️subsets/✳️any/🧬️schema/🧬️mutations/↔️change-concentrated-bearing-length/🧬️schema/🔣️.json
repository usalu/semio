{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-concentrated-bearing-length/schema.json",
  "title": "ChangeConcentratedBearingLength",
  "type": "object",
  "additionalProperties": false,
