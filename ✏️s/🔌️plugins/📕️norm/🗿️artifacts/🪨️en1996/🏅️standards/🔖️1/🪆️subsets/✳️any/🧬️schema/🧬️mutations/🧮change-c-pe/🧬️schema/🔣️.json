{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-c-pe/schema.json",
  "title": "ChangeCPe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "id",
    "newCPe"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "description": {
          "en": "The load case this mutation addresses, by id.",
          "de": "Das adressierte Element (Lastfall), per Kennung."
        },
        "ref": {
          "kind": "load-case"
        },
        "group": "target",
        "order": 20
      }
    },
    "newCPe": {
      "type": "number",
      "minimum": -5,
      "maximum": 5,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "External pressure coefficient c_pe",
          "de": "Außendruckbeiwert c_pe"
        },
        "step": 0.01,
        "precision": 2,
        "group": "actions",
        "order": 30
      }
    }
  }
}
