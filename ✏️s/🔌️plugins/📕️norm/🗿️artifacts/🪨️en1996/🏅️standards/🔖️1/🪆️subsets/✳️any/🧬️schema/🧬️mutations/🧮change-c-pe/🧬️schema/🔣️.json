{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-c-pe/schema.json",
  "title": "ChangeCPe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallIndex",
    "index",
    "newCPe"
  ],
  "properties": {
    "wallIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "Zero-based position of the wall in its list.",
          "de": "Nullbasierte Position der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "description": {
          "en": "Zero-based position of the load case within the wall in its list.",
          "de": "Nullbasierte Position des Lastfalls in der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "newCPe": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "External pressure coefficient c_pe",
          "de": "Außendruckbeiwert c_pe"
        },
        "step": 0.01,
        "precision": 2,
        "group": "actions",
        "order": 30
      }
    }
  }
}
