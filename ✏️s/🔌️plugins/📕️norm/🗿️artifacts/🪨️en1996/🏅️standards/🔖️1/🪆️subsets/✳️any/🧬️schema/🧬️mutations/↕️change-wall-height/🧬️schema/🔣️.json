{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-wall-height/schema.json",
  "title": "ChangeWallHeight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newHeightM"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "newHeightM": {
      "type": "number",
      "maximum": 10000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Clear wall height h",
          "de": "Lichte Wandhöhe h"
        },
        "unit": "m",
        "step": 0.05,
        "precision": 2,
        "group": "geometry",
        "order": 20
      }
    }
  }
}
