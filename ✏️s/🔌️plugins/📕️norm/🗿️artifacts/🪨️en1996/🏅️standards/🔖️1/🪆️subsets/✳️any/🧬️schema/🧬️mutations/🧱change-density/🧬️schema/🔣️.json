{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-density/schema.json",
  "title": "ChangeDensity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newDensityKgM3"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "newDensityKgM3": {
      "type": "number",
      "maximum": 23000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Masonry density ρ",
          "de": "Rohdichte des Mauerwerks ρ"
        },
        "unit": "kg/m³",
        "step": 10,
        "precision": 0,
        "group": "material",
        "order": 20
      }
    }
  }
}
