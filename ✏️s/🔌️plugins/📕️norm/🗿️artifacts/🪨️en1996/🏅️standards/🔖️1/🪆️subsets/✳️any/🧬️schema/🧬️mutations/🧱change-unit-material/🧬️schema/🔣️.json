{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-unit-material/schema.json",
  "title": "ChangeUnitMaterial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "newUnitMaterial"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "Zero-based position of the wall in its list.",
          "de": "Nullbasierte Position der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "newUnitMaterial": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/snapshot.json#/$defs/UnitMaterial",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Unit material",
          "de": "Steinart"
        },
        "description": {
          "en": "Clay, CalciumSilicate, Aerated or Concrete.",
          "de": "Clay (Mauerziegel), CalciumSilicate (Kalksandstein), Aerated (Porenbeton) oder Concrete (Betonstein)."
        },
        "group": "material",
        "order": 20
      }
    }
  }
}
