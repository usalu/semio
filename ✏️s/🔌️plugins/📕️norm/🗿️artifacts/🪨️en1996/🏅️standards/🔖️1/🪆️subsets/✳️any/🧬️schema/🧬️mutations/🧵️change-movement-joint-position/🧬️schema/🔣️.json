{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-movement-joint-position/schema.json",
  "title": "ChangeMovementJointPosition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newPositionM"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Movement joint",
          "de": "Dehnfuge"
        },
        "description": {
          "en": "The movement joint this mutation addresses, by id.",
          "de": "Das adressierte Element (Dehnfuge), per Kennung."
        },
        "ref": {
          "kind": "joint"
        },
        "group": "target",
        "order": 10
      }
    },
    "newPositionM": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000,
      "x-semio-ui": {
        "label": {
          "en": "Joint position x",
          "de": "Fugenlage x"
        },
        "widget": "stepper",
        "unit": "m",
        "step": 0.01,
        "precision": 3,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
