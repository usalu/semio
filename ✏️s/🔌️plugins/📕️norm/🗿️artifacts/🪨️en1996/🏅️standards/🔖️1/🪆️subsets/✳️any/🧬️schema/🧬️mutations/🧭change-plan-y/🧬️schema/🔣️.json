{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-plan-y/schema.json",
  "title": "ChangePlanY",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newPlanYM"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "newPlanYM": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Plan position y",
          "de": "Grundrissposition y"
        },
        "unit": "m",
        "step": 0.1,
        "precision": 2,
        "group": "site",
        "order": 20
      }
    }
  }
}
