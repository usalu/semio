{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-concentrated-force/schema.json",
  "title": "ChangeConcentratedForce",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "loadCaseId",
    "id",
    "newForceN"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "loadCaseId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "description": {
          "en": "The load case this mutation addresses, by id.",
          "de": "Das adressierte Element (Lastfall), per Kennung."
        },
        "ref": {
          "kind": "load-case"
        },
        "group": "target",
        "order": 20
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Concentrated load",
          "de": "Einzellast"
        },
        "description": {
          "en": "The concentrated load this mutation addresses, by id.",
          "de": "Das adressierte Element (Einzellast), per Kennung."
        },
        "ref": {
          "kind": "concentrated"
        },
        "group": "target",
        "order": 30
      }
    },
    "newForceN": {
      "type": "number",
      "minimum": -1000000000000,
      "maximum": 1000000000000,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Characteristic concentrated force F_k",
          "de": "Charakteristische Einzellast F_k"
        },
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "step": 1000,
        "precision": 1,
        "group": "actions",
        "order": 40
      }
    }
  }
}
