{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/insert-concentrated/schema.json",
  "title": "InsertConcentrated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallIndex",
    "loadCaseIndex",
    "index",
    "load"
  ],
  "properties": {
    "wallIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "Zero-based position of the wall in its list.",
          "de": "Nullbasierte Position der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "loadCaseIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "description": {
          "en": "Zero-based position of the load case within the wall in its list.",
          "de": "Nullbasierte Position des Lastfalls in der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 30
      }
    },
    "load": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/snapshot.json#/$defs/ConcentratedLoad",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Concentrated load",
          "de": "Einzellast"
        },
        "description": {
          "en": "The complete concentrated load record to insert.",
          "de": "Der vollständige einzufügende Einzellast-Datensatz."
        },
        "group": "record",
        "order": 40
      }
    }
  }
}
