{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-prestress-eccentricity/schema.json",
  "title": "ChangePrestressEccentricity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "id",
    "newEccentricityM"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tendon",
          "de": "Spannglied"
        },
        "description": {
          "en": "The tendon this mutation addresses, by id.",
          "de": "Das adressierte Element (Spannglied), per Kennung."
        },
        "ref": {
          "kind": "prestress"
        },
        "group": "target",
        "order": 20
      }
    },
    "newEccentricityM": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Tendon eccentricity",
          "de": "Spanngliedausmitte"
        },
        "unit": "m",
        "step": 0.05,
        "precision": 2,
        "group": "prestress",
        "order": 30
      }
    }
  }
}
