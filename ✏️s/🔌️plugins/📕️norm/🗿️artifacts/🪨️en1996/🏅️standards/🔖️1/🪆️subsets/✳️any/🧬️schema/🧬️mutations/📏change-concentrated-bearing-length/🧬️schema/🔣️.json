{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-concentrated-bearing-length/schema.json",
  "title": "ChangeConcentratedBearingLength",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "loadCaseId",
    "id",
    "newBearingLengthM"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "loadCaseId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "description": {
          "en": "The load case this mutation addresses, by id.",
          "de": "Das adressierte Element (Lastfall), per Kennung."
        },
        "ref": {
          "kind": "load-case"
        },
        "group": "target",
        "order": 20
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Concentrated load",
          "de": "Einzellast"
        },
        "description": {
          "en": "The concentrated load this mutation addresses, by id.",
          "de": "Das adressierte Element (Einzellast), per Kennung."
        },
        "ref": {
          "kind": "concentrated"
        },
        "group": "target",
        "order": 30
      }
    },
    "newBearingLengthM": {
      "type": "number",
      "maximum": 10000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Bearing length of the concentrated load",
          "de": "Auflagerlänge der Einzellast"
        },
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "step": 0.005,
        "precision": 0,
        "group": "actions",
        "order": 40
      }
    }
  }
}
