{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-unit-group/schema.json",
  "title": "ChangeUnitGroup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "newUnitGroup"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "Zero-based position of the wall in its list.",
          "de": "Nullbasierte Position der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "newUnitGroup": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/snapshot.json#/$defs/UnitGroup",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Masonry unit group",
          "de": "Steingruppe"
        },
        "description": {
          "en": "Group1 to Group4 (EN 1996-1-1 Table 3.1).",
          "de": "Group1 bis Group4 (EN 1996-1-1 Tabelle 3.1)."
        },
        "group": "material",
        "order": 20
      }
    }
  }
}
