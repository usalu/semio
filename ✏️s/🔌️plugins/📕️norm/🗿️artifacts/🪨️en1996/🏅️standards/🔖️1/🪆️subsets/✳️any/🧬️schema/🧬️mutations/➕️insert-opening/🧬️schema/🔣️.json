{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/insert-opening/schema.json",
  "title": "InsertOpening",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallIndex",
    "index",
    "opening"
  ],
  "properties": {
    "wallIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "Zero-based position of the wall in its list.",
          "de": "Nullbasierte Position der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "opening": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/snapshot.json#/$defs/WallOpening",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Opening",
          "de": "Öffnung"
        },
        "description": {
          "en": "The complete opening record to insert into the wall.",
          "de": "Der vollständige in die Wand einzufügende Öffnungsdatensatz."
        },
        "group": "record",
        "order": 30
      }
    }
  }
}
