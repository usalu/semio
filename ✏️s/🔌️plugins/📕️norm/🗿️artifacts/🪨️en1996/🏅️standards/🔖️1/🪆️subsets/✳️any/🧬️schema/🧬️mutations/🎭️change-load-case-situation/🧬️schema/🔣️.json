{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-load-case-situation/schema.json",
  "title": "ChangeLoadCaseSituation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallIndex",
    "loadCaseIndex",
    "newDesignSituation"
  ],
  "properties": {
    "wallIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "Zero-based position of the wall in its list.",
          "de": "Nullbasierte Position der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "loadCaseIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "description": {
          "en": "Zero-based position of the load case within the wall in its list.",
          "de": "Nullbasierte Position des Lastfalls in der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "newDesignSituation": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Design situation of the load case",
          "de": "Bemessungssituation des Lastfalls"
        },
        "description": {
          "en": "Persistent, Transient, Accidental or Seismic (EN 1990 §3.2).",
          "de": "Persistent (ständig), Transient (vorübergehend), Accidental (außergewöhnlich) oder Seismic (Erdbeben) nach EN 1990 §3.2."
        },
        "group": "actions",
        "order": 30
      }
    }
  }
}
