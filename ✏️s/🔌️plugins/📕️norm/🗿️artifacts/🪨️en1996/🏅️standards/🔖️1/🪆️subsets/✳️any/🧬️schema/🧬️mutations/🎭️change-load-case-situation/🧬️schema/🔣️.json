{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-load-case-situation/schema.json",
  "title": "ChangeLoadCaseSituation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "id",
    "newDesignSituation"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "description": {
          "en": "The load case this mutation addresses, by id.",
          "de": "Das adressierte Element (Lastfall), per Kennung."
        },
        "ref": {
          "kind": "load-case"
        },
        "group": "target",
        "order": 20
      }
    },
    "newDesignSituation": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/snapshot.json#/$defs/LoadCaseSituation",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Design situation of the load case",
          "de": "Bemessungssituation des Lastfalls"
        },
        "description": {
          "en": "Persistent, Transient, Accidental or Seismic (EN 1990 §3.2).",
          "de": "Persistent (ständig), Transient (vorübergehend), Accidental (außergewöhnlich) oder Seismic (Erdbeben) nach EN 1990 §3.2."
        },
        "group": "actions",
        "order": 30
      }
    }
  }
}
