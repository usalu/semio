{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-is-basement/schema.json",
  "title": "ChangeIsBasement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "newIsBasement"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "Zero-based position of the wall in its list.",
          "de": "Nullbasierte Position der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "newIsBasement": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Basement wall",
          "de": "Kellerwand"
        },
        "description": {
          "en": "Checked for earth pressure per EN 1996-3/NA.",
          "de": "Nachweis für Erddruck nach EN 1996-3/NA."
        },
        "group": "geometry",
        "order": 20
      }
    }
  }
}
