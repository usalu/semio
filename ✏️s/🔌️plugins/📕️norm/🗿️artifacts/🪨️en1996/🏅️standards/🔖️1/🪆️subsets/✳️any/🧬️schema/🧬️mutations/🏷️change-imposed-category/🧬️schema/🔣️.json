{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-imposed-category/schema.json",
  "title": "ChangeImposedCategory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallIndex",
    "index",
    "newImposedCategory"
  ],
  "properties": {
    "wallIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "Zero-based position of the wall in its list.",
          "de": "Nullbasierte Position der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Load case",
          "de": "Lastfall"
        },
        "description": {
          "en": "Zero-based position of the load case within the wall in its list.",
          "de": "Nullbasierte Position des Lastfalls in der Wand in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "newImposedCategory": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Imposed load category",
          "de": "Nutzungskategorie"
        },
        "description": {
          "en": "A to H per EN 1991-1-1 Table 6.1; sets the ψ factors.",
          "de": "A bis H nach EN 1991-1-1 Tabelle 6.1; bestimmt die ψ-Beiwerte."
        },
        "group": "actions",
        "order": 30
      }
    }
  }
}
