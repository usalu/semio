{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-wall-web-spacing-m/schema.json",
  "title": "ChangeWallWebSpacingM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newWebSpacingM"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "newWebSpacingM": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000,
      "x-semio-ui": {
        "label": {
          "en": "Wall in-plane stiffness",
          "de": "Stegabstand der Schubwand (0 = nicht angegeben)"
        },
        "widget": "stepper",
        "role": "value",
        "group": "value",
        "order": 20,
        "unit": "m",
        "precision": 3,
        "step": 0.05
      }
    }
  }
}
