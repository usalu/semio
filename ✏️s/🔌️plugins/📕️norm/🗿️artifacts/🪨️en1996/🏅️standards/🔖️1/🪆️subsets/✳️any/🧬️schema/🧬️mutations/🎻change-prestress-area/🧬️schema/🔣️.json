{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-prestress-area/schema.json",
  "title": "ChangePrestressArea",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "id",
    "newAreaM2"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tendon",
          "de": "Spannglied"
        },
        "description": {
          "en": "The tendon this mutation addresses, by id.",
          "de": "Das adressierte Element (Spannglied), per Kennung."
        },
        "ref": {
          "kind": "prestress"
        },
        "group": "target",
        "order": 20
      }
    },
    "newAreaM2": {
      "type": "number",
      "maximum": 100000000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Tendon area A_p",
          "de": "Spannstahlfläche A_p"
        },
        "unit": "m2",
        "step": 0.00001,
        "precision": 6,
        "group": "prestress",
        "order": 30,
        "displayUnit": "mm²",
        "displayFactor": 1000000
      }
    }
  }
}
