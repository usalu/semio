{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-bar-diameter/schema.json",
  "title": "ChangeBarDiameter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallId",
    "id",
    "newDiameterM"
  ],
  "properties": {
    "wallId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Reinforcing bar",
          "de": "Bewehrungsstab"
        },
        "description": {
          "en": "The reinforcing bar this mutation addresses, by id.",
          "de": "Das adressierte Element (Bewehrungsstab), per Kennung."
        },
        "ref": {
          "kind": "bar"
        },
        "group": "target",
        "order": 20
      }
    },
    "newDiameterM": {
      "type": "number",
      "maximum": 10000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Bar diameter",
          "de": "Stabdurchmesser"
        },
        "unit": "m",
        "step": 0.002,
        "precision": 3,
        "group": "bars",
        "order": 30
      }
    }
  }
}
