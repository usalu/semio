{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-cover/schema.json",
  "title": "ChangeCover",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newCoverM"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "newCoverM": {
      "type": "number",
      "maximum": 10000,
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Cover to reinforcement",
          "de": "Betondeckung bzw. Überdeckung der Bewehrung"
        },
        "unit": "m",
        "step": 0.005,
        "precision": 3,
        "group": "site",
        "order": 20
      }
    }
  }
}
