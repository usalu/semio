{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-chase-depth/schema.json",
  "title": "ChangeChaseDepth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newDepthM"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Chase",
          "de": "Schlitz"
        },
        "description": {
          "en": "The chase this mutation addresses, by id.",
          "de": "Das adressierte Element (Schlitz), per Kennung."
        },
        "ref": {
          "kind": "chase"
        },
        "group": "target",
        "order": 10
      }
    },
    "newDepthM": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "x-semio-ui": {
        "label": {
          "en": "Chase depth",
          "de": "Schlitztiefe"
        },
        "widget": "stepper",
        "unit": "m",
        "step": 0.01,
        "precision": 3,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
