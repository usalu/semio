{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/change-support-sides/schema.json",
  "title": "ChangeSupportSides",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newSupportSides"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Wall",
          "de": "Wand"
        },
        "description": {
          "en": "The wall this mutation addresses, by id.",
          "de": "Das adressierte Element (Wand), per Kennung."
        },
        "ref": {
          "kind": "wall"
        },
        "group": "target",
        "order": 10
      }
    },
    "newSupportSides": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Number of supported edges",
          "de": "Anzahl der gehaltenen Ränder"
        },
        "description": {
          "en": "Two-, three- or four-sided support (EN 1996-1-1 §5.5.1.2).",
          "de": "Zwei-, drei- oder vierseitig gehalten (EN 1996-1-1 §5.5.1.2)."
        },
        "step": 1,
        "precision": 0,
        "group": "geometry",
        "order": 20
      }
    }
  }
}
