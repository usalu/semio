{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/mutation/insert-prestress/schema.json",
  "title": "InsertPrestress",
  "type": "object",
  "additionalProperties": false,
