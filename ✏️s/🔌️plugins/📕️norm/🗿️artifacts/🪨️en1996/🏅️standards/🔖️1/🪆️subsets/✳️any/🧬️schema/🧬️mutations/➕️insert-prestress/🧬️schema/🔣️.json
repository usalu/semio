    "prestress": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/snapshot.json#/$defs/WallPrestress",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Tendon",
          "de": "Spannglied"
