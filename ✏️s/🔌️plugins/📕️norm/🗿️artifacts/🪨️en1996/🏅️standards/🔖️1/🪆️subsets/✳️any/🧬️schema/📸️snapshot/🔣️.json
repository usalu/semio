        "unitMaterial",
        "fBPa",
        "unitLengthM",
        "unitWidthM",
        "unitHeightM",
        "mortarType",
        "mortarClass",
        "mortarStrengthPa",
        "bedJointThicknessM",
        "reinforced",
        "asVerticalM2",
        "asHorizontalM2",
        "fYdPa",
        "fireReiMin",
        "exposure",
        "mu",
        "densityKgM3",
        "phiInfinity",
        "isBasement",
