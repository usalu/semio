  "$defs": {
    "ConcentratedLoad": {
      "title": "ConcentratedLoad",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "forceN",
        "bearingAreaM2",
        "bearingLengthM"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "forceN": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Characteristic concentrated force F_k",
              "de": "Charakteristische Einzellast F_k"
            },
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "step": 1000,
            "precision": 1
          }
        },
        "bearingAreaM2": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Loaded area A_b",
              "de": "Belastete Fläche A_b"
            },
            "unit": "m²",
            "displayUnit": "cm²",
            "displayFactor": 10000,
            "step": 0.0001,
            "precision": 0
          }
        },
        "bearingLengthM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Bearing length of the concentrated load",
              "de": "Auflagerlänge der Einzellast"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.005,
            "precision": 0
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
    "WallLoadCase": {
      "title": "WallLoadCase",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "designSituation",
        "imposedCategory",
        "gKSlabN",
        "qKImposedPa",
        "tributaryAreaM2",
        "slabSpanM",
        "qKSnowPa",
        "qPWindPa",
        "cPe",
        "hKEarthN",
        "concentrated"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "designSituation": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Design situation",
              "de": "Bemessungssituation"
            },
            "description": {
              "en": "Persistent, Transient, Accidental or Seismic (EN 1990 §3.2).",
              "de": "Persistent (ständig), Transient (vorübergehend), Accidental (außergewöhnlich) oder Seismic (Erdbeben) nach EN 1990 §3.2."
            }
          }
        },
        "imposedCategory": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Wall",
              "de": "Wand"
            },
            "description": {
              "en": "Zero-based position of the wall in its list.",
              "de": "Nullbasierte Position der Wand in der Liste."
            }
          }
        },
        "gKSlabN": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Characteristic permanent slab load G_k",
              "de": "Charakteristische ständige Deckenauflast G_k"
            },
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "step": 1000,
            "precision": 1
          }
        },
        "qKImposedPa": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Characteristic imposed load q_k",
              "de": "Charakteristische Nutzlast q_k"
            },
            "unit": "Pa",
            "displayUnit": "kN/m²",
            "displayFactor": 0.001,
            "step": 50,
            "precision": 2
          }
        },
        "tributaryAreaM2": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Tributary floor area",
              "de": "Lasteinzugsfläche"
            },
            "unit": "m²",
            "step": 0.5,
            "precision": 2
          }
        },
        "slabSpanM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Clear span of the slab l_f",
              "de": "Lichte Deckenstützweite l_f"
            },
            "unit": "m",
            "step": 0.05,
            "precision": 2
          }
        },
        "qKSnowPa": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Characteristic snow load s_k",
              "de": "Charakteristische Schneelast s_k"
            },
            "unit": "Pa",
            "displayUnit": "kN/m²",
            "displayFactor": 0.001,
            "step": 50,
            "precision": 2
          }
        },
        "qPWindPa": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Peak velocity pressure q_p",
              "de": "Böengeschwindigkeitsdruck q_p"
            },
            "unit": "Pa",
            "displayUnit": "kN/m²",
            "displayFactor": 0.001,
            "step": 50,
            "precision": 2
          }
        },
        "cPe": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Wall",
              "de": "Wand"
            },
            "description": {
              "en": "Zero-based position of the wall in its list.",
              "de": "Nullbasierte Position der Wand in der Liste."
            },
            "step": 1,
            "precision": 0
          }
        },
        "hKEarthN": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Characteristic earth pressure resultant H_k",
              "de": "Charakteristische Erddruckresultierende H_k"
            },
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "step": 1000,
            "precision": 1
          }
        },
        "concentrated": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConcentratedLoad"
          },
          "x-semio-ui": {
            "label": {
              "en": "Wall",
              "de": "Wand"
            },
            "description": {
              "en": "Zero-based position of the wall in its list.",
              "de": "Nullbasierte Position der Wand in der Liste."
            }
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
    "WallOpening": {
      "title": "WallOpening",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "widthM",
        "heightM",
        "sillHeightM"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "widthM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Opening width",
              "de": "Öffnungsbreite"
            },
            "unit": "m",
            "step": 0.05,
            "precision": 2
          }
        },
        "heightM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Clear wall height h",
              "de": "Lichte Wandhöhe h"
            },
            "unit": "m",
            "step": 0.05,
            "precision": 2
          }
        },
        "sillHeightM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Sill height",
              "de": "Brüstungshöhe"
            },
            "unit": "m",
            "step": 0.05,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
