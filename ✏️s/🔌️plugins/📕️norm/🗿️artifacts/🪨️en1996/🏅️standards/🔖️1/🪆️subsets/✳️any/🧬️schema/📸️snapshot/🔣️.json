            "label": {
              "en": "Wall type",
              "de": "Wandart"
            },
            "description": {
              "en": "LoadBearing, Shear or NonLoadBearing.",
              "de": "LoadBearing (tragend), Shear (aussteifend) oder NonLoadBearing (nichttragend)."
            }
          }
        },
        "thicknessM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Wall thickness t",
              "de": "Wanddicke t"
