{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1996/snapshot.json",
  "title": "En1996Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex",
    "masonryClass",
    "designSituation",
    "storeys",
    "walls"
  ],
  "properties": {
    "annex": {
      "type": "string",
      "enum": ["En", "De"]
    },
    "masonryClass": {
      "type": "string",
      "enum": ["Class1", "Class2", "Class3", "Class4", "Class5"]
    },
    "designSituation": {
      "type": "string",
      "enum": ["Persistent", "Transient", "Accidental", "Seismic"]
    },
    "storeys": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "labelEn",
          "labelDe",
          "wallType",
          "thicknessM",
          "heightM",
          "lengthM",
          "supportSides",
          "openings",
          "slabBearingDepthM",
          "eccentricityTopM",
          "eccentricityBottomM",
          "unitGroup",
          "unitMaterial",
          "fBPa",
          "unitLengthM",
          "unitWidthM",
          "unitHeightM",
          "mortarType",
          "mortarClass",
          "mortarStrengthPa",
          "bedJointThicknessM",
          "reinforced",
          "asVerticalM2",
          "asHorizontalM2",
          "fYdPa",
          "fireReiMin",
          "exposure",
          "mu",
          "densityKgM3",
          "phiInfinity",
          "isBasement",
          "loadCases"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "labelEn": {
            "type": "string"
          },
          "labelDe": {
            "type": "string"
          },
          "wallType": {
            "type": "string",
            "enum": ["LoadBearing", "Shear", "NonLoadBearing"]
          },
          "thicknessM": {
            "type": "number"
          },
          "heightM": {
            "type": "number"
          },
          "lengthM": {
            "type": "number"
          },
          "supportSides": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "widthM",
                "heightM",
                "sillHeightM"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "widthM": {
                  "type": "number"
                },
                "heightM": {
                  "type": "number"
                },
                "sillHeightM": {
                  "type": "number"
                }
              }
            }
          },
          "slabBearingDepthM": {
            "type": "number"
          },
          "eccentricityTopM": {
            "type": "number"
          },
          "eccentricityBottomM": {
            "type": "number"
          },
          "unitGroup": {
            "type": "string",
            "enum": ["Group1", "Group2", "Group3", "Group4"]
          },
          "unitMaterial": {
            "type": "string",
            "enum": ["Clay", "CalciumSilicate", "Aerated", "Concrete"]
          },
          "fBPa": {
            "type": "number"
          },
          "unitLengthM": {
            "type": "number"
          },
          "unitWidthM": {
            "type": "number"
          },
          "unitHeightM": {
            "type": "number"
          },
          "mortarType": {
            "type": "string",
            "enum": ["GeneralPurpose", "ThinLayer", "Lightweight"]
          },
          "mortarClass": {
            "type": "string",
            "enum": ["M1", "M2_5", "M5", "M10", "M15", "M20"]
          },
          "mortarStrengthPa": {
            "type": "number"
          },
          "bedJointThicknessM": {
            "type": "number"
          },
          "reinforced": {
            "type": "boolean"
          },
          "asVerticalM2": {
            "type": "number"
          },
          "asHorizontalM2": {
            "type": "number"
          },
          "fYdPa": {
            "type": "number"
          },
          "fireReiMin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "exposure": {
            "type": "string",
            "enum": ["Mx1", "Mx2", "Mx3", "Mx4", "Mx5"]
          },
          "mu": {
            "type": "number"
          },
          "densityKgM3": {
            "type": "number"
          },
          "phiInfinity": {
            "type": "number"
          },
          "isBasement": {
            "type": "boolean"
          },
          "loadCases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "designSituation",
                "imposedCategory",
                "gKSlabN",
                "qKImposedPa",
                "tributaryAreaM2",
                "slabSpanM",
                "qKSnowPa",
                "qPWindPa",
                "cPe",
                "hKEarthN",
                "concentrated"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "designSituation": {
                  "type": "string"
                },
                "imposedCategory": {
                  "type": "string"
                },
                "gKSlabN": {
                  "type": "number"
                },
                "qKImposedPa": {
                  "type": "number"
                },
                "tributaryAreaM2": {
                  "type": "number"
                },
                "slabSpanM": {
                  "type": "number"
                },
                "qKSnowPa": {
                  "type": "number"
                },
                "qPWindPa": {
                  "type": "number"
                },
                "cPe": {
                  "type": "number"
                },
                "hKEarthN": {
                  "type": "number"
                },
                "concentrated": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "forceN",
                      "bearingAreaM2",
                      "bearingLengthM"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "forceN": {
                        "type": "number"
                      },
                      "bearingAreaM2": {
                        "type": "number"
                      },
                      "bearingLengthM": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
