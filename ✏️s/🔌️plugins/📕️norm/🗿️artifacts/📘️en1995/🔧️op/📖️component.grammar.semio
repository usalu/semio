dialect grammar
grammar en1995.op
extension en1995
use family-sheet
start operation

artifact-mark = "norm.en1995-op"
operation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("en1995-basis" | "en1995-combination" | "en1995-partial-factor" | "en1995-verdict" | "en1995-annex" | "en1995-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
