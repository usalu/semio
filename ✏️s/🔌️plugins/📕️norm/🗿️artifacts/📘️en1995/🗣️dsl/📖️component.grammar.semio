dialect grammar
grammar en1995.document
extension en1995
use family-sheet
start document

artifact-mark = "norm.en1995"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("en1995-basis" | "en1995-combination" | "en1995-partial-factor" | "en1995-verdict" | "en1995-annex" | "en1995-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
