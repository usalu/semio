dialect grammar
grammar en1995.document
extension en1995
use family-sheet
start document

document = header assign*
header = "semio" IDENT "v" INT
assign = ("annex" | "m-ed-knm" | "n-ed-kn" | "v-ed-kn" | "w-mm3" | "a-mm2" | "b-mm" | "h-mm" | "f-m-k" | "f-c-0-k" | "service-class" | "load-duration" | "m-crit-knm" | "f-ed-kn" | "a-ef-mm2" | "f-v-k" | "fire-duration-min" | "section-depth-mm" | "a-vert-m-s2" | "n-cycles-bridge" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | UNITNUM | IDENT
UNITNUM = FLOAT UNIT | INT UNIT
UNIT = IDENT
