dialect grammar
grammar en1995.diff
extension en1995
use family-sheet
start diff

artifact-mark = "norm.en1995-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("en1995-basis" | "en1995-combination" | "en1995-partial-factor" | "en1995-verdict" | "en1995-annex" | "en1995-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
