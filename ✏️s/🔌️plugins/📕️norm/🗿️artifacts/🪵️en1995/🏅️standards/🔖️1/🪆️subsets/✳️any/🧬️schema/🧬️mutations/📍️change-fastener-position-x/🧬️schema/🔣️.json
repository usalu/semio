{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1995/mutation/change-fastener-position-x/schema.json",
  "title": "ChangeFastenerPositionX",
  "type": "object",
