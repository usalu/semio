{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1995/mutation/change-member-service-class/schema.json",
  "title": "ChangeMemberServiceClass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memberId",
    "newValue"
  ],
  "properties": {
    "memberId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Member",
          "de": "Bauteil"
        },
        "description": {
          "en": "The timber member this mutation addresses.",
          "de": "Das Holzbauteil, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "member"
        },
        "group": "target",
        "order": 10
      }
    },
    "newValue": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Service class",
          "de": "Nutzungsklasse"
        },
        "description": {
          "en": "Service class 1, 2 or 3 (EN 1995-1-1 §2.3.1.3).",
          "de": "Nutzungsklasse 1, 2 oder 3 (EN 1995-1-1 §2.3.1.3)."
        },
        "step": 1,
        "precision": 0,
        "group": "material",
        "order": 20
      }
    }
  }
}
