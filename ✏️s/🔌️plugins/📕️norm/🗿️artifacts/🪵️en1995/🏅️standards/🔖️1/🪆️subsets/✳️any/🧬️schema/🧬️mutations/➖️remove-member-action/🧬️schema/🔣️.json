{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1995/mutation/remove-member-action/schema.json",
  "title": "RemoveMemberAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memberId",
    "index"
  ],
  "properties": {
    "memberId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Member",
          "de": "Bauteil"
        },
        "description": {
          "en": "The timber member this mutation addresses.",
          "de": "Das Holzbauteil, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "member"
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Action",
          "de": "Einwirkung"
        },
        "description": {
          "en": "Zero-based position of the action within the member in its list.",
          "de": "Nullbasierte Position der Einwirkung im Bauteil in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  }
}
