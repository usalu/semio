{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1995/mutation/change-member-damping/schema.json",
  "title": "ChangeMemberDamping",
  "type": "object",
  "additionalProperties": false,
  "required": [
