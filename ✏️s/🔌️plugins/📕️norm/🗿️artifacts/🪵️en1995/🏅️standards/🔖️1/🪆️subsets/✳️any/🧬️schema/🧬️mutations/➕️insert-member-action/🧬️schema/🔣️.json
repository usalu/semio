{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1995/mutation/insert-member-action/schema.json",
  "title": "InsertMemberAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memberId",
    "index",
    "action"
  ],
  "properties": {
    "memberId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Member",
          "de": "Bauteil"
        },
        "description": {
          "en": "The timber member this mutation addresses.",
          "de": "Das Holzbauteil, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "member"
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "action": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1995/snapshot.json#/$defs/CharacteristicAction",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Action",
          "de": "Einwirkung"
        },
        "description": {
          "en": "The complete characteristic action to insert.",
          "de": "Die vollständige einzufügende charakteristische Einwirkung."
        },
        "group": "record",
        "order": 30
      }
    }
  }
}
