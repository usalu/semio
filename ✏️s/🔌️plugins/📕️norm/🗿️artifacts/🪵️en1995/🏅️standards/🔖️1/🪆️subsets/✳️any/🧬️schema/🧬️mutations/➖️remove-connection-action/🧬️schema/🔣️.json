{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1995/mutation/remove-connection-action/schema.json",
  "title": "RemoveConnectionAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
