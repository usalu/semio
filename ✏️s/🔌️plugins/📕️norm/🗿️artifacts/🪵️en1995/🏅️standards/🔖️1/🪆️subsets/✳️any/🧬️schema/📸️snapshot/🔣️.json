            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1,
            "step": 0.005
          }
        },
        "endDistanceM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "End distance a₃",
              "de": "Hirnholzabstand a₃"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1,
            "step": 0.005
          }
        },
        "t1M": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Side member thickness t₁",
              "de": "Dicke des Seitenholzes t₁"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1,
            "step": 0.001
          }
        },
        "t2M": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Central member thickness t₂",
              "de": "Dicke des Mittelholzes t₂"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1,
            "step": 0.001
          }
        },
        "steelPlate": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Steel-to-timber connection",
              "de": "Stahlblech-Holz-Verbindung"
            }
          }
        },
        "steelPlateThicknessM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Steel plate thickness",
              "de": "Stahlblechdicke"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1,
            "step": 0.001
          }
        },
        "shearPlanes": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Number of shear planes",
              "de": "Anzahl der Scherfugen"
            },
            "step": 1,
            "precision": 0
          },
          "maximum": 4294967295
        },
        "fUK": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Fastener tensile strength f_u,k",
              "de": "Zugfestigkeit des Verbindungsmittels f_u,k"
            },
            "widget": "stepper",
            "unit": "Pa",
            "displayUnit": "N/mm²",
            "displayFactor": 1e-06,
            "precision": 1,
            "step": 10000000,
            "snaps": [
              400000000,
              600000000,
              800000000,
              1000000000
            ]
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectionAction"
          },
          "x-semio-ui": {
            "label": {
              "en": "Connection actions",
              "de": "Einwirkungen auf die Verbindung"
            }
          }
        }
