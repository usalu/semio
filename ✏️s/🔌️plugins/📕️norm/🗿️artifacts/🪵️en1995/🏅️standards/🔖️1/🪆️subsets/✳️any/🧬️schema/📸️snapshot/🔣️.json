    "ConnectionAction": {
      "title": "ConnectionAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "loadDuration",
        "fKN"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Action type",
              "de": "Einwirkungsart"
            },
            "description": {
              "en": "permanent, imposed, snow, wind or accidental.",
              "de": "permanent (ständig), imposed (Nutzlast), snow (Schnee), wind oder accidental (außergewöhnlich)."
            }
          }
        },
        "loadDuration": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Load-duration class",
              "de": "Klasse der Lasteinwirkungsdauer"
            },
            "description": {
              "en": "permanent, long, medium, short or instantaneous (EN 1995-1-1 Table 2.1).",
              "de": "permanent (ständig), long (lang), medium (mittel), short (kurz) oder instantaneous (sehr kurz) nach EN 1995-1-1 Tabelle 2.1."
            }
          }
        },
        "fKN": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Characteristic force F_k",
              "de": "Charakteristische Kraft F_k"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2,
            "step": 100
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
