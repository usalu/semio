{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1995/snapshot.json",
  "title": "En1995Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex",
    "members",
    "connections"
  ],
  "properties": {
    "annex": {
      "type": "string",
      "x-semio-state": "artifact",
      "enum": [
        "En",
        "De"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimberMember"
      },
      "x-semio-state": "artifact"
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimberConnection"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "TimberConnection": {
      "title": "TimberConnection",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelEn",
        "labelDe",
        "fastenerType",
        "strengthClass",
        "serviceClass",
        "diameterM",
        "number",
        "rows",
        "spacingM",
        "edgeDistanceM",
        "endDistanceM",
        "t1M",
        "t2M",
        "steelPlate",
        "steelPlateThicknessM",
        "shearPlanes",
        "fUK",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "labelEn": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "English label",
              "de": "Englische Bezeichnung"
            }
          }
        },
        "labelDe": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "German label",
              "de": "Deutsche Bezeichnung"
            }
          }
        },
        "fastenerType": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Fastener type",
              "de": "Art des Verbindungsmittels"
            },
            "description": {
              "en": "nail, screw, bolt or dowel.",
              "de": "nail (Nagel), screw (Schraube), bolt (Bolzen) oder dowel (Stabdübel)."
            }
          }
        },
        "strengthClass": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Strength class",
              "de": "Festigkeitsklasse"
            },
            "description": {
              "en": "E.g. C24, GL24h, GL28c, LVL32 or CLT100 (EN 338, EN 14080).",
              "de": "Z. B. C24, GL24h, GL28c, LVL32 oder CLT100 (EN 338, EN 14080)."
            }
          }
        },
        "serviceClass": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Service class",
              "de": "Nutzungsklasse"
            },
            "description": {
              "en": "Service class 1, 2 or 3 (EN 1995-1-1 §2.3.1.3).",
              "de": "Nutzungsklasse 1, 2 oder 3 (EN 1995-1-1 §2.3.1.3)."
            },
            "step": 1,
            "precision": 0
          },
          "maximum": 255
        },
        "diameterM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Fastener diameter d",
              "de": "Durchmesser des Verbindungsmittels d"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1,
            "step": 0.0001
          }
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Number of fasteners n",
              "de": "Anzahl der Verbindungsmittel n"
            },
            "step": 1,
            "precision": 0
          },
          "maximum": 4294967295
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Number of rows",
              "de": "Anzahl der Reihen"
            },
            "step": 1,
            "precision": 0
          },
          "maximum": 4294967295
        },
        "spacingM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Fastener spacing a₁",
              "de": "Abstand der Verbindungsmittel a₁"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1,
            "step": 0.005
          }
        },
        "edgeDistanceM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Edge distance a₄",
              "de": "Randabstand a₄"
