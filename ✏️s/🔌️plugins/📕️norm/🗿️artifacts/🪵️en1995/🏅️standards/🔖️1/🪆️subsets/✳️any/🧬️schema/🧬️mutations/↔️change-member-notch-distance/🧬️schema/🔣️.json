{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1995/mutation/change-member-notch-distance/schema.json",
  "title": "ChangeMemberNotchDistance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memberId",
    "newValue"
  ],
  "properties": {
    "memberId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Member",
          "de": "Bauteil"
        },
        "description": {
          "en": "The timber member this mutation addresses.",
          "de": "Das Holzbauteil, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "member"
        },
        "group": "target",
        "order": 10
      }
    },
    "newValue": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Notch distance x",
          "de": "Abstand der Ausklinkung x"
        },
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "step": 0.001,
        "precision": 0,
        "group": "geometry",
        "order": 20
      }
    }
  }
}
