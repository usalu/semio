{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1997/mutation/insert-footing/schema.json",
  "title": "InsertFooting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "footing"
  ],
  "properties": {
    "mutation": {
      "const": "insertFooting"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "footing": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1997/snapshot.json#/$defs/SpreadFoundation",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Spread foundation",
          "de": "Flachgründung"
        },
        "description": {
          "en": "The complete spread foundation record to insert.",
          "de": "Der vollständige einzufügende Datensatz der Flachgründung."
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
