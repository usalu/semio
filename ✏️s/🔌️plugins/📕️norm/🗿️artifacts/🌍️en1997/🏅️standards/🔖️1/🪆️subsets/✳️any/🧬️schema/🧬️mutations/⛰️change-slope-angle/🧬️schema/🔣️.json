    "newAngleDeg": {
      "type": "number",
      "minimum": 0,
      "maximum": 90,
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "Slope angle β",
          "de": "Böschungswinkel β"
        },
        "unit": "°",
        "step": 0.5,
        "precision": 1,
        "group": "slope",
        "order": 20
      }
    }
