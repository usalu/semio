{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1997/mutation/change-slope-angle/schema.json",
  "title": "ChangeSlopeAngle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newAngleDeg"
  ],
  "properties": {
    "mutation": {
      "const": "changeSlopeAngle"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Slope",
          "de": "Böschung"
        },
        "description": {
          "en": "The slope this mutation addresses.",
          "de": "Die Böschung, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "slope"
        },
        "group": "target",
        "order": 10
