{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1997/mutation/remove-load-case/schema.json",
  "title": "RemoveLoadCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "footingId",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "removeLoadCase"
    },
    "footingId": {
      "type": "string",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Footing",
          "de": "Fundament"
        },
        "description": {
          "en": "The footing that owns the row, by id.",
          "de": "Das Elternelement (Fundament), per Kennung."
        },
        "group": "target",
        "order": 10,
        "widget": "reference",
        "ref": {
          "kind": "footing"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position of the row.",
          "de": "Nullbasierte Listenposition der Zeile."
        },
        "group": "target",
        "order": 20,
        "widget": "stepper",
        "step": 1,
        "precision": 0
      }
    }
  }
}
