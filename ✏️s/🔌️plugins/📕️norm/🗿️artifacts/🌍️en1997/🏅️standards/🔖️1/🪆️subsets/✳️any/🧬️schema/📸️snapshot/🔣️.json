      "items": {
        "type": "object"
      },
      "x-semio-state": "artifact"
    },
    "piles": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "x-semio-state": "artifact"
    },
    "retainingWalls": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "x-semio-state": "artifact"
    },
    "slopes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "x-semio-state": "artifact"
    },
    "upliftCases": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "x-semio-state": "artifact"
