{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1997/snapshot.json",
  "title": "En1997Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
