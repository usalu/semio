{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1997/mutation/change-groundwater-level/schema.json",
  "title": "ChangeGroundwaterLevel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newGroundwaterLevel"
  ],
  "properties": {
    "mutation": {
      "const": "changeGroundwaterLevel"
    },
    "newGroundwaterLevel": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Groundwater level",
          "de": "Grundwasserstand"
        },
        "description": {
          "en": "Depth of the design groundwater table below ground level.",
          "de": "Tiefe des Bemessungswasserstands unter Geländeoberkante."
        },
        "unit": "m",
        "step": 0.1,
        "precision": 2,
        "group": "site",
        "order": 10
      }
    }
  }
}
