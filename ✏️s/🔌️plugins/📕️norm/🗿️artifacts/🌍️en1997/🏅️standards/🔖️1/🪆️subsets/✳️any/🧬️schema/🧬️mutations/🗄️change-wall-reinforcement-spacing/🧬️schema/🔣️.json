{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1997/mutation/change-wall-reinforcement-spacing/schema.json",
  "title": "ChangeWallReinforcementSpacing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newReinforcementSpacing"
  ],
  "properties": {
    "mutation": {
      "const": "changeWallReinforcementSpacing"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Retaining wall",
          "de": "Stützwand"
        },
        "description": {
