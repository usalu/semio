    "newReinforcementSpacing": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Reinforcement spacing S_v (0 = none)",
          "de": "Bewehrungsabstand S_v (0 = unbewehrt)"
        },
        "widget": "stepper",
        "precision": 3,
        "step": 0.01,
        "role": "value",
        "group": "value",
        "order": 20
