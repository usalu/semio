{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1997/mutation/change-profile-base-resistance/schema.json",
  "title": "ChangeProfileBaseResistance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "pileId",
    "id",
    "newBaseResistance"
  ],
  "properties": {
    "mutation": {
      "const": "changeProfileBaseResistance"
    },
    "pileId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Pile",
          "de": "Pfahl"
        },
        "description": {
          "en": "The pile this mutation addresses, by id.",
          "de": "Die adressierte Zeile (Pfahl), per Kennung."
        },
        "ref": {
          "kind": "pile"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Pile test profile",
          "de": "Pfahl-Probebelastungsprofil"
        },
        "description": {
          "en": "The pile test profile this mutation addresses, by id.",
          "de": "Die adressierte Zeile (Pfahl-Probebelastungsprofil), per Kennung."
        },
        "ref": {
          "kind": "pile-test-profile"
        },
        "group": "target",
        "order": 20
      }
    },
    "newBaseResistance": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Measured base resistance R_b,m",
          "de": "Gemessener Spitzenwiderstand R_b,m"
        },
        "widget": "stepper",
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "precision": 2,
        "step": 1000,
        "role": "value",
        "group": "value",
