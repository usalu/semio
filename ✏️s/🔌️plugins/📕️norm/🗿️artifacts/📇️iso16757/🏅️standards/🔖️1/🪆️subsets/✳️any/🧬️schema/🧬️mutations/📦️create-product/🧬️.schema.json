{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateProduct",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product"
  ],
  "properties": {
    "product": {
      "title": "Product",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "seriesId",
        "names",
        "parameterDomains",
        "variants",
        "staticProperties"
      ],
      "properties": {
        "id": { "type": "string" },
        "seriesId": { "type": "string" },
        "names": {
          "title": "Names",
          "type": "object",
          "additionalProperties": false,
          "required": ["preferred", "alternatives"],
          "properties": {
            "preferred": {
              "title": "LocalizedText",
              "type": "object",
              "additionalProperties": false,
              "required": ["locale", "text"],
              "properties": { "locale": { "type": "string" }, "text": { "type": "string" } }
            },
            "shortName": { "type": "string" },
            "alternatives": {
              "type": "array",
              "items": {
                "title": "LocalizedText",
                "type": "object",
                "additionalProperties": false,
                "required": ["locale", "text"],
                "properties": { "locale": { "type": "string" }, "text": { "type": "string" } }
              }
            }
          }
        },
        "parameterDomains": {
          "type": "array",
          "items": {
            "title": "ParameterDomain",
            "type": "object",
            "additionalProperties": false,
            "required": ["parameterId", "allowedValues"],
            "properties": {
              "parameterId": { "type": "string" },
              "allowedValues": { "type": "array", "items": { "type": "object" } },
              "defaultValue": { "type": "object" }
            }
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "title": "ProductVariant",
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "parameterValues", "propertyValues"],
            "properties": {
              "id": { "type": "string" },
              "parameterValues": { "type": "object", "additionalProperties": true },
              "propertyValues": { "type": "array", "items": { "type": "object" } },
              "articleNumber": { "type": ["string", "null"] },
              "geometryId": { "type": ["string", "null"] }
            }
          }
        },
        "staticProperties": {
          "type": "array",
          "items": {
            "title": "PropertyValue",
            "type": "object",
            "additionalProperties": false,
            "required": ["definitionId", "value"],
            "properties": {
              "definitionId": { "type": "string" },
              "value": { "type": "object" },
              "functionId": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "index": {
      "type": ["integer", "null"]
    }
  }
}
