dialect grammar
grammar en1991.op
extension en1991
use family-sheet
start mutation

artifact-mark = "norm.en1991-op"
mutation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("en1991-basis" | "en1991-combination" | "en1991-partial-factor" | "en1991-verdict" | "en1991-annex" | "en1991-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
