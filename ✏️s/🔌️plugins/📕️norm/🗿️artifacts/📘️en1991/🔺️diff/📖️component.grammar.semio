dialect grammar
grammar en1991.diff
extension en1991
use family-sheet
start diff

artifact-mark = "norm.en1991-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("en1991-basis" | "en1991-combination" | "en1991-partial-factor" | "en1991-verdict" | "en1991-annex" | "en1991-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
