{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/insert-silo/schema.json",
  "title": "InsertSilo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "silo"
  ],
  "properties": {
    "mutation": {
      "const": "insertSilo"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted. Empty appends; positions past the end append.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird. Ohne Angabe am Ende; Positionen hinter dem Ende hängen an."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "silo": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/snapshot.json#/$defs/En1998Silo",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Silo",
          "de": "Silo"
        },
        "description": {
          "en": "The complete silo record (EN 1998-4) to insert.",
          "de": "Der vollständige einzufügende Silodatensatz (EN 1998-4)."
        },
        "group": "record",
        "order": 20
      }
    }
