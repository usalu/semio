{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-elevation-regular/schema.json",
  "title": "ChangeElevationRegular",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "buildingIndex",
    "newElevationRegular"
  ],
  "properties": {
    "mutation": {
      "const": "changeElevationRegular"
    },
    "buildingIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "Zero-based position of the building in its list.",
          "de": "Nullbasierte Position des Gebäudes in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "newElevationRegular": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Regular in elevation",
          "de": "Regelmäßig im Aufriss"
        },
        "description": {
          "en": "Criteria of EN 1998-1 §4.2.3.3.",
          "de": "Kriterien nach EN 1998-1 §4.2.3.3."
        },
        "group": "regularity",
        "order": 20
      }
    }
  }
}
