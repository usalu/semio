{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-building-masonry-wall-area-ratio/schema.json",
  "title": "ChangeBuildingMasonryWallAreaRatio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "buildingIndex",
    "newMasonryWallAreaRatio"
  ],
  "properties": {
    "mutation": {
      "const": "changeBuildingMasonryWallAreaRatio"
    },
    "buildingIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "Zero-based position of the building in its list.",
          "de": "Nullbasierte Position des Gebäudes in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "newMasonryWallAreaRatio": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Shear wall area ratio",
          "de": "Wandflächenanteil der Schubwände"
        },
        "description": {
          "en": "Cross-sectional area of the shear walls per direction relative to the floor area (EN 1998-1 Table 9.3).",
          "de": "Querschnittsfläche der Schubwände je Richtung bezogen auf die Geschossfläche (EN 1998-1 Tabelle 9.3)."
        },
        "step": 0.001,
        "precision": 3,
        "group": "masonry",
        "order": 20
      }
    }
  }
}
