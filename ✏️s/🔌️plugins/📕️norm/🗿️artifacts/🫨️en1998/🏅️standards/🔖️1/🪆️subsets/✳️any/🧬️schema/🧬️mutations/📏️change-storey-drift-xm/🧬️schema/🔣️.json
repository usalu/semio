{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-storey-drift-xm/schema.json",
  "title": "ChangeStoreyDriftXM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "buildingId",
    "id",
    "newDriftXM"
  ],
  "properties": {
    "mutation": {
      "const": "changeStoreyDriftXM"
    },
    "buildingId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "The building this mutation addresses, by id.",
          "de": "Das adressierte Element (Gebäude), per Kennung."
        },
        "ref": {
          "kind": "building"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Storey",
          "de": "Geschoss"
        },
        "description": {
          "en": "The storey this mutation addresses, by id.",
          "de": "Das adressierte Element (Geschoss), per Kennung."
        },
        "ref": {
          "kind": "storey"
        },
        "group": "target",
        "order": 20
      }
    },
    "newDriftXM": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Design interstorey drift d_r,x",
          "de": "Bemessungswert der Stockwerksverschiebung d_r,x"
