{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-storey-drift-xm/schema.json",
  "title": "ChangeStoreyDriftXM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "buildingIndex",
    "storeyIndex",
    "newDriftXM"
  ],
  "properties": {
    "mutation": {
      "const": "changeStoreyDriftXM"
    },
    "buildingIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "Zero-based position of the building in its list.",
          "de": "Nullbasierte Position des Gebäudes in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "storeyIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Storey",
          "de": "Geschoss"
        },
        "description": {
          "en": "Zero-based position of the storey within the building in its list.",
          "de": "Nullbasierte Position des Geschosses im Gebäude in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "newDriftXM": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Design interstorey drift d_r,x",
          "de": "Bemessungswert der Stockwerksverschiebung d_r,x"
        },
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "step": 0.001,
        "precision": 1,
        "group": "damage-limitation",
        "order": 30
      }
    }
  }
}
