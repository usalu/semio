{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-member-detailing-compatible/schema.json",
  "title": "ChangeMemberDetailingCompatible",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "buildingIndex",
    "memberIndex",
    "newDetailingCompatibleWithQ"
  ],
  "properties": {
    "mutation": {
      "const": "changeMemberDetailingCompatible"
    },
    "buildingIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "Zero-based position of the building in its list.",
          "de": "Nullbasierte Position des Gebäudes in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "memberIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Member",
          "de": "Bauteil"
        },
        "description": {
          "en": "Zero-based position of the member within the building in its list.",
          "de": "Nullbasierte Position des Bauteils im Gebäude in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "newDetailingCompatibleWithQ": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Detailing compatible with q",
          "de": "Konstruktive Durchbildung passend zu q"
        },
        "description": {
          "en": "Whether the member detailing meets the ductility class assumed for the behaviour factor q.",
          "de": "Ob die konstruktive Durchbildung des Bauteils der für den Verhaltensbeiwert q angesetzten Duktilitätsklasse entspricht."
        },
        "group": "ductility",
        "order": 30
      }
    }
  }
}
