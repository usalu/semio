{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-joint-ym/schema.json",
  "title": "ChangeJointYM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
