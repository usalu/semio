{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-site-n-spt/schema.json",
  "title": "ChangeSiteNSpt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newNSpt"
  ],
  "properties": {
    "mutation": {
      "const": "changeSiteNSpt"
    },
    "newNSpt": {
      "type": "number",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Time-averaged SPT blow count N_SPT of the top 30 m (0 = not given)",
          "de": "Zeitlich gemittelte SPT-Schlagzahl N_SPT der obersten 30 m (0 = nicht angegeben)"
        },
        "group": "value",
        "order": 10,
        "widget": "stepper",
        "step": 0.001,
        "precision": 3
      }
    }
  }
}
