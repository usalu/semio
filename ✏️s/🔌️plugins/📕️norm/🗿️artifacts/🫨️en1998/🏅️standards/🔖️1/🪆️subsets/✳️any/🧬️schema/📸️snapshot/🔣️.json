            "widget": "stepper",
            "unit": "s",
            "precision": 2
          }
        },
        "ct": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Coefficient C_t",
              "de": "Beiwert C_t"
            },
            "widget": "stepper",
            "precision": 3
          }
        },
        "driftLimitClass": {
          "type": "string",
