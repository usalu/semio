      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "planWidthM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Plan dimension L_x",
              "de": "Grundrissabmessung L_x"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "planLengthM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Plan dimension L_y",
              "de": "Grundrissabmessung L_y"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/En1998System"
          },
          "x-semio-ui": {
            "label": {
              "en": "Lateral load-resisting systems",
              "de": "Aussteifungssysteme"
            }
          }
        },
        "storeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/En1998Storey"
          },
          "x-semio-ui": {
            "label": {
              "en": "Storeys",
              "de": "Geschosse"
            }
          }
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/En1998Member"
          },
          "x-semio-ui": {
            "label": {
              "en": "Members",
              "de": "Bauteile"
            }
          }
        },
        "planRegular": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Building",
              "de": "Gebäude"
            },
            "description": {
              "en": "Zero-based position of the building in its list.",
              "de": "Nullbasierte Position des Gebäudes in der Liste."
            }
          }
        },
        "elevationRegular": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Building",
              "de": "Gebäude"
            },
            "description": {
              "en": "Zero-based position of the building in its list.",
              "de": "Nullbasierte Position des Gebäudes in der Liste."
            }
          }
        },
        "t1Method": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Fundamental period method",
              "de": "Verfahren für die Grundschwingzeit"
            },
            "description": {
              "en": "formula (4.6) or given.",
              "de": "Formel (4.6) oder vorgegeben."
            },
            "widget": "text"
          }
        },
        "t1GivenS": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Given fundamental period T₁",
              "de": "Vorgegebene Grundschwingzeit T₁"
