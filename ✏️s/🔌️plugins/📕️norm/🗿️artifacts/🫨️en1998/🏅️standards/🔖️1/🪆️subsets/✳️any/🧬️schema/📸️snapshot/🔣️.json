        },
        "masonryWallAreaRatio": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Building",
              "de": "Gebäude"
            },
            "description": {
              "en": "Zero-based position of the building in its list.",
              "de": "Nullbasierte Position des Gebäudes in der Liste."
            },
            "step": 1,
            "precision": 0
          }
        },
        "accidentalEccentricityRatio": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Accidental eccentricity ratio",
              "de": "Verhältnis der zufälligen Exzentrizität"
            },
            "widget": "stepper",
            "precision": 3
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "En1998Bridge": {
      "title": "En1998Bridge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "periodRatio",
        "fundamentalPeriodS",
        "vRdN",
        "bearingDRdM",
        "permanentGkN",
        "correlatedOccupancy",
        "variables"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "periodRatio": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Isolation period ratio T_isol/T_fixed",
              "de": "Periodenverhältnis T_isol/T_fixed"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "fundamentalPeriodS": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Fundamental period T",
              "de": "Grundschwingzeit T"
            },
            "widget": "stepper",
            "unit": "s",
            "precision": 2
          }
        },
        "vRdN": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Design shear resistance V_Rd",
              "de": "Bemessungswert der Querkrafttragfähigkeit V_Rd"
            },
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "step": 1000,
            "precision": 0
          }
        },
        "bearingDRdM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Bearing displacement capacity d_Rd",
              "de": "Verschiebungskapazität des Lagers d_Rd"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
