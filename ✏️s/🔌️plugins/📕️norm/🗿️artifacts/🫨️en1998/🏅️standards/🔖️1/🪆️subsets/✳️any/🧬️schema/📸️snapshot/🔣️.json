            "label": {
              "en": "Reduction factor ν",
              "de": "Abminderungsbeiwert ν"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "multipleResistingSystems": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Multiple resisting systems",
              "de": "Mehrere Aussteifungssysteme"
            },
            "widget": "toggle"
          }
        },
        "claimsSimpleMasonry": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Simple masonry building",
              "de": "Einfacher Mauerwerksbau"
            },
            "widget": "toggle"
