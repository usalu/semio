{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/snapshot.json",
  "title": "En1998Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex",
    "site",
    "buildings",
    "bridges",
    "assessments",
    "silos",
    "tanks",
    "foundations",
    "retainingWalls",
    "towers"
  ],
  "properties": {
    "annex": {
      "type": "string"
    },
    "site": {
      "$ref": "#/$defs/En1998Site"
    },
    "buildings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/En1998Building"
      }
    },
    "bridges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/En1998Bridge"
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/En1998Assessment"
      }
    },
    "silos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/En1998Silo"
      }
    },
    "tanks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/En1998Tank"
      }
    },
    "foundations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/En1998Foundation"
      }
    },
    "retainingWalls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/En1998RetainingWall"
      }
    },
    "towers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/En1998Tower"
      }
    }
  },
  "$defs": {
    "En1998Site": {
      "title": "En1998Site",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seismicZone",
        "aGr",
        "deGroundCombo",
        "importanceClass"
      ],
      "properties": {
        "seismicZone": {
          "$ref": "#/$defs/DeSeismicZone",
          "x-semio-ui": {
            "label": {
              "en": "Seismic zone",
              "de": "Erdbebenzone"
            }
          }
        },
        "aGr": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Reference peak ground acceleration a_gR",
              "de": "Referenz-Spitzenbodenbeschleunigung a_gR"
            },
            "widget": "stepper",
            "unit": "m/s²",
            "precision": 2
          }
        },
        "deGroundCombo": {
          "$ref": "#/$defs/DeGroundCombo",
          "x-semio-ui": {
            "label": {
              "en": "Ground class and subsoil class",
              "de": "Baugrundklasse und Untergrundklasse"
            }
          }
        },
        "enGroundType": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Ground type",
              "de": "Baugrundklasse"
            },
            "description": {
              "en": "A to E (EN 1998-1 Table 3.1); empty under the German annex.",
              "de": "A bis E (EN 1998-1 Tabelle 3.1); leer beim deutschen Anhang."
            },
            "widget": "text"
          }
        },
        "enSpectrumType": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Spectrum type",
              "de": "Spektrumtyp"
            },
            "description": {
              "en": "type1 or type2; empty under the German annex.",
              "de": "type1 oder type2; leer beim deutschen Anhang."
            },
            "widget": "text"
          }
        },
        "importanceClass": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Importance class",
              "de": "Bedeutungskategorie"
            },
            "widget": "text"
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "En1998System": {
      "title": "En1998System",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "direction",
        "systemType",
        "material",
        "ductilityClass",
        "q0",
        "alphaUOverAlpha1",
        "kW",
        "baseShearResistanceN"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Direction",
              "de": "Richtung"
            },
            "description": {
              "en": "x or y.",
              "de": "x oder y."
            },
            "widget": "text"
          }
        },
        "systemType": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Structural type",
              "de": "Tragwerkstyp"
            },
            "description": {
              "en": "frame, wall, dual, inverted pendulum …",
              "de": "Rahmen, Wand, Mischsystem, umgekehrtes Pendel …"
            },
            "widget": "text"
          }
        },
        "material": {
          "type": "string"
        },
        "ductilityClass": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Ductility class",
              "de": "Duktilitätsklasse"
            },
            "description": {
              "en": "DCL, DCM or DCH.",
              "de": "DCL, DCM oder DCH."
            },
            "widget": "text"
          }
        },
        "q0": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Basic behaviour factor q₀",
              "de": "Grundwert des Verhaltensbeiwerts q₀"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "alphaUOverAlpha1": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Overstrength ratio α_u/α₁",
              "de": "Überfestigkeitsverhältnis α_u/α₁"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "kW": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Failure-mode factor k_w",
              "de": "Beiwert der Versagensart k_w"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "baseShearResistanceN": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Building",
              "de": "Gebäude"
            },
            "description": {
              "en": "Zero-based position of the building in its list.",
              "de": "Nullbasierte Position des Gebäudes in der Liste."
            },
            "step": 1,
            "precision": 0
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "En1998Storey": {
      "title": "En1998Storey",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heightM",
        "permanentGkN",
        "correlatedOccupancy",
        "variables",
        "stiffnessX",
        "stiffnessY",
        "centreOfMassXM",
        "centreOfMassYM",
        "centreOfStiffnessXM",
        "centreOfStiffnessYM",
        "driftXM",
        "driftYM",
        "shearResistanceN"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "heightM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Storey height",
              "de": "Geschosshöhe"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "permanentGkN": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Building",
              "de": "Gebäude"
            },
            "description": {
              "en": "Zero-based position of the building in its list.",
              "de": "Nullbasierte Position des Gebäudes in der Liste."
            },
            "step": 1,
            "precision": 0
          }
        },
        "correlatedOccupancy": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Correlated occupancy",
              "de": "Korrelierte Nutzung"
            },
            "widget": "toggle"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/En1998VariableAction"
          },
          "x-semio-ui": {
            "label": {
              "en": "Variable actions",
              "de": "Veränderliche Einwirkungen"
            }
          }
        },
        "stiffnessX": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Building",
              "de": "Gebäude"
            },
            "description": {
              "en": "Zero-based position of the building in its list.",
              "de": "Nullbasierte Position des Gebäudes in der Liste."
            },
            "step": 1,
            "precision": 0
          }
        },
        "stiffnessY": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Lateral stiffness k_y",
              "de": "Horizontalsteifigkeit k_y"
            },
            "widget": "stepper",
            "unit": "N/m",
            "displayUnit": "kN/m",
            "displayFactor": 0.001,
            "precision": 0
          }
        },
        "centreOfMassXM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Centre of mass x",
              "de": "Massenschwerpunkt x"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "centreOfMassYM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Centre of mass y",
              "de": "Massenschwerpunkt y"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "centreOfStiffnessXM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Centre of stiffness x",
              "de": "Steifigkeitsmittelpunkt x"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "centreOfStiffnessYM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Centre of stiffness y",
              "de": "Steifigkeitsmittelpunkt y"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "driftXM": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Design interstorey drift d_r,x",
              "de": "Bemessungswert der Stockwerksverschiebung d_r,x"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.001,
            "precision": 1
          }
        },
        "driftYM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Interstorey drift d_r,y",
              "de": "Stockwerksverschiebung d_r,y"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "shearResistanceN": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Storey shear resistance V_Rd",
              "de": "Geschossschubwiderstand V_Rd"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "En1998Member": {
      "title": "En1998Member",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "material",
        "role",
        "detailingCompatibleWithQ",
        "minDimensionM",
        "rho",
        "rhoPrime",
        "omegaWd",
        "steelSectionClass"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "detailingCompatibleWithQ": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Detailing compatible with q",
              "de": "Konstruktive Durchbildung passend zu q"
            },
            "description": {
              "en": "Whether the member detailing meets the ductility class assumed for the behaviour factor q.",
              "de": "Ob die konstruktive Durchbildung des Bauteils der für den Verhaltensbeiwert q angesetzten Duktilitätsklasse entspricht."
            }
          }
        },
        "minDimensionM": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Minimum cross-section dimension b",
              "de": "Kleinste Querschnittsabmessung b"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "rho": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Tension reinforcement ratio ρ",
              "de": "Zugbewehrungsgrad ρ"
            },
            "widget": "stepper",
            "unit": "1",
            "displayUnit": "%",
            "displayFactor": 100,
            "precision": 2
          }
        },
        "rhoPrime": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Compression reinforcement ratio ρ′",
              "de": "Druckbewehrungsgrad ρ′"
            },
            "widget": "stepper",
            "unit": "1",
            "displayUnit": "%",
            "displayFactor": 100,
            "precision": 2
          }
        },
        "omegaWd": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Mechanical volumetric ratio of confinement ω_wd",
              "de": "Mechanischer Umschnürungsbewehrungsgrad ω_wd"
            },
            "widget": "stepper",
            "precision": 3
          }
        },
        "steelSectionClass": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Steel cross-section class",
              "de": "Querschnittsklasse (Stahl)"
            },
            "widget": "stepper",
            "step": 1,
            "precision": 0
          },
          "maximum": 255
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "En1998Building": {
      "title": "En1998Building",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "planWidthM",
        "planLengthM",
        "systems",
        "storeys",
        "members",
        "planRegular",
        "elevationRegular",
        "t1Method",
        "t1GivenS",
        "ct",
        "driftLimitClass",
        "nu",
        "multipleResistingSystems",
        "claimsSimpleMasonry",
        "masonryWallAreaRatio",
        "accidentalEccentricityRatio"
