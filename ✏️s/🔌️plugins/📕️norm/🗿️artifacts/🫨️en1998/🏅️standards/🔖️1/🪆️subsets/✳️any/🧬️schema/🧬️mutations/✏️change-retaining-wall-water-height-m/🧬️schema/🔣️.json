    },
    "newWaterHeightM": {
      "type": "number",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Height of the retained water above the wall base for the hydrostatic and hydrodynamic water pressure (0 = none)",
          "de": "Höhe des angestauten Wassers über der Wandsohle für den hydrostatischen und hydrodynamischen Wasserdruck (0 = keines)"
        },
        "group": "value",
        "order": 20,
        "widget": "stepper",
        "step": 0.001,
        "precision": 3
      }
