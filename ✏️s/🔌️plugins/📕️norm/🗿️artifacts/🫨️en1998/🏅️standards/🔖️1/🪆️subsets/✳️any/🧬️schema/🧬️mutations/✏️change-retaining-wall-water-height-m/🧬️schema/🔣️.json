{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-retaining-wall-water-height-m/schema.json",
  "title": "ChangeRetainingWallWaterHeightM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "newWaterHeightM"
  ],
  "properties": {
    "mutation": {
      "const": "changeRetainingWallWaterHeightM"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Retaining wall",
          "de": "Stützwand"
        },
        "description": {
          "en": "Zero-based position of the retaining wall in its list.",
          "de": "Nullbasierte Position in der Liste (Stützwand)."
