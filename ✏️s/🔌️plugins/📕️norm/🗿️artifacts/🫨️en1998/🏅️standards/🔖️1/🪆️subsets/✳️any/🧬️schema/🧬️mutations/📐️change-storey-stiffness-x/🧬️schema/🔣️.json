{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-storey-stiffness-x/schema.json",
  "title": "ChangeStoreyStiffnessX",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "buildingId",
    "id",
    "newStiffnessX"
  ],
  "properties": {
    "mutation": {
      "const": "changeStoreyStiffnessX"
    },
    "buildingId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "The building this mutation addresses, by id.",
          "de": "Das adressierte Element (Gebäude), per Kennung."
        },
        "ref": {
          "kind": "building"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Storey",
          "de": "Geschoss"
        },
        "description": {
          "en": "The storey this mutation addresses, by id.",
          "de": "Das adressierte Element (Geschoss), per Kennung."
        },
        "ref": {
          "kind": "storey"
        },
        "group": "target",
        "order": 20
      }
    },
    "newStiffnessX": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Storey stiffness in x",
          "de": "Geschosssteifigkeit in x-Richtung"
        },
        "unit": "N/m",
        "step": 1000000,
        "precision": 0,
        "group": "regularity",
        "order": 30
      }
    }
  }
}
