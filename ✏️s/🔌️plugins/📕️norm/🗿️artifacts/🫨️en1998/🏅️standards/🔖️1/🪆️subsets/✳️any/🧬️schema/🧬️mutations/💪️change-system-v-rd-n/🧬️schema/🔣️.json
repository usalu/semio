{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-system-v-rd-n/schema.json",
  "title": "ChangeSystemVRdN",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "buildingId",
    "id",
    "newBaseShearResistanceN"
  ],
  "properties": {
    "mutation": {
      "const": "changeSystemVRdN"
    },
    "buildingId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "The building this mutation addresses, by id.",
          "de": "Das adressierte Element (Gebäude), per Kennung."
        },
        "ref": {
          "kind": "building"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Structural system",
          "de": "Tragsystem"
        },
        "description": {
          "en": "The structural system this mutation addresses, by id.",
          "de": "Das adressierte Element (Tragsystem), per Kennung."
        },
        "ref": {
          "kind": "system"
        },
        "group": "target",
        "order": 20
      }
    },
    "newBaseShearResistanceN": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Base shear resistance V_Rd",
          "de": "Widerstand gegen die Gesamterdbebenkraft V_Rd"
        },
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "step": 1000,
        "precision": 0,
        "group": "resistance",
        "order": 30
