{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-member-detailing/schema.json",
  "title": "ChangeMemberDetailing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "buildingId",
    "id",
    "newDetailingCompatibleWithQ"
  ],
  "properties": {
    "mutation": {
      "const": "changeMemberDetailing"
    },
    "buildingId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "The building this mutation addresses, by id.",
          "de": "Das adressierte Element (Gebäude), per Kennung."
        },
        "ref": {
          "kind": "building"
        },
        "group": "target",
        "order": 10
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Member",
          "de": "Bauteil"
        },
        "description": {
          "en": "The member this mutation addresses, by id.",
          "de": "Das adressierte Element (Bauteil), per Kennung."
        },
        "ref": {
          "kind": "member"
        },
        "group": "target",
        "order": 20
      }
    },
    "newDetailingCompatibleWithQ": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Detailing compatible with q",
          "de": "Konstruktive Durchbildung passend zu q"
        },
        "description": {
          "en": "Whether the member detailing meets the ductility class assumed for the behaviour factor q.",
          "de": "Ob die konstruktive Durchbildung des Bauteils der für den Verhaltensbeiwert q angesetzten Duktilitätsklasse entspricht."
        },
        "group": "ductility",
        "order": 30
      }
    }
  }
}
