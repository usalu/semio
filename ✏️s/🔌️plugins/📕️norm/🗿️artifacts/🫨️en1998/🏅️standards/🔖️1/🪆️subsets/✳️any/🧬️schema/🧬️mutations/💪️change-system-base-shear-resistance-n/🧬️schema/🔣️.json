    "systemIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Structural system",
          "de": "Tragsystem"
        },
        "description": {
          "en": "Zero-based position of the structural system within the building in its list.",
