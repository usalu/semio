  "properties": {
    "mutation": {
      "const": "changeSystemBaseShearResistanceN"
    },
    "buildingIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "Zero-based position of the building in its list.",
          "de": "Nullbasierte Position des Gebäudes in der Liste."
