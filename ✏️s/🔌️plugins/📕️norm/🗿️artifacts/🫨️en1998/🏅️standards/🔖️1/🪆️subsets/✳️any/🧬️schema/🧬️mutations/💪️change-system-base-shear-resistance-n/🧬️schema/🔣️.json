{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-system-base-shear-resistance-n/schema.json",
  "title": "ChangeSystemBaseShearResistanceN",
  "type": "object",
  "additionalProperties": false,
  "required": [
