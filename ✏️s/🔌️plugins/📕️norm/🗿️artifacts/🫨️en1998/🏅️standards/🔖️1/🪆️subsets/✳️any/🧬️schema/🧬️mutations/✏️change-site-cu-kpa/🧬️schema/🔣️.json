{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/change-site-cu-kpa/schema.json",
  "title": "ChangeSiteCUKpa",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newCUKpa"
  ],
  "properties": {
    "mutation": {
