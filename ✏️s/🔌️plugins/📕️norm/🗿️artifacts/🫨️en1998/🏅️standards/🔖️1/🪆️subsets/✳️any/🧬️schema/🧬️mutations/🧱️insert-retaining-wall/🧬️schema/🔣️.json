{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/insert-retaining-wall/schema.json",
  "title": "InsertRetainingWall",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "wall"
  ],
  "properties": {
    "mutation": {
      "const": "insertRetainingWall"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "wall": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/snapshot.json#/$defs/En1998RetainingWall",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Retaining wall",
          "de": "Stützwand"
        },
        "description": {
          "en": "The complete retaining wall record (EN 1998-5) to insert.",
          "de": "Der vollständige einzufügende Stützwand-Datensatz (EN 1998-5)."
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
