{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/mutation/insert-bridge/schema.json",
  "title": "InsertBridge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "bridge"
  ],
  "properties": {
    "mutation": {
      "const": "insertBridge"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted. Empty appends; positions past the end append.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird. Ohne Angabe am Ende; Positionen hinter dem Ende hängen an."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "bridge": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1998/snapshot.json#/$defs/En1998Bridge",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Bridge",
          "de": "Brücke"
        },
        "description": {
          "en": "The complete bridge record (EN 1998-2) to insert.",
          "de": "Der vollständige einzufügende Brückendatensatz (EN 1998-2)."
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
