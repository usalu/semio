dialect grammar
grammar en1992.document
extension en1992
use family-sheet
start document

artifact-mark = "norm.en1992"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = field-name "=" value
field-name = "en1992-basis" | "en1992-combination" | "en1992-partial-factor" | "en1992-verdict" | "en1992-annex" | "en1992-actor" | "started" | "actor"
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
