dialect grammar
grammar en1992.op
extension en1992
use family-sheet
start operation

operation = ("set" | "patch" | "remove") field*
field = ("annex" | "m-ed-knm" | "v-ed-kn" | "f-ck" | "b-mm" | "d-mm" | "a-s-mm2" | "f-yk" | "rho-l" | "n-ed-kn" | "p-kn" | "a-c-mm2" | "use-fem" | "span-m" | "udl-kn-m" | "fire-rating" | "provided-axis-distance-mm" | "bridge-sigma-c-mpa" | "bridge-delta-sigma-s-mpa" | "tightness-class" | "hd-over-h" | "liquid-sigma-s-mpa" | "liquid-rho-p-eff" | "liquid-f-ct-eff-mpa" | "liquid-e-s-mpa" | "liquid-s-r-max-mm" | "anchor-h-ef-mm" | "anchor-cracked" | "anchor-f-uk-mpa" | "anchor-f-yk-mpa" | "anchor-a-s-mm2" | "anchor-d-mm" | "anchor-c1-mm" | "anchor-n-ed-kn" | "anchor-v-ed-kn" | "started" | "actor" | IDENT) "=" value
value = TEXT | INT | FLOAT | BOOL | UNITNUM | IDENT
UNITNUM = FLOAT UNIT | INT UNIT
UNIT = IDENT
