dialect protocol
protocol din4108.mutations
version 1
schema norm.din4108.mutations
start record
framing record

# Real `Din4108Mutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record change-category tag=0
field payload bytes
record change-climate tag=1
field payload bytes
record change-airtightness-n50 tag=2
field payload bytes
record change-psi-times-l-sum tag=3
field payload bytes
record change-rh-int tag=4
field payload bytes
record change-catalog-id tag=5
field payload bytes
record change-material-id tag=6
field payload bytes
record change-airtightness-class tag=7
field payload bytes
record change-t-int-c tag=8
field payload bytes
record change-solar-absorptance tag=9
field payload bytes
record change-irradiance-wm2 tag=10
field payload bytes
record change-moisture-mu-exterior tag=11
field payload bytes
record change-moisture-mu-interior tag=12
field payload bytes
record change-envelope-area-m2 tag=13
field payload bytes
record change-bb2-details-conform tag=14
field payload bytes
record change-application-type tag=15
field payload bytes
record change-declared-application-class tag=16
field payload bytes
record insert-layer tag=17
field payload bytes
record remove-layer tag=18
field payload bytes
record reorder-layers tag=19
field payload bytes
record change-layer-thickness tag=20
field payload bytes
record change-layer-lambda tag=21
field payload bytes
