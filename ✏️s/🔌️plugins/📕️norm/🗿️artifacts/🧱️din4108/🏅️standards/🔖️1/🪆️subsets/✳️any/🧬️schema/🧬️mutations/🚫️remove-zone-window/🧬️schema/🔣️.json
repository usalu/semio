{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/mutation/remove-zone-window/schema.json",
  "title": "RemoveZoneWindow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId",
    "index"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The thermal zone this mutation addresses.",
          "de": "Die thermische Zone, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "Zero-based position of the window within the zone in its list.",
          "de": "Nullbasierte Position des Fensters in der Zone in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  }
}
