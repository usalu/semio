{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/mutation/change-zone-window-area/schema.json",
  "title": "ChangeZoneWindowArea",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId",
    "windowId",
    "newAreaM2"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The thermal zone this mutation addresses.",
          "de": "Die thermische Zone, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "windowId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The window of the zone this mutation addresses.",
          "de": "Das Fenster der Zone, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "window"
        },
        "group": "target",
        "order": 20
      }
    },
    "newAreaM2": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Window area A_w",
          "de": "Fensterfläche A_w"
        },
        "unit": "m²",
        "step": 0.1,
        "precision": 2,
        "group": "summer",
        "order": 30
      }
    }
  }
}
