    "newFloorAreaM2": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Net floor area A_G",
          "de": "Nettogrundfläche A_G"
        },
        "unit": "m²",
        "step": 1,
        "precision": 1,
        "group": "summer",
        "order": 20
