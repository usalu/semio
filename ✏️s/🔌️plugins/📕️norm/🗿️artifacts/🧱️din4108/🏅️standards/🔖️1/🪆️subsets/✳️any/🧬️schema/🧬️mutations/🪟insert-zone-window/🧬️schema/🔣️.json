{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/mutation/insert-zone-window/schema.json",
  "title": "InsertZoneWindow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId",
    "window"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The thermal zone this mutation addresses.",
          "de": "Die thermische Zone, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted. Empty appends; positions past the end append.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird. Ohne Angabe am Ende; Positionen hinter dem Ende hängen an."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "window": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/snapshot.json#/$defs/ZoneWindow",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The complete window record to insert into the zone.",
          "de": "Der vollständige in die Zone einzufügende Fensterdatensatz."
        },
        "group": "record",
        "order": 30
      }
    }
  }
}
