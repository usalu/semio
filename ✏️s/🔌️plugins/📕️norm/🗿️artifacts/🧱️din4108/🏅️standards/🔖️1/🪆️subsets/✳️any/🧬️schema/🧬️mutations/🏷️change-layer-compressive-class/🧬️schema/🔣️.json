{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/mutation/change-layer-compressive-class/schema.json",
  "title": "ChangeLayerCompressiveClass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "elementId",
    "index",
    "newCompressiveClass"
  ],
  "properties": {
    "elementId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Envelope element",
          "de": "Bauteil der Gebäudehülle"
        },
        "description": {
          "en": "The envelope element this mutation addresses.",
          "de": "Das Bauteil der Gebäudehülle, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "element"
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Layer",
          "de": "Schicht"
        },
        "description": {
          "en": "Zero-based position of the layer, counted from the interior in its list.",
