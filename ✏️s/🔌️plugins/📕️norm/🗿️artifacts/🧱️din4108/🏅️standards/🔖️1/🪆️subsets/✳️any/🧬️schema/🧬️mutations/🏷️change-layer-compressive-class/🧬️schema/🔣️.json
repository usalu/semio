        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "newCompressiveClass": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Compressive load class",
          "de": "Druckbelastbarkeit"
        },
        "description": {
          "en": "DIN 4108-10 class dh, ds, dm, dk or dx.",
