    "newAdjacent": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Adjacent space",
          "de": "Angrenzender Bereich"
        },
        "description": {
          "en": "exterior, ground, unheated or otherHeated.",
          "de": "exterior (Außenluft), ground (Erdreich), unheated (unbeheizter Raum) oder otherHeated (anderer beheizter Raum)."
        },
        "group": "envelope",
        "order": 20
