{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/mutation/change-element-adjacent/schema.json",
  "title": "ChangeElementAdjacent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "elementId",
    "newAdjacent"
  ],
  "properties": {
    "elementId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Envelope element",
          "de": "Bauteil der Gebäudehülle"
        },
        "description": {
          "en": "The envelope element this mutation addresses.",
          "de": "Das Bauteil der Gebäudehülle, das diese Mutation adressiert."
