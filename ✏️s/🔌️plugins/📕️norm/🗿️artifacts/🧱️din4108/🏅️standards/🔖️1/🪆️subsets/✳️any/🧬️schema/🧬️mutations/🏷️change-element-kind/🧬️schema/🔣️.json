{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/mutation/change-element-kind/schema.json",
  "title": "ChangeElementKind",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "elementId",
    "newKind"
  ],
  "properties": {
    "elementId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Envelope element",
          "de": "Bauteil der Gebäudehülle"
        },
        "description": {
          "en": "The envelope element this mutation addresses.",
          "de": "Das Bauteil der Gebäudehülle, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "element"
        },
        "group": "target",
        "order": 10
      }
    },
    "newKind": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Element type",
          "de": "Bauteilart"
        },
        "description": {
          "en": "wall, roof, floor, window, door, frameOpaque or rollerShutterBox.",
          "de": "wall (Wand), roof (Dach), floor (Boden), window (Fenster), door (Tür), frameOpaque (opaker Rahmen) oder rollerShutterBox (Rollladenkasten)."
        },
        "group": "envelope",
        "order": 20
      }
    }
  }
