{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/mutation/insert-layer/schema.json",
  "title": "InsertLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "elementId",
    "index",
    "layer"
  ],
  "properties": {
    "elementId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Envelope element",
          "de": "Bauteil der Gebäudehülle"
        },
        "description": {
          "en": "The envelope element this mutation addresses.",
          "de": "Das Bauteil der Gebäudehülle, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "element"
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "layer": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/snapshot.json#/$defs/LayerDocument",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Layer",
          "de": "Schicht"
        },
        "description": {
          "en": "The complete construction layer record to insert.",
          "de": "Der vollständige einzufügende Schichtdatensatz."
        },
        "group": "record",
        "order": 30
      }
    }
  }
}
