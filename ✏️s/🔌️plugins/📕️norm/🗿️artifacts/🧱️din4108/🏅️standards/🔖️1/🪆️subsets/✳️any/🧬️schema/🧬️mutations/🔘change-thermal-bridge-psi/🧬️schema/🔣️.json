{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/mutation/change-thermal-bridge-psi/schema.json",
  "title": "ChangeThermalBridgePsi",
  "type": "object",
  "additionalProperties": false,
  "required": [
