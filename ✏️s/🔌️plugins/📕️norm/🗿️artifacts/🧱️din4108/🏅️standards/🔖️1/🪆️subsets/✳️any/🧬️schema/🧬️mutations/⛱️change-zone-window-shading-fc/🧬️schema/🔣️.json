{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din4108/mutation/change-zone-window-shading-fc/schema.json",
  "title": "ChangeZoneWindowShadingFc",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId",
    "windowId",
    "newShadingFc"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The thermal zone this mutation addresses.",
          "de": "Die thermische Zone, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "windowId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Window",
          "de": "Fenster"
        },
        "description": {
          "en": "The window of the zone this mutation addresses.",
          "de": "Das Fenster der Zone, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "window"
        },
        "group": "target",
        "order": 20
      }
    },
    "newShadingFc": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Shading reduction factor F_C",
          "de": "Abminderungsfaktor für Sonnenschutzvorrichtungen F_C"
        },
        "unit": "1",
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 0,
        "group": "summer",
        "order": 30
      }
    }
  }
}
