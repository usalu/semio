dialect grammar
grammar din16798.diff
extension din16798
use family-sheet
start diff

artifact-mark = "norm.din16798-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("din16798-basis" | "din16798-combination" | "din16798-partial-factor" | "din16798-verdict" | "din16798-annex" | "din16798-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
