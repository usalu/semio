dialect grammar
grammar din16798.document
extension din16798
use family-sheet
start document

artifact-mark = "norm.din16798"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("din16798-basis" | "din16798-combination" | "din16798-partial-factor" | "din16798-verdict" | "din16798-annex" | "din16798-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
