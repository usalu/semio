dialect grammar
grammar din18599.diff
extension din18599
use family-sheet
start diff

diff = change*
change = ("set" | "unset" | "replace") ("started" | "actor" | "use-class" | "heated-area-m2" | "occupants" | "h-t" | "h-v" | "internal-gains-w-m2" | "solar-gains-kwh" | "system-losses-kwh" | "renewable-kwh" | "annual-limit-kwh" | "energy-carrier" | "reference-q-p-kwh" | "theta-e-c" | "g-h-w-m2" | IDENT) ("=" value)?
value = TEXT | INT | FLOAT | BOOL | UNITNUM | IDENT
UNITNUM = FLOAT UNIT | INT UNIT
UNIT = IDENT
