dialect grammar
grammar din18599.diff
extension din18599
use family-sheet
start diff

artifact-mark = "norm.din18599-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("din18599-basis" | "din18599-combination" | "din18599-partial-factor" | "din18599-verdict" | "din18599-annex" | "din18599-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
