dialect grammar
grammar din18599.document
extension din18599
use family-sheet
start document

artifact-mark = "norm.din18599"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("din18599-basis" | "din18599-combination" | "din18599-partial-factor" | "din18599-verdict" | "din18599-annex" | "din18599-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
