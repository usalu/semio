dialect grammar
grammar din18599.op
extension din18599
use family-sheet
start operation

artifact-mark = "norm.din18599-op"
operation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("din18599-basis" | "din18599-combination" | "din18599-partial-factor" | "din18599-verdict" | "din18599-annex" | "din18599-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
