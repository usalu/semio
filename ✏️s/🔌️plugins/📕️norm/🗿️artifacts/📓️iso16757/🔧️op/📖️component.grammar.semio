dialect grammar
grammar iso16757.op
extension iso16757
use family-sheet
start operation

artifact-mark = "norm.iso16757-op"
operation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("iso16757-basis" | "iso16757-combination" | "iso16757-partial-factor" | "iso16757-verdict" | "iso16757-annex" | "iso16757-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
