dialect grammar
grammar iso16757.diff
extension iso16757
use family-sheet
start diff

artifact-mark = "norm.iso16757-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("iso16757-basis" | "iso16757-combination" | "iso16757-partial-factor" | "iso16757-verdict" | "iso16757-annex" | "iso16757-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
