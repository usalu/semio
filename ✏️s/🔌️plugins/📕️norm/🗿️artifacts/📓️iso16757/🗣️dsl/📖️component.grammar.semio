dialect grammar
grammar iso16757.document
extension iso16757
use family-sheet
start document

artifact-mark = "norm.iso16757"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("iso16757-basis" | "iso16757-combination" | "iso16757-partial-factor" | "iso16757-verdict" | "iso16757-annex" | "iso16757-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
