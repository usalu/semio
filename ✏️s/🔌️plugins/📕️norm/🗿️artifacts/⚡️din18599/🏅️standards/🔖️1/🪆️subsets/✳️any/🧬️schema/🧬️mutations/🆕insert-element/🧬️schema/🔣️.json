{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din18599/mutation/insert-element/schema.json",
  "title": "InsertElement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "element"
  ],
  "properties": {
    "mutation": {
      "const": "insertelement"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "element": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/din18599/snapshot/schema.json#/$defs/EnvelopeElement",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Envelope element",
          "de": "Bauteil der Gebäudehülle"
        },
        "description": {
          "en": "The complete element record to insert.",
          "de": "Der vollständige einzufügende Datensatz (Bauteil)."
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
