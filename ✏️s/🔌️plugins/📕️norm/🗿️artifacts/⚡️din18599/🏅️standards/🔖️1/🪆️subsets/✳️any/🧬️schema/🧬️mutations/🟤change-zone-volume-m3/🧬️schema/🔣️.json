{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din18599/mutation/change-zone-volume-m3/schema.json",
  "title": "ChangeZoneVolumeM3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "zoneId",
    "newVolumeM3"
  ],
  "properties": {
