        "ref": {
          "kind": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newPollutionClass": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Building pollution class",
          "de": "Emissionsklasse des Gebäudes"
        },
        "description": {
          "en": "very_low, low or non_low (EN 16798-1 Annex B).",
          "de": "very_low (sehr schadstoffarm), low (schadstoffarm) oder non_low (nicht schadstoffarm) nach EN 16798-1 Anhang B."
        },
        "group": "air-quality",
        "order": 20
      }
    }
