{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din16798/mutation/change-zone-co2/schema.json",
  "title": "ChangeZoneCo2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId",
    "newCo2Ppm"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The ventilation zone this mutation addresses.",
          "de": "Die Lüftungszone, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newCo2Ppm": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Indoor CO₂ concentration",
          "de": "CO₂-Konzentration der Raumluft"
        },
        "unit": "ppm",
        "step": 10,
        "precision": 0,
        "group": "air-quality",
        "order": 20
      }
    }
  }
}
