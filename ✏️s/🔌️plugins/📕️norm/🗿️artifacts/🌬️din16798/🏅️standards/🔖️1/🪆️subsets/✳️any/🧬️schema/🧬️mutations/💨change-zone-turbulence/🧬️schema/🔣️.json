{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din16798/mutation/change-zone-turbulence/schema.json",
  "title": "ChangeZoneTurbulence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId",
    "newTurbulenceIntensityPercent"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The ventilation zone this mutation addresses.",
          "de": "Die Lüftungszone, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newTurbulenceIntensityPercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Turbulence intensity Tu",
          "de": "Turbulenzgrad Tu"
        },
        "unit": "%",
        "step": 1,
        "precision": 0,
        "group": "comfort",
        "order": 20
      }
    }
  }
}
