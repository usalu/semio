{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/din16798/mutation/change-zone-occupants/schema.json",
  "title": "ChangeZoneOccupants",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId",
    "newOccupants"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Zone",
          "de": "Zone"
        },
        "description": {
          "en": "The ventilation zone this mutation addresses.",
          "de": "Die Lüftungszone, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "zone"
        },
        "group": "target",
        "order": 10
      }
    },
    "newOccupants": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Number of occupants",
          "de": "Personenanzahl"
        },
        "step": 1,
        "precision": 0,
        "group": "comfort",
        "order": 20
      }
    }
  }
}
