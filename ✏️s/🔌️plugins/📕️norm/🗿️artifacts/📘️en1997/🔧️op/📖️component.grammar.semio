dialect grammar
grammar en1997.op
extension en1997
use family-sheet
start operation

artifact-mark = "norm.en1997-op"
operation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("en1997-basis" | "en1997-combination" | "en1997-partial-factor" | "en1997-verdict" | "en1997-annex" | "en1997-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
