{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-plated-stiffener-spacing/schema.json",
  "title": "ChangePlatedStiffenerSpacing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newStiffenerSpacing"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plated panel",
          "de": "Plattenfeld"
        },
        "description": {
          "en": "The plated panel this mutation addresses, by id.",
          "de": "Das adressierte Element (Plattenfeld), per Kennung."
        },
        "ref": {
          "kind": "plated"
        },
        "group": "target",
        "order": 10
      }
    },
    "newStiffenerSpacing": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Longitudinal stiffener spacing s (equal subpanels, n = b/s - 1 stiffeners; 0 = the single stiffener of the stiffener fields)",
          "de": "Längssteifenabstand s (gleiche Teilfelder, n = b/s - 1 Steifen; 0 = die einzelne Steife der Steifenfelder)"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 3,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
