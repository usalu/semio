{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-crane-dispersion/schema.json",
  "title": "ChangeCraneDispersion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newDispersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Crane runway",
          "de": "Kranbahn"
        },
        "description": {
          "en": "The crane runway this mutation addresses, by id.",
          "de": "Das adressierte Element (Kranbahn), per Kennung."
        },
        "ref": {
          "kind": "crane"
        },
        "group": "target",
        "order": 10
      }
    },
    "newDispersion": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Load dispersion length",
          "de": "Lastausbreitungslänge"
        },
        "widget": "stepper",
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "precision": 1,
        "step": 0.001,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
