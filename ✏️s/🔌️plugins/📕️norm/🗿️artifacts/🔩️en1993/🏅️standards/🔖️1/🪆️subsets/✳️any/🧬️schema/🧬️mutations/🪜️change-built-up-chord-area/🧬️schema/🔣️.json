{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-built-up-chord-area/schema.json",
  "title": "ChangeBuiltUpChordArea",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newChordArea"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Built-up member",
          "de": "Zusammengesetzter Stab"
        },
        "description": {
          "en": "The built-up member this mutation addresses, by id.",
          "de": "Das adressierte Element (Zusammengesetzter Stab), per Kennung."
        },
        "ref": {
          "kind": "built-up"
        },
        "group": "target",
        "order": 10
      }
    },
    "newChordArea": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Chord area A_ch",
          "de": "Gurtfläche A_ch"
        },
        "widget": "stepper",
        "unit": "m²",
        "precision": 6,
        "step": 0.0001,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
