{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-silo-gamma/schema.json",
  "title": "ChangeSiloGamma",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newGamma"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Silo shell",
          "de": "Silo-Schale"
        },
        "description": {
          "en": "The silo shell this mutation addresses, by id.",
          "de": "Das adressierte Element (Silo-Schale), per Kennung."
        },
        "ref": {
          "kind": "silo"
        },
        "group": "target",
        "order": 10
      }
    },
    "newGamma": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Unit weight of the stored solid γ",
          "de": "Wichte des Schüttguts γ"
        },
        "widget": "stepper",
        "unit": "N/m³",
        "displayUnit": "kN/m³",
        "displayFactor": 0.001,
        "precision": 1,
        "step": 500,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
