{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-plated-lateral-pressure/schema.json",
  "title": "ChangePlatedLateralPressure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newLateralPressure"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plated panel",
          "de": "Plattenfeld"
        },
        "description": {
          "en": "The plated panel this mutation addresses, by id.",
          "de": "Das adressierte Element (Plattenfeld), per Kennung."
        },
        "ref": {
          "kind": "plated"
        },
        "group": "target",
        "order": 10
      }
    },
    "newLateralPressure": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Uniform lateral pressure p on the panel (EN 1993-1-7, perpendicular to the plate)",
          "de": "Gleichmäßiger Querdruck p auf das Blech (EN 1993-1-7, senkrecht zur Blechebene)"
        },
        "widget": "stepper",
        "unit": "Pa",
        "displayUnit": "N/mm²",
        "displayFactor": 0.000001,
        "precision": 1,
        "step": 1000000,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
