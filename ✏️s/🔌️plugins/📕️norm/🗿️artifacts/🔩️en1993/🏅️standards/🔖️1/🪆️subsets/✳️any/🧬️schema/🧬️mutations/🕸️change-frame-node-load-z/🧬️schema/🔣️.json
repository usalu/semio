{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-frame-node-load-z/schema.json",
  "title": "ChangeFrameNodeLoadZ",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newLoadZ"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Frame node",
          "de": "Rahmenknoten"
        },
        "description": {
          "en": "The frame node this mutation addresses, by id.",
          "de": "Das adressierte Element (Rahmenknoten), per Kennung."
        },
        "ref": {
          "kind": "frame-node"
        },
        "group": "target",
        "order": 10
      }
    },
    "newLoadZ": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Design load in z (gravity negative)",
          "de": "Bemessungslast in z (Schwerkraft negativ)"
        },
        "widget": "stepper",
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "precision": 1,
        "step": 1000,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
