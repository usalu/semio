{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-joint-weld-force-transverse/schema.json",
  "title": "ChangeJointWeldForceTransverse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newWeldForceTransverse"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Joint",
          "de": "Anschluss"
        },
        "description": {
          "en": "The joint this mutation addresses, by id.",
          "de": "Das adressierte Element (Anschluss), per Kennung."
        },
        "ref": {
          "kind": "joint"
        },
        "group": "target",
        "order": 10
      }
    },
    "newWeldForceTransverse": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Weld force perpendicular to the weld axis along a leg F_w,perp,Ed (0 = not given)",
          "de": "Nahtkraft quer zur Naht entlang eines Schenkels F_w,perp,Ed (0 = nicht angegeben)"
        },
        "widget": "stepper",
        "role": "value",
        "group": "value",
        "order": 20,
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "precision": 2,
        "step": 1000
      }
    }
  }
}
