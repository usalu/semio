{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-panel-design-temperature/schema.json",
  "title": "ChangePanelDesignTemperature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newDesignTemperature"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Panel panel",
          "de": "Plattenfeld"
        },
        "description": {
          "en": "The panel panel this mutation addresses, by id.",
          "de": "Das adressierte Element (Plattenfeld), per Kennung."
        },
        "ref": {
          "kind": "panel"
        },
        "group": "target",
        "order": 10
      }
    },
    "newDesignTemperature": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Reference temperature T_Ed of the plate (1-10)",
          "de": "Bezugstemperatur T_Ed der Platte (1-10)"
        },
        "widget": "stepper",
        "role": "value",
        "group": "value",
        "order": 20,
        "unit": "°C",
        "precision": 1,
        "step": 1
      }
    }
  }
}
