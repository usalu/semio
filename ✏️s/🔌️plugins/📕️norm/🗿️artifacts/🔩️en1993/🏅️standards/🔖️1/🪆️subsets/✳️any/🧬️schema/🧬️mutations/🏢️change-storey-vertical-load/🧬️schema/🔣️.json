{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-storey-vertical-load/schema.json",
  "title": "ChangeStoreyVerticalLoad",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newVerticalLoad"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Storey",
          "de": "Geschoss"
        },
        "description": {
          "en": "The storey this mutation addresses, by id.",
          "de": "Das adressierte Element (Geschoss), per Kennung."
        },
        "ref": {
          "kind": "storey"
        },
        "group": "target",
        "order": 10
      }
    },
    "newVerticalLoad": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Total vertical load V_Ed",
          "de": "Gesamte Vertikallast V_Ed"
        },
        "widget": "stepper",
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "precision": 1,
        "step": 1000,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
