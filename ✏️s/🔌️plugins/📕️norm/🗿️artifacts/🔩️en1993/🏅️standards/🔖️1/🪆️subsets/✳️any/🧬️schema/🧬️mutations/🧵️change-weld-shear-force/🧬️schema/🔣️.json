    "newShearForce": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Shear force F_Ed along the depth",
          "de": "Querkraft F_Ed in Tiefenrichtung"
        },
        "widget": "stepper",
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "precision": 1,
        "step": 1000,
        "role": "value",
        "group": "value",
        "order": 20
