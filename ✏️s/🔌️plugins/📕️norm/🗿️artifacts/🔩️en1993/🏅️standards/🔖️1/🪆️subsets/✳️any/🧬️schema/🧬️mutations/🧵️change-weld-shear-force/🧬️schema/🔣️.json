{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-weld-shear-force/schema.json",
  "title": "ChangeWeldShearForce",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newShearForce"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Weld group",
          "de": "Schweißnahtgruppe"
        },
        "description": {
          "en": "The weld group this mutation addresses, by id.",
