{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/insert-section/schema.json",
  "title": "InsertSection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "section"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "section": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/snapshot.json#/$defs/SteelSection",
      "x-semio-ui": {
        "label": {
          "en": "Cross-section",
          "de": "Querschnitt"
        },
        "description": {
          "en": "The complete cross-section record to insert.",
          "de": "Der vollständige einzufügende Querschnitt."
        }
      }
    }
  }
}
