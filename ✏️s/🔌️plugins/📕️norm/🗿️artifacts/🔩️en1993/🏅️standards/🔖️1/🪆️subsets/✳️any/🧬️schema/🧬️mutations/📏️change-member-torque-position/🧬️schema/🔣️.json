{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-member-torque-position/schema.json",
  "title": "ChangeMemberTorquePosition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newTorquePosition"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Member",
          "de": "Bauteil"
        },
        "description": {
          "en": "The member this mutation addresses, by id.",
          "de": "Das adressierte Element (Bauteil), per Kennung."
        },
        "ref": {
          "kind": "member"
        },
        "group": "target",
        "order": 10
      }
