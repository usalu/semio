    "newTorquePosition": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Position of the point torque as a fraction of the member length",
          "de": "Lage des Einzeltorsionsmoments als Bruchteil der Bauteillänge"
        },
        "widget": "stepper",
        "unit": "1",
        "precision": 3,
        "step": 0.01,
        "role": "value",
        "group": "value",
        "order": 20
