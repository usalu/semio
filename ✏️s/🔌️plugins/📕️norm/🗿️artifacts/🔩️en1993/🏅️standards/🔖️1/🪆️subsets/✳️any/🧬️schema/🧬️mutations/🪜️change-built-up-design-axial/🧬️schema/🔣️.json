{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-built-up-design-axial/schema.json",
  "title": "ChangeBuiltUpDesignAxial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newDesignAxial"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Built-up member",
          "de": "Zusammengesetzter Stab"
        },
        "description": {
          "en": "The built-up member this mutation addresses, by id.",
          "de": "Das adressierte Element (Zusammengesetzter Stab), per Kennung."
        },
        "ref": {
          "kind": "built-up"
        },
        "group": "target",
        "order": 10
      }
    },
    "newDesignAxial": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Design axial force N_Ed",
          "de": "Bemessungsnormalkraft N_Ed"
        },
        "widget": "stepper",
        "unit": "N",
        "displayUnit": "kN",
        "displayFactor": 0.001,
        "precision": 1,
        "step": 1000,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
