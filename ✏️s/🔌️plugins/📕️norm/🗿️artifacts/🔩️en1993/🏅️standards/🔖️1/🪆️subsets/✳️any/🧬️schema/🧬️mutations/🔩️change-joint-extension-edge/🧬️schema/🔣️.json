{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-joint-extension-edge/schema.json",
  "title": "ChangeJointExtensionEdge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newExtensionEdge"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Joint",
          "de": "Anschluss"
        },
        "description": {
          "en": "The joint this mutation addresses, by id.",
          "de": "Das adressierte Element (Anschluss), per Kennung."
        },
        "ref": {
          "kind": "joint"
        },
        "group": "target",
        "order": 10
      }
    },
    "newExtensionEdge": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Extended part: bolt to edge e_x",
          "de": "Überstand: Schraube zum Rand e_x"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 3,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
