{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-section-w-pl-z/schema.json",
  "title": "ChangeSectionWPlZ",
