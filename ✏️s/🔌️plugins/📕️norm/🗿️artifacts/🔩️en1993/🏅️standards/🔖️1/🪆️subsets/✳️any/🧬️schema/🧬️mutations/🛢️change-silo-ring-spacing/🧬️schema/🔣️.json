{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-silo-ring-spacing/schema.json",
  "title": "ChangeSiloRingSpacing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newRingSpacing"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Silo shell",
          "de": "Silo-Schale"
        },
        "description": {
          "en": "The silo shell this mutation addresses, by id.",
          "de": "Das adressierte Element (Silo-Schale), per Kennung."
        },
        "ref": {
          "kind": "silo"
        },
        "group": "target",
        "order": 10
      }
    },
    "newRingSpacing": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Ring stiffener spacing l_r (0 = unstiffened, L governs)",
          "de": "Ringsteifenabstand l_r (0 = unausgesteift, L maßgebend)"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 3,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
