{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-joint-pitch/schema.json",
  "title": "ChangeJointPitch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newPitch"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Joint",
          "de": "Anschluss"
        },
        "description": {
          "en": "The joint this mutation addresses, by id.",
          "de": "Das adressierte Element (Anschluss), per Kennung."
        },
        "ref": {
          "kind": "joint"
        },
        "group": "target",
        "order": 10
      }
    },
    "newPitch": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Pitch p₁",
          "de": "Lochabstand p₁"
        },
        "widget": "stepper",
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "precision": 1,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
