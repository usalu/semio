{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-joint-end-distance/schema.json",
  "title": "ChangeJointEndDistance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newEndDistance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Joint",
          "de": "Anschluss"
        },
        "description": {
          "en": "The joint this mutation addresses, by id.",
          "de": "Das adressierte Element (Anschluss), per Kennung."
        },
        "ref": {
          "kind": "joint"
        },
        "group": "target",
        "order": 10
      }
    },
    "newEndDistance": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "End distance e₁",
          "de": "Randabstand in Kraftrichtung e₁"
        },
        "widget": "stepper",
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "precision": 1,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
