{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/insert-joint/schema.json",
  "title": "InsertJoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "joint"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "joint": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/snapshot.json#/$defs/SteelJoint",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Joint",
          "de": "Anschluss"
        },
        "description": {
          "en": "The complete joint record to insert.",
          "de": "Der vollständige einzufügende Datensatz des Anschlusses."
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
