{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-section-iy/schema.json",
  "title": "ChangeSectionIy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newIy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Section",
          "de": "Querschnitt"
        },
        "description": {
          "en": "The section this mutation addresses, by id.",
          "de": "Das adressierte Element (Querschnitt), per Kennung."
        },
        "ref": {
          "kind": "section"
        },
        "group": "target",
        "order": 10
      }
    },
    "newIy": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Second moment of area I_y",
          "de": "Flächenträgheitsmoment I_y"
        },
        "widget": "stepper",
        "unit": "m⁴",
        "displayUnit": "cm⁴",
        "displayFactor": 100000000,
        "precision": 0,
        "step": 1e-8,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
