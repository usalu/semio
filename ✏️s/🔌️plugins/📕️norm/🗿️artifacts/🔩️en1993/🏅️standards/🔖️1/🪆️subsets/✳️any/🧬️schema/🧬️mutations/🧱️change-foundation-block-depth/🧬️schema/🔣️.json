{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-foundation-block-depth/schema.json",
  "title": "ChangeFoundationBlockDepth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newBlockDepth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Foundation block",
          "de": "Fundamentblock"
        },
        "description": {
          "en": "The foundation block this mutation addresses, by id.",
          "de": "Das adressierte Element (Fundamentblock), per Kennung."
        },
        "ref": {
          "kind": "foundation-block"
        },
        "group": "target",
        "order": 10
      }
    },
    "newBlockDepth": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Block depth h (load spread height)",
          "de": "Blockhöhe h (Lastausbreitungshöhe)"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 3,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
