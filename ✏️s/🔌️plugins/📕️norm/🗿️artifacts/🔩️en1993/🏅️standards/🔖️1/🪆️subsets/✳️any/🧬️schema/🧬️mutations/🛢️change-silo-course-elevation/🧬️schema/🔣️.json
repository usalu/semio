{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-silo-course-elevation/schema.json",
  "title": "ChangeSiloCourseElevation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newCourseElevation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Silo shell",
          "de": "Silo-Schale"
        },
        "description": {
          "en": "The silo shell this mutation addresses, by id.",
          "de": "Das adressierte Element (Silo-Schale), per Kennung."
        },
        "ref": {
          "kind": "silo"
        },
        "group": "target",
        "order": 10
      }
    },
    "newCourseElevation": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Course height above the base h",
          "de": "Schusshöhe über dem Boden h"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 3,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
