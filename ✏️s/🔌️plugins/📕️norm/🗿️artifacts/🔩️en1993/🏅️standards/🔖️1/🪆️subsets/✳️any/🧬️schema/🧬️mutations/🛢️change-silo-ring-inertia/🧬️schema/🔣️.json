{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-silo-ring-inertia/schema.json",
  "title": "ChangeSiloRingInertia",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
