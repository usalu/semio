{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-section-iw/schema.json",
  "title": "ChangeSectionIw",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newIw"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Section",
          "de": "Querschnitt"
        },
        "description": {
          "en": "The section this mutation addresses, by id.",
