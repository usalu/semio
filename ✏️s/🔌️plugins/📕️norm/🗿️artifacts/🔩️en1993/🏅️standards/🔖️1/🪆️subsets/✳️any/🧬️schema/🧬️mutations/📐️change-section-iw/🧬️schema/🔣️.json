    "newIw": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Warping constant I_w",
          "de": "Wölbwiderstand I_w"
        },
        "widget": "stepper",
        "unit": "m⁶",
        "displayUnit": "cm⁶",
        "displayFactor": 1000000000000,
        "precision": 0,
        "step": 1e-10,
        "role": "value",
        "group": "value",
