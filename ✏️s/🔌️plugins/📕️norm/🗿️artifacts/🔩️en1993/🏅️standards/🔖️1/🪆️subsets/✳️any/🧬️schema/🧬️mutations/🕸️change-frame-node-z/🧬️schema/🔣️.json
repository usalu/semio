{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-frame-node-z/schema.json",
  "title": "ChangeFrameNodeZ",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newZ"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Frame node",
          "de": "Rahmenknoten"
        },
        "description": {
          "en": "The frame node this mutation addresses, by id.",
          "de": "Das adressierte Element (Rahmenknoten), per Kennung."
        },
        "ref": {
          "kind": "frame-node"
        },
        "group": "target",
        "order": 10
      }
    },
    "newZ": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Coordinate z (up)",
          "de": "Koordinate z (nach oben)"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 3,
        "step": 0.005,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
