{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1993/mutation/change-plated-lat-pressure-coef/schema.json",
  "title": "ChangePlatedLatPressureCoef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newLateralPressureCoefficient"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Plated panel",
          "de": "Plattenfeld"
        },
        "description": {
          "en": "The plated panel this mutation addresses, by id.",
          "de": "Das adressierte Element (Plattenfeld), per Kennung."
        },
        "ref": {
          "kind": "plated"
        },
        "group": "target",
        "order": 10
      }
    },
    "newLateralPressureCoefficient": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Plate bending coefficient k of sigma = k p b²/t² for the panel aspect ratio and edge conditions (Timoshenko or Roark table, entered; table values not verified)",
          "de": "Plattenbeiwert k von sigma = k p b²/t² für Seitenverhältnis und Lagerung (Tabelle nach Timoshenko oder Roark, eingegeben; Tabellenwerte ungeprüft)"
        },
        "widget": "stepper",
        "unit": "1",
        "precision": 3,
        "step": 0.01,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
