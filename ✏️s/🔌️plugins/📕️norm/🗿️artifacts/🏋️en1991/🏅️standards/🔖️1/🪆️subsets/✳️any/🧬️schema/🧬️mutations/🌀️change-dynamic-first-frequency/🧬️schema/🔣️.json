{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-dynamic-first-frequency/schema.json",
  "title": "ChangeDynamicFirstFrequency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newFirstFrequency"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Dynamic element",
          "de": "Schwingungsanfälliges Bauteil"
        },
        "description": {
          "en": "The dynamic element this mutation addresses, by id.",
          "de": "Das adressierte Element (Schwingungsanfälliges Bauteil), per Kennung."
        },
        "ref": {
          "kind": "dynamic-element"
        },
        "group": "target",
        "order": 10
      }
    },
    "newFirstFrequency": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "First natural frequency n1 (0 = 46/h)",
          "de": "Erste Eigenfrequenz n1 (0 = 46/h)"
        },
        "widget": "stepper",
        "unit": "Hz",
        "precision": 2,
        "step": 0.05,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
