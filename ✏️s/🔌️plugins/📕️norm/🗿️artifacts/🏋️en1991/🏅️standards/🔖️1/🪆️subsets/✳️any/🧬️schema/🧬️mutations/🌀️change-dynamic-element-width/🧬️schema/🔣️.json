{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-dynamic-element-width/schema.json",
  "title": "ChangeDynamicElementWidth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newWidth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Dynamic element",
          "de": "Schwingungsanfälliges Bauteil"
        },
        "description": {
          "en": "The dynamic element this mutation addresses, by id.",
          "de": "Das adressierte Element (Schwingungsanfälliges Bauteil), per Kennung."
        },
        "ref": {
          "kind": "dynamic-element"
        },
        "group": "target",
        "order": 10
      }
    },
    "newWidth": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Width or diameter b",
          "de": "Breite oder Durchmesser b"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 2,
        "step": 0.1,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
