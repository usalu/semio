{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-impact-action-kind/schema.json",
  "title": "ChangeImpactActionKind",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newKind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Impact action",
          "de": "Anpralleinwirkung"
        },
        "description": {
          "en": "The impact action this mutation addresses, by id.",
          "de": "Das adressierte Element (Anpralleinwirkung), per Kennung."
        },
        "ref": {
          "kind": "impact-action"
        },
        "group": "target",
        "order": 10
      }
    },
    "newKind": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "label": {
          "en": "Impact kind (0 road vehicle, 1 ship, 2 forklift)",
          "de": "Anprallart (0 Straßenfahrzeug, 1 Schiff, 2 Gabelstapler)"
        },
        "widget": "stepper",
        "precision": 0,
        "step": 1,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
