  "$defs": {
    "FloorArea": {
      "title": "FloorArea",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "area",
        "assumedQk",
        "assumedQkConcentrated",
        "assumedPartitions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Category of use",
              "de": "Nutzungskategorie"
            },
            "description": {
              "en": "EN 1991-1-1 Table 6.1 category (A to H).",
              "de": "Kategorie nach EN 1991-1-1 Tabelle 6.1 (A bis H)."
            },
            "widget": "text"
          }
        },
        "area": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Loaded area A",
              "de": "Belastete Fläche A"
            },
            "widget": "stepper",
            "unit": "m²",
            "precision": 2
          }
        },
        "assumedQk": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Assumed imposed load q_k",
              "de": "Angesetzte Nutzlast q_k"
            },
            "description": {
              "en": "Value claimed by the design; the check compares it with the value derived from the standard.",
              "de": "Vom Entwurf angesetzter Wert; der Nachweis vergleicht ihn mit dem nach der Norm ermittelten Wert."
            },
            "unit": "Pa",
            "displayUnit": "kN/m²",
            "displayFactor": 0.001,
            "step": 50,
            "precision": 2
          }
        },
        "assumedQkConcentrated": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Assumed concentrated load Q_k",
              "de": "Angesetzte Einzellast Q_k"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        },
        "assumedPartitions": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Assumed partition allowance",
              "de": "Angesetzter Trennwandzuschlag"
            },
            "widget": "stepper",
            "unit": "Pa",
            "displayUnit": "kN/m²",
            "displayFactor": 0.001,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
    "SelfWeightElement": {
      "title": "SelfWeightElement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "material",
        "thickness",
        "assumedGk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "thickness": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Thickness",
              "de": "Dicke"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "assumedGk": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Assumed self-weight g_k",
              "de": "Angesetzte Eigenlast g_k"
            },
            "description": {
              "en": "Value claimed by the design; the check compares it with the value derived from the standard.",
              "de": "Vom Entwurf angesetzter Wert; der Nachweis vergleicht ihn mit dem nach der Norm ermittelten Wert."
            },
            "unit": "Pa",
            "displayUnit": "kN/m²",
            "displayFactor": 0.001,
            "step": 50,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
    "RoofArea": {
      "title": "RoofArea",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roofType",
        "pitchDeg",
        "cE",
        "cT",
        "hasParapet",
        "parapetHeight",
        "driftObstructionHeight",
        "multiSpan",
        "assumedSk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "roofType": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Roof type",
              "de": "Dachform"
            },
            "description": {
              "en": "monopitch, duopitch, flat …",
              "de": "Pultdach, Satteldach, Flachdach …"
            },
            "widget": "text"
          }
        },
        "pitchDeg": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Roof pitch α",
              "de": "Dachneigung α"
            },
            "widget": "stepper",
            "unit": "°",
            "precision": 0
          }
        },
        "cE": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Exposure coefficient C_e",
              "de": "Umgebungskoeffizient C_e"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "cT": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Thermal coefficient C_t",
              "de": "Temperaturkoeffizient C_t"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "hasParapet": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Parapet present",
              "de": "Attika vorhanden"
            },
            "widget": "toggle"
          }
        },
        "parapetHeight": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Parapet height",
              "de": "Attikahöhe"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "driftObstructionHeight": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Height of the drift obstruction",
              "de": "Höhe des Verwehungshindernisses"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "multiSpan": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Multi-span roof",
              "de": "Mehrfeldriges Dach"
            },
            "widget": "toggle"
          }
        },
        "assumedSk": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Assumed roof snow load s",
              "de": "Angesetzte Schneelast auf dem Dach s"
            },
            "description": {
              "en": "Value claimed by the design; the check compares it with the value derived from the standard.",
              "de": "Vom Entwurf angesetzter Wert; der Nachweis vergleicht ihn mit dem nach der Norm ermittelten Wert."
            },
            "unit": "Pa",
            "displayUnit": "kN/m²",
            "displayFactor": 0.001,
            "step": 50,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
    "WindFace": {
      "title": "WindFace",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "zone",
        "z",
        "cPe10",
        "cPe1",
        "cPi",
        "cS",
        "cD",
        "loadedArea",
        "assumedWp"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "z": {
          "type": "number"
        },
        "cPe10": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "External pressure coefficient c_pe,10",
              "de": "Außendruckbeiwert c_pe,10"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "cPe1": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "External pressure coefficient c_pe,1",
              "de": "Außendruckbeiwert c_pe,1"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "cPi": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Internal pressure coefficient c_pi",
              "de": "Innendruckbeiwert c_pi"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "cS": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Size factor c_s",
              "de": "Größenbeiwert c_s"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "cD": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Dynamic factor c_d",
              "de": "Dynamischer Beiwert c_d"
            },
            "widget": "stepper",
            "precision": 2
          }
        },
        "loadedArea": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Loaded area",
              "de": "Lasteinzugsfläche"
            },
            "widget": "stepper",
            "unit": "m²",
            "precision": 2
          }
        },
        "assumedWp": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Assumed wind pressure w_e",
              "de": "Angesetzter Winddruck w_e"
            },
            "description": {
              "en": "Value claimed by the design; the check compares it with the value derived from the standard.",
              "de": "Vom Entwurf angesetzter Wert; der Nachweis vergleicht ihn mit dem nach der Norm ermittelten Wert."
            },
            "unit": "Pa",
            "displayUnit": "kN/m²",
            "displayFactor": 0.001,
            "step": 50,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
    "AccidentalCase": {
      "title": "AccidentalCase",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "impact",
        "explosion"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "impact": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccidentalImpact"
          },
          "x-semio-ui": {
            "label": {
              "en": "Impact",
              "de": "Anprall"
            }
          }
        },
        "explosion": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccidentalExplosion"
          },
          "x-semio-ui": {
            "label": {
              "en": "Explosion",
              "de": "Explosion"
            }
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
    "AccidentalImpact": {
      "title": "AccidentalImpact",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicleMass",
        "vehicleSpeed",
        "assumedForce"
      ],
      "properties": {
        "vehicleMass": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Vehicle mass m",
              "de": "Fahrzeugmasse m"
            },
            "widget": "stepper",
            "unit": "kg",
            "precision": 0
          }
        },
        "vehicleSpeed": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Vehicle speed v",
              "de": "Fahrzeuggeschwindigkeit v"
            },
            "widget": "stepper",
            "unit": "m/s",
            "precision": 1
          }
        },
        "assumedForce": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Assumed impact force F_d",
              "de": "Angesetzte Anprallkraft F_d"
            },
            "description": {
              "en": "Value claimed by the design; the check compares it with the value derived from the standard.",
              "de": "Vom Entwurf angesetzter Wert; der Nachweis vergleicht ihn mit dem nach der Norm ermittelten Wert."
            },
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "step": 1000,
            "precision": 0
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🟦️typescript"
      ]
    },
    "AccidentalExplosion": {
      "title": "AccidentalExplosion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explosionMass",
        "standoff",
        "assumedPressure"
