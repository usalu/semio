{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-floor-assumed-partitions/schema.json",
  "title": "ChangeFloorAssumedPartitions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newAssumedPartitions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Floor area",
          "de": "Geschossfläche"
        },
        "description": {
          "en": "The floor area this mutation addresses, by id.",
          "de": "Das adressierte Element (Geschossfläche), per Kennung."
        },
        "ref": {
          "kind": "floor"
        },
        "group": "target",
        "order": 10
      }
    },
    "newAssumedPartitions": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Assumed partition load",
          "de": "Angenommene Trennwandlast"
        },
        "widget": "stepper",
        "unit": "Pa",
        "displayUnit": "kN/m²",
        "displayFactor": 0.001,
        "precision": 2,
        "step": 100,
        "snaps": [
          500,
          800,
          1200
        ],
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
