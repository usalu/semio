{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-tie-run-kind/schema.json",
  "title": "ChangeTieRunKind",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newKind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tie run",
          "de": "Zuggliedstrang"
        },
        "description": {
          "en": "The tie run this mutation addresses, by id.",
          "de": "Das adressierte Element (Zuggliedstrang), per Kennung."
        },
        "ref": {
          "kind": "tie-run"
        },
        "group": "target",
        "order": 10
      }
    },
    "newKind": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "label": {
          "en": "Tie kind (0 peripheral, 1 internal)",
          "de": "Zuggliedart (0 Randzugglied, 1 Innenzugglied)"
        },
        "widget": "stepper",
        "precision": 0,
        "step": 1,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
