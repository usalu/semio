{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-impact-action-stiffness/schema.json",
  "title": "ChangeImpactActionStiffness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newStiffness"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Impact action",
          "de": "Anpralleinwirkung"
        },
        "description": {
          "en": "The impact action this mutation addresses, by id.",
          "de": "Das adressierte Element (Anpralleinwirkung), per Kennung."
        },
        "ref": {
          "kind": "impact-action"
        },
        "group": "target",
        "order": 10
      }
    },
    "newStiffness": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Equivalent stiffness k (0 = registry value)",
          "de": "Ersatzsteifigkeit k (0 = Registerwert)"
        },
        "widget": "stepper",
        "unit": "N/m",
        "displayUnit": "kN/m",
        "displayFactor": 0.001,
        "precision": 1,
        "step": 100,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
