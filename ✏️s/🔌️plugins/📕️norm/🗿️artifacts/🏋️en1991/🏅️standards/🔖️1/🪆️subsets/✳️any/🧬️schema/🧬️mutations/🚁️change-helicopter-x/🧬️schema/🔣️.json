{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-helicopter-x/schema.json",
  "title": "ChangeHelicopterX",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newX"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Helicopter landing",
          "de": "Hubschrauberlandung"
        },
        "description": {
          "en": "The helicopter landing this mutation addresses, by id.",
          "de": "Das adressierte Element (Hubschrauberlandung), per Kennung."
        },
        "ref": {
          "kind": "helicopter-landing"
        },
        "group": "target",
        "order": 10
      }
    },
    "newX": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Plan position x",
          "de": "Position x"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 2,
        "step": 0.5,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
