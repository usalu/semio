{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-roof-ce/schema.json",
  "title": "ChangeRoofCE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newCE"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Roof",
          "de": "Dach"
        },
        "description": {
          "en": "The roof this mutation addresses, by id.",
          "de": "Das adressierte Element (Dach), per Kennung."
        },
        "ref": {
          "kind": "roof"
        },
        "group": "target",
        "order": 10
      }
    },
    "newCE": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Exposure coefficient cE",
          "de": "Aussetzungskoeffizient cE"
        },
        "widget": "stepper",
        "precision": 2,
        "step": 0.1,
        "snaps": [
          0.8,
          1,
          1.2
        ],
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
