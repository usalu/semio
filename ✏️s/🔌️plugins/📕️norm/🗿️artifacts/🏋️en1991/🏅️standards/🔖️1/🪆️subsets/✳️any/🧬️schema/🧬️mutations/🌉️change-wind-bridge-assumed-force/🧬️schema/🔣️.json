{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-wind-bridge-assumed-force/schema.json",
  "title": "ChangeWindBridgeAssumedForce",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newAssumedForce"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Bridge wind case",
          "de": "Brückenwindfall"
        },
        "description": {
          "en": "The bridge wind case this mutation addresses, by id.",
          "de": "Das adressierte Element (Brückenwindfall), per Kennung."
        },
        "ref": {
          "kind": "wind-bridge"
        },
        "group": "target",
        "order": 10
      }
    },
    "newAssumedForce": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Assumed horizontal wind force F_W per metre",
          "de": "Angenommene horizontale Windkraft F_W je Meter"
        },
        "widget": "stepper",
        "unit": "N/m",
        "displayUnit": "kN/m",
        "displayFactor": 0.001,
        "precision": 1,
        "step": 100,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
