{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-wind-face-assumed-wp/schema.json",
  "title": "ChangeWindFaceAssumedWp",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "newAssumedWp"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Wind-loaded face",
          "de": "Windbeanspruchte Fläche"
        },
        "description": {
          "en": "Zero-based position of the wind-loaded face in its list.",
          "de": "Nullbasierte Position der windbeanspruchten Fläche in der Liste."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "newAssumedWp": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Assumed wind pressure w_e",
          "de": "Angesetzter Winddruck w_e"
        },
        "description": {
          "en": "Value claimed by the design; the check compares it with the value derived from the standard.",
          "de": "Vom Entwurf angesetzter Wert; der Nachweis vergleicht ihn mit dem nach der Norm ermittelten Wert."
        },
        "unit": "Pa",
        "displayUnit": "kN/m²",
        "displayFactor": 0.001,
        "step": 50,
        "precision": 2,
        "group": "wind",
        "order": 20
      }
    }
  }
}
