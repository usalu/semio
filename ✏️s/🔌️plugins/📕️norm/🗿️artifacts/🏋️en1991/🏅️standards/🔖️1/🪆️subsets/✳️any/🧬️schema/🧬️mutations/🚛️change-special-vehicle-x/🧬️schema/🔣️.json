{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-special-vehicle-x/schema.json",
  "title": "ChangeSpecialVehicleX",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newX"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Special vehicle",
          "de": "Sonderfahrzeug"
        },
        "description": {
          "en": "The special vehicle this mutation addresses, by id.",
          "de": "Das adressierte Element (Sonderfahrzeug), per Kennung."
        },
        "ref": {
          "kind": "special-vehicle"
        },
        "group": "target",
        "order": 10
      }
    },
    "newX": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Vehicle centre along the span",
          "de": "Fahrzeugmitte entlang der Spannweite"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 2,
        "step": 0.5,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
