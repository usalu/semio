{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-accidental-assumed-force/schema.json",
  "title": "ChangeAccidentalAssumedForce",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newAssumedForce"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Accidental design situation",
          "de": "Außergewöhnliche Bemessungssituation"
        },
        "description": {
          "en": "The accidental design situation this mutation addresses, by id.",
