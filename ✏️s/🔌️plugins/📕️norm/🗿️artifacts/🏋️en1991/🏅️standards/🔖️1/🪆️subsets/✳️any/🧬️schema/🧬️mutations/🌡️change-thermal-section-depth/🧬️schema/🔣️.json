{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-thermal-section-depth/schema.json",
  "title": "ChangeThermalSectionDepth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newDepth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Thermal section",
          "de": "Temperaturquerschnitt"
        },
        "description": {
          "en": "The thermal section this mutation addresses, by id.",
          "de": "Das adressierte Element (Temperaturquerschnitt), per Kennung."
        },
        "ref": {
          "kind": "thermal-section"
        },
        "group": "target",
        "order": 10
      }
    },
    "newDepth": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Section depth h",
          "de": "Querschnittshöhe h"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 2,
        "step": 0.05,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
