{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-assumed-silo-patch/schema.json",
  "title": "ChangeAssumedSiloPatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newAssumedSiloPatch"
  ],
  "properties": {
