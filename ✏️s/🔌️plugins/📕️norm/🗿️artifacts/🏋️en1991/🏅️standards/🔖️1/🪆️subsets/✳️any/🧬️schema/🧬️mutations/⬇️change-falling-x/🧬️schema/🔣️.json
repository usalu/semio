{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1991/mutation/change-falling-x/schema.json",
  "title": "ChangeFallingX",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newX"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Falling load",
          "de": "Fallende Last"
        },
        "description": {
          "en": "The falling load this mutation addresses, by id.",
          "de": "Das adressierte Element (Fallende Last), per Kennung."
        },
        "ref": {
          "kind": "falling-load"
        },
        "group": "target",
        "order": 10
      }
    },
    "newX": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Plan position x",
          "de": "Position x"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 2,
        "step": 0.5,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
