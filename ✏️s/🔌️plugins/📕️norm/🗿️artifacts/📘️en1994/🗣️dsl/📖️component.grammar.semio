dialect grammar
grammar en1994.document
extension en1994
use family-sheet
start document

artifact-mark = "norm.en1994"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("en1994-basis" | "en1994-combination" | "en1994-partial-factor" | "en1994-verdict" | "en1994-annex" | "en1994-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
