dialect grammar
grammar en1994.diff
extension en1994
use family-sheet
start diff

artifact-mark = "norm.en1994-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("en1994-basis" | "en1994-combination" | "en1994-partial-factor" | "en1994-verdict" | "en1994-annex" | "en1994-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
