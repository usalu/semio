{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UpdateManufacturerFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newManufacturerFile"
  ],
  "properties": {
    "newManufacturerFile": {
      "title": "ManufacturerFile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildingSystemNumber",
        "charset",
        "created",
        "extensions",
        "headerVersion",
        "manufacturer",
        "recordCount"
      ],
      "properties": {
        "headerVersion": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "buildingSystemNumber": {
          "title": "BuildingSystemNumber",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "subsystem",
            "systemCode"
          ],
          "properties": {
            "systemCode": {
              "type": "string"
            },
            "subsystem": {
              "type": "string"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "created": {
          "type": "string"
        },
        "charset": {
          "type": "string"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "title": "ExtensionBag",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "description": "any JSON value"
              }
            }
          }
        }
      }
    }
  }
}
