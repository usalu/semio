{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/vdi3805/mutation/change-edition-profile/schema.json",
  "title": "ChangeEditionProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet",
    "newChoice"
  ],
  "properties": {
    "sheet": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Sheet",
          "de": "Blatt"
        },
        "description": {
          "en": "VDI 3805 sheet number, e.g. 8.",
          "de": "Blattnummer der VDI 3805, z. B. 8."
        },
        "group": "target",
        "order": 10
      }
    },
    "newChoice": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/vdi3805/snapshot.json#/$defs/EditionProfileChoice",
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Sheet edition",
          "de": "Blattausgabe"
        },
        "options": {
          "legacy": {
            "en": "Legacy edition",
            "de": "Frühere Ausgabe"
          },
          "current": {
            "en": "Current edition",
            "de": "Aktuelle Ausgabe"
          }
        },
        "group": "catalogue",
        "order": 20
      }
    }
  }
}
