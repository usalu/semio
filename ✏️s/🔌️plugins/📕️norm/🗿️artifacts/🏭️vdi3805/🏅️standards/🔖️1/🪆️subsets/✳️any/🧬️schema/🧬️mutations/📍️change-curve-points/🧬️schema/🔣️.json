{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/vdi3805/mutation/change-curve-points/schema.json",
  "title": "ChangeCurvePoints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newPoints"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Characteristic curve",
          "de": "Kennlinie"
        },
        "description": {
          "en": "The characteristic curve this mutation addresses.",
          "de": "Die Kennlinie, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "curve"
        },
        "group": "target",
        "order": 10
      }
    },
    "newPoints": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/vdi3805/snapshot.json#/$defs/CurvePoint"
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Curve points",
          "de": "Kennlinienpunkte"
        },
        "description": {
          "en": "Ordered (x, y) points in the curve's units.",
          "de": "Geordnete (x, y)-Punkte in den Einheiten der Kennlinie."
        },
        "group": "curve",
        "order": 20
      }
    }
  }
}
