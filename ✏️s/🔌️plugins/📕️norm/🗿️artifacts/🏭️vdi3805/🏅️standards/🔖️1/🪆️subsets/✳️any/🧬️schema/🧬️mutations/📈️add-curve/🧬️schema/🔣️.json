{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/vdi3805/mutation/add-curve/schema.json",
  "title": "AddCurve",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "curve"
  ],
  "properties": {
    "curve": {
      "title": "CharacteristicCurve",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "points",
        "xUnit",
        "yUnit"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "xUnit": {
          "title": "VdiUnit",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delta",
            "kind",
            "siFactor",
            "symbol"
          ],
          "properties": {
            "symbol": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "Dimensionless",
                "Length",
                "Area",
                "Volume",
                "Mass",
                "Time",
                "Temperature",
                "Force",
                "Pressure",
                "Stress",
                "Moment",
                "Energy",
                "Power",
                "ThermalConductivity",
                "ThermalResistance",
                "HeatTransferCoefficient",
                "AirPermeability",
                "VentilationRate",
                "Acceleration"
              ]
            },
            "delta": {
              "type": "boolean"
            },
            "siFactor": {
              "type": "number"
            }
          }
        },
        "yUnit": {
          "title": "VdiUnit",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delta",
            "kind",
            "siFactor",
            "symbol"
          ],
          "properties": {
            "symbol": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "Dimensionless",
                "Length",
                "Area",
                "Volume",
                "Mass",
                "Time",
                "Temperature",
                "Force",
                "Pressure",
                "Stress",
                "Moment",
                "Energy",
                "Power",
                "ThermalConductivity",
                "ThermalResistance",
                "HeatTransferCoefficient",
                "AirPermeability",
                "VentilationRate",
                "Acceleration"
              ]
            },
            "delta": {
              "type": "boolean"
            },
            "siFactor": {
              "type": "number"
            }
          }
        },
        "points": {
          "type": "array",
          "items": {
            "title": "CurvePoint",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
