{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/vdi3805/mutation/add-product/schema.json",
  "title": "AddProduct",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product"
  ],
  "properties": {
    "product": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/vdi3805/snapshot.json#/$defs/CatalogueProduct",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Product",
          "de": "Produkt"
        },
        "description": {
          "en": "The complete catalogue product to add.",
          "de": "Das vollständige hinzuzufügende Katalogprodukt."
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based position in the catalogue; a larger value appends.",
          "de": "Nullbasierte Position im Katalog; ein größerer Wert hängt an."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  }
}
