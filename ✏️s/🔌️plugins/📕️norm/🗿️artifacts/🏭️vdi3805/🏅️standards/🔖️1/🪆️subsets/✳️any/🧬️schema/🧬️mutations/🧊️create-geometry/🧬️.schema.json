{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateGeometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "geometry"
  ],
  "properties": {
    "geometry": {
      "title": "ParametricGeometry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox",
        "connections",
        "id",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bbox": {
          "title": "BoundingBox",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxX",
            "maxY",
            "maxZ",
            "minX",
            "minY",
            "minZ"
          ],
          "properties": {
            "minX": {
              "type": "number"
            },
            "minY": {
              "type": "number"
            },
            "minZ": {
              "type": "number"
            },
            "maxX": {
              "type": "number"
            },
            "maxY": {
              "type": "number"
            },
            "maxZ": {
              "type": "number"
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "title": "ConnectionPoint",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "direction",
              "id",
              "medium",
              "position"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "medium": {
                "type": "string"
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "direction": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "diameterMm": {
                "type": "number"
              }
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
