{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/vdi3805/snapshot.json",
  "title": "Vdi3805Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog",
    "editionProfile",
    "correctionAsOf",
    "strictMode",
    "index",
    "geometry",
    "curves"
  ],
  "properties": {
    "catalog": {
      "$ref": "#/$defs/ManufacturerCatalog",
      "x-semio-state": "artifact"
    },
    "editionProfile": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-semio-state": "artifact"
    },
    "correctionAsOf": {
      "$ref": "#/$defs/EditionId",
      "x-semio-state": "artifact"
    },
    "strictMode": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "index": {
      "$ref": "#/$defs/CatalogIndex",
      "x-semio-state": "artifact"
    },
    "geometry": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ParametricGeometry"
      },
      "x-semio-state": "artifact"
    },
    "curves": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CharacteristicCurve"
      },
      "x-semio-state": "artifact"
    },
    "limits": {
      "$ref": "#/$defs/SecurityLimits"
    }
  },
  "$defs": {
    "LocalizedText": {
      "title": "LocalizedText",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "text"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Language",
              "de": "Sprache"
            },
            "description": {
              "en": "Language tag, e.g. de or en.",
              "de": "Sprachkennung, z. B. de oder en."
            }
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "BuildingSystemNumber": {
      "title": "BuildingSystemNumber",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemCode",
        "subsystem",
        "sequence"
      ],
      "properties": {
        "systemCode": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "System code",
              "de": "Systemkennung"
            }
          }
        },
        "subsystem": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Subsystem",
              "de": "Teilsystem"
            }
          }
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Sequence number",
              "de": "Laufende Nummer"
            },
            "step": 1,
            "precision": 0
          }
        }
      }
    },
    "ExtensionFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ManufacturerFile": {
      "title": "ManufacturerFile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headerVersion",
        "manufacturer",
        "buildingSystemNumber",
        "created",
        "charset",
        "recordCount",
        "extensions"
      ],
      "properties": {
        "headerVersion": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Header version",
              "de": "Kopfversion"
            }
          }
        },
        "manufacturer": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Manufacturer code",
              "de": "Herstellerkennung"
            }
          }
        },
        "buildingSystemNumber": {
          "$ref": "#/$defs/BuildingSystemNumber",
          "x-semio-ui": {
            "label": {
              "en": "Building services number",
              "de": "Gewerknummer"
            }
          }
        },
        "created": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Creation date",
              "de": "Erstellungsdatum"
            }
          }
        },
        "charset": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Character set",
              "de": "Zeichensatz"
            }
          }
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Record count",
              "de": "Satzanzahl"
            },
            "step": 1,
            "precision": 0
          }
        },
        "extensions": {
          "$ref": "#/$defs/ExtensionBag",
          "x-semio-ui": {
            "label": {
              "en": "Extensions",
              "de": "Erweiterungen"
            }
          }
        }
      }
    },
    "NativeRecord": {
      "title": "NativeRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "fields",
        "extensions"
      ],
      "properties": {
        "family": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Record family",
              "de": "Satzart"
            }
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Fields",
              "de": "Felder"
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/ExtensionBag",
          "x-semio-ui": {
            "label": {
              "en": "Extensions",
              "de": "Erweiterungen"
            }
          }
        }
      }
    },
    "SheetAttributes": {
      "title": "SheetAttributes",
      "oneOf": [
        {
          "title": "ValveHeating",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dn",
            "kvsM3S",
            "pressureClass",
            "connectionType",
            "authorityMin",
            "authorityMax"
          ],
          "properties": {
            "kind": {
              "const": "valveHeating"
            },
            "dn": {
              "type": "integer",
              "minimum": 0
            },
            "kvsM3S": {
              "type": "number"
            },
            "pressureClass": {
              "type": "string"
            },
            "connectionType": {
              "type": "string"
            },
            "authorityMin": {
              "type": "number"
            },
            "authorityMax": {
              "type": "number"
            }
          }
        },
        {
          "title": "Radiator",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "standardOutputW",
            "heatExponentN",
            "lengthM",
            "heightM",
            "depthM",
            "connectionType"
          ],
          "properties": {
            "kind": {
              "const": "radiator"
            },
            "standardOutputW": {
              "type": "number"
            },
            "heatExponentN": {
              "type": "number"
            },
            "lengthM": {
              "type": "number"
            },
            "heightM": {
              "type": "number"
            },
            "depthM": {
              "type": "number"
            },
            "connectionType": {
              "type": "string"
            }
          }
        },
        {
          "title": "PumpHeating",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dnSuction",
            "dnDischarge",
            "nominalFlowM3S",
            "nominalHeadM",
            "motorPowerW",
            "hydraulicEfficiency"
          ],
          "properties": {
            "kind": {
              "const": "pumpHeating"
            },
            "dnSuction": {
              "type": "integer",
              "minimum": 0
            },
            "dnDischarge": {
              "type": "integer",
              "minimum": 0
            },
            "nominalFlowM3S": {
              "type": "number"
            },
            "nominalHeadM": {
              "type": "number"
            },
            "motorPowerW": {
              "type": "number"
            },
            "hydraulicEfficiency": {
              "type": "number"
            },
            "qhCurveRef": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "title": "HeatGenerator",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "nominalHeatOutputW",
            "fuelType",
            "flowTempMaxC",
            "returnTempMinC"
          ],
          "properties": {
            "kind": {
              "const": "heatGenerator"
            },
            "nominalHeatOutputW": {
              "type": "number"
            },
            "fuelType": {
              "type": "string"
            },
            "flowTempMaxC": {
              "type": "number"
            },
            "returnTempMinC": {
              "type": "number"
            }
          }
        },
        {
          "title": "Generic",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "generic"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GenericAttribute"
              }
            }
          }
        }
      ]
    },
    "Configuration": {
      "title": "Configuration",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "attributes",
        "functionRefs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "attributes": {
          "$ref": "#/$defs/SheetAttributes",
          "x-semio-ui": {
            "label": {
              "en": "Sheet attributes",
              "de": "Blattattribute"
            }
          }
        },
        "geometryRef": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "reference",
            "label": {
              "en": "Geometry",
              "de": "Geometrie"
            },
            "ref": {
              "kind": "geometry"
            },
            "role": "value"
          }
        },
        "functionRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "widget": "reference",
            "label": {
              "en": "Characteristic curves",
              "de": "Kennlinien"
            },
            "ref": {
              "kind": "curve"
            },
            "role": "value"
          }
        }
      }
    },
    "ProductIdentity": {
      "title": "ProductIdentity",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturerCode",
        "productGroup",
        "articleNumber"
      ],
      "properties": {
        "manufacturerCode": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Manufacturer code",
              "de": "Herstellerkennung"
            }
          }
        },
        "productGroup": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Product group",
              "de": "Produktgruppe"
            }
          }
        },
        "articleNumber": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Article number",
              "de": "Artikelnummer"
            }
          }
        }
      }
    },
    "Product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identity",
        "title",
        "sheet",
        "records",
        "configuration",
        "accessories",
        "components",
        "extensions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/ProductIdentity"
        },
        "title": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalizedText"
          }
        },
        "sheet": {
          "type": "integer"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeRecord"
          }
        },
        "configuration": {
          "$ref": "#/$defs/Configuration"
        },
        "accessories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessoryLink"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompositionLink"
          }
        },
        "extensions": {
          "$ref": "#/$defs/ExtensionFields"
        }
      }
    },
    "ManufacturerCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "products",
        "extensions"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/ManufacturerFile"
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Product"
          }
        },
        "extensions": {
          "$ref": "#/$defs/ExtensionFields"
        }
      }
    },
    "EditionId": {
      "title": "EditionId",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Year",
              "de": "Jahr"
            },
            "step": 1,
            "precision": 0
          }
        },
        "month": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Month",
              "de": "Monat"
            },
            "step": 1,
            "precision": 0
          }
        }
      }
    },
    "CatalogIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "sheet",
        "tags"
      ],
      "properties": {
        "productId": {
          "type": "string"
        },
        "sheet": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dn": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "CatalogIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogIndexEntry"
          }
        }
      }
    },
    "BoundingBox": {
      "title": "BoundingBox",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minX",
        "minY",
        "minZ",
        "maxX",
        "maxY",
        "maxZ"
      ],
      "properties": {
        "minX": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Minimum x",
              "de": "Minimum x"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.001,
            "precision": 0
          }
        },
        "minY": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Minimum y",
              "de": "Minimum y"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.001,
            "precision": 0
          }
        },
        "minZ": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Minimum z",
              "de": "Minimum z"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.001,
            "precision": 0
          }
        },
        "maxX": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Maximum x",
              "de": "Maximum x"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.001,
            "precision": 0
          }
        },
        "maxY": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Maximum y",
              "de": "Maximum y"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.001,
            "precision": 0
          }
        },
        "maxZ": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Maximum z",
              "de": "Maximum z"
            },
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "step": 0.001,
            "precision": 0
          }
        }
      }
    },
    "GeometryConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "medium",
        "position",
        "direction"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "direction": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "diameterMm": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "ParametricGeometry": {
      "title": "ParametricGeometry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bbox",
        "connections",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox",
          "x-semio-ui": {
            "label": {
              "en": "Bounding box",
              "de": "Hüllquader"
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConnectionPoint"
          },
          "x-semio-ui": {
            "label": {
              "en": "Connection points",
              "de": "Anschlusspunkte"
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "x-semio-ui": {
            "label": {
              "en": "Parameters",
              "de": "Parameter"
            }
          }
        }
      }
    },
    "CurvePoint": {
      "title": "CurvePoint",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "CharacteristicCurve": {
      "title": "CharacteristicCurve",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "xUnit",
        "yUnit",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "xUnit": {
          "$ref": "#/$defs/VdiUnit",
          "x-semio-ui": {
            "label": {
              "en": "x-axis unit",
              "de": "Einheit der x-Achse"
            }
          }
        },
        "yUnit": {
          "$ref": "#/$defs/VdiUnit",
          "x-semio-ui": {
            "label": {
              "en": "y-axis unit",
              "de": "Einheit der y-Achse"
            }
          }
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "x-semio-ui": {
            "label": {
              "en": "Curve points",
              "de": "Kennlinienpunkte"
            }
          }
        }
      }
    },
    "SecurityLimits": {
      "title": "SecurityLimits",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxFileBytes",
        "maxRecords",
        "maxFieldLength",
        "maxNestingDepth"
      ],
      "properties": {
        "maxFileBytes": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Maximum file size",
              "de": "Maximale Dateigröße"
            },
            "unit": "B",
            "step": 1,
            "precision": 0
          }
        },
        "maxRecords": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Maximum number of records",
              "de": "Maximale Satzanzahl"
            },
            "step": 1,
            "precision": 0
          }
        },
        "maxFieldLength": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Maximum field length",
              "de": "Maximale Feldlänge"
            },
            "unit": "B",
            "step": 1,
            "precision": 0
          }
        },
        "maxNestingDepth": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Maximum nesting depth",
              "de": "Maximale Verschachtelungstiefe"
            },
            "step": 1,
            "precision": 0
          }
        }
      }
    },
    "VdiUnit": {
      "title": "VdiUnit",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "kind",
        "delta",
        "siFactor"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Unit symbol",
              "de": "Einheitenzeichen"
            }
          }
        },
        "kind": {
          "$ref": "#/$defs/VdiQuantityKind"
        },
        "delta": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Difference quantity",
              "de": "Differenzgröße"
            },
            "description": {
              "en": "The unit measures a difference, e.g. K instead of °C.",
