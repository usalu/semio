{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateProduct",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product"
  ],
  "properties": {
    "product": {
      "title": "CatalogueProduct",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessories",
        "components",
        "configuration",
        "extensions",
        "identity",
        "records",
        "sheet",
        "title"
      ],
      "properties": {
        "identity": {
          "title": "ProductIdentity",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "articleNumber",
            "manufacturerCode",
            "productGroup"
          ],
          "properties": {
            "manufacturerCode": {
              "type": "string"
            },
            "productGroup": {
              "type": "string"
            },
            "articleNumber": {
              "type": "string"
            }
          }
        },
        "title": {
          "type": "array",
          "items": {
            "title": "LocalizedText",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locale",
              "text"
            ],
            "properties": {
              "locale": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "sheet": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "items": {
            "title": "NativeRecord",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "extensions",
              "family",
              "fields"
            ],
            "properties": {
              "family": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extensions": {
                "title": "ExtensionBag",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fields"
                ],
                "properties": {
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "description": "any JSON value"
                    }
                  }
                }
              }
            }
          }
        },
        "configuration": {
          "title": "Configuration",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "functionRefs",
            "id",
            "parameters"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Boolean"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Integer"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Decimal"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Text"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Enumeration"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Range"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "List"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "geometryRef": {
              "type": "string"
            },
            "functionRefs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "accessories": {
          "type": "array",
          "items": {
            "title": "AccessoryLink",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accessoryId",
              "quantity",
              "required"
            ],
            "properties": {
              "accessoryId": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "quantity": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "title": "CompositionLink",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "componentId",
              "quantity"
            ],
            "properties": {
              "componentId": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "extensions": {
          "title": "ExtensionBag",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "description": "any JSON value"
              }
            }
          }
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
