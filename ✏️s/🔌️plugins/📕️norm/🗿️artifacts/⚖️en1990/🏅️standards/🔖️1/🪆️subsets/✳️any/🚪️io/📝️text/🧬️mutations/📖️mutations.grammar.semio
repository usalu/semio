dialect grammar
grammar en1990.op
extension en1990
use family-sheet
start mutation

artifact-mark = "norm.en1990-op"
mutation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("en1990-basis" | "en1990-combination" | "en1990-partial-factor" | "en1990-verdict" | "en1990-annex" | "en1990-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
