dialect protocol
protocol en1990.mutations
version 1
schema norm.en1990.mutations
start record
framing record

# Real `En1990Mutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record change-annex tag=0
field payload bytes
record change-permanent-action tag=1
field payload bytes
record change-resistance tag=2
field payload bytes
record change-consequence-class tag=3
field payload bytes
record change-seismic-action tag=4
field payload bytes
record insert-variable-action tag=5
field payload bytes
record remove-variable-action tag=6
field payload bytes
record change-variable-action-category tag=7
field payload bytes
record change-variable-action-value tag=8
field payload bytes
record reorder-variable-actions tag=9
field payload bytes
