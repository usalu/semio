{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1990/artifact.json",
  "title": "En1990Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex",
    "projectId",
    "structureKind",
    "altitudeM",
    "consequenceClass",
    "reliabilityClass",
    "designWorkingLifeCategory",
    "designWorkingLifeYears",
    "referencePeriodYears",
    "supervisionLevel",
    "inspectionLevel",
    "betaComputed",
    "permanents",
    "variables",
    "accidentals",
    "seismics",
    "members",
    "bridgeSls",
    "effects",
    "fatigueSpectra",
    "reliabilityAnalyses",
    "testSeries",
    "placements",
    "cases",
    "factorOverrides",
    "trafficGroups"
  ],
  "properties": {
    "annex": {
      "type": "string",
      "enum": [
        "En",
        "De"
      ],
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "AnnexChoice"
      }
    },
    "projectId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "structureKind": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1990/snapshot.json#/$defs/StructureKind",
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "semio_s_artifact_norm_en1990_model::StructureKind"
      }
    },
    "altitudeM": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "consequenceClass": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-state": "artifact"
    },
    "reliabilityClass": {
      "type": "string",
      "enum": [
        "RC1",
        "RC2",
        "RC3"
      ],
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "semio_s_artifact_norm_en1990_model::ReliabilityClass"
      }
    },
    "designWorkingLifeCategory": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-state": "artifact"
    },
    "designWorkingLifeYears": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "referencePeriodYears": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "supervisionLevel": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1990/snapshot.json#/$defs/SupervisionLevel",
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "semio_s_artifact_norm_en1990_model::SupervisionLevel"
      }
    },
    "inspectionLevel": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1990/snapshot.json#/$defs/InspectionLevel",
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "semio_s_artifact_norm_en1990_model::InspectionLevel"
      }
    },
    "betaComputed": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "permanents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PermanentAction"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::PermanentAction>"
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VariableAction"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::VariableAction>"
      }
    },
    "accidentals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AccidentalAction"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::AccidentalAction>"
      }
    },
    "seismics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SeismicAction"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::SeismicAction>"
      }
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Member"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::Member>"
      }
    },
    "bridgeSls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BridgeSls"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::BridgeSls>"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemberEffect"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::MemberEffect>"
      }
    },
    "fatigueSpectra": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FatigueSpectrum"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::FatigueSpectrum>"
      }
    },
    "reliabilityAnalyses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReliabilityAnalysis"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::ReliabilityAnalysis>"
      }
    },
    "testSeries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestSeries"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::TestSeries>"
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Placement"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::Placement>"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CaseRow"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::CaseRow>"
      }
    },
    "factorOverrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FactorOverride"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::FactorOverride>"
      }
    },
    "trafficGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TrafficGroup"
      },
      "x-semio-state": "artifact",
      "x-semio-rust": {
        "type": "Vec<semio_s_artifact_norm_en1990_model::TrafficGroup>"
      }
    }
  },
  "$defs": {
    "PermanentAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "gk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "gk": {
          "type": "number"
        }
      }
    },
    "VariableAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "qk",
        "group"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "qk": {
          "type": "number"
        },
        "group": {
          "type": "string"
        }
      }
    },
    "AccidentalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ad"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ad": {
          "type": "number"
        }
      }
    },
    "SeismicAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aEk",
        "importanceClass"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "aEk": {
          "type": "number"
        },
        "importanceClass": {
          "type": "string",
          "enum": [
            "I",
            "II",
            "III",
            "IV"
          ]
        }
      }
    },
    "Member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelEn",
        "labelDe",
        "rdStr",
        "rdGeo",
        "rdEquStab",
        "rdEquDestab",
        "rdFat",
        "span",
        "precamber",
        "deflectionW1",
        "deflectionW2",
        "deflectionW3",
        "deflectionLimitRatio",
        "deflectionLimitRatioW3",
        "slsLimitChar",
        "slsLimitFreq",
        "slsLimitQp",
        "vibrationFrequency",
        "vibrationFrequencyMin",
        "frameHeight",
        "frameDrift",
        "storeyHeight",
        "storeyDrift",
        "materialStrengthK",
        "materialConversionFactor",
        "materialPartialFactor",
        "materialDesignStrength",
        "nominalDimension",
        "dimensionTolerance",
        "designDimension",
        "memberAlphaCr",
        "secondOrderAnalysis"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "labelEn": {
          "type": "string"
        },
        "labelDe": {
          "type": "string"
        },
        "rdStr": {
          "type": "number"
        },
        "rdGeo": {
          "type": "number"
        },
        "rdEquStab": {
          "type": "number"
        },
        "rdEquDestab": {
          "type": "number"
        },
        "rdFat": {
          "type": "number"
        },
        "span": {
          "type": "number"
        },
        "precamber": {
          "type": "number"
        },
        "deflectionW1": {
          "type": "number"
        },
        "deflectionW2": {
          "type": "number"
        },
        "deflectionW3": {
          "type": "number"
        },
        "deflectionLimitRatio": {
          "type": "number"
        },
        "deflectionLimitRatioW3": {
          "type": "number"
        },
        "slsLimitChar": {
          "type": "number"
        },
        "slsLimitFreq": {
          "type": "number"
        },
        "slsLimitQp": {
          "type": "number"
        },
        "vibrationFrequency": {
          "type": "number"
        },
        "vibrationFrequencyMin": {
          "type": "number"
        },
        "frameHeight": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Frame height H (A1.4)",
              "de": "Rahmenhöhe H (A1.4)"
            },
            "widget": "stepper",
            "precision": 2,
            "step": 0.01
          }
        },
        "frameDrift": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Horizontal frame drift u",
              "de": "Horizontale Rahmenverschiebung u"
            },
            "widget": "stepper",
            "precision": 4,
            "step": 0.001
          }
        },
        "storeyHeight": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Storey height h (A1.4)",
              "de": "Geschosshöhe h (A1.4)"
            },
            "widget": "stepper",
            "precision": 2,
            "step": 0.01
          }
        },
        "storeyDrift": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Horizontal storey drift u_i",
              "de": "Horizontale Geschossverschiebung u_i"
            },
            "widget": "stepper",
            "precision": 4,
            "step": 0.001
          }
        },
        "materialStrengthK": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Characteristic material strength X_k (E90.10)",
              "de": "Charakteristische Materialfestigkeit X_k (E90.10)"
            },
            "widget": "stepper",
            "precision": 0,
            "step": 500000
          }
        },
        "materialConversionFactor": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Conversion factor η (0 = 1.0)",
              "de": "Umrechnungsfaktor η (0 = 1,0)"
            },
            "widget": "stepper",
            "precision": 3,
            "step": 0.01
          }
        },
        "materialPartialFactor": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Material partial factor γ_m",
              "de": "Teilsicherheitsbeiwert des Materials γ_m"
            },
            "widget": "stepper",
            "precision": 3,
            "step": 0.01
          }
        },
        "materialDesignStrength": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Declared design strength X_d",
              "de": "Angesetzte Bemessungsfestigkeit X_d"
            },
            "widget": "stepper",
            "precision": 0,
            "step": 500000
          }
        },
        "nominalDimension": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Nominal dimension a_nom (E90.11)",
              "de": "Nennmaß a_nom (E90.11)"
            },
            "widget": "stepper",
            "precision": 4,
            "step": 0.001
          }
        },
        "dimensionTolerance": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Dimension tolerance Δa",
              "de": "Maßtoleranz Δa"
            },
            "widget": "stepper",
            "precision": 4,
            "step": 0.0005
          }
        },
        "designDimension": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Declared design dimension a_d",
              "de": "Angesetztes Bemessungsmaß a_d"
            },
            "widget": "stepper",
            "precision": 4,
            "step": 0.001
          }
        },
        "memberAlphaCr": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Elastic critical load factor α_cr (0 = not declared, E90.12)",
              "de": "Verzweigungslastfaktor α_cr (0 = nicht angegeben, E90.12)"
            },
            "widget": "stepper",
            "precision": 2,
            "step": 0.1
          }
        },
        "secondOrderAnalysis": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Second-order analysis used (0 = first order, 1 = second order)",
              "de": "Theorie 2. Ordnung angesetzt (0 = Theorie 1. Ordnung, 1 = 2. Ordnung)"
            },
            "widget": "stepper",
            "precision": 0,
            "step": 1
          }
        }
      }
    },
    "MemberEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "actionId",
        "influence"
      ],
      "properties": {
        "memberId": {
          "type": "string"
        },
        "actionId": {
          "type": "string"
        },
        "influence": {
          "type": "number"
        }
      }
    },
    "BridgeSls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "memberId",
        "deckAcceleration",
        "deckAccelerationLimit",
        "deckTwist",
        "deckTwistLimit",
        "bridgeDeflection",
        "bridgeDeflectionLimit",
        "trackGauge",
        "lineSpeed",
        "ballastDepth",
        "deckMass",
        "naturalFrequency",
        "endRotation",
        "basicWindSpeed",
        "dampingRatio"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "memberId": {
          "type": "string"
        },
        "deckAcceleration": {
          "type": "number"
        },
        "deckAccelerationLimit": {
          "type": "number"
        },
        "deckTwist": {
          "type": "number"
        },
        "deckTwistLimit": {
          "type": "number"
        },
        "bridgeDeflection": {
          "type": "number"
        },
        "bridgeDeflectionLimit": {
          "type": "number"
        },
        "trackGauge": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Track gauge (0 = not declared)",
              "de": "Spurweite (0 = nicht angegeben)"
            },
            "widget": "stepper",
            "precision": 3,
            "step": 0.001
          }
        },
        "lineSpeed": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Maximum line speed (0 = not declared)",
              "de": "Höchstgeschwindigkeit der Strecke (0 = nicht angegeben)"
            },
            "widget": "stepper",
            "precision": 0,
            "step": 5
          }
        },
        "ballastDepth": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Ballast depth (0 = slab track)",
              "de": "Schotterhöhe (0 = feste Fahrbahn)"
            },
            "widget": "stepper",
            "precision": 2,
            "step": 0.01
          }
        },
        "deckMass": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Deck mass per length",
              "de": "Deckmasse je Meter"
            },
            "widget": "stepper",
            "precision": 0,
            "step": 100
          }
        },
        "naturalFrequency": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Deck natural frequency",
              "de": "Eigenfrequenz des Decks"
            },
            "widget": "stepper",
            "precision": 2,
            "step": 0.1
          }
        },
        "endRotation": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Deck end rotation",
              "de": "Endverdrehung des Decks"
            },
            "widget": "stepper",
            "precision": 5,
            "step": 0.0001
          }
        },
        "basicWindSpeed": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Basic wind speed v_b (0 = no F*_W cap)",
              "de": "Basiswindgeschwindigkeit v_b (0 = keine F*_W-Kappung)"
            },
            "widget": "stepper",
            "precision": 1,
            "step": 0.5
          }
        },
        "dampingRatio": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Deck damping ratio ζ (0 = registry default)",
              "de": "Dämpfungsgrad ζ des Decks (0 = Registerwert)"
            },
            "widget": "stepper",
            "precision": 4,
            "step": 0.001
          }
        }
      }
    },
    "FatigueSpectrum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "memberId",
        "detailCategory",
        "stressRange",
        "cycles"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "memberId": {
          "type": "string"
        },
        "detailCategory": {
          "type": "number"
        },
        "stressRange": {
          "type": "number"
        },
        "cycles": {
          "type": "number"
        }
      }
    },
    "ReliabilityAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "resistanceDistribution",
        "resistanceMean",
        "resistanceSd",
        "actionDistribution",
        "actionMean",
        "actionSd",
        "secondActionDistribution",
        "secondActionMean",
        "secondActionSd",
        "memberId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "resistanceDistribution": {
          "type": "string"
        },
        "resistanceMean": {
          "type": "number"
        },
        "resistanceSd": {
          "type": "number"
        },
        "actionDistribution": {
          "type": "string"
        },
        "actionMean": {
          "type": "number"
        },
        "actionSd": {
          "type": "number"
        },
        "secondActionDistribution": {
          "type": "string"
        },
        "secondActionMean": {
          "type": "number"
        },
        "secondActionSd": {
          "type": "number"
        },
        "memberId": {"type": "string"}
      }
    },
    "TestSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "quantity",
        "distribution",
        "sampleSize",
        "mean",
        "stdDev",
        "variationKnown",
        "conversionFactor",
        "required",
        "pairs",
        "theoryVariation",
        "theoryMean"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "quantity": {
          "type": "string"
        },
        "distribution": {
          "type": "string"
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "mean": {
          "type": "number"
        },
        "stdDev": {
          "type": "number"
        },
        "variationKnown": {
          "type": "number"
        },
        "conversionFactor": {
          "type": "number"
        },
        "required": {
          "type": "number"
        },
        "pairs": {"type": "string"},
        "theoryVariation": {"type": "number", "format": "double"},
        "theoryMean": {"type": "number"}
      }
    },
    "Placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "z",
        "yaw"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "label": {
              "en": "Placed entity",
              "de": "Platziertes Element"
            },
            "ref": {
              "kind": "entity"
            }
          }
        },
        "x": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Origin x",
              "de": "Ursprung x"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "m",
            "displayFactor": 1,
            "precision": 3,
            "step": 0.1
          }
        },
        "y": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Origin y",
              "de": "Ursprung y"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "m",
