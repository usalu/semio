{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/norm/en1990/artifact.json",
  "title": "En1990Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gK",
    "qK",
    "resistanceKn",
    "consequenceClass",
    "annex",
    "seismicAEdKn"
  ],
  "properties": {
    "gK": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "qK": {
      "$ref": "https://semio.tech/schema/os/store/child.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "resistanceKn": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "consequenceClass": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-state": "artifact"
    },
    "annex": {
      "type": "string",
      "enum": [
        "En",
        "De"
      ],
      "x-semio-state": "artifact"
    },
    "seismicAEdKn": {
      "type": "number",
      "x-semio-state": "artifact"
    }
  }
}
