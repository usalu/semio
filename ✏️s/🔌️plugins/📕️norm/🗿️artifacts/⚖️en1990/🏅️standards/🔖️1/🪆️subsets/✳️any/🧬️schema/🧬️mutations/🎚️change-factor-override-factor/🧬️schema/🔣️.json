            "de": "ψ₀ Kombinationsbeiwert"
          },
          "psi1": {
            "en": "ψ₁ frequent value",
            "de": "ψ₁ Beiwert für häufige Werte"
          },
          "psi2": {
            "en": "ψ₂ quasi-permanent value",
