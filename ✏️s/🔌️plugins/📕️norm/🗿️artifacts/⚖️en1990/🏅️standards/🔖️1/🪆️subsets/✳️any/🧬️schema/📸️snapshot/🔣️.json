{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1990/snapshot.json",
  "title": "En1990Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex",
    "projectId",
    "structureKind",
    "altitudeM",
    "consequenceClass",
    "reliabilityClass",
    "designWorkingLifeCategory",
    "designWorkingLifeYears",
    "referencePeriodYears",
    "supervisionLevel",
    "inspectionLevel",
    "kFiDeclared",
    "betaComputed",
    "permanents",
    "variables",
    "accidentals",
    "seismics",
    "members",
    "bridgeSls",
    "effects"
  ],
  "properties": {
    "annex": {
      "type": "string",
      "enum": [
        "En",
        "De"
      ],
      "x-semio-state": "artifact"
    },
    "projectId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "structureKind": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "consequenceClass": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-state": "artifact"
    },
    "reliabilityClass": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-state": "artifact"
    },
    "designWorkingLifeCategory": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-state": "artifact"
    },
    "designWorkingLifeYears": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "referencePeriodYears": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "supervisionLevel": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "inspectionLevel": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "kFiDeclared": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "betaComputed": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "permanents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PermanentAction"
      },
      "x-semio-state": "artifact"
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VariableAction"
      },
      "x-semio-state": "artifact"
    },
    "accidentals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AccidentalAction"
      },
      "x-semio-state": "artifact"
    },
    "seismics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SeismicAction"
      },
      "x-semio-state": "artifact"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Member"
      },
      "x-semio-state": "artifact"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemberEffect"
      },
      "x-semio-state": "artifact"
    },
    "altitudeM": {
      "type": "number",
      "x-semio-state": "artifact"
    },
    "bridgeSls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BridgeSls"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "PermanentAction": {
      "title": "PermanentAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "gk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "gk": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Characteristic permanent action G_k",
              "de": "Charakteristischer Wert der ständigen Einwirkung G_k"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "VariableAction": {
      "title": "VariableAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "qk"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Action category",
              "de": "Einwirkungskategorie"
            },
            "description": {
              "en": "EN 1990 Table A1.1 category selecting ψ₀, ψ₁, ψ₂ (e.g. Q_imposed_A, Q_snow, Q_wind).",
              "de": "Kategorie nach EN 1990 Tabelle A1.1, die ψ₀, ψ₁, ψ₂ bestimmt (z. B. Q_imposed_A, Q_snow, Q_wind)."
            },
            "widget": "text"
          }
        },
        "qk": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Characteristic variable action Q_k",
              "de": "Charakteristischer Wert der veränderlichen Einwirkung Q_k"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "AccidentalAction": {
      "title": "AccidentalAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ad"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ad": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Design accidental action A_d",
              "de": "Bemessungswert der außergewöhnlichen Einwirkung A_d"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "SeismicAction": {
      "title": "SeismicAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aEk",
        "importanceClass"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "aEk": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Characteristic seismic action A_Ek",
              "de": "Charakteristischer Wert der Erdbebeneinwirkung A_Ek"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        },
        "importanceClass": {
          "$ref": "#/$defs/ImportanceClass",
          "x-semio-ui": {
            "label": {
              "en": "Importance class",
              "de": "Bedeutungskategorie"
            }
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "Member": {
      "title": "Member",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelEn",
        "labelDe",
        "rdStr",
        "rdGeo",
        "rdEquStab",
        "rdEquDestab",
        "rdFat",
        "span",
        "deflectionW",
        "deflectionLimitRatio",
        "vibrationFrequency",
        "vibrationFrequencyMin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "labelEn": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Label (English)",
              "de": "Bezeichnung (Englisch)"
            },
            "widget": "text"
          }
        },
        "labelDe": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Label (German)",
              "de": "Bezeichnung (Deutsch)"
            },
            "widget": "text"
          }
        },
        "rdStr": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Design resistance R_d (STR)",
              "de": "Bemessungswert des Widerstands R_d (STR)"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        },
        "rdGeo": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Design resistance R_d (GEO)",
              "de": "Bemessungswert des Widerstands R_d (GEO)"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        },
        "rdEquStab": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Stabilising design effect (EQU)",
              "de": "Bemessungswert der stabilisierenden Einwirkung (EQU)"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        },
        "rdEquDestab": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Destabilising design effect (EQU)",
              "de": "Bemessungswert der destabilisierenden Einwirkung (EQU)"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        },
        "rdFat": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Design fatigue resistance (FAT)",
              "de": "Bemessungswert des Ermüdungswiderstands (FAT)"
            },
            "widget": "stepper",
            "unit": "N",
            "displayUnit": "kN",
            "displayFactor": 0.001,
            "precision": 2
          }
        },
        "span": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Span l",
              "de": "Stützweite l"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 3
          }
        },
        "deflectionW": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Deflection w",
              "de": "Durchbiegung w"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "deflectionLimitRatio": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Deflection limit l/…",
              "de": "Durchbiegungsgrenze l/…"
            },
            "description": {
              "en": "Denominator of the admissible deflection l/n.",
              "de": "Nenner der zulässigen Durchbiegung l/n."
            },
            "widget": "stepper",
            "precision": 0
          }
        },
        "vibrationFrequency": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Natural frequency f",
              "de": "Eigenfrequenz f"
            },
            "widget": "stepper",
            "unit": "Hz",
            "precision": 2
          }
        },
        "vibrationFrequencyMin": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Minimum natural frequency f_min",
              "de": "Mindesteigenfrequenz f_min"
            },
            "widget": "stepper",
            "unit": "Hz",
            "precision": 2
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "MemberEffect": {
      "title": "MemberEffect",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "actionId",
        "influence"
      ],
      "properties": {
        "memberId": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Member",
              "de": "Bauteil"
            },
            "widget": "reference",
            "role": "value",
            "ref": {
              "kind": "member"
            }
          }
        },
        "actionId": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Action",
              "de": "Einwirkung"
            },
            "widget": "reference",
            "role": "value",
            "ref": {
              "kind": "action"
            }
          }
        },
        "influence": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Influence coefficient",
              "de": "Einflussbeiwert"
            },
            "description": {
              "en": "Factor mapping the action magnitude onto the member effect.",
              "de": "Faktor, der die Größe der Einwirkung auf die Beanspruchung des Bauteils abbildet."
            },
            "widget": "stepper",
            "precision": 3
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "BridgeSls": {
      "title": "BridgeSls",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "memberId",
        "deckAcceleration",
        "deckAccelerationLimit",
        "deckTwist",
        "deckTwistLimit",
        "bridgeDeflection",
        "bridgeDeflectionLimit"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "memberId": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Member",
              "de": "Bauteil"
            },
            "widget": "reference",
            "role": "value",
            "ref": {
              "kind": "member"
            }
          }
        },
        "deckAcceleration": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Deck acceleration a",
              "de": "Überbaubeschleunigung a"
            },
            "widget": "stepper",
            "unit": "m/s²",
            "precision": 2
          }
        },
        "deckAccelerationLimit": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Admissible deck acceleration a_max",
              "de": "Zulässige Überbaubeschleunigung a_max"
            },
            "widget": "stepper",
            "unit": "m/s²",
            "precision": 2
          }
        },
        "deckTwist": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Deck twist t",
              "de": "Verwindung des Überbaus t"
            },
            "widget": "stepper",
            "unit": "rad",
            "precision": 4
          }
        },
        "deckTwistLimit": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Admissible deck twist t_max",
              "de": "Zulässige Verwindung t_max"
            },
            "widget": "stepper",
            "unit": "rad",
            "precision": 4
          }
        },
        "bridgeDeflection": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Vertical deflection δ",
              "de": "Vertikale Durchbiegung δ"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "bridgeDeflectionLimit": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Admissible vertical deflection δ_max",
              "de": "Zulässige vertikale Durchbiegung δ_max"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "AnnexChoice": {
      "title": "AnnexChoice",
      "type": "string",
      "enum": [
        "En",
        "De"
      ],
      "x-semio-ui": {
        "options": {
          "En": {
            "en": "Recommended CEN values (EN)",
            "de": "Empfohlene CEN-Werte (EN)"
          },
          "De": {
            "en": "German national annex (DIN EN)",
            "de": "Deutscher Nationaler Anhang (DIN EN)"
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🔗️graphql"
      ]
    },
    "ImportanceClass": {
      "title": "ImportanceClass",
      "type": "string",
      "enum": [
        "I",
        "II",
        "III",
        "IV"
      ],
      "x-semio-ui": {
        "options": {
          "I": {
            "en": "I — minor importance",
            "de": "I — geringe Bedeutung"
          },
          "II": {
            "en": "II — ordinary buildings",
            "de": "II — gewöhnliche Hochbauten"
          },
          "III": {
            "en": "III — large occupancy",
            "de": "III — große Menschenansammlungen"
          },
          "IV": {
            "en": "IV — vital for civil protection",
            "de": "IV — lebenswichtig für den Katastrophenschutz"
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🔗️graphql"
      ]
    }
  }
}
