{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/norm/en1990/snapshot.json",
  "title": "En1990Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gK",
    "qK",
    "resistanceKn",
    "consequenceClass",
    "annex",
    "seismicAEdKn"
  ],
  "properties": {
    "gK": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "qK": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/norm/en1990/artifact.json#/$defs/En1990QkEntry"
      },
      "x-semio-state": "artifact"
    },
    "resistanceKn": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "consequenceClass": {
      "type": "integer",
      "format": "uint32",
      "x-semio-state": "artifact"
    },
    "annex": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "seismicAEdKn": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    }
  }
}
