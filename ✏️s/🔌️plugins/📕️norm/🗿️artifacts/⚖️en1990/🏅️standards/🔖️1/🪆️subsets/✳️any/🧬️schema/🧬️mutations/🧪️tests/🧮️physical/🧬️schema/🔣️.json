{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "bodyBytes",
    "maximumTurns",
    "copyBytes",
    "capacityBytes",
    "releaseBytes",
    "depth",
    "cancelAfter",
    "operationIndices",
    "expected",
    "heapQuote"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "s.norm-eurocode.en1990.physical-public-factory.v1"
    },
    "bodyBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maximumTurns": {
      "type": "integer",
      "minimum": 1
    },
    "copyBytes": {
      "type": "integer",
      "minimum": 1
    },
    "capacityBytes": {
      "type": "integer",
      "minimum": 1
    },
    "releaseBytes": {
      "type": "integer",
      "minimum": 1
    },
    "depth": {
      "type": "integer",
      "minimum": 1
    },
    "cancelAfter": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "operationIndices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "heapMatchesReceipts",
        "unchangedOnDenial",
        "coldEditWithinQuote"
      ],
      "additionalProperties": false,
      "properties": {
        "heapMatchesReceipts": {
          "const": true
        },
        "unchangedOnDenial": {
          "const": true
        },
        "coldEditWithinQuote": {
          "const": true
        }
      }
    },
    "heapQuote": {
      "type": "object",
      "required": [
        "factor",
        "fixedBytes",
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "factor": {
          "type": "integer",
          "minimum": 1
        },
        "fixedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "snapshotBytes",
              "mutationBytes",
              "copyBytes",
              "capacityBytes",
              "transientBytes"
            ],
            "additionalProperties": false,
            "properties": {
              "snapshotBytes": {
                "type": "integer",
                "minimum": 0
              },
              "mutationBytes": {
                "type": "integer",
                "minimum": 0
              },
              "copyBytes": {
                "type": "integer",
                "minimum": 0
              },
              "capacityBytes": {
                "type": "integer",
                "minimum": 0
              },
              "transientBytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
