{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1990/mutation/insert-seismic/schema.json",
  "title": "InsertSeismic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "item"
  ],
  "properties": {
    "mutation": {
      "const": "insertSeismic"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "label": {
          "en": "Position",
          "de": "Position"
