        "widget": "stepper",
        "step": 1,
        "precision": 0,
        "description": {
          "en": "Zero-based list position.",
          "de": "Nullbasierte Listenposition."
        }
      }
    },
    "item": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1990/snapshot.json#/$defs/SeismicAction",
      "x-semio-ui": {
        "label": {
          "en": "Seismic action",
          "de": "Erdbebeneinwirkung"
        }
      }
    }
  }
}
