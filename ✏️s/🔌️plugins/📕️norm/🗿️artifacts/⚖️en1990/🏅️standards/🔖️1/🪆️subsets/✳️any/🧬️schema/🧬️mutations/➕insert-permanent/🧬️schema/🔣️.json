{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1990/mutation/insert-permanent/schema.json",
  "title": "InsertPermanent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "item"
  ],
  "properties": {
    "mutation": {
      "const": "insertPermanent"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "widget": "stepper",
        "step": 1,
        "precision": 0,
        "description": {
          "en": "Zero-based list position at which the record is inserted. Empty appends; positions past the end append.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird. Ohne Angabe am Ende; Positionen hinter dem Ende hängen an."
        }
      }
    },
    "item": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1990/snapshot.json#/$defs/PermanentAction",
      "x-semio-ui": {
        "label": {
          "en": "Permanent action",
          "de": "Ständige Einwirkung"
        }
      }
    }
  }
}
