dialect grammar
grammar en1996.diff
extension en1996
use family-sheet
start diff

artifact-mark = "norm.en1996-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("en1996-basis" | "en1996-combination" | "en1996-partial-factor" | "en1996-verdict" | "en1996-annex" | "en1996-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
