dialect grammar
grammar en1996.document
extension en1996
use family-sheet
start document

artifact-mark = "norm.en1996"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("en1996-basis" | "en1996-combination" | "en1996-partial-factor" | "en1996-verdict" | "en1996-annex" | "en1996-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
