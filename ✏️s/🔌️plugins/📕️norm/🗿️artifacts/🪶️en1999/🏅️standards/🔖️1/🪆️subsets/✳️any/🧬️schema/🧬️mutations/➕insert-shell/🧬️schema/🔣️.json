{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/mutation/insert-shell/schema.json",
  "title": "InsertShell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "shell"
  ],
  "properties": {
    "mutation": {
      "const": "insertShell"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "shell": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/snapshot.json#/$defs/AluminiumShell",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Shell",
          "de": "Schale"
        },
        "description": {
          "en": "The complete shell record to add.",
          "de": "Der vollständige hinzuzufügende Datensatz: Schale."
        },
        "group": "record",
        "order": 20
      },
      "x-semio-rust": {
        "type": "AluminiumShell"
      }
    }
  }
}
