{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/mutation/change-shell-radius/schema.json",
  "title": "ChangeShellRadius",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "shellId",
    "newRadius"
  ],
  "properties": {
    "mutation": {
      "const": "changeShellRadius"
    },
    "shellId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Shell",
          "de": "Schale"
        },
        "description": {
          "en": "The shell this mutation addresses, by id.",
          "de": "Das adressierte Element (Schale), per Kennung."
        },
        "ref": {
          "kind": "shell"
        },
        "group": "target",
        "order": 10
      }
    },
    "newRadius": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Mid-surface radius r",
          "de": "Radius der Mittelfläche r"
        },
        "widget": "stepper",
        "unit": "m",
        "precision": 2,
        "step": 0.05,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
