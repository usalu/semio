{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/mutation/insert-section-element/schema.json",
  "title": "InsertSectionElement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "sectionId",
    "index",
    "element"
  ],
  "properties": {
    "mutation": {
      "const": "insertSectionElement"
    },
    "sectionId": {
      "type": "string",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Section",
          "de": "Querschnitt"
        },
        "description": {
          "en": "The section that owns the row, by id.",
          "de": "Das Elternelement (Querschnitt), per Kennung."
        },
        "group": "target",
        "order": 10,
        "widget": "reference",
        "ref": {
          "kind": "sections"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Zero-based list position at which the record is inserted.",
          "de": "Nullbasierte Listenposition, an der der Datensatz eingefügt wird."
        },
        "group": "target",
        "order": 20,
        "widget": "stepper",
        "step": 1,
        "precision": 0
      }
    },
    "element": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/snapshot.json#/$defs/PlateElement",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Section element",
          "de": "Querschnittsteil"
        },
        "description": {
          "en": "The complete section element record to add.",
          "de": "Der vollständige hinzuzufügende Datensatz: Querschnittsteil."
        },
        "group": "record",
        "order": 30
      },
      "x-semio-rust": {
        "type": "PlateElement"
      }
    }
  }
}
