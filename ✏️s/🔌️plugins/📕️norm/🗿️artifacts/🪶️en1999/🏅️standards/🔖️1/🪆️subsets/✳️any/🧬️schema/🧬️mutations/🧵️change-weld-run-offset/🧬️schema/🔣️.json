{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/mutation/change-weld-run-offset/schema.json",
  "title": "ChangeWeldRunOffset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "weldRunId",
    "newOffset"
  ],
  "properties": {
