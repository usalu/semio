      "const": "changeWeldRunOffset"
    },
    "weldRunId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Weld run",
          "de": "Schweißnaht"
        },
        "description": {
          "en": "The weld run this mutation addresses, by id.",
          "de": "Das adressierte Element (Schweißnaht), per Kennung."
        },
        "ref": {
