        },
        "group": "target",
        "order": 10
      }
    },
    "newOffset": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Weld position across the element",
          "de": "Nahtlage quer zum Element"
        },
        "widget": "stepper",
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "precision": 1,
        "step": 0.001,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
