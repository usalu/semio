    "newNCycles": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Number of cycles n_i",
          "de": "Lastspielzahl n_i"
        },
        "widget": "stepper",
        "precision": 0,
        "step": 10000,
        "snaps": [
          2000000,
          5000000,
          100000000
