{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/mutation/change-fatigue-n-cycles/schema.json",
  "title": "ChangeFatigueNCycles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "fatigueDetailId",
    "newNCycles"
  ],
  "properties": {
    "mutation": {
      "const": "changeFatigueNCycles"
    },
    "fatigueDetailId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Fatigue detail",
          "de": "Ermüdungsdetail"
        },
        "description": {
          "en": "The fatigue detail this mutation addresses, by id.",
          "de": "Das adressierte Element (Ermüdungsdetail), per Kennung."
        },
        "ref": {
          "kind": "fatigue-detail"
        },
        "group": "target",
        "order": 10
      }
