{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/mutation/change-section-web-thickness/schema.json",
  "title": "ChangeSectionWebThickness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "sectionId",
    "newWebThickness"
  ],
  "properties": {
    "mutation": {
      "const": "changeSectionWebThickness"
    },
    "sectionId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Section",
          "de": "Querschnitt"
        },
        "description": {
          "en": "The section this mutation addresses, by id.",
          "de": "Das adressierte Element (Querschnitt), per Kennung."
        },
        "ref": {
          "kind": "section"
        },
        "group": "target",
        "order": 10
      }
    },
    "newWebThickness": {
      "type": "number",
      "x-semio-ui": {
        "label": {
          "en": "Web (wall) thickness t_w",
          "de": "Steg- bzw. Wanddicke t_w"
        },
        "widget": "stepper",
        "unit": "m",
        "displayUnit": "mm",
        "displayFactor": 1000,
        "precision": 1,
        "step": 0.0001,
        "role": "value",
        "group": "value",
        "order": 20
      }
    }
  }
}
