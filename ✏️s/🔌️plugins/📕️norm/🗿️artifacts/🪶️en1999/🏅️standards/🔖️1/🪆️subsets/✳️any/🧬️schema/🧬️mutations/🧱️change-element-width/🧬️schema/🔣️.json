        },
        "group": "target",
        "order": 10
      }
    },
    "elementId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Element",
          "de": "Querschnittsteil"
        },
        "description": {
          "en": "The element this mutation addresses, by id.",
