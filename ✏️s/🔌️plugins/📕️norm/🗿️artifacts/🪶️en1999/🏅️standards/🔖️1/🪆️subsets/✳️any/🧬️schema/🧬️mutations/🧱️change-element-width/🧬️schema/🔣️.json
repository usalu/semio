{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/mutation/change-element-width/schema.json",
  "title": "ChangeElementWidth",
  "type": "object",
