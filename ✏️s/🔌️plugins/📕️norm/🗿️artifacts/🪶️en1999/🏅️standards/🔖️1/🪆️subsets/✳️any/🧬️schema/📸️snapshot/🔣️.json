            "label": {
              "en": "Characteristic actions",
              "de": "Charakteristische Einwirkungen"
            }
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "AnnexChoice": {
      "title": "AnnexChoice",
      "type": "string",
