            "label": {
              "en": "System length L",
              "de": "Systemlänge L"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2,
            "step": 0.05
          }
        },
        "support": {
          "$ref": "#/$defs/SupportCondition",
