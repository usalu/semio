            "widget": "stepper",
            "unit": "m",
            "precision": 2,
            "step": 0.05
          }
        },
        "bucklingLengthZ": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Buckling length l_cr,z",
              "de": "Knicklänge l_cr,z"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2,
            "step": 0.05
          }
        },
        "bucklingLengthT": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Torsional buckling length l_cr,T",
              "de": "Drillknicklänge l_cr,T"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2,
            "step": 0.05
          }
        },
        "ltbLength": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Lateral-torsional buckling length",
              "de": "Kipplänge"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2,
            "step": 0.05
          }
        },
        "c1": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Moment factor C₁",
              "de": "Momentenbeiwert C₁"
            },
            "widget": "stepper",
            "precision": 3,
            "step": 0.01
          }
        },
        "restrainedLtb": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Laterally restrained",
              "de": "Gegen Kippen gehalten"
            },
            "widget": "toggle"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberAction"
          },
