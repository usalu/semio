{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/norm/en1999/snapshot.json",
  "title": "En1999Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annex",
    "materials",
    "sections",
    "members",
    "connections",
    "fireScenarios",
    "fatigueDetails",
    "coldFormed",
    "shells"
  ],
  "properties": {
    "annex": {
      "$ref": "#/$defs/AnnexChoice",
      "x-semio-state": "artifact"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AluminiumMaterial"
      },
      "x-semio-state": "artifact"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AluminiumSection"
      },
      "x-semio-state": "artifact"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AluminiumMember"
      },
      "x-semio-state": "artifact"
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AluminiumConnection"
      },
      "x-semio-state": "artifact"
    },
    "fireScenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FireScenario"
      },
      "x-semio-state": "artifact"
    },
    "fatigueDetails": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FatigueDetail"
      },
      "x-semio-state": "artifact"
    },
    "coldFormed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ColdFormedSheet"
      },
      "x-semio-state": "artifact"
    },
    "shells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AluminiumShell"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "ColdFormedSheet": {
      "title": "ColdFormedSheet",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "materialId",
        "thickness",
        "width",
        "span",
        "welded",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "materialId": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Aluminium alloy",
              "de": "Aluminiumlegierung"
            },
            "widget": "reference",
            "role": "value",
            "ref": {
              "kind": "material"
            }
          }
        },
        "thickness": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Design thickness t",
              "de": "Bemessungsblechdicke t"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1,
            "step": 0.0001
          }
        },
        "width": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Flat width b",
              "de": "Ebene Breite b"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1,
            "step": 0.001
          }
        },
        "span": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Span L",
              "de": "Stützweite L"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2,
            "step": 0.05
          }
        },
        "welded": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Welded",
              "de": "Geschweißt"
            },
            "widget": "toggle"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberAction"
          },
          "x-semio-ui": {
            "label": {
              "en": "Characteristic actions",
              "de": "Charakteristische Einwirkungen"
            }
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust",
        "🟦️typescript",
        "🔗️graphql",
        "🛰️protobuf"
      ]
    },
    "AluminiumMember": {
      "title": "AluminiumMember",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
