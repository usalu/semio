            "role": "value",
            "ref": {
              "kind": "material"
            }
          }
        },
        "length": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Buckling axis",
              "de": "Knickachse"
            },
            "description": {
              "en": "y, z, t (torsional) or ltb (lateral-torsional); anything else sets y.",
              "de": "y, z, t (Drillknicken) oder ltb (Biegedrillknicken); jeder andere Wert setzt y."
            }
          }
        },
        "support": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Support conditions",
              "de": "Lagerungsbedingungen"
            },
            "description": {
              "en": "simplySupported, continuous or cantilever.",
              "de": "simplySupported (Einfeldträger), continuous (Durchlaufträger) oder cantilever (Kragarm)."
