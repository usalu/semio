  "$defs": {
    "ColdFormedSheet": {
      "title": "ColdFormedSheet",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "materialId",
        "thickness",
        "width",
        "span",
        "welded",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "materialId": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Aluminium alloy",
              "de": "Aluminiumlegierung"
            },
            "widget": "reference",
            "role": "value",
            "ref": {
              "kind": "material"
            }
          }
        },
        "thickness": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Design thickness t",
              "de": "Bemessungsblechdicke t"
            },
            "widget": "stepper",
            "unit": "m",
            "displayUnit": "mm",
            "displayFactor": 1000,
            "precision": 1
          }
        },
        "width": {
          "type": "number"
        },
        "span": {
          "type": "number",
          "x-semio-ui": {
            "label": {
              "en": "Span L",
              "de": "Stützweite L"
            },
            "widget": "stepper",
            "unit": "m",
            "precision": 2
          }
        },
        "welded": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Welded",
              "de": "Geschweißt"
            },
            "widget": "toggle"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemberAction"
          },
          "x-semio-ui": {
            "label": {
              "en": "Characteristic actions",
              "de": "Charakteristische Einwirkungen"
            }
          }
        }
      }
    },
    "AluminiumMember": {
