dialect grammar
grammar en1999.op
extension en1999
use family-sheet
start mutation

artifact-mark = "norm.en1999-op"
mutation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("en1999-basis" | "en1999-combination" | "en1999-partial-factor" | "en1999-verdict" | "en1999-annex" | "en1999-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
