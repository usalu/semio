dialect grammar
grammar en1990.diff
extension en1990
use family-sheet
start diff

artifact-mark = "norm.en1990-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("en1990-basis" | "en1990-combination" | "en1990-partial-factor" | "en1990-verdict" | "en1990-annex" | "en1990-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
