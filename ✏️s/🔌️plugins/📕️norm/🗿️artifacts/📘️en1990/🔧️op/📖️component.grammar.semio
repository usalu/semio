dialect grammar
grammar en1990.op
extension en1990
use family-sheet
start operation

operation = ("set" | "patch" | "remove") field*
field = ("g-k" | "q-k" | "resistance-kn" | "consequence-class" | "annex" | "seismic-a-ed-kn" | "started" | "actor" | IDENT) "=" value
value = TEXT | INT | FLOAT | BOOL | UNITNUM | IDENT
UNITNUM = FLOAT UNIT | INT UNIT
UNIT = IDENT
