dialect grammar
grammar en1990.document
extension en1990
use family-sheet
start document

document = header assign*
header = "semio" IDENT "v" INT
assign = ("g-k" | "q-k" | "resistance-kn" | "consequence-class" | "annex" | "seismic-a-ed-kn" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | UNITNUM | IDENT
UNITNUM = FLOAT UNIT | INT UNIT
UNIT = IDENT
