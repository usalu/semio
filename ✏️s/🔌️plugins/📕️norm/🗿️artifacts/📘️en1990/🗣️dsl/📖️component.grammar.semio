dialect grammar
grammar en1990.document
extension en1990
use family-sheet
start document

artifact-mark = "norm.en1990"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("en1990-basis" | "en1990-combination" | "en1990-partial-factor" | "en1990-verdict" | "en1990-annex" | "en1990-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
