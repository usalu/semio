dialect grammar
grammar en1993.diff
extension en1993
use family-sheet
start diff

artifact-mark = "norm.en1993-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("en1993-basis" | "en1993-combination" | "en1993-partial-factor" | "en1993-verdict" | "en1993-annex" | "en1993-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
