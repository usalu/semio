dialect grammar
grammar en1993.op
extension en1993
use family-sheet
start operation

artifact-mark = "norm.en1993-op"
operation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("en1993-basis" | "en1993-combination" | "en1993-partial-factor" | "en1993-verdict" | "en1993-annex" | "en1993-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
