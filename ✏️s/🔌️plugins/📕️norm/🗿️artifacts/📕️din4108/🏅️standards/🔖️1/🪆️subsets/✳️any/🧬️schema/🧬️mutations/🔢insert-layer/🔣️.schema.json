{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InsertLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "layer"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "layer": {
      "title": "LayerDocument",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lambdaWMk",
        "thicknessM"
      ],
      "properties": {
        "thicknessM": {
          "type": "number"
        },
        "lambdaWMk": {
          "type": "number"
        }
      }
    }
  }
}
