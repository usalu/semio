dialect grammar
grammar din4108.diff
extension din4108
use family-sheet
start diff

artifact-mark = "norm.din4108-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("din4108-basis" | "din4108-combination" | "din4108-partial-factor" | "din4108-verdict" | "din4108-annex" | "din4108-actor" | "started" | "actor") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
