dialect grammar
grammar din4108.document
extension din4108
use family-sheet
start document

artifact-mark = "norm.din4108"
document = artifact-mark doc-body
doc-body = header sheet-body
header = "semio" IDENT "v" INT
sheet-body = assign*
assign = ("din4108-basis" | "din4108-combination" | "din4108-partial-factor" | "din4108-verdict" | "din4108-annex" | "din4108-actor" | "started" | "actor") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY | clause-ref
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
clause-ref = IDENT "." IDENT
trace = IDENT "=" expr ARROW FLOAT
