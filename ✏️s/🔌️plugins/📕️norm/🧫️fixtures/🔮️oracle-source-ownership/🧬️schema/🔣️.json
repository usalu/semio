{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plugin",
    "manifest",
    "source",
    "destination",
    "module",
    "package",
    "host",
    "adapters"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugin": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "const": "🐍️"
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "adapters": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "feature", "owner"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
