{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 2,
  "factory": {
    "type": "NormBoundedCommandJobFactory",
    "payloadSchema": "norm.tool-command.v1",
    "maximumRawBytes": 8192,
    "shared": true
  },
  "publicationContracts": [
    { "toolId": "setSnapshot", "lanes": ["Artifact"] },
    { "toolId": "evaluate", "lanes": ["HostOnly"] },
    { "toolId": "setSelectedCheckIndex", "lanes": ["Config"] }
  ],
  "routes": [
    {
      "id": "setSnapshot",
      "emittedLanes": ["artifact"],
      "publicationLanes": ["Artifact"],
      "execution": "bounded",
      "admission": "migrated",
      "reducer": "🎮️commands/📤️set-snapshot — XMutation::from_snapshot bundled as one described edit"
    },
    {
      "id": "evaluate",
      "emittedLanes": [],
      "publicationLanes": ["HostOnly"],
      "execution": "bounded",
      "admission": "migrated",
      "reducer": "🎮️commands/🧮️evaluate — the report is derived on every read, so the reducer emits nothing"
    },
    {
      "id": "setSelectedCheckIndex",
      "emittedLanes": ["config"],
      "publicationLanes": ["Config"],
      "execution": "bounded",
      "admission": "migrated",
      "reducer": "🎮️commands/☑️selected-check — NormConfigMutation::ChangeSelectedCheckIndex"
    }
  ],
