{
  "$id": "https://semio.tech/schema/app/remodel/remodel/config.json",
  "title": "RemodelConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera",
    "layers",
    "frameCursor",
    "reportTable",
    "activeUtilityId",
    "locale"
  ],
  "properties": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "fov"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-state": "config"
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-state": "config"
        },
        "fov": {
          "type": "number",
          "x-semio-state": "config"
        }
      },
      "x-semio-state": "config"
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mesh",
        "dense",
        "sparse",
        "cameras",
        "gcps"
      ],
      "properties": {
        "mesh": {
          "type": "boolean",
          "x-semio-state": "config"
        },
        "dense": {
          "type": "boolean",
          "x-semio-state": "config"
        },
        "sparse": {
          "type": "boolean",
          "x-semio-state": "config"
        },
        "cameras": {
          "type": "boolean",
          "x-semio-state": "config"
        },
        "gcps": {
          "type": "boolean",
          "x-semio-state": "config"
        }
      },
      "x-semio-state": "config"
    },
    "frameCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameIndex"
      ],
      "properties": {
        "streamId": {
          "type": "string",
          "x-semio-state": "config"
        },
        "frameIndex": {
          "type": "integer",
          "minimum": 0,
          "x-semio-state": "config"
        }
      },
      "x-semio-state": "config"
    },
    "reportTable": {
      "type": "string",
      "x-semio-state": "config"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  }
}
