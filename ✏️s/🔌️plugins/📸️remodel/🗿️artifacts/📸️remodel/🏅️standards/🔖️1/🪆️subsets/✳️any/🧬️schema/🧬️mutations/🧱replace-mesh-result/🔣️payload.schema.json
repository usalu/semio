{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceMeshResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh"
  ],
  "properties": {
    "mesh": {
      "title": "RemodelMesh",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mesh",
        "source"
      ],
      "properties": {
        "mesh": {
          "type": "object",
          "properties": {
            "childId": {
              "type": "string"
            },
            "target": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string"
                },
                "dialect": {
                  "type": "string"
                }
              },
              "required": [
                "artifactId",
                "dialect"
              ]
            }
          },
          "required": [
            "childId",
            "target"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "placeholder",
            "reconstructed",
            "imported"
          ]
        },
        "textureAssetId": {
          "type": "string"
        },
        "watertight": {
          "title": "WatertightReportSnapshot",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundaryEdgeCount",
            "boundaryLoopCount",
            "closedFallbackUsed",
            "connectedComponents",
            "consistentlyOriented",
            "eulerCharacteristic",
            "isClosed",
            "isTwoManifold",
            "isWatertight",
            "nonManifoldEdgeCount",
            "nonManifoldVertexCount",
            "signedVolume",
            "triangleCount",
            "vertexCount"
          ],
          "properties": {
            "vertexCount": {
              "type": "integer",
              "minimum": 0
            },
            "triangleCount": {
              "type": "integer",
              "minimum": 0
            },
            "boundaryEdgeCount": {
              "type": "integer",
              "minimum": 0
            },
            "boundaryLoopCount": {
              "type": "integer",
              "minimum": 0
            },
            "nonManifoldEdgeCount": {
              "type": "integer",
              "minimum": 0
            },
            "nonManifoldVertexCount": {
              "type": "integer",
              "minimum": 0
            },
            "connectedComponents": {
              "type": "integer",
              "minimum": 0
            },
            "consistentlyOriented": {
              "type": "boolean"
            },
            "eulerCharacteristic": {
              "type": "integer"
            },
            "genus": {
              "type": "integer"
            },
            "signedVolume": {
              "type": "number"
            },
            "selfIntersectionPairs": {
              "type": "integer",
              "minimum": 0
            },
            "closedFallbackUsed": {
              "type": "boolean"
            },
            "isClosed": {
              "type": "boolean"
            },
            "isTwoManifold": {
              "type": "boolean"
            },
            "isWatertight": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
