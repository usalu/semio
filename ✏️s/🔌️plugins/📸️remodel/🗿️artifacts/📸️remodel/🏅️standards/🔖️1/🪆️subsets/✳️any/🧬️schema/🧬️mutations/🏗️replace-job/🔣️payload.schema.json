{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job"
  ],
  "properties": {
    "job": {
      "title": "ReconstructionJob",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cameraPosesPreview",
        "cancelRequested",
        "id",
        "progress01",
        "sparsePointCloudPreview",
        "stage",
        "stageCursor"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "enum": [
            "idle",
            "ingesting",
            "calibrating",
            "extracting-features",
            "matching-features",
            "estimating-poses",
            "bundle-adjusting",
            "georeferencing",
            "dense-stereo",
            "fusing-volume",
            "extracting-surface",
            "cleaning-mesh",
            "texturing",
            "tracking-motion",
            "deriving-geo-products",
            "reporting-qc",
            "done",
            "failed"
          ]
        },
        "progress01": {
          "type": "number"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "stageCursor": {
          "type": "integer",
          "minimum": 0
        },
        "startedAtMs": {
          "type": "number"
        },
        "error": {
          "type": "string"
        },
        "cameraPosesPreview": {
          "type": "array",
          "items": {
            "title": "CameraPosePreview",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cameraId",
              "rotationWxyz",
              "translation"
            ],
            "properties": {
              "cameraId": {
                "type": "string"
              },
              "rotationWxyz": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "translation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        "sparsePointCloudPreview": {
          "type": "string"
        }
      }
    }
  }
}
