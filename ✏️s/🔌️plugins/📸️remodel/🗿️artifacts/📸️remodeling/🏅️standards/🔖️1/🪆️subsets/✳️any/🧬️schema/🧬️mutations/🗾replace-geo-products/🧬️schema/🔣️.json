{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/replace-geo-products/schema.json",
  "title": "ReplaceGeoProducts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "geo"
  ],
  "properties": {
    "mutation": {
      "const": "replaceGeoProducts"
    },
    "geo": {
      "anyOf": [
        {
          "type": "object",
          "title": "GeoProducts",
          "additionalProperties": false,
          "required": [
            "dsmAssetId",
            "dtmAssetId",
            "orthoAssetId"
          ],
          "properties": {
            "dsmAssetId": {
              "type": [
                "string",
                "null"
              ],
              "x-semio-ui": {
                "widget": "reference",
                "role": "target",
                "label": {
                  "en": "DSM Raster",
                  "de": "DOM-Raster"
                },
                "description": {
                  "en": "Digital surface model raster.",
                  "de": "Raster des digitalen Oberflächenmodells."
                },
                "ref": {
                  "kind": "asset",
                  "domain": "assets",
                  "granularity": "asset"
                },
                "group": "result",
                "order": 10
              }
            },
            "dtmAssetId": {
              "type": [
                "string",
                "null"
              ],
              "x-semio-ui": {
                "widget": "reference",
                "role": "target",
                "label": {
                  "en": "DTM Raster",
                  "de": "DGM-Raster"
                },
                "description": {
                  "en": "Digital terrain model raster.",
                  "de": "Raster des digitalen Geländemodells."
                },
                "ref": {
                  "kind": "asset",
                  "domain": "assets",
                  "granularity": "asset"
                },
                "group": "result",
                "order": 20
              }
            },
            "orthoAssetId": {
              "type": [
                "string",
                "null"
              ],
              "x-semio-ui": {
                "widget": "reference",
                "role": "target",
                "label": {
                  "en": "Orthophoto",
                  "de": "Orthofoto"
                },
                "description": {
                  "en": "True orthophoto raster.",
                  "de": "Raster des Orthofotos."
                },
                "ref": {
                  "kind": "asset",
                  "domain": "assets",
                  "granularity": "asset"
                },
                "group": "result",
                "order": 30
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Geo Products",
          "de": "Geoprodukte"
        },
        "description": {
          "en": "DSM, DTM and orthophoto rasters; empty clears them.",
          "de": "DOM-, DGM- und Orthofoto-Raster; leer entfernt sie."
        },
        "group": "result",
        "order": 10
      }
    }
  }
}
