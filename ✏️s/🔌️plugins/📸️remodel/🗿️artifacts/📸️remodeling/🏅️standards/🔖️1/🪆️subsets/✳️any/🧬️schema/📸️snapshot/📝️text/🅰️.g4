// 🅰️ ANTLR4 mirror of the normative 📖️.grammar.semio in this directory — generated by
// 🐍️grammar-sidecars.py in the REMODEL-PLUGIN-END-TO-END ticket; same production names,
// kebab-case -> camelCase. Start rule: document.
grammar Remodeling_remodeling_snapshot;

artifactMark: 'remodeling.remodeling' ;
document: artifactMark snapshotBody ;
snapshotBody: schemaLine idLine snapshotPart* ;
schemaLine: 'schema' '=' 'remodeling.scene' ;
idLine: 'id' '=' name ;
snapshotPart: assetsMap | durableArtifactsMap | calibrationBlock | paramsBlock | jobBlock | resultsBlock | streamsTable | gcpsTable ;
name: IDENT | TEXT ;
num: INT | FLOAT ;
quantity: num IDENT ;
coord3: '@' num ',' num ',' num ;
pair: num ',' num ;
quad: num ',' num ',' num ',' num ;
quint: num ',' num ',' num ',' num ',' num ;
textList: '[' name* ']' ;
cell: PLACEHOLDER ;
assetsMap: 'assets' '=' '{' assetEntry* '}' ;
assetEntry: name '=' childHandle ;
childHandle: 'child_id' '=' name 'target' '=' TEXT ;
durableArtifactsMap: 'durable-artifacts' '=' '{' durableEntry* '}' ;
durableEntry: name '=' durableField+ ;
durableField: 'kind' '=' name | 'mime' '=' name | 'width' '=' INT | 'height' '=' INT | 'chunks' '=' textList ;
calibrationBlock: 'calibration' '{' camerasTable rigTable '}' ;
camerasTable: 'cameras' camerasHeader '{' cameraRow* '}' ;
camerasHeader: '[' 'id' ':' 'TEXT' 'label' ':' 'TEXT' 'model' ':' 'TEXT' 'fx' ':' 'NUM' 'fy' ':' 'NUM' 'cx' ':' 'NUM' 'cy' ':' 'NUM' 'skew' ':' 'NUM' 'distortion' ':' 'TUPLE' 'rms-reprojection-px' ':' 'NUM' 'locked' ':' 'BOOL' ']' ;
cameraRow: name name name num num num num num quint (num | cell) BOOL ;
rigTable: 'rig' rigHeader '{' rigRow* '}' ;
rigHeader: '[' 'camera-id' ':' 'TEXT' 'rotation-wxyz' ':' 'TUPLE' 'translation-m' ':' 'CRD' ']' ;
rigRow: name quad coord3 ;
streamsTable: 'streams' streamsHeader '{' streamRow* '}' ;
streamsHeader: '[' 'id' ':' 'TEXT' 'name' ':' 'TEXT' 'kind' ':' 'ENUM' 'camera-id' ':' 'TEXT' 'sync-offset-ms' ':' 'NUM' 'fps-hint' ':' 'NUM' 'frames' ':' 'TABLE' 'source' ':' 'BLOCK' ']' ;
streamRow: name name mediaKind (name | cell) num num frameList (videoSourceBlock | cell) ;
mediaKind: 'image-sequence' | 'video' ;
frameList: '[' frameItem* ']' ;
frameItem: '{' frameField+ '}' ;
frameField: 'index' '=' INT | 'timestamp-ms' '=' num | 'asset-id' '=' name ;
videoSourceBlock: '{' videoSourceField+ '}' ;
videoSourceField: 'name' '=' name | 'container' '=' name | 'codec' '=' videoCodec | 'duration-ms' '=' num | 'frame-count' '=' INT | 'width' '=' INT | 'height' '=' INT ;
videoCodec: 'avc' | 'hevc' | 'vp9' | 'av1' | 'mjpeg' | 'unknown' ;
gcpsTable: 'gcps' gcpsHeader '{' gcpRow* '}' ;
gcpsHeader: '[' 'id' ':' 'TEXT' 'name' ':' 'TEXT' 'world-position' ':' 'CRD' 'observations' ':' 'TABLE' ']' ;
gcpRow: name name coord3 observationList ;
observationList: '[' observationItem* ']' ;
observationItem: '{' observationField+ '}' ;
observationField: 'stream-id' '=' name | 'frame-index' '=' INT | 'pixel' '=' pair ;
paramsBlock: 'params' '{' paramsPart* '}' ;
paramsPart: ingestBlock | featureBlock | matchingBlock | sfmBlock | denseBlock | meshParamsBlock | motionBlock | geoBlock ;
ingestBlock: 'ingest' '{' ingestField* '}' ;
ingestField: 'frame-sample-stride' '=' INT | 'max-frames' '=' INT | 'downscale-long-edge-px' '=' INT | 'min-sharpness' '=' num ;
featureBlock: 'feature' '{' featureField* '}' ;
featureField: 'detector' '=' detector | 'target-count' '=' INT | 'octaves' '=' INT | 'edge-threshold' '=' num ;
detector: 'orb' | 'akaze' | 'harris' ;
matchingBlock: 'matching' '{' matchingField* '}' ;
matchingField: 'matcher' '=' matcher | 'ratio-test' '=' num | 'cross-check' '=' BOOL | 'sequential-window' '=' INT | 'max-pairs-per-frame' '=' INT | 'loop-closure' '=' BOOL ;
matcher: 'brute-force' | 'kd-tree' ;
sfmBlock: 'sfm' '{' sfmField* '}' ;
sfmField: 'ransac-iterations' '=' INT | 'ransac-threshold-px' '=' num | 'min-track-length' '=' INT | 'ba-max-iterations' '=' INT | 'robust-loss' '=' robustLoss | 'huber-delta-px' '=' num ;
robustLoss: 'l2' | 'huber' | 'cauchy' ;
denseBlock: 'dense' '{' denseField* '}' ;
denseField: 'resolution' '=' denseResolution | 'window-radius-px' '=' INT | 'min-view-consistency' '=' INT | 'confidence-threshold' '=' num | 'max-points' '=' INT ;
denseResolution: 'low' | 'medium' | 'high' ;
meshParamsBlock: 'mesh' '{' meshParamsField* '}' ;
meshParamsField: 'tsdf-voxel-size-mm' '=' quantity | 'tsdf-truncation-mm' '=' quantity | 'decimate-target-triangles' '=' INT | 'smoothing-iterations' '=' INT | 'texture-enabled' '=' BOOL | 'texture-size' '=' INT | 'guarantee-watertight' '=' BOOL | 'hole-fill-max-boundary-verts' '=' INT | 'self-intersection-check' '=' BOOL ;
motionBlock: 'motion' '{' motionField* '}' ;
motionField: 'enabled' '=' BOOL | 'max-tracks' '=' INT | 'track-window-px' '=' INT | 'min-track-quality' '=' num | 'min-track-length-frames' '=' INT ;
geoBlock: 'geo' '{' geoParamField* '}' ;
geoParamField: 'enabled' '=' BOOL | 'origin-lon' '=' num | 'origin-lat' '=' num | 'origin-alt' '=' num | 'gsd-m' '=' quantity | 'dsm-cell-m' '=' quantity | 'dtm-filter-radius-m' '=' quantity | 'ortho-max-px' '=' INT ;
jobBlock: 'job' '{' jobPart* '}' ;
jobPart: jobField | posesTable ;
jobField: 'id' '=' name | 'stage' '=' stage | 'progress-0-1' '=' num | 'cancel-requested' '=' BOOL | 'stage-cursor' '=' INT | 'started-at-ms' '=' num | 'error' '=' name | 'sparse-point-cloud-preview' '=' name ;
stage: 'idle' | 'ingesting' | 'calibrating' | 'extracting-features' | 'matching-features' | 'estimating-poses' | 'bundle-adjusting' | 'georeferencing' | 'dense-stereo' | 'fusing-volume' | 'extracting-surface' | 'cleaning-mesh' | 'texturing' | 'tracking-motion' | 'deriving-geo-products' | 'reporting-qc' | 'done' | 'failed' ;
posesTable: 'camera-poses-preview' posesHeader '{' poseRow* '}' ;
posesHeader: '[' 'camera-id' ':' 'TEXT' 'rotation-wxyz' ':' 'TUPLE' 'translation' ':' 'CRD' ']' ;
poseRow: name quad coord3 ;
resultsBlock: 'results' '{' resultsPart* '}' ;
resultsPart: sparseBlock | denseResultBlock | meshResultBlock | trajectoryBlock | geoProductsBlock | qcBlock | tracksTable ;
sparseBlock: 'sparse' '{' sparseField+ '}' ;
sparseField: 'points' '=' name | 'colors' '=' name ;
denseResultBlock: 'dense' '{' denseResultField+ '}' ;
denseResultField: 'positions' '=' name | 'colors' '=' name | 'confidence' '=' name | 'classification' '=' name ;
meshResultBlock: 'mesh' '{' meshResultPart* '}' ;
meshResultPart: 'source' '=' meshSource | 'texture-asset-id' '=' name | meshChildBlock | watertightBlock ;
meshSource: 'placeholder' | 'reconstructed' | 'imported' ;
meshChildBlock: 'mesh' '{' childHandle '}' ;
watertightBlock: 'watertight' '{' watertightField* '}' ;
watertightField: 'vertex-count' '=' INT | 'triangle-count' '=' INT | 'boundary-edge-count' '=' INT | 'boundary-loop-count' '=' INT | 'non-manifold-edge-count' '=' INT | 'non-manifold-vertex-count' '=' INT | 'connected-components' '=' INT | 'consistently-oriented' '=' BOOL | 'euler-characteristic' '=' INT | 'genus' '=' INT | 'signed-volume' '=' num | 'self-intersection-pairs' '=' INT | 'closed-fallback-used' '=' BOOL | 'is-closed' '=' BOOL | 'is-two-manifold' '=' BOOL | 'is-watertight' '=' BOOL ;
trajectoryBlock: 'trajectory' '{' trajectoryPosesTable '}' ;
trajectoryPosesTable: 'poses' posesHeader '{' poseRow* '}' ;
geoProductsBlock: 'geo' '{' geoProductField+ '}' ;
geoProductField: 'dsm-asset-id' '=' name | 'dtm-asset-id' '=' name | 'ortho-asset-id' '=' name ;
qcBlock: 'qc' '{' qcPart* '}' ;
qcPart: 'reprojection-rms-px' '=' num | 'gcp-checkpoint-rmse' '=' num | 'mean-track-length' '=' num | 'registered-frame-ratio' '=' num | 'dense-coverage-ratio' '=' num | watertightBlock | 'warnings' '=' textList ;
tracksTable: 'tracks' tracksHeader '{' trackRow* '}' ;
tracksHeader: '[' 'id' ':' 'TEXT' 'length' ':' 'UINT' 'class' ':' 'ENUM' 'mean-speed-m-s' ':' 'QTY' ']' ;
trackRow: name INT trackClass quantity ;
trackClass: 'static' | 'moving' ;

// 📐 Framework dialect-primitive terminals (only named, never defined, by the .semio itself).
BOOL: 'true' | 'false' ;
FLOAT: '-'? [0-9]+ '.' [0-9]+ ([eE] [+-]? [0-9]+)? ;
INT: '-'? [0-9]+ ;
IDENT: [A-Za-z_] [A-Za-z0-9_\-./]* ;
PLACEHOLDER: '_' ;
TEXT: '"' (~["\\] | '\\' .)* '"' ;
WS: [ \t\r\n]+ -> skip ;
