{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/1/any/mutation/replace-sparse/schema.json",
  "title": "ReplaceSparse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sparse"
  ],
  "properties": {
    "sparse": {
      "anyOf": [
        {
          "type": "object",
          "title": "SparseCloud",
          "additionalProperties": false,
          "required": [
            "points",
            "colors"
          ],
          "properties": {
            "points": {
              "type": "string",
              "format": "base64",
              "description": "base64 of little-endian f32 lanes (semio_s_plugin_remodel PackedF32)"
            },
            "colors": {
              "type": [
                "string",
                "null"
              ],
              "format": "base64",
              "description": "base64 of raw u8 lanes (semio_s_plugin_remodel PackedU8)"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
