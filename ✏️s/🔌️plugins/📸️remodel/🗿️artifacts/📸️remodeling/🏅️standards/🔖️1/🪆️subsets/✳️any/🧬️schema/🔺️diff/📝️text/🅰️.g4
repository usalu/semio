// 🅰️ ANTLR4 mirror of the normative 📖️.grammar.semio in this directory — generated by
// 🐍️grammar-sidecars.py in the REMODEL-PLUGIN-END-TO-END ticket; same production names,
// kebab-case -> camelCase. Start rule: diff.
grammar Remodeling_remodeling_diff;

diff: '{' lane* '}' ;
lane: artifactLane | schemaLane | idLane | streamsLane | assetsLane | durableArtifactsLane | calibrationLane | paramsLane | gcpsLane | jobLane | resultsLane | selectionLane | activeUtilityIdLane | reportTableLane | frameCursorLane | cameraLane | layersLane | localeLane ;
artifactLane: 'artifact' '=' value ;
schemaLane: 'schema' '=' value ;
idLane: 'id' '=' value ;
streamsLane: 'streams' '=' value ;
assetsLane: 'assets' '=' value ;
durableArtifactsLane: 'durableArtifacts' '=' value ;
calibrationLane: 'calibration' '=' value ;
paramsLane: 'params' '=' value ;
gcpsLane: 'gcps' '=' value ;
jobLane: 'job' '=' value ;
resultsLane: 'results' '=' value ;
selectionLane: 'selection' '=' value ;
activeUtilityIdLane: 'activeUtilityId' '=' value ;
reportTableLane: 'reportTable' '=' value ;
frameCursorLane: 'frameCursor' '=' value ;
cameraLane: 'camera' '=' value ;
layersLane: 'layers' '=' value ;
localeLane: 'locale' '=' value ;
value: 'null' | 'true' | 'false' | number | TEXT | array | object ;
number: INT | FLOAT ;
array: '[' value* ']' ;
object: '{' member* '}' ;
member: key '=' value ;
key: IDENT | TEXT ;

// 📐 Framework dialect-primitive terminals (only named, never defined, by the .semio itself).
BOOL: 'true' | 'false' ;
FLOAT: '-'? [0-9]+ '.' [0-9]+ ([eE] [+-]? [0-9]+)? ;
INT: '-'? [0-9]+ ;
IDENT: [A-Za-z_] [A-Za-z0-9_\-./]* ;
PLACEHOLDER: '_' ;
TEXT: '"' (~["\\] | '\\' .)* '"' ;
WS: [ \t\r\n]+ -> skip ;
