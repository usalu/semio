{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/1/any/mutation/update-sfm-params.json",
  "title": "UpdateSfmParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "params"
  ],
  "properties": {
    "params": {
      "type": "object",
      "title": "SfmParams",
      "additionalProperties": false,
      "required": [
        "ransacIterations",
        "ransacThresholdPx",
        "minTrackLength",
        "baMaxIterations",
        "robustLoss",
        "huberDeltaPx"
      ],
      "properties": {
        "ransacIterations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ransacThresholdPx": {
          "type": "number",
          "format": "float"
        },
        "minTrackLength": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "baMaxIterations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "robustLoss": {
          "type": "string",
          "title": "RobustLossKind",
          "enum": [
            "l2",
            "huber",
            "cauchy"
          ]
        },
        "huberDeltaPx": {
          "type": "number",
          "format": "float"
        }
      }
    }
  }
}
