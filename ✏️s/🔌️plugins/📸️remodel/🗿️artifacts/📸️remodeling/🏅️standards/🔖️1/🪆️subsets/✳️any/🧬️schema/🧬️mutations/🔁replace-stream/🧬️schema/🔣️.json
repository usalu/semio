{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/replace-stream-source/schema.json",
  "title": "ReplaceStreamSource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "source"
  ],
  "properties": {
    "mutation": {
      "const": "replaceStreamSource"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Stream",
          "de": "Stream"
        },
        "description": {
          "en": "The stream whose video provenance changes.",
          "de": "Stream, dessen Videoherkunft geändert wird."
        },
        "ref": {
          "kind": "stream"
        },
        "group": "target",
        "order": 10
      }
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "title": "VideoSource",
          "additionalProperties": false,
          "required": [
            "name",
            "container",
            "codec",
            "durationMs",
            "frameCount",
            "width",
            "height"
          ],
          "properties": {
            "name": {
              "type": "string",
              "x-semio-ui": {
                "widget": "text",
                "role": "value",
                "label": {
                  "en": "File Name",
                  "de": "Dateiname"
                },
                "group": "media",
                "order": 10
              }
            },
            "container": {
              "type": "string",
              "x-semio-ui": {
                "widget": "text",
                "role": "value",
                "label": {
                  "en": "Container",
                  "de": "Container"
                },
                "description": {
                  "en": "e.g. MP4 or AVI.",
                  "de": "z. B. MP4 oder AVI."
                },
                "group": "media",
                "order": 20
              }
            },
            "codec": {
              "type": "string",
              "title": "VideoCodec",
              "enum": [
                "avc",
                "hevc",
                "vp9",
                "av1",
                "mjpeg",
                "unknown"
              ],
              "x-semio-ui": {
                "widget": "select",
                "role": "value",
                "label": {
                  "en": "Codec",
                  "de": "Codec"
                },
                "options": {
                  "avc": {
                    "en": "H.264/AVC",
                    "de": "H.264/AVC"
                  },
                  "hevc": {
                    "en": "H.265/HEVC",
                    "de": "H.265/HEVC"
                  },
                  "vp9": {
                    "en": "VP9",
                    "de": "VP9"
                  },
                  "av1": {
                    "en": "AV1",
                    "de": "AV1"
                  },
                  "mjpeg": {
                    "en": "Motion JPEG",
                    "de": "Motion JPEG"
                  },
                  "unknown": {
                    "en": "Unknown",
                    "de": "Unbekannt"
                  }
                },
                "group": "media",
                "order": 30
              }
            },
            "durationMs": {
              "type": "number",
              "format": "double",
              "x-semio-ui": {
                "widget": "stepper",
                "role": "value",
                "label": {
                  "en": "Duration (ms)",
                  "de": "Dauer (ms)"
                },
                "unit": "ms",
                "step": 1,
                "precision": 1,
                "group": "timing",
                "order": 40
              }
            },
            "frameCount": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "x-semio-ui": {
                "widget": "stepper",
                "role": "value",
                "label": {
                  "en": "Frame Count",
                  "de": "Bildanzahl"
                },
                "step": 1,
                "precision": 0,
                "group": "media",
                "order": 50
              }
            },
            "width": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "x-semio-ui": {
                "widget": "stepper",
                "role": "value",
                "label": {
                  "en": "Width (px)",
                  "de": "Breite (px)"
                },
                "unit": "px",
                "step": 1,
                "precision": 0,
                "group": "media",
                "order": 60
              }
            },
            "height": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "x-semio-ui": {
                "widget": "stepper",
                "role": "value",
                "label": {
                  "en": "Height (px)",
                  "de": "Höhe (px)"
                },
                "unit": "px",
                "step": 1,
                "precision": 0,
                "group": "media",
                "order": 70
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Video Source",
          "de": "Videoquelle"
        },
        "description": {
          "en": "Provenance of a stream imported from a video file; empty for image sequences.",
          "de": "Herkunft eines aus einer Videodatei importierten Streams; leer bei Bildsequenzen."
        },
        "group": "media",
        "order": 20
      }
    }
  }
}
