{
  "$id": "https://semio.tech/schema/s/remodel/remodeling/snapshot.json",
  "title": "RemodelingSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "streams",
    "assets",
    "durableArtifacts",
    "calibration",
    "params",
    "gcps",
    "job",
    "results"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MediaStream"
      },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RemodelingAssetChild"
      },
      "x-semio-state": "artifact"
    },
    "durableArtifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RemodelingDurableArtifact"
      },
      "x-semio-state": "artifact"
    },
    "calibration": {
      "$ref": "#/$defs/CalibrationState",
      "x-semio-state": "artifact"
    },
    "params": {
      "$ref": "#/$defs/ReconstructionParams",
      "x-semio-state": "artifact"
    },
    "gcps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GroundControlPoint"
      },
      "x-semio-state": "artifact"
    },
    "job": {
      "$ref": "#/$defs/ReconstructionJob",
      "x-semio-state": "artifact"
    },
    "results": {
      "$ref": "#/$defs/ReconstructionResults",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "ArtifactDialect": {
      "type": "object",
      "title": "ArtifactDialect",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "subset": {
          "type": "string"
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "title": "ArtifactRef",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "dialect"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "dialect": {
          "$ref": "#/$defs/ArtifactDialect"
        }
      }
    },
    "CalibrationState": {
      "type": "object",
      "title": "CalibrationState",
      "additionalProperties": false,
      "required": [
        "cameras",
        "rig"
      ],
      "properties": {
        "cameras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CameraCalibration"
          }
        },
        "rig": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RigExtrinsic"
          }
        }
      }
    },
    "CameraCalibration": {
      "type": "object",
      "title": "CameraCalibration",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "model",
        "fx",
        "fy",
        "cx",
        "cy",
        "skew",
        "distortion",
        "rmsReprojectionPx",
        "locked"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "fx": {
          "type": "number",
          "format": "double"
        },
        "fy": {
          "type": "number",
          "format": "double"
        },
        "cx": {
          "type": "number",
          "format": "double"
        },
        "cy": {
          "type": "number",
          "format": "double"
        },
        "skew": {
          "type": "number",
          "format": "double"
        },
        "distortion": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "rmsReprojectionPx": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "CameraPosePreview": {
      "type": "object",
      "title": "CameraPosePreview",
      "additionalProperties": false,
      "required": [
        "cameraId",
        "rotationWxyz",
        "translation"
      ],
      "properties": {
        "cameraId": {
          "type": "string"
        },
        "rotationWxyz": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "translation": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "CameraTrajectory": {
      "type": "object",
      "title": "CameraTrajectory",
      "additionalProperties": false,
      "required": [
        "poses"
      ],
      "properties": {
        "poses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CameraPosePreview"
          }
        }
      }
    },
    "DenseCloud": {
      "type": "object",
      "title": "DenseCloud",
      "additionalProperties": false,
      "required": [
        "positions",
        "colors",
        "confidence",
        "classification"
      ],
      "properties": {
        "positions": {
          "type": "string",
          "format": "base64",
          "description": "base64 of little-endian f32 lanes (semio_s_plugin_remodel PackedF32)"
        },
        "colors": {
          "type": [
            "string",
            "null"
          ],
          "format": "base64",
          "description": "base64 of raw u8 lanes (semio_s_plugin_remodel PackedU8)"
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ],
          "format": "base64",
          "description": "base64 of little-endian f32 lanes (semio_s_plugin_remodel PackedF32)"
        },
        "classification": {
          "type": [
            "string",
            "null"
          ],
          "format": "base64",
          "description": "base64 of raw u8 lanes (semio_s_plugin_remodel PackedU8)"
        }
      }
    },
    "DenseParams": {
      "type": "object",
      "title": "DenseParams",
      "additionalProperties": false,
      "required": [
        "resolution",
        "windowRadiusPx",
        "minViewConsistency",
        "confidenceThreshold",
        "maxPoints"
      ],
      "properties": {
        "resolution": {
          "$ref": "#/$defs/DenseResolution"
        },
        "windowRadiusPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minViewConsistency": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "confidenceThreshold": {
          "type": "number",
          "format": "float"
        },
        "maxPoints": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "DenseResolution": {
      "type": "string",
      "title": "DenseResolution",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "FeatureDetector": {
      "type": "string",
      "title": "FeatureDetector",
      "enum": [
        "orb",
        "akaze",
        "harris"
      ]
    },
    "FeatureParams": {
      "type": "object",
      "title": "FeatureParams",
      "additionalProperties": false,
      "required": [
        "detector",
        "targetCount",
        "octaves",
        "edgeThreshold"
      ],
      "properties": {
        "detector": {
          "$ref": "#/$defs/FeatureDetector"
        },
        "targetCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "octaves": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "edgeThreshold": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "FrameRef": {
      "type": "object",
      "title": "FrameRef",
      "additionalProperties": false,
      "required": [
        "index",
        "timestampMs",
        "assetId"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "timestampMs": {
          "type": "number",
          "format": "double"
        },
        "assetId": {
          "type": "string"
        }
      }
    },
    "GcpObservation": {
      "type": "object",
      "title": "GcpObservation",
      "additionalProperties": false,
      "required": [
        "streamId",
        "frameIndex",
        "pixel"
      ],
      "properties": {
        "streamId": {
          "type": "string"
        },
        "frameIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pixel": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "GeoParams": {
      "type": "object",
      "title": "GeoParams",
      "additionalProperties": false,
      "required": [
        "enabled",
        "originLon",
        "originLat",
        "originAlt",
        "gsdM",
        "dsmCellM",
        "dtmFilterRadiusM",
        "orthoMaxPx"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "originLon": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "originLat": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "originAlt": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "gsdM": {
          "type": "number",
          "format": "float"
        },
        "dsmCellM": {
          "type": "number",
          "format": "float"
        },
        "dtmFilterRadiusM": {
          "type": "number",
          "format": "float"
        },
        "orthoMaxPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "GeoProducts": {
      "type": "object",
      "title": "GeoProducts",
      "additionalProperties": false,
      "required": [
        "dsmAssetId",
        "dtmAssetId",
        "orthoAssetId"
      ],
      "properties": {
        "dsmAssetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "dtmAssetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "orthoAssetId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GroundControlPoint": {
      "type": "object",
      "title": "GroundControlPoint",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "worldPosition",
        "observations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "worldPosition": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GcpObservation"
          }
        }
      }
    },
    "IngestParams": {
      "type": "object",
      "title": "IngestParams",
      "additionalProperties": false,
      "required": [
        "frameSampleStride",
        "maxFrames",
        "downscaleLongEdgePx",
        "minSharpness"
      ],
      "properties": {
        "frameSampleStride": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxFrames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "downscaleLongEdgePx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minSharpness": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "MatchParams": {
      "type": "object",
      "title": "MatchParams",
      "additionalProperties": false,
      "required": [
        "matcher",
        "ratioTest",
        "crossCheck",
        "sequentialWindow",
        "maxPairsPerFrame",
        "loopClosure"
      ],
      "properties": {
        "matcher": {
          "$ref": "#/$defs/MatcherKind"
        },
        "ratioTest": {
          "type": "number",
          "format": "float"
        },
        "crossCheck": {
          "type": "boolean"
        },
        "sequentialWindow": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxPairsPerFrame": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "loopClosure": {
          "type": "boolean"
        }
      }
    },
    "MatcherKind": {
      "type": "string",
      "title": "MatcherKind",
      "enum": [
        "brute-force",
        "kd-tree"
      ]
    },
    "MediaKind": {
      "type": "string",
      "title": "MediaKind",
      "enum": [
        "image-sequence",
        "video"
      ]
    },
    "MediaStream": {
      "type": "object",
      "title": "MediaStream",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "cameraId",
        "syncOffsetMs",
        "fpsHint",
        "frames",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "cameraId": {
          "type": [
            "string",
            "null"
          ]
        },
        "syncOffsetMs": {
          "type": "number",
          "format": "double"
        },
        "fpsHint": {
          "type": "number",
          "format": "double"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameRef"
          }
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoSource"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MeshParams": {
      "type": "object",
      "title": "MeshParams",
      "additionalProperties": false,
      "required": [
        "tsdfVoxelSizeMm",
        "tsdfTruncationMm",
        "decimateTargetTriangles",
        "smoothingIterations",
        "textureEnabled",
        "textureSize",
        "guaranteeWatertight",
        "holeFillMaxBoundaryVerts",
        "selfIntersectionCheck"
      ],
      "properties": {
        "tsdfVoxelSizeMm": {
          "type": "number",
          "format": "float"
        },
        "tsdfTruncationMm": {
          "type": "number",
          "format": "float"
        },
        "decimateTargetTriangles": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "smoothingIterations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "textureEnabled": {
          "type": "boolean"
        },
        "textureSize": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "guaranteeWatertight": {
          "type": "boolean"
        },
        "holeFillMaxBoundaryVerts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "selfIntersectionCheck": {
          "type": "boolean"
        }
      }
    },
    "MeshSource": {
      "type": "string",
      "title": "MeshSource",
      "enum": [
        "placeholder",
        "reconstructed",
        "imported"
      ]
    },
    "MotionParams": {
      "type": "object",
      "title": "MotionParams",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxTracks",
        "trackWindowPx",
        "minTrackQuality",
        "minTrackLengthFrames"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxTracks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "trackWindowPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minTrackQuality": {
          "type": "number",
          "format": "float"
        },
        "minTrackLengthFrames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "MotionTrackSummary": {
      "type": "object",
      "title": "MotionTrackSummary",
      "additionalProperties": false,
      "required": [
        "id",
        "length",
        "class",
        "meanSpeedMS"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "class": {
          "$ref": "#/$defs/TrackClass"
        },
        "meanSpeedMS": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "QcReportSnapshot": {
      "type": "object",
      "title": "QcReportSnapshot",
      "additionalProperties": false,
      "required": [
        "reprojectionRmsPx",
        "gcpCheckpointRmse",
        "watertight",
        "meanTrackLength",
        "registeredFrameRatio",
        "denseCoverageRatio",
        "warnings"
      ],
      "properties": {
        "reprojectionRmsPx": {
          "type": "number",
          "format": "double"
        },
        "gcpCheckpointRmse": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "watertight": {
          "anyOf": [
            {
              "$ref": "#/$defs/WatertightReportSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "meanTrackLength": {
          "type": "number",
          "format": "float"
        },
        "registeredFrameRatio": {
          "type": "number",
          "format": "float"
        },
        "denseCoverageRatio": {
          "type": "number",
          "format": "float"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ReconstructionJob": {
      "type": "object",
      "title": "ReconstructionJob",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "progress01",
        "cancelRequested",
        "stageCursor",
        "startedAtMs",
        "error",
        "cameraPosesPreview",
        "sparsePointCloudPreview"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/ReconstructionStage"
        },
        "progress01": {
          "type": "number",
          "format": "float"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "stageCursor": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startedAtMs": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "cameraPosesPreview": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CameraPosePreview"
          }
        },
        "sparsePointCloudPreview": {
          "type": "string",
          "format": "base64",
          "description": "base64 of little-endian f32 lanes (semio_s_plugin_remodel PackedF32)"
        }
      }
    },
    "ReconstructionParams": {
      "type": "object",
      "title": "ReconstructionParams",
      "additionalProperties": false,
      "required": [
        "ingest",
        "feature",
        "matching",
        "sfm",
        "dense",
        "mesh",
        "motion",
        "geo"
      ],
      "properties": {
        "ingest": {
          "$ref": "#/$defs/IngestParams"
        },
        "feature": {
          "$ref": "#/$defs/FeatureParams"
        },
        "matching": {
          "$ref": "#/$defs/MatchParams"
        },
        "sfm": {
          "$ref": "#/$defs/SfmParams"
        },
        "dense": {
          "$ref": "#/$defs/DenseParams"
        },
        "mesh": {
          "$ref": "#/$defs/MeshParams"
        },
        "motion": {
          "$ref": "#/$defs/MotionParams"
        },
        "geo": {
          "$ref": "#/$defs/GeoParams"
        }
      }
    },
    "ReconstructionResults": {
      "type": "object",
      "title": "ReconstructionResults",
      "additionalProperties": false,
      "required": [
        "sparse",
        "dense",
        "mesh",
        "trajectory",
        "tracks",
        "geo",
        "qc"
      ],
      "properties": {
        "sparse": {
          "anyOf": [
            {
              "$ref": "#/$defs/SparseCloud"
            },
            {
              "type": "null"
            }
          ]
        },
        "dense": {
          "anyOf": [
            {
              "$ref": "#/$defs/DenseCloud"
            },
            {
              "type": "null"
            }
          ]
        },
        "mesh": {
          "$ref": "#/$defs/RemodelingMesh"
        },
        "trajectory": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraTrajectory"
            },
            {
              "type": "null"
            }
          ]
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MotionTrackSummary"
          }
        },
        "geo": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoProducts"
            },
            {
              "type": "null"
            }
          ]
        },
        "qc": {
          "anyOf": [
            {
              "$ref": "#/$defs/QcReportSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReconstructionStage": {
      "type": "string",
      "title": "ReconstructionStage",
      "enum": [
        "idle",
        "ingesting",
        "calibrating",
        "extracting-features",
        "matching-features",
        "estimating-poses",
        "bundle-adjusting",
        "georeferencing",
        "dense-stereo",
        "fusing-volume",
        "extracting-surface",
        "cleaning-mesh",
        "texturing",
        "tracking-motion",
        "deriving-geo-products",
        "reporting-qc",
        "done",
        "failed"
      ]
    },
    "RemodelingAssetChild": {
      "type": "object",
      "title": "RemodelingAssetChild",
