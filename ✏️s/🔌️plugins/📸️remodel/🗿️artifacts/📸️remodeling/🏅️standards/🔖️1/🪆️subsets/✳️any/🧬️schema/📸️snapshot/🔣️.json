{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/snapshot.json",
  "title": "RemodelingSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "streams",
    "assets",
    "durableArtifacts",
    "calibration",
    "params",
    "gcps",
    "job",
    "results"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/MediaStream"
      },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/RemodelingAssetChild"
      },
      "x-semio-state": "artifact"
    },
    "durableArtifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/RemodelingDurableArtifact"
      },
      "x-semio-state": "artifact"
    },
    "calibration": {
      "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/CalibrationState",
      "x-semio-state": "artifact"
    },
    "params": {
      "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/ReconstructionParams",
      "x-semio-state": "artifact"
    },
    "gcps": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/GroundControlPoint"
      },
      "x-semio-state": "artifact"
    },
    "job": {
      "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/ReconstructionJob",
      "x-semio-state": "artifact"
    },
    "results": {
      "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/ReconstructionResults",
      "x-semio-state": "artifact"
    }
  }
}
