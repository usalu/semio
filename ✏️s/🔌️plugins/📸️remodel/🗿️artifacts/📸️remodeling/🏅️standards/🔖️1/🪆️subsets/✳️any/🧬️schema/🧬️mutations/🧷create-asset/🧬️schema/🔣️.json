{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/1/any/mutation/create-asset.json",
  "title": "CreateAsset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset",
    "key"
  ],
  "properties": {
    "key": {
      "type": "string"
    },
    "asset": {
      "type": "object",
      "title": "ImageAsset",
      "additionalProperties": false,
      "required": [
        "mime",
        "data",
        "width",
        "height"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    }
  }
}
