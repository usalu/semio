}
calibration {
  cameras [id:TEXT label:TEXT model:TEXT fx:NUM fy:NUM cx:NUM cy:NUM skew:NUM distortion:TUPLE rms-reprojection-px:NUM locked:BOOL] {
    synthetic-cam "Synthetic Orbit Camera" brownConrady 272 272 160 120 0 -0.019999999552965164,0.004999999888241291,0,0,0 0.5 true
  }
