{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/update-mesh-params/schema.json",
  "title": "UpdateMeshParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "params"
  ],
  "properties": {
    "mutation": {
      "const": "updateMeshParams"
    },
    "params": {
      "type": "object",
      "title": "MeshParams",
      "additionalProperties": false,
      "required": [
        "tsdfVoxelSizeMm",
        "tsdfTruncationMm",
        "decimateTargetTriangles",
        "smoothingIterations",
        "textureEnabled",
        "textureSize",
        "guaranteeWatertight",
        "holeFillMaxBoundaryVerts",
        "selfIntersectionCheck"
      ],
      "properties": {
        "tsdfVoxelSizeMm": {
          "type": "number",
          "format": "float",
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "TSDF Voxel Size (mm)",
              "de": "TSDF-Voxelgröße (mm)"
            },
            "unit": "mm",
            "step": 0.5,
            "precision": 1,
            "softMin": 1,
            "softMax": 20,
            "group": "parameters",
            "order": 10
          }
        },
        "tsdfTruncationMm": {
          "type": "number",
          "format": "float",
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "TSDF Truncation (mm)",
              "de": "TSDF-Kappungsabstand (mm)"
            },
            "unit": "mm",
            "step": 0.5,
            "precision": 1,
            "softMin": 2,
            "softMax": 60,
            "group": "parameters",
            "order": 20
          }
        },
        "decimateTargetTriangles": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Target Triangles (Decimation)",
              "de": "Ziel-Dreiecke (Dezimierung)"
            },
            "step": 1000,
            "precision": 0,
            "group": "parameters",
            "order": 30
          }
        },
        "smoothingIterations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Smoothing Iterations",
              "de": "Glättungsiterationen"
            },
            "step": 1,
            "precision": 0,
            "group": "parameters",
            "order": 40
          }
        },
        "textureEnabled": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Texture Enabled",
              "de": "Textur aktiviert"
            },
            "group": "parameters",
            "order": 50
          }
        },
        "textureSize": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Texture Size (px)",
              "de": "Texturgröße (px)"
            },
            "unit": "px",
            "step": 1024,
            "precision": 0,
            "snaps": [
              1024,
              2048,
              4096
            ],
            "group": "parameters",
            "order": 60
          }
        },
        "guaranteeWatertight": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Guarantee Watertight",
              "de": "Wasserdichtheit garantieren"
            },
            "group": "parameters",
            "order": 70
          }
        },
        "holeFillMaxBoundaryVerts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Hole Fill Max. Boundary Vertices",
              "de": "Max. Randpunkte für Lochfüllung"
            },
            "step": 1,
            "precision": 0,
            "group": "parameters",
            "order": 80
          }
        },
        "selfIntersectionCheck": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Self-Intersection Check",
              "de": "Selbstüberschneidungsprüfung"
            },
            "group": "parameters",
            "order": 90
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Meshing Parameters",
          "de": "Vermaschungsparameter"
        },
        "group": "parameters",
        "order": 10
      }
    }
  }
}
