{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/window/remodel/remodeling/frames/config/schema.json",
  "title": "RemodelingFramesWindowConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["frameCursor"],
  "properties": {
    "frameCursor": { "$ref": "#/$defs/RemodelingFrameCursor", "x-semio-state": "config" }
  },
  "$defs": {
    "RemodelingFrameCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameIndex"],
      "properties": {
        "streamId": { "type": ["string", "null"], "x-semio-state": "config" },
        "frameIndex": { "type": "integer", "minimum": 0, "maximum": 4294967295, "x-semio-state": "config" }
      },
      "x-semio-state": "config"
    }
  }
}
