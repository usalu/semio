{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/replace-mesh-result/schema.json",
  "title": "ReplaceMeshResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "mesh"
  ],
  "properties": {
    "mutation": {
      "const": "replaceMeshResult"
    },
    "mesh": {
      "type": "object",
      "title": "RemodelingMesh",
      "additionalProperties": false,
      "required": [
        "mesh",
        "source",
        "textureAssetId",
        "watertight"
      ],
      "properties": {
        "mesh": {
          "type": "object",
          "title": "RemodelingMeshChild",
          "description": "store::ArtifactChild<SemioMeshSnapshot> — an owned child handle; only childId and target cross the wire.",
          "additionalProperties": false,
          "required": [
            "childId",
            "target"
          ],
          "properties": {
            "childId": {
              "type": "string",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Child ID",
                  "de": "Kind-ID"
                },
                "description": {
                  "en": "Handle of the composed stdio mesh artifact.",
                  "de": "Verweis auf das eingebettete stdio-Mesh-Artefakt."
                },
                "group": "result",
                "order": 10
              }
            },
            "target": {
              "type": "object",
              "title": "ArtifactRef",
              "additionalProperties": false,
              "required": [
                "artifactId",
                "dialect"
              ],
              "properties": {
                "artifactId": {
                  "type": "string",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Artifact ID",
                      "de": "Artefakt-ID"
                    },
                    "group": "result",
                    "order": 10
                  }
                },
                "dialect": {
                  "type": "object",
                  "title": "ArtifactDialect",
                  "additionalProperties": false,
                  "required": [
                    "artifactKind",
                    "standard",
                    "subset"
                  ],
                  "properties": {
                    "artifactKind": {
                      "type": "string",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Artifact Kind",
                          "de": "Artefaktart"
                        },
                        "group": "result",
                        "order": 10
                      }
                    },
                    "standard": {
                      "type": "string",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Standard",
                          "de": "Standard"
                        },
                        "group": "result",
                        "order": 20
                      }
                    },
                    "subset": {
                      "type": "string",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Subset",
                          "de": "Teilmenge"
                        },
                        "group": "result",
                        "order": 30
                      }
                    }
                  },
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Dialect",
                      "de": "Dialekt"
                    },
                    "group": "result",
                    "order": 20
                  }
                }
              },
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Target Artifact",
                  "de": "Zielartefakt"
                },
                "description": {
                  "en": "Handle of the composed stdio mesh artifact.",
                  "de": "Verweis auf das eingebettete stdio-Mesh-Artefakt."
                },
                "group": "result",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "widget": "hidden",
            "role": "value",
            "label": {
              "en": "Mesh Artifact",
              "de": "Mesh-Artefakt"
            },
            "description": {
              "en": "Handle of the composed stdio mesh artifact.",
              "de": "Verweis auf das eingebettete stdio-Mesh-Artefakt."
            },
            "group": "result",
            "order": 10
          }
        },
        "source": {
          "type": "string",
          "title": "MeshSource",
          "enum": [
            "placeholder",
            "reconstructed",
            "imported"
          ],
          "x-semio-ui": {
            "widget": "segmented",
            "role": "value",
            "label": {
              "en": "Mesh Source",
              "de": "Mesh-Herkunft"
            },
            "options": {
              "placeholder": {
                "en": "Placeholder",
                "de": "Platzhalter"
              },
              "reconstructed": {
                "en": "Reconstructed",
                "de": "Rekonstruiert"
              },
              "imported": {
                "en": "Imported",
                "de": "Importiert"
              }
            },
            "group": "result",
            "order": 20
          }
        },
        "textureAssetId": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Texture Asset",
              "de": "Textur-Asset"
            },
            "description": {
              "en": "Texture image of the mesh; empty when untextured.",
              "de": "Texturbild des Mesh; leer, wenn untexturiert."
            },
            "ref": {
              "kind": "asset",
              "domain": "assets",
              "granularity": "asset"
            },
            "group": "result",
            "order": 30
          }
        },
        "watertight": {
          "anyOf": [
            {
              "type": "object",
              "title": "WatertightReportSnapshot",
              "additionalProperties": false,
              "required": [
                "vertexCount",
                "triangleCount",
                "boundaryEdgeCount",
                "boundaryLoopCount",
                "nonManifoldEdgeCount",
                "nonManifoldVertexCount",
                "connectedComponents",
                "consistentlyOriented",
                "eulerCharacteristic",
                "genus",
                "signedVolume",
                "selfIntersectionPairs",
                "closedFallbackUsed",
                "isClosed",
                "isTwoManifold",
                "isWatertight"
              ],
              "properties": {
                "vertexCount": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Vertex Count",
                      "de": "Anzahl der Eckpunkte"
                    },
                    "group": "report",
                    "order": 10
                  }
                },
                "triangleCount": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Triangle Count",
                      "de": "Anzahl der Dreiecke"
                    },
                    "group": "report",
                    "order": 20
                  }
                },
                "boundaryEdgeCount": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Boundary Edges",
                      "de": "Randkanten"
                    },
                    "group": "report",
                    "order": 30
                  }
                },
                "boundaryLoopCount": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Boundary Loops",
                      "de": "Randschleifen"
                    },
                    "group": "report",
                    "order": 40
                  }
                },
                "nonManifoldEdgeCount": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Non-Manifold Edges",
                      "de": "Nicht-mannigfaltige Kanten"
                    },
                    "group": "report",
                    "order": 50
                  }
                },
                "nonManifoldVertexCount": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Non-Manifold Vertices",
                      "de": "Nicht-mannigfaltige Eckpunkte"
                    },
                    "group": "report",
                    "order": 60
                  }
                },
                "connectedComponents": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Connected Components",
                      "de": "Zusammenhangskomponenten"
                    },
                    "group": "report",
                    "order": 70
                  }
                },
                "consistentlyOriented": {
                  "type": "boolean",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Consistently Oriented",
                      "de": "Konsistent orientiert"
                    },
                    "group": "report",
                    "order": 80
                  }
                },
                "eulerCharacteristic": {
                  "type": "integer",
                  "format": "int64",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Euler Characteristic",
                      "de": "Euler-Charakteristik"
                    },
                    "group": "report",
                    "order": 90
                  }
                },
                "genus": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "int64",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Genus",
                      "de": "Geschlecht"
                    },
                    "description": {
                      "en": "Topological genus of a closed 2-manifold.",
                      "de": "Topologisches Geschlecht einer geschlossenen 2-Mannigfaltigkeit."
                    },
                    "group": "report",
                    "order": 100
                  }
                },
                "signedVolume": {
                  "type": "number",
                  "format": "double",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Signed Volume",
                      "de": "Vorzeichenbehaftetes Volumen"
                    },
                    "group": "report",
                    "order": 110
                  }
                },
                "selfIntersectionPairs": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Self-Intersection Pairs",
                      "de": "Selbstüberschneidungspaare"
                    },
                    "group": "report",
                    "order": 120
                  }
                },
                "closedFallbackUsed": {
                  "type": "boolean",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Closing Fallback Used",
                      "de": "Schließ-Rückfall verwendet"
                    },
                    "group": "report",
                    "order": 130
                  }
                },
                "isClosed": {
                  "type": "boolean",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Closed",
                      "de": "Geschlossen"
                    },
                    "group": "report",
                    "order": 140
                  }
                },
                "isTwoManifold": {
                  "type": "boolean",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "2-Manifold",
                      "de": "2-Mannigfaltig"
                    },
                    "group": "report",
                    "order": 150
                  }
                },
                "isWatertight": {
                  "type": "boolean",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Watertight",
                      "de": "Wasserdicht"
                    },
                    "group": "report",
                    "order": 160
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Watertightness Report",
              "de": "Wasserdichtheitsbericht"
            },
            "description": {
              "en": "Derived from the mesh by the reconstruction; not edited by hand.",
              "de": "Von der Rekonstruktion aus dem Mesh abgeleitet; wird nicht von Hand bearbeitet."
            },
            "group": "report",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Mesh Result",
          "de": "Mesh-Ergebnis"
        },
        "description": {
          "en": "The complete mesh result; replaces the stored one.",
          "de": "Vollständiges Mesh-Ergebnis; ersetzt das gespeicherte."
        },
        "group": "result",
        "order": 10
      }
    }
  }
}
