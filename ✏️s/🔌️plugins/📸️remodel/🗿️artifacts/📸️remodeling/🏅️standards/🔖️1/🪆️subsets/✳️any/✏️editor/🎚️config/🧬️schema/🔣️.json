{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/remodel/remodeling/config/schema.json",
  "title": "RemodelingConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera",
    "layers",
    "frameCursor",
    "reportTable"
  ],
  "properties": {
    "camera": {
      "$ref": "#/$defs/RemodelingWorldCamera",
      "x-semio-state": "config"
    },
    "layers": {
      "$ref": "#/$defs/RemodelingLayerVisibility",
      "x-semio-state": "config"
    },
    "frameCursor": {
      "$ref": "#/$defs/RemodelingFrameCursor",
      "x-semio-state": "config"
    },
    "reportTable": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "RemodelingWorldCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "fov"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-state": "config"
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-state": "config"
        },
        "fov": {
          "type": "number",
          "x-semio-state": "config"
        }
      },
      "x-semio-state": "config"
    },
    "RemodelingLayerVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mesh",
        "dense",
        "sparse",
        "cameras",
        "gcps"
      ],
      "properties": {
        "mesh": {
          "type": "boolean",
          "x-semio-state": "config"
        },
        "dense": {
          "type": "boolean",
          "x-semio-state": "config"
        },
        "sparse": {
          "type": "boolean",
          "x-semio-state": "config"
        },
        "cameras": {
          "type": "boolean",
          "x-semio-state": "config"
        },
        "gcps": {
          "type": "boolean",
          "x-semio-state": "config"
        }
      },
      "x-semio-state": "config"
    },
    "RemodelingFrameCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameIndex"
      ],
      "properties": {
        "streamId": {
          "type": "string",
          "x-semio-state": "config"
        },
        "frameIndex": {
          "type": "integer",
          "minimum": 0,
          "x-semio-state": "config"
        }
      },
      "x-semio-state": "config"
    }
  }
}
