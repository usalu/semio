// 🅰️ ANTLR4 mirror of the normative 📖️.grammar.semio in this directory — generated by
// 🐍️grammar-sidecars.py in the REMODEL-PLUGIN-END-TO-END ticket; same production names,
// kebab-case -> camelCase. Start rule: inference.
grammar Remodeling_remodeling_inference;

inference: '{' inferenceLane* '}' ;
inferenceLane: boundsLane | relativeCameraPosesLane ;
boundsLane: 'bounds' '=' boundsObject ;
relativeCameraPosesLane: 'relativeCameraPoses' '=' poseMap ;
boundsObject: '{' boundsField* '}' ;
boundsField: 'boundingBox' '=' boundingBox | 'vertexCount' '=' number | 'faceCount' '=' number ;
boundingBox: '{' boxField* '}' ;
boxField: 'max' '=' triple | 'min' '=' triple ;
triple: '[' number number number ']' ;
poseMap: '{' poseEntry* '}' ;
poseEntry: key '=' poseObject ;
poseObject: '{' poseField* '}' ;
poseField: 'rotationAngleRad' '=' number | 'translationDelta' '=' triple ;
number: INT | FLOAT ;
key: IDENT | TEXT ;

// 📐 Framework dialect-primitive terminals (only named, never defined, by the .semio itself).
BOOL: 'true' | 'false' ;
FLOAT: '-'? [0-9]+ '.' [0-9]+ ([eE] [+-]? [0-9]+)? ;
INT: '-'? [0-9]+ ;
IDENT: [A-Za-z_] [A-Za-z0-9_\-./]* ;
PLACEHOLDER: '_' ;
TEXT: '"' (~["\\] | '\\' .)* '"' ;
WS: [ \t\r\n]+ -> skip ;
