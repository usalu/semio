{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "cases"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "base",
          "rows"
        ],
        "oneOf": [
          {
            "required": [
              "expected"
            ],
            "properties": {
              "expected": {},
              "refused": false
            }
          },
          {
            "required": [
              "refused"
            ],
            "properties": {
              "refused": {},
              "expected": false
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "value"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            }
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "row",
                    "entity"
                  ],
                  "properties": {
                    "row": {
                      "enum": [
                        "insert",
                        "replace"
                      ]
                    },
                    "entity": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "value"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "value": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "row",
                    "key"
                  ],
                  "properties": {
                    "row": {
                      "enum": [
                        "remove",
                        "patch"
                      ]
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "value"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            }
          },
          "refused": {
            "enum": [
              "duplicate-id",
              "missing-target"
            ]
          }
        }
      }
    }
  }
}
