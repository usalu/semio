; abnf remodeling.remodeling.inference — value-bridge record body (no dedicated codec: RemodelingInference has no DslRecord derive)
body         = symbol-count *symbol fields
symbol-count = varint
symbol       = varint *OCTET               ; length-prefixed UTF-8 symbol-table entry
fields       = *OCTET                      ; self-describing per-field-id tag stream
varint       = *(%x80-FF) %x00-7F
