{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/window/remodel/remodeling/model/config/schema.json",
  "title": "RemodelingModelWindowConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["camera", "layers"],
  "properties": {
    "camera": { "$ref": "https://semio.tech/schema/framework/ui/viewport/3d", "x-semio-state": "config" },
    "layers": { "$ref": "#/$defs/RemodelingLayerVisibility", "x-semio-state": "config" }
  },
  "$defs": {
    "RemodelingLayerVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mesh", "dense", "sparse", "cameras", "gcps"],
      "properties": {
        "mesh": { "type": "boolean", "x-semio-state": "config" },
        "dense": { "type": "boolean", "x-semio-state": "config" },
        "sparse": { "type": "boolean", "x-semio-state": "config" },
        "cameras": { "type": "boolean", "x-semio-state": "config" },
        "gcps": { "type": "boolean", "x-semio-state": "config" }
      },
      "x-semio-state": "config"
    }
  }
}
