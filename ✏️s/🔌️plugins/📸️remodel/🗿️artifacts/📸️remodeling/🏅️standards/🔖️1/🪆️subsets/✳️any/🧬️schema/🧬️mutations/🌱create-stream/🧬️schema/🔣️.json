{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/create-stream/schema.json",
  "title": "CreateStream",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "stream"
  ],
  "properties": {
    "mutation": {
      "const": "createStream"
    },
    "stream": {
      "type": "object",
      "title": "MediaStream",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "cameraId",
        "syncOffsetMs",
        "fpsHint",
        "frames",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Stream ID",
              "de": "Stream-ID"
            },
            "description": {
              "en": "Unique ID of the new stream.",
              "de": "Eindeutige ID des neuen Streams."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Bezeichnung"
            },
            "group": "identity",
            "order": 20
          }
        },
        "kind": {
          "type": "string",
          "title": "MediaKind",
          "enum": [
            "image-sequence",
            "video"
          ],
          "x-semio-ui": {
            "widget": "segmented",
            "role": "value",
            "label": {
              "en": "Stream Kind",
              "de": "Streamart"
            },
            "options": {
              "image-sequence": {
                "en": "Image Sequence",
                "de": "Bildsequenz"
              },
              "video": {
                "en": "Video",
                "de": "Video"
              }
            },
            "group": "media",
            "order": 30
          }
        },
        "cameraId": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Camera",
              "de": "Kamera"
            },
            "description": {
              "en": "Camera that captured the stream; empty when unbound.",
              "de": "Kamera, die den Stream aufgenommen hat; leer, wenn nicht zugeordnet."
            },
            "ref": {
              "kind": "camera"
            },
            "group": "media",
            "order": 40
          }
        },
        "syncOffsetMs": {
          "type": "number",
          "format": "double",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Sync Offset (ms)",
              "de": "Synchronisationsversatz (ms)"
            },
            "description": {
              "en": "Time shift that aligns this stream with the other streams.",
              "de": "Zeitversatz, der diesen Stream mit den anderen Streams synchronisiert."
            },
            "unit": "ms",
            "step": 1,
            "precision": 1,
            "group": "timing",
            "order": 50
          }
        },
        "fpsHint": {
          "type": "number",
          "format": "double",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Frame Rate Hint (fps)",
              "de": "Bildrate als Hinweis (fps)"
            },
            "unit": "fps",
            "step": 1,
            "precision": 2,
            "group": "timing",
            "order": 60
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "FrameRef",
            "additionalProperties": false,
            "required": [
              "index",
              "timestampMs",
              "assetId"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0,
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Frame Index",
                    "de": "Bildindex"
                  },
                  "step": 1,
                  "precision": 0,
                  "group": "media",
                  "order": 10
                }
              },
              "timestampMs": {
                "type": "number",
                "format": "double",
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Timestamp (ms)",
                    "de": "Zeitstempel (ms)"
                  },
                  "description": {
                    "en": "Media time of the frame.",
                    "de": "Medienzeit des Bildes."
                  },
                  "unit": "ms",
                  "step": 1,
                  "precision": 1,
                  "group": "timing",
                  "order": 20
                }
              },
              "assetId": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "reference",
                  "role": "target",
                  "label": {
                    "en": "Image Asset",
                    "de": "Bild-Asset"
                  },
                  "description": {
                    "en": "The embedded image of this frame.",
                    "de": "Das eingebettete Bild dieses Bildes."
                  },
                  "ref": {
                    "kind": "asset",
                    "domain": "assets",
                    "granularity": "asset"
                  },
                  "group": "media",
                  "order": 30
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Frames",
              "de": "Bilder"
            },
            "group": "media",
            "order": 70
          }
        },
        "source": {
          "anyOf": [
            {
              "type": "object",
              "title": "VideoSource",
              "additionalProperties": false,
              "required": [
                "name",
                "container",
                "codec",
                "durationMs",
                "frameCount",
                "width",
                "height"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "x-semio-ui": {
                    "widget": "text",
                    "role": "value",
                    "label": {
                      "en": "File Name",
                      "de": "Dateiname"
                    },
                    "group": "media",
                    "order": 10
                  }
                },
                "container": {
                  "type": "string",
                  "x-semio-ui": {
                    "widget": "text",
                    "role": "value",
                    "label": {
                      "en": "Container",
                      "de": "Container"
                    },
                    "description": {
                      "en": "e.g. MP4 or AVI.",
                      "de": "z. B. MP4 oder AVI."
                    },
                    "group": "media",
                    "order": 20
                  }
                },
                "codec": {
                  "type": "string",
                  "title": "VideoCodec",
                  "enum": [
                    "avc",
                    "hevc",
                    "vp9",
                    "av1",
                    "mjpeg",
                    "unknown"
                  ],
                  "x-semio-ui": {
                    "widget": "select",
                    "role": "value",
                    "label": {
                      "en": "Codec",
                      "de": "Codec"
                    },
                    "options": {
                      "avc": {
                        "en": "H.264/AVC",
                        "de": "H.264/AVC"
                      },
                      "hevc": {
                        "en": "H.265/HEVC",
                        "de": "H.265/HEVC"
                      },
                      "vp9": {
                        "en": "VP9",
                        "de": "VP9"
                      },
                      "av1": {
                        "en": "AV1",
                        "de": "AV1"
                      },
                      "mjpeg": {
                        "en": "Motion JPEG",
                        "de": "Motion JPEG"
                      },
                      "unknown": {
                        "en": "Unknown",
                        "de": "Unbekannt"
                      }
                    },
                    "group": "media",
                    "order": 30
                  }
                },
                "durationMs": {
                  "type": "number",
                  "format": "double",
                  "x-semio-ui": {
                    "widget": "stepper",
                    "role": "value",
                    "label": {
                      "en": "Duration (ms)",
                      "de": "Dauer (ms)"
                    },
                    "unit": "ms",
                    "step": 1,
                    "precision": 1,
                    "group": "timing",
                    "order": 40
                  }
                },
                "frameCount": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "stepper",
                    "role": "value",
                    "label": {
                      "en": "Frame Count",
                      "de": "Bildanzahl"
                    },
                    "step": 1,
                    "precision": 0,
                    "group": "media",
                    "order": 50
                  }
                },
                "width": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "stepper",
                    "role": "value",
                    "label": {
                      "en": "Width (px)",
                      "de": "Breite (px)"
                    },
                    "unit": "px",
                    "step": 1,
                    "precision": 0,
                    "group": "media",
                    "order": 60
                  }
                },
                "height": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0,
                  "x-semio-ui": {
                    "widget": "stepper",
                    "role": "value",
                    "label": {
                      "en": "Height (px)",
                      "de": "Höhe (px)"
                    },
                    "unit": "px",
                    "step": 1,
                    "precision": 0,
                    "group": "media",
                    "order": 70
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Video Source",
              "de": "Videoquelle"
            },
            "description": {
              "en": "Provenance of a stream imported from a video file; empty for image sequences.",
              "de": "Herkunft eines aus einer Videodatei importierten Streams; leer bei Bildsequenzen."
            },
            "group": "media",
            "order": 80
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Stream",
          "de": "Stream"
        },
        "description": {
          "en": "The new media stream with its frames.",
          "de": "Neuer Medienstream mit seinen Bildern."
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
