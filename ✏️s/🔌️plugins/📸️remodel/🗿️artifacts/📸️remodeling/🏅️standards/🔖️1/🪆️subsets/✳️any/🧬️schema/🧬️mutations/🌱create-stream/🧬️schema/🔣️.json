{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/mutation/create-stream/schema.json",
  "title": "CreateStream",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stream"
  ],
  "properties": {
    "stream": {
      "type": "object",
      "title": "MediaStream",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "cameraId",
        "syncOffsetMs",
        "fpsHint",
        "frames",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "title": "MediaKind",
          "enum": [
            "image-sequence",
            "video"
          ]
        },
        "cameraId": {
          "type": [
            "string",
            "null"
          ]
        },
        "syncOffsetMs": {
          "type": "number",
          "format": "double"
        },
        "fpsHint": {
          "type": "number",
          "format": "double"
        },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "FrameRef",
            "additionalProperties": false,
            "required": [
              "index",
              "timestampMs",
              "assetId"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "timestampMs": {
                "type": "number",
                "format": "double"
              },
              "assetId": {
                "type": "string"
              }
            }
          }
        },
        "source": {
          "anyOf": [
            {
              "type": "object",
              "title": "VideoSource",
              "additionalProperties": false,
              "required": [
                "name",
                "container",
                "codec",
                "durationMs",
                "frameCount",
                "width",
                "height"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "container": {
                  "type": "string"
                },
                "codec": {
                  "type": "string",
                  "title": "VideoCodec",
                  "enum": [
                    "avc",
                    "hevc",
                    "vp9",
                    "av1",
                    "mjpeg",
                    "unknown"
                  ]
                },
                "durationMs": {
                  "type": "number",
                  "format": "double"
                },
                "frameCount": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "width": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "height": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
