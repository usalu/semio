{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["port", "tool", "schema", "mimeType", "filename", "positions", "indices", "emptyMesh", "cancelAfterTurns", "denied"],
  "properties": {
    "port": { "const": "mesh:out" },
    "tool": { "const": "export-media:mesh:out" },
    "schema": { "const": "glb" },
    "mimeType": { "const": "model/gltf-binary" },
    "filename": { "const": "remodeling-mesh.glb" },
    "positions": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "number" } },
    "indices": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 0, "maximum": 2 } },
    "emptyMesh": { "const": "refused" },
    "cancelAfterTurns": { "const": [0, 1, 2] },
    "denied": { "const": ["items", "copyBytes", "depth"] }
  }
}
