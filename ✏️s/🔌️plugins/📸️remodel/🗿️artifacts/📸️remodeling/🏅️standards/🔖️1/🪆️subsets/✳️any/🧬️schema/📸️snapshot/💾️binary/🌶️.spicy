module Remodeling_snapshot;

# 📦️ The .spk document container `RemodelingSnapshot::encode_pack_with` writes inside the SEMIO
# envelope (os_pack::encode_document). Segment order: symbols(3), document(4)+, manifest(1), end(0).

public type Document = unit {
    magic:    bytes &size=8;
    header:   Header;
    segments: Segment[] &until($$.kind == 0);
    footer:   Footer;
};

type Header = unit {
    version_major:  uint16;
    version_minor:  uint16;
    required_flags: uint32;
    optional_flags: uint32;
    header_crc32:   uint32;
    reserved:       bytes &size=8;
};

type Segment = unit {
    kind:       uint8;
    flags:      uint8;
    stored_len: uint64 &convert=$$;
    raw_len:    uint64 if (self.flags & 1 != 0);
    payload:    bytes &size=self.stored_len;
    crc32:      uint32;
};

type Footer = unit {
    magic:              bytes &size=8;
    version_major:      uint16;
    version_minor:      uint16;
    required_flags:     uint32;
    manifest_offset:    uint64;
    manifest_len:       uint64;
    file_len:           uint64;
    content_hash:       bytes &size=32;
    prev_footer_offset: uint64;
    footer_crc32:       uint32;
};

# 🔤️ Decompressed symbols(3) payload (os_pack::format::encode_symbols).
type Symbols = unit {
    count:   uint64 &convert=$$;
    symbols: Symbol[self.count];
};

type Symbol = unit {
    len:  uint64 &convert=$$;
    text: bytes &size=self.len;
};

# 🧾️ Decompressed document(4) payloads concatenated: os_pack::encode_record_fields —
# `field_count varint, field_count*(field_id varint, tagged value)`, sorted by ascending field id,
# Absent fields omitted. RemodelingSnapshot::__dsl_spec() field ids (DslRecord assigns
# id = 0-based declaration index): 0 schema Text, 1 id Text, 2 streams Table, 3 assets Map,
# 4 durable-artifacts Map, 5 calibration Block, 6 params Block, 7 gcps Table, 8 job Block,
# 9 results Block. Tag 0x0D (record) nests this same unit.
type RecordFields = unit {
    field_count: uint64 &convert=$$;
    fields:      FieldEntry[self.field_count];
};

type FieldEntry = unit {
    field_id: uint64 &convert=$$;
    tag:      uint8;
    value:    bytes &eod;
};
