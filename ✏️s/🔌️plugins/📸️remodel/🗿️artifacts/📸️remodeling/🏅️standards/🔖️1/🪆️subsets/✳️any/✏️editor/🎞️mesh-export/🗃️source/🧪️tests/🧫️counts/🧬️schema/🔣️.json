{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "oneOf": [{ "required": ["value"] }, { "required": ["refused"] }],
        "properties": {
          "text": { "type": "string" },
          "value": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
          "refused": { "const": true }
        }
      }
    }
  }
}
