{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/1/any/mutation/replace-dense/schema.json",
  "title": "ReplaceDense",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dense"
  ],
  "properties": {
    "dense": {
      "anyOf": [
        {
          "type": "object",
          "title": "DenseCloud",
          "additionalProperties": false,
          "required": [
            "positions",
            "colors",
            "confidence",
            "classification"
          ],
          "properties": {
            "positions": {
              "type": "string",
              "format": "base64",
              "description": "base64 of little-endian f32 lanes (semio_s_plugin_remodel PackedF32)"
            },
            "colors": {
              "type": [
                "string",
                "null"
              ],
              "format": "base64",
              "description": "base64 of raw u8 lanes (semio_s_plugin_remodel PackedU8)"
            },
            "confidence": {
              "type": [
                "string",
                "null"
              ],
              "format": "base64",
              "description": "base64 of little-endian f32 lanes (semio_s_plugin_remodel PackedF32)"
            },
            "classification": {
              "type": [
                "string",
                "null"
              ],
              "format": "base64",
              "description": "base64 of raw u8 lanes (semio_s_plugin_remodel PackedU8)"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
