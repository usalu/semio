{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/replace-dense/schema.json",
  "title": "ReplaceDense",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "dense"
  ],
  "properties": {
    "mutation": {
      "const": "replaceDense"
    },
    "dense": {
      "anyOf": [
        {
          "type": "object",
          "title": "DenseCloud",
          "additionalProperties": false,
          "required": [
            "positions",
            "colors",
            "confidence",
            "classification"
          ],
          "properties": {
            "positions": {
              "type": "string",
              "format": "base64",
              "description": "base64 of little-endian f32 lanes (semio_hub_remodel PackedF32)",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Positions",
                  "de": "Positionen"
                },
                "description": {
                  "en": "Packed float32 xyz triples (base64).",
                  "de": "Gepackte float32-xyz-Tripel (Base64)."
                },
                "group": "result",
                "order": 10
              }
            },
            "colors": {
              "type": [
                "string",
                "null"
              ],
              "format": "base64",
              "description": "base64 of raw u8 lanes (semio_hub_remodel PackedU8)",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Colours",
                  "de": "Farben"
                },
                "description": {
                  "en": "Packed 8-bit RGB triples (base64).",
                  "de": "Gepackte 8-Bit-RGB-Tripel (Base64)."
                },
                "group": "result",
                "order": 20
              }
            },
            "confidence": {
              "type": [
                "string",
                "null"
              ],
              "format": "base64",
              "description": "base64 of little-endian f32 lanes (semio_hub_remodel PackedF32)",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Confidence",
                  "de": "Konfidenz"
                },
                "description": {
                  "en": "Packed float32 confidence per point (base64).",
                  "de": "Gepackte float32-Konfidenz je Punkt (Base64)."
                },
                "group": "result",
                "order": 30
              }
            },
            "classification": {
              "type": [
                "string",
                "null"
              ],
              "format": "base64",
              "description": "base64 of raw u8 lanes (semio_hub_remodel PackedU8)",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Classification",
                  "de": "Klassifizierung"
                },
                "description": {
                  "en": "Packed LAS classification code per point (base64).",
                  "de": "Gepackter LAS-Klassifizierungscode je Punkt (Base64)."
                },
                "group": "result",
                "order": 40
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Dense Point Cloud",
          "de": "Dichte Punktwolke"
        },
        "description": {
          "en": "Packed dense cloud; empty clears it.",
          "de": "Gepackte dichte Punktwolke; leer entfernt sie."
        },
        "group": "result",
        "order": 10
      }
    }
  }
}
