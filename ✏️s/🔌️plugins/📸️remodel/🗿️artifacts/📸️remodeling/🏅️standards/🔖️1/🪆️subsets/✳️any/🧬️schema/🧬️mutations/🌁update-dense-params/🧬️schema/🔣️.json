{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/update-dense-params/schema.json",
  "title": "UpdateDenseParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "params"
  ],
  "properties": {
    "mutation": {
      "const": "updateDenseParams"
    },
    "params": {
      "type": "object",
      "title": "DenseParams",
      "additionalProperties": false,
      "required": [
        "resolution",
        "windowRadiusPx",
        "minViewConsistency",
        "confidenceThreshold",
        "maxPoints"
      ],
      "properties": {
        "resolution": {
          "type": "string",
          "title": "DenseResolution",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "x-semio-ui": {
            "widget": "segmented",
            "role": "value",
            "label": {
              "en": "Resolution",
              "de": "Auflösung"
            },
            "options": {
              "low": {
                "en": "Low",
                "de": "Niedrig"
              },
              "medium": {
                "en": "Medium",
                "de": "Mittel"
              },
              "high": {
                "en": "High",
                "de": "Hoch"
              }
            },
            "group": "parameters",
            "order": 10
          }
        },
        "windowRadiusPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Window Radius (px)",
              "de": "Fensterradius (px)"
            },
            "unit": "px",
            "step": 1,
            "precision": 0,
            "group": "parameters",
            "order": 20
          }
        },
        "minViewConsistency": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Min. View Consistency",
              "de": "Min. Ansichtskonsistenz"
            },
            "description": {
              "en": "Views that must agree before a point is kept.",
              "de": "Anzahl der Ansichten, die übereinstimmen müssen, damit ein Punkt erhalten bleibt."
            },
            "step": 1,
            "precision": 0,
            "group": "parameters",
            "order": 30
          }
        },
        "confidenceThreshold": {
          "type": "number",
          "format": "float",
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "Confidence Threshold",
              "de": "Konfidenzschwelle"
            },
            "step": 0.01,
            "precision": 2,
            "softMin": 0,
            "softMax": 1,
            "group": "parameters",
            "order": 40
          }
        },
        "maxPoints": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Max. Points",
              "de": "Max. Punkte"
            },
            "step": 1000,
            "precision": 0,
            "group": "parameters",
            "order": 50
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Dense Reconstruction Parameters",
          "de": "Parameter der dichten Rekonstruktion"
        },
        "group": "parameters",
        "order": 10
      }
    }
  }
}
