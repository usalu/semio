{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/1/any/mutation/update-match-params/schema.json",
  "title": "UpdateMatchParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "params"
  ],
  "properties": {
    "params": {
      "type": "object",
      "title": "MatchParams",
      "additionalProperties": false,
      "required": [
        "matcher",
        "ratioTest",
        "crossCheck",
        "sequentialWindow",
        "maxPairsPerFrame",
        "loopClosure"
      ],
      "properties": {
        "matcher": {
          "type": "string",
          "title": "MatcherKind",
          "enum": [
            "brute-force",
            "kd-tree"
          ]
        },
        "ratioTest": {
          "type": "number",
          "format": "float"
        },
        "crossCheck": {
          "type": "boolean"
        },
        "sequentialWindow": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxPairsPerFrame": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "loopClosure": {
          "type": "boolean"
        }
      }
    }
  }
}
