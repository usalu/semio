{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UpdateIngestParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "params"
  ],
  "properties": {
    "params": {
      "type": "object",
      "title": "IngestParams",
      "additionalProperties": false,
      "required": [
        "frameSampleStride",
        "maxFrames",
        "downscaleLongEdgePx",
        "minSharpness"
      ],
      "properties": {
        "frameSampleStride": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "maxFrames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "downscaleLongEdgePx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minSharpness": {
          "type": "number",
          "format": "float"
        }
      }
    }
  }
}
