// 🅰️ ANTLR4 mirror of the normative 📖️.grammar.semio in this directory — generated by
// 🐍️grammar-sidecars.py in the REMODEL-PLUGIN-END-TO-END ticket; same production names,
// kebab-case -> camelCase. Start rule: op.
grammar Remodeling_remodeling_op;

op: createStreamOp | deleteStreamOp | changeStreamSyncOp | addStreamFrameOp | removeStreamFrameOp | replaceStreamSourceOp | createAssetOp | deleteAssetOp | createCameraCalibrationOp | updateCameraCalibrationOp | deleteCameraCalibrationOp | createRigExtrinsicOp | deleteRigExtrinsicOp | updateRigExtrinsicOp | createGcpOp | deleteGcpOp | addGcpObservationOp | removeGcpObservationOp | updateIngestParamsOp | updateFeatureParamsOp | updateMatchParamsOp | updateSfmParamsOp | updateDenseParamsOp | updateMeshParamsOp | updateMotionParamsOp | updateGeoParamsOp | replaceJobOp | replaceSparseOp | replaceDenseOp | replaceMeshResultOp | replaceTrajectoryOp | replaceTracksOp | replaceGeoProductsOp | replaceQcOp | commitReconstructionOp ;
createStreamOp: 'create-stream' 'stream' '=' mediaStreamBlock ;
deleteStreamOp: 'delete-stream' 'id' '=' name ;
changeStreamSyncOp: 'change-stream-sync' 'id' '=' name 'new-sync-offset-ms' '=' num ;
addStreamFrameOp: 'add-stream-frame' 'id' '=' name 'kind' '=' mediaKind 'frame' '=' frameBlock ;
removeStreamFrameOp: 'remove-stream-frame' 'id' '=' name 'frame-index' '=' INT ;
replaceStreamSourceOp: 'replace-stream-source' 'id' '=' name ('source' '=' videoSourceBlock)? ;
createAssetOp: 'create-asset' 'key' '=' name 'asset' '=' imageAssetBlock ;
deleteAssetOp: 'delete-asset' 'key' '=' name ;
createCameraCalibrationOp: 'create-camera-calibration' 'camera' '=' cameraBlock ;
updateCameraCalibrationOp: 'update-camera-calibration' 'camera' '=' cameraBlock ;
deleteCameraCalibrationOp: 'delete-camera-calibration' 'camera-id' '=' name ;
createRigExtrinsicOp: 'create-rig-extrinsic' 'extrinsic' '=' rigBlock ;
deleteRigExtrinsicOp: 'delete-rig-extrinsic' 'camera-id' '=' name ;
updateRigExtrinsicOp: 'update-rig-extrinsic' 'extrinsic' '=' rigBlock ;
createGcpOp: 'create-gcp' 'gcp' '=' gcpBlock ;
deleteGcpOp: 'delete-gcp' 'id' '=' name ;
addGcpObservationOp: 'add-gcp-observation' 'id' '=' name 'observation' '=' observationBlock ;
removeGcpObservationOp: 'remove-gcp-observation' 'id' '=' name 'observation-index' '=' INT ;
updateIngestParamsOp: 'update-ingest-params' 'params' '=' '{' ingestField* '}' ;
updateFeatureParamsOp: 'update-feature-params' 'params' '=' '{' featureField* '}' ;
updateMatchParamsOp: 'update-match-params' 'params' '=' '{' matchingField* '}' ;
updateSfmParamsOp: 'update-sfm-params' 'params' '=' '{' sfmField* '}' ;
updateDenseParamsOp: 'update-dense-params' 'params' '=' '{' denseField* '}' ;
updateMeshParamsOp: 'update-mesh-params' 'params' '=' '{' meshParamsField* '}' ;
updateMotionParamsOp: 'update-motion-params' 'params' '=' '{' motionField* '}' ;
updateGeoParamsOp: 'update-geo-params' 'params' '=' '{' geoParamField* '}' ;
replaceJobOp: 'replace-job' 'job' '=' jobBlock ;
replaceSparseOp: 'replace-sparse' ('sparse' '=' sparseBlock)? ;
replaceDenseOp: 'replace-dense' ('dense' '=' denseCloudBlock)? ;
replaceMeshResultOp: 'replace-mesh-result' 'mesh' '=' meshResultBlock ;
replaceTrajectoryOp: 'replace-trajectory' ('trajectory' '=' trajectoryBlock)? ;
replaceTracksOp: 'replace-tracks' 'tracks' '=' '[' trackRecord* ']' ;
replaceGeoProductsOp: 'replace-geo-products' ('geo' '=' geoProductsBlock)? ;
replaceQcOp: 'replace-qc' ('qc' '=' qcBlock)? ;
commitReconstructionOp: 'commit-reconstruction' 'job' '=' jobBlock ('sparse' '=' sparseBlock)? ('trajectory' '=' trajectoryBlock)? ('mesh' '=' meshResultBlock)? ('geo' '=' geoProductsBlock)? ('qc' '=' qcBlock)? 'assets' assetCommitHeader '{' assetCommitRow* '}' ;
name: IDENT | TEXT ;
num: INT | FLOAT ;
quantity: num IDENT ;
coord3: '@' num ',' num ',' num ;
pair: num ',' num ;
quad: num ',' num ',' num ',' num ;
quint: num ',' num ',' num ',' num ',' num ;
textList: '[' name* ']' ;
mediaKind: 'image-sequence' | 'video' ;
videoCodec: 'avc' | 'hevc' | 'vp9' | 'av1' | 'mjpeg' | 'unknown' ;
detector: 'orb' | 'akaze' | 'harris' ;
matcher: 'brute-force' | 'kd-tree' ;
robustLoss: 'l2' | 'huber' | 'cauchy' ;
denseResolution: 'low' | 'medium' | 'high' ;
meshSource: 'placeholder' | 'reconstructed' | 'imported' ;
trackClass: 'static' | 'moving' ;
stage: 'idle' | 'ingesting' | 'calibrating' | 'extracting-features' | 'matching-features' | 'estimating-poses' | 'bundle-adjusting' | 'georeferencing' | 'dense-stereo' | 'fusing-volume' | 'extracting-surface' | 'cleaning-mesh' | 'texturing' | 'tracking-motion' | 'deriving-geo-products' | 'reporting-qc' | 'done' | 'failed' ;
mediaStreamBlock: '{' mediaStreamPart* '}' ;
mediaStreamPart: 'id' '=' name | 'name' '=' name | 'kind' '=' mediaKind | 'camera-id' '=' name | 'sync-offset-ms' '=' num | 'fps-hint' '=' num | 'source' '=' videoSourceBlock | framesTable ;
framesTable: 'frames' framesHeader '{' frameRow* '}' ;
framesHeader: '[' 'index' ':' 'UINT' 'timestamp-ms' ':' 'NUM' 'asset-id' ':' 'TEXT' ']' ;
frameRow: INT num name ;
frameBlock: '{' frameField+ '}' ;
frameField: 'index' '=' INT | 'timestamp-ms' '=' num | 'asset-id' '=' name ;
videoSourceBlock: '{' videoSourceField+ '}' ;
videoSourceField: 'name' '=' name | 'container' '=' name | 'codec' '=' videoCodec | 'duration-ms' '=' num | 'frame-count' '=' INT | 'width' '=' INT | 'height' '=' INT ;
imageAssetBlock: '{' imageAssetField+ '}' ;
imageAssetField: 'mime' '=' name | 'data' '=' name | 'width' '=' INT | 'height' '=' INT ;
cameraBlock: '{' cameraField+ '}' ;
cameraField: 'id' '=' name | 'label' '=' name | 'model' '=' name | 'fx' '=' num | 'fy' '=' num | 'cx' '=' num | 'cy' '=' num | 'skew' '=' num | 'distortion' '=' quint | 'rms-reprojection-px' '=' num | 'locked' '=' BOOL ;
rigBlock: '{' rigField+ '}' ;
rigField: 'camera-id' '=' name | 'rotation-wxyz' '=' quad | 'translation-m' '=' coord3 ;
gcpBlock: '{' gcpPart* '}' ;
gcpPart: 'id' '=' name | 'name' '=' name | 'world-position' '=' coord3 | observationsTable ;
observationsTable: 'observations' observationsHeader '{' observationRow* '}' ;
observationsHeader: '[' 'stream-id' ':' 'TEXT' 'frame-index' ':' 'UINT' 'pixel' ':' 'TUPLE' ']' ;
observationRow: name INT pair ;
observationBlock: '{' observationField+ '}' ;
observationField: 'stream-id' '=' name | 'frame-index' '=' INT | 'pixel' '=' pair ;
ingestField: 'frame-sample-stride' '=' INT | 'max-frames' '=' INT | 'downscale-long-edge-px' '=' INT | 'min-sharpness' '=' num ;
featureField: 'detector' '=' detector | 'target-count' '=' INT | 'octaves' '=' INT | 'edge-threshold' '=' num ;
matchingField: 'matcher' '=' matcher | 'ratio-test' '=' num | 'cross-check' '=' BOOL | 'sequential-window' '=' INT | 'max-pairs-per-frame' '=' INT | 'loop-closure' '=' BOOL ;
sfmField: 'ransac-iterations' '=' INT | 'ransac-threshold-px' '=' num | 'min-track-length' '=' INT | 'ba-max-iterations' '=' INT | 'robust-loss' '=' robustLoss | 'huber-delta-px' '=' num ;
denseField: 'resolution' '=' denseResolution | 'window-radius-px' '=' INT | 'min-view-consistency' '=' INT | 'confidence-threshold' '=' num | 'max-points' '=' INT ;
meshParamsField: 'tsdf-voxel-size-mm' '=' quantity | 'tsdf-truncation-mm' '=' quantity | 'decimate-target-triangles' '=' INT | 'smoothing-iterations' '=' INT | 'texture-enabled' '=' BOOL | 'texture-size' '=' INT | 'guarantee-watertight' '=' BOOL | 'hole-fill-max-boundary-verts' '=' INT | 'self-intersection-check' '=' BOOL ;
motionField: 'enabled' '=' BOOL | 'max-tracks' '=' INT | 'track-window-px' '=' INT | 'min-track-quality' '=' num | 'min-track-length-frames' '=' INT ;
geoParamField: 'enabled' '=' BOOL | 'origin-lon' '=' num | 'origin-lat' '=' num | 'origin-alt' '=' num | 'gsd-m' '=' quantity | 'dsm-cell-m' '=' quantity | 'dtm-filter-radius-m' '=' quantity | 'ortho-max-px' '=' INT ;
jobBlock: '{' jobPart* '}' ;
jobPart: 'id' '=' name | 'stage' '=' stage | 'progress-0-1' '=' num | 'cancel-requested' '=' BOOL | 'stage-cursor' '=' INT | 'started-at-ms' '=' num | 'error' '=' name | 'sparse-point-cloud-preview' '=' name | posesTable ;
posesTable: 'camera-poses-preview' posesHeader '{' poseRow* '}' ;
posesHeader: '[' 'camera-id' ':' 'TEXT' 'rotation-wxyz' ':' 'TUPLE' 'translation' ':' 'CRD' ']' ;
poseRow: name quad coord3 ;
sparseBlock: '{' sparseField+ '}' ;
sparseField: 'points' '=' name | 'colors' '=' name ;
denseCloudBlock: '{' denseCloudField+ '}' ;
denseCloudField: 'positions' '=' name | 'colors' '=' name | 'confidence' '=' name | 'classification' '=' name ;
trajectoryBlock: '{' trajectoryPosesTable '}' ;
trajectoryPosesTable: 'poses' posesHeader '{' poseRow* '}' ;
meshResultBlock: '{' meshResultPart* '}' ;
meshResultPart: 'source' '=' meshSource | 'texture-asset-id' '=' name | meshChildBlock | watertightBlock ;
meshChildBlock: 'mesh' '{' childHandle '}' ;
childHandle: 'child_id' '=' name 'target' '=' TEXT ;
watertightBlock: 'watertight' '{' watertightField* '}' ;
watertightField: 'vertex-count' '=' INT | 'triangle-count' '=' INT | 'boundary-edge-count' '=' INT | 'boundary-loop-count' '=' INT | 'non-manifold-edge-count' '=' INT | 'non-manifold-vertex-count' '=' INT | 'connected-components' '=' INT | 'consistently-oriented' '=' BOOL | 'euler-characteristic' '=' INT | 'genus' '=' INT | 'signed-volume' '=' num | 'self-intersection-pairs' '=' INT | 'closed-fallback-used' '=' BOOL | 'is-closed' '=' BOOL | 'is-two-manifold' '=' BOOL | 'is-watertight' '=' BOOL ;
geoProductsBlock: '{' geoProductField+ '}' ;
geoProductField: 'dsm-asset-id' '=' name | 'dtm-asset-id' '=' name | 'ortho-asset-id' '=' name ;
qcBlock: '{' qcPart* '}' ;
qcPart: 'reprojection-rms-px' '=' num | 'gcp-checkpoint-rmse' '=' num | 'mean-track-length' '=' num | 'registered-frame-ratio' '=' num | 'dense-coverage-ratio' '=' num | watertightBlock | 'warnings' '=' textList ;
trackRecord: 'id' '=' name 'length' '=' INT 'class' '=' trackClass 'mean-speed-m-s' '=' quantity ;
assetCommitHeader: '[' 'id' ':' 'TEXT' 'asset' ':' 'BLOCK' ']' ;
assetCommitRow: name imageAssetBlock ;

// 📐 Framework dialect-primitive terminals (only named, never defined, by the .semio itself).
BOOL: 'true' | 'false' ;
FLOAT: '-'? [0-9]+ '.' [0-9]+ ([eE] [+-]? [0-9]+)? ;
INT: '-'? [0-9]+ ;
IDENT: [A-Za-z_] [A-Za-z0-9_\-./]* ;
PLACEHOLDER: '_' ;
TEXT: '"' (~["\\] | '\\' .)* '"' ;
WS: [ \t\r\n]+ -> skip ;
