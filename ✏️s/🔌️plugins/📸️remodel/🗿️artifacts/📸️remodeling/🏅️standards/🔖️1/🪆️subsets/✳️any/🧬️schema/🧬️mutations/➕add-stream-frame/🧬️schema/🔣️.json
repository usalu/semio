{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/add-stream-frame/schema.json",
  "title": "AddStreamFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "frame",
    "id",
    "kind"
  ],
  "properties": {
    "mutation": {
      "const": "addStreamFrame"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Stream",
          "de": "Stream"
        },
        "description": {
          "en": "The stream that receives the frame.",
          "de": "Stream, der das Bild erhält."
        },
        "ref": {
          "kind": "stream"
        },
        "group": "target",
        "order": 10
      }
    },
    "frame": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/artifact.json#/$defs/FrameRef",
      "title": "FrameRef",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Frame",
          "de": "Bild"
        },
        "description": {
          "en": "The frame appended to the stream.",
          "de": "Das an den Stream angehängte Bild."
        },
        "group": "record",
        "order": 20
      }
    },
    "kind": {
      "type": "string",
      "title": "MediaKind",
      "enum": [
        "image-sequence",
        "video"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Stream Kind",
          "de": "Streamart"
        },
        "description": {
          "en": "Capture form of the stream the frame belongs to.",
          "de": "Erfassungsform des Streams, zu dem das Bild gehört."
        },
        "options": {
          "image-sequence": {
            "en": "Image Sequence",
            "de": "Bildsequenz"
          },
          "video": {
            "en": "Video",
            "de": "Video"
          }
        },
        "group": "media",
        "order": 30
      }
    }
  }
}
