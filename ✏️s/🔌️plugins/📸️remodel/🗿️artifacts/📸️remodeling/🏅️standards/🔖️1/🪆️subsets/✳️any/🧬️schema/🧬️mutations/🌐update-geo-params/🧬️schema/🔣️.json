{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/update-geo-params/schema.json",
  "title": "UpdateGeoParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "params"
  ],
  "properties": {
    "mutation": {
      "const": "updateGeoParams"
    },
    "params": {
      "type": "object",
      "title": "GeoParams",
      "additionalProperties": false,
      "required": [
        "enabled",
        "originLon",
        "originLat",
        "originAlt",
        "gsdM",
        "dsmCellM",
        "dtmFilterRadiusM",
        "orthoMaxPx"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Georeferencing Enabled",
              "de": "Georeferenzierung aktiviert"
            },
            "group": "parameters",
            "order": 10
          }
        },
        "originLon": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": -180,
          "maximum": 180,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Origin Longitude",
              "de": "Ursprung Längengrad"
            },
            "description": {
              "en": "Longitude of the local origin (WGS 84); empty when not set.",
              "de": "Längengrad des lokalen Ursprungs (WGS 84); leer, wenn nicht festgelegt."
            },
            "unit": "°",
            "step": 1e-06,
            "precision": 7,
            "group": "origin",
            "order": 20
          }
        },
        "originLat": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": -90,
          "maximum": 90,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Origin Latitude",
              "de": "Ursprung Breitengrad"
            },
            "description": {
              "en": "Latitude of the local origin (WGS 84); empty when not set.",
              "de": "Breitengrad des lokalen Ursprungs (WGS 84); leer, wenn nicht festgelegt."
            },
            "unit": "°",
            "step": 1e-06,
            "precision": 7,
            "group": "origin",
            "order": 30
          }
        },
        "originAlt": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Origin Altitude (m)",
              "de": "Ursprung Höhe (m)"
            },
            "description": {
              "en": "Height of the local origin; empty when not set.",
              "de": "Höhe des lokalen Ursprungs; leer, wenn nicht festgelegt."
            },
            "unit": "m",
            "step": 0.01,
            "precision": 2,
            "group": "origin",
            "order": 40
          }
        },
        "gsdM": {
          "type": "number",
          "format": "float",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "Ground Sample Distance (m)",
              "de": "Bodenpixelgröße (m)"
            },
            "description": {
              "en": "Target ground sampling distance of the orthophoto.",
              "de": "Angestrebte Bodenauflösung des Orthofotos."
            },
            "unit": "m",
            "step": 0.01,
            "precision": 3,
            "softMin": 0.01,
            "softMax": 1,
            "scale": "log",
            "group": "parameters",
            "order": 50
          }
        },
        "dsmCellM": {
          "type": "number",
          "format": "float",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "DSM Cell Size (m)",
              "de": "DOM-Rasterweite (m)"
            },
            "description": {
              "en": "Grid spacing of the digital surface model.",
              "de": "Rasterweite des digitalen Oberflächenmodells."
            },
            "unit": "m",
            "step": 0.01,
            "precision": 2,
            "softMin": 0.01,
            "softMax": 5,
            "scale": "log",
            "group": "parameters",
            "order": 60
          }
        },
        "dtmFilterRadiusM": {
          "type": "number",
          "format": "float",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "DTM Filter Radius (m)",
              "de": "DGM-Filterradius (m)"
            },
            "description": {
              "en": "Radius of the ground filter that derives the digital terrain model.",
              "de": "Radius des Bodenfilters, der das digitale Geländemodell ableitet."
            },
            "unit": "m",
            "step": 0.1,
            "precision": 1,
            "softMin": 0.1,
            "softMax": 10,
            "scale": "log",
            "group": "parameters",
            "order": 70
          }
        },
        "orthoMaxPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Max. Orthophoto Size (px)",
              "de": "Max. Orthofotogröße (px)"
            },
            "unit": "px",
            "step": 256,
            "precision": 0,
            "group": "parameters",
            "order": 80
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Georeferencing Parameters",
          "de": "Georeferenzierungsparameter"
        },
        "group": "parameters",
        "order": 10
      }
    }
  }
}
