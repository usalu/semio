{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceStreamSource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "title": "VideoSource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "container",
        "durationMs",
        "frameCount",
        "height",
        "name",
        "width"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "codec": {
          "type": "string",
          "enum": [
            "avc",
            "hevc",
            "vp9",
            "av1",
            "mjpeg",
            "unknown"
          ]
        },
        "durationMs": {
          "type": "number"
        },
        "frameCount": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
