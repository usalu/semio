{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/replace-qc/schema.json",
  "title": "ReplaceQc",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "qc"
  ],
  "properties": {
    "mutation": {
      "const": "replaceQc"
    },
    "qc": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/artifact.json#/$defs/QcReportSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Quality Report",
          "de": "Qualitätsbericht"
        },
        "description": {
          "en": "Quality metrics of the last run; empty clears them.",
          "de": "Qualitätskennzahlen des letzten Laufs; leer entfernt sie."
        },
        "group": "result",
        "order": 10,
        "widget": "hidden"
      }
    }
  }
}
