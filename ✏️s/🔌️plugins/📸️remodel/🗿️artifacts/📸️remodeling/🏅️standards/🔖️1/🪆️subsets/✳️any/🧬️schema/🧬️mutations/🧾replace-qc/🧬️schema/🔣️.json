{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/1/any/mutation/replace-qc/schema.json",
  "title": "ReplaceQc",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qc"
  ],
  "properties": {
    "qc": {
      "anyOf": [
        {
          "type": "object",
          "title": "QcReportSnapshot",
          "additionalProperties": false,
          "required": [
            "reprojectionRmsPx",
            "gcpCheckpointRmse",
            "watertight",
            "meanTrackLength",
            "registeredFrameRatio",
            "denseCoverageRatio",
            "warnings"
          ],
          "properties": {
            "reprojectionRmsPx": {
              "type": "number",
              "format": "double"
            },
            "gcpCheckpointRmse": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "watertight": {
              "anyOf": [
                {
                  "type": "object",
                  "title": "WatertightReportSnapshot",
                  "additionalProperties": false,
                  "required": [
                    "vertexCount",
                    "triangleCount",
                    "boundaryEdgeCount",
                    "boundaryLoopCount",
                    "nonManifoldEdgeCount",
                    "nonManifoldVertexCount",
                    "connectedComponents",
                    "consistentlyOriented",
                    "eulerCharacteristic",
                    "genus",
                    "signedVolume",
                    "selfIntersectionPairs",
                    "closedFallbackUsed",
                    "isClosed",
                    "isTwoManifold",
                    "isWatertight"
                  ],
                  "properties": {
                    "vertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "triangleCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "boundaryEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "boundaryLoopCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "nonManifoldEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "nonManifoldVertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "connectedComponents": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "consistentlyOriented": {
                      "type": "boolean"
                    },
                    "eulerCharacteristic": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "genus": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "int64"
                    },
                    "signedVolume": {
                      "type": "number",
                      "format": "double"
                    },
                    "selfIntersectionPairs": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "uint32",
                      "minimum": 0
                    },
                    "closedFallbackUsed": {
                      "type": "boolean"
                    },
                    "isClosed": {
                      "type": "boolean"
                    },
                    "isTwoManifold": {
                      "type": "boolean"
                    },
                    "isWatertight": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "meanTrackLength": {
              "type": "number",
              "format": "float"
            },
            "registeredFrameRatio": {
              "type": "number",
              "format": "float"
            },
            "denseCoverageRatio": {
              "type": "number",
              "format": "float"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
