{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/replace-qc/schema.json",
  "title": "ReplaceQc",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "qc"
  ],
  "properties": {
    "mutation": {
      "const": "replaceQc"
    },
    "qc": {
      "anyOf": [
        {
          "type": "object",
          "title": "QcReportSnapshot",
          "additionalProperties": false,
          "required": [
            "reprojectionRmsPx",
            "gcpCheckpointRmse",
            "watertight",
            "meanTrackLength",
            "registeredFrameRatio",
            "denseCoverageRatio",
            "warnings"
          ],
          "properties": {
            "reprojectionRmsPx": {
              "type": "number",
              "format": "double",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Reprojection RMS (px)",
                  "de": "RMS des Rückprojektionsfehlers (px)"
                },
                "description": {
                  "en": "Computed by the reconstruction run; not edited by hand.",
                  "de": "Vom Rekonstruktionslauf berechnet; wird nicht von Hand bearbeitet."
                },
                "group": "report",
                "order": 10
              }
            },
            "gcpCheckpointRmse": {
              "type": [
                "number",
                "null"
              ],
              "format": "double",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Checkpoint RMSE",
                  "de": "RMSE der Kontrollpunkte"
                },
                "description": {
                  "en": "Root mean square error at the ground control checkpoints.",
                  "de": "Mittlerer quadratischer Fehler an den Kontrollpunkten."
                },
                "group": "report",
                "order": 20
              }
            },
            "watertight": {
              "anyOf": [
                {
                  "type": "object",
                  "title": "WatertightReportSnapshot",
                  "additionalProperties": false,
                  "required": [
                    "vertexCount",
                    "triangleCount",
                    "boundaryEdgeCount",
                    "boundaryLoopCount",
                    "nonManifoldEdgeCount",
                    "nonManifoldVertexCount",
                    "connectedComponents",
                    "consistentlyOriented",
                    "eulerCharacteristic",
                    "genus",
                    "signedVolume",
                    "selfIntersectionPairs",
                    "closedFallbackUsed",
                    "isClosed",
                    "isTwoManifold",
                    "isWatertight"
                  ],
                  "properties": {
                    "vertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Vertex Count",
                          "de": "Anzahl der Eckpunkte"
                        },
                        "group": "report",
                        "order": 10
                      }
                    },
                    "triangleCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Triangle Count",
                          "de": "Anzahl der Dreiecke"
                        },
                        "group": "report",
                        "order": 20
                      }
                    },
                    "boundaryEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Boundary Edges",
                          "de": "Randkanten"
                        },
                        "group": "report",
                        "order": 30
                      }
                    },
                    "boundaryLoopCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Boundary Loops",
                          "de": "Randschleifen"
                        },
                        "group": "report",
                        "order": 40
                      }
                    },
                    "nonManifoldEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Non-Manifold Edges",
                          "de": "Nicht-mannigfaltige Kanten"
                        },
                        "group": "report",
                        "order": 50
                      }
                    },
                    "nonManifoldVertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Non-Manifold Vertices",
                          "de": "Nicht-mannigfaltige Eckpunkte"
                        },
                        "group": "report",
                        "order": 60
                      }
                    },
                    "connectedComponents": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Connected Components",
                          "de": "Zusammenhangskomponenten"
                        },
                        "group": "report",
                        "order": 70
                      }
                    },
                    "consistentlyOriented": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Consistently Oriented",
                          "de": "Konsistent orientiert"
                        },
                        "group": "report",
                        "order": 80
                      }
                    },
                    "eulerCharacteristic": {
                      "type": "integer",
                      "format": "int64",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Euler Characteristic",
                          "de": "Euler-Charakteristik"
                        },
                        "group": "report",
                        "order": 90
                      }
                    },
                    "genus": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "int64",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Genus",
                          "de": "Geschlecht"
                        },
                        "description": {
                          "en": "Topological genus of a closed 2-manifold.",
                          "de": "Topologisches Geschlecht einer geschlossenen 2-Mannigfaltigkeit."
                        },
                        "group": "report",
                        "order": 100
                      }
                    },
                    "signedVolume": {
                      "type": "number",
                      "format": "double",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Signed Volume",
                          "de": "Vorzeichenbehaftetes Volumen"
                        },
                        "group": "report",
                        "order": 110
                      }
                    },
                    "selfIntersectionPairs": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Self-Intersection Pairs",
                          "de": "Selbstüberschneidungspaare"
                        },
                        "group": "report",
                        "order": 120
                      }
                    },
                    "closedFallbackUsed": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Closing Fallback Used",
                          "de": "Schließ-Rückfall verwendet"
                        },
                        "group": "report",
                        "order": 130
                      }
                    },
                    "isClosed": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Closed",
                          "de": "Geschlossen"
                        },
                        "group": "report",
                        "order": 140
                      }
                    },
                    "isTwoManifold": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "2-Manifold",
                          "de": "2-Mannigfaltig"
                        },
                        "group": "report",
                        "order": 150
                      }
                    },
                    "isWatertight": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Watertight",
                          "de": "Wasserdicht"
                        },
                        "group": "report",
                        "order": 160
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ],
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Watertightness Report",
                  "de": "Wasserdichtheitsbericht"
                },
                "description": {
                  "en": "Derived from the mesh by the reconstruction; not edited by hand.",
                  "de": "Von der Rekonstruktion aus dem Mesh abgeleitet; wird nicht von Hand bearbeitet."
                },
                "group": "report",
                "order": 30
              }
            },
            "meanTrackLength": {
              "type": "number",
              "format": "float",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Mean Track Length",
                  "de": "Mittlere Spurlänge"
                },
                "description": {
                  "en": "Computed by the reconstruction run; not edited by hand.",
                  "de": "Vom Rekonstruktionslauf berechnet; wird nicht von Hand bearbeitet."
                },
                "group": "report",
                "order": 40
              }
            },
            "registeredFrameRatio": {
              "type": "number",
              "format": "float",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Registered Frame Ratio",
                  "de": "Anteil registrierter Bilder"
                },
                "description": {
                  "en": "Computed by the reconstruction run; not edited by hand.",
                  "de": "Vom Rekonstruktionslauf berechnet; wird nicht von Hand bearbeitet."
                },
                "group": "report",
                "order": 50
              }
            },
            "denseCoverageRatio": {
              "type": "number",
              "format": "float",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Dense Coverage Ratio",
                  "de": "Abdeckungsgrad der dichten Punktwolke"
                },
                "description": {
                  "en": "Computed by the reconstruction run; not edited by hand.",
                  "de": "Vom Rekonstruktionslauf berechnet; wird nicht von Hand bearbeitet."
                },
                "group": "report",
                "order": 60
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Warnings",
                  "de": "Warnungen"
                },
                "description": {
                  "en": "Computed by the reconstruction run; not edited by hand.",
                  "de": "Vom Rekonstruktionslauf berechnet; wird nicht von Hand bearbeitet."
                },
                "group": "report",
                "order": 70
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Quality Report",
          "de": "Qualitätsbericht"
        },
        "description": {
          "en": "Quality metrics of the last run; empty clears them.",
          "de": "Qualitätskennzahlen des letzten Laufs; leer entfernt sie."
        },
        "group": "result",
        "order": 10
      }
    }
  }
}
