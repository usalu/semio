{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/1/any/mutation/replace-tracks.json",
  "title": "ReplaceTracks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tracks"
  ],
  "properties": {
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "MotionTrackSummary",
        "additionalProperties": false,
        "required": [
          "id",
          "length",
          "class",
          "meanSpeedMS"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "length": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "class": {
            "type": "string",
            "title": "TrackClass",
            "enum": [
              "static",
              "moving"
            ]
          },
          "meanSpeedMS": {
            "type": "number",
            "format": "float"
          }
        }
      }
    }
  }
}
