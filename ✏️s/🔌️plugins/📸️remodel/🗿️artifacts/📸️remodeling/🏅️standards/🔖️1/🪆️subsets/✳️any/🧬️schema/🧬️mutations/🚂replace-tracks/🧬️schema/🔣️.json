{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/replace-tracks/schema.json",
  "title": "ReplaceTracks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "tracks"
  ],
  "properties": {
    "mutation": {
      "const": "replaceTracks"
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "MotionTrackSummary",
        "additionalProperties": false,
        "required": [
          "id",
          "length",
          "class",
          "meanSpeedMS"
        ],
        "properties": {
          "id": {
            "type": "string",
            "x-semio-ui": {
              "widget": "text",
              "role": "value",
              "label": {
                "en": "Track ID",
                "de": "Spur-ID"
              },
              "group": "identity",
              "order": 10
            }
          },
          "length": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "x-semio-ui": {
              "widget": "stepper",
              "role": "value",
              "label": {
                "en": "Length (frames)",
                "de": "Länge (Bilder)"
              },
              "step": 1,
              "precision": 0,
              "group": "result",
              "order": 20
            }
          },
          "class": {
            "type": "string",
            "title": "TrackClass",
            "enum": [
              "static",
              "moving"
            ],
            "x-semio-ui": {
              "widget": "segmented",
              "role": "value",
              "label": {
                "en": "Track Class",
                "de": "Spurklasse"
              },
              "options": {
                "static": {
                  "en": "Static",
                  "de": "Statisch"
                },
                "moving": {
                  "en": "Moving",
                  "de": "Bewegt"
                }
              },
              "group": "result",
              "order": 30
            }
          },
          "meanSpeedMS": {
            "type": "number",
            "format": "float",
            "x-semio-ui": {
              "widget": "stepper",
              "role": "value",
              "label": {
                "en": "Mean Speed (m/s)",
                "de": "Mittlere Geschwindigkeit (m/s)"
              },
              "unit": "m/s",
              "step": 0.01,
              "precision": 2,
              "group": "result",
              "order": 40
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Motion Tracks",
          "de": "Bewegungsspuren"
        },
        "group": "result",
        "order": 10
      }
    }
  }
}
