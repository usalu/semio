{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/update-motion-params/schema.json",
  "title": "UpdateMotionParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "params"
  ],
  "properties": {
    "mutation": {
      "const": "updateMotionParams"
    },
    "params": {
      "type": "object",
      "title": "MotionParams",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxTracks",
        "trackWindowPx",
        "minTrackQuality",
        "minTrackLengthFrames"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Motion Tracking Enabled",
              "de": "Bewegungsverfolgung aktiviert"
            },
            "group": "parameters",
            "order": 10
          }
        },
        "maxTracks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Max. Tracks",
              "de": "Max. Spuren"
            },
            "step": 1,
            "precision": 0,
            "group": "parameters",
            "order": 20
          }
        },
        "trackWindowPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Track Window (px)",
              "de": "Spurfenster (px)"
            },
            "unit": "px",
            "step": 1,
            "precision": 0,
            "group": "parameters",
            "order": 30
          }
        },
        "minTrackQuality": {
          "type": "number",
          "format": "float",
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "Min. Track Quality",
              "de": "Min. Spurqualität"
            },
            "step": 0.01,
            "precision": 2,
            "softMin": 0,
            "softMax": 1,
            "group": "parameters",
            "order": 40
          }
        },
        "minTrackLengthFrames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Min. Track Length (frames)",
              "de": "Min. Spurlänge (Bilder)"
            },
            "step": 1,
            "precision": 0,
            "group": "parameters",
            "order": 50
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Motion Tracking Parameters",
          "de": "Parameter der Bewegungsverfolgung"
        },
        "group": "parameters",
        "order": 10
      }
    }
  }
}
