{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/commit-reconstruction/schema.json",
  "title": "CommitReconstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "assets",
    "geo",
    "mesh",
    "qc",
    "sparse",
    "trajectory"
  ],
  "properties": {
    "mutation": {
      "const": "commitReconstruction"
    },
    "sparse": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/artifact.json#/$defs/SparseCloud"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Sparse Point Cloud",
          "de": "Dünne Punktwolke"
        },
        "description": {
          "en": "Sparse cloud produced by the run.",
          "de": "Vom Lauf erzeugte dünne Punktwolke."
        },
        "group": "result",
        "order": 10,
        "widget": "hidden"
      }
    },
    "trajectory": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/artifact.json#/$defs/CameraTrajectory"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Camera Trajectory",
          "de": "Kameratrajektorie"
        },
        "description": {
          "en": "Camera poses recovered by the run.",
          "de": "Vom Lauf rekonstruierte Kameraposen."
        },
        "group": "result",
        "order": 20,
        "widget": "hidden"
      }
    },
    "mesh": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/artifact.json#/$defs/RemodelingMesh"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Mesh",
          "de": "Mesh"
        },
        "description": {
          "en": "Reconstructed mesh; empty keeps the stored mesh.",
          "de": "Rekonstruiertes Mesh; leer behält das gespeicherte Mesh."
        },
        "group": "result",
        "order": 30,
        "widget": "hidden"
      }
    },
    "geo": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/artifact.json#/$defs/GeoProducts"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Geo Products",
          "de": "Geoprodukte"
        },
        "description": {
          "en": "DSM, DTM and orthophoto rasters produced by the run.",
          "de": "Vom Lauf erzeugte DOM-, DGM- und Orthofoto-Raster."
        },
        "group": "result",
        "order": 40,
        "widget": "hidden"
      }
    },
    "qc": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/artifact.json#/$defs/QcReportSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Quality Report",
          "de": "Qualitätsbericht"
        },
        "description": {
          "en": "Computed by the reconstruction run; not edited by hand.",
          "de": "Vom Rekonstruktionslauf berechnet; wird nicht von Hand bearbeitet."
        },
        "group": "result",
        "order": 50,
        "widget": "hidden"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "contentId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "x-semio-ui": {
        "widget": "hidden",
        "role": "value",
        "label": {
          "en": "Image assets",
          "de": "Bildressourcen"
        },
        "description": {
          "en": "The images the reconstruction derived, by id.",
          "de": "Die von der Rekonstruktion abgeleiteten Bilder, nach Kennung."
        },
        "group": "result",
        "order": 60
      }
    }
  }
}
