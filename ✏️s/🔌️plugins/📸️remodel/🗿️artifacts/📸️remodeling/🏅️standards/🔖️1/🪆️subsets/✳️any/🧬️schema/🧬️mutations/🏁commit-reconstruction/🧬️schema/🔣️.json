{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/commit-reconstruction/schema.json",
  "title": "CommitReconstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "assets",
    "geo",
    "mesh",
    "qc",
    "sparse",
    "trajectory"
  ],
  "properties": {
    "mutation": {
      "const": "commitReconstruction"
    },
    "sparse": {
      "anyOf": [
        {
          "type": "object",
          "title": "SparseCloud",
          "additionalProperties": false,
          "required": [
            "points",
            "colors"
          ],
          "properties": {
            "points": {
              "type": "string",
              "format": "base64",
              "description": "base64 of little-endian f32 lanes (semio_hub_remodel PackedF32)",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Points",
                  "de": "Punkte"
                },
                "description": {
                  "en": "Packed float32 xyz triples (base64).",
                  "de": "Gepackte float32-xyz-Tripel (Base64)."
                },
                "group": "result",
                "order": 10
              }
            },
            "colors": {
              "type": [
                "string",
                "null"
              ],
              "format": "base64",
              "description": "base64 of raw u8 lanes (semio_hub_remodel PackedU8)",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Colours",
                  "de": "Farben"
                },
                "description": {
                  "en": "Packed 8-bit RGB triples (base64).",
                  "de": "Gepackte 8-Bit-RGB-Tripel (Base64)."
                },
                "group": "result",
                "order": 20
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Sparse Point Cloud",
          "de": "Dünne Punktwolke"
        },
        "description": {
          "en": "Sparse cloud produced by the run.",
          "de": "Vom Lauf erzeugte dünne Punktwolke."
        },
        "group": "result",
        "order": 10
      }
    },
    "trajectory": {
      "anyOf": [
        {
          "type": "object",
          "title": "CameraTrajectory",
          "additionalProperties": false,
          "required": [
            "poses"
          ],
          "properties": {
            "poses": {
              "type": "array",
              "items": {
                "type": "object",
                "title": "CameraPosePreview",
                "additionalProperties": false,
                "required": [
                  "cameraId",
                  "rotationWxyz",
                  "translation"
                ],
                "properties": {
                  "cameraId": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "reference",
                      "role": "target",
                      "label": {
                        "en": "Camera",
                        "de": "Kamera"
                      },
                      "description": {
                        "en": "The camera this pose belongs to.",
                        "de": "Kamera, zu der diese Pose gehört."
                      },
                      "ref": {
                        "kind": "camera"
                      },
                      "group": "pose",
                      "order": 10
                    }
                  },
                  "rotationWxyz": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "format": "float"
                    },
                    "minItems": 4,
                    "maxItems": 4,
                    "x-semio-ui": {
                      "widget": "vector",
                      "role": "value",
                      "label": {
                        "en": "Rotation (Quaternion w, x, y, z)",
                        "de": "Rotation (Quaternion w, x, y, z)"
                      },
                      "description": {
                        "en": "Unit quaternion of the camera orientation.",
                        "de": "Einheitsquaternion der Kameraorientierung."
                      },
                      "step": 0.001,
                      "group": "pose",
                      "order": 20
                    }
                  },
                  "translation": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "format": "float"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "x-semio-ui": {
                      "widget": "vector",
                      "role": "value",
                      "label": {
                        "en": "Translation",
                        "de": "Translation"
                      },
                      "description": {
                        "en": "Camera position in reconstruction coordinates.",
                        "de": "Kameraposition in Rekonstruktionskoordinaten."
                      },
                      "step": 0.001,
                      "group": "pose",
                      "order": 30
                    }
                  }
                }
              },
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Camera Poses",
                  "de": "Kameraposen"
                },
                "group": "result",
                "order": 10
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Camera Trajectory",
          "de": "Kameratrajektorie"
        },
        "description": {
          "en": "Camera poses recovered by the run.",
          "de": "Vom Lauf rekonstruierte Kameraposen."
        },
        "group": "result",
        "order": 20
      }
    },
    "mesh": {
      "anyOf": [
        {
          "type": "object",
          "title": "RemodelingMesh",
          "additionalProperties": false,
          "required": [
            "mesh",
            "source",
            "textureAssetId",
            "watertight"
          ],
          "properties": {
            "mesh": {
              "type": "object",
              "title": "RemodelingMeshChild",
              "description": "store::ArtifactChild<SemioMeshSnapshot> — an owned child handle; only childId and target cross the wire.",
              "additionalProperties": false,
              "required": [
                "childId",
                "target"
              ],
              "properties": {
                "childId": {
                  "type": "string",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Child ID",
                      "de": "Kind-ID"
                    },
                    "description": {
                      "en": "Handle of the composed stdio mesh artifact.",
                      "de": "Verweis auf das eingebettete stdio-Mesh-Artefakt."
                    },
                    "group": "result",
                    "order": 10
                  }
                },
                "target": {
                  "type": "object",
                  "title": "ArtifactRef",
                  "additionalProperties": false,
                  "required": [
                    "artifactId",
                    "dialect"
                  ],
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Artifact ID",
                          "de": "Artefakt-ID"
                        },
                        "group": "result",
                        "order": 10
                      }
                    },
                    "dialect": {
                      "type": "object",
                      "title": "ArtifactDialect",
                      "additionalProperties": false,
                      "required": [
                        "artifactKind",
                        "standard",
                        "subset"
                      ],
                      "properties": {
                        "artifactKind": {
                          "type": "string",
                          "x-semio-ui": {
                            "widget": "hidden",
                            "role": "value",
                            "label": {
                              "en": "Artifact Kind",
                              "de": "Artefaktart"
                            },
                            "group": "result",
                            "order": 10
                          }
                        },
                        "standard": {
                          "type": "string",
                          "x-semio-ui": {
                            "widget": "hidden",
                            "role": "value",
                            "label": {
                              "en": "Standard",
                              "de": "Standard"
                            },
                            "group": "result",
                            "order": 20
                          }
                        },
                        "subset": {
                          "type": "string",
                          "x-semio-ui": {
                            "widget": "hidden",
                            "role": "value",
                            "label": {
                              "en": "Subset",
                              "de": "Teilmenge"
                            },
                            "group": "result",
                            "order": 30
                          }
                        }
                      },
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Dialect",
                          "de": "Dialekt"
                        },
                        "group": "result",
                        "order": 20
                      }
                    }
                  },
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Target Artifact",
                      "de": "Zielartefakt"
                    },
                    "description": {
                      "en": "Handle of the composed stdio mesh artifact.",
                      "de": "Verweis auf das eingebettete stdio-Mesh-Artefakt."
                    },
                    "group": "result",
                    "order": 20
                  }
                }
              },
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Mesh Artifact",
                  "de": "Mesh-Artefakt"
                },
                "description": {
                  "en": "Handle of the composed stdio mesh artifact.",
                  "de": "Verweis auf das eingebettete stdio-Mesh-Artefakt."
                },
                "group": "result",
                "order": 10
              }
            },
            "source": {
              "type": "string",
              "title": "MeshSource",
              "enum": [
                "placeholder",
                "reconstructed",
                "imported"
              ],
              "x-semio-ui": {
                "widget": "segmented",
                "role": "value",
                "label": {
                  "en": "Mesh Source",
                  "de": "Mesh-Herkunft"
                },
                "options": {
                  "placeholder": {
                    "en": "Placeholder",
                    "de": "Platzhalter"
                  },
                  "reconstructed": {
                    "en": "Reconstructed",
                    "de": "Rekonstruiert"
                  },
                  "imported": {
                    "en": "Imported",
                    "de": "Importiert"
                  }
                },
                "group": "result",
                "order": 20
              }
            },
            "textureAssetId": {
              "type": [
                "string",
                "null"
              ],
              "x-semio-ui": {
                "widget": "reference",
                "role": "target",
                "label": {
                  "en": "Texture Asset",
                  "de": "Textur-Asset"
                },
                "description": {
                  "en": "Texture image of the mesh; empty when untextured.",
                  "de": "Texturbild des Mesh; leer, wenn untexturiert."
                },
                "ref": {
                  "kind": "asset",
                  "domain": "assets",
                  "granularity": "asset"
                },
                "group": "result",
                "order": 30
              }
            },
            "watertight": {
              "anyOf": [
                {
                  "type": "object",
                  "title": "WatertightReportSnapshot",
                  "additionalProperties": false,
                  "required": [
                    "vertexCount",
                    "triangleCount",
                    "boundaryEdgeCount",
                    "boundaryLoopCount",
                    "nonManifoldEdgeCount",
                    "nonManifoldVertexCount",
                    "connectedComponents",
                    "consistentlyOriented",
                    "eulerCharacteristic",
                    "genus",
                    "signedVolume",
                    "selfIntersectionPairs",
                    "closedFallbackUsed",
                    "isClosed",
                    "isTwoManifold",
                    "isWatertight"
                  ],
                  "properties": {
                    "vertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Vertex Count",
                          "de": "Anzahl der Eckpunkte"
                        },
                        "group": "report",
                        "order": 10
                      }
                    },
                    "triangleCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Triangle Count",
                          "de": "Anzahl der Dreiecke"
                        },
                        "group": "report",
                        "order": 20
                      }
                    },
                    "boundaryEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Boundary Edges",
                          "de": "Randkanten"
                        },
                        "group": "report",
                        "order": 30
                      }
                    },
                    "boundaryLoopCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Boundary Loops",
                          "de": "Randschleifen"
                        },
                        "group": "report",
                        "order": 40
                      }
                    },
                    "nonManifoldEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Non-Manifold Edges",
                          "de": "Nicht-mannigfaltige Kanten"
                        },
                        "group": "report",
                        "order": 50
                      }
                    },
                    "nonManifoldVertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Non-Manifold Vertices",
                          "de": "Nicht-mannigfaltige Eckpunkte"
                        },
                        "group": "report",
                        "order": 60
                      }
                    },
                    "connectedComponents": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Connected Components",
                          "de": "Zusammenhangskomponenten"
                        },
                        "group": "report",
                        "order": 70
                      }
                    },
                    "consistentlyOriented": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Consistently Oriented",
                          "de": "Konsistent orientiert"
                        },
                        "group": "report",
                        "order": 80
                      }
                    },
                    "eulerCharacteristic": {
                      "type": "integer",
                      "format": "int64",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Euler Characteristic",
                          "de": "Euler-Charakteristik"
                        },
                        "group": "report",
                        "order": 90
                      }
                    },
                    "genus": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "int64",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Genus",
                          "de": "Geschlecht"
                        },
                        "description": {
                          "en": "Topological genus of a closed 2-manifold.",
                          "de": "Topologisches Geschlecht einer geschlossenen 2-Mannigfaltigkeit."
                        },
                        "group": "report",
                        "order": 100
                      }
                    },
                    "signedVolume": {
                      "type": "number",
                      "format": "double",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Signed Volume",
                          "de": "Vorzeichenbehaftetes Volumen"
                        },
                        "group": "report",
                        "order": 110
                      }
                    },
                    "selfIntersectionPairs": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Self-Intersection Pairs",
                          "de": "Selbstüberschneidungspaare"
                        },
                        "group": "report",
                        "order": 120
                      }
                    },
                    "closedFallbackUsed": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Closing Fallback Used",
                          "de": "Schließ-Rückfall verwendet"
                        },
                        "group": "report",
                        "order": 130
                      }
                    },
                    "isClosed": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Closed",
                          "de": "Geschlossen"
                        },
                        "group": "report",
                        "order": 140
                      }
                    },
                    "isTwoManifold": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "2-Manifold",
                          "de": "2-Mannigfaltig"
                        },
                        "group": "report",
                        "order": 150
                      }
                    },
                    "isWatertight": {
                      "type": "boolean",
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Watertight",
                          "de": "Wasserdicht"
                        },
                        "group": "report",
                        "order": 160
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ],
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Watertightness Report",
                  "de": "Wasserdichtheitsbericht"
                },
                "description": {
                  "en": "Derived from the mesh by the reconstruction; not edited by hand.",
                  "de": "Von der Rekonstruktion aus dem Mesh abgeleitet; wird nicht von Hand bearbeitet."
                },
                "group": "report",
                "order": 40
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Mesh",
          "de": "Mesh"
        },
        "description": {
          "en": "Reconstructed mesh; empty keeps the stored mesh.",
          "de": "Rekonstruiertes Mesh; leer behält das gespeicherte Mesh."
        },
        "group": "result",
        "order": 30
      }
    },
    "geo": {
      "anyOf": [
        {
          "type": "object",
          "title": "GeoProducts",
          "additionalProperties": false,
          "required": [
            "dsmAssetId",
            "dtmAssetId",
            "orthoAssetId"
          ],
          "properties": {
            "dsmAssetId": {
              "type": [
                "string",
                "null"
              ],
              "x-semio-ui": {
                "widget": "reference",
                "role": "target",
                "label": {
                  "en": "DSM Raster",
                  "de": "DOM-Raster"
                },
                "description": {
                  "en": "Digital surface model raster.",
                  "de": "Raster des digitalen Oberflächenmodells."
                },
                "ref": {
                  "kind": "asset",
                  "domain": "assets",
                  "granularity": "asset"
                },
                "group": "result",
                "order": 10
              }
            },
            "dtmAssetId": {
              "type": [
                "string",
                "null"
              ],
              "x-semio-ui": {
                "widget": "reference",
                "role": "target",
                "label": {
                  "en": "DTM Raster",
                  "de": "DGM-Raster"
                },
                "description": {
                  "en": "Digital terrain model raster.",
                  "de": "Raster des digitalen Geländemodells."
                },
                "ref": {
                  "kind": "asset",
                  "domain": "assets",
                  "granularity": "asset"
                },
                "group": "result",
                "order": 20
              }
            },
            "orthoAssetId": {
              "type": [
                "string",
                "null"
              ],
              "x-semio-ui": {
                "widget": "reference",
                "role": "target",
                "label": {
                  "en": "Orthophoto",
                  "de": "Orthofoto"
                },
                "description": {
                  "en": "True orthophoto raster.",
                  "de": "Raster des Orthofotos."
                },
                "ref": {
                  "kind": "asset",
                  "domain": "assets",
                  "granularity": "asset"
                },
                "group": "result",
                "order": 30
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Geo Products",
          "de": "Geoprodukte"
        },
        "description": {
          "en": "DSM, DTM and orthophoto rasters produced by the run.",
          "de": "Vom Lauf erzeugte DOM-, DGM- und Orthofoto-Raster."
        },
        "group": "result",
        "order": 40
      }
    },
    "qc": {
      "anyOf": [
        {
          "type": "object",
          "title": "QcReportSnapshot",
          "additionalProperties": false,
          "required": [
            "reprojectionRmsPx",
            "gcpCheckpointRmse",
            "watertight",
            "meanTrackLength",
            "registeredFrameRatio",
            "denseCoverageRatio",
            "warnings"
          ],
          "properties": {
            "reprojectionRmsPx": {
              "type": "number",
              "format": "double",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Reprojection RMS (px)",
                  "de": "RMS des Rückprojektionsfehlers (px)"
                },
                "description": {
                  "en": "Computed by the reconstruction run; not edited by hand.",
                  "de": "Vom Rekonstruktionslauf berechnet; wird nicht von Hand bearbeitet."
                },
                "group": "report",
                "order": 10
              }
            },
            "gcpCheckpointRmse": {
              "type": [
                "number",
                "null"
              ],
              "format": "double",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Checkpoint RMSE",
                  "de": "RMSE der Kontrollpunkte"
                },
                "description": {
                  "en": "Root mean square error at the ground control checkpoints.",
                  "de": "Mittlerer quadratischer Fehler an den Kontrollpunkten."
                },
                "group": "report",
                "order": 20
              }
            },
            "watertight": {
              "anyOf": [
                {
                  "type": "object",
                  "title": "WatertightReportSnapshot",
                  "additionalProperties": false,
                  "required": [
                    "vertexCount",
                    "triangleCount",
                    "boundaryEdgeCount",
                    "boundaryLoopCount",
                    "nonManifoldEdgeCount",
                    "nonManifoldVertexCount",
                    "connectedComponents",
                    "consistentlyOriented",
                    "eulerCharacteristic",
                    "genus",
                    "signedVolume",
                    "selfIntersectionPairs",
                    "closedFallbackUsed",
                    "isClosed",
                    "isTwoManifold",
                    "isWatertight"
                  ],
                  "properties": {
                    "vertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Vertex Count",
                          "de": "Anzahl der Eckpunkte"
                        },
                        "group": "report",
                        "order": 10
                      }
                    },
                    "triangleCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Triangle Count",
                          "de": "Anzahl der Dreiecke"
                        },
                        "group": "report",
                        "order": 20
                      }
                    },
                    "boundaryEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0,
                      "x-semio-ui": {
                        "widget": "hidden",
                        "role": "value",
                        "label": {
                          "en": "Boundary Edges",
