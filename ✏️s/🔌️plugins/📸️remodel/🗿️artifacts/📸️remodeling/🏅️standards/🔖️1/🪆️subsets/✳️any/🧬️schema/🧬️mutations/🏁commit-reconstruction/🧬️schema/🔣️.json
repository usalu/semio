{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/1/any/mutation/commit-reconstruction/schema.json",
  "title": "CommitReconstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assets",
    "geo",
    "job",
    "mesh",
    "qc",
    "sparse",
    "trajectory"
  ],
  "properties": {
    "job": {
      "type": "object",
      "title": "ReconstructionJob",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "progress01",
        "cancelRequested",
        "stageCursor",
        "startedAtMs",
        "error",
        "cameraPosesPreview",
        "sparsePointCloudPreview"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "title": "ReconstructionStage",
          "enum": [
            "idle",
            "ingesting",
            "calibrating",
            "extracting-features",
            "matching-features",
            "estimating-poses",
            "bundle-adjusting",
            "georeferencing",
            "dense-stereo",
            "fusing-volume",
            "extracting-surface",
            "cleaning-mesh",
            "texturing",
            "tracking-motion",
            "deriving-geo-products",
            "reporting-qc",
            "done",
            "failed"
          ]
        },
        "progress01": {
          "type": "number",
          "format": "float"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "stageCursor": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startedAtMs": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "cameraPosesPreview": {
          "type": "array",
          "items": {
            "type": "object",
            "title": "CameraPosePreview",
            "additionalProperties": false,
            "required": [
              "cameraId",
              "rotationWxyz",
              "translation"
            ],
            "properties": {
              "cameraId": {
                "type": "string"
              },
              "rotationWxyz": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "translation": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        "sparsePointCloudPreview": {
          "type": "string",
          "format": "base64",
          "description": "base64 of little-endian f32 lanes (semio_s_plugin_remodel PackedF32)"
        }
      }
    },
    "sparse": {
      "anyOf": [
        {
          "type": "object",
          "title": "SparseCloud",
          "additionalProperties": false,
          "required": [
            "points",
            "colors"
          ],
          "properties": {
            "points": {
              "type": "string",
              "format": "base64",
              "description": "base64 of little-endian f32 lanes (semio_s_plugin_remodel PackedF32)"
            },
            "colors": {
              "type": [
                "string",
                "null"
              ],
              "format": "base64",
              "description": "base64 of raw u8 lanes (semio_s_plugin_remodel PackedU8)"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "trajectory": {
      "anyOf": [
        {
          "type": "object",
          "title": "CameraTrajectory",
          "additionalProperties": false,
          "required": [
            "poses"
          ],
          "properties": {
            "poses": {
              "type": "array",
              "items": {
                "type": "object",
                "title": "CameraPosePreview",
                "additionalProperties": false,
                "required": [
                  "cameraId",
                  "rotationWxyz",
                  "translation"
                ],
                "properties": {
                  "cameraId": {
                    "type": "string"
                  },
                  "rotationWxyz": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "format": "float"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "translation": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "format": "float"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "mesh": {
      "anyOf": [
        {
          "type": "object",
          "title": "RemodelingMesh",
          "additionalProperties": false,
          "required": [
            "mesh",
            "source",
            "textureAssetId",
            "watertight"
          ],
          "properties": {
            "mesh": {
              "type": "object",
              "title": "RemodelingMeshChild",
              "description": "store::ArtifactChild<SemioMeshSnapshot> — an owned child handle; only childId and target cross the wire.",
              "additionalProperties": false,
              "required": [
                "childId",
                "target"
              ],
              "properties": {
                "childId": {
                  "type": "string"
                },
                "target": {
                  "type": "object",
                  "title": "ArtifactRef",
                  "additionalProperties": false,
                  "required": [
                    "artifactId",
                    "dialect"
                  ],
                  "properties": {
                    "artifactId": {
                      "type": "string"
                    },
                    "dialect": {
                      "type": "object",
                      "title": "ArtifactDialect",
                      "additionalProperties": false,
                      "required": [
                        "artifactKind",
                        "standard",
                        "subset"
                      ],
                      "properties": {
                        "artifactKind": {
                          "type": "string"
                        },
                        "standard": {
                          "type": "string"
                        },
                        "subset": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "source": {
              "type": "string",
              "title": "MeshSource",
              "enum": [
                "placeholder",
                "reconstructed",
                "imported"
              ]
            },
            "textureAssetId": {
              "type": [
                "string",
                "null"
              ]
            },
            "watertight": {
              "anyOf": [
                {
                  "type": "object",
                  "title": "WatertightReportSnapshot",
                  "additionalProperties": false,
                  "required": [
                    "vertexCount",
                    "triangleCount",
                    "boundaryEdgeCount",
                    "boundaryLoopCount",
                    "nonManifoldEdgeCount",
                    "nonManifoldVertexCount",
                    "connectedComponents",
                    "consistentlyOriented",
                    "eulerCharacteristic",
                    "genus",
                    "signedVolume",
                    "selfIntersectionPairs",
                    "closedFallbackUsed",
                    "isClosed",
                    "isTwoManifold",
                    "isWatertight"
                  ],
                  "properties": {
                    "vertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "triangleCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "boundaryEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "boundaryLoopCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "nonManifoldEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "nonManifoldVertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "connectedComponents": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "consistentlyOriented": {
                      "type": "boolean"
                    },
                    "eulerCharacteristic": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "genus": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "int64"
                    },
                    "signedVolume": {
                      "type": "number",
                      "format": "double"
                    },
                    "selfIntersectionPairs": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "uint32",
                      "minimum": 0
                    },
                    "closedFallbackUsed": {
                      "type": "boolean"
                    },
                    "isClosed": {
                      "type": "boolean"
                    },
                    "isTwoManifold": {
                      "type": "boolean"
                    },
                    "isWatertight": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "geo": {
      "anyOf": [
        {
          "type": "object",
          "title": "GeoProducts",
          "additionalProperties": false,
          "required": [
            "dsmAssetId",
            "dtmAssetId",
            "orthoAssetId"
          ],
          "properties": {
            "dsmAssetId": {
              "type": [
                "string",
                "null"
              ]
            },
            "dtmAssetId": {
              "type": [
                "string",
                "null"
              ]
            },
            "orthoAssetId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "qc": {
      "anyOf": [
        {
          "type": "object",
          "title": "QcReportSnapshot",
          "additionalProperties": false,
          "required": [
            "reprojectionRmsPx",
            "gcpCheckpointRmse",
            "watertight",
            "meanTrackLength",
            "registeredFrameRatio",
            "denseCoverageRatio",
            "warnings"
          ],
          "properties": {
            "reprojectionRmsPx": {
              "type": "number",
              "format": "double"
            },
            "gcpCheckpointRmse": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "watertight": {
              "anyOf": [
                {
                  "type": "object",
                  "title": "WatertightReportSnapshot",
                  "additionalProperties": false,
                  "required": [
                    "vertexCount",
                    "triangleCount",
                    "boundaryEdgeCount",
                    "boundaryLoopCount",
                    "nonManifoldEdgeCount",
                    "nonManifoldVertexCount",
                    "connectedComponents",
                    "consistentlyOriented",
                    "eulerCharacteristic",
                    "genus",
                    "signedVolume",
                    "selfIntersectionPairs",
                    "closedFallbackUsed",
                    "isClosed",
                    "isTwoManifold",
                    "isWatertight"
                  ],
                  "properties": {
                    "vertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "triangleCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "boundaryEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "boundaryLoopCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "nonManifoldEdgeCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "nonManifoldVertexCount": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "connectedComponents": {
                      "type": "integer",
                      "format": "uint32",
                      "minimum": 0
                    },
                    "consistentlyOriented": {
                      "type": "boolean"
                    },
                    "eulerCharacteristic": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "genus": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "int64"
                    },
                    "signedVolume": {
                      "type": "number",
                      "format": "double"
                    },
                    "selfIntersectionPairs": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "format": "uint32",
                      "minimum": 0
                    },
                    "closedFallbackUsed": {
                      "type": "boolean"
                    },
                    "isClosed": {
                      "type": "boolean"
                    },
                    "isTwoManifold": {
                      "type": "boolean"
                    },
                    "isWatertight": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "meanTrackLength": {
              "type": "number",
              "format": "float"
            },
            "registeredFrameRatio": {
              "type": "number",
              "format": "float"
            },
            "denseCoverageRatio": {
              "type": "number",
              "format": "float"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "ReconstructionAssetCommit",
        "additionalProperties": false,
        "required": [
          "id",
          "asset"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "asset": {
            "type": "object",
            "title": "ImageAsset",
            "additionalProperties": false,
            "required": [
              "mime",
              "data",
              "width",
              "height"
            ],
            "properties": {
              "mime": {
                "type": "string"
              },
              "data": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "height": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
