{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "controller",
    "documentSchema",
    "factory",
    "limits",
    "publicationContracts",
    "routes",
    "oracle"
  ],
  "properties": {
    "controller": {
      "const": "s.remodel.remodeling@1/*#editor"
    },
    "documentSchema": {
      "const": "remodeling.scene"
    },
    "factory": {
      "const": "RemodelingRetainedCommandJobFactory"
    },
    "limits": {
      "type": "object",
      "required": [
        "bounded"
      ],
      "properties": {
        "bounded": {
          "$ref": "#/$defs/contract"
        }
      },
      "additionalProperties": false
    },
    "publicationContracts": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "required": [
          "toolId",
          "lanes"
        ],
        "properties": {
          "toolId": {
            "type": "string",
            "minLength": 1
          },
          "lanes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "enum": [
                "hostOnly",
                "artifact",
                "config"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "required": [
          "id",
          "execution",
          "feature"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "const": "bounded"
          },
          "feature": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "oracle": {
      "type": "object",
      "required": [
        "library",
        "scope",
        "ownedInterface",
        "runtimeDependency",
        "expected"
      ],
      "properties": {
        "library": {
          "const": "serde_json"
        },
        "scope": {
          "const": "test-only-existing-dependency"
        },
        "ownedInterface": {
          "const": "RemodelingRetainedCatalogOracle"
        },
        "runtimeDependency": {
          "const": false
        },
        "expected": {
          "type": "object",
          "required": [
            "routes",
            "bounded",
            "resumable",
            "unique"
          ],
          "properties": {
            "routes": {
              "const": 42
            },
            "bounded": {
              "const": 42
            },
            "resumable": {
              "const": 0
            },
            "unique": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "required": [
        "maxRawBytes",
        "maxDecodedItems",
        "maxWorkUnitsPerStep",
        "maxOutputBytes",
        "maxStepMicros"
      ],
      "properties": {
        "maxRawBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxDecodedItems": {
          "type": "integer",
          "minimum": 1
        },
        "maxWorkUnitsPerStep": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxStepMicros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7999
        },
        "maxCheckpointBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxInFlightPages": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
