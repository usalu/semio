        "id",
        "streams",
        "assets",
        "durableArtifacts",
        "calibration",
        "params",
        "gcps",
        "job",
        "results"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "streams": {
          "type": "array",
