      }
    },
    "RemodelingMediaStreamList": {
      "type": "object",
      "title": "RemodelingMediaStreamList",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/MediaStream"
          }
        }
      }
    }
  }
}
