{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/diff.json",
  "title": "RemodelingDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemodelingArtifact"
