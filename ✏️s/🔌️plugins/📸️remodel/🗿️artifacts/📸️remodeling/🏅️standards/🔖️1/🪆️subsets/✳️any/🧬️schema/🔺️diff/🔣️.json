          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    },
    "results": {
      "anyOf": [
        {
          "$ref": "https://semio.tech/schema/s/remodel/remodeling/artifact.json#/$defs/ReconstructionResults"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    }
