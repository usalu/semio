{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remodeling.reconstruction.run.v1",
  "title": "Remodeling Reconstruction Run",
  "description": "Source of record for the remodeling reconstruction ToolRunDefinition (📋️tool-run-contract.md §2.4). The run is mutating: every sparse cloud, mesh and raster it produces is a provisional append-content op, and one commit-reconstruction op binds them; nothing reaches the document before finalize. One unit of fuel is one pipeline decision that produced visible evidence (a frame verdict, a feature set, a batch of match verdicts, a camera, triangulated or pruned points, a depth map, a dense point batch, one product op). The checkpoint layout is `checkpoint`.",
  "$ref": "https://json.schemas.assets.semio-tech.com/framework/tool-run/schema.json#/$defs/ToolRunDefinition",
  "x-semio-toolRun": {
    "toolId": "reconstruction",
    "label": { "en": "Reconstruction", "de": "Rekonstruktion" },
    "mutating": true,
    "rebase": "revalidate",
    "reconfigure": "resume",
    "unit": { "en": "decisions", "de": "Entscheidungen" },
    "trace": "instance3d",
    "runJob": "remodeling.reconstruction.run",
    "revalidateJob": "remodeling.reconstruction.revalidate",
    "traceMeshLane": ["remodeling-trace-point", "remodeling-trace-camera"],
    "stages": [
      { "id": "ingest", "en": "Ingesting frames", "de": "Bilder werden eingelesen" },
      { "id": "features", "en": "Extracting features", "de": "Merkmale werden extrahiert" },
      { "id": "matching", "en": "Matching features", "de": "Merkmale werden zugeordnet" },
      { "id": "poses", "en": "Estimating camera poses", "de": "Kameraposen werden geschätzt" },
      { "id": "bundle", "en": "Bundle adjusting", "de": "Bündelausgleich" },
      { "id": "dense", "en": "Dense stereo", "de": "Dichtes Stereo" },
      { "id": "fusion", "en": "Fusing the volume", "de": "Volumen wird fusioniert" },
      { "id": "surface", "en": "Extracting the surface", "de": "Oberfläche wird extrahiert" },
      { "id": "texturing", "en": "Texturing", "de": "Texturierung" },
      { "id": "products", "en": "Preparing the result", "de": "Ergebnis wird vorbereitet" }
    ],
    "counters": [
      { "id": "framesAccepted", "en": "Frames accepted", "de": "Angenommene Bilder" },
      { "id": "framesRejected", "en": "Frames rejected", "de": "Verworfene Bilder" },
      { "id": "keypoints", "en": "Keypoints", "de": "Schlüsselpunkte" },
      { "id": "matchesAccepted", "en": "Matches accepted", "de": "Angenommene Zuordnungen" },
      { "id": "matchesRejected", "en": "Matches rejected", "de": "Verworfene Zuordnungen" },
      { "id": "cameras", "en": "Cameras registered", "de": "Registrierte Kameras" },
      { "id": "sparsePoints", "en": "Sparse points", "de": "Dünne Punkte" },
      { "id": "densePoints", "en": "Dense points", "de": "Dichte Punkte" }
    ],
    "reasons": [
      { "code": 0, "id": "frameAccepted", "verdict": "success", "args": ["frame"], "en": "Frame {0} accepted", "de": "Bild {0} angenommen" },
      { "code": 1, "id": "frameSkipped", "verdict": "warning", "args": ["frame"], "en": "Frame {0} skipped by the sampling stride or frame limit", "de": "Bild {0} durch Abtastschritt oder Bildgrenze übersprungen" },
      { "code": 2, "id": "frameBlurred", "verdict": "warning", "args": ["frame"], "en": "Frame {0} rejected as too blurred", "de": "Bild {0} als zu unscharf verworfen" },
      { "code": 3, "id": "frameUnreadable", "verdict": "danger", "args": ["frame"], "en": "Frame {0} could not be decoded", "de": "Bild {0} konnte nicht dekodiert werden" },
      { "code": 4, "id": "featuresExtracted", "verdict": "success", "args": ["frame", "keypoints"], "en": "Frame {0}: {1} keypoints", "de": "Bild {0}: {1} Schlüsselpunkte" },
      { "code": 5, "id": "matchAccepted", "verdict": "success", "args": ["frameA", "frameB"], "en": "Match between frames {0} and {1} accepted", "de": "Zuordnung zwischen Bild {0} und {1} angenommen" },
      { "code": 6, "id": "matchAmbiguous", "verdict": "warning", "args": ["frameA", "frameB"], "en": "Match between frames {0} and {1} rejected by the ratio test", "de": "Zuordnung zwischen Bild {0} und {1} durch den Verhältnistest verworfen" },
      { "code": 7, "id": "matchAsymmetric", "verdict": "danger", "args": ["frameA", "frameB"], "en": "Match between frames {0} and {1} rejected by the cross check", "de": "Zuordnung zwischen Bild {0} und {1} durch die Kreuzprüfung verworfen" },
      { "code": 8, "id": "pairMatched", "verdict": "success", "args": ["frameA", "frameB", "matches"], "en": "Frames {0} and {1}: {2} matches", "de": "Bilder {0} und {1}: {2} Zuordnungen" },
      { "code": 9, "id": "tracksBuilt", "verdict": "success", "args": ["tracks"], "en": "{0} feature tracks built", "de": "{0} Merkmalsspuren gebildet" },
      { "code": 10, "id": "cameraRegistered", "verdict": "success", "args": ["frame"], "en": "Camera of frame {0} registered", "de": "Kamera von Bild {0} registriert" },
      { "code": 11, "id": "cameraRejected", "verdict": "warning", "args": ["frame"], "en": "Camera of frame {0} could not be registered", "de": "Kamera von Bild {0} konnte nicht registriert werden" },
      { "code": 12, "id": "pointsTriangulated", "verdict": "success", "args": ["points"], "en": "{0} points triangulated", "de": "{0} Punkte trianguliert" },
      { "code": 13, "id": "pointsPruned", "verdict": "danger", "args": ["points"], "en": "{0} points pruned by their reprojection error", "de": "{0} Punkte wegen ihres Reprojektionsfehlers entfernt" },
      { "code": 14, "id": "depthMapEstimated", "verdict": "success", "args": ["view", "samples"], "en": "Depth map {0}: {1} valid samples", "de": "Tiefenkarte {0}: {1} gültige Stichproben" },
      { "code": 15, "id": "denseCloudFused", "verdict": "success", "args": ["points"], "en": "{0} dense points fused", "de": "{0} dichte Punkte fusioniert" },
      { "code": 16, "id": "denseTraceCapped", "verdict": "warning", "args": ["shown", "points"], "en": "Showing {0} of {1} dense points", "de": "{0} von {1} dichten Punkten werden gezeigt" },
      { "code": 17, "id": "meshExtracted", "verdict": "success", "args": ["vertices", "triangles"], "en": "Mesh with {0} vertices and {1} triangles extracted", "de": "Netz mit {0} Eckpunkten und {1} Dreiecken extrahiert" },
      { "code": 18, "id": "meshOutsideEnvelope", "verdict": "warning", "args": ["vertices", "triangles"], "en": "Mesh with {0} vertices and {1} triangles exceeds the storable envelope and is not kept", "de": "Netz mit {0} Eckpunkten und {1} Dreiecken überschreitet die speicherbare Grenze und wird nicht behalten" },
      { "code": 19, "id": "sparseCapped", "verdict": "warning", "args": ["kept", "points"], "en": "Keeping {0} of {1} sparse points", "de": "{0} von {1} dünnen Punkten werden behalten" },
      { "code": 20, "id": "contentPrepared", "verdict": "success", "args": ["leaves", "bytes"], "en": "Content of {0} leaves ({1} bytes) prepared", "de": "Inhalt aus {0} Blättern ({1} Bytes) vorbereitet" },
      { "code": 21, "id": "resultReady", "verdict": "success", "args": ["ops"], "en": "Result ready: {0} provisional changes", "de": "Ergebnis bereit: {0} vorläufige Änderungen" },
      { "code": 22, "id": "tooFewFrames", "verdict": "danger", "args": ["accepted"], "en": "Only {0} frames accepted; at least 2 are needed", "de": "Nur {0} Bilder angenommen; mindestens 2 werden benötigt" },
      { "code": 23, "id": "pipelineFailed", "verdict": "danger", "args": ["stage"], "en": "Reconstruction failed in stage {0}", "de": "Rekonstruktion in Stufe {0} fehlgeschlagen" },
      { "code": 24, "id": "rasterFailed", "verdict": "danger", "args": [], "en": "A terrain raster could not be encoded", "de": "Ein Geländeraster konnte nicht kodiert werden" },
      { "code": 25, "id": "resuming", "verdict": "success", "args": ["decisions"], "en": "Resumed after {0} decisions", "de": "Nach {0} Entscheidungen fortgesetzt" },
      { "code": 26, "id": "inputsChanged", "verdict": "danger", "args": ["ops"], "en": "Frames, parameters or calibration changed since the run started; {0} provisional changes withdrawn", "de": "Bilder, Parameter oder Kalibrierung haben sich seit dem Start geändert; {0} vorläufige Änderungen zurückgezogen" }
    ],
    "checkpoint": {
      "bytes": 84,
      "littleEndian": ["baseRevision:bytes32", "inputs:u64x4", "inputsLength:u64", "decisions:u64", "provisionalOps:u32"]
    }
  }
}
