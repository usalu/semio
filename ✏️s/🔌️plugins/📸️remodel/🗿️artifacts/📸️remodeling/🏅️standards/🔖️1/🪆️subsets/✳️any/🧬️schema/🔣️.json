{
  "$id": "https://semio.tech/schema/s/remodeling/remodeling/artifact.json",
  "title": "RemodelingArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "streams",
    "assets",
    "calibration",
    "params",
    "gcps",
    "job",
    "results",
    "selection",
    "activeUtilityId",
    "reportTable",
    "frameCursor",
    "camera",
    "layers",
    "locale"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MediaStream"
      },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ImageAsset"
      },
      "x-semio-state": "artifact"
    },
    "calibration": {
      "$ref": "#/$defs/CalibrationState",
      "x-semio-state": "artifact"
    },
    "params": {
      "$ref": "#/$defs/ReconstructionParams",
      "x-semio-state": "artifact"
    },
    "gcps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GroundControlPoint"
      },
      "x-semio-state": "artifact"
    },
    "job": {
      "$ref": "#/$defs/ReconstructionJob",
      "x-semio-state": "artifact"
    },
    "results": {
      "$ref": "#/$defs/ReconstructionResults",
      "x-semio-state": "artifact"
    },
    "selection": {
      "$ref": "#/$defs/RemodelingUiSelection",
      "x-semio-state": "presence"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "reportTable": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "frameCursor": {
      "$ref": "#/$defs/RemodelingUiFrameCursor",
      "x-semio-state": "presence"
    },
    "camera": {
      "$ref": "#/$defs/RemodelingUiCamera",
      "x-semio-state": "config"
    },
    "layers": {
      "$ref": "#/$defs/RemodelingUiLayers",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "MediaStream": {
      "type": "object",
      "title": "MediaStream"
    },
    "ImageAsset": {
      "type": "object",
      "title": "ImageAsset"
    },
    "CalibrationState": {
      "type": "object",
      "title": "CalibrationState"
    },
    "ReconstructionParams": {
      "type": "object",
      "title": "ReconstructionParams"
    },
    "GroundControlPoint": {
      "type": "object",
      "title": "GroundControlPoint"
    },
    "ReconstructionJob": {
      "type": "object",
      "title": "ReconstructionJob"
    },
    "ReconstructionResults": {
      "type": "object",
      "title": "ReconstructionResults"
    },
    "RemodelingUiCamera": {
      "type": "object",
      "title": "RemodelingUiCamera",
      "required": [
        "position",
        "target",
        "fov"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "fov": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "RemodelingUiSelection": {
      "type": "object",
      "title": "RemodelingUiSelection",
      "required": [
        "mode",
        "ids"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RemodelingUiLayers": {
      "type": "object",
      "title": "RemodelingUiLayers",
      "required": [
        "mesh",
        "dense",
        "sparse",
        "cameras",
        "gcps"
      ],
      "properties": {
        "mesh": {
          "type": "boolean"
        },
        "dense": {
          "type": "boolean"
        },
        "sparse": {
          "type": "boolean"
        },
        "cameras": {
          "type": "boolean"
        },
        "gcps": {
          "type": "boolean"
        }
      }
    },
    "RemodelingUiFrameCursor": {
      "type": "object",
      "title": "RemodelingUiFrameCursor",
      "required": [
        "frameIndex"
      ],
      "properties": {
        "streamId": {
          "type": "string"
        },
        "frameIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "RemodelingMediaStreamList": {
      "type": "object",
      "title": "RemodelingMediaStreamList",
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MediaStream"
          }
        }
      }
    },
    "RemodelingGcpList": {
      "type": "object",
      "title": "RemodelingGcpList",
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroundControlPoint"
          }
        }
      }
    },
    "RemodelingArtifact": {
      "type": "object",
      "title": "RemodelingArtifact"
    }
  }
}
