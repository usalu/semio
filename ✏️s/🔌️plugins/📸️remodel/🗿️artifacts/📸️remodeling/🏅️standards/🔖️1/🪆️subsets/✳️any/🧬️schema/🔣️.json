{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/artifact.json",
  "title": "RemodelingArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MediaStream"
      },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RemodelingAssetChild"
      },
      "x-semio-state": "artifact"
    },
    "durableArtifacts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/RemodelingDurableArtifact"
      },
      "x-semio-state": "artifact"
    },
    "calibration": {
      "$ref": "#/$defs/CalibrationState",
      "x-semio-state": "artifact"
    },
    "params": {
      "$ref": "#/$defs/ReconstructionParams",
      "x-semio-state": "artifact"
    },
    "gcps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GroundControlPoint"
      },
      "x-semio-state": "artifact"
    },
    "results": {
      "$ref": "#/$defs/ReconstructionResults",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "ArtifactDialect": {
      "type": "object",
      "title": "ArtifactDialect",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "subset": {
          "type": "string"
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "title": "ArtifactRef",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "dialect"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "dialect": {
          "$ref": "#/$defs/ArtifactDialect"
        }
      }
    },
    "CalibrationState": {
      "type": "object",
      "title": "CalibrationState",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "cameras": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CameraCalibration"
          }
        },
        "rig": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RigExtrinsic"
          }
        }
      }
    },
    "CameraCalibration": {
      "type": "object",
      "title": "CameraCalibration",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "fx": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "fy": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "cx": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "cy": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "skew": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "distortion": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/Binary32Transport"
          }
        },
        "rmsReprojectionPx": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary32Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "CameraPosePreview": {
      "type": "object",
      "title": "CameraPosePreview",
      "additionalProperties": false,
      "required": [
        "cameraId",
        "rotationWxyz",
        "translation"
      ],
      "properties": {
        "cameraId": {
          "type": "string"
        },
        "rotationWxyz": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/Binary32Transport"
          }
        },
        "translation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Binary32Transport"
          }
        }
      }
    },
    "CameraTrajectory": {
      "type": "object",
      "title": "CameraTrajectory",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "poses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CameraPosePreview"
          }
        }
      }
    },
    "DenseCloud": {
      "type": "object",
      "title": "DenseCloud",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "positions": {
          "$ref": "#/$defs/Float32Buffer"
        },
        "colors": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteBuffer"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Float32Buffer"
            },
            {
              "type": "null"
            }
          ]
        },
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteBuffer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DenseParams": {
      "type": "object",
      "title": "DenseParams",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "resolution": {
          "$ref": "#/$defs/DenseResolution"
        },
        "windowRadiusPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "minViewConsistency": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "confidenceThreshold": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "maxPoints": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "DenseResolution": {
      "type": "string",
      "title": "DenseResolution",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "FeatureDetector": {
      "type": "string",
      "title": "FeatureDetector",
      "enum": [
        "orb",
        "akaze",
        "harris"
      ]
    },
    "FeatureParams": {
      "type": "object",
      "title": "FeatureParams",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "detector": {
          "$ref": "#/$defs/FeatureDetector"
        },
        "targetCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "octaves": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "edgeThreshold": {
          "$ref": "#/$defs/Binary32Transport"
        }
      }
    },
    "FrameRef": {
      "type": "object",
      "title": "FrameRef",
      "additionalProperties": false,
      "required": [
        "index",
        "timestampMs",
        "assetId"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "timestampMs": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "assetId": {
          "type": "string"
        }
      }
    },
    "GcpObservation": {
      "type": "object",
      "title": "GcpObservation",
      "additionalProperties": false,
      "required": [
        "streamId",
        "frameIndex",
        "pixel"
      ],
      "properties": {
        "streamId": {
          "type": "string"
        },
        "frameIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "pixel": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/Binary32Transport"
          }
        }
      }
    },
    "GeoParams": {
      "type": "object",
      "title": "GeoParams",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "originLon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "originLat": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "originAlt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "gsdM": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "dsmCellM": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "dtmFilterRadiusM": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "orthoMaxPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "GeoProducts": {
      "type": "object",
      "title": "GeoProducts",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "dsmAssetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "dtmAssetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "orthoAssetId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "GroundControlPoint": {
      "type": "object",
      "title": "GroundControlPoint",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "worldPosition": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Binary64Transport"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GcpObservation"
          }
        }
      }
    },
    "IngestParams": {
      "type": "object",
      "title": "IngestParams",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "frameSampleStride": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maxFrames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "downscaleLongEdgePx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "minSharpness": {
          "$ref": "#/$defs/Binary32Transport"
        }
      }
    },
    "MatchParams": {
      "type": "object",
      "title": "MatchParams",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "matcher": {
          "$ref": "#/$defs/MatcherKind"
        },
        "ratioTest": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "crossCheck": {
          "type": "boolean"
        },
        "sequentialWindow": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maxPairsPerFrame": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "loopClosure": {
          "type": "boolean"
        }
      }
    },
    "MatcherKind": {
      "type": "string",
      "title": "MatcherKind",
      "enum": [
        "brute-force",
        "kd-tree"
      ]
    },
    "MediaKind": {
      "type": "string",
      "title": "MediaKind",
      "enum": [
        "image-sequence",
        "video"
      ]
    },
    "MediaStream": {
      "type": "object",
      "title": "MediaStream",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "cameraId": {
          "type": [
            "string",
            "null"
          ]
        },
        "syncOffsetMs": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "fpsHint": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameRef"
          }
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoSource"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MeshParams": {
      "type": "object",
      "title": "MeshParams",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "tsdfVoxelSizeMm": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "tsdfTruncationMm": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "decimateTargetTriangles": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "smoothingIterations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "textureEnabled": {
          "type": "boolean"
        },
        "textureSize": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "guaranteeWatertight": {
          "type": "boolean"
        },
        "holeFillMaxBoundaryVerts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "selfIntersectionCheck": {
          "type": "boolean"
        }
      }
    },
    "MeshSource": {
      "type": "string",
      "title": "MeshSource",
      "enum": [
        "placeholder",
        "reconstructed",
        "imported"
      ]
    },
    "MotionParams": {
      "type": "object",
      "title": "MotionParams",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxTracks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "trackWindowPx": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "minTrackQuality": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "minTrackLengthFrames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "MotionTrackSummary": {
      "type": "object",
      "title": "MotionTrackSummary",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "class": {
          "$ref": "#/$defs/TrackClass"
        },
        "meanSpeedMS": {
          "$ref": "#/$defs/Binary32Transport"
        }
      }
    },
    "QcReportSnapshot": {
      "type": "object",
      "title": "QcReportSnapshot",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "reprojectionRmsPx": {
          "$ref": "#/$defs/Binary64Transport"
        },
        "gcpCheckpointRmse": {
          "anyOf": [
            {
              "$ref": "#/$defs/Binary64Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "watertight": {
          "anyOf": [
            {
              "$ref": "#/$defs/WatertightReportSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "meanTrackLength": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "registeredFrameRatio": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "denseCoverageRatio": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ReconstructionParams": {
      "type": "object",
      "title": "ReconstructionParams",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "ingest": {
          "$ref": "#/$defs/IngestParams"
        },
        "feature": {
          "$ref": "#/$defs/FeatureParams"
        },
        "matching": {
          "$ref": "#/$defs/MatchParams"
        },
        "sfm": {
          "$ref": "#/$defs/SfmParams"
        },
        "dense": {
          "$ref": "#/$defs/DenseParams"
        },
        "mesh": {
          "$ref": "#/$defs/MeshParams"
        },
        "motion": {
          "$ref": "#/$defs/MotionParams"
        },
        "geo": {
          "$ref": "#/$defs/GeoParams"
        }
      }
    },
    "ReconstructionResults": {
      "type": "object",
      "title": "ReconstructionResults",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "sparse": {
          "anyOf": [
            {
              "$ref": "#/$defs/SparseCloud"
            },
            {
              "type": "null"
            }
          ]
        },
        "dense": {
          "anyOf": [
            {
              "$ref": "#/$defs/DenseCloud"
            },
            {
              "type": "null"
            }
          ]
        },
        "mesh": {
          "$ref": "#/$defs/RemodelingMesh"
        },
        "trajectory": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraTrajectory"
            },
            {
              "type": "null"
            }
          ]
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MotionTrackSummary"
          }
        },
        "geo": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoProducts"
            },
            {
              "type": "null"
            }
          ]
        },
        "qc": {
          "anyOf": [
            {
              "$ref": "#/$defs/QcReportSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RemodelingAssetChild": {
      "type": "object",
      "title": "RemodelingAssetChild",
      "description": "store::ArtifactChild<SemioImageSnapshot> — an owned child handle; only childId and target cross the wire.",
      "additionalProperties": false,
      "required": [
        "childId",
        "target"
      ],
      "properties": {
        "childId": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ArtifactRef"
        }
      }
    },
    "RemodelingContentKind": {
      "type": "string",
      "title": "RemodelingContentKind",
      "enum": [
        "sparse",
        "mesh",
        "image"
      ]
    },
    "RemodelingDurableArtifact": {
      "type": "object",
      "title": "RemodelingDurableArtifact",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "kind": {
          "type": "string"
        },
        "mime": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ByteBuffer"
          }
        }
      }
    },
    "RemodelingMesh": {
      "type": "object",
      "title": "RemodelingMesh",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "mesh": {
          "$ref": "#/$defs/RemodelingMeshChild"
        },
        "source": {
          "$ref": "#/$defs/MeshSource"
        },
        "textureAssetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "watertight": {
          "anyOf": [
            {
              "$ref": "#/$defs/WatertightReportSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RemodelingMeshChild": {
      "type": "object",
      "title": "RemodelingMeshChild",
      "description": "store::ArtifactChild<SemioMeshSnapshot> — an owned child handle; only childId and target cross the wire.",
      "additionalProperties": false,
      "required": [
        "childId",
        "target"
      ],
      "properties": {
        "childId": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ArtifactRef"
        }
      }
    },
    "RigExtrinsic": {
      "type": "object",
      "title": "RigExtrinsic",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "cameraId": {
          "type": "string"
        },
        "rotationWxyz": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/Binary32Transport"
          }
        },
        "translationM": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Binary32Transport"
          }
        }
      }
    },
    "RobustLossKind": {
      "type": "string",
      "title": "RobustLossKind",
      "enum": [
        "l2",
        "huber",
        "cauchy"
      ]
    },
    "SfmParams": {
      "type": "object",
      "title": "SfmParams",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "ransacIterations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "ransacThresholdPx": {
          "$ref": "#/$defs/Binary32Transport"
        },
        "minTrackLength": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "baMaxIterations": {
          "type": "integer",
