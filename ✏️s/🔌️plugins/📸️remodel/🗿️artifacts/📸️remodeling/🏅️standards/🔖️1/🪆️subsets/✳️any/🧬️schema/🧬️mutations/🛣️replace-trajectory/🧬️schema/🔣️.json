{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/remodel/remodeling/1/any/mutation/replace-trajectory.json",
  "title": "ReplaceTrajectory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trajectory"
  ],
  "properties": {
    "trajectory": {
      "anyOf": [
        {
          "type": "object",
          "title": "CameraTrajectory",
          "additionalProperties": false,
          "required": [
            "poses"
          ],
          "properties": {
            "poses": {
              "type": "array",
              "items": {
                "type": "object",
                "title": "CameraPosePreview",
                "additionalProperties": false,
                "required": [
                  "cameraId",
                  "rotationWxyz",
                  "translation"
                ],
                "properties": {
                  "cameraId": {
                    "type": "string"
                  },
                  "rotationWxyz": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "format": "float"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "translation": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "format": "float"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
