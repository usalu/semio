{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/remodel/remodeling/mutation/replace-trajectory/schema.json",
  "title": "ReplaceTrajectory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "trajectory"
  ],
  "properties": {
    "mutation": {
      "const": "replaceTrajectory"
    },
    "trajectory": {
      "anyOf": [
        {
          "type": "object",
          "title": "CameraTrajectory",
          "additionalProperties": false,
          "required": [
            "poses"
          ],
          "properties": {
            "poses": {
              "type": "array",
              "items": {
                "type": "object",
                "title": "CameraPosePreview",
                "additionalProperties": false,
                "required": [
                  "cameraId",
                  "rotationWxyz",
                  "translation"
                ],
                "properties": {
                  "cameraId": {
                    "type": "string",
                    "x-semio-ui": {
                      "widget": "reference",
                      "role": "target",
                      "label": {
                        "en": "Camera",
                        "de": "Kamera"
                      },
                      "description": {
                        "en": "The camera this pose belongs to.",
                        "de": "Kamera, zu der diese Pose gehört."
                      },
                      "ref": {
                        "kind": "camera"
                      },
                      "group": "pose",
                      "order": 10
                    }
                  },
                  "rotationWxyz": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "format": "float"
                    },
                    "minItems": 4,
                    "maxItems": 4,
                    "x-semio-ui": {
                      "widget": "vector",
                      "role": "value",
                      "label": {
                        "en": "Rotation (Quaternion w, x, y, z)",
                        "de": "Rotation (Quaternion w, x, y, z)"
                      },
                      "description": {
                        "en": "Unit quaternion of the camera orientation.",
                        "de": "Einheitsquaternion der Kameraorientierung."
                      },
                      "step": 0.001,
                      "group": "pose",
                      "order": 20
                    }
                  },
                  "translation": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "format": "float"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "x-semio-ui": {
                      "widget": "vector",
                      "role": "value",
                      "label": {
                        "en": "Translation",
                        "de": "Translation"
                      },
                      "description": {
                        "en": "Camera position in reconstruction coordinates.",
                        "de": "Kameraposition in Rekonstruktionskoordinaten."
                      },
                      "step": 0.001,
                      "group": "pose",
                      "order": 30
                    }
                  }
                }
              },
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Camera Poses",
                  "de": "Kameraposen"
                },
                "group": "result",
                "order": 10
              }
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Camera Trajectory",
          "de": "Kameratrajektorie"
        },
        "description": {
          "en": "Recovered camera poses; empty clears the trajectory.",
          "de": "Rekonstruierte Kameraposen; leer entfernt die Trajektorie."
        },
        "group": "result",
        "order": 10
      }
    }
  }
}
