{
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "mime",
      "hex",
      "valid"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string"
      },
      "mime": {
        "type": [
          "string",
          "null"
        ]
      },
      "hex": {
        "type": "string",
        "pattern": "^([0-9a-f]{2})*$"
      },
      "valid": {
        "type": "boolean"
      }
    }
  }
}
