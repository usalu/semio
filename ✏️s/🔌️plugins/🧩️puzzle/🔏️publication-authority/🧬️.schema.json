{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.puzzle.publication-authority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "closePageBytes", "owners", "laws"],
  "properties": {
    "schema": { "const": "semio.puzzle.publication-authority.v1" },
    "closePageBytes": { "const": 16384 },
    "owners": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "source", "groups"],
        "properties": {
          "owner": { "enum": ["Puzzle2dPlayApp", "Puzzle3dPlayApp", "Puzzle5dPlayApp"] },
          "source": { "type": "string", "minLength": 1 },
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "lanes", "routes"],
              "properties": {
                "status": { "enum": ["Migrated", "BatchOnlyPendingRewrite"] },
                "lanes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["Artifact", "Config", "Draft", "Presence", "Transient", "Child", "HostOnly"] }
                },
                "routes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "blocker": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                {
                  "if": { "properties": { "status": { "const": "BatchOnlyPendingRewrite" } } },
                  "then": { "properties": { "blocker": {} }, "required": ["blocker"] },
                  "else": { "properties": { "blocker": {} }, "not": { "required": ["blocker"] } }
                }
              ]
            }
          }
        }
      }
    },
    "laws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationBeforeDecode", "contractBijection", "hostOnlyExclusive", "storeAuthorityRequired", "operationOwnedCursor", "boundedProgress", "cancellation", "freshnessValidation", "exactOwnerReturn", "incrementalClose", "terminalEmpty"],
      "properties": {
        "activationBeforeDecode": { "const": true },
        "contractBijection": { "const": true },
        "hostOnlyExclusive": { "const": true },
        "storeAuthorityRequired": { "const": true },
        "operationOwnedCursor": { "const": true },
        "boundedProgress": { "const": true },
        "cancellation": { "const": true },
        "freshnessValidation": { "const": true },
        "exactOwnerReturn": { "const": true },
        "incrementalClose": { "const": true },
        "terminalEmpty": { "const": true }
      }
    }
  }
}
