      },
      "x-semio-state": "shared-ui"
    },
    "cameraX": {
      "type": "number",
      "x-semio-state": "shared-ui"
    },
    "cameraY": {
      "type": "number",
      "x-semio-state": "shared-ui"
    },
    "cameraZoom": {
      "type": "number",
      "x-semio-state": "shared-ui"
    },
    "selectionMethod": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "shared-ui"
    }
  }
}
