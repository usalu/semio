{
  "name": "@semio-tech/puzzle-plugin",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/✏️s/🔌️plugins/🧩️puzzle/**/*.rs",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts wasm"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "fixtures-lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts fixtures lint",
        "forwardAllArgs": true
      }
    },
    "describe": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts describe",
        "forwardAllArgs": true
      }
    }
  }
}
