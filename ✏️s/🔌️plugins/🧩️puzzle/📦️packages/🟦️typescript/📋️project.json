{
  "name": "@semio-tech/puzzle-js",
  "$schema": "../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/✏️s/🔌️plugins/🧩️puzzle/🧪️tests/🎚️config/🟦️.ts",
      "{workspaceRoot}/✏️s/🧑‍💻dev/🧩️puzzle/🧪️tests/🔺️diff-parsers/🟦️.ts",
      "{workspaceRoot}/✏️s/🔌️plugins/🧩️puzzle/🧪️tests/🧫️fixtures/🔺️diff-records/🔣️.json"
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
