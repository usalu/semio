{
  "name": "@semio-tech/puzzle-js",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/✏️s/🔌️plugins/🧩️puzzle/🧪️tests/🎚️config/🟦️.ts",
      "{workspaceRoot}/✏️s/🧑‍💻dev/🧩️puzzle/🧪️tests/🔺️diff-parsers/🟦️.ts"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "publication-authority-audit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts publication-authority-audit",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "test-renderer-contract": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/✏️s/🔌️plugins/🧩️puzzle/**/*",
        "{workspaceRoot}/🧰️framework/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🧩️puzzle/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test renderer-contract",
        "forwardAllArgs": true
      }
    }
  }
}
