    "lhs": {"pattern":{"leftVar":"a","leftKind":"Part","edgeVar":"f","edgeKind":"Fastener","rightVar":"b","rightKind":"Part"}},
    "rhs": {"create":[{"leftVar":"a","leftKind":"Part","edgeVar":"new","edgeKind":"Fastener","rightVar":"c","rightKind":"Part"}],
      "delete":["f"],"merge":[],"parameters":[],
      "set":[{"var":"c","prop":"label","value":"New world part"},{"var":"new","prop":"gap","value":2}]}
  },
  "before": {
    "schema": "puzzle.5d",
    "domain": "architecture",
    "label": "Preserved",
    "meta": {"description": "Rewrite fixture"},
