{
  "rule": {
    "name": "Move and rename one part and extend its fastener",
    "lhs": {"pattern":{"leftVar":"a","leftKind":"Part","edgeVar":"f","edgeKind":"Fastener","rightVar":"b","rightKind":"Part"}},
    "rhs": {"create":[],"delete":[],"merge":[],"parameters":[{"name":"gap","kind":"number","default":7}],
      "set":[{"var":"a","prop":"name","value":"Renamed"},{"var":"a","prop":"x","value":3},{"var":"a","prop":"y","value":4},{"var":"f","prop":"gap","value":"$gap"}]}
  },
  "createRule": {
