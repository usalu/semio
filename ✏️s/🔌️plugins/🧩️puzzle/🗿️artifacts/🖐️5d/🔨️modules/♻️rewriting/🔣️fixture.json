    "parts": [
      {"id":"a","2d":{"x":3,"y":4,"text":"Renamed","width":5},"3d":{"origin":[1,2,3],"scale":[1,2,3],"label":"World A"},"grips":[{"id":"rim","gripKind":"port","2d":{"angle":0.5},"3d":{"position":[0,1,0]}}]},
      {"id":"b","2d":{"text":"B"},"grips":[{"id":"rim","gripKind":"port"}]}
    ],
    "fasteners": [{"id":"f","source":"a:rim","target":"b:rim","gap":7,"turn":0.5}],
    "targetVolumes": [{"id":"keep","origin":[2,4,6],"locked":true}]
