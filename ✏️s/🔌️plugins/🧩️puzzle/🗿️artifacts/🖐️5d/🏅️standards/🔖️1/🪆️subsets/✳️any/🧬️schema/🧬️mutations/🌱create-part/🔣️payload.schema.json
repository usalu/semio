{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreatePart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "part"
  ],
  "properties": {
    "part": {
      "title": "Puzzle5dPart",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "grips",
        "id",
        "part2d",
        "part3d",
        "partKind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "partKind": {
          "type": "string"
        },
        "anchor": {
          "type": "string",
          "enum": [
            "fixed",
            "derived"
          ]
        },
        "part2d": {
          "title": "Puzzle5dPart2d",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius",
            "shape",
            "text",
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "shape": {
              "type": "string"
            },
            "radius": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "text": {
              "type": "string"
            },
            "iconKind": {
              "type": "string"
            },
            "hidden": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            }
          }
        },
        "part3d": {
          "title": "Puzzle5dPart3d",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin"
          ],
          "properties": {
            "origin": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "meshUrl": {
              "type": "string"
            },
            "orientation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "scale": {
              "description": "any JSON value"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "grips": {
          "type": "array",
          "items": {
            "title": "Puzzle5dGrip",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "grip2d",
              "grip3d",
              "gripKind",
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "gripKind": {
                "type": "string"
              },
              "grip2d": {
                "title": "Puzzle5dGrip2d",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "angle",
                  "gripKind",
                  "radius"
                ],
                "properties": {
                  "angle": {
                    "type": "number"
                  },
                  "gripKind": {
                    "type": "string"
                  },
                  "radius": {
                    "type": "number"
                  }
                }
              },
              "grip3d": {
                "title": "Puzzle5dGrip3d",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "radius"
                ],
                "properties": {
                  "position": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "direction": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "radius": {
                    "type": "number"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
