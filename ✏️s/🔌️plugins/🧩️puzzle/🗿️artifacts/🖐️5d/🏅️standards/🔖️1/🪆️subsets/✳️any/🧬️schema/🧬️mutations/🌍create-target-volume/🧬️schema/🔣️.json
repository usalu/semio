{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle5d/mutation/create-target-volume/schema.json",
  "title": "CreateTargetVolume",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "targetVolume"
  ],
  "properties": {
    "mutation": {
      "const": "createTargetVolume"
    },
    "targetVolume": {
      "title": "Puzzle5dTargetVolume",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden",
        "id",
        "locked",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique target volume id in this puzzle.",
              "de": "Eindeutige Zielvolumen-ID in diesem Puzzle."
            },
            "group": "identity",
            "order": 10
          }
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Origin",
              "de": "Ursprung"
            },
            "unit": "m",
            "step": 0.1,
            "group": "pose",
            "order": 20,
            "snapSource": {
              "config": "gridSpacing"
            }
          }
        },
        "orientation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Orientation",
              "de": "Orientierung"
            },
            "description": {
              "en": "Unit quaternion (x, y, z, w); (0, 0, 0, 1) is no rotation.",
              "de": "Einheitsquaternion (x, y, z, w); (0, 0, 0, 1) ist keine Drehung."
            },
            "step": 0.01,
            "group": "pose",
            "order": 30
          }
        },
        "scale": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          ],
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Scale",
              "de": "Skalierung"
            },
            "description": {
              "en": "One factor for all three axes, or one factor per axis (x, y, z).",
              "de": "Ein Faktor für alle drei Achsen oder ein Faktor je Achse (x, y, z)."
            },
            "group": "pose",
            "order": 40
          }
        },
        "hidden": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Hidden",
              "de": "Ausgeblendet"
            },
            "group": "state",
            "order": 50
          }
        },
        "locked": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Locked",
              "de": "Gesperrt"
            },
            "group": "state",
            "order": 60
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Target volume",
          "de": "Zielvolumen"
        },
        "description": {
          "en": "The complete target volume record to add.",
          "de": "Das vollständige hinzuzufügende Zielvolumen."
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Index",
          "de": "Index"
        },
        "description": {
          "en": "Position in the list; the end when omitted.",
          "de": "Position in der Liste; ohne Angabe am Ende."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 20
      }
    }
  }
}
