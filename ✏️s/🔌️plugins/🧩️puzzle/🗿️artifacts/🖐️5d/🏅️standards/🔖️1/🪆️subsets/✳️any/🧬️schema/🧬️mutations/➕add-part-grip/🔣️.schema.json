      "type": "object",
      "additionalProperties": false,
      "required": [
        "grip2d",
        "grip3d",
        "gripKind",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "gripKind": {
          "type": "string"
        },
        "grip2d": {
          "title": "Puzzle5dGrip2d",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "angle",
            "gripKind",
            "radius"
          ],
          "properties": {
            "angle": {
              "type": "number"
            },
            "gripKind": {
              "type": "string"
            },
            "radius": {
              "type": "number"
            }
          }
        },
        "grip3d": {
          "title": "Puzzle5dGrip3d",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "radius"
          ],
          "properties": {
            "position": {
              "type": "array",
