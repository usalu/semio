{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AddPartGrip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grip",
    "partId"
  ],
  "properties": {
    "partId": {
      "type": "string"
    },
    "grip": {
