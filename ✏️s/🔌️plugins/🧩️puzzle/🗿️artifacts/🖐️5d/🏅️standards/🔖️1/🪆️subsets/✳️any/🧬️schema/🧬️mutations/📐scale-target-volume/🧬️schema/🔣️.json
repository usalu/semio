{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle5d/mutation/scale-target-volume/schema.json",
  "title": "ScaleTargetVolume",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id"
  ],
  "properties": {
    "mutation": {
      "const": "scaleTargetVolume"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Target volume",
          "de": "Zielvolumen"
        },
        "description": {
          "en": "The target volume this mutation addresses.",
          "de": "Das Zielvolumen, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "targetVolume",
          "domain": "vortex",
          "granularity": "targetVolume"
        },
        "group": "target",
        "order": 10
      }
    },
    "newScale": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Scale",
          "de": "Skalierung"
        },
        "description": {
          "en": "One factor for all three axes, or one factor per axis (x, y, z).",
          "de": "Ein Faktor für alle drei Achsen oder ein Faktor je Achse (x, y, z)."
        },
        "group": "pose",
        "order": 20
      }
    }
  }
}
