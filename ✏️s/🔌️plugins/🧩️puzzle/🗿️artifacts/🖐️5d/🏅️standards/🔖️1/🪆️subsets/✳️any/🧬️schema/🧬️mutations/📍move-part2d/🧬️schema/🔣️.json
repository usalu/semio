{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle5d/mutation/move-part2d/schema.json",
  "title": "MovePart2d",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newX",
    "newY"
  ],
  "properties": {
    "mutation": {
      "const": "movePart2d"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Part",
          "de": "Teil"
        },
        "description": {
          "en": "The part this mutation addresses.",
          "de": "Das Teil, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "part",
          "domain": "vortex",
          "granularity": "part"
        },
        "group": "target",
        "order": 10
      }
    },
    "newX": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "X",
          "de": "X"
        },
        "description": {
          "en": "Absolute final x on the board.",
          "de": "Absolute x-Endposition auf dem Brett."
        },
        "step": 1,
        "precision": 2,
        "snapSource": {
          "config": "gridFactor"
        },
        "group": "board",
        "order": 20
      }
    },
    "newY": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Y",
          "de": "Y"
        },
        "description": {
          "en": "Absolute final y on the board.",
          "de": "Absolute y-Endposition auf dem Brett."
        },
        "step": 1,
        "precision": 2,
        "snapSource": {
          "config": "gridFactor"
        },
        "group": "board",
        "order": 30
      }
    }
  }
}
