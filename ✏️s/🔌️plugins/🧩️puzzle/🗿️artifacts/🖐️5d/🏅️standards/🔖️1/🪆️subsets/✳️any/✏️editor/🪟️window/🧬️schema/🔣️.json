{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/puzzle/puzzle5d/window-ownership.json",
  "title": "Puzzle5dWindowOwnership",
  "definitions": {
    "Puzzle5dCamera2d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "Puzzle5dCamera3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "target", "zoom"],
      "properties": {
        "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "target": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "WorldSunConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "azimuth", "elevation", "intensity", "color"],
      "properties": {
        "enabled": { "type": "boolean" },
        "azimuth": { "type": "number" },
        "elevation": { "type": "number" },
        "intensity": { "type": "number" },
        "color": { "type": "string" }
      }
    },
    "Puzzle5dBoardWindowConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera2d", "fillCount", "lodMode", "suggestionOffset", "gridSnapEnabled", "gridFactor"],
      "properties": {
        "camera2d": { "$ref": "#/definitions/Puzzle5dCamera2d" },
        "fillCount": { "type": "integer", "minimum": 0 },
        "lodMode": { "type": "string" },
        "suggestionOffset": { "type": "number" },
        "gridSnapEnabled": { "type": "boolean" },
        "gridFactor": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "Puzzle5dWorldWindowConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera3d", "sun"],
      "properties": {
        "camera3d": { "$ref": "#/definitions/Puzzle5dCamera3d" },
        "sun": { "$ref": "#/definitions/WorldSunConfig" }
      }
    },
    "Puzzle5dWindowTransient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engagementInput", "brushCandidateIndex"],
      "properties": {
        "engagementInput": { "type": "string" },
        "brushCandidateIndex": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/Puzzle5dBoardWindowConfig" },
    { "$ref": "#/definitions/Puzzle5dWorldWindowConfig" },
    { "$ref": "#/definitions/Puzzle5dWindowTransient" }
  ]
}
