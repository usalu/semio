{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/puzzle/puzzle5d/snapshot.json",
  "title": "Puzzle5dSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "domain",
    "meta",
    "kindCompatibility",
    "parts",
    "fasteners"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "domain": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "label": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "meta": {
      "$ref": "https://semio.tech/schema/s/puzzle/puzzle5d/artifact.json#/$defs/Puzzle5dMeta",
      "x-semio-state": "artifact"
    },
    "kindCatalogs": {
      "$ref": "#/$defs/ArtifactChildHandle",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.kit"
    },
    "kindCatalogsExtra": {
      "$ref": "#/$defs/Puzzle5dKindCatalogsExtra",
      "x-semio-state": "artifact"
    },
    "kindCompatibility": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/puzzle/puzzle5d/artifact.json#/$defs/Puzzle5dKindCompatibility"
      },
      "x-semio-state": "artifact"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/puzzle/puzzle5d/artifact.json#/$defs/Puzzle5dPart"
      },
      "x-semio-state": "artifact"
    },
    "fasteners": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/puzzle/puzzle5d/artifact.json#/$defs/Puzzle5dFastener"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "ArtifactChildHandle": {
      "title": "ArtifactChildHandle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "childId",
        "target"
      ],
      "properties": {
        "childId": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    },
    "Puzzle5dKindCatalogsExtra": {
      "title": "Puzzle5dKindCatalogsExtra",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle5dCatalogPartKindExtra"
          }
        },
        "grips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle5dCatalogGripKindExtra"
          }
        },
        "fasteners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle5dCatalogFastenerKindExtra"
          }
        },
        "ropes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle5dCatalogRopeKindExtra"
          }
        }
      }
    },
    "Puzzle5dCatalogPartKindExtra": {
      "title": "Puzzle5dCatalogPartKindExtra",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "abstract": {
          "type": "boolean"
        },
        "baseKinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "representations": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/puzzle/puzzle5d/artifact.json#/$defs/Puzzle5dRepresentation"
          }
        },
        "grips": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/puzzle/puzzle5d/artifact.json#/$defs/Puzzle5dGripTemplate"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/puzzle/puzzle5d/artifact.json#/$defs/Puzzle5dAttribute"
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/puzzle/puzzle5d/artifact.json#/$defs/Puzzle5dAuthor"
          }
        }
      }
    },
    "Puzzle5dCatalogGripKindExtra": {
      "title": "Puzzle5dCatalogGripKindExtra",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "compatibleWith": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "defaultRopeKind": {
          "type": "string"
        }
      }
    },
    "Puzzle5dCatalogFastenerKindExtra": {
      "title": "Puzzle5dCatalogFastenerKindExtra",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "Puzzle5dCatalogRopeKindExtra": {
      "title": "Puzzle5dCatalogRopeKindExtra",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "defaultFastenerKind": {
          "type": "string"
        }
      }
    }
  }
}
