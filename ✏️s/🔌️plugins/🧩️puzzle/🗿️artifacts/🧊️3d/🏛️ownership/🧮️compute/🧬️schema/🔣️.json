{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/compute-consumer/puzzle-brush-cache.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
