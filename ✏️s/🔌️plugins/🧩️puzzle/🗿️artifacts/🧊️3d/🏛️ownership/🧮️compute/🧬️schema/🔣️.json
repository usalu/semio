      "const": "puzzle-brush-cache"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "const": "✏️s/🔌️plugins/🧩️puzzle/🗿️artifacts/🧊️3d/🏅️standards/🔖️1/🪆️subsets/✳️any/✏️editor/⏳️precompute/🦀️.rs"
    },
    "manifest": {
      "type": "string",
      "minLength": 1,
      "const": "✏️s/🔌️plugins/🧩️puzzle/🗿️artifacts/🧊️3d/📦️packages/🦀️rust/Cargo.toml"
    },
    "bindings": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "EngineKey",
          "EngineHandle",
          "EngineFault",
          "Engine",
          "EngineHandles",
          "EngineCache",
          "EngineRep"
        ]
      },
      "const": [
        "Engine",
        "EngineCache",
        "EngineFault",
        "EngineHandle"
      ]
    }
  }
}
