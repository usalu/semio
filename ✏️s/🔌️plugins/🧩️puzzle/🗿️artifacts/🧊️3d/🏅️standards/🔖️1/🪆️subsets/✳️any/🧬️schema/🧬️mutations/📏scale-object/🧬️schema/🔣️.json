{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/puzzle/puzzle3d/mutation/scale-object/schema.json",
  "title": "ScaleObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "newScale": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
