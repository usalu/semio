{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle3d/mutation/move-object/schema.json",
  "title": "MoveObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newOrigin"
  ],
  "properties": {
    "mutation": {
      "const": "moveObject"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The object this mutation addresses.",
          "de": "Das Objekt, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "object",
          "domain": "vortex",
          "granularity": "object"
        },
        "group": "target",
        "order": 10
      }
    },
    "newOrigin": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Origin",
          "de": "Ursprung"
        },
        "description": {
          "en": "Absolute final origin in the world.",
          "de": "Absoluter Endursprung in der Welt."
        },
        "unit": "m",
        "step": 0.1,
        "group": "pose",
        "order": 20,
        "snapSource": {
          "config": "gridSpacing"
        }
      }
    }
  }
}
