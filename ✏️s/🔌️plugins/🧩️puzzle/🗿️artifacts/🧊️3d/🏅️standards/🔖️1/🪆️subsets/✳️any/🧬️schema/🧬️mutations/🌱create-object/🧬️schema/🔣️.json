{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle3d/mutation/create-object/schema.json",
  "title": "CreateObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "object"
  ],
  "properties": {
    "mutation": {
      "const": "createObject"
    },
    "object": {
      "title": "Puzzle3dObject",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden",
        "id",
        "locked",
        "origin",
        "vortices",
        "anchor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique object id in this puzzle.",
              "de": "Eindeutige Objekt-ID in diesem Puzzle."
            },
            "group": "identity",
            "order": 10
          }
        },
        "label": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Label",
              "de": "Bezeichnung"
            },
            "group": "appearance",
            "order": 20
          }
        },
        "objectKind": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Object kind",
              "de": "Objektart"
            },
            "description": {
              "en": "Id of a kind from the kind catalog.",
              "de": "ID einer Art aus dem Artenkatalog."
            },
            "group": "kind",
            "order": 30
          }
        },
        "anchor": {
          "type": "string",
          "enum": [
            "fixed",
            "derived"
          ],
          "x-semio-ui": {
            "widget": "segmented",
            "role": "value",
            "label": {
              "en": "Anchor",
              "de": "Verankerung"
            },
            "description": {
              "en": "Fixed keeps the stored plane at a root; derived resets it to the default XY plane.",
              "de": "Fest behält die gespeicherte Ebene an einer Wurzel; abgeleitet setzt sie auf die XY-Standardebene zurück."
            },
            "options": {
              "fixed": {
                "en": "Fixed",
                "de": "Fest"
              },
              "derived": {
                "en": "Derived",
                "de": "Abgeleitet"
              }
            },
            "group": "geometry",
            "order": 35
          }
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Origin",
              "de": "Ursprung"
            },
            "unit": "m",
            "step": 0.1,
            "group": "pose",
            "order": 40,
            "snapSource": {
              "config": "gridSpacing"
            }
          }
        },
        "orientation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Orientation",
              "de": "Orientierung"
            },
            "description": {
              "en": "Unit quaternion (x, y, z, w); (0, 0, 0, 1) is no rotation.",
              "de": "Einheitsquaternion (x, y, z, w); (0, 0, 0, 1) ist keine Drehung."
            },
            "step": 0.01,
            "group": "pose",
            "order": 50
          }
        },
        "scale": {
          "description": "any JSON value",
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Scale",
              "de": "Skalierung"
            },
            "description": {
              "en": "One factor for all three axes, or one factor per axis (x, y, z).",
              "de": "Ein Faktor für alle drei Achsen oder ein Faktor je Achse (x, y, z)."
            },
            "group": "pose",
            "order": 60
          }
        },
        "meshUrl": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Mesh URL",
              "de": "Mesh-URL"
            },
            "description": {
              "en": "Address of the file, e.g. an https or data URL.",
              "de": "Adresse der Datei, z. B. eine https- oder data-URL."
            },
            "group": "source",
            "order": 70
          }
        },
        "vortices": {
          "type": "array",
          "items": {
            "title": "Puzzle3dVortex",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hidden",
              "id",
              "locked",
              "position"
            ],
            "properties": {
              "id": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "ID",
                    "de": "ID"
                  },
                  "description": {
                    "en": "Id of the vortex, unique on its object.",
                    "de": "ID des Vortex, eindeutig an seinem Objekt."
                  },
                  "group": "identity",
                  "order": 10
                }
              },
              "vortexKind": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Vortex kind",
                    "de": "Vortex-Art"
                  },
                  "description": {
                    "en": "Id of a kind from the kind catalog.",
                    "de": "ID einer Art aus dem Artenkatalog."
                  },
                  "group": "kind",
                  "order": 20
                }
              },
              "label": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Label",
                    "de": "Bezeichnung"
                  },
                  "group": "appearance",
                  "order": 25
                }
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "x-semio-ui": {
                  "widget": "vector",
                  "role": "value",
                  "label": {
                    "en": "Position",
                    "de": "Position"
                  },
                  "description": {
                    "en": "Where the vortex sits in the object's local frame.",
                    "de": "Lage des Vortex im lokalen System des Objekts."
                  },
                  "unit": "m",
                  "step": 0.1,
                  "group": "pose",
                  "order": 30,
                  "snapSource": {
                    "config": "gridSpacing"
                  }
                }
              },
              "direction": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "x-semio-ui": {
                  "widget": "vector",
                  "role": "value",
                  "label": {
                    "en": "Direction",
                    "de": "Richtung"
                  },
                  "description": {
                    "en": "Direction the vortex points in.",
                    "de": "Richtung, in die der Vortex zeigt."
                  },
                  "step": 0.1,
                  "group": "geometry",
                  "order": 40
                }
              },
              "radius": {
                "type": "number",
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Radius",
                    "de": "Radius"
                  },
                  "description": {
                    "en": "Collision radius used by the brush fill.",
                    "de": "Kollisionsradius für das Pinselfüllen."
                  },
                  "unit": "m",
                  "step": 0.01,
                  "precision": 3,
                  "group": "geometry",
                  "order": 50
                }
              },
              "hidden": {
                "type": "boolean",
                "x-semio-ui": {
                  "widget": "toggle",
                  "role": "value",
                  "label": {
                    "en": "Hidden",
                    "de": "Ausgeblendet"
                  },
                  "group": "state",
                  "order": 60
                }
              },
              "locked": {
                "type": "boolean",
                "x-semio-ui": {
                  "widget": "toggle",
                  "role": "value",
                  "label": {
                    "en": "Locked",
                    "de": "Gesperrt"
                  },
                  "group": "state",
                  "order": 70
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Vortices",
              "de": "Vortices"
            },
            "group": "topology",
            "order": 80
          }
        },
        "hidden": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Hidden",
              "de": "Ausgeblendet"
            },
            "group": "state",
            "order": 90
          }
        },
        "locked": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Locked",
              "de": "Gesperrt"
            },
            "group": "state",
            "order": 100
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The complete object record to add.",
          "de": "Das vollständige hinzuzufügende Objekt."
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Index",
          "de": "Index"
        },
        "description": {
          "en": "Position in the list; the end when omitted.",
          "de": "Position in der Liste; ohne Angabe am Ende."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 20
      }
    }
  }
}
