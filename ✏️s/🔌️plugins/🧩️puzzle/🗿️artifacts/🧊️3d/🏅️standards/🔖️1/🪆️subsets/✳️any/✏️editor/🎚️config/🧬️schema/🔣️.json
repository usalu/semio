{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/puzzle/puzzle3d/config/schema.json",
  "title": "Puzzle3dConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["fillCount", "overlapBudget", "objectKindWeights", "vortexKindWeights", "activeExampleId"],
  "properties": {
    "fillCount": { "type": "integer", "minimum": 0, "x-semio-state": "config" },
    "overlapBudget": { "type": "number", "x-semio-state": "config" },
    "objectKindWeights": { "type": "object", "additionalProperties": { "type": "number" }, "x-semio-state": "config" },
    "vortexKindWeights": { "type": "object", "additionalProperties": { "type": "number" }, "x-semio-state": "config" },
    "activeExampleId": { "type": "string", "x-semio-state": "config" }
  }
}
