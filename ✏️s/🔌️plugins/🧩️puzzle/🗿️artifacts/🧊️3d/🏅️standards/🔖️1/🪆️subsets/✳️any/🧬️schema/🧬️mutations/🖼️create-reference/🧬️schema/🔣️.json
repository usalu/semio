{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/puzzle/3d/1/any/mutation/create-reference.json",
  "title": "CreateReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference"
  ],
  "properties": {
    "reference": {
      "title": "Puzzle3dReference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden",
        "id",
        "locked",
        "origin",
        "source",
        "widthWorld"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "title": "Puzzle3dReferenceSource",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "mediaKind": {
              "type": "string"
            }
          }
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "widthWorld": {
          "type": "number"
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
