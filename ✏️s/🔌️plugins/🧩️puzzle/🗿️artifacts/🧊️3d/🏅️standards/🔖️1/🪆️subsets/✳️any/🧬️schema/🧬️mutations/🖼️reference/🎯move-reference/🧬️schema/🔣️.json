{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle3d/mutation/move-reference/schema.json",
  "title": "MoveReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newOrigin"
  ],
  "properties": {
    "mutation": {
      "const": "moveReference"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Reference",
          "de": "Referenz"
        },
        "description": {
          "en": "The reference image this mutation addresses.",
          "de": "Das Referenzbild, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "reference",
          "domain": "vortex",
          "granularity": "reference"
        },
        "group": "target",
        "order": 10
      }
    },
    "newOrigin": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Origin",
          "de": "Ursprung"
        },
        "description": {
          "en": "Absolute final origin in the world.",
          "de": "Absoluter Endursprung in der Welt."
        },
        "unit": "m",
        "step": 0.1,
        "group": "pose",
        "order": 20,
        "snapSource": {
          "config": "gridSpacing"
        }
      }
    }
  }
}
