(* ebnf puzzle.puzzle3d.mutations *)
(* Below: ISO-14977-style mirror of the normative 📖️.grammar.semio (same production
   names, kebab-case -> "space case"). This facet's .semio defines no header/body/payload
   envelope (`start line`); the two lines above are preserved verbatim from the prior
   identity fix for traceability but are not referenced below. *)
document = header, body ;
header = 'schema', space, 'puzzle.puzzle3d.mutations', newline ;

line = create object
     | delete object
     | move object
     | rotate object
     | scale object
     | change object mesh
     | edit object label
     | change object kind
     | change object anchor
     | change object hidden
     | change object locked
     | add object vortex
     | remove object vortex
     | replace object vortex
     | connect vortices
     | disconnect vortices
     | replace attraction geometry
     | create target volume
     | delete target volume
     | move target volume
     | rotate target volume
     | scale target volume
     | change target volume hidden
     | change target volume locked
     | create reference
     | delete reference
     | move reference
     | resize reference
     | replace reference source
     | change reference hidden
     | change reference locked
     | change domain
     | connect kind compatibility
     | disconnect kind compatibility
     | replace kind catalogs ;
create object = 'create-object', space, object block, space, index opt ;
delete object = 'delete-object', space, id ;
move object = 'move-object', space, id, space, number, space, number, space, number ;
rotate object = 'rotate-object', space, id, space, quat opt ;
scale object = 'scale-object', space, id, space, scale opt ;
change object mesh = 'change-object-mesh', space, id, space, text opt ;
edit object label = 'edit-object-label', space, id, space, text opt ;
change object kind = 'change-object-kind', space, id, space, text opt ;
change object anchor = 'change-object-anchor', space, id, space, anchor ;
change object hidden = 'change-object-hidden', space, id, space, boolean ;
change object locked = 'change-object-locked', space, id, space, boolean ;
add object vortex = 'add-object-vortex', space, id, space, vortex block, space, index opt ;
remove object vortex = 'remove-object-vortex', space, id, space, id ;
replace object vortex = 'replace-object-vortex', space, id, space, id, space, vortex block ;
connect vortices = 'connect-vortices', space, id, space, full vortex id, space, full vortex id, space, attraction fields ;
disconnect vortices = 'disconnect-vortices', space, id ;
replace attraction geometry = 'replace-attraction-geometry', space, id, space, number, space, number, space, number, space, number, space, number, space, number, space, number, space, number ;
create target volume = 'create-target-volume', space, volume block, space, index opt ;
delete target volume = 'delete-target-volume', space, id ;
move target volume = 'move-target-volume', space, id, space, number, space, number, space, number ;
rotate target volume = 'rotate-target-volume', space, id, space, quat opt ;
scale target volume = 'scale-target-volume', space, id, space, scale opt ;
change target volume hidden = 'change-target-volume-hidden', space, id, space, boolean ;
change target volume locked = 'change-target-volume-locked', space, id, space, boolean ;
create reference = 'create-reference', space, reference block, space, index opt ;
delete reference = 'delete-reference', space, id ;
move reference = 'move-reference', space, id, space, number, space, number, space, number ;
resize reference = 'resize-reference', space, id, space, number ;
replace reference source = 'replace-reference-source', space, id, space, source block ;
change reference hidden = 'change-reference-hidden', space, id, space, boolean ;
change reference locked = 'change-reference-locked', space, id, space, boolean ;
change domain = 'change-domain', space, text ;
connect kind compatibility = 'connect-kind-compatibility', space, id, space, id, space, boolean, space, boolean, space, specificity ;
disconnect kind compatibility = 'disconnect-kind-compatibility', space, id, space, id ;
replace kind catalogs = 'replace-kind-catalogs', space, catalogs block opt ;
object block = '{', newline, octet, { octet }, '}' ;
vortex block = '{', newline, octet, { octet }, '}' ;
volume block = '{', newline, octet, { octet }, '}' ;
reference block = '{', newline, octet, { octet }, '}' ;
source block = '{', newline, octet, { octet }, '}' ;
catalogs block opt = ( '{', newline, octet, { octet }, '}' )
     | 'none' ;
attraction fields = number, space, number, space, number, space, number, space, number, space, number, space, number, space, number ;
full vortex id = octet, { octet } ;
anchor = 'fixed'
     | 'derived' ;
specificity = 'general'
     | 'object'
     | 'attraction'
     | 'cable'
     | 'vortex' ;
quat opt = ( number, space, number, space, number, space, number )
     | 'none' ;
scale opt = number, { number }
     | 'none' ;
index opt = number
     | 'none' ;
text opt = text
     | 'none' ;
id = octet, { octet } ;
number = octet, { octet } ;
text = octet, { octet } ;
boolean = 'true'
     | 'false' ;

(* Framework dialect-primitive terminals, given one concrete definition each for a
   self-contained mirror (not defined in the .semio itself — ticket-reported deviation). *)
newline = [ '\r' ], '\n' ;
octet = ? any single raw byte ? ;
space = ' ' ;
