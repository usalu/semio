{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateTargetVolume",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetVolume"
  ],
  "properties": {
    "targetVolume": {
      "title": "Puzzle3dTargetVolume",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden",
        "id",
        "locked",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "orientation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {
          "description": "any JSON value"
        },
        "hidden": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
