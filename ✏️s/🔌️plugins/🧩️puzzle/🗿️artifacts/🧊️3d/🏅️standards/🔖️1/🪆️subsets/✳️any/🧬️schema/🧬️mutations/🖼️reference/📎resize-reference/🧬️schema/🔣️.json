{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle3d/mutation/resize-reference/schema.json",
  "title": "ResizeReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newWidthWorld"
  ],
  "properties": {
    "mutation": {
      "const": "resizeReference"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Reference",
          "de": "Referenz"
        },
        "description": {
          "en": "The reference image this mutation addresses.",
          "de": "Das Referenzbild, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "reference",
          "domain": "vortex",
          "granularity": "reference"
        },
        "group": "target",
        "order": 10
      }
    },
    "newWidthWorld": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Width",
          "de": "Breite"
        },
        "description": {
          "en": "Width of the reference plane in the world.",
          "de": "Breite der Referenzebene in der Welt."
        },
        "unit": "m",
        "step": 0.1,
        "precision": 3,
        "group": "geometry",
        "order": 20
      }
    }
  }
}
