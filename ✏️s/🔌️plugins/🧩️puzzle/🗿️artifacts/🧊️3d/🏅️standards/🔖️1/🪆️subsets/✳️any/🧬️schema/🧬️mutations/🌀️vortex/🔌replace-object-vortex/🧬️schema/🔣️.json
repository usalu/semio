{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle3d/mutation/replace-object-vortex/schema.json",
  "title": "ReplaceObjectVortex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newVortex",
    "objectId",
    "vortexId"
  ],
  "properties": {
    "mutation": {
      "const": "replaceObjectVortex"
    },
    "objectId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "The object that owns the vortex.",
          "de": "Das Objekt, dem der Vortex gehört."
        },
        "ref": {
          "kind": "object",
          "domain": "vortex",
          "granularity": "object"
        },
        "group": "target",
        "order": 10
      }
    },
    "vortexId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Vortex",
          "de": "Vortex"
        },
        "description": {
          "en": "Id of the vortex on its object.",
          "de": "ID des Vortex an seinem Objekt."
        },
        "ref": {
          "kind": "vortex"
        },
        "group": "target",
        "order": 20
      }
    },
    "newVortex": {
      "title": "Puzzle3dVortex",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hidden",
        "id",
        "locked",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Id of the vortex, unique on its object.",
              "de": "ID des Vortex, eindeutig an seinem Objekt."
            },
            "group": "identity",
            "order": 10
          }
        },
        "vortexKind": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Vortex kind",
              "de": "Vortex-Art"
            },
            "description": {
              "en": "Id of a kind from the kind catalog.",
              "de": "ID einer Art aus dem Artenkatalog."
            },
            "group": "kind",
            "order": 20
          }
        },
        "label": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Label",
              "de": "Bezeichnung"
            },
            "group": "appearance",
            "order": 25
          }
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Position",
              "de": "Position"
            },
            "description": {
              "en": "Where the vortex sits in the object's local frame.",
              "de": "Lage des Vortex im lokalen System des Objekts."
            },
            "unit": "m",
            "step": 0.1,
            "group": "pose",
            "order": 30,
            "snapSource": {
              "config": "gridSpacing"
            }
          }
        },
        "direction": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Direction",
              "de": "Richtung"
            },
            "description": {
              "en": "Direction the vortex points in.",
              "de": "Richtung, in die der Vortex zeigt."
            },
            "step": 0.1,
            "group": "geometry",
            "order": 40
          }
        },
        "radius": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Radius",
              "de": "Radius"
            },
            "description": {
              "en": "Collision radius used by the brush fill.",
              "de": "Kollisionsradius für das Pinselfüllen."
            },
            "unit": "m",
            "step": 0.01,
            "precision": 3,
            "group": "geometry",
            "order": 50
          }
        },
        "hidden": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Hidden",
              "de": "Ausgeblendet"
            },
            "group": "state",
            "order": 60
          }
        },
        "locked": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Locked",
              "de": "Gesperrt"
            },
            "group": "state",
            "order": 70
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New vortex",
          "de": "Neuer Vortex"
        },
        "description": {
          "en": "The vortex record that replaces the addressed one.",
          "de": "Der Vortex, der den adressierten ersetzt."
        },
        "group": "record",
        "order": 30
      }
    }
  }
}
