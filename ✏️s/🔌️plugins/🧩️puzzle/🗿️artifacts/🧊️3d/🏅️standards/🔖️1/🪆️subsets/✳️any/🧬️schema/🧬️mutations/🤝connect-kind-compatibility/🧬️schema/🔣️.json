{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/puzzle/3d/1/any/mutation/connect-kind-compatibility/schema.json",
  "title": "ConnectKindCompatibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bidirectional",
    "important",
    "source",
    "specificity",
    "target"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "bidirectional": {
      "type": "boolean"
    },
    "important": {
      "type": "boolean"
    },
    "specificity": {
      "type": "string",
      "enum": [
        "general",
        "object",
        "attraction",
        "cable",
        "vortex"
      ]
    }
  }
}
