{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle3d/mutation/connect-kind-compatibility/schema.json",
  "title": "ConnectKindCompatibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "bidirectional",
    "important",
    "source",
    "specificity",
    "target"
  ],
  "properties": {
    "mutation": {
      "const": "connectKindCompatibility"
    },
    "source": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Source kind",
          "de": "Quellart"
        },
        "group": "kind",
        "order": 10
      }
    },
    "target": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Target kind",
          "de": "Zielart"
        },
        "group": "kind",
        "order": 20
      }
    },
    "bidirectional": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Bidirectional",
          "de": "Beidseitig"
        },
        "group": "kind",
        "order": 30
      }
    },
    "important": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Important",
          "de": "Wichtig"
        },
        "group": "kind",
        "order": 40
      }
    },
    "specificity": {
      "type": "string",
      "enum": [
        "general",
        "object",
        "attraction",
        "cable",
        "vortex"
      ],
      "x-semio-ui": {
        "widget": "select",
        "role": "value",
        "label": {
          "en": "Specificity",
          "de": "Spezifität"
        },
        "description": {
          "en": "Which level of the kind hierarchy this pair applies to.",
          "de": "Auf welcher Ebene der Artenhierarchie dieses Paar gilt."
        },
        "options": {
          "general": {
            "en": "General",
            "de": "Allgemein"
          },
          "object": {
            "en": "Object",
            "de": "Objekt"
          },
          "attraction": {
            "en": "Attraction",
            "de": "Anziehung"
          },
          "cable": {
            "en": "Cable",
            "de": "Kabel"
          },
          "vortex": {
            "en": "Vortex",
            "de": "Vortex"
          }
        },
        "group": "kind",
        "order": 50
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Insertion index",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Final row position. Empty appends; positions past the end append.",
          "de": "Endgültige Zeilenposition. Ohne Angabe am Ende; Positionen hinter dem Ende hängen an."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 60
      }
    }
  }
}
