{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.puzzle3d.fill-preview-json.v1",
  "type": "object",
  "x-semio-maxEncodedUtf8Bytes": 4096,
  "additionalProperties": false,
  "properties": {
    "targetVortexFullId": { "type": "string" },
    "objectKindId": { "type": "string" },
    "sourceVortexIndex": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "meshUrl": { "type": "string" },
    "origin": { "$ref": "#/$defs/vector3" },
    "orientation": { "$ref": "#/$defs/quaternion" },
    "color": { "type": "string", "maxLength": 128, "x-semio-maxUtf8Bytes": 128 },
    "opacity": { "const": 0.35 },
    "fillBuildPreview": { "$ref": "#/$defs/diagnostic" }
  },
  "required": ["fillBuildPreview"],
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "vector3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "ghost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetVortexFullId": { "type": "string" },
        "objectKindId": { "type": "string" },
        "sourceVortexIndex": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "meshUrl": { "type": "string" },
        "origin": { "$ref": "#/$defs/vector3" },
        "orientation": { "$ref": "#/$defs/quaternion" }
      },
      "required": ["targetVortexFullId", "objectKindId", "sourceVortexIndex", "meshUrl", "origin", "orientation"]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "baseRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "registryGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "stage": { "type": "string" },
        "statusLabel": { "type": "string", "minLength": 1, "maxLength": 256, "x-semio-maxUtf8Bytes": 256 },
        "targetVortexFullId": { "$ref": "#/$defs/nullableString" },
        "candidateObjectKindId": { "$ref": "#/$defs/nullableString" },
        "candidateGhost": { "oneOf": [{ "$ref": "#/$defs/ghost" }, { "type": "null" }] },
        "currentPairObjectId": { "$ref": "#/$defs/nullableString" },
        "collisionCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sampleCursor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "insideBoth": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "lastSample": { "oneOf": [{ "$ref": "#/$defs/vector3" }, { "type": "null" }] },
        "candidatePage": {
          "type": "array",
          "items": { "$ref": "#/$defs/nullableString" },
          "minItems": 8,
          "maxItems": 8
        },
        "truncated": { "type": "boolean" },
        "rejectionReason": { "$ref": "#/$defs/nullableString" },
        "targetCursor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "candidateCursor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "acceptedCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "totalCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "searchCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "rejectedCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": [
        "operation",
        "baseRevision",
        "registryGeneration",
        "sequence",
        "generation",
        "stage",
        "statusLabel",
        "targetVortexFullId",
        "candidateObjectKindId",
        "candidateGhost",
        "currentPairObjectId",
        "collisionCount",
        "sampleCursor",
        "insideBoth",
        "lastSample",
        "candidatePage",
        "truncated",
        "rejectionReason",
        "targetCursor",
        "candidateCursor",
        "acceptedCount",
        "totalCount",
        "searchCount",
        "rejectedCount"
      ]
    }
  }
}
