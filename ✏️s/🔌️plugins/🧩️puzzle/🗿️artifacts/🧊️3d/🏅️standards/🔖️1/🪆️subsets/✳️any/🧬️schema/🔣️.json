{
  "$id": "https://semio.tech/schema/s/puzzle/puzzle3d/artifact.json",
  "title": "Puzzle3dArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "domain",
    "meta",
    "objects",
    "attractions",
    "targetVolumes",
    "references",
    "selectedObjectIds",
    "selectedVortexIds",
    "selectedAttractionIds",
    "selectedTargetVolumeIds",
    "selectedReferenceIds",
    "activeUtilityId",
    "cameraPositionX",
    "cameraPositionY",
    "cameraPositionZ",
    "cameraTargetX",
    "cameraTargetY",
    "cameraTargetZ",
    "cameraZoom",
    "selectionMethod",
    "selectionModeDefault",
    "engagementInput",
    "gridVisible",
    "gridSnapEnabled",
    "gridSpacing",
    "overlapBudget",
    "fillCount",
    "brushCandidateIndex",
    "lodAutomatic",
    "lodDepthVariable",
    "lodManual",
    "proximityRadius",
    "locale",
    "runtimeExtrasJson",
    "previewSeq"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "domain": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "meta": {
      "$ref": "#/$defs/Puzzle3dMeta",
      "x-semio-state": "artifact"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Puzzle3dObject"
      },
      "x-semio-state": "artifact"
    },
    "attractions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Puzzle3dAttraction"
      },
      "x-semio-state": "artifact"
    },
    "targetVolumes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Puzzle3dTargetVolume"
      },
      "x-semio-state": "artifact"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Puzzle3dReference"
      },
      "x-semio-state": "artifact"
    },
    "selectedObjectIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "selectedVortexIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "selectedAttractionIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "selectedTargetVolumeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "selectedReferenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "cameraPositionX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraPositionY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraPositionZ": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraTargetX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraTargetY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraTargetZ": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "cameraZoom": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "selectionMethod": {
      "type": "string",
      "x-semio-state": "config"
    },
    "selectionModeDefault": {
      "type": "string",
      "x-semio-state": "config"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "gridVisible": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "gridSnapEnabled": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "gridSpacing": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "overlapBudget": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "fillCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "brushCandidateIndex": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "lodAutomatic": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "lodDepthVariable": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "lodManual": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "proximityRadius": {
      "type": "number",
      "format": "double",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    },
    "runtimeExtrasJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    },
    "hoveredObjectId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "hoveredVortexFullId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "hoveredKindId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "previewSeq": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "Puzzle3dMeta": {
      "type": "object",
      "title": "Puzzle3dMeta",
      "additionalProperties": false,
      "properties": {
        "kindCatalogs": {
          "type": "object",
          "additionalProperties": true
        },
        "kindCompatibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle3dKindCompatibility"
          }
        }
      }
    },
    "Puzzle3dObject": {
      "type": "object",
      "title": "Puzzle3dObject",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "objectKind": {
          "type": "string"
        },
        "anchor": {
          "type": "string",
          "enum": [
            "fixed",
            "derived"
          ],
          "default": "fixed"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "orientation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {},
        "meshUrl": {
          "type": "string"
        },
        "vortices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle3dVortex"
          }
        },
        "hidden": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "Puzzle3dAttraction": {
      "type": "object",
      "title": "Puzzle3dAttraction",
      "additionalProperties": false,
      "required": [
        "attracting",
        "attracted"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "attracting": {
          "type": "string"
        },
        "attracted": {
          "type": "string"
        },
        "gap": {
          "type": "number",
          "default": 0.0
        },
        "shift": {
          "type": "number",
          "default": 0.0
        },
        "rise": {
          "type": "number",
          "default": 0.0
        },
        "rotation": {
          "type": "number",
          "default": 0.0,
          "description": "degrees"
        },
        "turn": {
          "type": "number",
          "default": 0.0,
          "description": "degrees"
        },
        "tilt": {
          "type": "number",
          "default": 0.0,
          "description": "degrees"
        },
        "x": {
          "type": "number",
          "default": 0.0,
          "description": "diagram offset (compose u)"
        },
        "y": {
          "type": "number",
          "default": 0.0,
          "description": "diagram offset (compose v)"
        }
      }
    },
    "Puzzle3dTargetVolume": {
      "title": "Puzzle3dTargetVolume",
      "type": "object",
      "additionalProperties": true
    },
    "Puzzle3dReference": {
      "title": "Puzzle3dReference",
      "type": "object",
      "additionalProperties": true
    },
    "Puzzle3dVortex": {
      "type": "object",
      "title": "Puzzle3dVortex",
      "additionalProperties": true,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "vortexKind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "direction": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "radius": {
          "type": "number"
        },
        "hidden": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "Puzzle3dKindCompatibility": {
      "type": "object",
      "title": "Puzzle3dKindCompatibility",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "bidirectional": {
          "type": "boolean",
          "default": false
        },
        "important": {
          "type": "boolean",
          "default": false
        },
        "specificity": {
          "type": "string",
          "enum": [
            "general",
            "object",
            "attraction",
            "vortex",
            "cable"
          ],
          "default": "general"
        }
      }
    },
    "Puzzle3dRepresentation": {
      "type": "object",
      "title": "Puzzle3dRepresentation",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lod": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Puzzle3dCatalogVortexTemplate": {
      "type": "object",
      "title": "Puzzle3dCatalogVortexTemplate",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "vortexKind": {
          "type": "string"
        },
        "point": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "direction": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "t": {
          "type": "number"
        },
        "mandatory": {
          "type": "boolean"
        },
        "radius": {
          "type": "number"
        }
      }
    },
    "Puzzle3dCatalogObjectKind": {
      "type": "object",
      "title": "Puzzle3dCatalogObjectKind",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "abstract": {
          "type": "boolean",
          "default": false
        },
        "baseKinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "representations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle3dRepresentation"
          }
        },
        "vortices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle3dCatalogVortexTemplate"
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "Puzzle3dCatalogVortexKind": {
      "type": "object",
      "title": "Puzzle3dCatalogVortexKind",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "compatibleWith": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "defaultCableKind": {
          "type": "string"
        }
      }
    }
  }
}
