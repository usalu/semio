{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object"
  ],
  "properties": {
    "object": {
      "title": "Puzzle3dObject",
      "type": "object",
