        },
        "label": {
          "type": "string"
        },
        "objectKind": {
          "type": "string"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "orientation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {
          "description": "any JSON value"
        },
        "meshUrl": {
          "type": "string"
        },
        "vortices": {
          "type": "array",
          "items": {
            "title": "Puzzle3dVortex",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hidden",
              "id",
              "locked",
              "position"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "vortexKind": {
                "type": "string"
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "direction": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "radius": {
                "type": "number"
              },
              "hidden": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              }
            }
          }
        },
        "hidden": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
