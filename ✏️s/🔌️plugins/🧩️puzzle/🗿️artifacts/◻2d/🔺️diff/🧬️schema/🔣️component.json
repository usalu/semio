        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/Puzzle2dNodePatch"
        }
      }
    },
    "Puzzle2dNodePatch": {
      "title": "Puzzle2dNodePatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "replacement": {
          "$ref": "#/$defs/Puzzle2dNode"
        }
      }
    },
    "Puzzle2dNode": {
      "title": "Puzzle2dNode",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "Puzzle2dEdgesDelta": {
      "title": "Puzzle2dEdgesDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle2dEdge"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle2dEdgePatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Puzzle2dEdgePatchEntry": {
      "title": "Puzzle2dEdgePatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/Puzzle2dEdgePatch"
        }
      }
    },
    "Puzzle2dEdgePatch": {
      "title": "Puzzle2dEdgePatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "replacement": {
          "$ref": "#/$defs/Puzzle2dEdge"
        }
      }
    },
    "Puzzle2dEdge": {
      "title": "Puzzle2dEdge",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "Puzzle2dCamera": {
      "title": "Puzzle2dCamera",
      "type": "object",
      "additionalProperties": true
    },
    "Puzzle2dMeta": {
      "title": "Puzzle2dMeta",
      "type": "object",
      "additionalProperties": true
    }
