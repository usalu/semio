      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Puzzle2dNodesDelta": {
      "title": "Puzzle2dNodesDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle2dNode"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle2dNodePatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Puzzle2dNodePatchEntry": {
      "title": "Puzzle2dNodePatchEntry",
      "type": "object",
      "additionalProperties": false,
