    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "cameraX": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "cameraY": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "cameraZoom": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "selectionMethod": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "gridSnapEnabled": {
      "type": "boolean",
      "x-semio-state": "local-ui"
    },
    "gridFactor": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "suggestionOffset": {
      "type": "number",
      "format": "double",
      "x-semio-state": "local-ui"
    },
    "fillCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "local-ui"
    },
    "brushCandidateIndex": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "local-ui"
    },
    "brushCandidateSourceHandleId": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "terminology": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "lodModeByPaneJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "local-ui"
    },
    "engagementInputByPaneJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "local-ui"
    },
    "brushCandidatesJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "local-ui"
    },
    "nodeKindWeightsJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "local-ui"
    },
    "handleKindWeightsJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "local-ui"
    },
    "activeUtilityByWindowIdJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "local-ui"
    },
    "hoveredNodeId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ],
      "x-semio-state": "preview"
    },
    "previewSeq": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "preview"
    }
  },
  "$defs": {
    "Puzzle2dStringList": {
      "title": "Puzzle2dStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
