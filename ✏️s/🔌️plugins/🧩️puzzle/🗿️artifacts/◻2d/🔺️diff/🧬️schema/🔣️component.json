{
  "$id": "https://semio.tech/schema/s/puzzle/puzzle2d/diff.json",
  "title": "Puzzle2dDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "title": "Puzzle2dArtifact",
      "type": "object",
      "x-semio-state": "persistent"
    },
    "schema": {
      "type": "string",
      "x-semio-state": "persistent"
    },
    "camera": {
      "$ref": "#/$defs/Puzzle2dCamera",
      "x-semio-state": "persistent"
    },
    "nodes": {
      "$ref": "#/$defs/Puzzle2dNodesDelta",
      "x-semio-state": "persistent"
    },
    "edges": {
      "$ref": "#/$defs/Puzzle2dEdgesDelta",
      "x-semio-state": "persistent"
    },
    "meta": {
      "$ref": "#/$defs/Puzzle2dMeta",
      "x-semio-state": "persistent"
    },
    "selectedIds": {
      "$ref": "#/$defs/Puzzle2dStringList",
