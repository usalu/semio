{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceNodeHandle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handleId",
    "newHandle",
    "nodeId"
  ],
  "properties": {
    "nodeId": {
      "type": "string"
    },
    "handleId": {
      "type": "string"
    },
    "newHandle": {
      "title": "Puzzle2dHandle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "handleKind": {
          "type": "string"
        },
        "angle": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "iconKind": {
          "type": "string"
        },
        "scale": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    }
  }
}
