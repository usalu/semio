{
  "$id": "https://semio.tech/schema/app/puzzle/puzzle2d/config.json",
  "title": "Puzzle2dConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cameraX",
    "cameraY",
    "cameraZoom",
    "lodModeByPane",
    "engagementInputByPane",
    "brushCandidateIndex",
    "brushCandidates",
    "brushCandidateSourceHandleId",
    "fillCount",
    "fillJobOperation",
    "fillJobGeneration",
    "fillJobSeed",
    "fillJobBaseRevision",
    "fillJobCheckpointSequence",
    "fillJobAcceptedCount",
    "fillJobSearchCount",
    "fillJobStage",
    "fillJobLifecycle",
    "gridSnapEnabled",
    "gridFactor",
    "suggestionOffset",
    "nodeKindWeights",
    "handleKindWeights",
    "activeUtilityByWindowId",
    "locale",
    "terminology",
    "exampleLoadGeneration"
  ],
  "properties": {
    "cameraX": {
      "type": "number",
      "x-semio-state": "config"
    },
    "cameraY": {
      "type": "number",
      "x-semio-state": "config"
    },
    "cameraZoom": {
      "type": "number",
      "x-semio-state": "config"
    },
    "lodModeByPane": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "engagementInputByPane": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "brushCandidateIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "brushCandidates": {
      "type": "array",
      "items": {
        "title": "Value",
        "type": "object"
      },
      "x-semio-state": "config"
    },
    "brushCandidateSourceHandleId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "fillCount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "fillJobOperation": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "fillJobGeneration": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "fillJobSeed": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "fillJobBaseRevision": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "fillJobCheckpointSequence": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "fillJobAcceptedCount": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "fillJobSearchCount": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "fillJobStage": {
      "type": "string",
      "x-semio-state": "config"
    },
    "fillJobLifecycle": {
      "type": "string",
      "enum": ["idle", "capturing", "queued", "running", "checkpointReady", "applying", "awaitingAdoption", "closing", "completed", "cancelled", "faulted", "discarded"],
      "x-semio-state": "config"
    },
    "fillJobFaultCode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "gridSnapEnabled": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "gridFactor": {
      "type": "number",
      "x-semio-state": "config"
    },
    "suggestionOffset": {
      "type": "number",
      "x-semio-state": "config"
    },
    "nodeKindWeights": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "x-semio-state": "config"
    },
    "handleKindWeights": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "x-semio-state": "config"
    },
    "activeUtilityByWindowId": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    },
    "terminology": {
      "type": "string",
      "x-semio-state": "config"
    },
    "exampleLoadGeneration": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "exampleLoadId": {
      "type": "string",
      "x-semio-state": "config"
    }
  }
}
