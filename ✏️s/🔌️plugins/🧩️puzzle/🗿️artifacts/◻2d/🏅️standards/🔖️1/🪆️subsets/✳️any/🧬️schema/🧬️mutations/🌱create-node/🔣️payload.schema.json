{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node"
  ],
  "properties": {
    "node": {
      "title": "Puzzle2dNode",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor",
        "handles",
        "id",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "nodeKind": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "iconKind": {
          "type": "string"
        },
        "root": {
          "type": "boolean"
        },
        "scale": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "anchor": {
          "type": "string",
          "enum": [
            "Fixed",
            "Derived"
          ]
        },
        "handles": {
          "type": "array",
          "items": {
            "title": "Puzzle2dHandle",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "angle",
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "handleKind": {
                "type": "string"
              },
              "angle": {
                "type": "number"
              },
              "radius": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "iconKind": {
                "type": "string"
              },
              "scale": {
                "type": "number"
              },
              "visible": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
