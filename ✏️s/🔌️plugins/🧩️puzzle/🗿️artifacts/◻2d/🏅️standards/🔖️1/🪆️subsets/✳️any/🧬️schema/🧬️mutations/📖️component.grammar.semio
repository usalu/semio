dialect grammar
grammar puzzle.puzzle2d.op
extension puzzle2d
use family-scene
start mutation

artifact-mark = "puzzle.2d-op"
mutation = artifact-mark mesh-op+
mesh-op = "add-vertex" vtx-field+ | "set-face" face-field+ | "transform-mesh" xfm-field+ | "merge-solid" merge-field+ | "snap-part" snap-field+
snap-field = "part" "=" IDENT | "grid" "=" INT
vtx-field = "x" "=" FLOAT | "y" "=" FLOAT | "z" "=" FLOAT
face-field = "index" "=" INT | "loop" "=" list
xfm-field = "axis" "=" IDENT | "angle" "=" FLOAT
merge-field = "target" "=" IDENT | "source" "=" IDENT
list = "[" INT* "]"
layer = IDENT "@" FLOAT FLOAT FLOAT?
