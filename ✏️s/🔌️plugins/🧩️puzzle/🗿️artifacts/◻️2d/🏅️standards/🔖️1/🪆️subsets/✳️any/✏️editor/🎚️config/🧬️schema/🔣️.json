{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/puzzle/puzzle2d/config/schema.json",
  "title": "Puzzle2dConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodeKindWeights", "handleKindWeights", "fillCount"],
  "properties": {
    "nodeKindWeights": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "x-semio-state": "config"
    },
    "handleKindWeights": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "x-semio-state": "config"
    },
    "fillCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 100,
      "x-semio-state": "config"
    }
  }
}
