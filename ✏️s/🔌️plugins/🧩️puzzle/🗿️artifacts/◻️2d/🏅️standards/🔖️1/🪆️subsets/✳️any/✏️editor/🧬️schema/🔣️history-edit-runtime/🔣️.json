{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle2d/editor/history-edit-runtime/schema.json",
  "title": "Puzzle2dHistoryEditRuntimeFixture",
  "description": "⏪️ Scenarios that prove the history-edit runtime on puzzle 2d: authored logs, history-session steps through the reserved `historyEdit*` verbs, undo/redo and reloads, with the expected session, outcomes, history-edit rows and named heads (`🧫️fixtures/🧫️history-edit-runtime/🔣️.json`).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "description", "board", "scenarios"],
  "properties": {
    "schema": { "const": "s.puzzle2d.history-edit-runtime.v1" },
    "description": { "type": "string" },
    "board": {
      "type": "object",
      "required": ["schema", "nodes", "edges"],
      "properties": {
        "schema": { "const": "puzzle.2d.fixture" },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x", "y"],
            "properties": { "id": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "locked": { "type": "boolean" } }
          }
        },
        "edges": { "type": "array" }
      }
    },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Scenario" } }
  },
  "definitions": {
    "Ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "Leaf": {
      "type": "object",
      "required": ["mutation"],
      "properties": { "mutation": { "enum": ["dragSelection", "createNode", "changeNodeLocked"] } }
    },
    "Severity": { "enum": ["info", "warning", "error", "fatal"] },
    "Label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } }
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "locked": { "type": "boolean" } }
    },
    "Edit": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["index", "leaf"], "properties": { "index": { "type": "integer", "minimum": 0 }, "leaf": { "$ref": "#/definitions/Leaf" } } },
        { "type": "object", "additionalProperties": false, "required": ["index", "withdrawn"], "properties": { "index": { "type": "integer", "minimum": 0 }, "withdrawn": { "const": true } } }
      ]
    },
    "Head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edits", "nodes"],
      "properties": {
        "edits": { "type": "array", "items": { "$ref": "#/definitions/Edit" } },
        "nodes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/definitions/Point" } },
        "absent": { "$ref": "#/definitions/Ids" }
      }
    },
    "Outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "worst", "code"],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "worst": { "$ref": "#/definitions/Severity" },
        "code": { "type": "string", "pattern": "^mutation\\." },
        "target": { "$ref": "#/definitions/Ids" },
        "introduced": { "type": "boolean" }
      }
    },
    "Expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": { "type": "integer", "minimum": 0 },
        "stage": { "enum": [null, "editing", "replaying", "reviewing", "choosing", "finalizing"] },
        "review": { "enum": ["noChanges", "needsReplay", "blocked", "ready"] },
        "blocking": { "type": "boolean" },
        "worst": { "$ref": "#/definitions/Severity" },
        "acceptedCount": { "type": "integer", "minimum": 0 },
        "fault": { "type": "string" },
        "rerunnable": { "type": "boolean" },
        "nextProblem": { "type": "object", "additionalProperties": false, "required": ["row"], "properties": { "row": { "type": "integer", "minimum": 0 } } },
        "outcomes": { "type": "array", "items": { "$ref": "#/definitions/Outcome" } },
        "draft": { "type": "object" },
        "head": { "type": "string" },
        "historyEdits": { "type": "array", "items": { "$ref": "#/definitions/Label" } },
        "alternative": { "type": "string", "minLength": 1 },
        "words": {
          "type": "object",
          "additionalProperties": false,
          "required": ["row", "en", "de"],
          "properties": { "row": { "type": "integer", "minimum": 0 }, "en": { "type": "string" }, "de": { "type": "string" } }
        }
      }
    },
    "Step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "properties": {
        "translate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["select", "dx", "dy", "step"],
          "properties": { "select": { "$ref": "#/definitions/Ids" }, "dx": { "type": "number" }, "dy": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "ingest": { "$ref": "#/definitions/Leaf" },
        "select": { "$ref": "#/definitions/Ids" },
        "begin": {
          "oneOf": [
            { "const": "nextProblem" },
            { "type": "object", "additionalProperties": false, "required": ["row"], "properties": { "row": { "type": "integer", "minimum": 0 } } }
          ]
        },
        "input": { "type": "object", "additionalProperties": false, "required": ["path", "value"], "properties": { "path": { "type": "string", "pattern": "^/" }, "value": {} } },
        "useSelection": { "type": "string", "pattern": "^/" },
        "withdraw": { "type": "null" },
        "accept": { "type": "null" },
        "acceptPending": { "type": "null" },
        "cancelReplay": { "type": "null" },
        "rerun": { "type": "null" },
        "exit": { "type": "null" },
        "finalize": {
          "oneOf": [
            { "const": "overwrite" },
            { "type": "object", "additionalProperties": false, "required": ["alternative"], "properties": { "alternative": { "type": "string", "minLength": 1 } } }
          ]
        },
        "undo": { "type": "null" },
        "redo": { "type": "null" },
        "reload": { "enum": ["text", "pack"] },
        "expect": { "$ref": "#/definitions/Expect" }
      },
      "additionalProperties": false
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "log", "heads", "steps"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "log": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Leaf" } },
        "heads": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/definitions/Head" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Step" } }
      }
    }
  }
}
