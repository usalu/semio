      },
      "x-semio-state": "artifact"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/puzzle/puzzle2d/artifact.json#/$defs/Puzzle2dEdge"
      },
      "x-semio-state": "artifact"
    },
    "meta": {
