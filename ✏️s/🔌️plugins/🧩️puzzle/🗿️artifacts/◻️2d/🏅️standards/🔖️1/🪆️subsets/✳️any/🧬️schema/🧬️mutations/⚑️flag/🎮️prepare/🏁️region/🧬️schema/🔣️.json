{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "control",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "control": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "rows",
          "mutation",
          "status",
          "index",
          "previous",
          "inverse",
          "after"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "region-hidden",
              "region-locked"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "value": {
                  "type": "boolean"
                }
              }
            }
          },
          "mutation": {
            "type": "object",
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          "status": {
            "enum": [
              "changed",
              "no-op",
              "target-missing"
            ]
          },
          "index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "previous": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "inverse": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "mutation",
                    "id",
                    "newHidden"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "mutation": {
                      "const": "changeTargetRegionHidden"
                    },
                    "id": {
                      "type": "string"
                    },
                    "newHidden": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "mutation",
                    "id",
                    "newLocked"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "mutation": {
                      "const": "changeTargetRegionLocked"
                    },
                    "id": {
                      "type": "string"
                    },
                    "newLocked": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "after": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "required": [
                "id",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "value": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
