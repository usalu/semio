{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/puzzle/2d/1/any/mutation/add-node-handle.json",
  "title": "AddNodeHandle",
  "description": "The `add-node-handle` mutation record — internally tagged `\"mutation\": \"addNodeHandle\"`, the one branch the aggregate `../🔣️.json` union carries for this kind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "nodeId",
    "handle"
  ],
  "properties": {
    "mutation": {
      "const": "addNodeHandle"
    },
    "nodeId": {
      "type": "string"
    },
    "handle": {
      "$ref": "#/$defs/Puzzle2dHandle"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "$defs": {
    "Puzzle2dHandle": {
      "title": "Puzzle2dHandle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "angle"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "handleKind": {
          "type": "string"
        },
        "angle": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "iconKind": {
          "type": "string"
        },
        "scale": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    }
  }
}
