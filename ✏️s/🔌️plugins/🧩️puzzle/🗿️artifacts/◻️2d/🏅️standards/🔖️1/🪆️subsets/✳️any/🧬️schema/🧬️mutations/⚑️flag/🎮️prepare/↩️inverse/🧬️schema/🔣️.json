{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "inverse"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "inverse": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "mutation",
                    "id",
                    "newLocked"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "mutation": {
                      "const": "changeNodeLocked"
                    },
                    "id": {
                      "type": "string"
                    },
                    "newLocked": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "mutation",
                    "id",
                    "newVisible"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "mutation": {
                      "const": "changeNodeVisible"
                    },
                    "id": {
                      "type": "string"
                    },
                    "newVisible": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "mutation",
                    "id",
                    "newLocked"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "mutation": {
                      "const": "changeEdgeLocked"
                    },
                    "id": {
                      "type": "string"
                    },
                    "newLocked": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "mutation",
                    "id",
                    "newVisible"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "mutation": {
                      "const": "changeEdgeVisible"
                    },
                    "id": {
                      "type": "string"
                    },
                    "newVisible": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
