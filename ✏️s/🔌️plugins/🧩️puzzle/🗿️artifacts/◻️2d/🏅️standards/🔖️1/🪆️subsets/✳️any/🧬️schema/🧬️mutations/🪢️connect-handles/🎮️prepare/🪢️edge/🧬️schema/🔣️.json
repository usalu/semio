{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "control",
    "cases"
  ],
  "properties": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumTurnBytes",
        "cancelAfterBodyBytes",
        "largePrefix",
        "largeRepeats"
      ],
      "properties": {
        "maximumItems": {
          "const": 1
        },
        "maximumTurnBytes": {
          "const": 4096
        },
        "cancelAfterBodyBytes": {
          "const": 128
        },
        "largePrefix": {
          "type": "string"
        },
        "largeRepeats": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "mutation",
          "edge"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "mutation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "target",
              "edgeKind",
              "sourceTip",
              "targetTip",
              "scalarBits",
              "toleranceBits",
              "index"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "edgeKind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceTip": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "targetTip": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scalarBits": {
                "type": "array",
                "minItems": 8,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              },
              "toleranceBits": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "index": {
                "type": "string",
                "pattern": "^[0-9]+$"
              }
            }
          },
          "edge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "target",
              "edgeKind",
              "sourceTip",
              "targetTip",
              "scalarBits",
              "visible",
              "locked"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "edgeKind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceTip": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "targetTip": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scalarBits": {
                "type": "array",
                "minItems": 8,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              },
              "visible": {
                "type": "null"
              },
              "locked": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  }
}
