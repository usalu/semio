{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Puzzle2dOptionalTextPreparationCases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "pausePoints"
  ],
  "properties": {
    "pausePoints": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "before",
          "next",
          "target",
          "expected"
        ],
        "properties": {
          "role": {
            "enum": [
              "nodeIcon",
              "regionLabel"
            ]
          },
          "before": {
            "type": [
              "string",
              "null"
            ]
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": "boolean"
          },
          "expected": {
            "enum": [
              "changed",
              "noOp",
              "targetMissing"
            ]
          }
        }
      }
    }
  }
}
