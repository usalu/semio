{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/s/puzzle/puzzle2d/mutations/replace-node-handle.json",
  "title": "ReplaceNodeHandle",
  "description": "The `replace-node-handle` mutation record — internally tagged `\"mutation\": \"replaceNodeHandle\"`, the one branch the aggregate `../🔣️.json` union carries for this kind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "nodeId",
    "handleId",
    "newHandle"
  ],
  "properties": {
    "mutation": {
      "const": "replaceNodeHandle"
    },
    "nodeId": {
      "type": "string"
    },
    "handleId": {
      "type": "string"
    },
    "newHandle": {
      "$ref": "#/$defs/Puzzle2dHandle"
    }
  },
  "$defs": {
    "Puzzle2dHandle": {
      "title": "Puzzle2dHandle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "angle"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "handleKind": {
          "type": "string"
        },
        "angle": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "iconKind": {
          "type": "string"
        },
        "scale": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    }
  }
}
