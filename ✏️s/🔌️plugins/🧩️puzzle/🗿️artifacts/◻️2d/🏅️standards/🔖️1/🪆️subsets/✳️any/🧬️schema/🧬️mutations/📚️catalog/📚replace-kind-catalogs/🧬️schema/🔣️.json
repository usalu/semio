  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "replaceKindCatalogs",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "newCatalogs": {
      "anyOf": [
        {
          "$ref": "#/$defs/Puzzle2dKindCatalogs"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Kind catalogs",
          "de": "Artenkataloge"
        },
        "description": {
          "en": "Node, handle, edge and wire kind tables; empty removes them.",
          "de": "Knoten-, Anschluss-, Kanten- und Leitungsartentabellen; leer entfernt sie."
        },
        "group": "record",
        "order": 10
      }
    }
  },
