{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Puzzle Board Drawing Output Witness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot",
    "dwg",
    "page"
  ],
  "properties": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "camera",
        "nodes",
        "edges",
        "targetRegions",
        "meta"
      ],
      "properties": {
        "schema": {
          "const": "board.ports.directed.v1"
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number"
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "x",
              "y"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "radius": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "shape": {
                "enum": [
                  "circle",
                  "rectangle"
                ]
              },
              "text": {
                "type": "string"
              },
              "visible": {
                "type": "boolean"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "targetRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "x",
              "y",
              "width",
              "height",
              "label",
              "hidden",
              "locked"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "label": {
                "type": "string"
              },
              "hidden": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              }
            }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    },
    "dwg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "circles",
        "texts"
      ],
      "properties": {
        "standard": {
          "const": "AC1024"
        },
        "circles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "center",
              "radius"
            ],
            "properties": {
              "center": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "texts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "value"
            ],
            "properties": {
              "at": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages",
        "paths",
        "labels"
      ],
      "properties": {
        "pages": {
          "type": "integer",
          "minimum": 1
        },
        "paths": {
          "type": "integer",
          "minimum": 1
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
