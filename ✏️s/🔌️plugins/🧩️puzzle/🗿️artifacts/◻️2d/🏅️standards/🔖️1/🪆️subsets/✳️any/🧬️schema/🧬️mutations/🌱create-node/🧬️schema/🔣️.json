        "locked": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Locked",
              "de": "Gesperrt"
            },
            "group": "state",
            "order": 90
          }
        }
      }
    },
