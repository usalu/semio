{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/puzzle/2d/1/any/mutation/create-node/schema.json",
  "title": "CreateNode",
  "description": "The `create-node` mutation record — internally tagged `\"mutation\": \"createNode\"`, the one branch the aggregate `../🔣️.json` union carries for this kind.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "node"
  ],
  "properties": {
    "mutation": {
      "const": "createNode"
    },
    "node": {
      "$ref": "#/$defs/Puzzle2dNode"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "$defs": {
    "Puzzle2dHandle": {
      "title": "Puzzle2dHandle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "angle"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "handleKind": {
          "type": "string"
        },
        "angle": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "iconKind": {
          "type": "string"
        },
        "scale": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "Puzzle2dNode": {
      "title": "Puzzle2dNode",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "anchor",
        "handles"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "nodeKind": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "iconKind": {
          "type": "string"
        },
        "root": {
          "type": "boolean"
        },
        "scale": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "anchor": {
          "$ref": "#/$defs/Puzzle2dNodeAnchor"
        },
        "handles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Puzzle2dHandle"
          }
        }
      }
    },
    "Puzzle2dNodeAnchor": {
      "title": "Puzzle2dNodeAnchor",
      "type": "string",
      "enum": [
        "fixed",
        "derived"
      ]
    }
  }
}
