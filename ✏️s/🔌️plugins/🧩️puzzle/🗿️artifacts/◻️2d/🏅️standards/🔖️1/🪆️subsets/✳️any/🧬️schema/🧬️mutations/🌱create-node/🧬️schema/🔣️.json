            "group": "appearance",
            "order": 60
          }
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "Scale",
              "de": "Skalierung"
            },
            "step": 0.01,
            "precision": 2,
            "softMin": 0.1,
            "softMax": 10,
            "scale": "log",
            "snaps": [
              0.25,
              0.5,
              1,
              2,
              4
            ],
            "group": "appearance",
            "order": 70
          }
        },
        "visible": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
