{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "control",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "control": {
      "type": "object",
      "required": [
        "maximumItems",
        "maximumTurnBytes",
        "largePrefix",
        "largeRepeats",
        "cancelAfterBodyBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "maximumItems": {
          "const": 1
        },
        "maximumTurnBytes": {
          "const": 4096
        },
        "largePrefix": {
          "const": "😀é"
        },
        "largeRepeats": {
          "const": 20000
        },
        "cancelAfterBodyBytes": {
          "const": 128
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "id",
          "source",
          "target",
          "gapWord",
          "base",
          "position",
          "changed",
          "inverse"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "gapWord": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "base": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "changed": {
            "type": "boolean"
          },
          "inverse": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "disconnect-handles"
                },
                "id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
