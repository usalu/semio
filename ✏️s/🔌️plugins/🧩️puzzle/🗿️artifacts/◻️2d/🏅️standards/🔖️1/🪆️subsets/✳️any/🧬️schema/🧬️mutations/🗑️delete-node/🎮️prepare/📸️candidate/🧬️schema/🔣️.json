{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Puzzle Native Node Deletion Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["maximumItems", "maximumTurnBytes", "journeys", "cases"],
  "properties": {
    "maximumItems": {"const": 1},
    "maximumTurnBytes": {"const": 4096},
    "journeys": {"const": ["firstNodeOnly", "firstMatchingEdgeId", "duplicateTargetRefusal", "sortedOriginalOrdinals", "allUntouchedOwners", "zeroGrant", "sourceSwap", "cancelDuringCascade", "cancelDuringSnapshotCopy", "cancelDuringRemoval", "takeOnce", "controlledRetirement"]},
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nodes", "edges", "target", "status", "removed", "afterNodes", "afterEdges"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "target": {"type": "string"},
          "status": {"enum": ["changed", "unchanged", "refused"]},
          "nodes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "handles"], "properties": {"id": {"type": "string"}, "handles": {"type": "array", "items": {"type": "string"}}}}},
          "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "source", "target"], "properties": {"id": {"type": "string"}, "source": {"type": "string"}, "target": {"type": "string"}}}},
          "removed": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "afterNodes": {"type": "array", "items": {"type": "string"}},
          "afterEdges": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
