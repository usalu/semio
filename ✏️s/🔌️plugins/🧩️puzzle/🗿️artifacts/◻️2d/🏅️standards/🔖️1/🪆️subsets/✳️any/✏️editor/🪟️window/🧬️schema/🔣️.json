{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/puzzle/puzzle2d/window.json",
  "definitions": {
    "Puzzle2dWindowConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cameraX", "cameraY", "cameraZoom", "lodMode", "gridVisible", "gridSnapEnabled", "gridFactor", "suggestionOffset", "proximityRadius", "areaBrushWidth", "areaBrushHeight", "transformMove", "transformRotate", "selectableNodes", "selectableHandles", "selectableEdges"],
      "properties": {
        "cameraX": {"type": "number", "x-semio-state": "window-config"},
        "cameraY": {"type": "number", "x-semio-state": "window-config"},
        "cameraZoom": {"type": "number", "x-semio-state": "window-config"},
        "lodMode": {"type": "string", "x-semio-state": "window-config"},
        "gridVisible": {"type": "boolean", "default": true, "x-semio-state": "window-config"},
        "gridSnapEnabled": {"type": "boolean", "x-semio-state": "window-config"},
        "gridFactor": {"type": "number", "x-semio-state": "window-config"},
        "suggestionOffset": {"type": "number", "x-semio-state": "window-config"},
        "proximityRadius": {"type": "number", "minimum": 0, "default": 12, "x-semio-state": "window-config"},
        "areaBrushWidth": {"type": "number", "minimum": 1, "default": 1, "x-semio-state": "window-config"},
        "areaBrushHeight": {"type": "number", "minimum": 1, "default": 1, "x-semio-state": "window-config"},
        "transformMove": {"type": "boolean", "default": true, "x-semio-state": "window-config"},
        "transformRotate": {"type": "boolean", "default": true, "x-semio-state": "window-config"},
        "selectableNodes": {"type": "boolean", "default": true, "x-semio-state": "window-config"},
        "selectableHandles": {"type": "boolean", "default": true, "x-semio-state": "window-config"},
        "selectableEdges": {"type": "boolean", "default": true, "x-semio-state": "window-config"}
      }
    },
    "Puzzle2dSuggestionMenu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "windowId", "handleId"],
      "properties": {
        "x": {"type": "number", "x-semio-state": "window-transient"},
        "y": {"type": "number", "x-semio-state": "window-transient"},
        "windowId": {"type": "string", "x-semio-state": "window-transient"},
        "handleId": {"type": "string", "x-semio-state": "window-transient"}
      }
    },
    "Puzzle2dWindowTransient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engagementInput", "brushCandidateIndex", "brushCandidates", "brushCandidateSourceHandleId"],
      "properties": {
        "engagementInput": {"type": "string", "x-semio-state": "window-transient"},
        "brushCandidateIndex": {"type": "integer", "minimum": 0, "x-semio-state": "window-transient"},
        "brushCandidates": {"type": "array", "items": {}, "x-semio-state": "window-transient"},
        "brushCandidateSourceHandleId": {"type": "string", "x-semio-state": "window-transient"},
        "suggestionMenu": {"anyOf": [{"$ref": "#/definitions/Puzzle2dSuggestionMenu"}, {"type": "null"}], "x-semio-state": "window-transient"},
        "selectTool": {"anyOf": [{"$ref": "#/definitions/Puzzle2dSelectToolState"}, {"type": "null"}], "x-semio-state": "window-transient"}
      }
    },
    "Puzzle2dSelectToolState": {
      "description": "🛠️ A window's in-flight select-tool gesture between dispatches: the statechart configuration by stable ids, the admission and document revision it opened on, whether its drop connects, and the open tool transaction's provisional entries. Ephemeral tool state, never history.",
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "verb", "authoringSeed", "baseRevision", "connect", "transaction", "entries"],
      "properties": {
        "states": {"type": "array", "items": {"type": "string", "minLength": 1}, "x-semio-state": "window-transient"},
        "verb": {"type": "string", "minLength": 1, "x-semio-state": "window-transient"},
        "authoringSeed": {"type": "string", "x-semio-state": "window-transient"},
        "baseRevision": {"type": "string", "x-semio-state": "window-transient"},
        "connect": {"type": "boolean", "x-semio-state": "window-transient"},
        "transaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "tool"],
          "properties": {"id": {"type": "string", "minLength": 1}, "tool": {"type": "string", "minLength": 1}},
          "x-semio-state": "window-transient"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "mutation"],
            "properties": {"key": {"type": "string", "minLength": 1}, "mutation": { "description": "One provisional puzzle 2d mutation in value form — a branch of https://json.schemas.assets.semio-tech.com/s/puzzle/puzzle2d/mutations.json, internally tagged on `mutation` with the camelCase variant name.", "type": "object", "required": ["mutation"], "properties": { "mutation": { "type": "string", "minLength": 1 } } }}
          },
          "x-semio-state": "window-transient"
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/Puzzle2dWindowConfig" },
    { "$ref": "#/definitions/Puzzle2dWindowTransient" }
  ]
}
