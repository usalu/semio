{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "journeys",
    "cases",
    "insertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "journeys": {
      "const": [
        "firstEdge",
        "middleEdge",
        "lastEdge",
        "allCascadeEdges",
        "selfEdgeOnce",
        "optionalFalse",
        "optionalTrue",
        "absentFlags",
        "unicodeNul",
        "clampedInsertion"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "edges",
          "removed"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source",
                "target"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "visible": {
                  "type": "boolean"
                },
                "locked": {
                  "type": "boolean"
                }
              }
            }
          },
          "removed": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "insertions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "index",
          "after"
        ],
        "properties": {
          "before": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
