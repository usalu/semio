        { "translate": { "select": ["mid"], "dx": 0.0, "dy": 1.0, "step": 10.0 }, "expect": { "rows": 2, "head": "original" } },
        { "begin": { "row": 0 }, "expect": { "stage": "editing" } },
        { "input": { "path": "/dx", "value": 30.0 } },
        { "accept": null, "expect": { "stage": "reviewing", "review": "ready", "blocking": false, "acceptedCount": 1 } },
        { "begin": { "row": 1 }, "expect": { "stage": "editing", "acceptedCount": 1 } },
        { "input": { "path": "/dy", "value": 20.0 } },
        { "accept": null, "expect": { "stage": "reviewing", "review": "ready", "blocking": false, "acceptedCount": 2 } },
        { "finalize": "overwrite", "expect": { "stage": null, "head": "edited", "historyEdits": [{ "en": "History edited — overwrite: 2 mutations", "de": "Verlauf bearbeitet — überschrieben: 2 Mutationen" }] } },
        { "undo": null, "expect": { "head": "original", "historyEdits": [{ "en": "History edit undone — overwrite: 2 mutations", "de": "Verlaufsbearbeitung rückgängig — überschrieben: 2 Mutationen" }, { "en": "History edited — overwrite: 2 mutations", "de": "Verlauf bearbeitet — überschrieben: 2 Mutationen" }] } },
        { "redo": null, "expect": { "head": "edited" } }
