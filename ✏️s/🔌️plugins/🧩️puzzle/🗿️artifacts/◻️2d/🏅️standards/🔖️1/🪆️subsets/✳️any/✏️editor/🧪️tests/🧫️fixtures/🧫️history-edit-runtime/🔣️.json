        "edited": {
          "edits": [
            { "index": 0, "leaf": { "mutation": "dragSelection", "targets": ["left"], "dx": 30.0, "dy": 0.0 } },
            { "index": 1, "leaf": { "mutation": "dragSelection", "targets": ["mid"], "dx": 0.0, "dy": 20.0 } }
          ],
          "nodes": { "left": { "x": -170.0, "y": 0.0 }, "mid": { "x": 0.0, "y": 20.0 }, "pin": { "x": 200.0, "y": 0.0, "locked": true } }
        }
      },
      "steps": [
