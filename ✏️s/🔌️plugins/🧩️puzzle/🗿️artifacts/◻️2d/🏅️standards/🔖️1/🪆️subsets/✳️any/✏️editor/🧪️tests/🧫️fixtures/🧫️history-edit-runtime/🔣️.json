        { "reload": "text", "expect": { "stage": null, "head": "withdrawn", "outcomes": [{ "row": 1, "worst": "warning", "code": "mutation.partial", "target": ["pin"], "introduced": false }], "words": { "row": 1, "en": "Warning", "de": "Warnung" } } },
