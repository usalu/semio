        "mutating": true,
        "rebase": "revalidate",
        "reconfigure": "resume",
        "trace": "placement2d",
        "runJob": "puzzle2d.fill.run",
        "revalidateJob": "puzzle2d.fill.revalidate",
        "unit": {
          "en": "placements",
          "de": "Platzierungen"
        },
        "stages": [
          {
            "id": "capture",
            "en": "Capturing the board",
            "de": "Brett wird erfasst"
          },
          {
            "id": "search",
            "en": "Searching an open handle",
            "de": "Offener Anschluss wird gesucht"
          },
          {
            "id": "test",
            "en": "Testing candidates",
            "de": "Kandidaten werden geprüft"
          },
          {
            "id": "place",
            "en": "Placing",
            "de": "Wird platziert"
          },
          {
            "id": "retract",
            "en": "Retracting",
            "de": "Wird zurückgenommen"
          }
        ],
        "counters": [
          {
            "id": "tested",
            "en": "Tested",
            "de": "Geprüft"
          },
          {
            "id": "accepted",
            "en": "Accepted",
            "de": "Angenommen"
