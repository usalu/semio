        "cancellation": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "attachCalls",
              "freeBeforeSettle",
              "freeAfterSettle"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "constructing",
                  "attaching",
                  "ready"
                ]
              },
              "attachCalls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "freeBeforeSettle": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "freeAfterSettle": {
                "const": 1
              }
            }
          }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pluginId",
              "appId",
              "instanceId",
              "matches"
            ],
            "properties": {
              "pluginId": {
                "type": "string"
              },
              "appId": {
                "type": "string"
              },
              "instanceId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "matches": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "title": "Puzzle2dWasmSessionFactory",
      "description": "The `s.puzzle2d` editor/viewer wasm BoardSession factory contract: which crate and artifacts the session module is built from, which failures it retries, how construction cancels in each phase, and how a session scope matches a plugin/app/instance triple.",
