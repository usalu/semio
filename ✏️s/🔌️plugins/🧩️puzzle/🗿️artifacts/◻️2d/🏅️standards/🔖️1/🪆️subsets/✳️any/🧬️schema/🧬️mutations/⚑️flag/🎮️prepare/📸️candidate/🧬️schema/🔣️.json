{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "after"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "after": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
