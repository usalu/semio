{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "pausePoints"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "before",
          "next",
          "target",
          "expectedInverse"
        ],
        "properties": {
          "role": {
            "enum": [
              "nodeIcon",
              "regionLabel"
            ]
          },
          "before": {
            "type": [
              "string",
              "null"
            ]
          },
          "next": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": "boolean"
          },
          "expectedInverse": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "previous"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "previous": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "pausePoints": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
