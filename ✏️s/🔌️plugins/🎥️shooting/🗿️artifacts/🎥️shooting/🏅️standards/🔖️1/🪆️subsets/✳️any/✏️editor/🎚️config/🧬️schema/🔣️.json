{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/shooting/shooting/config/schema.json",
  "title": "ShootingConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaultShotFormat",
    "defaultShotShape",
    "defaultAssetFormat",
    "selectedShotIds",
    "centerModel",
    "fitRevision",
    "cameraDraftLabel",
    "camera",
    "activeUtilityId"
  ],
  "properties": {
    "defaultShotFormat": {
      "type": "string",
      "x-semio-state": "config"
    },
    "defaultShotShape": {
      "type": "string",
      "x-semio-state": "config"
    },
    "defaultAssetFormat": {
      "type": "string",
      "x-semio-state": "config"
    },
    "selectedShotIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "centerModel": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "fitRevision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "cameraDraftLabel": {
      "type": "string",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "https://semio.tech/schema/s/shooting/shooting/artifact.json#/$defs/ShootingCamera",
      "x-semio-state": "config"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "config"
    }
  }
}
