dialect grammar
grammar shooting.op
extension shooting
start mutation

mutation = object
object = "{" SP* (member (SP* "," SP* member)*)? SP* "}"
member = TEXT SP* ":" SP* value
value = object | array | TEXT | FLOAT | INT | "true" | "false" | "null"
array = "[" SP* (value (SP* "," SP* value)*)? SP* "]"
