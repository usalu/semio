{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/mutation/set-shot-auto-fit/schema.json",
  "title": "SetShotAutoFit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "autoFit"
  ],
  "properties": {
    "mutation": {
      "const": "setShotAutoFit"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Shot",
          "de": "Aufnahme"
        },
        "description": {
          "en": "The shot this mutation addresses.",
          "de": "Die Aufnahme, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "shot"
        },
        "group": "target",
        "order": 10
      }
    },
    "autoFit": {
      "type": [
        "boolean",
        "null"
      ],
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Auto fit",
          "de": "Automatische Einpassung"
        },
        "description": {
          "en": "Null removes the override so the shot inherits the scene setting.",
          "de": "Null entfernt die Überschreibung, damit die Aufnahme die Szeneneinstellung erbt."
        },
        "group": "framing",
        "order": 20
      }
    }
  }
}
