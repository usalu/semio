{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/mutation/change-scene-sun-intensity/schema.json",
  "title": "ChangeSceneSunIntensity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newIntensity"
  ],
  "properties": {
    "mutation": {
      "const": "changeSceneSunIntensity"
    },
    "newIntensity": {
      "type": "number",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Sun intensity",
          "de": "Sonnenlichtstärke"
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 4,
        "snaps": [
          0,
          0.5,
          1,
          2,
          4
        ],
        "group": "lighting",
        "order": 10
      }
    }
  }
}
