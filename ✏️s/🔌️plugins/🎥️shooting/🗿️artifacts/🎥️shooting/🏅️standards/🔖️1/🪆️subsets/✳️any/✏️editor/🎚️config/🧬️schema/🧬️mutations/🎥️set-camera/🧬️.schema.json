{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Set Camera",
  "type": "object",
  "properties": {
    "camera": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "zoom": {
          "type": "number"
        },
        "fov": {
          "type": "number"
        },
        "up": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "projection": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "position",
        "target",
        "zoom",
        "fov"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "camera"
  ],
  "additionalProperties": false
}
