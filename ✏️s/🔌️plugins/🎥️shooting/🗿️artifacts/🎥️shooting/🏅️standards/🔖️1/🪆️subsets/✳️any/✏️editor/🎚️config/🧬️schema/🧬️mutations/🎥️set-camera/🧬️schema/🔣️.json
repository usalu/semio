{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/shooting/shooting/config/mutation/set-camera/schema.json",
  "title": "SetCamera",
  "type": "object",
  "properties": {
    "camera": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Position",
              "de": "Position"
            },
            "description": {
              "en": "Where the camera stands.",
              "de": "Standpunkt der Kamera."
            },
            "step": 0.1,
            "group": "camera",
            "order": 10
          }
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Look at",
              "de": "Blickziel"
            },
            "description": {
              "en": "The point the camera looks at.",
              "de": "Der Punkt, auf den die Kamera blickt."
            },
            "step": 0.1,
            "group": "camera",
            "order": 20
          }
        },
        "zoom": {
          "type": "number",
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "Zoom",
              "de": "Zoom"
            },
            "step": 0.01,
            "precision": 2,
            "softMin": 0.1,
            "softMax": 10,
            "scale": "log",
            "snaps": [
              0.5,
              1,
              2
            ],
            "group": "camera",
            "order": 30
          }
        },
        "fov": {
          "type": "number",
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "Field of view",
              "de": "Sichtfeld"
            },
            "description": {
              "en": "Vertical opening angle of a perspective camera.",
              "de": "Vertikaler Öffnungswinkel einer perspektivischen Kamera."
            },
            "unit": "deg",
            "step": 1,
            "precision": 1,
            "softMin": 10,
            "softMax": 120,
            "snaps": [
              30,
              45,
              60,
              90
            ],
            "group": "camera",
            "order": 40
          }
        },
        "up": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Up",
              "de": "Oben"
            },
            "description": {
              "en": "Up direction of the camera image.",
              "de": "Aufwärtsrichtung des Kamerabilds."
            },
            "step": 0.1,
            "group": "camera",
            "order": 50
          }
        },
        "projection": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Projection",
              "de": "Projektion"
            },
            "description": {
              "en": "perspective or orthographic.",
              "de": "perspective (perspektivisch) oder orthographic (orthografisch)."
            },
            "group": "camera",
            "order": 60
          }
        }
      },
      "required": [
        "position",
        "target",
        "zoom",
        "fov"
      ],
      "additionalProperties": false,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Viewport camera",
          "de": "Ansichtskamera"
        },
        "group": "camera",
        "order": 10
      }
    }
  },
  "required": [
    "camera"
  ],
  "additionalProperties": false
}
