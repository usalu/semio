{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/shooting/shooting/presence/mutation/replace-presence/schema.json",
  "title": "ReplacePresence",
  "type": "object",
  "properties": {
    "presence": {
      "type": "object",
      "properties": {
        "selectedShotIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "camera": {
          "type": "object",
          "properties": {
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "target": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "zoom": {
              "type": "number"
            },
            "fov": {
              "type": "number"
            },
            "up": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ]
            },
            "projection": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "position",
            "target",
            "zoom",
            "fov"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "selectedShotIds",
        "camera"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "presence"
  ],
  "additionalProperties": false
}
