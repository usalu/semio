{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/mutation/change-scene-sun-azimuth/schema.json",
  "title": "ChangeSceneSunAzimuth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newAzimuth"
  ],
  "properties": {
    "mutation": {
      "const": "changeSceneSunAzimuth"
    },
    "newAzimuth": {
      "type": "number",
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "Sun azimuth",
          "de": "Sonnenazimut"
        },
        "description": {
          "en": "Compass direction of the sun.",
          "de": "Himmelsrichtung der Sonne."
        },
        "unit": "deg",
        "step": 1,
        "precision": 1,
        "softMin": 0,
        "softMax": 360,
        "snaps": [
          0,
          90,
          180,
          270,
          360
        ],
        "group": "lighting",
        "order": 10
      }
    }
  }
}
