{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/snapshot.json",
  "title": "ShootingSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assets",
    "savedCameras",
    "scene",
    "shots",
    "activeShotId",
    "activeAssetId"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/artifact.json#/$defs/ShootingAsset"
      },
      "x-semio-state": "artifact"
    },
    "savedCameras": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/artifact.json#/$defs/ShootingSavedCamera"
      },
      "x-semio-state": "artifact"
    },
    "scene": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/artifact.json#/$defs/ShootingSceneLighting",
      "x-semio-state": "artifact"
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/artifact.json#/$defs/ShootingShot"
      },
      "x-semio-state": "artifact"
    },
    "activeShotId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "activeAssetId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "emblem": {
      "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.image"
    }
  }
}
