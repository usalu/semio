{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateAsset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset"
  ],
  "properties": {
    "asset": {
      "title": "ShootingAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "id",
        "name",
        "origin",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "orientation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
