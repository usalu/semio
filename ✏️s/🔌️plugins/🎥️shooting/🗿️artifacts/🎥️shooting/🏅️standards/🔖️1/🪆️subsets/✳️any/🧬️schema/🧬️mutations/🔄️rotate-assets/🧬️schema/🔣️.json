{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/mutation/rotate-assets/schema.json",
  "title": "RotateAssets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "angle",
    "assetIds",
    "ax",
    "ay",
    "az"
  ],
  "properties": {
    "mutation": {
      "const": "rotateAssets"
    },
    "assetIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Assets",
          "de": "Objekte"
        },
        "description": {
          "en": "Assets to transform; missing ones are skipped.",
          "de": "Zu transformierende Objekte; fehlende werden übersprungen."
        },
        "ref": {
          "kind": "asset",
          "domain": "assets",
          "granularity": "asset"
        },
        "group": "target",
        "order": 10
      }
    },
    "ax": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Axis X",
          "de": "Achse X"
        },
        "description": {
          "en": "Rotation axis; its length does not matter.",
          "de": "Drehachse; ihre Länge spielt keine Rolle."
        },
        "step": 0.1,
        "precision": 3,
        "group": "axis",
        "order": 20
      }
    },
    "ay": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Axis Y",
          "de": "Achse Y"
        },
        "step": 0.1,
        "precision": 3,
        "group": "axis",
        "order": 30
      }
    },
    "az": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Axis Z",
          "de": "Achse Z"
        },
        "step": 0.1,
        "precision": 3,
        "group": "axis",
        "order": 40
      }
    },
    "angle": {
      "type": "number",
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "Angle",
          "de": "Winkel"
        },
        "description": {
          "en": "Right-handed rotation about the axis.",
          "de": "Rechtshändige Drehung um die Achse."
        },
        "unit": "rad",
        "displayUnit": "deg",
        "displayFactor": 57.29577951308232,
        "step": 0.017453292519943295,
        "precision": 4,
        "softMin": -3.141592653589793,
        "softMax": 3.141592653589793,
        "snaps": [
          -3.141592653589793,
          -1.5707963267948966,
          0,
          1.5707963267948966,
          3.141592653589793
        ],
        "group": "rotation",
        "order": 50
      }
    }
  }
}
