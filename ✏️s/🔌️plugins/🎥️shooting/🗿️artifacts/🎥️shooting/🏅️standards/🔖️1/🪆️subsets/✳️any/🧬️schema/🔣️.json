{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/shooting/shooting/artifact.json",
  "title": "ShootingArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assets",
    "savedCameras",
    "scene",
    "shots",
    "activeShotId",
    "activeAssetId",
    "selectedShotIds",
    "activeUtilityId",
    "defaultShotFormat",
    "defaultShotShape",
    "defaultAssetFormat",
    "centerModel",
    "fitRevision",
    "cameraDraftLabel",
    "camera"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShootingAsset"
      },
      "x-semio-state": "artifact"
    },
    "savedCameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShootingSavedCamera"
      },
      "x-semio-state": "artifact"
    },
    "scene": {
      "$ref": "#/$defs/ShootingSceneLighting",
      "x-semio-state": "artifact"
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShootingShot"
      },
      "x-semio-state": "artifact"
    },
    "activeShotId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "activeAssetId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "selectedShotIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "defaultShotFormat": {
      "type": "string",
      "x-semio-state": "config"
    },
    "defaultShotShape": {
      "type": "string",
      "x-semio-state": "config"
    },
    "defaultAssetFormat": {
      "type": "string",
      "x-semio-state": "config"
    },
    "centerModel": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "fitRevision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "cameraDraftLabel": {
      "type": "string",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "#/$defs/ShootingCamera",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "ShootingCamera": {
      "title": "ShootingCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "zoom",
        "fov"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "zoom": {
          "type": "number",
          "format": "double"
        },
        "fov": {
          "type": "number",
          "format": "double"
        },
        "up": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "projection": {
          "type": "string"
        }
      }
    },
    "ShootingSavedCamera": {
      "title": "ShootingSavedCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "camera"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "camera": {
          "$ref": "#/$defs/ShootingCamera"
        }
      }
    },
    "ShootingAsset": {
      "title": "ShootingAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url",
        "format",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "orientation": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "ShootingShot": {
      "title": "ShootingShot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "width",
        "height",
        "format",
        "shape"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "format": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "cameraId": {
          "type": "string"
        }
      }
    },
    "ShootingSun": {
      "title": "ShootingSun",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "azimuth",
        "elevation",
        "intensity",
        "color"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "azimuth": {
          "type": "number",
          "format": "double"
        },
        "elevation": {
          "type": "number",
          "format": "double"
        },
        "intensity": {
          "type": "number",
          "format": "double"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "ShootingAmbient": {
      "title": "ShootingAmbient",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intensity",
        "color"
      ],
      "properties": {
        "intensity": {
          "type": "number",
          "format": "double"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "ShootingShadow": {
      "title": "ShootingShadow",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "opacity",
        "softness"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "format": "double"
        },
        "softness": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "ShootingMaterial": {
      "title": "ShootingMaterial",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "metalness",
        "roughness",
        "emissive",
        "emissiveIntensity"
      ],
      "properties": {
        "color": {
          "type": "string"
        },
        "metalness": {
          "type": "number",
          "format": "double"
        },
        "roughness": {
          "type": "number",
          "format": "double"
        },
        "emissive": {
          "type": "string"
        },
        "emissiveIntensity": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "ShootingSceneLighting": {
      "title": "ShootingSceneLighting",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "sun",
        "ambient",
        "shadow",
        "material"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "sun": {
          "$ref": "#/$defs/ShootingSun"
        },
        "ambient": {
          "$ref": "#/$defs/ShootingAmbient"
        },
        "shadow": {
          "$ref": "#/$defs/ShootingShadow"
        },
        "material": {
          "$ref": "#/$defs/ShootingMaterial"
        },
        "emblemBase64": {
          "type": "string"
        }
      }
    },
    "ShootingRetainedCommandStepContract": {
      "type": "object",
      "required": [
        "maxRawBytes",
        "maxDecodedItems",
        "maxWorkUnitsPerStep",
        "maxOutputBytes",
        "maxStepMicros"
      ],
      "properties": {
        "maxRawBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxDecodedItems": {
          "type": "integer",
          "minimum": 1
        },
        "maxWorkUnitsPerStep": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxStepMicros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7999
        },
        "maxCheckpointBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxInFlightPages": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ShootingLoadRequestPublication": {
      "type": "object",
      "required": [
        "toolId",
        "lanes"
      ],
      "properties": {
        "toolId": {
          "const": "loadRequest"
        },
        "lanes": {
          "const": [
            "host-only"
          ]
        }
      },
      "additionalProperties": false
    },
    "ShootingImportAssetRequestPublication": {
      "type": "object",
      "required": [
        "toolId",
        "lanes"
      ],
      "properties": {
        "toolId": {
          "const": "importAssetRequest"
        },
        "lanes": {
          "const": [
            "host-only"
          ]
        }
      },
      "additionalProperties": false
    },
    "ShootingRetainedCommandLimits": {
      "type": "object",
      "required": [
        "controller",
        "documentSchema",
        "factory",
        "limits",
        "publicationContracts",
        "routes",
        "oracle"
      ],
      "properties": {
        "controller": {
          "const": "s.shooting.shooting@1/*#editor"
        },
        "documentSchema": {
          "const": "shooting.shooting"
        },
        "factory": {
          "const": "ShootingCommandJobFactory"
        },
        "limits": {
          "type": "object",
          "required": [
            "bounded",
            "resumable"
          ],
          "properties": {
            "bounded": {
              "$ref": "#/$defs/ShootingRetainedCommandStepContract"
            },
            "resumable": {
              "$ref": "#/$defs/ShootingRetainedCommandStepContract"
            }
          },
          "additionalProperties": false
        },
        "publicationContracts": {
          "type": "array",
          "items": [
            {
              "$ref": "#/$defs/ShootingLoadRequestPublication"
            },
            {
              "$ref": "#/$defs/ShootingImportAssetRequestPublication"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "routes": {
          "allOf": [
            {
              "$ref": "https://semio.tech/schema/framework/ui/schema.json#/$defs/RetainedCommandRoutes"
            },
            {
              "type": "array",
              "minItems": 39,
              "maxItems": 39,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "execution",
                  "admission",
                  "feature"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "execution": {
                    "enum": [
                      "bounded",
                      "resumable"
                    ]
                  },
                  "admission": {
                    "enum": [
                      "migrated",
                      "fail-closed"
                    ]
                  },
                  "feature": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          ]
        },
        "oracle": {
          "type": "object",
          "required": [
            "library",
            "scope",
            "ownedInterface",
            "runtimeDependency",
            "expected"
          ],
          "properties": {
            "library": {
              "const": "serde_json"
            },
            "scope": {
              "const": "test-only-existing-dependency"
            },
            "ownedInterface": {
              "const": "ShootingRetainedCatalogOracle"
            },
            "runtimeDependency": {
              "const": false
            },
            "expected": {
              "type": "object",
              "required": [
                "routes",
                "bounded",
                "resumable",
                "migrated",
                "failClosed",
                "unique"
              ],
              "properties": {
                "routes": {
                  "const": 39
                },
                "bounded": {
                  "const": 2
                },
                "resumable": {
                  "const": 37
                },
                "migrated": {
                  "const": 2
                },
                "failClosed": {
                  "const": 37
                },
                "unique": {
                  "const": true
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
