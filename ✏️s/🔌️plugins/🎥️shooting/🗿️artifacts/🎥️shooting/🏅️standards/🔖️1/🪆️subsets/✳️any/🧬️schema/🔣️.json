{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/artifact.json",
  "title": "ShootingArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assets",
    "savedCameras",
    "scene",
    "shots",
    "activeShotId",
    "activeAssetId"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShootingAsset"
      },
      "x-semio-state": "artifact"
    },
    "savedCameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShootingSavedCamera"
      },
      "x-semio-state": "artifact"
    },
    "scene": {
      "$ref": "#/$defs/ShootingSceneLighting",
      "x-semio-state": "artifact"
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShootingShot"
      },
      "x-semio-state": "artifact"
    },
    "activeShotId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "activeAssetId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "emblem": {
      "$ref": "https://json.schemas.assets.semio-tech.com/framework/schema/artifact-reference/child/schema.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "stdio.semio.image"
    }
  },
  "$defs": {
    "ShootingCamera": {
      "title": "ShootingCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "zoom",
        "fov"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "zoom": {
          "type": "number",
          "format": "double"
        },
        "fov": {
          "type": "number",
          "format": "double",
          "x-semio-ui": {
            "label": {
              "en": "Perspective field of view (°)",
              "de": "Perspektivischer Bildwinkel (°)"
            }
          }
        },
        "up": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "label": {
              "en": "Camera up",
              "de": "Kamera-Hochachse"
            }
          }
        },
        "projection": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Projection",
              "de": "Projektion"
            }
          }
        }
      }
    },
    "ShootingSavedCamera": {
      "title": "ShootingSavedCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "camera"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "camera": {
          "$ref": "#/$defs/ShootingCamera"
        }
      }
    },
    "ShootingAsset": {
      "title": "ShootingAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url",
        "format",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "orientation": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "ShootingShot": {
      "title": "ShootingShot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "width",
        "height",
        "format",
        "shape"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 4294967295
        },
        "format": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "cameraId": {
          "type": "string"
        },
        "drawing": {
          "$ref": "#/$defs/ShootingDrawing"
        },
        "autoFit": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Auto fit",
              "de": "Automatische Einpassung"
            },
            "widget": "toggle",
            "description": {
              "en": "Absent inherits the scene auto-fit setting.",
              "de": "Ohne Angabe gilt die automatische Einpassung der Szene."
            }
          }
        }
      }
    },
    "ShootingSun": {
      "title": "ShootingSun",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "azimuth",
        "elevation",
        "intensity",
        "color"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "azimuth": {
          "type": "number",
          "format": "double"
        },
        "elevation": {
          "type": "number",
          "format": "double"
        },
        "intensity": {
          "type": "number",
          "format": "double"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "ShootingAmbient": {
      "title": "ShootingAmbient",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intensity",
        "color"
      ],
      "properties": {
        "intensity": {
          "type": "number",
          "format": "double"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "ShootingShadow": {
      "title": "ShootingShadow",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "opacity",
        "softness"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "format": "double"
        },
        "softness": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "ShootingMaterial": {
      "title": "ShootingMaterial",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "metalness",
        "roughness",
        "emissive",
        "emissiveIntensity"
      ],
      "properties": {
        "color": {
          "type": "string"
        },
        "metalness": {
          "type": "number",
          "format": "double"
        },
        "roughness": {
          "type": "number",
          "format": "double"
        },
        "emissive": {
          "type": "string"
        },
        "emissiveIntensity": {
          "type": "number",
          "format": "double"
        },
        "stroke": {
          "type": "string",
          "default": "#000000"
        }
      }
    },
    "ShootingSceneLighting": {
      "title": "ShootingSceneLighting",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "sun",
        "ambient",
        "shadow",
        "material"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "sun": {
          "$ref": "#/$defs/ShootingSun"
        },
        "ambient": {
          "$ref": "#/$defs/ShootingAmbient"
        },
        "shadow": {
          "$ref": "#/$defs/ShootingShadow"
        },
        "material": {
          "$ref": "#/$defs/ShootingMaterial"
        }
      }
    },
    "ShootingRetainedCommandStepContract": {
      "type": "object",
      "required": [
        "maxRawBytes",
        "maxDecodedItems",
        "maxWorkUnitsPerStep",
        "maxOutputBytes",
        "maxStepMicros"
      ],
      "properties": {
        "maxRawBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxDecodedItems": {
          "type": "integer",
          "minimum": 1
        },
        "maxWorkUnitsPerStep": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxStepMicros": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7999
        },
        "maxCheckpointBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxInFlightPages": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ShootingImportAssetRequestPublication": {
      "type": "object",
      "required": [
        "toolId",
        "lanes"
      ],
      "properties": {
        "toolId": {
          "const": "importAssetRequest"
        },
        "lanes": {
          "const": [
            "HostOnly"
          ]
        }
      },
      "additionalProperties": false
    },
    "ShootingDrawing": {
      "title": "ShootingDrawing",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "fill",
        "fillOpacity",
        "visibleLines",
        "hiddenLines",
        "visibleColor",
        "hiddenColor",
        "visibleWidth",
        "hiddenWidth",
        "lineEasing",
        "mergeLines"
      ],
      "properties": {
        "background": {
          "type": "boolean",
          "default": true,
          "x-semio-ui": {
            "label": {
              "en": "Background layer",
              "de": "Hintergrundebene"
            },
            "widget": "toggle"
          }
        },
        "fill": {
          "type": "boolean",
          "default": true,
          "x-semio-ui": {
            "label": {
              "en": "Face fills",
              "de": "Flächenfüllungen"
            },
            "widget": "toggle"
          }
        },
        "fillColor": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "x-semio-ui": {
            "label": {
              "en": "Fill color",
              "de": "Füllfarbe"
            }
          }
        },
        "fillOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "x-semio-ui": {
            "label": {
              "en": "Fill opacity",
              "de": "Deckkraft der Füllung"
            }
          }
        },
        "visibleLines": {
          "type": "boolean",
          "default": true,
          "x-semio-ui": {
            "label": {
              "en": "Visible lines",
              "de": "Sichtbare Linien"
            },
            "widget": "toggle"
          }
        },
        "hiddenLines": {
          "type": "boolean",
          "default": false,
          "x-semio-ui": {
            "label": {
              "en": "Hidden lines",
              "de": "Verdeckte Linien"
            },
            "widget": "toggle"
          }
        },
        "visibleColor": {
          "type": "string",
          "default": "#000000",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "x-semio-ui": {
            "label": {
              "en": "Visible line color",
              "de": "Farbe sichtbarer Linien"
            }
          }
        },
        "hiddenColor": {
          "type": "string",
          "default": "#808080",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "x-semio-ui": {
            "label": {
              "en": "Hidden line color",
              "de": "Farbe verdeckter Linien"
            }
          }
        },
        "visibleWidth": {
          "type": "number",
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 64,
          "x-semio-ui": {
            "label": {
              "en": "Visible line width (px)",
              "de": "Sichtbare Linienbreite (px)"
            }
          }
        },
        "hiddenWidth": {
          "type": "number",
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 64,
          "x-semio-ui": {
            "label": {
              "en": "Hidden line width (px)",
              "de": "Verdeckte Linienbreite (px)"
            }
          }
        },
        "lineEasing": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "x-semio-ui": {
            "label": {
              "en": "Corner radius (px)",
              "de": "Eckenradius (px)"
            }
          }
        },
        "mergeLines": {
          "type": "boolean",
          "default": false,
          "x-semio-ui": {
            "label": {
              "en": "Merge connected lines",
              "de": "Verbundene Linien zusammenführen"
            },
            "widget": "toggle"
          }
        }
      }
    },
    "ShootingDrawingPatch": {
      "title": "ShootingDrawingPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "background": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Background layer",
              "de": "Hintergrundebene"
            },
            "widget": "toggle"
          }
        },
        "fill": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Face fills",
              "de": "Flächenfüllungen"
            },
            "widget": "toggle"
          }
        },
        "visibleLines": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Visible lines",
              "de": "Sichtbare Linien"
            },
            "widget": "toggle"
          }
        },
        "hiddenLines": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Hidden lines",
              "de": "Verdeckte Linien"
            },
            "widget": "toggle"
          }
        },
        "visibleColor": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "x-semio-ui": {
            "label": {
              "en": "Visible line color",
              "de": "Farbe sichtbarer Linien"
            }
          }
        },
        "hiddenColor": {
          "type": "string",
          "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
          "x-semio-ui": {
            "label": {
              "en": "Hidden line color",
              "de": "Farbe verdeckter Linien"
            }
          }
        },
        "visibleWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64,
          "x-semio-ui": {
            "label": {
              "en": "Visible line width (px)",
              "de": "Sichtbare Linienbreite (px)"
            }
          }
        },
        "hiddenWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64,
          "x-semio-ui": {
            "label": {
              "en": "Hidden line width (px)",
              "de": "Verdeckte Linienbreite (px)"
            }
          }
        },
        "lineEasing": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "x-semio-ui": {
            "label": {
              "en": "Corner radius (px)",
              "de": "Eckenradius (px)"
            }
          }
        },
        "mergeLines": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Merge connected lines",
              "de": "Verbundene Linien zusammenführen"
            },
            "widget": "toggle"
          }
        },
        "fillColor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
              "x-semio-ui": {
                "label": {
                  "en": "Fill color",
                  "de": "Füllfarbe"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Fill color",
              "de": "Füllfarbe"
            }
          }
        },
        "fillOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "x-semio-ui": {
            "label": {
              "en": "Fill opacity",
              "de": "Deckkraft der Füllung"
            }
          }
        },
        "restoreAbsent": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Restore absent fields",
              "de": "Fehlende Felder wiederherstellen"
            },
            "widget": "toggle"
          }
        }
      }
    }
  }
}
