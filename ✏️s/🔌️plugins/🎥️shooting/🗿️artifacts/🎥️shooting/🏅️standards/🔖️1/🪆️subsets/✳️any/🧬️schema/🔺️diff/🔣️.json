{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/shooting/shooting/diff.json",
  "title": "ShootingDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "title": "ShootingArtifact",
      "type": "object",
      "x-semio-state": "artifact"
    },
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "assets": {
      "$ref": "#/$defs/ShootingAssetsDelta",
      "x-semio-state": "artifact"
    },
    "savedCameras": {
      "$ref": "#/$defs/ShootingSavedCamerasDelta",
      "x-semio-state": "artifact"
    },
    "scene": {
      "$ref": "https://semio.tech/schema/s/shooting/shooting/artifact.json#/$defs/ShootingSceneLighting",
      "x-semio-state": "artifact"
    },
    "shots": {
      "$ref": "#/$defs/ShootingShotsDelta",
      "x-semio-state": "artifact"
    },
    "activeShotId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "activeAssetId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "emblem": {
      "anyOf": [
        { "$ref": "https://semio.tech/schema/os/store/child.json" },
        { "type": "null" }
      ],
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.image"
    }
  },
  "$defs": {
    "ShootingStringList": {
      "title": "ShootingStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ShootingAssetPatch": {
      "title": "ShootingAssetPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "orientation": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "ShootingShotPatch": {
      "title": "ShootingShotPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "label": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "format": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        }
      }
    },
    "ShootingSavedCameraPatch": {
      "title": "ShootingSavedCameraPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "label": {
          "type": "string"
        },
        "camera": {
          "$ref": "https://semio.tech/schema/s/shooting/shooting/artifact.json#/$defs/ShootingCamera"
        }
      }
    },
    "ShootingAssetPatchEntry": {
      "title": "ShootingAssetPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/ShootingAssetPatch"
        }
      }
    },
    "ShootingShotPatchEntry": {
      "title": "ShootingShotPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/ShootingShotPatch"
        }
      }
    },
    "ShootingSavedCameraPatchEntry": {
      "title": "ShootingSavedCameraPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "#/$defs/ShootingSavedCameraPatch"
        }
      }
    },
    "ShootingAssetsDelta": {
      "title": "ShootingAssetsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/shooting/shooting/artifact.json#/$defs/ShootingAsset"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShootingAssetPatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ShootingShotsDelta": {
      "title": "ShootingShotsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/shooting/shooting/artifact.json#/$defs/ShootingShot"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShootingShotPatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ShootingSavedCamerasDelta": {
      "title": "ShootingSavedCamerasDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/shooting/shooting/artifact.json#/$defs/ShootingSavedCamera"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShootingSavedCameraPatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
