{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/diff.json",
  "title": "ShootingDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "schema": { "type": ["string", "null"], "x-semio-state": "artifact" },
    "assets": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ShootingAssetsDelta" }], "x-semio-state": "artifact" },
    "savedCameras": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ShootingSavedCamerasDelta" }], "x-semio-state": "artifact" },
    "scene": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ShootingScenePatch" }], "x-semio-state": "artifact" },
    "shots": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ShootingShotsDelta" }], "x-semio-state": "artifact" },
    "activeShotId": { "type": ["string", "null"], "x-semio-state": "artifact" },
    "activeAssetId": { "type": ["string", "null"], "x-semio-state": "artifact" },
    "emblem": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": { "anyOf": [{ "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child/schema.json" }, { "type": "null" }] }
          },
          "x-semio-child-kind": "s.stdio.semio.image"
        }
      ],
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "ShootingAssetPatch": {
      "title": "ShootingAssetPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "name": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "format": { "type": ["string", "null"] },
        "origin": { "anyOf": [{ "type": "null" }, { "type": "array", "items": { "type": "number", "format": "double" }, "minItems": 3, "maxItems": 3 }] },
        "orientation": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": { "value": { "anyOf": [{ "type": "null" }, { "type": "array", "items": { "type": "number", "format": "double" }, "minItems": 4, "maxItems": 4 }] } }
            }
          ]
        },
        "scale": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": { "value": { "anyOf": [{ "type": "null" }, { "type": "array", "items": { "type": "number", "format": "double" }, "minItems": 3, "maxItems": 3 }] } }
            }
          ]
        }
      }
    },
    "ShootingShotPatch": {
      "title": "ShootingShotPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "label": { "type": ["string", "null"] },
        "width": { "type": ["integer", "null"], "format": "uint32", "minimum": 0, "maximum": 4294967295 },
        "height": { "type": ["integer", "null"], "format": "uint32", "minimum": 0, "maximum": 4294967295 },
        "format": { "type": ["string", "null"] },
        "shape": { "type": ["string", "null"] },
        "background": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["value"], "properties": { "value": { "type": ["string", "null"] } } }
          ]
        },
        "cameraId": {
          "anyOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["value"], "properties": { "value": { "type": ["string", "null"] } } }
          ]
        }
      }
    },
    "ShootingSavedCameraPatch": {
      "title": "ShootingSavedCameraPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "label": { "type": ["string", "null"] },
        "camera": { "anyOf": [{ "type": "null" }, { "$ref": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/artifact.json#/$defs/ShootingCamera" }] }
      }
    },
    "ShootingScenePatch": {
      "title": "ShootingScenePatch",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "background": { "type": ["string", "null"] },
        "sunEnabled": { "type": ["boolean", "null"] },
        "sunAzimuth": { "type": ["number", "null"], "format": "double" },
        "sunElevation": { "type": ["number", "null"], "format": "double" },
        "sunIntensity": { "type": ["number", "null"], "format": "double" },
        "sunColor": { "type": ["string", "null"] },
        "ambientIntensity": { "type": ["number", "null"], "format": "double" },
        "ambientColor": { "type": ["string", "null"] },
        "shadowEnabled": { "type": ["boolean", "null"] },
        "shadowOpacity": { "type": ["number", "null"], "format": "double" },
        "shadowSoftness": { "type": ["number", "null"], "format": "double" },
        "materialColor": { "type": ["string", "null"] },
        "materialMetalness": { "type": ["number", "null"], "format": "double" },
        "materialRoughness": { "type": ["number", "null"], "format": "double" },
        "materialEmissive": { "type": ["string", "null"] },
        "materialEmissiveIntensity": { "type": ["number", "null"], "format": "double" },
        "materialStroke": { "type": ["string", "null"] }
      }
    },
    "ShootingAssetEdit": {
      "title": "ShootingAssetEdit",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["edit", "index", "item"],
          "properties": {
            "edit": { "const": "add" },
            "index": { "type": "integer", "minimum": 0 },
            "item": { "$ref": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/artifact.json#/$defs/ShootingAsset" }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["edit", "id", "index"], "properties": { "edit": { "const": "remove" }, "id": { "type": "string" }, "index": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["edit", "id", "from", "to"], "properties": { "edit": { "const": "move" }, "id": { "type": "string" }, "from": { "type": "integer", "minimum": 0 }, "to": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "ShootingShotEdit": {
      "title": "ShootingShotEdit",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["edit", "index", "item"],
          "properties": {
            "edit": { "const": "add" },
            "index": { "type": "integer", "minimum": 0 },
            "item": { "$ref": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/artifact.json#/$defs/ShootingShot" }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["edit", "id", "index"], "properties": { "edit": { "const": "remove" }, "id": { "type": "string" }, "index": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["edit", "id", "from", "to"], "properties": { "edit": { "const": "move" }, "id": { "type": "string" }, "from": { "type": "integer", "minimum": 0 }, "to": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "ShootingSavedCameraEdit": {
      "title": "ShootingSavedCameraEdit",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["edit", "index", "item"],
          "properties": {
            "edit": { "const": "add" },
            "index": { "type": "integer", "minimum": 0 },
            "item": { "$ref": "https://json.schemas.assets.semio-tech.com/s/shooting/shooting/artifact.json#/$defs/ShootingSavedCamera" }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["edit", "id", "index"], "properties": { "edit": { "const": "remove" }, "id": { "type": "string" }, "index": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["edit", "id", "from", "to"], "properties": { "edit": { "const": "move" }, "id": { "type": "string" }, "from": { "type": "integer", "minimum": 0 }, "to": { "type": "integer", "minimum": 0 } } }
      ]
    },
    "ShootingAssetPatchEntry": {
      "title": "ShootingAssetPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "patch"],
      "properties": { "id": { "type": "string" }, "patch": { "$ref": "#/$defs/ShootingAssetPatch" } }
    },
    "ShootingShotPatchEntry": {
      "title": "ShootingShotPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "patch"],
      "properties": { "id": { "type": "string" }, "patch": { "$ref": "#/$defs/ShootingShotPatch" } }
    },
    "ShootingSavedCameraPatchEntry": {
      "title": "ShootingSavedCameraPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "patch"],
      "properties": { "id": { "type": "string" }, "patch": { "$ref": "#/$defs/ShootingSavedCameraPatch" } }
    },
    "ShootingAssetsDelta": {
      "title": "ShootingAssetsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": ["edits", "patched"],
      "properties": { "edits": { "type": "array", "items": { "$ref": "#/$defs/ShootingAssetEdit" } }, "patched": { "type": "array", "items": { "$ref": "#/$defs/ShootingAssetPatchEntry" } } }
    },
    "ShootingShotsDelta": {
      "title": "ShootingShotsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": ["edits", "patched"],
      "properties": { "edits": { "type": "array", "items": { "$ref": "#/$defs/ShootingShotEdit" } }, "patched": { "type": "array", "items": { "$ref": "#/$defs/ShootingShotPatchEntry" } } }
    },
    "ShootingSavedCamerasDelta": {
      "title": "ShootingSavedCamerasDelta",
      "type": "object",
      "additionalProperties": false,
      "required": ["edits", "patched"],
      "properties": { "edits": { "type": "array", "items": { "$ref": "#/$defs/ShootingSavedCameraEdit" } }, "patched": { "type": "array", "items": { "$ref": "#/$defs/ShootingSavedCameraPatchEntry" } } }
    }
  }
}
