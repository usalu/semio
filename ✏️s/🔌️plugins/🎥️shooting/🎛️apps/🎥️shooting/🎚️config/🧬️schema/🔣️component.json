{
  "$id": "https://semio.tech/schema/app/shooting/shooting/config.json",
  "title": "ShootingConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaultShotFormat",
    "defaultShotShape",
    "defaultAssetFormat",
    "selectedShotIds",
    "selectedAssetIds",
    "selectionMethod",
    "centerModel",
    "fitRevision",
    "cameraDraftLabel",
    "camera",
    "activeUtilityId",
    "locale"
  ],
  "properties": {
    "defaultShotFormat": {
      "type": "string",
      "x-semio-state": "config"
    },
    "defaultShotShape": {
      "type": "string",
      "x-semio-state": "config"
    },
    "defaultAssetFormat": {
      "type": "string",
      "x-semio-state": "config"
    },
    "selectedShotIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "selectedAssetIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "selectionMethod": {
      "type": "string",
      "x-semio-state": "config"
    },
    "hoveredAssetId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "centerModel": {
      "type": "boolean",
      "x-semio-state": "config"
    },
    "fitRevision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "x-semio-state": "config"
    },
    "cameraDraftLabel": {
      "type": "string",
      "x-semio-state": "config"
    },
    "camera": {
      "$ref": "#/$defs/ShootingCamera",
      "x-semio-state": "config"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "ShootingCamera": {
      "title": "ShootingCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "zoom",
        "fov"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "zoom": {
          "type": "number",
          "format": "double"
        },
        "fov": {
          "type": "number",
          "format": "double"
        },
        "up": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "projection": {
          "type": "string"
        }
      }
    }
  }
}
