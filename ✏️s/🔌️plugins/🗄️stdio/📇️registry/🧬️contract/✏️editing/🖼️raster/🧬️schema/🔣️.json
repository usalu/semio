{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "s.stdio.editing.raster-region.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["x", "y", "width", "height", "color"],
  "properties": {
    "x": {"$ref": "#/$defs/coordinate"},
    "y": {"$ref": "#/$defs/coordinate"},
    "width": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "height": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "color": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
  },
  "$defs": {"coordinate": {"type": "integer", "minimum": 0, "maximum": 4294967295}}
}
