{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.test/envelope.json",
  "type": "object",
  "required": ["schema", "subset"],
  "properties": {
    "schema": { "const": "test.details-envelope" },
    "subset": { "$ref": "#/definitions/Subset" }
  },
  "definitions": {
    "Subset": {
      "oneOf": [
        {
          "allOf": [{ "$ref": "https://example.test/model.json" }],
          "required": ["subset"],
          "properties": {
            "subset": { "const": "model" },
            "spatial": { "maxItems": 1 }
          }
        },
        {
          "allOf": [{ "$ref": "https://example.test/text.json" }],
          "required": ["subset"],
          "properties": { "subset": { "const": "text" } }
        }
      ]
    }
  }
}
