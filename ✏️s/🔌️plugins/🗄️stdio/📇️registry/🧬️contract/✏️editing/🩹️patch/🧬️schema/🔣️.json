{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/snapshot-patch/schema.json",
  "title": "Stdio Snapshot Patch",
  "description": "🩹️ An atomic, bounded native artifact patch over decoded JSON Pointer segments.",
  "type": "object",
  "required": [
    "edits"
  ],
  "properties": {
    "edits": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "path",
          "edit"
        ],
        "properties": {
          "path": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string"
            }
          },
          "edit": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "operation",
                  "value"
                ],
                "properties": {
                  "operation": {
                    "const": "set"
                  },
                  "value": {}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "operation",
                  "value"
                ],
                "properties": {
                  "operation": {
                    "const": "insert"
                  },
                  "value": {}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "operation",
                  "value",
                  "index"
                ],
                "properties": {
                  "operation": {
                    "const": "insertAt"
                  },
                  "value": {},
                  "index": {
                    "type": "integer",
                    "description": "Requested member position for insertion-ordered objects. Containers with intrinsic key ordering retain that ordering; keys and values are always preserved.",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "operation"
                ],
                "properties": {
                  "operation": {
                    "const": "remove"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
