{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/stdio/retained-native-route.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["routeCases", "lifecycle", "textCopy", "commandAdmission", "structuralCopy", "documentCopy"],
  "properties": {
    "routeCases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mutation", "recognized", "primaryAccepts", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mutation": { "type": "integer", "minimum": 0, "maximum": 255 },
          "recognized": { "type": "boolean" },
          "primaryAccepts": { "type": "boolean" },
          "expected": { "enum": ["primary", "fallback", "refused"] }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "cancelAfter", "expectedProgress", "expectedCloseSteps"],
      "properties": {
        "units": { "type": "integer", "minimum": 2, "maximum": 64 },
        "cancelAfter": { "type": "integer", "minimum": 1, "maximum": 63 },
        "expectedProgress": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 64 }
        },
        "expectedCloseSteps": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "textCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteLength", "pageBytes", "expectedDataSteps", "cancelAfterBytes", "expectedCloseSteps", "interruptedUnicode", "partialByteStops"],
      "properties": {
        "byteLength": { "type": "integer", "minimum": 65536, "maximum": 16777216 },
        "pageBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "expectedDataSteps": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "cancelAfterBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "expectedCloseSteps": { "type": "integer", "minimum": 2, "maximum": 16385 },
        "interruptedUnicode": { "type": "string", "minLength": 2 },
        "partialByteStops": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "commandAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumBytes", "cases"],
      "properties": {
        "maximumBytes": { "type": "integer", "minimum": 1 },
        "cases": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "value", "accepted"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "value": { "type": "string" },
              "accepted": { "type": "boolean" }
            }
          }
        }
      }
    },
    "structuralCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runCount", "tableRowCount", "meshVertexCount", "brepVertexCount", "nurbsPointCount", "textureByteLength", "pageBytes", "cancelAfterTurns"],
      "properties": {
        "runCount": { "type": "integer", "minimum": 4096 },
        "tableRowCount": { "type": "integer", "minimum": 1024 },
        "meshVertexCount": { "type": "integer", "minimum": 8192 },
        "brepVertexCount": { "type": "integer", "minimum": 8192 },
        "nurbsPointCount": { "type": "integer", "minimum": 4096 },
        "textureByteLength": { "type": "integer", "minimum": 2097152, "maximum": 16777216 },
        "pageBytes": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "cancelAfterTurns": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "documentCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siblingByteLength", "replacementText", "replacementRepeats", "pageBytes", "cancelAfterTurns", "minimumCompleteTurns"],
      "properties": {
        "siblingByteLength": { "type": "integer", "minimum": 2097152, "maximum": 16777216 },
        "replacementText": { "type": "string", "minLength": 1, "maxLength": 4 },
        "replacementRepeats": { "type": "integer", "minimum": 65536, "maximum": 524288 },
        "pageBytes": { "type": "integer", "minimum": 4096, "maximum": 65536 },
        "cancelAfterTurns": { "type": "integer", "minimum": 1, "maximum": 256 },
        "minimumCompleteTurns": { "type": "integer", "minimum": 500, "maximum": 8192 }
      }
    }
  }
}
