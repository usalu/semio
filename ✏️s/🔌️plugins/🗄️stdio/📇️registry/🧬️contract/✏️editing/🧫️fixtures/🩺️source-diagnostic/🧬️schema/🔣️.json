{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.stdio.snapshot-edit.source-diagnostic.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["why", "cases"],
  "properties": {
    "why": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "line", "column", "length"],
            "properties": {
              "code": { "const": "snapshot-edit.invalid-source" },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 },
              "length": { "type": "integer", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
