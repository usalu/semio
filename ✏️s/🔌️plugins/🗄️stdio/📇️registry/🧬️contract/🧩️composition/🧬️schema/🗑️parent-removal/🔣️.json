{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.stdio.parent-removal-admission/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "expected",
    "absent",
    "present"
  ],
  "properties": {
    "schema": {
      "const": "semio.stdio.parent-removal-admission/v1"
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "absent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "present": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "kind",
          "complete"
        ],
        "properties": {
          "identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "kind": {
            "enum": [
              "directory",
              "symlink",
              "file"
            ]
          },
          "complete": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
