{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner",
    "cases",
    "runtimeCases"
  ],
  "properties": {
    "schema": {
      "const": "semio.stdio.definition-hierarchy/v1"
    },
    "owner": {
      "const": "s.stdio.ifc"
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "category",
          "accepted"
        ],
        "properties": {
          "identity": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "runtimeCases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "standards",
          "identity",
          "category",
          "accepted"
        ],
        "properties": {
          "standards": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^s\\.stdio\\.[a-z]+\\.standard\\.[a-z0-9-]+$"
            }
          },
          "identity": {
            "type": "string"
          },
          "category": {
            "enum": [
              "codec",
              "representation"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
