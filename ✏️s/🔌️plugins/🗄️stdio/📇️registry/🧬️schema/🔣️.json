{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/registry/schema.json",
  "$defs": {
    "SnapshotPatch": {
      "description": "🩹️ One path-scoped native snapshot edit: an RFC 6901 pointer operation and, where it writes one, the value. The editable input of a `patch-snapshot` leaf; its value is typed at runtime by the snapshot sub-schema the pointer addresses.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "path", "value"],
          "properties": {
            "operation": { "const": "set" },
            "path": { "$ref": "#/$defs/SnapshotPointer" },
            "value": {
              "x-semio-ui": {
                "label": { "en": "Value", "de": "Wert" },
                "description": { "en": "The value written at the path.", "de": "Der am Pfad geschriebene Wert." }
              }
            }
          },
          "x-semio-ui": { "label": { "en": "Set", "de": "Setzen" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "path", "value"],
          "properties": {
            "operation": { "const": "insert" },
            "path": { "$ref": "#/$defs/SnapshotPointer" },
            "value": {
              "x-semio-ui": {
                "label": { "en": "Value", "de": "Wert" },
                "description": { "en": "The value inserted at the path.", "de": "Der am Pfad eingefügte Wert." }
              }
            },
            "index": { "$ref": "#/$defs/SnapshotMemberIndex" }
          },
          "x-semio-ui": { "label": { "en": "Insert", "de": "Einfügen" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "path"],
          "properties": {
            "operation": { "const": "remove" },
            "path": { "$ref": "#/$defs/SnapshotPointer" }
          },
          "x-semio-ui": { "label": { "en": "Remove", "de": "Entfernen" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "from", "path"],
          "properties": {
            "operation": { "const": "move" },
            "from": { "$ref": "#/$defs/SnapshotPointer" },
            "path": { "$ref": "#/$defs/SnapshotPointer" },
            "index": { "$ref": "#/$defs/SnapshotMemberIndex" }
          },
          "x-semio-ui": { "label": { "en": "Move", "de": "Verschieben" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "path", "key"],
          "properties": {
            "operation": { "const": "rename" },
            "path": { "$ref": "#/$defs/SnapshotPointer" },
            "key": {
              "type": "string",
              "x-semio-ui": {
                "label": { "en": "New key", "de": "Neuer Schlüssel" },
                "description": { "en": "The member name the addressed object key is renamed to, in place.", "de": "Der Name, in den der adressierte Objektschlüssel an seiner Stelle umbenannt wird." }
              }
            }
          },
          "x-semio-ui": { "label": { "en": "Rename", "de": "Umbenennen" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "path", "offset", "remove", "value"],
          "properties": {
            "operation": { "const": "splice" },
            "path": { "$ref": "#/$defs/SnapshotPointer" },
            "offset": { "$ref": "#/$defs/SnapshotSpliceUnits" },
            "remove": { "$ref": "#/$defs/SnapshotSpliceUnits" },
            "value": {
              "anyOf": [{ "type": "array", "items": true }, { "type": "string" }, { "type": "object", "additionalProperties": true }],
              "x-semio-ui": {
                "label": { "en": "Inserted part", "de": "Eingefügter Teil" },
                "description": { "en": "The units spliced in at the offset: array items or octets, text (offsets in UTF-8 bytes) or object members.", "de": "Die am Versatz eingefügten Einheiten: Array-Elemente oder Oktette, Text (Versatz in UTF-8-Bytes) oder Objekteinträge." }
              }
            },
            "continued": {
              "type": "boolean",
              "description": "Marks a non-final part of one exact multi-part inverse; the run's final part checks the whole-snapshot invariant.",
              "x-semio-ui": {
                "widget": "hidden",
                "label": { "en": "Continued", "de": "Fortgesetzt" }
              }
            }
          },
          "x-semio-ui": { "label": { "en": "Splice", "de": "Spleißen" } }
        }
      ]
    },
    "SnapshotPointer": {
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)*$",
      "x-semio-ui": {
        "widget": "hidden",
        "label": { "en": "Path", "de": "Pfad" },
        "description": { "en": "RFC 6901 JSON Pointer into the snapshot; empty addresses the whole document.", "de": "RFC-6901-JSON-Pointer in die Momentaufnahme; leer adressiert das ganze Dokument." }
      }
    },
    "SnapshotMemberIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Position of an inserted object member, carried only by an exact inverse that restores a member at its former place. Containers with intrinsic key ordering keep that ordering; keys and values are always preserved.",
      "x-semio-ui": {
        "widget": "hidden",
        "label": { "en": "Member position", "de": "Position des Eintrags" }
      }
    },
    "SnapshotSpliceUnits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "An offset or count of the units a splice addresses: array items, octets, UTF-8 bytes of text or object members.",
      "x-semio-ui": {
        "widget": "hidden",
        "label": { "en": "Units", "de": "Einheiten" }
      }
    }
  }
}
