{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/registry/schema.json",
  "$defs": {
    "SnapshotPatch": {
      "description": "🩹️ An atomic, bounded native artifact patch over decoded JSON Pointer segments.",
      "type": "object",
      "required": [
        "edits"
      ],
      "properties": {
        "edits": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "path",
              "edit"
            ],
            "properties": {
              "path": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "string"
                }
              },
              "edit": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "operation",
                      "value"
                    ],
                    "properties": {
                      "operation": {
                        "const": "set"
                      },
                      "value": {}
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "operation",
                      "value"
                    ],
                    "properties": {
                      "operation": {
                        "const": "insert"
                      },
                      "value": {}
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "operation",
                      "value",
                      "index"
                    ],
                    "properties": {
                      "operation": {
                        "const": "insertAt"
                      },
                      "value": {},
                      "index": {
                        "type": "integer",
                        "description": "Requested member position for insertion-ordered objects. Containers with intrinsic key ordering retain that ordering; keys and values are always preserved.",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "operation"
                    ],
                    "properties": {
                      "operation": {
                        "const": "remove"
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "x-semio-ui": {
                  "label": {
                    "en": "Edit",
                    "de": "Änderung"
                  },
                  "description": {
                    "en": "Set, insert, insert at a position, or remove the value at the path.",
                    "de": "Wert am Pfad setzen, einfügen, an einer Position einfügen oder entfernen."
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "x-semio-ui": {
            "label": {
              "en": "Edits",
              "de": "Änderungen"
            },
            "description": {
              "en": "At most two path edits applied atomically.",
              "de": "Höchstens zwei Pfadänderungen, atomar angewendet."
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
