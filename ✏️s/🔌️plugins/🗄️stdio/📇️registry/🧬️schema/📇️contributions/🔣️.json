{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/registry/contribution-removal/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cases",
    "registrationCases",
    "receiptCases"
  ],
  "properties": {
    "schema": {
      "const": "semio.stdio.contribution-removal/v1"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "selected",
          "remove",
          "accepted",
          "remaining"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "selected": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "remove": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accepted": {
            "type": "boolean"
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "registrationCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "first",
          "second",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "first": {
            "type": "string"
          },
          "second": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "receiptCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authoredFactory",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "authoredFactory": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
