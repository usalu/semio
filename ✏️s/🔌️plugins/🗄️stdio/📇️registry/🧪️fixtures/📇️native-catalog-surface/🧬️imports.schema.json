{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["schema", "features", "cases"],
  "properties": {
    "schema": { "const": "semio.stdio.headless-imports/v1" },
    "features": { "const": ["full-artifact-catalog"] },
    "cases": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "source", "accepted"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]+$" },
          "source": { "type": "string", "minLength": 1, "maxLength": 512 },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
