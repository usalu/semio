{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["schema", "topic", "cases"],
  "properties": {
    "schema": { "const": "semio.stdio.artifact-catalog-cases/v1" },
    "topic": { "const": "stdio.artifact-catalog.v1" },
    "cases": {
      "type": "array", "minItems": 30, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "operation", "path", "accepted"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["none", "reverse-object-fields", "missing-topic", "duplicate-topic", "foreign-topic", "bare-topic", "unknown-field", "replace", "remove-last", "append-first", "reverse", "toggle"] },
          "path": { "type": "array", "maxItems": 6, "items": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "integer", "minimum": 0 }] } },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
