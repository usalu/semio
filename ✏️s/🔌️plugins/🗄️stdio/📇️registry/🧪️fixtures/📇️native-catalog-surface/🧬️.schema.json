{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/stdio-native-catalog-surface-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "definitionCount", "codecCount", "cases"],
  "properties": {
    "schema": { "const": "semio.stdio.native-catalog-surface/v1" },
    "definitionCount": { "const": 36 },
    "codecCount": { "const": 26 },
    "cases": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "mutation", "accepted"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mutation": { "enum": ["none", "reverse", "missing", "extra", "duplicate", "identity", "schema", "name", "source-format"] },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
