{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "projectionLimitBytes", "descriptorLimitBytes", "cases", "aggregateCases"],
  "properties": {
    "schema": { "const": "semio.stdio.catalog-projection-budget-cases/v1" },
    "projectionLimitBytes": { "const": 2097152 },
    "descriptorLimitBytes": { "const": 16777216 },
    "cases": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "text", "encodedBytes"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string" }, "encodedBytes": { "type": "integer", "minimum": 2, "maximum": 16384 } }
      }
    },
    "aggregateCases": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "projectionCharges", "descriptorCharges", "accepted"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "projectionCharges": { "$ref": "#/$defs/charges" },
          "descriptorCharges": { "$ref": "#/$defs/charges" },
          "accepted": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": { "charges": { "type": "array", "maxItems": 4, "items": { "type": "integer", "minimum": 0, "maximum": 16777216 } } }
}
