{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/stdio-artifact-catalog-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "pluginId", "packageId", "packageVersion", "definitions", "codecs"],
  "properties": {
    "schema": { "const": "semio.stdio.artifact-catalog/v1" },
    "pluginId": { "const": "stdio" },
    "packageId": { "const": "semio:stdio" },
    "packageVersion": { "type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$" },
    "definitions": {
      "type": "array", "minItems": 36, "maxItems": 36,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["identity", "capabilities"],
        "properties": {
          "identity": { "$ref": "#/$defs/identity" },
          "capabilities": {
            "type": "array", "minItems": 1, "maxItems": 2048,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["identity", "kind", "descriptorSha256", "executable", "claims", "localizations"],
              "properties": {
                "identity": { "$ref": "#/$defs/identity" },
                "kind": { "$ref": "#/$defs/text" },
                "descriptorSha256": { "$ref": "#/$defs/digest" },
                "executable": { "type": "boolean" },
                "claims": {
                  "type": "array", "maxItems": 64,
                  "items": {
                    "type": "object", "additionalProperties": false, "required": ["namespace", "value"],
                    "properties": { "namespace": { "$ref": "#/$defs/text" }, "value": { "$ref": "#/$defs/text" } }
                  }
                },
                "localizations": {
                  "type": "array", "maxItems": 64,
                  "items": {
                    "type": "object", "additionalProperties": false, "required": ["locale", "text"],
                    "properties": { "locale": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "codecs": {
      "type": "array", "minItems": 26, "maxItems": 26,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["factoryId", "definitionIdentity", "descriptorCodecId", "runtimeCapabilityId", "artifactKind", "schema", "extension", "packSchemaSha256"],
        "properties": {
          "factoryId": { "$ref": "#/$defs/text" },
          "definitionIdentity": { "$ref": "#/$defs/identity" },
          "descriptorCodecId": { "$ref": "#/$defs/identity" },
          "runtimeCapabilityId": { "$ref": "#/$defs/identity" },
          "artifactKind": { "enum": ["stdio.avi", "stdio.bcf", "stdio.csv", "stdio.deflate", "stdio.docx", "stdio.dwg", "stdio.dxf", "s.stdio.gltf", "stdio.jpg", "stdio.json", "stdio.las", "stdio.md", "stdio.mp3", "stdio.mp4", "stdio.obj", "stdio.pdf", "stdio.ply", "stdio.png", "stdio.pptx", "stdio.step", "stdio.stl", "stdio.svg", "stdio.tiff", "stdio.xlsx", "stdio.xml", "stdio.zip"] },
          "schema": { "$ref": "#/$defs/text" },
          "extension": { "$ref": "#/$defs/text" },
          "packSchemaSha256": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "identity": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^s[.]stdio[.]" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
