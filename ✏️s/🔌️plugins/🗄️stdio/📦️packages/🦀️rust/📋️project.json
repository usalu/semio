{
  "name": "@semio-tech/stdio-assembly-rs",
  "$schema": "../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:plugin",
    "family:stdio"
  ],
  "namedInputs": {
    "nativeSources": [
      "{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/**/*",
      "{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/**/*.{ts,tsx,json,semio,wit,sql}",
      "{workspaceRoot}/🧰️framework/**/*",
      "{workspaceRoot}/🧰️framework/**/*.{ts,tsx,json,semio,wit,sql}"
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "repo:script",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "canonical-architecture": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts canonical-architecture",
        "forwardAllArgs": true
      }
    },
    "deletion-proof": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts deletion-proof"
      }
    }
  }
}
