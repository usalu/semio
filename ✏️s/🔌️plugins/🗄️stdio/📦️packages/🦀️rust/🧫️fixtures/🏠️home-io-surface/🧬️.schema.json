{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/stdio-home-io-surface-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "features",
    "directArtifacts",
    "sharedCodecs",
    "fullArtifactCount",
    "nativeCodecCount",
    "surfaceCases"
  ],
  "properties": {
    "schema": {
      "const": "semio.stdio.home-io-surface/v1"
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homeIo",
        "fullArtifactCatalog",
        "componentAppAssembly",
        "spaceGuest"
      ],
      "properties": {
        "homeIo": {
          "const": "home-io"
        },
        "fullArtifactCatalog": {
          "const": "full-artifact-catalog"
        },
        "componentAppAssembly": { "const": "component-app-assembly" },
        "spaceGuest": {
          "const": "space-guest"
        }
      }
    },
    "directArtifacts": {
      "type": "array",
      "prefixItems": [
        {
          "const": "csv"
        },
        {
          "const": "json"
        },
        {
          "const": "xlsx"
        },
        {
          "const": "zip"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "sharedCodecs": {
      "type": "array",
      "prefixItems": [
        {
          "const": "binary"
        },
        {
          "const": "deflate"
        },
        {
          "const": "txt"
        },
        {
          "const": "xml"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "fullArtifactCount": {
      "const": 36
    },
    "nativeCodecCount": { "const": 26 },
    "surfaceCases": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "selected", "catalog", "apps", "exports"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "selected": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["default", "plugin-root", "home-io", "full-artifact-catalog", "component-app-assembly"] } },
          "catalog": { "enum": [8, 36] },
          "apps": { "type": "boolean" },
          "exports": { "type": "boolean" }
        }
      }
    }
  }
}
