{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "phases",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "phases": {
      "const": {
        "docx": [
          "measure-snapshot",
          "measure-mutation",
          "apply",
          "measure-post",
          "measure-inverse"
        ],
        "zip": [
          "inspect-envelope",
          "scan-row",
          "apply",
          "validate-post"
        ],
        "mesh": [
          "scan-row",
          "apply"
        ],
        "brep": [
          "scan-row",
          "apply"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 43,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "format",
          "calls"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "format": {
            "enum": [
              "docx",
              "zip",
              "mesh",
              "brep"
            ]
          },
          "calls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "priorWork",
                "actions",
                "expected"
              ],
              "properties": {
                "priorWork": {
                  "type": "integer",
                  "minimum": 0
                },
                "actions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "action",
                      "admitted",
                      "fails"
                    ],
                    "properties": {
                      "action": {
                        "enum": [
                          "measure-snapshot",
                          "measure-mutation",
                          "apply",
                          "measure-post",
                          "measure-inverse",
                          "inspect-envelope",
                          "scan-row",
                          "validate-post"
                        ]
                      },
                      "admitted": {
                        "type": "boolean"
                      },
                      "fails": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "expected": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "work",
                    "attempted",
                    "outcome"
                  ],
                  "properties": {
                    "work": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "attempted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "outcome": {
                      "enum": [
                        "ok",
                        "failure",
                        "denied"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
