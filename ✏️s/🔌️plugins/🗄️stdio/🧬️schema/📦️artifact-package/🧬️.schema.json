{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.semio-tech.com/s/stdio/artifact-packages/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "identity": {
      "type": "string",
      "pattern": "^s\\.stdio\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "rust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargoName", "nxName", "manifest"],
      "properties": {
        "cargoName": { "type": "string", "pattern": "^semio-s-artifact-stdio-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "nxName": { "type": "string", "pattern": "^@semio-tech/stdio-[a-z0-9]+(?:-[a-z0-9]+)*-rs$" },
        "manifest": { "$ref": "#/$defs/path" }
      }
    },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nxName", "manifest", "entry"],
      "properties": {
        "name": { "type": "string", "pattern": "^@semio-tech/stdio-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "nxName": { "type": "string", "pattern": "^@semio-tech/stdio-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "manifest": { "$ref": "#/$defs/path" },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["types", "import"],
          "properties": {
            "types": { "const": "./dist/🟦️.d.ts" },
            "import": { "const": "./dist/🟦️.js" }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "directory", "identity", "source", "dependencies", "rust", "typescript"],
      "properties": {
        "artifact": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "directory": { "type": "string", "minLength": 2, "pattern": "^[^/\\\\]+$" },
        "identity": { "$ref": "#/$defs/identity" },
        "source": { "$ref": "#/$defs/path" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identity" }
        },
        "rust": { "$ref": "#/$defs/rust" },
        "typescript": { "$ref": "#/$defs/typescript" }
      }
    }
  }
}
