{
  "valid": [
    {
      "id": "doctype-before-prolog",
      "source": "<!DOCTYPE root SYSTEM \"urn:system]>greater>\">\n<!--before--><?prepare first?><root/><!--after--><?finish last?>",
      "doctypePosition": 0,
      "prologKinds": ["comment", "processingInstruction"],
      "epilogKinds": ["comment", "processingInstruction"]
    },
    {
      "id": "doctype-between-prolog",
      "source": "<!--first--><!DOCTYPE root PUBLIC \"public ] > id\" \"urn:system]>id\"><?prepare second?><root/><?finish after?>",
      "doctypePosition": 1,
      "prologKinds": ["comment", "processingInstruction"],
      "epilogKinds": ["processingInstruction"]
    },
    {
      "id": "doctype-after-prolog",
      "source": "<!--first--><?prepare second?><!DOCTYPE root [<!ENTITY quoted \"value ] > still quoted\">]><root/><!--after-->",
      "doctypePosition": 2,
      "prologKinds": ["comment", "processingInstruction"],
      "epilogKinds": ["comment"]
    }
  ],
  "invalid": [
    {
      "id": "duplicate-doctype",
      "source": "<!DOCTYPE root><!--between--><!DOCTYPE root><root/>",
      "error": "duplicate DOCTYPE declaration"
    },
    {
      "id": "trailing-doctype",
      "source": "<root/><!--after--><!DOCTYPE root>",
      "error": "DOCTYPE declaration cannot appear after root element"
    }
  ]
}
