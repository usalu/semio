dialect protocol stdio.obj.mutations
; ObjMutation's wire binary IS its serde_json encoding (protocol::OpBinary), tagged on
; "mutation"; shares the same envelope shape as every other .semio binary facet.
magic = %x89.53.45.4D.0D.0A.1A.0A
token-len = U32LE
token = *OCTET                      ; UTF-8 "stdio.obj.mutations v1"
payload = *OCTET                    ; UTF-8 JSON bytes of ObjMutation (see ../📝️text/📖️component.grammar.semio)
