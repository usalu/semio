(* ObjDiff's wire text IS its JSON serialization (protocol::OpText — serde_json), sparse
   fields per 🦀️component.rs; this documents the real shape, not RFC 8259's JSON grammar. *)
diff = "{", [ member, { ",", member } ], "}" ;
member = '"vertices"', ":", collection diff
       | '"texcoords"', ":", collection diff
       | '"normals"', ":", collection diff
       | '"faces"', ":", collection diff
       | '"groups"', ":", named diff
       | '"objects"', ":", named diff
       | '"mtllib"', ":", ( string | "null" )
       | '"usemtl"', ":", array
       | '"smoothingGroups"', ":", array
       | '"unknownStatements"', ":", array ;
collection diff = "{", [ member, { ",", member } ], "}" ;   (* removed/modified/added *)
named diff = "{", [ member, { ",", member } ], "}" ;         (* removed/modified/added, string-keyed *)
array = "[", { json value }, "]" ;
