dialect grammar
grammar stdio.obj.diff
start diff

# P2-FG1: real hand-rolled `print_diff`/`parse_diff` text grammar this artifact's own `DiffCodec`
# ALREADY emits (`../🦀️.rs`'s `#region 🔖️HandcraftedDiffCodec` — NOT `serde_json`, that
# module's own doc comment explicitly says so: "Grammar (real, not serde_json, mirrors
# gif89a/svg's §5 template)"). One space-separated token per changed top-level `ObjDiff` field
# (absent field = unchanged, tokens.join(" ")); every token below traced directly from
# `print_obj_diff`/`enc_*` (lines 927-1346 of that file), not guessed.
comment none

diff = clause*
clause = vertices-clause | texcoords-clause | normals-clause | faces-clause | groups-clause | objects-clause | mtllib-clause | usemtl-clause | smoothing-clause | unknown-clause

# Rust's own whole-valued-float `Display` (`fmt_f64` = plain `to_string()`) prints `1.0` as `"1"`
# — every `f64` field below accepts INT as well as FLOAT.
number = FLOAT | INT

# `hex`/`hex_encode`/`hex_decode` (lowercase hex-digit-run, incl. empty) — the framework's
# built-in `hex` MACRO (bare `hex`, deliberately NOT a production here — `Symbol::Ref`'s
# production-then-macro fallback resolves it; see the sibling json/csv/zip artifacts' own `hex`
# doc comments for why a hand-rolled `{INT|IDENT}*` production would be wrong: `Symbol::Star`
# never backtracks, and a hex run containing `<digits>e<digits>` lexes as one `FLOAT`, not
# alternating `INT`/`IDENT`). Used for group/object/material names, `mtllib`, and retained raw
# unknown-statement source text — `hex_encode_str`/`hex_decode_str`, lines 936-937.
#
# `encode_option`/`decode_option`'s uniform `[0]`=None / `[1,<value>]`=Some(value) tri-state tag
# (lines 969-982) — reused for every `Option<T>` this artifact's diff types carry, both real
# optional SNAPSHOT fields (`ObjVertex::w`) and genuine diff tri-states (`ObjVertexDiff::w`,
# `ObjDiff::mtllib`).
opt-number = "[" "0" "]" | "[" "1" "," number "]"
opt-int = "[" "0" "]" | "[" "1" "," INT "]"
opt-hex = "[" "0" "]" | "[" "1" "," hex "]"

# Shared `[removed];[modified];[added]` collection-triple shape (recipe §1.4), index-keyed —
# `removed` is `Vec<usize>` for all four index-keyed collections (`enc_index_triple`, lines
# 1191-1196).
removed-idx-list = {INT {"," INT}*}?

# `enc_vertex`/`dec_vertex` (lines 986-993): `[x,y,z,w_opt]`.
vertex-value = "[" number "," number "," number "," opt-number "]"
# `enc_vertex_diff`/`dec_vertex_diff` (lines 1071-1094): single-uppercase-letter `TAG:value`
# entries inside `[...]`, comma-joined.
vertex-diff-entry = "X" ":" number | "Y" ":" number | "Z" ":" number | "W" ":" opt-number
vertex-diff-value = "[" {vertex-diff-entry {"," vertex-diff-entry}*}? "]"
vertex-modified = INT ":" vertex-diff-value
vertex-added = INT ":" vertex-value
vertices-clause = "vertices" "{" "[" removed-idx-list "]" ";" "[" {vertex-modified {"," vertex-modified}*}? "]" ";" "[" {vertex-added {"," vertex-added}*}? "]" "}"

# `enc_texcoord`/`dec_texcoord` (lines 994-1001): `[u,v,w_opt]`.
texcoord-value = "[" number "," number "," opt-number "]"
texcoord-diff-entry = "U" ":" number | "V" ":" number | "W" ":" opt-number
texcoord-diff-value = "[" {texcoord-diff-entry {"," texcoord-diff-entry}*}? "]"
texcoord-modified = INT ":" texcoord-diff-value
texcoord-added = INT ":" texcoord-value
texcoords-clause = "texcoords" "{" "[" removed-idx-list "]" ";" "[" {texcoord-modified {"," texcoord-modified}*}? "]" ";" "[" {texcoord-added {"," texcoord-added}*}? "]" "}"

# `enc_normal`/`dec_normal` (lines 1002-1008): `[x,y,z]` — no `w`, always exactly 3.
normal-value = "[" number "," number "," number "]"
normal-diff-entry = "X" ":" number | "Y" ":" number | "Z" ":" number
normal-diff-value = "[" {normal-diff-entry {"," normal-diff-entry}*}? "]"
normal-modified = INT ":" normal-diff-value
normal-added = INT ":" normal-value
normals-clause = "normals" "{" "[" removed-idx-list "]" ";" "[" {normal-modified {"," normal-modified}*}? "]" ";" "[" {normal-added {"," normal-added}*}? "]" "}"

# `enc_face_vertex`/`dec_face_vertex` (lines 1010-1017): `[vertex,texcoord_opt,normal_opt]`.
face-vertex-value = "[" INT "," opt-int "," opt-int "]"
face-vertex-list = "[" {face-vertex-value {"," face-vertex-value}*}? "]"
# `enc_face`/`dec_face` (lines 1018-1025): `[fv,fv,...]` (comma-joined, no outer opt wrapper).
face-value = face-vertex-list
# `enc_face_diff`/`dec_face_diff` (lines 1139-1161): the ONLY possible entry is `V:<face-vertex-list>`
# (`ObjFaceDiff` has exactly one field, `vertices`) — still modeled as a repeatable entry set for
# the same "nothing silently dropped, no hand-tuned single-field shortcut" honesty this file's own
# other diff-value productions follow.
face-diff-entry = "V" ":" face-vertex-list
face-diff-value = "[" {face-diff-entry}? "]"
face-modified = INT ":" face-diff-value
face-added = INT ":" face-value
faces-clause = "faces" "{" "[" removed-idx-list "]" ";" "[" {face-modified {"," face-modified}*}? "]" ";" "[" {face-added {"," face-added}*}? "]" "}"

# Name-keyed triple (recipe §1.4) — `enc_named_triple`/`dec_named_triple` (lines 1211-1230):
# `removed` is `Vec<String>` (hex-encoded), `modified` keyed by hex name, `added` keyed by FINAL
# index. `enc_group`/`dec_group` (lines 1026-1033): `[hexname,[faces]]` — `enc_object`/`dec_object`
# (lines 1035-1043) share the IDENTICAL shape (`ObjGroup`/`ObjObject` are structurally the same
# `name`/`faces` pair), so `group-value` below is reused for both `groups`/`objects` `added`.
removed-name-list = {hex {"," hex}*}?
faces-list = "[" {INT {"," INT}*}? "]"
group-value = "[" hex "," faces-list "]"
# `enc_group_diff`/`dec_group_diff` (lines 1162-1184): the ONLY possible entry is `F:<faces-list>`
# — `dec_objects_diff` reuses this SAME function for its own `modified` entries (lines 1289-1309:
# `ObjObjectsDiff.modified: Vec<ObjGroupModified>`, the identical type `ObjGroupsDiff` uses).
group-diff-entry = "F" ":" faces-list
group-diff-value = "[" {group-diff-entry}? "]"
group-modified = hex ":" group-diff-value
group-added = INT ":" group-value
groups-clause = "groups" "{" "[" removed-name-list "]" ";" "[" {group-modified {"," group-modified}*}? "]" ";" "[" {group-added {"," group-added}*}? "]" "}"
objects-clause = "objects" "{" "[" removed-name-list "]" ";" "[" {group-modified {"," group-modified}*}? "]" ";" "[" {group-added {"," group-added}*}? "]" "}"

# Top-level scalars — `print_obj_diff` (lines 1313-1326): `mtllib=<opt-hex>`,
# `usemtl=[<enc_usemtl>,...]`, `smoothing=[<enc_smoothing>,...]`, `unknown=[<enc_unknown>,...]`.
mtllib-clause = "mtllib" "=" opt-hex
# `enc_usemtl`/`dec_usemtl` (lines 1044-1051): `[faceIndexFrom,hexmaterial]`.
usemtl-value = "[" INT "," hex "]"
usemtl-clause = "usemtl" "=" "[" {usemtl-value {"," usemtl-value}*}? "]"
# `enc_smoothing`/`dec_smoothing` (lines 1052-1059): `[faceIndexFrom,group_opt]`.
smoothing-value = "[" INT "," opt-int "]"
smoothing-clause = "smoothing" "=" "[" {smoothing-value {"," smoothing-value}*}? "]"
# `enc_unknown`/`dec_unknown` (lines 1060-1067): `[lineIndex,hexraw]`.
unknown-value = "[" INT "," hex "]"
unknown-clause = "unknown" "=" "[" {unknown-value {"," unknown-value}*}? "]"
