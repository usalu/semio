{
  "id": "s.stdio.gltf.mutation.move-primitive.v1",
  "laws": [
    "typed validation rejection",
    "direct sparse mesh diff",
    "exact-base inverse",
    "declared touched paths",
    "reference repair or rejection",
    "apply/replay/undo determinism"
  ],
  "touchedPaths": [
    "document/meshes/*/primitives"
  ],
  "referencePolicy": "reorders one mesh-local primitive without altering typed references"
}
