dialect protocol

protocol stdio.gltf.mutations
version 1
schema stdio.gltf.mutations
start op

# Canonical generic envelope: format, marker, phase, UTF-8 command-id length/data, command
# version, and canonical typed payload length/data. Command-specific payload bytes remain opaque
# here and are validated only by the registered descriptor.
framing record
header fixed 3
field format u8
field marker u8
field phase u8
chain envelope bytes
