{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/change-scene-extension-data/schema.json",
  "title": "GltfChangeSceneExtensionDataPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene",
    "data"
  ],
  "properties": {
    "scene": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Scene",
          "de": "Szene"
        },
        "description": {
          "en": "Index of the scene, counted from 0.",
          "de": "Index der Szene, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "data": {
      "$ref": "#/$defs/GltfDataPresence",
      "x-semio-ui": {
        "label": {
          "en": "Extension data",
          "de": "Erweiterungsdaten"
        },
        "description": {
          "en": "JSON object keyed by extension name; empty removes it.",
          "de": "JSON-Objekt mit Erweiterungsnamen als Schlüssel; leer entfernt es."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "ChangeSceneExtensionDataMutation": {
      "description": "The whole wire of ChangeSceneExtensionDataMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/diff.json"
            }
          }
        }
      ]
    },
    "GltfDataPresence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "absent",
              "x-semio-ui": {
                "label": {
                  "en": "Presence",
                  "de": "Vorhandensein"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "present",
              "x-semio-ui": {
                "label": {
                  "en": "Presence",
                  "de": "Vorhandensein"
                }
              }
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/snapshot.json#/$defs/GltfJson",
              "x-semio-ui": {
                "label": {
                  "en": "JSON value",
                  "de": "JSON-Wert"
                }
              }
            }
          }
        }
      ]
    }
  }
}
