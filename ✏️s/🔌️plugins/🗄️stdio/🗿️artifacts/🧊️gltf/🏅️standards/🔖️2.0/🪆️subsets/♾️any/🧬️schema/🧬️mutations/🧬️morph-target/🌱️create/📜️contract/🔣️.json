{
  "id": "s.stdio.gltf.mutation.create-morph-target.v1",
  "laws": [
    "typed validation rejection",
    "direct sparse mesh diff",
    "exact-base inverse",
    "declared touched paths",
    "reference repair or rejection",
    "apply/replay/undo determinism"
  ],
  "touchedPaths": [
    "document/meshes/*/primitives/*/targets"
  ],
  "referencePolicy": "creates an empty target only where mesh target arity remains coherent"
}
