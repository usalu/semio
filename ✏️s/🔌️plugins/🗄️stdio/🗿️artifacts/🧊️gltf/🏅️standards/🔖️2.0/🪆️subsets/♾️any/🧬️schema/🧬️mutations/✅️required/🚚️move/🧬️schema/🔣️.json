{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/move-required-extension/schema.json",
  "title": "GltfMoveRequiredExtensionPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extension",
    "position"
  ],
  "properties": {
    "extension": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Extension",
          "de": "Erweiterung"
        },
        "description": {
          "en": "Extension name, e.g. KHR_materials_unlit.",
          "de": "Name der Erweiterung, z. B. KHR_materials_unlit."
        },
        "group": "value",
        "order": 10
      }
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Target index in the list, counted from 0.",
          "de": "Zielindex in der Liste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "MoveRequiredExtensionMutation": {
      "description": "The whole wire of MoveRequiredExtensionMutation: the editable apply payload (this document's root).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "value"
      ],
      "properties": {
        "phase": {
          "const": "apply"
        },
        "value": {
          "$ref": "#"
        }
      }
    }
  }
}
