{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/create-accessor/schema.json",
  "title": "GltfCreateAccessorPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "position",
    "componentType",
    "count",
    "kind"
  ],
  "properties": {
    "position": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Target index in the list, counted from 0.",
          "de": "Zielindex in der Liste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 10
      }
    },
    "componentType": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/snapshot.json#/$defs/GltfComponentType",
      "x-semio-ui": {
        "label": {
          "en": "Component type",
          "de": "Komponententyp"
        },
        "description": {
          "en": "5120 byte, 5121 unsigned byte, 5122 short, 5123 unsigned short, 5125 unsigned int, 5126 float.",
          "de": "5120 Byte, 5121 Byte ohne Vorzeichen, 5122 Short, 5123 Short ohne Vorzeichen, 5125 Integer ohne Vorzeichen, 5126 Gleitkommazahl."
        },
        "snaps": [
          5120,
          5121,
          5122,
          5123,
          5125,
          5126
        ],
        "group": "value",
        "order": 20
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Element count",
          "de": "Elementanzahl"
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    },
    "kind": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/snapshot.json#/$defs/GltfAccessorType",
      "x-semio-ui": {
        "widget": "select",
        "label": {
          "en": "Element type",
          "de": "Elementtyp"
        },
        "group": "value",
        "order": 40
      }
    }
  },
  "$defs": {
    "CreateAccessorMutation": {
      "description": "The whole wire of CreateAccessorMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/diff.json"
            }
          }
        }
      ]
    }
  }
}
