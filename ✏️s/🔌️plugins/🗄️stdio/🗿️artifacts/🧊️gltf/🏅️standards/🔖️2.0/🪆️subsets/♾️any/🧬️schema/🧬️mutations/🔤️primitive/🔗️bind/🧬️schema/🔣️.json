{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/bind-primitive-attribute/schema.json",
  "title": "GltfBindPrimitiveAttributePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh",
    "primitive",
    "semantic",
    "accessor"
  ],
  "properties": {
    "mesh": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Mesh",
          "de": "Netz"
        },
        "description": {
          "en": "Index of the mesh, counted from 0.",
          "de": "Index des Netzes, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "primitive": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Primitive",
          "de": "Primitiv"
        },
        "description": {
          "en": "Index of the primitive within the mesh, counted from 0.",
          "de": "Index des Primitivs im Netz, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "semantic": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Attribute semantic",
          "de": "Attributsemantik"
        },
        "description": {
          "en": "e.g. POSITION, NORMAL or TEXCOORD_0.",
          "de": "z. B. POSITION, NORMAL oder TEXCOORD_0."
        },
        "group": "value",
        "order": 30
      }
    },
    "accessor": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Accessor",
          "de": "Accessor"
        },
        "description": {
          "en": "Index of the accessor, counted from 0.",
          "de": "Index des Accessors, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 40
      }
    }
  },
  "$defs": {
    "BindPrimitiveAttributeMutation": {
      "description": "The whole wire of BindPrimitiveAttributeMutation: the editable apply payload (this document's root).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "value"
      ],
      "properties": {
        "phase": {
          "const": "apply"
        },
        "value": {
          "$ref": "#"
        }
      }
    }
  }
}
