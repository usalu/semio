dialect protocol
protocol stdio.gltf.diff
version 1
schema stdio.gltf.diff
start diff

# P2-FG3: real binary diff-frame `protocol::DiffCodec::encode_diff`/`decode_diff` NOW emit for
# `GltfDiff` — upgraded from the F6-era `print_diff().into_bytes()` text-as-binary shortcut (see
# this artifact's report; 100% of stdio's `DiffCodec` impls were still on that shortcut per the
# P2-W0 census). `GltfDiff` is a flat 21-field struct: 18 plain `Option<T>` fields (2-way flag) +
# 3 TRI-STATE `Option<Option<T>>` fields (`scene`, `extensions`, `extras` — 3-way flag, same
# `protocol-cond-cannot-chain`-avoiding shape PNG's/gif's own precedent uses). Every one of the 14
# collection fields (`scenes`..`cameras`) is one length-prefixed opaque blob wrapping its own real
# binary `removed`/`modified`/`added` encoding — `Prim::Ref` to a struct/enum still unconditionally
# errors at walk time (`protocol-prim-ref-recursion`, confirmed unchanged) and a `repeat` arm has
# no way to describe a homogeneous run of VARYING-width records either (`protocol-array-of-records`)
# — so each blob's OWN internal shape isn't further protocol-walkable; the Rust `encode_diff`/
# `decode_diff` side (`../🦀️.rs`'s `RealBinary*` regions) IS genuinely, fully structured
# real binary throughout (real varint counts, real per-item recursive encoding, including the fully
# recursive `GltfJson` value type and the `GltfCameraProjection` data-carrying enum) — this is
# purely a limit on how deep the PROTOCOL DESCRIPTION itself can validate structurally, same
# documented limitation as every other stdio pilot's own nested-payload field.
framing record

# Every tri-state field's payload is gated DIRECTLY off its own 3-way flag (`eq 2`) — never a
# second CHAINED `if`-guard on an intermediate flag that was itself only conditionally decoded
# (`protocol-cond-cannot-chain`, §5 — `eval_cond` hard-errors on a guard field that wasn't
# unconditionally decoded). `asset_flag`/`scene_flag`/etc. are always unconditionally read first,
# so gating their payload directly off THAT single flag stays a legal one-level `Cond`.
#
# `asset`/`extensions_used`/`extensions_required`/`extensions`/`extras` are each a length-prefixed
# `Array(u8, Field(<name>_len))` blob (same shape the 14 collection fields below use) rather than a
# bare `bytes` field — none of these five are the LAST field in the frame, and `bytes` with no
# length is a GREEDY "rest of buffer" read (§2.2) that would swallow every subsequent field.
field asset_flag u8
field asset_len varint if asset_flag eq 1
field asset_value Array(u8, Field(asset_len)) if asset_flag eq 1

field scene_flag u8
field scene_value varint if scene_flag eq 2

field scenes_flag u8
field scenes_len varint if scenes_flag eq 1
field scenes_value Array(u8, Field(scenes_len)) if scenes_flag eq 1

field nodes_flag u8
field nodes_len varint if nodes_flag eq 1
field nodes_value Array(u8, Field(nodes_len)) if nodes_flag eq 1

field meshes_flag u8
field meshes_len varint if meshes_flag eq 1
field meshes_value Array(u8, Field(meshes_len)) if meshes_flag eq 1

field accessors_flag u8
field accessors_len varint if accessors_flag eq 1
field accessors_value Array(u8, Field(accessors_len)) if accessors_flag eq 1

field buffer_views_flag u8
field buffer_views_len varint if buffer_views_flag eq 1
field buffer_views_value Array(u8, Field(buffer_views_len)) if buffer_views_flag eq 1

field buffers_flag u8
field buffers_len varint if buffers_flag eq 1
field buffers_value Array(u8, Field(buffers_len)) if buffers_flag eq 1

field buffer_bytes_flag u8
field buffer_bytes_len varint if buffer_bytes_flag eq 1
field buffer_bytes_value Array(u8, Field(buffer_bytes_len)) if buffer_bytes_flag eq 1

field materials_flag u8
field materials_len varint if materials_flag eq 1
field materials_value Array(u8, Field(materials_len)) if materials_flag eq 1

field textures_flag u8
field textures_len varint if textures_flag eq 1
field textures_value Array(u8, Field(textures_len)) if textures_flag eq 1

field images_flag u8
field images_len varint if images_flag eq 1
field images_value Array(u8, Field(images_len)) if images_flag eq 1

field samplers_flag u8
field samplers_len varint if samplers_flag eq 1
field samplers_value Array(u8, Field(samplers_len)) if samplers_flag eq 1

field skins_flag u8
field skins_len varint if skins_flag eq 1
field skins_value Array(u8, Field(skins_len)) if skins_flag eq 1

field animations_flag u8
field animations_len varint if animations_flag eq 1
field animations_value Array(u8, Field(animations_len)) if animations_flag eq 1

field cameras_flag u8
field cameras_len varint if cameras_flag eq 1
field cameras_value Array(u8, Field(cameras_len)) if cameras_flag eq 1

field extensions_used_flag u8
field extensions_used_len varint if extensions_used_flag eq 1
field extensions_used_value Array(u8, Field(extensions_used_len)) if extensions_used_flag eq 1

field extensions_required_flag u8
field extensions_required_len varint if extensions_required_flag eq 1
field extensions_required_value Array(u8, Field(extensions_required_len)) if extensions_required_flag eq 1

field extensions_flag u8
field extensions_len varint if extensions_flag eq 2
field extensions_value Array(u8, Field(extensions_len)) if extensions_flag eq 2

field extras_flag u8
field extras_len varint if extras_flag eq 2
field extras_value Array(u8, Field(extras_len)) if extras_flag eq 2

field source_form_flag u8
field source_form_value u8 if source_form_flag eq 1
