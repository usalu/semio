{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/unbind-node-child/schema.json",
  "title": "GltfUnbindNodeChildPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent",
    "child"
  ],
  "properties": {
    "parent": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Parent node",
          "de": "Elternknoten"
        },
        "description": {
          "en": "Index of the parent node, counted from 0.",
          "de": "Index des Elternknotens, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "child": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Child node",
          "de": "Kindknoten"
        },
        "description": {
          "en": "Index of the child node, counted from 0.",
          "de": "Index des Kindknotens, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  },
  "$defs": {
    "UnbindNodeChildMutation": {
      "description": "The whole wire of UnbindNodeChildMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/diff.json"
            }
          }
        }
      ]
    }
  }
}
