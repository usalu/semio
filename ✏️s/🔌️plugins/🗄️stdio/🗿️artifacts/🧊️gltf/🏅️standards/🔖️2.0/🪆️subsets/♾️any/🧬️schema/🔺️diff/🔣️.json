{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/gltf/2.0/any/diff.json",
  "title": "GltfDiff",
  "description": "Sparse per-field diff. Index-keyed collection triples per top-level array; no full-replace snapshot slot.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "asset": {
      "type": "object",
      "description": "Sparse GltfAssetDiff"
    },
    "scene": {
      "type": [
        "integer",
        "null"
      ]
    },
    "scenes": {
      "$ref": "#/definitions/collectionDiff"
    },
    "nodes": {
      "$ref": "#/definitions/collectionDiff"
    },
    "meshes": {
      "$ref": "#/definitions/collectionDiff"
    },
    "accessors": {
      "$ref": "#/definitions/collectionDiff"
    },
    "bufferViews": {
      "$ref": "#/definitions/collectionDiff"
    },
    "buffers": {
      "$ref": "#/definitions/collectionDiff"
    },
    "bufferBytes": {
      "$ref": "#/definitions/collectionDiff"
    },
    "materials": {
      "$ref": "#/definitions/collectionDiff"
    },
    "textures": {
      "$ref": "#/definitions/collectionDiff"
    },
    "images": {
      "$ref": "#/definitions/collectionDiff"
    },
    "samplers": {
      "$ref": "#/definitions/collectionDiff"
    },
    "skins": {
      "$ref": "#/definitions/collectionDiff"
    },
    "animations": {
      "$ref": "#/definitions/collectionDiff"
    },
    "cameras": {
      "$ref": "#/definitions/collectionDiff"
    },
    "extensionsUsed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensionsRequired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {},
    "extras": {},
    "sourceForm": {
      "enum": [
        "json",
        "glb"
      ]
    }
  },
  "$defs": {
    "GltfDiffDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward",
        "inverse",
        "touchedPaths",
        "touchedRegions"
      ],
      "properties": {
        "forward": {
          "$ref": "#"
        },
        "inverse": {
          "$ref": "#"
        },
        "touchedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "touchedRegions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/touchedRegion"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "definitions": {
    "touchedRegion": {
      "enum": [
        "asset",
        "scene",
        "scenes",
        "nodes",
        "meshes",
        "accessors",
        "bufferViews",
        "buffers",
        "bufferBytes",
        "materials",
        "textures",
        "images",
        "samplers",
        "skins",
        "animations",
        "cameras",
        "extensionsUsed",
        "extensionsRequired",
        "extensions",
        "extras",
        "sourceForm"
      ]
    },
    "collectionDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "diff": {}
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "item": {}
            }
          }
        }
      }
    }
  }
}
