dialect grammar
grammar stdio.gltf.snapshot
extension gltf
start document
string double backslash

# P2-FG3: real RFC8259 §2-§7 JSON grammar of `stdio.gltf`'s `.gltf` wire text, in the SAME
# territory as this program's own json pilot (`🔣️json/…/📸️snapshot/📝️text/📖️component.grammar.semio`
# -- glTF files literally ARE JSON, per glTF 2.0 §3.1 "Determining File Type", and this program's
# W0 recon confirmed this facet "sufficient" at exactly the json pilot's own depth, §1a/§1c) --
# replaces the old ABNF-dialect placeholder (`;` comments, `(...)` grouping, `%x` char-class
# ranges, no `dialect grammar`/`grammar <id>` header lines -- all outside this repo's real dialect
# alphabet, unparseable by `parse_grammar`). `document` matches the m5 harness's own reconstructed
# body shape (`dsl_body_from_fixture`, `🧪️fixture-sweep/🦀️component.rs`): the mandatory `semio
# stdio.gltf.dsl v1` preamble line is stripped and replaced with the bare `envelope_id()` token
# before recognition, so `artifact-mark` below matches literally `stdio.gltf` (one token -- `.` is
# an ident-continue char in this lexer's `is_ident_continue`, confirmed against gif89a's own
# `schema=stdio.gif.89a` precedent), not the full preamble line.
#
# `string double backslash` (P2-M1 item 1) turns on RFC8259 escape decoding for every `"..."` TEXT
# token in the RECOGNIZED input document -- `\" \\ \/ \b \f \n \r \t \uXXXX` incl. surrogate pairs,
# matching `parse_gltf_document`'s own `serde_json::from_str` (⚙️engine/component.rs:333). This
# grammar FILE's own quoted literals below (`"asset"`, `"{"`, …) are always lexed by the grammar-
# dialect's fixed meta-lexer regardless of this directive (`string` configures how INPUT bytes are
# tokenized at recognize time, not how the .grammar.semio source itself is parsed) -- both
# conventions agree on plain-ASCII literals with no escapes, so there is no discrepancy here.
#
# `value`/`object`/`array`/`json-string`/`number` are genuinely recursive (`object`/`array`
# reference `value` which references them back) -- the SAME `Ref` self-recursion M1 proved real,
# zero Recognizer changes needed (P2-M1 item 6), reused verbatim from json's own grammar.
#
# `{...}*` grouping (never bare `(...)*`, reserved exclusively for macro-call argument lists) --
# P2-P1-fix Bug 2, csv's/json's own already-corrected precedent.
artifact-mark = "stdio.gltf"
document = artifact-mark value

value = object | array | json-string | number | "true" | "false" | "null"
object = "{" "}" | "{" member {"," member}* "}"
member = json-string ":" value
array = "[" "]" | "[" value {"," value}* "]"

# P2-P1-fix: named `json-string`, not bare `string` -- `parse_grammar`'s unified header/production
# loop reads a leading `string` ident as the `string <quote> <mode>` HEADER directive WHEREVER it
# appears, not only in the header block; a production literally named `string` fails with a
# confusing `expected Ident, found Equals` (json's own original bug, `p2-p1-fix-report.md` Bug/
# "Extra bug found"). `extension`/`use`/`start`/`comment`/`string` can never be a production name
# anywhere in this file.
json-string = TEXT

# RFC8259 §6: `-? (0 | [1-9][0-9]*) (.[0-9]+)? ([eE][+-]?[0-9]+)?` -- the shared lexer's `INT`/
# `FLOAT` scanners already capture this lexeme-for-lexeme (json's own precedent), no `%x`
# char-class rewrite needed.
number = INT | FLOAT

# glTF 2.0 §5's real top-level document shape (the root JSON object's own known member set, per
# `GltfDocument`'s 19 typed fields, ⚙️engine/component.rs + 📸️snapshot/🦀️component.rs) -- literal
# member keys (`Symbol::Literal` compares a TEXT token's DECODED content, so a quoted grammar-file
# literal like `"asset"` matches an input `"asset"` key regardless of surrounding quote glyphs,
# confirmed against `match_symbol_tracked`'s `Symbol::Literal` arm, 📖️grammar/component.rs:1918-
# 1921) with generic `value`/`array`/`number`/`json-string` payloads -- NOT re-typed per nested
# field (accessor/material/… internals) at the grammar-dialect level: that byte-precise typing
# already lives in the artifact's real serde-typed Rust model AND in this artifact's exhaustive
# hand-rolled DIFF/MUTATIONS grammars (../../🔺️diff/📝️text, ../../🧬️mutations/📝️text), matching the
# json pilot's own established depth for a text-native JSON format rather than fabricating a
# second, redundant per-field JSON schema here.
gltf-document = "{" "}" | "{" gltf-member {"," gltf-member}* "}"
gltf-member = "asset" ":" object | "scene" ":" number | "scenes" ":" array | "nodes" ":" array | "meshes" ":" array | "accessors" ":" array | "bufferViews" ":" array | "buffers" ":" array | "materials" ":" array | "textures" ":" array | "images" ":" array | "samplers" ":" array | "skins" ":" array | "animations" ":" array | "cameras" ":" array | "extensionsUsed" ":" array | "extensionsRequired" ":" array | "extensions" ":" object | "extras" ":" value
