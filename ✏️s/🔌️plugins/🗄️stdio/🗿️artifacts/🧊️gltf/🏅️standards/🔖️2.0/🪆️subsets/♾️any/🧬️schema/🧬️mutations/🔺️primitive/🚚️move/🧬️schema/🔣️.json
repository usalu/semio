    "mesh",
    "primitive",
    "position"
  ],
  "properties": {
    "mesh": {
      "type": "integer",
      "minimum": 0
    },
    "primitive": {
      "type": "integer",
      "minimum": 0
    },
    "position": {
      "type": "integer",
      "minimum": 0
    }
  },
  "x-semio": {
    "id": "s.stdio.gltf.mutation.move-primitive.v1",
    "version": 1,
    "phase": "mutation",
    "kind": "move",
    "touchedPaths": [
      "document/meshes/*/primitives"
    ],
    "referencePolicy": "reorders one mesh-local primitive without altering typed references"
  },
  "x-semio-mutation": "move-primitive"
}
