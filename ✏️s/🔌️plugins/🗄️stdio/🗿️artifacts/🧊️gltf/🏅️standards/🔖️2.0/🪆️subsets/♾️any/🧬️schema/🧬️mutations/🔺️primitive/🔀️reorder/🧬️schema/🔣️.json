{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/reorder-primitives/schema.json",
  "title": "GltfReorderPrimitivesPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh",
    "order"
  ],
  "properties": {
    "mesh": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Mesh",
          "de": "Netz"
        },
        "description": {
          "en": "Index of the mesh, counted from 0.",
          "de": "Index des Netzes, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "New order",
          "de": "Neue Reihenfolge"
        },
        "description": {
          "en": "The current indices, listed in their new order.",
          "de": "Die bisherigen Indizes in ihrer neuen Reihenfolge."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "ReorderPrimitivesMutation": {
      "description": "The whole wire of ReorderPrimitivesMutation: the editable apply payload (this document's root).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "value"
      ],
      "properties": {
        "phase": {
          "const": "apply"
        },
        "value": {
          "$ref": "#"
        }
      }
    }
  }
}
