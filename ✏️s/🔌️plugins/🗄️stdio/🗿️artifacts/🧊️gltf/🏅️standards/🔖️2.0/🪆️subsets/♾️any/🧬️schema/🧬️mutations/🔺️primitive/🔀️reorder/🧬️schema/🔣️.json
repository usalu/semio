        "type": "integer",
        "minimum": 0
      }
    }
  },
  "x-semio": {
    "id": "s.stdio.gltf.mutation.reorder-primitives.v1",
    "version": 1,
    "phase": "mutation",
    "kind": "reorder",
    "touchedPaths": [
      "document/meshes/*/primitives"
    ],
    "referencePolicy": "accepts only a complete mesh-local primitive permutation"
  },
  "x-semio-mutation": "reorder-primitives"
}
