{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/gltf/2.0/any/mutation/node/reparent.json",
  "title": "GltfReparentNodeMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent",
    "child",
    "position"
  ],
  "properties": {
    "parent": {
      "type": "integer",
      "minimum": 0
    },
    "child": {
      "type": "integer",
      "minimum": 0
    },
    "position": {
      "type": "integer",
      "minimum": 0
    }
  },
  "x-semio": {
    "id": "s.stdio.gltf.mutation.move-node-parent.v1",
    "version": 1,
    "phase": "mutation",
    "kind": "reparent",
    "touchedPaths": [
      "document/nodes/*/children",
      "document/scenes/*/nodes"
    ],
    "referencePolicy": "removes stale parent and scene-root links before binding the new parent; rejects cycles"
  },
  "x-semio-mutation": "move-node-parent"
}
