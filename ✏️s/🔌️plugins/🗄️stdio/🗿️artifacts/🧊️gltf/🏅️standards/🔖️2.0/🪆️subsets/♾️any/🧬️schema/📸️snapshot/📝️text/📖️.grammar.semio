dialect grammar
grammar stdio.gltf.snapshot
extension gltf
start document
comment none

document = "stdio.gltf" field*
field = IDENT field-value?
field-value = "=" value
value = scalar value-tail? | list | record
scalar = field | TEXT | INT | FLOAT
value-tail = "," value
list = "[" value* "]"
record = "{" field* "}"
