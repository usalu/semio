{
  "id": "s.stdio.gltf.mutation.change-primitive-extra-data.v1",
  "laws": [
    "typed validation rejection",
    "direct sparse mesh diff",
    "exact-base inverse",
    "declared touched paths",
    "reference repair or rejection",
    "apply/replay/undo determinism"
  ],
  "touchedPaths": [
    "document/meshes/*/primitives/*/extras"
  ],
  "referencePolicy": "none"
}
