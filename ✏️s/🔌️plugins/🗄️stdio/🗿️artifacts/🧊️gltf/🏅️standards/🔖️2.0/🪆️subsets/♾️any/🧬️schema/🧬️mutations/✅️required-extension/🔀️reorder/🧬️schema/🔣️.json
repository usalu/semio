{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/reorder-required-extensions/schema.json",
  "title": "GltfReorderRequiredExtensionsPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order"
  ],
  "properties": {
    "order": {
      "type": "array",
      "items": {
