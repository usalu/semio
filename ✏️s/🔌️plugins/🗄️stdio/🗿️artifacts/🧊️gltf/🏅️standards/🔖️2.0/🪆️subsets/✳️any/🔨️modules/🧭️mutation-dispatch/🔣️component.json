{

  "$id": "https://semio.tech/schema/s.stdio.gltf/mutation.json",
  "title": "GltfMutationDescriptorEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["commandId", "version", "phase", "payload"],
  "properties": {
    "commandId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "phase": { "enum": ["mutation", "diff", "inverse"] },
    "payload": { "type": "string", "maxLength": 65536 },
    "touchedPaths": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 512 } }
  },
  "$defs": {
    "rejection": { "type": "object", "additionalProperties": false, "required": ["code", "path", "detail"], "properties": { "code": { "type": "string" }, "path": { "type": "string" }, "detail": { "type": "string" } } },
    "application": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["accepted", "snapshot", "touchedPaths"], "properties": { "accepted": { "const": true }, "snapshot": {}, "touchedPaths": { "type": "array", "items": { "type": "string" } } } }, { "type": "object", "additionalProperties": false, "required": ["accepted", "rejection"], "properties": { "accepted": { "const": false }, "rejection": { "$ref": "#/$defs/rejection" } } } ] }
  },
  "x-semio": { "kind": "open-descriptor-envelope" }
}
