dialect grammar

grammar stdio.gltf.mutations
start op
comment none

# `commandId` and typed `payload` are lower-case hex so this grammar remains independent of every
# command-specific payload. The runtime decodes the canonical envelope before dispatching it to a
# registered descriptor.
op = "gltf-mutation" "commandId" "=" hex "version" "=" INT "phase" "=" phase "payload" "=" hex-opt
phase = "mutation" | "inverse"
hex-opt = "-" | hex
