{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/reorder-morph-targets/schema.json",
  "title": "GltfReorderMorphTargetsPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh",
    "primitive",
    "order"
  ],
  "properties": {
    "mesh": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Mesh",
          "de": "Netz"
        },
        "description": {
          "en": "Index of the mesh, counted from 0.",
          "de": "Index des Netzes, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "primitive": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Primitive",
          "de": "Primitiv"
        },
        "description": {
          "en": "Index of the primitive within the mesh, counted from 0.",
          "de": "Index des Primitivs im Netz, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "New order",
          "de": "Neue Reihenfolge"
        },
        "description": {
          "en": "The current indices, listed in their new order.",
          "de": "Die bisherigen Indizes in ihrer neuen Reihenfolge."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "ReorderMorphTargetsMutation": {
      "description": "The whole wire of ReorderMorphTargetsMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/diff.json"
            }
          }
        }
      ]
    }
  }
}
