{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.stdio.gltf.mutation.reparent-node.v1.diff",
  "title": "GltfReparentNodeDiff",
  "type": "object",
  "properties": {
    "diff": {
      "type": "object"
    },
    "touchedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "diff",
    "touchedPaths"
  ],
  "additionalProperties": false,
  "x-semio": {
    "id": "s.stdio.gltf.mutation.reparent-node.v1",
    "version": 1,
    "phase": "diff",
    "kind": "reparent",
    "touchedPaths": [
      "document/nodes/*/children",
      "document/scenes/*/nodes"
    ],
    "referencePolicy": "removes stale parent and scene-root links before binding the new parent; rejects cycles"
  }
}
