{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/gltf/2.0/any/mutation/change-node-transform/schema.json",
  "title": "GltfTransformNodePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node",
    "transform"
  ],
  "properties": {
    "node": {
      "type": "integer",
      "minimum": 0
    },
    "transform": {
      "$ref": "#/$defs/GltfNodeTransform"
    }
  },
  "$defs": {
    "GltfNodeTransform": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "matrix"
          ],
          "properties": {
            "kind": {
              "const": "matrix"
            },
            "matrix": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 16,
              "maxItems": 16
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "trs"
            },
            "translation": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ]
            },
            "rotation": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                {
                  "type": "null"
                }
              ]
            },
            "scale": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    }
  },
  "x-semio": {
    "id": "s.stdio.gltf.mutation.change-node-transform.v1",
    "version": 1,
    "phase": "mutation",
    "kind": "change",
    "touchedPaths": [
      "document/nodes/*/matrix",
      "document/nodes/*/translation",
      "document/nodes/*/rotation",
      "document/nodes/*/scale"
    ],
    "referencePolicy": "matrix and TRS are mutually exclusive; every scalar must be finite"
  },
  "x-semio-mutation": "change-node-transform"
}
