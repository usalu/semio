{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/change-node-transform/schema.json",
  "title": "GltfTransformNodePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node",
    "transform"
  ],
  "properties": {
    "node": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "Index of the node, counted from 0.",
          "de": "Index des Knotens, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "transform": {
      "$ref": "#/$defs/GltfNodeTransform",
      "x-semio-ui": {
        "label": {
          "en": "Transform",
          "de": "Transformation"
        },
        "description": {
          "en": "Either a 4×4 matrix or translation, rotation and scale.",
          "de": "Entweder eine 4×4-Matrix oder Verschiebung, Drehung und Skalierung."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "ChangeNodeTransformMutation": {
      "description": "The whole wire of ChangeNodeTransformMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/diff.json"
            }
          }
        }
      ]
    },
    "GltfNodeTransform": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "matrix"
          ],
          "properties": {
            "kind": {
              "const": "matrix"
            },
            "matrix": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 16,
              "maxItems": 16,
              "x-semio-ui": {
                "label": {
                  "en": "Matrix",
                  "de": "Matrix"
                },
                "description": {
                  "en": "4×4 transform, column-major.",
                  "de": "4×4-Transformationsmatrix, spaltenweise."
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "translation",
            "rotation",
            "scale"
          ],
          "properties": {
            "kind": {
              "const": "trs"
            },
            "translation": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ],
              "x-semio-ui": {
                "label": {
                  "en": "Translation",
                  "de": "Verschiebung"
                }
              }
            },
            "rotation": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                {
                  "type": "null"
                }
              ],
              "x-semio-ui": {
                "label": {
                  "en": "Rotation",
                  "de": "Drehung"
                },
                "description": {
                  "en": "Unit quaternion (x, y, z, w).",
                  "de": "Einheitsquaternion (x, y, z, w)."
                }
              }
            },
            "scale": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                {
                  "type": "null"
                }
              ],
              "x-semio-ui": {
                "label": {
                  "en": "Scale",
                  "de": "Skalierung"
                }
              }
            }
          }
        }
      ]
    }
  }
}
