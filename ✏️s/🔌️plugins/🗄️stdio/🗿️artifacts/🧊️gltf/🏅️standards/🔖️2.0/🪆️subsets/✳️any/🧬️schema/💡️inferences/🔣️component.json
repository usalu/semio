{
  "$id": "https://semio.tech/schema/s/stdio/gltf/inference.json",
  "title": "GltfInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["bounds"],
  "properties": {
    "bounds": { "$ref": "#/$defs/GltfBounds", "x-semio-state": "inferred" }
  },
  "$defs": {
    "GltfBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "vertexCount", "meshCount", "primitiveCount"],
      "properties": {
        "min": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "max": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "vertexCount": { "type": "integer", "minimum": 0 },
        "meshCount": { "type": "integer", "minimum": 0 },
        "primitiveCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
