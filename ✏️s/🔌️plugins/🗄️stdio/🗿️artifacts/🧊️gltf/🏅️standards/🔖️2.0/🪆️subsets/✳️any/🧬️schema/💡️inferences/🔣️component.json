{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/s/stdio/gltf/inference.json",
  "title": "GltfInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["geometricAnalysis"],
  "properties": { "geometricAnalysis": { "$ref": "#/$defs/geometricInference", "x-semio-derived": true } },
  "$defs": {
    "vec3": { "type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } },
    "quality": { "type": "object", "additionalProperties": false, "required": ["method", "coverage", "sampleCount", "watertight", "manifold", "consistentlyOriented", "warnings"], "properties": { "method": { "enum": ["exact", "deterministicEstimate"] }, "coverage": { "type": "number", "minimum": 0, "maximum": 1 }, "absoluteError": { "type": "number", "minimum": 0 }, "relativeError": { "type": "number", "minimum": 0 }, "sampleCount": { "type": "integer", "minimum": 0 }, "watertight": { "type": "boolean" }, "manifold": { "type": "boolean" }, "consistentlyOriented": { "type": "boolean" }, "warnings": { "type": "array", "items": { "type": "string" } } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["algorithm", "algorithmVersion", "dependencyFingerprints", "coordinateSpace", "toleranceFingerprint"], "properties": { "algorithm": { "type": "string" }, "algorithmVersion": { "type": "integer", "minimum": 1 }, "dependencyFingerprints": { "type": "array", "items": { "type": "string" } }, "coordinateSpace": { "enum": ["meshLocal", "nodeLocal", "sceneWorld"] }, "toleranceFingerprint": { "type": "string" }, "samplingSeed": { "type": "string" }, "pose": { "type": "string" } } },
    "histogram": { "type": "object", "additionalProperties": false, "required": ["edges", "counts", "weights"], "properties": { "edges": { "type": "array", "items": { "type": "number" } }, "counts": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "weights": { "type": "array", "items": { "type": "number", "minimum": 0 } } } },
    "statistics": { "type": "object", "additionalProperties": false, "required": ["quantiles"], "properties": { "minimum": { "type": "number" }, "maximum": { "type": "number" }, "mean": { "type": "number" }, "variance": { "type": "number", "minimum": 0 }, "standardDeviation": { "type": "number", "minimum": 0 }, "median": { "type": "number" }, "quantiles": { "type": "array", "items": { "type": "number" } }, "histogram": { "$ref": "#/$defs/histogram" } } },
    "measure": { "type": "object", "additionalProperties": false, "required": ["unit", "availability", "validity", "diagnosticIds", "quality", "provenance"], "properties": { "value": {}, "unit": { "enum": ["unitless", "metre", "squareMetre", "cubicMetre", "radian", "inverseMetre", "inverseSquareMetre"] }, "availability": { "enum": ["available", "approximate", "unavailable", "invalidInput", "unsupportedPrimitive", "openSurface", "nonManifold", "degenerate", "unresolvedResource"] }, "validity": { "enum": ["valid", "invalid", "indeterminate"] }, "diagnosticIds": { "type": "array", "items": { "type": "string" } }, "quality": { "$ref": "#/$defs/quality" }, "provenance": { "$ref": "#/$defs/provenance" } } },
    "policy": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "absoluteLengthTolerance", "relativeTolerance", "angularToleranceRadians", "contactTolerance", "sharpFeatureAngleRadians", "histogramEdges", "samplingBudget", "samplingSeed", "staticPose", "unitDensity", "fingerprint"], "properties": { "schemaVersion": { "type": "integer", "minimum": 1 }, "absoluteLengthTolerance": { "type": "number", "exclusiveMinimum": 0 }, "relativeTolerance": { "type": "number", "exclusiveMinimum": 0 }, "angularToleranceRadians": { "type": "number", "exclusiveMinimum": 0 }, "contactTolerance": { "type": "number", "minimum": 0 }, "sharpFeatureAngleRadians": { "type": "number", "minimum": 0 }, "histogramEdges": { "type": "array", "items": { "type": "number" } }, "samplingBudget": { "type": "integer", "minimum": 0 }, "samplingSeed": { "type": "string" }, "staticPose": { "type": "boolean" }, "unitDensity": { "type": "boolean" }, "fingerprint": { "type": "string" } } },
    "address": { "type": "object", "additionalProperties": false, "required": ["scope", "nodePath", "contentFingerprint"], "properties": { "scope": { "enum": ["document", "scene", "nodeInstance", "mesh", "primitive", "component", "surfaceRegion"] }, "scene": { "type": "integer", "minimum": 0 }, "nodePath": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "mesh": { "type": "integer", "minimum": 0 }, "primitive": { "type": "integer", "minimum": 0 }, "component": { "type": "integer", "minimum": 0 }, "surfaceRegion": { "type": "integer", "minimum": 0 }, "contentFingerprint": { "type": "string" } } },
    "size": { "type": "object", "additionalProperties": false, "required": ["overallSize", "axisAlignedBounds", "orientedBounds", "boundingBoxDimensions", "characteristicLength", "footprintArea", "projectedArea"], "properties": { "overallSize": { "$ref": "#/$defs/measure" }, "axisAlignedBounds": { "$ref": "#/$defs/measure" }, "orientedBounds": { "$ref": "#/$defs/measure" }, "boundingBoxDimensions": { "$ref": "#/$defs/measure" }, "characteristicLength": { "$ref": "#/$defs/measure" }, "footprintArea": { "$ref": "#/$defs/measure" }, "projectedArea": { "$ref": "#/$defs/measure" } } },
    "areaVolume": { "type": "object", "additionalProperties": false, "required": ["surfaceArea", "totalArea", "exposedArea", "contactArea", "volume", "enclosedVolume", "materialVolume", "voidVolume"], "properties": { "surfaceArea": { "$ref": "#/$defs/measure" }, "totalArea": { "$ref": "#/$defs/measure" }, "exposedArea": { "$ref": "#/$defs/measure" }, "contactArea": { "$ref": "#/$defs/measure" }, "volume": { "$ref": "#/$defs/measure" }, "enclosedVolume": { "$ref": "#/$defs/measure" }, "materialVolume": { "$ref": "#/$defs/measure" }, "voidVolume": { "$ref": "#/$defs/measure" } } },
    "compactness": { "type": "object", "additionalProperties": false, "required": ["compactness", "surfaceToVolumeRatio", "sphericity", "compactnessIndex", "hullFillRatio"], "properties": { "compactness": { "$ref": "#/$defs/measure" }, "surfaceToVolumeRatio": { "$ref": "#/$defs/measure" }, "sphericity": { "$ref": "#/$defs/measure" }, "compactnessIndex": { "$ref": "#/$defs/measure" }, "hullFillRatio": { "$ref": "#/$defs/measure" } } },
    "proportion": { "type": "object", "additionalProperties": false, "required": ["aspectRatios", "slenderness", "flatness", "elongation"], "properties": { "aspectRatios": { "$ref": "#/$defs/measure" }, "slenderness": { "$ref": "#/$defs/measure" }, "flatness": { "$ref": "#/$defs/measure" }, "elongation": { "$ref": "#/$defs/measure" } } },
    "mass": { "type": "object", "additionalProperties": false, "required": ["centroid", "principalFrame", "principalAxes", "momentsOfInertia", "inertiaTensor"], "properties": { "centroid": { "$ref": "#/$defs/measure" }, "principalFrame": { "$ref": "#/$defs/measure" }, "principalAxes": { "$ref": "#/$defs/measure" }, "momentsOfInertia": { "$ref": "#/$defs/measure" }, "inertiaTensor": { "$ref": "#/$defs/measure" } } },
    "curvature": { "type": "object", "additionalProperties": false, "required": ["meanCurvature", "gaussianCurvature", "curvatureHistogram", "sharpFeatureProportion"], "properties": { "meanCurvature": { "$ref": "#/$defs/measure" }, "gaussianCurvature": { "$ref": "#/$defs/measure" }, "curvatureHistogram": { "$ref": "#/$defs/measure" }, "sharpFeatureProportion": { "$ref": "#/$defs/measure" } } },
    "thickness": { "type": "object", "additionalProperties": false, "required": ["meanThickness", "minimumThickness", "thicknessVariability", "thicknessDistribution"], "properties": { "meanThickness": { "$ref": "#/$defs/measure" }, "minimumThickness": { "$ref": "#/$defs/measure" }, "thicknessVariability": { "$ref": "#/$defs/measure" }, "thicknessDistribution": { "$ref": "#/$defs/measure" } } },
    "concavity": { "type": "object", "additionalProperties": false, "required": ["convexHullGap", "reentrantArea", "reentrantVolume", "concavityIndex"], "properties": { "convexHullGap": { "$ref": "#/$defs/measure" }, "reentrantArea": { "$ref": "#/$defs/measure" }, "reentrantVolume": { "$ref": "#/$defs/measure" }, "concavityIndex": { "$ref": "#/$defs/measure" } } },
    "clearance": { "type": "object", "additionalProperties": false, "required": ["minimumDistanceToNeighbors", "clearanceDistribution", "interferenceVolume", "overlapVolume"], "properties": { "minimumDistanceToNeighbors": { "$ref": "#/$defs/measure" }, "clearanceDistribution": { "$ref": "#/$defs/measure" }, "interferenceVolume": { "$ref": "#/$defs/measure" }, "overlapVolume": { "$ref": "#/$defs/measure" } } },
    "adjacency": { "type": "object", "additionalProperties": false, "required": ["numberOfContacts", "contactGraphDegree", "connectedComponents"], "properties": { "numberOfContacts": { "$ref": "#/$defs/measure" }, "contactGraphDegree": { "$ref": "#/$defs/measure" }, "connectedComponents": { "$ref": "#/$defs/measure" } } },
    "orientation": { "type": "object", "additionalProperties": false, "required": ["mainAxisDirection", "faceNormalDistribution", "orientationConsistency"], "properties": { "mainAxisDirection": { "$ref": "#/$defs/measure" }, "faceNormalDistribution": { "$ref": "#/$defs/measure" }, "orientationConsistency": { "$ref": "#/$defs/measure" } } },
    "symmetry": { "type": "object", "additionalProperties": false, "required": ["reflectionSymmetryScore", "rotationalSymmetryScore", "reflectionSymmetries", "rotationalSymmetries", "repetitionRatio", "modularityRatio"], "properties": { "reflectionSymmetryScore": { "$ref": "#/$defs/measure" }, "rotationalSymmetryScore": { "$ref": "#/$defs/measure" }, "reflectionSymmetries": { "$ref": "#/$defs/measure" }, "rotationalSymmetries": { "$ref": "#/$defs/measure" }, "repetitionRatio": { "$ref": "#/$defs/measure" }, "modularityRatio": { "$ref": "#/$defs/measure" } } },
    "roughness": { "type": "object", "additionalProperties": false, "required": ["deviationFromIdeal", "deviationFromSmoothedGeometry", "normalVariation", "surfaceWaviness", "irregularity"], "properties": { "deviationFromIdeal": { "$ref": "#/$defs/measure" }, "deviationFromSmoothedGeometry": { "$ref": "#/$defs/measure" }, "normalVariation": { "$ref": "#/$defs/measure" }, "surfaceWaviness": { "$ref": "#/$defs/measure" }, "irregularity": { "$ref": "#/$defs/measure" } } },
    "topology": { "type": "object", "additionalProperties": false, "required": ["holes", "handles", "boundaryLoops", "eulerCharacteristic", "genus"], "properties": { "holes": { "$ref": "#/$defs/measure" }, "handles": { "$ref": "#/$defs/measure" }, "boundaryLoops": { "$ref": "#/$defs/measure" }, "eulerCharacteristic": { "$ref": "#/$defs/measure" }, "genus": { "$ref": "#/$defs/measure" } } },
    "indicators": { "type": "object", "additionalProperties": false, "required": ["size", "areaVolume", "compactness", "proportion", "mass", "curvature", "thickness", "concavity", "clearance", "adjacency", "orientation", "symmetry", "roughness", "topology"], "properties": { "size": { "$ref": "#/$defs/size" }, "areaVolume": { "$ref": "#/$defs/areaVolume" }, "compactness": { "$ref": "#/$defs/compactness" }, "proportion": { "$ref": "#/$defs/proportion" }, "mass": { "$ref": "#/$defs/mass" }, "curvature": { "$ref": "#/$defs/curvature" }, "thickness": { "$ref": "#/$defs/thickness" }, "concavity": { "$ref": "#/$defs/concavity" }, "clearance": { "$ref": "#/$defs/clearance" }, "adjacency": { "$ref": "#/$defs/adjacency" }, "orientation": { "$ref": "#/$defs/orientation" }, "symmetry": { "$ref": "#/$defs/symmetry" }, "roughness": { "$ref": "#/$defs/roughness" }, "topology": { "$ref": "#/$defs/topology" } } },
    "part": { "type": "object", "additionalProperties": false, "required": ["address", "indicators", "diagnosticIds"], "properties": { "address": { "$ref": "#/$defs/address" }, "name": { "type": "string" }, "indicators": { "$ref": "#/$defs/indicators" }, "diagnosticIds": { "type": "array", "items": { "type": "string" } } } },
    "pair": { "type": "object", "additionalProperties": false, "required": ["first", "second", "minimumDistance", "clearanceDistribution", "contactArea", "interferenceVolume", "overlapVolume", "adjacent", "orientationConsistency"], "properties": { "first": { "$ref": "#/$defs/address" }, "second": { "$ref": "#/$defs/address" }, "minimumDistance": { "$ref": "#/$defs/measure" }, "clearanceDistribution": { "$ref": "#/$defs/measure" }, "contactArea": { "$ref": "#/$defs/measure" }, "interferenceVolume": { "$ref": "#/$defs/measure" }, "overlapVolume": { "$ref": "#/$defs/measure" }, "adjacent": { "$ref": "#/$defs/measure" }, "orientationConsistency": { "$ref": "#/$defs/measure" } } },
    "diagnostic": { "type": "object", "additionalProperties": false, "required": ["id", "severity", "code", "message", "paths"], "properties": { "id": { "type": "string" }, "severity": { "enum": ["info", "warning", "error"] }, "code": { "type": "string" }, "message": { "type": "string" }, "paths": { "type": "array", "items": { "type": "string" } } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["sceneCount", "nodeInstanceCount", "meshCount", "primitiveCount", "vertexCount", "triangleCount", "componentCount", "surfaceRegionCount", "pairCount", "validPartCount", "invalidPartCount"], "properties": { "sceneCount": { "type": "integer", "minimum": 0 }, "nodeInstanceCount": { "type": "integer", "minimum": 0 }, "meshCount": { "type": "integer", "minimum": 0 }, "primitiveCount": { "type": "integer", "minimum": 0 }, "vertexCount": { "type": "integer", "minimum": 0 }, "triangleCount": { "type": "integer", "minimum": 0 }, "componentCount": { "type": "integer", "minimum": 0 }, "surfaceRegionCount": { "type": "integer", "minimum": 0 }, "pairCount": { "type": "integer", "minimum": 0 }, "validPartCount": { "type": "integer", "minimum": 0 }, "invalidPartCount": { "type": "integer", "minimum": 0 } } },
    "geometricInference": { "type": "object", "additionalProperties": false, "required": ["schema", "schemaVersion", "policy", "counts", "overall", "parts", "pairs", "diagnostics", "validity", "quality", "provenance"], "properties": { "schema": { "const": "s.stdio.gltf.inference" }, "schemaVersion": { "type": "integer", "minimum": 2 }, "policy": { "$ref": "#/$defs/policy" }, "counts": { "$ref": "#/$defs/counts" }, "overall": { "$ref": "#/$defs/indicators" }, "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } }, "pairs": { "type": "array", "items": { "$ref": "#/$defs/pair" } }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }, "validity": { "enum": ["valid", "invalid", "indeterminate"] }, "quality": { "$ref": "#/$defs/quality" }, "provenance": { "$ref": "#/$defs/provenance" } } }
  },
  "x-semio": {
    "kind": "collection",
    "members": [
      { "directory": "📦️size", "id": "s.stdio.gltf.inference.size", "kind": "inference", "responsibility": "Size indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.size" } },
      { "directory": "🧱️area-volume", "id": "s.stdio.gltf.inference.area-volume", "kind": "inference", "responsibility": "Area and volume indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.areaVolume" } },
      { "directory": "⚪️compactness", "id": "s.stdio.gltf.inference.compactness", "kind": "inference", "responsibility": "Compactness indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.compactness" } },
      { "directory": "📏️proportion", "id": "s.stdio.gltf.inference.proportion", "kind": "inference", "responsibility": "Proportion indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.proportion" } },
      { "directory": "⚖️mass-distribution", "id": "s.stdio.gltf.inference.mass-distribution", "kind": "inference", "responsibility": "Mass-distribution indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.mass" } },
      { "directory": "🌀️curvature", "id": "s.stdio.gltf.inference.curvature", "kind": "inference", "responsibility": "Curvature indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.curvature" } },
      { "directory": "↕️thickness", "id": "s.stdio.gltf.inference.thickness", "kind": "inference", "responsibility": "Thickness indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.thickness" } },
      { "directory": "🕳️concavity", "id": "s.stdio.gltf.inference.concavity", "kind": "inference", "responsibility": "Concavity indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.concavity" } },
      { "directory": "↔️clearance", "id": "s.stdio.gltf.inference.clearance", "kind": "inference", "responsibility": "Clearance indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.clearance" } },
      { "directory": "🔗️adjacency", "id": "s.stdio.gltf.inference.adjacency", "kind": "inference", "responsibility": "Adjacency indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.adjacency" } },
      { "directory": "🧭️orientation", "id": "s.stdio.gltf.inference.orientation", "kind": "inference", "responsibility": "Orientation indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.orientation" } },
      { "directory": "🪞️symmetry", "id": "s.stdio.gltf.inference.symmetry", "kind": "inference", "responsibility": "Symmetry indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.symmetry" } },
      { "directory": "🌊️roughness", "id": "s.stdio.gltf.inference.roughness", "kind": "inference", "responsibility": "Roughness indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.roughness" } },
      { "directory": "🕸️topology", "id": "s.stdio.gltf.inference.topology", "kind": "inference", "responsibility": "Topology indicators derived from geometric analysis context.", "inference": { "inputs": ["schema/snapshot"], "target": "geometricAnalysis.overall.topology" } },
      { "directory": "🧮️geometric-analysis", "id": "s.stdio.gltf.inference.geometric-analysis", "kind": "inference", "responsibility": "Aggregate static-pose glTF geometric analysis.", "inference": { "inputs": ["schema/snapshot", "buffers"], "target": "geometricAnalysis" } }
    ]
  }
}
