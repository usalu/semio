{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/create-primitive/schema.json",
  "title": "GltfCreatePrimitivePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh",
    "position"
  ],
  "properties": {
    "mesh": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Mesh",
          "de": "Netz"
        },
        "description": {
          "en": "Index of the mesh, counted from 0.",
          "de": "Index des Netzes, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Target index in the list, counted from 0.",
          "de": "Zielindex in der Liste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 20
      }
    },
    "primitive": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/snapshot.json#/$defs/GltfPrimitive",
      "x-semio-ui": {
        "label": {
          "en": "Primitive record",
          "de": "Primitiv-Datensatz"
        },
        "description": {
          "en": "Optional full record to insert instead of an empty one; its references address the document after the insert.",
          "de": "Optionaler vollständiger Datensatz, der statt eines leeren eingefügt wird; seine Verweise adressieren das Dokument nach dem Einfügen."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "CreatePrimitiveMutation": {
      "description": "The whole wire of CreatePrimitiveMutation: the editable apply payload (this document's root).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "value"
      ],
      "properties": {
        "phase": {
          "const": "apply"
        },
        "value": {
          "$ref": "#"
        }
      }
    }
  }
}
