dialect protocol
protocol stdio.gltf.snapshot
version 1
schema stdio.gltf
start document

# Real `.glb` binary container -- mirrors encode_glb/decode_glb (../../../⚙️engine/component.rs
# `encode_glb`:372-410 / `decode_glb`:416-461) byte-for-byte: a 12-byte header (magic "glTF",
# version u32LE, total_length u32LE, header-patched to the whole container's byte length after
# chunk emission) then a length-first tag-dispatched repeat of chunks (chunk_length u32LE,
# chunk_type fixed 4 bytes, chunk_data -- length ALREADY includes the 4-byte alignment padding
# `align4` adds, so a chunk's own declared length is the exact byte count to skip). JSON chunk
# (type "JSON", 0x4A534F4E) MUST come first per spec; BIN chunk (type "BIN\0", 0x42494E00 -- a
# literal NUL byte, expressed as the M2 hex-tag form per §1.3(f)/§2.3's own convention since a
# `\0` cannot round-trip through this dialect's default RAW `"..."` quote mode) is OPTIONAL and,
# if present, comes second; `decode_glb`'s own loop tolerates and simply skips ANY further chunk
# type (`length`-based auto-skip, `walk_repeat`'s own unrecognized-arm mechanism) -- the SAME real
# tolerance PNG's own ancillary-chunk handling gets.
#
# `framing magic` is a FIXED 8-byte comparison in this dialect (`magic_bytes(value: u64) -> [u8;
# 8]`, `📖️grammar/🦀️component.rs:983-985` -- always zero-extends/reads exactly 8 bytes, confirmed
# by a real `walk_protocol` failure with a bare 4-byte 0x676C5446 literal: "magic mismatch:
# expected [0,0,0,0,103,108,84,70], got [103,108,84,70,2,0,0,0]" -- the walker DOES read 8 real
# bytes from input but compares against a WRONG zero-padded-at-the-FRONT 8-byte expectation for a
# magic literal narrower than 8 bytes). GLB's own real magic is only 4 bytes ("glTF") -- folding
# the MANDATORY `version=2` field (§5.1, `decode_glb` hard-errors on any other value, :424-426)
# into the SAME 8-byte magic comparison (`0x676C544602000000` = ASCII "glTF" followed by u32LE 2)
# is the honest fit: version is a spec-constant for every valid GLB, so checking it as part of the
# fixed signature is equivalent in strictness to `decode_glb`'s own separate runtime check, and
# matches this dialect's real, tested `framing magic` shape (PNG's own 8-byte signature) rather
# than fighting a narrower-than-8-byte magic the mechanism doesn't support.
framing magic 0x676C544602000000
header fixed 4
field total_length u32

# `repeat`'s own `length` directive value is used internally for auto-skip/overrun but is NEVER
# bound to a named field an arm's own fields could `Array(_, Field(length))` against
# (`protocol-repeat-length-not-named`, §5 -- confirmed by a real `walk_protocol` failure: "unknown
# count field `length`"). Both arms stay honestly EMPTY -- `walk_repeat`'s own length-based
# auto-skip mechanism consumes each chunk's real payload bytes structurally, the SAME treatment
# PNG's own unrecognized-ancillary-chunk (and its deliberately empty `PLTE` arm) gets. The Rust
# `decode_glb`/`encode_glb` side (../../../⚙️engine/component.rs) still genuinely, fully decodes
# every chunk's real content (JSON parse, BIN byte slice) -- this is purely a limit on how deep the
# PROTOCOL DESCRIPTION can bind an unnamed repeat-length to a field reference.
repeat chunks {
  tag fixed 4
  length u32
  order length-first
  arm "JSON" { }
  arm 0x42494E00 { }
}
