      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "reorder"
        },
        "order": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "kind",
        "order"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "touchedPaths",
    "payload",
    "operation"
