{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.stdio.gltf.mutation.reorder-textures.v1.diff",
  "title": "GltfReorderTexturesDiffV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
