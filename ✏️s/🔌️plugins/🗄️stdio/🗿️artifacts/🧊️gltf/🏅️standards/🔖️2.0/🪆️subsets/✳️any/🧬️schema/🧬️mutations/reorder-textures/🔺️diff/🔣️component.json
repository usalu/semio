  "x-semio": {
    "id": "s.stdio.gltf.mutation.reorder-textures.v1",
    "version": 1,
    "phase": "diff",
    "touchedPathPattern": "document/textures",
    "referencePolicy": "typed references remap, repair, or reject"
  }
