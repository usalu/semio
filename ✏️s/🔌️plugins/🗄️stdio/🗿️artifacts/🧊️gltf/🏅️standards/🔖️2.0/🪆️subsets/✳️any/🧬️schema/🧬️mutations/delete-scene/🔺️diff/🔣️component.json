{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.stdio.gltf.mutation.delete-scene.v1",
  "title": "GltfDeleteSceneDiffV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "s.stdio.gltf.mutation.delete-scene.v1"
    },
    "version": {
      "const": 1
    },
    "phase": {
      "const": "diff"
    },
    "touchedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "anyOf": [
          {
            "const": "document/scene"
          },
          {
            "type": "string",
            "pattern": "^document/scenes/[0-9]+$"
          }
        ]
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "deletedScene": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "name": {
          "type": "string"
        },
        "extensions": {},
        "extras": {}
      },
      "required": [
        "nodes"
      ]
    },
    "defaultSceneAfter": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "id",
    "version",
    "phase",
    "touchedPaths",
    "index",
    "deletedScene",
    "defaultSceneAfter"
  ],
  "x-semio": {
    "id": "s.stdio.gltf.mutation.delete-scene.v1",
    "version": 1,
    "phase": "diff",
    "touchedPathPatterns": [
      "document/scenes/{index}",
      "document/scene"
    ]
  }
}
