{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/gltf/2.0/any/mutation/morph-target/delete.json",
  "title": "GltfDeleteMorphTargetMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh",
    "primitive",
    "target"
  ],
  "properties": {
    "mesh": {
      "type": "integer",
      "minimum": 0
    },
    "primitive": {
      "type": "integer",
      "minimum": 0
    },
    "target": {
      "type": "integer",
      "minimum": 0
    }
  },
  "x-semio": {
    "id": "s.stdio.gltf.mutation.delete-morph-target.v1",
    "version": 1,
    "phase": "mutation",
    "kind": "delete",
    "touchedPaths": [
      "document/meshes/*/primitives/*/targets"
    ],
    "referencePolicy": "removes one target only when mesh target-count coherence survives"
  },
  "x-semio-mutation": "delete-morph-target"
}
