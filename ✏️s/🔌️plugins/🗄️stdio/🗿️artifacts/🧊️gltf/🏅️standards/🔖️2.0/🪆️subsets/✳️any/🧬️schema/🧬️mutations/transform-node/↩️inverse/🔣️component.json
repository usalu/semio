{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.stdio.gltf.mutation.transform-node.v1.inverse",
  "title": "GltfTransformNodeInverse",
  "type": "object",
  "properties": {
    "inverse": {
      "type": "object"
    },
    "touchedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "inverse",
    "touchedPaths"
  ],
  "additionalProperties": false,
  "x-semio": {
    "id": "s.stdio.gltf.mutation.transform-node.v1",
    "version": 1,
    "phase": "inverse",
    "kind": "change",
    "touchedPaths": [
      "document/nodes/*/matrix",
      "document/nodes/*/translation",
      "document/nodes/*/rotation",
      "document/nodes/*/scale"
    ],
    "referencePolicy": "matrix and TRS are mutually exclusive; every scalar must be finite"
  }
}
