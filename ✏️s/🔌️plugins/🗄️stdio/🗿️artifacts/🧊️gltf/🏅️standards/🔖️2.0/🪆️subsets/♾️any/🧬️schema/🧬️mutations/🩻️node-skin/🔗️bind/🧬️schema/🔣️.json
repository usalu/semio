{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/bind-node-skin/schema.json",
  "title": "GltfBindNodeSkinPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node",
    "skin"
  ],
  "properties": {
    "node": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "Index of the node, counted from 0.",
          "de": "Index des Knotens, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "skin": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Skin",
          "de": "Skin"
        },
        "description": {
          "en": "Index of the skin, counted from 0.",
          "de": "Index des Skins, ab 0 gezählt."
        },
        "precision": 0,
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "BindNodeSkinMutation": {
      "description": "The whole wire of BindNodeSkinMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/diff.json"
            }
          }
        }
      ]
    }
  }
}
