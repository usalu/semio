{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/mutation/change-primitive-extra-data/schema.json",
  "title": "GltfChangePrimitiveExtraDataPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh",
    "primitive",
    "data"
  ],
  "properties": {
    "mesh": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Mesh",
          "de": "Netz"
        },
        "description": {
          "en": "Index of the mesh, counted from 0.",
          "de": "Index des Netzes, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "primitive": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Primitive",
          "de": "Primitiv"
        },
        "description": {
          "en": "Index of the primitive within the mesh, counted from 0.",
          "de": "Index des Primitivs im Netz, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "data": {
      "$ref": "#/$defs/GltfDataPresence",
      "x-semio-ui": {
        "label": {
          "en": "Extras",
          "de": "Zusatzdaten (extras)"
        },
        "description": {
          "en": "Application-specific JSON; empty removes it.",
          "de": "Anwendungsspezifisches JSON; leer entfernt es."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "ChangePrimitiveExtraDataMutation": {
      "description": "The whole wire of ChangePrimitiveExtraDataMutation: the editable apply payload (this document's root).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "value"
      ],
      "properties": {
        "phase": {
          "const": "apply"
        },
        "value": {
          "$ref": "#"
        }
      }
    },
    "GltfDataPresence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "absent",
              "x-semio-ui": {
                "label": {
                  "en": "Presence",
                  "de": "Vorhandensein"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "present",
              "x-semio-ui": {
                "label": {
                  "en": "Presence",
                  "de": "Vorhandensein"
                }
              }
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/2.0/any/snapshot.json#/$defs/GltfJson",
              "x-semio-ui": {
                "label": {
                  "en": "JSON value",
                  "de": "JSON-Wert"
                }
              }
            }
          }
        }
      ]
    }
  }
}
