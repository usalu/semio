{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/gltf/2.0/any/mutation/delete-primitive/schema.json",
  "title": "GltfDeletePrimitiveMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh",
    "primitive"
  ],
  "properties": {
    "mesh": {
      "type": "integer",
      "minimum": 0
    },
    "primitive": {
      "type": "integer",
      "minimum": 0
    }
  },
  "x-semio": {
    "id": "s.stdio.gltf.mutation.delete-primitive.v1",
    "version": 1,
    "phase": "mutation",
    "kind": "delete",
    "touchedPaths": [
      "document/meshes/*/primitives"
    ],
    "referencePolicy": "removes one primitive; mesh weights stay coherent because target counts are unchanged"
  },
  "x-semio-mutation": "delete-primitive"
}
