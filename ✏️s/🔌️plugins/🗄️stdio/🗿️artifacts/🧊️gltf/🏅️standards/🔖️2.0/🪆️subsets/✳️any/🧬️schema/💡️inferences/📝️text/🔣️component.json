{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/s/stdio/gltf/inference/text.json",
  "title": "GltfInferenceTextDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "payloadLength", "checksum", "value"],
  "properties": {
    "schema": { "const": "s.stdio.gltf.inference" },
    "version": { "const": 2 },
    "payloadLength": { "type": "integer", "minimum": 0 },
    "checksum": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "value": { "$ref": "https://semio.tech/schema/s/stdio/gltf/inference.json" }
  }
}
