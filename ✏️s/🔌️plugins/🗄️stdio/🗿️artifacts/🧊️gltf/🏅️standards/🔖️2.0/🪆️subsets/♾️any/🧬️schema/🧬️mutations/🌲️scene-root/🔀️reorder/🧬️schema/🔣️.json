{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/gltf/2.0/any/mutation/reorder-scene-root-nodes/schema.json",
  "title": "GltfReorderSceneRootNodesMutation",
