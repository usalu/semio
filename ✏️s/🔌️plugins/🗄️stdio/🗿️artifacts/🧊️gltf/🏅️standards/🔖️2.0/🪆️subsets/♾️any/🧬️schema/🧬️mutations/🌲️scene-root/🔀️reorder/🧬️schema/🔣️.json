    },
    "order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "x-semio": {
    "id": "s.stdio.gltf.mutation.reorder-scene-root-nodes.v1",
    "version": 1,
    "phase": "mutation",
    "kind": "reorder",
    "touchedPaths": [
      "document/scenes/*/nodes"
