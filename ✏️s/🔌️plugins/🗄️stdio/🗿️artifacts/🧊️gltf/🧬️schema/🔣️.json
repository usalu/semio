{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gltf/artifact-definition/schema.json",
  "type": "object",
  "required": [
    "id",
    "artifact",
    "mutations",
    "inferences"
  ],
  "properties": {
    "id": {
      "const": "s.stdio.gltf"
    },
    "artifact": {
      "const": "gltf"
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "not": {
              "pattern": "\\.(no-mutation\\.|set-snapshot\\.|set-)"
            }
          }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "not": {
              "pattern": "\\.(no-mutation\\.|set-snapshot\\.|set-)"
            }
          }
        }
      }
    }
  },
  "$defs": {}
}
