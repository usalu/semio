{
  "$id": "https://semio.tech/schema/s.stdio.dwg/snapshot.json",
  "title": "DwgSnapshot",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "version": { "type": "string", "x-semio-state": "artifact" },
    "maintenanceVersion": { "type": "integer", "minimum": 0, "maximum": 255, "x-semio-state": "artifact" },
    "codepage": { "type": "integer", "minimum": 0, "maximum": 65535, "x-semio-state": "artifact" },
    "drawing": { "$ref": "#/$defs/drawing", "x-semio-state": "artifact" },
    "sectionNames": { "type": "array", "items": { "type": "string" }, "x-semio-state": "artifact" },
    "decodeStatus": { "type": "string", "x-semio-state": "artifact" }
  },
  "required": ["schema", "version", "maintenanceVersion", "codepage", "drawing", "sectionNames", "decodeStatus"],
  "$defs": {
    "geometry": { "type": "object", "properties": { "kind": { "type": "string" }, "values": { "type": "array", "items": { "type": "number" } }, "indices": { "type": "array", "items": { "type": "integer" } }, "text": { "type": "string" }, "closed": { "type": "boolean" } }, "required": ["kind", "values", "indices", "text", "closed"] },
    "layer": { "type": "object", "properties": { "name": { "type": "string" }, "color": { "type": "integer", "minimum": 0, "maximum": 255 } }, "required": ["name", "color"] },
    "entity": { "type": "object", "properties": { "layer": { "type": "integer", "minimum": 0 }, "color": { "type": "integer" }, "geometry": { "$ref": "#/$defs/geometry" } }, "required": ["layer", "color", "geometry"] },
    "drawing": { "type": "object", "properties": { "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }, "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } }, "extmin": { "type": "array", "items": { "type": "number" } }, "extmax": { "type": "array", "items": { "type": "number" } } }, "required": ["layers", "entities", "extmin", "extmax"] }
  }
}
