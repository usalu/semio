dialect grammar
grammar stdio.dwg.ac1024.mutations
start op
comment none

op = no-mutation | set-snapshot | set-version-info
no-mutation = "no-mutation"
set-snapshot = "set-snapshot" "snapshot" record
set-version-info = "set-version-info" "version" "=" value "maintenance-version" "=" INT "codepage" "=" INT
field = IDENT "=" value
value = field | TEXT | IDENT | INT | FLOAT | "true" | "false" | "null" | list | record
list = "[" value* "]"
record = "{" field* "}"
