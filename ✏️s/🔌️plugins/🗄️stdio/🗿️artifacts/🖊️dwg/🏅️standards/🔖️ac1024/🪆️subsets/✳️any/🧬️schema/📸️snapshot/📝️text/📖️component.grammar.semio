dialect grammar
grammar stdio.dwg.ac1024.snapshot
extension dwg
start document
comment none

# 🎫️26/08/10/ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION FG2: real
# `store::ArtifactDsl::print_dsl`/`parse_dsl` shape for `stdio.dwg` (ac1024), read directly from
# `../🦀️component.rs`'s handcrafted `impl store::ArtifactDsl for DwgSnapshot` — same shape as
# ac1018's own sibling file (`🔖️ac1018/…/📸️snapshot/📝️text/📖️component.grammar.semio`):
# `encode_dwg` deterministically materializes the logical snapshot, and `print_dsl` exposes that
# materialized native document as one continuous run of lowercase hex digit pairs.
document = artifact-mark hex-body
artifact-mark = "stdio.dwg"

# P2-P1-fix note (mandatory reading, `p2-p1-fix-report.md`): an open-ended hex run MUST be the
# framework's built-in `hex` MACRO (bare `hex`, no matching production).
hex-body = hex
