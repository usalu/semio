{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/dwg/ac1024/any/mutation/set-version-info/schema.json",
  "title": "SetVersionInfo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "version",
    "maintenanceVersion",
    "codepage"
  ],
  "properties": {
    "mutation": {
      "const": "setVersionInfo",
      "description": "Aggregate discriminator spliced in by DwgMutation; absent when the payload stands alone."
    },
    "version": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "DWG version",
          "de": "DWG-Version"
        },
        "description": {
          "en": "Version string, e.g. AC1024.",
          "de": "Versionskennung, z. B. AC1024."
        },
        "group": "value",
        "order": 10
      }
    },
    "maintenanceVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Maintenance version",
          "de": "Wartungsversion"
        },
        "precision": 0,
        "group": "value",
        "order": 20
      }
    },
    "codepage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Code page",
          "de": "Codepage"
        },
        "description": {
          "en": "Windows code page number of the drawing text.",
          "de": "Windows-Codepage des Zeichnungstexts."
        },
        "precision": 0,
        "group": "value",
        "order": 30
      }
    }
  }
}
