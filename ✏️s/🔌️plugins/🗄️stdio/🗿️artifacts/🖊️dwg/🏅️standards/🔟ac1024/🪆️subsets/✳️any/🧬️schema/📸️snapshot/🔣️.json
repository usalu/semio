{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/dwg/ac1024/any/snapshot.json",
  "title": "DwgSnapshot",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "maintenanceVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "codepage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "drawing": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/dwg/ac1024/any/artifact.json#/$defs/DwgLogicalDrawing"
    },
    "header": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/dwg/ac1024/any/artifact.json#/$defs/DwgHeaderVariables"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object"
    },
    "application": {
      "type": "object"
    },
    "template": {
      "type": "object"
    },
    "auxiliaryHeader": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/dwg/ac1024/any/artifact.json#/$defs/DwgAuxiliaryHeader"
    },
    "revisionHistory": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/dwg/ac1024/any/artifact.json#/$defs/DwgRevisionHistory"
    },
    "preview": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/dwg/ac1024/any/artifact.json#/$defs/DwgIndexedPreview"
    },
    "applicationHistory": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/dwg/ac1024/any/artifact.json#/$defs/DwgApplicationHistory"
    }
  },
  "required": [
    "schema",
    "version",
    "maintenanceVersion",
    "codepage",
    "drawing",
    "header",
    "classes",
    "dependencies",
    "summary",
    "application",
    "template",
    "auxiliaryHeader",
    "revisionHistory",
    "preview",
    "applicationHistory"
  ]
