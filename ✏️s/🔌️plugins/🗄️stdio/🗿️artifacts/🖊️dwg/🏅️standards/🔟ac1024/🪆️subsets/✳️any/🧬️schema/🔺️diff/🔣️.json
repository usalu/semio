{
  "$id": "https://semio.tech/schema/s.stdio.dwg/diff.json",
  "title": "DwgDiff",
  "type": "object",
  "properties": {
    "version": { "type": "string", "x-semio-state": "artifact" },
    "maintenanceVersion": { "type": "integer", "minimum": 0, "maximum": 255, "x-semio-state": "artifact" },
    "codepage": { "type": "integer", "minimum": 0, "maximum": 65535, "x-semio-state": "artifact" },
    "drawing": { "$ref": "https://semio.tech/schema/s.stdio.dwg/artifact.json#/$defs/drawing", "x-semio-state": "artifact" },
    "header": { "$ref": "https://semio.tech/schema/s.stdio.dwg/artifact.json#/$defs/headerVariables", "x-semio-state": "artifact" },
    "classes": { "type": "array", "items": { "$ref": "#/$defs/class" }, "x-semio-state": "artifact" },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" }, "x-semio-state": "artifact" },
    "summary": { "$ref": "#/$defs/summary", "x-semio-state": "artifact" },
    "application": { "$ref": "#/$defs/application", "x-semio-state": "artifact" },
    "template": { "$ref": "#/$defs/template", "x-semio-state": "artifact" },
    "auxiliaryHeader": { "$ref": "https://semio.tech/schema/s.stdio.dwg/artifact.json#/$defs/auxiliaryHeader", "x-semio-state": "artifact" },
    "revisionHistory": { "$ref": "https://semio.tech/schema/s.stdio.dwg/artifact.json#/$defs/revisionHistory", "x-semio-state": "artifact" },
    "preview": { "$ref": "https://semio.tech/schema/s.stdio.dwg/artifact.json#/$defs/indexedPreview", "x-semio-state": "artifact" },
    "applicationHistory": { "$ref": "https://semio.tech/schema/s.stdio.dwg/artifact.json#/$defs/applicationHistory", "x-semio-state": "artifact" }
  },
  "$defs": {
    "class": { "type": "object", "additionalProperties": false, "required": ["number", "proxyFlags", "applicationName", "cppClassName", "dxfName", "wasZombie", "itemClassId", "objectCount", "dwgVersion", "maintenanceVersion", "reservedValues"], "properties": { "number": { "type": "integer", "minimum": 0 }, "proxyFlags": { "type": "integer", "minimum": 0 }, "applicationName": { "type": "string" }, "cppClassName": { "type": "string" }, "dxfName": { "type": "string" }, "wasZombie": { "type": "boolean" }, "itemClassId": { "type": "integer", "minimum": 0 }, "objectCount": { "type": "integer", "minimum": 0 }, "dwgVersion": { "type": "integer", "minimum": 0 }, "maintenanceVersion": { "type": "integer", "minimum": 0 }, "reservedValues": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } },
    "dependency": { "type": "object", "additionalProperties": false, "required": ["feature", "fullPath", "relativePath", "fingerprint", "version", "timestamp", "fileSize", "affectsGraphics", "referenceCount"], "properties": { "feature": { "type": "string" }, "fullPath": { "type": "string" }, "relativePath": { "type": "string" }, "fingerprint": { "type": "string" }, "version": { "type": "string" }, "timestamp": { "type": "integer", "minimum": 0 }, "fileSize": { "type": "integer", "minimum": 0 }, "affectsGraphics": { "type": "boolean" }, "referenceCount": { "type": "integer", "minimum": 0 } } },
    "julianDate": { "type": "object", "additionalProperties": false, "required": ["days", "milliseconds"], "properties": { "days": { "type": "integer", "minimum": 0 }, "milliseconds": { "type": "integer", "minimum": 0 } } },
    "customProperty": { "type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": { "key": { "type": "string" }, "value": { "type": "string" } } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["title", "subject", "author", "keywords", "comments", "lastSavedBy", "revisionNumber", "hyperlinkBase", "totalEditingTime", "createdAt", "modifiedAt", "customProperties"], "properties": { "title": { "type": "string" }, "subject": { "type": "string" }, "author": { "type": "string" }, "keywords": { "type": "string" }, "comments": { "type": "string" }, "lastSavedBy": { "type": "string" }, "revisionNumber": { "type": "string" }, "hyperlinkBase": { "type": "string" }, "totalEditingTime": { "type": "integer", "minimum": 0 }, "createdAt": { "$ref": "#/$defs/julianDate" }, "modifiedAt": { "$ref": "#/$defs/julianDate" }, "customProperties": { "type": "array", "items": { "$ref": "#/$defs/customProperty" } } } },
    "application": { "type": "object", "additionalProperties": false, "required": ["name", "versionChecksum", "version", "commentChecksum", "comment", "productChecksum", "product", "applicationVersion"], "properties": { "name": { "type": "string" }, "versionChecksum": { "type": "string" }, "version": { "type": "string" }, "commentChecksum": { "type": "string" }, "comment": { "type": "string" }, "productChecksum": { "type": "string" }, "product": { "type": "string" }, "applicationVersion": { "type": "string" } } },
    "template": { "type": "object", "additionalProperties": false, "required": ["description", "measurement"], "properties": { "description": { "type": "string" }, "measurement": { "enum": ["english", "metric"] } } }
  }
}
