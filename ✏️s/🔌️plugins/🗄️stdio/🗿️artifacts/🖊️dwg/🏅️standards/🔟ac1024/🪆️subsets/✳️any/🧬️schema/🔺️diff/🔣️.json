    },
    "codepage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-semio-state": "artifact"
    },
    "drawing": {
      "$ref": "https://semio.tech/schema/s/stdio/dwg/ac1024/any/artifact.json#/$defs/DwgLogicalDrawing",
      "x-semio-state": "artifact"
    },
    "header": {
      "$ref": "https://semio.tech/schema/s/stdio/dwg/ac1024/any/artifact.json#/$defs/headerVariables",
      "x-semio-state": "artifact"
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/class"
      },
      "x-semio-state": "artifact"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/dependency"
      },
      "x-semio-state": "artifact"
    },
    "summary": {
      "$ref": "#/definitions/summary",
      "x-semio-state": "artifact"
    },
    "application": {
      "$ref": "#/definitions/application",
      "x-semio-state": "artifact"
    },
    "template": {
      "$ref": "#/definitions/template",
      "x-semio-state": "artifact"
    },
    "auxiliaryHeader": {
      "$ref": "https://semio.tech/schema/s/stdio/dwg/ac1024/any/artifact.json#/$defs/auxiliaryHeader",
      "x-semio-state": "artifact"
    },
    "revisionHistory": {
      "$ref": "https://semio.tech/schema/s/stdio/dwg/ac1024/any/artifact.json#/$defs/revisionHistory",
      "x-semio-state": "artifact"
    },
    "preview": {
      "$ref": "https://semio.tech/schema/s/stdio/dwg/ac1024/any/artifact.json#/$defs/indexedPreview",
      "x-semio-state": "artifact"
    },
    "applicationHistory": {
      "$ref": "https://semio.tech/schema/s/stdio/dwg/ac1024/any/artifact.json#/$defs/applicationHistory",
      "x-semio-state": "artifact"
    }
