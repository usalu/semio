        "feature": {
          "type": "string"
        },
        "fullPath": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "fileSize": {
          "type": "integer",
          "minimum": 0
        },
        "affectsGraphics": {
          "type": "boolean"
        },
        "referenceCount": {
          "type": "integer",
          "minimum": 0
        }
      }
