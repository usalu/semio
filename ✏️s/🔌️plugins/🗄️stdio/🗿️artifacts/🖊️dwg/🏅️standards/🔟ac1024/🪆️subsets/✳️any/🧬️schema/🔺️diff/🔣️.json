      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subject",
        "author",
        "keywords",
        "comments",
        "lastSavedBy",
        "revisionNumber",
        "hyperlinkBase",
        "totalEditingTime",
        "createdAt",
        "modifiedAt",
        "customProperties"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "lastSavedBy": {
          "type": "string"
        },
        "revisionNumber": {
          "type": "string"
        },
        "hyperlinkBase": {
          "type": "string"
        },
        "totalEditingTime": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "$ref": "#/definitions/julianDate"
        },
        "modifiedAt": {
          "$ref": "#/definitions/julianDate"
        },
        "customProperties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/customProperty"
          }
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "versionChecksum",
        "version",
        "commentChecksum",
        "comment",
        "productChecksum",
        "product",
        "applicationVersion"
