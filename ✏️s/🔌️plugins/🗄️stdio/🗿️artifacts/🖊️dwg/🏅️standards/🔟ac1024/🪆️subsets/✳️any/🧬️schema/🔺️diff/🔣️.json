      "properties": {
        "name": {
          "type": "string"
        },
        "versionChecksum": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commentChecksum": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "productChecksum": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "applicationVersion": {
          "type": "string"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "measurement"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "measurement": {
          "enum": [
            "english",
            "metric"
          ]
        }
      }
    }
