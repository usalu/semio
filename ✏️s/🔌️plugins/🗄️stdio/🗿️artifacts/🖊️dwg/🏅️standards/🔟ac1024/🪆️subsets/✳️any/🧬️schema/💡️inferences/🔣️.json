      "properties": {
        "layerCount": { "type": "integer", "minimum": 0 },
        "entityCount": { "type": "integer", "minimum": 0 },
        "geometryValueCount": { "type": "integer", "minimum": 0 },
        "geometryIndexCount": { "type": "integer", "minimum": 0 },
        "textCharacterCount": { "type": "integer", "minimum": 0 },
        "codepage": { "type": "integer", "minimum": 0 },
        "version": { "type": "string" }
