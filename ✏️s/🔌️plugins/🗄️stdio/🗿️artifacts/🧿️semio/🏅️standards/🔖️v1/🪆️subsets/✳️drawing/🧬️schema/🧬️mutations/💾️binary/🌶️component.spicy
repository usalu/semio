module Stdio_semio_drawing_mutations;

# Real binary op frame: `format` (1 byte) + `tag` (1 byte, the `SemioDrawingMutation` variant
# ordinal), then one opaque `payload` tail (the variant's own `key=value ...` argument text) — see
# the sibling `📡️component.protocol.semio`'s comment on the boundary.
type Document = unit {
    format: uint8;
    tag: uint8;
    payload: bytes &eod;
};
