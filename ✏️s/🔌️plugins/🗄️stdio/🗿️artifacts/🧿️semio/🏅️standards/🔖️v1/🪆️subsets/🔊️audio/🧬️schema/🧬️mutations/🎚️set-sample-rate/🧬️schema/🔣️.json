{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/audio/mutation/set-sample-rate/schema.json",
  "title": "SetSampleRate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "sampleRate"
  ],
  "properties": {
    "mutation": {
      "const": "setSampleRate",
      "description": "Aggregate discriminator spliced in by SemioAudioMutation; absent when the payload stands alone."
    },
    "sampleRate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Sample rate",
          "de": "Abtastrate"
        },
        "unit": "Hz"
      }
    }
  }
}
