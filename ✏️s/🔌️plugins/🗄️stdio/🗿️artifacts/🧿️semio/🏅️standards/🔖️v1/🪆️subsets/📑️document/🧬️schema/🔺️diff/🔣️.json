{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/document/diff.json",
  "title": "SemioDocumentDiff",
  "description": "Handcrafted sparse diff: name-keyed styles/images triples + an index-keyed recursive blocks triple.",
  "type": "object",
  "properties": {
    "styles": {
      "$ref": "#/definitions/namedTriple"
    },
    "images": {
      "$ref": "#/definitions/namedTriple"
    },
    "blocks": {
      "$ref": "#/definitions/indexedTriple"
    }
  },
  "definitions": {
    "indexedTriple": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "modified": {
          "type": "array"
        },
        "added": {
          "type": "array"
        }
      }
    },
    "namedTriple": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array"
        },
        "added": {
          "type": "array"
        }
      }
    }
  }
}
