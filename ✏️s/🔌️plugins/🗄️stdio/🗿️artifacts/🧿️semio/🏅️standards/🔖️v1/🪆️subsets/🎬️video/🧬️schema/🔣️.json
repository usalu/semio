{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/video/artifact.json",
  "title": "SemioVideoArtifact",
  "description": "Full artifact state, mirrors SemioVideoSnapshot field for field.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "streams": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "./📸️snapshot/🔣️.json#/properties/streams/items"
      }
    }
  },
  "required": [
    "schema",
    "streams"
  ]
}
