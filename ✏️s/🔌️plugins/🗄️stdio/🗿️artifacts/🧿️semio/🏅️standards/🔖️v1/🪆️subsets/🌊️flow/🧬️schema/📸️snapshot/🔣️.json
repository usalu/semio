{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/flow/snapshot.json",
  "title": "SemioFlowSnapshot",
  "description": "🧬️ Real facet mirror of 🦀️.rs — id-keyed nodes{kind,label,params,position} + PortRef-addressed edges{from,to,kind}.",
  "type": "object",
  "definitions": {
    "SemioPoint2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "PortRef": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "port": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Port",
              "de": "Port"
            }
          }
        }
      },
      "required": [
        "node",
        "port"
      ]
    },
    "FlowParam": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "FlowNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowParam"
          }
        },
        "position": {
          "$ref": "#/definitions/SemioPoint2"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "params",
        "position"
      ]
    },
    "FlowEdge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/definitions/PortRef"
        },
        "to": {
          "$ref": "#/definitions/PortRef"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "kind"
      ]
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "nodes": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/definitions/FlowNode"
      },
      "x-semio-ui": {
        "label": {
          "en": "Nodes",
          "de": "Knoten"
        }
      }
    },
    "edges": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/definitions/FlowEdge"
      },
      "x-semio-ui": {
        "label": {
          "en": "Edges",
          "de": "Kanten"
        }
      }
    }
  },
  "required": [
    "schema",
    "nodes",
    "edges"
  ]
}
