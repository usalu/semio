{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/mutation/set-spatial-node/schema.json",
  "title": "SetSpatialNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id"
  ],
  "properties": {
    "mutation": {
      "const": "setSpatialNode",
      "description": "Aggregate discriminator spliced in by SemioModelMutation; absent when the payload stands alone."
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Spatial node",
          "de": "Raumknoten"
        },
        "description": {
          "en": "Id of the spatial node.",
          "de": "Kennung des Raumknotens."
        },
        "ref": {
          "kind": "spatialNode"
        },
        "group": "target",
        "order": 10
      }
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpatialKind"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "options": {
          "site": {
            "en": "Site",
            "de": "Grundstück"
          },
          "building": {
            "en": "Building",
            "de": "Gebäude"
          },
          "storey": {
            "en": "Storey",
            "de": "Geschoss"
          },
          "space": {
            "en": "Space",
            "de": "Raum"
          }
        }
      }
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "description": {
          "en": "Display name of the spatial node.",
          "de": "Anzeigename des Raumknotens."
        },
        "group": "value",
        "order": 30
      }
    },
    "parentId": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Parent",
          "de": "Übergeordneter Knoten"
        },
        "description": {
          "en": "Id of the parent spatial node; cleared, the node becomes a root.",
          "de": "Kennung des übergeordneten Raumknotens; geleert wird der Knoten zur Wurzel."
        },
        "ref": {
          "kind": "spatialNode"
        },
        "group": "value",
        "order": 40
      }
    },
    "placement": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemioTransform"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Placement",
          "de": "Platzierung"
        },
        "description": {
          "en": "Translation, rotation (unit quaternion) and scale of the local placement.",
          "de": "Verschiebung, Drehung (Einheitsquaternion) und Skalierung der lokalen Platzierung."
        },
        "group": "value",
        "order": 50
      }
    }
  },
  "$defs": {
    "SpatialKind": {
      "type": "string",
      "enum": [
        "site",
        "building",
        "storey",
        "space"
      ]
    },
    "SemioTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/SemioPoint3",
          "x-semio-ui": {
            "label": {
              "en": "Translation",
              "de": "Verschiebung"
            }
          }
        },
        "rotation": {
          "$ref": "#/$defs/SemioQuaternion"
        },
        "scale": {
          "$ref": "#/$defs/SemioPoint3"
        }
      }
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "W",
              "de": "W"
            },
            "description": {
              "en": "Scalar part of the rotation quaternion.",
              "de": "Skalarteil des Rotationsquaternions."
            }
          }
        }
      }
    }
  }
}
