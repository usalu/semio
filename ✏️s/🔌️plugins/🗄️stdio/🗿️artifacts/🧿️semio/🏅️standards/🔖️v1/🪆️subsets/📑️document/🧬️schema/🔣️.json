{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/document/artifact.json",
  "title": "SemioDocumentArtifact",
  "description": "Full artifact state, mirrors SemioDocumentSnapshot field for field.",
  "type": "object",
  "required": [
    "schema",
    "styles",
    "images",
    "blocks"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "styles": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object"
      }
    },
    "images": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object"
      }
    },
    "blocks": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object"
      }
    }
  }
}
