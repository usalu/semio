{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/snapshot.json",
  "title": "SemioImageSnapshot",
  "description": "width/height/colorspace/bitDepth + frames{delayMs, rgba8} + icc + metadata entries.",
  "type": "object",
  "required": [
    "schema",
    "width",
    "height",
    "colorspace",
    "bitDepth",
    "frames",
    "metadata"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "width": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "colorspace": {
      "enum": [
        "rgb",
        "rgba",
        "grayscale",
        "grayscaleAlpha",
        "indexed"
      ],
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "select",
        "label": {
          "en": "Color space",
          "de": "Farbraum"
        },
        "options": {
          "rgb": {
            "en": "RGB",
            "de": "RGB"
          },
          "rgba": {
            "en": "RGB with alpha",
            "de": "RGB mit Alpha"
          },
          "grayscale": {
            "en": "Grayscale",
            "de": "Graustufen"
          },
          "grayscaleAlpha": {
            "en": "Grayscale with alpha",
            "de": "Graustufen mit Alpha"
          },
          "indexed": {
            "en": "Indexed color",
            "de": "Indizierte Farben"
          }
        }
      }
    },
    "bitDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Bit depth",
          "de": "Bittiefe"
        },
        "unit": "bit"
      }
    },
    "frames": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "properties": {
          "delayMs": {
            "type": "integer",
            "minimum": 0,
            "x-semio-ui": {
              "widget": "stepper",
              "label": {
                "en": "Frame delay",
                "de": "Bildverzögerung"
              },
              "unit": "ms"
            }
          },
          "rgba8": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "x-semio-ui": {
              "label": {
                "en": "RGBA pixels",
                "de": "RGBA-Pixel"
              },
              "description": {
                "en": "8-bit red, green, blue, alpha per pixel, row by row.",
                "de": "8 Bit Rot, Grün, Blau, Alpha je Pixel, zeilenweise."
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Frames",
          "de": "Einzelbilder"
        }
      }
    },
    "icc": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "ICC profile",
          "de": "ICC-Profil"
        }
      }
    },
    "metadata": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Metadata",
          "de": "Metadaten"
        }
      }
    }
  }
}
