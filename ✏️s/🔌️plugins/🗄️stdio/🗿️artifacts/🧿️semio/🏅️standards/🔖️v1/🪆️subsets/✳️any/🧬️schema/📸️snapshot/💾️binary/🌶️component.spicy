module Stdio_semio_snapshot;

# `pack` payload, past the `semio_format` envelope: real `format`/`tag` (1 byte each) + a
# varint-length-prefixed `schema` UTF-8 string, then one opaque `payload` tail — the wrapped
# subset's own real `ArtifactPack::encode_pack()` bytes (see the sibling `📡️component.protocol.semio`
# comment on the `protocol-prim-ref-recursion` boundary this crosses).
type Document = unit {
    format: uint8;
    tag: uint8;
    schema_len: bytes &until=$$ ; # varint (LEB128) — Spicy has no native varint primitive; see
                                   # 📸️snapshot/🦀️component.rs's real `store::pack_rt` varint reader.
    payload: bytes &eod;
};
