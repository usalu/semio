{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/mutation/insert-frame/schema.json",
  "title": "InsertFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "frame"
  ],
  "properties": {
    "mutation": {
      "const": "insertFrame",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the frames at which it is inserted, counted from 0.",
          "de": "Position unter den Einzelbildern, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "frame": {
      "$ref": "#/$defs/SemioImageFrame",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Frame",
          "de": "Einzelbild"
        },
        "description": {
          "en": "Delay and RGBA pixels of the frame that is inserted.",
          "de": "Verzögerung und RGBA-Pixel des Einzelbilds, das eingefügt wird."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "SemioImageFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delayMs"
      ],
      "properties": {
        "delayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Frame delay",
              "de": "Bildverzögerung"
            },
            "unit": "ms"
          }
        },
        "rgba8": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "RGBA pixels",
              "de": "RGBA-Pixel"
            },
            "description": {
              "en": "8-bit red, green, blue, alpha per pixel, row by row.",
              "de": "8 Bit Rot, Grün, Blau, Alpha je Pixel, zeilenweise."
            }
          }
        }
      }
    }
  }
}
