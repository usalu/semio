module Stdio_semio_document_diff;

# Real binary `SemioDocumentDiff` frame: `format` (1 byte) + `presence` bitmask (1 byte,
# bit0=styles bit1=images bit2=blocks), then one opaque `payload` tail — see the sibling
# `📡️.protocol.semio`'s comment on the `protocol-cond-cannot-chain` boundary.
type Document = unit {
    format: uint8;
    presence: uint8;
    payload: bytes &eod;
};
