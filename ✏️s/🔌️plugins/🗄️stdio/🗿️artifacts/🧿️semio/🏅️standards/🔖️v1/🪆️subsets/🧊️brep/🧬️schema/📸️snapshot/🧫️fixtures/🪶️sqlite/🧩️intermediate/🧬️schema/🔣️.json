{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "cases"
  ],
  "properties": {
    "role": {
      "const": "codeAdmittedIntermediateOwner"
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "origin",
        "direction"
      ],
      "properties": {
        "kind": {
          "const": "line"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "direction": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "plane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "origin",
        "normal"
      ],
      "properties": {
        "kind": {
          "const": "plane"
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "normal": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "vertex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "point",
        "tol"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "point": {
          "$ref": "#/$defs/point"
        },
        "tol": {
          "type": "number"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startVertex",
        "endVertex",
        "curve",
        "tol"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "startVertex": {
          "type": "string"
        },
        "endVertex": {
          "type": "string"
        },
        "curve": {
          "$ref": "#/$defs/line"
        },
        "tol": {
          "type": "number"
        }
      }
    },
    "loopEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "orientation"
      ],
      "properties": {
        "edge": {
          "type": "string"
        },
        "orientation": {
          "type": "boolean"
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "edges"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loopEdge"
          }
        }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outerLoop",
        "innerLoops",
        "surface",
        "orientation",
        "tol"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "outerLoop": {
          "type": "string"
        },
        "innerLoops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surface": {
          "$ref": "#/$defs/plane"
        },
        "orientation": {
          "type": "boolean"
        },
        "tol": {
          "type": "number"
        }
      }
    },
    "shellFace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face",
        "orientation"
      ],
      "properties": {
        "face": {
          "type": "string"
        },
        "orientation": {
          "type": "boolean"
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "faces"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "faces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shellFace"
          }
        }
      }
    },
    "solidShell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell",
        "isVoid"
      ],
      "properties": {
        "shell": {
          "type": "string"
        },
        "isVoid": {
          "type": "boolean"
        }
      }
    },
    "solid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shells"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "shells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/solidShell"
          }
        }
      }
    },
    "coedge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "edge",
        "forward",
        "pcurve",
        "prange",
        "loopId",
        "next",
        "prev"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "edge": {
          "type": "string"
        },
        "forward": {
          "type": "boolean"
        },
        "pcurve": {
          "type": "null"
        },
        "prange": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "loopId": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "prev": {
          "type": "string"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "nextLabel",
        "vertices",
        "edges",
        "loops",
        "faces",
        "shells",
        "solids",
        "coedges"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "nextLabel": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vertex"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "loops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loop"
          }
        },
        "faces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/face"
          }
        },
        "shells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shell"
          }
        },
        "solids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/solid"
          }
        },
        "coedges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coedge"
          }
        }
      }
    },
    "queriedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_native_id",
        "loop_native_id",
        "next_native_id",
        "previous_native_id"
      ],
      "properties": {
        "edge_native_id": {
          "type": "string"
        },
        "loop_native_id": {
          "type": "string"
        },
        "next_native_id": {
          "type": "string"
        },
        "previous_native_id": {
          "type": "string"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "snapshot",
        "query",
        "expectedRows"
      ],
      "properties": {
        "name": {
          "enum": [
            "unresolvedTopology",
            "nonreciprocalRing",
            "duplicateNativeNames"
          ]
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "query": {
          "type": "string"
        },
        "expectedRows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/queriedRow"
          }
        }
      }
    }
  }
}
