            "properties": {
              "language": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "marks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "href"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "bold",
                        "italic",
                        "code",
                        "link"
                      ]
                    },
                    "href": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cancelAfterTurns": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "integer",
