{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/cad/diff.json",
  "title": "SemioCadDiff",
  "description": "Real facet mirror of 🦀️.rs (source of truth) -- sparse, handcrafted, name/handle-keyed triples over ../📸️snapshot/🔣️.json's domain types.",
  "definitions": {
    "layerDiff": {
      "type": "object",
      "properties": {
        "colorIndex": {
          "type": "integer"
        },
        "lineType": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "entityRecordDiff": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string"
        },
        "entity": {
          "$ref": "https://semio.tech/schema/s/stdio/semio/v1/cad/snapshot.json#/$defs/entity"
        }
      }
    },
    "blockDiff": {
      "type": "object",
      "properties": {
        "basePoint": {
          "$ref": "https://semio.tech/schema/s/stdio/semio/v1/cad/snapshot.json#/$defs/point2"
        },
        "entities": {
          "$ref": "#/definitions/entitiesDiff"
        }
      }
    },
    "layersDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "$ref": "#/definitions/layerDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/stdio/semio/v1/cad/snapshot.json#/$defs/layer"
          }
        }
      }
    },
    "blocksDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "$ref": "#/definitions/blockDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/stdio/semio/v1/cad/snapshot.json#/$defs/block"
          }
        }
      }
    },
    "entitiesDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "$ref": "#/definitions/entityRecordDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/stdio/semio/v1/cad/snapshot.json#/$defs/entityRecord"
          }
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "layers": {
      "$ref": "#/definitions/layersDiff"
    },
    "blocks": {
      "$ref": "#/definitions/blocksDiff"
    },
    "entities": {
      "$ref": "#/definitions/entitiesDiff"
    }
  }
}
