{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplacePath",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "at",
    "newSegments"
  ],
  "properties": {
    "at": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "newSegments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "MoveTo"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "LineTo"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "CubicTo"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "QuadTo"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "ArcTo"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
