dialect grammar
grammar stdio.semio.document.diff
extension semio
start document

# ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION document wave: real one-line
# `DiffCodec::print_diff`/`parse_diff` shape ALREADY emitted by `🦀️component.rs`'s
# `print_document_diff`/`parse_document_diff` — token-per-nonempty-collection, space-separated
# (space is lexer trivia, irrelevant at this dialect level). `styles`/`images` are NAME-keyed
# (`engine::triples::enc_named_triple`, `DocStyle::id`/`DocImage::id`); `blocks` is INDEX-keyed
# (`enc_indexed_triple`) and recursive (`List`/`Table`/`Quote` all nest `DocBlock` further down).
# All 3 top-level fields are optional (an unchanged diff prints as the empty string).
document = styles-line? images-line? blocks-line?

styles-line = "styles" "=" styles-triple
styles-triple = "[" named-removed-list? "]" ";" "[" style-modified-list? "]" ";" "[" style-added-list? "]"
style-modified-list = style-modified {"," style-modified}*
style-modified = hex ":" style-diff
style-added-list = style {"," style}*

images-line = "images" "=" images-triple
images-triple = "[" named-removed-list? "]" ";" "[" image-modified-list? "]" ";" "[" image-added-list? "]"
image-modified-list = image-modified {"," image-modified}*
image-modified = hex ":" image-diff
image-added-list = image {"," image}*

named-removed-list = hex {"," hex}*

blocks-line = "blocks" "=" blocks-diff
blocks-diff = "[" indexed-removed-list? "]" ";" "[" block-modified-list? "]" ";" "[" block-added-list? "]"
block-modified-list = block-modified {"," block-modified}*
block-modified = INT ":" block-diff
block-added-list = block-added {"," block-added}*
block-added = INT ":" block

indexed-removed-list = INT {"," INT}*

# `enc_style`/`enc_image`/`enc_block`/`enc_run` — the same full-VALUE codecs
# `../../📸️snapshot/📝️text/📖️component.grammar.semio` declares (restated here so this leaf grammar
# is self-contained, matching the repo's existing per-facet convention).
style = "[" hex "," hex "," option-hex "]"
image = "[" hex "," hex "," hex "]"
run = "[" hex "," run-style "]"
run-style = "[" bool "," bool "," bool "," option-num "," option-hex "," option-hex "," option-hex "]"
list-item = "[" "[" block-items? "]" "]"
row = "[" "[" cell-items? "]" "]"
cell = "[" "[" block-items? "]" "]"
block-items = block {"," block}*
block = "P" "[" option-hex "," "[" run-items? "]" "]" | "H" "[" INT "," option-hex "," "[" run-items? "]" "]" | "L" "[" bool "," "[" list-item-items? "]" "]" | "T" "[" "[" row-items? "]" "]" | "C" "[" option-hex "," hex "]" | "Q" "[" "[" block-items? "]" "]" | "I" "[" hex "," hex "," option-num "," option-num "]" | "B" "[" "]"
run-items = run {"," run}*
list-item-items = list-item {"," list-item}*
row-items = row {"," row}*
cell-items = cell {"," cell}*

# Per-entity/per-field diff grammars — field order matches `🦀️component.rs`'s `enc_style_diff`/
# `enc_image_diff`/`enc_run_diff`/`enc_run_style_diff`/`enc_block_diff`'s 8 per-kind arms exactly
# (the authoritative source). Every `Option<T>` field prints via the shared `[0]` (unchanged) /
# `[1,<value>]` (changed) tri-state tag; every DOUBLY-optional `Option<Option<T>>` field (the
# block/snapshot's own value is itself an `Option`, e.g. `style_id`/`based_on`/`language`/
# `size`/`font`/`color`/`link`/`width`/`height`) nests a second tri-state tag inside the first.
style-diff = "[" option-hex "," option-option-hex "]"
image-diff = "[" option-hex "," option-hex "]"

paragraph-diff = "[" option-option-hex "," option-runs-diff "]"
heading-diff = "[" option-num "," option-option-hex "," option-runs-diff "]"
list-diff = "[" option-bool "," option-items-diff "]"
table-diff = "[" option-rows-diff "]"
code-diff = "[" option-option-hex "," option-hex "]"
quote-diff = "[" option-blocks-diff "]"
image-block-diff = "[" option-hex "," option-hex "," option-option-num "," option-option-num "]"
block-diff = "P" paragraph-diff | "H" heading-diff | "L" list-diff | "T" table-diff | "C" code-diff | "Q" quote-diff | "I" image-block-diff | "R" "[" block "]"

run-diff = "[" option-hex "," option-run-style-diff "]"
run-style-diff = "[" option-bool "," option-bool "," option-bool "," option-option-num "," option-option-hex "," option-option-hex "," option-option-hex "]"
option-run-style-diff = "[" "0" "]" | "[" "1" "," run-style-diff "]"
runs-diff = "[" indexed-removed-list? "]" ";" "[" run-modified-list? "]" ";" "[" run-added-list? "]"
run-modified-list = run-modified {"," run-modified}*
run-modified = INT ":" run-diff
run-added-list = run-added {"," run-added}*
run-added = INT ":" run
option-runs-diff = "[" "0" "]" | "[" "1" "," runs-diff "]"

list-item-diff = "[" option-blocks-diff "]"
items-diff = "[" indexed-removed-list? "]" ";" "[" item-modified-list? "]" ";" "[" item-added-list? "]"
item-modified-list = item-modified {"," item-modified}*
item-modified = INT ":" list-item-diff
item-added-list = item-added {"," item-added}*
item-added = INT ":" list-item
option-items-diff = "[" "0" "]" | "[" "1" "," items-diff "]"

row-diff = "[" option-cells-diff "]"
rows-diff = "[" indexed-removed-list? "]" ";" "[" row-modified-list? "]" ";" "[" row-added-list? "]"
row-modified-list = row-modified {"," row-modified}*
row-modified = INT ":" row-diff
row-added-list = row-added {"," row-added}*
row-added = INT ":" row
option-rows-diff = "[" "0" "]" | "[" "1" "," rows-diff "]"

cell-diff = "[" option-blocks-diff "]"
cells-diff = "[" indexed-removed-list? "]" ";" "[" cell-modified-list? "]" ";" "[" cell-added-list? "]"
cell-modified-list = cell-modified {"," cell-modified}*
cell-modified = INT ":" cell-diff
cell-added-list = cell-added {"," cell-added}*
cell-added = INT ":" cell
option-cells-diff = "[" "0" "]" | "[" "1" "," cells-diff "]"

option-blocks-diff = "[" "0" "]" | "[" "1" "," blocks-diff "]"

option-hex = "[" "0" "]" | "[" "1" "," hex "]"
option-option-hex = "[" "0" "]" | "[" "1" "," option-hex "]"
# `enc_f64` prints `f64::to_bits()` (a `u64` bit pattern) as plain decimal digits, NOT a float
# literal — every numeric leaf (`u8` via `enc_u8`, `f64` via `enc_f64`) is a bare `INT` token.
option-num = "[" "0" "]" | "[" "1" "," INT "]"
option-option-num = "[" "0" "]" | "[" "1" "," option-num "]"
option-bool = "[" "0" "]" | "[" "1" "," bool "]"
bool = "0" | "1"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO — see the sibling `../../📸️snapshot/📝️text/📖️component.grammar.semio`'s own `hex` doc
# comment for why a hand-rolled `{INT|IDENT}*` production would be wrong here.
