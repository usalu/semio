dialect grammar stdio.semio.document.diff
; Space-separated key=value tokens; each value a `[removed];[modified];[added]` triple.
root = document
document = *(token SP) / ""
token = stylesToken / imagesToken / blocksToken
stylesToken = "styles=" triple
imagesToken = "images=" triple
blocksToken = "blocks=" triple
triple = "[" removedList "];[" modifiedList "];[" addedList "]"
removedList = *(key ",")
modifiedList = *(key ":" itemDiff ",")
addedList = *(item ",")
