dialect protocol
protocol stdio.semio.kit.mutations
version 1
schema s.stdio.semio.kit
start body
framing record

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM kit wave (W2c). Real binary op frame: `format u8` + `tag u8`
# (the `SemioKitMutation` variant ordinal, `../💾️binary/🦀️.rs`'s
# `OP_KEYWORDS`/`variant_ordinal`, 0-14) as two REAL fixed fields, then the variant's own argument
# payload as one opaque trailing `bytes` chain.
header fixed 2
field format u8
field tag u8

chain payload bytes
