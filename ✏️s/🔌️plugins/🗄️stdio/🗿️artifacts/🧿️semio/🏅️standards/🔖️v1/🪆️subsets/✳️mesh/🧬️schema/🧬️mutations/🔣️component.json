    { "type": "object", "properties": { "mutation": { "const": "addTexture" }, "texture": { "type": "object" } }, "required": ["mutation", "texture"] },
    { "type": "object", "properties": { "mutation": { "const": "removeTexture" }, "id": { "type": "string" } }, "required": ["mutation", "id"] },
