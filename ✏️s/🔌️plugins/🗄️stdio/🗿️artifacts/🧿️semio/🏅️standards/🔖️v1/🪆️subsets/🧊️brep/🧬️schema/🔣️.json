{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/artifact.json",
  "title": "SemioBrepArtifact",
  "description": "Full artifact state, mirrors SemioBrepSnapshot field for field. See ./📸️snapshot/🔣️.json for the entity type definitions.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "vertices": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepVertex"
      }
    },
    "edges": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepEdge"
      }
    },
    "loops": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepLoop"
      }
    },
    "faces": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepFace"
      }
    },
    "shells": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepShell"
      }
    },
    "solids": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepSolid"
      }
    },
    "coedges": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepCoedge"
      }
    },
    "nextLabel": {
      "type": "integer",
      "x-semio-state": "artifact"
    }
  },
  "required": [
    "schema",
    "vertices",
    "edges",
    "loops",
    "faces",
    "shells",
    "solids",
    "coedges",
    "nextLabel"
