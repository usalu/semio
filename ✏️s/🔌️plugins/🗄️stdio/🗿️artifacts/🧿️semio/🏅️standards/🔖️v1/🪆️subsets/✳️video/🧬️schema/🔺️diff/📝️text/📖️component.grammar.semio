dialect grammar
grammar stdio.semio.video.diff
extension semio
start document

# Video wave: real one-line `DiffCodec::print_diff`/`parse_diff` shape ALREADY emitted by
# `🔺️diff/🦀️component.rs` (`print_semio_video_diff`/`parse_semio_video_diff`) — a single optional
# `streams=` token; `streams` is index-keyed (no natural id — the master plan's own spec never
# proposes one for `streams`/`samples`), encoded via `engine::triples::enc_indexed_triple`/
# `dec_indexed_triple` (recipe's own index-keyed collection-triple shape, §1.4's sibling to the
# hex-keyed pattern). The SAME generic triple codec is reused, recursively, one nesting level down
# for each modified stream's own `samples` field.
document = streams-line?

streams-line = "streams" "=" streams-triple
streams-triple = "[" removed-list? "]" ";" "[" stream-modified-list? "]" ";" "[" stream-added-list? "]"
removed-list = INT {"," INT}*
stream-modified-list = stream-modified {"," stream-modified}*
stream-modified = INT ":" stream-diff
stream-added-list = stream-added {"," stream-added}*
stream-added = INT ":" stream

# `enc_stream_diff`/`dec_stream_diff` — `SemioVideoStreamDiff`'s 6 fields (`kind`/`codec`/`width`/
# `height`/`rate`/`samples`), each an `Option<T>` printed via the shared `[0]` (None) /
# `[1,<value>]` (Some) tri-state tag (recipe §1.4's "tri-state" pattern). Each bracket/digit/comma
# is its OWN literal token (`"[" "0" "]"`, never a combined `"[0]"` literal) — the shared lexer
# tokenizes `[`/`]`/digits separately, so a single `Symbol::Literal("[0]")` can never match one
# input token; mesh's own diff grammar established this exact three-token-literal shape first.
# `samples` nests the SAME `streams-triple` shape one level down (`SemioVideoSamplesDiff`, itself
# an `IndexedTripleDiff`).
stream-diff = "[" opt-kind "," opt-codec "," opt-width "," opt-height "," opt-rate "," opt-samples "]"
opt-kind = "[" "0" "]" | "[" "1" "," kind "]"
opt-codec = "[" "0" "]" | "[" "1" "," hex "]"
opt-width = "[" "0" "]" | "[" "1" "," INT "]"
opt-height = "[" "0" "]" | "[" "1" "," INT "]"
opt-rate = "[" "0" "]" | "[" "1" "," rational "]"
opt-samples = "[" "0" "]" | "[" "1" "," samples-triple "]"

samples-triple = "[" removed-list? "]" ";" "[" sample-modified-list? "]" ";" "[" sample-added-list? "]"
sample-modified-list = sample-modified {"," sample-modified}*
sample-modified = INT ":" sample-diff
sample-added-list = sample-added {"," sample-added}*
sample-added = INT ":" sample
sample-diff = "[" opt-pts "," opt-key "," opt-data "]"
opt-pts = "[" "0" "]" | "[" "1" "," INT "]"
opt-key = "[" "0" "]" | "[" "1" "," bool "]"
opt-data = "[" "0" "]" | "[" "1" "," hex "]"

# `enc_stream`/`enc_sample` — the same full-VALUE codecs `📸️snapshot/📝️text/📖️component.grammar.semio`
# declares (restated here so this leaf grammar is self-contained, matching the repo's existing
# per-facet convention).
stream = "[" kind "," hex "," INT "," INT "," rational "," "[" sample-list? "]" "]"
sample-list = sample {"," sample}*
sample = "[" INT "," bool "," hex "]"
rational = "[" INT "," INT "]"
kind = "V" | "A" | "S"
bool = "0" | "1"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO — see the sibling `📸️snapshot/📝️text/📖️component.grammar.semio`'s own `hex` doc
# comment for why a hand-rolled `{INT|IDENT}*` production would be wrong here.
