; ABNF-style descriptive mirror of `stdio.semio.flow`'s real diff binary frame -- see the
; authoritative `📡️component.protocol.semio` for the conformance-tested version.
document  = format presence payload
format    = %x01                  ; DIFF_BINARY_FORMAT
presence  = OCTET                 ; bit0=nodes present, bit1=edges present
payload   = *OCTET                ; 0-2 varint-length-prefixed opaque blobs, see component.rs
