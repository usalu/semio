module Semio_semio_drawing_snapshot;
# real semio_format::wrap_binary envelope: 8-byte magic, u32-LE token length, UTF-8 token, then
# raw JSON(SemioDrawingSnapshot) bytes to end of input (structure of that JSON: 🔣️component.json).
type Document = unit {
    magic: bytes &size=8;
    token_len: uint32 &byte-order=spicy::ByteOrder::Little;
    token: bytes &size=self.token_len;
    json_bytes: bytes &eod;
};
