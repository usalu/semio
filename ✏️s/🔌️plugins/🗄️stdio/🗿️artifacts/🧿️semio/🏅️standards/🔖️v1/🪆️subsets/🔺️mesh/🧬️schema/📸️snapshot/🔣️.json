{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/snapshot.json",
  "title": "SemioMeshSnapshot",
  "description": "meshes -> primitives{topology, positions/normals/uvs/colors, indices, material} + materials (PBR base_color/metallic/roughness) + textures{mime, bytes}. Real mirror of the Rust snapshot.",
  "type": "object",
  "definitions": {
    "SemioPoint3": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "SemioUv": {
      "type": "object",
      "properties": {
        "u": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "U",
              "de": "U"
            }
          }
        },
        "v": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "V",
              "de": "V"
            }
          }
        }
      },
      "required": [
        "u",
        "v"
      ]
    },
    "SemioRgba": {
      "type": "object",
      "properties": {
        "r": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        },
        "a": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Alpha",
              "de": "Alpha"
            },
            "description": {
              "en": "Opacity, 0 transparent to 1 opaque.",
              "de": "Deckkraft, 0 transparent bis 1 deckend."
            }
          }
        }
      },
      "required": [
        "r",
        "g",
        "b",
        "a"
      ]
    },
    "SemioTopology": {
      "type": "string",
      "enum": [
        "points",
        "lines",
        "lineStrip",
        "triangles",
        "triangleStrip",
        "triangleFan"
      ]
    },
    "SemioPrimitive": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "topology": {
          "$ref": "#/definitions/SemioTopology",
          "x-semio-ui": {
            "widget": "select",
            "label": {
              "en": "Primitive topology",
              "de": "Primitivtopologie"
            },
            "options": {
              "points": {
                "en": "Points",
                "de": "Punkte"
              },
              "lines": {
                "en": "Lines",
                "de": "Linien"
              },
              "lineStrip": {
                "en": "Line strip",
                "de": "Linienzug"
              },
              "triangles": {
                "en": "Triangles",
                "de": "Dreiecke"
              },
              "triangleStrip": {
                "en": "Triangle strip",
                "de": "Dreiecksstreifen"
              },
              "triangleFan": {
                "en": "Triangle fan",
                "de": "Dreiecksfächer"
              }
            }
          }
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SemioPoint3"
          },
          "x-semio-ui": {
            "label": {
              "en": "Positions",
              "de": "Positionen"
            }
          }
        },
        "normals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SemioPoint3"
          },
          "x-semio-ui": {
            "label": {
              "en": "Normals",
              "de": "Normalen"
            }
          }
        },
        "uvs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SemioUv"
          },
          "x-semio-ui": {
            "label": {
              "en": "Texture coordinates",
              "de": "Texturkoordinaten"
            }
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SemioRgba"
          },
          "x-semio-ui": {
            "label": {
              "en": "Vertex colors",
              "de": "Eckpunktfarben"
            }
          }
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "materialId": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Material",
              "de": "Material"
            },
            "ref": {
              "kind": "material"
            }
          }
        }
      },
      "required": [
        "id"
      ]
    },
    "SemioMesh": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "primitives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SemioPrimitive"
          },
          "x-semio-ui": {
            "label": {
              "en": "Primitives",
              "de": "Primitive"
            }
          }
        }
      },
      "required": [
        "id"
      ]
    },
    "SemioMaterial": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "baseColor": {
          "$ref": "#/definitions/SemioRgba",
          "x-semio-ui": {
            "label": {
              "en": "Base color",
              "de": "Grundfarbe"
            }
          }
        },
        "metallic": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Metallic",
              "de": "Metallizität"
            },
            "description": {
              "en": "PBR metalness, 0 dielectric to 1 metal.",
              "de": "PBR-Metallizität, 0 Dielektrikum bis 1 Metall."
            }
          }
        },
        "roughness": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Roughness",
              "de": "Rauheit"
            },
            "description": {
              "en": "PBR roughness, 0 smooth to 1 rough.",
              "de": "PBR-Rauheit, 0 glatt bis 1 rau."
            }
          }
        }
      },
      "required": [
        "id"
      ]
    },
    "SemioTexture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "mime": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Media type",
              "de": "Medientyp"
            }
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "x-semio-ui": {
            "label": {
              "en": "Bytes",
              "de": "Bytes"
            }
          }
        }
      },
      "required": [
        "id"
      ]
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "meshes": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/definitions/SemioMesh"
      },
      "x-semio-ui": {
        "label": {
          "en": "Meshes",
          "de": "Netze"
        }
      }
    },
    "materials": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/definitions/SemioMaterial"
      },
      "x-semio-ui": {
        "label": {
          "en": "Materials",
          "de": "Materialien"
        }
      }
    },
    "textures": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/definitions/SemioTexture"
      },
      "x-semio-ui": {
        "label": {
          "en": "Textures",
          "de": "Texturen"
        }
      }
    }
  },
  "required": [
    "schema",
    "meshes",
    "materials",
    "textures"
  ]
}
