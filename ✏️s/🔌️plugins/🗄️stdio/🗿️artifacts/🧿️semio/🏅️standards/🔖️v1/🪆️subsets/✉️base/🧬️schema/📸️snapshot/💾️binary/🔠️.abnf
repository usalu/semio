; ABNF-style descriptive mirror of `stdio.semio`'s real `pack` binary frame (past the
; `semio_format` envelope) -- see the authoritative `📡️.protocol.semio` for the
; conformance-tested version.
document       = format tag schema-len schema-bytes payload
format         = %x01                  ; PACK_BINARY_FORMAT
tag            = OCTET                 ; subset ordinal (0-12)
schema-len     = 1*OCTET               ; LEB128 varint byte count
schema-bytes   = *OCTET                ; UTF-8, schema-len bytes
payload        = *OCTET                ; opaque tail: wrapped subset's own real encode_pack() bytes
