{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/audio/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot"
  ],
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/SemioAudioSnapshot"
    },
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by SemioAudioMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioAudioSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sampleRate"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "format": {
          "$ref": "#/$defs/SemioAudioFormat"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioAudioChannel"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioAudioTag"
          }
        }
      }
    },
    "SemioAudioFormat": {
      "type": "string",
      "enum": [
        "pcm8",
        "pcm16",
        "pcm24",
        "pcm32",
        "float32",
        "float64"
      ]
    },
    "SemioAudioChannel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "SemioAudioTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
