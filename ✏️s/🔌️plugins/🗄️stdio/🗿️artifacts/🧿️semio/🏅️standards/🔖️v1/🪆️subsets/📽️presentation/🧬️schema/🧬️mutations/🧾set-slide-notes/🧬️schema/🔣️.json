{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/mutation/set-slide-notes/schema.json",
  "title": "SetSlideNotes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "notes"
  ],
  "properties": {
    "mutation": {
      "const": "setSlideNotes",
      "description": "Aggregate discriminator spliced in by SemioPresentationMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Slide",
          "de": "Folie"
        },
        "description": {
          "en": "Index of the slide, counted from 0.",
          "de": "Index der Folie, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocBlock"
      },
      "x-semio-ui": {
        "label": {
          "en": "Speaker notes",
          "de": "Notizen"
        }
      }
    }
  },
  "$defs": {
    "DocBlock": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/snapshot.json#/$defs/DocBlock"
    }
  }
}
