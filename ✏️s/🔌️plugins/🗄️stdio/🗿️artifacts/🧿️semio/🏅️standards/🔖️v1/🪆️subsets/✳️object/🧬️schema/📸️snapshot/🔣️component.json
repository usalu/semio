{
  "$id": "https://semio.tech/schema/s.stdio.semio.object/snapshot.json",
  "title": "SemioObjectSnapshot",
  "description": "Ordered, lexeme-preserving typed object graph — mirrors the 🦀️component.rs sibling's real fields.",
  "$defs": {
    "objectId": {
      "type": "object",
      "properties": { "value": { "type": "string" } },
      "required": ["value"]
    },
    "semioValue": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["null", "bool", "int", "float", "str", "bytes", "list", "map", "ref"] },
        "value": { "type": ["boolean", "string"] },
        "lexeme": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/semioValue" } },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/semioObjectEntry" } },
        "id": { "$ref": "#/$defs/objectId" }
      },
      "required": ["kind"]
    },
    "semioObjectEntry": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "$ref": "#/$defs/semioValue" }
      },
      "required": ["key", "value"]
    },
    "semioObjectNode": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/objectId" },
        "value": { "$ref": "#/$defs/semioValue" }
      },
      "required": ["id", "value"]
    }
  },
  "type": "object",
  "properties": {
    "schema": { "type": "string", "x-semio-state": "persistent" },
    "root": { "$ref": "#/$defs/semioValue", "x-semio-state": "persistent" },
    "objects": { "type": "array", "x-semio-state": "persistent", "items": { "$ref": "#/$defs/semioObjectNode" } }
  },
  "required": ["schema", "root", "objects"]
}
