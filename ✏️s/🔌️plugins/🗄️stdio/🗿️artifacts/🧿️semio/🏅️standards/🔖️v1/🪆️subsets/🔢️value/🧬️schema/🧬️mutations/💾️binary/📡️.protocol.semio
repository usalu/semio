dialect protocol
protocol semio.value.mutations
version 1
schema stdio.semio.value.mutations
start body
framing record

# Real `SemioValueMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record set-value tag=1
field payload bytes
record set-map-entry tag=2
field payload bytes
record remove-map-entry tag=3
field payload bytes
record insert-list-item tag=4
field payload bytes
record remove-list-item tag=5
field payload bytes
record set-node tag=6
field payload bytes
record remove-node tag=7
field payload bytes
