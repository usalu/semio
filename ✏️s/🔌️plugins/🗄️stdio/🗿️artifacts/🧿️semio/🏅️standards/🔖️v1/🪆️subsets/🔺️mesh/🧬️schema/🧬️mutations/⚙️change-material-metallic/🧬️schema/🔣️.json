{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/mutation/change-material-metallic/schema.json",
  "title": "ChangeMaterialMetallic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "new_metallic"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Material",
          "de": "Material"
        },
        "description": {
          "en": "Id of the material.",
          "de": "Kennung des Materials."
        },
        "ref": {
          "kind": "material"
        },
        "group": "target",
        "order": 10
      }
    },
    "new_metallic": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "label": {
          "en": "Metallic",
          "de": "Metallizität"
        },
        "description": {
          "en": "PBR metalness, 0 dielectric to 1 metal.",
          "de": "PBR-Metallizität, 0 Dielektrikum bis 1 Metall."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1
      }
    }
  }
}
