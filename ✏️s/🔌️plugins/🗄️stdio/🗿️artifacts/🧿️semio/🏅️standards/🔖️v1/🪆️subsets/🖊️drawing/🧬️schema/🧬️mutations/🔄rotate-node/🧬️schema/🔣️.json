{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/rotate-node/schema.json",
  "title": "RotateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "at",
    "new_rotation"
  ],
  "properties": {
    "at": {
      "$ref": "#/$defs/NodePath",
      "x-semio-ui": {
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "Layer index and child indices of the node, each counted from 0.",
          "de": "Ebenenindex und Kindindizes des Knotens, jeweils ab 0 gezählt."
        },
        "group": "target",
        "order": 10
      }
    },
    "new_rotation": {
      "$ref": "#/$defs/SemioQuaternion",
      "x-semio-ui": {
        "label": {
          "en": "Rotation",
          "de": "Drehung"
        }
      }
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "W",
              "de": "W"
            },
            "description": {
              "en": "Scalar part of the rotation quaternion.",
              "de": "Skalarteil des Rotationsquaternions."
            }
          }
        }
      }
    }
  }
}
