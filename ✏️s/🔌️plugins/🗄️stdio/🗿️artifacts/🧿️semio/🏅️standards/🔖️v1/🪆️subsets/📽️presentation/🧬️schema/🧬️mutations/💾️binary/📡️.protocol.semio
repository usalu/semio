dialect protocol
protocol stdio.semio.presentation.mutations
version 1
schema stdio.semio.presentation
start body
framing record

# Real `SemioPresentationMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value ...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record insert-slide tag=1
field payload bytes
record remove-slide tag=2
field payload bytes
record set-slide-layout tag=3
field payload bytes
record set-slide-notes tag=4
field payload bytes
record insert-shape tag=5
field payload bytes
record remove-shape tag=6
field payload bytes
record set-shape-frame tag=7
field payload bytes
record set-text-box-blocks tag=8
field payload bytes
record insert-master tag=9
field payload bytes
record remove-master tag=10
field payload bytes
record insert-layout tag=11
field payload bytes
record remove-layout tag=12
field payload bytes
record set-layout-master tag=13
field payload bytes
