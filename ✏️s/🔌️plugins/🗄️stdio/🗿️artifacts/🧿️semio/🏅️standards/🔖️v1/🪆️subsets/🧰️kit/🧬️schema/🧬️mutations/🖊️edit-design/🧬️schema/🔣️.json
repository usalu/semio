{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/kit/mutation/edit-design/schema.json",
  "title": "EditDesign",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pieces", "connections"],
  "properties": {
    "id": { "type": "string" },
    "pieces": {
      "type": "array",
      "items": { "$ref": "https://semio.tech/schema/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitPiece" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "https://semio.tech/schema/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitConnection" }
    }
  }
}
