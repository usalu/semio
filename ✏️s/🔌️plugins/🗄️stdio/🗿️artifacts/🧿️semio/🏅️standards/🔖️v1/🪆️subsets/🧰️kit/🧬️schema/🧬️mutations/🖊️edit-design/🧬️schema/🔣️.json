{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/mutation/edit-design/schema.json",
  "title": "EditDesign",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pieces", "connections"],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Design",
          "de": "Entwurf"
        },
        "description": {
          "en": "Id of the design.",
          "de": "Kennung des Entwurfs."
        },
        "ref": {
          "kind": "design"
        },
        "group": "target",
        "order": 10
      }
    },
    "pieces": {
      "type": "array",
      "items": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitPiece" },
      "x-semio-ui": {
        "label": {
          "en": "Pieces",
          "de": "Teile"
        }
      }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitConnection" },
      "x-semio-ui": {
        "label": {
          "en": "Connections",
          "de": "Verbindungen"
        }
      }
    }
  }
}
