{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/mutation/set-icc/schema.json",
  "title": "SetIcc",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setIcc",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    },
    "icc": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "ICC profile",
          "de": "ICC-Profil"
        }
      }
    }
  }
}
