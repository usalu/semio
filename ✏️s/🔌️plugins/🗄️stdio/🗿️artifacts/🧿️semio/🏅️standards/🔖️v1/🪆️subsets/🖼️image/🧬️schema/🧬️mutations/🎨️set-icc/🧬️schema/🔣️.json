{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/image/mutation/set-icc/schema.json",
  "title": "SetIcc",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "icc": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "mutation": {
      "const": "setIcc",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    }
  }
}
