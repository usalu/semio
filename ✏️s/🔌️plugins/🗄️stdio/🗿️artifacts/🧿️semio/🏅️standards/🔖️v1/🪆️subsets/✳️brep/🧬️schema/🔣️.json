{
  "$id": "https://semio.tech/schema/s.stdio.semio.brep/artifact.json",
  "title": "SemioBrepArtifact",
  "description": "Full artifact state, mirrors SemioBrepSnapshot field for field. See ./📸️snapshot/🔣️.json for the entity type definitions.",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "vertices": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "📸️snapshot/🔣️.json#/$defs/brepVertex" } },
    "edges": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "📸️snapshot/🔣️.json#/$defs/brepEdge" } },
    "loops": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "📸️snapshot/🔣️.json#/$defs/brepLoop" } },
    "faces": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "📸️snapshot/🔣️.json#/$defs/brepFace" } },
    "shells": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "📸️snapshot/🔣️.json#/$defs/brepShell" } },
    "solids": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "📸️snapshot/🔣️.json#/$defs/brepSolid" } },
    "coedges": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "📸️snapshot/🔣️.json#/$defs/brepCoedge" } },
    "nextLabel": { "type": "integer", "x-semio-state": "artifact" }
  },
  "required": ["schema", "vertices", "edges", "loops", "faces", "shells", "solids", "coedges", "nextLabel"]
}
