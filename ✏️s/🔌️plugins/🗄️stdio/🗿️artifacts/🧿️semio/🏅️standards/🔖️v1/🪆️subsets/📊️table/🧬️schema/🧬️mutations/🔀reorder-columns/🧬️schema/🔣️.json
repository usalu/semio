{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/table/mutation/reorder-columns/schema.json",
  "title": "ReorderColumns",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "to_index"
  ],
  "properties": {
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Column",
          "de": "Spalte"
        },
        "description": {
          "en": "Name of the column.",
          "de": "Name der Spalte."
        },
        "ref": {
          "kind": "column"
        },
        "group": "target",
        "order": 10
      }
    },
    "to_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Target index",
          "de": "Zielindex"
        },
        "description": {
          "en": "Zero-based position the column moves to.",
          "de": "Nullbasierte Position, an die die Spalte verschoben wird."
        },
        "step": 1
      }
    }
  }
}
