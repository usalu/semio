module Stdio_semio_mesh_mutation;

# Spicy mirror (descriptive, not test-parsed — the real byte-level walker is
# ../📡️.protocol.semio, walked by dsl::walk_protocol) for the REAL binary
# `OpBinary::encode_op`/`decode_op` frame (../../🦀️.rs) — replaces the old
# `print_op().into_bytes()` text-as-binary shortcut.

public type Envelope = unit {
    format: uint8;   # OP_BINARY_FORMAT, currently 1
    tag: uint8;      # SemioMeshMutation variant ordinal — see OP_KEYWORDS in ../../🦀️.rs
    payload: bytes &eod;   # UTF-8 "key=value ..." argument text (never empty — all 17 mesh keywords carry ≥1 argument)
};
