{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/mutation/add-type/schema.json",
  "title": "AddType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Type id",
          "de": "Typ-ID"
        },
        "description": {
          "en": "Id the new type carries.",
          "de": "Kennung, die der neue Typ trägt."
        },
        "group": "value",
        "order": 10
      }
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "description": {
          "en": "Display name of the new type.",
          "de": "Anzeigename des neuen Typs."
        },
        "group": "value",
        "order": 20
      }
    },
    "category": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Category",
          "de": "Kategorie"
        }
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in list",
          "de": "Position in der Liste"
        },
        "description": {
          "en": "Index the entry is inserted at; absent appends it. Undo of a removal names the removed index.",
          "de": "Index, an dem der Eintrag eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Entfernens nennt den entfernten Index."
        }
      }
    }
  }
}
