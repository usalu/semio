dialect grammar
grammar stdio.semio.kit.diff
extension semio
start diff

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM kit wave (W2c). Real one-line `DiffCodec::print_diff`/
# `parse_diff` shape ALREADY emitted by `../../../🧬️schema/🔺️diff/🦀️.rs` (`print_kit_diff`/`parse_kit_diff`) —
# `;`-joined `tag=value` fields, one per touched field of `SemioKitSnapshot`.
diff = field-list?
field-list = field {";" field}*
field = "t" "=" type-list | "d" "=" design-list | "o" "=" child-list | "m" "=" child-list | "p" "=" { "[" "]" | child } | "r" "=" link-list

type-list = "[" {kit-type {"," kit-type}*}? "]"
kit-type = "[" hex "," hex "," hex "]"

design-list = "[" {design {"," design}*}? "]"
design = "[" hex "," hex "," "[" {piece {"," piece}*}? "]" "," "[" {connection {"," connection}*}? "]" "]"
piece = "[" hex "," hex "," transform "]"
connection = "[" hex "," hex "," hex "," hex "," hex "]"
transform = "[" number "," number "," number "," number "," number "," number "," number "," number "," number "," number "]"

child-list = "[" {child {"," child}*}? "]"
child = "[" hex "," reference "]"

link-list = "[" {link {"," link}*}? "]"
link = "[" reference "," pin "," hex "]"
pin = "[" "h" "]" | "[" "c" "," hex "]" | "[" "s" "," hex "," INT "," hex "]"

number = INT | FLOAT | IDENT | "-" "inf"

reference = "[" hex "," hex "," hex "," hex "]"

# 🔢️ Numeric identifiers are inf or nan64_ followed by exactly sixteen hexadecimal IEEE754 bits of NaN class.
