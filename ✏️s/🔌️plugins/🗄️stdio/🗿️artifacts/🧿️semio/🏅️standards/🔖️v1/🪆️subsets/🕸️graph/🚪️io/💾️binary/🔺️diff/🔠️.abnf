; RFC 5234 ABNF mirror (descriptive, not test-walked — the real byte-level walker is
; ../📡️.protocol.semio, walked by dsl::walk_protocol) for the SemioGraphDiff binary frame.
diff-frame  = format presence payload
format      = OCTET                 ; DIFF_BINARY_FORMAT, currently 1
presence    = OCTET                 ; bit0 = nodes, bit1 = edges
payload     = *OCTET                ; present-only: varint count(s) + per-record repeated data
