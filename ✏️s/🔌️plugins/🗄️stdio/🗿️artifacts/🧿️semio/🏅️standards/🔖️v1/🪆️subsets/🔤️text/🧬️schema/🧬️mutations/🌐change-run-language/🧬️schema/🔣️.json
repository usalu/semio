{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/text/mutation/change-run-language/schema.json",
  "title": "ChangeRunLanguage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "new_language"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Run",
          "de": "Textlauf"
        },
        "description": {
          "en": "Index of the run, counted from 0.",
          "de": "Index des Textlaufs, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "new_language": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Language",
          "de": "Sprache"
        },
        "description": {
          "en": "BCP 47 tag; empty means unspecified.",
          "de": "BCP-47-Kennung; leer bedeutet unbestimmt."
        }
      }
    }
  }
}
