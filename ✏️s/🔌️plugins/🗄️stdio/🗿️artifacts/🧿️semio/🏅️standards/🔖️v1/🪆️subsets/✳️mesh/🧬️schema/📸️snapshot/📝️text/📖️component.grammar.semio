dialect grammar stdio.semio.mesh.snapshot
root = document
; preamble line + its trailing newline are stripped before this grammar runs
; (store::semio_format::split_text_preamble). This subset's snapshot is a neutral semio type —
; the DSL text is a whitespace-tolerant ASCII hex dump of SemioMeshSnapshot's real JSON bytes
; (serde_json::to_vec); see ../💾️binary/🥋️component.ksy for the sibling binary envelope.
document = hex_byte (WS hex_byte)*
hex_byte = HEXDIG HEXDIG
HEXDIG = %x30-39 / %x41-46 / %x61-66
WS = *(%x20 / %x09 / %x0D / %x0A)
