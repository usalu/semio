{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/video/inference.json",
  "title": "SemioVideoInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "duration"
  ],
  "properties": {
    "duration": {
      "$ref": "#/$defs/SemioVideoDuration",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "SemioVideoDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationSeconds",
        "streamCount",
        "sampleCount"
      ],
      "properties": {
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "streamCount": {
          "type": "integer",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
