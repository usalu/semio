dialect protocol
protocol stdio.semio.brep.mutations
version 1
schema stdio.semio.brep
start body
framing record

# Real `SemioBrepMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value ...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record create-vertex tag=0
field payload bytes
record delete-vertex tag=1
field payload bytes
record create-edge tag=2
field payload bytes
record delete-edge tag=3
field payload bytes
record create-face tag=4
field payload bytes
record delete-face tag=5
field payload bytes
record create-shell tag=6
field payload bytes
record delete-shell tag=7
field payload bytes
record create-solid tag=8
field payload bytes
record delete-solid tag=9
field payload bytes
record replace-curve tag=10
field payload bytes
record replace-surface tag=11
field payload bytes
record move-vertex tag=12
field payload bytes
