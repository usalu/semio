{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/mutation/create-node/schema.json",
  "title": "CreateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "label",
    "position",
    "width",
    "height",
    "ports",
    "properties"
  ],
  "properties": {
    "id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Id",
              "de": "ID"
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Node id",
          "de": "Knoten-ID"
        },
        "description": {
          "en": "Id the new node carries.",
          "de": "Kennung, die der neue Knoten trägt."
        },
        "group": "target",
        "order": 10
      }
    },
    "kind": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Kind",
          "de": "Art"
        },
        "description": {
          "en": "Kind of the node, as the graph's manifest names it.",
          "de": "Art des Knotens, wie sie das Manifest des Graphen benennt."
        },
        "group": "value",
        "order": 20
      }
    },
    "label": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Label",
          "de": "Beschriftung"
        },
        "description": {
          "en": "Text shown on the node.",
          "de": "Text, der auf dem Knoten angezeigt wird."
        },
        "group": "value",
        "order": 30
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bits"
              ],
              "properties": {
                "bits": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              }
            },
            {
              "type": "number"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "X",
              "de": "X"
            },
            "step": 1,
            "precision": 2,
            "snapSource": {
              "config": "gridFactor"
            }
          }
        },
        "y": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bits"
              ],
              "properties": {
                "bits": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              }
            },
            {
              "type": "number"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Y",
              "de": "Y"
            },
            "step": 1,
            "precision": 2,
            "snapSource": {
              "config": "gridFactor"
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Canvas position of the node's origin.",
          "de": "Position des Knotenursprungs auf der Leinwand."
        },
        "group": "value",
        "order": 40
      }
    },
    "width": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bits"
          ],
          "properties": {
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "number"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Width",
          "de": "Breite"
        },
        "description": {
          "en": "Width of the node on the canvas.",
          "de": "Breite des Knotens auf der Leinwand."
        },
        "step": 1,
        "precision": 2,
        "softMin": 0,
        "snapSource": {
          "config": "gridFactor"
        },
        "group": "value",
        "order": 50
      }
    },
    "height": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bits"
          ],
          "properties": {
            "bits": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "number"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Height",
          "de": "Höhe"
        },
        "description": {
          "en": "Height of the node on the canvas.",
          "de": "Höhe des Knotens auf der Leinwand."
        },
        "step": 1,
        "precision": 2,
        "softMin": 0,
        "snapSource": {
          "config": "gridFactor"
        },
        "group": "value",
        "order": 60
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "category",
          "properties"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "in",
              "out",
              "inOut"
            ],
            "x-semio-ui": {
              "widget": "segmented",
              "label": {
                "en": "Direction",
                "de": "Richtung"
              },
              "options": {
                "in": {
                  "en": "Input",
                  "de": "Eingang"
                },
                "out": {
                  "en": "Output",
                  "de": "Ausgang"
                },
                "inOut": {
                  "en": "Bidirectional",
                  "de": "Bidirektional"
                }
              }
            }
          },
          "category": {
            "type": "string",
            "x-semio-ui": {
              "widget": "text",
              "label": {
                "en": "Category",
                "de": "Kategorie"
              },
              "description": {
                "en": "Category of the port, as the graph's manifest names it.",
                "de": "Kategorie des Anschlusses, wie sie das Manifest des Graphen benennt."
              }
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "$ref": "#/$defs/SemioValue"
                }
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Ports",
          "de": "Anschlüsse"
        },
        "description": {
          "en": "Named connection points of the node with their direction, category and properties.",
          "de": "Benannte Anschlusspunkte des Knotens mit Richtung, Kategorie und Eigenschaften."
        },
        "group": "value",
        "order": 70
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "$ref": "#/$defs/SemioValue"
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Properties",
          "de": "Eigenschaften"
        },
        "description": {
          "en": "Keyed typed entries attached to the node.",
          "de": "Einträge mit Schlüssel und typisiertem Wert, die am Knoten hängen."
        },
        "group": "value",
        "order": 80
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in set",
          "de": "Position in der Menge"
        },
        "description": {
          "en": "Index the node is inserted at; absent appends it. Undo of a delete names the removed index.",
          "de": "Index, an dem der Knoten eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Löschens nennt den entfernten Index."
        }
      }
    }
  },
  "$defs": {
    "SemioValue": {
      "description": "One typed value, internally tagged on `kind` exactly as the Rust `SemioValue` enum: numbers keep their lexeme, bytes are raw octets.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Null",
              "de": "Null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean",
              "x-semio-ui": {
                "widget": "toggle",
                "label": {
                  "en": "Value",
                  "de": "Wert"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Boolean",
              "de": "Wahrheitswert"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "lexeme": {
              "type": "string",
              "x-semio-ui": {
                "widget": "text",
                "label": {
                  "en": "Lexeme",
                  "de": "Lexem"
                },
                "description": {
                  "en": "Exact textual form of a number or string value.",
                  "de": "Genaue Textform eines Zahlen- oder Zeichenkettenwerts."
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Integer",
              "de": "Ganzzahl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "lexeme": {
              "type": "string",
              "x-semio-ui": {
                "widget": "text",
                "label": {
                  "en": "Lexeme",
                  "de": "Lexem"
                },
                "description": {
                  "en": "Exact textual form of a number or string value.",
                  "de": "Genaue Textform eines Zahlen- oder Zeichenkettenwerts."
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Floating point",
              "de": "Gleitkommazahl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "str"
            },
            "value": {
              "type": "string",
              "x-semio-ui": {
                "widget": "text",
                "label": {
                  "en": "Value",
                  "de": "Wert"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Text",
              "de": "Text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "x-semio-ui": {
                "label": {
                  "en": "Bytes",
                  "de": "Bytes"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Bytes",
              "de": "Bytes"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValue"
              },
              "x-semio-ui": {
                "label": {
                  "en": "List items",
                  "de": "Listenelemente"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "List",
              "de": "Liste"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "map"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValueEntry"
              },
              "x-semio-ui": {
                "label": {
                  "en": "Map entries",
                  "de": "Map-Einträge"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Map",
              "de": "Map"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "ref"
            },
            "id": {
              "$ref": "#/$defs/ValueId",
              "x-semio-ui": {
                "label": {
                  "en": "Referenced node",
                  "de": "Referenzierter Knoten"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Reference",
              "de": "Referenz"
            }
          }
        }
      ]
    },
    "SemioValueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SemioValue"
        }
      }
    },
    "SemioValueNode": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ValueId"
        },
        "value": {
          "$ref": "#/$defs/SemioValue"
        }
      },
      "required": [
        "id",
        "value"
      ]
    },
    "ValueId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    }
  }
}
