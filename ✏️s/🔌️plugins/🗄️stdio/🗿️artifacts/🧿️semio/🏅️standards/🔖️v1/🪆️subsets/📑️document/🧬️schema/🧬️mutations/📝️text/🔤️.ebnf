(* ISO-14977-style EBNF for `stdio.semio.document`'s real one-line `OpText` text form —
   descriptive mirror of the authoritative `📖️.grammar.semio` (same production names,
   abridged: full per-keyword argument detail lives there). *)
op = keyword, { space, arg } ;
keyword = 'set-snapshot' | 'insert-block' | 'remove-block' | 'set-block-content'
        | 'set-paragraph-style' | 'set-heading-level' | 'set-list-ordered' | 'set-run-text'
        | 'set-run-style' | 'set-image-block' | 'insert-style' | 'remove-style'
        | 'set-style-name' | 'set-style-based-on' | 'insert-image' | 'remove-image'
        | 'set-image-bytes' ;
arg = ident, '=', value ;
ident = letter, { letter | '-' } ;
value = '[', bracketed content, ']' | hex | integer ;
(* `bracketed content` = arbitrary further-nested bracket/comma-delimited value text — see the
   authoritative grammar for the exhaustive, byte-for-byte per-keyword expansion. *)
