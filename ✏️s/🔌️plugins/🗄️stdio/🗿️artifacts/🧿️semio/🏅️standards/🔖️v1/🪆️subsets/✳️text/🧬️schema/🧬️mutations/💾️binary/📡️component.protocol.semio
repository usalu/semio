dialect protocol
protocol stdio.semio.text.mutations
version 1
schema s.stdio.semio.text
start body
framing record

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM text wave: real binary op frame. `format u8`
# (`OP_BINARY_FORMAT` convention) + `tag u8` (the `SemioTextMutation` variant ordinal,
# `../💾️binary/🦀️component.rs`'s `OP_KEYWORDS`/`variant_ordinal`, 0-6 matching
# `parse_text_mutation`'s keyword match) as two REAL fixed fields, then the variant's own argument
# payload as one opaque trailing `bytes` chain — the same honest boundary the sibling
# `../../🔺️diff/💾️binary/📡️component.protocol.semio` uses.
header fixed 2
field format u8
field tag u8

chain payload bytes
