{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/object/mutation/rotate-object/schema.json",
  "title": "RotateObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rotation"
  ],
  "properties": {
    "rotation": {
      "$ref": "#/$defs/SemioQuaternion"
    }
  },
  "$defs": {
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        }
      }
    }
  }
}
