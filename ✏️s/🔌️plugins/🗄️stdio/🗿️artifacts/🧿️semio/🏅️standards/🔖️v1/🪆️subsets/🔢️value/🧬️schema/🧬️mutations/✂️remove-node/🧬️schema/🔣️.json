  "title": "RemoveNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/ValueId"
    },
    "kind": {
      "const": "removeNode",
      "description": "Aggregate discriminator spliced in by SemioValuePathSegment; absent when the payload stands alone."
