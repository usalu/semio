{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sql",
    "identity",
    "weakenedColumn",
    "weakenedReplacement"
  ],
  "properties": {
    "schema": {
      "const": "semio.drawing.relational-component/v1"
    },
    "sql": {
      "type": "string"
    },
    "identity": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "weakenedColumn": {
      "const": "schema TEXT NOT NULL"
    },
    "weakenedReplacement": {
      "const": "schema TEXT"
    }
  }
}
