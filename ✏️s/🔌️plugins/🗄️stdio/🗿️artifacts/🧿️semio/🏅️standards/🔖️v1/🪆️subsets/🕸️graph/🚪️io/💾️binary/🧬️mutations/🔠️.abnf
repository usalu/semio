; RFC 5234 ABNF mirror (descriptive, not test-walked — the real byte-level walker is
; ../📡️.protocol.semio, walked by dsl::walk_protocol) for the SemioGraphMutation op frame.
op-frame    = format tag payload
format      = %x01
tag         = %x00-0A / %x0D-13    ; canonical one-byte varints for declared record tags
payload     = 1*OCTET               ; selected variant's typed Pack wire value
