module Stdio_semio_video_mutations;
# Spicy mirror (descriptive, not test-parsed — the real byte-level walker is
# ../📡️.protocol.semio, walked by dsl::walk_protocol) for the REAL binary op frame
# (video wave, replacing the old print_op().into_bytes() text-as-binary shortcut). `format` +
# `tag` (the SemioVideoMutation variant ordinal) are real, fully described fixed fields; the
# variant's own argument text is one opaque trailing `payload`.
type Document = unit {
    format: uint8;
    tag: uint8;
    payload: bytes &eod;
};
