dialect grammar
grammar stdio.semio.graph.snapshot
extension semio
start document

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM graph wave. Real grammar for `SemioGraphSnapshot::print_dsl`/
# `parse_dsl` (📸️snapshot/🦀️.rs's `print_graph_snapshot_body`/`parse_graph_snapshot_body`)
# — hand-rolled, mirroring `✳️text`'s own hex/bracket-encoded value convention.
#
# `document` matches the fixture-honesty harness's own reconstructed body shape (mandatory `semio
# s.stdio.semio.graph.dsl v1` preamble stripped and replaced with the bare `envelope_id()` token —
# `artifact-mark` below — before recognition, same convention every other semio subset's own
# grammar uses).
artifact-mark = "s.stdio.semio.graph"
document = artifact-mark schema-line nodes-line edges-line

schema-line = "schema" "=" hex
nodes-line = "nodes" "=" "[" node-list? "]"
edges-line = "edges" "=" "[" edge-list? "]"

node-list = node {"," node}*
node = "[" hex "," hex "," hex "," hex "," hex "," "[" port-list? "]" "," "[" property-list? "]" "]"
port-list = port {"," port}*
port = "[" hex "," port-kind "]"
port-kind = "i" | "o" | "x"
property-list = property {"," property}*
property = hex ":" value

edge-list = edge {"," edge}*
edge = "[" hex "," hex "," hex "," hex "," hex "]"

# `value` is the `✳️value` subset's own `SemioValue` grammar production (tag-prefixed `Z`/`B[...]`/
# `I[...]`/`F[...]`/`S[...]`/`Y[...]`/`L[...]`/`M[...]`/`R[...]`), reused verbatim by
# `enc_semio_value`/`dec_semio_value` — this facet never reinvents the value vocabulary, but every
# grammar file is self-contained (no cross-file production references), so it is RESTATED here, the
# same convention `✳️value`'s own snapshot grammar and `✳️table`'s grammars use.
value = "Z" | "B" "[" bit "]" | "I" "[" hex "]" | "F" "[" hex "]" | "S" "[" hex "]" | "Y" "[" hex "]" | "L" "[" list-item* "]" | "M" "[" map-item* "]" | "R" "[" hex "]"
list-item = value ","?
map-item = hex ":" value ","?
bit = "0" | "1"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO (`📖️grammar/🦀️.rs`'s `default_macros`) — every hex-encoded `schema`/node
# `id`/`kind`/`label`/`x`/`y`/port `name`/property key routes through it. `Symbol::Ref`'s
# production→macro fallback resolves bare `hex` automatically, with real backtracking.
