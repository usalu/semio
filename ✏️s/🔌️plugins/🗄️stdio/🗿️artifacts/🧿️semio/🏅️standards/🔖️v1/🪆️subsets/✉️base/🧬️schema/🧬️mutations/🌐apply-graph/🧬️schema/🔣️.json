{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/base/mutation/apply-graph.json",
  "title": "ApplyGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "$ref": "#/$defs/SemioGraphMutation"
    }
  },
  "$defs": {
    "SemioGraphMutation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CreateNode"
          ],
          "properties": {
            "CreateNode": {
              "$ref": "#/$defs/CreateNode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "DeleteNode"
          ],
          "properties": {
            "DeleteNode": {
              "$ref": "#/$defs/DeleteNode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ChangeNodeKind"
          ],
          "properties": {
            "ChangeNodeKind": {
              "$ref": "#/$defs/ChangeNodeKind"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ChangeNodeLabel"
          ],
          "properties": {
            "ChangeNodeLabel": {
              "$ref": "#/$defs/ChangeNodeLabel"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "MoveNode"
          ],
          "properties": {
            "MoveNode": {
              "$ref": "#/$defs/MoveNode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "AddNodePort"
          ],
          "properties": {
            "AddNodePort": {
              "$ref": "#/$defs/AddNodePort"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "RemoveNodePort"
          ],
          "properties": {
            "RemoveNodePort": {
              "$ref": "#/$defs/RemoveNodePort"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "AddNodeProperty"
          ],
          "properties": {
            "AddNodeProperty": {
              "$ref": "#/$defs/AddNodeProperty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "RemoveNodeProperty"
          ],
          "properties": {
            "RemoveNodeProperty": {
              "$ref": "#/$defs/RemoveNodeProperty"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CreateEdge"
          ],
          "properties": {
            "CreateEdge": {
              "$ref": "#/$defs/CreateEdge"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "DeleteEdge"
          ],
          "properties": {
            "DeleteEdge": {
              "$ref": "#/$defs/DeleteEdge"
            }
          }
        }
      ]
    },
    "CreateNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent",
        "index",
        "node"
      ],
      "properties": {
        "parent": {
          "$ref": "#/$defs/NodePath"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "node": {
          "$ref": "#/$defs/DrawNode"
        }
      }
    },
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "DrawNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "segments"
          ],
          "properties": {
            "kind": {
              "const": "path"
            },
            "segments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PathSegment"
              }
            },
            "style": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value",
            "at"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "style": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transform"
          ],
          "properties": {
            "kind": {
              "const": "group"
            },
            "transform": {
              "$ref": "#/$defs/SemioTransform"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DrawNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "at",
            "width",
            "height",
            "mime",
            "bytes"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "at": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "mime": {
              "type": "string"
            },
            "bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      ]
    },
    "PathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "moveTo"
            },
            "to": {
              "$ref": "#/$defs/SemioPoint2"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "lineTo"
            },
            "to": {
              "$ref": "#/$defs/SemioPoint2"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "c1",
            "c2",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "cubicTo"
            },
            "c1": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "c2": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "to": {
              "$ref": "#/$defs/SemioPoint2"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "c",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "quadTo"
            },
            "c": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "to": {
              "$ref": "#/$defs/SemioPoint2"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rx",
            "ry",
            "xRotation",
            "largeArc",
            "sweep",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "arcTo"
            },
            "rx": {
              "type": "number"
            },
            "ry": {
              "type": "number"
            },
            "xRotation": {
              "type": "number"
            },
            "largeArc": {
              "type": "boolean"
            },
            "sweep": {
              "type": "boolean"
            },
            "to": {
              "$ref": "#/$defs/SemioPoint2"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "close"
            }
          }
        }
      ]
    },
    "SemioPoint2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "SemioTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/SemioPoint3"
        },
        "rotation": {
          "$ref": "#/$defs/SemioQuaternion"
        },
        "scale": {
          "$ref": "#/$defs/SemioPoint3"
        }
      }
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        }
      }
    },
    "DeleteNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/NodePath"
        }
      }
    },
    "ChangeNodeKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "new_kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/GraphNodeId"
        },
        "new_kind": {
          "type": "string"
        }
      }
    },
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "ChangeNodeLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "new_label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/GraphNodeId"
        },
        "new_label": {
          "type": "string"
        }
      }
    },
    "MoveNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "new_origin"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/NodePath"
        },
        "new_origin": {
          "$ref": "#/$defs/SemioPoint2"
        }
      }
    },
    "AddNodePort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "index",
        "port"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/GraphNodeId"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "$ref": "#/$defs/SemioGraphPort"
        }
      }
    },
    "SemioGraphPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SemioGraphPortKind"
        }
      }
    },
    "SemioGraphPortKind": {
      "type": "string",
      "enum": [
        "in",
        "out",
        "inOut"
      ]
    },
    "RemoveNodePort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "index"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/GraphNodeId"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AddNodeProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "index",
        "property"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/GraphNodeId"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "property": {
          "$ref": "#/$defs/SemioValueEntry"
        }
      }
    },
    "SemioValueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SemioValue"
        }
      }
    },
    "SemioValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "lexeme": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "lexeme": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "str"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValue"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "map"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValueEntry"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "ref"
            },
            "id": {
              "$ref": "#/$defs/ValueId"
            }
          }
        }
      ]
    },
    "ValueId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "RemoveNodeProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "index"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/GraphNodeId"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CreateEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/GraphEdgeId"
        },
        "source": {
          "$ref": "#/$defs/GraphNodeId"
        },
        "target": {
          "$ref": "#/$defs/GraphNodeId"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "GraphEdgeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "DeleteEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/GraphEdgeId"
        }
      }
    }
  }
}
