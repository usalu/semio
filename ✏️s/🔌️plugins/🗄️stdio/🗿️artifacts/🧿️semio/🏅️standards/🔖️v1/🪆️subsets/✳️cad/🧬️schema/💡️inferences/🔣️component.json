{
  "$id": "https://semio.tech/schema/s/stdio/semio/cad/inference.json",
  "title": "SemioCadInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["bounds"],
  "properties": {
    "bounds": { "$ref": "#/$defs/SemioCadBounds", "x-semio-state": "inferred" }
  },
  "$defs": {
    "SemioPoint2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "SemioCadBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "entityCount"],
      "properties": {
        "min": { "$ref": "#/$defs/SemioPoint2" },
        "max": { "$ref": "#/$defs/SemioPoint2" },
        "entityCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
