{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/audio/mutation/insert-tag/schema.json",
  "title": "InsertTag",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "tag"
  ],
  "properties": {
    "mutation": {
      "const": "insertTag",
      "description": "Aggregate discriminator spliced in by SemioAudioMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the metadata tags at which it is inserted, counted from 0.",
          "de": "Position unter den Metadaten-Tags, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "tag": {
      "$ref": "#/$defs/SemioAudioTag",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Tag",
          "de": "Tag"
        },
        "description": {
          "en": "Key and value of the metadata tag that is inserted.",
          "de": "Schlüssel und Wert des Metadaten-Tags, das eingefügt wird."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "SemioAudioTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
