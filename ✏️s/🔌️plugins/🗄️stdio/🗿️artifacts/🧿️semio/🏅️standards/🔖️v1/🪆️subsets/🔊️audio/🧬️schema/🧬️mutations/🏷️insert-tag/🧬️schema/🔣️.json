{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/audio/mutation/insert-tag.json",
  "title": "InsertTag",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "tag"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "tag": {
      "$ref": "#/$defs/SemioAudioTag"
    },
    "mutation": {
      "const": "insertTag",
      "description": "Aggregate discriminator spliced in by SemioAudioMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioAudioTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
