{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/mutation/set-shape-frame/schema.json",
  "title": "SetShapeFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "slide_index",
    "shape_index",
    "frame"
  ],
  "properties": {
    "mutation": {
      "const": "setShapeFrame",
      "description": "Aggregate discriminator spliced in by SemioPresentationMutation; absent when the payload stands alone."
    },
    "slide_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Slide",
          "de": "Folie"
        },
        "description": {
          "en": "Index of the slide, counted from 0.",
          "de": "Index der Folie, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "shape_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Shape",
          "de": "Form"
        },
        "description": {
          "en": "Index of the shape on the slide, counted from 0.",
          "de": "Index der Form auf der Folie, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "frame": {
      "$ref": "#/$defs/SlideFrame",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Frame",
          "de": "Rahmen"
        },
        "description": {
          "en": "Position and size of the shape on the slide: x, y, width and height.",
          "de": "Position und Größe der Form auf der Folie: x, y, Breite und Höhe."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "SlideFrame": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/snapshot.json#/definitions/SlideFrame"
    }
  }
}
