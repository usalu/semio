{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/mutation/set-block-content/schema.json",
  "title": "SetBlockContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "block"
  ],
  "properties": {
    "mutation": {
      "const": "setBlockContent",
      "description": "Aggregate discriminator spliced in by SemioDocumentMutation; absent when the payload stands alone."
    },
    "path": {
      "$ref": "#/$defs/DocBlockPath",
      "x-semio-ui": {
        "label": {
          "en": "Block",
          "de": "Block"
        },
        "description": {
          "en": "Path of the block: the steps into nested containers and its index there, counted from 0.",
          "de": "Pfad des Blocks: die Schritte in verschachtelte Container und sein Index dort, ab 0 gezählt."
        },
        "group": "target",
        "order": 10
      }
    },
    "block": {
      "$ref": "#/$defs/DocBlock",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Block",
          "de": "Block"
        },
        "description": {
          "en": "The block that takes the place of the addressed one.",
          "de": "Der Block, der an die Stelle des adressierten tritt."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "DocBlockPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocPathSegment"
          },
          "x-semio-ui": {
            "label": {
              "en": "Block path",
              "de": "Blockpfad"
            },
            "description": {
              "en": "Child indices from the document root to the block.",
              "de": "Kindindizes vom Dokumentstamm bis zum Block."
            }
          }
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DocPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex"
          ],
          "properties": {
            "kind": {
              "const": "quote"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex",
            "item"
          ],
          "properties": {
            "kind": {
              "const": "listItem"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            },
            "item": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex",
            "row",
            "cell"
          ],
          "properties": {
            "kind": {
              "const": "tableCell"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "cell": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "DocBlock": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/snapshot.json#/$defs/DocBlock"
    }
  }
}
