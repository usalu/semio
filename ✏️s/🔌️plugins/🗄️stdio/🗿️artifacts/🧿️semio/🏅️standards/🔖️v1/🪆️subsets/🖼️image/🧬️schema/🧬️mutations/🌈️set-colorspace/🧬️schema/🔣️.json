{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/mutation/set-colorspace/schema.json",
  "title": "SetColorspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "colorspace"
  ],
  "properties": {
    "mutation": {
      "const": "setColorspace",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    },
    "colorspace": {
      "$ref": "#/$defs/SemioColorspace",
      "x-semio-ui": {
        "widget": "select",
        "label": {
          "en": "Color space",
          "de": "Farbraum"
        },
        "options": {
          "rgb": {
            "en": "RGB",
            "de": "RGB"
          },
          "rgba": {
            "en": "RGB with alpha",
            "de": "RGB mit Alpha"
          },
          "grayscale": {
            "en": "Grayscale",
            "de": "Graustufen"
          },
          "grayscaleAlpha": {
            "en": "Grayscale with alpha",
            "de": "Graustufen mit Alpha"
          },
          "indexed": {
            "en": "Indexed color",
            "de": "Indizierte Farben"
          }
        }
      }
    }
  },
  "$defs": {
    "SemioColorspace": {
      "type": "string",
      "enum": [
        "rgb",
        "rgba",
        "grayscale",
        "grayscaleAlpha",
        "indexed"
      ]
    }
  }
}
