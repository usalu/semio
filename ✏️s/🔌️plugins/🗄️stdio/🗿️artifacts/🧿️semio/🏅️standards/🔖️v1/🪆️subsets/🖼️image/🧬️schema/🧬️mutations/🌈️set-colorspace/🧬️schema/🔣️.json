{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/image/mutation/set-colorspace/schema.json",
  "title": "SetColorspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "colorspace"
  ],
  "properties": {
    "colorspace": {
      "$ref": "#/$defs/SemioColorspace"
    },
    "mutation": {
      "const": "setColorspace",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioColorspace": {
      "type": "string",
      "enum": [
        "rgb",
        "rgba",
        "grayscale",
        "grayscaleAlpha",
        "indexed"
      ]
    }
  }
}
