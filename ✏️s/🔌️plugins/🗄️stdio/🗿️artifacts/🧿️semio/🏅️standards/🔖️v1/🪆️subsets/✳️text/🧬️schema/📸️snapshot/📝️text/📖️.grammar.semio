dialect grammar
grammar stdio.semio.text.snapshot
extension semio
start document

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM text wave. Real grammar for `SemioTextSnapshot::print_dsl`/
# `parse_dsl` (📸️snapshot/🦀️.rs's `print_text_snapshot_body`/`parse_text_snapshot_body`)
# — hand-rolled, mirroring `✳️image`'s own hex/bracket-encoded value convention.
#
# `document` matches the fixture-honesty harness's own reconstructed body shape (mandatory `semio
# s.stdio.semio.text.dsl v1` preamble stripped and replaced with the bare `envelope_id()` token —
# `artifact-mark` below — before recognition, same convention every other semio subset's own
# grammar uses).
artifact-mark = "s.stdio.semio.text"
document = artifact-mark schema-line runs-line

schema-line = "schema" "=" hex
runs-line = "runs" "=" "[" run-list? "]"
run-list = run {"," run}*
run = "[" hex "," hex "," "[" mark-list? "]" "]"
mark-list = mark {"," mark}*
mark = "[" mark-kind "," hex "]"
mark-kind = "b" | "i" | "c" | "l"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO (`📖️grammar/🦀️.rs`'s `default_macros`) — every hex-encoded `schema`/run
# `language`/`content`/mark `href` routes through it. `Symbol::Ref`'s production→macro fallback
# resolves bare `hex` automatically, with real backtracking.
