{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/mutation/set-image-block/schema.json",
  "title": "SetImageBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "image_id",
    "alt"
  ],
  "properties": {
    "mutation": {
      "const": "setImageBlock",
      "description": "Aggregate discriminator spliced in by SemioDocumentMutation; absent when the payload stands alone."
    },
    "path": {
      "$ref": "#/$defs/DocBlockPath",
      "x-semio-ui": {
        "label": {
          "en": "Block",
          "de": "Block"
        },
        "description": {
          "en": "Path of the block: the steps into nested containers and its index there, counted from 0.",
          "de": "Pfad des Blocks: die Schritte in verschachtelte Container und sein Index dort, ab 0 gezählt."
        },
        "group": "target",
        "order": 10
      }
    },
    "image_id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Image",
          "de": "Bild"
        },
        "ref": {
          "kind": "image"
        }
      }
    },
    "alt": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Alternative text",
          "de": "Alternativtext"
        }
      }
    },
    "width": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Width",
          "de": "Breite"
        },
        "description": {
          "en": "Display width of the image; cleared, the image keeps its own width.",
          "de": "Anzeigebreite des Bildes; geleert behält das Bild seine eigene Breite."
        },
        "step": 1,
        "precision": 2,
        "softMin": 0,
        "group": "value",
        "order": 40
      }
    },
    "height": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Height",
          "de": "Höhe"
        },
        "description": {
          "en": "Display height of the image; cleared, the image keeps its own height.",
          "de": "Anzeigehöhe des Bildes; geleert behält das Bild seine eigene Höhe."
        },
        "step": 1,
        "precision": 2,
        "softMin": 0,
        "group": "value",
        "order": 50
      }
    }
  },
  "$defs": {
    "DocBlockPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocPathSegment"
          },
          "x-semio-ui": {
            "label": {
              "en": "Block path",
              "de": "Blockpfad"
            },
            "description": {
              "en": "Child indices from the document root to the block.",
              "de": "Kindindizes vom Dokumentstamm bis zum Block."
            }
          }
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DocPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex"
          ],
          "properties": {
            "kind": {
              "const": "quote"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex",
            "item"
          ],
          "properties": {
            "kind": {
              "const": "listItem"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            },
            "item": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex",
            "row",
            "cell"
          ],
          "properties": {
            "kind": {
              "const": "tableCell"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "cell": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
