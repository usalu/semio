{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/cad/mutation/set-block-base-point.json",
  "title": "SetBlockBasePoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "basePoint"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "basePoint": {
      "$ref": "#/$defs/SemioPoint2"
    },
    "mutation": {
      "const": "setBlockBasePoint",
      "description": "Aggregate discriminator spliced in by SemioCadMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioPoint2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
