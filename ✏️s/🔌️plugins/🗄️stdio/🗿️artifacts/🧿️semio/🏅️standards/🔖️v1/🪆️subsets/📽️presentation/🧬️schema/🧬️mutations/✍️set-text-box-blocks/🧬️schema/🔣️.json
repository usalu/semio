{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/presentation/mutation/set-text-box-blocks.json",
  "title": "SetTextBoxBlocks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slide_index",
    "shape_index",
    "blocks"
  ],
  "properties": {
    "slide_index": {
      "type": "integer",
      "minimum": 0
    },
    "shape_index": {
      "type": "integer",
      "minimum": 0
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocBlock"
      }
    },
    "mutation": {
      "const": "setTextBoxBlocks",
      "description": "Aggregate discriminator spliced in by SemioPresentationMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "DocBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "paragraph"
            },
            "styleId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocRun"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "level"
          ],
          "properties": {
            "kind": {
              "const": "heading"
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "styleId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocRun"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "ordered": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocListItem"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "table"
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocTableRow"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "code"
            },
            "language": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "quote"
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocBlock"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "imageId"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "imageId": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "width": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "height": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "pageBreak"
            }
          }
        }
      ]
    },
    "DocRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/RunStyle"
        }
      }
    },
    "RunStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DocListItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocBlock"
          }
        }
      }
    },
    "DocTableRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocTableCell"
          }
        }
      }
    },
    "DocTableCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocBlock"
          }
        }
      }
    }
  }
}
