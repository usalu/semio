(* s.stdio.semio.mesh OpText grammar (protocol::OpText::print_op/parse_op). "keyword arg=value
   ..." (space-separated), one keyword per SemioMeshMutation variant (kebab-case, e.g.
   "add-mesh", "set-primitive-topology"). *)
document = keyword, { " ", arg } ;
arg = name, "=", value ;
keyword = letter, { letter | "-" } ;
name = letter, { letter | "-" } ;
value = { ? any char except " " ? } ;
letter = "a" | "b" | "c" | "d" | "e" | "f" | "g" | "h" | "i" | "j" | "k" | "l" | "m"
       | "n" | "o" | "p" | "q" | "r" | "s" | "t" | "u" | "v" | "w" | "x" | "y" | "z" ;
