module Stdio_semio_mutations;

# `SemioMutation` real binary frame, past the `semio_format` envelope: real `format`/`tag` (1 byte
# each), then one opaque `payload` tail (the wrapped subset's own real `encode_op()` bytes, or the
# wrapped snapshot's own real `encode_pack()` bytes for `setSnapshot`).
type Document = unit {
    format: uint8;
    tag: uint8;
    payload: bytes &eod;
};
