{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/flow/mutation/insert-node.json",
  "title": "InsertNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node"
  ],
  "properties": {
    "node": {
      "$ref": "#/$defs/FlowNode"
    },
    "mutation": {
      "const": "insertNode",
      "description": "Aggregate discriminator spliced in by SemioFlowMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "FlowNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FlowParam"
          }
        },
        "position": {
          "$ref": "#/$defs/SemioPoint2"
        }
      }
    },
    "FlowParam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "SemioPoint2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
