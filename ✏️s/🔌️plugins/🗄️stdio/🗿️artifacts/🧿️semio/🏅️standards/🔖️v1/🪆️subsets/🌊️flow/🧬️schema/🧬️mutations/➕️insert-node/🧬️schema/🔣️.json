{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/flow/mutation/insert-node/schema.json",
  "title": "InsertNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "node"
  ],
  "properties": {
    "mutation": {
      "const": "insertNode",
      "description": "Aggregate discriminator spliced in by SemioFlowMutation; absent when the payload stands alone."
    },
    "node": {
      "$ref": "#/$defs/FlowNode",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "Id, kind, label, position, ports and parameters of the node that is inserted.",
          "de": "Kennung, Art, Beschriftung, Position, Anschlüsse und Parameter des Knotens, der eingefügt wird."
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "FlowNode": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/flow/snapshot.json#/definitions/FlowNode"
    }
  }
}
