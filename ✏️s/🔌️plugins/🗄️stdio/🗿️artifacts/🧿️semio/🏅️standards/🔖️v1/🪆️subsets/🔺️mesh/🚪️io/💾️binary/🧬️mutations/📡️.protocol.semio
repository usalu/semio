dialect protocol
protocol stdio.semio.mesh.mutations
version 1
schema stdio.semio.mesh
start body
framing record

# Real `SemioMeshMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value ...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record create-mesh tag=0
field payload bytes
record delete-mesh tag=1
field payload bytes
record create-primitive tag=2
field payload bytes
record delete-primitive tag=3
field payload bytes
record set-primitive-topology tag=4
field payload bytes
record replace-primitive-geometry tag=5
field payload bytes
record set-primitive-material tag=6
field payload bytes
record create-material tag=7
field payload bytes
record delete-material tag=8
field payload bytes
record change-material-base-color tag=9
field payload bytes
record change-material-metallic tag=10
field payload bytes
record change-material-roughness tag=11
field payload bytes
record create-texture tag=12
field payload bytes
record delete-texture tag=13
field payload bytes
record change-texture-mime tag=14
field payload bytes
record replace-texture-bytes tag=15
field payload bytes
record move-vertex tag=16
field payload bytes
