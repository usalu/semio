{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoveVertex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meshId",
    "newPoint",
    "primitiveId",
    "vertexIndex"
  ],
  "properties": {
    "meshId": {
      "type": "string"
    },
    "primitiveId": {
      "type": "string"
    },
    "vertexIndex": {
      "type": "integer",
      "minimum": 0
    },
    "newPoint": {
      "title": "SemioPoint3",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
