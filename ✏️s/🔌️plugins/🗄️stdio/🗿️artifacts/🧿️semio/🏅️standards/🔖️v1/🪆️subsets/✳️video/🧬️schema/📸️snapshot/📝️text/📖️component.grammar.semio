dialect grammar stdio.semio.video.snapshot
; Envelope line ("schema stdio.semio.video") followed by a hex-encoded UTF-8 JSON document whose
; own structure is normatively described by the sibling 🔣️component.json (SemioVideoSnapshot:
; schema, streams[]{kind,codec,width,height,rate{num,den},samples[]{pts,key,data}}). The hex body
; is opaque to THIS grammar only because JSON is a distinct sibling grammar, not because the
; payload is unspecified.
root = document
document = header NL body
header = "schema" SP "stdio.semio.video"
body = hex-digit-pair *
hex-digit-pair = HEXDIG HEXDIG
