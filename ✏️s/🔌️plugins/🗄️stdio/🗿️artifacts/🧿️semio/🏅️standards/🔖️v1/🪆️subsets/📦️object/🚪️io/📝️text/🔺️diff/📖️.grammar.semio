dialect grammar
grammar stdio.semio.object.diff
extension semio
start diff

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM object wave (W2c). Real one-line `DiffCodec::print_diff`/
# `parse_diff` shape ALREADY emitted by `../../../🧬️schema/🔺️diff/🦀️.rs` (`print_object_diff`/
# `parse_object_diff`) — `;`-joined `tag=value` fields, one per touched field of
# `SemioObjectSnapshot` (`transform`/`brep`/`mesh`/`properties`).
diff = field-list?
field-list = field {";" field}*
field = "t" "=" transform-value | "b" "=" child | "m" "=" child | "p" "=" child
transform-value = "[" number "," number "," number "," number "," number "," number "," number "," number "," number "," number "]"
child = "[" "]" | "[" hex "," reference "]"
number = INT | FLOAT | IDENT | "-" "inf"

reference = "[" hex "," hex "," hex "," hex "]"

# 🔢️ Numeric identifiers are inf or nan64_ followed by exactly sixteen hexadecimal IEEE754 bits of NaN class.
