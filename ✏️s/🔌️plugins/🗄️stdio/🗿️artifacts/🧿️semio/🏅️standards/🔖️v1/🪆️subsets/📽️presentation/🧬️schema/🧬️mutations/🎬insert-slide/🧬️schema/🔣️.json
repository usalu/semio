{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/mutation/insert-slide/schema.json",
  "title": "InsertSlide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "slide"
  ],
  "properties": {
    "mutation": {
      "const": "insertSlide",
      "description": "Aggregate discriminator spliced in by SemioPresentationMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the slides at which it is inserted, counted from 0.",
          "de": "Position unter den Folien, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "slide": {
      "$ref": "#/$defs/Slide",
      "x-semio-ui": {
        "label": {
          "en": "Slide",
          "de": "Folie"
        }
      }
    }
  },
  "$defs": {
    "Slide": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/snapshot.json#/definitions/Slide"
    }
  }
}
