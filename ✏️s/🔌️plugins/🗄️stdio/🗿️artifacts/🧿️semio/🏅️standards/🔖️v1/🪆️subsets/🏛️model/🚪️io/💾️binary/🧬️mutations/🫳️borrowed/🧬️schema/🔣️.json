{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "copyBytes",
    "grants",
    "cancelStops",
    "elements"
  ],
  "properties": {
    "copyBytes": {
      "const": 64
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "cancelStops": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "elements": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    }
  }
}
