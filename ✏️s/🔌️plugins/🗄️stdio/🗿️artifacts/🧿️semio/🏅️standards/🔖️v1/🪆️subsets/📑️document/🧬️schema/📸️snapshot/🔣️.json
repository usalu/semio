{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/snapshot.json",
  "title": "SemioDocumentSnapshot",
  "description": "Complete-per-spec document snapshot: named styles + id-keyed images + the top-level block tree.",
  "type": "object",
  "required": [
    "schema",
    "styles",
    "images",
    "blocks"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "styles": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "basedOn": {
            "type": [
              "string",
              "null"
            ],
            "x-semio-ui": {
              "widget": "reference",
              "role": "target",
              "label": {
                "en": "Based on style",
                "de": "Basiert auf Formatvorlage"
              },
              "ref": {
                "kind": "style"
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Styles",
          "de": "Formatvorlagen"
        }
      }
    },
    "images": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mime",
          "bytes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mime": {
            "type": "string",
            "x-semio-ui": {
              "widget": "text",
              "label": {
                "en": "Media type",
                "de": "Medientyp"
              }
            }
          },
          "bytes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "x-semio-ui": {
              "label": {
                "en": "Bytes",
                "de": "Bytes"
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Images",
          "de": "Bilder"
        }
      }
    },
    "blocks": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/DocBlock"
      },
      "x-semio-ui": {
        "label": {
          "en": "Content blocks",
          "de": "Inhaltsblöcke"
        }
      }
    }
  },
  "$defs": {
    "DocBlock": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "paragraph",
            "heading",
            "list",
            "table",
            "code",
            "quote",
            "image",
            "pageBreak"
          ],
          "x-semio-ui": {
            "options": {
              "paragraph": {
                "en": "Paragraph",
                "de": "Absatz"
              },
              "heading": {
                "en": "Heading",
                "de": "Überschrift"
              },
              "list": {
                "en": "List",
                "de": "Liste"
              },
              "code": {
                "en": "Code block",
                "de": "Codeblock"
              },
              "quote": {
                "en": "Block quote",
                "de": "Zitat"
              },
              "pageBreak": {
                "en": "Page break",
                "de": "Seitenumbruch"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "paragraph"
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocRun"
              }
            },
            "style_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "heading"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocRun"
              }
            },
            "style_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "list"
            },
            "ordered": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "blocks": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/DocBlock"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "table"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cells": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "blocks": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/DocBlock"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "code"
            },
            "language": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "quote"
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocBlock"
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "image"
            },
            "alt": {
              "type": "string"
            },
            "width": {
              "type": [
                "number",
                "null"
              ]
            },
            "height": {
              "type": [
                "number",
                "null"
              ]
            },
            "image_id": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "pageBreak"
            }
          }
        }
      ]
    },
    "DocRun": {
      "type": "object",
      "required": [
        "text",
        "style"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "style": {
          "$ref": "#/$defs/RunStyle"
        }
      }
    },
    "RunStyle": {
      "type": "object",
      "properties": {
        "bold": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Bold",
              "de": "Fett"
            }
          }
        },
        "italic": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Italic",
              "de": "Kursiv"
            }
          }
        },
        "underline": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Underline",
              "de": "Unterstrichen"
            }
          }
        },
        "size": {
          "type": [
            "number",
            "null"
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Font size",
              "de": "Schriftgröße"
            }
          }
        },
        "font": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Font",
              "de": "Schriftart"
            }
          }
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Link target",
              "de": "Linkziel"
            }
          }
        }
      }
    }
  }
}
