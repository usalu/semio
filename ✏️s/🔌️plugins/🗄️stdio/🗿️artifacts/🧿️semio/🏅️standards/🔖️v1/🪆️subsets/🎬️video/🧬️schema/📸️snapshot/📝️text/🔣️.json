{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/video/snapshot/text.json",
  "title": "SemioVideoSnapshotTextEnvelope",
  "description": "Envelope header line + hex(JSON) body; the JSON body's own structure is ../🔣️.json's SemioVideoSnapshot.",
  "type": "object",
  "properties": {
    "header": {
      "const": "schema stdio.semio.video"
    },
    "bodyHex": {
      "type": "string",
      "contentEncoding": "hex",
      "description": "decodes as SemioVideoSnapshot, see ../🔣️.json"
    }
  },
  "required": [
    "header",
    "bodyHex"
  ]
}
