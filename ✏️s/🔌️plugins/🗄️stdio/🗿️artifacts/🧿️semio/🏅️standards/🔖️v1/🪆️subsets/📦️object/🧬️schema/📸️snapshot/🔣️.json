{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/object/snapshot.json",
  "title": "SemioObjectSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transform"
  ],
  "properties": {
    "schema": {
      "const": "stdio.semio.object",
      "x-semio-state": "artifact"
    },
    "transform": {
      "$ref": "https://semio.tech/schema/s/stdio/semio/v1/base/geometry.json",
      "x-semio-state": "artifact"
    },
    "brep": {
      "$ref": "https://semio.tech/schema/s/stdio/semio/v1/base/child.json#/$defs/brep",
      "x-semio-state": "artifact",
      "x-semio-child": {
        "kind": "s.stdio.semio"
      }
    },
    "mesh": {
      "$ref": "https://semio.tech/schema/s/stdio/semio/v1/base/child.json#/$defs/mesh",
      "x-semio-state": "artifact",
      "x-semio-child": {
        "kind": "s.stdio.semio"
      }
    },
    "properties": {
      "$ref": "https://semio.tech/schema/s/stdio/semio/v1/base/child.json#/$defs/value",
      "x-semio-state": "artifact",
      "x-semio-child": {
        "kind": "s.stdio.semio"
      }
    }
  }
}
