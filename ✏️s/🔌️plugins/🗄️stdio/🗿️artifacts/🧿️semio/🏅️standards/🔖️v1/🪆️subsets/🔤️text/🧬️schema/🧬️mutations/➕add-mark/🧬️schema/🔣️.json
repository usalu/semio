{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/text/mutation/add-mark/schema.json",
  "title": "AddMark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_index",
    "index",
    "mark"
  ],
  "properties": {
    "run_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Run",
          "de": "Textlauf"
        },
        "description": {
          "en": "Index of the run, counted from 0.",
          "de": "Index des Textlaufs, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the marks of the run at which it is inserted, counted from 0.",
          "de": "Position unter den Auszeichnungen des Textlaufs, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "mark": {
      "$ref": "#/$defs/SemioTextMark",
      "x-semio-ui": {
        "label": {
          "en": "Mark",
          "de": "Auszeichnung"
        }
      }
    }
  },
  "$defs": {
    "SemioTextMark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SemioTextMarkKind",
          "x-semio-ui": {
            "options": {
              "bold": {
                "en": "Bold",
                "de": "Fett"
              },
              "italic": {
                "en": "Italic",
                "de": "Kursiv"
              },
              "code": {
                "en": "Code",
                "de": "Code"
              },
              "link": {
                "en": "Link",
                "de": "Link"
              }
            }
          }
        },
        "href": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Link target",
              "de": "Linkziel"
            },
            "description": {
              "en": "URL of a link mark.",
              "de": "URL einer Link-Auszeichnung."
            }
          }
        }
      }
    },
    "SemioTextMarkKind": {
      "type": "string",
      "enum": [
        "bold",
        "italic",
        "code",
        "link"
      ]
    }
  }
}
