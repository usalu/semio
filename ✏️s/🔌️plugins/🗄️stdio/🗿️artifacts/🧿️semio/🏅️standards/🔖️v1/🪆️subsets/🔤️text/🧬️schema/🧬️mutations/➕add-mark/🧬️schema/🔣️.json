{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/text/mutation/add-mark/schema.json",
  "title": "AddMark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_index",
    "index",
    "mark"
  ],
  "properties": {
    "run_index": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "mark": {
      "$ref": "#/$defs/SemioTextMark"
    }
  },
  "$defs": {
    "SemioTextMark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SemioTextMarkKind"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "SemioTextMarkKind": {
      "type": "string",
      "enum": [
        "bold",
        "italic",
        "code",
        "link"
      ]
    }
  }
}
