{
  "$id": "https://semio.tech/schema/s.stdio.semio.object/mutations.json",
  "title": "SemioObjectMutation",
  "description": "Named-variant mutation vocabulary — mirrors the 🦀️component.rs sibling's real fields.",
  "$defs": {
    "objectId": { "type": "object", "properties": { "value": { "type": "string" } } },
    "semioObjectPathSegment": {
      "type": "object",
      "properties": { "kind": { "enum": ["key", "index"] }, "key": { "type": "string" }, "index": { "type": "integer" } }
    }
  },
  "type": "object",
  "properties": {
    "mutation": { "enum": ["noMutation", "setSnapshot", "setValue", "setMapEntry", "removeMapEntry", "insertListItem", "removeListItem", "setObject", "removeObject"] },
    "snapshot": { "type": "object" },
    "path": { "type": "array", "items": { "$ref": "#/$defs/semioObjectPathSegment" } },
    "value": {},
    "key": { "type": "string" },
    "index": { "type": "integer" },
    "id": { "$ref": "#/$defs/objectId" }
  },
  "required": ["mutation"]
}
