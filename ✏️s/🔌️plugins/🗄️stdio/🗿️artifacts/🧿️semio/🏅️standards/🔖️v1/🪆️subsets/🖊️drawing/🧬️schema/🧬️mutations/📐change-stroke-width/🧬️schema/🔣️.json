{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/change-stroke-width/schema.json",
  "title": "ChangeStrokeWidth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "style_name"
  ],
  "properties": {
    "style_name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Style",
          "de": "Stil"
        },
        "description": {
          "en": "Name of the drawing style.",
          "de": "Name des Zeichenstils."
        },
        "ref": {
          "kind": "style"
        },
        "group": "target",
        "order": 10
      }
    },
    "new_width": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Stroke width",
          "de": "Konturstärke"
        },
        "step": 0.25,
        "precision": 2,
        "softMin": 0
      }
    }
  }
}
