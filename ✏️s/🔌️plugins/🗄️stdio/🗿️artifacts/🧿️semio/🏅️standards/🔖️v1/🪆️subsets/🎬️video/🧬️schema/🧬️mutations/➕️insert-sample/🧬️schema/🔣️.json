{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/video/mutation/insert-sample/schema.json",
  "title": "InsertSample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "streamIndex",
    "index",
    "sample"
  ],
  "properties": {
    "mutation": {
      "const": "insertSample",
      "description": "Aggregate discriminator spliced in by SemioVideoMutation; absent when the payload stands alone."
    },
    "streamIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Stream",
          "de": "Datenstrom"
        },
        "description": {
          "en": "Index of the stream, counted from 0.",
          "de": "Index des Datenstroms, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the samples of the stream at which it is inserted, counted from 0.",
          "de": "Position unter den Samples des Datenstroms, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "sample": {
      "$ref": "#/$defs/SemioVideoSample",
      "x-semio-ui": {
        "label": {
          "en": "Sample",
          "de": "Sample"
        }
      }
    }
  },
  "$defs": {
    "SemioVideoSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pts"
      ],
      "properties": {
        "pts": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Presentation time stamp",
              "de": "Präsentationszeitstempel (PTS)"
            }
          }
        },
        "key": {
          "type": "boolean"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
