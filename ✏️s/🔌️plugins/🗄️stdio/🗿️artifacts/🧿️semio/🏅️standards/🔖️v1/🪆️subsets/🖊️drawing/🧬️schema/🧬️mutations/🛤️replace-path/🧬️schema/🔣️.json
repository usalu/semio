{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/replace-path/schema.json",
  "title": "ReplacePath",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "at",
    "new_segments"
  ],
  "properties": {
    "at": {
      "$ref": "#/$defs/NodePath"
    },
    "new_segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PathSegment"
      }
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "PathSegment": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/snapshot.json#/$defs/PathSegment"
    }
  }
}
