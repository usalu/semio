{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/mutation/set-paragraph-style/schema.json",
  "title": "SetParagraphStyle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path"
  ],
  "properties": {
    "mutation": {
      "const": "setParagraphStyle",
      "description": "Aggregate discriminator spliced in by SemioDocumentMutation; absent when the payload stands alone."
    },
    "path": {
      "$ref": "#/$defs/DocBlockPath"
    },
    "style_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Paragraph style",
          "de": "Absatzformat"
        },
        "ref": {
          "kind": "style"
        }
      }
    }
  },
  "$defs": {
    "DocBlockPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocPathSegment"
          },
          "x-semio-ui": {
            "label": {
              "en": "Block path",
              "de": "Blockpfad"
            },
            "description": {
              "en": "Child indices from the document root to the block.",
              "de": "Kindindizes vom Dokumentstamm bis zum Block."
            }
          }
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DocPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex"
          ],
          "properties": {
            "kind": {
              "const": "quote"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex",
            "item"
          ],
          "properties": {
            "kind": {
              "const": "listItem"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            },
            "item": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex",
            "row",
            "cell"
          ],
          "properties": {
            "kind": {
              "const": "tableCell"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "cell": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
