{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/cad/mutation/add-block-entity/schema.json",
  "title": "AddBlockEntity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "blockName",
    "entity"
  ],
  "properties": {
    "mutation": {
      "const": "addBlockEntity",
      "description": "Aggregate discriminator spliced in by SemioCadMutation; absent when the payload stands alone."
    },
    "blockName": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Block",
          "de": "Block"
        },
        "description": {
          "en": "Name of the block definition.",
          "de": "Name der Blockdefinition."
        },
        "ref": {
          "kind": "block"
        },
        "group": "target",
        "order": 10
      }
    },
    "entity": {
      "$ref": "#/$defs/CadEntityRecord",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Entity",
          "de": "Entität"
        },
        "description": {
          "en": "Handle, layer and geometry of the entity that is added.",
          "de": "Referenz (Handle), Layer und Geometrie der Entität, die hinzugefügt wird."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "CadEntityRecord": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/cad/snapshot.json#/$defs/CadEntityRecord"
    }
  }
}
