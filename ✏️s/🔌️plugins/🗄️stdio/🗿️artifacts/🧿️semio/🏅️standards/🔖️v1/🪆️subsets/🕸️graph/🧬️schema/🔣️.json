{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/graph/artifact.json",
  "title": "SemioGraphArtifact",
  "description": "Full artifact state, mirrors SemioGraphSnapshot field for field.",
  "type": "object",
  "required": [
    "schema",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "nodes": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object"
      }
    },
    "edges": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object"
      }
    }
  }
}
