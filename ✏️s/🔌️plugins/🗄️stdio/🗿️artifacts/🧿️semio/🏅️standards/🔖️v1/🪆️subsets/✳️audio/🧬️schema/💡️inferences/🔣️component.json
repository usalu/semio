{
  "$id": "https://semio.tech/schema/s/stdio/semio/audio/inference.json",
  "title": "SemioAudioInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["duration"],
  "properties": {
    "duration": { "$ref": "#/$defs/SemioAudioDuration", "x-semio-state": "inferred" }
  },
  "$defs": {
    "SemioAudioDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "sampleCount", "channelCount"],
      "properties": {
        "durationSeconds": { "type": "number", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "channelCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
