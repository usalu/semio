dialect protocol
protocol s.stdio.semio.graph.mutations
version 1
schema s.stdio.semio.graph
start body
framing record

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM graph wave: real binary op frame. `format u8`
# (`OP_BINARY_FORMAT` convention) + `tag u8` (the `SemioGraphMutation` variant ordinal,
# `../💾️binary/🦀️.rs`'s `OP_KEYWORDS`/`variant_ordinal`, 0-10 matching
# `parse_graph_mutation`'s keyword match) as two REAL fixed fields, then the variant's own argument
# payload as one opaque trailing `bytes` chain — the same honest boundary the sibling
# `../../🔺️diff/💾️binary/📡️.protocol.semio` uses.
header fixed 2
field format u8
field tag u8

chain payload bytes
