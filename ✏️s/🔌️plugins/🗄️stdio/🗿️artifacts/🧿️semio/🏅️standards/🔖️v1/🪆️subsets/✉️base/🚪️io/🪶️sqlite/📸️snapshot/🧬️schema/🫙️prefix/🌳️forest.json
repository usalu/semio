{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema", "key", "text", "integerLexeme", "floatLexeme", "octets", "nodeId", "kinds", "stops", "interiorPhases"],
  "properties": {
    "contract": {"const": "stdio.semio.original-value-forest/v1"},
    "schema": {"const": "stdio.semio.value"},
    "key": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "integerLexeme": {"type": "string"},
    "floatLexeme": {"type": "string"},
    "octets": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "nodeId": {"type": "string"},
    "kinds": {"const": ["map", "null", "bool", "int", "float", "str", "bytes", "list", "ref"]},
    "stops": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "interiorPhases": {"const": ["text", "octets"]}
  }
}
