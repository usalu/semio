{
  "$id": "https://semio.tech/schema/s.stdio.semio.document/diff.json",
  "title": "SemioDocumentDiff",
  "description": "Handcrafted sparse diff: name-keyed styles/images triples + an index-keyed recursive blocks triple.",
  "type": "object",
  "properties": {
    "styles": { "$ref": "#/$defs/namedTriple" },
    "images": { "$ref": "#/$defs/namedTriple" },
    "blocks": { "$ref": "#/$defs/indexedTriple" }
  },
  "$defs": {
    "indexedTriple": { "type": "object", "properties": { "removed": { "type": "array", "items": { "type": "integer" } }, "modified": { "type": "array" }, "added": { "type": "array" } } },
    "namedTriple": { "type": "object", "properties": { "removed": { "type": "array", "items": { "type": "string" } }, "modified": { "type": "array" }, "added": { "type": "array" } } }
  }
}
