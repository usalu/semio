; ABNF-style descriptive mirror of `stdio.semio.document`'s real binary diff frame -- see the
; authoritative `📡️.protocol.semio` for the conformance-tested version.
document       = format presence payload
format         = %x01                  ; DIFF_BINARY_FORMAT
presence       = OCTET                 ; bit0=styles bit1=images bit2=blocks
payload        = *OCTET                ; 0-3 varint-length-prefixed collection blobs,
                                        ; see component.rs's DiffCodec::encode_diff
