{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/mutation/set-value/schema.json",
  "title": "SetValue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setValue",
      "description": "Aggregate discriminator spliced in by SemioValueMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemioValuePathSegment"
      },
      "x-semio-ui": {
        "label": {
          "en": "Path",
          "de": "Pfad"
        },
        "description": {
          "en": "Map keys and list indices leading from the root to the value that is set; empty for the root.",
          "de": "Zuordnungsschlüssel und Listenindizes von der Wurzel bis zum Wert, der gesetzt wird; leer für die Wurzel."
        },
        "group": "target",
        "order": 10
      }
    },
    "value": {
      "$ref": "#/$defs/SemioValue",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Value",
          "de": "Wert"
        },
        "description": {
          "en": "The typed value written: null, boolean, integer, number, text, bytes, list, map or reference.",
          "de": "Der geschriebene typisierte Wert: null, Wahrheitswert, Ganzzahl, Zahl, Text, Bytes, Liste, Zuordnung oder Referenz."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "SemioValuePathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "key": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "SemioValue": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/snapshot.json#/$defs/SemioValue"
    }
  }
}
