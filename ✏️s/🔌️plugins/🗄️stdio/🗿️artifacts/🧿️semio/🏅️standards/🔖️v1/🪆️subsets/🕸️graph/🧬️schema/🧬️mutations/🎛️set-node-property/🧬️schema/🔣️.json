{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/mutation/set-node-property/schema.json",
  "title": "SetNodeProperty",
  "description": "The `set-node-property` mutation record: one existing keyed property of a node takes an absolute typed value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "key",
    "value"
  ],
  "properties": {
    "node_id": {
      "$ref": "#/$defs/GraphNodeId",
      "x-semio-ui": {
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "Node whose property is set.",
          "de": "Knoten, dessen Eigenschaft gesetzt wird."
        },
        "group": "target",
        "order": 10
      }
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Property",
          "de": "Eigenschaft"
        },
        "description": {
          "en": "Key of the node property that takes the value.",
          "de": "Schlüssel der Knoteneigenschaft, die den Wert erhält."
        },
        "group": "target",
        "order": 20
      }
    },
    "value": {
      "$ref": "#/$defs/SemioValue",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Value",
          "de": "Wert"
        },
        "description": {
          "en": "Typed value the property takes.",
          "de": "Typisierter Wert, den die Eigenschaft erhält."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Node ID",
              "de": "Knoten-ID"
            },
            "ref": {
              "kind": "node",
              "domain": "graph",
              "granularity": "node"
            }
          }
        }
      }
    },
    "SemioValueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SemioValue"
        }
      }
    },
    "SemioValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "lexeme": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "lexeme": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "str"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValue"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "map"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValueEntry"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "ref"
            },
            "id": {
              "$ref": "#/$defs/ValueId"
            }
          }
        }
      ]
    },
    "ValueId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    }
  }
}
