{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangeRepresentationPin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "pin"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "pin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Checkpoint"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Snapshot"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
