module Semio_value_mutations;

# REAL binary op frame (upgraded from the old print_op-bytes-verbatim shortcut): `format u8` +
# `tag u8` (SemioValueMutation variant ordinal, 0-8) fixed header, then the variant's own
# recursive path/key/value/id payload as one opaque `payload` tail (real LEB128-varint Rust-side
# encoding, see ../📝️text/📖️component.grammar.semio for the equivalent text shape).
type Document = unit {
    format: uint8;
    tag: uint8;
    payload: bytes &eod;
};
