{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/mesh/mutation/set-primitive-topology/schema.json",
  "title": "SetPrimitiveTopology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh_id",
    "primitive_id",
    "topology"
  ],
  "properties": {
    "mesh_id": {
      "type": "string"
    },
    "primitive_id": {
      "type": "string"
    },
    "topology": {
      "$ref": "#/$defs/SemioTopology"
    }
  },
  "$defs": {
    "SemioTopology": {
      "type": "string",
      "enum": [
        "points",
        "lines",
        "lineStrip",
        "triangles",
        "triangleStrip",
        "triangleFan"
      ]
    }
  }
}
