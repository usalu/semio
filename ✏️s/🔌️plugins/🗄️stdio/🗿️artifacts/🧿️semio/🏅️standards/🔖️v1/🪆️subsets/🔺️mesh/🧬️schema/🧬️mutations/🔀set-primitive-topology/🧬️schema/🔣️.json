{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/mutation/set-primitive-topology/schema.json",
  "title": "SetPrimitiveTopology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh_id",
    "primitive_id",
    "topology"
  ],
  "properties": {
    "mesh_id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Mesh",
          "de": "Netz"
        },
        "description": {
          "en": "Id of the mesh.",
          "de": "Kennung des Netzes."
        },
        "ref": {
          "kind": "mesh"
        },
        "group": "target",
        "order": 10
      }
    },
    "primitive_id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Primitive",
          "de": "Primitiv"
        },
        "description": {
          "en": "Id of the primitive within the mesh.",
          "de": "Kennung des Primitivs innerhalb des Netzes."
        },
        "ref": {
          "kind": "primitive"
        },
        "group": "target",
        "order": 20
      }
    },
    "topology": {
      "$ref": "#/$defs/SemioTopology",
      "x-semio-ui": {
        "widget": "select",
        "label": {
          "en": "Primitive topology",
          "de": "Primitivtopologie"
        },
        "options": {
          "points": {
            "en": "Points",
            "de": "Punkte"
          },
          "lines": {
            "en": "Lines",
            "de": "Linien"
          },
          "lineStrip": {
            "en": "Line strip",
            "de": "Linienzug"
          },
          "triangles": {
            "en": "Triangles",
            "de": "Dreiecke"
          },
          "triangleStrip": {
            "en": "Triangle strip",
            "de": "Dreiecksstreifen"
          },
          "triangleFan": {
            "en": "Triangle fan",
            "de": "Dreiecksfächer"
          }
        }
      }
    }
  },
  "$defs": {
    "SemioTopology": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/snapshot.json#/definitions/SemioTopology"
    }
  }
}
