dialect grammar
grammar stdio.semio.presentation.diff
extension semio
start document

# ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION presentation wave: real one-line
# `DiffCodec::print_diff`/`parse_diff` shape ALREADY emitted by `🦀️.rs`'s
# `print_presentation_diff`/`parse_presentation_diff` (this facet's text codec was already real,
# hand-rolled hex/bracket, pre-wave — only the BINARY frame needed upgrading, plus the leaf `Vec
# <DocBlock>` codec, which was a real policy violation this wave fixed by switching to document's
# own real `enc_block`/`dec_block`, see `🦀️.rs`'s module doc comment). Token-per-nonempty-
# collection, space-separated. `masters`/`layouts` are NAME-keyed (`NamedTripleDiff`, keyed by
# `SlideMaster::id`/`SlideLayout::id`); `slides` is INDEX-keyed (`IndexedTripleDiff`) even though
# each `Slide` also carries its own `id`. `shapes` (nested in every master/layout/slide), `blocks`
# (`DocBlocksDiff`, whole-VALUE diff — `document::DocBlock` is not owned here, see the module doc
# comment), and table `rows`/`cells` are all index-keyed too.
document = masters-line? layouts-line? slides-line?

masters-line = "masters" "=" masters-triple
masters-triple = "[" named-removed-list? "]" ";" "[" master-modified-list? "]" ";" "[" master-added-list? "]"
master-modified-list = master-modified {"," master-modified}*
master-modified = hex ":" master-diff
master-added-list = master {"," master}*

layouts-line = "layouts" "=" layouts-triple
layouts-triple = "[" named-removed-list? "]" ";" "[" layout-modified-list? "]" ";" "[" layout-added-list? "]"
layout-modified-list = layout-modified {"," layout-modified}*
layout-modified = hex ":" layout-diff
layout-added-list = layout {"," layout}*

named-removed-list = hex {"," hex}*

slides-line = "slides" "=" slides-triple
slides-triple = "[" indexed-removed-list? "]" ";" "[" slide-modified-list? "]" ";" "[" slide-added-list? "]"
slide-modified-list = slide-modified {"," slide-modified}*
slide-modified = INT ":" slide-diff
slide-added-list = slide-added {"," slide-added}*
slide-added = INT ":" slide

indexed-removed-list = INT {"," INT}*

# Per-entity diff grammars — field order matches `🦀️.rs`'s `enc_master_diff`/
# `enc_layout_diff`/`enc_slide_diff`/`enc_shape_diff`/`enc_frame_diff`/`enc_image_diff` exactly (the
# authoritative source). Every `Option<T>` field prints via the shared `[0]` (unchanged) /
# `[1,<value>]` (changed) tri-state tag; `slide-diff`'s `layout_id` is DOUBLY optional
# (`Option<Option<String>>`) and nests a second tri-state tag inside the first.
master-diff = "[" option-shapes-diff "]"
layout-diff = "[" option-hex "," option-shapes-diff "]"
slide-diff = "[" option-option-hex "," option-shapes-diff "," option-blocks-diff "]"

option-shapes-diff = "[" "0" "]" | "[" "1" "," shapes-diff "]"
shapes-diff = "[" indexed-removed-list? "]" ";" "[" shape-modified-list? "]" ";" "[" shape-added-list? "]"
shape-modified-list = shape-modified {"," shape-modified}*
shape-modified = INT ":" shape-diff
shape-added-list = shape-added {"," shape-added}*
shape-added = INT ":" shape

# `enc_shape_diff` — `X[...]`/`P[...]`/`T[...]`/`H[...]` mirror each `SlideShape` variant's own
# fields (tri-state-wrapped); `R[shape]` is the whole-shape `Replace` fallback (a shape-KIND change,
# reachable only through a real structural `between()`, never through any single mutation variant).
shape-diff = "X" "[" option-frame-diff "," option-blocks-diff "]" | "P" "[" option-frame-diff "," option-image-diff "]" | "T" "[" option-frame-diff "," option-rows-diff "]" | "H" "[" option-frame-diff "," option-placeholder-kind "]" | "R" "[" shape "]"

option-frame-diff = "[" "0" "]" | "[" "1" "," frame-diff "]"
frame-diff = "[" option-point2 "," option-num "," option-num "]"
option-point2 = "[" "0" "]" | "[" "1" "," point2 "]"

option-image-diff = "[" "0" "]" | "[" "1" "," image-diff "]"
image-diff = "[" option-hex "," option-hex "," option-hex "]"

option-placeholder-kind = "[" "0" "]" | "[" "1" "," placeholder-kind "]"

# `DocBlocksDiff = IndexedTripleDiff<DocBlock, DocBlock>` — `document::DocBlock` treated as its own
# diff (`D = T`, see `🦀️.rs`'s module doc comment): `modified` entries carry the WHOLE
# replacement `block`, not a `DocBlockDiff` structure (this subset never sub-diffs a type it does
# not own the internals of).
option-blocks-diff = "[" "0" "]" | "[" "1" "," blocks-diff "]"
blocks-diff = "[" indexed-removed-list? "]" ";" "[" block-modified-list? "]" ";" "[" block-added-list? "]"
block-modified-list = block-modified {"," block-modified}*
block-modified = INT ":" block
block-added-list = block-added {"," block-added}*
block-added = INT ":" block

option-rows-diff = "[" "0" "]" | "[" "1" "," rows-diff "]"
rows-diff = "[" indexed-removed-list? "]" ";" "[" row-modified-list? "]" ";" "[" row-added-list? "]"
row-modified-list = row-modified {"," row-modified}*
row-modified = INT ":" row-diff
row-added-list = row-added {"," row-added}*
row-added = INT ":" row
row-diff = "[" option-cells-diff "]"

option-cells-diff = "[" "0" "]" | "[" "1" "," cells-diff "]"
cells-diff = "[" indexed-removed-list? "]" ";" "[" cell-modified-list? "]" ";" "[" cell-added-list? "]"
cell-modified-list = cell-modified {"," cell-modified}*
cell-modified = INT ":" cell-diff
cell-added-list = cell-added {"," cell-added}*
cell-added = INT ":" cell
cell-diff = "[" option-blocks-diff "]"

# `master`/`layout`/`🎞️slide`/`shape`/`frame`/`point2`/`image`/`placeholder-kind`/`row`/`cell`/`block`
# — the same full-VALUE codecs `../../📸️snapshot/📝️text/📖️.grammar.semio` declares
# (restated here so this leaf grammar is self-contained, matching the repo's existing per-facet
# convention). `block`'s own `doc-row`/`doc-cell` sub-productions are copied from document's real
# grammar verbatim (renamed to avoid colliding with this file's own `row`/`cell`, which encode
# `SlideTableRow`/`SlideTableCell`).
master = "[" hex "," "[" shape-items? "]" "]"
layout = "[" hex "," hex "," "[" shape-items? "]" "]"
slide = "[" hex "," option-hex "," "[" shape-items? "]" "," "[" block-items? "]" "]"
shape-items = shape {"," shape}*
shape = "X" "[" frame "," "[" block-items? "]" "]" | "P" "[" frame "," image "]" | "T" "[" frame "," "[" row-items? "]" "]" | "H" "[" frame "," placeholder-kind "]"
frame = "[" point2 "," INT "," INT "]"
point2 = "[" INT "," INT "]"
image = "[" hex "," hex "," hex "]"
placeholder-kind = "T" | "S" | "B" | "F" | "N" | "D" | "O" "[" hex "]"
row-items = row {"," row}*
row = "[" cell-items? "]"
cell-items = cell {"," cell}*
cell = "[" block-items? "]"
block-items = block {"," block}*
block = "P" "[" option-hex "," "[" run-items? "]" "]" | "H" "[" INT "," option-hex "," "[" run-items? "]" "]" | "L" "[" bool "," "[" list-item-items? "]" "]" | "T" "[" "[" doc-row-items? "]" "]" | "C" "[" option-hex "," hex "]" | "Q" "[" "[" block-items? "]" "]" | "I" "[" hex "," hex "," option-num "," option-num "]" | "B" "[" "]"
run-items = run {"," run}*
run = "[" hex "," run-style "]"
run-style = "[" bool "," bool "," bool "," option-num "," option-hex "," option-hex "," option-hex "]"
list-item-items = list-item {"," list-item}*
list-item = "[" "[" block-items? "]" "]"
doc-row-items = doc-row {"," doc-row}*
doc-row = "[" "[" doc-cell-items? "]" "]"
doc-cell-items = doc-cell {"," doc-cell}*
doc-cell = "[" "[" block-items? "]" "]"

option-hex = "[" "0" "]" | "[" "1" "," hex "]"
option-option-hex = "[" "0" "]" | "[" "1" "," option-hex "]"
# `enc_f64` prints `f64::to_bits()` (a `u64` bit pattern) as plain decimal digits, NOT a float
# literal — every numeric leaf is a bare `INT` token.
option-num = "[" "0" "]" | "[" "1" "," INT "]"
bool = "0" | "1"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO — see the sibling `../../📸️snapshot/📝️text/📖️.grammar.semio`'s own `hex` doc
# comment for why a hand-rolled `{INT|IDENT}*` production would be wrong here.
