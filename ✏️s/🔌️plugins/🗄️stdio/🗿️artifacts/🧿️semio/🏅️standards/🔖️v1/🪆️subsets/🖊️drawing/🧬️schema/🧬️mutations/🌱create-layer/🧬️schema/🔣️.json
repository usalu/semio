{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/create-layer/schema.json",
  "title": "CreateLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "layer"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the layers at which it is inserted, counted from 0.",
          "de": "Position unter den Ebenen, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "layer": {
      "$ref": "#/$defs/DrawLayer",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "description": {
          "en": "Id, name, visibility and nodes of the layer that is created.",
          "de": "Kennung, Name, Sichtbarkeit und Knoten der Ebene, die erstellt wird."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "DrawLayer": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/snapshot.json#/$defs/DrawLayer"
    }
  }
}
