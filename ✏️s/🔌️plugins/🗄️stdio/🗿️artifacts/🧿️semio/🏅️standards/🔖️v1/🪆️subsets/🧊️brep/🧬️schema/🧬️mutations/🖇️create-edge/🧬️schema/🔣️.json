{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/mutation/create-edge/schema.json",
  "title": "CreateEdge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "start_vertex",
    "end_vertex",
    "curve",
    "tol"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Edge id",
          "de": "Kanten-ID"
        },
        "description": {
          "en": "Id the new edge carries.",
          "de": "Kennung, die die neue Kante trägt."
        },
        "group": "value",
        "order": 10
      }
    },
    "start_vertex": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Start vertex",
          "de": "Startpunkt"
        },
        "ref": {
          "kind": "vertex"
        }
      }
    },
    "end_vertex": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "End vertex",
          "de": "Endpunkt"
        },
        "ref": {
          "kind": "vertex"
        }
      }
    },
    "curve": {
      "$ref": "#/$defs/BrepCurve",
      "x-semio-ui": {
        "label": {
          "en": "Curve",
          "de": "Kurve"
        }
      }
    },
    "tol": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Tolerance",
          "de": "Toleranz"
        },
        "description": {
          "en": "Geometric tolerance of the edge: the distance within which it coincides with the geometry it bounds.",
          "de": "Geometrische Toleranz der Kante: der Abstand, innerhalb dessen sie mit der begrenzten Geometrie zusammenfällt."
        },
        "step": 1e-09,
        "precision": 9,
        "softMin": 1e-09,
        "softMax": 0.1,
        "scale": "log",
        "snaps": [
          1e-09,
          1e-08,
          1e-07,
          1e-06,
          1e-05,
          0.0001,
          0.001,
          0.01,
          0.1
        ],
        "group": "value",
        "order": 50
      }
    }
  },
  "$defs": {
    "BrepCurve": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepCurve"
    }
  }
}
