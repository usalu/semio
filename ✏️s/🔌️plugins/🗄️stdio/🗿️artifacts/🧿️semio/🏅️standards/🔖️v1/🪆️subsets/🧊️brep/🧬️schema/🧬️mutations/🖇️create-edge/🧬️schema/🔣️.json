{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/mutation/create-edge/schema.json",
  "title": "CreateEdge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "start_vertex",
    "end_vertex",
    "curve",
    "tol"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "start_vertex": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Start vertex",
          "de": "Startpunkt"
        },
        "ref": {
          "kind": "vertex"
        }
      }
    },
    "end_vertex": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "End vertex",
          "de": "Endpunkt"
        },
        "ref": {
          "kind": "vertex"
        }
      }
    },
    "curve": {
      "$ref": "#/$defs/BrepCurve",
      "x-semio-ui": {
        "label": {
          "en": "Curve",
          "de": "Kurve"
        }
      }
    },
    "tol": {
      "type": "number"
    }
  },
  "$defs": {
    "BrepCurve": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepCurve"
    }
  }
}
