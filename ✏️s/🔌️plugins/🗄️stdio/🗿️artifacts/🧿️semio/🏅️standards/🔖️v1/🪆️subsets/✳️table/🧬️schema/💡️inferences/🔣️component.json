        "rowCount": { "type": "integer", "minimum": 0 },
        "nullColumnCount": { "type": "integer", "minimum": 0 },
        "boolColumnCount": { "type": "integer", "minimum": 0 },
        "intColumnCount": { "type": "integer", "minimum": 0 },
        "floatColumnCount": { "type": "integer", "minimum": 0 },
        "strColumnCount": { "type": "integer", "minimum": 0 },
        "bytesColumnCount": { "type": "integer", "minimum": 0 }
