{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/graph/mutation/add-node-property/schema.json",
  "title": "AddNodeProperty",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "index",
    "property"
  ],
  "properties": {
    "node_id": {
      "$ref": "#/$defs/GraphNodeId"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "property": {
      "$ref": "#/$defs/SemioValueEntry"
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "SemioValueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SemioValue"
        }
      }
    },
    "SemioValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "lexeme": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "lexeme": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "str"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValue"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "map"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValueEntry"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "ref"
            },
            "id": {
              "$ref": "#/$defs/ValueId"
            }
          }
        }
      ]
    },
    "ValueId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    }
  }
}
