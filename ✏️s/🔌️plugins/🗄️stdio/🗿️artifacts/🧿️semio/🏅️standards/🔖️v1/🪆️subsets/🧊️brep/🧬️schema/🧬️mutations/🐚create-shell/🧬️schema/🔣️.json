{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/mutation/create-shell/schema.json",
  "title": "CreateShell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "faces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BrepShellFace"
      }
    }
  },
  "$defs": {
    "BrepShellFace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face",
        "orientation"
      ],
      "properties": {
        "face": {
          "type": "string"
        },
        "orientation": {
          "type": "boolean"
        }
      }
    }
  }
}
