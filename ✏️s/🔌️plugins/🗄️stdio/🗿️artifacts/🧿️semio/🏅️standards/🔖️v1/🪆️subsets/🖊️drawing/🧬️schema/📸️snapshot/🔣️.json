{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/snapshot.json",
  "title": "SemioDrawingSnapshot",
  "description": "Mirrors the real Rust 📸️snapshot/🦀️.rs. Codec: hex-encoded JSON body, semio_format-enveloped text, options-aware ArtifactPack encode/decode.",
  "type": "object",
  "required": [
    "schema",
    "canvas"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "canvas": {
      "$ref": "#/$defs/DrawCanvas",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Canvas",
          "de": "Zeichenfläche"
        }
      }
    },
    "styles": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/DrawStyle"
      },
      "x-semio-ui": {
        "label": {
          "en": "Styles",
          "de": "Stile"
        }
      },
      "default": []
    },
    "layers": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/DrawLayer"
      },
      "x-semio-ui": {
        "label": {
          "en": "Layers",
          "de": "Layer"
        }
      },
      "default": []
    }
  },
  "$defs": {
    "SemioPoint2": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "Rgba": {
      "type": "object",
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        },
        "a": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Alpha",
              "de": "Alpha"
            },
            "description": {
              "en": "Opacity, 0 transparent to 1 opaque.",
              "de": "Deckkraft, 0 transparent bis 1 deckend."
            }
          }
        }
      }
    },
    "Point3": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "Quaternion": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "W",
              "de": "W"
            },
            "description": {
              "en": "Scalar part of the rotation quaternion.",
              "de": "Skalarteil des Rotationsquaternions."
            }
          }
        }
      }
    },
    "Transform": {
      "type": "object",
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/Point3",
          "x-semio-ui": {
            "label": {
              "en": "Translation",
              "de": "Verschiebung"
            }
          }
        },
        "rotation": {
          "$ref": "#/$defs/Quaternion"
        },
        "scale": {
          "$ref": "#/$defs/Point3"
        }
      }
    },
    "PathSegment": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "moveTo"
            },
            "to": {}
          },
          "required": [
            "kind",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "lineTo"
            },
            "to": {}
          },
          "required": [
            "kind",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "cubicTo"
            },
            "c1": {},
            "c2": {},
            "to": {}
          },
          "required": [
            "kind",
            "c1",
            "c2",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "quadTo"
            },
            "c": {},
            "to": {}
          },
          "required": [
            "kind",
            "c",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "arcTo"
            },
            "rx": {},
            "ry": {},
            "xRotation": {},
            "largeArc": {},
            "sweep": {},
            "to": {}
          },
          "required": [
            "kind",
            "rx",
            "ry",
            "xRotation",
            "largeArc",
            "sweep",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "close"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ],
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "moveTo",
            "lineTo",
            "cubicTo",
            "quadTo",
            "arcTo",
            "close"
          ],
          "x-semio-ui": {
            "options": {
              "moveTo": {
                "en": "Move to",
                "de": "Bewegen zu"
              },
              "lineTo": {
                "en": "Line to",
                "de": "Linie zu"
              },
              "cubicTo": {
                "en": "Cubic Bézier to",
                "de": "Kubische Bézierkurve zu"
              },
              "quadTo": {
                "en": "Quadratic Bézier to",
                "de": "Quadratische Bézierkurve zu"
              },
              "arcTo": {
                "en": "Arc to",
                "de": "Bogen zu"
              },
              "close": {
                "en": "Close path",
                "de": "Pfad schließen"
              }
            }
          }
        },
        "to": {
          "$ref": "#/$defs/SemioPoint2"
        },
        "c1": {
          "$ref": "#/$defs/SemioPoint2",
          "x-semio-ui": {
            "label": {
              "en": "First control point",
              "de": "Erster Kontrollpunkt"
            }
          }
        },
        "c2": {
          "$ref": "#/$defs/SemioPoint2",
          "x-semio-ui": {
            "label": {
              "en": "Second control point",
              "de": "Zweiter Kontrollpunkt"
            }
          }
        },
        "c": {
          "$ref": "#/$defs/SemioPoint2",
          "x-semio-ui": {
            "label": {
              "en": "Control point",
              "de": "Kontrollpunkt"
            }
          }
        },
        "rx": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Radius X",
              "de": "Radius X"
            }
          }
        },
        "ry": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Radius Y",
              "de": "Radius Y"
            }
          }
        },
        "xRotation": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "X-axis rotation",
              "de": "Drehung der X-Achse"
            },
            "unit": "deg"
          }
        },
        "largeArc": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Large arc",
              "de": "Großer Bogen"
            },
            "description": {
              "en": "Takes the arc spanning more than 180° (SVG large-arc-flag).",
              "de": "Wählt den Bogen über 180° (SVG large-arc-flag)."
            }
          }
        },
        "sweep": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Positive sweep",
              "de": "Positive Bogenrichtung"
            },
            "description": {
              "en": "Draws the arc in the positive-angle direction (SVG sweep-flag).",
              "de": "Zeichnet den Bogen in positiver Winkelrichtung (SVG sweep-flag)."
            }
          }
        }
      }
    },
    "DrawNode": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "path"
            },
            "segments": {},
            "style": {}
          },
          "required": [
            "kind",
            "segments"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {},
            "at": {},
            "style": {}
          },
          "required": [
            "kind",
            "value",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "image"
            },
            "at": {},
            "width": {},
            "height": {},
            "mime": {},
            "bytes": {}
          },
          "required": [
            "kind",
            "at",
            "width",
            "height",
            "mime",
            "bytes"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "group"
            },
            "transform": {},
            "children": {}
          },
          "required": [
            "kind",
            "transform"
          ],
          "additionalProperties": false
        }
      ],
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "path",
            "text",
            "group",
            "image"
          ],
          "x-semio-ui": {
            "options": {
              "group": {
                "en": "Group",
                "de": "Gruppe"
              }
            }
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathSegment"
          },
          "x-semio-ui": {
            "label": {
              "en": "Path segments",
              "de": "Pfadsegmente"
            }
          }
        },
        "style": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/SemioPoint2"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DrawNode"
          },
          "x-semio-ui": {
            "label": {
              "en": "Child nodes",
              "de": "Untergeordnete Knoten"
            }
          }
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "mime": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Media type",
              "de": "Medientyp"
            }
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Image data",
              "de": "Bilddaten"
            }
          }
        }
      }
    },
    "DrawStyle": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "fill": {
          "$ref": "#/$defs/Rgba",
          "x-semio-ui": {
            "label": {
              "en": "Fill color",
              "de": "Füllfarbe"
            }
          }
        },
        "stroke": {
          "$ref": "#/$defs/Rgba",
          "x-semio-ui": {
            "label": {
              "en": "Stroke color",
              "de": "Konturfarbe"
            }
          }
        },
        "strokeWidth": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Stroke width",
              "de": "Konturstärke"
            }
          }
        },
        "opacity": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "DrawLayer": {
      "type": "object",
      "required": [
        "id",
        "name",
        "visible",
        "root"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "root": {
          "$ref": "#/$defs/DrawNode",
          "x-semio-ui": {
            "label": {
              "en": "Root node",
              "de": "Wurzelknoten"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "DrawCanvas": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "background": {
          "$ref": "#/$defs/Rgba",
          "x-semio-ui": {
            "label": {
              "en": "Background color",
              "de": "Hintergrundfarbe"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
