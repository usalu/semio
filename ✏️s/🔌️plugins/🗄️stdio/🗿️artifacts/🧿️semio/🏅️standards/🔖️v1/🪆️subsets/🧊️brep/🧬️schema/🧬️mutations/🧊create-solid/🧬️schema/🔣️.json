{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/mutation/create-solid.json",
  "title": "CreateSolid",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "shells"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "shells": {
      "type": "array",
      "items": {
        "title": "BrepSolidShell",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "isVoid",
          "shell"
        ],
        "properties": {
          "shell": {
            "type": "string"
          },
          "isVoid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
