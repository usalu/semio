{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/mutation/create-solid/schema.json",
  "title": "CreateSolid",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "shells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BrepSolidShell"
      }
    }
  },
  "$defs": {
    "BrepSolidShell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell",
        "isVoid"
      ],
      "properties": {
        "shell": {
          "type": "string"
        },
        "isVoid": {
          "type": "boolean"
        }
      }
    }
  }
}
