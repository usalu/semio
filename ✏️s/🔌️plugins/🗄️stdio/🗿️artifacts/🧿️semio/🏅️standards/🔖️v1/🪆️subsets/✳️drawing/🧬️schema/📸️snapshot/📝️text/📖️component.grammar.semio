dialect grammar stdio.semio.drawing.snapshot.text
; 📖️ real shape: preamble line + hex-encoded JSON(SemioDrawingSnapshot) body (see 🔣️component.json
; for the full field structure this hex payload decodes to)
root = document
document = preamble NL hex_body
preamble = "semio stdio.semio.drawing.dsl v1"
hex_body = *HEXDIG
