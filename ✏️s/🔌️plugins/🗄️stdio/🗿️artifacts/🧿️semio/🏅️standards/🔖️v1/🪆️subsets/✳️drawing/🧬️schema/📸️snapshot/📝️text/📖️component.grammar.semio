dialect grammar
grammar semio.drawing.snapshot
extension semio
start document

# ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION drawing wave (following the
# workflow/brep waves' proven template). Real grammar for
# `SemioDrawingSnapshot::print_dsl`/`parse_dsl` (📸️snapshot/🦀️component.rs's
# `print_drawing_snapshot_body`/`parse_drawing_snapshot_body`) — hand-rolled (`PathSegment`/
# `DrawNode` are data-carrying tagged enums, `DrawNode` additionally RECURSIVE via
# `Group.children`; a derive-path `RecordSpec` cannot express the `M[...]`/`G[...]`-tagged
# recursive text shape). Same hex/bracket-encoded value convention as this subset's own
# `🔺️diff`/`🧬️mutations` facet grammars.
#
# `document` matches the fixture-honesty harness's own reconstructed body shape (mandatory `semio
# stdio.semio.drawing.dsl v1` preamble stripped and replaced with the bare `envelope_id()` token —
# `artifact-mark` below — before recognition, same convention `json.snapshot`'s own grammar uses).
artifact-mark = "stdio.semio.drawing"
document = artifact-mark schema-line canvas-line styles-line layers-line

schema-line = "schema" "=" hex
canvas-line = "canvas" "=" canvas
styles-line = "styles" "=" "[" style-items? "]"
style-items = style {"," style}*
layers-line = "layers" "=" "[" layer-items? "]"
layer-items = layer {"," layer}*

canvas = "[" number "," number "," option-rgba "]"
style = "[" hex "," option-rgba "," option-rgba "," option-number "," option-number "]"
layer = "[" hex "," hex "," bool "," node "]"

# `DrawNode`: `P[segments,style]` (Path) / `T[value,at,style]` (Text) /
# `G[transform,children]` (Group, `children` genuinely RECURSIVE) /
# `I[at,width,height,mime,bytes]` (Image, `bytes` hex-encoded) — single-letter tag prefix, same
# convention brep's own `enc_curve`/`enc_surface` established.
node = "P" "[" segment-list "," option-hex "]" | "T" "[" hex "," point2 "," option-hex "]" | "G" "[" transform "," node-list "]" | "I" "[" point2 "," number "," number "," hex "," hex "]"
node-list = "[" node-items? "]"
node-items = node {"," node}*

# `PathSegment`: `M[to]` (MoveTo) / `L[to]` (LineTo) / `C[c1,c2,to]` (CubicTo) / `Q[c,to]`
# (QuadTo) / `A[rx,ry,xRotation,largeArc,sweep,to]` (ArcTo) / `Z` (Close, no payload).
segment = "M" "[" point2 "]" | "L" "[" point2 "]" | "C" "[" point2 "," point2 "," point2 "]" | "Q" "[" point2 "," point2 "]" | "A" "[" number "," number "," number "," bool "," bool "," point2 "]" | "Z"
segment-list = "[" segment-items? "]"
segment-items = segment {"," segment}*

transform = "[" point3 "," quaternion "," point3 "]"
point2 = "[" number "," number "]"
point3 = "[" number "," number "," number "]"
quaternion = "[" number "," number "," number "," number "]"
rgba = "[" number "," number "," number "," number "]"
bool = "0" | "1"

# `SemioPoint2.x`/etc and every `f64`/`f32` field print via plain Rust `{v}` Display — the shared
# lexer's `INT`/`FLOAT` scanners already capture a leading `-` when digit-adjacent.
number = INT | FLOAT

option-rgba = "[" "0" "]" | "[" "1" "," rgba "]"
option-number = "[" "0" "]" | "[" "1" "," number "]"
option-hex = "[" "0" "]" | "[" "1" "," hex "]"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO (`📖️grammar/🦀️component.rs`'s `default_macros`) — every `id`/`name`/`schema`/`mime`/
# `value` leaf string is `enc_str` (lowercase-hex UTF-8 bytes). A hand-rolled `{INT|IDENT}*`
# production would be wrong here (see the sibling `🔺️diff`/`🧬️mutations` grammars' own `hex` doc
# comment for the two independent reasons why) — `Symbol::Ref`'s production→macro fallback
# resolves bare `hex` automatically, with real backtracking.
