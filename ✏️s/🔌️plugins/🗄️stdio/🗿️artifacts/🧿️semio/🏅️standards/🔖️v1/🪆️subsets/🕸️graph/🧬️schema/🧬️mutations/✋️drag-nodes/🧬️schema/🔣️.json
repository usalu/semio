{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/mutation/drag-nodes/schema.json",
  "title": "DragNodes",
  "description": "The `drag-nodes` mutation record: a set of graph nodes moved by one relative canvas offset.",
  "x-semio-inverse-rows": { "perTarget": { "targets": 1 } },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets",
    "dx",
    "dy"
  ],
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GraphNodeId"
      },
      "minItems": 1,
      "uniqueItems": true,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Nodes",
          "de": "Knoten"
        },
        "description": {
          "en": "Nodes to drag; ones the graph lacks are skipped.",
          "de": "Zu ziehende Knoten; im Graphen fehlende werden übersprungen."
        },
        "ref": {
          "kind": "node",
          "domain": "graph",
          "granularity": "node"
        },
        "group": "target",
        "order": 10
      }
    },
    "dx": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Offset X",
          "de": "Versatz X"
        },
        "description": {
          "en": "Horizontal canvas offset every node moves by.",
          "de": "Horizontaler Leinwandversatz, um den jeder Knoten verschoben wird."
        },
        "step": 1,
        "precision": 2,
        "snapSource": {
          "config": "gridFactor"
        },
        "group": "offset",
        "order": 20
      }
    },
    "dy": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Offset Y",
          "de": "Versatz Y"
        },
        "description": {
          "en": "Vertical canvas offset every node moves by.",
          "de": "Vertikaler Leinwandversatz, um den jeder Knoten verschoben wird."
        },
        "step": 1,
        "precision": 2,
        "snapSource": {
          "config": "gridFactor"
        },
        "group": "offset",
        "order": 30
      }
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    }
  }
}
