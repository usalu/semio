dialect grammar
grammar semio.mesh.mutations
extension semio
start op

# DKM mesh-vocabulary wave: real one-line `OpText::print_op`/`parse_op` shape emitted by
# `🧬️mutations/🦀️.rs` (`print_semio_mesh_mutation`/`parse_semio_mesh_mutation`) —
# "keyword arg=value ..." (space-separated; space is lexer trivia at this dialect level). Every
# keyword/field-name token below is copied verbatim from the real `format!(...)` call sites in
# that file's `print_semio_mesh_mutation`, not invented. Replaces the prior 16-verb
# `Add*`/`Remove*`/`Set*` alternation with the new 17-verb vocabulary derived from this subset's
# real snapshot fields, checked against SMO's taxonomy+derivation-rules docs:
# create/delete-{mesh,primitive,material,texture}, set-primitive-{topology,material},
# replace-primitive-geometry, change-material-{base-color,metallic,roughness},
# change-texture-mime, replace-texture-bytes, move-vertex.
op = create-mesh | delete-mesh | create-primitive | delete-primitive | set-primitive-topology | replace-primitive-geometry | set-primitive-material | create-material | delete-material | change-material-base-color | change-material-metallic | change-material-roughness | create-texture | delete-texture | change-texture-mime | replace-texture-bytes | move-vertex

create-mesh = "create-mesh" "mesh" "=" mesh
delete-mesh = "delete-mesh" "id" "=" hex
create-primitive = "create-primitive" "mesh-id" "=" hex "primitive" "=" primitive
delete-primitive = "delete-primitive" "mesh-id" "=" hex "primitive-id" "=" hex
set-primitive-topology = "set-primitive-topology" "mesh-id" "=" hex "primitive-id" "=" hex "topology" "=" topology
replace-primitive-geometry = "replace-primitive-geometry" "mesh-id" "=" hex "primitive-id" "=" hex "positions" "=" "[" point3-list? "]" "normals" "=" "[" point3-list? "]" "uvs" "=" "[" uv-list? "]" "colors" "=" "[" rgba-list? "]" "indices" "=" "[" index-list? "]"
set-primitive-material = "set-primitive-material" "mesh-id" "=" hex "primitive-id" "=" hex "material-id" "=" option-hex
create-material = "create-material" "material" "=" material
delete-material = "delete-material" "id" "=" hex
change-material-base-color = "change-material-base-color" "id" "=" hex "new-base-color" "=" rgba
change-material-metallic = "change-material-metallic" "id" "=" hex "new-metallic" "=" number
change-material-roughness = "change-material-roughness" "id" "=" hex "new-roughness" "=" number
create-texture = "create-texture" "texture" "=" texture
delete-texture = "delete-texture" "id" "=" hex
change-texture-mime = "change-texture-mime" "id" "=" hex "new-mime" "=" hex
replace-texture-bytes = "replace-texture-bytes" "id" "=" hex "new-bytes" "=" hex
move-vertex = "move-vertex" "mesh-id" "=" hex "primitive-id" "=" hex "vertex-index" "=" INT "new-point" "=" point3

# `enc_mesh`/`enc_primitive`/`enc_material`/`enc_texture` — the same full-VALUE codecs
# `📸️snapshot/🦀️.rs`'s own text DSL grammar declares (restated here so this leaf grammar
# is self-contained, matching the repo's existing per-facet convention). No `snapshot-lit`
# production remains — `set-snapshot` is deleted with no replacement (whole-document replace goes
# through `ArtifactStore::reset`, outside history, per the locked decision).
mesh-list = mesh {"," mesh}*
mesh = "[" hex "," "[" primitive-list? "]" "]"
primitive-list = primitive {"," primitive}*
primitive = "[" hex "," topology "," "[" point3-list? "]" "," "[" point3-list? "]" "," "[" uv-list? "]" "," "[" rgba-list? "]" "," "[" index-list? "]" "," option-hex "]"
material-list = material {"," material}*
material = "[" hex "," rgba "," number "," number "]"
texture-list = texture {"," texture}*
texture = "[" hex "," hex "," hex "]"

point3-list = point3 {"," point3}*
point3 = "[" number "," number "," number "]"
uv-list = uv {"," uv}*
uv = "[" number "," number "]"
rgba-list = rgba {"," rgba}*
rgba = "[" number "," number "," number "," number "]"
index-list = INT {"," INT}*
topology = "P" | "L" | "S" | "T" | "X" | "F"
option-hex = "[" "0" "]" | "[" "1" "," hex "]"
number = INT | FLOAT

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO — a run of lowercase hex digits (`enc_str`/`hex_encode`'s own alphabet), incl. the
# empty string. `Symbol::Ref` already falls back from "no production of this name" to "macro of
# this name", so referencing `hex` with no matching production routes here automatically. Using a
# hand-rolled `{INT|IDENT}*` production instead would be wrong: it never backtracks and would
# silently swallow the next literal keyword token (e.g. `id=<hex> new-mime=<hex>` — the literal
# `new-mime` tokenizes as a plain `IDENT`, exactly like a stray hex letter run would).
