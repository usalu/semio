dialect protocol
protocol s.stdio.semio.table.snapshot
version 1
schema s.stdio.semio.table
start body
framing record

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM table wave: real binary pack frame. `format u8` (real, fixed)
# then `schema_len`/`schema_bytes` (real, varint-length-prefixed UTF-8 — matches `write_str_lp`'s
# own wire exactly, imported from ✳️value's diff module) are genuinely, fully described. Past that,
# `columns` and `rows` (each a HOMOGENEOUS but variable-length repeated record: per-column
# varint-length-prefixed name + kind tag byte; per-row varint cell count + per-cell recursive
# SemioValue binary) are modeled as one opaque trailing `payload` chain — the
# `protocol-array-of-records` gap every sibling subset's own protocol description uses at this same
# boundary. The real Rust `encode_table_snapshot_binary`/`decode_table_snapshot_binary`
# (`../../🦀️.rs`) stays genuinely, fully structured (varint counts, per-field
# length-prefixes, real recursive `enc_semio_value_bin`/`dec_semio_value_bin`) — round-trip tested
# independently by this facet's own tests, only the protocol DESCRIPTION stops at this boundary.
header fixed 1
field format u8

segment schema_len varint
segment schema_bytes Array(u8, Field(schema_len))

chain payload bytes
