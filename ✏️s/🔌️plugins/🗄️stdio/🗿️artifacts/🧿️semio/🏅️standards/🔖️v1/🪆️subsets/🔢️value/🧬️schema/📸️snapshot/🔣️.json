{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/value/snapshot.json",
  "title": "SemioValueSnapshot",
  "description": "Ordered, lexeme-preserving typed value graph — mirrors the 🦀️.rs sibling's real fields.",
  "$defs": {
    "SemioValue": {
      "type": "value",
      "properties": {
        "kind": {
          "enum": [
            "null",
            "bool",
            "int",
            "float",
            "str",
            "bytes",
            "list",
            "map",
            "ref"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "lexeme": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioValue"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioValueEntry"
          }
        },
        "id": {
          "$ref": "#/$defs/ValueId"
        }
      },
      "required": [
        "kind"
      ]
    },
    "SemioValueEntry": {
      "type": "value",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SemioValue"
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "SemioValueNode": {
      "type": "value",
      "properties": {
        "id": {
          "$ref": "#/$defs/ValueId"
        },
        "value": {
          "$ref": "#/$defs/SemioValue"
        }
      },
      "required": [
        "id",
        "value"
      ]
    },
    "ValueId": {
      "type": "value",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    }
  },
  "type": "value",
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "root": {
      "$ref": "#/$defs/SemioValue",
      "x-semio-state": "artifact"
    },
    "nodes": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/SemioValueNode"
      }
    }
  },
  "required": [
    "schema",
    "root",
    "nodes"
  ]
}
