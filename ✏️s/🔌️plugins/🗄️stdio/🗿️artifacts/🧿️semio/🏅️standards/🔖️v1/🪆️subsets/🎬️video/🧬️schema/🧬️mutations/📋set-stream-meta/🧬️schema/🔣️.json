{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/video/mutation/set-stream-meta/schema.json",
  "title": "SetStreamMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "kind",
    "codec",
    "width",
    "height",
    "rate"
  ],
  "properties": {
    "mutation": {
      "const": "setStreamMeta",
      "description": "Aggregate discriminator spliced in by SemioVideoMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Stream",
          "de": "Datenstrom"
        },
        "description": {
          "en": "Index of the stream, counted from 0.",
          "de": "Index des Datenstroms, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "kind": {
      "$ref": "#/$defs/SemioVideoStreamKind",
      "x-semio-ui": {
        "options": {
          "video": {
            "en": "Video",
            "de": "Video"
          },
          "audio": {
            "en": "Audio",
            "de": "Audio"
          },
          "subtitle": {
            "en": "Subtitles",
            "de": "Untertitel"
          }
        }
      }
    },
    "codec": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Codec",
          "de": "Codec"
        }
      }
    },
    "width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Width",
          "de": "Breite"
        },
        "description": {
          "en": "Frame width of the stream.",
          "de": "Bildbreite des Datenstroms."
        },
        "unit": "px",
        "step": 1,
        "precision": 0,
        "softMax": 7680,
        "snaps": [
          640,
          1280,
          1920,
          2560,
          3840
        ],
        "group": "value",
        "order": 40
      }
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Height",
          "de": "Höhe"
        },
        "description": {
          "en": "Frame height of the stream.",
          "de": "Bildhöhe des Datenstroms."
        },
        "unit": "px",
        "step": 1,
        "precision": 0,
        "softMax": 4320,
        "snaps": [
          360,
          480,
          720,
          1080,
          1440,
          2160
        ],
        "group": "value",
        "order": 50
      }
    },
    "rate": {
      "$ref": "#/$defs/SemioRational",
      "x-semio-ui": {
        "label": {
          "en": "Frame or sample rate",
          "de": "Bild- bzw. Abtastrate"
        },
        "description": {
          "en": "Frames (video) or samples (audio) per second as an exact fraction.",
          "de": "Bilder (Video) bzw. Abtastwerte (Audio) pro Sekunde als exakter Bruch."
        }
      }
    }
  },
  "$defs": {
    "SemioVideoStreamKind": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "subtitle"
      ]
    },
    "SemioRational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Numerator",
              "de": "Zähler"
            }
          }
        },
        "den": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Denominator",
              "de": "Nenner"
            }
          }
        }
      }
    }
  }
}
