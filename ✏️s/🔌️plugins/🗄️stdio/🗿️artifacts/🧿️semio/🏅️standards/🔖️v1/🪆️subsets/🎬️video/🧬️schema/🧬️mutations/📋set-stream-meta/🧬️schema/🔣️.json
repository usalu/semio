{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/video/mutation/set-stream-meta/schema.json",
  "title": "SetStreamMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "kind",
    "codec",
    "width",
    "height",
    "rate"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "$ref": "#/$defs/SemioVideoStreamKind"
    },
    "codec": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "rate": {
      "$ref": "#/$defs/SemioRational"
    },
    "mutation": {
      "const": "setStreamMeta",
      "description": "Aggregate discriminator spliced in by SemioVideoMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioVideoStreamKind": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "subtitle"
      ]
    },
    "SemioRational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer"
        },
        "den": {
          "type": "integer"
        }
      }
    }
  }
}
