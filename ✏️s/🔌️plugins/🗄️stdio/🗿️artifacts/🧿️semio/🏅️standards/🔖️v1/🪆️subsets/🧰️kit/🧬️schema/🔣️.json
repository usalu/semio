{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/artifact.json",
  "title": "SemioKitArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "types", "designs", "objects", "models", "representations"],
  "properties": {
    "schema": { "const": "stdio.semio.kit", "x-semio-state": "artifact" },
    "types": {
      "type": "array",
      "items": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitType" },
      "x-semio-state": "artifact"
    },
    "designs": {
      "type": "array",
      "items": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitDesign" },
      "x-semio-state": "artifact"
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/base/child.json#/$defs/object" },
      "x-semio-state": "artifact",
      "x-semio-child": "s.stdio.semio"
    },
    "models": {
      "type": "array",
      "items": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/base/child.json#/$defs/model" },
      "x-semio-state": "artifact",
      "x-semio-child": "s.stdio.semio"
    },
    "properties": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/base/child.json#/$defs/value",
      "x-semio-state": "artifact",
      "x-semio-child": "s.stdio.semio"
    },
    "representations": {
      "type": "array",
      "items": { "$ref": "https://json.schemas.assets.semio-tech.com/os/store/link.json" },
      "x-semio-state": "artifact",
      "x-semio-link": "representation"
    }
  }
}
