{
  "$id": "https://semio.tech/schema/s.stdio.semio.workflow/mutations.json",
  "title": "SemioWorkflowMutation",
  "description": "🧬️ Real facet mirror of 🦀️component.rs — discriminated union on the `mutation` tag.",
  "type": "object",
  "definitions": {
    "SemioPoint2": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "PortRef": { "type": "object", "properties": { "node": { "type": "string" }, "port": { "type": "string" } } },
    "WorkflowParam": { "type": "object", "properties": { "key": { "type": "string" }, "value": { "type": "string" } } },
    "WorkflowNode": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/definitions/WorkflowParam" } },
        "position": { "$ref": "#/definitions/SemioPoint2" }
      }
    },
    "WorkflowEdge": {
      "type": "object",
      "properties": { "id": { "type": "string" }, "from": { "$ref": "#/definitions/PortRef" }, "to": { "$ref": "#/definitions/PortRef" }, "kind": { "type": "string" } }
    },
    "SemioWorkflowSnapshot": {
      "type": "object",
      "properties": {
        "schema": { "type": "string" },
        "nodes": { "type": "array", "items": { "$ref": "#/definitions/WorkflowNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/definitions/WorkflowEdge" } }
      }
    }
  },
  "properties": {
    "mutation": {
      "type": "string",
      "enum": [
        "noMutation", "setSnapshot", "insertNode", "removeNode", "setNodeKind", "setNodeLabel", "setNodePosition",
        "setNodeParam", "removeNodeParam", "insertEdge", "removeEdge", "setEdgeEndpoints", "setEdgeKind"
      ]
    },
    "snapshot": { "$ref": "#/definitions/SemioWorkflowSnapshot" },
    "node": { "$ref": "#/definitions/WorkflowNode" },
    "edge": { "$ref": "#/definitions/WorkflowEdge" },
    "id": { "type": "string" },
    "kind": { "type": "string" },
    "label": { "type": "string" },
    "position": { "$ref": "#/definitions/SemioPoint2" },
    "key": { "type": "string" },
    "value": { "type": "string" },
    "from": { "$ref": "#/definitions/PortRef" },
    "to": { "$ref": "#/definitions/PortRef" }
  },
  "required": ["mutation"]
}
