module Stdio_semio_mesh_diff;

# Spicy mirror (descriptive, not test-parsed — the real byte-level walker is
# ../📡️.protocol.semio, walked by dsl::walk_protocol) for the REAL binary
# `DiffCodec::encode_diff`/`decode_diff` frame (../../🦀️.rs) — replaces the old
# `print_diff().into_bytes()` text-as-binary shortcut.

public type Envelope = unit {
    format: uint8;     # DIFF_BINARY_FORMAT, currently 1
    presence: uint8;   # bit0=meshes, bit1=materials, bit2=textures
    payload: bytes &eod;   # 0-3 varint-length-prefixed UTF-8 blobs, one per bit set in `presence`
};
