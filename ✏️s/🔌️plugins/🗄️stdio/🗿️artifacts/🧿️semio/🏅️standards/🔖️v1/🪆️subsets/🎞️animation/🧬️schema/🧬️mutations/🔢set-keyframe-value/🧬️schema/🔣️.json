{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/mutation/set-keyframe-value/schema.json",
  "title": "SetKeyframeValue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "timelineIndex",
    "channelIndex",
    "index",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setKeyframeValue",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    },
    "timelineIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Timeline",
          "de": "Zeitleiste"
        },
        "description": {
          "en": "Index of the timeline, counted from 0.",
          "de": "Index der Zeitleiste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "channelIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Channel",
          "de": "Kanal"
        },
        "description": {
          "en": "Index of the channel within the timeline, counted from 0.",
          "de": "Index des Kanals innerhalb der Zeitleiste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Keyframe",
          "de": "Schlüsselbild"
        },
        "description": {
          "en": "Index of the keyframe within the channel, counted from 0.",
          "de": "Index des Schlüsselbilds innerhalb des Kanals, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 30
      }
    },
    "value": {
      "$ref": "#/$defs/AnimValue",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Value",
          "de": "Wert"
        },
        "description": {
          "en": "Typed value the keyframe holds: scalar, vector, quaternion or colour.",
          "de": "Typisierter Wert des Schlüsselbilds: Skalar, Vektor, Quaternion oder Farbe."
        },
        "group": "value",
        "order": 40
      }
    }
  },
  "$defs": {
    "AnimValue": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/snapshot.json#/definitions/AnimValue"
    }
  }
}
