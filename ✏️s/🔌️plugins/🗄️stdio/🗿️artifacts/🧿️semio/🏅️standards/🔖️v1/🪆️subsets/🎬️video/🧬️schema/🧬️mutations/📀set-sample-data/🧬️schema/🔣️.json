{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/video/mutation/set-sample-data/schema.json",
  "title": "SetSampleData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "streamIndex",
    "index",
    "data"
  ],
  "properties": {
    "streamIndex": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "mutation": {
      "const": "setSampleData",
      "description": "Aggregate discriminator spliced in by SemioVideoMutation; absent when the payload stands alone."
    }
  }
}
