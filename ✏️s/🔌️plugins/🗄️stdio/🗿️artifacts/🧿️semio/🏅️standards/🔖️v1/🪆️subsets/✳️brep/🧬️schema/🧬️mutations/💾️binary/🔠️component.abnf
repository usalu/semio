; abnf stdio.semio.brep mutations (op/binary payload)
; payload is UTF-8 compact RFC8259 JSON text (serde_json::to_vec of a SemioBrepMutation) -- see
; ../📝️text/🔤️component.ebnf for the outer JSON-value grammar restated, and ../🔣️component.json
; for the tagged variant/field enumeration.
document = json-text
json-text = value
value = object / array / string / number / %s"true" / %s"false" / %s"null"
object = %x7B [ member *( %x2C member ) ] %x7D
member = string %x3A value
array = %x5B [ value *( %x2C value ) ] %x5D
string = DQUOTE *( unescaped / escape ) DQUOTE
unescaped = %x20-21 / %x23-5B / %x5D-10FFFF
escape = %x5C ( DQUOTE / %x5C / %x2F / %x62 / %x66 / %x6E / %x72 / %x74 / ( %x75 4HEXDIG ) )
number = [ %x2D ] int [ frac ] [ exp ]
int = %x30 / ( %x31-39 *DIGIT )
frac = %x2E 1*DIGIT
exp = ( %x65 / %x45 ) [ %x2B / %x2D ] 1*DIGIT
