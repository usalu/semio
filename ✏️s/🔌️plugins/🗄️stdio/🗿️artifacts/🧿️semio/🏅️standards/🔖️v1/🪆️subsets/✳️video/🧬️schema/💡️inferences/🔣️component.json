{
  "$id": "https://semio.tech/schema/s/stdio/semio/video/inference.json",
  "title": "SemioVideoInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["duration"],
  "properties": {
    "duration": { "$ref": "#/$defs/SemioVideoDuration", "x-semio-state": "inferred" }
  },
  "$defs": {
    "SemioVideoDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "streamCount", "sampleCount"],
      "properties": {
        "durationSeconds": { "type": "number", "minimum": 0 },
        "streamCount": { "type": "integer", "minimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
