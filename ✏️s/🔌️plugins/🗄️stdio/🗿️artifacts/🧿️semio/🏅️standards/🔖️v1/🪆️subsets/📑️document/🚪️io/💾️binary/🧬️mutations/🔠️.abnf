; ABNF-style descriptive mirror of `stdio.semio.document`'s real binary op frame -- see the
; authoritative `📡️.protocol.semio` for the conformance-tested version.
document       = format tag payload
format         = %x01                  ; OP_BINARY_FORMAT
tag            = OCTET                 ; the kind's record tag in 📡️.protocol.semio
payload        = *OCTET                ; the variant's own "key=value ..." argument text,
                                        ; see component.rs's OpBinary::encode_op
