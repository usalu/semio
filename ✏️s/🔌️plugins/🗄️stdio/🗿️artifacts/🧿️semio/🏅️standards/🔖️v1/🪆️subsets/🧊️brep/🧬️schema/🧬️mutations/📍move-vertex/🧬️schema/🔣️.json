{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/mutation/move-vertex/schema.json",
  "title": "MoveVertex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vertex_id",
    "new_point"
  ],
  "properties": {
    "vertex_id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Vertex",
          "de": "Eckpunkt"
        },
        "ref": {
          "kind": "vertex"
        }
      }
    },
    "new_point": {
      "$ref": "#/$defs/SemioPoint3",
      "x-semio-ui": {
        "label": {
          "en": "Position",
          "de": "Position"
        }
      }
    }
  },
  "$defs": {
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
