{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/mutation/move-vertex/schema.json",
  "title": "MoveVertex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vertex_id",
    "new_point"
  ],
  "properties": {
    "vertex_id": {
      "type": "string"
    },
    "new_point": {
      "$ref": "#/$defs/SemioPoint3"
    }
  },
  "$defs": {
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
