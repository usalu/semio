dialect protocol
protocol stdio.semio.document.mutations
version 1
schema stdio.semio.document
start body
framing record

# Real `SemioDocumentMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value ...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record insert-block tag=1
field payload bytes
record remove-block tag=2
field payload bytes
record set-block-content tag=3
field payload bytes
record set-paragraph-style tag=4
field payload bytes
record set-heading-level tag=5
field payload bytes
record set-list-ordered tag=6
field payload bytes
record set-run-text tag=7
field payload bytes
record set-run-style tag=8
field payload bytes
record set-image-block tag=9
field payload bytes
record insert-style tag=10
field payload bytes
record remove-style tag=11
field payload bytes
record set-style-name tag=12
field payload bytes
record set-style-based-on tag=13
field payload bytes
record insert-image tag=14
field payload bytes
record remove-image tag=15
field payload bytes
record set-image-bytes tag=16
field payload bytes
