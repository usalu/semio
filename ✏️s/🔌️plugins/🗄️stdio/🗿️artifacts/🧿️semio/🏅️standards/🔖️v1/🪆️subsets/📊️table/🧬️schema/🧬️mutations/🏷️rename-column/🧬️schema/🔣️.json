{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/table/mutation/rename-column/schema.json",
  "title": "RenameColumn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "new_name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Column",
          "de": "Spalte"
        },
        "description": {
          "en": "Name of the column.",
          "de": "Name der Spalte."
        },
        "ref": {
          "kind": "column"
        },
        "group": "target",
        "order": 10
      }
    },
    "new_name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "New name",
          "de": "Neuer Name"
        },
        "description": {
          "en": "Name the column carries afterwards.",
          "de": "Name, den die Spalte danach trägt."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
