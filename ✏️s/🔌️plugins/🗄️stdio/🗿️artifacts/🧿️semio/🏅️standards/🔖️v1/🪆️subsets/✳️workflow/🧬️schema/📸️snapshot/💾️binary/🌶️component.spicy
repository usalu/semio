module Semio_workflow_snapshot;
# `s.stdio.semio.workflow` snapshot binary wire format — `store::semio_format` binary envelope
# (envelope_id + component tag + version) wrapping a `serde_json::to_vec(SemioWorkflowSnapshot)`
# payload verbatim. See the module doc comment on `📸️snapshot/💾️binary/🥋️component.ksy`.
type Document = unit {
    envelope_id: bytes &size=20;
    component_tag: uint8;
    version: uint8;
    json_payload: bytes &eod;
};
