module Stdio_semio_presentation_diff;

# Real binary `SemioPresentationDiff` frame: `format` (1 byte) + `presence` bitmask (1 byte,
# bit0=masters bit1=layouts bit2=slides), then one opaque `payload` tail — see the sibling
# `📡️.protocol.semio`'s comment on the `protocol-cond-cannot-chain` boundary.
type Document = unit {
    format: uint8;
    presence: uint8;
    payload: bytes &eod;
};
