{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/mutation/insert-element/schema.json",
  "title": "InsertElement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "$ref": "#/$defs/SemioModelElement"
    },
    "mutation": {
      "const": "insertElement",
      "description": "Aggregate discriminator spliced in by SemioModelMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioModelElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/ElementClass"
        },
        "placement": {
          "$ref": "#/$defs/SemioTransform"
        },
        "geometry": {
          "$ref": "#/$defs/GeometryRef"
        },
        "spatialId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "psets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertySet"
          }
        }
      }
    },
    "ElementClass": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/snapshot.json#/$defs/ElementClass"
    },
    "SemioTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/SemioPoint3"
        },
        "rotation": {
          "$ref": "#/$defs/SemioQuaternion"
        },
        "scale": {
          "$ref": "#/$defs/SemioPoint3"
        }
      }
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        }
      }
    },
    "GeometryRef": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/snapshot.json#/$defs/GeometryRef"
    },
    "PropertySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Property"
          }
        }
      }
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/PsetValue"
        }
      }
    },
    "PsetValue": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/snapshot.json#/$defs/PsetValue"
    }
  }
}
