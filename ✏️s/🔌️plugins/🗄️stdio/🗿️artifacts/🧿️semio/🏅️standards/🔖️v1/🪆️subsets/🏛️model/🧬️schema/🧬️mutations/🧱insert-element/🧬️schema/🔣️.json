{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/model/mutation/insert-element/schema.json",
  "title": "InsertElement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "element"
  ],
  "properties": {
    "element": {
      "$ref": "#/$defs/SemioModelElement"
    },
    "mutation": {
      "const": "insertElement",
      "description": "Aggregate discriminator spliced in by SemioModelMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioModelElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/ElementClass"
        },
        "placement": {
          "$ref": "#/$defs/SemioTransform"
        },
        "geometry": {
          "$ref": "#/$defs/GeometryRef"
        },
        "spatialId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "psets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertySet"
          }
        }
      }
    },
    "ElementClass": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "wall"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "slab"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "column"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "beam"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "door"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "window"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "roof"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "stair"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "furniture"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "other"
            },
            "name": {
              "type": "string"
            }
          }
        }
      ]
    },
    "SemioTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/SemioPoint3"
        },
        "rotation": {
          "$ref": "#/$defs/SemioQuaternion"
        },
        "scale": {
          "$ref": "#/$defs/SemioPoint3"
        }
      }
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        }
      }
    },
    "GeometryRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "brepId"
          ],
          "properties": {
            "kind": {
              "const": "brep"
            },
            "brepId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "meshId"
          ],
          "properties": {
            "kind": {
              "const": "mesh"
            },
            "meshId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "PropertySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Property"
          }
        }
      }
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/PsetValue"
        }
      }
    },
    "PsetValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
