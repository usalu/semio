{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/group-nodes/schema.json",
  "title": "GroupNodes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent",
    "indices",
    "transform"
  ],
  "properties": {
    "parent": {
      "$ref": "#/$defs/NodePath",
      "x-semio-ui": {
        "label": {
          "en": "Parent",
          "de": "Übergeordneter Knoten"
        },
        "description": {
          "en": "Layer index and child indices of the group (or the layer itself) that holds the nodes, each counted from 0.",
          "de": "Ebenenindex und Kindindizes der Gruppe (oder der Ebene selbst), die die Knoten enthält, jeweils ab 0 gezählt."
        },
        "group": "target",
        "order": 10
      }
    },
    "indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Nodes",
          "de": "Knoten"
        },
        "description": {
          "en": "Indices of the sibling nodes that are grouped, counted from 0.",
          "de": "Indizes der Geschwisterknoten, die gruppiert werden, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "transform": {
      "$ref": "#/$defs/SemioTransform",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Group transform",
          "de": "Gruppentransformation"
        },
        "description": {
          "en": "Translation, rotation (unit quaternion) and scale of the new group.",
          "de": "Verschiebung, Drehung (Einheitsquaternion) und Skalierung der neuen Gruppe."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "SemioTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/SemioPoint3",
          "x-semio-ui": {
            "label": {
              "en": "Translation",
              "de": "Verschiebung"
            }
          }
        },
        "rotation": {
          "$ref": "#/$defs/SemioQuaternion"
        },
        "scale": {
          "$ref": "#/$defs/SemioPoint3"
        }
      }
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "W",
              "de": "W"
            },
            "description": {
              "en": "Scalar part of the rotation quaternion.",
              "de": "Skalarteil des Rotationsquaternions."
            }
          }
        }
      }
    }
  }
}
