{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/kit/mutation/create-object/schema.json",
  "title": "CreateObject",
  "type": "object",
  "additionalProperties": false,
  "required": ["child_id", "target"],
  "properties": {
    "child_id": { "type": "string" },
    "target": {
      "allOf": [
        { "$ref": "https://semio.tech/schema/framework/io/schema.json#/$defs/ArtifactRef" },
        {
          "type": "object",
          "properties": {
            "dialect": {
              "type": "object",
              "properties": {
                "artifactKind": { "const": "s.stdio.semio" },
                "standard": { "const": "v1" },
                "subset": { "const": "object" }
              }
            }
          }
        }
      ]
    }
  }
}
