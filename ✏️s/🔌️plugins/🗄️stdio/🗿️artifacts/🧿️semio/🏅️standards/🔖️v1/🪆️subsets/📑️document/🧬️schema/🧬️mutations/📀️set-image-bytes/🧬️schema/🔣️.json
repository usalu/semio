{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/document/mutation/set-image-bytes.json",
  "title": "SetImageBytes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mime",
    "bytes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "mime": {
      "type": "string"
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "kind": {
      "const": "setImageBytes",
      "description": "Aggregate discriminator spliced in by DocPathSegment; absent when the payload stands alone."
    }
  }
}
