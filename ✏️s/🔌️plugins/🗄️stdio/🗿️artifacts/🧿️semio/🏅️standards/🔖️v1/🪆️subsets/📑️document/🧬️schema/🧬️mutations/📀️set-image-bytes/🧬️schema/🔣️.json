{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/mutation/set-image-bytes/schema.json",
  "title": "SetImageBytes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "mime",
    "bytes"
  ],
  "properties": {
    "mutation": {
      "const": "setImageBytes",
      "description": "Aggregate discriminator spliced in by SemioDocumentMutation; absent when the payload stands alone."
    },
    "id": {
      "type": "string"
    },
    "mime": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Media type",
          "de": "Medientyp"
        }
      }
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "x-semio-ui": {
        "label": {
          "en": "Bytes",
          "de": "Bytes"
        }
      }
    }
  }
}
