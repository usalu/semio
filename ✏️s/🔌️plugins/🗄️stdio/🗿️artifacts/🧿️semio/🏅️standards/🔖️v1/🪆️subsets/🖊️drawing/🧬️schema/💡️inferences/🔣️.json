{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/drawing/inference.json",
  "title": "SemioDrawingInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flattenedScene"
  ],
  "properties": {
    "flattenedScene": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/FlattenedNode"
      },
      "x-semio-derived": true
    }
  },
  "$defs": {
    "FlattenedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldTransform"
      ],
      "properties": {
        "worldTransform": {
          "$ref": "https://semio.tech/schema/s/stdio/semio/v1/drawing/snapshot.json#/$defs/Transform"
        },
        "resolvedStyle": {
          "$ref": "https://semio.tech/schema/s/stdio/semio/v1/drawing/snapshot.json#/$defs/DrawStyle"
        }
      }
    }
  }
}
