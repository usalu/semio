{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/animation/mutation/remove-channel/schema.json",
  "title": "RemoveChannel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timelineIndex",
    "index"
  ],
  "properties": {
    "timelineIndex": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "mutation": {
      "const": "removeChannel",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    }
  }
}
