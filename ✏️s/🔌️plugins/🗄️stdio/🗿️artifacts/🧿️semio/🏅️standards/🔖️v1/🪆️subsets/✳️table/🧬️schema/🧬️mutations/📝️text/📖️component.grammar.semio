dialect grammar
grammar stdio.semio.table.mutations
extension semio
start op

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM table wave: real one-line `OpText::print_op`/`parse_op` shape
# ALREADY emitted by `../📝️text/🦀️component.rs` (`print_table_mutation`/`parse_table_mutation`) —
# `tag:args` (no space; `:` separates the keyword from its positional, comma-separated argument
# list). Every keyword/tag token below is copied verbatim from the real `format!(...)` call sites
# in that file's `print_table_mutation`, not invented. Eight keywords, one per closed-vocabulary
# verb this facet registers (`create`/`delete`/`rename`/`reorder`/`insert`/`remove`/`edit`) —
# `📓️taxonomy.md`'s `APPROVED_VERBS`, no `no`/`setSnapshot` (banned vocabulary).
op = create-column | delete-column | rename-column | reorder-columns | insert-row | remove-row | reorder-rows | edit-cell

create-column = "createColumn" ":" hex "," cell-kind "," opt-index
delete-column = "deleteColumn" ":" hex
rename-column = "renameColumn" ":" hex "," hex
reorder-columns = "reorderColumns" ":" hex "," INT
insert-row = "insertRow" ":" INT "," row
remove-row = "removeRow" ":" INT
reorder-rows = "reorderRows" ":" INT "," INT
edit-cell = "editCell" ":" INT "," hex "," value

# `CreateColumn.index: Option<usize>` — an empty token means `None`, matching `enc_opt_usize`.
opt-index = INT?
cell-kind = "n" | "b" | "i" | "f" | "s" | "y"
row = "[" list-item* "]"

# `value`/`list-item`/`map-item`/`bit` reused verbatim from ✳️value's own grammar (`EditCell`'s
# `new_value` and each row cell are `SemioValue`, encoded via that subset's `enc_semio_value`).
value = "Z" | "B" "[" bit "]" | "I" "[" hex "]" | "F" "[" hex "]" | "S" "[" hex "]" | "Y" "[" hex "]" | "L" "[" list-item* "]" | "M" "[" map-item* "]" | "R" "[" hex "]"
list-item = value ","?
map-item = hex ":" value ","?
bit = "0" | "1"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO — a run of lowercase hex digits, incl. the empty string.
