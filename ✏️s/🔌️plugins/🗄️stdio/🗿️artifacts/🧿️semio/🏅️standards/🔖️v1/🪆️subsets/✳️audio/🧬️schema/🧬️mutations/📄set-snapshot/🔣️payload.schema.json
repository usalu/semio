{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string"
    },
    "sampleRate": {
      "type": "integer",
      "minimum": 0
    },
    "format": {
      "type": "string",
      "enum": [
        "Pcm8",
        "Pcm16",
        "Pcm24",
        "Pcm32",
        "Float32",
        "Float64"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "samples": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "samples"
        ],
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "sampleRate",
    "format",
    "channels",
    "tags"
  ],
  "additionalProperties": false
}
