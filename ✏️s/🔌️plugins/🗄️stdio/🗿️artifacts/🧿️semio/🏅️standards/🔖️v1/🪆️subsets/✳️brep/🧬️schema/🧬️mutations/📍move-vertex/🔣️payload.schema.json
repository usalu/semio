{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoveVertex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newPoint",
    "vertexId"
  ],
  "properties": {
    "vertexId": {
      "type": "string"
    },
    "newPoint": {
      "title": "SemioPoint3",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
