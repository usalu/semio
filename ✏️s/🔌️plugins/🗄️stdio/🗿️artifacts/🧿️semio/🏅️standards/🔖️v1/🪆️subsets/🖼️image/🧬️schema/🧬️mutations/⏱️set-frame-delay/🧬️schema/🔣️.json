{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/mutation/set-frame-delay/schema.json",
  "title": "SetFrameDelay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "delay_ms"
  ],
  "properties": {
    "mutation": {
      "const": "setFrameDelay",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Frame",
          "de": "Einzelbild"
        },
        "description": {
          "en": "Index of the frame, counted from 0.",
          "de": "Index des Einzelbilds, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "delay_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Frame delay",
          "de": "Bildverzögerung"
        },
        "unit": "ms",
        "step": 1
      }
    }
  }
}
