{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/diff.json",
  "title": "SemioValueTreeDiff",
  "description": "Sparse, handcrafted diff over SemioValueSnapshot — mirrors the 🦀️.rs sibling's real fields.",
  "$defs": {
    "IndexedTripleDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "diff": {
                "$ref": "#/$defs/SemioValueDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "item": {
                "$ref": "#/definitions/semioValue"
              }
            }
          }
        }
      }
    },
    "NamedTripleDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array"
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {},
              "diff": {
                "$ref": "#/$defs/SemioValueDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "item": {}
            }
          }
        }
      }
    },
    "SemioValueDiff": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "replace",
            "bool",
            "int",
            "float",
            "str",
            "bytes",
            "list",
            "map",
            "ref"
          ]
        },
        "value": {},
        "lexeme": {
          "type": "string"
        },
        "diff": {
          "$ref": "#/$defs/IndexedTripleDiff"
        },
        "id": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/snapshot.json#/$defs/ValueId"
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  "type": "object",
  "properties": {
    "root": {
      "$ref": "#/$defs/SemioValueDiff",
      "x-semio-state": "artifact"
    },
    "nodes": {
      "$ref": "#/$defs/NamedTripleDiff",
      "x-semio-state": "artifact"
    }
  },
  "definitions": {
    "semioValue": {
      "type": "object"
    },
    "semioValueEntry": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/semioValue"
        }
      }
    },
    "semioValueNode": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/snapshot.json#/$defs/ValueId"
        },
        "value": {
          "$ref": "#/definitions/semioValue"
        }
      }
    }
  }
}
