{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/drawing/mutation/scale-node/schema.json",
  "title": "ScaleNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "at",
    "new_scale"
  ],
  "properties": {
    "at": {
      "$ref": "#/$defs/NodePath"
    },
    "new_scale": {
      "$ref": "#/$defs/SemioPoint3"
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
