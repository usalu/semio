{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/drawing/mutation/scale-node.json",
  "title": "Scale",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "at",
    "newScale"
  ],
  "properties": {
    "at": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "newScale": {
      "title": "SemioPoint3",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
