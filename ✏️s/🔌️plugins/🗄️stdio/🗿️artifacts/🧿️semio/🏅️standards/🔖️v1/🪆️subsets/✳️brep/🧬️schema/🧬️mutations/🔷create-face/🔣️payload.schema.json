{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateFace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "innerLoops",
    "orientation",
    "outerLoop",
    "surface"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "outerLoop": {
      "type": "string"
    },
    "innerLoops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Plane"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Cylinder"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Cone"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Sphere"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Torus"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Nurbs"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "orientation": {
      "type": "boolean"
    }
  }
}
