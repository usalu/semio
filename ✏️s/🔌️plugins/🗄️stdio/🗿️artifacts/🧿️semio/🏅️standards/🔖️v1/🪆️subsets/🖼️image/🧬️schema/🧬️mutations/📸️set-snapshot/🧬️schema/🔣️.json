{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/image/mutation/set-snapshot.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "width",
    "height",
    "colorspace",
    "bitDepth",
    "frames",
    "metadata"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 0
    },
    "height": {
      "type": "integer",
      "minimum": 0
    },
    "colorspace": {
      "type": "string",
      "enum": [
        "Rgb",
        "Rgba",
        "Grayscale",
        "GrayscaleAlpha",
        "Indexed"
      ]
    },
    "bitDepth": {
      "type": "integer",
      "minimum": 0
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "delayMs": {
            "type": "integer",
            "minimum": 0
          },
          "rgba8": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "delayMs",
          "rgba8"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    }
  }
}
