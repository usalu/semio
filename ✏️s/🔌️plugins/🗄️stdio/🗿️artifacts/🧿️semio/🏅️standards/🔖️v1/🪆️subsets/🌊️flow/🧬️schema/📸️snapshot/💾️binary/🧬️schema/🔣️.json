{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/flow/snapshot/binary/schema.json",
  "$defs": {
    "FlowRetainedSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "semio.flow.retained-snapshot/v1"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "const": 256
            },
            "edges": {
              "const": 512
            },
            "paramsPerNode": {
              "const": 64
            },
            "stringBytes": {
              "const": 4096
            },
            "totalStringBytes": {
              "const": 1048576
            }
          },
          "required": [
            "nodes",
            "edges",
            "paramsPerNode",
            "stringBytes",
            "totalStringBytes"
          ]
        },
        "valid": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "empty",
                  "unicode"
                ]
              },
              "snapshot": {
                "$ref": "#/$defs/snapshot"
              },
              "hex": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})+$"
              }
            },
            "required": [
              "id",
              "snapshot",
              "hex"
            ]
          }
        },
        "invalid": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "hex": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})+$"
              },
              "reason": {
                "enum": [
                  "malformed",
                  "identity",
                  "capacity"
                ]
              }
            },
            "required": [
              "id",
              "hex",
              "reason"
            ]
          }
        }
      },
      "required": [
        "schema",
        "limits",
        "valid",
        "invalid"
      ],
      "$defs": {
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "const": "stdio.semio.flow"
            },
            "nodes": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "kind": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "params": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "key": {
                          "type": "string",
                          "maxLength": 4096
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 4096
                        }
                      },
                      "required": [
                        "key",
                        "value"
                      ]
                    }
                  },
                  "position": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "label",
                  "params",
                  "position"
                ]
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "from": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "node": {
                        "type": "string",
                        "maxLength": 4096
                      },
                      "port": {
                        "type": "string",
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "node",
                      "port"
                    ]
                  },
                  "to": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "node": {
                        "type": "string",
                        "maxLength": 4096
                      },
                      "port": {
                        "type": "string",
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "node",
                      "port"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "required": [
                  "id",
                  "from",
                  "to",
                  "kind"
                ]
              }
            }
          },
          "required": [
            "schema",
            "nodes",
            "edges"
          ]
        }
      },
      "title": "FlowRetainedSnapshot"
    },
    "FlowRetainedSnapshotLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "semio.flow.retained-snapshot-lifecycle/v1"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "const": "flow-member"
            },
            "artifactKind": {
              "const": "s.stdio.semio"
            },
            "standard": {
              "const": "v1"
            },
            "subset": {
              "const": "flow"
            },
            "identityBytes": {
              "const": 30
            }
          },
          "required": [
            "artifactId",
            "artifactKind",
            "standard",
            "subset",
            "identityBytes"
          ]
        },
        "admission": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "live",
                  "unadmitted",
                  "closing",
                  "retired",
                  "foreign"
                ]
              },
              "state": {
                "enum": [
                  "admitted",
                  "unadmitted",
                  "closing",
                  "retired"
                ]
              },
              "subset": {
                "enum": [
                  "flow",
                  "text"
                ]
              },
              "reason": {
                "enum": [
                  null,
                  "unsealed",
                  "stale",
                  "identity"
                ]
              }
            },
            "required": [
              "id",
              "state",
              "subset",
              "reason"
            ]
          }
        },
        "multiPage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "unicode"
            },
            "nodeIndex": {
              "const": 0
            },
            "labelScalar": {
              "const": "🧬"
            },
            "labelRepeats": {
              "const": 1024
            },
            "wireBytes": {
              "const": 4249
            },
            "inputBytes": {
              "const": 4252
            },
            "inputPages": {
              "const": 2
            },
            "snapshotRetiredBytes": {
              "const": 4190
            },
            "totalRetiredBytes": {
              "const": 8472
            }
          },
          "required": [
            "source",
            "nodeIndex",
            "labelScalar",
            "labelRepeats",
            "wireBytes",
            "inputBytes",
            "inputPages",
            "snapshotRetiredBytes",
            "totalRetiredBytes"
          ]
        },
        "retirementGrants": {
          "const": [
            [
              1
            ],
            [
              7
            ],
            [
              1,
              3,
              4096,
              2
            ]
          ]
        }
      },
      "required": [
        "schema",
        "request",
        "admission",
        "multiPage",
        "retirementGrants"
      ],
      "title": "FlowRetainedSnapshotLifecycle"
    }
  }
}
