{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/audio/mutation/set-tag-value/schema.json",
  "title": "SetTagValue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setTagValue",
      "description": "Aggregate discriminator spliced in by SemioAudioMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Tag",
          "de": "Tag"
        },
        "description": {
          "en": "Index of the metadata tag, counted from 0.",
          "de": "Index des Metadaten-Tags, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "value": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Value",
          "de": "Wert"
        },
        "description": {
          "en": "Text the tag holds afterwards.",
          "de": "Text, den das Tag danach enthält."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
