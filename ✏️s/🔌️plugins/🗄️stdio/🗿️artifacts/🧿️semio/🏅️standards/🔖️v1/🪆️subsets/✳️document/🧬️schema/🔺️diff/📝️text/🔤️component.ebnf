(* ISO-14977-style EBNF for `stdio.semio.document`'s real one-line `DiffCodec` text form —
   descriptive mirror of the authoritative `📖️component.grammar.semio` (same production names,
   abridged: full per-field diff detail lives there). *)
document = [ styles line ], [ images line ], [ blocks line ] ;

styles line = 'styles', '=', triple ;
images line = 'images', '=', triple ;
blocks line = 'blocks', '=', triple ;

triple = '[', [ removed items ], ']', ';', '[', [ modified items ], ']', ';', '[', [ added items ], ']' ;
removed items = key, { ',', key } ;
key = hex | integer ;
modified items = modified item, { ',', modified item } ;
modified item = key, ':', diff body ;
added items = added item, { ',', added item } ;
added item = value | ( integer, ':', value ) ;

diff body = '[', bracketed content, ']' ;
value = '[', bracketed content, ']' ;
(* `bracketed content` = arbitrary further-nested bracket/comma/semicolon-delimited value text —
   see the authoritative grammar for the exhaustive, byte-for-byte per-kind expansion. *)
