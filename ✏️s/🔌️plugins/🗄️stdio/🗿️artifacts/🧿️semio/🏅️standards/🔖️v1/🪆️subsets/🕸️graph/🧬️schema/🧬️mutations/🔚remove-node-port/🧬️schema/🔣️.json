{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/mutation/remove-node-port/schema.json",
  "title": "RemoveNodePort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "index"
  ],
  "properties": {
    "node_id": {
      "$ref": "#/$defs/GraphNodeId",
      "x-semio-ui": {
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The node the mutation addresses.",
          "de": "Der Knoten, den die Mutation adressiert."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Port",
          "de": "Anschluss"
        },
        "description": {
          "en": "Index of the port of the node, counted from 0.",
          "de": "Index des Anschlusses des Knotens, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Node id",
              "de": "Knoten-ID"
            },
            "ref": {
              "kind": "node",
              "domain": "graph",
              "granularity": "node"
            }
          }
        }
      }
    }
  }
}
