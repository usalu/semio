(* ISO-14977-style EBNF for `stdio.semio`'s real text DSL body — descriptive mirror of the
   authoritative `📖️component.grammar.semio` (same production names). Real header only; the
   wrapped subset's own body is opaque "rest of document", validated by that subset's own
   grammar file, not re-described here. *)
document = artifact mark, subset line, rest of document ;
artifact mark = 'stdio.semio' ;

subset line = 'subset', '=', subset tag ;
subset tag = 'brep' | 'mesh' | 'model' | 'object' | 'document' | 'cad' | 'drawing' | 'image' | 'video' | 'audio' | 'animation' | 'presentation' | 'workflow' ;

rest of document = { ? any character up to end of document ? } ;
