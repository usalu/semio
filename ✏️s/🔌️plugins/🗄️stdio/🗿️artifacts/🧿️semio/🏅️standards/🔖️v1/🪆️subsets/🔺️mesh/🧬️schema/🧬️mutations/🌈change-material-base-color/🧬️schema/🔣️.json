{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/mesh/mutation/change-material-base-color/schema.json",
  "title": "ChangeMaterialBaseColor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "new_base_color"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "new_base_color": {
      "$ref": "#/$defs/SemioRgba"
    }
  },
  "$defs": {
    "SemioRgba": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      }
    }
  }
}
