{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/mesh/mutation/change-material-base-color.json",
  "title": "ChangeMaterialBaseColor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newBaseColor"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "newBaseColor": {
      "title": "SemioRgba",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "b",
        "g",
        "r"
      ],
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      }
    }
  }
}
