  "inverseCases": [
    {
      "id": "delete-vertex-restores-distinct-tolerance-and-edge-cascade",
      "before": {
        "schema": "stdio.semio.brep",
        "vertices": [
          {
            "id": "v-delete",
            "point": {
              "x": 1,
              "y": 2,
              "z": 3
            },
            "tol": 2.1e-7
          },
          {
            "id": "v-keep",
            "point": {
              "x": 4,
              "y": 5,
              "z": 6
            },
            "tol": 2.2e-7
          }
        ],
        "edges": [
          {
            "id": "e-cascade-a",
            "startVertex": "v-delete",
            "endVertex": "v-keep",
            "curve": {
              "kind": "line",
              "origin": {
                "x": 0,
                "y": 0,
                "z": 0
              },
              "direction": {
                "x": 1,
                "y": 0,
                "z": 0
              }
            },
            "tol": 3.1e-7
          },
          {
            "id": "e-cascade-b",
            "startVertex": "v-keep",
            "endVertex": "v-delete",
            "curve": {
              "kind": "line",
              "origin": {
                "x": 0,
                "y": 0,
                "z": 0
              },
              "direction": {
                "x": 0,
                "y": 1,
                "z": 0
              }
            },
            "tol": 3.2e-7
          }
        ]
      },
      "mutation": {
        "DeleteVertex": {
          "id": "v-delete"
        }
      },
      "expectedInverse": [
        {
          "CreateVertex": {
            "id": "v-delete",
            "point": {
              "x": 1,
              "y": 2,
              "z": 3
            },
            "tol": 2.1e-7
          }
        },
        {
          "CreateEdge": {
            "id": "e-cascade-a",
            "start_vertex": "v-delete",
            "end_vertex": "v-keep",
            "curve": {
              "kind": "line",
              "origin": {
                "x": 0,
                "y": 0,
                "z": 0
              },
              "direction": {
                "x": 1,
                "y": 0,
                "z": 0
              }
            },
            "tol": 3.1e-7
          }
        },
        {
          "CreateEdge": {
            "id": "e-cascade-b",
            "start_vertex": "v-keep",
            "end_vertex": "v-delete",
            "curve": {
              "kind": "line",
              "origin": {
                "x": 0,
                "y": 0,
                "z": 0
              },
              "direction": {
                "x": 0,
                "y": 1,
                "z": 0
              }
            },
            "tol": 3.2e-7
          }
        }
      ]
    },
