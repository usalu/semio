module Stdio_semio_video_diff;
# Spicy mirror (descriptive, not test-parsed — the real byte-level walker is
# ../📡️.protocol.semio, walked by dsl::walk_protocol) for the REAL binary diff frame
# (video wave, replacing the old print_diff().into_bytes() text-as-binary shortcut). `format` +
# `presence` (bit0 = streams present) are real, fully described fixed fields; the optional
# streams blob is one opaque trailing `payload` (protocol-cond-cannot-chain gap).
type Document = unit {
    format: uint8;
    presence: uint8;
    payload: bytes &eod;
};
