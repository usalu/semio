{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/video/mutation/set-sample-flags.json",
  "title": "SetSampleFlags",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "streamIndex",
    "index",
    "pts",
    "key"
  ],
  "properties": {
    "streamIndex": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "pts": {
      "type": "integer",
      "minimum": 0
    },
    "key": {
      "type": "boolean"
    },
    "mutation": {
      "const": "setSampleFlags",
      "description": "Aggregate discriminator spliced in by SemioVideoMutation; absent when the payload stands alone."
    }
  }
}
