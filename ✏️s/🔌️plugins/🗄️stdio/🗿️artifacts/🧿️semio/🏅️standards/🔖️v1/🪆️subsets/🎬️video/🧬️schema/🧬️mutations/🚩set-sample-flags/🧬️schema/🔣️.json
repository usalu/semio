{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/video/mutation/set-sample-flags/schema.json",
  "title": "SetSampleFlags",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "streamIndex",
    "index",
    "pts",
    "key"
  ],
  "properties": {
    "mutation": {
      "const": "setSampleFlags",
      "description": "Aggregate discriminator spliced in by SemioVideoMutation; absent when the payload stands alone."
    },
    "streamIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Stream",
          "de": "Datenstrom"
        },
        "description": {
          "en": "Index of the stream, counted from 0.",
          "de": "Index des Datenstroms, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Sample",
          "de": "Sample"
        },
        "description": {
          "en": "Index of the sample within the stream, counted from 0.",
          "de": "Index des Samples innerhalb des Datenstroms, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "pts": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Presentation time stamp",
          "de": "Präsentationszeitstempel (PTS)"
        },
        "step": 1
      }
    },
    "key": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Sync sample",
          "de": "Sync-Sample"
        },
        "description": {
          "en": "Whether the sample decodes without any earlier sample (a key frame).",
          "de": "Ob das Sample ohne frühere Samples dekodierbar ist (ein Schlüsselbild)."
        },
        "group": "value",
        "order": 40
      }
    }
  }
}
