{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/mutation/insert-spatial-node/schema.json",
  "title": "InsertSpatialNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "node"
  ],
  "properties": {
    "mutation": {
      "const": "insertSpatialNode",
      "description": "Aggregate discriminator spliced in by SemioModelMutation; absent when the payload stands alone."
    },
    "node": {
      "$ref": "#/$defs/SpatialNode"
    }
  },
  "$defs": {
    "SpatialNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SpatialKind",
          "x-semio-ui": {
            "options": {
              "site": {
                "en": "Site",
                "de": "Grundstück"
              },
              "building": {
                "en": "Building",
                "de": "Gebäude"
              },
              "storey": {
                "en": "Storey",
                "de": "Geschoss"
              },
              "space": {
                "en": "Space",
                "de": "Raum"
              }
            }
          }
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "placement": {
          "$ref": "#/$defs/SemioTransform"
        }
      }
    },
    "SpatialKind": {
      "type": "string",
      "enum": [
        "site",
        "building",
        "storey",
        "space"
      ]
    },
    "SemioTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/SemioPoint3",
          "x-semio-ui": {
            "label": {
              "en": "Translation",
              "de": "Verschiebung"
            }
          }
        },
        "rotation": {
          "$ref": "#/$defs/SemioQuaternion"
        },
        "scale": {
          "$ref": "#/$defs/SemioPoint3"
        }
      }
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "W",
              "de": "W"
            },
            "description": {
              "en": "Scalar part of the rotation quaternion.",
              "de": "Skalarteil des Rotationsquaternions."
            }
          }
        }
      }
    }
  }
}
