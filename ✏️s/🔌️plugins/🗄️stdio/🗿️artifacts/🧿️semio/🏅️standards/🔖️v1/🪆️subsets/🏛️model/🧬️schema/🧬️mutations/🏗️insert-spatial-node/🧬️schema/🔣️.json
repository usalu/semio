{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/model/mutation/insert-spatial-node.json",
  "title": "InsertSpatialNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node"
  ],
  "properties": {
    "node": {
      "$ref": "#/$defs/SpatialNode"
    },
    "mutation": {
      "const": "insertSpatialNode",
      "description": "Aggregate discriminator spliced in by SemioModelMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SpatialNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SpatialKind"
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "placement": {
          "$ref": "#/$defs/SemioTransform"
        }
      }
    },
    "SpatialKind": {
      "type": "string",
      "enum": [
        "site",
        "building",
        "storey",
        "space"
      ]
    },
    "SemioTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/SemioPoint3"
        },
        "rotation": {
          "$ref": "#/$defs/SemioQuaternion"
        },
        "scale": {
          "$ref": "#/$defs/SemioPoint3"
        }
      }
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        }
      }
    }
  }
}
