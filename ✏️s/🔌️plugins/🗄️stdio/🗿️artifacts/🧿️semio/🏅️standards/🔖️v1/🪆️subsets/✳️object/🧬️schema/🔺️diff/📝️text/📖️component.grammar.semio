dialect grammar
grammar semio.object.diff
extension semio
start document

# `protocol::DiffCodec::print_diff`/`parse_diff` (`🦀️component.rs`'s `print_object_diff`/
# `parse_object_diff`) — a SINGLE LINE, space-separated `key=value` tokens, either or both absent
# (an absent field = unchanged). NOT `serde_json` on the wire (unlike the snapshot facet): this is
# the hand-rolled tag-prefixed hex grammar every field-diff codec in this program uses.
document = ( root-token ( SP objects-token )? | objects-token )?
root-token = "root" "=" value-diff
objects-token = "objects" "=" named-triple

# `enc_value_diff`/`dec_value_diff` — tag-prefixed: `P`=rePlace (carries a full `value`), `B`=Bool,
# `I`=Int, `F`=Float, `S`=Str, `Y`=bYtes, `L`=List (nests an `indexed-triple`), `M`=Map (nests a
# `named-triple`), `R`=Ref.
value-diff = "P" "[" value "]" | "B" "[" bit "]" | "I" "[" hex "]" | "F" "[" hex "]" | "S" "[" hex "]"
           | "Y" "[" hex "]" | "L" "[" indexed-triple "]" | "M" "[" named-triple "]" | "R" "[" hex "]"
bit = "0" | "1"

# `enc_indexed_triple`/`dec_indexed_triple` (shared `engine::triples`) — `[removed];[modified];[added]`,
# index-keyed. Used by `List`.
indexed-triple = "[" ( index-removed ( "," index-removed )* )? "]" ";"
                 "[" ( index-modified ( "," index-modified )* )? "]" ";"
                 "[" ( index-added ( "," index-added )* )? "]"
index-removed = INT
index-modified = INT ":" value-diff
index-added = INT ":" value

# `enc_named_triple`/`dec_named_triple` (shared `engine::triples`) — same shape, name/id-keyed.
# Used by `Map` (key = hex string) and the top-level `objects` graph (key = hex object id).
# `named-item` is INDEX-PREFIXED (`enc_named_added_entry`/`enc_named_added_node`, this facet's own
# `NamedAdded<T>` wrapper — the shared engine's `NamedTripleDiff<K,D,T>.added: Vec<T>` alone
# carries no position, which broke `between_roundtrip_law`'s reverse direction until fixed; see
# `NamedAdded`'s doc comment in the sibling `🦀️component.rs`).
named-triple = "[" ( hex ( "," hex )* )? "]" ";"
               "[" ( named-modified ( "," named-modified )* )? "]" ";"
               "[" ( named-item ( "," named-item )* )? "]"
named-modified = hex ":" value-diff
# `named-item` = `index:key:value` (a full `Map` entry) or `index:id:value` (a full graph node),
# depending on which top-level token this triple sits under.
named-item = INT ":" hex ":" value

# `enc_semio_value`/`dec_semio_value` — restated here (identical to the sibling
# ../../📸️snapshot/📝️text/📖️component.grammar.semio's `semio-value`, flattened to this facet's own
# tag alphabet) so this leaf grammar is self-contained.
value = "Z" | "B" "[" bit "]" | "I" "[" hex "]" | "F" "[" hex "]" | "S" "[" hex "]" | "Y" "[" hex "]"
      | "L" "[" ( value ( "," value )* )? "]" | "M" "[" ( entry ( "," entry )* )? "]" | "R" "[" hex "]"
entry = hex ":" value

hex = ( HEXDIG HEXDIG )*
