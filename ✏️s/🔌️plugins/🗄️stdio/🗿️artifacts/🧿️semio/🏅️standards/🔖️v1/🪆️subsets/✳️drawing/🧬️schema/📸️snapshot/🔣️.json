{
  "$id": "https://semio.tech/schema/s.stdio.semio.drawing/snapshot.json",
  "title": "SemioDrawingSnapshot",
  "description": "Mirrors the real Rust 📸️snapshot/🦀️.rs. Codec: hex-encoded JSON body, semio_format-enveloped text, options-aware ArtifactPack encode/decode.",
  "type": "object",
  "required": ["schema", "canvas", "styles", "layers"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "canvas": { "$ref": "#/$defs/DrawCanvas", "x-semio-state": "artifact" },
    "styles": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "#/$defs/DrawStyle" } },
    "layers": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "#/$defs/DrawLayer" } }
  },
  "$defs": {
    "SemioPoint2": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "Rgba": { "type": "object", "required": ["r", "g", "b", "a"], "properties": { "r": { "type": "number" }, "g": { "type": "number" }, "b": { "type": "number" }, "a": { "type": "number" } } },
    "Point3": { "type": "object", "required": ["x", "y", "z"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } },
    "Quaternion": { "type": "object", "required": ["x", "y", "z", "w"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }, "w": { "type": "number" } } },
    "Transform": { "type": "object", "required": ["translation", "rotation", "scale"], "properties": { "translation": { "$ref": "#/$defs/Point3" }, "rotation": { "$ref": "#/$defs/Quaternion" }, "scale": { "$ref": "#/$defs/Point3" } } },
    "PathSegment": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["moveTo", "lineTo", "cubicTo", "quadTo", "arcTo", "close"] },
        "to": { "$ref": "#/$defs/SemioPoint2" },
        "c1": { "$ref": "#/$defs/SemioPoint2" },
        "c2": { "$ref": "#/$defs/SemioPoint2" },
        "c": { "$ref": "#/$defs/SemioPoint2" },
        "rx": { "type": "number" },
        "ry": { "type": "number" },
        "xRotation": { "type": "number" },
        "largeArc": { "type": "boolean" },
        "sweep": { "type": "boolean" }
      }
    },
    "DrawNode": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["path", "text", "group", "image"] },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/PathSegment" } },
        "style": { "type": "string" },
        "value": { "type": "string" },
        "at": { "$ref": "#/$defs/SemioPoint2" },
        "transform": { "$ref": "#/$defs/Transform" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/DrawNode" } },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "mime": { "type": "string" },
        "bytes": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "DrawStyle": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" }, "fill": { "$ref": "#/$defs/Rgba" }, "stroke": { "$ref": "#/$defs/Rgba" }, "strokeWidth": { "type": "number" }, "opacity": { "type": "number" } }
    },
    "DrawLayer": {
      "type": "object",
      "required": ["id", "name", "visible", "root"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "visible": { "type": "boolean" }, "root": { "$ref": "#/$defs/DrawNode" } }
    },
    "DrawCanvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "type": "number" }, "height": { "type": "number" }, "background": { "$ref": "#/$defs/Rgba" } }
    }
  }
}
