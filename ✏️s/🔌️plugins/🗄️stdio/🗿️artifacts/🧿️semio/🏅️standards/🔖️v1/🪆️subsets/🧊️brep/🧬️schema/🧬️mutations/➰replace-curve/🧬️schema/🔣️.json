{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/mutation/replace-curve.json",
  "title": "ReplaceCurve",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edgeId",
    "newCurve"
  ],
  "properties": {
    "edgeId": {
      "type": "string"
    },
    "newCurve": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Line"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Circle"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Ellipse"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Nurbs"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
