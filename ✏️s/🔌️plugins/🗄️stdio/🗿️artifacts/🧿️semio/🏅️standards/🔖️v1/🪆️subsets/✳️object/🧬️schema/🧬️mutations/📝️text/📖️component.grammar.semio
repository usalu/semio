dialect grammar
grammar semio.object.mutations
extension semio
start document

# `protocol::OpText::print_op`/`parse_op` (`🦀️component.rs`'s `print_object_mutation`/
# `parse_object_mutation`) — `keyword arg=value ...` (space-separated), one keyword per variant.
document = "no-mutation"
          | "set-snapshot" SP "snapshot" "=" snapshot
          | "set-value" SP "path" "=" path SP "value" "=" value
          | "set-map-entry" SP "path" "=" path SP "key" "=" hex SP "value" "=" value
          | "remove-map-entry" SP "path" "=" path SP "key" "=" hex
          | "insert-list-item" SP "path" "=" path SP "index" "=" INT SP "value" "=" value
          | "remove-list-item" SP "path" "=" path SP "index" "=" INT
          | "set-object" SP "id" "=" hex SP "value" "=" value
          | "remove-object" SP "id" "=" hex

# `enc_path`/`dec_path` — a bracketed, comma-separated list of tagged segments: `K[hex(key)]`
# (map key) or `I[index]` (list index).
path = "[" ( path-segment ( "," path-segment )* )? "]"
path-segment = "K" "[" hex "]" | "I" "[" INT "]"

# `enc_semio_snapshot`/`dec_semio_snapshot` — `[hex(schema),value,[objectNode,...]]`.
snapshot = "[" hex "," value "," "[" ( object-node ( "," object-node )* )? "]" "]"
object-node = hex ":" value

# `enc_semio_value`/`dec_semio_value` — restated here (identical to
# ../../🔺️diff/📝️text/📖️component.grammar.semio's `value`) so this leaf grammar is self-contained.
value = "Z" | "B" "[" bit "]" | "I" "[" hex "]" | "F" "[" hex "]" | "S" "[" hex "]" | "Y" "[" hex "]"
      | "L" "[" ( value ( "," value )* )? "]" | "M" "[" ( entry ( "," entry )* )? "]" | "R" "[" hex "]"
entry = hex ":" value
bit = "0" | "1"

hex = ( HEXDIG HEXDIG )*
