module Stdio_semio_cad_diff;

# Real binary `DiffCodec` frame: `format` (1 byte) + `presence` bitmask (1 byte,
# bit0=layers/bit1=blocks/bit2=entities), then one opaque `payload` tail holding 0-3
# varint-length-prefixed text blobs (see the sibling `📡️component.protocol.semio`'s comment).
type Document = unit {
    format: uint8;
    presence: uint8;
    payload: bytes &eod;
};
