{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/mutation/insert-image/schema.json",
  "title": "InsertImage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "image"
  ],
  "properties": {
    "mutation": {
      "const": "insertImage",
      "description": "Aggregate discriminator spliced in by SemioDocumentMutation; absent when the payload stands alone."
    },
    "image": {
      "$ref": "#/$defs/DocImage",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Image",
          "de": "Bild"
        },
        "description": {
          "en": "Id, media type and bytes of the image that is embedded.",
          "de": "Kennung, Medientyp und Bytes des Bildes, das eingebettet wird."
        },
        "group": "value",
        "order": 10
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in list",
          "de": "Position in der Liste"
        },
        "description": {
          "en": "Index the entry is inserted at; absent appends it. Undo of a removal names the removed index.",
          "de": "Index, an dem der Eintrag eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Entfernens nennt den entfernten Index."
        }
      }
    }
  },
  "$defs": {
    "DocImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "mime": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Media type",
              "de": "Medientyp"
            }
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Bytes",
              "de": "Bytes"
            }
          }
        }
      }
    }
  }
}
