; abnf stdio.semio.object snapshot (pack/binary payload)
; payload is UTF-8 tag-prefixed SemioObjectSnapshot text -- see ../📝️text/📖️component.grammar.semio
; for the full grammar; restated here for a self-contained ABNF reading. NOT JSON, NOT hex-of-JSON.
document = "[" hex "," value "," "[" *object-node "]" "]"
object-node = hex ":" value [","]

value = "Z" / ("B" "[" bit "]") / ("I" "[" hex "]") / ("F" "[" hex "]") / ("S" "[" hex "]")
      / ("Y" "[" hex "]") / ("L" "[" *list-item "]") / ("M" "[" *map-item "]") / ("R" "[" hex "]")
list-item = value [","]
map-item = hex ":" value [","]
bit = "0" / "1"
hex = *HEXDIGLC
HEXDIGLC = %x30-39 / %x61-66 ; lowercase hex digits only
