; RFC 5234 ABNF mirror (descriptive, not test-walked — the real byte-level walker is
; ../📡️component.protocol.semio) for the shared `.semio` binary envelope wrapping the REAL
; varint-length-prefixed SemioObjectSnapshot binary pack.
snapshot-pack   = format schema-len schema-bytes payload
format          = OCTET                 ; PACK_BINARY_FORMAT, currently 1
schema-len      = 1*OCTET               ; LEB128 varint
schema-bytes    = *OCTET                ; UTF-8 schema id, length = schema-len
payload         = *OCTET                ; transform (10 f64 LE) + 3 optional child handles
