dialect grammar
grammar semio.animation.diff
extension semio
start document

# animation wave: real one-line `DiffCodec::print_diff`/`parse_diff` shape ALREADY emitted by
# `🔺️diff/🦀️component.rs` (`print_semio_animation_diff`/`parse_semio_animation_diff`) — a single
# optional `timelines{[removed];[modified];[added]}` clause (an unchanged diff prints as the empty
# string), the recipe's own index-keyed collection-triple shape (§1.4), verbatim from
# `engine::triples::enc_indexed_triple`/`dec_indexed_triple`'s real `[r];[m];[a]` wire shape.
#
# UNLIKE the flat one-field-per-line shape workflow/brep/drawing's own diff grammars use, this
# facet's per-item diffs (`AnimTimelineDiff`/`AnimChannelDiff`/`AnimKeyframeDiff`) are SPARSE
# tag-lists — only the fields that actually changed are printed, each as a `TAG:value` entry inside
# a bracket-wrapped, comma-joined list (`enc_timeline_diff`/`enc_channel_diff`/`enc_keyframe_diff`)
# — NOT the flat "every slot present, each itself tri-state" shape those other subsets use. Modeled
# below as an alternation of tagged-field productions repeated 0-or-more times inside brackets.
document = timelines-clause?

timelines-clause = "timelines" "{" "[" removed-list? "]" ";" "[" modified-list? "]" ";" "[" added-list? "]" "}"
removed-list = index {"," index}*
modified-list = timeline-modified {"," timeline-modified}*
timeline-modified = index ":" timeline-diff
added-list = timeline-added {"," timeline-added}*
timeline-added = index ":" timeline

# `enc_timeline_diff` — `[<field>,...]`, each field one of `N:<option-name>` (name changed) or
# `C:[<channels-triple>]` (channels collection changed) — present only if that field actually
# differs, in this fixed order when both are present.
timeline-diff = "[" timeline-diff-items? "]"
timeline-diff-items = timeline-diff-field {"," timeline-diff-field}*
timeline-diff-field = "N" ":" option-name | "C" ":" "[" channels-triple-body "]"
channels-triple-body = "[" channels-removed-list? "]" ";" "[" channel-modified-list? "]" ";" "[" channel-added-list? "]"
channels-removed-list = index {"," index}*
channel-modified-list = channel-modified {"," channel-modified}*
channel-modified = index ":" channel-diff
channel-added-list = channel-added {"," channel-added}*
channel-added = index ":" channel

# `enc_channel_diff` — `[<field>,...]`, `G:<target>` / `I:<interpolation>` /
# `K:[<keyframes-triple>]`.
channel-diff = "[" channel-diff-items? "]"
channel-diff-items = channel-diff-field {"," channel-diff-field}*
channel-diff-field = "G" ":" target | "I" ":" interpolation | "K" ":" "[" keyframes-triple-body "]"
keyframes-triple-body = "[" keyframes-removed-list? "]" ";" "[" keyframe-modified-list? "]" ";" "[" keyframe-added-list? "]"
keyframes-removed-list = index {"," index}*
keyframe-modified-list = keyframe-modified {"," keyframe-modified}*
keyframe-modified = index ":" keyframe-diff
keyframe-added-list = keyframe-added {"," keyframe-added}*
keyframe-added = index ":" keyframe

# `enc_keyframe_diff` — `[<field>,...]`, `T:<number>` (t changed) / `Y:<value>` (value changed).
keyframe-diff = "[" keyframe-diff-items? "]"
keyframe-diff-items = keyframe-diff-field {"," keyframe-diff-field}*
keyframe-diff-field = "T" ":" number | "Y" ":" value

option-name = "[" "0" "]" | "[" "1" "," hex "]"

# `enc_timeline`/`enc_channel`/`enc_keyframe`/`enc_target`/`enc_property`/`enc_interpolation`/
# `enc_value` — the same full-VALUE codecs `📸️snapshot/📝️text/📖️component.grammar.semio` declares
# (restated here so this leaf grammar is self-contained, matching the repo's existing per-facet
# convention).
timeline = "[" option-name "," channel-list "]"
channel-list = "[" channel-items? "]"
channel-items = channel {"," channel}*
channel = "[" target "," interpolation "," keyframe-list "]"
keyframe-list = "[" keyframe-items? "]"
keyframe-items = keyframe {"," keyframe}*
keyframe = "[" number "," value "]"
target = "[" hex "," property "]"
property = "t" | "r" | "s" | "w" | "c" ":" hex
interpolation = "l" | "s" | "c"
value = "S" ":" number | "V" ":" point3 | "Q" ":" quat | "W" ":" number-list

point3 = "[" number "," number "," number "]"
quat = "[" number "," number "," number "," number "]"
number-list = "[" number-items? "]"
number-items = number {"," number}*

index = INT
number = INT | FLOAT

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO — see the sibling `📸️snapshot/📝️text/📖️component.grammar.semio`'s own `hex` doc
# comment for why a hand-rolled `{INT|IDENT}*` production would be wrong here.
