dialect grammar stdio.semio.animation.diff
root = document
document = header body
header = 'schema' SP 'stdio.semio.animation.diff' NL
body = timelines_triple
timelines_triple = 'timelines{' removed ';' modified ';' added '}'
removed = index*
modified = (index ':' timeline_diff)*
added = (index ':' timeline)*
timeline_diff = '[' (name_tristate ',')? (channels_triple)? ']'
