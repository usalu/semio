{
  "$id": "https://semio.tech/schema/s.stdio.semio.video/diff.json",
  "title": "SemioVideoDiff",
  "description": "Sparse diff: streams is an index-keyed removed/modified/added triple; a modified stream's samples is, recursively, the same triple shape.",
  "type": "object",
  "properties": {
    "streams": {
      "title": "SemioVideoStreamsDiff",
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer" } },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": { "type": "integer" },
              "diff": {
                "title": "SemioVideoStreamDiff",
                "type": "object",
                "properties": {
                  "kind": { "enum": ["video", "audio", "subtitle"] },
                  "codec": { "type": "string" },
                  "width": { "type": "integer" },
                  "height": { "type": "integer" },
                  "rate": { "type": "object", "properties": { "num": { "type": "integer" }, "den": { "type": "integer" } } },
                  "samples": {
                    "title": "SemioVideoSamplesDiff",
                    "type": "object",
                    "properties": {
                      "removed": { "type": "array", "items": { "type": "integer" } },
                      "modified": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "index": { "type": "integer" },
                            "diff": {
                              "title": "SemioVideoSampleDiff",
                              "type": "object",
                              "properties": {
                                "pts": { "type": "integer" },
                                "key": { "type": "boolean" },
                                "data": { "type": "string", "contentEncoding": "hex" }
                              }
                            }
                          }
                        }
                      },
                      "added": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "item": { "type": "object" } } } }
                    }
                  }
                }
              }
            }
          }
        },
        "added": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "item": { "type": "object" } } } }
      }
    }
  }
}
