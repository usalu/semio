{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "node",
    "parent"
  ],
  "properties": {
    "parent": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Path"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Text"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Group"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Image"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
