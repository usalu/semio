{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "layer"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "layer": {
      "title": "DrawLayer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "root",
        "visible"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "root": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "Path"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "Text"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "Group"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "Image"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  }
}
