{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/mutation/insert-master/schema.json",
  "title": "InsertMaster",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "master"
  ],
  "properties": {
    "mutation": {
      "const": "insertMaster",
      "description": "Aggregate discriminator spliced in by SemioPresentationMutation; absent when the payload stands alone."
    },
    "master": {
      "$ref": "#/$defs/SlideMaster",
      "x-semio-ui": {
        "label": {
          "en": "Slide master",
          "de": "Folienmaster"
        }
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in list",
          "de": "Position in der Liste"
        },
        "description": {
          "en": "Index the entry is inserted at; absent appends it. Undo of a removal names the removed index.",
          "de": "Index, an dem der Eintrag eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Entfernens nennt den entfernten Index."
        }
      }
    }
  },
  "$defs": {
    "SlideMaster": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/snapshot.json#/definitions/SlideMaster"
    }
  }
}
