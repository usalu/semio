{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/inference.json",
  "title": "SemioAnimationInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "duration"
  ],
  "properties": {
    "duration": {
      "$ref": "#/$defs/SemioAnimationDuration",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "SemioAnimationDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationSeconds",
        "timelineCount",
        "channelCount",
        "keyframeCount"
      ],
      "properties": {
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "timelineCount": {
          "type": "integer",
          "minimum": 0
        },
        "channelCount": {
          "type": "integer",
          "minimum": 0
        },
        "keyframeCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
