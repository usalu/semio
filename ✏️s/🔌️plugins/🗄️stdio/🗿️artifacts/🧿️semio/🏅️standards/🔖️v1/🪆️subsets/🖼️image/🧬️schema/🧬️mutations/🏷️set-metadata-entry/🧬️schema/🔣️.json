{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/mutation/set-metadata-entry/schema.json",
  "title": "SetMetadataEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "key",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setMetadataEntry",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    },
    "key": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Key",
          "de": "Schlüssel"
        },
        "description": {
          "en": "Name of the metadata entry that is set; a new name adds the entry.",
          "de": "Name des Metadateneintrags, der gesetzt wird; ein neuer Name fügt den Eintrag hinzu."
        },
        "group": "target",
        "order": 10
      }
    },
    "value": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Value",
          "de": "Wert"
        },
        "description": {
          "en": "Text the metadata entry holds.",
          "de": "Text, den der Metadateneintrag enthält."
        },
        "group": "value",
        "order": 20
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in list",
          "de": "Position in der Liste"
        },
        "description": {
          "en": "Index the entry is inserted at; absent appends it. Undo of a removal names the removed index.",
          "de": "Index, an dem der Eintrag eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Entfernens nennt den entfernten Index."
        }
      }
    }
  }
}
