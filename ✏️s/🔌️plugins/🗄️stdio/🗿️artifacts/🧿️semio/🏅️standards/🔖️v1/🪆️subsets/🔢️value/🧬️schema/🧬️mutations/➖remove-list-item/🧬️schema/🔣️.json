{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/mutation/remove-list-item/schema.json",
  "title": "RemoveListItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "removeListItem",
      "description": "Aggregate discriminator spliced in by SemioValueMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemioValuePathSegment"
      },
      "x-semio-ui": {
        "label": {
          "en": "Path",
          "de": "Pfad"
        },
        "description": {
          "en": "Map keys and list indices leading from the root to the list; empty for the root.",
          "de": "Zuordnungsschlüssel und Listenindizes von der Wurzel bis zur Liste; leer für die Wurzel."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Item",
          "de": "Element"
        },
        "description": {
          "en": "Index of the list item, counted from 0.",
          "de": "Index des Listenelements, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  },
  "$defs": {
    "SemioValuePathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "key": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
