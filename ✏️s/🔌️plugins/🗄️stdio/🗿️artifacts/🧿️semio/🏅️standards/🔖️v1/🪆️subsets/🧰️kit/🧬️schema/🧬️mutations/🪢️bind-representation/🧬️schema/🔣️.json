{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/kit/mutation/bind-representation/schema.json",
  "title": "BindRepresentation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "pin",
    "role"
  ],
  "properties": {
    "target": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "pin": {
      "$ref": "#/$defs/LinkPin"
    },
    "role": {
      "type": "string"
    }
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "dialect"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "dialect": {
          "$ref": "#/$defs/ArtifactDialect"
        }
      }
    },
    "ArtifactDialect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "subset": {
          "type": "string"
        }
      }
    },
    "LinkPin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "head"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "checkpoint"
            },
            "id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blob"
          ],
          "properties": {
            "kind": {
              "const": "snapshot"
            },
            "blob": {
              "$ref": "#/$defs/BlobRef"
            }
          }
        }
      ]
    },
    "BlobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "size",
        "mediaType"
      ],
      "properties": {
        "hash": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mediaType": {
          "type": "string"
        }
      }
    }
  }
}
