(* ISO-14977-style EBNF for the s.stdio.semio.workflow mutation text wire format
   (SemioWorkflowMutation::print_op/parse_op) -- see the module doc comment on
   🧬️mutations/📝️text/📖️component.grammar.semio. *)
op = 'no-mutation' | keyword, { space, arg } ;
keyword = 'set-snapshot' | 'insert-node' | 'remove-node' | 'set-node-kind' | 'set-node-label'
        | 'set-node-position' | 'set-node-param' | 'remove-node-param' | 'insert-edge'
        | 'remove-edge' | 'set-edge-endpoints' | 'set-edge-kind' ;
arg = name, '=', value ;
name = letter, { letter | '-' } ;
value = printable char, { printable char } ;
