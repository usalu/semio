{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/mutation/change-node-kind/schema.json",
  "title": "ChangeNodeKind",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "new_kind"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/GraphNodeId",
      "x-semio-ui": {
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The node the mutation addresses.",
          "de": "Der Knoten, den die Mutation adressiert."
        },
        "group": "target",
        "order": 10
      }
    },
    "new_kind": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Node kind",
          "de": "Knotenart"
        }
      }
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Node id",
              "de": "Knoten-ID"
            },
            "ref": {
              "kind": "node",
              "domain": "graph",
              "granularity": "node"
            }
          }
        }
      }
    }
  }
}
