{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/image/mutation/set-frame-pixels.json",
  "title": "SetFramePixels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "rgba8"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "rgba8": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "mutation": {
      "const": "setFramePixels",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    }
  }
}
