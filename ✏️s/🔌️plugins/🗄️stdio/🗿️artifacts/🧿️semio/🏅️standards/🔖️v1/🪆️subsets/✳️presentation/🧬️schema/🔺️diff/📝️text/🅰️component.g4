grammar Semio_semio_presentation_diff;
line: (token (WS token)*)? EOF;
token: MASTERS_EQ triple | LAYOUTS_EQ triple | SLIDES_EQ triple;
MASTERS_EQ: 'masters=';
LAYOUTS_EQ: 'layouts=';
SLIDES_EQ: 'slides=';
triple: '[' list ']' ';' '[' list ']' ';' '[' list ']';
list: (ITEM (',' ITEM)*)?;
ITEM: (~[,;\[\]])+;
WS: ' ';
