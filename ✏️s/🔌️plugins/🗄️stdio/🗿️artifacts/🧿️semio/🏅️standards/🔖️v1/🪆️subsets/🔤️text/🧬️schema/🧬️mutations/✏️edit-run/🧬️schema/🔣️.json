{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/text/mutation/edit-run/schema.json",
  "title": "EditRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "new_content"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Run",
          "de": "Textlauf"
        },
        "description": {
          "en": "Index of the run, counted from 0.",
          "de": "Index des Textlaufs, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "new_content": {
      "type": "string",
      "x-semio-ui": {
        "widget": "multiline",
        "label": {
          "en": "Text",
          "de": "Text"
        }
      }
    }
  }
}
