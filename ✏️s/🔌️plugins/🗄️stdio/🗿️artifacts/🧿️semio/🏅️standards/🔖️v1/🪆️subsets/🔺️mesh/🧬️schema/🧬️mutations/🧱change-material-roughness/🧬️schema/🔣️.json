{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/mutation/change-material-roughness/schema.json",
  "title": "ChangeMaterialRoughness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "new_roughness"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Material",
          "de": "Material"
        },
        "description": {
          "en": "Id of the material.",
          "de": "Kennung des Materials."
        },
        "ref": {
          "kind": "material"
        },
        "group": "target",
        "order": 10
      }
    },
    "new_roughness": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "label": {
          "en": "Roughness",
          "de": "Rauheit"
        },
        "description": {
          "en": "PBR roughness, 0 smooth to 1 rough.",
          "de": "PBR-Rauheit, 0 glatt bis 1 rau."
        },
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1
      }
    }
  }
}
