{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/mutation/change-material-roughness/schema.json",
  "title": "ChangeMaterialRoughness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "new_roughness"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "new_roughness": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Roughness",
          "de": "Rauheit"
        },
        "description": {
          "en": "PBR roughness, 0 smooth to 1 rough.",
          "de": "PBR-Rauheit, 0 glatt bis 1 rau."
        }
      }
    }
  }
}
