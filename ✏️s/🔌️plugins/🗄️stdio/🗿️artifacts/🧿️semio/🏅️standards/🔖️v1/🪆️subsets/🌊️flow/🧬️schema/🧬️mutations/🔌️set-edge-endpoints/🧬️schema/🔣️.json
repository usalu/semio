{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/flow/mutation/set-edge-endpoints.json",
  "title": "SetEdgeEndpoints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "from",
    "to"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "from": {
      "$ref": "#/$defs/PortRef"
    },
    "to": {
      "$ref": "#/$defs/PortRef"
    },
    "mutation": {
      "const": "setEdgeEndpoints",
      "description": "Aggregate discriminator spliced in by SemioFlowMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "PortRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "port"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      }
    }
  }
}
