{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/mutation/insert-keyframe/schema.json",
  "title": "InsertKeyframe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "timelineIndex",
    "channelIndex",
    "index",
    "keyframe"
  ],
  "properties": {
    "mutation": {
      "const": "insertKeyframe",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    },
    "timelineIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Timeline",
          "de": "Zeitleiste"
        },
        "description": {
          "en": "Index of the timeline, counted from 0.",
          "de": "Index der Zeitleiste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "channelIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Channel",
          "de": "Kanal"
        },
        "description": {
          "en": "Index of the channel within the timeline, counted from 0.",
          "de": "Index des Kanals innerhalb der Zeitleiste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the keyframes of the channel at which it is inserted, counted from 0.",
          "de": "Position unter den Schlüsselbildern des Kanals, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 30
      }
    },
    "keyframe": {
      "$ref": "#/$defs/AnimKeyframe",
      "x-semio-ui": {
        "label": {
          "en": "Keyframe",
          "de": "Schlüsselbild"
        }
      }
    }
  },
  "$defs": {
    "AnimKeyframe": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/snapshot.json#/definitions/AnimKeyframe"
    }
  }
}
