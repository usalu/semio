{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/mutation/insert-keyframe/schema.json",
  "title": "InsertKeyframe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timelineIndex",
    "channelIndex",
    "index",
    "keyframe"
  ],
  "properties": {
    "timelineIndex": {
      "type": "integer",
      "minimum": 0
    },
    "channelIndex": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "keyframe": {
      "$ref": "#/$defs/AnimKeyframe"
    },
    "mutation": {
      "const": "insertKeyframe",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "AnimKeyframe": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/snapshot.json#/definitions/AnimKeyframe"
    }
  }
}
