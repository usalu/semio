{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/mutation/add-node-port/schema.json",
  "title": "AddNodePort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "index",
    "port"
  ],
  "properties": {
    "node_id": {
      "$ref": "#/$defs/GraphNodeId"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "port": {
      "$ref": "#/$defs/SemioGraphPort",
      "x-semio-ui": {
        "label": {
          "en": "Port",
          "de": "Port"
        }
      }
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "SemioGraphPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "category",
        "properties"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SemioGraphPortKind",
          "x-semio-ui": {
            "options": {
              "in": {
                "en": "Input",
                "de": "Eingang"
              },
              "out": {
                "en": "Output",
                "de": "Ausgang"
              },
              "inOut": {
                "en": "Input and output",
                "de": "Ein- und Ausgang"
              }
            }
          }
        },
        "category": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/snapshot.json#/$defs/SemioValueEntry"
          }
        }
      }
    },
    "SemioGraphPortKind": {
      "type": "string",
      "enum": [
        "in",
        "out",
        "inOut"
      ]
    }
  }
}
