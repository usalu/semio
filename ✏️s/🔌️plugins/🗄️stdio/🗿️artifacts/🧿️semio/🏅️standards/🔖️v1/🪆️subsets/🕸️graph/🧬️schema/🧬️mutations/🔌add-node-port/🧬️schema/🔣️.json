{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/mutation/add-node-port/schema.json",
  "title": "AddNodePort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "index",
    "port"
  ],
  "properties": {
    "node_id": {
      "$ref": "#/$defs/GraphNodeId",
      "x-semio-ui": {
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The node the mutation addresses.",
          "de": "Der Knoten, den die Mutation adressiert."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the ports of the node at which it is inserted, counted from 0.",
          "de": "Position unter den Anschlüssen des Knotens, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "port": {
      "$ref": "#/$defs/SemioGraphPort",
      "x-semio-ui": {
        "label": {
          "en": "Port",
          "de": "Port"
        }
      }
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Node id",
              "de": "Knoten-ID"
            },
            "ref": {
              "kind": "node",
              "domain": "graph",
              "granularity": "node"
            }
          }
        }
      }
    },
    "SemioGraphPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "category",
        "properties"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SemioGraphPortKind",
          "x-semio-ui": {
            "options": {
              "in": {
                "en": "Input",
                "de": "Eingang"
              },
              "out": {
                "en": "Output",
                "de": "Ausgang"
              },
              "inOut": {
                "en": "Input and output",
                "de": "Ein- und Ausgang"
              }
            }
          }
        },
        "category": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Category",
              "de": "Kategorie"
            },
            "description": {
              "en": "Category of the port, as the graph's manifest names it.",
              "de": "Kategorie des Anschlusses, wie sie das Manifest des Graphen benennt."
            }
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/snapshot.json#/$defs/SemioValueEntry"
          }
        }
      }
    },
    "SemioGraphPortKind": {
      "type": "string",
      "enum": [
        "in",
        "out",
        "inOut"
      ]
    }
  }
}
