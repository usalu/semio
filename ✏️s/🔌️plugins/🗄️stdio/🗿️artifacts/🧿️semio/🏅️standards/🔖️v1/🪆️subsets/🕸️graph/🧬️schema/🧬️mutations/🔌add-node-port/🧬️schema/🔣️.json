{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/graph/mutation/add-node-port/schema.json",
  "title": "AddNodePort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "index",
    "port"
  ],
  "properties": {
    "node_id": {
      "$ref": "#/$defs/GraphNodeId"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "port": {
      "$ref": "#/$defs/SemioGraphPort"
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "SemioGraphPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SemioGraphPortKind"
        }
      }
    },
    "SemioGraphPortKind": {
      "type": "string",
      "enum": [
        "in",
        "out",
        "inOut"
      ]
    }
  }
}
