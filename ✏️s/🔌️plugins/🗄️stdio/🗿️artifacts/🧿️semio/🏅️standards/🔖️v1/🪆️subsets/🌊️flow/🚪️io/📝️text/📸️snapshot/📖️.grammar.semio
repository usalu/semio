dialect grammar
grammar stdio.semio.flow.snapshot
extension semio
start document

# Grammar of `SemioFlowSnapshot::print_dsl`/`parse_dsl` (`🦀️.rs`: `print_flow_snapshot_body`/
# `parse_flow_snapshot_body`). One `schema=`, `nodes=[...]` and `edges=[...]` line each; every string
# leaf (`schema`, node and edge `id`/`kind`/`label`/`key`/`value`, port `node`/`port`) is lowercase-hex
# UTF-8 bytes, matching this subset's `🔺️diff` and `🧬️mutations` grammars.
#
# `document` is the body the preamble `semio stdio.semio.flow.dsl v1` introduces, with the preamble
# replaced by the bare `artifact-mark` token before recognition.
artifact-mark = "stdio.semio.flow"
document = artifact-mark schema-line nodes-line edges-line

schema-line = "schema" "=" hex

nodes-line = "nodes" "=" "[" node-list? "]"
node-list = node {"," node}*
node = "[" hex "," hex "," hex "," "[" param-list? "]" "," "[" number "," number "]" "]"
param-list = param {"," param}*
param = "[" hex "," hex "]"

edges-line = "edges" "=" "[" edge-list? "]"
edge-list = edge {"," edge}*
edge = "[" hex "," port "," port "," hex "]"
port = "[" hex "," hex "]"

# Finite binary64 values retain their Rust decimal display. Nonfinite values use inf/-inf
# or nan64_ followed by exactly sixteen hexadecimal bits; the codec validates NaN class.
number = INT | FLOAT | IDENT | "-" "inf"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO (`📖️grammar/🦀️.rs`'s `default_macros`) — every `id`/`kind`/`label`/`key`/
# `value`/`node`/`port`/`schema` leaf string is `enc_str` (lowercase-hex UTF-8 bytes). A hand-rolled
# `{INT|IDENT}*` production would be wrong here (see the sibling `🔺️diff`/`🧬️mutations` grammars'
# own `hex` doc comment for the two independent reasons why) — `Symbol::Ref`'s production→macro
# fallback resolves bare `hex` automatically, with real backtracking.
