dialect protocol
protocol stdio.semio.flow.mutations
version 1
schema stdio.semio.flow
start body
framing record

# Real `SemioFlowMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value ...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record insert-node tag=1
field payload bytes
record remove-node tag=2
field payload bytes
record set-node-kind tag=3
field payload bytes
record set-node-label tag=4
field payload bytes
record set-node-position tag=5
field payload bytes
record set-node-param tag=6
field payload bytes
record remove-node-param tag=7
field payload bytes
record insert-edge tag=8
field payload bytes
record remove-edge tag=9
field payload bytes
record set-edge-endpoints tag=10
field payload bytes
record set-edge-kind tag=11
field payload bytes
