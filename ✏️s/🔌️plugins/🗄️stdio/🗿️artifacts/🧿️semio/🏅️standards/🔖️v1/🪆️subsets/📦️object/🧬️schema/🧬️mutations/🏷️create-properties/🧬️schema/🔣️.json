{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/object/mutation/create-properties/schema.json",
  "title": "CreateProperties",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "child_id",
    "target"
  ],
  "properties": {
    "child_id": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "$defs": {
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "dialect"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "dialect": {
          "$ref": "#/$defs/ArtifactDialect"
        }
      }
    },
    "ArtifactDialect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "subset": {
          "type": "string"
        }
      }
    }
  }
}
