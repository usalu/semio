{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/flow/mutation/set-node-param/schema.json",
  "title": "SetNodeParam",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "key",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setNodeParam",
      "description": "Aggregate discriminator spliced in by SemioFlowMutation; absent when the payload stands alone."
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "Id of the node.",
          "de": "Kennung des Knotens."
        },
        "ref": {
          "kind": "node"
        },
        "group": "target",
        "order": 10
      }
    },
    "key": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Parameter",
          "de": "Parameter"
        },
        "description": {
          "en": "Name of the node parameter.",
          "de": "Name des Knotenparameters."
        },
        "group": "target",
        "order": 20
      }
    },
    "value": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Value",
          "de": "Wert"
        },
        "description": {
          "en": "Text form of the value the parameter takes.",
          "de": "Textform des Werts, den der Parameter erhält."
        },
        "group": "value",
        "order": 30
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in list",
          "de": "Position in der Liste"
        },
        "description": {
          "en": "Index the entry is inserted at; absent appends it. Undo of a removal names the removed index.",
          "de": "Index, an dem der Eintrag eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Entfernens nennt den entfernten Index."
        }
      }
    }
  }
}
