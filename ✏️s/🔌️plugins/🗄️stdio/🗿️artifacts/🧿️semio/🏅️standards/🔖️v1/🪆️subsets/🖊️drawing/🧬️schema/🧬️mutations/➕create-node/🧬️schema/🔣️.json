{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/create-node/schema.json",
  "title": "CreateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent",
    "index",
    "node"
  ],
  "properties": {
    "parent": {
      "$ref": "#/$defs/NodePath",
      "x-semio-ui": {
        "label": {
          "en": "Parent",
          "de": "Übergeordneter Knoten"
        },
        "description": {
          "en": "Layer index and child indices of the group (or the layer itself) that holds the nodes, each counted from 0.",
          "de": "Ebenenindex und Kindindizes der Gruppe (oder der Ebene selbst), die die Knoten enthält, jeweils ab 0 gezählt."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the children of the parent at which it is inserted, counted from 0.",
          "de": "Position unter den Kindknoten des übergeordneten Knotens, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "node": {
      "$ref": "#/$defs/DrawNode",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The shape, path, text, image or group that is created.",
          "de": "Die Form, der Pfad, der Text, das Bild oder die Gruppe, die erstellt wird."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "DrawNode": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/snapshot.json#/$defs/DrawNode"
    }
  }
}
