{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/create-node/schema.json",
  "title": "CreateNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent",
    "index",
    "node"
  ],
  "properties": {
    "parent": {
      "$ref": "#/$defs/NodePath"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "node": {
      "$ref": "#/$defs/DrawNode"
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "DrawNode": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/snapshot.json#/$defs/DrawNode"
    }
  }
}
