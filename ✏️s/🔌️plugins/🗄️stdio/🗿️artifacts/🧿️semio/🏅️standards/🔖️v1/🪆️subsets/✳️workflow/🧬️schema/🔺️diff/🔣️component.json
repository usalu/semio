{
  "$id": "https://semio.tech/schema/s.stdio.semio.workflow/diff.json",
  "title": "SemioWorkflowDiff",
  "description": "🔺️ Real facet mirror of 🦀️component.rs — sparse name-keyed triple diff over nodes/edges.",
  "type": "object",
  "definitions": {
    "SemioPoint2": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "PortRef": { "type": "object", "properties": { "node": { "type": "string" }, "port": { "type": "string" } } },
    "WorkflowParam": { "type": "object", "properties": { "key": { "type": "string" }, "value": { "type": "string" } } },
    "WorkflowNode": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/definitions/WorkflowParam" } },
        "position": { "$ref": "#/definitions/SemioPoint2" }
      }
    },
    "WorkflowEdge": {
      "type": "object",
      "properties": { "id": { "type": "string" }, "from": { "$ref": "#/definitions/PortRef" }, "to": { "$ref": "#/definitions/PortRef" }, "kind": { "type": "string" } }
    },
    "WorkflowParamDiff": { "type": "object", "properties": { "value": { "type": "string" } } },
    "WorkflowParamsDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "string" } },
        "modified": { "type": "array", "items": { "type": "object", "properties": { "key": { "type": "string" }, "diff": { "$ref": "#/definitions/WorkflowParamDiff" } } } },
        "added": { "type": "array", "items": { "$ref": "#/definitions/WorkflowParam" } }
      }
    },
    "WorkflowNodeDiff": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "params": { "$ref": "#/definitions/WorkflowParamsDiff" },
        "position": { "$ref": "#/definitions/SemioPoint2" }
      }
    },
    "WorkflowNodesDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "string" } },
        "modified": { "type": "array", "items": { "type": "object", "properties": { "key": { "type": "string" }, "diff": { "$ref": "#/definitions/WorkflowNodeDiff" } } } },
        "added": { "type": "array", "items": { "$ref": "#/definitions/WorkflowNode" } }
      }
    },
    "WorkflowEdgeDiff": {
      "type": "object",
      "properties": { "from": { "$ref": "#/definitions/PortRef" }, "to": { "$ref": "#/definitions/PortRef" }, "kind": { "type": "string" } }
    },
    "WorkflowEdgesDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "string" } },
        "modified": { "type": "array", "items": { "type": "object", "properties": { "key": { "type": "string" }, "diff": { "$ref": "#/definitions/WorkflowEdgeDiff" } } } },
        "added": { "type": "array", "items": { "$ref": "#/definitions/WorkflowEdge" } }
      }
    }
  },
  "properties": {
    "nodes": { "$ref": "#/definitions/WorkflowNodesDiff", "x-semio-state": "persistent" },
    "edges": { "$ref": "#/definitions/WorkflowEdgesDiff", "x-semio-state": "persistent" }
  }
}
