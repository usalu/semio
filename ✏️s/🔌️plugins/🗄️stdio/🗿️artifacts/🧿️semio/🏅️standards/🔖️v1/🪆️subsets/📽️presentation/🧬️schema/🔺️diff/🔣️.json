    "NamedTripleDiff": { "type": "object", "properties": { "removed": { "type": "array" }, "modified": { "type": "array" }, "added": { "type": "array" } } },
    "SlideFrameDiff": { "type": "object", "properties": { "origin": { "type": "object" }, "width": { "type": "number" }, "height": { "type": "number" } } },
