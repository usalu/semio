{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/mutation/remove-map-entry/schema.json",
  "title": "RemoveMapEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "key"
  ],
  "properties": {
    "mutation": {
      "const": "removeMapEntry",
      "description": "Aggregate discriminator spliced in by SemioValueMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemioValuePathSegment"
      },
      "x-semio-ui": {
        "label": {
          "en": "Path",
          "de": "Pfad"
        },
        "description": {
          "en": "Map keys and list indices leading from the root to the map; empty for the root.",
          "de": "Zuordnungsschlüssel und Listenindizes von der Wurzel bis zur Zuordnung; leer für die Wurzel."
        },
        "group": "target",
        "order": 10
      }
    },
    "key": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Key",
          "de": "Schlüssel"
        },
        "description": {
          "en": "Key of the map entry.",
          "de": "Schlüssel des Zuordnungseintrags."
        },
        "group": "target",
        "order": 20
      }
    }
  },
  "$defs": {
    "SemioValuePathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "key": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
