{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/value/mutation/remove-map-entry.json",
  "title": "RemoveMapEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "key"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemioValuePathSegment"
      }
    },
    "key": {
      "type": "string"
    },
    "kind": {
      "const": "removeMapEntry",
      "description": "Aggregate discriminator spliced in by SemioValuePathSegment; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioValuePathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "key": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
