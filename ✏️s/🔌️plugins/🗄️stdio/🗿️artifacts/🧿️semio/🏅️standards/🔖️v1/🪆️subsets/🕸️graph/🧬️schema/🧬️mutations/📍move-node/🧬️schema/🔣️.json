{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/graph/mutation/move-node/schema.json",
  "title": "MoveNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "new_position"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/GraphNodeId"
    },
    "new_position": {
      "$ref": "#/$defs/SemioPoint2"
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "SemioPoint2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
