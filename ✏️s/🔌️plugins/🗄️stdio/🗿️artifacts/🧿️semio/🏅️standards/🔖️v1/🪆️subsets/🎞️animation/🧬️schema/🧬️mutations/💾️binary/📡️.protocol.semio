dialect protocol
protocol stdio.semio.animation.mutations
version 1
schema stdio.semio.animation
start body
framing record

# Real `SemioAnimationMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value,...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record insert-timeline tag=1
field payload bytes
record remove-timeline tag=2
field payload bytes
record set-timeline-name tag=3
field payload bytes
record insert-channel tag=4
field payload bytes
record remove-channel tag=5
field payload bytes
record set-channel-target tag=6
field payload bytes
record set-channel-interpolation tag=7
field payload bytes
record insert-keyframe tag=8
field payload bytes
record remove-keyframe tag=9
field payload bytes
record set-keyframe-time tag=10
field payload bytes
record set-keyframe-value tag=11
field payload bytes
