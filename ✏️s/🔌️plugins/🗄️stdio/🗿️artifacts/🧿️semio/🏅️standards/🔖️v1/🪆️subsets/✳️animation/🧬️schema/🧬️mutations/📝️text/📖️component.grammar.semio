dialect grammar stdio.semio.animation.mutations
root = document
document = header body
header = 'schema' SP 'stdio.semio.animation.mutations' NL
body = op
op = 'N' / ('S:' hex) / ('IT:' index ',' timeline) / ('RT:' index) / ('TN:' index ',' option) / ('IC:' index ',' index ',' channel) / ('RC:' index ',' index) / ('CT:' index ',' index ',' target) / ('CI:' index ',' index ',' interpolation) / ('IK:' index ',' index ',' index ',' keyframe) / ('RK:' index ',' index ',' index) / ('KT:' index ',' index ',' index ',' f64) / ('KV:' index ',' index ',' index ',' value)
