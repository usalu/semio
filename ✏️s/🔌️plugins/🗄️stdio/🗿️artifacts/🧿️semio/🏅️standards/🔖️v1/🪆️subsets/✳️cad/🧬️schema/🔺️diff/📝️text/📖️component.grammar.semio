dialect grammar stdio.semio.cad.diff
root = document
; `protocol::DiffCodec::print_diff`/`parse_diff` grammar for `SemioCadDiff` -- NO semio envelope
; (unlike the snapshot facet): this diff type does not implement ArtifactDsl/ArtifactPack, only
; DiffCodec, and `encode_diff` is simply `print_diff().into_bytes()` (same simplification
; gif/svg/bcf use) -- so this text grammar IS the binary grammar too (see
; ../💾️binary/📡️component.protocol.semio, byte-identical structure).
document = [ token *( SP token ) ]
token = ("layers=" layers-triple) / ("blocks=" blocks-triple) / ("entities=" entities-triple)

layers-triple = "[" removed-keys "]" ";" "[" layers-modified "]" ";" "[" layers-added "]"
layers-modified = [ layer-mod *( "," layer-mod ) ]
layer-mod = hexstr ":" layer-diff
layers-added = [ layer *( "," layer ) ]

blocks-triple = "[" removed-keys "]" ";" "[" blocks-modified "]" ";" "[" blocks-added "]"
blocks-modified = [ block-mod *( "," block-mod ) ]
block-mod = hexstr ":" block-diff
blocks-added = [ block *( "," block ) ]

entities-triple = "[" removed-keys "]" ";" "[" entities-modified "]" ";" "[" entities-added "]"
entities-modified = [ entity-record-mod *( "," entity-record-mod ) ]
entity-record-mod = hexstr ":" entity-record-diff
entities-added = [ entity-record *( "," entity-record ) ]

removed-keys = [ hexstr *( "," hexstr ) ]

; --- option / tri-state: "[0]" = None, "[1,<T>]" = Some(T) ---
option-i32 = "[0]" / ( "[1," i32 "]" )
option-str = "[0]" / ( "[1," hexstr "]" )
option-bool = "[0]" / ( "[1," bool01 "]" )
option-point2 = "[0]" / ( "[1," point2 "]" )
option-entity = "[0]" / ( "[1," entity "]" )
option-entities-triple = "[0]" / ( "[1," entities-triple "]" )

; --- diff-values (used inside *-mod entries above) ---
layer-diff = "[" option-i32 "," option-str "," option-bool "]"
entity-record-diff = "[" option-str "," option-entity "]"
block-diff = "[" option-point2 "," option-entities-triple "]"

; --- full values (used inside *-added lists above) ---
layer = "[" hexstr "," i32 "," hexstr "," bool01 "]"
entity-record = "[" hexstr "," hexstr "," entity "]"
entity-record-list = "[" [ entity-record *( "," entity-record ) ] "]"
block = "[" hexstr "," point2 "," entity-record-list "]"

; --- entity: 9-variant tagged union, single-letter tag prefix ---
entity = line / arc / circle / ellipse / polyline / text-entity / insert / solid / dimension
line = "L[" point2 "," point2 "]"
arc = "A[" point2 "," f64 "," f64 "," f64 "]"
circle = "C[" point2 "," f64 "]"
ellipse = "E[" point2 "," point2 "," f64 "," f64 "," f64 "]"
polyline = "P[" point2-list "," bool01 "]"
point2-list = "[" [ point2 *( "," point2 ) ] "]"
text-entity = "T[" point2 "," f64 "," f64 "," hexstr "]"
insert = "I[" hexstr "," point2 "," point2 "," f64 "]"
solid = "S[" point2 "," point2 "," point2 "," point2 "]"
dimension = "D[" point2 "," point2 "," f64 "," hexstr "]"

; --- primitives ---
point2 = "[" f64 "," f64 "]"
hexstr = *HEXDIG                    ; hex(utf8(s)), even length
i32 = ["-"] 1*DIGIT
f64 = ["-"] 1*DIGIT ["." 1*DIGIT] [("e"/"E") ["+"/"-"] 1*DIGIT]
bool01 = "0" / "1"
