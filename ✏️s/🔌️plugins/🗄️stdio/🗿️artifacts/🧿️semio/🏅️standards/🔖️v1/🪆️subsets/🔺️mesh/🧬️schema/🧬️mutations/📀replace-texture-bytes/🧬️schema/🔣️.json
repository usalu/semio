{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/mutation/replace-texture-bytes/schema.json",
  "title": "ReplaceTextureBytes",
  "type": "object",
  "additionalProperties": false,
