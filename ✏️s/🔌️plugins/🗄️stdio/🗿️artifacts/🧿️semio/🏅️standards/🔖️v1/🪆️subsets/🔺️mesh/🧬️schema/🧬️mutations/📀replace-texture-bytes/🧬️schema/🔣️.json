    "new_bytes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Texture",
          "de": "Textur"
        },
        "description": {
          "en": "Id of the texture.",
          "de": "Kennung der Textur."
        },
        "ref": {
          "kind": "texture"
        },
        "group": "target",
        "order": 10
      }
    },
    "new_bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "x-semio-ui": {
        "label": {
          "en": "Bytes",
          "de": "Bytes"
