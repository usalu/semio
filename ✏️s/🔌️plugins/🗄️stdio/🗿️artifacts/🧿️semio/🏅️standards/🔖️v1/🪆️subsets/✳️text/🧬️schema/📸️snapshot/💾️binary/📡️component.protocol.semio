dialect protocol
protocol s.stdio.semio.text.snapshot
version 1
schema s.stdio.semio.text
start body
framing record

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM text wave: real binary pack frame. `format u8` (real, fixed)
# then `schema_len`/`schema_bytes` (real, varint-length-prefixed UTF-8 — matches `write_str_lp`'s
# own wire exactly) are genuinely, fully described. Past that, `runs` (a HOMOGENEOUS but
# variable-length repeated record: per-run varint-length-prefixed language/content strings plus a
# nested variable-length marks list) is modeled as one opaque trailing `payload` chain — the
# `protocol-array-of-records` gap every sibling subset's own protocol description uses at this same
# boundary. The real Rust `encode_text_snapshot_binary`/`decode_text_snapshot_binary`
# (`../../🦀️component.rs`) stays genuinely, fully structured (varint counts, per-field
# length-prefixes) — round-trip tested independently by this facet's own tests, only the protocol
# DESCRIPTION stops at this boundary.
header fixed 1
field format u8

segment schema_len varint
segment schema_bytes Array(u8, Field(schema_len))

chain payload bytes
