{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/snapshot.json",
  "title": "SemioModelSnapshot",
  "description": "Spatial hierarchy (site/building/storey/space) + elements + relations, from ifc/4.",
  "type": "object",
  "required": [
    "schema",
    "spatial",
    "elements",
    "relations"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "spatial": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "placement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "site",
              "building",
              "storey",
              "space"
            ],
            "x-semio-ui": {
              "options": {
                "site": {
                  "en": "Site",
                  "de": "Grundstück"
                },
                "building": {
                  "en": "Building",
                  "de": "Gebäude"
                },
                "storey": {
                  "en": "Storey",
                  "de": "Geschoss"
                },
                "space": {
                  "en": "Space",
                  "de": "Raum"
                }
              }
            }
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "placement": {
            "$ref": "#/definitions/transform"
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Spatial structure",
          "de": "Räumliche Struktur"
        },
        "description": {
          "en": "Site, building, storey and space hierarchy.",
          "de": "Hierarchie aus Grundstück, Gebäude, Geschoss und Raum."
        }
      }
    },
    "elements": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "placement",
          "geometry",
          "psets"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "class": {
            "$ref": "#/$defs/ElementClass",
            "x-semio-ui": {
              "label": {
                "en": "Element class",
                "de": "Elementklasse"
              }
            }
          },
          "placement": {
            "$ref": "#/definitions/transform"
          },
          "geometry": {
            "$ref": "#/$defs/GeometryRef",
            "x-semio-ui": {
              "label": {
                "en": "Geometry",
                "de": "Geometrie"
              }
            }
          },
          "spatialId": {
            "type": [
              "string",
              "null"
            ],
            "x-semio-ui": {
              "widget": "reference",
              "role": "target",
              "label": {
                "en": "Spatial container",
                "de": "Räumlicher Container"
              },
              "description": {
                "en": "Spatial structure node that contains the element.",
                "de": "Knoten der räumlichen Struktur, der das Element enthält."
              },
              "ref": {
                "kind": "spatialNode"
              }
            }
          },
          "psets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "properties"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "properties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "value"
                    ],
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "value": {
                        "$ref": "#/$defs/PsetValue"
                      }
                    }
                  }
                }
              }
            },
            "x-semio-ui": {
              "label": {
                "en": "Property sets",
                "de": "Eigenschaftssätze"
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Elements",
          "de": "Elemente"
        }
      }
    },
    "relations": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/RelationKind"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Relations",
          "de": "Beziehungen"
        }
      }
    }
  },
  "$defs": {
    "ElementClass": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "wall",
            "slab",
            "column",
            "beam",
            "door",
            "window",
            "roof",
            "stair",
            "furniture",
            "other"
          ],
          "x-semio-ui": {
            "options": {
              "wall": {
                "en": "Wall",
                "de": "Wand"
              },
              "slab": {
                "en": "Slab",
                "de": "Decke"
              },
              "column": {
                "en": "Column",
                "de": "Stütze"
              },
              "beam": {
                "en": "Beam",
                "de": "Träger"
              },
              "door": {
                "en": "Door",
                "de": "Tür"
              },
              "window": {
                "en": "Window",
                "de": "Fenster"
              },
              "roof": {
                "en": "Roof",
                "de": "Dach"
              },
              "stair": {
                "en": "Stair",
                "de": "Treppe"
              },
              "furniture": {
                "en": "Furniture",
                "de": "Möbel"
              },
              "other": {
                "en": "Other",
                "de": "Sonstiges"
              }
            }
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "GeometryRef": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "none",
            "brep",
            "mesh"
          ],
          "x-semio-ui": {
            "options": {
              "none": {
                "en": "None",
                "de": "Keine"
              },
              "brep": {
                "en": "B-rep",
                "de": "B-Rep"
              }
            }
          }
        },
        "brepId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "B-rep",
              "de": "B-Rep"
            },
            "ref": {
              "kind": "brep"
            }
          }
        },
        "meshId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Mesh",
              "de": "Netz"
            },
            "ref": {
              "kind": "mesh"
            }
          }
        }
      }
    },
    "PsetValue": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "text",
            "number",
            "boolean"
          ],
          "x-semio-ui": {
            "options": {
              "number": {
                "en": "Number",
                "de": "Zahl"
              },
              "boolean": {
                "en": "Boolean",
                "de": "Wahrheitswert"
              }
            }
          }
        },
        "value": {}
      }
    },
    "RelationKind": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "aggregates",
            "containedIn",
            "connectsTo",
            "fillsVoid",
            "voidsElement",
            "other"
          ],
          "x-semio-ui": {
            "options": {
              "aggregates": {
                "en": "Aggregates",
                "de": "Aggregiert"
              },
              "containedIn": {
                "en": "Contained in",
                "de": "Enthalten in"
              },
              "connectsTo": {
                "en": "Connects to",
                "de": "Verbunden mit"
              },
              "fillsVoid": {
                "en": "Fills opening",
                "de": "Füllt Öffnung"
              },
              "voidsElement": {
                "en": "Opens element",
                "de": "Öffnet Bauteil"
              },
              "other": {
                "en": "Other",
                "de": "Sonstige"
              }
            }
          }
        },
        "label": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "point3": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "quaternion": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "W",
              "de": "W"
            },
            "description": {
              "en": "Scalar part of the rotation quaternion.",
              "de": "Skalarteil des Rotationsquaternions."
            }
          }
        }
      }
    },
    "transform": {
      "type": "object",
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/definitions/point3",
          "x-semio-ui": {
            "label": {
              "en": "Translation",
              "de": "Verschiebung"
            }
          }
        },
        "rotation": {
          "$ref": "#/definitions/quaternion"
        },
        "scale": {
          "$ref": "#/definitions/point3"
        }
      }
    }
  }
}
