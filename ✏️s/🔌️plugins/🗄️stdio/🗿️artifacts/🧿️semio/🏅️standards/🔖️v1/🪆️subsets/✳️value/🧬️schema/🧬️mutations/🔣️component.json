{
  "$id": "https://semio.tech/schema/s.stdio.semio.value/mutations.json",
  "title": "SemioValueMutation",
  "description": "Named-variant mutation vocabulary — mirrors the 🦀️component.rs sibling's real fields.",
  "$defs": {
    "valueId": { "type": "value", "properties": { "value": { "type": "string" } } },
    "semioValuePathSegment": {
      "type": "value",
      "properties": { "kind": { "enum": ["key", "index"] }, "key": { "type": "string" }, "index": { "type": "integer" } }
    }
  },
  "type": "value",
  "properties": {
    "mutation": { "enum": ["setSnapshot", "setValue", "setMapEntry", "removeMapEntry", "insertListItem", "removeListItem", "setNode", "removeNode"] },
    "snapshot": { "type": "value" },
    "path": { "type": "array", "items": { "$ref": "#/$defs/semioValuePathSegment" } },
    "value": {},
    "key": { "type": "string" },
    "index": { "type": "integer" },
    "id": { "$ref": "#/$defs/valueId" }
  },
  "required": ["mutation"]
}
