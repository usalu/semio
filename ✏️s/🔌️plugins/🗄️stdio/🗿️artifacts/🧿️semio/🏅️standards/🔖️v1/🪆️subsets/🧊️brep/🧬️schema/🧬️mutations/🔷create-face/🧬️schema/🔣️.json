{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/mutation/create-face/schema.json",
  "title": "CreateFace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "outer_loop",
    "surface",
    "orientation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "outer_loop": {
      "type": "string"
    },
    "inner_loops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface": {
      "$ref": "#/$defs/BrepSurface"
    },
    "orientation": {
      "type": "boolean"
    }
  },
  "$defs": {
    "BrepSurface": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "normal"
          ],
          "properties": {
            "kind": {
              "const": "plane"
            },
            "origin": {
              "$ref": "#/$defs/SemioPoint3"
            },
            "normal": {
              "$ref": "#/$defs/SemioPoint3"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "axis",
            "radius"
          ],
          "properties": {
            "kind": {
              "const": "cylinder"
            },
            "origin": {
              "$ref": "#/$defs/SemioPoint3"
            },
            "axis": {
              "$ref": "#/$defs/SemioPoint3"
            },
            "radius": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "origin",
            "axis",
            "radius",
            "halfAngle"
          ],
          "properties": {
            "kind": {
              "const": "cone"
            },
            "origin": {
              "$ref": "#/$defs/SemioPoint3"
            },
            "axis": {
              "$ref": "#/$defs/SemioPoint3"
            },
            "radius": {
              "type": "number"
            },
            "halfAngle": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "center",
            "radius"
          ],
          "properties": {
            "kind": {
              "const": "sphere"
            },
            "center": {
              "$ref": "#/$defs/SemioPoint3"
            },
            "radius": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "center",
            "axis",
            "majorRadius",
            "minorRadius"
          ],
          "properties": {
            "kind": {
              "const": "torus"
            },
            "center": {
              "$ref": "#/$defs/SemioPoint3"
            },
            "axis": {
              "$ref": "#/$defs/SemioPoint3"
            },
            "majorRadius": {
              "type": "number"
            },
            "minorRadius": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "controlPoints",
            "weights",
            "uCount",
            "vCount",
            "degreeU",
            "degreeV",
            "knotsU",
            "knotsV"
          ],
          "properties": {
            "kind": {
              "const": "nurbs"
            },
            "controlPoints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioPoint3"
              }
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "uCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "vCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "degreeU": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "degreeV": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "knotsU": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "knotsV": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
