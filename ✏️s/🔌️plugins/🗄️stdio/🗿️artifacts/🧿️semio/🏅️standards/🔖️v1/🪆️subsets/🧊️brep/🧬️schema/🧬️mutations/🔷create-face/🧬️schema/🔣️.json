{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/mutation/create-face/schema.json",
  "title": "CreateFace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "outer_loop",
    "surface",
    "orientation",
    "tol"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Face id",
          "de": "Flächen-ID"
        },
        "description": {
          "en": "Id the new face carries.",
          "de": "Kennung, die die neue Fläche trägt."
        },
        "group": "value",
        "order": 10
      }
    },
    "outer_loop": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Outer loop",
          "de": "Äußere Schleife"
        },
        "ref": {
          "kind": "loop"
        }
      }
    },
    "inner_loops": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Inner loops",
          "de": "Innere Schleifen"
        },
        "description": {
          "en": "Loops that bound holes in the face.",
          "de": "Schleifen, die Löcher in der Fläche begrenzen."
        },
        "ref": {
          "kind": "loop"
        }
      }
    },
    "surface": {
      "$ref": "#/$defs/BrepSurface",
      "x-semio-ui": {
        "label": {
          "en": "Surface",
          "de": "Fläche (Geometrie)"
        }
      }
    },
    "orientation": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "label": {
          "en": "Same orientation",
          "de": "Gleichsinnig orientiert"
        },
        "description": {
          "en": "On: the use agrees with the element's natural orientation.",
          "de": "An: Die Verwendung stimmt mit der natürlichen Orientierung überein."
        }
      }
    },
    "tol": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Tolerance",
          "de": "Toleranz"
        },
        "description": {
          "en": "Geometric tolerance of the face: the distance within which it coincides with the geometry it bounds.",
          "de": "Geometrische Toleranz der Fläche: der Abstand, innerhalb dessen sie mit der begrenzten Geometrie zusammenfällt."
        },
        "step": 1e-09,
        "precision": 9,
        "softMin": 1e-09,
        "softMax": 0.1,
        "scale": "log",
        "snaps": [
          1e-09,
          1e-08,
          1e-07,
          1e-06,
          1e-05,
          0.0001,
          0.001,
          0.01,
          0.1
        ],
        "group": "value",
        "order": 60
      }
    }
  },
  "$defs": {
    "BrepSurface": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepSurface"
    }
  }
}
