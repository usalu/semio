      "type": "string"
    },
    "outer_loop": {
      "type": "string"
    },
    "inner_loops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface": {
      "$ref": "#/$defs/BrepSurface"
    },
    "orientation": {
      "type": "boolean"
    },
    "tol": {
      "type": "number"
    }
  },
  "$defs": {
    "BrepSurface": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepSurface"
    }
  }
}
