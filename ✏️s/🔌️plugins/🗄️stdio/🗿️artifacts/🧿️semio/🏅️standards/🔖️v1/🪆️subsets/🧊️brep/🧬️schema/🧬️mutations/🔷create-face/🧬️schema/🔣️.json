{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/mutation/create-face/schema.json",
  "title": "CreateFace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "outer_loop",
    "surface",
    "orientation",
    "tol"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "outer_loop": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Outer loop",
          "de": "Äußere Schleife"
        },
        "ref": {
          "kind": "loop"
        }
      }
    },
    "inner_loops": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Inner loops",
          "de": "Innere Schleifen"
        },
        "description": {
          "en": "Loops that bound holes in the face.",
          "de": "Schleifen, die Löcher in der Fläche begrenzen."
        },
        "ref": {
          "kind": "loop"
        }
      }
    },
    "surface": {
      "$ref": "#/$defs/BrepSurface",
      "x-semio-ui": {
        "label": {
          "en": "Surface",
          "de": "Fläche (Geometrie)"
        }
      }
    },
    "orientation": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "label": {
          "en": "Same orientation",
          "de": "Gleichsinnig orientiert"
        },
        "description": {
          "en": "On: the use agrees with the element's natural orientation.",
          "de": "An: Die Verwendung stimmt mit der natürlichen Orientierung überein."
        }
      }
    },
    "tol": {
      "type": "number"
    }
  },
  "$defs": {
    "BrepSurface": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json#/$defs/BrepSurface"
    }
  }
}
