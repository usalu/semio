{
  "$id": "https://semio.tech/schema/s.stdio.semio.object/artifact.json",
  "title": "SemioObjectArtifact",
  "description": "Full artifact state — mirrors SemioObjectSnapshot field for field.",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "x-semio-state": "persistent" },
