{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/mutation/create-edge/schema.json",
  "title": "CreateEdge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "target",
    "kind",
    "label",
    "properties"
  ],
  "properties": {
    "id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Id",
              "de": "ID"
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Edge id",
          "de": "Kanten-ID"
        },
        "description": {
          "en": "Id the new edge carries.",
          "de": "Kennung, die die neue Kante trägt."
        },
        "group": "target",
        "order": 10
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Node id",
              "de": "Knoten-ID"
            },
            "ref": {
              "kind": "node",
              "domain": "graph",
              "granularity": "node"
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Source node",
          "de": "Quellknoten"
        },
        "description": {
          "en": "Node the edge starts at.",
          "de": "Knoten, an dem die Kante beginnt."
        },
        "group": "target",
        "order": 20
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Node id",
              "de": "Knoten-ID"
            },
            "ref": {
              "kind": "node",
              "domain": "graph",
              "granularity": "node"
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Target node",
          "de": "Zielknoten"
        },
        "description": {
          "en": "Node the edge ends at.",
          "de": "Knoten, an dem die Kante endet."
        },
        "group": "target",
        "order": 30
      }
    },
    "kind": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Kind",
          "de": "Art"
        },
        "description": {
          "en": "Kind of the edge, as the graph's manifest names it.",
          "de": "Art der Kante, wie sie das Manifest des Graphen benennt."
        },
        "group": "value",
        "order": 40
      }
    },
    "label": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Label",
          "de": "Beschriftung"
        },
        "description": {
          "en": "Text shown on the edge.",
          "de": "Text, der an der Kante angezeigt wird."
        },
        "group": "value",
        "order": 50
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "$ref": "#/$defs/SemioValue"
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Properties",
          "de": "Eigenschaften"
        },
        "description": {
          "en": "Keyed typed entries attached to the edge.",
          "de": "Einträge mit Schlüssel und typisiertem Wert, die an der Kante hängen."
        },
        "group": "value",
        "order": 60
      }
    },
    "source_port": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Source port",
          "de": "Quellanschluss"
        },
        "description": {
          "en": "Name of the port on the source node; cleared, the edge attaches to the node itself.",
          "de": "Name des Anschlusses am Quellknoten; geleert hängt die Kante am Knoten selbst."
        },
        "group": "value",
        "order": 70
      }
    },
    "target_port": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Target port",
          "de": "Zielanschluss"
        },
        "description": {
          "en": "Name of the port on the target node; cleared, the edge attaches to the node itself.",
          "de": "Name des Anschlusses am Zielknoten; geleert hängt die Kante am Knoten selbst."
        },
        "group": "value",
        "order": 80
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in set",
          "de": "Position in der Menge"
        },
        "description": {
          "en": "Index the edge is inserted at; absent appends it. Undo of a delete names the removed index.",
          "de": "Index, an dem die Kante eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Löschens nennt den entfernten Index."
        }
      }
    }
  },
  "$defs": {
    "SemioValue": {
      "description": "One typed value, internally tagged on `kind` exactly as the Rust `SemioValue` enum: numbers keep their lexeme, bytes are raw octets.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Null",
              "de": "Null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean",
              "x-semio-ui": {
                "widget": "toggle",
                "label": {
                  "en": "Value",
                  "de": "Wert"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Boolean",
              "de": "Wahrheitswert"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "lexeme": {
              "type": "string",
              "x-semio-ui": {
                "widget": "text",
                "label": {
                  "en": "Lexeme",
                  "de": "Lexem"
                },
                "description": {
                  "en": "Exact textual form of a number or string value.",
                  "de": "Genaue Textform eines Zahlen- oder Zeichenkettenwerts."
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Integer",
              "de": "Ganzzahl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "lexeme": {
              "type": "string",
              "x-semio-ui": {
                "widget": "text",
                "label": {
                  "en": "Lexeme",
                  "de": "Lexem"
                },
                "description": {
                  "en": "Exact textual form of a number or string value.",
                  "de": "Genaue Textform eines Zahlen- oder Zeichenkettenwerts."
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Floating point",
              "de": "Gleitkommazahl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "str"
            },
            "value": {
              "type": "string",
              "x-semio-ui": {
                "widget": "text",
                "label": {
                  "en": "Value",
                  "de": "Wert"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Text",
              "de": "Text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "x-semio-ui": {
                "label": {
                  "en": "Bytes",
                  "de": "Bytes"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Bytes",
              "de": "Bytes"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValue"
              },
              "x-semio-ui": {
                "label": {
                  "en": "List items",
                  "de": "Listenelemente"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "List",
              "de": "Liste"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "map"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioValueEntry"
              },
              "x-semio-ui": {
                "label": {
                  "en": "Map entries",
                  "de": "Map-Einträge"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Map",
              "de": "Map"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "ref"
            },
            "id": {
              "$ref": "#/$defs/ValueId",
              "x-semio-ui": {
                "label": {
                  "en": "Referenced node",
                  "de": "Referenzierter Knoten"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Reference",
              "de": "Referenz"
            }
          }
        }
      ]
    },
    "SemioValueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/SemioValue"
        }
      }
    },
    "SemioValueNode": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ValueId"
        },
        "value": {
          "$ref": "#/$defs/SemioValue"
        }
      },
      "required": [
        "id",
        "value"
      ]
    },
    "ValueId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    }
  }
}
