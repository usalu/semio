{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/mutation/set-node/schema.json",
  "title": "SetNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setNode",
      "description": "Aggregate discriminator spliced in by SemioValueMutation; absent when the payload stands alone."
    },
    "id": {
      "$ref": "#/$defs/ValueId",
      "x-semio-ui": {
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "Id of the value node.",
          "de": "Kennung des Wertknotens."
        },
        "group": "target",
        "order": 10
      }
    },
    "value": {
      "$ref": "#/$defs/SemioValue",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Value",
          "de": "Wert"
        },
        "description": {
          "en": "The typed value written: null, boolean, integer, number, text, bytes, list, map or reference.",
          "de": "Der geschriebene typisierte Wert: null, Wahrheitswert, Ganzzahl, Zahl, Text, Bytes, Liste, Zuordnung oder Referenz."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "ValueId": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/snapshot.json#/$defs/ValueId"
    },
    "SemioValue": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/snapshot.json#/$defs/SemioValue"
    }
  }
}
