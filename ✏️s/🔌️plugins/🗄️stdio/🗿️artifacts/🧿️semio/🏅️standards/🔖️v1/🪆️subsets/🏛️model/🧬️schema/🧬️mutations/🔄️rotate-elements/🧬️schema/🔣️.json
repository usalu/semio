{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/mutation/rotate-elements/schema.json",
  "title": "RotateElements",
  "description": "The `rotate-elements` mutation record — internally tagged `\"mutation\": \"rotateElements\"`: a set of model elements turned in place about one world axis by one relative angle.",
  "x-semio-inverse-rows": {
    "perTarget": {
      "targets": 1
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "targets",
    "axis",
    "angle"
  ],
  "x-semio-invariant": [
    {
      "id": "axis-nonzero",
      "description": {
        "en": "The rotation axis has a non-zero length.",
        "de": "Die Drehachse hat eine von null verschiedene Länge."
      }
    }
  ],
  "properties": {
    "mutation": {
      "const": "rotateElements",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Elements",
          "de": "Elemente"
        },
        "description": {
          "en": "Elements to turn; ones the model lacks are skipped.",
          "de": "Zu drehende Elemente; im Modell fehlende werden übersprungen."
        },
        "ref": {
          "kind": "object",
          "domain": "cad",
          "granularity": "object"
        },
        "group": "target",
        "order": 10
      }
    },
    "axis": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Axis",
          "de": "Achse"
        },
        "description": {
          "en": "World axis to turn about; its length is ignored.",
          "de": "Weltachse der Drehung; ihre Länge spielt keine Rolle."
        },
        "step": 0.1,
        "precision": 3,
        "group": "rotation",
        "order": 20
      }
    },
    "angle": {
      "type": "number",
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "Angle",
          "de": "Winkel"
        },
        "description": {
          "en": "Right-handed rotation about the axis.",
          "de": "Rechtshändige Drehung um die Achse."
        },
        "unit": "rad",
        "displayUnit": "deg",
        "displayFactor": 57.29577951308232,
        "step": 0.017453292519943295,
        "softMin": -3.141592653589793,
        "softMax": 3.141592653589793,
        "snaps": [
          -3.141592653589793,
          -1.5707963267948966,
          0,
          1.5707963267948966,
          3.141592653589793
        ],
        "group": "rotation",
        "order": 30
      }
    }
  }
}
