{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/change-stroke-color/schema.json",
  "title": "ChangeStrokeColor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "style_name"
  ],
  "properties": {
    "style_name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Style",
          "de": "Stil"
        },
        "description": {
          "en": "Name of the drawing style.",
          "de": "Name des Zeichenstils."
        },
        "ref": {
          "kind": "style"
        },
        "group": "target",
        "order": 10
      }
    },
    "new_color": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemioRgba"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Stroke color",
          "de": "Konturfarbe"
        }
      }
    }
  },
  "$defs": {
    "SemioRgba": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        },
        "a": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Alpha",
              "de": "Alpha"
            },
            "description": {
              "en": "Opacity, 0 transparent to 1 opaque.",
              "de": "Deckkraft, 0 transparent bis 1 deckend."
            }
          }
        }
      }
    }
  }
}
