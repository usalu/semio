{
  "$id": "https://semio.tech/schema/s.stdio.semio.value/snapshot.json",
  "title": "SemioValueSnapshot",
  "description": "Ordered, lexeme-preserving typed value graph — mirrors the 🦀️component.rs sibling's real fields.",
  "$defs": {
    "valueId": {
      "type": "value",
      "properties": { "value": { "type": "string" } },
      "required": ["value"]
    },
    "semioValue": {
      "type": "value",
      "properties": {
        "kind": { "enum": ["null", "bool", "int", "float", "str", "bytes", "list", "map", "ref"] },
        "value": { "type": ["boolean", "string"] },
        "lexeme": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/semioValue" } },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/semioValueEntry" } },
        "id": { "$ref": "#/$defs/valueId" }
      },
      "required": ["kind"]
    },
    "semioValueEntry": {
      "type": "value",
      "properties": {
        "key": { "type": "string" },
        "value": { "$ref": "#/$defs/semioValue" }
      },
      "required": ["key", "value"]
    },
    "semioValueNode": {
      "type": "value",
      "properties": {
        "id": { "$ref": "#/$defs/valueId" },
        "value": { "$ref": "#/$defs/semioValue" }
      },
      "required": ["id", "value"]
    }
  },
  "type": "value",
  "properties": {
    "schema": { "type": "string", "x-semio-state": "persistent" },
    "root": { "$ref": "#/$defs/semioValue", "x-semio-state": "persistent" },
    "nodes": { "type": "array", "x-semio-state": "persistent", "items": { "$ref": "#/$defs/semioValueNode" } }
  },
  "required": ["schema", "root", "nodes"]
}
