module Stdio_semio_audio_mutations;

# Spicy mirror (descriptive, not test-parsed — the real byte-level walker is
# ../📡️component.protocol.semio, walked by dsl::walk_protocol) for the REAL binary
# `SemioAudioMutation::encode_op`/`decode_op` frame. `format`/`tag` are real, fully described; the
# variant's own argument payload is one opaque trailing byte span.

public type Frame = unit {
    format: uint8;      # OP_BINARY_FORMAT, currently 1
    tag: uint8;          # SemioAudioMutation variant ordinal, 0-9
    payload: bytes &eod;
};
