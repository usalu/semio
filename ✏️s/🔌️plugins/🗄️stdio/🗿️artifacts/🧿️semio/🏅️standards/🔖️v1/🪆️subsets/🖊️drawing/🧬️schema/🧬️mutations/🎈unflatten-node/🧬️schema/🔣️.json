{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/unflatten-node/schema.json",
  "title": "UnflattenNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "at",
    "original"
  ],
  "properties": {
    "at": {
      "$ref": "#/$defs/NodePath",
      "x-semio-ui": {
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "Layer index and child indices of the node, each counted from 0.",
          "de": "Ebenenindex und Kindindizes des Knotens, jeweils ab 0 gezählt."
        },
        "group": "target",
        "order": 10
      }
    },
    "original": {
      "$ref": "#/$defs/DrawNode",
      "x-semio-ui": {
        "label": {
          "en": "Original node",
          "de": "Ursprünglicher Knoten"
        }
      }
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "DrawNode": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/snapshot.json#/$defs/DrawNode"
    }
  }
}
