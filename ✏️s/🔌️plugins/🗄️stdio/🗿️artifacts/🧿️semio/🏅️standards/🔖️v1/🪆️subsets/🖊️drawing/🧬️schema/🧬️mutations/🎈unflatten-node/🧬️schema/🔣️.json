{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/unflatten-node/schema.json",
  "title": "UnflattenNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "at",
    "original"
  ],
  "properties": {
    "at": {
      "$ref": "#/$defs/NodePath"
    },
    "original": {
      "$ref": "#/$defs/DrawNode"
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "DrawNode": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/snapshot.json#/$defs/DrawNode"
    }
  }
}
