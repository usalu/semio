{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/diff.json",
  "title": "SemioBrepDiff",
  "description": "Handcrafted sparse diff — one NamedTripleDiff{removed,modified,added} per collection. See the sibling 🦀️.rs for the real source of truth.",
  "type": "object",
  "properties": {
    "vertices": {
      "$ref": "#/definitions/vertexTriple"
    },
    "edges": {
      "$ref": "#/definitions/edgeTriple"
    },
    "loops": {
      "$ref": "#/definitions/namedTriple"
    },
    "faces": {
      "$ref": "#/definitions/faceTriple"
    },
    "shells": {
      "$ref": "#/definitions/namedTriple"
    },
    "solids": {
      "$ref": "#/definitions/namedTriple"
    }
  },
  "definitions": {
    "vertexTriple": {
      "allOf": [
        {
          "$ref": "#/definitions/namedTriple"
        }
      ],
      "properties": {
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/vertexModified"
          }
        }
      }
    },
    "edgeTriple": {
      "allOf": [
        {
          "$ref": "#/definitions/namedTriple"
        }
      ],
      "properties": {
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/edgeModified"
          }
        }
      }
    },
    "faceTriple": {
      "allOf": [
        {
          "$ref": "#/definitions/namedTriple"
        }
      ],
      "properties": {
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/faceModified"
          }
        }
      }
    },
    "vertexModified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "diff"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "point": {},
            "tol": {
              "type": "number"
            }
          }
        }
      }
    },
    "edgeModified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "diff"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startVertex": {
              "type": "string"
            },
            "endVertex": {
              "type": "string"
            },
            "curve": {},
            "tol": {
              "type": "number"
            }
          }
        }
      }
    },
    "faceModified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "diff"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outerLoop": {
              "type": "string"
            },
            "innerLoops": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "surface": {},
            "orientation": {
              "type": "boolean"
            },
            "tol": {
              "type": "number"
            }
          }
        }
      }
    },
    "namedTriple": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {}
            },
            "required": [
              "key",
              "diff"
            ]
          }
        },
        "added": {
          "type": "array",
          "items": {}
        }
      }
    }
  }
}
