{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/diff.json",
  "title": "SemioBrepDiff",
  "description": "Handcrafted sparse diff — one NamedTripleDiff{removed,modified,added} per collection. See the sibling 🦀️.rs for the real source of truth.",
  "type": "object",
  "properties": {
    "vertices": {
      "$ref": "#/definitions/namedTriple"
    },
    "edges": {
      "$ref": "#/definitions/namedTriple"
    },
    "loops": {
      "$ref": "#/definitions/namedTriple"
    },
    "faces": {
      "$ref": "#/definitions/namedTriple"
    },
    "shells": {
      "$ref": "#/definitions/namedTriple"
    },
    "solids": {
      "$ref": "#/definitions/namedTriple"
    }
  },
  "definitions": {
    "namedTriple": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {}
            },
            "required": [
              "key",
              "diff"
            ]
          }
        },
        "added": {
          "type": "array",
          "items": {}
        }
      }
    }
  }
}
