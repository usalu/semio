{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/mutation/insert-channel/schema.json",
  "title": "InsertChannel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "timelineIndex",
    "index",
    "channel"
  ],
  "properties": {
    "mutation": {
      "const": "insertChannel",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    },
    "timelineIndex": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "channel": {
      "$ref": "#/$defs/AnimChannel",
      "x-semio-ui": {
        "label": {
          "en": "Channel",
          "de": "Kanal"
        }
      }
    }
  },
  "$defs": {
    "AnimChannel": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/snapshot.json#/definitions/AnimChannel"
    }
  }
}
