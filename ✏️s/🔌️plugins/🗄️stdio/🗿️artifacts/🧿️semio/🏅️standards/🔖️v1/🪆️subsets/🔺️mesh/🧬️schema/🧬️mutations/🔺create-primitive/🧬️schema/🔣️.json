{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/mesh/mutation/create-primitive/schema.json",
  "title": "CreatePrimitive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh_id",
    "primitive"
  ],
  "properties": {
    "mesh_id": {
      "type": "string"
    },
    "primitive": {
      "$ref": "#/$defs/SemioPrimitive"
    }
  },
  "$defs": {
    "SemioPrimitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "topology": {
          "$ref": "#/$defs/SemioTopology"
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioPoint3"
          }
        },
        "normals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioPoint3"
          }
        },
        "uvs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioUv"
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioRgba"
          }
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "materialId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SemioTopology": {
      "type": "string",
      "enum": [
        "points",
        "lines",
        "lineStrip",
        "triangles",
        "triangleStrip",
        "triangleFan"
      ]
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioUv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "u",
        "v"
      ],
      "properties": {
        "u": {
          "type": "number"
        },
        "v": {
          "type": "number"
        }
      }
    },
    "SemioRgba": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      }
    }
  }
}
