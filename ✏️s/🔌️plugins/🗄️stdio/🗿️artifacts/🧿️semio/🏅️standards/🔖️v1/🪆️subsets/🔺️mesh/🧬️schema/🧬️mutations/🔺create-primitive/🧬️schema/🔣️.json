{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/mutation/create-primitive/schema.json",
  "title": "CreatePrimitive",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh_id",
    "primitive"
  ],
  "properties": {
    "mesh_id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Mesh",
          "de": "Netz"
        },
        "description": {
          "en": "Id of the mesh.",
          "de": "Kennung des Netzes."
        },
        "ref": {
          "kind": "mesh"
        },
        "group": "target",
        "order": 10
      }
    },
    "primitive": {
      "$ref": "#/$defs/SemioPrimitive",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Primitive",
          "de": "Primitiv"
        },
        "description": {
          "en": "Id, topology, material and vertex data of the primitive that is created.",
          "de": "Kennung, Topologie, Material und Vertexdaten des Primitivs, das erstellt wird."
        },
        "group": "value",
        "order": 20
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in list",
          "de": "Position in der Liste"
        },
        "description": {
          "en": "Index the entry is inserted at; absent appends it. Undo of a delete names the removed index.",
          "de": "Index, an dem der Eintrag eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Löschens nennt den entfernten Index."
        }
      }
    }
  },
  "$defs": {
    "SemioPrimitive": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/snapshot.json#/definitions/SemioPrimitive"
    }
  }
}
