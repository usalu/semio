{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/mutation/insert-relation/schema.json",
  "title": "InsertRelation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "relation"
  ],
  "properties": {
    "mutation": {
      "const": "insertRelation",
      "description": "Aggregate discriminator spliced in by SemioModelMutation; absent when the payload stands alone."
    },
    "relation": {
      "$ref": "#/$defs/ModelRelation",
      "x-semio-ui": {
        "label": {
          "en": "Relation",
          "de": "Beziehung"
        }
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in list",
          "de": "Position in der Liste"
        },
        "description": {
          "en": "Index the entry is inserted at; absent appends it. Undo of a removal names the removed index.",
          "de": "Index, an dem der Eintrag eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Entfernens nennt den entfernten Index."
        }
      }
    }
  },
  "$defs": {
    "ModelRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RelationKind"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "RelationKind": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/snapshot.json#/$defs/RelationKind"
    }
  }
}
