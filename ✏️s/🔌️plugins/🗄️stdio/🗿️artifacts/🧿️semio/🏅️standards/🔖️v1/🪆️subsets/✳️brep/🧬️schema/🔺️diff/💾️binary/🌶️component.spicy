module Stdio_semio_brep_diff;

# Real binary frame: `format` (1 byte) + `presence` bitmask (1 byte, bit0=vertices..bit5=solids),
# then 0-6 varint-length-prefixed opaque per-collection text blobs (protocol::DiffCodec's real
# encode_diff/decode_diff, replacing the old "text bytes verbatim" shortcut).
type Document = unit {
    format: uint8;
    presence: uint8;
    payload: bytes &eod;
};
