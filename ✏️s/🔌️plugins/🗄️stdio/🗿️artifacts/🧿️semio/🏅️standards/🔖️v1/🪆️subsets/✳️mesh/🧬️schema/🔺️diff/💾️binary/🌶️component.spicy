module Stdio_semio_mesh_diff;

# BINARY representation — identical to the TEXT grammar, UTF-8 encoded, no additional framing:
# encode_diff() is print_diff().into_bytes() verbatim (../🦀️component.rs's `TopLevel` region).

public type Envelope = unit {
    text_utf8: bytes &eod;   # UTF-8 bytes of the print_diff() text grammar
};
