{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/drawing/mutation/drag-nodes/schema.json",
  "title": "DragNodes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ats",
    "offset"
  ],
  "properties": {
    "ats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NodePath"
      }
    },
    "offset": {
      "$ref": "#/$defs/SemioPoint2"
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "SemioPoint2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
