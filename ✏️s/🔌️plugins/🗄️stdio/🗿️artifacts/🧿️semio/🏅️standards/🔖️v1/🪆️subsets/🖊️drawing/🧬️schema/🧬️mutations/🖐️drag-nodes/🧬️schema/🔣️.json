{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/mutation/drag-nodes/schema.json",
  "title": "DragNodes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ats",
    "offset"
  ],
  "properties": {
    "ats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NodePath"
      },
      "x-semio-ui": {
        "label": {
          "en": "Target positions",
          "de": "Zielpositionen"
        },
        "description": {
          "en": "New anchor position per dragged node.",
          "de": "Neue Ankerposition je gezogenem Knoten."
        }
      }
    },
    "offset": {
      "$ref": "#/$defs/SemioPoint2",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Offset",
          "de": "Versatz"
        },
        "description": {
          "en": "Distance every dragged node moves by, as x and y.",
          "de": "Strecke, um die jeder gezogene Knoten verschoben wird, als x und y."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "NodePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer"
      ],
      "properties": {
        "layer": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "SemioPoint2": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/drawing/snapshot.json#/$defs/SemioPoint2"
    }
  }
}
