{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/snapshot.json",
  "title": "SemioPresentationSnapshot",
  "type": "object",
  "required": [
    "schema",
    "masters",
    "layouts",
    "slides"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "masters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SlideMaster"
      },
      "x-semio-ui": {
        "label": {
          "en": "Slide masters",
          "de": "Folienmaster"
        }
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SlideLayout"
      },
      "x-semio-ui": {
        "label": {
          "en": "Slide layouts",
          "de": "Folienlayouts"
        }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Slide"
      },
      "x-semio-ui": {
        "label": {
          "en": "Slides",
          "de": "Folien"
        }
      }
    }
  },
  "definitions": {
    "SemioPoint2": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "SlideFrame": {
      "type": "object",
      "required": [
        "origin",
        "width",
        "height"
      ],
      "properties": {
        "origin": {
          "$ref": "#/definitions/SemioPoint2",
          "x-semio-ui": {
            "label": {
              "en": "Origin",
              "de": "Ursprung"
            }
          }
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "SlidePictureImage": {
      "type": "object",
      "required": [
        "assetId",
        "mime",
        "bytes"
      ],
      "properties": {
        "assetId": {
          "type": "string"
        },
        "mime": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Media type",
              "de": "Medientyp"
            }
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Bytes",
              "de": "Bytes"
            }
          }
        }
      }
    },
    "PlaceholderKind": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "title",
            "subtitle",
            "body",
            "footer",
            "slideNumber",
            "dateTime",
            "other"
          ],
          "x-semio-ui": {
            "options": {
              "subtitle": {
                "en": "Subtitle",
                "de": "Untertitel"
              },
              "body": {
                "en": "Body",
                "de": "Textkörper"
              },
              "footer": {
                "en": "Footer",
                "de": "Fußzeile"
              },
              "slideNumber": {
                "en": "Slide number",
                "de": "Foliennummer"
              },
              "dateTime": {
                "en": "Date and time",
                "de": "Datum und Uhrzeit"
              },
              "other": {
                "en": "Other",
                "de": "Sonstiger"
              }
            }
          }
        },
        "value": {
          "type": "string"
        }
      }
    },
    "SlideTableCell": {
      "type": "object",
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "x-semio-ui": {
            "label": {
              "en": "Text blocks",
              "de": "Textblöcke"
            }
          }
        }
      }
    },
    "SlideTableRow": {
      "type": "object",
      "required": [
        "cells"
      ],
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SlideTableCell"
          },
          "x-semio-ui": {
            "label": {
              "en": "Cells",
              "de": "Zellen"
            }
          }
        }
      }
    },
    "SlideShape": {
      "type": "object",
      "required": [
        "shapeKind",
        "frame"
      ],
      "properties": {
        "shapeKind": {
          "enum": [
            "textBox",
            "picture",
            "table",
            "placeholder"
          ],
          "x-semio-ui": {
            "widget": "select",
            "label": {
              "en": "Shape kind",
              "de": "Formart"
            },
            "options": {
              "textBox": {
                "en": "Text box",
                "de": "Textfeld"
              },
              "picture": {
                "en": "Picture",
                "de": "Bild"
              },
              "placeholder": {
                "en": "Placeholder",
                "de": "Platzhalter"
              }
            }
          }
        },
        "frame": {
          "$ref": "#/definitions/SlideFrame"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/snapshot.json#/$defs/DocBlock"
          },
          "x-semio-ui": {
            "label": {
              "en": "Text blocks",
              "de": "Textblöcke"
            }
          }
        },
        "image": {
          "$ref": "#/definitions/SlidePictureImage"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SlideTableRow"
          },
          "x-semio-ui": {
            "label": {
              "en": "Rows",
              "de": "Zeilen"
            }
          }
        },
        "kind": {
          "$ref": "#/definitions/PlaceholderKind"
        }
      }
    },
    "SlideMaster": {
      "type": "object",
      "required": [
        "id",
        "shapes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SlideShape"
          },
          "x-semio-ui": {
            "label": {
              "en": "Shapes",
              "de": "Formen"
            }
          }
        }
      }
    },
    "SlideLayout": {
      "type": "object",
      "required": [
        "id",
        "masterId",
        "shapes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "masterId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Slide master",
              "de": "Folienmaster"
            },
            "ref": {
              "kind": "master"
            }
          }
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SlideShape"
          },
          "x-semio-ui": {
            "label": {
              "en": "Shapes",
              "de": "Formen"
            }
          }
        }
      }
    },
    "Slide": {
      "type": "object",
      "required": [
        "id",
        "shapes",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "layoutId": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Slide layout",
              "de": "Folienlayout"
            },
            "ref": {
              "kind": "layout"
            }
          }
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SlideShape"
          },
          "x-semio-ui": {
            "label": {
              "en": "Shapes",
              "de": "Formen"
            }
          }
        },
        "notes": {
          "type": "array",
          "x-semio-ui": {
            "label": {
              "en": "Speaker notes",
              "de": "Notizen"
            }
          }
        }
      }
    }
  }
}
