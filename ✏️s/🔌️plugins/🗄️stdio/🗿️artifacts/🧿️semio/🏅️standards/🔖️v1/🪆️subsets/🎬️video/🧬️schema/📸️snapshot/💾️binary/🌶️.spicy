module Stdio_semio_video_snapshot;
# Spicy mirror (descriptive, not test-parsed — the real byte-level walker is
# ../📡️.protocol.semio, walked by dsl::walk_protocol) for the post-envelope-unwrap
# SemioVideoSnapshot binary pack payload (this subset's `ArtifactPack` impl,
# `encode_video_snapshot_binary`/`decode_video_snapshot_binary`). Past `format`/`schema_len`/
# `schema_bytes`, `streams` (each with a nested `samples` sub-collection and an opaque `data`
# buffer) is one opaque trailing `payload` — the `protocol-array-of-records` gap, same boundary
# the real protocol file uses. Spicy has no built-in LEB128 varint unit type, so `schema_len` is
# described only, not test-parsed.
type Document = unit {
    format: uint8;
    schema_bytes_and_payload: bytes &eod;    # schema_len (varint) + schema_bytes + streams payload
};
