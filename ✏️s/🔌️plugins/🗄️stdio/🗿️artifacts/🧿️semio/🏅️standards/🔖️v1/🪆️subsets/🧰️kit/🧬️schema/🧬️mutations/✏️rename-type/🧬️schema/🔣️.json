{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/mutation/rename-type/schema.json",
  "title": "RenameType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "new_name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Type",
          "de": "Typ"
        },
        "description": {
          "en": "Id of the type.",
          "de": "Kennung des Typs."
        },
        "ref": {
          "kind": "type"
        },
        "group": "target",
        "order": 10
      }
    },
    "new_name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "New name",
          "de": "Neuer Name"
        },
        "description": {
          "en": "Name the type carries afterwards.",
          "de": "Name, den der Typ danach trägt."
