{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/audio/snapshot.json",
  "title": "SemioAudioSnapshot",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "sampleRate": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Sample rate",
          "de": "Abtastrate"
        },
        "unit": "Hz"
      }
    },
    "format": {
      "type": "string",
      "enum": [
        "pcm8",
        "pcm16",
        "pcm24",
        "pcm32",
        "f32",
        "f64"
      ],
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "select",
        "label": {
          "en": "Sample format",
          "de": "Sample-Format"
        },
        "options": {
          "pcm8": {
            "en": "PCM, 8-bit",
            "de": "PCM, 8 Bit"
          },
          "pcm16": {
            "en": "PCM, 16-bit",
            "de": "PCM, 16 Bit"
          },
          "pcm24": {
            "en": "PCM, 24-bit",
            "de": "PCM, 24 Bit"
          },
          "pcm32": {
            "en": "PCM, 32-bit",
            "de": "PCM, 32 Bit"
          },
          "f32": {
            "en": "Float, 32-bit",
            "de": "Gleitkomma, 32 Bit"
          },
          "f64": {
            "en": "Float, 64-bit",
            "de": "Gleitkomma, 64 Bit"
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "properties": {
          "samples": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "x-semio-ui": {
              "label": {
                "en": "Samples",
                "de": "Samples"
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Channels",
          "de": "Kanäle"
        }
      }
    },
    "tags": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Tags",
          "de": "Tags"
        }
      }
    }
  }
}
