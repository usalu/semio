# Zeek Spicy mirror (descriptive, not test-parsed — the real byte-level walker is
# ../📡️.protocol.semio) for the s.stdio.semio.object snapshot binary pack, past the
# shared `.semio` envelope.
module StdioSemioObjectSnapshot;

public type SnapshotPack = unit {
    format: uint8;
    schema_len: bytes &size=1 &convert=$$.to_uint(spicy::ByteOrder::Little);
    schema_bytes: bytes &size=self.schema_len;
    payload: bytes &eod;
};
