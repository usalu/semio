{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/audio/mutation/insert-channel/schema.json",
  "title": "InsertChannel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "channel"
  ],
  "properties": {
    "mutation": {
      "const": "insertChannel",
      "description": "Aggregate discriminator spliced in by SemioAudioMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "channel": {
      "$ref": "#/$defs/SemioAudioChannel",
      "x-semio-ui": {
        "label": {
          "en": "Channel",
          "de": "Kanal"
        }
      }
    }
  },
  "$defs": {
    "SemioAudioChannel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "x-semio-ui": {
            "label": {
              "en": "Samples",
              "de": "Samples"
            }
          }
        }
      }
    }
  }
}
