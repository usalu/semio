{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/audio/mutation/insert-channel/schema.json",
  "title": "InsertChannel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "channel"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "channel": {
      "$ref": "#/$defs/SemioAudioChannel"
    },
    "mutation": {
      "const": "insertChannel",
      "description": "Aggregate discriminator spliced in by SemioAudioMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioAudioChannel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
