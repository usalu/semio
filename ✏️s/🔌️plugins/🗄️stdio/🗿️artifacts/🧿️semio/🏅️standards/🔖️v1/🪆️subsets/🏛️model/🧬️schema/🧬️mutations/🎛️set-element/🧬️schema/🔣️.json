{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/mutation/set-element/schema.json",
  "title": "SetElement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id"
  ],
  "properties": {
    "mutation": {
      "const": "setElement",
      "description": "Aggregate discriminator spliced in by SemioModelMutation; absent when the payload stands alone."
    },
    "id": {
      "type": "string"
    },
    "class": {
      "anyOf": [
        {
          "$ref": "#/$defs/ElementClass"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Element class",
          "de": "Elementklasse"
        }
      }
    },
    "placement": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemioTransform"
        },
        {
          "type": "null"
        }
      ]
    },
    "geometry": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeometryRef"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Geometry",
          "de": "Geometrie"
        }
      }
    },
    "spatialId": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Spatial container",
          "de": "Räumlicher Container"
        },
        "description": {
          "en": "Spatial structure node that contains the element.",
          "de": "Knoten der räumlichen Struktur, der das Element enthält."
        },
        "ref": {
          "kind": "spatialNode"
        }
      }
    },
    "psets": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertySet"
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Property sets",
          "de": "Eigenschaftssätze"
        }
      }
    }
  },
  "$defs": {
    "ElementClass": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/snapshot.json#/$defs/ElementClass"
    },
    "SemioTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/$defs/SemioPoint3",
          "x-semio-ui": {
            "label": {
              "en": "Translation",
              "de": "Verschiebung"
            }
          }
        },
        "rotation": {
          "$ref": "#/$defs/SemioQuaternion"
        },
        "scale": {
          "$ref": "#/$defs/SemioPoint3"
        }
      }
    },
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioQuaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "W",
              "de": "W"
            },
            "description": {
              "en": "Scalar part of the rotation quaternion.",
              "de": "Skalarteil des Rotationsquaternions."
            }
          }
        }
      }
    },
    "GeometryRef": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/snapshot.json#/$defs/GeometryRef"
    },
    "PropertySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Property"
          }
        }
      }
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/PsetValue"
        }
      }
    },
    "PsetValue": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/model/snapshot.json#/$defs/PsetValue"
    }
  }
}
