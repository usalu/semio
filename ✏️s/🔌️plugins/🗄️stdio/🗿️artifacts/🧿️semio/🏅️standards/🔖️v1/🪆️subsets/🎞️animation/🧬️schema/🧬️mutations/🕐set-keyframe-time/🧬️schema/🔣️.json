{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/mutation/set-keyframe-time/schema.json",
  "title": "SetKeyframeTime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "timelineIndex",
    "channelIndex",
    "index",
    "t"
  ],
  "properties": {
    "mutation": {
      "const": "setKeyframeTime",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    },
    "timelineIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Timeline",
          "de": "Zeitleiste"
        },
        "description": {
          "en": "Index of the timeline, counted from 0.",
          "de": "Index der Zeitleiste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "channelIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Channel",
          "de": "Kanal"
        },
        "description": {
          "en": "Index of the channel within the timeline, counted from 0.",
          "de": "Index des Kanals innerhalb der Zeitleiste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Keyframe",
          "de": "Schlüsselbild"
        },
        "description": {
          "en": "Index of the keyframe within the channel, counted from 0.",
          "de": "Index des Schlüsselbilds innerhalb des Kanals, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 30
      }
    },
    "t": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Time",
          "de": "Zeit"
        },
        "unit": "s",
        "step": 0.01,
        "precision": 3
      }
    }
  }
}
