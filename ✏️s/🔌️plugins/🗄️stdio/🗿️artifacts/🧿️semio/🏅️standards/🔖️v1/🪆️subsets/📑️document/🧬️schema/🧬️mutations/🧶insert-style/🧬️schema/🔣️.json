{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/document/mutation/insert-style/schema.json",
  "title": "InsertStyle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "style"
  ],
  "properties": {
    "mutation": {
      "const": "insertStyle",
      "description": "Aggregate discriminator spliced in by SemioDocumentMutation; absent when the payload stands alone."
    },
    "style": {
      "$ref": "#/$defs/DocStyle",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Style",
          "de": "Formatvorlage"
        },
        "description": {
          "en": "Id, name and parent of the style that is inserted.",
          "de": "Kennung, Name und übergeordnete Formatvorlage der Formatvorlage, die eingefügt wird."
        },
        "group": "value",
        "order": 10
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in list",
          "de": "Position in der Liste"
        },
        "description": {
          "en": "Index the entry is inserted at; absent appends it. Undo of a removal names the removed index.",
          "de": "Index, an dem der Eintrag eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Entfernens nennt den entfernten Index."
        }
      }
    }
  },
  "$defs": {
    "DocStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "basedOn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Based on style",
              "de": "Basiert auf Formatvorlage"
            },
            "ref": {
              "kind": "style"
            }
          }
        }
      }
    }
  }
}
