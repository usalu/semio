; ABNF-style descriptive mirror of `stdio.semio.drawing`'s real binary op frame -- see the
; authoritative `📡️component.protocol.semio` for the conformance-tested version.
document       = format tag payload
format         = %x01                  ; OP_BINARY_FORMAT
tag            = OCTET                 ; SemioDrawingMutation variant ordinal, see OP_KEYWORDS
payload        = *OCTET                ; opaque tail: "key=value ..." argument text, see
                                        ; component.rs's OpBinary::encode_op
