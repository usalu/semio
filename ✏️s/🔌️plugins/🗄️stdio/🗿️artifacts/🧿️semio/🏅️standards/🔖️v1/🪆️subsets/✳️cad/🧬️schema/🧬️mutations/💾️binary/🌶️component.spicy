module Stdio_semio_cad_mutations;

# Real binary `OpBinary` frame: `format` (1 byte) + `tag` (1 byte, the `SemioCadMutation` variant
# ordinal), then one opaque `payload` tail holding the variant's `key=value ...` argument text (see
# the sibling `📡️component.protocol.semio`'s comment).
type Document = unit {
    format: uint8;
    tag: uint8;
    payload: bytes &eod;
};
