{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/cad/mutation/add-layer/schema.json",
  "title": "AddLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layer"
  ],
  "properties": {
    "mutation": {
      "const": "addLayer",
      "description": "Aggregate discriminator spliced in by SemioCadMutation; absent when the payload stands alone."
    },
    "layer": {
      "$ref": "#/$defs/CadLayer",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Layer",
          "de": "Layer"
        },
        "description": {
          "en": "Name, colour index, line type and visibility of the layer that is added.",
          "de": "Name, Farbindex, Linientyp und Sichtbarkeit des Layers, der hinzugefügt wird."
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "CadLayer": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/cad/snapshot.json#/$defs/CadLayer"
    }
  }
}
