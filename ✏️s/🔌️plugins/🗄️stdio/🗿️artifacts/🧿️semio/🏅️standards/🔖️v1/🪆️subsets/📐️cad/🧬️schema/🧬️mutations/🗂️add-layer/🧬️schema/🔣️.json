{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/cad/mutation/add-layer.json",
  "title": "AddLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer"
  ],
  "properties": {
    "layer": {
      "$ref": "#/$defs/CadLayer"
    },
    "mutation": {
      "const": "addLayer",
      "description": "Aggregate discriminator spliced in by SemioCadMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "CadLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "colorIndex",
        "lineType",
        "visible"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "colorIndex": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "lineType": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      }
    }
  }
}
