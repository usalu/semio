{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/cad/mutation/set-layer/schema.json",
  "title": "SetLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "name"
  ],
  "properties": {
    "mutation": {
      "const": "setLayer",
      "description": "Aggregate discriminator spliced in by SemioCadMutation; absent when the payload stands alone."
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Layer",
          "de": "Layer"
        },
        "description": {
          "en": "Name of the layer.",
          "de": "Name des Layers."
        },
        "ref": {
          "kind": "layer"
        },
        "group": "target",
        "order": 10
      }
    },
    "colorIndex": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Color index",
          "de": "Farbindex"
        },
        "description": {
          "en": "ACI color number; 256 = by layer, 0 = by block.",
          "de": "ACI-Farbnummer; 256 = von Layer, 0 = von Block."
        },
        "step": 1
      }
    },
    "lineType": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Line type",
          "de": "Linientyp"
        }
      }
    },
    "visible": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Visible",
          "de": "Sichtbar"
        },
        "description": {
          "en": "Whether the layer is displayed.",
          "de": "Ob der Layer angezeigt wird."
        },
        "group": "value",
        "order": 40
      }
    }
  }
}
