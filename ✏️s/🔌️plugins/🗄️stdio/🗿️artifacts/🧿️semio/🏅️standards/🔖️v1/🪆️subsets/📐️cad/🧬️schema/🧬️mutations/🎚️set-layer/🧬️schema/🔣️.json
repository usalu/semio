{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/cad/mutation/set-layer/schema.json",
  "title": "SetLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "name"
  ],
  "properties": {
    "mutation": {
      "const": "setLayer",
      "description": "Aggregate discriminator spliced in by SemioCadMutation; absent when the payload stands alone."
    },
    "name": {
      "type": "string"
    },
    "colorIndex": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Color index",
          "de": "Farbindex"
        },
        "description": {
          "en": "ACI color number; 256 = by layer, 0 = by block.",
          "de": "ACI-Farbnummer; 256 = von Layer, 0 = von Block."
        }
      }
    },
    "lineType": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Line type",
          "de": "Linientyp"
        }
      }
    },
    "visible": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
