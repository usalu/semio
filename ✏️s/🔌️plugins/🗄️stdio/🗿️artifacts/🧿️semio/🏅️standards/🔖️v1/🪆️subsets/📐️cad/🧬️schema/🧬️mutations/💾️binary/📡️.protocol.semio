dialect protocol
protocol stdio.semio.cad.mutations
version 1
schema stdio.semio.cad
start body
framing record

# Real `SemioCadMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value ...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record add-layer tag=1
field payload bytes
record remove-layer tag=2
field payload bytes
record set-layer tag=3
field payload bytes
record add-block tag=4
field payload bytes
record remove-block tag=5
field payload bytes
record set-block-base-point tag=6
field payload bytes
record add-entity tag=7
field payload bytes
record remove-entity tag=8
field payload bytes
record set-entity-layer tag=9
field payload bytes
record set-entity-geometry tag=10
field payload bytes
record add-block-entity tag=11
field payload bytes
record remove-block-entity tag=12
field payload bytes
record set-block-entity-layer tag=13
field payload bytes
record set-block-entity-geometry tag=14
field payload bytes
