{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BindRepresentation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pin",
    "role",
    "target"
  ],
  "properties": {
    "target": {
      "title": "ArtifactRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "dialect"
      ],
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "dialect": {
          "title": "ArtifactDialect",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactKind",
            "standard",
            "subset"
          ],
          "properties": {
            "artifactKind": {
              "type": "string"
            },
            "standard": {
              "type": "string"
            },
            "subset": {
              "type": "string"
            }
          }
        }
      }
    },
    "pin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Checkpoint"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Snapshot"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "role": {
      "type": "string"
    }
  }
}
