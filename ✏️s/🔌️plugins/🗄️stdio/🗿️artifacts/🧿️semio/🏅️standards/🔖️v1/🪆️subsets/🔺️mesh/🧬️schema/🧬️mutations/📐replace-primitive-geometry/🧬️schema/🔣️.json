{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/mesh/mutation/replace-primitive-geometry/schema.json",
  "title": "ReplacePrimitiveGeometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh_id",
    "primitive_id",
    "positions",
    "normals",
    "uvs",
    "colors",
    "indices"
  ],
  "properties": {
    "mesh_id": {
      "type": "string"
    },
    "primitive_id": {
      "type": "string"
    },
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemioPoint3"
      }
    },
    "normals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemioPoint3"
      }
    },
    "uvs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemioUv"
      }
    },
    "colors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemioRgba"
      }
    },
    "indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    }
  },
  "$defs": {
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "SemioUv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "u",
        "v"
      ],
      "properties": {
        "u": {
          "type": "number"
        },
        "v": {
          "type": "number"
        }
      }
    },
    "SemioRgba": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      }
    }
  }
}
