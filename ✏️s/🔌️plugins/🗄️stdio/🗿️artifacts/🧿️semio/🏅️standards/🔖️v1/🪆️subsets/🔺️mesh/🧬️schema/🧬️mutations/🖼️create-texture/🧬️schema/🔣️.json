{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/mutation/create-texture/schema.json",
  "title": "CreateTexture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "texture"
  ],
  "properties": {
    "texture": {
      "$ref": "#/$defs/SemioTexture",
      "x-semio-ui": {
        "label": {
          "en": "Texture",
          "de": "Textur"
        }
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575,
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Position in set",
          "de": "Position in der Menge"
        },
        "description": {
          "en": "Index the texture is inserted at; absent appends it. Undo of a delete names the removed index.",
          "de": "Index, an dem die Textur eingefügt wird; fehlt er, wird angehängt. Das Rückgängigmachen eines Löschens nennt den entfernten Index."
        }
      }
    }
  },
  "$defs": {
    "SemioTexture": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/snapshot.json#/definitions/SemioTexture"
    }
  }
}
