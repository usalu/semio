{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/mesh/mutation/create-texture/schema.json",
  "title": "CreateTexture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "texture"
  ],
  "properties": {
    "texture": {
      "$ref": "#/$defs/SemioTexture"
    }
  },
  "$defs": {
    "SemioTexture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
