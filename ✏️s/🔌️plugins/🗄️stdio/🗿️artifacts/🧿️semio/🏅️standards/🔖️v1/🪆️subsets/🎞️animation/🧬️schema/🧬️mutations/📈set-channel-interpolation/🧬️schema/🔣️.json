{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/animation/mutation/set-channel-interpolation/schema.json",
  "title": "SetChannelInterpolation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timelineIndex",
    "index",
    "interpolation"
  ],
  "properties": {
    "timelineIndex": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "interpolation": {
      "$ref": "#/$defs/AnimInterpolation"
    },
    "mutation": {
      "const": "setChannelInterpolation",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "AnimInterpolation": {
      "type": "string",
      "enum": [
        "linear",
        "step",
        "cubicSpline"
      ]
    }
  }
}
