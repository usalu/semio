{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/audio/mutation/set-channel-samples/schema.json",
  "title": "SetChannelSamples",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "samples"
  ],
  "properties": {
    "mutation": {
      "const": "setChannelSamples",
      "description": "Aggregate discriminator spliced in by SemioAudioMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Channel",
          "de": "Kanal"
        },
        "description": {
          "en": "Index of the channel, counted from 0.",
          "de": "Index des Kanals, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "x-semio-ui": {
        "label": {
          "en": "Samples",
          "de": "Samples"
        }
      }
    }
  }
}
