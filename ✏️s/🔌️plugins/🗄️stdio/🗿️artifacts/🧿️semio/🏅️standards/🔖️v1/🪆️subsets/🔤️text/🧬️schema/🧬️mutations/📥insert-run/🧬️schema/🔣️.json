{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/text/mutation/insert-run/schema.json",
  "title": "InsertRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "run"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "run": {
      "$ref": "#/$defs/SemioTextRun"
    }
  },
  "$defs": {
    "SemioTextRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioTextMark"
          }
        }
      }
    },
    "SemioTextMark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SemioTextMarkKind"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "SemioTextMarkKind": {
      "type": "string",
      "enum": [
        "bold",
        "italic",
        "code",
        "link"
      ]
    }
  }
}
