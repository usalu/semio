{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/text/mutation/insert-run/schema.json",
  "title": "InsertRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "run"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "run": {
      "$ref": "#/$defs/SemioTextRun",
      "x-semio-ui": {
        "label": {
          "en": "Text run",
          "de": "Textlauf"
        }
      }
    }
  },
  "$defs": {
    "SemioTextRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Language",
              "de": "Sprache"
            },
            "description": {
              "en": "BCP 47 tag; empty means unspecified.",
              "de": "BCP-47-Kennung; leer bedeutet unbestimmt."
            }
          }
        },
        "content": {
          "type": "string"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioTextMark"
          },
          "x-semio-ui": {
            "label": {
              "en": "Marks",
              "de": "Auszeichnungen"
            }
          }
        }
      }
    },
    "SemioTextMark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SemioTextMarkKind",
          "x-semio-ui": {
            "options": {
              "bold": {
                "en": "Bold",
                "de": "Fett"
              },
              "italic": {
                "en": "Italic",
                "de": "Kursiv"
              },
              "code": {
                "en": "Code",
                "de": "Code"
              },
              "link": {
                "en": "Link",
                "de": "Link"
              }
            }
          }
        },
        "href": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Link target",
              "de": "Linkziel"
            },
            "description": {
              "en": "URL of a link mark.",
              "de": "URL einer Link-Auszeichnung."
            }
          }
        }
      }
    },
    "SemioTextMarkKind": {
      "type": "string",
      "enum": [
        "bold",
        "italic",
        "code",
        "link"
      ]
    }
  }
}
