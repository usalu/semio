dialect protocol
protocol s.stdio.semio.object.snapshot
version 1
schema s.stdio.semio.object
start body
framing record

# UNIFIED-COMPOSABLE-ARTIFACT-SYSTEM object wave (W2c, first COMPOSITE subset). `format u8` (real,
# fixed) then `schema_len`/`schema_bytes` (real, varint-length-prefixed UTF-8) are genuinely, fully
# described. Past that, `transform` (10 fixed f64 LE) plus the three optional child-handle slots
# (`brep`/`mesh`/`properties`, each a presence byte + two length-prefixed strings when present) are
# modeled as one opaque trailing `payload` chain — the same `protocol-array-of-records`-style
# boundary every sibling subset's own protocol description uses. The real Rust
# `encode_object_snapshot_binary`/`decode_object_snapshot_binary` (`../../🦀️component.rs`) stays
# genuinely, fully structured and is round-trip tested independently.
header fixed 1
field format u8

segment schema_len varint
segment schema_bytes Array(u8, Field(schema_len))

chain payload bytes
