module Stdio_semio_brep_mutations;

# Real binary frame: `format` (1 byte) + `tag` (1 byte, the SemioBrepMutation variant ordinal,
# see 🧬️mutations/🦀️.rs's OP_KEYWORDS/variant_ordinal), then the variant's own
# `key=value ...` argument text as one opaque trailing payload. Replaces the old whole-enum
# compact-JSON shortcut.
type Document = unit {
    format: uint8;
    tag: uint8;
    payload: bytes &eod &convert=$$.decode("utf-8");
};
