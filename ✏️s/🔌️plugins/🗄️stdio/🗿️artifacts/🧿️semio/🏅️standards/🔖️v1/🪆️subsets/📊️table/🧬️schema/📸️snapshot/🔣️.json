{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/table/snapshot.json",
  "title": "SemioTableSnapshot",
  "description": "The neutral tabular interchange shape: named/typed columns plus rows of scalar cells (what csv/tsv/xlsx eventually map onto).",
  "type": "object",
  "required": [
    "schema",
    "columns",
    "rows"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "columns": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "native key — name-keyed collection"
          },
          "kind": {
            "enum": [
              "null",
              "bool",
              "int",
              "float",
              "str",
              "bytes"
            ],
            "x-semio-ui": {
              "options": {
                "null": {
                  "en": "Null",
                  "de": "Null"
                },
                "bool": {
                  "en": "Boolean",
                  "de": "Wahrheitswert"
                },
                "int": {
                  "en": "Integer",
                  "de": "Ganzzahl"
                },
                "float": {
                  "en": "Floating point",
                  "de": "Gleitkommazahl"
                },
                "str": {
                  "en": "Text",
                  "de": "Text"
                },
                "bytes": {
                  "en": "Bytes",
                  "de": "Bytes"
                }
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Columns",
          "de": "Spalten"
        }
      }
    },
    "rows": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "properties": {
          "cells": {
            "type": "array",
            "description": "positionally aligned with columns; each cell is a value-subset SemioValue",
            "items": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/snapshot.json#/$defs/SemioValue"
            },
            "x-semio-ui": {
              "label": {
                "en": "Cells",
                "de": "Zellen"
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Rows",
          "de": "Zeilen"
        }
      }
    }
  }
}
