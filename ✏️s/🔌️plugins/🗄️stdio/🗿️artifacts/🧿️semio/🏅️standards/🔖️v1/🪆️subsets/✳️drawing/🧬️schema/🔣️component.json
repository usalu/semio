{
  "$id": "https://semio.tech/schema/s.stdio.semio.drawing/artifact.json",
  "title": "SemioDrawingArtifact",
  "description": "Mirrors the real Rust SemioDrawingArtifact. See snapshot/component.json for DrawCanvas/DrawStyle/DrawLayer/DrawNode.",
  "type": "object",
  "required": ["schema", "canvas", "styles", "layers"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "canvas": { "$ref": "📸️snapshot/🔣️component.json#/$defs/DrawCanvas", "x-semio-state": "artifact" },
    "styles": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "📸️snapshot/🔣️component.json#/$defs/DrawStyle" } },
    "layers": { "type": "array", "x-semio-state": "artifact", "items": { "$ref": "📸️snapshot/🔣️component.json#/$defs/DrawLayer" } }
  }
}
