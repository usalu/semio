{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/text/mutation/remove-mark/schema.json",
  "title": "RemoveMark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_index",
    "index"
  ],
  "properties": {
    "run_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Run",
          "de": "Textlauf"
        },
        "description": {
          "en": "Index of the run, counted from 0.",
          "de": "Index des Textlaufs, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Mark",
          "de": "Auszeichnung"
        },
        "description": {
          "en": "Index of the mark within the run, counted from 0.",
          "de": "Index der Auszeichnung innerhalb des Textlaufs, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  }
}
