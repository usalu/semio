{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateMaterial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "material"
  ],
  "properties": {
    "material": {
      "title": "SemioMaterial",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseColor",
        "id",
        "metallic",
        "roughness"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "baseColor": {
          "title": "SemioRgba",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "a",
            "b",
            "g",
            "r"
          ],
          "properties": {
            "r": {
              "type": "number"
            },
            "g": {
              "type": "number"
            },
            "b": {
              "type": "number"
            },
            "a": {
              "type": "number"
            }
          }
        },
        "metallic": {
          "type": "number"
        },
        "roughness": {
          "type": "number"
        }
      }
    }
  }
}
