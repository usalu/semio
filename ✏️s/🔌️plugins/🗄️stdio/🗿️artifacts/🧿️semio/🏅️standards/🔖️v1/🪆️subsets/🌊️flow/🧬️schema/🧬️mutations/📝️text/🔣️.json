{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/flow/mutations/text.json",
  "title": "SemioFlowMutationText",
  "description": "🧬️ TEXT representation facet mirror — real, matches the facet root's shape.",
  "type": "object",
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "type": "string",
      "enum": [
        "setSnapshot",
        "insertNode",
        "removeNode",
        "setNodeKind",
        "setNodeLabel",
        "setNodePosition",
        "setNodeParam",
        "removeNodeParam",
        "insertEdge",
        "removeEdge",
        "setEdgeEndpoints",
        "setEdgeKind"
      ]
    },
    "snapshot": {
      "$ref": "#/definitions/SemioFlowSnapshot"
    },
    "node": {
      "$ref": "#/definitions/FlowNode"
    },
    "edge": {
      "$ref": "#/definitions/FlowEdge"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "position": {
      "$ref": "#/definitions/SemioPoint2"
    },
    "key": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "from": {
      "$ref": "#/definitions/PortRef"
    },
    "to": {
      "$ref": "#/definitions/PortRef"
    }
  },
  "definitions": {
    "SemioPoint2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "PortRef": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      }
    },
    "FlowParam": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "FlowNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowParam"
          }
        },
        "position": {
          "$ref": "#/definitions/SemioPoint2"
        }
      }
    },
    "FlowEdge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/definitions/PortRef"
        },
        "to": {
          "$ref": "#/definitions/PortRef"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "SemioFlowSnapshot": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowEdge"
          }
        }
      }
    }
  }
}
