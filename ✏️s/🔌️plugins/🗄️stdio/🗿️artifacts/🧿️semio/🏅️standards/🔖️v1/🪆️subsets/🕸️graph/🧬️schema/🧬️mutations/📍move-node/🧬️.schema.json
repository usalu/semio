{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoveNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newPosition"
  ],
  "properties": {
    "id": {
      "title": "GraphNodeId",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    },
    "newPosition": {
      "title": "SemioPoint2",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
