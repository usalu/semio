dialect grammar stdio.semio.cad.mutations
root = document
; `OpText::print_op`/`parse_op` grammar for `SemioCadMutation` -- NO semio envelope: `OpBinary`
; is `print_op().into_bytes()` (see ../💾️binary/📡️component.protocol.semio, byte-identical).
; Grammar: `keyword arg=value ...` (space-separated), one alternative per variant.
document = "no-mutation" / ( keyword SP args )
args = arg *( SP arg )
arg = key "=" value

keyword = "set-snapshot" / "add-layer" / "remove-layer" / "set-layer" / "add-block" / "remove-block"
        / "set-block-base-point" / "add-entity" / "remove-entity" / "set-entity-layer"
        / "set-entity-geometry" / "add-block-entity" / "remove-block-entity"
        / "set-block-entity-layer" / "set-block-entity-geometry"
key = "snapshot" / "layer" / "name" / "color-index" / "line-type" / "visible" / "block"
    / "base-point" / "entity" / "handle" / "block-name"
; `value` is keyword-dependent (see the per-variant field list below); the grammar's `arg` rule
; is deliberately permissive (any hex/bracket value) -- the real discriminator is the KEYWORD,
; matching `parse_cad_mutation`'s own dispatch (`🦀️component.rs`).
value = cad-snapshot / layer / block / entity-record / entity / point2 / hexstr
      / option-i32 / option-str / option-bool

; --- per-variant real arg lists (informative -- see 🦀️component.rs `print_cad_mutation` for the
; authoritative dispatch) ---
; set-snapshot        snapshot=<cad-snapshot>
; add-layer           layer=<layer>
; remove-layer        name=<hexstr>
; set-layer           name=<hexstr> color-index=<option-i32> line-type=<option-str> visible=<option-bool>
; add-block           block=<block>
; remove-block        name=<hexstr>
; set-block-base-point name=<hexstr> base-point=<point2>
; add-entity          entity=<entity-record>
; remove-entity       handle=<hexstr>
; set-entity-layer    handle=<hexstr> layer=<hexstr>
; set-entity-geometry handle=<hexstr> entity=<entity>
; add-block-entity    block-name=<hexstr> entity=<entity-record>
; remove-block-entity block-name=<hexstr> handle=<hexstr>
; set-block-entity-layer    block-name=<hexstr> handle=<hexstr> layer=<hexstr>
; set-block-entity-geometry block-name=<hexstr> handle=<hexstr> entity=<entity>

cad-snapshot = "[" hexstr "," layer-list "," block-list "," entity-record-list "]"
layer-list = "[" [ layer *( "," layer ) ] "]"
block-list = "[" [ block *( "," block ) ] "]"
entity-record-list = "[" [ entity-record *( "," entity-record ) ] "]"

option-i32 = "[0]" / ( "[1," i32 "]" )
option-str = "[0]" / ( "[1," hexstr "]" )
option-bool = "[0]" / ( "[1," bool01 "]" )

layer = "[" hexstr "," i32 "," hexstr "," bool01 "]"
entity-record = "[" hexstr "," hexstr "," entity "]"
block = "[" hexstr "," point2 "," entity-record-list "]"

entity = line / arc / circle / ellipse / polyline / text-entity / insert / solid / dimension
line = "L[" point2 "," point2 "]"
arc = "A[" point2 "," f64 "," f64 "," f64 "]"
circle = "C[" point2 "," f64 "]"
ellipse = "E[" point2 "," point2 "," f64 "," f64 "," f64 "]"
polyline = "P[" point2-list "," bool01 "]"
point2-list = "[" [ point2 *( "," point2 ) ] "]"
text-entity = "T[" point2 "," f64 "," f64 "," hexstr "]"
insert = "I[" hexstr "," point2 "," point2 "," f64 "]"
solid = "S[" point2 "," point2 "," point2 "," point2 "]"
dimension = "D[" point2 "," point2 "," f64 "," hexstr "]"

point2 = "[" f64 "," f64 "]"
hexstr = *HEXDIG
i32 = ["-"] 1*DIGIT
f64 = ["-"] 1*DIGIT ["." 1*DIGIT] [("e"/"E") ["+"/"-"] 1*DIGIT]
bool01 = "0" / "1"
