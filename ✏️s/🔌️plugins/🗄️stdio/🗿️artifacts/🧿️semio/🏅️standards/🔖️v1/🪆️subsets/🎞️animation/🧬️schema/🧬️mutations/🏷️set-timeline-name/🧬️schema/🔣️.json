{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/mutation/set-timeline-name/schema.json",
  "title": "SetTimelineName",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "setTimelineName",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Timeline",
          "de": "Zeitleiste"
        },
        "description": {
          "en": "Index of the timeline, counted from 0.",
          "de": "Index der Zeitleiste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "description": {
          "en": "Display name of the timeline; cleared, it has none.",
          "de": "Anzeigename der Zeitleiste; geleert hat sie keinen."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
