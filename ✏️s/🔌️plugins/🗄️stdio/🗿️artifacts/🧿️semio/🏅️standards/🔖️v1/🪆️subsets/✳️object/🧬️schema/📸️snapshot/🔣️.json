{
  "$id": "https://semio.tech/schema/s.stdio.semio.object/snapshot.json",
  "title": "SemioObjectSnapshot",
  "description": "One spatial thing: a placement/transform, its geometry (brep and/or mesh child handles), and its property sets (value child handle). First COMPOSITE subset.",
  "type": "object",
  "required": ["schema", "transform"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "transform": {
      "type": "object",
      "x-semio-state": "artifact",
      "properties": {
        "translation": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } },
        "rotation": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }, "w": { "type": "number" } } },
        "scale": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } }
      }
    },
    "brep": { "type": "object", "x-semio-state": "artifact", "x-semio-child": "s.stdio.semio.brep", "properties": { "childId": { "type": "string" }, "target": { "type": "string" } } },
    "mesh": { "type": "object", "x-semio-state": "artifact", "x-semio-child": "s.stdio.semio.mesh", "properties": { "childId": { "type": "string" }, "target": { "type": "string" } } },
    "properties": { "type": "object", "x-semio-state": "artifact", "x-semio-child": "s.stdio.semio.value", "properties": { "childId": { "type": "string" }, "target": { "type": "string" } } }
  }
}
