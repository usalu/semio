{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/mutation/set-bit-depth/schema.json",
  "title": "SetBitDepth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "bit_depth"
  ],
  "properties": {
    "mutation": {
      "const": "setBitDepth",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    },
    "bit_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Bit depth",
          "de": "Bittiefe"
        },
        "unit": "bit"
      }
    }
  }
}
