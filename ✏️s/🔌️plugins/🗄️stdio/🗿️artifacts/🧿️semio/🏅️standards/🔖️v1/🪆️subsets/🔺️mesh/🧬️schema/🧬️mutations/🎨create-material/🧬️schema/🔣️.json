{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/mesh/mutation/create-material/schema.json",
  "title": "CreateMaterial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "material"
  ],
  "properties": {
    "material": {
      "$ref": "#/$defs/SemioMaterial"
    }
  },
  "$defs": {
    "SemioMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "baseColor": {
          "$ref": "#/$defs/SemioRgba"
        },
        "metallic": {
          "type": "number"
        },
        "roughness": {
          "type": "number"
        }
      }
    },
    "SemioRgba": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      }
    }
  }
}
