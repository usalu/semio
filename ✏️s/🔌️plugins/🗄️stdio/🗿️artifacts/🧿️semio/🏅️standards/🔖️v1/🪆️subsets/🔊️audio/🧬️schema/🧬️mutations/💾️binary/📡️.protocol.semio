dialect protocol
protocol stdio.semio.audio.mutations
version 1
schema stdio.semio.audio
start body
framing record

# Real `SemioAudioMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value ...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record set-sample-rate tag=1
field payload bytes
record set-format tag=2
field payload bytes
record insert-channel tag=3
field payload bytes
record remove-channel tag=4
field payload bytes
record set-channel-samples tag=5
field payload bytes
record insert-tag tag=6
field payload bytes
record remove-tag tag=7
field payload bytes
record set-tag-value tag=8
field payload bytes
