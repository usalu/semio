{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/drawing/mutation/replace-fill/schema.json",
  "title": "ReplaceFill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "style_name"
  ],
  "properties": {
    "style_name": {
      "type": "string"
    },
    "new_fill": {
      "anyOf": [
        {
          "$ref": "#/$defs/SemioRgba"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "SemioRgba": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      }
    }
  }
}
