{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "language",
    "unit",
    "repeat",
    "preamble",
    "encodings",
    "stops",
    "policy"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "repeat": {
      "type": "integer",
      "minimum": 1
    },
    "preamble": {
      "type": "string"
    },
    "encodings": {
      "type": "array",
      "items": {
        "enum": [
          "text",
          "binary"
        ]
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
