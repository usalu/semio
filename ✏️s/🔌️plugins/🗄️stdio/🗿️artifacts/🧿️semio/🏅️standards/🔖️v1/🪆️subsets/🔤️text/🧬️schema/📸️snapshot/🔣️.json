{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/text/snapshot.json",
  "title": "SemioTextSnapshot",
  "description": "A sequence of language-tagged runs carrying content plus inline marks (bold/italic/code/link).",
  "type": "object",
  "required": [
    "schema",
    "runs"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "runs": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "description": "BCP-47 tag; empty = unspecified",
            "x-semio-ui": {
              "widget": "text",
              "label": {
                "en": "Language",
                "de": "Sprache"
              },
              "description": {
                "en": "BCP 47 tag; empty means unspecified.",
                "de": "BCP-47-Kennung; leer bedeutet unbestimmt."
              }
            }
          },
          "content": {
            "type": "string"
          },
          "marks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "bold",
                    "italic",
                    "code",
                    "link"
                  ],
                  "x-semio-ui": {
                    "options": {
                      "bold": {
                        "en": "Bold",
                        "de": "Fett"
                      },
                      "italic": {
                        "en": "Italic",
                        "de": "Kursiv"
                      },
                      "code": {
                        "en": "Code",
                        "de": "Code"
                      },
                      "link": {
                        "en": "Link",
                        "de": "Link"
                      }
                    }
                  }
                },
                "href": {
                  "type": "string",
                  "description": "populated only when kind == link",
                  "x-semio-ui": {
                    "widget": "text",
                    "label": {
                      "en": "Link target",
                      "de": "Linkziel"
                    },
                    "description": {
                      "en": "URL of a link mark.",
                      "de": "URL einer Link-Auszeichnung."
                    }
                  }
                }
              }
            },
            "x-semio-ui": {
              "label": {
                "en": "Marks",
                "de": "Auszeichnungen"
              }
            }
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Text runs",
          "de": "Textläufe"
        }
      }
    }
  }
}
