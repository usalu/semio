module Stdio_semio_drawing_diff;

# Real binary diff frame: `format` (1 byte) + `presence` bitmask (bit0=canvas, bit1=styles,
# bit2=layers), then one opaque `payload` tail of 0-3 varint-length-prefixed blobs — see the
# sibling `📡️.protocol.semio`'s comment on the `protocol-cond-cannot-chain` boundary.
type Document = unit {
    format: uint8;
    presence: uint8;
    payload: bytes &eod;
};
