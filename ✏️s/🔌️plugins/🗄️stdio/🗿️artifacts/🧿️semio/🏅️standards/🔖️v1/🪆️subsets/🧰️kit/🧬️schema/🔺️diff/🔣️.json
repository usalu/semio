{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/diff.json",
  "title": "SemioKitDiff",
  "description": "Sparse keyed-row diff: per collection `removed` base indices, `modified` rows (sparse row diffs) and `added` rows with their final index.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "types": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "diff"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "diff": {
                "$ref": "#/$defs/SemioKitTypeDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "item"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "item": {
                "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitType"
              }
            }
          }
        }
      }
    },
    "designs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "diff"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "diff": {
                "$ref": "#/$defs/SemioKitDesignDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "item"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "item": {
                "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitDesign"
              }
            }
          }
        }
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "diff"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "diff": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "object",
                    "x-semio-type": "store::ArtifactChild<SemioObjectSnapshot>"
                  }
                }
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "item"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "item": {
                "type": "object",
                "x-semio-type": "store::ArtifactChild<SemioObjectSnapshot>"
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "diff"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "diff": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "object",
                    "x-semio-type": "store::ArtifactChild<SemioModelSnapshot>"
                  }
                }
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "item"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "item": {
                "type": "object",
                "x-semio-type": "store::ArtifactChild<SemioModelSnapshot>"
              }
            }
          }
        }
      }
    },
    "properties": {
      "type": "object",
      "x-semio-type": "store::ArtifactChild<SemioValueSnapshot>"
    },
    "representations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "diff"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "diff": {
                "$ref": "#/$defs/SemioKitLinkDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "item"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "item": {
                "type": "object",
                "x-semio-type": "store::ArtifactLink"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "SemioKitTypeDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      }
    },
    "SemioKitDesignDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "pieces": {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitPiece"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/snapshot.json#/$defs/SemioKitConnection"
          }
        }
      }
    },
    "SemioKitLinkDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pin": {
          "type": "object",
          "x-semio-type": "store::LinkPin"
        }
      }
    }
  }
}
