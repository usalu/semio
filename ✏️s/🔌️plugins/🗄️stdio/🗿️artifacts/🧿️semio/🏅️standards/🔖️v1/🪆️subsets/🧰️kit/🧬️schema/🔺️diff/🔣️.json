{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/kit/diff.json",
  "title": "SemioKitDiff",
  "description": "Sparse per-field diff over SemioKitSnapshot — types/designs/objects/models/properties/representations, each present only when touched.",
  "type": "object",
  "properties": {
    "types": {
      "type": "array"
    },
    "designs": {
      "type": "array"
    },
    "objects": {
      "type": "array"
    },
    "models": {
      "type": "array"
    },
    "properties": {
      "type": [
        "object",
        "null"
      ]
    },
    "representations": {
      "type": "array"
    }
  }
}
