dialect grammar
grammar stdio.semio.audio.snapshot
extension semio
start document

# ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION audio wave. Real grammar for
# `SemioAudioSnapshot::print_dsl`/`parse_dsl` (📸️snapshot/🦀️component.rs's `print_audio_snapshot_body`/
# `parse_audio_snapshot_body`) — hand-rolled, NOT `#[derive(dsl::DslArtifact)]`: this subset's own
# `🔺️diff`/`🧬️mutations` facets already hand-roll their codecs (pre-wave), and per the ticket's
# blanket instruction ("hand-roll all diff/op codecs — do not fight the derive") the snapshot stays
# on the SAME hand-rolled hex/bracket convention as its sibling facets rather than a derive-based
# codec that would print/parse a structurally different wire shape.
#
# `document` matches the fixture-honesty harness's own reconstructed body shape (mandatory `semio
# stdio.semio.audio.dsl v1` preamble stripped and replaced with the bare `envelope_id()` token —
# `artifact-mark` below — before recognition, same convention `json.snapshot`'s/`image.snapshot`'s
# own grammars use).
artifact-mark = "stdio.semio.audio"
document = artifact-mark schema-line sample-rate-line format-line channels-line tags-line

schema-line = "schema" "=" hex
sample-rate-line = "sampleRate" "=" INT
format-line = "format" "=" format

channels-line = "channels" "=" "[" channel-list? "]"
channel-list = channel {"," channel}*
channel = "[" sample-list? "]"
sample-list = hex {"," hex}*

tags-line = "tags" "=" "[" tag-list? "]"
tag-list = tag {"," tag}*
tag = "[" hex "," hex "]"

format = "pcm8" | "pcm16" | "pcm24" | "pcm32" | "f32" | "f64"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO (`📖️grammar/🦀️component.rs`'s `default_macros`) — every hex-encoded `schema`/tag
# `key`/`value` leaf AND every hex-encoded `f32` sample bit-pattern token routes through it.
# `Symbol::Ref`'s production→macro fallback resolves bare `hex` automatically, with real
# backtracking — a hand-rolled `{INT|IDENT}*` production would be wrong here (recipe pitfall #2).
