{
  "$id": "https://semio.tech/schema/s.stdio.semio.document/artifact.json",
  "title": "SemioDocumentArtifact",
  "description": "Full artifact state, mirrors SemioDocumentSnapshot field for field.",
  "type": "object",
  "required": ["schema", "styles", "images", "blocks"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "persistent" },
    "styles": { "type": "array", "x-semio-state": "persistent", "items": { "type": "object" } },
    "images": { "type": "array", "x-semio-state": "persistent", "items": { "type": "object" } },
    "blocks": { "type": "array", "x-semio-state": "persistent", "items": { "type": "object" } }
  }
}
