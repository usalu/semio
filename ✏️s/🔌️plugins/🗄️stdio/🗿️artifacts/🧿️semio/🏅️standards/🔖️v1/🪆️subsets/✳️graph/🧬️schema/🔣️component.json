{
  "$id": "https://semio.tech/schema/s.stdio.semio.graph/artifact.json",
  "title": "SemioGraphArtifact",
  "description": "Full artifact state, mirrors SemioGraphSnapshot field for field.",
  "type": "object",
  "required": ["schema", "nodes", "edges"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "persistent" },
    "nodes": { "type": "array", "x-semio-state": "persistent", "items": { "type": "object" } },
    "edges": { "type": "array", "x-semio-state": "persistent", "items": { "type": "object" } }
  }
}
