{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/model/diff.json",
  "title": "SemioModelDiff",
  "description": "Sparse per-field diff, id-keyed triples (removed/modified/added) over spatial/elements/relations.",
  "type": "object",
  "properties": {
    "spatial": {
      "$ref": "#/definitions/spatialTriple"
    },
    "elements": {
      "$ref": "#/definitions/elementsTriple"
    },
    "relations": {
      "$ref": "#/definitions/relationsTriple"
    }
  },
  "$defs": {
    "ModelRelationDiff": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "object"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "SemioModelElementDiff": {
      "type": "object",
      "properties": {
        "class": {
          "type": "object"
        },
        "placement": {
          "type": "object"
        },
        "geometry": {
          "type": "object"
        },
        "spatialId": {
          "type": [
            "string",
            "null"
          ]
        },
        "psets": {
          "type": "array"
        }
      }
    },
    "SpatialNodeDiff": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "placement": {
          "type": "object"
        }
      }
    }
  },
  "definitions": {
    "spatialTriple": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "$ref": "#/$defs/SpatialNodeDiff"
              }
            }
          }
        },
        "added": {
          "type": "array"
        }
      }
    },
    "elementsTriple": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "$ref": "#/$defs/SemioModelElementDiff"
              }
            }
          }
        },
        "added": {
          "type": "array"
        }
      }
    },
    "relationsTriple": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "$ref": "#/$defs/ModelRelationDiff"
              }
            }
          }
        },
        "added": {
          "type": "array"
        }
      }
    }
  }
}
