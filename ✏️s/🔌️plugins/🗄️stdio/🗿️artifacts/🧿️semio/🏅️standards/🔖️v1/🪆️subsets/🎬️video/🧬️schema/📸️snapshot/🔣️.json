{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/video/snapshot.json",
  "title": "SemioVideoSnapshot",
  "description": "streams{kind,codec,width,height,rate,samples{pts,key,data}} — container-typed, payload-opaque.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "streams": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/video/snapshot.json#/$defs/SemioVideoStream"
      },
      "x-semio-ui": {
        "label": {
          "en": "Streams",
          "de": "Datenströme"
        }
      }
    }
  },
  "required": [
    "schema",
    "streams"
  ],
  "$defs": {
    "SemioVideoStream": {
      "title": "SemioVideoStream",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "video",
            "audio",
            "subtitle"
          ],
          "x-semio-ui": {
            "options": {
              "video": {
                "en": "Video",
                "de": "Video"
              },
              "audio": {
                "en": "Audio",
                "de": "Audio"
              },
              "subtitle": {
                "en": "Subtitles",
                "de": "Untertitel"
              }
            }
          }
        },
        "codec": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Codec",
              "de": "Codec"
            }
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "rate": {
          "title": "SemioRational",
          "type": "object",
          "properties": {
            "num": {
              "type": "integer",
              "x-semio-ui": {
                "widget": "stepper",
                "label": {
                  "en": "Numerator",
                  "de": "Zähler"
                }
              }
            },
            "den": {
              "type": "integer",
              "x-semio-ui": {
                "widget": "stepper",
                "label": {
                  "en": "Denominator",
                  "de": "Nenner"
                }
              }
            }
          },
          "required": [
            "num",
            "den"
          ],
          "x-semio-ui": {
            "label": {
              "en": "Frame or sample rate",
              "de": "Bild- bzw. Abtastrate"
            },
            "description": {
              "en": "Frames (video) or samples (audio) per second as an exact fraction.",
              "de": "Bilder (Video) bzw. Abtastwerte (Audio) pro Sekunde als exakter Bruch."
            }
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "title": "SemioVideoSample",
            "type": "object",
            "properties": {
              "pts": {
                "type": "integer",
                "minimum": 0,
                "x-semio-ui": {
                  "widget": "stepper",
                  "label": {
                    "en": "Presentation time stamp",
                    "de": "Präsentationszeitstempel (PTS)"
                  }
                }
              },
              "key": {
                "type": "boolean"
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            },
            "required": [
              "pts",
              "key",
              "data"
            ]
          },
          "x-semio-ui": {
            "label": {
              "en": "Samples",
              "de": "Samples"
            }
          }
        }
      },
      "required": [
        "kind",
        "codec",
        "width",
        "height",
        "rate",
        "samples"
      ]
    }
  }
}
