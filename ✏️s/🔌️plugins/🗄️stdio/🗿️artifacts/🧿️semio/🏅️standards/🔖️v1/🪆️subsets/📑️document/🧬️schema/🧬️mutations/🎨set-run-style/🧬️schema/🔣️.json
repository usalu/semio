{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/document/mutation/set-run-style/schema.json",
  "title": "SetRunStyle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "run_index",
    "style"
  ],
  "properties": {
    "path": {
      "$ref": "#/$defs/DocBlockPath"
    },
    "run_index": {
      "type": "integer",
      "minimum": 0
    },
    "style": {
      "$ref": "#/$defs/RunStyle"
    },
    "mutation": {
      "const": "setRunStyle",
      "description": "Aggregate discriminator spliced in by SemioDocumentMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "DocBlockPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocPathSegment"
          }
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DocPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex"
          ],
          "properties": {
            "kind": {
              "const": "quote"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex",
            "item"
          ],
          "properties": {
            "kind": {
              "const": "listItem"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            },
            "item": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blockIndex",
            "row",
            "cell"
          ],
          "properties": {
            "kind": {
              "const": "tableCell"
            },
            "blockIndex": {
              "type": "integer",
              "minimum": 0
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "cell": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "RunStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
