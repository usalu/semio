{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/mesh/mutation/move-vertex/schema.json",
  "title": "MoveVertex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh_id",
    "primitive_id",
    "vertex_index",
    "new_point"
  ],
  "properties": {
    "mesh_id": {
      "type": "string"
    },
    "primitive_id": {
      "type": "string"
    },
    "vertex_index": {
      "type": "integer",
      "minimum": 0
    },
    "new_point": {
      "$ref": "#/$defs/SemioPoint3"
    }
  },
  "$defs": {
    "SemioPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
