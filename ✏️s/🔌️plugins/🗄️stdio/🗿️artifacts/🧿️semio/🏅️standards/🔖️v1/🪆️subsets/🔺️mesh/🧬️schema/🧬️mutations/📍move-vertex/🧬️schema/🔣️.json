{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/mutation/move-vertex/schema.json",
  "title": "MoveVertex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh_id",
    "primitive_id",
    "vertex_index",
    "new_point"
  ],
  "properties": {
    "mesh_id": {
      "type": "string"
    },
    "primitive_id": {
      "type": "string"
    },
    "vertex_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Vertex index",
          "de": "Eckpunktindex"
        }
      }
    },
    "new_point": {
      "$ref": "#/$defs/SemioPoint3",
      "x-semio-ui": {
        "label": {
          "en": "Position",
          "de": "Position"
        }
      }
    }
  },
  "$defs": {
    "SemioPoint3": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/snapshot.json#/definitions/SemioPoint3"
    }
  }
}
