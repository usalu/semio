{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/mutation/move-vertex/schema.json",
  "title": "MoveVertex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mesh_id",
    "primitive_id",
    "vertex_index",
    "new_point"
  ],
  "properties": {
    "mesh_id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Mesh",
          "de": "Netz"
        },
        "description": {
          "en": "Id of the mesh.",
          "de": "Kennung des Netzes."
        },
        "ref": {
          "kind": "mesh"
        },
        "group": "target",
        "order": 10
      }
    },
    "primitive_id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Primitive",
          "de": "Primitiv"
        },
        "description": {
          "en": "Id of the primitive within the mesh.",
          "de": "Kennung des Primitivs innerhalb des Netzes."
        },
        "ref": {
          "kind": "primitive"
        },
        "group": "target",
        "order": 20
      }
    },
    "vertex_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Vertex index",
          "de": "Eckpunktindex"
        },
        "step": 1
      }
    },
    "new_point": {
      "$ref": "#/$defs/SemioPoint3",
      "x-semio-ui": {
        "label": {
          "en": "Position",
          "de": "Position"
        }
      }
    }
  },
  "$defs": {
    "SemioPoint3": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/mesh/snapshot.json#/definitions/SemioPoint3"
    }
  }
}
