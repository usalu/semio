{
  "$id": "https://semio.tech/schema/s/stdio/semio/animation/inference.json",
  "title": "SemioAnimationInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["duration"],
  "properties": {
    "duration": { "$ref": "#/$defs/SemioAnimationDuration", "x-semio-state": "inferred" }
  },
  "$defs": {
    "SemioAnimationDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "timelineCount", "channelCount", "keyframeCount"],
      "properties": {
        "durationSeconds": { "type": "number", "minimum": 0 },
        "timelineCount": { "type": "integer", "minimum": 0 },
        "channelCount": { "type": "integer", "minimum": 0 },
        "keyframeCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
