dialect grammar
grammar semio.model.snapshot
extension semio
start document

# P2 pilot (model), following stdio.semio.flow's proven pattern. Real grammar for
# `SemioModelSnapshot::print_dsl`/`parse_dsl` (📸️snapshot/🦀️.rs's
# `print_semio_model_snapshot_body`/`parse_semio_model_snapshot_body`) — hand-rolled, NOT
# `#[derive(dsl::DslArtifact)]`: even though the shared geometry types now derive `dsl::DslRecord`,
# this subset's own enums (`SpatialKind`/`ElementClass`/`GeometryRef`/`PsetValue`/`RelationKind`)
# and id-keyed collections don't have a generic derive bridge either (same family of gap
# `f6-final-summary.md` §4.4 documents) — hand-rolled hex/bracket convention throughout, same style
# as this subset's own `🔺️diff`/`🧬️mutations` facet grammars.
#
# `document` matches the fixture-honesty harness's own reconstructed body shape (mandatory `semio
# stdio.semio.model.dsl v1` preamble stripped and replaced with the bare `envelope_id()` token —
# `artifact-mark` below — before recognition, same convention `json.snapshot`'s own grammar uses).
artifact-mark = "stdio.semio.model"
document = artifact-mark schema-line spatial-line elements-line relations-line

schema-line = "schema" "=" hex

spatial-line = "spatial" "=" "[" spatial-list? "]"
spatial-list = spatial-node {"," spatial-node}*
spatial-node = "[" hex "," spatial-kind "," hex "," opt-str "," transform "]"
spatial-kind = "S" | "B" | "T" | "P"

elements-line = "elements" "=" "[" element-list? "]"
element-list = element {"," element}*
element = "[" hex "," element-class "," transform "," geometry-ref "," opt-str "," "[" pset-list? "]" "]"
element-class = "WA" | "SL" | "CO" | "BE" | "DO" | "WI" | "RO" | "ST" | "FU" | "OT" "[" hex "]"
geometry-ref = "N" | "B" "[" hex "]" | "M" "[" hex "]"
pset-list = property-set {"," property-set}*
property-set = "[" hex "," "[" property-list? "]" "]"
property-list = property {"," property}*
property = "[" hex "," pset-value "]"
pset-value = "T" "[" hex "]" | "N" "[" number "]" | "B" "[" bit "]"
bit = "0" | "1"

relations-line = "relations" "=" "[" relation-list? "]"
relation-list = relation {"," relation}*
relation = "[" hex "," relation-kind "," hex "," hex "]"
relation-kind = "AG" | "CI" | "CN" | "FV" | "VE" | "OT" "[" hex "]"

# Shared value shapes reused across spatial/element records.
opt-str = "[" "0" "]" | "[" "1" "," hex "]"
transform = "[" point3 "," quat "," point3 "]"
point3 = "[" number "," number "," number "]"
quat = "[" number "," number "," number "," number "]"

# `SemioPoint3`/`SemioQuaternion`/f64 pset numbers print via plain Rust `{v}` Display (`0`, `3`,
# `0.24`, ...) — the shared lexer's `INT`/`FLOAT` scanners already capture a leading `-` when
# digit-adjacent (P2-M1's trailing-dot-float work), matching `enc_f64`/`dec_f64` lexeme-for-lexeme.
number = INT | FLOAT

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO (`📖️grammar/🦀️.rs`'s `default_macros`) — every `id`/`name`/`key`/`brep_id`/
# `mesh_id`/text-`PsetValue`/`schema` leaf string is `enc_str` (lowercase-hex UTF-8 bytes). A
# hand-rolled `{INT|IDENT}*` production would be wrong here (see the sibling `🔺️diff`/`🧬️mutations`
# grammars' own `hex` doc comment) — `Symbol::Ref`'s production→macro fallback resolves bare `hex`
# automatically, with real backtracking.
