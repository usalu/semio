module SemioImageMutationBinary;

# Real binary layout for `SemioImageMutation::encode_op`/`decode_op` — a documented
# simplification (matching gif's own hand-rolled op codec): `encode_op` is the 📝️text sibling's
# `op` grammar UTF-8 bytes, verbatim, with no separate binary framing.
public type OpBinary = unit {
    op_utf8: bytes &eod;
};
