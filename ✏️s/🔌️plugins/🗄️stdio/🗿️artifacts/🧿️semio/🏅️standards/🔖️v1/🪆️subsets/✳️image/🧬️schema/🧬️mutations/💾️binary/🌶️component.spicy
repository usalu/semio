module Stdio_semio_image_mutations;

# Spicy mirror (descriptive, not test-parsed — the real byte-level walker is
# ../📡️component.protocol.semio, walked by dsl::walk_protocol) for `SemioImageMutation`'s real
# binary op frame. `format`/`tag` are real fixed fields; the variant's own argument payload is one
# opaque trailing blob, same boundary the real protocol file uses.

public type OpFrame = unit {
    format: uint8;                                          # OP_BINARY_FORMAT, currently 1
    tag: uint8;                                              # variant ordinal, see .ksy sibling
    payload: bytes &eod;                                      # variant's own argument text
};
