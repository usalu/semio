dialect protocol
protocol stdio.semio.image.mutations
version 1
schema s.stdio.semio.image
start body
framing record

# Real `SemioImageMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value ...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record set-dimensions tag=1
field payload bytes
record set-colorspace tag=2
field payload bytes
record set-bit-depth tag=3
field payload bytes
record set-icc tag=4
field payload bytes
record insert-frame tag=5
field payload bytes
record remove-frame tag=6
field payload bytes
record move-frame tag=7
field payload bytes
record set-frame-delay tag=8
field payload bytes
record set-frame-pixels tag=9
field payload bytes
record set-metadata-entry tag=10
field payload bytes
record remove-metadata-entry tag=11
field payload bytes
