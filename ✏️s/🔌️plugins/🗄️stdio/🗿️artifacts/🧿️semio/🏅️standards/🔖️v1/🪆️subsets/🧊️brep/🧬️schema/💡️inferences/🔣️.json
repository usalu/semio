{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json",
  "title": "SemioBrepInference",
  "description": "Derived, non-persisted computation over a SemioBrepSnapshot. See the sibling 🦀️.rs for the real source of truth.",
  "type": "object",
  "$defs": {
    "BrepMassProperties": {
      "type": "object",
      "properties": {
        "volume": {
          "type": "number"
        },
        "area": {
          "type": "number"
        },
        "centroid": {
          "$ref": "#/$defs/SemioPoint3"
        },
        "errorEstimate": {
          "type": "number"
        }
      },
      "required": [
        "volume",
        "area",
        "centroid",
        "errorEstimate"
      ]
    },
    "SemioPoint3": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "Vec3": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    }
  },
  "properties": {
    "validationReport": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "tessellation": {
      "$ref": "#/definitions/meshTransfer"
    },
    "massProperties": {
      "$ref": "#/$defs/BrepMassProperties"
    }
  },
  "required": [
    "validationReport",
    "tessellation",
    "massProperties"
  ],
  "definitions": {
    "faceGroup": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer"
        },
        "count": {
          "type": "integer"
        },
        "entityId": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "count",
        "entityId"
      ]
    },
    "edgeGroup": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer"
        },
        "count": {
          "type": "integer"
        },
        "entityId": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "count",
        "entityId"
      ]
    },
    "surfaceKind": {
      "enum": [
        "plane",
        "cylinder",
        "cone",
        "sphere",
        "torus",
        "nurbs"
      ]
    },
    "curveKind": {
      "enum": [
        "line",
        "circle",
        "ellipse",
        "nurbs"
      ]
    },
    "faceInfo": {
      "type": "object",
      "properties": {
        "entityId": {
          "type": "string"
        },
        "surfaceKind": {
          "$ref": "#/definitions/surfaceKind"
        },
        "area": {
          "type": "number"
        },
        "normal": {
          "$ref": "#/$defs/Vec3"
        }
      },
      "required": [
        "entityId",
        "surfaceKind",
        "area",
        "normal"
      ]
    },
    "edgeInfo": {
      "type": "object",
      "properties": {
        "entityId": {
          "type": "string"
        },
        "curveKind": {
          "$ref": "#/definitions/curveKind"
        },
        "length": {
          "type": "number"
        }
      },
      "required": [
        "entityId",
        "curveKind",
        "length"
      ]
    },
    "meshTransfer": {
      "type": "object",
      "description": "Tessellated mesh payload for preview upload — see ⚙️engine/🔖️contract/🦀️.rs's MeshTransfer.",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "normal": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "index": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "points": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "faceGroups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/faceGroup"
          }
        },
        "edgeGroups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/edgeGroup"
          }
        },
        "faceInfos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/faceInfo"
          }
        },
        "edgeInfos": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/edgeInfo"
          }
        }
      },
      "required": [
        "position",
        "normal",
        "index",
        "edges",
        "points",
        "faceGroups",
        "edgeGroups",
        "faceInfos",
        "edgeInfos"
      ]
    }
  }
}
