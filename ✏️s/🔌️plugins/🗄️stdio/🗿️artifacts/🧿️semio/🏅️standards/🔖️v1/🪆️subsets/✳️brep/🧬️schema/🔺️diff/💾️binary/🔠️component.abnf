; Real hand-rolled `SemioBrepDiff::print_diff`/`parse_diff` grammar (protocol::DiffCodec) --
; space-separated `collection=[removed];[modified];[added]` tokens, one per touched collection,
; hex-encoded strings/keys (every `id`/`String` field is UTF-8 hex, so `:`/`,`/`;`/`[`/`]` never
; appear unescaped inside a key). `split_top_level`/`strip_brackets` (🧰️triples) are
; bracket-depth-aware so a nested `[...]` payload (curve/surface control-point lists) never
; confuses the outer split. This text is what each `encode_diff` binary frame's opaque per-
; collection payload blob carries verbatim -- see `component.rs` (frame = `format` byte +
; `presence` bitmask byte + 0-6 varint-length-prefixed blobs of exactly this text).
diff-line     = [token *(SP token)]
token         = collection "=" named-triple
collection    = "vertices" / "edges" / "loops" / "faces" / "shells" / "solids"
named-triple  = "[" removed-list "]" ";" "[" modified-list "]" ";" "[" added-list "]"
removed-list  = [hexkey *("," hexkey)]
modified-list = [mod-entry *("," mod-entry)]
mod-entry     = hexkey ":" diff-value
added-list    = [item-value *("," item-value)]
hexkey        = 1*2HEXDIG  ; hex-encoded UTF-8 entity id, in pairs
opt-field     = "[0]" / ("[1," field-value "]")

; per-collection item / diff-value shapes (bracket-wrapped, comma-separated, SAME field order as
; the sibling 🦀️component.rs -- the authoritative source; opt-field is this collection's tri-state
; "changed to value" slot)
vertex        = "[" hexkey "," point3 "]"
vertex-diff   = "[" opt-field "]"                                   ; point
edge          = "[" hexkey "," hexkey "," hexkey "," curve "]"
edge-diff     = "[" opt-field "," opt-field "," opt-field "]"       ; startVertex,endVertex,curve
brep-loop     = "[" hexkey "," loop-edge-list "]"
loop-diff     = "[" opt-field "]"                                   ; edges
face          = "[" hexkey "," hexkey "," string-list "," surface "," bool "]"
face-diff     = "[" opt-field "," opt-field "," opt-field "," opt-field "]"  ; outerLoop,innerLoops,surface,orientation
shell         = "[" hexkey "," shell-face-list "]"
shell-diff    = "[" opt-field "]"                                   ; faces
solid         = "[" hexkey "," solid-shell-list "]"
solid-diff    = "[" opt-field "]"                                   ; shells
item-value    = vertex / edge / brep-loop / face / shell / solid
diff-value    = vertex-diff / edge-diff / loop-diff / face-diff / shell-diff / solid-diff
field-value   = point3 / hexkey / curve / surface / bool / string-list / loop-edge-list / shell-face-list / solid-shell-list

loop-edge-list   = "[" [loop-edge *("," loop-edge)] "]"
loop-edge        = "[" hexkey "," bool "]"                          ; edge,orientation
shell-face-list  = "[" [shell-face *("," shell-face)] "]"
shell-face       = "[" hexkey "," bool "]"                          ; face,orientation
solid-shell-list = "[" [solid-shell *("," solid-shell)] "]"
solid-shell      = "[" hexkey "," bool "]"                          ; shell,isVoid
string-list      = "[" [hexkey *("," hexkey)] "]"

; curve = L[origin,direction] / C[center,axis,radius] / E[center,axis,radiusMajor,radiusMinor]
;       / N[controlPoints,weights,degree,knots]
curve         = ("L[" point3 "," point3 "]")
              / ("C[" point3 "," point3 "," real "]")
              / ("E[" point3 "," point3 "," real "," real "]")
              / ("N[" point3-list "," real-list "," 1*DIGIT "," real-list "]")
; surface = P[origin,normal] / C[origin,axis,radius] / O[origin,axis,radius,halfAngle]
;         / S[center,radius] / T[center,axis,majorRadius,minorRadius]
;         / N[controlPoints,weights,uCount,vCount,degreeU,degreeV,knotsU,knotsV]
surface       = ("P[" point3 "," point3 "]")
              / ("C[" point3 "," point3 "," real "]")
              / ("O[" point3 "," point3 "," real "," real "]")
              / ("S[" point3 "," real "]")
              / ("T[" point3 "," point3 "," real "," real "]")
              / ("N[" point3-list "," real-list "," 1*DIGIT "," 1*DIGIT "," 1*DIGIT "," 1*DIGIT "," real-list "," real-list "]")
point3        = "[" real "," real "," real "]"
point3-list   = "[" [point3 *("," point3)] "]"
real          = ["-"] 1*DIGIT ["." 1*DIGIT] [("e" / "E") ["-" / "+"] 1*DIGIT]
real-list     = "[" [real *("," real)] "]"
bool          = "0" / "1"
