{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/mutation/insert-list-item/schema.json",
  "title": "InsertListItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "index",
    "value"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemioValuePathSegment"
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "value": {
      "$ref": "#/$defs/SemioValue"
    },
    "mutation": {
      "const": "insertListItem",
      "description": "Aggregate discriminator spliced in by SemioValueMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioValuePathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "key": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "SemioValue": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/value/snapshot.json#/$defs/SemioValue"
    }
  }
}
