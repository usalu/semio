{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/cad/snapshot.json",
  "title": "SemioCadSnapshot",
  "description": "Real facet mirror of 🦀️.rs (source of truth) -- layers/blocks/entities, dxf r12-informed CadEntity vocabulary.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "layers": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/CadLayer"
      }
    },
    "blocks": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/CadBlock"
      }
    },
    "entities": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/CadEntityRecord"
      }
    }
  },
  "required": [
    "schema",
    "layers",
    "blocks",
    "entities"
  ],
  "$defs": {
    "CadBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "basePoint": {
          "$ref": "#/$defs/SemioPoint2"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CadEntityRecord"
          }
        }
      },
      "required": [
        "name",
        "basePoint",
        "entities"
      ]
    },
    "CadEntity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "line"
            },
            "a": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "b": {
              "$ref": "#/$defs/SemioPoint2"
            }
          },
          "required": [
            "kind",
            "a",
            "b"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "arc"
            },
            "center": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "radius": {
              "type": "number"
            },
            "startAngle": {
              "type": "number"
            },
            "endAngle": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "radius",
            "startAngle",
            "endAngle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "circle"
            },
            "center": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ellipse"
            },
            "center": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "majorAxisEnd": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "ratio": {
              "type": "number"
            },
            "startParam": {
              "type": "number"
            },
            "endParam": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "majorAxisEnd",
            "ratio",
            "startParam",
            "endParam"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "polyline"
            },
            "vertices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioPoint2"
              }
            },
            "closed": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "vertices",
            "closed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "position": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "height": {
              "type": "number"
            },
            "rotation": {
              "type": "number"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "position",
            "height",
            "rotation",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "insert"
            },
            "blockName": {
              "type": "string"
            },
            "insertionPoint": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "scale": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "rotation": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "blockName",
            "insertionPoint",
            "scale",
            "rotation"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "solid"
            },
            "p1": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "p2": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "p3": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "p4": {
              "$ref": "#/$defs/SemioPoint2"
            }
          },
          "required": [
            "kind",
            "p1",
            "p2",
            "p3",
            "p4"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "dimension"
            },
            "defPoint": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "textPosition": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "measurement": {
              "type": "number"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "defPoint",
            "textPosition",
            "measurement",
            "text"
          ]
        }
      ]
    },
    "CadEntityRecord": {
      "type": "object",
      "description": "handle is the id key; layer must name a real layer (checked by SemioCadValidator, not this schema).",
      "properties": {
        "handle": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "entity": {
          "$ref": "#/$defs/CadEntity"
        }
      },
      "required": [
        "handle",
        "layer",
        "entity"
      ]
    },
    "CadLayer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "colorIndex": {
          "type": "integer"
        },
        "lineType": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "colorIndex",
        "lineType",
        "visible"
      ]
    },
    "SemioPoint2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    }
  }
}
