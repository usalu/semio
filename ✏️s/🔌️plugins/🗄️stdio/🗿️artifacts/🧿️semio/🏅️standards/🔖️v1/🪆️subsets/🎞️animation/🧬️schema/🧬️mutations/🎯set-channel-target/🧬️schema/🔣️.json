{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/animation/mutation/set-channel-target.json",
  "title": "SetChannelTarget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timelineIndex",
    "index",
    "target"
  ],
  "properties": {
    "timelineIndex": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "target": {
      "$ref": "#/$defs/AnimTarget"
    },
    "mutation": {
      "const": "setChannelTarget",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "AnimTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "property": {
          "$ref": "#/$defs/AnimTargetProperty"
        }
      }
    },
    "AnimTargetProperty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "translation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "rotation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "scale"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "weights"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "custom"
            },
            "name": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
