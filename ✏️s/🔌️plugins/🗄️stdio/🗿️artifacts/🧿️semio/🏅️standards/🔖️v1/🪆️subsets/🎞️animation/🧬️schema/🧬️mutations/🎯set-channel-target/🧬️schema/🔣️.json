{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/mutation/set-channel-target/schema.json",
  "title": "SetChannelTarget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timelineIndex",
    "index",
    "target"
  ],
  "properties": {
    "timelineIndex": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "target": {
      "$ref": "#/$defs/AnimTarget"
    },
    "mutation": {
      "const": "setChannelTarget",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "AnimTarget": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/snapshot.json#/definitions/AnimTarget"
    }
  }
}
