{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/mutation/set-channel-target/schema.json",
  "title": "SetChannelTarget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "timelineIndex",
    "index",
    "target"
  ],
  "properties": {
    "mutation": {
      "const": "setChannelTarget",
      "description": "Aggregate discriminator spliced in by SemioAnimationMutation; absent when the payload stands alone."
    },
    "timelineIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Timeline",
          "de": "Zeitleiste"
        },
        "description": {
          "en": "Index of the timeline, counted from 0.",
          "de": "Index der Zeitleiste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Channel",
          "de": "Kanal"
        },
        "description": {
          "en": "Index of the channel within the timeline, counted from 0.",
          "de": "Index des Kanals innerhalb der Zeitleiste, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "target": {
      "$ref": "#/$defs/AnimTarget",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Target",
          "de": "Ziel"
        },
        "description": {
          "en": "Entity and property the channel animates.",
          "de": "Entität und Eigenschaft, die der Kanal animiert."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "AnimTarget": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/animation/snapshot.json#/definitions/AnimTarget"
    }
  }
}
