dialect grammar
grammar semio.workflow.snapshot
extension semio
start document

document = envelope-line NL hex-body
envelope-line = "schema" SP "stdio.semio.workflow"
hex-body = hexbyte*
hexbyte = hexdig hexdig
hexdig = %x30-39 | %x61-66

; -- The envelope wraps a serialized SemioWorkflowSnapshot as lowercase hex (see
; -- `SemioWorkflowSnapshot::print_dsl`) -- an honest opaque wire-body boundary: this subset's
; -- snapshot is a NEUTRAL semio type (not an on-disk file format), so there is no external byte
; -- layout to describe beyond "envelope plus serialized body". The serialized body's own real
; -- shape is `{schema, nodes:[WorkflowNode], edges:[WorkflowEdge]}` per `📸️snapshot/🦀️component.rs`.
