dialect grammar
grammar semio.workflow.snapshot
extension semio
start document

# P2 pilot (workflow — the FIRST semio subset upgraded off the old hex-dump-of-JSON scaffold, per
# ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION). Real grammar for
# `SemioWorkflowSnapshot::print_dsl`/`parse_dsl` (📸️snapshot/🦀️component.rs's `print_workflow_
# snapshot_body`/`parse_workflow_snapshot_body`) — hand-rolled, NOT `#[derive(dsl::DslArtifact)]`:
# `position: SemioPoint2` would need `SemioPoint2` (`engine::geometry`, outside this ticket's
# `✳️workflow/`-only edit scope) to implement `dsl::DslField`/`DslRecord`, which it does not. Same
# hex/bracket-encoded value convention as this subset's own `🔺️diff`/`🧬️mutations` facet grammars
# (and `GifDiff`/`SvgDiff`/`DocxDiff`'s hand-rolled precedent repo-wide).
#
# `document` matches the fixture-honesty harness's own reconstructed body shape (mandatory `semio
# stdio.semio.workflow.dsl v1` preamble stripped and replaced with the bare `envelope_id()` token —
# `artifact-mark` below — before recognition, same convention `json.snapshot`'s own grammar uses).
artifact-mark = "stdio.semio.workflow"
document = artifact-mark schema-line nodes-line edges-line

schema-line = "schema" "=" hex

nodes-line = "nodes" "=" "[" node-list? "]"
node-list = node {"," node}*
node = "[" hex "," hex "," hex "," "[" param-list? "]" "," "[" number "," number "]" "]"
param-list = param {"," param}*
param = "[" hex "," hex "]"

edges-line = "edges" "=" "[" edge-list? "]"
edge-list = edge {"," edge}*
edge = "[" hex "," port "," port "," hex "]"
port = "[" hex "," hex "]"

# `SemioPoint2.x`/`.y` print via plain Rust `{v}` Display (`0`, `120.5`, `-30.25`, ...) — the shared
# lexer's `INT`/`FLOAT` scanners already capture a leading `-` when digit-adjacent (P2-M1's
# trailing-dot-float work), matching `enc_f64`/`dec_f64` lexeme-for-lexeme.
number = INT | FLOAT

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO (`📖️grammar/🦀️component.rs`'s `default_macros`) — every `id`/`kind`/`label`/`key`/
# `value`/`node`/`port`/`schema` leaf string is `enc_str` (lowercase-hex UTF-8 bytes). A hand-rolled
# `{INT|IDENT}*` production would be wrong here (see the sibling `🔺️diff`/`🧬️mutations` grammars'
# own `hex` doc comment for the two independent reasons why) — `Symbol::Ref`'s production→macro
# fallback resolves bare `hex` automatically, with real backtracking.
