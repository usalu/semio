dialect grammar
grammar semio.mesh.mutations
extension semio
start op

# P2 mesh wave: real one-line `OpText::print_op`/`parse_op` shape ALREADY emitted by
# `🧬️mutations/🦀️component.rs` (`print_semio_mesh_mutation`/`parse_semio_mesh_mutation`) —
# "keyword arg=value ..." (space-separated; space is lexer trivia at this dialect level). Every
# keyword/field-name token below is copied verbatim from the real `format!(...)` call sites in
# that file's `print_semio_mesh_mutation`, not invented.
op = no-mutation | set-snapshot | add-mesh | remove-mesh | add-primitive | remove-primitive | set-primitive-topology | set-primitive-geometry | set-primitive-material | add-material | remove-material | set-material-base-color | set-material-pbr | add-texture | remove-texture | set-texture-bytes

no-mutation = "no-mutation"
set-snapshot = "set-snapshot" "snapshot" "=" snapshot-lit
add-mesh = "add-mesh" "mesh" "=" mesh
remove-mesh = "remove-mesh" "id" "=" hex
add-primitive = "add-primitive" "mesh-id" "=" hex "primitive" "=" primitive
remove-primitive = "remove-primitive" "mesh-id" "=" hex "primitive-id" "=" hex
set-primitive-topology = "set-primitive-topology" "mesh-id" "=" hex "primitive-id" "=" hex "topology" "=" topology
set-primitive-geometry = "set-primitive-geometry" "mesh-id" "=" hex "primitive-id" "=" hex "positions" "=" "[" point3-list? "]" "normals" "=" "[" point3-list? "]" "uvs" "=" "[" uv-list? "]" "colors" "=" "[" rgba-list? "]" "indices" "=" "[" index-list? "]"
set-primitive-material = "set-primitive-material" "mesh-id" "=" hex "primitive-id" "=" hex "material-id" "=" option-hex
add-material = "add-material" "material" "=" material
remove-material = "remove-material" "id" "=" hex
set-material-base-color = "set-material-base-color" "id" "=" hex "base-color" "=" rgba
set-material-pbr = "set-material-pbr" "id" "=" hex "metallic" "=" number "roughness" "=" number
add-texture = "add-texture" "texture" "=" texture
remove-texture = "remove-texture" "id" "=" hex
set-texture-bytes = "set-texture-bytes" "id" "=" hex "mime" "=" hex "bytes" "=" hex

# `enc_mesh_snapshot`/`enc_mesh`/`enc_primitive`/`enc_material`/`enc_texture` — the same
# full-VALUE codecs `📸️snapshot/🦀️component.rs`'s own text DSL grammar declares (restated here so
# this leaf grammar is self-contained, matching the repo's existing per-facet convention).
snapshot-lit = "[" hex "," "[" mesh-list? "]" "," "[" material-list? "]" "," "[" texture-list? "]" "]"
mesh-list = mesh {"," mesh}*
mesh = "[" hex "," "[" primitive-list? "]" "]"
primitive-list = primitive {"," primitive}*
primitive = "[" hex "," topology "," "[" point3-list? "]" "," "[" point3-list? "]" "," "[" uv-list? "]" "," "[" rgba-list? "]" "," "[" index-list? "]" "," option-hex "]"
material-list = material {"," material}*
material = "[" hex "," rgba "," number "," number "]"
texture-list = texture {"," texture}*
texture = "[" hex "," hex "," hex "]"

point3-list = point3 {"," point3}*
point3 = "[" number "," number "," number "]"
uv-list = uv {"," uv}*
uv = "[" number "," number "]"
rgba-list = rgba {"," rgba}*
rgba = "[" number "," number "," number "," number "]"
index-list = INT {"," INT}*
topology = "P" | "L" | "S" | "T" | "X" | "F"
option-hex = "[" "0" "]" | "[" "1" "," hex "]"
number = INT | FLOAT

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO — a run of lowercase hex digits (`enc_str`/`hex_encode`'s own alphabet), incl. the
# empty string. `Symbol::Ref` already falls back from "no production of this name" to "macro of
# this name", so referencing `hex` with no matching production routes here automatically. Using a
# hand-rolled `{INT|IDENT}*` production instead would be wrong: it never backtracks and would
# silently swallow the next literal keyword token (e.g. `id=<hex> mime=<hex>` — the literal `mime`
# tokenizes as a plain `IDENT`, exactly like a stray hex letter run would).
