dialect grammar stdio.semio.mesh.mutations
root = document
; REAL hand-rolled OpText grammar (protocol::OpText::print_op/parse_op): either the literal
; "no-mutation", or "keyword arg=value ..." (space-separated), one keyword per SemioMeshMutation
; variant (kebab-case). 16 keywords: no-mutation, set-snapshot, add-mesh, remove-mesh,
; add-primitive, remove-primitive, set-primitive-topology, set-primitive-geometry,
; set-primitive-material, add-material, remove-material, set-material-base-color,
; set-material-pbr, add-texture, remove-texture, set-texture-bytes.
document = "no-mutation" / (KEYWORD (SP arg)*)
arg = NAME "=" VALUE
KEYWORD = 1*(%x61-7A / "-")
NAME = 1*(%x61-7A / "-")
VALUE = *(%x21-FF)   ; any non-space octet
SP = %x20
