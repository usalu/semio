dialect grammar stdio.semio.animation.snapshot
root = document
document = header body
header = 'schema' SP 'stdio.semio.animation.snapshot' NL
body = timeline*
timeline = name? channel*
channel = target interpolation keyframe*
target = node property
property = 'translation' / 'rotation' / 'scale' / 'weights' / ('custom' name)
keyframe = t value
value = ('scalar' f64) / ('vec3' f64 f64 f64) / ('quat' f64 f64 f64 f64) / ('weights' f64*)
