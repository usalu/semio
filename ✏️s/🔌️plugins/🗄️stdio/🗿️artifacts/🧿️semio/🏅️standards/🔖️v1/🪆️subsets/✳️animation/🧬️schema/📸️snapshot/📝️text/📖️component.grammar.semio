dialect grammar
grammar semio.animation.snapshot
extension semio
start document

# ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION animation wave (following the
# workflow pilot's proven template, `ws-codec-workflow-report.md`, and brep's/drawing's own
# generalization to data-carrying tagged enums, `ws-codec-brep-report.md`). Real grammar for
# `SemioAnimationSnapshot::print_dsl`/`parse_dsl` (📸️snapshot/🦀️component.rs's
# `print_animation_snapshot_body`/`parse_animation_snapshot_body`) — hand-rolled (`AnimTargetProperty`/
# `AnimValue` are data-carrying tagged enums whose variants hold different field sets; a derive-path
# `RecordSpec` cannot express the `t`/`r`/`s`/`w`/`c:<hex>` or `S:`/`V:`/`Q:`/`W:`-tagged text shape).
# Same hex/bracket-encoded value convention this subset's own `🔺️diff`/`🧬️mutations` facets use.
#
# `document` matches the fixture-honesty harness's own reconstructed body shape (mandatory `semio
# stdio.semio.animation.dsl v1` preamble stripped and replaced with the bare `envelope_id()` token —
# `artifact-mark` below — before recognition, same convention every prior semio wave's grammar uses).
artifact-mark = "s.stdio.semio.animation"
document = artifact-mark schema-line timelines-line

schema-line = "schema" "=" hex
timelines-line = "timelines" "=" "[" timeline-items? "]"
timeline-items = timeline {"," timeline}*

# `enc_timeline` — `[<option-name>,[<channel>,...]]`.
timeline = "[" option-name "," channel-list "]"
option-name = "[" "0" "]" | "[" "1" "," hex "]"
channel-list = "[" channel-items? "]"
channel-items = channel {"," channel}*

# `enc_channel` — `[<target>,<interpolation>,[<keyframe>,...]]`.
channel = "[" target "," interpolation "," keyframe-list "]"
keyframe-list = "[" keyframe-items? "]"
keyframe-items = keyframe {"," keyframe}*

# `enc_target` — `[<hex node>,<property>]`.
target = "[" hex "," property "]"

# `enc_property` — `t`/`r`/`s`/`w` for the unit variants, `c:<hex>` for `Custom{name}`. The
# trailing `:` after `c` is REQUIRED (not `c<hex>` glued directly): the shared lexer's
# `is_ident_continue` includes alphanumerics, so a bare `c` immediately followed by hex digits
# would lex as ONE fused identifier token, not two — the same class of authoring pitfall the
# grammar recipe's own pitfall #2 warns about, just at lexer-fusion level rather than
# `Symbol::Star` backtracking.
property = "t" | "r" | "s" | "w" | "c" ":" hex

# `enc_interpolation` — a single bare char, `l`/`s`/`c`.
interpolation = "l" | "s" | "c"

# `enc_keyframe` — `[<t>,<value>]`.
keyframe = "[" number "," value "]"

# `enc_value` — `S:<number>` (Scalar) / `V:<point3>` (Vec3) / `Q:<quat>` (Quat) /
# `W:[<number>,...]` (Weights).
value = "S" ":" number | "V" ":" point3 | "Q" ":" quat | "W" ":" number-list

point3 = "[" number "," number "," number "]"
quat = "[" number "," number "," number "," number "]"
number-list = "[" number-items? "]"
number-items = number {"," number}*

# `SemioPoint3.x`/`.y`/`.z`, `SemioQuaternion.x`/`.y`/`.z`/`.w`, and every `f64` field print via
# plain Rust `{v}` Display — the shared lexer's `INT`/`FLOAT` scanners already capture a leading
# `-` when digit-adjacent (P2-M1's trailing-dot-float work).
number = INT | FLOAT

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO (`📖️grammar/🦀️component.rs`'s `default_macros`) — every `schema`/`node`/`name` leaf
# string is `enc_str` (lowercase-hex UTF-8 bytes). A hand-rolled `{INT|IDENT}*` production would be
# wrong here (see the grammar recipe's own pitfall #2) — `Symbol::Ref`'s production→macro fallback
# resolves bare `hex` automatically, with real backtracking.
