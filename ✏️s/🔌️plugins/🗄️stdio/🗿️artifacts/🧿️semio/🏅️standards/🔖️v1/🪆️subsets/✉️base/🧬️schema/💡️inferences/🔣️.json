{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/base/inference.json",
  "title": "SemioInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "$ref": "#/$defs/SemioKind",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "SemioKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "ordinal"
      ],
      "properties": {
        "tag": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
