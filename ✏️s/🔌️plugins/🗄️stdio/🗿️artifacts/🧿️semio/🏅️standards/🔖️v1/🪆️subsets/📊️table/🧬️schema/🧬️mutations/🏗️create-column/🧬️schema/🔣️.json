{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/table/mutation/create-column/schema.json",
  "title": "CreateColumn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "kind"
  ],
  "properties": {
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Column name",
          "de": "Spaltenname"
        },
        "description": {
          "en": "Name the new column carries.",
          "de": "Name, den die neue Spalte trägt."
        },
        "group": "value",
        "order": 10
      }
    },
    "kind": {
      "$ref": "#/$defs/SemioTableCellKind",
      "x-semio-ui": {
        "options": {
          "null": {
            "en": "Null",
            "de": "Null"
          },
          "bool": {
            "en": "Boolean",
            "de": "Wahrheitswert"
          },
          "int": {
            "en": "Integer",
            "de": "Ganzzahl"
          },
          "float": {
            "en": "Floating point",
            "de": "Gleitkommazahl"
          },
          "str": {
            "en": "Text",
            "de": "Text"
          },
          "bytes": {
            "en": "Bytes",
            "de": "Bytes"
          }
        }
      }
    },
    "index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the columns at which it is inserted, counted from 0; cleared, the column is appended.",
          "de": "Position unter den Spalten, an der eingefügt wird, ab 0 gezählt; geleert wird die Spalte angehängt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 30
      }
    }
  },
  "$defs": {
    "SemioTableCellKind": {
      "type": "string",
      "enum": [
        "null",
        "bool",
        "int",
        "float",
        "str",
        "bytes"
      ]
    }
  }
}
