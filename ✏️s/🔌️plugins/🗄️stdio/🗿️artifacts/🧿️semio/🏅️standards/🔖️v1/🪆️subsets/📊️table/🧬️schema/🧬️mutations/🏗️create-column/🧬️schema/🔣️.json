{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/table/mutation/create-column/schema.json",
  "title": "CreateColumn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "kind"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SemioTableCellKind"
    },
    "index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "SemioTableCellKind": {
      "type": "string",
      "enum": [
        "null",
        "bool",
        "int",
        "float",
        "str",
        "bytes"
      ]
    }
  }
}
