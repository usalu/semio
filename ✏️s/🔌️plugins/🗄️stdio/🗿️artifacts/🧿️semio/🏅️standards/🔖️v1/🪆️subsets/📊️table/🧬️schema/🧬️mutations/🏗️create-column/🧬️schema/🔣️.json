{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/table/mutation/create-column/schema.json",
  "title": "CreateColumn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "kind"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SemioTableCellKind",
      "x-semio-ui": {
        "options": {
          "null": {
            "en": "Null",
            "de": "Null"
          },
          "bool": {
            "en": "Boolean",
            "de": "Wahrheitswert"
          },
          "int": {
            "en": "Integer",
            "de": "Ganzzahl"
          },
          "float": {
            "en": "Floating point",
            "de": "Gleitkommazahl"
          },
          "str": {
            "en": "Text",
            "de": "Text"
          },
          "bytes": {
            "en": "Bytes",
            "de": "Bytes"
          }
        }
      }
    },
    "index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "SemioTableCellKind": {
      "type": "string",
      "enum": [
        "null",
        "bool",
        "int",
        "float",
        "str",
        "bytes"
      ]
    }
  }
}
