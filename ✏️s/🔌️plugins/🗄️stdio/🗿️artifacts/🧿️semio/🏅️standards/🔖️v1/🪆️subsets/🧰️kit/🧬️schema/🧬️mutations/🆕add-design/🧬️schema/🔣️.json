{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/kit/mutation/add-design/schema.json",
  "title": "AddDesign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Design id",
          "de": "Entwurfs-ID"
        },
        "description": {
          "en": "Id the new design carries.",
          "de": "Kennung, die der neue Entwurf trägt."
        },
        "group": "value",
        "order": 10
      }
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Name",
          "de": "Name"
        },
        "description": {
          "en": "Display name of the new design.",
          "de": "Anzeigename des neuen Entwurfs."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
