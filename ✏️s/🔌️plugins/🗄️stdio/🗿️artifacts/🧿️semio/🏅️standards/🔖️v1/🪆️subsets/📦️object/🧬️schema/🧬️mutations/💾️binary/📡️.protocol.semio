dialect protocol
protocol stdio.semio.object.mutations
version 1
schema s.stdio.semio.object
start body
framing record

# Real `SemioObjectMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's `key=value ...` text arguments.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records (`dsl::protocol_record`), and decodes a tag to its record's kind.
header fixed 2
field format u8
field tag u8
record move-object tag=0
field payload bytes
record rotate-object tag=1
field payload bytes
record scale-object tag=2
field payload bytes
record create-brep tag=3
field payload bytes
record delete-brep tag=4
field payload bytes
record create-mesh tag=5
field payload bytes
record delete-mesh tag=6
field payload bytes
record create-properties tag=7
field payload bytes
record delete-properties tag=8
field payload bytes
