{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/mutation/remove-node-property/schema.json",
  "title": "RemoveNodeProperty",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "index"
  ],
  "properties": {
    "node_id": {
      "$ref": "#/$defs/GraphNodeId"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "GraphNodeId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string"
        }
      }
    }
  }
}
