{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/graph/snapshot/text.json",
  "title": "SemioGraphSnapshotDsl",
  "description": "Text-encoding mirror of the snapshot facet — see ../🔣️.json for the canonical facet schema.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "x": {
            "type": "string"
          },
          "y": {
            "type": "string"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind",
                "category",
                "properties"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "i",
                    "o",
                    "x"
                  ]
                },
                "category": {
                  "type": "string"
                },
                "properties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "width": {
            "type": "string"
          },
          "height": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "x",
          "y",
          "width",
          "height",
          "ports",
          "properties"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "sourcePort": {
            "type": "string"
          },
          "targetPort": {
            "type": "string"
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "kind",
          "label",
          "sourcePort",
          "targetPort",
          "properties"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "nodes",
    "edges"
  ]
}
