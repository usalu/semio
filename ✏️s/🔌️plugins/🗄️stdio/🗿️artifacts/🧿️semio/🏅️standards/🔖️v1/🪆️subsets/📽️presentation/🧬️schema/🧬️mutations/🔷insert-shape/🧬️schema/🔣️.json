{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/mutation/insert-shape/schema.json",
  "title": "InsertShape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "slide_index",
    "shape_index",
    "shape"
  ],
  "properties": {
    "mutation": {
      "const": "insertShape",
      "description": "Aggregate discriminator spliced in by SemioPresentationMutation; absent when the payload stands alone."
    },
    "slide_index": {
      "type": "integer",
      "minimum": 0
    },
    "shape_index": {
      "type": "integer",
      "minimum": 0
    },
    "shape": {
      "$ref": "#/$defs/SlideShape",
      "x-semio-ui": {
        "label": {
          "en": "Shape",
          "de": "Form"
        }
      }
    }
  },
  "$defs": {
    "SlideShape": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/snapshot.json#/definitions/SlideShape"
    }
  }
}
