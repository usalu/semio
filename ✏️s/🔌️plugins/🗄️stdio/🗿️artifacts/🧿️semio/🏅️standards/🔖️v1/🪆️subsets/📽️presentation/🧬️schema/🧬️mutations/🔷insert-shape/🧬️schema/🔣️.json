{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/mutation/insert-shape/schema.json",
  "title": "InsertShape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "slide_index",
    "shape_index",
    "shape"
  ],
  "properties": {
    "mutation": {
      "const": "insertShape",
      "description": "Aggregate discriminator spliced in by SemioPresentationMutation; absent when the payload stands alone."
    },
    "slide_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Slide",
          "de": "Folie"
        },
        "description": {
          "en": "Index of the slide, counted from 0.",
          "de": "Index der Folie, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "shape_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the shapes of the slide at which it is inserted, counted from 0.",
          "de": "Position unter den Formen der Folie, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "shape": {
      "$ref": "#/$defs/SlideShape",
      "x-semio-ui": {
        "label": {
          "en": "Shape",
          "de": "Form"
        }
      }
    }
  },
  "$defs": {
    "SlideShape": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/presentation/snapshot.json#/definitions/SlideShape"
    }
  }
}
