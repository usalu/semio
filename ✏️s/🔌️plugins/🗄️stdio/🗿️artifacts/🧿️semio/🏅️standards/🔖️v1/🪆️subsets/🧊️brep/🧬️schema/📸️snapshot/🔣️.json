{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/brep/snapshot.json",
  "title": "SemioBrepSnapshot",
  "description": "id-keyed b-rep topology graph — see the sibling 🦀️.rs for the real source of truth.",
  "type": "object",
  "$defs": {
    "BrepCoedge": {
      "type": "object",
      "description": "First-class p-curve/ring-position coedge — see native Coedge; a separate, purely-additive collection (never widens brepLoopEdge, see 🦀️.rs doc comment).",
      "properties": {
        "id": {
          "type": "string"
        },
        "edge": {
          "type": "string"
        },
        "forward": {
          "type": "boolean"
        },
        "pcurve": {
          "oneOf": [
            {
              "$ref": "#/$defs/BrepCurve2"
            },
            {
              "type": "null"
            }
          ]
        },
        "prange": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "loopId": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "prev": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "edge",
        "forward",
        "pcurve",
        "prange",
        "loopId",
        "next",
        "prev"
      ]
    },
    "BrepCurve": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "line"
            },
            "origin": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "direction": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            }
          },
          "required": [
            "kind",
            "origin",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "circle"
            },
            "center": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "axis": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "axis",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ellipse"
            },
            "center": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "axis": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "radiusMajor": {
              "type": "number"
            },
            "radiusMinor": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "axis",
            "radiusMajor",
            "radiusMinor"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "nurbs"
            },
            "controlPoints": {
              "type": "array",
              "items": {
                "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
              }
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "degree": {
              "type": "integer"
            },
            "knots": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "kind",
            "controlPoints",
            "weights",
            "degree",
            "knots"
          ]
        }
      ]
    },
    "BrepCurve2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "line"
            },
            "origin": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "direction": {
              "$ref": "#/$defs/SemioPoint2"
            }
          },
          "required": [
            "kind",
            "origin",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "circle"
            },
            "center": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ellipse"
            },
            "center": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "xAxis": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "radiusMajor": {
              "type": "number"
            },
            "radiusMinor": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "xAxis",
            "radiusMajor",
            "radiusMinor"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "nurbs"
            },
            "controlPoints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioPoint2"
              }
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "degree": {
              "type": "integer"
            },
            "knots": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "kind",
            "controlPoints",
            "weights",
            "degree",
            "knots"
          ]
        }
      ]
    },
    "BrepEdge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "startVertex": {
          "type": "string"
        },
        "endVertex": {
          "type": "string"
        },
        "curve": {
          "$ref": "#/$defs/BrepCurve"
        },
        "tol": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "startVertex",
        "endVertex",
        "curve",
        "tol"
      ]
    },
    "BrepFace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "outerLoop": {
          "type": "string"
        },
        "innerLoops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surface": {
          "$ref": "#/$defs/BrepSurface"
        },
        "orientation": {
          "type": "boolean"
        },
        "tol": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "outerLoop",
        "innerLoops",
        "surface",
        "orientation",
        "tol"
      ]
    },
    "BrepLoop": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrepLoopEdge"
          }
        }
      },
      "required": [
        "id",
        "edges"
      ]
    },
    "BrepLoopEdge": {
      "type": "object",
      "properties": {
        "edge": {
          "type": "string"
        },
        "orientation": {
          "type": "boolean"
        }
      },
      "required": [
        "edge",
        "orientation"
      ]
    },
    "BrepShell": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "faces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrepShellFace"
          }
        }
      },
      "required": [
        "id",
        "faces"
      ]
    },
    "BrepShellFace": {
      "type": "object",
      "properties": {
        "face": {
          "type": "string"
        },
        "orientation": {
          "type": "boolean"
        }
      },
      "required": [
        "face",
        "orientation"
      ]
    },
    "BrepSolid": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "shells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrepSolidShell"
          }
        }
      },
      "required": [
        "id",
        "shells"
      ]
    },
    "BrepSolidShell": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "string"
        },
        "isVoid": {
          "type": "boolean"
        }
      },
      "required": [
        "shell",
        "isVoid"
      ]
    },
    "BrepSurface": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "plane"
            },
            "origin": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "normal": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            }
          },
          "required": [
            "kind",
            "origin",
            "normal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cylinder"
            },
            "origin": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "axis": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "origin",
            "axis",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cone"
            },
            "origin": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "axis": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "radius": {
              "type": "number"
            },
            "halfAngle": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "origin",
            "axis",
            "radius",
            "halfAngle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sphere"
            },
            "center": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "torus"
            },
            "center": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "axis": {
              "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
            },
            "majorRadius": {
              "type": "number"
            },
            "minorRadius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "axis",
            "majorRadius",
            "minorRadius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "nurbs"
            },
            "controlPoints": {
              "type": "array",
              "items": {
                "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
              }
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "uCount": {
              "type": "integer"
            },
            "vCount": {
              "type": "integer"
            },
            "degreeU": {
              "type": "integer"
            },
            "degreeV": {
              "type": "integer"
            },
            "knotsU": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "knotsV": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "kind",
            "controlPoints",
            "weights",
            "uCount",
            "vCount",
            "degreeU",
            "degreeV",
            "knotsU",
            "knotsV"
          ]
        }
      ]
    },
    "BrepVertex": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "point": {
          "$ref": "https://semio.tech/schema/s/stdio/semio/v1/brep/inference.json#/$defs/semioPoint3"
        },
        "tol": {
          "type": "number",
          "description": "native Vertex::tol; <= 0.0 means unspecified"
        }
      },
      "required": [
        "id",
        "point",
        "tol"
      ]
    },
    "SemioPoint2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "vertices": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepVertex"
      }
    },
    "edges": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepEdge"
      }
    },
    "loops": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepLoop"
      }
    },
    "faces": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepFace"
      }
    },
    "shells": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepShell"
      }
    },
    "solids": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepSolid"
      }
    },
    "coedges": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepCoedge"
      },
      "description": "empty for snapshots produced before this field existed"
    },
    "nextLabel": {
      "type": "integer",
      "x-semio-state": "artifact",
      "description": "native LabelSource high-water mark; 0 means no persistent-label history to preserve"
    }
  },
  "required": [
    "schema",
    "vertices",
    "edges",
    "loops",
    "faces",
    "shells",
    "solids",
    "coedges",
    "nextLabel"
  ]
}
