{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/snapshot.json",
  "title": "SemioBrepSnapshot",
  "description": "id-keyed b-rep topology graph — see the sibling 🦀️.rs for the real source of truth.",
  "type": "object",
  "$defs": {
    "BrepCoedge": {
      "type": "object",
      "description": "First-class p-curve/ring-position coedge — see native Coedge; a separate, purely-additive collection (never widens brepLoopEdge, see 🦀️.rs doc comment).",
      "properties": {
        "id": {
          "type": "string"
        },
        "edge": {
          "type": "string"
        },
        "forward": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Same direction as edge",
              "de": "Gleichsinnig zur Kante"
            }
          }
        },
        "pcurve": {
          "oneOf": [
            {
              "$ref": "#/$defs/BrepCurve2"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Parameter curve",
              "de": "Parameterkurve"
            },
            "description": {
              "en": "Curve of the coedge in the face's parameter space.",
              "de": "Kurve der Koante im Parameterraum der Fläche."
            }
          }
        },
        "prange": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "x-semio-ui": {
            "widget": "vector",
            "label": {
              "en": "Parameter range",
              "de": "Parameterbereich"
            }
          }
        },
        "loopId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Loop",
              "de": "Schleife"
            },
            "ref": {
              "kind": "loop"
            }
          }
        },
        "next": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Next coedge",
              "de": "Nächste Koante"
            },
            "ref": {
              "kind": "coedge"
            }
          }
        },
        "prev": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Previous coedge",
              "de": "Vorherige Koante"
            },
            "ref": {
              "kind": "coedge"
            }
          }
        }
      },
      "required": [
        "id",
        "edge",
        "forward",
        "pcurve",
        "prange",
        "loopId",
        "next",
        "prev"
      ]
    },
    "BrepCurve": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "line"
            },
            "origin": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "direction": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            }
          },
          "required": [
            "kind",
            "origin",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "circle"
            },
            "center": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "axis": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "axis",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ellipse"
            },
            "center": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "axis": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "radiusMajor": {
              "type": "number"
            },
            "radiusMinor": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "axis",
            "radiusMajor",
            "radiusMinor"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "nurbs"
            },
            "controlPoints": {
              "type": "array",
              "items": {
                "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
              }
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "degree": {
              "type": "integer"
            },
            "knots": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "kind",
            "controlPoints",
            "weights",
            "degree",
            "knots"
          ]
        }
      ]
    },
    "BrepCurve2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "line"
            },
            "origin": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "direction": {
              "$ref": "#/$defs/SemioPoint2"
            }
          },
          "required": [
            "kind",
            "origin",
            "direction"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "circle"
            },
            "center": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ellipse"
            },
            "center": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "xAxis": {
              "$ref": "#/$defs/SemioPoint2"
            },
            "radiusMajor": {
              "type": "number"
            },
            "radiusMinor": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "xAxis",
            "radiusMajor",
            "radiusMinor"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "nurbs"
            },
            "controlPoints": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SemioPoint2"
              }
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "degree": {
              "type": "integer"
            },
            "knots": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "kind",
            "controlPoints",
            "weights",
            "degree",
            "knots"
          ]
        }
      ]
    },
    "BrepEdge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "startVertex": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Start vertex",
              "de": "Startpunkt"
            },
            "ref": {
              "kind": "vertex"
            }
          }
        },
        "endVertex": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "End vertex",
              "de": "Endpunkt"
            },
            "ref": {
              "kind": "vertex"
            }
          }
        },
        "curve": {
          "$ref": "#/$defs/BrepCurve",
          "x-semio-ui": {
            "label": {
              "en": "Curve",
              "de": "Kurve"
            }
          }
        },
        "tol": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "startVertex",
        "endVertex",
        "curve",
        "tol"
      ]
    },
    "BrepFace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "outerLoop": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Outer loop",
              "de": "Äußere Schleife"
            },
            "ref": {
              "kind": "loop"
            }
          }
        },
        "innerLoops": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Inner loops",
              "de": "Innere Schleifen"
            },
            "description": {
              "en": "Loops that bound holes in the face.",
              "de": "Schleifen, die Löcher in der Fläche begrenzen."
            },
            "ref": {
              "kind": "loop"
            }
          }
        },
        "surface": {
          "$ref": "#/$defs/BrepSurface",
          "x-semio-ui": {
            "label": {
              "en": "Surface",
              "de": "Fläche (Geometrie)"
            }
          }
        },
        "orientation": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Same orientation",
              "de": "Gleichsinnig orientiert"
            },
            "description": {
              "en": "On: the use agrees with the element's natural orientation.",
              "de": "An: Die Verwendung stimmt mit der natürlichen Orientierung überein."
            }
          }
        },
        "tol": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "outerLoop",
        "innerLoops",
        "surface",
        "orientation",
        "tol"
      ]
    },
    "BrepLoop": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrepLoopEdge"
          },
          "x-semio-ui": {
            "label": {
              "en": "Edges",
              "de": "Kanten"
            }
          }
        }
      },
      "required": [
        "id",
        "edges"
      ]
    },
    "BrepLoopEdge": {
      "type": "object",
      "properties": {
        "edge": {
          "type": "string"
        },
        "orientation": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Same orientation",
              "de": "Gleichsinnig orientiert"
            },
            "description": {
              "en": "On: the use agrees with the element's natural orientation.",
              "de": "An: Die Verwendung stimmt mit der natürlichen Orientierung überein."
            }
          }
        }
      },
      "required": [
        "edge",
        "orientation"
      ]
    },
    "BrepShell": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "faces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrepShellFace"
          }
        }
      },
      "required": [
        "id",
        "faces"
      ]
    },
    "BrepShellFace": {
      "type": "object",
      "properties": {
        "face": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Face",
              "de": "Fläche"
            },
            "ref": {
              "kind": "face"
            }
          }
        },
        "orientation": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Same orientation",
              "de": "Gleichsinnig orientiert"
            },
            "description": {
              "en": "On: the use agrees with the element's natural orientation.",
              "de": "An: Die Verwendung stimmt mit der natürlichen Orientierung überein."
            }
          }
        }
      },
      "required": [
        "face",
        "orientation"
      ]
    },
    "BrepSolid": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "shells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrepSolidShell"
          },
          "x-semio-ui": {
            "label": {
              "en": "Shells",
              "de": "Schalen"
            }
          }
        }
      },
      "required": [
        "id",
        "shells"
      ]
    },
    "BrepSolidShell": {
      "type": "object",
      "properties": {
        "shell": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Shell",
              "de": "Schale"
            },
            "ref": {
              "kind": "shell"
            }
          }
        },
        "isVoid": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Void shell",
              "de": "Hohlraumschale"
            },
            "description": {
              "en": "The shell bounds a cavity inside the solid.",
              "de": "Die Schale begrenzt einen Hohlraum im Körper."
            }
          }
        }
      },
      "required": [
        "shell",
        "isVoid"
      ]
    },
    "BrepSurface": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "plane"
            },
            "origin": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "normal": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            }
          },
          "required": [
            "kind",
            "origin",
            "normal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cylinder"
            },
            "origin": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "axis": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "origin",
            "axis",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cone"
            },
            "origin": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "axis": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "radius": {
              "type": "number"
            },
            "halfAngle": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "origin",
            "axis",
            "radius",
            "halfAngle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sphere"
            },
            "center": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "radius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "radius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "torus"
            },
            "center": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "axis": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
            },
            "majorRadius": {
              "type": "number"
            },
            "minorRadius": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "center",
            "axis",
            "majorRadius",
            "minorRadius"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "nurbs"
            },
            "controlPoints": {
              "type": "array",
              "items": {
                "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
              }
            },
            "weights": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "uCount": {
              "type": "integer"
            },
            "vCount": {
              "type": "integer"
            },
            "degreeU": {
              "type": "integer"
            },
            "degreeV": {
              "type": "integer"
            },
            "knotsU": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "knotsV": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "kind",
            "controlPoints",
            "weights",
            "uCount",
            "vCount",
            "degreeU",
            "degreeV",
            "knotsU",
            "knotsV"
          ]
        }
      ]
    },
    "BrepVertex": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "point": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/brep/inference.json#/$defs/SemioPoint3"
        },
        "tol": {
          "type": "number",
          "description": "native Vertex::tol containment radius in model units, persisted explicitly"
        }
      },
      "required": [
        "id",
        "point",
        "tol"
      ]
    },
    "SemioPoint2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "vertices": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepVertex"
      },
      "x-semio-ui": {
        "label": {
          "en": "Vertices",
          "de": "Eckpunkte"
        }
      }
    },
    "edges": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepEdge"
      },
      "x-semio-ui": {
        "label": {
          "en": "Edges",
          "de": "Kanten"
        }
      }
    },
    "loops": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepLoop"
      },
      "x-semio-ui": {
        "label": {
          "en": "Loops",
          "de": "Schleifen"
        }
      }
    },
    "faces": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepFace"
      }
    },
    "shells": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepShell"
      },
      "x-semio-ui": {
        "label": {
          "en": "Shells",
          "de": "Schalen"
        }
      }
    },
    "solids": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepSolid"
      },
      "x-semio-ui": {
        "label": {
          "en": "Solids",
          "de": "Körper"
        }
      }
    },
    "coedges": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BrepCoedge"
      },
      "description": "empty for snapshots produced before this field existed",
      "x-semio-ui": {
        "label": {
          "en": "Coedges",
          "de": "Koanten"
        },
        "description": {
          "en": "Oriented uses of edges inside loops.",
          "de": "Orientierte Verwendungen von Kanten in Schleifen."
        }
      }
    },
    "nextLabel": {
      "type": "integer",
      "x-semio-state": "artifact",
      "description": "native LabelSource high-water mark; 0 means no persistent-label history to preserve",
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Next persistent label",
          "de": "Nächste persistente Kennung"
        },
        "description": {
          "en": "High-water mark of the persistent label source; 0 means no history.",
          "de": "Höchststand der Quelle persistenter Kennungen; 0 bedeutet keine Historie."
        }
      }
    }
  },
  "required": [
    "schema",
    "vertices",
    "edges",
    "loops",
    "faces",
    "shells",
    "solids",
    "coedges",
    "nextLabel"
  ]
}
