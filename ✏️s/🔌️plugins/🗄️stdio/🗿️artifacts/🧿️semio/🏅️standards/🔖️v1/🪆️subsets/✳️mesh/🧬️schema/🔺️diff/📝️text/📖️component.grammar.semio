dialect grammar stdio.semio.mesh.diff
root = document
; REAL hand-rolled DiffCodec grammar (protocol::DiffCodec::print_diff/parse_diff), not a hex-JSON
; envelope: space-separated `key=value` tokens, one per changed top-level field. Each value is a
; bracket-depth-aware named triple `[removed];[modified];[added]`
; (engine::triples::enc_named_triple/dec_named_triple, split_top_level/strip_brackets).
document = (token (SP token)*)?
token = "meshes=" triple / "materials=" triple / "textures=" triple
triple = "[" list "]" ";" "[" list "]" ";" "[" list "]"
list = (item ("," item)*)?
item = HEXSTR (":" payload)?
payload = *(%x00-2B / %x2D / %x2E-3A / %x3C-FF)   ; any octet except "," (0x2C) and ";" (0x3B) at this depth
HEXSTR = *(%x30-39 / %x41-46 / %x61-66)
SP = %x20
