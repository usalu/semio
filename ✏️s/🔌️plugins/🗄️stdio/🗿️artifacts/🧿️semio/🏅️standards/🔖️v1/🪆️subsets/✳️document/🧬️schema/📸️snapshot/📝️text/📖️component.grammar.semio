dialect grammar
grammar stdio.semio.document.snapshot
extension semio
start document

# ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION document wave (following the
# flow/model/brep pilots' proven template, `ws-codec-workflow-report.md`). Real grammar for
# `SemioDocumentSnapshot::print_dsl`/`parse_dsl` (📸️snapshot/🦀️component.rs's
# `print_document_snapshot_body`/`parse_document_snapshot_body`) — hand-rolled (`DocBlock` is a
# data-carrying tagged enum with heterogeneous per-variant field sets; no `dsl::DslField`/`DslEnum`
# impl exists for it). Reuses the SAME hex/bracket-encoded value convention `🔺️diff`'s
# `enc_style`/`enc_image`/`enc_block` already established pre-wave (restated here so this leaf
# grammar is self-contained, matching the repo's existing per-facet convention).
#
# `document` matches the fixture-honesty harness's own reconstructed body shape (mandatory `semio
# stdio.semio.document.dsl v1` preamble stripped and replaced with the bare `envelope_id()` token —
# `artifact-mark` below — before recognition, same convention `json.snapshot`'s own grammar uses).
artifact-mark = "s.stdio.semio.document"
document = artifact-mark schema-line styles-line images-line blocks-line

schema-line = "schema" "=" hex

styles-line = "styles" "=" "[" style-items? "]"
style-items = style {"," style}*
images-line = "images" "=" "[" image-items? "]"
image-items = image {"," image}*
blocks-line = "blocks" "=" "[" block-items? "]"
block-items = block {"," block}*

# `enc_style`/`enc_image` — field order matches `🔺️diff/🦀️component.rs`'s `enc_style`/`enc_image`
# exactly (the authoritative source, reused verbatim by this facet).
style = "[" hex "," hex "," option-hex "]"
image = "[" hex "," hex "," hex "]"

# `DocBlock`: `P[...]` (Paragraph) / `H[...]` (Heading) / `L[...]` (List) / `T[...]` (Table) /
# `C[...]` (Code) / `Q[...]` (Quote) / `I[...]` (Image) / `B[]` (PageBreak) — single-letter tag
# prefix, same convention `enc_block` (🔺️diff/🦀️component.rs) uses.
block = "P" "[" option-hex "," "[" run-items? "]" "]" | "H" "[" INT "," option-hex "," "[" run-items? "]" "]" | "L" "[" bool "," "[" list-item-items? "]" "]" | "T" "[" "[" row-items? "]" "]" | "C" "[" option-hex "," hex "]" | "Q" "[" "[" block-items? "]" "]" | "I" "[" hex "," hex "," option-f64 "," option-f64 "]" | "B" "[" "]"

run-items = run {"," run}*
run = "[" hex "," run-style "]"
run-style = "[" bool "," bool "," bool "," option-f64 "," option-hex "," option-hex "," option-hex "]"

list-item-items = list-item {"," list-item}*
list-item = "[" "[" block-items? "]" "]"

row-items = row {"," row}*
row = "[" "[" cell-items? "]" "]"
cell-items = cell {"," cell}*
cell = "[" "[" block-items? "]" "]"

option-hex = "[" "0" "]" | "[" "1" "," hex "]"
# `enc_f64` prints `f64::to_bits()` (a `u64` bit pattern) as plain decimal digits, NOT a float
# literal — `dec_f64` parses it back via `u64::from_str`/`f64::from_bits` — so every `f64` leaf
# below (including `level: u8` via `enc_u8`) is a bare `INT` token, never `FLOAT`.
option-f64 = "[" "0" "]" | "[" "1" "," INT "]"
bool = "0" | "1"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in
# `hex` MACRO — a run of lowercase hex digits (`enc_str`/`hex_encode`'s own alphabet), incl. the
# empty string. `Symbol::Ref`'s production->macro fallback resolves bare `hex` automatically, with
# real backtracking — a hand-rolled `{INT|IDENT}*` production would be wrong here (see the grammar
# recipe's own §3 pitfall #2).
