{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/video/mutation/insert-stream/schema.json",
  "title": "InsertStream",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "stream"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "stream": {
      "$ref": "#/$defs/SemioVideoStream"
    },
    "mutation": {
      "const": "insertStream",
      "description": "Aggregate discriminator spliced in by SemioVideoMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "SemioVideoStream": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/video/snapshot.json#/$defs/SemioVideoStream"
    }
  }
}
