{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/video/mutation/insert-stream/schema.json",
  "title": "InsertStream",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "stream"
  ],
  "properties": {
    "mutation": {
      "const": "insertStream",
      "description": "Aggregate discriminator spliced in by SemioVideoMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the streams at which it is inserted, counted from 0.",
          "de": "Position unter den Datenströmen, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "stream": {
      "$ref": "#/$defs/SemioVideoStream",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Stream",
          "de": "Datenstrom"
        },
        "description": {
          "en": "Kind, codec, dimensions, rate and samples of the stream that is inserted.",
          "de": "Art, Codec, Abmessungen, Rate und Samples des Datenstroms, der eingefügt wird."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "SemioVideoStream": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/video/snapshot.json#/$defs/SemioVideoStream"
    }
  }
}
