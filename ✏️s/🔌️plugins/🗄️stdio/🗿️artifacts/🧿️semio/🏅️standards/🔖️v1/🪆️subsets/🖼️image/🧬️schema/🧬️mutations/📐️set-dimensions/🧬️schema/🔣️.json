{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/semio/v1/image/mutation/set-dimensions/schema.json",
  "title": "SetDimensions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "height"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "mutation": {
      "const": "setDimensions",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    }
  }
}
