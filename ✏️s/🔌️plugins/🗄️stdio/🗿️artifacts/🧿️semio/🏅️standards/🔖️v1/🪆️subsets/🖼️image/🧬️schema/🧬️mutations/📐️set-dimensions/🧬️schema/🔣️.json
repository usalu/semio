{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/semio/v1/image/mutation/set-dimensions/schema.json",
  "title": "SetDimensions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "width",
    "height"
  ],
  "properties": {
    "mutation": {
      "const": "setDimensions",
      "description": "Aggregate discriminator spliced in by SemioImageMutation; absent when the payload stands alone."
    },
    "width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Width",
          "de": "Breite"
        },
        "description": {
          "en": "Width of every frame.",
          "de": "Breite jedes Einzelbilds."
        },
        "unit": "px",
        "step": 1,
        "precision": 0,
        "softMax": 16384,
        "group": "value",
        "order": 10
      }
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Height",
          "de": "Höhe"
        },
        "description": {
          "en": "Height of every frame.",
          "de": "Höhe jedes Einzelbilds."
        },
        "unit": "px",
        "step": 1,
        "precision": 0,
        "softMax": 16384,
        "group": "value",
        "order": 20
      }
    }
  }
}
