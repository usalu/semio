{
  "$id": "https://semio.tech/schema/s.stdio.txt/snapshot.json",
  "title": "TxtSnapshot",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "persistent"
    },
    "lines": {
      "type": "array",
      "items": { "type": "string" },
      "x-semio-state": "persistent"
    },
    "trailingNewline": {
      "type": "boolean",
      "x-semio-state": "persistent"
    },
    "lineEnding": {
      "type": "string",
      "enum": ["lf", "crLf"],
      "x-semio-state": "persistent"
    }
  },
  "required": ["schema", "lines", "trailingNewline", "lineEnding"]
}
