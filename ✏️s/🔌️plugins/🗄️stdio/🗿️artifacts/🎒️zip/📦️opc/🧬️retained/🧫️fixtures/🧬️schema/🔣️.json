{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "payload", "parts", "contentTypes", "relationships", "comment", "grant", "expected"],
  "properties": {
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "multiplier", "increment"],
      "properties": {
        "length": { "const": 6145 },
        "multiplier": { "type": "integer", "minimum": 1, "maximum": 255 },
        "increment": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contentType", "payload"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "contentType": { "type": "string", "minLength": 1 },
          "payload": { "enum": ["pattern", "empty"] }
        }
      }
    },
    "contentTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults", "overrides"],
      "properties": {
        "defaults": { "$ref": "#/$defs/pairs" },
        "overrides": { "$ref": "#/$defs/pairs" }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "entries"],
        "properties": {
          "owner": { "type": "string" },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "relType", "target", "targetMode"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "relType": { "type": "string", "minLength": 1 },
                "target": { "type": "string", "minLength": 1 },
                "targetMode": { "enum": ["internal", "external"] }
              }
            }
          }
        }
      }
    },
    "comment": { "type": "string" },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumItems", "maximumCopyBytes", "maximumCapacityBytes", "maximumDepth"],
      "properties": {
        "maximumItems": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maximumCopyBytes": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maximumCapacityBytes": { "const": 4096 },
        "maximumDepth": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePreserved", "orderPreserved", "copyRequiresMultipleTurns", "closeRequiresMultipleTurns", "terminalEmpty"],
      "properties": {
        "sourcePreserved": { "const": true },
        "orderPreserved": { "const": true },
        "copyRequiresMultipleTurns": { "const": true },
        "closeRequiresMultipleTurns": { "const": true },
        "terminalEmpty": { "const": true }
      }
    }
  },
  "$defs": {
    "pairs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [{ "type": "string", "minLength": 1 }, { "type": "string", "minLength": 1 }],
        "items": false
      }
    }
  }
}
