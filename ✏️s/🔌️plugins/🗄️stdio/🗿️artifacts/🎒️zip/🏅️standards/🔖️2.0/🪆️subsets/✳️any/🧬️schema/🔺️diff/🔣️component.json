{
  "$id": "https://semio.tech/schema/s.stdio.zip/diff.json",
  "title": "ZipDiff",
  "type": "object",
  "$defs": {
    "ZipEntry": { "type": "object", "required": ["name", "data"], "properties": { "name": { "type": "string" }, "data": { "type": "array", "items": { "type": "integer" } } } },
    "ZipEntryDiff": { "type": "object", "properties": { "name": { "type": "string" }, "data": { "type": "array", "items": { "type": "integer" } } } },
    "ZipEntryModified": { "type": "object", "required": ["name", "diff"], "properties": { "name": { "type": "string" }, "diff": { "$ref": "#/$defs/ZipEntryDiff" } } },
    "ZipEntriesDiff": { "type": "object", "properties": { "removed": { "type": "array", "items": { "type": "string" } }, "modified": { "type": "array", "items": { "$ref": "#/$defs/ZipEntryModified" } }, "added": { "type": "array", "items": { "$ref": "#/$defs/ZipEntry" } } } }
  },
  "properties": { "comment": { "type": "string" }, "entries": { "$ref": "#/$defs/ZipEntriesDiff" } }
}
