{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/zip/2.0/base/inference.json",
  "title": "ZipInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "$ref": "#/$defs/ZipEntries",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "ZipEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryCount",
        "totalUncompressedSize",
        "contentDigest"
      ],
      "properties": {
        "entryCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalUncompressedSize": {
          "type": "integer",
          "minimum": 0
        },
        "contentDigest": {
          "type": "string"
        }
      }
    }
  }
}
