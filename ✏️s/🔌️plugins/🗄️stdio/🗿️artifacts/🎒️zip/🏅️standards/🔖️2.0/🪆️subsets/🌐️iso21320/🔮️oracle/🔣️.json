  "comparisonProfiles": [
    {
      "id": "semantic-zip-iso21320-v1",
      "description": "ISO/IEC 21320-1 archives compared as a SET of members by name, uncompressed size and content digest, plus the archive-level comment as a normative field, plus the two ISO/IEC 21320-1 predicates per member: isoCompressionAllowed (the wire compression method is Stored or Deflate, §4.4) and encrypted (§4.1 forbids it). The predicate and not the method: §4.4 admits BOTH Stored and Deflate, so which of the two a writer picks for a given member is writer freedom — comparing the method itself would compare this repository's own canonical_compression_method policy against a copy of that policy planted in the oracle, which is the exact failure this platform exists to prevent. Entry order, compression level, timestamps, attributes and the extra field remain writer freedom as in the base archive profile.",
      "arrays": "set",
      "ignoreKeys": [
        "compressedSize",
        "compressionMethod",
        "compressionLevel",
        "modified",
        "created",
        "accessed",
        "externalAttributes",
        "internalAttributes",
        "extraField",
        "crcOrder",
        "centralDirectoryOffset",
        "byteLength",
        "fileSize"
      ]
    }
  ],
