dialect grammar
grammar stdio.zip.mutations
start op

# P2-P2: real one-line OpText grammar matching `ZipMutation`'s GENERIC `dsl::DslOps`-derived
# `print_op`/`parse_op` (../🦀️component.rs's `OpCodecs` region: `dsl::DslVariants::
# to_named_record` + `dsl::print(..., dsl::JoinMode::Inline)` — no per-artifact custom printer,
# unlike json/csv's own hand-rolled `print_json_mutation`/`print_csv_mutation`). Keyword = the
# kebab-case of the Rust variant name (`to_kebab`, `🗣️dsl/✨️derive/🦀️component.rs`'s own
# documented convention: `SetCamera` -> `set-camera`) — `SetEntryData` -> `set-entry-data`. Field
# keys are likewise kebab-case of the Rust field ident (`new_name` -> `new-name`), printed as
# `key=value` atoms in `keyed_field_rank` order (`🗣️dsl/🧬️schema/🦀️component.rs`): every field on
# every `ZipMutation` variant is a scalar (rank 0, since none use `Table`/`Statements`/`Embed`), so
# print order is exactly Rust declaration order — a stable sort over an already-ordered slice.
#
# `AddEntry`/`SetSnapshot`/`SetEntryExtra` embed a nested `#[dsl(block)]` record (a whole
# `ZipEntry`/`ZipSnapshot`, itself containing further nested records/lists — `ZipSnapshot.entries`
# is a `Vec<ZipEntry>`, each `ZipEntry` its own multi-field block) or a bare `Vec<ZipExtraField>`
# list — genuinely recursive composite shapes the generic printer renders as `key={ ... }`/
# `key=[ ... ]` with no closing delimiter reachable by a fixed, finite production (nesting depth
# is only bounded by the DATA, not the grammar). Modeled honestly as `REST` (P2-M1's raw-span
# terminal, `Symbol::Terminal("REST")` — reads the ORIGINAL source text to EOF, past whatever the
# shared lexer already fragmented, so it correctly swallows arbitrarily-nested `{`/`[`/`=` content
# verbatim) for exactly these three variants — the same honest-boundary treatment this program
# gives a compressed payload or a self-recursive protocol value. Every OTHER variant (10 of 13,
# every field a plain scalar) is modeled precisely, field-for-field, token-for-token below.

op = no-mutation | set-snapshot | set-archive-comment | add-entry | remove-entry | rename-entry | set-entry-data | set-entry-method | set-entry-timestamps | set-entry-flags | set-entry-versions | set-entry-attributes | set-entry-extra | set-entry-comment

# `scalar_to_text` (🗣️dsl/🧬️schema/🦀️component.rs) prints a `String`/`Bytes64` field bare (IDENT)
# when it lexes back as exactly one identifier (`is_bare_ident`), quoted+escaped (TEXT) otherwise —
# covers `name`/`new_name`/`comment` (plain `String`) AND `data` (`#[dsl(base64)]` `Vec<u8>`,
# always printed as a quoted base64 string, still just a `TEXT` token).
text-value = IDENT | TEXT

# `ZipCompressionMethod` (`#[derive(dsl::DslScalar)]`, ../../📸️snapshot/🦀️component.rs) prints its
# bare kebab-case variant tag — `Stored` -> `stored`, `Deflate` -> `deflate`.
method-value = "stored" | "deflate"

no-mutation = "no-mutation"

# Genuinely recursive nested-block payload (`snapshot={ ... }`) — see module doc comment.
set-snapshot = "set-snapshot" REST

set-archive-comment = "set-archive-comment" "comment" "=" text-value

# Genuinely recursive nested-block payload (`index=<N> entry={ ... }`) — see module doc comment.
add-entry = "add-entry" REST

remove-entry = "remove-entry" "name" "=" text-value

rename-entry = "rename-entry" "name" "=" text-value "new-name" "=" text-value

set-entry-data = "set-entry-data" "name" "=" text-value "data" "=" text-value

set-entry-method = "set-entry-method" "name" "=" text-value "method" "=" method-value

set-entry-timestamps = "set-entry-timestamps" "name" "=" text-value "dos-date" "=" INT "dos-time" "=" INT {"unix-mtime" "=" INT}?

set-entry-flags = "set-entry-flags" "name" "=" text-value "flags" "=" INT

set-entry-versions = "set-entry-versions" "name" "=" text-value "version-made-by" "=" INT "version-needed" "=" INT

set-entry-attributes = "set-entry-attributes" "name" "=" text-value "internal-attrs" "=" INT "external-attrs" "=" INT

# Genuinely recursive list-of-records payload (`local-extra=[ ... ] central-extra=[ ... ]`) — see
# module doc comment.
set-entry-extra = "set-entry-extra" REST

set-entry-comment = "set-entry-comment" "name" "=" text-value "comment" "=" text-value
