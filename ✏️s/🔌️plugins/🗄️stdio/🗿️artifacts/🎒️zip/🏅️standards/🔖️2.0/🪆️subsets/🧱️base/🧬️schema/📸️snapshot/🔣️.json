{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/zip/2.0/base/snapshot.json",
  "title": "ZipSnapshot",
  "$defs": {
    "ZipExtraField": {
      "type": "object",
      "required": ["id", "data"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "data": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "description": "Exact unknown payload. Derived ids 0x0001, 0x7075 and 0x6375 must use an empty marker payload and are regenerated coherently."
        }
      }
    },
    "ZipLocalHeaderMetadata": {
      "type": "object",
      "required": ["versionNeeded", "flags", "modifiedTime", "modifiedDate", "extraFields"],
      "properties": {
        "versionNeeded": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "flags": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "modifiedTime": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "modifiedDate": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "extraFields": { "type": "array", "items": { "$ref": "#/$defs/ZipExtraField" } },
        "unicodePathLegacyName": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    },
    "ZipCentralHeaderMetadata": {
      "type": "object",
      "required": ["versionMadeBy", "versionNeeded", "flags", "modifiedTime", "modifiedDate", "extraFields", "comment", "internalAttributes", "externalAttributes"],
      "properties": {
        "versionMadeBy": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "versionNeeded": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "flags": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "modifiedTime": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "modifiedDate": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "extraFields": { "type": "array", "items": { "$ref": "#/$defs/ZipExtraField" } },
        "unicodePathLegacyName": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "comment": { "type": "string" },
        "unicodeCommentLegacy": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "internalAttributes": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "externalAttributes": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "ZipEntryMetadata": {
      "type": "object",
      "required": ["compressionMethod", "local", "central", "dataDescriptorSignature"],
      "properties": {
        "compressionMethod": { "type": "integer", "enum": [0, 8] },
        "local": { "$ref": "#/$defs/ZipLocalHeaderMetadata" },
        "central": { "$ref": "#/$defs/ZipCentralHeaderMetadata" },
        "dataDescriptorSignature": { "type": "boolean" }
      }
    },
    "ZipEntry": {
      "type": "object",
      "required": [
        "name",
        "data",
        "metadata"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "metadata": { "$ref": "#/$defs/ZipEntryMetadata" }
      }
    }
  },
  "type": "object",
  "required": [
    "schema",
    "entries",
    "comment",
    "commentUtf8"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ZipEntry"
      },
      "x-semio-state": "artifact"
    },
    "comment": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "commentUtf8": {
      "type": "boolean",
      "description": "True for UTF-8 EOCD comment bytes; false for the unambiguous CP437 fallback.",
      "x-semio-state": "artifact"
    }
  }
}
