dialect grammar
grammar stdio.zip.mutations
start op

# 🧬 Generic DslVariants syntax for logical archive comment and name-keyed decompressed members.
op = set-snapshot | patch-snapshot | set-archive-comment | add-entry | remove-entry | rename-entry | set-entry-data
text-value = IDENT | TEXT
bool-value = "true" | "false"

patch-snapshot = "patch-snapshot" "patch" "{" "{" patch-fields "}" "}"
patch-fields = patch-set | patch-insert | patch-remove | patch-move | patch-rename | patch-splice
patch-set = "operation" "=" "set" "path" "=" TEXT "value" "=" patch-value
patch-insert = {"index" "=" U64}? "operation" "=" "insert" "path" "=" TEXT "value" "=" patch-value
patch-remove = "operation" "=" "remove" "path" "=" TEXT
patch-move = "from" "=" TEXT {"index" "=" U64}? "operation" "=" "move" "path" "=" TEXT
patch-rename = "key" "=" TEXT "operation" "=" "rename" "path" "=" TEXT
patch-splice = {"continued" "=" BOOL}? "offset" "=" U64 "operation" "=" "splice" "path" "=" TEXT "remove" "=" U64 "value" "=" patch-value
patch-value = TEXT | BOOL | "null" | patch-number | patch-bytes | patch-array | patch-object
patch-number = INT | FLOAT | IDENT | "-" IDENT
patch-bytes = "bytes64" "(" TEXT ")"
patch-array = "[" {patch-value}* "]"
patch-object = "{" {patch-member}* "}"
patch-member = text-value "=" patch-value
set-snapshot = "set-snapshot" REST
set-archive-comment = "set-archive-comment" "comment" "=" text-value "comment-utf8" "=" bool-value
add-entry = "add-entry" REST
remove-entry = "remove-entry" "name" "=" text-value
rename-entry = "rename-entry" "name" "=" text-value "new-name" "=" text-value
set-entry-data = "set-entry-data" "name" "=" text-value "data" "=" text-value
