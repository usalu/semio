{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/zip/2.0/base/mutation/add-entry.json",
  "title": "AddEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry"
  ],
  "properties": {
    "entry": {
      "$ref": "#/$defs/ZipEntry"
    },
    "mutation": {
      "const": "addEntry",
      "description": "Aggregate discriminator spliced in by ZipMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "ZipEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
