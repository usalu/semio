dialect protocol
protocol stdio.zip.snapshot
version 1
schema stdio.zip
start entries
framing chunked

# 🎒️ P2-P2: THE main deliverable — real ZIP 2.0 byte layout, field-for-field against the REAL
# codec (../../../⚙️engine/🦀️component.rs's `decode_zip`/`encode_zip`), using M2's `repeat`/
# `backward`/`jump` constructs exactly as the P2-W0 recon's dedicated ZIP paragraph and the
# P2-M2 report's own worked ZIP example describe. Models the bytes as if the walk already starts
# AT the payload (past the SEMIO envelope — see `🧬️semio/📡️protocol/📡️component.protocol.semio`,
# described once, framework-level; per M3's own guidance, this file does NOT re-describe it).
#
# Three real structures, in this exact block order (each `arm 0x504B....` tag literal is the
# BIG-ENDIAN byte representation of the real on-disk 4-byte magic, e.g. `0x504B0304` decodes to
# bytes `50 4B 03 04` = literal `PK\x03\x04` — `parse_tag_value`'s own documented convention):
#
# 1. `entries` (repeat, forward from byte 0): local file headers + per-entry payload
#    (`PK\x03\x04`), until the first central-directory signature (`PK\x01\x02`) is seen — an
#    empty arm for that tag lets the repeat terminate cleanly on it (matching `walk_repeat`'s own
#    "sentinel must also match an arm" rule) without re-reading it; the next real block below
#    (`jump`) starts fresh from `cd_offset` regardless of where this leaves `pos`.
# 2. `eocd` (backward-scan): ZIP's End Of Central Directory record is genuinely NOT locatable by
#    a forward walk — its own comment field is 0-65535 bytes, so nothing before it announces
#    where it starts (`find_eocd`'s own doc comment, W0's "load-bearing decision": "a forward-walk
#    reformulation still cannot avoid this... nothing about the central directory's span is
#    knowable until the backward scan happens first"). Scans backward from EOF for `PK\x05\x06`.
# 3. `central_dir_start` (jump) + `central_directory` (repeat): `cd_offset`, decoded by the
#    backward-scan block above, is the ABSOLUTE offset of the first central-directory record —
#    `jump` repositions `pos` there (M2's cross-block field-env threading, item 3, is what makes
#    this legal: `cd_offset` was decoded by an EARLIER block, resolved against the walk-wide env),
#    then `central_directory` reads the real, repeated per-entry metadata (`PK\x01\x02`) until the
#    EOCD signature (already fully captured by block 2) is seen again, terminating the same way
#    block 1 does.
#
# Per M2's own report (`p2-m2-report.md`, deviation #1) and the plan's own explicit latitude ("the
# central-directory entries alone already carry the real per-entry metadata"): the OPTIONAL
# per-entry `local_off` backward-jump-to-local-header cross-validation `decode_zip` also performs
# is NOT modeled here — `repeat`'s arm bodies cannot yet embed a `jump` sub-directive per iteration
# (M2's own documented boundary), so this genuinely can't be expressed without a further M-fix; the
# central directory's own real per-entry fields (incl. `local_off` itself, decoded but not
# dereferenced) are the honest, complete model this wave ships. Filed as `mechanism_gaps`.
#
# Also NOT modeled: the optional trailing streaming data-descriptor (general-purpose bit 3) after
# an entry's payload — `encode_zip` NEVER emits one (always clears bit 3, sizes always written up
# front, see its own doc comment); a real third-party archive that DOES use one is still decodable
# by the real Rust `decode_zip` (which handles it), just outside this declarative walker's honest
# reach for a construct our OWN writer never produces. Documented, not silently dropped.
#
# Because this file declares `backward`/`jump` blocks, the walk is (correctly, per M2's own
# documented exception) no longer required to land on exactly `bytes.len()` — `walk_protocol`
# skips the final EOF check for any protocol that jumps at least once.

# ── 1. Local file headers + payload, forward from byte 0 ──────────────────────────────────────
repeat entries {
  tag fixed 4
  until 0x504B0102
  arm 0x504B0304 {
    version_needed u16
    flags u16
    method u16
    dos_time u16
    dos_date u16
    crc32 u32
    comp_size u32
    uncomp_size u32
    name_len u16
    extra_len u16
    name Array(u8, Field(name_len))
    extra Array(u8, Field(extra_len))
    payload Array(u8, Field(comp_size))
  }
  arm 0x504B0102 { }
}

# ── 2. EOCD, located by scanning backward from EOF for its own magic ──────────────────────────
backward eocd magic 0x504B0506 {
  disk_number u16
  disk_cd u16
  count u16
  total_count u16
  cd_size u32
  cd_offset u32
  comment_len u16
  comment Array(u8, Field(comment_len))
}

# ── 3. Jump to the central directory's first record, then walk it forward, repeated ───────────
jump central_dir_start from cd_offset { }

repeat central_directory {
  tag fixed 4
  until 0x504B0506
  arm 0x504B0102 {
    version_made_by u16
    version_needed u16
    flags u16
    method u16
    dos_time u16
    dos_date u16
    crc32 u32
    comp_size u32
    uncomp_size u32
    name_len u16
    extra_len u16
    comment_len u16
    disk_start u16
    internal_attrs u16
    external_attrs u32
    local_off u32
    name Array(u8, Field(name_len))
    extra Array(u8, Field(extra_len))
    comment Array(u8, Field(comment_len))
  }
  arm 0x504B0506 { }
}
