{
  "$id": "https://semio.tech/schema/s.stdio.zip/snapshot.json",
  "title": "ZipSnapshot",
  "$defs": {
    "ZipEntry": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "data": { "type": "array", "items": { "type": "integer" } }
      }
    }
  },
  "type": "object",
  "required": ["schema"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/ZipEntry" }, "x-semio-state": "artifact" },
    "comment": { "type": "string", "x-semio-state": "artifact" }
  }
}
