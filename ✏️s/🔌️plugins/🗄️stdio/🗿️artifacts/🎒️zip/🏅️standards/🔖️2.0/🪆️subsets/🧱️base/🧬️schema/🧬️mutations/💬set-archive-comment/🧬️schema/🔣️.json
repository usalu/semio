{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/zip/2.0/base/mutation/set-archive-comment/schema.json",
  "title": "SetArchiveComment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comment",
    "commentUtf8"
  ],
  "properties": {
    "comment": {
      "type": "string"
    },
    "commentUtf8": {
      "type": "boolean",
      "description": "True for UTF-8 EOCD bytes; false for an unambiguous CP437 representation."
    },
    "mutation": {
      "const": "setArchiveComment",
      "description": "Aggregate discriminator spliced in by ZipMutation; absent when the payload stands alone."
    }
  }
}
