{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/base/snapshot.json",
  "title": "JsonSnapshot",
  "type": "object",
  "required": [
    "schema",
    "value"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "value": {
      "$ref": "#/$defs/JsonValue",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "JsonMember": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      }
    },
    "JsonValue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "lexeme": {
              "type": "string",
              "description": "original RFC8259 number lexeme, verbatim",
              "x-semio-ui": {
                "label": {
                  "en": "Number lexeme",
                  "de": "Zahlenlexem"
                },
                "description": {
                  "en": "The RFC 8259 number exactly as written, never rounded.",
                  "de": "Die RFC-8259-Zahl genau wie geschrieben, nie gerundet."
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "x-semio-ui": {
                "label": {
                  "en": "Items",
                  "de": "Elemente"
                },
                "description": {
                  "en": "The array elements, in order.",
                  "de": "Die Array-Elemente in ihrer Reihenfolge."
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/JsonMember"
              },
              "description": "insertion order preserved",
              "x-semio-ui": {
                "label": {
                  "en": "Members",
                  "de": "Eigenschaften"
                },
                "description": {
                  "en": "The object members, in insertion order.",
                  "de": "Die Objekteigenschaften in Einfügereihenfolge."
                }
              }
            }
          }
        }
      ]
    }
  }
}
