{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/i-json/mutation/rename-member/schema.json",
  "title": "RenameMember",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "from",
    "to"
  ],
  "properties": {
    "mutation": {
      "const": "renameMember",
      "description": "Aggregate discriminator spliced in by JsonIJsonMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/JsonPathSegment"
      },
      "x-semio-ui": {
        "label": {
          "en": "Path",
          "de": "Pfad"
        },
        "description": {
          "en": "Member names and array indices leading from the root to the object or array that changes; empty for the root.",
          "de": "Eigenschaftsnamen und Array-Indizes von der Wurzel bis zum Objekt oder Array, das sich ändert; leer für die Wurzel."
        },
        "group": "target",
        "order": 10
      }
    },
    "from": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Member name",
          "de": "Name der Eigenschaft"
        },
        "description": {
          "en": "Current name of the object member.",
          "de": "Aktueller Name der Objekteigenschaft."
        },
        "group": "target",
        "order": 20
      }
    },
    "to": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "New name",
          "de": "Neuer Name"
        },
        "description": {
          "en": "Name the member carries afterwards.",
          "de": "Name, den die Eigenschaft danach trägt."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "JsonPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
