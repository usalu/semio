{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/geojson/artifact.json",
  "title": "GeoJson",
  "description": "RFC 7946 GeoJSON as the rfc8259/geojson subset reads and writes it: the base subset's JSON document constrained to a GeoJSON object whose positions are WGS 84 longitude/latitude (optionally an ellipsoidal height). The writer always emits a FeatureCollection without `crs`; the reader also accepts a bare Feature or geometry and a GJ2008 named `crs` of CRS84/EPSG:4326 (lon/lat) or spherical Web Mercator (inverse projected), and refuses every other CRS.",
  "allOf": [{ "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/base/artifact.json" }],
  "oneOf": [{ "$ref": "#/definitions/FeatureCollection" }, { "$ref": "#/definitions/Feature" }, { "$ref": "#/definitions/Geometry" }],
  "definitions": {
    "Position": { "type": "array", "minItems": 2, "items": { "type": "number" }, "description": "[longitude, latitude, height?] — longitude ∈ [−180, 180], latitude ∈ [−90, 90] after the CRS policy." },
    "LinearRing": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/Position" }, "description": "Closed: first and last positions identical. Written right-handed (exterior counter-clockwise, holes clockwise)." },
    "Point": { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "Point" }, "coordinates": { "$ref": "#/definitions/Position" } } },
    "MultiPoint": { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "MultiPoint" }, "coordinates": { "type": "array", "items": { "$ref": "#/definitions/Position" } } } },
    "LineString": { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "LineString" }, "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/Position" } } } },
    "MultiLineString": { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "MultiLineString" }, "coordinates": { "type": "array", "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/Position" } } } } },
    "Polygon": { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "Polygon" }, "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/LinearRing" } } } },
    "MultiPolygon": { "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "MultiPolygon" }, "coordinates": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/LinearRing" } } } } },
    "GeometryCollection": { "type": "object", "required": ["type", "geometries"], "properties": { "type": { "const": "GeometryCollection" }, "geometries": { "type": "array", "items": { "$ref": "#/definitions/Geometry" } } } },
    "Geometry": { "oneOf": [{ "$ref": "#/definitions/Point" }, { "$ref": "#/definitions/MultiPoint" }, { "$ref": "#/definitions/LineString" }, { "$ref": "#/definitions/MultiLineString" }, { "$ref": "#/definitions/Polygon" }, { "$ref": "#/definitions/MultiPolygon" }, { "$ref": "#/definitions/GeometryCollection" }] },
    "Feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": ["string", "number"] },
        "geometry": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/Geometry" }] },
        "properties": { "type": ["object", "null"] }
      }
    },
    "FeatureCollection": { "type": "object", "required": ["type", "features"], "properties": { "type": { "const": "FeatureCollection" }, "features": { "type": "array", "items": { "$ref": "#/definitions/Feature" } } } },
    "NamedCrs": {
      "description": "GJ2008 only (removed by RFC 7946 §4): the reader honours these names and refuses all others.",
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "type": { "const": "name" },
        "properties": { "type": "object", "required": ["name"], "properties": { "name": { "enum": ["urn:ogc:def:crs:OGC:1.3:CRS84", "urn:ogc:def:crs:OGC::CRS84", "OGC:CRS84", "EPSG:4326", "urn:ogc:def:crs:EPSG::4326", "EPSG:3857", "urn:ogc:def:crs:EPSG::3857", "EPSG:900913", "EPSG:102100", "EPSG:102113"] } } }
      }
    }
  },
  "x-semio-formats": ["🔣️jsonschema"]
}
