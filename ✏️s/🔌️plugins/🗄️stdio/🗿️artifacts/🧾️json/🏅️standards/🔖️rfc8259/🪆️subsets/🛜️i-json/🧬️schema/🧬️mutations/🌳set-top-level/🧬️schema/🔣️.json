{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/i-json/mutation/set-top-level/schema.json",
  "title": "SetTopLevel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "root"
  ],
  "properties": {
    "mutation": {
      "const": "setTopLevel",
      "description": "Aggregate discriminator spliced in by JsonIJsonMutation; absent when the payload stands alone."
    },
    "root": {
      "$ref": "#/$defs/JsonIJsonRoot",
      "x-semio-ui": {
        "label": {
          "en": "Top-level value",
          "de": "Wert der obersten Ebene"
        },
        "description": {
          "en": "The object or array that forms the I-JSON text.",
          "de": "Das Objekt oder Array, das den I-JSON-Text bildet."
        }
      }
    }
  },
  "$defs": {
    "JsonIJsonRoot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/JsonMember"
              },
              "x-semio-ui": {
                "label": {
                  "en": "Members",
                  "de": "Eigenschaften"
                },
                "description": {
                  "en": "The object members, in insertion order.",
                  "de": "Die Objekteigenschaften in Einfügereihenfolge."
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/base/snapshot.json#/$defs/JsonValue"
              },
              "x-semio-ui": {
                "label": {
                  "en": "Items",
                  "de": "Elemente"
                },
                "description": {
                  "en": "The array elements, in order.",
                  "de": "Die Array-Elemente in ihrer Reihenfolge."
                }
              }
            }
          }
        }
      ]
    },
    "JsonMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/base/snapshot.json#/$defs/JsonValue",
          "x-semio-ui": {
            "description": {
              "en": "A JSON value: null, boolean, number, string, array or object.",
              "de": "Ein JSON-Wert: null, Wahrheitswert, Zahl, Zeichenkette, Array oder Objekt."
            }
          }
        }
      }
    }
  }
}
