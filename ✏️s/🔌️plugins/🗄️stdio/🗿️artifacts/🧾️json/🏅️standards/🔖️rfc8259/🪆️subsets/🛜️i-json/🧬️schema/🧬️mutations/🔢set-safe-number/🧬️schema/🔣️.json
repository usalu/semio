{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/i-json/mutation/set-safe-number/schema.json",
  "title": "SetSafeNumber",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "lexeme"
  ],
  "properties": {
    "mutation": {
      "const": "setSafeNumber",
      "description": "Aggregate discriminator spliced in by JsonIJsonMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/JsonPathSegment"
      }
    },
    "lexeme": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Number lexeme",
          "de": "Zahlenlexem"
        },
        "description": {
          "en": "Exact number spelling within the I-JSON safe range.",
          "de": "Genaue Schreibweise der Zahl im sicheren I-JSON-Bereich."
        }
      }
    }
  },
  "$defs": {
    "JsonPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
