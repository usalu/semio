{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/json/rfc8259/base/inference.json",
  "title": "JsonInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outline"
  ],
  "properties": {
    "outline": {
      "$ref": "#/$defs/JsonOutline",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "JsonOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeCount",
        "maxDepth",
        "rootKind"
      ],
      "properties": {
        "nodeCount": {
          "type": "integer"
        },
        "maxDepth": {
          "type": "integer"
        },
        "rootKind": {
          "type": "string"
        }
      }
    }
  }
}
