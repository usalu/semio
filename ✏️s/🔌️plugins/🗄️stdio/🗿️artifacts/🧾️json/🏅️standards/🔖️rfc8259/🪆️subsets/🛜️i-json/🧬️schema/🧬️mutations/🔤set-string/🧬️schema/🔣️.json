{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/i-json/mutation/set-string/schema.json",
  "title": "SetString",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setString",
      "description": "Aggregate discriminator spliced in by JsonIJsonMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/JsonPathSegment"
      },
      "x-semio-ui": {
        "label": {
          "en": "Path",
          "de": "Pfad"
        },
        "description": {
          "en": "Member names and array indices leading from the root to the value that is set; empty for the root.",
          "de": "Eigenschaftsnamen und Array-Indizes von der Wurzel bis zum Wert, der gesetzt wird; leer für die Wurzel."
        },
        "group": "target",
        "order": 10
      }
    },
    "value": {
      "type": "string",
      "x-semio-ui": {
        "widget": "multiline",
        "role": "value",
        "label": {
          "en": "Text",
          "de": "Text"
        },
        "description": {
          "en": "The string the value holds afterwards.",
          "de": "Die Zeichenkette, die der Wert danach enthält."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "JsonPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
