{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/base/mutation/insert-array-element/schema.json",
  "title": "InsertArrayElementPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "index",
    "value"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/JsonPathSegment"
      },
      "x-semio-ui": {
        "label": {
          "en": "Path",
          "de": "Pfad"
        },
        "description": {
          "en": "Member names and array indices leading from the root to the object or array that changes; empty for the root.",
          "de": "Eigenschaftsnamen und Array-Indizes von der Wurzel bis zum Objekt oder Array, das sich ändert; leer für die Wurzel."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the elements of the array at which it is inserted, counted from 0.",
          "de": "Position unter den Elementen des Arrays, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "value": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/base/snapshot.json#/$defs/JsonValue",
      "x-semio-ui": {
        "description": {
          "en": "A JSON value: null, boolean, number, string, array or object.",
          "de": "Ein JSON-Wert: null, Wahrheitswert, Zahl, Zeichenkette, Array oder Objekt."
        }
      }
    }
  },
  "$defs": {
    "JsonPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "key"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "index"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "InsertArrayElementMutation": {
      "description": "The whole wire of InsertArrayElementMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/json/rfc8259/base/diff.json"
            }
          }
        }
      ]
    }
  }
}
