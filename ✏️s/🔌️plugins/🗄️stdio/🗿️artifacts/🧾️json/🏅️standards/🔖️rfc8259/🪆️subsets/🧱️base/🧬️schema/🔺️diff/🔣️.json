{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/json/rfc8259/base/diff.json",
  "title": "JsonDiff",
  "type": "object",
  "properties": {
    "value": {
      "$ref": "#/$defs/JsonValueDiff",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "JsonValueDiff": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "replace"
            },
            "value": {
              "$ref": "https://semio.tech/schema/s/stdio/json/rfc8259/base/snapshot.json#/$defs/JsonValue"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "lexeme"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "lexeme": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "diff"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "diff": {
              "$ref": "#/$defs/JsonArrayDiff"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "diff"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "diff": {
              "$ref": "#/$defs/JsonObjectDiff"
            }
          }
        }
      ]
    },
    "JsonArrayDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "base-state indices"
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "diff"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "diff": {
                "$ref": "#/$defs/JsonValueDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "item"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "item": {
                "$ref": "https://semio.tech/schema/s/stdio/json/rfc8259/base/snapshot.json#/$defs/JsonValue"
              }
            }
          },
          "description": "final-state indices, ascending insert"
        }
      }
    },
    "JsonObjectDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "diff"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "$ref": "#/$defs/JsonValueDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "key",
              "item"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "key": {
                "type": "string"
              },
              "item": {
                "$ref": "https://semio.tech/schema/s/stdio/json/rfc8259/base/snapshot.json#/$defs/JsonValue"
              }
            }
          }
        }
      }
    }
  }
}
