dialect grammar stdio.stl.mutation
; A `StlMutation` op-text line is `serde_json::to_string` of the `#[serde(tag = "mutation")]`
; enum — a single-line JSON object whose `"mutation"` member is the camelCase variant name and
; whose remaining members are that variant's own fields (untagged serde adjacency: no nested
; payload wrapper).
root = mutation-line
mutation-line = mutation-object NL?
mutation-object = '{' '"mutation"' ':' mutation-kind [ ',' variant-fields ] '}'
mutation-kind = '"noMutation"' / '"setSnapshot"' / '"setSolidName"' / '"insertTriangle"'
              / '"removeTriangle"' / '"setTriangleNormal"' / '"setTriangleVertices"'
; The concrete member set is exactly one of the following, selected by `mutation-kind` above —
; `noMutation` has none.
variant-fields = set-snapshot-fields / set-solid-name-fields / insert-triangle-fields
               / remove-triangle-fields / set-triangle-normal-fields / set-triangle-vertices-fields
set-snapshot-fields = '"snapshot"' ':' stl-snapshot-object
set-solid-name-fields = '"name"' ':' json-string
insert-triangle-fields = '"index"' ':' json-number ',' '"triangle"' ':' triangle-object
remove-triangle-fields = '"index"' ':' json-number
set-triangle-normal-fields = '"index"' ':' json-number ',' '"normal"' ':' vector3-array
set-triangle-vertices-fields = '"index"' ':' json-number ',' '"vertices"' ':' vertices-array
; Full snapshot/triangle shapes — see `📸️snapshot/📝️text/📖️component.grammar.semio` for the
; complete `StlTriangle` field set this artifact models (`triangle-object` reuses it verbatim).
stl-snapshot-object = '{' '"schema"' ':' json-string ',' '"solidName"' ':' json-string ','
                       '"triangles"' ':' '[' *( triangle-object ',' ) ']' '}'
triangle-object = '{' '"normal"' ':' vector3-array ',' '"vertices"' ':' vertices-array '}'
vertices-array = '[' vector3-array ',' vector3-array ',' vector3-array ']'
vector3-array = '[' json-number ',' json-number ',' json-number ']'
json-string = DQUOTE *CHAR DQUOTE
json-number = ["-"] 1*DIGIT ["." 1*DIGIT]
