dialect grammar stdio.stl.snapshot
; ASCII STL (https://en.wikipedia.org/wiki/STL_(file_format)). Envelope preamble line + its
; trailing newline are stripped before this grammar runs (store::semio_format::split_text_preamble).
root = solid
solid = "solid" [SP name] NL facet* "endsolid" [SP name] NL?
name = 1*(ALPHA / DIGIT / "_" / "-" / ".")
facet = "facet" SP "normal" SP vector3 NL
        "outer" SP "loop" NL
        vertex vertex vertex
        "endloop" NL
        "endfacet" NL
vertex = "vertex" SP vector3 NL
vector3 = real SP real SP real
real = ["-"] 1*DIGIT ["." 1*DIGIT] [("e" / "E") ["-" / "+"] 1*DIGIT]
