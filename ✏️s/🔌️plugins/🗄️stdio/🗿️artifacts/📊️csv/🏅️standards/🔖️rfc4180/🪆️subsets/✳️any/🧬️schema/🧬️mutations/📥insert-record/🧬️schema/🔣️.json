{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/csv/rfc4180/any/mutation/insert-record/schema.json",
  "title": "InsertRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "record"
  ],
  "properties": {
    "mutation": {
      "const": "insertRecord"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "record": {
      "$ref": "#/$defs/CsvRecord",
      "x-semio-ui": {
        "label": {
          "en": "Record",
          "de": "Datensatz"
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "CsvRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CsvField"
          },
          "x-semio-ui": {
            "label": {
              "en": "Fields",
              "de": "Felder"
            }
          }
        }
      }
    },
    "CsvField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Field value",
              "de": "Feldwert"
            }
          }
        },
        "quoted": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Quoted",
              "de": "In Anführungszeichen"
            }
          }
        }
      }
    }
  }
}
