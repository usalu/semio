{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "encodings",
    "snapshots",
    "policy",
    "edit"
  ],
  "properties": {
    "contract": {
      "const": "completeCsvLogicalOwner"
    },
    "encodings": {
      "const": [
        "binary",
        "text"
      ]
    },
    "snapshots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "hasHeader",
          "records"
        ],
        "properties": {
          "schema": {
            "type": "string"
          },
          "hasHeader": {
            "type": "boolean"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fields"
              ],
              "properties": {
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "quoted"
                    ],
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "quoted": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "policy": {
      "const": {
        "preserveSchema": true,
        "preserveHasHeader": true,
        "preserveQuoted": true,
        "preserveEmptyRecord": true,
        "nativeOwner": "declaredLogicalRecord",
        "naturalFile": "rfc4180"
      }
    },
    "edit": {
      "const": {
        "query": "UPDATE csv_document SET has_header=1",
        "snapshotIndex": 0
      }
    }
  }
}
