dialect grammar
grammar stdio.csv.diff
start diff

# Real one-line `print_diff`/`parse_diff` form this artifact's hand-rolled `DiffCodec` emits
# (🔺️diff/🦀️component.rs `print_csv_diff`/`parse_csv_diff`) — a space-separated
# `name=value` token per changed top-level field, `records` printed as the real
# removed/modified/added COLLECTION-TRIPLE (`records{[removed];[modified];[added]}`) —
# this artifact's own `CsvSnapshot.records` is a collection, so `CsvDiff.records` is the FIRST
# real collection-triple grammar production in this program; later waves for other
# collection-shaped standards copy this exact shape (see this artifact's report).
comment none

diff = has-header-clause? records-clause?
has-header-clause = "has-header" "=" bit
records-clause = "records" "{" "[" removed-list? "]" ";" "[" modified-list? "]" ";" "[" added-list? "]" "}"

# `removed`: bare BASE indices, comma-joined (`enc_records_diff`, 🔺️diff/🦀️component.rs).
removed-list = INT {"," INT}*

# `modified`: BASE-index-keyed `index:record-diff` pairs — `record-diff` is itself a sparse,
# POSITIONAL per-field patch list (`CsvRecordDiff.fields: Option<Vec<Option<CsvFieldDiff>>>`),
# printed via the uniform `encode_option` tri-state convention (`[0]`=None / `[1,<T>]`=Some(T))
# this artifact's F6-era `enc_record_diff`/`dec_record_diff` already use.
modified-list = record-modified {"," record-modified}*
record-modified = INT ":" record-diff
record-diff = "[" "0" "]" | "[" "1" "," "[" field-patch-list? "]" "]"
field-patch-list = field-patch {"," field-patch}*
field-patch = "[" "0" "]" | "[" "1" "," field-diff "]"
field-diff = "[" field-diff-entry-list? "]"
field-diff-entry-list = field-diff-entry {"," field-diff-entry}*
field-diff-entry = "V" ":" hex | "Q" ":" bit

# `added`: FINAL-index-keyed `index:record` pairs — `record` is the full whole-value payload
# (same positional-tuple shape the mutations/snapshot-transfer grammar already documents).
added-list = record-added {"," record-added}*
record-added = INT ":" record-value
record-value = "[" field-list? "]"
field-list = field-value {"," field-value}*
field-value = "[" hex "," bit "]"
bit = "0" | "1"

# `hex` (bare `hex`, deliberately NOT defined as a production here) is the framework's built-in `hex`
# MACRO (`📖️grammar/🦀️component.rs`'s `default_macros`/`macro_hex_ok`) — see
# ../../🧬️mutations/📝️text/📖️component.grammar.semio's own `hex` doc comment for why a macro, not a
# `{INT|IDENT}*`-shaped production, is required here.
