{
  "$id": "https://semio.tech/schema/s.stdio.csv/artifact.csv",
  "title": "CsvArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hasHeader", "records"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "hasHeader": { "type": "boolean", "x-semio-state": "artifact" },
    "records": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fields"],
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "quoted"],
              "properties": {
                "value": { "type": "string" },
                "quoted": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
