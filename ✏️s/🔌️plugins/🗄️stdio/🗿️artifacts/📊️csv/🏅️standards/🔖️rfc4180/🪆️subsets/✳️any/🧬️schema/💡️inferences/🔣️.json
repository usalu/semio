{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/csv/rfc4180/any/inference.json",
  "title": "CsvInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outline"
  ],
  "properties": {
    "outline": {
      "$ref": "#/$defs/CsvOutline",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "CsvOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordCount",
        "columnCount",
        "hasHeader"
      ],
      "properties": {
        "recordCount": {
          "type": "integer"
        },
        "columnCount": {
          "type": "integer"
        },
        "hasHeader": {
          "type": "boolean"
        }
      }
    }
  }
}
