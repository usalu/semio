dialect protocol
protocol stdio.csv.mutations
version 1
schema stdio.csv.op
start op
framing record

# Real `CsvMutation` op frame: `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 1
field tag u8
record set-snapshot tag=1
field snapshot bytes
record set-has-header tag=2
field has_header u8
record insert-record tag=3
field index varint
field record bytes
record remove-record tag=4
field index varint
record set-field tag=5
field record_index varint
field field_index varint
field quoted u8
field value bytes
