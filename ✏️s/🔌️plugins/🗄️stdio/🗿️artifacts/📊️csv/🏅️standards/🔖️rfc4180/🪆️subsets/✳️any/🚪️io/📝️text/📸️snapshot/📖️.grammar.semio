dialect grammar
grammar stdio.csv.snapshot
extension csv
start snapshot
comment none

snapshot = "schema" "=" text "has-header" "=" boolean "records" "=" "[" record* "]"
record = "{" "fields" "=" "[" field* "]" "}"
field = "{" "value" "=" text "quoted" "=" boolean "}"
text = STRING / IDENT / INT / FLOAT
boolean = "true" / "false"
