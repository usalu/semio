      "license": "MIT OR Unlicense",
      "testOnly": true,
      "homepage": "https://github.com/BurntSushi/rust-csv",
      "rationale": "The reference RFC 4180 CSV reader/writer of the Rust ecosystem, read with `has_headers(false)` and `flexible(true)` so it models the format the same way this subset's own schema does: no structural header/data distinction (only the `has_header` convention, which is metadata, not bytes) and per-record field counts as real information rather than an assumed rectangular grid. Used here to perform every declared `CsvMutation` kind independently of this repository's own codec.",
      "kind": "third-party-library",
      "engine": {
        "family": "csv",
        "implementation": "csv Rust RFC 4180 reader/writer",
        "version": "1"
      },
