dialect protocol
protocol stdio.bcf.snapshot
version 1
schema stdio.bcf
start snapshot
framing record
use semio.pack

# RecordSpec declares optional presence, full IEEE words and ordered occurrences.
record snapshot {
  schema utf8
  version utf8
  topics array Ref(BcfTopic)
  parts array Ref(BcfRawPart)
}
record BcfTopic {
  guid utf8
  title utf8
  description utf8
  status utf8
  priority utf8
  labels array utf8
  creationDate utf8
  creationAuthor utf8
  comments array Ref(BcfComment)
  viewpoints array Ref(BcfViewpoint)
}
record BcfComment {
  guid utf8
  date utf8
  author utf8
  text utf8
  viewpointRef utf8
}
record BcfViewpoint {
  guid utf8
  camera Ref(BcfCamera)
  components Ref(BcfComponents)
  snapshot array u8
}
enum BcfCamera {
  perspective=0
  orthogonal=1
}
record PerspectiveCamera {
  viewPoint Ref(BcfPoint3)
  direction Ref(BcfPoint3)
  upVector Ref(BcfPoint3)
  fieldOfView f64
}
record OrthogonalCamera {
  viewPoint Ref(BcfPoint3)
  direction Ref(BcfPoint3)
  upVector Ref(BcfPoint3)
  viewToWorldScale f64
}
record BcfPoint3 {
  x f64
  y f64
  z f64
}
record BcfComponents {
  selection array utf8
  visibility Ref(BcfVisibility)
  coloring array Ref(BcfColoring)
}
record BcfVisibility {
  defaultVisibility u8
  exceptions array utf8
}
record BcfColoring {
  color utf8
  components array utf8
}
record BcfRawPart {
  name utf8
  data bytes
}
