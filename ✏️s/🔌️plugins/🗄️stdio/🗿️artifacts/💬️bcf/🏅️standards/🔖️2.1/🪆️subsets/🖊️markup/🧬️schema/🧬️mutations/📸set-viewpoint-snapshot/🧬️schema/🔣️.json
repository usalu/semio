{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/bcf/2.1/markup/mutation/set-viewpoint-snapshot/schema.json",
  "title": "SetViewpointSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "topicGuid",
    "guid"
  ],
  "properties": {
    "mutation": {
      "const": "setViewpointSnapshot"
    },
    "topicGuid": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Topic",
          "de": "Thema"
        },
        "description": {
          "en": "GUID of the topic.",
          "de": "GUID des Themas."
        },
        "ref": {
          "kind": "topic",
          "domain": "bcf"
        },
        "group": "target",
        "order": 10
      }
    },
    "guid": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Viewpoint",
          "de": "Ansichtspunkt"
        },
        "description": {
          "en": "GUID of the viewpoint.",
          "de": "GUID des Ansichtspunkts."
        },
        "ref": {
          "kind": "viewpoint",
          "domain": "bcf"
        },
        "group": "target",
        "order": 20
      }
    },
    "snapshot": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Snapshot image",
          "de": "Snapshot-Bild"
        },
        "description": {
          "en": "PNG bytes of the viewpoint snapshot; empty removes it.",
          "de": "PNG-Bytes des Ansichtspunkt-Snapshots; leer entfernt ihn."
        },
        "group": "value",
        "order": 30
      }
    }
  }
}
