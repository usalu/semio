{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/bcf/2.1/markup/mutation/insert-comment.json",
  "title": "InsertComment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic_guid",
    "comment"
  ],
  "properties": {
    "topic_guid": {
      "type": "string"
    },
    "comment": {
      "$ref": "#/$defs/BcfComment"
    }
  },
  "$defs": {
    "BcfComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guid",
        "date",
        "author",
        "text"
      ],
      "properties": {
        "guid": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "viewpointRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
