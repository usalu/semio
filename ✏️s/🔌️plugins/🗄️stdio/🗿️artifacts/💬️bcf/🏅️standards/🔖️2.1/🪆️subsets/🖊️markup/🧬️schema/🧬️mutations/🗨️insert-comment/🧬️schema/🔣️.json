{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/bcf/2.1/markup/mutation/insert-comment/schema.json",
  "title": "InsertComment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "topicGuid",
    "comment"
  ],
  "properties": {
    "mutation": {
      "const": "insertComment"
    },
    "topicGuid": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Topic",
          "de": "Thema"
        },
        "description": {
          "en": "GUID of the topic.",
          "de": "GUID des Themas."
        },
        "ref": {
          "kind": "topic",
          "domain": "bcf"
        },
        "group": "target",
        "order": 10
      }
    },
    "comment": {
      "$ref": "#/$defs/BcfComment",
      "x-semio-ui": {
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "BcfComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guid",
        "date",
        "author",
        "text"
      ],
      "properties": {
        "guid": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Date",
              "de": "Datum"
            },
            "description": {
              "en": "ISO 8601 date and time.",
              "de": "Datum und Uhrzeit nach ISO 8601."
            }
          }
        },
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "viewpointRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Viewpoint",
              "de": "Ansichtspunkt"
            },
            "description": {
              "en": "GUID of the viewpoint the comment refers to.",
              "de": "GUID des Ansichtspunkts, auf den sich der Kommentar bezieht."
            }
          }
        }
      }
    }
  }
}
