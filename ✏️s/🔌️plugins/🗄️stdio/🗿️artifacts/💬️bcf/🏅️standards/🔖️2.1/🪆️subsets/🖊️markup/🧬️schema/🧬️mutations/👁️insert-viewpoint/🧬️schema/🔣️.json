{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/bcf/2.1/markup/mutation/insert-viewpoint/schema.json",
  "title": "InsertViewpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "topicGuid",
    "viewpoint"
  ],
  "properties": {
    "mutation": {
      "const": "insertViewpoint"
    },
    "topicGuid": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Topic",
          "de": "Thema"
        },
        "description": {
          "en": "GUID of the topic.",
          "de": "GUID des Themas."
        },
        "ref": {
          "kind": "topic",
          "domain": "bcf"
        },
        "group": "target",
        "order": 10
      }
    },
    "viewpoint": {
      "$ref": "#/$defs/BcfViewpoint",
      "x-semio-ui": {
        "label": {
          "en": "Viewpoint",
          "de": "Ansichtspunkt"
        },
        "group": "value",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "label": {
          "en": "Index",
          "de": "Position"
        },
        "description": {
          "en": "Position to insert at; absent appends.",
          "de": "Einfügeposition; ohne Angabe wird angehängt."
        },
        "group": "target",
        "order": 20
      }
    }
  },
  "$defs": {
    "BcfViewpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guid"
      ],
      "properties": {
        "guid": {
          "type": "string"
        },
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/BcfCamera"
            },
            {
              "type": "null"
            }
          ]
        },
        "components": {
          "anyOf": [
            {
              "$ref": "#/$defs/BcfComponents"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Components",
              "de": "Bauteile"
            }
          }
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Snapshot image",
              "de": "Snapshot-Bild"
            },
            "description": {
              "en": "PNG bytes of the viewpoint snapshot; empty removes it.",
              "de": "PNG-Bytes des Ansichtspunkt-Snapshots; leer entfernt ihn."
            }
          }
        }
      }
    },
    "BcfCamera": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "viewPoint",
            "direction",
            "upVector",
            "fieldOfView"
          ],
          "properties": {
            "kind": {
              "const": "perspective"
            },
            "viewPoint": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "direction": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "upVector": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "fieldOfView": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "viewPoint",
            "direction",
            "upVector",
            "viewToWorldScale"
          ],
          "properties": {
            "kind": {
              "const": "orthogonal"
            },
            "viewPoint": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "direction": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "upVector": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "viewToWorldScale": {
              "type": "number"
            }
          }
        }
      ]
    },
    "BcfPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "BcfComponents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Selected components",
              "de": "Ausgewählte Bauteile"
            },
            "description": {
              "en": "IFC GUIDs of the selected components.",
              "de": "IFC-GUIDs der ausgewählten Bauteile."
            }
          }
        },
        "visibility": {
          "$ref": "#/$defs/BcfVisibility",
          "x-semio-ui": {
            "label": {
              "en": "Visibility",
              "de": "Sichtbarkeit"
            }
          }
        },
        "coloring": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BcfColoring"
          },
          "x-semio-ui": {
            "label": {
              "en": "Coloring",
              "de": "Einfärbung"
            }
          }
        }
      }
    },
    "BcfVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultVisibility"
      ],
      "properties": {
        "defaultVisibility": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Visible by default",
              "de": "Standardmäßig sichtbar"
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Exceptions",
              "de": "Ausnahmen"
            },
            "description": {
              "en": "IFC GUIDs of components that deviate from the default visibility.",
              "de": "IFC-GUIDs der Bauteile, die von der Standardsichtbarkeit abweichen."
            }
          }
        }
      }
    },
    "BcfColoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color"
      ],
      "properties": {
        "color": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Color",
              "de": "Farbe"
            },
            "description": {
              "en": "ARGB or RGB hex color.",
              "de": "ARGB- oder RGB-Hexfarbe."
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Components",
              "de": "Bauteile"
            },
            "description": {
              "en": "IFC GUIDs of the colored components.",
              "de": "IFC-GUIDs der eingefärbten Bauteile."
            }
          }
        }
      }
    }
  }
}
