          "assertions": {
            "bothImport": true
          }
        },
        {
          "probe": "bcf-compare",
          "description": "Set/map-keyed structural equality — the operative equality.",
          "inputs": [
            "expected-bcf",
            "actual-bcf"
          ],
          "assertions": {
            "equal": true
          }
        }
      ]
    }
