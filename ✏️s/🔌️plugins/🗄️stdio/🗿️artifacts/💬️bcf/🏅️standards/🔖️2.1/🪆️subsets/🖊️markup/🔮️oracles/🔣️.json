  "comparisonProfiles": [
    {
      "id": "semantic-bcf-v1",
      "description": "BCF 2.1 documents compared by version, every topic keyed by guid (title/description/status/priority/labels/creationDate/creationAuthor, comments keyed by guid, viewpoints keyed by guid), and every raw retained part keyed by name by size+content digest. A viewpoint's camera/components project as their full typed structure; its PNG snapshot projects as size+digest rather than raw bytes (an opaque binary payload, not a lossy-encoded sample array, so a content digest is the correct treatment per the fleet brief's raster precedent). Topic/comment/viewpoint/part identity keys make document-order irrelevant; label/selection/exception/coloring lists are unordered sets in the BCF domain, so all arrays compare as sets.",
      "arrays": "set",
      "ignoreKeys": []
    },
    {
      "id": "semantic-bcf-jszip-v1",
      "description": "Bundle-style comparison for the jszip+fast-xml-parser oracle: delegates to the bcf-2-1-jszip-compare-v1 pipeline rather than a single-projection diff.",
      "pipeline": "bcf-2-1-jszip-compare-v1"
    }
