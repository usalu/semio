{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/bcf/2.1/markup/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "snapshot"
  ],
  "properties": {
    "mutation": {
      "const": "setSnapshot"
    },
    "snapshot": {
      "$ref": "#/$defs/BcfSnapshot",
      "x-semio-ui": {
        "label": {
          "en": "BCF archive",
          "de": "BCF-Archiv"
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "BcfSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Schema",
              "de": "Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema this document follows.",
              "de": "Kennung des Snapshot-Schemas, dem dieses Dokument folgt."
            }
          }
        },
        "version": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "BCF version",
              "de": "BCF-Version"
            }
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BcfTopic"
          },
          "x-semio-ui": {
            "label": {
              "en": "Topics",
              "de": "Themen"
            }
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BcfRawPart"
          },
          "x-semio-ui": {
            "label": {
              "en": "Other archive parts",
              "de": "Weitere Archivteile"
            },
            "description": {
              "en": "Archive entries kept byte for byte.",
              "de": "Archiveinträge, die bytegenau erhalten bleiben."
            }
          }
        }
      }
    },
    "BcfTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guid",
        "title",
        "status"
      ],
      "properties": {
        "guid": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Status",
              "de": "Status"
            },
            "description": {
              "en": "Topic status, e.g. Open or Closed.",
              "de": "Themenstatus, z. B. Open oder Closed."
            }
          }
        },
        "priority": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Priority",
              "de": "Priorität"
            }
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Labels",
              "de": "Schlagwörter"
            }
          }
        },
        "creationDate": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Creation date",
              "de": "Erstellungsdatum"
            }
          }
        },
        "creationAuthor": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Created by",
              "de": "Erstellt von"
            }
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BcfComment"
          },
          "x-semio-ui": {
            "label": {
              "en": "Comments",
              "de": "Kommentare"
            }
          }
        },
        "viewpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BcfViewpoint"
          },
          "x-semio-ui": {
            "label": {
              "en": "Viewpoints",
              "de": "Ansichtspunkte"
            }
          }
        }
      }
    },
    "BcfComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guid",
        "date",
        "author",
        "text"
      ],
      "properties": {
        "guid": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Date",
              "de": "Datum"
            },
            "description": {
              "en": "ISO 8601 date and time.",
              "de": "Datum und Uhrzeit nach ISO 8601."
            }
          }
        },
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "viewpointRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Viewpoint",
              "de": "Ansichtspunkt"
            },
            "description": {
              "en": "GUID of the viewpoint the comment refers to.",
              "de": "GUID des Ansichtspunkts, auf den sich der Kommentar bezieht."
            }
          }
        }
      }
    },
    "BcfViewpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guid"
      ],
      "properties": {
        "guid": {
          "type": "string"
        },
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/BcfCamera"
            },
            {
              "type": "null"
            }
          ]
        },
        "components": {
          "anyOf": [
            {
              "$ref": "#/$defs/BcfComponents"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Components",
              "de": "Bauteile"
            }
          }
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Snapshot image",
              "de": "Snapshot-Bild"
            },
            "description": {
              "en": "PNG bytes of the viewpoint snapshot; empty removes it.",
              "de": "PNG-Bytes des Ansichtspunkt-Snapshots; leer entfernt ihn."
            }
          }
        }
      }
    },
    "BcfCamera": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "viewPoint",
            "direction",
            "upVector",
            "fieldOfView"
          ],
          "properties": {
            "kind": {
              "const": "perspective"
            },
            "viewPoint": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "direction": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "upVector": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "fieldOfView": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "viewPoint",
            "direction",
            "upVector",
            "viewToWorldScale"
          ],
          "properties": {
            "kind": {
              "const": "orthogonal"
            },
            "viewPoint": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "direction": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "upVector": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "viewToWorldScale": {
              "type": "number"
            }
          }
        }
      ]
    },
    "BcfPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "BcfComponents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Selected components",
              "de": "Ausgewählte Bauteile"
            },
            "description": {
              "en": "IFC GUIDs of the selected components.",
              "de": "IFC-GUIDs der ausgewählten Bauteile."
            }
          }
        },
        "visibility": {
          "$ref": "#/$defs/BcfVisibility",
          "x-semio-ui": {
            "label": {
              "en": "Visibility",
              "de": "Sichtbarkeit"
            }
          }
        },
        "coloring": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BcfColoring"
          },
          "x-semio-ui": {
            "label": {
              "en": "Coloring",
              "de": "Einfärbung"
            }
          }
        }
      }
    },
    "BcfVisibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultVisibility"
      ],
      "properties": {
        "defaultVisibility": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Visible by default",
              "de": "Standardmäßig sichtbar"
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Exceptions",
              "de": "Ausnahmen"
            },
            "description": {
              "en": "IFC GUIDs of components that deviate from the default visibility.",
              "de": "IFC-GUIDs der Bauteile, die von der Standardsichtbarkeit abweichen."
            }
          }
        }
      }
    },
    "BcfColoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color"
      ],
      "properties": {
        "color": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Color",
              "de": "Farbe"
            },
            "description": {
              "en": "ARGB or RGB hex color.",
              "de": "ARGB- oder RGB-Hexfarbe."
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Components",
              "de": "Bauteile"
            },
            "description": {
              "en": "IFC GUIDs of the colored components.",
              "de": "IFC-GUIDs der eingefärbten Bauteile."
            }
          }
        }
      }
    },
    "BcfRawPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Entry name",
              "de": "Eintragsname"
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Entry bytes",
              "de": "Eintragsbytes"
            }
          }
        }
      }
    }
  }
}
