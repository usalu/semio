{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/bcf/2.1/markup/mutation/set-viewpoint-camera/schema.json",
  "title": "SetViewpointCamera",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "topicGuid",
    "guid"
  ],
  "properties": {
    "mutation": {
      "const": "setViewpointCamera"
    },
    "topicGuid": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Topic",
          "de": "Thema"
        },
        "description": {
          "en": "GUID of the topic.",
          "de": "GUID des Themas."
        },
        "ref": {
          "kind": "topic",
          "domain": "bcf"
        },
        "group": "target",
        "order": 10
      }
    },
    "guid": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Viewpoint",
          "de": "Ansichtspunkt"
        },
        "description": {
          "en": "GUID of the viewpoint.",
          "de": "GUID des Ansichtspunkts."
        },
        "ref": {
          "kind": "viewpoint",
          "domain": "bcf"
        },
        "group": "target",
        "order": 20
      }
    },
    "camera": {
      "anyOf": [
        {
          "$ref": "#/$defs/BcfCamera"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "BcfCamera": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "viewPoint",
            "direction",
            "upVector",
            "fieldOfView"
          ],
          "properties": {
            "kind": {
              "const": "perspective"
            },
            "viewPoint": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "direction": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "upVector": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "fieldOfView": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "viewPoint",
            "direction",
            "upVector",
            "viewToWorldScale"
          ],
          "properties": {
            "kind": {
              "const": "orthogonal"
            },
            "viewPoint": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "direction": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "upVector": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "viewToWorldScale": {
              "type": "number"
            }
          }
        }
      ]
    },
    "BcfPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
