{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/bcf/2.1/markup/mutation/set-viewpoint-camera/schema.json",
  "title": "SetViewpointCamera",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic_guid",
    "guid"
  ],
  "properties": {
    "topic_guid": {
      "type": "string"
    },
    "guid": {
      "type": "string"
    },
    "camera": {
      "anyOf": [
        {
          "$ref": "#/$defs/BcfCamera"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "BcfCamera": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "viewPoint",
            "direction",
            "upVector",
            "fieldOfView"
          ],
          "properties": {
            "kind": {
              "const": "perspective"
            },
            "viewPoint": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "direction": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "upVector": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "fieldOfView": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "viewPoint",
            "direction",
            "upVector",
            "viewToWorldScale"
          ],
          "properties": {
            "kind": {
              "const": "orthogonal"
            },
            "viewPoint": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "direction": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "upVector": {
              "$ref": "#/$defs/BcfPoint3"
            },
            "viewToWorldScale": {
              "type": "number"
            }
          }
        }
      ]
    },
    "BcfPoint3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
