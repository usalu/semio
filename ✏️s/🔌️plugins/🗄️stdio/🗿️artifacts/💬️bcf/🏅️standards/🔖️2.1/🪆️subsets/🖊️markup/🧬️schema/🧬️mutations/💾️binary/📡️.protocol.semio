dialect protocol
protocol stdio.bcf.mutations
version 1
schema stdio.bcf
start record
framing record

# Real `BcfMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record set-snapshot tag=1
field payload bytes
record set-version tag=2
field payload bytes
record insert-topic tag=3
field payload bytes
record remove-topic tag=4
field payload bytes
record set-topic-markup tag=5
field payload bytes
record insert-comment tag=6
field payload bytes
record remove-comment tag=7
field payload bytes
record set-comment tag=8
field payload bytes
record insert-viewpoint tag=9
field payload bytes
record remove-viewpoint tag=10
field payload bytes
record set-viewpoint-camera tag=11
field payload bytes
record set-viewpoint-components tag=12
field payload bytes
record set-viewpoint-snapshot tag=13
field payload bytes
