{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "headerSize": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "width": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "height": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "rowOrder": {
      "anyOf": [
        {
          "$ref": "#/$defs/BmpRowOrder"
        },
        {
          "type": "null"
        }
      ]
    },
    "planes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        {
          "type": "null"
        }
      ]
    },
    "bitsPerPixel": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        {
          "type": "null"
        }
      ]
    },
    "compression": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "imageSize": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "xPixelsPerMeter": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "yPixelsPerMeter": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "colorsUsed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "colorsImportant": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "BmpRowOrder": {
      "type": "string",
      "enum": [
        "bottomUp",
        "topDown"
      ]
    },
    "BmpPaletteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b",
        "g",
        "r",
        "reserved"
      ],
      "properties": {
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  },
  "title": "ChangeHeaderFieldsMutation"
}
