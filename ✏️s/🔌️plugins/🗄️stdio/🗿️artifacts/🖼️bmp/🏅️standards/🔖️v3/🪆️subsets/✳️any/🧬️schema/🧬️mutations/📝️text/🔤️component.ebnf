(* BmpMutation's wire text IS its JSON serialization (protocol::OpText — serde_json),
   tagged on "mutation" per 🦀️component.rs's enum. Real variant tags, not a placeholder. *)
mutation = "{", '"mutation"', ":", tag, { ",", member }, "}" ;
tag = '"noMutation"'
    | '"setSnapshot"'
    | '"setHeaderFields"'
    | '"insertPaletteEntry"'
    | '"removePaletteEntry"'
    | '"setPaletteEntry"'
    | '"setPixelData"' ;
member = string, ":", json value ;
