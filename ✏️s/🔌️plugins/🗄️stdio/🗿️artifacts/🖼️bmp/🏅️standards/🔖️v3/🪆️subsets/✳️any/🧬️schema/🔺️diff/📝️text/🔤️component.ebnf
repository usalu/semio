(* BmpDiff's wire text IS its JSON serialization (serde, camelCase), sparse fields per
   🦀️component.rs; this documents the real shape, not RFC 8259's JSON grammar. *)
diff = "{", [ member, { ",", member } ], "}" ;
member = '"headerSize"', ":", integer
       | '"width"', ":", integer
       | '"height"', ":", integer
       | '"rowOrder"', ":", row order
       | '"planes"', ":", integer
       | '"bitsPerPixel"', ":", integer
       | '"compression"', ":", integer
       | '"imageSize"', ":", integer
       | '"xPixelsPerMeter"', ":", integer
       | '"yPixelsPerMeter"', ":", integer
       | '"colorsUsed"', ":", integer
       | '"colorsImportant"', ":", integer
       | '"palette"', ":", palette diff
       | '"pixels"', ":", "[", { integer }, "]" ;
row order = '"bottomUp"' | '"topDown"' ;
palette diff = "{", [ pmember, { ",", pmember } ], "}" ;
pmember = '"removed"', ":", "[", { integer }, "]"
        | '"modified"', ":", "[", { palette modified }, "]"
        | '"added"', ":", "[", { palette added }, "]" ;
palette modified = "{", '"index"', ":", integer, ",", '"entry"', ":", palette entry, "}" ;
palette added = "{", '"index"', ":", integer, ",", '"entry"', ":", palette entry, "}" ;
palette entry = "{", '"b"', ":", integer, ",", '"g"', ":", integer, ",",
                '"r"', ":", integer, ",", '"reserved"', ":", integer, "}" ;
