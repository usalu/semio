dialect grammar stdio.bmp.mutations
root = mutation
; wire text IS the JSON serialization of BmpMutation (protocol::OpText — serde_json),
; tagged on "mutation" per 🦀️component.rs's enum
mutation = "{" '"mutation"' ":" tag ("," member)* "}"
tag = '"noMutation"' / '"setSnapshot"' / '"setHeaderFields"'
    / '"insertPaletteEntry"' / '"removePaletteEntry"' / '"setPaletteEntry"' / '"setPixelData"'
member = STRING ":" JSON_VALUE
