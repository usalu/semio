(* Complete schema-owned AVI snapshot text records. Field domains follow the adjacent JSON schema. *)
document = { element } ;
element = field | block | list | identifier | string | integer ;
field = identifier , "=" , element ;
block = identifier , "{" , { element } , "}" ;
list = "[" , { element } , "]" ;
identifier = letter , { letter | digit | "_" | "-" } ;
integer = [ "-" ] , digit , { digit } ;
string = '"' , { character | escape } , '"' ;
