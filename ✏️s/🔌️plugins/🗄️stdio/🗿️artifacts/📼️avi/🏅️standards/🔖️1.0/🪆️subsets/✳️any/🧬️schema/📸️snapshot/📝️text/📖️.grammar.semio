dialect grammar stdio.avi.snapshot
root = document
; preamble stripped before this runs (store::semio_format::split_text_preamble). RIFF/AVI has
; no textual syntax of its own — the DSL text is a whitespace-tolerant ASCII hex dump of the
; REAL binary RIFF bytes; see ../💾️binary/🥋️.ksy for the real chunk-tree grammar.
document = hex_byte (WS hex_byte)*
hex_byte = HEXDIG HEXDIG
HEXDIG = %x30-39 / %x41-46 / %x61-66
WS = *(%x20 / %x09 / %x0D / %x0A)
