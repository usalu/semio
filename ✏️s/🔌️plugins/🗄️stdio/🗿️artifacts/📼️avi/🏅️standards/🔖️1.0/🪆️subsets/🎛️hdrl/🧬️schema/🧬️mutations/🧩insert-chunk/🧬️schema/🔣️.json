{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/avi/1.0/hdrl/mutation/insert-chunk/schema.json",
  "title": "InsertChunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "streamIndex",
    "index",
    "chunk"
  ],
  "properties": {
    "mutation": {
      "const": "insertChunk",
      "description": "Aggregate discriminator spliced in by AviMutation; absent when the payload stands alone."
    },
    "streamIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Stream",
          "de": "Datenstrom"
        },
        "description": {
          "en": "Index of the stream, counted from 0.",
          "de": "Index des Datenstroms, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "chunk": {
      "$ref": "#/$defs/AviChunk",
      "x-semio-ui": {
        "label": {
          "en": "Chunk",
          "de": "Chunk"
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "AviChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourcc",
        "keyframe"
      ],
      "properties": {
        "fourcc": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "FourCC",
              "de": "FourCC"
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Chunk data",
              "de": "Chunk-Daten"
            }
          }
        },
        "keyframe": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Keyframe",
              "de": "Schlüsselbild"
            }
          }
        }
      }
    }
  }
}
