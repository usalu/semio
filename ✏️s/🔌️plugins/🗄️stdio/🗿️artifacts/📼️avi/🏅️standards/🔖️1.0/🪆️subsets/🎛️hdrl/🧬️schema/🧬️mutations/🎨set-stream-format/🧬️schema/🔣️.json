{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/avi/1.0/hdrl/mutation/set-stream-format/schema.json",
  "title": "SetStreamFormat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "streamIndex",
    "strf"
  ],
  "properties": {
    "mutation": {
      "const": "setStreamFormat",
      "description": "Aggregate discriminator spliced in by AviMutation; absent when the payload stands alone."
    },
    "streamIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Stream",
          "de": "Datenstrom"
        },
        "description": {
          "en": "Index of the stream, counted from 0.",
          "de": "Index des Datenstroms, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "strf": {
      "$ref": "#/$defs/AviStreamFormat",
      "x-semio-ui": {
        "label": {
          "en": "Stream format",
          "de": "Datenstromformat"
        },
        "description": {
          "en": "strf chunk: BITMAPINFOHEADER or WAVEFORMATEX.",
          "de": "strf-Chunk: BITMAPINFOHEADER oder WAVEFORMATEX."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "AviStreamFormat": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "size",
            "width",
            "height",
            "planes",
            "bitCount",
            "compression",
            "sizeImage",
            "xPelsPerMeter",
            "yPelsPerMeter",
            "colorsUsed",
            "colorsImportant"
          ],
          "properties": {
            "format": {
              "const": "bitmapInfo"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "width": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "height": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "planes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "bitCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "compression": {
              "type": "string"
            },
            "sizeImage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "xPelsPerMeter": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "yPelsPerMeter": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "colorsUsed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "colorsImportant": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "formatTag",
            "channels",
            "samplesPerSec",
            "avgBytesPerSec",
            "blockAlign",
            "bitsPerSample"
          ],
          "properties": {
            "format": {
              "const": "waveFormat"
            },
            "formatTag": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "channels": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "samplesPerSec": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "avgBytesPerSec": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "blockAlign": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "bitsPerSample": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "data"
          ],
          "properties": {
            "format": {
              "const": "raw"
            },
            "data": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      ]
    }
  }
}
