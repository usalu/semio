{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/avi/1.0/hdrl/mutation/set-chunk-keyframe/schema.json",
  "title": "SetChunkKeyframe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "streamIndex",
    "index",
    "keyframe"
  ],
  "properties": {
    "mutation": {
      "const": "setChunkKeyframe",
      "description": "Aggregate discriminator spliced in by AviMutation; absent when the payload stands alone."
    },
    "streamIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Stream",
          "de": "Datenstrom"
        },
        "description": {
          "en": "Index of the stream, counted from 0.",
          "de": "Index des Datenstroms, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Chunk",
          "de": "Chunk"
        },
        "description": {
          "en": "Index of the chunk within the stream, counted from 0.",
          "de": "Index des Chunks im Datenstrom, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "keyframe": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "label": {
          "en": "Keyframe",
          "de": "Schlüsselbild"
        },
        "group": "value",
        "order": 30
      }
    }
  }
}
