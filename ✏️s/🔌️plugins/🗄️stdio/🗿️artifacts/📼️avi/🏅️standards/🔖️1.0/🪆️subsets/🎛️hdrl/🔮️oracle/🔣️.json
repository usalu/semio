  "comparisonProfiles": [
    {
      "id": "semantic-avi-v1",
      "description": "AVI 1.0 documents compared structurally: the main header's 10 typed DWORD fields plus dwReserved, idx1Present, and every stream IN ORDER (stream index is semantic identity in AVI — the movi fourcc's own leading 2-digit stream number — unlike a guid-keyed document; there is no natural stable identity for a stream or a movi chunk beyond its position). Each stream's strh (all 16 fields) and strf (BitmapInfo/WaveFormat/Raw, discriminated by a `format` tag) project as their full typed structure; each movi chunk projects as fourcc, keyframe flag, and a size+digest of its payload rather than raw bytes, since a real chunk in the committed fixture runs into the tens of kilobytes — the same opaque-binary-payload treatment the fleet brief's own raster/mp4 precedent gives large payloads. Every top-level unknown chunk (an unrecognised chunk or LIST directly inside the RIFF form, tagged `LIST:<type>` for the latter) projects the same way, in file order. Arrays are order-significant throughout: streams, chunks and unknown chunks are all positional in this format, never set-like.",
      "arrays": "ordered",
      "ignoreKeys": [],
      "pipeline": "avi-1-0-riff-compare-v1"
    }
  ],
