{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/avi/1.0/hdrl/mutation/add-unknown-chunk.json",
  "title": "AddUnknownChunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "item"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "item": {
      "$ref": "#/$defs/RiffChunk"
    },
    "mutation": {
      "const": "addUnknownChunk",
      "description": "Aggregate discriminator spliced in by AviMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "RiffChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourcc"
      ],
      "properties": {
        "fourcc": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
