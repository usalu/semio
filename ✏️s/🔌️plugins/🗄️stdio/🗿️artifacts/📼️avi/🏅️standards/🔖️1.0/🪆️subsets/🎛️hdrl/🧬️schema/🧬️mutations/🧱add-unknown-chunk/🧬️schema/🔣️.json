{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/avi/1.0/hdrl/mutation/add-unknown-chunk/schema.json",
  "title": "AddUnknownChunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "item"
  ],
  "properties": {
    "mutation": {
      "const": "addUnknownChunk",
      "description": "Aggregate discriminator spliced in by AviMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "item": {
      "$ref": "#/$defs/RiffChunk",
      "x-semio-ui": {
        "label": {
          "en": "Chunk",
          "de": "Chunk"
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "RiffChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourcc"
      ],
      "properties": {
        "fourcc": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "FourCC",
              "de": "FourCC"
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Chunk data",
              "de": "Chunk-Daten"
            }
          }
        }
      }
    }
  }
}
