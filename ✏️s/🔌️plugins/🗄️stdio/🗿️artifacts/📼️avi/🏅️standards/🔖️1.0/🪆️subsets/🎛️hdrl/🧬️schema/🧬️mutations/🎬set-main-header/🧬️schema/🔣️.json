{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/avi/1.0/hdrl/mutation/set-main-header.json",
  "title": "SetMainHeader",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "main_header"
  ],
  "properties": {
    "main_header": {
      "$ref": "#/$defs/AviMainHeader"
    },
    "mutation": {
      "const": "setMainHeader",
      "description": "Aggregate discriminator spliced in by AviMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "AviMainHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "microSecPerFrame",
        "maxBytesPerSec",
        "paddingGranularity",
        "flags",
        "totalFrames",
        "initialFrames",
        "streams",
        "suggestedBufferSize",
        "width",
        "height"
      ],
      "properties": {
        "microSecPerFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maxBytesPerSec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "paddingGranularity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "totalFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "initialFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "streams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "suggestedBufferSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "reserved": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    }
  }
}
