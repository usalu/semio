{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/avi/1.0/hdrl/mutation/set-main-header/schema.json",
  "title": "SetMainHeader",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "mainHeader"
  ],
  "properties": {
    "mutation": {
      "const": "setMainHeader",
      "description": "Aggregate discriminator spliced in by AviMutation; absent when the payload stands alone."
    },
    "mainHeader": {
      "$ref": "#/$defs/AviMainHeader",
      "x-semio-ui": {
        "label": {
          "en": "Main header",
          "de": "Hauptheader"
        },
        "description": {
          "en": "avih chunk",
          "de": "avih-Chunk"
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "AviMainHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "microSecPerFrame",
        "maxBytesPerSec",
        "paddingGranularity",
        "flags",
        "totalFrames",
        "initialFrames",
        "streams",
        "suggestedBufferSize",
        "width",
        "height"
      ],
      "properties": {
        "microSecPerFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Frame duration",
              "de": "Framedauer"
            },
            "unit": "µs"
          }
        },
        "maxBytesPerSec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Maximum data rate",
              "de": "Maximale Datenrate"
            },
            "unit": "B/s"
          }
        },
        "paddingGranularity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Padding granularity",
              "de": "Auffüllgranularität"
            },
            "unit": "B"
          }
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Flags",
              "de": "Flags"
            }
          }
        },
        "totalFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Total frames",
              "de": "Gesamtzahl Frames"
            }
          }
        },
        "initialFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Initial frames",
              "de": "Anfangsframes"
            }
          }
        },
        "streams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Stream count",
              "de": "Anzahl Datenströme"
            }
          }
        },
        "suggestedBufferSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Suggested buffer size",
              "de": "Empfohlene Puffergröße"
            },
            "unit": "B"
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Width",
              "de": "Breite"
            },
            "unit": "px"
          }
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Height",
              "de": "Höhe"
            },
            "unit": "px"
          }
        },
        "reserved": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "x-semio-ui": {
            "label": {
              "en": "Reserved",
              "de": "Reserviert"
            }
          }
        }
      }
    }
  }
}
