; AVI snapshot binary envelope around the repository typed RecordSpec document.
document = envelope-magic token-len token record-payload
envelope-magic = %x89.53.45.4D.0D.0A.1A.0A
token-len = 4OCTET ; little-endian UTF-8 token byte count
token = 17OCTET ; "stdio.avi.pack v1"
record-payload = *OCTET ; store::pack_rt document, validated against AviSnapshot::__dsl_spec
