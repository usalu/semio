dialect protocol stdio.avi.snapshot
; Snapshot persistence encodes the complete owned record tree through store::pack_rt.
; The ordinary RIFF serializer is a separate I/O representation.
envelope-magic = %x89.53.45.4D.0D.0A.1A.0A
token-len = U32LE
token = UTF8(17) ; "stdio.avi.pack v1"
record-payload = BYTES(*) ; repository typed RecordSpec document
; Root fields: schema, main_header, streams, idx1_present, unknown_chunks, hdrl_extra.
; MainHeader: ten unsigned DWORD fields and an ordered unrestricted reserved DWORD list.
; Stream: full nineteen-field header, exactly one bitmapInfo/waveFormat/raw choice,
; ordered chunks with keyframe state and ordered strl_extra chunks.
; All intrinsic octets and arbitrary UTF-8 strings are owned scalar/list fields.
