dialect protocol
protocol stdio.avi.snapshot
version 1
schema stdio.avi
start snapshot
framing record
use semio.pack

# RecordSpec owns presence, format selection and ordered collection framing.
record snapshot {
  schema utf8
  mainHeader Ref(AviMainHeader)
  streams array Ref(AviStream)
  idx1Present u8
  unknownChunks array Ref(RiffChunk)
  hdrlExtra array Ref(RiffChunk)
}
record AviMainHeader {
  microSecPerFrame u32
  maxBytesPerSec u32
  paddingGranularity u32
  flags u32
  totalFrames u32
  initialFrames u32
  streams u32
  suggestedBufferSize u32
  width u32
  height u32
  reserved array u32
}
record AviStream {
  strh Ref(AviStreamHeader)
  strf Ref(AviStreamFormat)
  chunks array Ref(AviChunk)
  strlExtra array Ref(RiffChunk)
}
record AviStreamHeader {
  fccType utf8
  fccHandler utf8
  flags u32
  priority u16
  language u16
  initialFrames u32
  scale u32
  rate u32
  start u32
  length u32
  suggestedBufferSize u32
  quality i32
  sampleSize u32
  rcFrameLeft i32
  rcFrameTop i32
  rcFrameRight i32
  rcFrameBottom i32
  rcFrameWidth u8
  strhExtra array u8
}
enum AviStreamFormat {
  bitmapInfo=0
  waveFormat=1
  raw=2
}
record AviBitmapInfo {
  size u32
  width i32
  height i32
  planes u16
  bitCount u16
  compression utf8
  sizeImage u32
  xPelsPerMeter i32
  yPelsPerMeter i32
  colorsUsed u32
  colorsImportant u32
}
record AviWaveFormat {
  formatTag u16
  channels u16
  samplesPerSec u32
  avgBytesPerSec u32
  blockAlign u16
  bitsPerSample u16
  extra array u8
}
record AviRawFormat {
  data array u8
}
record AviChunk {
  fourcc utf8
  data array u8
  keyframe u8
}
record RiffChunk {
  fourcc utf8
  data array u8
}
