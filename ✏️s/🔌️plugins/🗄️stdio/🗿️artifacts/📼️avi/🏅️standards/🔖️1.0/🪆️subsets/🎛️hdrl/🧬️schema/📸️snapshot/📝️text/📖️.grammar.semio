dialect grammar stdio.avi.snapshot
root = document
; Schema-owned fields and variant boundaries are declared by AviSnapshot's RecordSpec.
; The text body retains every header, format choice and intrinsic chunk field.
document = element*
element = field / block / list / IDENT / STRING / INT
field = IDENT "=" element
block = IDENT "{" element* "}"
list = "[" element* "]"
IDENT = 1*(ALPHA / DIGIT / "-" / "_")
STRING = DQUOTE *(%x20-21 / %x23-5B / %x5D-10FFFF) DQUOTE
INT = ["-"] 1*DIGIT
