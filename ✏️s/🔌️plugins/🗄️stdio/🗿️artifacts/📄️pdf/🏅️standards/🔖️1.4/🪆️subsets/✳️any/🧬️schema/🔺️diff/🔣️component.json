{
  "$id": "https://semio.tech/schema/s.stdio.pdf/diff.json",
  "title": "PdfDiff",
  "$defs": {
    "PdfPageDiff": {
      "description": "Sparse per-field patch for one PageDoc.",
      "type": "object",
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "text": { "type": "string" }
      }
    },
    "PdfPageModified": {
      "type": "object",
      "required": ["index", "diff"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "diff": { "$ref": "#/$defs/PdfPageDiff" }
      }
    },
    "PdfPageAdded": {
      "type": "object",
      "required": ["index", "page"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "page": { "$ref": "snapshot.json#/$defs/PageDoc" }
      }
    },
    "PdfPagesDiff": {
      "description": "Index-keyed collection triple over the document's pages. removed/modified indices address the BASE state, added indices the FINAL state.",
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "modified": { "type": "array", "items": { "$ref": "#/$defs/PdfPageModified" } },
        "added": { "type": "array", "items": { "$ref": "#/$defs/PdfPageAdded" } }
      }
    }
  },
  "type": "object",
  "properties": {
    "pages": { "$ref": "#/$defs/PdfPagesDiff", "x-semio-state": "artifact" }
  }
}
