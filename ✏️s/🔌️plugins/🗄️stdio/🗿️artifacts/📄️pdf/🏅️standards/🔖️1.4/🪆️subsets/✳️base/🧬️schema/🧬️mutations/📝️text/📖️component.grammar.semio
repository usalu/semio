dialect grammar
grammar stdio.pdf.mutations
start op
comment none

op = insert-page | remove-page | move-page | resize-page | replace-page-text
insert-page = "insert-page" "payload" "=" hex
remove-page = "remove-page" "payload" "=" hex
move-page = "move-page" "payload" "=" hex
resize-page = "resize-page" "payload" "=" hex
replace-page-text = "replace-page-text" "payload" "=" hex
