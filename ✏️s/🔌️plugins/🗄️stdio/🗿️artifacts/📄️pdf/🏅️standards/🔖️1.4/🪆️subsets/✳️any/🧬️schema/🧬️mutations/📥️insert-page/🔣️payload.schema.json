{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/stdio/pdf/1.4/mutations/insert-page",
  "title": "InsertPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "page"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "text"
      ],
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
