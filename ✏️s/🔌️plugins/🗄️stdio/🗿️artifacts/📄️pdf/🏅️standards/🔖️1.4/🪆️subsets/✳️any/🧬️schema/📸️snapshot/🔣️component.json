{
  "$id": "https://semio.tech/schema/s.stdio.pdf/snapshot.json",
  "title": "PdfSnapshot",
  "$defs": {
    "PageDoc": {
      "type": "object",
      "required": ["width", "height", "text"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "text": { "type": "string" }
      }
    }
  },
  "type": "object",
  "required": ["schema", "page"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "page": { "$ref": "#/$defs/PageDoc", "x-semio-state": "artifact" }
  }
}
