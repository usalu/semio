dialect grammar
grammar stdio.pdf.1.7.diff
start diff
comment none

# P2-FG3: real one-line `DiffCodec::print_diff`/`parse_diff` shape for `stdio.pdf.1.7`'s
# hand-rolled `PdfDiff` (../../🦀️component.rs `print_pdf_diff`/`parse_pdf_diff`) -- every
# keyword/tag token and value micro-syntax production below is copied verbatim from the real
# `format!(...)` call sites (`enc_pages_diff`/`enc_page_diff`/`enc_dict_diff`/`enc_array_diff`/
# `enc_value_diff`/`enc_objects_diff`), never guessed. `#[derive(dsl::DslDiff)]` was tried for real
# and confirmed rejected (blocker: `PdfObject`/`PdfValueDiff` are genuine data-carrying enums
# reachable via `Replace`/`Array`/`Dict` items, plus the typed filter pipeline is an
# independent tri-state blocker -- see that file's own doc comment).
diff = declared-version-field? info-field? pages-field? objects-field? trailer-field?
declared-version-field = "declared-version" "=" hex
info-field = "info" "=" info-lit
pages-field = "pages" "=" pages-diff-body
objects-field = "objects" "=" objects-diff-body
trailer-field = "trailer" "=" dict-diff-body

# `encode_option`'s uniform tri-state shape and shared value micro-syntax
# (`📖️grammar-recipe.md` §1.4); restated here so this diff-facet grammar is self-contained, same
# per-facet convention xml's own sibling diff/mutations grammars use.
opt-hex = "[" "0" "]" | "[" "1" "," hex "]"
opt-box = "[" "0" "]" | "[" "1" "," box-lit "]"
bit = "0" | "1"
number = INT | FLOAT
objref-lit = "[" INT "," INT "]"
box-lit = "[" number "," number "," number "," number "]"
info-lit = "[" opt-hex "," opt-hex "," opt-hex "," opt-hex "," opt-hex "," opt-hex "]"
page-lit = "[" box-lit "," opt-box "," INT "," hex "]"

# `enc_pdf_object`/`dec_pdf_object` -- restated (same shape as ../../🧬️mutations/📝️text/
# 📖️component.grammar.semio's own `pdf-object`) so this facet grammar is self-contained.
pdf-object = "Z" | "B" "[" bit "]" | "I" "[" INT "]" | "R" "[" number "]" | "S" "[" hex "]" | "N" "[" hex "]" | "A" "[" pdf-object-item* "]" | "D" "[" dict-entry-item* "]" | "F" "[" objref-lit "]" | "T" "[" "[" dict-entry-item* "]" "," hex "," stream-filters "]"
pdf-object-item = pdf-object ","?
dict-entry-item = dict-entry-lit ","?
dict-entry-lit = "[" hex "," pdf-object "]"

# `enc_pages_diff`/`dec_pages_diff` -- index-keyed collection triple (`📖️grammar-recipe.md` §1.4):
# `[removed];[modified];[added]`, `modified` items carry a sparse `PdfPageDiff`, `added` items
# carry a full `PdfPage`.
pages-diff-body = "[" removed-index-item* "]" ";" "[" page-modified-item* "]" ";" "[" page-added-item* "]"
removed-index-item = INT ","?
page-modified-item = INT ":" page-diff-lit ","?
page-added-item = INT ":" page-lit ","?

# `enc_page_diff`/`dec_page_diff` -- `PdfPageDiff`'s own sparse fields as single-letter `tag:value`
# pairs: `M`=media_box, `C`=crop_box (tri-state, one level of `encode_option` over the inner
# `Option<[f64;4]>`), `R`=rotate, `X`=text.
page-diff-lit = "[" page-diff-item* "]"
page-diff-item = page-diff-entry ","?
page-diff-entry = "M" ":" box-lit | "C" ":" opt-box | "R" ":" INT | "X" ":" hex

# `enc_dict_diff`/`dec_dict_diff` -- name-keyed collection triple, reused verbatim for `Dict`/
# `Stream.dict`/top-level `trailer` (the recipe's "trailer is itself a Dict-shaped structure"
# guidance): `[removed];[modified];[added]`, keys are hex.
dict-diff-body = "[" removed-key-item* "]" ";" "[" dict-modified-item* "]" ";" "[" dict-added-item* "]"
removed-key-item = hex ","?
dict-modified-item = hex ":" value-diff ","?
dict-added-item = INT ":" hex ":" pdf-object ","?

# `enc_array_diff`/`dec_array_diff` -- index-keyed collection triple, nested inside
# `PdfValueDiff::Array` only.
array-diff-body = "[" removed-index-item* "]" ";" "[" array-modified-item* "]" ";" "[" array-added-item* "]"
array-modified-item = INT ":" value-diff ","?
array-added-item = INT ":" pdf-object ","?

# `enc_value_diff`/`dec_value_diff` -- recursive, mirrors `pdf-object`'s own tag vocabulary:
# `L`=Replace (whole-node), `B`/`I`/`R`/`S`/`N`/`F`=scalar diffs (new value only, node KIND is
# stable), `A[..]`=Array diff, `D[..]`=Dict diff, `T[..]`=Stream diff (its OWN sparse `D:`/`A:`/
# `F:` tag:value pairs for `dict`/decoded `data`/typed `filters` -- `filters` is sparse,
# `encode_option` over the inner `Option<String>`).
value-diff = "L" "[" pdf-object "]" | "B" "[" bit "]" | "I" "[" INT "]" | "R" "[" number "]" | "S" "[" hex "]" | "N" "[" hex "]" | "F" "[" objref-lit "]" | "A" "[" array-diff-body "]" | "D" "[" dict-diff-body "]" | "T" "[" stream-diff-item* "]"
stream-diff-item = stream-diff-entry ","?
stream-diff-entry = "D" ":" dict-diff-body | "A" ":" hex | "F" ":" stream-filters
stream-filters = "[" stream-filter-item* "]"
stream-filter-item = stream-filter ","?
stream-filter = "H" | "A" | "L" | "F" "[" "0" "]" | "F" "[" "1" "," INT "," INT "," INT "," INT "]"

# `enc_objects_diff`/`dec_objects_diff` -- `(id,gen)`-keyed collection triple (the recipe's
# "numeric id" key kind, using the full `ObjRef`).
objects-diff-body = "[" removed-objref-item* "]" ";" "[" objects-modified-item* "]" ";" "[" objects-added-item* "]"
removed-objref-item = objref-lit ","?
objects-modified-item = objref-lit ":" value-diff ","?
objects-added-item = INT ":" objref-lit ":" pdf-object ","?
