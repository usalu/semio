{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s.stdio.pdf.1.7.h/mutation/embed-font-file.json",
  "title": "EmbedFontFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "descriptorOrdinal",
    "key",
    "program"
  ],
  "properties": {
    "mutation": {
      "const": "embedFontFile"
    },
    "descriptorOrdinal": {
      "type": "integer",
      "minimum": 0
    },
    "key": {
      "type": "string"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "gen"],
      "properties": {
        "num": { "type": "integer", "minimum": 0 },
        "gen": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
