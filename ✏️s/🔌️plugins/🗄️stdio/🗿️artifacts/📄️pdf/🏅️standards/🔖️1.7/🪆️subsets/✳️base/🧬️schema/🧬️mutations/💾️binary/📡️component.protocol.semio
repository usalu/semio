dialect protocol
protocol stdio.pdf.1.7.mutations
version 1
schema stdio.pdf.1.7.op
start record

# Exact binary op frame: format byte, direct-owner tag, payload length, then canonical aggregate
# JSON. `tag` is the `PdfMutation` direct-owner ordinal, exactly 0-15: InsertPage, RemovePage, SetPageMediaBox,
# SetPageCropBox, AppendPageContent, SetInfo, InsertObject, RemoveObject, SetObjectValue,
# SetDictEntry, RemoveDictEntry, SetTrailerEntry, RemoveTrailerEntry, MovePage, SetPageContent,
# SetPageRotation.
#
# The schema-derived JSON tail retains recursive PDF values without duplicating their grammar.
framing record
header fixed 2
field format u8
field tag u8
chain payload bytes
