dialect grammar
grammar stdio.pdf.1.7.mutations
start op
comment none

# P2-FG3: real one-line `OpText::print_op`/`parse_op` shape for `stdio.pdf.1.7`'s hand-rolled
# `PdfMutation` (../../🦀️component.rs `print_pdf_mutation`/`parse_pdf_mutation`) -- every
# keyword/field-name token and every value micro-syntax production below is copied verbatim from
# the real `format!(...)` call sites in that file (`enc_pdf_object`/`enc_pdf_page`/`enc_pdf_info`/
# `enc_objref`/`enc_path`/`enc_pdf_snapshot`/`encode_option`/`enc_box`/`hex_encode` via `enc_str`),
# never guessed. `#[derive(dsl::DslOps)]` was tried for real and confirmed rejected (blocker: every
# variant reaches `PdfObject`/`ObjRef`/`PdfPathSegment`, none of which satisfy `DslField` -- see
# that file's own doc comment), so there is no `DslVariants`-derived keyword table to trace instead.
op = no-mutation | set-snapshot | insert-page | remove-page | set-page-media-box | set-page-crop-box | append-page-content | set-info | insert-object | remove-object | set-object-value | set-dict-entry | remove-dict-entry | set-trailer-entry | remove-trailer-entry

no-mutation = "no-mutation"
set-snapshot = "set-snapshot" "snapshot" "=" snapshot-lit
insert-page = "insert-page" "index" "=" INT "page" "=" page-lit
remove-page = "remove-page" "index" "=" INT
set-page-media-box = "set-page-media-box" "index" "=" INT "media-box" "=" box-lit
set-page-crop-box = "set-page-crop-box" "index" "=" INT "crop-box" "=" opt-box
append-page-content = "append-page-content" "index" "=" INT "text" "=" hex
set-info = "set-info" "info" "=" info-lit
insert-object = "insert-object" "id" "=" objref-lit "value" "=" pdf-object
remove-object = "remove-object" "id" "=" objref-lit
set-object-value = "set-object-value" "id" "=" objref-lit "value" "=" pdf-object
set-dict-entry = "set-dict-entry" "id" "=" objref-lit "path" "=" path-lit "key" "=" hex "value" "=" pdf-object
remove-dict-entry = "remove-dict-entry" "id" "=" objref-lit "path" "=" path-lit "key" "=" hex
set-trailer-entry = "set-trailer-entry" "key" "=" hex "value" "=" pdf-object
remove-trailer-entry = "remove-trailer-entry" "key" "=" hex

# `enc_objref`/`dec_objref` -- `[num,gen]`, both plain non-negative `INT`s.
objref-lit = "[" INT "," INT "]"
# `enc_box`/`dec_box` -- `[x0,y0,x1,y1]`, 4 `f64`s printed via bare Rust `Display` (a whole-valued
# float MAY print with no fractional part, hence `INT | FLOAT` -- same defensive convention
# stl's/obj's own `number` productions use).
box-lit = "[" number "," number "," number "," number "]"
# `encode_option`'s uniform tri-state shape (`📖️grammar-recipe.md` §1.4).
opt-box = "[" "0" "]" | "[" "1" "," box-lit "]"
opt-hex = "[" "0" "]" | "[" "1" "," hex "]"
bit = "0" | "1"
number = INT | FLOAT

# `enc_path`/`dec_path` -- `[seg,seg,...]`; `enc_path_segment`/`dec_path_segment` -- `I[index]`
# (array-index step) or `K[hex]` (dict-key step).
path-lit = "[" path-item* "]"
path-item = path-segment ","?
path-segment = "I" "[" INT "]" | "K" "[" hex "]"

# `enc_pdf_page`/`dec_pdf_page` -- `[box,opt-box,rotate,hex(text)]`.
page-lit = "[" box-lit "," opt-box "," INT "," hex "]"
# `enc_pdf_info`/`dec_pdf_info` -- 6 tri-state hex fields, in `title/author/subject/keywords/
# creator/producer` declaration order.
info-lit = "[" opt-hex "," opt-hex "," opt-hex "," opt-hex "," opt-hex "," opt-hex "]"

# `enc_pdf_snapshot`/`dec_pdf_snapshot` -- `[hex(schema),hex(declaredVersion),[pages],info,
# [indirectObjects],[trailerEntries]]`.
snapshot-lit = "[" hex "," hex "," "[" page-item* "]" "," info-lit "," "[" indirect-object-item* "]" "," "[" dict-entry-item* "]" "]"
page-item = page-lit ","?
# `enc_indirect_object`/`dec_indirect_object` -- `[objref,pdfObject]`.
indirect-object-item = indirect-object-lit ","?
indirect-object-lit = "[" objref-lit "," pdf-object "]"
# `enc_dict_entry`/`dec_dict_entry` -- `[hex(key),pdfObject]`.
dict-entry-item = dict-entry-lit ","?
dict-entry-lit = "[" hex "," pdf-object "]"

# `enc_pdf_object`/`dec_pdf_object` -- the full recursive COS object grammar (ISO 32000-1 §7.3):
# `Z`=Null (bare, no payload) / `B[bit]`=Bool / `I[int]`=Int / `R[number]`=Real / `S[hex]`=Str /
# `N[hex]`=Name / `A[items]`=Array / `D[entries]`=Dict / `F[objref]`=Ref (indirect reference) /
# `T[[entries],hex(decoded-data),stream-filters]`=Stream -- single-uppercase-letter tag prefix, never
# ambiguous with a hex payload (hex never starts with an uppercase letter) or with `Z`'s bare form
# (every other tag is immediately followed by `[`).
pdf-object = "Z" | "B" "[" bit "]" | "I" "[" INT "]" | "R" "[" number "]" | "S" "[" hex "]" | "N" "[" hex "]" | "A" "[" pdf-object-item* "]" | "D" "[" dict-entry-item* "]" | "F" "[" objref-lit "]" | "T" "[" "[" dict-entry-item* "]" "," hex "," stream-filters "]"
pdf-object-item = pdf-object ","?
stream-filters = "[" stream-filter-item* "]"
stream-filter-item = stream-filter ","?
stream-filter = "H" | "A" | "L" | "F" "[" "0" "]" | "F" "[" "1" "," INT "," INT "," INT "," INT "]"
