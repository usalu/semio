{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gif/87a/any/mutation/set-global-color-table/schema.json",
  "title": "SetGlobalColorTable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setGlobalColorTable",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    },
    "gct": {
      "anyOf": [
        {
          "$ref": "#/$defs/GifColorTable"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Global color table",
          "de": "Globale Farbtabelle"
        },
        "description": {
          "en": "Empty removes the global color table.",
          "de": "Leer entfernt die globale Farbtabelle."
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "GifColorTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sorted": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Sorted by importance",
              "de": "Nach Wichtigkeit sortiert"
            }
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GifRgb"
          },
          "x-semio-ui": {
            "label": {
              "en": "Colors",
              "de": "Farben"
            }
          }
        }
      }
    },
    "GifRgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        }
      }
    }
  }
}
