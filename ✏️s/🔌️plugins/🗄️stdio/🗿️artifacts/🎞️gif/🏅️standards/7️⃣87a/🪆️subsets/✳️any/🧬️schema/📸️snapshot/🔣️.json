{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gif/87a/any/snapshot.json",
  "title": "GifSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "width",
    "height",
    "gct",
    "backgroundColorIndex",
    "pixelAspectRatio",
    "images"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "width": {
      "$ref": "#/definitions/u32",
      "x-semio-state": "artifact"
    },
    "height": {
      "$ref": "#/definitions/u32",
      "x-semio-state": "artifact"
    },
    "gct": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/colorTable"
        }
      ],
      "x-semio-state": "artifact"
    },
    "backgroundColorIndex": {
      "$ref": "#/definitions/byte",
      "x-semio-state": "artifact"
    },
    "pixelAspectRatio": {
      "$ref": "#/definitions/byte",
      "x-semio-state": "artifact"
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/image"
      },
      "x-semio-state": "artifact"
    }
  },
  "definitions": {
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "rgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "$ref": "#/definitions/byte"
        },
        "g": {
          "$ref": "#/definitions/byte"
        },
        "b": {
          "$ref": "#/definitions/byte"
        }
      }
    },
    "colorTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sorted",
        "colors"
      ],
      "properties": {
        "sorted": {
          "type": "boolean"
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rgb"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "width",
        "height",
        "interlace",
        "lct",
        "indices"
      ],
      "properties": {
        "left": {
          "$ref": "#/definitions/u32"
        },
        "top": {
          "$ref": "#/definitions/u32"
        },
        "width": {
          "$ref": "#/definitions/u32"
        },
        "height": {
          "$ref": "#/definitions/u32"
        },
        "interlace": {
          "type": "boolean"
        },
        "lct": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/colorTable"
            }
          ]
        },
        "indices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/byte"
          }
        }
      }
    }
  }
}
