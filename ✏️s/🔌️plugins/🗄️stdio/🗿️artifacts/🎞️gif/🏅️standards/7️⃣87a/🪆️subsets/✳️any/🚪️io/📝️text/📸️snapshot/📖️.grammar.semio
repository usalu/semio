dialect grammar
grammar stdio.gif.snapshot
extension gif
start document
comment none

document = "stdio.gif" snapshot
snapshot = "schema" "=" text "width" "=" uint "height" "=" uint "background-color-index" "=" uint "pixel-aspect-ratio" "=" uint global-palette? "images" "=" "[" image* "]"
global-palette = "gct" "{" palette "}"
local-palette = "lct" "{" palette "}"
palette = "sorted" "=" bool "colors" "=" "[" color* "]"
color = "{" "r" "=" uint "g" "=" uint "b" "=" uint "}"
image = "{" "left" "=" uint "top" "=" uint "width" "=" uint "height" "=" uint "interlace" "=" bool "indices" "=" text local-palette? "}"
uint = INT
text = STRING / IDENT / INT / FLOAT
bool = "true" / "false"
