dialect protocol
protocol stdio.gif.snapshot
version 1
schema stdio.gif
start snapshot
framing record
use semio.pack

record snapshot {
  schema utf8
  width u32
  height u32
  gct Ref(OptionalColorTable)
  background-color-index u8
  pixel-aspect-ratio u8
  images array Ref(GifImage)
}
record GifImage {
  left u32
  top u32
  width u32
  height u32
  interlace u8
  lct Ref(OptionalColorTable)
  indices array u8
}
record GifRgb {
  r u8
  g u8
  b u8
}
record GifColorTable {
  sorted u8
  colors array Ref(GifRgb)
}
record OptionalColorTable {
  present u8
  value Ref(GifColorTable) if present eq 1
}
