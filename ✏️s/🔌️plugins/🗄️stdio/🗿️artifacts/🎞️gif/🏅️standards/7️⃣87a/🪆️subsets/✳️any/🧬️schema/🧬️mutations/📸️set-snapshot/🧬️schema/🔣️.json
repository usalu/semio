{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gif/87a/any/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "snapshot"
  ],
  "properties": {
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    },
    "snapshot": {
      "$ref": "#/$defs/GifSnapshot",
      "x-semio-ui": {
        "label": {
          "en": "GIF image",
          "de": "GIF-Bild"
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "GifSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "width",
        "height"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Schema",
              "de": "Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema this document follows.",
              "de": "Kennung des Snapshot-Schemas, dem dieses Dokument folgt."
            }
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Logical screen width",
              "de": "Breite des logischen Bildschirms"
            },
            "unit": "px"
          }
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Logical screen height",
              "de": "Höhe des logischen Bildschirms"
            },
            "unit": "px"
          }
        },
        "gct": {
          "anyOf": [
            {
              "$ref": "#/$defs/GifColorTable"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Global color table",
              "de": "Globale Farbtabelle"
            },
            "description": {
              "en": "Empty removes the global color table.",
              "de": "Leer entfernt die globale Farbtabelle."
            }
          }
        },
        "backgroundColorIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Background color index",
              "de": "Hintergrundfarbindex"
            },
            "description": {
              "en": "Index of the palette color, 0 to 255.",
              "de": "Index der Palettenfarbe, 0 bis 255."
            }
          }
        },
        "pixelAspectRatio": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Pixel aspect ratio",
              "de": "Pixel-Seitenverhältnis"
            },
            "description": {
              "en": "Stored byte: aspect = (value + 15) / 64; 0 means no information.",
              "de": "Gespeichertes Byte: Seitenverhältnis = (Wert + 15) / 64; 0 bedeutet keine Angabe."
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GifImage"
          },
          "x-semio-ui": {
            "label": {
              "en": "Images",
              "de": "Bilder"
            }
          }
        }
      }
    },
    "GifColorTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sorted": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Sorted by importance",
              "de": "Nach Wichtigkeit sortiert"
            }
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GifRgb"
          },
          "x-semio-ui": {
            "label": {
              "en": "Colors",
              "de": "Farben"
            }
          }
        }
      }
    },
    "GifRgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        }
      }
    },
    "GifImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "width",
        "height"
      ],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Left offset",
              "de": "Abstand links"
            },
            "unit": "px"
          }
        },
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Top offset",
              "de": "Abstand oben"
            },
            "unit": "px"
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Width",
              "de": "Breite"
            },
            "unit": "px"
          }
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Height",
              "de": "Höhe"
            },
            "unit": "px"
          }
        },
        "interlace": {
          "type": "boolean"
        },
        "lct": {
          "anyOf": [
            {
              "$ref": "#/$defs/GifColorTable"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Local color table",
              "de": "Lokale Farbtabelle"
            }
          }
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Pixel color indices",
              "de": "Pixel-Farbindizes"
            },
            "description": {
              "en": "One palette index per pixel, row by row.",
              "de": "Ein Palettenindex je Pixel, zeilenweise."
            }
          }
        }
      }
    }
  }
}
