{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/gif/87a/any/mutation/insert-image.json",
  "title": "InsertImage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "image"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "$ref": "#/$defs/GifImage"
    },
    "mutation": {
      "const": "insertImage",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "GifImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "width",
        "height"
      ],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "interlace": {
          "type": "boolean"
        },
        "lct": {
          "anyOf": [
            {
              "$ref": "#/$defs/GifColorTable"
            },
            {
              "type": "null"
            }
          ]
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "GifColorTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sorted": {
          "type": "boolean"
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GifRgb"
          }
        }
      }
    },
    "GifRgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
