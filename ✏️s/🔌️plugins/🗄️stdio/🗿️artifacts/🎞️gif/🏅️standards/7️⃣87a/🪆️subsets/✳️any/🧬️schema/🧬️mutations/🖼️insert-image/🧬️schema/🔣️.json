{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gif/87a/any/mutation/insert-image/schema.json",
  "title": "InsertImage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "image"
  ],
  "properties": {
    "mutation": {
      "const": "insertImage",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "image": {
      "$ref": "#/$defs/GifImage",
      "x-semio-ui": {
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "GifImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "width",
        "height"
      ],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Left offset",
              "de": "Abstand links"
            },
            "unit": "px"
          }
        },
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Top offset",
              "de": "Abstand oben"
            },
            "unit": "px"
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Width",
              "de": "Breite"
            },
            "unit": "px"
          }
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Height",
              "de": "Höhe"
            },
            "unit": "px"
          }
        },
        "interlace": {
          "type": "boolean"
        },
        "lct": {
          "anyOf": [
            {
              "$ref": "#/$defs/GifColorTable"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Local color table",
              "de": "Lokale Farbtabelle"
            }
          }
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Pixel color indices",
              "de": "Pixel-Farbindizes"
            },
            "description": {
              "en": "One palette index per pixel, row by row.",
              "de": "Ein Palettenindex je Pixel, zeilenweise."
            }
          }
        }
      }
    },
    "GifColorTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sorted": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Sorted by importance",
              "de": "Nach Wichtigkeit sortiert"
            }
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GifRgb"
          },
          "x-semio-ui": {
            "label": {
              "en": "Colors",
              "de": "Farben"
            }
          }
        }
      }
    },
    "GifRgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        }
      }
    }
  }
}
