{
  "$id": "https://semio.tech/schema/s/stdio/gif/inference.json",
  "title": "GifInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["dimensions"],
  "properties": {
    "dimensions": { "$ref": "#/$defs/GifDimensions", "x-semio-derived": true }
  },
  "$defs": {
    "GifDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "bitDepth", "hasAlpha", "pixelCount"],
      "properties": {
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "bitDepth": { "type": "integer", "minimum": 0 },
        "hasAlpha": { "type": "boolean" },
        "pixelCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
