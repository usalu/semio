{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gif/89a/base/mutation/set-loop-count/schema.json",
  "title": "SetLoopCount",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setLoopCount",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    },
    "loopCount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Loop count",
          "de": "Anzahl Wiederholungen"
        },
        "description": {
          "en": "NETSCAPE2.0 loop count; 0 loops forever, empty removes the loop extension.",
          "de": "NETSCAPE2.0-Wiederholungen; 0 wiederholt endlos, leer entfernt die Schleifenerweiterung."
        },
        "precision": 0,
        "group": "value",
        "order": 10
      }
    }
  }
}
