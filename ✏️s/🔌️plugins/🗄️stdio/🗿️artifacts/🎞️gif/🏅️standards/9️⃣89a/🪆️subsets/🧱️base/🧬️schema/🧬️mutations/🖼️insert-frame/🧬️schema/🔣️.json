{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gif/89a/base/mutation/insert-frame/schema.json",
  "title": "InsertFrame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "frame"
  ],
  "properties": {
    "mutation": {
      "const": "insertFrame",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "frame": {
      "$ref": "#/$defs/GifFrame",
      "x-semio-ui": {
        "label": {
          "en": "Frame",
          "de": "Einzelbild"
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "GifFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "width",
        "height"
      ],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Left offset",
              "de": "Abstand links"
            },
            "unit": "px"
          }
        },
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Top offset",
              "de": "Abstand oben"
            },
            "unit": "px"
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Width",
              "de": "Breite"
            },
            "unit": "px"
          }
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Height",
              "de": "Höhe"
            },
            "unit": "px"
          }
        },
        "interlace": {
          "type": "boolean"
        },
        "lct": {
          "anyOf": [
            {
              "$ref": "#/$defs/GifColorTable"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Local color table",
              "de": "Lokale Farbtabelle"
            }
          }
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Pixel color indices",
              "de": "Pixel-Farbindizes"
            },
            "description": {
              "en": "One palette index per pixel, row by row.",
              "de": "Ein Palettenindex je Pixel, zeilenweise."
            }
          }
        },
        "delayCs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "label": {
              "en": "Frame delay",
              "de": "Bildverzögerung"
            },
            "unit": "cs",
            "displayUnit": "s",
            "displayFactor": 0.01,
            "precision": 2
          }
        },
        "disposal": {
          "$ref": "#/$defs/GifDisposal",
          "x-semio-ui": {
            "label": {
              "en": "Disposal method",
              "de": "Entfernungsmethode"
            },
            "description": {
              "en": "What happens to the frame before the next one is drawn.",
              "de": "Was mit dem Einzelbild geschieht, bevor das nächste gezeichnet wird."
            }
          }
        },
        "transparentIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Transparent color index",
              "de": "Transparenzfarbindex"
            }
          }
        },
        "userInput": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Wait for user input",
              "de": "Auf Benutzereingabe warten"
            }
          }
        },
        "plainText": {
          "anyOf": [
            {
              "$ref": "#/$defs/GifPlainText"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Plain text extension",
              "de": "Klartexterweiterung"
            }
          }
        }
      }
    },
    "GifColorTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sorted": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Sorted by importance",
              "de": "Nach Wichtigkeit sortiert"
            }
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GifRgb"
          },
          "x-semio-ui": {
            "label": {
              "en": "Colors",
              "de": "Farben"
            }
          }
        }
      }
    },
    "GifRgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        }
      }
    },
    "GifDisposal": {
      "type": "string",
      "enum": [
        "unspecified",
        "doNotDispose",
        "restoreToBackground",
        "restoreToPrevious"
      ],
      "x-semio-ui": {
        "options": {
          "unspecified": {
            "en": "Not specified",
            "de": "Nicht festgelegt"
          },
          "doNotDispose": {
            "en": "Do not dispose",
            "de": "Nicht entfernen"
          },
          "restoreToBackground": {
            "en": "Restore to background",
            "de": "Auf Hintergrund zurücksetzen"
          },
          "restoreToPrevious": {
            "en": "Restore to previous",
            "de": "Auf vorheriges Bild zurücksetzen"
          }
        }
      }
    },
    "GifPlainText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "width",
        "height",
        "cellWidth",
        "cellHeight",
        "fgColorIndex",
        "bgColorIndex"
      ],
      "properties": {
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Left offset",
              "de": "Abstand links"
            },
            "unit": "px"
          }
        },
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Top offset",
              "de": "Abstand oben"
            },
            "unit": "px"
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Width",
              "de": "Breite"
            },
            "unit": "px"
          }
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Height",
              "de": "Höhe"
            },
            "unit": "px"
          }
        },
        "cellWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Character cell width",
              "de": "Zeichenzellenbreite"
            },
            "unit": "px"
          }
        },
        "cellHeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Character cell height",
              "de": "Zeichenzellenhöhe"
            },
            "unit": "px"
          }
        },
        "fgColorIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Text color index",
              "de": "Textfarbindex"
            }
          }
        },
        "bgColorIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Background color index",
              "de": "Hintergrundfarbindex"
            }
          }
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
