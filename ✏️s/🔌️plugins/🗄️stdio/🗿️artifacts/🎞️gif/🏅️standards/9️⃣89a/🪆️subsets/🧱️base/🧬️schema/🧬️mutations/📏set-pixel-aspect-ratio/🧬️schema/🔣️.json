{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gif/89a/base/mutation/set-pixel-aspect-ratio/schema.json",
  "title": "SetPixelAspectRatio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "ratio"
  ],
  "properties": {
    "mutation": {
      "const": "setPixelAspectRatio",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    },
    "ratio": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Pixel aspect ratio",
          "de": "Pixel-Seitenverhältnis"
        },
        "description": {
          "en": "Stored byte: aspect = (value + 15) / 64; 0 means no information.",
          "de": "Gespeichertes Byte: Seitenverhältnis = (Wert + 15) / 64; 0 bedeutet keine Angabe."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 10
      }
    }
  }
}
