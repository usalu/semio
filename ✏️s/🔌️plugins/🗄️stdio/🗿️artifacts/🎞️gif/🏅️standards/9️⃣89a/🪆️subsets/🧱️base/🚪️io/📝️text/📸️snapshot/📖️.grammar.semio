dialect grammar
grammar stdio.gif.89a.snapshot
extension gif
start document
comment none

document = "stdio.gif.89a" snapshot
snapshot = "schema" "=" text "width" "=" uint "height" "=" uint "background-color-index" "=" uint "pixel-aspect-ratio" "=" uint loop-count? global-palette? "frames" "=" "[" frame* "]" "comments" "=" "[" text* "]" "app-extensions" "=" "[" application* "]"
loop-count = "loop-count" "=" uint
global-palette = "gct" "{" palette "}"
local-palette = "lct" "{" palette "}"
palette = "sorted" "=" bool "colors" "=" "[" color* "]"
color = "{" "r" "=" uint "g" "=" uint "b" "=" uint "}"
frame = "{" "left" "=" uint "top" "=" uint "width" "=" uint "height" "=" uint "interlace" "=" bool "indices" "=" text "delay-cs" "=" uint "disposal" "=" disposal transparent-index? "user-input" "=" bool local-palette? plain-text? "}"
transparent-index = "transparent-index" "=" uint
disposal = "unspecified" / "do-not-dispose" / "restore-to-background" / "restore-to-previous"
plain-text = "plain-text" "{" "left" "=" uint "top" "=" uint "width" "=" uint "height" "=" uint "cell-width" "=" uint "cell-height" "=" uint "fg-color-index" "=" uint "bg-color-index" "=" uint "text" "=" text "}"
application = "{" "identifier" "=" byte8-list "auth-code" "=" byte3-list "data" "=" text "}"
byte8-list = uint "," uint "," uint "," uint "," uint "," uint "," uint "," uint
byte3-list = uint "," uint "," uint
uint = INT
text = STRING / IDENT / INT / FLOAT
bool = "true" / "false"
