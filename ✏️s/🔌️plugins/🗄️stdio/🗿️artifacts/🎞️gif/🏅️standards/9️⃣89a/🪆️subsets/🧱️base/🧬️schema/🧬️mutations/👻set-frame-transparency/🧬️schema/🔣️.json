{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gif/89a/base/mutation/set-frame-transparency/schema.json",
  "title": "SetFrameTransparency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "setFrameTransparency",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Frame",
          "de": "Einzelbild"
        },
        "description": {
          "en": "Index of the frame, counted from 0.",
          "de": "Index des Einzelbildes, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "transparentIndex": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Transparent color index",
          "de": "Transparenzfarbindex"
        },
        "description": {
          "en": "Palette index drawn transparent; empty disables transparency.",
          "de": "Palettenindex, der transparent gezeichnet wird; leer schaltet Transparenz ab."
        },
        "precision": 0,
        "group": "value",
        "order": 20
      }
    }
  }
}
