        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "text": {
      "type": "string",
      "x-semio-ui": {
        "widget": "multiline",
        "label": {
          "en": "Comment text",
          "de": "Kommentartext"
        },
        "group": "value",
        "order": 20
      }
    }
