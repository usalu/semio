{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/gif/89a/base/mutation/set-global-color-table.json",
  "title": "SetGlobalColorTable",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "gct": {
      "anyOf": [
        {
          "$ref": "#/$defs/GifColorTable"
        },
        {
          "type": "null"
        }
      ]
    },
    "mutation": {
      "const": "setGlobalColorTable",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "GifColorTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sorted": {
          "type": "boolean"
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GifRgb"
          }
        }
      }
    },
    "GifRgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
