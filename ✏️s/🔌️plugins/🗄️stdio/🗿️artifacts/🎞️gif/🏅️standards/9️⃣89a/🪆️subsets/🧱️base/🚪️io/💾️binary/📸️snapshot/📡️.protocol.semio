dialect protocol
protocol stdio.gif.89a.snapshot
version 1
schema stdio.gif.89a
start snapshot
framing record
use semio.pack

record snapshot {
  schema utf8
  width u32
  height u32
  gct Ref(OptionalColorTable)
  background-color-index u8
  pixel-aspect-ratio u8
  loop-count Ref(OptionalShort)
  frames array Ref(GifFrame)
  comments array utf8
  app-extensions array Ref(GifAppExtension)
}
record GifFrame {
  left u32
  top u32
  width u32
  height u32
  interlace u8
  lct Ref(OptionalColorTable)
  indices array u8
  delay-cs u16
  disposal Ref(GifDisposal)
  transparent-index Ref(OptionalOctet)
  user-input u8
  plain-text Ref(OptionalPlainText)
}
enum GifDisposal {
  unspecified=0
  do-not-dispose=1
  restore-to-background=2
  restore-to-previous=3
}
record GifPlainText {
  left u32
  top u32
  width u32
  height u32
  cell-width u8
  cell-height u8
  fg-color-index u8
  bg-color-index u8
  text utf8
}
record GifAppExtension {
  identifier array u8
  auth-code array u8
  data array u8
}
record OptionalShort {
  present u8
  value u16 if present eq 1
}
record OptionalOctet {
  present u8
  value u8 if present eq 1
}
record OptionalPlainText {
  present u8
  value Ref(GifPlainText) if present eq 1
}
record GifRgb {
  r u8
  g u8
  b u8
}
record GifColorTable {
  sorted u8
  colors array Ref(GifRgb)
}
record OptionalColorTable {
  present u8
  value Ref(GifColorTable) if present eq 1
}
