dialect grammar
grammar stdio.gif.89a.snapshot
extension gif
start document

# GIF89a has no textual syntax of its own — `store::ArtifactDsl::print_dsl`/`parse_dsl`
# (../../🦀️.rs, the `HandcraftedArtifactCodecs` region) hex-encode/decode the REAL
# binary GIF89a file bytes (magic + logical screen descriptor + optional GCT + repeated
# extension/image block sequence) verbatim, byte-for-byte — this is png's own honest
# precedent (P2-W0 §1b: "hex-dump grammar per png's own precedent") and 87a's own sibling
# grammar, applied here for the identical reason: GIF's own real byte layout is what
# ../💾️binary/📡️.protocol.semio models structurally; this grammar honestly models
# the DSL TEXT form (a hex digit run), never the binary bytes themselves.
comment none

# `dsl::fixture_sweep`'s `dsl_body_from_fixture` feeds the Recognizer
# "<envelope-id>\n<body>" (`SemioEnvelope::envelope_id` = "stdio.gif.89a", the real preamble
# line's own trailing "v<n>" already stripped by the harness) — the shared lexer treats the
# preamble's newline as trivia, so `envelope-mark` and the hex body sit directly adjacent in
# the significant token stream, matching png/87a/json/csv's own grammars' identical convention.
envelope-mark = "stdio.gif.89a"
document = envelope-mark hex-body

# The rest of the DSL text is one lowercase-hex digit run — the real GIF89a file's bytes
# (`GIF89a` magic + screen descriptor + optional GCT + extension/image block sequence),
# hex-encoded losslessly (`encode_gif`/`decode_gif`, ../../⚙️engine/🦀️.rs). `hex`
# (bare `hex`, deliberately NOT defined as a production) is the framework's built-in `hex`
# MACRO (`📖️grammar/🦀️.rs`'s `default_macros`/`macro_hex_ok`) — a hand-rolled
# `{INT | IDENT}*`-shaped production would silently mis-lex a `<digits>e<digits>` byte run as
# one FLOAT token instead of alternating INT/IDENT; the macro's own largest-span-first
# backtracking (`Recognizer::match_macro_span`) handles it correctly with no grammar-file
# workaround needed (P2-P1 fix report item 2; the same convention every stdio pilot's own hex
# payload uses).
hex-body = hex
