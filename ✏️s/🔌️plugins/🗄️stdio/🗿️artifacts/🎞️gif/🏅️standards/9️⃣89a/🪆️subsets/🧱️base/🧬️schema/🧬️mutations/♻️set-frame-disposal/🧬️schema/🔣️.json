{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/gif/89a/base/mutation/set-frame-disposal/schema.json",
  "title": "SetFrameDisposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "disposal"
  ],
  "properties": {
    "mutation": {
      "const": "setFrameDisposal",
      "description": "Aggregate discriminator spliced in by GifMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Frame",
          "de": "Einzelbild"
        },
        "description": {
          "en": "Index of the frame, counted from 0.",
          "de": "Index des Einzelbildes, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "disposal": {
      "$ref": "#/$defs/GifDisposal",
      "x-semio-ui": {
        "widget": "select",
        "label": {
          "en": "Disposal method",
          "de": "Entfernungsmethode"
        },
        "description": {
          "en": "What happens to the frame before the next one is drawn.",
          "de": "Was mit dem Einzelbild geschieht, bevor das nächste gezeichnet wird."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "GifDisposal": {
      "type": "string",
      "enum": [
        "unspecified",
        "doNotDispose",
        "restoreToBackground",
        "restoreToPrevious"
      ],
      "x-semio-ui": {
        "options": {
          "unspecified": {
            "en": "Not specified",
            "de": "Nicht festgelegt"
          },
          "doNotDispose": {
            "en": "Do not dispose",
            "de": "Nicht entfernen"
          },
          "restoreToBackground": {
            "en": "Restore to background",
            "de": "Auf Hintergrund zurücksetzen"
          },
          "restoreToPrevious": {
            "en": "Restore to previous",
            "de": "Auf vorheriges Bild zurücksetzen"
          }
        }
      }
    }
  }
}
