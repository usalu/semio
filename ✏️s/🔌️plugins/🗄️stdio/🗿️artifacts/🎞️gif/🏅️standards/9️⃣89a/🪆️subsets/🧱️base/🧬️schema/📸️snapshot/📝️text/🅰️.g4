grammar Stdio_gif89a_snapshot;
document: 'semio' 'stdio.gif.89a.dsl' 'v1' snapshot EOF;
snapshot: 'schema' '=' text 'width' '=' UINT 'height' '=' UINT 'background-color-index' '=' UINT 'pixel-aspect-ratio' '=' UINT ('loop-count' '=' UINT)? globalPalette? 'frames' '=' '[' frame* ']' 'comments' '=' '[' text* ']' 'app-extensions' '=' '[' application* ']';
globalPalette: 'gct' '{' palette '}';
localPalette: 'lct' '{' palette '}';
palette: 'sorted' '=' boolean 'colors' '=' '[' color* ']';
color: '{' 'r' '=' UINT 'g' '=' UINT 'b' '=' UINT '}';
frame: '{' 'left' '=' UINT 'top' '=' UINT 'width' '=' UINT 'height' '=' UINT 'interlace' '=' boolean 'indices' '=' text 'delay-cs' '=' UINT 'disposal' '=' disposal ('transparent-index' '=' UINT)? 'user-input' '=' boolean localPalette? plainText? '}';
plainText: 'plain-text' '{' 'left' '=' UINT 'top' '=' UINT 'width' '=' UINT 'height' '=' UINT 'cell-width' '=' UINT 'cell-height' '=' UINT 'fg-color-index' '=' UINT 'bg-color-index' '=' UINT 'text' '=' text '}';
application: '{' 'identifier' '=' UINT ',' UINT ',' UINT ',' UINT ',' UINT ',' UINT ',' UINT ',' UINT 'auth-code' '=' UINT ',' UINT ',' UINT 'data' '=' text '}';
disposal: 'unspecified' | 'do-not-dispose' | 'restore-to-background' | 'restore-to-previous';
boolean: 'true' | 'false';
text: STRING | IDENT | UINT;
UINT: [0-9]+;
STRING: '"' ('\\' . | ~["\\])* '"';
IDENT: [a-zA-Z_] [a-zA-Z_0-9.-]*;
WS: [ \t\r\n]+ -> skip;
