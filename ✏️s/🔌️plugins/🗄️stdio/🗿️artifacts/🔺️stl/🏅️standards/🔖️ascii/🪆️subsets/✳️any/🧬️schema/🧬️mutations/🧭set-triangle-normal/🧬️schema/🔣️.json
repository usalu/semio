{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/stl/ascii/any/mutation/set-triangle-normal/schema.json",
  "title": "SetTriangleNormal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "normal"
  ],
  "properties": {
    "mutation": {
      "const": "setTriangleNormal",
      "description": "Aggregate discriminator spliced in by StlMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Triangle",
          "de": "Dreieck"
        },
        "description": {
          "en": "Index of the triangle (facet), counted from 0.",
          "de": "Index des Dreiecks (Facette), ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "normal": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "widget": "vector",
        "role": "value",
        "label": {
          "en": "Normal",
          "de": "Normale"
        },
        "description": {
          "en": "Facet normal as x, y, z; a unit vector that points out of the solid.",
          "de": "Facettennormale als x, y, z; ein Einheitsvektor, der aus dem Körper heraus zeigt."
        },
        "step": 0.01,
        "precision": 6,
        "group": "value",
        "order": 20
      }
    }
  }
}
