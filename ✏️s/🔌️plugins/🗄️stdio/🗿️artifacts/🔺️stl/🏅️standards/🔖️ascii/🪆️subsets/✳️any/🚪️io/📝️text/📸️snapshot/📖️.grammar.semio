dialect grammar
grammar stdio.stl.snapshot
extension stl
start document
comment none

document = "stdio.stl" field*
field = IDENT field-value?
field-value = "=" value
value = scalar value-tail? | list | record
scalar = field | TEXT | INT | FLOAT
value-tail = "," value
list = "[" value* "]"
record = "{" field* "}"
