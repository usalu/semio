dialect protocol
protocol stdio.stl.mutations
version 1
schema stdio.stl
start record
framing record

# Real `StlMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record set-snapshot tag=1
field payload bytes
record set-solid-name tag=2
field payload bytes
record insert-triangle tag=3
field payload bytes
record remove-triangle tag=4
field payload bytes
record set-triangle-normal tag=5
field payload bytes
record set-triangle-vertices tag=6
field payload bytes
