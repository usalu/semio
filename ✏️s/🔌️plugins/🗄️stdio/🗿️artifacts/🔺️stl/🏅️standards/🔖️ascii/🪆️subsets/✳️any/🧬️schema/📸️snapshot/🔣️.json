      "x-semio-state": "artifact"
    },
    "triangles": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/stl/ascii/any/artifact.json#/$defs/StlTriangle"
      },
      "x-semio-state": "artifact"
    }
  }
}
