{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/stl/ascii/any/mutation/insert-triangle/schema.json",
  "title": "InsertTriangle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "triangle"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "triangle": {
      "$ref": "#/$defs/StlTriangle"
    },
    "mutation": {
      "const": "insertTriangle",
      "description": "Aggregate discriminator spliced in by StlMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "StlTriangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal",
        "vertices"
      ],
      "properties": {
        "normal": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "vertices": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  }
}
