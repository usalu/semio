{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/stl/ascii/any/mutation/insert-triangle/schema.json",
  "title": "InsertTriangle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "triangle"
  ],
  "properties": {
    "mutation": {
      "const": "insertTriangle",
      "description": "Aggregate discriminator spliced in by StlMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "triangle": {
      "$ref": "#/$defs/StlTriangle",
      "x-semio-ui": {
        "label": {
          "en": "Triangle",
          "de": "Dreieck"
        }
      }
    }
  },
  "$defs": {
    "StlTriangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal",
        "vertices"
      ],
      "properties": {
        "normal": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "vertices": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "label": {
              "en": "Vertices",
              "de": "Eckpunkte"
            },
            "description": {
              "en": "The three corner points in counter-clockwise order seen from outside.",
              "de": "Die drei Eckpunkte gegen den Uhrzeigersinn, von außen gesehen."
            }
          }
        }
      }
    }
  }
}
