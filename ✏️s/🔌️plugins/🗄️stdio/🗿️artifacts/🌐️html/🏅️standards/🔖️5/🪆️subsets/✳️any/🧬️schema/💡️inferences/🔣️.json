{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/html/5/any/inference.json",
  "title": "HtmlInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outline"
  ],
  "properties": {
    "outline": {
      "$ref": "#/$defs/HtmlOutline",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "HtmlOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementCount",
        "maxDepth",
        "textLength"
      ],
      "properties": {
        "elementCount": {
          "type": "integer"
        },
        "maxDepth": {
          "type": "integer"
        },
        "textLength": {
          "type": "integer"
        }
      }
    }
  }
}
