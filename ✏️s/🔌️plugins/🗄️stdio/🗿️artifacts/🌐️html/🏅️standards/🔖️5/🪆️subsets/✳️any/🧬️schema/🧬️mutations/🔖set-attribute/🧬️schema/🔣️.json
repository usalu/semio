{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/html/5/any/mutation/set-attribute.json",
  "title": "SetAttribute",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "name"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "name": {
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "mutation": {
      "const": "setAttribute",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    }
  }
}
