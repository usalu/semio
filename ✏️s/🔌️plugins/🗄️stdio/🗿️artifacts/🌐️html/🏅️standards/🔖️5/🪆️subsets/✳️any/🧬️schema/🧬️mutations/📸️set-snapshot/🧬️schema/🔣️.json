{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/html/5/any/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "snapshot"
  ],
  "properties": {
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    },
    "snapshot": {
      "$ref": "#/$defs/HtmlSnapshot",
      "x-semio-ui": {
        "label": {
          "en": "HTML document",
          "de": "HTML-Dokument"
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "HtmlSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "root"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Schema",
              "de": "Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema this document follows.",
              "de": "Kennung des Snapshot-Schemas, dem dieses Dokument folgt."
            }
          }
        },
        "doctype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Document type",
              "de": "Dokumenttyp"
            },
            "description": {
              "en": "DOCTYPE declaration; empty removes it.",
              "de": "DOCTYPE-Deklaration; leer entfernt sie."
            }
          }
        },
        "root": {
          "$ref": "#/$defs/HtmlNode",
          "x-semio-ui": {
            "label": {
              "en": "Root node",
              "de": "Wurzelknoten"
            }
          }
        }
      }
    },
    "HtmlNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string"
            },
            "attributes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HtmlAttr"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HtmlNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "comment"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parentKind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "rawText"
            },
            "parentKind": {
              "$ref": "#/$defs/RawTextKind"
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "HtmlAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RawTextKind": {
      "type": "string",
      "enum": [
        "script",
        "style"
      ]
    }
  }
}
