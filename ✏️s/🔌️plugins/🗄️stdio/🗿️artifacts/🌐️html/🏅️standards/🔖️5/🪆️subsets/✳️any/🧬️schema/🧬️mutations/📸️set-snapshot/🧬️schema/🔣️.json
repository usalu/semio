{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/html/5/any/mutation/set-snapshot.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot"
  ],
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/HtmlSnapshot"
    },
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "HtmlSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "root"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "doctype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "root": {
          "$ref": "#/$defs/HtmlNode"
        }
      }
    },
    "HtmlNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string"
            },
            "attributes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HtmlAttr"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HtmlNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "comment"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parentKind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "rawText"
            },
            "parentKind": {
              "$ref": "#/$defs/RawTextKind"
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "HtmlAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RawTextKind": {
      "type": "string",
      "enum": [
        "script",
        "style"
      ]
    }
  }
}
