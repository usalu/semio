{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/html/5/any/net-mutation/schema.json",
  "title": "HtmlNetMutationAddress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "at"
  ],
  "properties": {
    "kind": {
      "enum": [
        "set-doctype",
        "insert-node",
        "remove-node",
        "set-element-name",
        "set-attribute",
        "set-text",
        "set-comment",
        "set-raw-text"
      ]
    },
    "at": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
