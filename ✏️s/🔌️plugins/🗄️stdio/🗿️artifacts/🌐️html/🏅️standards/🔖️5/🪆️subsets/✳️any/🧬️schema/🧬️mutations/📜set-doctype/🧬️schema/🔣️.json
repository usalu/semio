{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/html/5/any/mutation/set-doctype/schema.json",
  "title": "SetDoctype",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "doctype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "mutation": {
      "const": "setDoctype",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    }
  }
}
