{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/html/5/any/mutation/set-doctype/schema.json",
  "title": "SetDoctype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setDoctype",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    },
    "doctype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Document type",
          "de": "Dokumenttyp"
        },
        "description": {
          "en": "DOCTYPE declaration; empty removes it.",
          "de": "DOCTYPE-Deklaration; leer entfernt sie."
        },
        "group": "value",
        "order": 10
      }
    }
  }
}
