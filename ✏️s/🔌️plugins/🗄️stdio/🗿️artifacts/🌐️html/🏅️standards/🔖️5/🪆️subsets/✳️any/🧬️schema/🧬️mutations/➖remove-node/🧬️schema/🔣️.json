{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/html/5/any/mutation/remove-node/schema.json",
  "title": "RemoveNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "parent",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "removeNode",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    },
    "parent": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Parent path",
          "de": "Pfad des Elternknotens"
        },
        "description": {
          "en": "Child indices from the document root to the parent node.",
          "de": "Kindindizes vom Dokumentstamm bis zum Elternknoten."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Child position",
          "de": "Kindposition"
        },
        "description": {
          "en": "Position among the parent's children, counted from 0.",
          "de": "Position unter den Kindknoten des Elternknotens, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  }
}
