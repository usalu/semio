{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/html/5/any/mutation/remove-node.json",
  "title": "RemoveNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent",
    "index"
  ],
  "properties": {
    "parent": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "mutation": {
      "const": "removeNode",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    }
  }
}
