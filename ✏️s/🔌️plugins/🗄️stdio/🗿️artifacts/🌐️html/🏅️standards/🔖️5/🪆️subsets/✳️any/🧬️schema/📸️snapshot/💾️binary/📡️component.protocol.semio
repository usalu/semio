dialect protocol
protocol html.snapshot
version 1
schema stdio.html
start frame
framing magic 0x8953f83f7d340d0b
header fixed 32
field format_major u16
field format_minor u16
field flags u32
field domain_tag u32
field header_crc32 u32
; payload bytes are UTF-8 HTML5 text (canonical `write_html_document` form) -- same grammar as the
; sibling ../📝️text/📖️component.grammar.semio's `document` production, not an unstructured blob.
segment payload varint bytes
footer fixed 64
field artifact_mark utf8
field body_crc32 u32
