{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/html/5/any/mutation/set-raw-text.json",
  "title": "SetRawText",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "text"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "text": {
      "type": "string"
    },
    "mutation": {
      "const": "setRawText",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    }
  }
}
