{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/html/5/any/mutation/set-raw-text/schema.json",
  "title": "SetRawText",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "text"
  ],
  "properties": {
    "mutation": {
      "const": "setRawText",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Node path",
          "de": "Knotenpfad"
        },
        "description": {
          "en": "Child indices from the document root to the node.",
          "de": "Kindindizes vom Dokumentstamm bis zum Knoten."
        },
        "group": "target",
        "order": 10
      }
    },
    "text": {
      "type": "string",
      "x-semio-ui": {
        "widget": "multiline",
        "label": {
          "en": "Raw text",
          "de": "Rohtext"
        },
        "description": {
          "en": "Script or style content written without escaping.",
          "de": "Skript- oder Stilinhalt, der ohne Maskierung geschrieben wird."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
