{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/html/5/any/mutation/insert-node/schema.json",
  "title": "InsertNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "parent",
    "index",
    "node"
  ],
  "properties": {
    "mutation": {
      "const": "insertNode",
      "description": "Aggregate discriminator spliced in by HtmlMutation; absent when the payload stands alone."
    },
    "parent": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Parent path",
          "de": "Pfad des Elternknotens"
        },
        "description": {
          "en": "Child indices from the document root to the parent node.",
          "de": "Kindindizes vom Dokumentstamm bis zum Elternknoten."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Child position",
          "de": "Kindposition"
        },
        "description": {
          "en": "Position among the parent's children, counted from 0.",
          "de": "Position unter den Kindknoten des Elternknotens, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "node": {
      "$ref": "#/$defs/HtmlNode",
      "x-semio-ui": {
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The element, text or comment node to insert.",
          "de": "Der einzufügende Element-, Text- oder Kommentarknoten."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "HtmlNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string"
            },
            "attributes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HtmlAttr"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HtmlNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "comment"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parentKind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "rawText"
            },
            "parentKind": {
              "$ref": "#/$defs/RawTextKind"
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "HtmlAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RawTextKind": {
      "type": "string",
      "enum": [
        "script",
        "style"
      ]
    }
  }
}
