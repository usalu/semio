{
  "$id": "https://semio.tech/schema/s.stdio.dxf/artifact.json",
  "title": "DxfArtifact",
  "description": "Full artifact state — same persisted fields as DxfSnapshot (see snapshot.json for the shared $defs).",
  "type": "object",
  "properties": {
    "schema": { "type": "string", "x-semio-state": "persistent" },
    "headerVars": { "type": "array", "x-semio-state": "persistent" },
    "tables": { "type": "object", "x-semio-state": "persistent" },
    "otherTables": { "type": "array", "x-semio-state": "persistent" },
    "blocks": { "type": "array", "x-semio-state": "persistent" },
    "entities": { "type": "array", "x-semio-state": "persistent" }
  },
  "required": ["schema", "headerVars", "tables", "otherTables", "blocks", "entities"]
}
