dialect protocol stdio.dxf.snapshot
; shared `.semio` binary envelope (store::semio_format::wrap_binary)
magic = %x89.53.45.4D.0D.0A.1A.0A
token-len = U32LE
token = *OCTET                      ; UTF-8 "stdio.dxf.pack v1", token-len bytes
payload = *OCTET                    ; UTF-8 DXF R12 ASCII text (see ../📝️text/📖️component.grammar.semio)
