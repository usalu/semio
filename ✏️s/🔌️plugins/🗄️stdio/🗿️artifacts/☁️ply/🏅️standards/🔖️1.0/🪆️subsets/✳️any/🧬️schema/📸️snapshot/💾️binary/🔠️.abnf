; abnf stdio.ply snapshot (binary) — mirrors the sibling `📡️.protocol.semio`'s real
; header + header-driven body structure in plain RFC 5234 ABNF (octet-literal header keywords
; instead of the repo-native dialect's hex-literal style, for tooling that expects strict ABNF).

document = header body
header = "ply" LF format-line (comment-line / element-block)* "end_header" LF
format-line = "format" SP format-kind SP "1.0" LF
format-kind = "ascii" / "binary_little_endian" / "binary_big_endian"
comment-line = "comment" [ SP *(%x20-7E) ] LF
element-block = element-line *property-line
element-line = "element" SP name SP count LF
property-line = scalar-property-line / list-property-line
scalar-property-line = "property" SP scalar-kind SP name LF
list-property-line = "property" SP "list" SP scalar-kind SP scalar-kind SP name LF
scalar-kind = "char" / "uchar" / "short" / "ushort" / "int" / "uint" / "float" / "double"
name = 1*(ALPHA / DIGIT / "_")
count = 1*DIGIT

; 🧮 Header-driven binary body: element order/count and each row's cell widths come ENTIRELY
; from the header just parsed above — not a fixed layout. `w(k)` = the byte width table
; (char/uchar=1, short/ushort=2, int/uint/float=4, double=8), applied at the endianness the
; `format-kind` line selected.
body = *row
row = *cell
cell = w-octets / ( count-octets *w-octets )   ; scalar cell, or list cell (count + N values)
w-octets = 1OCTET / 2OCTET / 4OCTET / 8OCTET   ; whichever `w(k)` the current property declares
count-octets = 1OCTET / 2OCTET / 4OCTET / 8OCTET
