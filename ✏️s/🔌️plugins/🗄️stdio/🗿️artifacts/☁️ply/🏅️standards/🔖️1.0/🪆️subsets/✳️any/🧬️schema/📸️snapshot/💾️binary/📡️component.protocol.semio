dialect protocol stdio.ply.snapshot
; Real PLY binary-body protocol (`binary_little_endian` / `binary_big_endian`). The header
; (magic/format/comment/element/property declarations) is ALWAYS ASCII text — see the sibling
; `📝️text/📖️component.grammar.semio` for its full grammar — terminated by the literal line
; `end_header\n`; only the BODY that follows is binary. This file's `body` section is therefore
; genuinely schema-driven at the byte level: each element's row width and shape is exactly what
; the header just declared (arbitrary named elements, scalar or count-prefixed list properties,
; 8 possible per-cell widths) — a real self-describing binary layout, honestly captured below as
; a byte-cursor walk keyed by the header's own declarations rather than a fixed struct.

header = magic format-decl (comment-decl / element-decl)* end-marker
magic = %x70.6c.79 %x0a                      ; "ply\n"
format-decl = %x66.6f.72.6d.61.74 SP format-kind SP version %x0a
format-kind = %x61.73.63.69.69 / %x62.69.6e.61.72.79.5f.6c.69.74.74.6c.65.5f.65.6e.64.69.61.6e / %x62.69.6e.61.72.79.5f.62.69.67.5f.65.6e.64.69.61.6e
version = %x31.2e.30                          ; "1.0"
comment-decl = %x63.6f.6d.6d.65.6e.74 [ SP *CHAR ] %x0a
element-decl = element-line property-line*
element-line = %x65.6c.65.6d.65.6e.74 SP name SP count %x0a
property-line = scalar-property / list-property
scalar-property = %x70.72.6f.70.65.72.74.79 SP scalar-kind SP name %x0a
list-property = %x70.72.6f.70.65.72.74.79 SP %x6c.69.73.74 SP scalar-kind SP scalar-kind SP name %x0a
scalar-kind = char-kind / uchar-kind / short-kind / ushort-kind / int-kind / uint-kind / float-kind / double-kind
end-marker = %x65.6e.64.5f.68.65.61.64.65.72 %x0a  ; "end_header\n"

; 📦 One binary octet-width per scalar kind (endianness selected by `format-kind` above, applied
; uniformly to every multi-byte kind for the whole body — this is exactly the two `PlyFormat`
; binary variants' real width table, mirrored 1:1 from the Rust engine's `scalar_type_size`):
char-kind = 1OCTET      ; i8
uchar-kind = 1OCTET     ; u8
short-kind = 2OCTET     ; i16
ushort-kind = 2OCTET    ; u16
int-kind = 4OCTET       ; i32
uint-kind = 4OCTET      ; u32
float-kind = 4OCTET     ; f32
double-kind = 8OCTET    ; f64

; 🧮 Body: for each `element-decl` in header order, `count` repetitions of one row; a row is one
; cell per `property-line` in declared order — a plain `scalar-kind`-width read for a scalar
; property, or a `scalar-kind`-width count read (the list's own `count-kind`) followed by that
; many `scalar-kind`-width value reads (the list's `value-kind`) for a list property. This walk
; is genuinely header-driven (row width is NOT fixed across the file, only within one element),
; matching the Rust engine's `decode_body_binary` byte-for-byte.
body = *row
row = *cell
cell = scalar-cell / list-cell
scalar-cell = scalar-kind
list-cell = scalar-kind *scalar-kind          ; count-kind width, then N × value-kind width
