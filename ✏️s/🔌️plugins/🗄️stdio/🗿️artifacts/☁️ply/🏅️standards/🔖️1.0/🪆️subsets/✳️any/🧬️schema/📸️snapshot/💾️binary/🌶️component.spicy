module Stdio_ply_snapshot;

# Real PLY structure. The header is always ASCII text, one declaration per line, ending at the
# literal `end_header` line — read here as a sequence of newline-terminated lines up to that
# marker (Spicy's `&until` supports exactly this data-dependent stop condition). The body that
# follows is binary and header-driven (each element's row width/shape comes from the header
# lines just parsed, not a fixed layout) — real per-element/property decoding needs the parsed
# `header_lines` values to select scalar widths at runtime, which belongs in the Rust engine's
# `decode_body_binary` (mounted at `⚙️engine/🦀️component.rs`, walking the identical header
# grammar this unit's `header_lines` field captures); this unit stops at exposing the raw,
# already-header-delimited body bytes rather than re-deriving that walk in Spicy.
public type Document = unit {
    header_lines: bytes &until="end_header\n" &convert=$$.split("\n"[0]);
    body_bytes: bytes &eod;

    on %done {
        # `header_lines` alone tells a caller everything needed to re-walk the body: `format`
        # (ascii/binary_little_endian/binary_big_endian), every `element <name> <count>`, and
        # every `property [list] <type(s)> <name>` in declaration order.
    }
};
