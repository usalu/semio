{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "s.stdio.idml.package",
  "title": "InDesign Markup Language Package",
  "type": "object",
  "required": [
    "domVersion",
    "parts"
  ],
  "properties": {
    "domVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "parts": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 2
    }
  },
  "additionalProperties": false
}
