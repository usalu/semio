{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.stdio.idml.mutation.replace-part",
  "title": "Replace IDML Part",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "bytes"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
