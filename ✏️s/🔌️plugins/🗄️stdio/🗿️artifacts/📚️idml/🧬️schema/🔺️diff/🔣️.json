{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "s.stdio.idml.diff",
  "title": "IdmlDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps"
  ],
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domVersion": {
            "type": "string"
          },
          "partOrder": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        },
        "required": [
          "parts"
        ]
      }
    }
  }
}
