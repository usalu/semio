{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Borrowed IDML Sparse Change Events",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "version"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "order"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "remove"
        },
        "before": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "before"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "part"
        },
        "next": {
          "type": "integer",
          "minimum": 0
        },
        "before": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "next"
      ]
    }
  ],
  "description": "Read-only numeric event planning over two original admitted member indexes. No source field clones, mutable post, or diff publication capability. Version bytes, member names and payload comparisons advance under explicit work grants."
}
