{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/geometry/graph.json",
  "title": "IfcRepresentationGraph",
  "description": "Read-only source graph contract; projection readers borrow native values and do not rewrite an artifact into another standard.",
  "type": "object",
  "required": [
    "standard",
    "instances"
  ],
  "additionalProperties": false,
  "properties": {
    "standard": {
      "enum": [
        "IFC2X3",
        "IFC4"
      ]
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Instance"
      }
    }
  },
  "definitions": {
    "Instance": {
      "type": "object",
      "required": [
        "id",
        "types"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Constituent"
          }
        }
      }
    },
    "Constituent": {
      "type": "object",
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Value"
          }
        }
      }
    },
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "unset",
                "derived"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "reference",
                "integer"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "real"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "string",
                "enum",
                "binary"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Value"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "typed"
            },
            "name": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Value"
              }
            }
          }
        }
      ]
    }
  }
}
