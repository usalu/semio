{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "observer",
          "phase",
          "outcome"
        ],
        "properties": {
          "operation": {
            "enum": [
              "difference",
              "union",
              "intersection",
              "halfspace"
            ]
          },
          "observer": {
            "enum": [
              "tick",
              "progress"
            ]
          },
          "phase": {
            "enum": [
              "initial",
              "interior",
              "completion"
            ]
          },
          "outcome": {
            "enum": [
              "error",
              "undefined",
              "false"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "observer": {
                  "const": "tick"
                }
              }
            },
            "then": {
              "properties": {
                "outcome": {
                  "enum": [
                    "error",
                    "undefined"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
