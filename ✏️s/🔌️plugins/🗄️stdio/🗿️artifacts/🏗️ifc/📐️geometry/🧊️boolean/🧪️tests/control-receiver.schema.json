{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "mode",
          "observer",
          "maxWork",
          "expected",
          "calls",
          "receiver"
        ],
        "properties": {
          "operation": {
            "enum": [
              "difference",
              "union",
              "intersection",
              "halfspace"
            ]
          },
          "mode": {
            "enum": [
              "sync",
              "steps",
              "async"
            ]
          },
          "observer": {
            "enum": [
              "tick",
              "progress"
            ]
          },
          "maxWork": {
            "const": 1
          },
          "expected": {
            "const": "boolean-work-limit"
          },
          "calls": {
            "const": 2
          },
          "receiver": {
            "const": "undefined"
          }
        }
      }
    }
  }
}
