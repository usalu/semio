{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 90,
      "maxItems": 90,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "mode",
          "value",
          "expected"
        ],
        "properties": {
          "field": {
            "enum": [
              "maxWork",
              "maxPolygons",
              "maxDepth",
              "yieldEvery"
            ]
          },
          "mode": {
            "enum": [
              "sync",
              "steps",
              "async"
            ]
          },
          "value": {},
          "expected": {
            "enum": [
              "boolean-invalid-limits",
              "boolean-invalid-yield-policy"
            ]
          }
        }
      }
    }
  }
}
