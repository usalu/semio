{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/geometry/limits.json",
  "title": "IfcGeometryLimits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work",
    "vertices",
    "triangles",
    "depth"
  ],
  "properties": {
    "work": {
      "type": "integer",
      "minimum": 0
    },
    "vertices": {
      "type": "integer",
      "minimum": 0
    },
    "triangles": {
      "type": "integer",
      "minimum": 0
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    }
  },
  "default": {
    "work": 8000000,
    "vertices": 200000,
    "triangles": 400000,
    "depth": 64
  }
}
