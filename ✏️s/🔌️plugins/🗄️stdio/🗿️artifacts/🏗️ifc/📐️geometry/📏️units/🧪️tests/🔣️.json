    {
      "name": "overflow",
      "data": "#1=IFCPROJECT('0AAAAAAAAAAAAAAAAAAAAA',$,$,$,$,$,$,$,#2);#2=IFCUNITASSIGNMENT((#3));#3=IFCCONVERSIONBASEDUNIT(#4,.LENGTHUNIT.,'foot',#5);#4=IFCDIMENSIONALEXPONENTS(1,0,0,0,0,0,0);#5=IFCMEASUREWITHUNIT(IFCLENGTHMEASURE(1.E300),#6);#6=IFCCONVERSIONBASEDUNIT(#4,.LENGTHUNIT.,'inch',#7);#7=IFCMEASUREWITHUNIT(IFCLENGTHMEASURE(1.E300),#8);#8=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);",
      "expected": {
        "status": "invalid",
        "reason": "unrepresentable-length-scale"
