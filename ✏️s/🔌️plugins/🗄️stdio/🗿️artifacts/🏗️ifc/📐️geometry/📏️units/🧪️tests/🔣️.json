    {
      "name": "duplicate nonlength assignment",
      "data": "#1=IFCPROJECT('0AAAAAAAAAAAAAAAAAAAAA',$,$,$,$,$,$,$,#2);#2=IFCUNITASSIGNMENT((#3,#7,#7));#3=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);#7=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);",
      "expected": {
