    {
      "name": "missing project",
      "data": "#3=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);",
      "expected": {
        "status": "invalid",
        "reason": "missing-project"
      }
    },
    {
      "name": "missing assignment",
      "data": "#1=IFCPROJECT('0AAAAAAAAAAAAAAAAAAAAA',$,$,$,$,$,$,$,$);#2=IFCUNITASSIGNMENT((#3));#3=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);",
      "expected": {
