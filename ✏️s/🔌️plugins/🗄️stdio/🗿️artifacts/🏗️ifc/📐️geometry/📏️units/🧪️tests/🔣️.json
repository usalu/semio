        "reason": "missing-unit-assignment"
      }
    },
    {
      "name": "wrong assignment",
      "data": "#1=IFCPROJECT('0AAAAAAAAAAAAAAAAAAAAA',$,$,$,$,$,$,$,#2);#2=IFCCARTESIANPOINT((0.,0.));#3=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);",
      "expected": {
        "status": "invalid",
        "reason": "invalid-unit-assignment"
      }
    },
    {
      "name": "no length unit",
      "data": "#1=IFCPROJECT('0AAAAAAAAAAAAAAAAAAAAA',$,$,$,$,$,$,$,#2);#2=IFCUNITASSIGNMENT((#3));#3=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);",
