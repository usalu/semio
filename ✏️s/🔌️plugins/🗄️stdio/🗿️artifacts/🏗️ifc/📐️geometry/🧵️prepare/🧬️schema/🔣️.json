{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/geometry/preparation.json",
  "title": "RetainedIfcGeometryPreparation",
  "description": "Captured-source retained geometry preparation with explicit single-product or whole-model scope; every original grant advances an exact stored source/product/mesh frontier. Retained coverage is extended family by family before mounted integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "limits",
    "scope"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "instance",
        "operation",
        "generation",
        "revision",
        "source"
      ],
      "properties": {
        "standard": {
          "enum": [
            "IFC4",
            "IFC2X3"
          ]
        },
        "instance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "operation": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$",
          "maxLength": 20
        },
        "generation": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$",
          "maxLength": 20
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "sourceBytes",
        "scratchBytes",
        "resultBytes",
        "vertices",
        "triangles",
        "depth"
      ],
      "properties": {
        "work": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scratchBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "resultBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "vertices": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "triangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "product"
            },
            "target": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$",
              "maxLength": 20,
              "description": "One original product selected for the first concrete retained primitive cursor; whole-model orchestration remains separate."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "model"
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "Phase": {
      "enum": [
        "admitting",
        "indexing",
        "projecting",
        "ready",
        "cancelling",
        "closing",
        "closed",
        "refused",
        "relationships",
        "selecting",
        "publishing",
        "retiring"
      ]
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "items",
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "properties": {
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "copyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "work",
        "sourceBytes",
        "scratchBytes",
        "resultBytes",
        "published"
      ],
      "properties": {
        "phase": {
          "$ref": "#/definitions/Phase"
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scratchBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resultBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "published": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "indexedEntities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "productsCompleted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "productsSkipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$comment": "Original-caller work and physical receipts persist across turns. The embedding owner retains the immutable source lease through granted close. Ready publishes only the declared primitive result through checked borrowed reads; it does not claim full-model projection, JSON payload completion or mounted rendering. Cancelled and refused partial resources remain owned until funded close."
}
