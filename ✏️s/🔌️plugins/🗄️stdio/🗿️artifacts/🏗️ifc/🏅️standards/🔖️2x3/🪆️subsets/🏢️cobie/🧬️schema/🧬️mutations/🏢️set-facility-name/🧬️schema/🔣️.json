{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/cobie/mutation/set-facility-name/schema.json",
  "title": "SetFacilityName",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "building"
  ],
  "properties": {
    "building": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Building",
          "de": "Gebäude"
        },
        "description": {
          "en": "STEP instance id of the IfcBuilding.",
          "de": "STEP-Instanz-ID des IfcBuilding."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Facility name",
          "de": "Name der Liegenschaft"
        },
        "description": {
          "en": "COBie Facility name; empty clears it.",
          "de": "COBie-Name der Liegenschaft; leer löscht ihn."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
