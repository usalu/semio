{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/sav/mutation/set-analysis-model/schema.json",
  "title": "SetAnalysisModel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Analysis model",
          "de": "Berechnungsmodell"
        },
        "description": {
          "en": "STEP instance id of the IfcStructuralAnalysisModel.",
          "de": "STEP-Instanz-ID des IfcStructuralAnalysisModel."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/SavAnalysisModel"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Analysis model",
          "de": "Berechnungsmodell"
        },
        "description": {
          "en": "Empty removes the model.",
          "de": "Leer entfernt das Modell."
        },
        "group": "value",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position a new instance takes among the instances; the last position when absent.",
          "de": "Position, die eine neue Instanz unter den Instanzen einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    },
    "instance": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/base/artifact.json#/$defs/Part21Instance",
      "x-semio-ui": {
        "label": {
          "en": "Exact instance",
          "de": "Exakte Instanz"
        },
        "description": {
          "en": "The instance written verbatim instead of one rebuilt from the row; carried when the row cannot express every attribute.",
          "de": "Die Instanz, die unverändert geschrieben wird statt einer aus der Zeile aufgebauten; wird mitgeführt, wenn die Zeile nicht jedes Attribut ausdrücken kann."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "SavAnalysisModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalId",
        "name"
      ],
      "properties": {
        "globalId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "GlobalId",
              "de": "GlobalId"
            },
            "description": {
              "en": "22-character IFC GUID of the object.",
              "de": "22-stellige IFC-GUID des Objekts."
            }
          }
        },
        "ownerHistory": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Owner history",
              "de": "Eigentümerhistorie"
            },
            "description": {
              "en": "STEP instance id of the IfcOwnerHistory.",
              "de": "STEP-Instanz-ID der IfcOwnerHistory."
            }
          }
        },
        "name": {
          "type": "string"
        },
        "predefinedType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Predefined type",
              "de": "Vordefinierter Typ"
            }
          }
        }
      }
    }
  }
}
