{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IFC2x3 STEP Exchange Admission Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "description",
    "name",
    "fileSchema",
    "ids",
    "references",
    "recordCounts"
  ],
  "properties": {
    "schema": {
      "const": "stdio.ifc.2x3"
    },
    "description": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ],
      "additionalItems": false
    },
    "name": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": [
        {
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "additionalItems": false
    },
    "fileSchema": {
      "const": [
        [
          "IFC2X3"
        ]
      ]
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "recordCounts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
