{
  "$id": "https://semio.tech/schema/s.stdio.ifc.2x3/snapshot.json",
  "title": "Ifc2x3Snapshot",
  "type": "object",
  "$defs": {
    "Part21Decimal": {"type":"object","properties":{"negative":{"type":"boolean"},"coefficient":{"type":"string"},"scale":{"type":"integer"},"exponent":{"type":"integer"}},"required":["negative","coefficient","scale"]},
    "Part21Value": {"type":"object","properties":{"kind":{"type":"string","enum":["ref","str","enum","int","real","list","typed","unset","derived"]},"value":{},"values":{"type":"array","items":{"$ref":"#/$defs/Part21Value"}},"typeName":{"type":"string"}},"required":["kind"]},
    "Part21Entity": {"type":"object","properties":{"typeName":{"type":"string"},"arguments":{"type":"array","items":{"$ref":"#/$defs/Part21Value"}}},"required":["typeName","arguments"]},
    "Part21Instance": {"type":"object","properties":{"id":{"type":"integer"},"entities":{"type":"array","items":{"$ref":"#/$defs/Part21Entity"}}},"required":["id","entities"]},
    "Part21Header": {"type":"object","properties":{"fileDescription":{"type":"array","items":{"$ref":"#/$defs/Part21Value"}},"fileName":{"type":"array","items":{"$ref":"#/$defs/Part21Value"}},"fileSchema":{"type":"array","items":{"$ref":"#/$defs/Part21Value"}}},"required":["fileDescription","fileName","fileSchema"]},
