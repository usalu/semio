{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/cobie/mutation/set-type-assignment/schema.json",
  "title": "SetTypeAssignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Type relationship",
          "de": "Typbeziehung"
        },
        "description": {
          "en": "STEP instance id of the IfcRelDefinesByType.",
          "de": "STEP-Instanz-ID der IfcRelDefinesByType."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "assignment": {
      "anyOf": [
        {
          "$ref": "#/$defs/CobieTypeAssignment"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Type assignment",
          "de": "Typzuweisung"
        },
        "description": {
          "en": "Empty removes the relationship.",
          "de": "Leer entfernt die Beziehung."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "CobieTypeAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalId",
        "relatedObjects",
        "relatingType"
      ],
      "properties": {
        "globalId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "GlobalId",
              "de": "GlobalId"
            },
            "description": {
              "en": "22-character IFC GUID of the object.",
              "de": "22-stellige IFC-GUID des Objekts."
            }
          }
        },
        "ownerHistory": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Owner history",
              "de": "Eigentümerhistorie"
            },
            "description": {
              "en": "STEP instance id of the IfcOwnerHistory.",
              "de": "STEP-Instanz-ID der IfcOwnerHistory."
            }
          }
        },
        "relatedObjects": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "x-semio-ui": {
            "label": {
              "en": "Related objects",
              "de": "Zugeordnete Objekte"
            },
            "description": {
              "en": "STEP instance ids of the assigned objects.",
              "de": "STEP-Instanz-IDs der zugeordneten Objekte."
            }
          }
        },
        "relatingType": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Type object",
              "de": "Typobjekt"
            },
            "description": {
              "en": "STEP instance id of the relating IfcTypeObject.",
              "de": "STEP-Instanz-ID des zuweisenden IfcTypeObject."
            }
          }
        }
      }
    }
  }
}
