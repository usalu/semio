{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/cv20/mutation/set-project-units/schema.json",
  "title": "SetProjectUnits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project"
  ],
  "properties": {
    "project": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Project",
          "de": "Projekt"
        },
        "description": {
          "en": "STEP instance id of the IfcProject.",
          "de": "STEP-Instanz-ID des IfcProject."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "units": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Unit assignment",
          "de": "Einheitenzuweisung"
        },
        "description": {
          "en": "STEP instance id of the IfcUnitAssignment; empty clears it.",
          "de": "STEP-Instanz-ID der IfcUnitAssignment; leer löscht sie."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 20
      }
    }
  }
}
