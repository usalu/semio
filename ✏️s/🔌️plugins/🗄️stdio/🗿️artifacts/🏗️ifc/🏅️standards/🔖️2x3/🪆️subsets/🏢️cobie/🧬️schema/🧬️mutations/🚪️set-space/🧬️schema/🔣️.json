{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/cobie/mutation/set-space/schema.json",
  "title": "SetSpace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Space",
          "de": "Raum"
        },
        "description": {
          "en": "STEP instance id of the IfcSpace.",
          "de": "STEP-Instanz-ID des IfcSpace."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "space": {
      "anyOf": [
        {
          "$ref": "#/$defs/CobieSpaceRow"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Space row",
          "de": "Raumzeile"
        },
        "description": {
          "en": "COBie Space row; empty removes the space.",
          "de": "COBie-Raumzeile; leer entfernt den Raum."
        },
        "group": "value",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position a new instance takes among the instances; the last position when absent.",
          "de": "Position, die eine neue Instanz unter den Instanzen einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    },
    "instance": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/base/artifact.json#/$defs/Part21Instance",
      "x-semio-ui": {
        "label": {
          "en": "Exact instance",
          "de": "Exakte Instanz"
        },
        "description": {
          "en": "The instance written verbatim instead of one rebuilt from the row; carried when the row cannot express every attribute.",
          "de": "Die Instanz, die unverändert geschrieben wird statt einer aus der Zeile aufgebauten; wird mitgeführt, wenn die Zeile nicht jedes Attribut ausdrücken kann."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "CobieSpaceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalId",
        "name",
        "placement"
      ],
      "properties": {
        "globalId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "GlobalId",
              "de": "GlobalId"
            },
            "description": {
              "en": "22-character IFC GUID of the object.",
              "de": "22-stellige IFC-GUID des Objekts."
            }
          }
        },
        "name": {
          "type": "string"
        },
        "placement": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Placement",
              "de": "Platzierung"
            },
            "description": {
              "en": "STEP instance id of the IfcLocalPlacement.",
              "de": "STEP-Instanz-ID der IfcLocalPlacement."
            }
          }
        }
      }
    }
  }
}
