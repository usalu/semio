{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/ifc/2x3/sav/mutation/set-load-group.json",
  "title": "SetLoadGroup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "group": {
      "anyOf": [
        {
          "$ref": "#/$defs/SavLoadGroup"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "SavLoadGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalId",
        "name"
      ],
      "properties": {
        "globalId": {
          "type": "string"
        },
        "ownerHistory": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "predefinedType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "actionType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "actionSource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
