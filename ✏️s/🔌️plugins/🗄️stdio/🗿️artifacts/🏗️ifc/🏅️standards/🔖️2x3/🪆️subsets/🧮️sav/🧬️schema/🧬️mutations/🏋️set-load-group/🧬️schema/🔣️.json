{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/sav/mutation/set-load-group/schema.json",
  "title": "SetLoadGroup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Load group",
          "de": "Lastgruppe"
        },
        "description": {
          "en": "STEP instance id of the IfcStructuralLoadGroup.",
          "de": "STEP-Instanz-ID der IfcStructuralLoadGroup."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "group": {
      "anyOf": [
        {
          "$ref": "#/$defs/SavLoadGroup"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Load group",
          "de": "Lastgruppe"
        },
        "description": {
          "en": "Empty removes the load group.",
          "de": "Leer entfernt die Lastgruppe."
        },
        "group": "value",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position a new instance takes among the instances; the last position when absent.",
          "de": "Position, die eine neue Instanz unter den Instanzen einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    },
    "instance": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/base/artifact.json#/$defs/Part21Instance",
      "x-semio-ui": {
        "label": {
          "en": "Exact instance",
          "de": "Exakte Instanz"
        },
        "description": {
          "en": "The instance written verbatim instead of one rebuilt from the row; carried when the row cannot express every attribute.",
          "de": "Die Instanz, die unverändert geschrieben wird statt einer aus der Zeile aufgebauten; wird mitgeführt, wenn die Zeile nicht jedes Attribut ausdrücken kann."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "SavLoadGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalId",
        "name"
      ],
      "properties": {
        "globalId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "GlobalId",
              "de": "GlobalId"
            },
            "description": {
              "en": "22-character IFC GUID of the object.",
              "de": "22-stellige IFC-GUID des Objekts."
            }
          }
        },
        "ownerHistory": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Owner history",
              "de": "Eigentümerhistorie"
            },
            "description": {
              "en": "STEP instance id of the IfcOwnerHistory.",
              "de": "STEP-Instanz-ID der IfcOwnerHistory."
            }
          }
        },
        "name": {
          "type": "string"
        },
        "predefinedType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Predefined type",
              "de": "Vordefinierter Typ"
            }
          }
        },
        "actionType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Action type",
              "de": "Einwirkungsart"
            },
            "description": {
              "en": "Permanent, variable or accidental action (EN 1990).",
              "de": "Ständige, veränderliche oder außergewöhnliche Einwirkung (EN 1990)."
            }
          }
        },
        "actionSource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Action source",
              "de": "Einwirkungsursache"
            },
            "description": {
              "en": "e.g. dead load, wind, snow.",
              "de": "z. B. Eigengewicht, Wind, Schnee."
            }
          }
        }
      }
    }
  }
}
