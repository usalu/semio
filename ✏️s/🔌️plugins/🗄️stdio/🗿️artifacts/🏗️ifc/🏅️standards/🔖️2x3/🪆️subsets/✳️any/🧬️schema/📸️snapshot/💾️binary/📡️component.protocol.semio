# Structural logical snapshot payload: format tag, schema, typed Part-21 header, ordered typed
# instances, and optional typed EDM preamble. Native Part-21 text is materialized only by I/O.
dialect protocol
protocol stdio.ifc.2x3.snapshot
version 1
schema stdio.ifc.2x3
start body

framing record
header fixed 1
chain schema utf8
chain header bytes
chain instances bytes
chain edm_preamble bytes
