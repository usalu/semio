# 🏗️ Complete IFC2x3 owned records preserve ordered header roots and literal decimal fields.
dialect grammar
grammar stdio.ifc.2x3.snapshot
extension ifc
start document

document = "stdio.ifc.2x3" frame
frame = "schema" "=" text "file-description" "=" indices "file-name" "=" indices "file-schema" "=" indices "instances" "=" "[" instance* "]" "values" "=" "[" node* "]" preamble?
text = TEXT | IDENT
indices = "[" INT* "]"
instance = "{" "id" "=" INT "entities" "=" "[" entity* "]" "}"
entity = "{" "name" "=" text "arguments" "=" indices "}"
node = "{" "kind" "=" text integer? reference? literal? name? negative? coefficient? scale? exponent? "children" "=" indices "}"
integer = "integer" "=" INT
reference = "reference" "=" INT
literal = "text" "=" text
name = "name" "=" text
negative = "negative" "=" boolean
boolean = "true" | "false"
coefficient = "coefficient" "=" text
scale = "scale" "=" INT
exponent = "exponent" "=" INT
preamble = "edm" "=" "producer" "=" text "module" "=" text "creation-date" "=" text "host" "=" text "database" "=" text "database-version" "=" text "database-creation-date" "=" text "schema" "=" text "model" "=" text "model-creation-date" "=" text "header-model" "=" text "header-model-creation-date" "=" text "user" "=" text "group" "=" text "license" "=" text "options" "=" text
