dialect grammar
grammar stdio.ifc.2x3.snapshot
extension ifc
start document

document = envelope-mark snapshot
envelope-mark = "stdio.ifc.2x3"
snapshot = "schema=" HEX "header=" part21-header "instances=" instance-list "edm-preamble=" optional-preamble
part21-header = "[" value-list "," value-list "," value-list "]"
instance-list = "[" {instance {"," instance}*}? "]"
instance = "[" INT "," "[" {entity {"," entity}*}? "]" "]"
entity = "[" HEX "," value-list "]"
value-list = "[" {value {"," value}*}? "]"
value = "U" | "D" | tagged-value
tagged-value = IDENT "[" {value-payload}? "]"
value-payload = HEX | INT | value | value-list | HEX "," value-list
optional-preamble = "[0]" | "[1," preamble "]"
preamble = "[" HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "," HEX "]"
