{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/ifc/2x3/cv20/mutation/set-product-placement/schema.json",
  "title": "SetProductPlacement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product"
  ],
  "properties": {
    "product": {
      "type": "integer",
      "minimum": 0
    },
    "placement": {
