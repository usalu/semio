{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/sav/mutation/set-group-assignment/schema.json",
  "title": "SetGroupAssignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Group relationship",
          "de": "Gruppenbeziehung"
        },
        "description": {
          "en": "STEP instance id of the IfcRelAssignsToGroup.",
          "de": "STEP-Instanz-ID der IfcRelAssignsToGroup."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "assignment": {
      "anyOf": [
        {
          "$ref": "#/$defs/SavGroupAssignment"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Group assignment",
          "de": "Gruppenzuweisung"
        },
        "description": {
          "en": "Empty removes the relationship.",
          "de": "Leer entfernt die Beziehung."
        },
        "group": "value",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position a new instance takes among the instances; the last position when absent.",
          "de": "Position, die eine neue Instanz unter den Instanzen einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "SavGroupAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalId",
        "relatedObjects",
        "relatingGroup"
      ],
      "properties": {
        "globalId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "GlobalId",
              "de": "GlobalId"
            },
            "description": {
              "en": "22-character IFC GUID of the object.",
              "de": "22-stellige IFC-GUID des Objekts."
            }
          }
        },
        "ownerHistory": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Owner history",
              "de": "Eigentümerhistorie"
            },
            "description": {
              "en": "STEP instance id of the IfcOwnerHistory.",
              "de": "STEP-Instanz-ID der IfcOwnerHistory."
            }
          }
        },
        "relatedObjects": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "x-semio-ui": {
            "label": {
              "en": "Related objects",
              "de": "Zugeordnete Objekte"
            },
            "description": {
              "en": "STEP instance ids of the assigned objects.",
              "de": "STEP-Instanz-IDs der zugeordneten Objekte."
            }
          }
        },
        "relatingGroup": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Group",
              "de": "Gruppe"
            },
            "description": {
              "en": "STEP instance id of the relating IfcGroup.",
              "de": "STEP-Instanz-ID der zuweisenden IfcGroup."
            }
          }
        }
      }
    }
  }
}
