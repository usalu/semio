{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/ifc/2x3/cv20/mutation/set-structural-entity.json",
  "title": "SetStructuralEntity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "entity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cv20StructuralEntity"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "Cv20StructuralEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeName",
        "globalId",
        "name"
      ],
      "properties": {
        "typeName": {
          "type": "string"
        },
        "globalId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
