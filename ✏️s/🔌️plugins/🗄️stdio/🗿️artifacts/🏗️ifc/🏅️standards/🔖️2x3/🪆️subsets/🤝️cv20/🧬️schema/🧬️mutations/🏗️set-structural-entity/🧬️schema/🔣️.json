{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/cv20/mutation/set-structural-entity/schema.json",
  "title": "SetStructuralEntity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Entity",
          "de": "Entität"
        },
        "description": {
          "en": "STEP instance id (#n) of the entity.",
          "de": "STEP-Instanz-ID (#n) der Entität."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "entity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cv20StructuralEntity"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Building element",
          "de": "Bauteil"
        },
        "description": {
          "en": "Coordination View 2.0 element row; empty removes it.",
          "de": "Bauteilzeile der Coordination View 2.0; leer entfernt sie."
        },
        "group": "value",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position a new instance takes among the instances; the last position when absent.",
          "de": "Position, die eine neue Instanz unter den Instanzen einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    },
    "instance": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/base/artifact.json#/$defs/Part21Instance",
      "x-semio-ui": {
        "label": {
          "en": "Exact instance",
          "de": "Exakte Instanz"
        },
        "description": {
          "en": "The instance written verbatim instead of one rebuilt from the row; carried when the row cannot express every attribute.",
          "de": "Die Instanz, die unverändert geschrieben wird statt einer aus der Zeile aufgebauten; wird mitgeführt, wenn die Zeile nicht jedes Attribut ausdrücken kann."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "Cv20StructuralEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeName",
        "globalId",
        "name"
      ],
      "properties": {
        "typeName": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Entity type",
              "de": "Entitätstyp"
            }
          }
        },
        "globalId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "GlobalId",
              "de": "GlobalId"
            },
            "description": {
              "en": "22-character IFC GUID of the object.",
              "de": "22-stellige IFC-GUID des Objekts."
            }
          }
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
