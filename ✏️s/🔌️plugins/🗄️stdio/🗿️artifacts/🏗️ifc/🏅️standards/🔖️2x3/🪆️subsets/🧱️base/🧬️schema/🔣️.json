{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/base/artifact.json",
  "title": "Ifc2x3Artifact",
  "type": "object",
  "$defs": {
    "Part21Decimal": {
      "type": "object",
      "properties": {
        "negative": {
          "type": "boolean"
        },
        "coefficient": {
          "type": "string"
        },
        "scale": {
          "type": "integer"
        },
        "exponent": {
          "type": "integer"
        }
      },
      "required": [
        "negative",
        "coefficient",
        "scale"
      ]
    },
    "Part21Value": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ref",
            "str",
            "enum",
            "int",
            "real",
            "list",
            "typed",
            "unset",
            "derived"
          ],
          "x-semio-ui": {
            "label": {
              "en": "Value kind",
              "de": "Wertart"
            },
            "options": {
              "ref": {
                "en": "Instance reference",
                "de": "Instanzverweis"
              },
              "str": {
                "en": "String",
                "de": "Zeichenkette"
              },
              "enum": {
                "en": "Enumeration",
                "de": "Aufzählung"
              },
              "int": {
                "en": "Integer",
                "de": "Ganzzahl"
              },
              "real": {
                "en": "Real",
                "de": "Gleitkommazahl"
              },
              "list": {
                "en": "List",
                "de": "Liste"
              },
              "typed": {
                "en": "Typed value",
                "de": "Typisierter Wert"
              },
              "unset": {
                "en": "Unset ($)",
                "de": "Nicht gesetzt ($)"
              },
              "derived": {
                "en": "Derived (*)",
                "de": "Abgeleitet (*)"
              }
            }
          }
        },
        "value": {
          "x-semio-ui": {
            "label": {
              "en": "Value",
              "de": "Wert"
            }
          }
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Value"
          },
          "x-semio-ui": {
            "label": {
              "en": "List items",
              "de": "Listenelemente"
            }
          }
        },
        "typeName": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Type name",
              "de": "Typname"
            },
            "description": {
              "en": "Defined type of a typed value, e.g. IFCLABEL.",
              "de": "Definierter Typ eines typisierten Werts, z. B. IFCLABEL."
            }
          }
        }
      },
      "required": [
        "kind"
      ]
    },
    "Part21Entity": {
      "type": "object",
      "properties": {
        "typeName": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Entity type",
              "de": "Entitätstyp"
            }
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Value"
          },
          "x-semio-ui": {
            "label": {
              "en": "Attribute values",
              "de": "Attributwerte"
            }
          }
        }
      },
      "required": [
        "typeName",
        "arguments"
      ]
    },
    "Part21Instance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "x-semio-ui": {
            "label": {
              "en": "Instance id",
              "de": "Instanz-ID"
            },
            "description": {
              "en": "STEP instance id (#n).",
              "de": "STEP-Instanz-ID (#n)."
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Entity"
          },
          "x-semio-ui": {
            "label": {
              "en": "Entities",
              "de": "Entitäten"
            },
            "description": {
              "en": "One entity, or the parts of a complex entity.",
              "de": "Eine Entität oder die Teile einer komplexen Entität."
            }
          }
        }
      },
      "required": [
        "id",
        "entities"
      ]
    },
    "Part21Header": {
      "type": "object",
      "properties": {
        "fileDescription": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Value"
          },
          "x-semio-ui": {
            "label": {
              "en": "File description",
              "de": "Dateibeschreibung"
            }
          }
        },
        "fileName": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Value"
          },
          "x-semio-ui": {
            "label": {
              "en": "File name",
              "de": "Dateiname"
            }
          }
        },
        "fileSchema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Value"
          },
          "x-semio-ui": {
            "label": {
              "en": "File schema",
              "de": "Dateischema"
            }
          }
        }
      },
      "required": [
        "fileDescription",
        "fileName",
        "fileSchema"
      ]
    },
    "Part21Document": {
      "type": "object",
      "properties": {
        "header": {
          "$ref": "#/$defs/Part21Header",
          "x-semio-ui": {
            "label": {
              "en": "STEP header",
              "de": "STEP-Kopfteil"
            }
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Instance"
          },
          "x-semio-ui": {
            "label": {
              "en": "Instances",
              "de": "Instanzen"
            }
          }
        }
      },
      "required": [
        "header",
        "instances"
      ]
    },
    "Ifc2x3EdmPreamble": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Producer",
              "de": "Hersteller"
            }
          }
        },
        "module": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Module",
              "de": "Modul"
            }
          }
        },
        "creationDate": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Creation date",
              "de": "Erstellungsdatum"
            }
          }
        },
        "host": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Host",
              "de": "Host"
            }
          }
        },
        "database": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Database",
              "de": "Datenbank"
            }
          }
        },
        "databaseVersion": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Database version",
              "de": "Datenbankversion"
            }
          }
        },
        "databaseCreationDate": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Database creation date",
              "de": "Erstellungsdatum der Datenbank"
            }
          }
        },
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "EXPRESS schema",
              "de": "EXPRESS-Schema"
            }
          }
        },
        "model": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Model",
              "de": "Modell"
            }
          }
        },
        "modelCreationDate": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Model creation date",
              "de": "Erstellungsdatum des Modells"
            }
          }
        },
        "headerModel": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Header model",
              "de": "Kopfteilmodell"
            }
          }
        },
        "headerModelCreationDate": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Header model creation date",
              "de": "Erstellungsdatum des Kopfteilmodells"
            }
          }
        },
        "user": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "User",
              "de": "Benutzer"
            }
          }
        },
        "group": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Group",
              "de": "Gruppe"
            }
          }
        },
        "license": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "License",
              "de": "Lizenz"
            }
          }
        },
        "options": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Options",
              "de": "Optionen"
            }
          }
        }
      },
      "required": [
        "producer",
        "module",
        "creationDate",
        "host",
        "database",
        "databaseVersion",
        "databaseCreationDate",
        "schema",
        "model",
        "modelCreationDate",
        "headerModel",
        "headerModelCreationDate",
        "user",
        "group",
        "license",
        "options"
      ]
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "document": {
      "$ref": "#/$defs/Part21Document",
      "x-semio-state": "artifact"
    },
    "edmPreamble": {
      "$ref": "#/$defs/Ifc2x3EdmPreamble",
      "x-semio-state": "artifact"
    }
  }
}
