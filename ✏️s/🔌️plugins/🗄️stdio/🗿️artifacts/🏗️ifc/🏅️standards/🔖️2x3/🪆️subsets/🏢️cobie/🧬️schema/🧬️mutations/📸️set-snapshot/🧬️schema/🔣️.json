{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/ifc/2x3/cobie/mutation/set-snapshot.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot"
  ],
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/Ifc2x3Snapshot"
    }
  },
  "$defs": {
    "Ifc2x3Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "document": {
          "$ref": "#/$defs/Part21Document"
        },
        "edmPreamble": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ifc2x3EdmPreamble"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Part21Document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "instances"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/Part21Header"
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Instance"
          }
        }
      }
    },
    "Part21Header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_description",
        "file_name",
        "file_schema"
      ],
      "properties": {
        "file_description": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Value"
          }
        },
        "file_name": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Value"
          }
        },
        "file_schema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part21Value"
          }
        }
      }
    },
    "Part21Value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Ref"
          ],
          "properties": {
            "Ref": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Str"
          ],
          "properties": {
            "Str": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Enum"
          ],
          "properties": {
            "Enum": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Int"
          ],
          "properties": {
            "Int": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Real"
          ],
          "properties": {
            "Real": {
              "$ref": "#/$defs/Part21Decimal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "List"
          ],
          "properties": {
            "List": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Part21Value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Typed"
          ],
          "properties": {
            "Typed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Part21Value"
                  }
                }
              },
              "required": [
                "name",
                "items"
              ]
            }
          }
        },
        {
          "type": "string",
          "const": "Unset"
        },
        {
          "type": "string",
          "const": "Derived"
        }
      ]
    },
    "Part21Decimal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "negative",
        "coefficient",
        "scale"
      ],
      "properties": {
        "negative": {
          "type": "boolean"
        },
        "coefficient": {
          "type": "string"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "exponent": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Part21Instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entities"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Part21Value"
                }
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "Ifc2x3EdmPreamble": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "module",
        "creationDate",
        "host",
        "database",
        "databaseVersion",
        "databaseCreationDate",
        "schema",
        "model",
        "modelCreationDate",
        "headerModel",
        "headerModelCreationDate",
        "user",
        "group",
        "license",
        "options"
      ],
      "properties": {
        "producer": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "creationDate": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "databaseVersion": {
          "type": "string"
        },
        "databaseCreationDate": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "modelCreationDate": {
          "type": "string"
        },
        "headerModel": {
          "type": "string"
        },
        "headerModelCreationDate": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "options": {
          "type": "string"
        }
      }
    }
  }
}
