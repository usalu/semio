{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/2x3/cobie/mutation/set-floor-elevation/schema.json",
  "title": "SetFloorElevation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storey"
  ],
  "properties": {
    "storey": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Building storey",
          "de": "Geschoss"
        },
        "description": {
          "en": "STEP instance id of the IfcBuildingStorey.",
          "de": "STEP-Instanz-ID des IfcBuildingStorey."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "elevation": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Elevation",
          "de": "Höhenkote"
        },
        "description": {
          "en": "Storey elevation in project length units; empty clears it.",
          "de": "Geschosshöhenkote in Längeneinheiten des Projekts; leer löscht sie."
        },
        "precision": 3,
        "group": "value",
        "order": 20
      }
    }
  }
}
