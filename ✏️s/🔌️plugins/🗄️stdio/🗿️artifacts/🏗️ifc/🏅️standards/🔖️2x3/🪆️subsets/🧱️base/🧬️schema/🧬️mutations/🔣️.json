          "required": [
            "mutation"
          ],
          "properties": {
            "mutation": {
              "const": "setSnapshot"
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "https://semio.tech/schema/s/stdio/ifc/2x3/base/mutation/upsert-instance/schema.json"
