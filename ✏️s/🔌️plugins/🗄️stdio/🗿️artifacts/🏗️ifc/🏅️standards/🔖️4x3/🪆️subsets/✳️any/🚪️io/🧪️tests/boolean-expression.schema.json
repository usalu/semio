{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "root",
          "rootForm",
          "nodes",
          "expected",
          "volume",
          "physical"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "rootForm": {
            "enum": [
              "csg",
              "direct"
            ]
          },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "kind",
                    "origin",
                    "size"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "const": "block"
                    },
                    "origin": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    },
                    "size": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "kind",
                    "operator",
                    "first",
                    "second"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "const": "boolean"
                    },
                    "operator": {
                      "enum": [
                        "DIFFERENCE",
                        "UNION",
                        "INTERSECTION"
                      ]
                    },
                    "first": {
                      "type": "string",
                      "minLength": 1
                    },
                    "second": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          "expected": {
            "enum": [
              "mesh",
              "empty",
              "unsupported"
            ]
          },
          "volume": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "physical": {
            "enum": [
              "valid",
              "cyclic-not-sdk-evaluated",
              "malformed"
            ]
          }
        }
      }
    }
  }
}
