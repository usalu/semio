{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "applicable",
          "expected"
        ],
        "properties": {
          "id": {
            "enum": [
              "zero-length",
              "zero-parameter",
              "integer-zero",
              "negative-zero",
              "mixed-case-tag",
              "nonterminal-zero",
              "not-applicable",
              "wrong-kind",
              "wrong-segment",
              "business-nonzero",
              "curve-nonzero-decoy",
              "missing-representation",
              "parent-only",
              "missing-curve",
              "two-items",
              "repeated-curve",
              "two-representations",
              "raw-select",
              "unknown-select",
              "select-arity",
              "nonfinite-select",
              "unknown-constituent",
              "ambiguous-owner",
              "duplicate-id"
            ]
          },
          "kind": {
            "enum": [
              "horizontal",
              "vertical",
              "cant"
            ]
          },
          "applicable": {
            "type": "boolean"
          },
          "expected": {
            "enum": [
              "pass",
              "fail",
              "incomplete",
              "not-applicable"
            ]
          }
        }
      }
    }
  }
}
