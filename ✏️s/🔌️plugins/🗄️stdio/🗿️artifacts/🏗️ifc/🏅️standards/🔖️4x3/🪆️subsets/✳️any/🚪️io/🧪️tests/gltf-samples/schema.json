{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"stdio.ifc.gltf-originals","type":"object","additionalProperties":false,"required":["schema","sourceCommit","relativeErrorLimit","cases"],
 "properties":{
  "schema":{"const":"stdio.ifc.gltf-originals"},"sourceCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"relativeErrorLimit":{"type":"number","exclusiveMinimum":0},
  "cases":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","file","primitives","vertices","triangles","ifcBounds"],"properties":{
