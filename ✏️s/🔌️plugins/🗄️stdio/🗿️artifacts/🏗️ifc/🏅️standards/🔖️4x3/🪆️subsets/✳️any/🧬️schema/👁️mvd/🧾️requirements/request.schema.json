{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/ifc4x3/requirements-request.schema.json",
  "$defs": {
    "Id": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "Obligation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "applicable",
            "target"
          ],
          "properties": {
            "contract": {
              "enum": [
                "body-tessellation",
                "body-swept-solid",
                "body-advanced-swept-solid",
                "body-surface-model",
                "body-clipping",
                "body-brep",
                "body-advanced-brep"
              ]
            },
            "applicable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "representation"
              ],
              "properties": {
                "representation": {
                  "$ref": "#/$defs/Id"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "applicable",
            "target"
          ],
          "properties": {
            "contract": {
              "const": "alignment-terminal"
            },
            "applicable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layout",
                "kind"
              ],
              "properties": {
                "layout": {
                  "$ref": "#/$defs/Id"
                },
                "kind": {
                  "enum": [
                    "horizontal",
                    "vertical",
                    "cant"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "applicable",
            "target"
          ],
          "properties": {
            "contract": {
              "const": "alignment-direct"
            },
            "applicable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment",
                "kind"
              ],
              "properties": {
                "segment": {
                  "$ref": "#/$defs/Id"
                },
                "kind": {
                  "enum": [
                    "horizontal",
                    "vertical",
                    "cant"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "obligations"
      ],
      "properties": {
        "scope": {
          "const": "selected-contracts"
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64000,
          "items": {
            "$ref": "#/$defs/Obligation"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "view"
      ],
      "properties": {
        "scope": {
          "const": "released-view"
        },
        "view": {
          "enum": [
            "ReferenceView",
            "Alignment-basedReferenceView"
          ]
        }
      }
    }
  ]
}
