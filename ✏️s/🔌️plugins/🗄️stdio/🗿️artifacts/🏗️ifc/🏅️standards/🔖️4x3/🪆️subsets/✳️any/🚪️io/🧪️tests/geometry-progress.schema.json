{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://semio.tech/ifc4x3/geometry-progress.schema.json",
 "type": "object",
 "required": [
  "cases"
 ],
 "additionalProperties": false,
 "properties": {
  "cases": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "allOf": [
     {
      "if": {
       "properties": {
        "endpoint": {
         "const": "source-capture"
        }
       },
       "required": [
        "endpoint"
       ]
      },
      "then": {
       "properties": {
        "phase": {
         "const": "capture-copyOwned"
        }
       }
      }
     }
    ],
    "required": [
     "phase",
     "fault",
     "endpoint",
     "expected"
    ],
    "additionalProperties": false,
    "properties": {
     "phase": {
      "enum": [
       "capture-copyOwned",
       "geometry",
       "vertices",
       "triangles",
       "units",
       "placements",
       "representations",
       "items",
       "pn-indices",
       "geometry-unbound"
      ]
     },
     "fault": {
      "enum": [
       "error",
       "step-error",
       "edit-error",
       "edit-cancelled",
       "undefined",
       "number"
      ]
     },
     "expected": {
      "const": "reject-original"
     },
     "endpoint": {
      "enum": [
       "triangles",
       "glb-export",
       "source-capture"
      ]
     }
    }
   }
  }
 }
}
