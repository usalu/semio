{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept",
          "stage",
          "fault",
          "expected"
        ],
        "properties": {
          "concept": {
            "enum": [
              "alignment",
              "tessellation"
            ]
          },
          "stage": {
            "enum": [
              "request",
              "source"
            ]
          },
          "fault": {
            "enum": [
              "edit-error",
              "edit-cancelled",
              "step-error",
              "error",
              "undefined",
              "number"
            ]
          },
          "expected": {
            "const": "reject-original"
          }
        }
      }
    }
  }
}
