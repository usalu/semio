    {"name":"Tiny Reflection","linear":[-1e-200,0,0,0,1e-200,0,0,0,1e-200],"sign":-1},
    {"name":"Overflowing Products","linear":[1e308,0,0,0,1e308,0,0,0,1e308],"sign":1},
    {"name":"Subnormal Positive","linear":[5e-324,0,0,0,5e-324,0,0,0,5e-324],"sign":1},
    {"name":"Subnormal Reflection","linear":[5e-324,0,0,0,-5e-324,0,0,0,5e-324],"sign":-1},
    {"name":"Huge Singular","linear":[1e308,1e308,1e308,1e308,1e308,1e308,1e308,1e308,1e308],"sign":0},
    {"name":"Huge Cancellation","linear":[1e308,1e308,0,1e308,9.999999999999998e307,0,0,0,1],"sign":-1},
    {"name":"Near Singular Positive","linear":[1,1,1,1,1.0000000000000002,1,1,1,1.0000000000000002],"sign":1},
    {"name":"Near Singular Reflection","linear":[1,1.0000000000000002,1,1,1,1,1,1,1.0000000000000002],"sign":-1},
    {"name":"Mixed Exponents","linear":[1e308,0,0,0,5e-324,0,0,0,-1],"sign":-1}
