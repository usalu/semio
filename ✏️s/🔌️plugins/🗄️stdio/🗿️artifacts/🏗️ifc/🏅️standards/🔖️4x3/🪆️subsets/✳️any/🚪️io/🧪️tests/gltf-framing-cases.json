{
  "schema": "stdio.ifc.glb-framing",
  "json": "{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"byteLength\":1}]}",
  "cases": [
    {"name": "Space and Zero Padding", "jsonTail": " ", "binPadding": 0, "unknownChunk": false, "accepted": true},
    {"name": "Nonzero Binary Padding", "jsonTail": " ", "binPadding": 1, "unknownChunk": false, "accepted": false},
    {"name": "NUL JSON Tail", "jsonTail": "\u0000", "binPadding": 0, "unknownChunk": false, "accepted": false},
    {"name": "JSON Tab Text", "jsonTail": "\t", "binPadding": 0, "unknownChunk": false, "accepted": true},
    {"name": "JSON Line Text", "jsonTail": "\n", "binPadding": 0, "unknownChunk": false, "accepted": true},
    {"name": "Ignored Future Chunk", "jsonTail": " ", "binPadding": 0, "unknownChunk": true, "accepted": true}
  ],
  "scales": [1, 0.000001, 1e-200, -1e-200],
  "cancellationRoutes": ["readGlb", "writeGlb", "importGltf", "exportGltf"],
  "orientations": [
    {"name":"Identity","linear":[1,0,0,0,1,0,0,0,1],"sign":1},
