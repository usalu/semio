{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "unset",
              "real",
              "typed",
              "wrong-typed",
              "integer",
              "derived",
              "scalar",
              "missing",
              "component-unset"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "expected": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
