{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "radius",
          "depth",
          "direction",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "radius": {
            "type": "number"
          },
          "depth": {
            "type": "number"
          },
          "direction": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "millimetres": {
            "type": "boolean"
          },
          "profileOrigin": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "profileX": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "solidOrigin": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "solidZ": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "solidX": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "profileType": {
            "type": "string"
          },
          "sampling": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "absoluteChordErrorMetres": {
                "type": "number",
                "minimum": 0
              },
              "relativeChordError": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maxSegments": {
                "type": "integer",
                "minimum": 4,
                "maximum": 65536
              }
            }
          },
          "expected": {
            "enum": [
              "supported",
              "refuse"
            ]
          },
          "segments": {
            "type": "integer",
            "minimum": 4
          },
          "volume": {
            "type": "number"
          }
        }
      }
    }
  }
}
