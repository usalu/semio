     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "allOf": [{"if":{"properties":{"variant":{"type":"string"}},"required":["variant"]},"then":{"properties":{"lengths":{"type":"array","minItems":2}}}}],
      "required": [
       "id",
       "kind",
       "lengths",
       "applicable",
       "expected"
