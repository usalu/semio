        }
       },
       "applicable": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "expected": {
        "$ref": "#/$defs/Status"
       },
       "variant": {
        "enum": [
         "signedzero",
         "wrong-design",
         "complex",
         "duplicate-target",
         "missing-target",
         "wrong-target",
         "unknown-target",
         "mixed-layout",
         "competing-lists",
         "unrelated-relationship",
         "other-owner",
         "duplicate-attribute",
         "nonreference-member",
         "dangling-terminal",
         "ambiguous-terminal",
         "wrong-member",
         "dangling-design",
         "typed-measure",
         "wrong-measure-tag",
         "typed-multiple-items",
         "integer-zero",
         "integer-large",
         "tiny",
         "negative",
         "string-zero",
         "unknown-complex",
         "earlier-unresolved"
        ]
       }
      }
     }
    }
   }
