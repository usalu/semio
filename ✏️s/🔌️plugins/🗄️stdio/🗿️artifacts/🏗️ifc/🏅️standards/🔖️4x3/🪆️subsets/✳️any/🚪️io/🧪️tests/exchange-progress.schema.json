{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route",
          "phase",
          "occurrence",
          "fault",
          "expected"
        ],
        "properties": {
          "route": {
            "enum": [
              "bim-to-ifc",
              "ifc-to-bim",
              "fem-to-ifc",
              "ifc-to-fem"
            ]
          },
          "phase": {
            "enum": [
              "bim-sites",
              "bim-import",
              "fem-export",
              "fem-materials"
            ]
          },
          "occurrence": {
            "enum": [
              1,
              2
            ]
          },
          "fault": {
            "enum": [
              "error",
              "step-error",
              "step-cancelled",
              "edit-error",
              "undefined",
              "number"
            ]
          },
          "expected": {
            "const": "reject-original"
          }
        },
        "oneOf": [
          {
            "properties": {
              "route": {
                "const": "bim-to-ifc"
              },
              "phase": {
                "const": "bim-sites"
              },
              "occurrence": {
                "const": 1
              }
            }
          },
          {
            "properties": {
              "route": {
                "const": "ifc-to-bim"
              },
              "phase": {
                "const": "bim-import"
              },
              "occurrence": {
                "const": 2
              }
            }
          },
          {
            "properties": {
              "route": {
                "const": "fem-to-ifc"
              },
              "phase": {
                "const": "fem-export"
              },
              "occurrence": {
                "const": 2
              }
            }
          },
          {
            "properties": {
              "route": {
                "const": "ifc-to-fem"
              },
              "phase": {
                "const": "fem-materials"
              },
              "occurrence": {
                "const": 1
              }
            }
          }
        ]
      }
    }
  }
}

