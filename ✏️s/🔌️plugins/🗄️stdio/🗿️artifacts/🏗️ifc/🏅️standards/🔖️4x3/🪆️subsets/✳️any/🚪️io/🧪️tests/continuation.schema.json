{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "steps",
    "routes",
    "laws"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "routes": {
      "const": [
        "io",
        "edit"
      ]
    },
    "laws": {
      "const": [
        "shared-host-continuation",
        "original-error",
        "original-cancellation",
        "timer-fairness"
      ]
    }
  }
}
