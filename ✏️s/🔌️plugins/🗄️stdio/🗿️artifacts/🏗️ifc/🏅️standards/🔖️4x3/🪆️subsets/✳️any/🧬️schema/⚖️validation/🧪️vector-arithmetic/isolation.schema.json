{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "source",
    "helper",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "const": "one-public-query-with-nested-procedures"
    },
    "source": {
      "const": "../\ud83e\uddea\ufe0fvector/source.ifc"
    },
    "helper": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "args",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "real",
                  "integer",
                  "logical",
                  "direction",
                  "error"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
