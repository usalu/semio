{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "surrogateOffset",
    "editReference",
    "cases"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "surrogateOffset": {
      "type": "integer",
      "minimum": 1
    },
    "editReference": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "removedId",
          "remainingIds",
          "references"
        ],
        "properties": {
          "removedId": {
            "enum": [
              "0",
              "18446744073709551615"
            ]
          },
          "remainingIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "0",
                "18446744073709551615"
              ]
            }
          },
          "references": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "literal",
                "resolved"
              ],
              "properties": {
                "literal": {
                  "enum": [
                    "0",
                    "18446744073709551615"
                  ]
                },
                "resolved": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "0",
                        "18446744073709551615"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
