{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/4/any/mutation/insert-entity/schema.json",
  "title": "InsertEntity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "entity"
  ],
  "properties": {
    "mutation": {
      "const": "insertEntity",
      "description": "Aggregate discriminator spliced in by IfcMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position in the DATA section, counted from 0.",
          "de": "Position im DATA-Abschnitt, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "entity": {
      "$ref": "#/$defs/IfcEntity",
      "x-semio-ui": {
        "label": {
          "en": "Entity",
          "de": "Entität"
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "IfcEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "args"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Instance id",
              "de": "Instanz-ID"
            },
            "description": {
              "en": "STEP instance id (#n) of the entity.",
              "de": "STEP-Instanz-ID (#n) der Entität."
            }
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Entity type",
              "de": "Entitätstyp"
            },
            "description": {
              "en": "Upper-case IFC entity name, e.g. IFCWALL.",
              "de": "IFC-Entitätsname in Großbuchstaben, z. B. IFCWALL."
            }
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "Attributes",
              "de": "Attribute"
            },
            "description": {
              "en": "Attribute values in schema order.",
              "de": "Attributwerte in Schemareihenfolge."
            }
          }
        },
        "complex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcComplexType"
          },
          "x-semio-ui": {
            "label": {
              "en": "Complex entity parts",
              "de": "Teile der komplexen Entität"
            }
          }
        }
      }
    },
    "IfcValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unset"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "derived"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "real"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "enum"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reference"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IfcValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "typedValue"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "items"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/IfcValue"
                  }
                }
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "IfcComplexType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "args"
      ],
      "properties": {
        "name": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Entity type",
              "de": "Entitätstyp"
            }
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "Attributes",
              "de": "Attribute"
            }
          }
        }
      }
    }
  }
}
