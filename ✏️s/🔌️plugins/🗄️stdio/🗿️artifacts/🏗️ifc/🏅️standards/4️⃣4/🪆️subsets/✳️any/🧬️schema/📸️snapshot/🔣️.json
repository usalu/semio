{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/4/any/snapshot.json",
  "title": "IfcSnapshot",
  "type": "object",
  "definitions": {
    "IfcHeader": {
      "type": "object",
      "required": [
        "fileDescription",
        "fileName",
        "fileSchema"
      ],
      "properties": {
        "fileDescription": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        },
        "fileName": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        },
        "fileSchema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "header": {
      "$ref": "#/definitions/IfcHeader",
      "x-semio-state": "artifact"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IfcEntity"
      },
      "x-semio-state": "artifact"
    }
  },
  "required": [
    "schema",
    "header",
    "entities"
  ],
  "$defs": {
    "IfcComplexType": {
      "type": "object",
      "required": [
        "name",
        "args"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        }
      },
      "additionalProperties": false
    },
    "IfcEntity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "args"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        },
        "complex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcComplexType"
          }
        }
      },
      "additionalProperties": false
    },
    "IfcValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unset"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "derived"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "real"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "binary"
            },
            "value": {
              "type": "string",
              "pattern": "^(?:0[0-9A-F]*|1[0-7][0-9A-F]*|2[0-3][0-9A-F]*|3[01][0-9A-F]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "reference"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IfcValue"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "typedValue"
            },
            "value": {
              "$ref": "#/$defs/IfcTypedValue"
            }
          }
        }
      ]
    },
    "IfcTypedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "items"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
