{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/4/any/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "snapshot"
  ],
  "properties": {
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by IfcMutation; absent when the payload stands alone."
    },
    "snapshot": {
      "$ref": "#/$defs/IfcSnapshot",
      "x-semio-ui": {
        "label": {
          "en": "IFC model",
          "de": "IFC-Modell"
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "IfcSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Schema",
              "de": "Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema this document follows.",
              "de": "Kennung des Snapshot-Schemas, dem dieses Dokument folgt."
            }
          }
        },
        "header": {
          "$ref": "#/$defs/IfcHeader",
          "x-semio-ui": {
            "label": {
              "en": "STEP header",
              "de": "STEP-Kopfteil"
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcEntity"
          },
          "x-semio-ui": {
            "label": {
              "en": "Entities",
              "de": "Entitäten"
            }
          }
        }
      }
    },
    "IfcHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileDescription",
        "fileName",
        "fileSchema"
      ],
      "properties": {
        "fileDescription": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "File description",
              "de": "Dateibeschreibung"
            }
          }
        },
        "fileName": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "File name",
              "de": "Dateiname"
            }
          }
        },
        "fileSchema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "File schema",
              "de": "Dateischema"
            }
          }
        }
      }
    },
    "IfcValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unset"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "derived"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "real"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "enum"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reference"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IfcValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "typedValue"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "items"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/IfcValue"
                  }
                }
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "IfcEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "args"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Instance id",
              "de": "Instanz-ID"
            },
            "description": {
              "en": "STEP instance id (#n) of the entity.",
              "de": "STEP-Instanz-ID (#n) der Entität."
            }
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Entity type",
              "de": "Entitätstyp"
            },
            "description": {
              "en": "Upper-case IFC entity name, e.g. IFCWALL.",
              "de": "IFC-Entitätsname in Großbuchstaben, z. B. IFCWALL."
            }
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "Attributes",
              "de": "Attribute"
            },
            "description": {
              "en": "Attribute values in schema order.",
              "de": "Attributwerte in Schemareihenfolge."
            }
          }
        },
        "complex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcComplexType"
          },
          "x-semio-ui": {
            "label": {
              "en": "Complex entity parts",
              "de": "Teile der komplexen Entität"
            }
          }
        }
      }
    },
    "IfcComplexType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "args"
      ],
      "properties": {
        "name": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Entity type",
              "de": "Entitätstyp"
            }
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "Attributes",
              "de": "Attribute"
            }
          }
        }
      }
    }
