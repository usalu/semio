{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/ifc/4/any/mutation/set-snapshot.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot"
  ],
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/IfcSnapshot"
    },
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by IfcMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "IfcSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "header": {
          "$ref": "#/$defs/IfcHeader"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcEntity"
          }
        }
      }
    },
    "IfcHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileDescription",
        "fileName",
        "fileSchema"
      ],
      "properties": {
        "fileDescription": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        },
        "fileName": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        },
        "fileSchema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        }
      }
    },
    "IfcValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unset"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "derived"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "real"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "enum"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reference"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IfcValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "typedValue"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "items"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/IfcValue"
                  }
                }
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "IfcEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "args"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        },
        "complex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcComplexType"
          }
        }
      }
    },
    "IfcComplexType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "args"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IfcValue"
          }
        }
      }
    }
  }
}
