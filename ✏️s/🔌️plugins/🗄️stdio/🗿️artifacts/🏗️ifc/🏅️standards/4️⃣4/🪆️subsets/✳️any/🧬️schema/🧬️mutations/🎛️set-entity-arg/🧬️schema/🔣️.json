{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ifc/4/any/mutation/set-entity-arg/schema.json",
  "title": "SetEntityArg",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "index",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setEntityArg",
      "description": "Aggregate discriminator spliced in by IfcMutation; absent when the payload stands alone."
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Entity",
          "de": "Entität"
        },
        "description": {
          "en": "STEP instance id (#n) of the entity.",
          "de": "STEP-Instanz-ID (#n) der Entität."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Attribute position",
          "de": "Attributposition"
        },
        "description": {
          "en": "Position of the attribute in schema order, counted from 0.",
          "de": "Position des Attributs in Schemareihenfolge, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "value": {
      "$ref": "#/$defs/IfcValue",
      "x-semio-ui": {
        "label": {
          "en": "Attribute value",
          "de": "Attributwert"
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "IfcValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unset"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "derived"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "real"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "enum"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reference"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IfcValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "typedValue"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "items"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/IfcValue"
                  }
                }
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}
