# 📖️ P2-FG1: real `DiffCodec::print_diff`/`parse_diff` shape for `IfcDiff`, hand-rolled since
# `#[derive(dsl::DslDiff)]` fails (real `cargo check` output — `IfcValue`/`IfcEntitiesDiff: DslField`
# unsatisfied, see `🔺️diff/🦀️component.rs`'s own doc comment). One line of space-separated
# `name=value` tokens, only the CHANGED top-level fields present, in declared field order — every
# literal below copied verbatim from `print_ifc_diff`'s real body, not invented. Replaces the old
# ABNF placeholder this file used to contain.
dialect grammar
grammar stdio.ifc.diff
start document

document = file-description-tok? file-name-tok? file-schema-tok? entities-tok?
file-description-tok = "file-description" "=" ifc-value-list
file-name-tok = "file-name" "=" ifc-value-list
file-schema-tok = "file-schema" "=" ifc-value-list
entities-tok = "entities" "=" entities-diff

# `enc_entities_diff`: `[removed-ids];[modified];[added]` — id-keyed collection triple (§1.4's
# copy-pasteable shape), same shape as the sibling STEP artifact's own `entities` diff.
entities-diff = "[" u64-list "]" ";" "[" entity-modified-list "]" ";" "[" entity-added-list "]"
u64-list = {INT {"," INT}*}?
entity-modified-list = {entity-modified {"," entity-modified}*}?
entity-modified = INT ":" entity-diff
entity-added-list = {entity-added {"," entity-added}*}?
entity-added = INT ":" entity

# `enc_entity_diff`: `[nameOpt,argsOpt,complexOpt]` — every field independently `[0]`/`[1,value]`
# tri-state-tagged (§1.4's Tri-state pattern; a plain `Option<T>`, never a genuine
# `Option<Option<T>>` here).
entity-diff = "[" name-opt "," args-opt "," complex-opt "]"
name-opt = "[" "0" "]" | "[" "1" "," hex "]"
args-opt = "[" "0" "]" | "[" "1" "," args-diff "]"
complex-opt = "[" "0" "]" | "[" "1" "," complex-list "]"

# `enc_args_diff`: SAME `[removed];[modified];[added]` collection-triple shape, index-keyed (IFC4
# EXPRESS attribute lists are positional, so indices shift on insert/remove). Items are `IfcValue`
# directly — a weak collection, the "diff" IS the whole new value.
args-diff = "[" usize-list "]" ";" "[" arg-modified-list "]" ";" "[" arg-added-list "]"
usize-list = {INT {"," INT}*}?
arg-modified-list = {arg-modified {"," arg-modified}*}?
arg-modified = INT ":" ifc-value
arg-added-list = {arg-added {"," arg-added}*}?
arg-added = INT ":" ifc-value

# `IfcValue`'s tag scheme — see the sibling mutations grammar's identical doc comment for the full
# rationale (own copy per this dialect's per-file convention).
ifc-value = "U" | "D" | "I" "[" INT "]" | "R" "[" real-num "]" | "S" "[" hex "]" | "E" "[" hex "]" | "F" "[" INT "]" | "A" "[" value-csv "]" | "T" "[" hex "," "[" value-csv "]" "]"
real-num = INT | FLOAT
value-csv = {ifc-value {"," ifc-value}*}?
ifc-value-list = "[" value-csv "]"

complex-item = "[" hex "," ifc-value-list "]"
complex-list = "[" complex-csv "]"
complex-csv = {complex-item {"," complex-item}*}?

entity = "[" INT "," hex "," ifc-value-list "," complex-list "]"
