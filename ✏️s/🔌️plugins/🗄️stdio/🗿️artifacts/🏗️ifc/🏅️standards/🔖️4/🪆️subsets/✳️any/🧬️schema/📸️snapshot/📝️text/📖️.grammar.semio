# 📖️ Real ISO 10303-21 Part-21 exchange-file grammar (P2-FG1), matching this facet's own reuse of
# `step::engine::part21::{Lexer, parse_part21, write_part21}` 1:1 — IFC4 rides the exact same
# Part-21 container syntax STEP does (own `IfcHeader`/`IfcEntity`/`IfcValue` DATA MODEL, per the
# plan's specific-over-generic mandate, but the underlying wire GRAMMAR is identical — this file
# closely parallels `📐️step/…/📸️snapshot/📝️text/📖️.grammar.semio`'s own productions
# deliberately, documenting the parallel here rather than `use`-ing it (cross-artifact `use` doesn't
# resolve at recognize time; own copy per the recipe's specific-code mandate too). Same M1 header
# directives for the same reason: `comment line none` + `comment block "/*" "*/"` resolve the
# `#N=...` entity-ref-vs-`#`-comment collision; `string single doubled` turns on `''`-doubling for
# every `'...'` token (the `\X\HH\`/`\X2\HHHH...\X0\` escapes stay opaque TEXT-token content).
# https://www.iso.org/standard/70303.html (IFC4) / https://www.iso.org/standard/63141.html (Part 21)
dialect grammar
grammar stdio.ifc.snapshot
extension ifc
start document
comment line none
comment block "/*" "*/"
string single doubled

document = envelope-mark exchange-file
envelope-mark = "stdio.ifc"

exchange-file = "ISO-10303-21" ";" "HEADER" ";" file-description-record file-name-record file-schema-record "ENDSEC" ";" "DATA" ";" instance* "ENDSEC" ";" "END-ISO-10303-21" ";"
file-description-record = "FILE_DESCRIPTION" "(" value-list ")" ";"
file-name-record = "FILE_NAME" "(" value-list ")" ";"
file-schema-record = "FILE_SCHEMA" "(" value-list ")" ";"

# One `#N=TYPE(args);` simple instance, or a spec-legal `#N=(TYPE1(...)TYPE2(...));` COMPLEX
# instance (`IfcComplexType`, ISO 10303-21 §4.2) — real and common in IFC4's own select-type
# disambiguation (e.g. `IFCQUANTITYAREA(...)IFCPHYSICALSIMPLEQUANTITY(...)`).
instance = "#" INT "=" instance-body ";"
instance-body = entity-record | "(" entity-record+ ")"
entity-record = IDENT "(" value-list ")"

value-list = {step-value {"," step-value}*}?
step-value = "$" | "*" | "#" INT | TEXT | DOTENUM | INT | FLOAT | "(" value-list ")" | IDENT "(" value-list ")"
