{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.ifc.relation-index.v1"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entities",
          "role",
          "target",
          "family",
          "hits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "args"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/value"
                  }
                },
                "complex": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "args"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/value"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "role": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "family": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "hits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ordinal",
                "issue",
                "pointer"
              ],
              "properties": {
                "ordinal": {
                  "type": "integer",
                  "minimum": 0
                },
                "issue": {
                  "enum": [
                    null,
                    "aggregate",
                    "missing",
                    "ambiguous",
                    "unknown"
                  ]
                },
                "pointer": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "minItems": 9
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families",
        "roles"
      ],
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "type",
              "subtypes"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "subtypes": {
                "type": "boolean"
              }
            }
          },
          "minItems": 1,
          "maxItems": 32
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "family",
              "attribute",
              "owner",
              "cardinality"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "type": "string",
                "minLength": 1
              },
              "attribute": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "cardinality": {
                "enum": [
                  "one",
                  "many"
                ]
              }
            }
          },
          "maxItems": 32
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "unset",
                "malformed"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "reference",
                "string",
                "integer"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        }
      ]
    }
  }
}
