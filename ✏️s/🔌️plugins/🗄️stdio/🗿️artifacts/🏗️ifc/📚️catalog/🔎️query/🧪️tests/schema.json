{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entity",
          "name",
          "owner",
          "status",
          "values",
          "pointers"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "entity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "args"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "complex": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "args"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "enum": [
              "unique",
              "missing",
              "ambiguous",
              "unknown"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 2
          },
          "pointers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 2
          }
        }
      }
    }
  }
}
