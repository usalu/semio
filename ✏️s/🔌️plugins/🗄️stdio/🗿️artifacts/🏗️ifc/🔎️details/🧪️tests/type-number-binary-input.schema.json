{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nativeExecution",
    "encoding",
    "sources",
    "cases",
    "invalidBits",
    "invalidBinary",
    "binarySyntax",
    "binaryCandidateRefusals",
    "numberModes",
    "candidateRefusals",
    "originalControl",
    "ownerRefusals",
    "contextSequence"
  ],
  "properties": {
    "schema": {
      "const": "IFC4X3_ADD2"
    },
    "nativeExecution": {
      "const": false
    },
    "encoding": {
      "const": "ifc-template-command"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entities"
        ],
        "properties": {
          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/entity"
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "index",
          "value",
          "args",
          "admitted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "enum": [
              "real",
              "number",
              "binary",
              "ratio"
            ]
          },
          "target": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "$ref": "#/definitions/value"
          },
          "args": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/value"
            }
          },
          "admitted": {
            "type": "boolean"
          }
        }
      }
    },
    "invalidBits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidBinary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "binarySyntax": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "bits"
        ],
        "properties": {
          "word": {
            "type": "string"
          },
          "bits": {
            "type": "string",
            "pattern": "^[01]*$"
          }
        }
      }
    },
    "binaryCandidateRefusals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "numberModes": {
      "const": [
        "integer",
        "real"
      ]
    },
    "originalControl": {
      "const": {
        "cancelEveryProgressPrefix": true,
        "preserveCallerSource": true,
        "retainOriginalCallbackAndSignal": true,
        "propagateOriginalFailureIdentity": true,
        "undefinedFailureTailPrefixes": 32
      }
    },
    "candidateRefusals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "component",
          "index",
          "value",
          "inputIndex",
          "input"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "inputIndex": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "$ref": "#/definitions/value"
          },
          "input": {
            "$ref": "#/definitions/value"
          }
        }
      }
    },
    "ownerRefusals": {
      "const": [
        "absent",
        "duplicate"
      ]
    },
    "contextSequence": {
      "const": [
        "valid",
        "invalid-preserved-alias",
        "valid"
      ]
    }
  },
  "definitions": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unset"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "derived"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]{0,18})$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "reference"
            },
            "value": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "real"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bits"
              ],
              "properties": {
                "bits": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "binary"
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "args"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/value"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "args",
        "complex"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/value"
          }
        },
        "complex": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/part"
          }
        }
      }
    }
  }
}
