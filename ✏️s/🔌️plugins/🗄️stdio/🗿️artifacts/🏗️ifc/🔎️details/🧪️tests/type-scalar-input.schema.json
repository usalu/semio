{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "nativeExecution",
    "encoding",
    "sources",
    "cases",
    "integerDrafts",
    "integerValues"
  ],
  "properties": {
    "schema": {
      "const": "IFC4X3_ADD2"
    },
    "nativeExecution": {
      "const": false
    },
    "encoding": {
      "const": "ifc-template-command"
    },
    "sources": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": [
          "entities"
        ],
        "properties": {
          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "required",
          "steps",
          "args",
          "mutations"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "enum": [
              "basic",
              "unit"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "required": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "kind"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "enum": [
                    "reference",
                    "string",
                    "integer"
                  ]
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "text"
              ],
              "properties": {
                "field": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "mutations": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "integerDrafts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integerValues": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(0|-?[1-9][0-9]*)$"
      }
    }
  }
}
