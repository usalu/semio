{
  "$id": "https://semio.tech/schema/s.stdio.deflate/mutation.json",
  "title": "DeflateMutation",
  "oneOf": [
    {
      "type": "object",
      "required": ["mutation", "snapshot"],
      "properties": {
        "mutation": { "const": "setSnapshot" },
        "snapshot": { "$ref": "./📸️snapshot/🔣️.json" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["mutation", "method", "windowBits", "levelHint"],
      "properties": {
        "mutation": { "const": "setCompressionParams" },
        "method": { "type": "integer", "minimum": 0, "maximum": 15 },
        "windowBits": { "type": "integer", "minimum": 0, "maximum": 15 },
        "levelHint": { "type": "string", "enum": ["fastest", "fast", "default", "maximum"] }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["mutation", "dictId"],
      "properties": {
        "mutation": { "const": "setPresetDictionary" },
        "dictId": { "type": ["integer", "null"], "minimum": 0, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["mutation", "payload"],
      "properties": {
        "mutation": { "const": "setPayload" },
        "payload": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      },
      "additionalProperties": false
    }
  ]
}
