{
  "$id": "https://semio.tech/schema/s.stdio.deflate/diff.json",
  "title": "DeflateDiff",
  "type": "object",
  "properties": {
    "compressionMethod": { "type": "integer", "minimum": 0, "maximum": 15 },
    "windowBits": { "type": "integer", "minimum": 0, "maximum": 15 },
    "compressionLevelHint": {
      "type": "string",
      "enum": ["fastest", "fast", "default", "maximum"]
    },
    "dictId": {
      "description": "tri-state: absent=unchanged, null=cleared, number=set",
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 4294967295
    },
    "payload": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    }
  }
}
