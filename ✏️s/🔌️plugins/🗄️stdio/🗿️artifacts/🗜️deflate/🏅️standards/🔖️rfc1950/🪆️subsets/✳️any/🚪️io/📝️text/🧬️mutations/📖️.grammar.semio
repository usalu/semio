dialect grammar
grammar deflate.mutations
start op

# P2-FG2: real one-line `OpText` grammar matching `DeflateMutation`'s GENERIC `dsl::DslOps`-derived
# `print_op`/`parse_op` (../🦀️.rs `OpCodecs` region: `dsl::DslVariants::to_named_record` +
# `dsl::print(..., dsl::JoinMode::Inline)` -- no per-artifact custom printer), replacing the F6-era
# placeholder that described a serde-JSON `DeflateMutation` wire struct the Rust codec never emits.
# Same mechanism, same conventions, as stdio.txt's own already-real mutations grammar
# (../../../../../../🔤️txt/🏅️standards/🔖️utf-8/🪆️subsets/✳️any/🚪️io/📝️text/🧬️mutations/
# 📖️.grammar.semio). Keyword = kebab-case of the Rust variant name (`to_kebab`,
# `🗣️dsl/✨️derive/🦀️.rs`'s own documented convention: `SetPresetDictionary` ->
# `set-preset-dictionary`). Field keys are likewise kebab-case of the Rust field ident, printed
# `key=value` in declaration order. Every token below is copied verbatim from a REAL
# `cargo test -p semio-s-plugin-stdio --lib artifacts::deflate -- --ignored --nocapture` run of a
# temporary `[TRACE]` dump against representative `DeflateMutation` values (deleted before this
# wave closes), e.g.:
#   no-mutation
#   set-compression-params method=8 window-bits=5 level-hint=maximum
#   set-preset-dictionary dict-id=7
#   set-preset-dictionary                                                                          (no dict-id token at all when `None`)
#   set-payload payload="ZGVtby1wYXlsb2Fk"
op = no-mutation | set-compression-params | set-preset-dictionary | set-payload

no-mutation = "no-mutation"


# `SetCompressionParams` -- three plain scalar fields, always all present (no `Option`).
set-compression-params = "set-compression-params" "method" "=" INT "window-bits" "=" INT "level-hint" "=" level-hint-value

# `SetPresetDictionary { dict_id: Option<u32> }` -- the SAME "token omitted when `None`"
# convention as every other optional scalar (this is one bare `Option<u32>` scalar field on the
# variant itself -- there is only ONE flavor of "unset" here, not a separate "explicitly cleared" state).
set-preset-dictionary = "set-preset-dictionary" dict-id-tok?
dict-id-tok = "dict-id" "=" INT

# `SetPayload { payload: Vec<u8> }` (`#[dsl(base64)]`) -- always present (bare `Vec<u8>`, not
# `Option`), one quoted `TEXT` token, incl. the empty-payload case `payload=""`.
set-payload = "set-payload" "payload" "=" TEXT

# `DeflateLevelHint` (`dsl::DslScalar`-derived, ../../📸️snapshot/🦀️.rs) -- bare
# kebab-case unit-variant tags, all four confirmed real by the derive's own documented
# convention (only `default`/`fastest`/`maximum` exercised live above; `fast` follows the same
# mechanical `to_kebab` rule as every other variant).
level-hint-value = "fastest" | "fast" | "default" | "maximum"
