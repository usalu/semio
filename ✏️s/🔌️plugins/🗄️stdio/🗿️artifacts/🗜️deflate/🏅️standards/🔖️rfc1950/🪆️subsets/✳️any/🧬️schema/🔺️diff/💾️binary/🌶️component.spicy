module Stdio_deflate_diff;

# The "binary" wire form is UTF-8 JSON bytes (protocol::OpBinary::encode_op = serde_json::to_vec),
# the same sparse camelCase object as the sibling text grammar -- not a distinct byte layout.
# Spicy has no JSON grammar of its own, so it's typed as the UTF-8 text it actually is.
public type Document = unit {
    json_utf8: bytes &eod &convert=cast<string>($$);
};
