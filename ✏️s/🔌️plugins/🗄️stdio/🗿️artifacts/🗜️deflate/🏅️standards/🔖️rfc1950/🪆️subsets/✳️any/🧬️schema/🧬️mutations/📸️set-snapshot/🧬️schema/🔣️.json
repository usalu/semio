{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/deflate/rfc1950/any/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "snapshot"
  ],
  "properties": {
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by DeflateMutation; absent when the payload stands alone."
    },
    "snapshot": {
      "$ref": "#/$defs/DeflateSnapshot",
      "x-semio-ui": {
        "label": {
          "en": "zlib stream",
          "de": "zlib-Datenstrom"
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "DeflateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Schema",
              "de": "Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema this document follows.",
              "de": "Kennung des Snapshot-Schemas, dem dieses Dokument folgt."
            }
          }
        },
        "compressionMethod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Compression method (CM)",
              "de": "Kompressionsverfahren (CM)"
            },
            "description": {
              "en": "8 is deflate.",
              "de": "8 ist Deflate."
            }
          }
        },
        "windowBits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Window size",
              "de": "Fenstergröße"
            },
            "description": {
              "en": "Base-2 logarithm of the LZ77 window, 8 to 15.",
              "de": "Zweierlogarithmus des LZ77-Fensters, 8 bis 15."
            }
          }
        },
        "compressionLevelHint": {
          "$ref": "#/$defs/DeflateLevelHint",
          "x-semio-ui": {
            "label": {
              "en": "Compression level (FLEVEL)",
              "de": "Kompressionsstufe (FLEVEL)"
            }
          }
        },
        "dictId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Preset dictionary (DICTID)",
              "de": "Vorgabewörterbuch (DICTID)"
            },
            "description": {
              "en": "Adler-32 of the preset dictionary.",
              "de": "Adler-32 des Vorgabewörterbuchs."
            }
          }
        },
        "payload": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Payload",
              "de": "Nutzdaten"
            },
            "description": {
              "en": "Uncompressed bytes carried by the zlib stream.",
              "de": "Unkomprimierte Bytes des zlib-Datenstroms."
            }
          }
        }
      }
    },
    "DeflateLevelHint": {
      "type": "string",
      "enum": [
        "fastest",
        "fast",
        "default",
        "maximum"
      ],
      "x-semio-ui": {
        "options": {
          "fastest": {
            "en": "Fastest",
            "de": "Am schnellsten"
          },
          "fast": {
            "en": "Fast",
            "de": "Schnell"
          },
          "default": {
            "en": "Default",
            "de": "Standard"
          },
          "maximum": {
            "en": "Maximum compression",
            "de": "Maximale Kompression"
          }
        }
      }
    }
  }
}
