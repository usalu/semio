{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preflight",
    "ownedSchema",
    "fieldText",
    "bytePattern",
    "workItems",
    "copyBytes",
    "cancelAfter",
    "copyCancelAfter",
    "maxAllocationBytes",
    "lowRows",
    "expectedRows",
    "compressionMethod",
    "windowBits",
    "dictionaryAdler32",
    "allocationRole",
    "nativeInput"
  ],
  "properties": {
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encodings",
        "ownershipBytes",
        "byteAuthority",
        "refusalKinds",
        "cancelAt",
        "retirementRefund"
      ],
      "properties": {
        "encodings": {
          "const": [
            "binary",
            "text"
          ]
        },
        "ownershipBytes": {
          "const": 0
        },
        "byteAuthority": {
          "const": "fixedHuffmanCapacityAtLeastLiteralOutput"
        },
        "refusalKinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "cancellation"
          ],
          "properties": {
            "file": {
              "const": "ownershipLimit"
            },
            "cancellation": {
              "const": "canceled"
            }
          }
        },
        "cancelAt": {
          "const": "firstBorrowedCheckpoint"
        },
        "retirementRefund": {
          "const": false
        }
      }
    },
    "ownedSchema": {
      "type": "string"
    },
    "fieldText": {
      "type": "string"
    },
    "bytePattern": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "workItems": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "copyBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "cancelAfter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "copyCancelAfter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "lowRows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "expectedRows": {
      "type": "integer",
      "const": 1025
    },
    "compressionMethod": {
      "const": 15
    },
    "windowBits": {
      "const": 15
    },
    "dictionaryAdler32": {
      "const": 4294967295
    },
    "maxAllocationBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "allocationRole": {
      "const": "cumulativeOwnedBacking"
    },
    "nativeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compressionMethod",
        "windowBits",
        "dictionaryPresent",
        "dictionaryRefusal"
      ],
      "properties": {
        "compressionMethod": {
          "const": 8
        },
        "windowBits": {
          "const": 7
        },
        "dictionaryPresent": {
          "const": false
        },
        "dictionaryRefusal": {
          "const": "unsupportedOwner"
        }
      }
    }
  },
  "$id": "semio:stdio.deflate/sqlite/native-control"
}
