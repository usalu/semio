  "title": "SetPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "payload"
  ],
  "properties": {
    "mutation": {
      "const": "setPayload",
      "description": "Aggregate discriminator spliced in by DeflateMutation; absent when the payload stands alone."
