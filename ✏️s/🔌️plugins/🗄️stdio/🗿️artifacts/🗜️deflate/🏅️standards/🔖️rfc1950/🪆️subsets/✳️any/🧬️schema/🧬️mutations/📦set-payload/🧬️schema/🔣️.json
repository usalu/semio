        "maximum": 255
      },
      "x-semio-ui": {
        "label": {
          "en": "Payload",
          "de": "Nutzdaten"
        },
        "description": {
          "en": "Uncompressed bytes carried by the zlib stream.",
          "de": "Unkomprimierte Bytes des zlib-Datenstroms."
        },
        "group": "value",
        "order": 10
      }
