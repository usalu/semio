{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ply/1.0/any/mutation/set-row-property/schema.json",
  "title": "SetRowProperty",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "elementName",
    "rowIndex",
    "propertyName",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setRowProperty",
      "description": "Aggregate discriminator spliced in by PlyMutation; absent when the payload stands alone."
    },
    "elementName": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Element",
          "de": "Element"
        },
        "description": {
          "en": "Name of the PLY element whose rows are addressed.",
          "de": "Name des PLY-Elements, dessen Zeilen adressiert werden."
        }
      }
    },
    "rowIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Row index",
          "de": "Zeilenindex"
        },
        "description": {
          "en": "Zero-based row of the element.",
          "de": "Nullbasierte Zeile des Elements."
        },
        "step": 1
      }
    },
    "propertyName": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Property",
          "de": "Eigenschaft"
        },
        "description": {
          "en": "Name of the element property to set.",
          "de": "Name der zu setzenden Elementeigenschaft."
        }
      }
    },
    "value": {
      "$ref": "#/$defs/PlyValue",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Value",
          "de": "Wert"
        },
        "description": {
          "en": "Typed scalar or list the property holds in this row.",
          "de": "Typisierter Skalar oder Liste, die die Eigenschaft in dieser Zeile enthält."
        },
        "group": "value",
        "order": 40
      }
    }
  },
