{
  "$id": "https://semio.tech/schema/s.stdio.ply/snapshot.json",
  "title": "PlySnapshot",
  "type": "object",
  "$defs": {
    "PlyScalarType": {
      "type": "string",
      "enum": ["char", "uChar", "short", "uShort", "int", "uInt", "float", "double"]
    },
    "PlyProperty": {
      "oneOf": [
        {
          "type": "object",
          "required": ["form", "name", "kind"],
          "properties": {
            "form": { "const": "scalar" },
            "name": { "type": "string" },
            "kind": { "$ref": "#/$defs/PlyScalarType" }
          }
        },
        {
          "type": "object",
          "required": ["form", "name", "countKind", "valueKind"],
          "properties": {
            "form": { "const": "list" },
            "name": { "type": "string" },
            "countKind": { "$ref": "#/$defs/PlyScalarType" },
            "valueKind": { "$ref": "#/$defs/PlyScalarType" }
          }
        }
      ]
    },
    "PlyValue": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "enum": ["char", "uChar", "short", "uShort", "int", "uInt", "float", "double", "list"] },
        "value": {}
      }
    },
    "PlyRow": {
      "type": "object",
      "required": ["values"],
      "properties": {
        "values": { "type": "array", "items": { "$ref": "#/$defs/PlyValue" } }
      }
    },
    "PlyElement": {
      "type": "object",
      "required": ["name", "count", "properties", "rows"],
      "properties": {
        "name": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/PlyProperty" } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/PlyRow" } }
      }
    }
  },
  "required": ["schema", "format", "comments", "elements"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "format": { "type": "string", "enum": ["ascii", "binaryLittleEndian", "binaryBigEndian"], "x-semio-state": "artifact" },
    "comments": { "type": "array", "items": { "type": "string" }, "x-semio-state": "artifact" },
    "elements": { "type": "array", "items": { "$ref": "#/$defs/PlyElement" }, "x-semio-state": "artifact" }
  }
}
