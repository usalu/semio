{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ply/1.0/any/mutation/insert-comment/schema.json",
  "title": "InsertComment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "comment"
  ],
  "properties": {
    "mutation": {
      "const": "insertComment",
      "description": "Aggregate discriminator spliced in by PlyMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the header comments at which it is inserted, counted from 0.",
          "de": "Position unter den Kommentaren des Kopfteils, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "comment": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Comment",
          "de": "Kommentar"
        },
        "description": {
          "en": "Text of the `comment` header line.",
          "de": "Text der Kopfzeile `comment`."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
