{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ply/1.0/any/mutation/insert-row/schema.json",
  "title": "InsertRow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "elementName",
    "index",
    "row"
  ],
  "properties": {
    "mutation": {
      "const": "insertRow",
      "description": "Aggregate discriminator spliced in by PlyMutation; absent when the payload stands alone."
    },
    "elementName": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Element",
          "de": "Element"
        },
        "description": {
          "en": "Name of the PLY element whose rows are addressed.",
          "de": "Name des PLY-Elements, dessen Zeilen adressiert werden."
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the rows of the element at which it is inserted, counted from 0.",
          "de": "Position unter den Zeilen des Elements, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "row": {
      "$ref": "#/$defs/PlyRow",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Row",
          "de": "Zeile"
        },
        "description": {
          "en": "Property values of the inserted row, in property order.",
          "de": "Eigenschaftswerte der eingefügten Zeile in der Reihenfolge der Eigenschaften."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "PlyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlyValue"
          }
        }
      }
    },
    "PlyValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "char"
            },
            "value": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uChar"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "short"
            },
            "value": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32767
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uShort"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "int"
            },
            "value": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uInt"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "float"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "double"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlyValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}
