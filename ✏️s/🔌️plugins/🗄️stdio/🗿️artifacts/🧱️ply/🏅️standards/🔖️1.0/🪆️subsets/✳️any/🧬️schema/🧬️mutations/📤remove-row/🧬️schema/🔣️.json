{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ply/1.0/any/mutation/remove-row/schema.json",
  "title": "RemoveRow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "elementName",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "removeRow",
      "description": "Aggregate discriminator spliced in by PlyMutation; absent when the payload stands alone."
    },
    "elementName": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Element",
          "de": "Element"
        },
        "description": {
          "en": "Name of the PLY element whose rows are addressed.",
          "de": "Name des PLY-Elements, dessen Zeilen adressiert werden."
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Row",
          "de": "Zeile"
        },
        "description": {
          "en": "Index of the row of the element, counted from 0.",
          "de": "Index der Zeile des Elements, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  }
}
