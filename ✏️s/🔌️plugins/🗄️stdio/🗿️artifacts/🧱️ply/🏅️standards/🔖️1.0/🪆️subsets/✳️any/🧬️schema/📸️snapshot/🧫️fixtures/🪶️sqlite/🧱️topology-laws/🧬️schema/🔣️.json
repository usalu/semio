{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "depth",
    "cancelAfter",
    "maxRows",
    "maxValueBytes",
    "binary64Bits",
    "surrogateOffset",
    "unreachableCycle",
    "controlledRefusals",
    "controlledTextSource"
  ],
  "properties": {
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "cancelAfter": {
      "type": "integer",
      "minimum": 0
    },
    "maxRows": {
      "type": "integer",
      "minimum": 0
    },
    "maxValueBytes": {
      "type": "integer",
      "minimum": 0
    },
    "binary64Bits": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "surrogateOffset": {
      "type": "integer",
      "minimum": 0
    },
    "unreachableCycle": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "controlledRefusals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancellation",
        "rowAdmission",
        "malformedRecord"
      ],
      "properties": {
        "cancellation": {
          "const": "canceled"
        },
        "rowAdmission": {
          "const": "ownershipLimit"
        },
        "malformedRecord": {
          "const": "invalidValue"
        }
      }
    },
    "controlledTextSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "kind",
        "span"
      ],
      "properties": {
        "source": {
          "const": "?"
        },
        "kind": {
          "const": "invalidValue"
        },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line",
            "column",
            "length"
          ],
          "properties": {
            "line": {
              "const": 1
            },
            "column": {
              "const": 1
            },
            "length": {
              "const": 0
            }
          }
        }
      }
    }
  }
}
