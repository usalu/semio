{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ply/1.0/any/mutation/set-format/schema.json",
  "title": "SetFormat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "format"
  ],
  "properties": {
    "mutation": {
      "const": "setFormat",
      "description": "Aggregate discriminator spliced in by PlyMutation; absent when the payload stands alone."
    },
    "format": {
      "$ref": "#/$defs/PlyFormat",
      "x-semio-ui": {
        "widget": "segmented",
        "label": {
          "en": "File format",
          "de": "Dateiformat"
        },
        "options": {
          "ascii": {
            "en": "ASCII",
            "de": "ASCII"
          },
          "binaryLittleEndian": {
            "en": "Binary, little-endian",
            "de": "Binär, Little-Endian"
          },
          "binaryBigEndian": {
            "en": "Binary, big-endian",
            "de": "Binär, Big-Endian"
          }
        }
      }
    }
  },
  "$defs": {
    "PlyFormat": {
      "type": "string",
      "enum": [
        "ascii",
        "binaryLittleEndian",
        "binaryBigEndian"
      ]
    }
  }
}
