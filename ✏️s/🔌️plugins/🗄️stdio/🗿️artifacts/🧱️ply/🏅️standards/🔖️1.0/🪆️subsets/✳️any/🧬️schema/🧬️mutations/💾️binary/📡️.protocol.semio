dialect protocol
protocol stdio.ply.mutations
version 1
schema stdio.ply.op
start op
framing record

# Real `PlyMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record set-format tag=1
field payload bytes
record insert-comment tag=2
field payload bytes
record remove-comment tag=3
field payload bytes
record add-element tag=4
field payload bytes
record remove-element tag=5
field payload bytes
record insert-row tag=6
field payload bytes
record remove-row tag=7
field payload bytes
record set-row-property tag=8
field payload bytes
