{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/ply/1.0/any/diff.json",
  "title": "PlyDiff",
  "type": "object",
  "$defs": {
    "PlyRowFieldChange": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "https://semio.tech/schema/s/stdio/ply/1.0/any/snapshot.json#/$defs/PlyValue"
        }
      }
    },
    "PlyRowDiff": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlyRowFieldChange"
          }
        }
      }
    },
    "PlyRowModified": {
      "type": "object",
      "required": [
        "index",
        "diff"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "diff": {
          "$ref": "#/$defs/PlyRowDiff"
        }
      }
    },
    "PlyRowAdded": {
      "type": "object",
      "required": [
        "index",
        "row"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "$ref": "https://semio.tech/schema/s/stdio/ply/1.0/any/snapshot.json#/$defs/PlyRow"
        }
      }
    },
    "PlyRowsDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlyRowModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlyRowAdded"
          }
        }
      }
    },
    "PlyElementDiff": {
      "type": "object",
      "properties": {
        "properties": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/stdio/ply/1.0/any/snapshot.json#/$defs/PlyProperty"
          }
        },
        "rows": {
          "$ref": "#/$defs/PlyRowsDiff"
        }
      }
    },
    "PlyElementModified": {
      "type": "object",
      "required": [
        "name",
        "diff"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "diff": {
          "$ref": "#/$defs/PlyElementDiff"
        }
      }
    },
    "PlyElementAdded": {
      "type": "object",
      "required": [
        "index",
        "element"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "element": {
          "$ref": "https://semio.tech/schema/s/stdio/ply/1.0/any/snapshot.json#/$defs/PlyElement"
        }
      }
    },
    "PlyElementsDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlyElementModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlyElementAdded"
          }
        }
      }
    }
  },
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "ascii",
        "binaryLittleEndian",
        "binaryBigEndian"
      ]
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "elements": {
      "$ref": "#/$defs/PlyElementsDiff"
    }
  }
}
