{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/ply/1.0/any/mutation/add-element/schema.json",
  "title": "AddElement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "element"
  ],
  "properties": {
    "mutation": {
      "const": "addElement",
      "description": "Aggregate discriminator spliced in by PlyMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the elements at which it is inserted, counted from 0.",
          "de": "Position unter den Elementen, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "element": {
      "$ref": "#/$defs/PlyElement",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Element",
          "de": "Element"
        },
        "description": {
          "en": "Name, properties and rows of the element that is added.",
          "de": "Name, Eigenschaften und Zeilen des Elements, das hinzugefügt wird."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "PlyElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "count",
        "properties",
        "rows"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlyProperty"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlyRow"
          },
          "x-semio-ui": {
            "label": {
              "en": "Rows",
              "de": "Zeilen"
            },
            "description": {
              "en": "One value set per element instance.",
              "de": "Ein Wertesatz je Elementinstanz."
            }
          }
        }
      }
    },
    "PlyProperty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form",
            "name",
            "kind"
          ],
          "properties": {
            "form": {
              "const": "scalar"
            },
            "name": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/PlyScalarType"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form",
            "name",
            "countKind",
            "valueKind"
          ],
          "properties": {
            "form": {
              "const": "list"
            },
            "name": {
              "type": "string"
            },
            "countKind": {
              "$ref": "#/$defs/PlyScalarType"
            },
            "valueKind": {
              "$ref": "#/$defs/PlyScalarType"
            }
          }
        }
      ]
    },
    "PlyScalarType": {
      "type": "string",
      "enum": [
        "char",
        "uChar",
        "short",
        "uShort",
        "int",
        "uInt",
        "float",
        "double"
      ]
    },
    "PlyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlyValue"
          }
        }
      }
    },
    "PlyValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "char"
            },
            "value": {
              "type": "integer",
              "minimum": -128,
              "maximum": 127
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uChar"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "short"
            },
            "value": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 32767
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uShort"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "int"
            },
            "value": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uInt"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "float"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "double"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "list"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PlyValue"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}
