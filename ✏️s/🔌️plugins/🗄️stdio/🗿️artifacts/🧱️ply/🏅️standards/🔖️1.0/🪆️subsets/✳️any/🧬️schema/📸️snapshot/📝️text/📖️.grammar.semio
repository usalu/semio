dialect grammar
grammar stdio.ply.snapshot
extension ply
start document
comment none

document = "stdio.ply" field*
field = IDENT field-value?
field-value = "=" value
value = scalar value-tail? | list | record
scalar = field | TEXT | INT | FLOAT
value-tail = "," value
list = "[" value* "]"
record = "{" field* "}"
