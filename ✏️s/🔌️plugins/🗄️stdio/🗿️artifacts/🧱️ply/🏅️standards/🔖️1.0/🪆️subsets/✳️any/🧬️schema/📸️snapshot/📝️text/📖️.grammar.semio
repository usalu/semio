dialect grammar
grammar stdio.ply.snapshot
extension ply
start document
comment none

# 🎫️26/08/10/ARTIFACT-SYSTEM-OVERHAUL-REAL-CODECS-RUNTIME-REUSE-EVOLUTION FG3: real PLY 1.0
# ASCII header + data-row syntax (replaces the pre-Phase-2 ABNF placeholder this file used to
# contain — `%x`-hex byte literals, `/` alternation, `1*DIGIT`-shaped repetition, none of which
# is this dialect's real syntax). This artifact's `print_dsl`/`parse_dsl`
# (../../🦀️.rs's `HandcraftedArtifactCodecs` region) always render/read the CANONICAL
# ASCII encoding of a `PlySnapshot` regardless of its own persisted `format` field (`encode_ply`
# forces `PlyFormat::Ascii` — the DSL/text facet is deliberately format-normalized so it stays
# legible, human-diffable UTF-8 text even for a snapshot whose PERSISTED `format` names one of
# the two binary variants; those variants are the real byte-exact Pack facet's job instead — see
# the sibling `../💾️binary/📡️.protocol.semio` and this wave's own report). Header
# grammar matches `parse_header_text`/`header_text` (../../⚙️engine/🦀️.rs) production
# for production: magic line, one `format` line, any number of `comment` lines (order-
# preserving), then any number of `element <name> <count>` blocks each introducing 0+ `property`
# declarations (a plain scalar, or a `list <count-type> <value-type>` column).
#
# `dsl::fixture_sweep`'s `dsl_body_from_fixture` feeds the Recognizer "<envelope-id>\n<body>"
# (`SemioEnvelope::envelope_id` = "stdio.ply", the real preamble line's own trailing "v<n>"
# already stripped by the harness) — the shared lexer treats the preamble's newline as trivia, so
# `envelope-mark` and the header sit directly adjacent in the significant token stream, matching
# every other pilot's own identical convention (json/csv/png/gif89a).
envelope-mark = "stdio.ply"
document = envelope-mark magic-line format-line header-lines end-marker body

magic-line = "ply"

# `format-kind` lists all THREE real spec variants — the header text is identical in SHAPE across
# all three (only this one word differs), even though `print_dsl` itself only ever emits "ascii"
# (see the module doc comment above): the GRAMMAR models the real spec, not merely what one
# particular encode path happens to produce.
format-line = "format" format-kind "1.0"
format-kind = "ascii" | "binary_little_endian" | "binary_big_endian"

header-lines = header-line*
header-line = comment-line | element-line | property-line

# `LINE` (M1's raw-span terminal — captures the rest of the CURRENT physical line verbatim from
# the original source text) is used for comment text specifically because a real PLY comment is
# spec-legal free text that may contain multiple whitespace-separated words (`comment Cyberware
# Scan`, `parse_header_text`'s own `rest.strip_prefix(' ')...`) — a plain `IDENT?` would only
# ever accept ONE token, silently rejecting any multi-word comment.
comment-line = "comment" LINE?

element-line = "element" IDENT INT

property-line = scalar-property-line | list-property-line
scalar-property-line = "property" scalar-type IDENT
list-property-line = "property" "list" scalar-type scalar-type IDENT

# Both the canonical long spelling (`scalar_type_wire_name`, what `header_text` always emits) and
# every short spelling `parse_scalar_type` also accepts on input (../../⚙️engine/🦀️.rs).
# Kept on ONE physical line — this dialect's sequence parsing stops at the first Newline token,
# no line-continuation syntax exists (§3 pitfall #4 of `📖️grammar-recipe.md` — a real bug this
# exact production tripped on before this comment was added, caught by `committed_facet_files_parse`).
scalar-type = "char" | "uchar" | "short" | "ushort" | "int" | "uint" | "float" | "double" | "int8" | "uint8" | "int16" | "uint16" | "int32" | "uint32" | "float32" | "float64"

end-marker = "end_header"

# 📚️ The body: EVERY element instance's row data, back to back, as one flat run of numeric
# literals (a plain scalar cell is one number; a list cell is its own count followed by that many
# values — `decode_body_ascii`, ../../⚙️engine/🦀️.rs). Per-row/per-element BOUNDARIES are
# schema-external here: which property list belongs to which element, and how many rows each
# element has, is only known from `header-lines`' own runtime-parsed `element`/`property`
# declarations — a genuine cross-dialect "a value the GRAMMAR already parsed must parameterize
# the grammar's own later shape" dependency this dialect has no construct for (the SAME root
# cause `📖️grammar-recipe.md` §6's own PLY/PDF carve-out documents for the PROTOCOL side, restated
# here for the grammar side: "PLY's per-file schema selecting its own binary field list from an
# ASCII header ... deferred"). `Newline` is also always lexer trivia (confirmed unchanged, see
# that recipe's own `csv-newline-trivia` gap), so there is no structural `NEWLINE` terminal to
# fall back on for a per-line row boundary either. Honestly modeled as the real numeric-token
# VOCABULARY (genuine `INT`/`FLOAT` literals — not a hex/REST escape hatch) with NO row-count/
# row-shape validation at the grammar layer; that validation stays Rust-side, exactly like every
# other pilot's own opaque-tail treatment of a schema-external region.
body = number*
number = INT | FLOAT
