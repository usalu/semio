dialect grammar
grammar stdio.xml.diff
extension xml
start document
comment none

# P2-FG1: real one-line `DiffCodec::print_diff`/`parse_diff` shape ALREADY emitted by
# `../../🦀️component.rs` (`print_xml_diff`/`parse_xml_diff`), replacing the F6-era placeholder that
# described a serde-JSON `XmlDiff` wire struct the codec never emits. Every keyword/tag token below
# is copied verbatim from the real `format!(...)` call sites, not invented.
#
# `comment none`: not strictly required by any token this grammar's own alphabet produces (hex
# payloads are lowercase-only, never containing `#`), kept for consistency with the sibling
# ../../📸️snapshot/📝️text grammar and because a `#` appearing in future demo/fixture growth should
# fail loudly as a real parse mismatch, not silently vanish as a comment.
#
# `hex` (bare `hex`, referenced below but deliberately NOT defined as a production in this file) is
# the framework's built-in `hex` MACRO -- see the mandatory-macro rationale in
# `📖️grammar-recipe.md` §1.3(f)/§3 pitfall 2 (a hand-rolled `{INT|IDENT}*` production never
# backtracks and would silently swallow a following bareword literal like `declaration`/`doctype`).
document = declaration-tok? doctype-tok? root-tok?
declaration-tok = "declaration" "=" opt-declaration
doctype-tok = "doctype" "=" opt-hex
root-tok = "root" "=" node-diff

# `encode_option`'s uniform tri-state shape (`📖️grammar-recipe.md` §1.4): `[0]` (unchanged/None) /
# `[1,<value>]` (Some).
opt-hex = "[" "0" "]" | "[" "1" "," hex "]"
opt-bool = "[" "0" "]" | "[" "1" "," bool-lit "]"
bool-lit = "0" | "1"

# `enc_declaration`/`dec_declaration`: `[hex(version),opt-hex(encoding),opt-bool(standalone)]`.
opt-declaration = "[" "0" "]" | "[" "1" "," declaration-lit "]"
declaration-lit = "[" hex "," opt-hex "," opt-bool "]"

# `enc_node_diff`/`dec_node_diff` -- `XmlNodeDiff` itself needs a tag (`E`=Element, `T`=Text,
# `R`=Replace) since, unlike a bare `XmlNode`, it appears standalone (not always inside a bracketed
# container) at the top-level `root=` token position. Genuinely recursive: `E`'s children slot
# references `node-diff` (via `child-modified-item`) which references `node-diff` back through
# `children-diff-body` -- the same self-recursion `📖️grammar-recipe.md` §1.3(g) documents as
# already-proven-safe.
node-diff = "E" "[" opt-hex "," opt-attrs-diff "," opt-children-diff "]" | "T" "[" opt-hex "]" | "R" "[" opt-xml-node "]"
opt-attrs-diff = "[" "0" "]" | "[" "1" "," attrs-diff-body "]"
opt-children-diff = "[" "0" "]" | "[" "1" "," children-diff-body "]"
opt-xml-node = "[" "0" "]" | "[" "1" "," xml-node "]"

# `enc_attrs_diff`/`dec_attrs_diff` -- `[removed];[modified];[added]`, name-keyed
# (`📖️grammar-recipe.md` §1.4's name-keyed collection-triple shape).
attrs-diff-body = "[" attr-removed-item* "]" ";" "[" attr-modified-item* "]" ";" "[" attr-added-item* "]"
attr-removed-item = hex ","?
attr-modified-item = hex ":" hex ","?
attr-added-item = INT ":" hex ":" hex ","?

# `enc_children_diff`/`dec_children_diff` -- `[removed];[modified];[added]`, index-keyed.
children-diff-body = "[" child-removed-item* "]" ";" "[" child-modified-item* "]" ";" "[" child-added-item* "]"
child-removed-item = INT ","?
child-modified-item = INT ":" node-diff ","?
child-added-item = INT ":" xml-node ","?

# `enc_xml_node`/`dec_xml_node` -- restated here (same shape as
# ../../📸️snapshot/🦀️component.rs's `XmlNode`) so this leaf grammar is self-contained, matching the
# repo's existing per-facet convention (json's own diff grammar restates `value` the same way).
xml-node = "E" "[" hex "," "[" attr-item* "]" "," "[" node-item* "]" "]" | "T" "[" hex "]" | "D" "[" hex "]" | "M" "[" hex "]" | "P" "[" hex "," hex "]"
attr-item = "[" hex "," hex "]" ","?
node-item = xml-node ","?
