{
  "$id": "https://semio.tech/schema/s.stdio.pdf/snapshot.json",
  "title": "PdfSnapshot",
  "$defs": {
    "PageDoc": {
      "description": "One resolved page of a PDF 1.4 document: its /MediaBox extent and its shown text.",
      "type": "object",
      "required": ["width", "height", "text"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "text": { "type": "string" }
      }
    }
  },
  "type": "object",
  "required": ["schema", "pages"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/PageDoc" }, "x-semio-state": "artifact" }
  }
}
