dialect protocol
protocol stdio.pdf.snapshot
version 1
schema stdio.pdf
start snapshot
framing record
use semio.pack

# Canonical Pack frames carry the owned schema and ordered page records.
# RecordSpec field IDs are schema=0 and pages=1; requiredness is checked by its decoder.
record snapshot {
  schema utf8
  pages Array(Ref(page),varint)
}
struct page {
  width f64
  height f64
  text utf8
}
