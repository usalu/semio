{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pdf/1.4/base/mutation/insert-page/schema.json",
  "title": "InsertPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "page"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "page": {
      "$ref": "#/$defs/PageDoc"
    }
  },
  "$defs": {
    "PageDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
