{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.4/base/mutation/insert-page/schema.json",
  "title": "InsertPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "page"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the pages at which it is inserted, counted from 0.",
          "de": "Position unter den Seiten, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "page": {
      "$ref": "#/$defs/PageDoc",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Size and content of the page that is inserted.",
          "de": "Größe und Inhalt der Seite, die eingefügt wird."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "PageDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
