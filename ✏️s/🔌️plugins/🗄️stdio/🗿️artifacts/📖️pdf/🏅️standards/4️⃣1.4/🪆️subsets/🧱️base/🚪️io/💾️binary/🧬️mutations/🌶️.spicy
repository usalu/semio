module Pdf14Mutations;

# 💾️ Native direct-leaf payloads; indices and lengths are little-endian u64.
type Text = unit {
    length: uint64 &byte-order=spicy::ByteOrder::Little;
    value: bytes &size=self.length;
};
type Page = unit {
    width: real64 &byte-order=spicy::ByteOrder::Little;
    height: real64 &byte-order=spicy::ByteOrder::Little;
    text: Text;
};
type InsertPage = unit {
    index: uint64 &byte-order=spicy::ByteOrder::Little;
    page: Page;
};
type RemovePage = unit {
    index: uint64 &byte-order=spicy::ByteOrder::Little;
};
type MovePage = unit {
    from: uint64 &byte-order=spicy::ByteOrder::Little;
    to: uint64 &byte-order=spicy::ByteOrder::Little;
};
type ResizePage = unit {
    index: uint64 &byte-order=spicy::ByteOrder::Little;
    width: real64 &byte-order=spicy::ByteOrder::Little;
    height: real64 &byte-order=spicy::ByteOrder::Little;
};
type ReplacePageText = unit {
    index: uint64 &byte-order=spicy::ByteOrder::Little;
    text: Text;
};
public type PdfMutation = unit {
    format: uint8 &requires=self.format == 1;
    tag: uint8 &requires=self.tag <= 4;
    switch (self.tag) {
        0 -> insert_page: InsertPage;
        1 -> remove_page: RemovePage;
        2 -> move_page: MovePage;
        3 -> resize_page: ResizePage;
        4 -> replace_page_text: ReplacePageText;
    };
};
