{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/pdf14/snapshot/sqlite/backing.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority", "phases", "ceilings", "cancellation", "diagnosticOwnership", "retirementRefund"],
  "properties": {
    "authority": { "type": "string", "const": "completeSystemAllocatorRequests" },
    "phases": { "type": "array", "items": { "type": "string" }, "const": ["projectSnapshot", "reconstructSnapshot"] },
    "ceilings": { "type": "array", "items": { "type": "string" }, "const": ["zero", "exact", "oneBelow", "cumulative"] },
    "cancellation": { "type": "array", "items": { "type": "string" }, "const": ["start", "materializedInterior"] },
    "diagnosticOwnership": { "type": "string", "const": "actualCapacity" },
    "retirementRefund": { "type": "boolean", "const": false }
  }
}
