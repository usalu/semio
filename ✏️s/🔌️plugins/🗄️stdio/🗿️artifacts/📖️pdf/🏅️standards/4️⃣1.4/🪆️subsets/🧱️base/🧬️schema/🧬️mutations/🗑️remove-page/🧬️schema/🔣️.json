{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.4/base/mutation/remove-page/schema.json",
  "title": "RemovePage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
