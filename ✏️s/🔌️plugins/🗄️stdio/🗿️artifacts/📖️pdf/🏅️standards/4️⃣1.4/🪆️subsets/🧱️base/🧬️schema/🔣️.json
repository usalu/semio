{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pdf/1.4/base/artifact.json",
  "title": "PdfArtifact",
  "type": "object",
  "required": [
    "schema",
    "pages"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/pdf/1.4/base/snapshot.json#/$defs/PageDoc"
