{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.4/base/mutation/replace-page-text/schema.json",
  "title": "ReplacePageText",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "text"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Index of the page, counted from 0.",
          "de": "Index der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "text": {
      "type": "string",
      "x-semio-ui": {
        "widget": "multiline",
        "role": "value",
        "label": {
          "en": "Page text",
          "de": "Seitentext"
        },
        "description": {
          "en": "Text the page shows afterwards.",
          "de": "Text, den die Seite danach zeigt."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
