dialect protocol
protocol stdio.pdf.mutations
version 1
schema stdio.pdf.op
start op

# 💾️ Header format byte then direct leaf tag. Integers are u64 little-endian;
# geometry is finite f64 little-endian; strings are u64 byte-length plus UTF-8.
# 0 insert-page: index=u64le page=(width:f64le,height:f64le,text:utf8-length64)
# 1 remove-page: index=u64le
# 2 move-page: from=u64le to=u64le
# 3 resize-page: index=u64le width=f64le height=f64le
# 4 replace-page-text: index=u64le text=utf8-length64
framing record
header fixed 2
field format u8
field tag u8
chain payload bytes
