{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/set-page-layout/schema.json",
  "title": "SetPageLayout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setPageLayout",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "layout": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfPageLayout"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "options": {
          "singlePage": {
            "en": "Single page",
            "de": "Einzelne Seite"
          },
          "oneColumn": {
            "en": "One column",
            "de": "Fortlaufend"
          },
          "twoColumnLeft": {
            "en": "Two columns, odd pages left",
            "de": "Zwei Spalten, ungerade Seiten links"
          },
          "twoColumnRight": {
            "en": "Two columns, odd pages right",
            "de": "Zwei Spalten, ungerade Seiten rechts"
          },
          "twoPageLeft": {
            "en": "Two pages, odd pages left",
            "de": "Doppelseite, ungerade Seiten links"
          },
          "twoPageRight": {
            "en": "Two pages, odd pages right",
            "de": "Doppelseite, ungerade Seiten rechts"
          }
        }
      }
    }
  }
}
