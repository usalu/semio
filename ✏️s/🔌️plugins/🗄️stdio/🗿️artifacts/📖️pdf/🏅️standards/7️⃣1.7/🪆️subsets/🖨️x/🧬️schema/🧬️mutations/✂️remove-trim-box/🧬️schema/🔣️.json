{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/x/mutation/remove-trim-box/schema.json",
  "title": "RemoveTrimBox",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "pageIndex"
  ],
  "properties": {
    "mutation": {
      "const": "removeTrimBox",
      "description": "Aggregate discriminator spliced in by PdfXMutation; absent when the payload stands alone."
    },
    "pageIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Index of the page, counted from 0.",
          "de": "Index der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    }
  }
}
