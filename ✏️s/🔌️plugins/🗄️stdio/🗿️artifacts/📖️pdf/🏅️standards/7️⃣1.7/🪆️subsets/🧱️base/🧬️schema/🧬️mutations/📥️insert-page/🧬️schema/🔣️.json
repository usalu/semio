{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/insert-page/schema.json",
  "title": "InsertPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "page"
  ],
  "properties": {
    "mutation": {
      "const": "insertPage",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the pages at which it is inserted, counted from 0.",
          "de": "Position unter den Seiten, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "page": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfPage",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Size and content of the page that is inserted.",
          "de": "Größe und Inhalt der Seite, die eingefügt wird."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
