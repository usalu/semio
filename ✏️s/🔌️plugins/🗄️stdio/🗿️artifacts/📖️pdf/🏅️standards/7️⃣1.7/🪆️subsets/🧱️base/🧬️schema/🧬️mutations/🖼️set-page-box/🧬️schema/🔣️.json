{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/set-page-box/schema.json",
  "title": "SetPageBox",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "kind"
  ],
  "properties": {
    "mutation": {
      "const": "setPageBox",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Index of the page, counted from 0.",
          "de": "Index der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "kind": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/diff.json#/$defs/PdfPageBox",
      "x-semio-ui": {
        "options": {
          "crop": {
            "en": "Crop box (CropBox)",
            "de": "Maskenrahmen (CropBox)"
          },
          "bleed": {
            "en": "Bleed box (BleedBox)",
            "de": "Anschnittrahmen (BleedBox)"
          },
          "trim": {
            "en": "Trim box (TrimBox)",
            "de": "Endformatrahmen (TrimBox)"
          },
          "art": {
            "en": "Art box (ArtBox)",
            "de": "Objektrahmen (ArtBox)"
          }
        }
      }
    },
    "rect": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/Binary64Transport"
          },
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "vector",
        "label": {
          "en": "Page box",
          "de": "Seitenrahmen"
        },
        "description": {
          "en": "Rectangle as [llx lly urx ury].",
          "de": "Rechteck als [llx lly urx ury]."
        },
        "unit": "pt"
      }
    }
  }
}
