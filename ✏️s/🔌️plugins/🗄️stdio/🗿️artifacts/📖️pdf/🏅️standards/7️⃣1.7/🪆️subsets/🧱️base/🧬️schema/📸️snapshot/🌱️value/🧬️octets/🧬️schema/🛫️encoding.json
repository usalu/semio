{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object","additionalProperties":false,
  "required":["schema","text","repeatCount","maximumBytes","cancelAt","documentId","fieldCount"],
  "properties":{
    "schema":{"const":"semio.pdf.owned-native-output/v1"},
    "text":{"type":"string","minLength":1},
    "repeatCount":{"type":"integer","minimum":16384},
    "maximumBytes":{"type":"integer","minimum":1},
    "cancelAt":{"type":"integer","minimum":65536},
    "documentId":{"type":"object","additionalProperties":false,"required":["left","right"],"properties":{"left":{"type":"array","items":{"type":"integer","minimum":0,"maximum":255}},"right":{"type":"array","items":{"type":"integer","minimum":0,"maximum":255}}}},
    "fieldCount":{"const":31}
  }
}
