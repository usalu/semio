{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/ua/mutation/remove-font-file/schema.json",
  "title": "RemoveFontFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "descriptorOrdinal"
  ],
  "properties": {
    "mutation": {
      "const": "removeFontFile",
      "description": "Aggregate discriminator spliced in by PdfUaMutation; absent when the payload stands alone."
    },
    "descriptorOrdinal": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Font descriptor",
          "de": "Schriftdeskriptor"
        },
        "description": {
          "en": "Index of the font descriptor in document order, counted from 0.",
          "de": "Index des Schriftdeskriptors in Dokumentreihenfolge, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    }
  }
}
