{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/insert-annotation/schema.json",
  "title": "InsertAnnotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "at",
    "annotation"
  ],
  "properties": {
    "mutation": {
      "const": "insertAnnotation",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Index of the page, counted from 0.",
          "de": "Index der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the page's annotations at which it is inserted, counted from 0.",
          "de": "Position unter den Anmerkungen der Seite, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "annotation": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfAnnotation",
      "x-semio-ui": {
        "label": {
          "en": "Annotation",
          "de": "Anmerkung"
        }
      }
    }
  }
}
