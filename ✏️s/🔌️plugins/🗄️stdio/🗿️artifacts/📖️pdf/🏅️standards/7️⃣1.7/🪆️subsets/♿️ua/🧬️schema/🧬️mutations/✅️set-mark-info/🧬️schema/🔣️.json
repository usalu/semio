{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/ua/mutation/set-mark-info/schema.json",
  "title": "SetMarkInfo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "marked"
  ],
  "properties": {
    "mutation": {
      "const": "setMarkInfo",
      "description": "Aggregate discriminator spliced in by PdfUaMutation; absent when the payload stands alone."
    },
    "marked": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "label": {
          "en": "Tagged PDF",
          "de": "Getaggtes PDF"
        },
        "description": {
          "en": "The document conforms to the Tagged PDF conventions.",
          "de": "Das Dokument folgt den Konventionen für getaggtes PDF."
        }
      }
    }
  }
}
