{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmbedFontFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptorOrdinal",
    "key",
    "program"
  ],
  "properties": {
    "descriptorOrdinal": {
      "type": "integer",
      "minimum": 0
    },
    "key": {
      "type": "string"
    },
    "program": {
      "title": "ObjRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gen",
        "num"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 0
        },
        "gen": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
