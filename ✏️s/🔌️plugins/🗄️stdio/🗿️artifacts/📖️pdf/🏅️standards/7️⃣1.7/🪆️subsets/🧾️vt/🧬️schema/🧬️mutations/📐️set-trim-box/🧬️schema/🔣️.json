{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/vt/mutation/set-trim-box/schema.json",
  "title": "SetTrimBox",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "pageIndex",
    "trimBox"
  ],
  "properties": {
    "mutation": {
      "const": "setTrimBox",
      "description": "Aggregate discriminator spliced in by PdfVtMutation; absent when the payload stands alone."
    },
    "pageIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Index of the page, counted from 0.",
          "de": "Index der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "trimBox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "x-semio-ui": {
        "widget": "vector",
        "label": {
          "en": "Trim box",
          "de": "Endformatrahmen (TrimBox)"
        },
        "description": {
          "en": "Finished page size after trimming as [llx lly urx ury].",
          "de": "Endformat der Seite nach dem Beschnitt als [llx lly urx ury]."
        },
        "unit": "pt"
      }
    }
  }
}
