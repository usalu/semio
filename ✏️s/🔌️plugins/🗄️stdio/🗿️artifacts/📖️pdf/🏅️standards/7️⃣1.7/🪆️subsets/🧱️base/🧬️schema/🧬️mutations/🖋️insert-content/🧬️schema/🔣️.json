{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/insert-content/schema.json",
  "title": "InsertContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "at",
    "content"
  ],
  "properties": {
    "mutation": {
      "const": "insertContent",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Index of the page, counted from 0.",
          "de": "Index der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the operators of the page's content stream at which it is inserted, counted from 0.",
          "de": "Position unter den Operatoren des Inhaltsstroms der Seite, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "content": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfOp"
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Content operators",
          "de": "Inhaltsoperatoren"
        },
        "description": {
          "en": "Content stream operators with their operands, in painting order.",
          "de": "Operatoren des Inhaltsstroms mit ihren Operanden in Zeichenreihenfolge."
        },
        "group": "value",
        "order": 30
      }
    }
  }
}
