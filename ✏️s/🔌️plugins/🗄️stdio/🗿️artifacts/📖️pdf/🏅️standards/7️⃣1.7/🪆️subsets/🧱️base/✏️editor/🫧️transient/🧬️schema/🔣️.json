{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/stdio/pdf/view/transient/schema.json",
  "title": "PdfViewTransient",
  "type": "object",
  "additionalProperties": false,
  "required": ["zoomMode", "zoomPermille", "page", "revision", "query", "matchCase", "active"],
  "properties": {
    "zoomMode": { "type": "string", "x-semio-state": "transient" },
    "zoomPermille": { "type": "integer", "minimum": 0, "x-semio-state": "transient" },
    "page": { "type": "integer", "minimum": 0, "x-semio-state": "transient" },
    "revision": { "type": "integer", "minimum": 0, "x-semio-state": "transient" },
    "query": { "type": "string", "x-semio-state": "transient" },
    "matchCase": { "type": "boolean", "x-semio-state": "transient" },
    "active": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }], "x-semio-state": "transient" }
  }
}
