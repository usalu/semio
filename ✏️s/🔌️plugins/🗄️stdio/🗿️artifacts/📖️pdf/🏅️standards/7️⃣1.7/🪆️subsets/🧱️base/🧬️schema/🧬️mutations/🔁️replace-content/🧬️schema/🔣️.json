{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/replace-content/schema.json",
  "title": "ReplaceContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "at",
    "op"
  ],
  "properties": {
    "mutation": {
      "const": "replaceContent",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Index of the page, counted from 0.",
          "de": "Index der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Operator",
          "de": "Operator"
        },
        "description": {
          "en": "Index of the operator in the page's content stream, counted from 0.",
          "de": "Index des Operators im Inhaltsstrom der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "op": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfOp",
      "x-semio-ui": {
        "label": {
          "en": "Content operator",
          "de": "Inhaltsoperator"
        },
        "description": {
          "en": "Content stream operator with its operands.",
          "de": "Operator des Inhaltsstroms mit seinen Operanden."
        }
      }
    }
  }
}
