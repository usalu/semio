{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://s.stdio.pdf.1.7.base.recursive-value",
  "title": "PdfRecursiveValue",
  "oneOf": [
    {
      "$ref": "#/$defs/color"
    },
    {
      "$ref": "#/$defs/function"
    },
    {
      "$ref": "#/$defs/action"
    },
    {
      "$ref": "#/$defs/outline"
    },
    {
      "$ref": "#/$defs/form"
    },
    {
      "$ref": "#/$defs/date"
    }
  ],
  "$defs": {
    "color": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "deviceGray",
                "deviceRgb"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base"
          ],
          "properties": {
            "kind": {
              "const": "pattern"
            },
            "base": {
              "$ref": "#/$defs/color"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "alternate",
            "tintTransform"
          ],
          "properties": {
            "kind": {
              "const": "separation"
            },
            "name": {
              "type": "string"
            },
            "alternate": {
              "$ref": "#/$defs/color"
            },
            "tintTransform": {
              "$ref": "#/$defs/function"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "names",
            "alternate",
            "tintTransform",
            "attributes"
          ],
          "properties": {
            "kind": {
              "const": "deviceN"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "alternate": {
              "$ref": "#/$defs/color"
            },
            "tintTransform": {
              "$ref": "#/$defs/function"
            },
            "attributes": {
              "type": "null"
            }
          }
        }
      ]
    },
    "function": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "domain",
            "range",
            "c0",
            "c1",
            "n"
          ],
          "properties": {
            "kind": {
              "const": "exponential"
            },
            "domain": {
              "type": "array",
              "items": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/Binary64Transport"
              }
            },
            "range": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/Binary64Transport"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "c0": {
              "type": "array",
              "items": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/Binary64Transport"
              }
            },
            "c1": {
              "type": "array",
              "items": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/Binary64Transport"
              }
            },
            "n": {
              "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/Binary64Transport"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "functions"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "functions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/function"
              }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "uri"
                },
                "uri": {
                  "type": "string"
                },
                "isMap": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "uri",
                "isMap"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "named"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name"
              ]
            }
          ]
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "required": [
        "kind"
      ]
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "italic": {
          "type": "boolean"
        },
        "bold": {
          "type": "boolean"
        },
        "open": {
          "type": "boolean"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outline"
          }
        }
      },
      "required": [
        "title",
        "italic",
        "bold",
        "open"
      ]
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "container"
            }
          },
          "required": [
            "kind"
          ]
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/form"
          }
        }
      },
      "required": [
        "name",
        "kind",
        "flags"
      ]
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "year": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "month": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "second": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "second"
      ]
    }
  }
}
