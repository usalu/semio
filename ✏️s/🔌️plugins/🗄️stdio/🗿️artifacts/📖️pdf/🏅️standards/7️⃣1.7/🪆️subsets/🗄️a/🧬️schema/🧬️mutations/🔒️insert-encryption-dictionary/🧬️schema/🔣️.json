{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/a/mutation/insert-encryption-dictionary/schema.json",
  "title": "InsertEncryptionDictionary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "version",
    "revision"
  ],
  "properties": {
    "mutation": {
      "const": "insertEncryptionDictionary",
      "description": "Aggregate discriminator spliced in by PdfAMutation; absent when the payload stands alone."
    },
    "version": {
      "type": "integer",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Algorithm version (V)",
          "de": "Algorithmusversion (V)"
        },
        "description": {
          "en": "V entry of the encryption dictionary: 1, 2, 4 or 5.",
          "de": "Eintrag V des Verschlüsselungswörterbuchs: 1, 2, 4 oder 5."
        },
        "step": 1,
        "precision": 0,
        "softMin": 0,
        "softMax": 5,
        "group": "value",
        "order": 10
      }
    },
    "revision": {
      "type": "integer",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Revision (R)",
          "de": "Revision (R)"
        },
        "description": {
          "en": "R entry of the standard security handler: 2 to 6.",
          "de": "Eintrag R des Standard-Sicherheitshandlers: 2 bis 6."
        },
        "step": 1,
        "precision": 0,
        "softMin": 2,
        "softMax": 6,
        "group": "value",
        "order": 20
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "index"
        ],
        "properties": {
          "id": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/ObjRef"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Placements",
          "de": "Platzierungen"
        },
        "description": {
          "en": "Object number and list position of each created object, in creation order; absent objects take the next free number and are appended.",
          "de": "Objektnummer und Listenposition jedes erzeugten Objekts in Erzeugungsreihenfolge; fehlende Objekte erhalten die nächste freie Nummer und werden angehängt."
        },
        "group": "target",
        "order": 30
      }
    }
  }
}
