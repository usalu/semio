{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/remove-object/schema.json",
  "title": "RemoveObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id"
  ],
  "properties": {
    "mutation": {
      "const": "removeObject",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "id": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/ObjRef",
      "x-semio-ui": {
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "Object and generation number of the indirect object.",
          "de": "Objekt- und Generationsnummer des indirekten Objekts."
        },
        "group": "target",
        "order": 10
      }
    },
    "admittedStreamRoles": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "removed": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "modified": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "value": {
                    "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfAdmittedStreamRole"
                  }
                },
                "required": [
                  "index",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "added": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "value": {
                    "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfAdmittedStreamRole"
                  }
                },
                "required": [
                  "index",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  }
