{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/vt/mutation/set-dpart-metadata/schema.json",
  "title": "SetDpartMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "job"
  ],
  "properties": {
    "mutation": {
      "const": "setDpartMetadata",
      "description": "Aggregate discriminator spliced in by PdfVtMutation; absent when the payload stands alone."
    },
    "job": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Job name",
          "de": "Auftragsname"
        },
        "description": {
          "en": "Name of the PDF/VT document part job.",
          "de": "Name des PDF/VT-Auftrags der Dokumentteile."
        }
      }
    }
  }
}
