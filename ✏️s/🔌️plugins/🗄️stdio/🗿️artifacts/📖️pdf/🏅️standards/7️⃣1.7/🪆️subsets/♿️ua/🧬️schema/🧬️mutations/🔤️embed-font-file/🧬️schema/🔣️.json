{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/ua/mutation/embed-font-file/schema.json",
  "title": "EmbedFontFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "descriptorOrdinal",
    "key",
    "program"
  ],
  "properties": {
    "mutation": {
      "const": "embedFontFile",
      "description": "Aggregate discriminator spliced in by PdfUaMutation; absent when the payload stands alone."
    },
    "descriptorOrdinal": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Font descriptor",
          "de": "Schriftdeskriptor"
        },
        "description": {
          "en": "Index of the font descriptor in document order, counted from 0.",
          "de": "Index des Schriftdeskriptors in Dokumentreihenfolge, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "key": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Font file key",
          "de": "Schlüssel der Schriftdatei"
        },
        "description": {
          "en": "Descriptor entry that carries the font program: FontFile, FontFile2 or FontFile3.",
          "de": "Deskriptoreintrag, der das Schriftprogramm trägt: FontFile, FontFile2 oder FontFile3."
        },
        "group": "target",
        "order": 20
      }
    },
    "program": {
      "$ref": "#/$defs/ObjRef",
      "x-semio-ui": {
        "label": {
          "en": "Font program",
          "de": "Schriftprogramm"
        },
        "description": {
          "en": "Object and generation number of the stream that holds the embedded font program.",
          "de": "Objekt- und Generationsnummer des Datenstroms mit dem eingebetteten Schriftprogramm."
        },
        "group": "target",
        "order": 30
      }
    },
    "entryIndex": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Entry position",
          "de": "Eintragsposition"
        },
        "description": {
          "en": "Position the dictionary entry takes when it does not exist yet, counted from 0; absent appends.",
          "de": "Position, die der Wörterbucheintrag einnimmt, wenn er noch nicht existiert, ab 0 gezählt; fehlt sie, wird angehängt."
        },
        "group": "target",
        "order": 40,
        "widget": "stepper",
        "step": 1,
        "precision": 0
      }
    }
  },
  "$defs": {
    "ObjRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "gen"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Object number",
              "de": "Objektnummer"
            }
          }
        },
        "gen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Generation number",
              "de": "Generationsnummer"
            }
          }
        }
      }
    }
  }
}
