{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pdf/1.7/ua/mutation/embed-font-file/schema.json",
  "title": "EmbedFontFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptorOrdinal",
    "key",
    "program"
  ],
  "properties": {
    "descriptorOrdinal": {
      "type": "integer",
      "minimum": 0
    },
    "key": {
      "type": "string"
    },
    "program": {
      "$ref": "#/$defs/ObjRef"
    },
    "mutation": {
      "const": "embedFontFile",
      "description": "Aggregate discriminator spliced in by PdfUaMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "ObjRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "gen"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "gen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    }
  }
}
