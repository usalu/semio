{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/ua/mutation/embed-font-file/schema.json",
  "title": "EmbedFontFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "descriptorOrdinal",
    "key",
    "program"
  ],
  "properties": {
    "mutation": {
      "const": "embedFontFile",
      "description": "Aggregate discriminator spliced in by PdfUaMutation; absent when the payload stands alone."
    },
    "descriptorOrdinal": {
      "type": "integer",
      "minimum": 0
    },
    "key": {
      "type": "string"
    },
    "program": {
      "$ref": "#/$defs/ObjRef"
    }
  },
  "$defs": {
    "ObjRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "gen"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Object number",
              "de": "Objektnummer"
            }
          }
        },
        "gen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Generation number",
              "de": "Generationsnummer"
            }
          }
        }
      }
    }
  }
}
