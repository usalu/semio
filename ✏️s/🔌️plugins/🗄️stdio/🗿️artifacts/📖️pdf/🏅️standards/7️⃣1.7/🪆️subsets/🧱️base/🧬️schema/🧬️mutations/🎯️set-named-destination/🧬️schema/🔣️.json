{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/set-named-destination/schema.json",
  "title": "SetNamedDestination",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "destination"
  ],
  "properties": {
    "mutation": {
      "const": "setNamedDestination",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "destination": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfNamedDestination",
      "x-semio-ui": {
        "label": {
          "en": "Destination",
          "de": "Ziel"
        }
      }
    },
    "index": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position the item takes when it does not exist yet, counted from 0; absent appends.",
          "de": "Position, die der Eintrag einnimmt, wenn er noch nicht existiert, ab 0 gezählt; fehlt sie, wird angehängt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 40
      }
    }
  }
}
