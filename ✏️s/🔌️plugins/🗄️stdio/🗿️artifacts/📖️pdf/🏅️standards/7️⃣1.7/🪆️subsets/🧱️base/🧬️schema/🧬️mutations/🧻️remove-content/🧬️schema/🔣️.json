{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/remove-content/schema.json",
  "title": "RemoveContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "at",
    "count"
  ],
  "properties": {
    "mutation": {
      "const": "removeContent",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Index of the page, counted from 0.",
          "de": "Index der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "First operator",
          "de": "Erster Operator"
        },
        "description": {
          "en": "Index of the first operator that is removed, counted from 0.",
          "de": "Index des ersten Operators, der entfernt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Operator count",
          "de": "Anzahl Operatoren"
        },
        "description": {
          "en": "Number of consecutive operators that are removed.",
          "de": "Anzahl aufeinanderfolgender Operatoren, die entfernt werden."
        },
        "step": 1,
        "precision": 0,
        "softMin": 1,
        "group": "value",
        "order": 30
      }
    }
  }
}
