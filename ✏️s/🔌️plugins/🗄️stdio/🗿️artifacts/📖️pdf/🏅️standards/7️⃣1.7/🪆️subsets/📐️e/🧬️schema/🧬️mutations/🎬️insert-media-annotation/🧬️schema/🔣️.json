{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/e/mutation/insert-media-annotation/schema.json",
  "title": "InsertMediaAnnotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "subtype",
    "title"
  ],
  "properties": {
    "mutation": {
      "const": "insertMediaAnnotation",
      "description": "Aggregate discriminator spliced in by PdfEMutation; absent when the payload stands alone."
    },
    "subtype": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Annotation subtype",
          "de": "Anmerkungsuntertyp"
        },
        "description": {
          "en": "Subtype of the media annotation: Movie, Sound, Screen or 3D.",
          "de": "Untertyp der Medienanmerkung: Movie, Sound, Screen oder 3D."
        },
        "group": "value",
        "order": 10
      }
    },
    "title": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Title",
          "de": "Titel"
        },
        "description": {
          "en": "Title (T entry) of the media annotation.",
          "de": "Titel (Eintrag T) der Medienanmerkung."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
