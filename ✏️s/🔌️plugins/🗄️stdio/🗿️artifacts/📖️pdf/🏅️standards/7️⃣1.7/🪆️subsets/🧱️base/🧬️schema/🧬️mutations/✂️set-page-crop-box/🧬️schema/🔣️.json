{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/set-page-crop-box/schema.json",
  "title": "SetPageCropBox",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "setPageCropBox",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Page",
          "de": "Seite"
        },
        "description": {
          "en": "Index of the page, counted from 0.",
          "de": "Index der Seite, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "cropBox": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/Binary64Transport"
          },
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "vector",
        "label": {
          "en": "Crop box",
          "de": "Maskenrahmen (CropBox)"
        },
        "description": {
          "en": "Visible region of the page as [llx lly urx ury].",
          "de": "Sichtbarer Bereich der Seite als [llx lly urx ury]."
        },
        "unit": "pt"
      }
    }
  }
}
