{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pdf/1.7/base/mutation/set-page-crop-box/schema.json",
  "title": "SetPageCropBox",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "cropBox": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "mutation": {
      "const": "setPageCropBox",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    }
  }
}
