dialect grammar
grammar stdio.pdf.1.7.snapshot
extension pdf
start document

# The Semio envelope precedes this complete owned record body.
# The authored RecordSpec enforces requiredness and canonical typed field reconstruction.
document = "stdio.pdf.1.7" field*
field = text-field / value-field
text-field = ("schema" / "declaredVersion") "=" (STRING / IDENT)
value-field = value-key "=" value
value-key = "pages" / "fonts" / "images" / "forms" / "extGStates" / "shadings" / "patterns" / "colorSpaces" / "properties" / "outlines" / "namedDestinations" / "pageLabels" / "embeddedFiles" / "outputIntents" / "acroForm" / "optionalContent" / "pageLayout" / "pageMode" / "viewerPreferences" / "openAction" / "language" / "markInfo" / "metadata" / "documentId" / "encryption" / "info" / "catalogExtra" / "objects" / "trailer" / "admittedStreamRoles"
value = "null" / "true" / "false" / number / STRING / bytes / array / object
array = "[" value* "]"
object = "{" member* "}"
member = IDENT "=" value
number = INT / FLOAT / IDENT
# Exceptional IEEE words are IDENT tokens; the typed scalar parser validates their exact bits.
bytes = "bytes64" "(" STRING ")"
