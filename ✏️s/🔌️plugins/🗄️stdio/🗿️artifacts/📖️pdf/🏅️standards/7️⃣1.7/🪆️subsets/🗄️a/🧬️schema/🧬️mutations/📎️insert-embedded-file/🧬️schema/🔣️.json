{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/a/mutation/insert-embedded-file/schema.json",
  "title": "InsertEmbeddedFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "fileName"
  ],
  "properties": {
    "mutation": {
      "const": "insertEmbeddedFile",
      "description": "Aggregate discriminator spliced in by PdfAMutation; absent when the payload stands alone."
    },
    "fileName": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "File name",
          "de": "Dateiname"
        },
        "description": {
          "en": "Name the embedded file is listed under.",
          "de": "Name, unter dem die eingebettete Datei geführt wird."
        },
        "group": "value",
        "order": 10
      }
    }
  }
}
