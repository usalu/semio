{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pdf/1.7/base/mutation/remove-dict-entry/schema.json",
  "title": "RemoveDictEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "path",
    "key"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/ObjRef"
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PdfPathSegment"
      }
    },
    "key": {
      "type": "string"
    },
    "mutation": {
      "const": "removeDictEntry",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "ObjRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num",
        "gen"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "gen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "PdfPathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "index"
          ],
          "properties": {
            "kind": {
              "const": "arrayIndex"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "dictKey"
            },
            "key": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
