{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pdf/1.7/x/mutation/set-trim-box/schema.json",
  "title": "SetTrimBox",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageIndex",
    "trimBox"
  ],
  "properties": {
    "pageIndex": {
      "type": "integer",
      "minimum": 0
    },
    "trimBox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "mutation": {
      "const": "setTrimBox",
      "description": "Aggregate discriminator spliced in by PdfXMutation; absent when the payload stands alone."
    }
  }
}
