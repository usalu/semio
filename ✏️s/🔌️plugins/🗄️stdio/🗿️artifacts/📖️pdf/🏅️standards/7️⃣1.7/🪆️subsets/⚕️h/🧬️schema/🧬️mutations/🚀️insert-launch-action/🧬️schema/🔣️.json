{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/h/mutation/insert-launch-action/schema.json",
  "title": "InsertLaunchAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "target"
  ],
  "properties": {
    "mutation": {
      "const": "insertLaunchAction",
      "description": "Aggregate discriminator spliced in by PdfHMutation; absent when the payload stands alone."
    },
    "target": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Launch target",
          "de": "Startziel"
        },
        "description": {
          "en": "File or application the Launch action opens.",
          "de": "Datei oder Anwendung, die die Launch-Aktion öffnet."
        },
        "group": "value",
        "order": 10
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "index"
        ],
        "properties": {
          "id": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/snapshot.json#/$defs/ObjRef"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "x-semio-ui": {
        "label": {
          "en": "Placements",
          "de": "Platzierungen"
        },
        "description": {
          "en": "Object number and list position of each created object, in creation order; absent objects take the next free number and are appended.",
          "de": "Objektnummer und Listenposition jedes erzeugten Objekts in Erzeugungsreihenfolge; fehlende Objekte erhalten die nächste freie Nummer und werden angehängt."
        },
        "group": "target",
        "order": 20
      }
    }
  }
}
