{
  "$id": "https://semio.tech/schema/s.stdio.pdf.1.7/diff.json",
  "title": "PdfDiff",
  "$defs": {
    "ObjRef": {
      "type": "object",
      "required": ["num", "gen"],
      "properties": { "num": { "type": "integer" }, "gen": { "type": "integer" } }
    },
    "PdfObject": { "type": "object", "required": ["kind"] },
    "PdfStreamFilter": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string", "enum": ["flate", "asciiHex", "ascii85", "runLength"] }, "predictor": { "type": "object" } } },
    "PdfInfo": {
      "type": "object",
      "properties": {
        "title": { "type": "string" }, "author": { "type": "string" }, "subject": { "type": "string" },
        "keywords": { "type": "string" }, "creator": { "type": "string" }, "producer": { "type": "string" }
      }
    },
    "PdfPage": {
      "type": "object",
      "properties": {
        "mediaBox": { "type": "array", "items": { "type": "number" } },
        "cropBox": { "type": "array", "items": { "type": "number" } },
        "rotate": { "type": "integer" },
        "text": { "type": "string" }
      }
    },
    "PdfPageDiff": {
      "type": "object",
      "properties": {
        "mediaBox": { "type": "array", "items": { "type": "number" } },
        "cropBox": { "type": ["array", "null"], "items": { "type": "number" } },
        "rotate": { "type": "integer" },
        "text": { "type": "string" }
      }
    },
    "PdfPageModified": { "type": "object", "required": ["index", "diff"], "properties": { "index": { "type": "integer" }, "diff": { "$ref": "#/$defs/PdfPageDiff" } } },
    "PdfPageAdded": { "type": "object", "required": ["index", "page"], "properties": { "index": { "type": "integer" }, "page": { "$ref": "#/$defs/PdfPage" } } },
    "PdfPagesDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer" } },
        "modified": { "type": "array", "items": { "$ref": "#/$defs/PdfPageModified" } },
        "added": { "type": "array", "items": { "$ref": "#/$defs/PdfPageAdded" } }
      }
    },
    "PdfDictModified": { "type": "object", "required": ["key", "diff"], "properties": { "key": { "type": "string" }, "diff": { "$ref": "#/$defs/PdfValueDiff" } } },
    "PdfDictAdded": { "type": "object", "required": ["index", "key", "item"], "properties": { "index": { "type": "integer" }, "key": { "type": "string" }, "item": { "$ref": "#/$defs/PdfObject" } } },
    "PdfDictDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "string" } },
        "modified": { "type": "array", "items": { "$ref": "#/$defs/PdfDictModified" } },
        "added": { "type": "array", "items": { "$ref": "#/$defs/PdfDictAdded" } }
      }
    },
    "PdfArrayModified": { "type": "object", "required": ["index", "diff"], "properties": { "index": { "type": "integer" }, "diff": { "$ref": "#/$defs/PdfValueDiff" } } },
    "PdfArrayAdded": { "type": "object", "required": ["index", "item"], "properties": { "index": { "type": "integer" }, "item": { "$ref": "#/$defs/PdfObject" } } },
    "PdfArrayDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer" } },
        "modified": { "type": "array", "items": { "$ref": "#/$defs/PdfArrayModified" } },
        "added": { "type": "array", "items": { "$ref": "#/$defs/PdfArrayAdded" } }
      }
    },
    "PdfValueDiff": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["replace", "bool", "int", "real", "str", "name", "ref", "array", "dict", "stream"] },
        "value": {},
        "diff": {},
        "dict": { "$ref": "#/$defs/PdfDictDiff" },
        "data": { "type": "array", "items": { "type": "integer" } },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/PdfStreamFilter" } }
      }
    },
    "PdfObjectModified": { "type": "object", "required": ["id", "diff"], "properties": { "id": { "$ref": "#/$defs/ObjRef" }, "diff": { "$ref": "#/$defs/PdfValueDiff" } } },
    "PdfObjectAdded": { "type": "object", "required": ["index", "id", "value"], "properties": { "index": { "type": "integer" }, "id": { "$ref": "#/$defs/ObjRef" }, "value": { "$ref": "#/$defs/PdfObject" } } },
    "PdfObjectsDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "$ref": "#/$defs/ObjRef" } },
        "modified": { "type": "array", "items": { "$ref": "#/$defs/PdfObjectModified" } },
        "added": { "type": "array", "items": { "$ref": "#/$defs/PdfObjectAdded" } }
      }
    },
    "PdfPathSegment": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "type": "string", "enum": ["arrayIndex", "dictKey"] }, "index": { "type": "integer" }, "key": { "type": "string" } }
    }
  },
  "type": "object",
  "properties": {
    "declaredVersion": { "type": "string", "x-semio-state": "artifact" },
    "info": { "$ref": "#/$defs/PdfInfo", "x-semio-state": "artifact" },
    "pages": { "$ref": "#/$defs/PdfPagesDiff", "x-semio-state": "artifact" },
    "objects": { "$ref": "#/$defs/PdfObjectsDiff", "x-semio-state": "artifact" },
    "trailer": { "$ref": "#/$defs/PdfDictDiff", "x-semio-state": "artifact" }
  }
}
