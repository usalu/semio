{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pdf/1.7/base/diff.json",
  "title": "PdfDiff",
  "$defs": {
    "PdfPageDiff": {
      "type": "object",
      "properties": {
        "mediaBox": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "cropBox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          }
        },
        "rotate": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "PdfPageModified": {
      "type": "object",
      "required": [
        "index",
        "diff"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "diff": {
          "$ref": "#/$defs/PdfPageDiff"
        }
      }
    },
    "PdfPageAdded": {
      "type": "object",
      "required": [
        "index",
        "page"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "page": {
          "$ref": "https://semio.tech/schema/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfPage"
        }
      }
    },
    "PdfPagesDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PdfPageModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PdfPageAdded"
          }
        }
      }
    },
    "PdfDictModified": {
      "type": "object",
      "required": [
        "key",
        "diff"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "diff": {
          "$ref": "#/$defs/PdfValueDiff"
        }
      }
    },
    "PdfDictAdded": {
      "type": "object",
      "required": [
        "index",
        "key",
        "item"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "item": {
          "$ref": "https://semio.tech/schema/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfObject"
        }
      }
    },
    "PdfDictDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PdfDictModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PdfDictAdded"
          }
        }
      }
    },
    "PdfArrayModified": {
      "type": "object",
      "required": [
        "index",
        "diff"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "diff": {
          "$ref": "#/$defs/PdfValueDiff"
        }
      }
    },
    "PdfArrayAdded": {
      "type": "object",
      "required": [
        "index",
        "item"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "item": {
          "$ref": "https://semio.tech/schema/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfObject"
        }
      }
    },
    "PdfArrayDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PdfArrayModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PdfArrayAdded"
          }
        }
      }
    },
    "PdfValueDiff": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "replace",
            "bool",
            "int",
            "real",
            "str",
            "name",
            "ref",
            "array",
            "dict",
            "stream"
          ]
        },
        "value": {},
        "diff": {},
        "dict": {
          "$ref": "#/$defs/PdfDictDiff"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfStreamFilter"
          }
        }
      }
    },
    "PdfObjectModified": {
      "type": "object",
      "required": [
        "id",
        "diff"
      ],
      "properties": {
        "id": {
          "$ref": "https://semio.tech/schema/s/stdio/pdf/1.7/base/snapshot.json#/$defs/ObjRef"
        },
        "diff": {
          "$ref": "#/$defs/PdfValueDiff"
        }
      }
    },
    "PdfObjectAdded": {
      "type": "object",
      "required": [
        "index",
        "id",
        "value"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "id": {
          "$ref": "https://semio.tech/schema/s/stdio/pdf/1.7/base/snapshot.json#/$defs/ObjRef"
        },
        "value": {
          "$ref": "https://semio.tech/schema/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfObject"
        }
      }
    },
    "PdfObjectsDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/stdio/pdf/1.7/base/snapshot.json#/$defs/ObjRef"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PdfObjectModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PdfObjectAdded"
          }
        }
      }
    },
    "PdfPathSegment": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "arrayIndex",
            "dictKey"
          ]
        },
        "index": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "declaredVersion": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "info": {
      "$ref": "https://semio.tech/schema/s/stdio/pdf/1.7/base/snapshot.json#/$defs/PdfInfo",
      "x-semio-state": "artifact"
    },
    "pages": {
      "$ref": "#/$defs/PdfPagesDiff",
      "x-semio-state": "artifact"
    },
    "objects": {
      "$ref": "#/$defs/PdfObjectsDiff",
      "x-semio-state": "artifact"
    },
    "trailer": {
      "$ref": "#/$defs/PdfDictDiff",
      "x-semio-state": "artifact"
    }
  }
}
