{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pdf/1.7/base/mutation/set-language/schema.json",
  "title": "SetLanguage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setLanguage",
      "description": "Aggregate discriminator spliced in by PdfMutation; absent when the payload stands alone."
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Document language",
          "de": "Dokumentsprache"
        },
        "description": {
          "en": "BCP 47 tag of the natural language, e.g. de-DE.",
          "de": "BCP-47-Kennung der natürlichen Sprache, z. B. de-DE."
        }
      }
    }
  }
}
