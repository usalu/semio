(* Owned PDF 1.7 snapshot text; the sibling RecordSpec owns required fields. *)
document = 'stdio.pdf.1.7', { field } ;
field = key, '=', value ;
key = ? exact PDF snapshot root field name from the sibling RecordSpec ? ;
value = string | number | 'true' | 'false' | 'null' | array | object ;
array = '[', { value }, ']' ;
object = '{', { member }, '}' ;
member = ( identifier | string ), '=', value ;
number = ? semio.dsl exact integer or binary64 scalar, including IEEE bit words ? ;
string = ? semio.dsl quoted UTF-8 string with escapes ? ;
identifier = ? semio.dsl unquoted object key ? ;
