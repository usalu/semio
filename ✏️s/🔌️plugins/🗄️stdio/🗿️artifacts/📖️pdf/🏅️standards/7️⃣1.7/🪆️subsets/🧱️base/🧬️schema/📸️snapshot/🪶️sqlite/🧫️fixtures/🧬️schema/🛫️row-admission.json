      "minimum": 1
    },
    "totalRows": {
      "type": "integer",
      "minimum": 1
    },
    "refusedRows": {
      "type": "integer",
      "minimum": 1
    },
    "cancelAt": {
      "type": "integer",
      "minimum": 1
    },
    "counts": {
      "type": "object",
