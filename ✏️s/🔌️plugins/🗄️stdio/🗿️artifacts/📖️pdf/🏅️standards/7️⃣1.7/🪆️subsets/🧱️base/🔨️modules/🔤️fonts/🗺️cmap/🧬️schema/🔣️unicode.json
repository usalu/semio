{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PDF Variable-Width Unicode CMap Witness",
  "type": "object",
  "required": [
    "encoding",
    "toUnicode",
    "text",
    "codes",
    "expected"
  ],
  "properties": {
    "encoding": {
      "type": "string"
    },
    "toUnicode": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "codes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "codeWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "rangeStorage": {
          "type": "integer"
        }
      }
    },
    "sameNumericCode": {
      "type": "object",
      "required": [
        "encoding",
        "toUnicode",
        "cmap",
        "unicode",
        "codes",
        "bytes",
        "widths",
        "spaces",
        "text"
      ],
      "properties": {
        "encoding": {
          "$ref": "#/properties/encoding"
        },
        "toUnicode": {
          "$ref": "#/properties/toUnicode"
        },
        "codes": {
          "$ref": "#/properties/codes"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "widths": {
          "type": "array",
          "items": {
            "$ref": "#/properties/expected/properties/codeWidth"
          }
        },
        "spaces": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "text": {
          "$ref": "#/properties/text"
        }
      }
    }
  },
  "description": "Composite code widths come from Encoding CMap; ToUnicode ranges stay compact and are resolved lazily, including supplementary scalars."
}
