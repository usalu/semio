{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/binary/raw/any/mutation/replace-byte-range/schema.json",
  "title": "ReplaceByteRange",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offset",
    "remove_len",
    "insert"
  ],
  "properties": {
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "remove_len": {
      "type": "integer",
      "minimum": 0
    },
    "insert": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "mutation": {
      "const": "replaceByteRange",
      "description": "Aggregate discriminator spliced in by BinaryMutation; absent when the payload stands alone."
    }
  }
}
