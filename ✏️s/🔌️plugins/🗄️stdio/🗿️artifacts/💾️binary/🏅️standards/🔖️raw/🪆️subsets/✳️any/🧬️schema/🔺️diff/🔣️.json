{
  "$id": "https://semio.tech/schema/s.stdio.binary/diff.json",
  "title": "BinaryDiff",
  "type": "object",
  "definitions": {
    "ByteSplice": {
      "type": "object",
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "removeLen": { "type": "integer", "minimum": 0 },
        "insert": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      },
      "required": ["offset", "removeLen", "insert"]
    }
  },
  "properties": {
    "splices": { "type": "array", "items": { "$ref": "#/definitions/ByteSplice" } }
