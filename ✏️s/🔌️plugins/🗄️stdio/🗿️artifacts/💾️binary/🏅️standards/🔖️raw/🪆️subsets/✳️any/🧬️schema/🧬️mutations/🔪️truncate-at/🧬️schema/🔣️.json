{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/binary/raw/any/mutation/truncate-at/schema.json",
  "title": "TruncateAt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "offset"
  ],
  "properties": {
    "mutation": {
      "const": "truncateAt",
      "description": "Aggregate discriminator spliced in by BinaryMutation; absent when the payload stands alone."
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Byte offset",
          "de": "Byte-Versatz"
        },
        "unit": "B",
        "precision": 0,
        "group": "target",
        "order": 10
      }
    }
  }
}
