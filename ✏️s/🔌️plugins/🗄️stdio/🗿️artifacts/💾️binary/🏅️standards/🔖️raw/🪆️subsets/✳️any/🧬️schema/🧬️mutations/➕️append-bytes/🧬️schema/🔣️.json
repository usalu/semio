{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/binary/raw/any/mutation/append-bytes.json",
  "title": "AppendBytes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "mutation": {
      "const": "appendBytes",
      "description": "Aggregate discriminator spliced in by BinaryMutation; absent when the payload stands alone."
    }
  }
}
