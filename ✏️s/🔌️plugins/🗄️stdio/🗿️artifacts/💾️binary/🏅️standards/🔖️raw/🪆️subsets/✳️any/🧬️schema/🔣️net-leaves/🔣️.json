{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/binary/raw/any/net-mutation/schema.json",
  "title": "BinaryNetMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "offset",
    "removeLen",
    "insert"
  ],
  "properties": {
    "kind": {
      "const": "replace-byte-range"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "removeLen": {
      "type": "integer",
      "minimum": 0
    },
    "insert": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$"
    }
  }
}
