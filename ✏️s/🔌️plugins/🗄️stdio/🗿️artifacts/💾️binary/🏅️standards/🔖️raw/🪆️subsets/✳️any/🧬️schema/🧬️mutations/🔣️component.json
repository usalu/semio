{
  "$id": "https://semio.tech/schema/s.stdio.binary/mutation.json",
  "title": "BinaryMutation",
  "type": "object",
  "properties": {
    "mutation": {
      "type": "string",
      "enum": ["noMutation", "setSnapshot", "splice", "appendBytes", "truncateAt"]
    },
    "snapshot": { "$ref": "../📸️snapshot/🔣️component.json" },
    "offset": { "type": "integer", "minimum": 0 },
    "removeLen": { "type": "integer", "minimum": 0 },
    "insert": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "data": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
  },
  "required": ["mutation"]
}
