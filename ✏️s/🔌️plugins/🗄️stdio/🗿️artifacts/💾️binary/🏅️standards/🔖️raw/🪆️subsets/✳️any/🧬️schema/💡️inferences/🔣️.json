{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/binary/raw/any/inference.json",
  "title": "BinaryInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extent"
  ],
  "properties": {
    "extent": {
      "$ref": "#/$defs/BinaryExtent",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "BinaryExtent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "isEmpty",
        "contentDigest"
      ],
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "isEmpty": {
          "type": "boolean"
        },
        "contentDigest": {
          "type": "string"
        }
      }
    }
  }
}
