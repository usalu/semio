{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/binary/raw/any/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot"
  ],
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/BinarySnapshot"
    },
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by BinaryMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "BinarySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
