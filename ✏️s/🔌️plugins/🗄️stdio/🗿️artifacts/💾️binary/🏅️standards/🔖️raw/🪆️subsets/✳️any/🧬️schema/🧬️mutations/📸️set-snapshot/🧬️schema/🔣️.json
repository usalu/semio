{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/binary/raw/any/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "snapshot"
  ],
  "properties": {
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by BinaryMutation; absent when the payload stands alone."
    },
    "snapshot": {
      "$ref": "#/$defs/BinarySnapshot",
      "x-semio-ui": {
        "label": {
          "en": "Binary content",
          "de": "Binärinhalt"
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "BinarySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Schema",
              "de": "Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema this document follows.",
              "de": "Kennung des Snapshot-Schemas, dem dieses Dokument folgt."
            }
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Bytes",
              "de": "Bytes"
            }
          }
        }
      }
    }
  }
}
