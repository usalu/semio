; abnf stdio.binary snapshot (binary pack layer)
document    = magic token-len token raw-bytes
magic       = %x89 %x53.45.4D %x0D.0A.1A.0A
token-len   = 4OCTET                    ; u32 LE byte count of token
token       = *OCTET                    ; UTF-8 "plugin.artifact.component vN", token-len bytes
raw-bytes   = *OCTET                    ; verbatim BinarySnapshot::bytes -- opaque by spec, to EOF
