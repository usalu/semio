{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bytes",
    "pixels",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "stdio.bmp.source-hex-fixture/v1"
    },
    "bytes": {
      "type": "array",
      "minItems": 54,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "pixels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "valid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
