      },
      "unit": "px",
      "step": 1,
      "precision": 0,
      "group": "region",
      "order": 30
    }},
    "width": {"type": "integer", "minimum": 1, "x-semio-ui": {
      "widget": "stepper",
      "label": {
        "en": "Width",
        "de": "Breite"
      },
      "unit": "px",
      "step": 1,
      "precision": 0,
      "group": "region",
      "order": 40
    }},
    "height": {"type": "integer", "minimum": 1, "x-semio-ui": {
