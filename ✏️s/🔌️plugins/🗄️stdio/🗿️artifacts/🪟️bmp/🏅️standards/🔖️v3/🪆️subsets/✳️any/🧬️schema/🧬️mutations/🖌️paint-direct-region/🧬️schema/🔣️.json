        "de": "Blau"
      },
      "step": 1,
      "precision": 0,
      "group": "color",
      "order": 80
    }},
    "alpha": {"type": "integer", "minimum": 0, "maximum": 255, "x-semio-ui": {
      "widget": "slider",
