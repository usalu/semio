{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/bmp/v3/any/artifact.json",
  "title": "BmpArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bytes"],
  "properties": {
    "schema": {"type": "string", "const": "stdio.bmp", "x-semio-state": "artifact"},
    "bytes": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 255},
      "x-semio-state": "artifact"
    }
  }
}
