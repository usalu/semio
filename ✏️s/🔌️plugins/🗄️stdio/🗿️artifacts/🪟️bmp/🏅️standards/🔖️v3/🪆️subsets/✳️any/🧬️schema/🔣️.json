{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/bmp/v3/any/artifact.json",
  "title": "BmpArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "headerSize",
    "width",
    "height",
    "rowOrder",
    "planes",
    "bitsPerPixel",
    "compression",
    "imageSize",
    "xPixelsPerMeter",
    "yPixelsPerMeter",
    "colorsUsed",
    "colorsImportant",
    "palette",
    "pixels"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "headerSize": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "width": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "rowOrder": {
      "$ref": "https://semio.tech/schema/s/stdio/bmp/v3/any/snapshot.json#/$defs/BmpRowOrder",
      "x-semio-state": "artifact"
    },
    "planes": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "bitsPerPixel": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "compression": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "imageSize": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "xPixelsPerMeter": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "yPixelsPerMeter": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "colorsUsed": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "colorsImportant": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "palette": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/bmp/v3/any/snapshot.json#/$defs/BmpPaletteEntry"
      }
    },
    "pixels": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
