{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/bmp/v3/any/snapshot.json",
  "title": "BmpSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bytes"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "stdio.bmp",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {"en": "Schema", "de": "Schema"}
      }
    },
    "bytes": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 255},
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {"en": "Exact BMP bytes", "de": "Exakte BMP-Bytes"},
        "description": {
          "en": "The complete source file, including reserved fields, palettes, masks, gaps, row padding and trailers.",
          "de": "Die vollständige Quelldatei einschließlich reservierter Felder, Paletten, Masken, Lücken, Zeilenfüllung und Anhänge."
        }
      }
    }
  }
}
