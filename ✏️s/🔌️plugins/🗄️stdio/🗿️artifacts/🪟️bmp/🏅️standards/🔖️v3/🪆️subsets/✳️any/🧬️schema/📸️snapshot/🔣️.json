{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/bmp/v3/any/snapshot.json",
  "title": "BmpSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "headerSize",
    "width",
    "height",
    "rowOrder",
    "planes",
    "bitsPerPixel",
    "compression",
    "imageSize",
    "xPixelsPerMeter",
    "yPixelsPerMeter",
    "colorsUsed",
    "colorsImportant",
    "palette",
    "pixels"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Schema",
          "de": "Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema this document follows.",
          "de": "Kennung des Snapshot-Schemas, dem dieses Dokument folgt."
        }
      }
    },
    "headerSize": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Header size",
          "de": "Headergröße"
        },
        "description": {
          "en": "biSize: 40 for BITMAPINFOHEADER.",
          "de": "biSize: 40 für BITMAPINFOHEADER."
        },
        "unit": "B"
      }
    },
    "width": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Width",
          "de": "Breite"
        },
        "unit": "px"
      }
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Height",
          "de": "Höhe"
        },
        "unit": "px"
      }
    },
    "rowOrder": {
      "$ref": "#/$defs/BmpRowOrder",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Row order",
          "de": "Zeilenreihenfolge"
        }
      }
    },
    "planes": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Color planes",
          "de": "Farbebenen"
        },
        "description": {
          "en": "Always 1.",
          "de": "Immer 1."
        }
      }
    },
    "bitsPerPixel": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Bits per pixel",
          "de": "Bits pro Pixel"
        },
        "description": {
          "en": "Color depth: 1, 4, 8, 16, 24 or 32.",
          "de": "Farbtiefe: 1, 4, 8, 16, 24 oder 32."
        }
      }
    },
    "compression": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Compression",
          "de": "Kompression"
        },
        "description": {
          "en": "biCompression, e.g. 0 = BI_RGB, 1 = BI_RLE8.",
          "de": "biCompression, z. B. 0 = BI_RGB, 1 = BI_RLE8."
        }
      }
    },
    "imageSize": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Image size",
          "de": "Bildgröße"
        },
        "unit": "B"
      }
    },
    "xPixelsPerMeter": {
      "type": "integer",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Horizontal resolution",
          "de": "Horizontale Auflösung"
        },
        "unit": "px/m"
      }
    },
    "yPixelsPerMeter": {
      "type": "integer",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Vertical resolution",
          "de": "Vertikale Auflösung"
        },
        "unit": "px/m"
      }
    },
    "colorsUsed": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Colors used",
          "de": "Verwendete Farben"
        }
      }
    },
    "colorsImportant": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Important colors",
          "de": "Wichtige Farben"
        }
      }
    },
    "palette": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/BmpPaletteEntry"
      },
      "x-semio-ui": {
        "label": {
          "en": "Palette",
          "de": "Palette"
        }
      }
    },
    "pixels": {
      "type": "array",
      "x-semio-state": "artifact",
      "description": "Canonical 8-bit RGBA, width*height*4 bytes, row 0 = image top.",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "x-semio-ui": {
        "label": {
          "en": "Pixels",
          "de": "Pixel"
        },
        "description": {
          "en": "Canonical 8-bit RGBA, width × height × 4 bytes, row 0 at the top.",
          "de": "Kanonisches 8-Bit-RGBA, Breite × Höhe × 4 Bytes, Zeile 0 oben."
        }
      }
    }
  },
  "$defs": {
    "BmpRowOrder": {
      "type": "string",
      "enum": [
        "bottomUp",
        "topDown"
      ],
      "x-semio-ui": {
        "options": {
          "bottomUp": {
            "en": "Bottom-up",
            "de": "Von unten nach oben"
          },
          "topDown": {
            "en": "Top-down",
            "de": "Von oben nach unten"
          }
        }
      }
    },
    "BmpPaletteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b",
        "g",
        "r",
        "reserved"
      ],
      "properties": {
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "label": {
              "en": "Reserved",
              "de": "Reserviert"
            }
          }
        }
      }
    }
  }
}
