dialect protocol
protocol stdio.bmp.mutations
version 1
schema stdio.bmp.op
start op
framing record

# Real op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload (its leaf's `💾️binary` codec).
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: every leaf
# codec derives its tag from its record at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record change-header-fields tag=2
field payload bytes
record insert-palette-entry tag=3
field payload bytes
record remove-palette-entry tag=4
field payload bytes
record replace-palette-entry tag=5
field payload bytes
record replace-pixel-data tag=6
field payload bytes
