{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/bmp/v3/any/diff.json",
  "title": "BmpDiff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/bmp/v3/any/snapshot.json#/definitions/image",
      "x-semio-state": "artifact"
    },
    "rects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rect"
      },
      "x-semio-state": "artifact"
    }
  },
  "definitions": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region"
      ],
      "properties": {
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "red",
              "green",
              "blue",
              "alpha",
              "reserved"
            ],
            "properties": {
              "red": {
                "type": "integer",
                "minimum": 0
              },
              "green": {
                "type": "integer",
                "minimum": 0
              },
              "blue": {
                "type": "integer",
                "minimum": 0
              },
              "alpha": {
                "type": "integer",
                "minimum": 0
              },
              "reserved": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
