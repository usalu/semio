semio stdio.bmp.dsl v1
schema=stdio.bmp
image {
  width=2 height=1 row-order=bottom-up profile=indexed-rgb4 masks=0,0,0,0 x-pixels-per-meter=0 y-pixels-per-meter=0 colors-used=2 colors-important=0 reserved-1=0 reserved-2=0 palette=[ { b=60 g=40 r=20 reserved=7 } { b=60 g=40 r=20 reserved=11 } ]
  pixels {
    indexed indices=[ 1 1 ]
  }
  opaque-gap=[ ] opaque-trailer=[ ]
}
