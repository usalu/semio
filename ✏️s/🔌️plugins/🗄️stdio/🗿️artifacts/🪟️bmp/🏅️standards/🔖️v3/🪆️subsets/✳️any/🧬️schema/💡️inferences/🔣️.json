{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/bmp/v3/any/inference.json",
  "title": "BmpInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dimensions"
  ],
  "properties": {
    "dimensions": {
      "$ref": "#/$defs/BmpDimensions",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "BmpDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "bitDepth",
        "hasAlpha",
        "pixelCount"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "bitDepth": {
          "type": "integer",
          "minimum": 0
        },
        "hasAlpha": {
          "type": "boolean"
        },
        "pixelCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
