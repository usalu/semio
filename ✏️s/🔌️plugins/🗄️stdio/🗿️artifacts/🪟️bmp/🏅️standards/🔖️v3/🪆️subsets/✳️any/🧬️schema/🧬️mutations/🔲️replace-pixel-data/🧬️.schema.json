{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pixels"
  ],
  "properties": {
    "pixels": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  },
  "$defs": {
    "BmpRowOrder": {
      "type": "string",
      "enum": [
        "bottomUp",
        "topDown"
      ]
    },
    "BmpPaletteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b",
        "g",
        "r",
        "reserved"
      ],
      "properties": {
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  },
  "title": "ReplacePixelDataMutation"
}
