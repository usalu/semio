{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.stdio.bmp.command.paint-region.v1",
  "title": "Paint BMP Region",
  "oneOf": [
    { "$ref": "#/$defs/indexed" },
    { "$ref": "#/$defs/direct" }
  ],
  "$defs": {
    "region": {
      "type": "object",
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "y": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "width": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65536 }
      },
      "required": ["x", "y", "width", "height"]
    },
    "indexed": {
      "allOf": [
        { "$ref": "#/$defs/region" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": true,
            "y": true,
            "width": true,
            "height": true,
            "paletteIndex": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "required": ["paletteIndex"]
        }
      ]
    },
    "direct": {
      "allOf": [
        { "$ref": "#/$defs/region" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": true,
            "y": true,
            "width": true,
            "height": true,
            "red": { "type": "integer", "minimum": 0, "maximum": 255 },
            "green": { "type": "integer", "minimum": 0, "maximum": 255 },
            "blue": { "type": "integer", "minimum": 0, "maximum": 255 },
            "alpha": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "required": ["red", "green", "blue", "alpha"]
        }
      ]
    }
  }
}
