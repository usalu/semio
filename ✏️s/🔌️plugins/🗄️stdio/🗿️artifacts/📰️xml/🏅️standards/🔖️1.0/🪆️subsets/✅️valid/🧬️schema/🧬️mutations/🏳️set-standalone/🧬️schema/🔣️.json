{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/valid/mutation/set-standalone/schema.json",
  "title": "SetStandalone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setStandalone",
      "description": "Aggregate discriminator spliced in by XmlValidMutation; absent when the payload stands alone."
    },
    "standalone": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "toggle",
        "label": {
          "en": "Standalone document",
          "de": "Standalone-Dokument"
        },
        "description": {
          "en": "Declares that no external markup declaration affects the document content.",
          "de": "Erklärt, dass keine externe Markup-Deklaration den Dokumentinhalt beeinflusst."
        }
      }
    }
  }
}
