{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/mutation/set-text/schema.json",
  "title": "SetTextPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "text"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Text path",
          "de": "Textpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the text node, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Textknoten, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "text": {
      "type": "string",
      "x-semio-ui": {
        "widget": "multiline",
        "role": "value",
        "label": {
          "en": "Text",
          "de": "Text"
        },
        "description": {
          "en": "Character data the text node holds afterwards.",
          "de": "Zeichendaten, die der Textknoten danach enthält."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "SetTextMutation": {
      "description": "The whole wire of SetTextMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/diff.json"
            }
          }
        }
      ]
    }
  }
}
