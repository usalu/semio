{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/mutation/set-declaration/schema.json",
  "title": "SetDeclarationPayload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "declaration": {
      "anyOf": [
        {
          "$ref": "#/$defs/XmlDeclaration"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "XML declaration",
          "de": "XML-Deklaration"
        }
      }
    }
  },
  "$defs": {
    "XmlDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Encoding",
              "de": "Zeichenkodierung"
            },
            "description": {
              "en": "Encoding name written in the XML declaration, e.g. UTF-8.",
              "de": "In der XML-Deklaration angegebene Zeichenkodierung, z. B. UTF-8."
            }
          }
        },
        "standalone": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Standalone document",
              "de": "Standalone-Dokument"
            },
            "description": {
              "en": "Declares that no external markup declaration affects the document content.",
              "de": "Erklärt, dass keine externe Markup-Deklaration den Dokumentinhalt beeinflusst."
            }
          }
        },
        "quote": {
          "type": "string",
          "enum": [
            "double",
            "single"
          ],
          "description": "🗣️ Delimiter the declaration's pseudo-attributes are written with (XML 1.0 §2.8); absent means the default `\"` spelling.",
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Quote character",
              "de": "Anführungszeichen"
            },
            "description": {
              "en": "Delimiter of the XML declaration's pseudo-attributes.",
              "de": "Begrenzungszeichen der Pseudoattribute der XML-Deklaration."
            },
            "options": {
              "double": {
                "en": "Double quotes (\")",
                "de": "Doppelte Anführungszeichen (\")"
              },
              "single": {
                "en": "Single quotes (')",
                "de": "Einfache Anführungszeichen (')"
              }
            }
          }
        }
      }
    }
  }
}
