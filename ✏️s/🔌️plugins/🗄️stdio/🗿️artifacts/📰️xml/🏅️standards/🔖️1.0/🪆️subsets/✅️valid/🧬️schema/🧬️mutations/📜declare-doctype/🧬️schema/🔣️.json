{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/xml/1.0/valid/mutation/declare-doctype.json",
  "title": "DeclareDoctype",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "external_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/XmlExternalId"
        },
        {
          "type": "null"
        }
      ]
    },
    "mutation": {
      "const": "declareDoctype",
      "description": "Aggregate discriminator spliced in by XmlValidMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "XmlExternalId": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "system"
            },
            "systemId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "publicId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "public"
            },
            "publicId": {
              "type": "string"
            },
            "systemId": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
