{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/valid/mutation/declare-doctype/schema.json",
  "title": "DeclareDoctype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "declareDoctype",
      "description": "Aggregate discriminator spliced in by XmlValidMutation; absent when the payload stands alone."
    },
    "externalId": {
      "anyOf": [
        {
          "$ref": "#/$defs/XmlExternalId"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "External identifier",
          "de": "Externer Bezeichner"
        },
        "description": {
          "en": "SYSTEM or PUBLIC identifier of the external DTD subset.",
          "de": "SYSTEM- oder PUBLIC-Bezeichner der externen DTD-Teilmenge."
        }
      }
    }
  },
  "$defs": {
    "XmlExternalId": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "system"
            },
            "systemId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "publicId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "public"
            },
            "publicId": {
              "type": "string"
            },
            "systemId": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
