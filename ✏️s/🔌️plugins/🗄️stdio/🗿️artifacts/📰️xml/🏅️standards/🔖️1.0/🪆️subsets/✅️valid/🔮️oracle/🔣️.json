  "comparisonProfiles": [
    {
      "id": "semantic-xml-valid-1-0-v1",
      "description": "XML 1.0 ✳️valid mutation round trips compared on the ground the subset is defined on: the XML declaration decomposed into version/encoding/standalone, the DOCTYPE decomposed into Name, SYSTEM/PUBLIC external identifier and the ORDERED internal-subset entity declarations (§4.2 binds the first declaration of a name, so order is normative and is never sorted), the document element's name, the four §2.8/§2.9 validity verdicts derived independently by each side, and the element/text/CDATA/comment/PI tree. Attributes are compared as a name-sorted set, because XML attribute order is real writer freedom; sibling and child order IS normative and is never sorted. Self-closing versus explicit empty open/close tags are equivalent by construction — both parse to zero children — and are never distinguished by either side. Nothing about validity is narrowed away: the presence of the DOCTYPE, the agreement of its Name with the document element, and the standalone/external-subset pair are exactly what the comparison sees.",
      "tolerance": 0,
      "ignoreKeys": []
    }
  ],
