dialect grammar
grammar stdio.xml.snapshot
extension xml
start document
comment none

# The REAL wire text of `stdio.xml`'s snapshot facet: the one-line, bracket-nested, hex-payload
# body `store::ArtifactDsl::print_dsl` actually emits -- `🧬️schema/🔨️modules/🧬️mutation-support`'s
# `encode_snapshot`/`decode_snapshot` (since 2026-08-27), NOT the document's own `<?xml ...?>`
# markup. The previous revision of this file described XML 1.0 markup itself, which this artifact's
# `print_dsl` has not emitted for as long as `encode_snapshot` has existed: `grammar_conformance_law`
# (`../../🧪️tests/🔬️unit`) measures the grammar against REAL `print_dsl` output, and that is the
# text modeled here. The document's own markup syntax is still real and still parsed -- by
# `../../🦀️.rs`'s `xml_document_from_text`, reached through `import_utf8`, which is the IMPORT path
# (`.xml` files), not this artifact's snapshot DSL.
#
# `comment none`: the alphabet below is hex payloads (lowercase only), single-uppercase-letter node
# tags and bracket/comma punctuation -- no `#` is ever produced, so no comment dialect applies.
#
# `hex` (bare `hex`, referenced below but deliberately NOT defined as a production here) is the
# framework's built-in `hex` MACRO, and it accepts the EMPTY run (`enc_str("")`), exactly as the
# sibling ../../🔺️diff/📝️text grammar's own header explains.
#
# Every production below is copied from the real `format!(...)` call sites in
# `../../🔺️diff/🦀️.rs` (`enc_str`/`encode_option`/`enc_xml_node`/`enc_doctype`/`enc_declaration`/
# `enc_prolog`), the same self-contained per-facet restatement convention the diff grammar uses.
artifact-mark = "stdio.xml"
document = artifact-mark snapshot-lit

# `encode_snapshot` -- `[hex(schema),option(root),option(doctype),option(declaration),prolog]`.
snapshot-lit = "[" hex "," opt-xml-node "," opt-doctype "," opt-declaration "," prolog-list "]"

# `encode_option`'s uniform tri-state shape (`📖️grammar-recipe.md` §1.4): `[0]` (None) /
# `[1,<value>]` (Some).
opt-hex = "[" "0" "]" | "[" "1" "," hex "]"
opt-bool = "[" "0" "]" | "[" "1" "," bool-lit "]"
opt-xml-node = "[" "0" "]" | "[" "1" "," xml-node "]"
opt-doctype = "[" "0" "]" | "[" "1" "," doctype-lit "]"
opt-declaration = "[" "0" "]" | "[" "1" "," declaration-lit "]"
bool-lit = "0" | "1"

# `enc_declaration`: `[hex(version),opt-hex(encoding),opt-bool(standalone)]`.
declaration-lit = "[" hex "," opt-hex "," opt-bool "]"

# `enc_doctype`: `[hex(name),opt-external-id,[dtd-declaration,...]]`.
doctype-lit = "[" hex "," opt-external-id "," "[" dtd-declaration-list? "]" "]"
opt-external-id = "[" "0" "]" | "[" "1" "," external-id "]"
external-id = "S" "[" hex "]" | "P" "[" hex "," hex "]"
dtd-declaration-list = dtd-declaration {"," dtd-declaration}*
dtd-declaration = "E" "[" bool-lit "," hex "," hex "]"

# `enc_prolog`: the bracketed comma list of whole nodes that precede the root element.
prolog-list = "[" node-item* "]"

# `enc_xml_node` -- single-uppercase-letter tag immediately followed by the bracketed positional
# payload: `E`=Element, `T`=Text, `D`=CDATA, `M`=Comment, `P`=ProcessingInstruction. Genuinely
# recursive: an element's children slot references `xml-node` back through `node-item`.
xml-node = "E" "[" hex "," "[" attr-item* "]" "," "[" node-item* "]" "]" | "T" "[" hex "]" | "D" "[" hex "]" | "M" "[" hex "]" | "P" "[" hex "," hex "]"
attr-item = "[" hex "," hex "]" ","?
node-item = xml-node ","?
