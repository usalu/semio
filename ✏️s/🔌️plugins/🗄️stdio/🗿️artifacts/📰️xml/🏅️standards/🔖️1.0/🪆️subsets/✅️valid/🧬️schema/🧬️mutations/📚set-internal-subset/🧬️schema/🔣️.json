{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/valid/mutation/set-internal-subset/schema.json",
  "title": "SetInternalSubset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "declarations"
  ],
  "properties": {
    "mutation": {
      "const": "setInternalSubset",
      "description": "Aggregate discriminator spliced in by XmlValidMutation; absent when the payload stands alone."
    },
    "declarations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/XmlDtdDeclaration"
      },
      "x-semio-ui": {
        "label": {
          "en": "Markup declarations",
          "de": "Markup-Deklarationen"
        },
        "description": {
          "en": "Declarations of the internal DTD subset in document order.",
          "de": "Deklarationen der internen DTD-Teilmenge in Dokumentreihenfolge."
        }
      }
    }
  },
  "$defs": {
    "XmlDtdDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parameter",
            "name",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "parameter": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
