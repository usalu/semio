{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/valid/mutation/set-text/schema.json",
  "title": "SetText",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "text"
  ],
  "properties": {
    "mutation": {
      "const": "setText",
      "description": "Aggregate discriminator spliced in by XmlValidMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Text path",
          "de": "Textpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the text node, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Textknoten, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "text": {
      "type": "string",
      "x-semio-ui": {
        "widget": "multiline",
        "role": "value",
        "label": {
          "en": "Text",
          "de": "Text"
        },
        "description": {
          "en": "Character data the text node holds afterwards.",
          "de": "Zeichendaten, die der Textknoten danach enthält."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
