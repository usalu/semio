{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/valid/mutation/set-text/schema.json",
  "title": "SetText",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "text"
  ],
  "properties": {
    "mutation": {
      "const": "setText",
      "description": "Aggregate discriminator spliced in by XmlValidMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "text": {
      "type": "string"
    }
  }
}
