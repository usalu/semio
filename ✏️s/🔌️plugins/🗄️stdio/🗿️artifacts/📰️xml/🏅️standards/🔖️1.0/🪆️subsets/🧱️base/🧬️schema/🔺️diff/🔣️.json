{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/diff.json",
  "title": "XmlDiff",
  "type": "object",
  "properties": {
    "prolog": {
      "type": "array",
      "items": {
        "$ref": "snapshot.json#/$defs/XmlNode"
      }
    },
    "epilog": {
      "type": "array",
      "items": {
        "$ref": "snapshot.json#/$defs/XmlNode"
      }
    },
    "declaration": {
      "$ref": "#/$defs/NullableXmlDeclaration"
    },
    "doctype": {
      "$ref": "#/$defs/NullableXmlDoctype"
    },
    "root": {
      "$ref": "#/$defs/XmlNodeDiff"
    }
  },
  "$defs": {
    "NullableXmlDeclaration": {
      "description": "Tri-state: absent key = unchanged, null = cleared, object = set.",
      "type": [
        "object",
        "null"
      ]
    },
    "NullableXmlDoctype": {
      "description": "Tri-state: absent key = unchanged, null = cleared, object = set.",
      "oneOf": [
        { "$ref": "snapshot.json#/$defs/XmlDoctype" },
        { "type": "null" }
      ]
    },
    "XmlAttrModified": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "XmlAttrAdded": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "XmlAttributesDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlAttrModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlAttrAdded"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "XmlChildModified": {
      "type": "object",
      "required": [
        "index",
        "diff"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "diff": {
          "$ref": "#/$defs/XmlNodeDiff"
        }
      }
    },
    "XmlChildAdded": {
      "type": "object",
      "required": [
        "index",
        "item"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "item": {
          "type": "object"
        }
      }
    },
    "XmlChildrenDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlChildModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlChildAdded"
          }
        }
      }
    },
    "XmlElementDiff": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "attributes": {
          "$ref": "#/$defs/XmlAttributesDiff"
        },
        "children": {
          "$ref": "#/$defs/XmlChildrenDiff"
        }
      }
    },
    "XmlNodeDiff": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "element"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/XmlElementDiff"
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "replace"
            },
            "node": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      ]
    }
  }
}
