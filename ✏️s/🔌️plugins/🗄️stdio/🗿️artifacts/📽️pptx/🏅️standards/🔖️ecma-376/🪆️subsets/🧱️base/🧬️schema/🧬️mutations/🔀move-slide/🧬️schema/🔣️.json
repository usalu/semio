{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/mutation/move-slide/schema.json",
  "title": "MoveSlide",
  "type": "object",
  "additionalProperties": false,
  "required": ["mutation", "address", "destinationIndex"],
  "properties": {
    "mutation": { "const": "moveSlide" },
    "address": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/xml-address.json#/$defs/PptxSlideAddress",
      "x-semio-ui": {
        "label": { "en": "Slide", "de": "Folie" },
        "description": { "en": "Revision-bound slide to move.", "de": "Revisionsgebundene zu verschiebende Folie." }
      }
    },
    "destinationIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-semio-ui": {
        "label": { "en": "Destination position", "de": "Zielposition" },
        "description": { "en": "Zero-based final position of the slide.", "de": "Nullbasierte endgültige Position der Folie." }
      }
    }
  }
}
