{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/mutation/set-shape-position/schema.json",
  "title": "SetShapePosition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "slideIndex",
    "shapeIndex",
    "position"
  ],
  "properties": {
    "mutation": {
      "const": "setShapePosition",
      "description": "Aggregate discriminator spliced in by PptxMutation; absent when the payload stands alone."
    },
    "slideIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Slide Index",
          "de": "Folienindex"
        },
        "description": {
          "en": "Zero-based position of the slide in the deck.",
          "de": "Nullbasierte Position der Folie im Foliensatz."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "shapeIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Shape Index",
          "de": "Formindex"
        },
        "description": {
          "en": "Zero-based position of the shape on its slide.",
          "de": "Nullbasierte Position der Form auf ihrer Folie."
        },
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "position": {
      "$ref": "#/$defs/PptxTransform"
    }
  },
  "$defs": {
    "PptxTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "cx",
        "cy"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "cx": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Width",
              "de": "Breite"
            },
            "description": {
              "en": "Shape extent in EMU (914400 per inch).",
              "de": "Ausdehnung der Form in EMU (914400 je Zoll)."
            },
            "unit": "EMU",
            "displayUnit": "cm",
            "displayFactor": 2.777777777777778e-06,
            "precision": 2
          }
        },
        "cy": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Height",
              "de": "Höhe"
            },
            "description": {
              "en": "Shape extent in EMU (914400 per inch).",
              "de": "Ausdehnung der Form in EMU (914400 je Zoll)."
            },
            "unit": "EMU",
            "displayUnit": "cm",
            "displayFactor": 2.777777777777778e-06,
            "precision": 2
          }
        }
      }
    }
  }
}
