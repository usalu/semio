{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pptx/ecma-376/base/mutation/set-shape-position/schema.json",
  "title": "SetShapePosition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slide_index",
    "shape_index",
    "position"
  ],
  "properties": {
    "slide_index": {
      "type": "integer",
      "minimum": 0
    },
    "shape_index": {
      "type": "integer",
      "minimum": 0
    },
    "position": {
      "$ref": "#/$defs/PptxTransform"
    },
    "mutation": {
      "const": "setShapePosition",
      "description": "Aggregate discriminator spliced in by PptxMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "PptxTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "cx",
        "cy"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "cx": {
          "type": "integer"
        },
        "cy": {
          "type": "integer"
        }
      }
    }
  }
}
