{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/diff.json",
  "title": "PptxDiff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "opc": {
      "$ref": "#/$defs/PptxOpcDiff",
      "x-semio-state": "artifact"
    },
    "presentation": {
      "$ref": "#/$defs/PptxPresentationDiff",
      "x-semio-state": "artifact"
    },
    "xmlParts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PptxXmlPart"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "OpcPackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpcPart"
          }
        },
        "contentTypes": {
          "$ref": "#/$defs/OpcContentTypes"
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OpcRelationship"
            }
          }
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "OpcPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "OpcContentTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "OpcRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relType",
        "target",
        "targetMode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "relType": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "targetMode": {
          "$ref": "#/$defs/OpcTargetMode"
        }
      }
    },
    "OpcTargetMode": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "PptxXmlPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType",
        "document"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "document": {
          "$ref": "#/$defs/XmlDocument"
        }
      }
    },
    "XmlDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlNode"
            },
            {
              "type": "null"
            }
          ]
        },
        "doctype": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlDoctype"
            },
            {
              "type": "null"
            }
          ]
        },
        "declaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlDeclaration"
            },
            {
              "type": "null"
            }
          ]
        },
        "prolog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          }
        },
        "epilog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          }
        }
      }
    },
    "XmlNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string"
            },
            "attrs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlAttr"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "cData"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "comment"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "processingInstruction"
            },
            "target": {
              "type": "string"
            },
            "data": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "XmlDoctype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "prologPosition": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of prolog nodes preceding this declaration."
        },
        "name": {
          "type": "string"
        },
        "externalId": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlExternalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlDtdDeclaration"
          }
        }
      }
    },
    "XmlExternalId": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "system"
            },
            "systemId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "publicId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "public"
            },
            "publicId": {
              "type": "string"
            },
            "systemId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlDtdDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parameter",
            "name",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "parameter": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "standalone": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "type": "string",
          "enum": [
            "double",
            "single"
          ]
        }
      }
    },
    "PptxPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxSlide"
          }
        }
      }
    },
    "PptxSlide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shapes": {
          "type": "array",
          "items": {
