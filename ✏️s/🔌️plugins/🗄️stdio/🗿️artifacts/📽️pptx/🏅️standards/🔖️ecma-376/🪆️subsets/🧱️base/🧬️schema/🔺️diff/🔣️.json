    "PptxRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PptxTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "cx",
        "cy"
      ],
      "properties": {
        "x": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20
        },
        "y": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20
        },
        "cx": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20
        },
        "cy": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20
        }
      }
    },
    "PptxSlidesDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "diff"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "diff": {
                "$ref": "#/$defs/PptxSlideDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "item"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "item": {
                "$ref": "#/$defs/PptxSlide"
              }
            }
          }
        }
      }
    },
    "PptxShapesDiff": {
