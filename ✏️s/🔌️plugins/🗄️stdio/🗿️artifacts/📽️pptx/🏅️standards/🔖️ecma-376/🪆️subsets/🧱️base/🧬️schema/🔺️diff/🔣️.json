      }
    },
    "PptxShape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind"
          ],
          "properties": {
            "shapeKind": {
              "const": "textBox"
            },
            "textFrame": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PptxParagraph"
              }
            },
            "position": {
              "$ref": "#/$defs/PptxTransform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "blipRelId"
          ],
          "properties": {
            "shapeKind": {
              "const": "picture"
            },
            "blipRelId": {
              "type": "string"
            },
            "position": {
              "$ref": "#/$defs/PptxTransform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "kind"
          ],
          "properties": {
            "shapeKind": {
              "const": "placeholder"
            },
            "kind": {
              "type": "string"
            },
            "textFrame": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PptxParagraph"
              }
            },
            "position": {
              "$ref": "#/$defs/PptxTransform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "node"
          ],
          "properties": {
            "shapeKind": {
              "const": "other"
            },
            "node": {
              "$ref": "#/$defs/XmlNode"
