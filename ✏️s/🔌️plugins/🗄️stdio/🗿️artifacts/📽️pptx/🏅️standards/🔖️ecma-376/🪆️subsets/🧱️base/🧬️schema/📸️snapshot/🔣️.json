{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pptx/ecma-376/base/snapshot.json",
  "title": "PptxSnapshot",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "opc": {
      "$ref": "#/$defs/OpcPackage",
      "x-semio-state": "artifact"
    },
    "xmlParts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/xmlPart"
      },
      "x-semio-state": "artifact"
    },
    "presentation": {
      "$ref": "#/definitions/presentation",
      "x-semio-state": "artifact"
    }
  },
  "required": [
    "schema",
    "opc",
    "xmlParts",
    "presentation"
  ],
  "$defs": {
    "NameValue": {
      "type": "array",
      "items": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "OpcPackage": {
      "type": "object",
      "properties": {
        "contentTypes": {
          "type": "object",
          "properties": {
            "defaults": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NameValue"
              }
            },
            "overrides": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NameValue"
              }
            }
          },
          "required": [
            "defaults",
            "overrides"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpcPart"
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/relationship"
            }
          }
        }
      },
      "required": [
        "contentTypes",
        "parts",
        "relationships"
      ]
    },
    "OpcPart": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "path",
        "contentType",
        "bytes"
      ]
    },
    "XmlDocument": {
      "type": "object",
      "properties": {
        "declaration": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            },
            "encoding": {
              "type": "string"
            },
            "standalone": {
              "type": "boolean"
            }
          },
          "required": [
            "version"
          ]
        },
        "prolog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          }
        },
        "root": {
          "$ref": "#/$defs/XmlNode"
        }
      },
      "required": [
        "prolog"
      ]
    },
    "XmlNode": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "element",
            "text",
            "cData",
            "comment",
            "processingInstruction"
          ]
        },
        "name": {
          "type": "string"
        },
        "attrs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ]
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          }
        },
        "text": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "data": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    }
  },
  "definitions": {
    "relationship": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "relType": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "targetMode": {
          "enum": [
            "internal",
            "external"
          ]
        }
      },
      "required": [
        "id",
        "relType",
        "target",
        "targetMode"
      ]
    },
    "xmlPart": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "document": {
          "$ref": "#/$defs/XmlDocument"
        }
      },
      "required": [
        "path",
        "contentType",
        "document"
      ]
    },
    "transform": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "cx": {
          "type": "integer"
        },
        "cy": {
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "cx",
        "cy"
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "fontSize": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "text",
        "bold",
        "italic"
      ]
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/run"
          }
        }
      },
      "required": [
        "runs"
      ]
    },
    "shape": {
      "type": "object",
      "properties": {
        "shapeKind": {
          "enum": [
            "textBox",
            "picture",
            "placeholder",
            "other"
          ]
        },
        "textFrame": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/paragraph"
          }
        },
        "position": {
          "$ref": "#/definitions/transform"
        },
        "blipRelId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/XmlNode"
        }
      },
      "required": [
        "shapeKind"
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "shapes": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/shape"
                }
              }
            },
            "required": [
              "shapes"
            ]
          }
        }
      },
      "required": [
        "slides"
      ]
    }
  }
}
