{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/snapshot.json",
  "title": "PptxSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "opc": {
      "$ref": "#/$defs/OpcPackage",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "OPC package",
          "de": "OPC-Paket"
        },
        "description": {
          "en": "Open Packaging Conventions container of the document (ISO/IEC 29500-2).",
          "de": "Container des Dokuments nach Open Packaging Conventions (ISO/IEC 29500-2)."
        }
      }
    },
    "xmlParts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PptxXmlPart"
      },
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "XML parts",
          "de": "XML-Teile"
        },
        "description": {
          "en": "Parsed XML parts of the package.",
          "de": "Geparste XML-Teile des Pakets."
        }
      }
    }
  },
  "$defs": {
    "OpcPackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpcPart"
          },
          "x-semio-ui": {
            "label": {
              "en": "Package parts",
              "de": "Paketteile"
            }
          }
        },
        "contentTypes": {
          "$ref": "#/$defs/OpcContentTypes",
          "x-semio-ui": {
            "label": {
              "en": "Content types",
              "de": "Inhaltstypen"
            },
            "description": {
              "en": "Content of the [Content_Types].xml part.",
              "de": "Inhalt des Teils [Content_Types].xml."
            }
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OpcRelationship"
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Relationships",
              "de": "Beziehungen"
            }
          }
        },
        "comment": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Comment",
              "de": "Kommentar"
            }
          }
        }
      }
    },
    "OpcPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType"
      ],
      "properties": {
        "path": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Path",
              "de": "Pfad"
            }
          }
        },
        "contentType": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Content type",
              "de": "Inhaltstyp"
            },
            "description": {
              "en": "MIME media type of the package part.",
              "de": "MIME-Medientyp des Paketteils."
            }
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Part bytes",
              "de": "Bytes des Paketteils"
            }
          }
        }
      }
    },
    "OpcContentTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "x-semio-ui": {
            "label": {
              "en": "Default content types",
              "de": "Standard-Inhaltstypen"
            },
            "description": {
              "en": "Content type per file extension.",
              "de": "Inhaltstyp je Dateierweiterung."
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "x-semio-ui": {
            "label": {
              "en": "Content type overrides",
              "de": "Inhaltstyp-Überschreibungen"
            },
            "description": {
              "en": "Content type per part name, overriding the extension default.",
              "de": "Inhaltstyp je Teilname; überschreibt den Standard der Dateierweiterung."
            }
          }
        }
      }
    },
    "OpcRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relType",
        "target",
        "targetMode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "ID",
              "de": "ID"
            }
          }
        },
        "relType": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Relationship type",
              "de": "Beziehungstyp"
            }
          }
        },
        "target": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Target",
              "de": "Ziel"
            }
          }
        },
        "targetMode": {
          "$ref": "#/$defs/OpcTargetMode",
          "x-semio-ui": {
            "label": {
              "en": "Target mode",
              "de": "Zielmodus"
            }
          }
        }
      }
    },
    "OpcTargetMode": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "PptxXmlPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType",
        "document"
      ],
      "properties": {
        "path": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Path",
              "de": "Pfad"
            }
          }
        },
        "contentType": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Content type",
              "de": "Inhaltstyp"
            }
          }
        },
        "document": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlDocument",
          "x-semio-ui": {
            "label": {
              "en": "Document",
              "de": "Dokument"
            }
          }
        }
      }
    },
    "XmlDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlNode"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Root element",
              "de": "Wurzelelement"
            }
          }
        },
        "doctype": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlDoctype"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Document type",
              "de": "Dokumenttyp"
            }
          }
        },
        "declaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "XML declaration",
              "de": "XML-Deklaration"
            }
          }
        },
        "prolog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          },
          "x-semio-ui": {
            "label": {
              "en": "Prolog",
              "de": "Prolog"
            }
          }
        },
        "epilog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          },
          "x-semio-ui": {
            "label": {
              "en": "Epilog",
              "de": "Epilog"
            }
          }
        }
      }
    },
    "XmlNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Name",
                  "de": "Name"
                }
              }
            },
            "attrs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlAttr"
              },
              "x-semio-ui": {
                "label": {
                  "en": "Attributes",
                  "de": "Attribute"
                }
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlNode"
              },
              "x-semio-ui": {
                "label": {
                  "en": "Children",
                  "de": "Unterelemente"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Text",
                  "de": "Text"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "cData"
            },
            "text": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Text",
                  "de": "Text"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "comment"
            },
            "text": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Text",
                  "de": "Text"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "processingInstruction"
            },
            "target": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Target",
                  "de": "Ziel"
                }
              }
            },
            "data": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Data",
                  "de": "Daten"
                }
              }
            }
          }
        }
      ]
    },
    "XmlAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Name",
              "de": "Name"
            }
          }
        },
        "value": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Value",
              "de": "Wert"
            }
          }
        }
      }
    },
    "XmlDoctype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "prologPosition": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-semio-ui": {
            "label": {
              "en": "Prolog position",
              "de": "Prologposition"
            }
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Name",
              "de": "Name"
            }
          }
        },
        "externalId": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlExternalId"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "External ID",
              "de": "Externe ID"
            }
          }
        },
        "declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlDtdDeclaration"
          },
          "x-semio-ui": {
            "label": {
              "en": "Declarations",
              "de": "Deklarationen"
            }
          }
        }
      }
    },
    "XmlExternalId": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "system"
            },
            "systemId": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "System ID",
                  "de": "System-ID"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "publicId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "public"
            },
            "publicId": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Public ID",
                  "de": "Öffentliche ID"
                }
              }
            },
            "systemId": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "System ID",
                  "de": "System-ID"
                }
              }
            }
          }
        }
      ]
    },
    "XmlDtdDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parameter",
            "name",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "parameter": {
              "type": "boolean",
              "x-semio-ui": {
                "label": {
                  "en": "Parameter",
                  "de": "Parameter"
                }
              }
            },
            "name": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Name",
                  "de": "Name"
                }
              }
            },
            "value": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Value",
                  "de": "Wert"
                }
              }
            }
          }
        }
      ]
    },
    "XmlDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Version",
              "de": "Version"
            }
          }
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Encoding",
              "de": "Kodierung"
            }
          }
        },
        "standalone": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Standalone",
              "de": "Eigenständig"
            }
          }
        },
        "quote": {
          "type": "string",
          "enum": [
            "double",
            "single"
          ],
          "x-semio-ui": {
            "label": {
              "en": "Quotation marks",
              "de": "Anführungszeichen"
            }
          }
        }
      }
    },
    "PptxPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxSlide"
          },
          "x-semio-ui": {
            "label": {
              "en": "Slides",
              "de": "Folien"
            }
          }
        }
      }
    },
    "PptxSlide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxShape"
          },
          "x-semio-ui": {
            "label": {
              "en": "Shapes",
              "de": "Formen"
            }
          }
        }
      }
    },
    "PptxShape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind"
          ],
          "properties": {
            "shapeKind": {
              "const": "textBox"
            },
            "textFrame": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PptxParagraph"
              },
              "x-semio-ui": {
                "label": {
                  "en": "Text frame",
                  "de": "Textrahmen"
                }
              }
            },
            "position": {
              "$ref": "#/$defs/PptxTransform",
              "x-semio-ui": {
                "label": {
                  "en": "Position",
                  "de": "Position"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "blipRelId"
          ],
          "properties": {
            "shapeKind": {
              "const": "picture"
            },
            "blipRelId": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Image relationship ID",
                  "de": "Bildbeziehungs-ID"
                }
              }
            },
            "position": {
              "$ref": "#/$defs/PptxTransform",
              "x-semio-ui": {
                "label": {
                  "en": "Position",
                  "de": "Position"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "kind"
          ],
          "properties": {
            "shapeKind": {
              "const": "placeholder"
            },
            "kind": {
              "type": "string",
              "x-semio-ui": {
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "textFrame": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PptxParagraph"
              },
              "x-semio-ui": {
                "label": {
                  "en": "Text frame",
                  "de": "Textrahmen"
                }
              }
            },
            "position": {
              "$ref": "#/$defs/PptxTransform",
              "x-semio-ui": {
                "label": {
                  "en": "Position",
                  "de": "Position"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "node"
          ],
          "properties": {
            "shapeKind": {
              "const": "other"
            },
            "node": {
              "$ref": "#/$defs/XmlNode",
              "x-semio-ui": {
                "label": {
                  "en": "Node",
                  "de": "Knoten"
                }
              }
            }
          }
        }
      ]
    },
    "PptxParagraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxRun"
          },
          "x-semio-ui": {
            "label": {
              "en": "Text runs",
              "de": "Textabschnitte"
            }
          }
        }
      }
    },
    "PptxRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Text",
              "de": "Text"
            }
          }
        },
        "bold": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Bold",
              "de": "Fett"
            }
          }
        },
        "italic": {
          "type": "boolean",
          "x-semio-ui": {
            "label": {
              "en": "Italic",
              "de": "Kursiv"
            }
          }
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Font size",
              "de": "Schriftgröße"
            }
          }
        }
      }
    },
    "PptxTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "cx",
        "cy"
      ],
      "properties": {
        "x": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20,
          "x-semio-ui": {
            "label": {
              "en": "Horizontal position (EMU)",
              "de": "Horizontale Position (EMU)"
            },
            "description": {
              "en": "Shape offset along x in English Metric Units (914400 per inch).",
              "de": "Versatz der Form entlang x in English Metric Units (914400 pro Zoll)."
            }
          }
        },
        "y": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20,
          "x-semio-ui": {
            "label": {
              "en": "Vertical position (EMU)",
              "de": "Vertikale Position (EMU)"
            },
            "description": {
              "en": "Shape offset along y in English Metric Units (914400 per inch).",
              "de": "Versatz der Form entlang y in English Metric Units (914400 pro Zoll)."
            }
          }
        },
