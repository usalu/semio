{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/mutation/insert-shape/schema.json",
  "title": "InsertShape",
  "type": "object",
  "additionalProperties": false,
  "required": ["mutation", "vacancy", "shape"],
  "properties": {
    "mutation": { "const": "insertShape" },
    "vacancy": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/xml-address.json#/$defs/PptxXmlVacancyAddress",
      "x-semio-ui": {
        "label": { "en": "Shape position", "de": "Formposition" },
        "description": { "en": "Revision-bound vacant position in the slide shape tree.", "de": "Revisionsgebundene freie Position im Formbaum der Folie." }
      }
    },
    "shape": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlNode",
      "x-semio-ui": {
        "label": { "en": "Shape XML", "de": "Form-XML" },
        "description": { "en": "Canonical PresentationML shape element to insert.", "de": "Einzufügendes kanonisches PresentationML-Formelement." }
      }
    }
  }
}
