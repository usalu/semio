{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/mutation/insert-shape/schema.json",
  "title": "InsertShape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "slideIndex",
    "shapeIndex",
    "shape"
  ],
  "properties": {
    "mutation": {
      "const": "insertShape",
      "description": "Aggregate discriminator spliced in by PptxMutation; absent when the payload stands alone."
    },
    "slideIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Slide Index",
          "de": "Folienindex"
        },
        "description": {
          "en": "Zero-based position of the slide in the deck.",
          "de": "Nullbasierte Position der Folie im Foliensatz."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "shapeIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Shape Index",
          "de": "Formindex"
        },
        "description": {
          "en": "Zero-based position of the shape on its slide.",
          "de": "Nullbasierte Position der Form auf ihrer Folie."
        },
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "shape": {
      "$ref": "#/$defs/PptxShape",
      "x-semio-ui": {
        "label": {
          "en": "Shape",
          "de": "Form"
        }
      }
    }
  },
  "$defs": {
    "PptxShape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind"
          ],
          "properties": {
            "shapeKind": {
              "const": "textBox"
            },
            "textFrame": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PptxParagraph"
              }
            },
            "position": {
              "$ref": "#/$defs/PptxTransform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "blipRelId"
          ],
          "properties": {
            "shapeKind": {
              "const": "picture"
            },
            "blipRelId": {
              "type": "string"
            },
            "position": {
              "$ref": "#/$defs/PptxTransform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "kind"
          ],
          "properties": {
            "shapeKind": {
              "const": "placeholder"
            },
            "kind": {
              "type": "string"
            },
            "textFrame": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PptxParagraph"
              }
            },
            "position": {
              "$ref": "#/$defs/PptxTransform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "node"
          ],
          "properties": {
            "shapeKind": {
              "const": "other"
            },
            "node": {
              "$ref": "#/$defs/XmlNode"
            }
          }
        }
      ]
    },
    "PptxParagraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxRun"
          }
        }
      }
    },
    "PptxRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PptxTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "cx",
        "cy"
      ],
      "properties": {
        "x": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20
        },
        "y": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20
        },
        "cx": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20
        },
        "cy": {
          "type": "string",
          "pattern": "^(-?[1-9][0-9]*|0)$",
          "maxLength": 20
        }
      }
    },
    "XmlNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string"
            },
            "attrs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlAttr"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "cData"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "comment"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "processingInstruction"
            },
            "target": {
              "type": "string"
            },
            "data": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
