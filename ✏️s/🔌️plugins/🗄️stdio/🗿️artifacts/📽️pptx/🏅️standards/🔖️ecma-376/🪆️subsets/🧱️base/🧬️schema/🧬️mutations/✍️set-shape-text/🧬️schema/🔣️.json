      }
    },
    "text": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": { "en": "Shape text", "de": "Formtext" },
        "description": { "en": "Replacement text for the addressed DrawingML text run.", "de": "Ersatztext für den adressierten DrawingML-Textlauf." }
      }
    }
