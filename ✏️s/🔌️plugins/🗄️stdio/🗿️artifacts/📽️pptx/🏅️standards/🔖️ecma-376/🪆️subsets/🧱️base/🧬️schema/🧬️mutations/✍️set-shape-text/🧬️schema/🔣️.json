{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/pptx/ecma-376/base/mutation/set-shape-text/schema.json",
  "title": "SetShapeText",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slide_index",
    "shape_index",
    "text_frame"
  ],
  "properties": {
    "slide_index": {
      "type": "integer",
      "minimum": 0
    },
    "shape_index": {
      "type": "integer",
      "minimum": 0
    },
    "text_frame": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PptxParagraph"
      }
    },
    "mutation": {
      "const": "setShapeText",
      "description": "Aggregate discriminator spliced in by PptxMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "PptxParagraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxRun"
          }
        }
      }
    },
    "PptxRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
