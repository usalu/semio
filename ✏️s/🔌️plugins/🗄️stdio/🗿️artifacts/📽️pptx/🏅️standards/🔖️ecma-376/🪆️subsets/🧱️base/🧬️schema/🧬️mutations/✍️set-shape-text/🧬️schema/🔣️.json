{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/mutation/set-shape-text/schema.json",
  "title": "SetShapeText",
  "type": "object",
  "additionalProperties": false,
  "required": ["mutation", "address", "text"],
  "properties": {
    "mutation": { "const": "setShapeText" },
    "address": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/xml-address.json#/$defs/PptxShapeAddress",
      "x-semio-ui": {
        "label": { "en": "Shape", "de": "Form" },
