{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/mutation/set-shape-text/schema.json",
  "title": "SetShapeText",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "slide_index",
    "shape_index",
    "text_frame"
  ],
  "properties": {
    "mutation": {
      "const": "setShapeText",
      "description": "Aggregate discriminator spliced in by PptxMutation; absent when the payload stands alone."
    },
    "slide_index": {
      "type": "integer",
      "minimum": 0
    },
    "shape_index": {
      "type": "integer",
      "minimum": 0
    },
    "text_frame": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PptxParagraph"
      },
      "x-semio-ui": {
        "label": {
          "en": "Text body",
          "de": "Textkörper"
        },
        "description": {
          "en": "Paragraphs of the shape's text body.",
          "de": "Absätze des Textkörpers der Form."
        }
      }
    }
  },
  "$defs": {
    "PptxParagraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxRun"
          },
          "x-semio-ui": {
            "label": {
              "en": "Text runs",
              "de": "Textläufe"
            }
          }
        }
      }
    },
    "PptxRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "bold": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Bold",
              "de": "Fett"
            }
          }
        },
        "italic": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Italic",
              "de": "Kursiv"
            }
          }
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Font size",
              "de": "Schriftgröße"
            },
            "description": {
              "en": "Whole points; written as DrawingML `sz` in hundredths of a point.",
              "de": "Ganze Punkt; geschrieben als DrawingML `sz` in Hundertstel Punkt."
            },
            "unit": "pt"
          }
        }
      }
    }
  }
}
