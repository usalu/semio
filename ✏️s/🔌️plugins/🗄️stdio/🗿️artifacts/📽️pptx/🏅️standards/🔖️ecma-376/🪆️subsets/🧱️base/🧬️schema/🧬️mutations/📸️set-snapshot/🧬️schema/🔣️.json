{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/pptx/ecma-376/base/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "snapshot"
  ],
  "properties": {
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by PptxMutation; absent when the payload stands alone."
    },
    "snapshot": {
      "$ref": "#/$defs/PptxSnapshot"
    }
  },
  "$defs": {
    "PptxSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Snapshot schema",
              "de": "Snapshot-Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema version.",
              "de": "Kennung der Version des Snapshot-Schemas."
            }
          }
        },
        "opc": {
          "$ref": "#/$defs/OpcPackage",
          "x-semio-ui": {
            "label": {
              "en": "OPC package",
              "de": "OPC-Paket"
            },
            "description": {
              "en": "Open Packaging Conventions container of the document (ISO/IEC 29500-2).",
              "de": "Container des Dokuments nach Open Packaging Conventions (ISO/IEC 29500-2)."
            }
          }
        },
        "xmlParts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxXmlPart"
          },
          "x-semio-ui": {
            "label": {
              "en": "XML parts",
              "de": "XML-Teile"
            },
            "description": {
              "en": "Parsed XML parts of the package.",
              "de": "Geparste XML-Teile des Pakets."
            }
          }
        },
        "presentation": {
          "$ref": "#/$defs/PptxPresentation",
          "x-semio-ui": {
            "label": {
              "en": "Presentation",
              "de": "Präsentation"
            }
          }
        }
      }
    },
    "OpcPackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpcPart"
          },
          "x-semio-ui": {
            "label": {
              "en": "Package parts",
              "de": "Paketteile"
            }
          }
        },
        "contentTypes": {
          "$ref": "#/$defs/OpcContentTypes",
          "x-semio-ui": {
            "label": {
              "en": "Content types",
              "de": "Inhaltstypen"
            },
            "description": {
              "en": "Content of the [Content_Types].xml part.",
              "de": "Inhalt des Teils [Content_Types].xml."
            }
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OpcRelationship"
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Relationships",
              "de": "Beziehungen"
            }
          }
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "OpcPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "contentType": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Content type",
              "de": "Inhaltstyp"
            },
            "description": {
              "en": "MIME media type of the package part.",
              "de": "MIME-Medientyp des Paketteils."
            }
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Part bytes",
              "de": "Bytes des Paketteils"
            }
          }
        }
      }
    },
    "OpcContentTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "x-semio-ui": {
            "label": {
              "en": "Default content types",
              "de": "Standard-Inhaltstypen"
            },
            "description": {
              "en": "Content type per file extension.",
              "de": "Inhaltstyp je Dateierweiterung."
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "x-semio-ui": {
            "label": {
              "en": "Content type overrides",
              "de": "Inhaltstyp-Überschreibungen"
            },
            "description": {
              "en": "Content type per part name, overriding the extension default.",
              "de": "Inhaltstyp je Teilname; überschreibt den Standard der Dateierweiterung."
            }
          }
        }
      }
    },
    "OpcRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relType",
        "target",
        "targetMode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "relType": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "targetMode": {
          "$ref": "#/$defs/OpcTargetMode"
        }
      }
    },
    "OpcTargetMode": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "PptxXmlPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType",
        "document"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "contentType": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Content type",
              "de": "Inhaltstyp"
            },
            "description": {
              "en": "MIME media type of the package part.",
              "de": "MIME-Medientyp des Paketteils."
            }
          }
        },
        "document": {
          "$ref": "#/$defs/XmlDocument",
          "x-semio-ui": {
            "label": {
              "en": "XML document",
              "de": "XML-Dokument"
            }
          }
        }
      }
    },
    "XmlDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlNode"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Root element",
              "de": "Wurzelelement"
            }
          }
        },
        "doctype": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlDoctype"
            },
            {
              "type": "null"
            }
          ]
        },
        "declaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "XML declaration",
              "de": "XML-Deklaration"
            }
          }
        },
        "prolog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          },
          "x-semio-ui": {
            "label": {
              "en": "Prolog",
              "de": "Prolog"
            },
            "description": {
              "en": "Comments and processing instructions before the root element.",
              "de": "Kommentare und Verarbeitungsanweisungen vor dem Wurzelelement."
            }
          }
        },
        "epilog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          },
          "x-semio-ui": {
            "label": {
              "en": "Epilog",
              "de": "Epilog"
            },
            "description": {
              "en": "Comments and processing instructions after the root element.",
              "de": "Kommentare und Verarbeitungsanweisungen nach dem Wurzelelement."
            }
          }
        }
      }
    },
    "XmlNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string"
            },
            "attrs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlAttr"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "cData"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "comment"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "processingInstruction"
            },
            "target": {
              "type": "string"
            },
            "data": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "XmlDoctype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "prologPosition": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of prolog nodes preceding this declaration.",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Prolog position",
              "de": "Position im Prolog"
            },
            "description": {
              "en": "Number of prolog nodes before the document type declaration.",
              "de": "Anzahl der Prolog-Knoten vor der Dokumenttypdeklaration."
            }
          }
        },
        "name": {
          "type": "string"
        },
        "externalId": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlExternalId"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "External identifier",
              "de": "Externer Bezeichner"
            },
            "description": {
              "en": "SYSTEM or PUBLIC identifier of the external DTD subset.",
              "de": "SYSTEM- oder PUBLIC-Bezeichner der externen DTD-Teilmenge."
            }
          }
        },
        "declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlDtdDeclaration"
          },
          "x-semio-ui": {
            "label": {
              "en": "Markup declarations",
              "de": "Markup-Deklarationen"
            },
            "description": {
              "en": "Declarations of the internal DTD subset in document order.",
              "de": "Deklarationen der internen DTD-Teilmenge in Dokumentreihenfolge."
            }
          }
        }
      }
    },
    "XmlExternalId": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "system"
            },
            "systemId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "publicId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "public"
            },
            "publicId": {
              "type": "string"
            },
            "systemId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlDtdDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parameter",
            "name",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "parameter": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Encoding",
              "de": "Zeichenkodierung"
            },
            "description": {
              "en": "Encoding name written in the XML declaration, e.g. UTF-8.",
              "de": "In der XML-Deklaration angegebene Zeichenkodierung, z. B. UTF-8."
            }
          }
        },
        "standalone": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Standalone document",
              "de": "Standalone-Dokument"
            },
            "description": {
              "en": "Declares that no external markup declaration affects the document content.",
              "de": "Erklärt, dass keine externe Markup-Deklaration den Dokumentinhalt beeinflusst."
            }
          }
        },
        "quote": {
          "type": "string",
          "enum": [
            "double",
            "single"
          ],
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Quote character",
              "de": "Anführungszeichen"
            },
            "description": {
              "en": "Delimiter of the XML declaration's pseudo-attributes.",
              "de": "Begrenzungszeichen der Pseudoattribute der XML-Deklaration."
            },
            "options": {
              "double": {
                "en": "Double quotes (\")",
                "de": "Doppelte Anführungszeichen (\")"
              },
              "single": {
                "en": "Single quotes (')",
                "de": "Einfache Anführungszeichen (')"
              }
            }
          }
        }
      }
    },
    "PptxPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxSlide"
          },
          "x-semio-ui": {
            "label": {
              "en": "Slides",
              "de": "Folien"
            }
          }
        }
      }
    },
    "PptxSlide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxShape"
          },
          "x-semio-ui": {
            "label": {
              "en": "Shapes",
              "de": "Formen"
            }
          }
        }
      }
    },
    "PptxShape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind"
          ],
          "properties": {
            "shapeKind": {
              "const": "textBox"
            },
            "textFrame": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PptxParagraph"
              }
            },
            "position": {
              "$ref": "#/$defs/PptxTransform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "blipRelId"
          ],
          "properties": {
            "shapeKind": {
              "const": "picture"
            },
            "blipRelId": {
              "type": "string"
            },
            "position": {
              "$ref": "#/$defs/PptxTransform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "kind"
          ],
          "properties": {
            "shapeKind": {
              "const": "placeholder"
            },
            "kind": {
              "type": "string"
            },
            "textFrame": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PptxParagraph"
              }
            },
            "position": {
              "$ref": "#/$defs/PptxTransform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shapeKind",
            "node"
          ],
          "properties": {
            "shapeKind": {
              "const": "other"
            },
            "node": {
              "$ref": "#/$defs/XmlNode"
            }
          }
        }
      ]
    },
    "PptxParagraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PptxRun"
          }
        }
      }
    },
    "PptxRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "fontSize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PptxTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "cx",
        "cy"
      ],
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "cx": {
          "type": "integer"
        },
        "cy": {
          "type": "integer"
        }
      }
    }
  }
}
