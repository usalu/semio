{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PPTX Actual Owned Request Settlement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phases",
    "requestExtent",
    "reallocation",
    "exactReplay",
    "denial",
    "retirementRefund",
    "refusalKind",
    "tableCount"
  ],
  "properties": {
    "phases": {
      "const": [
        "projectSnapshot",
        "reconstructSnapshot"
      ]
    },
    "requestExtent": {
      "const": "fullConcreteRequests"
    },
    "reallocation": {
      "const": "completeReplacement"
    },
    "exactReplay": {
      "const": true
    },
    "denial": {
      "const": "oneByteBelowObserved"
    },
    "retirementRefund": {
      "const": false
    },
    "refusalKind": {
      "const": "ownershipLimit"
    },
    "tableCount": {
      "const": 21
    }
  }
}
