module Stdio_las_snapshot;
# §LAS 1.0 public header block (227 bytes) + VLRs + point records. Matches
# engine::{encode_las, decode_las} exactly (see component.ksy for per-field docs).

type PointCommon = unit {
    x: int32;
    y: int32;
    z: int32;
    intensity: uint16;
    return_flags: uint8;
    classification: uint8;
    scan_angle_rank: int8;
    user_data: uint8;
    point_source_id: uint16;
};

type Vlr = unit {
    reserved: uint16;
    user_id: bytes &size=16;
    record_id: uint16;
    record_length_after_header: uint16;
    description: bytes &size=32;
    data: bytes &size=self.record_length_after_header;
};

type Header = unit {
    magic: bytes &size=4 &requires=(self.magic == b"LASF");
    file_source_id: bytes &size=2;
    global_encoding: bytes &size=2;
    project_id_guid: bytes &size=16;
    version_major: uint8;
    version_minor: uint8;
    system_identifier: bytes &size=32;
    generating_software: bytes &size=32;
    creation_day_of_year: uint16;
    creation_year: uint16;
    header_size: uint16;               # STRUCTURAL, always 227 on encode
    offset_to_point_data: uint32;      # STRUCTURAL
    number_of_vlrs: uint32;            # STRUCTURAL
    point_data_format_id: uint8;       # STRUCTURAL, 0-3 supported
    point_data_record_length: uint16;  # STRUCTURAL
    number_of_point_records: uint32;   # STRUCTURAL
    points_by_return: uint32[5];
    x_scale: double;
    y_scale: double;
    z_scale: double;
    x_offset: double;
    y_offset: double;
    z_offset: double;
    max_x: double;
    min_x: double;
    max_y: double;
    min_y: double;
    max_z: double;
    min_z: double;
};

type Document = unit {
    header: Header;
    vlrs: Vlr[] &count=self.header.number_of_vlrs;
    # Point records: format 0-3, dispatched on header.point_data_format_id (0=common only,
    # 1=+gps_time, 2=+rgb, 3=+gps_time+rgb) -- see component.ksy's `switch-on` for the
    # equivalent typed dispatch; kept as raw bytes here since Spicy's own dispatch idiom
    # differs, this leaf documents the byte-count contract, not a live parser.
    points: bytes &size=(self.header.number_of_point_records * self.header.point_data_record_length);
};
