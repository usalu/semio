{
  "$id": "https://semio.tech/schema/s.stdio.las/diff.json",
  "title": "LasDiff",
  "type": "object",
  "definitions": {
    "LasVlrDiff": {
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "recordId": { "type": "integer" },
        "description": { "type": "string" },
        "data": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "LasVlrsDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer" } },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "index": { "type": "integer" }, "diff": { "$ref": "#/definitions/LasVlrDiff" } }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "index": { "type": "integer" }, "vlr": { "type": "object" } }
          }
        }
      }
    },
    "LasPointDiff": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "intensity": { "type": "integer" },
        "returnNumber": { "type": "integer" },
        "numberOfReturns": { "type": "integer" },
        "scanDirectionFlag": { "type": "boolean" },
        "edgeOfFlightLine": { "type": "boolean" },
        "classification": { "type": "integer" },
        "scanAngleRank": { "type": "integer" },
        "userData": { "type": "integer" },
        "pointSourceId": { "type": "integer" },
        "gpsTime": { "type": ["number", "null"] },
        "rgb": { "type": ["array", "null"], "items": { "type": "integer" }, "minItems": 3, "maxItems": 3 }
      }
    },
    "LasPointsDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer" } },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "index": { "type": "integer" }, "diff": { "$ref": "#/definitions/LasPointDiff" } }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "index": { "type": "integer" }, "point": { "type": "object" } }
          }
        }
      }
    }
  },
  "properties": {
    "versionMajor": { "type": "integer", "x-semio-state": "artifact" },
    "versionMinor": { "type": "integer", "x-semio-state": "artifact" },
    "systemIdentifier": { "type": "string", "x-semio-state": "artifact" },
    "generatingSoftware": { "type": "string", "x-semio-state": "artifact" },
    "creationDayOfYear": { "type": "integer", "x-semio-state": "artifact" },
    "creationYear": { "type": "integer", "x-semio-state": "artifact" },
    "headerSize": { "type": "integer", "x-semio-state": "artifact" },
    "offsetToPointData": { "type": "integer", "x-semio-state": "artifact" },
    "numberOfVlrs": { "type": "integer", "x-semio-state": "artifact" },
    "pointDataFormatId": { "type": "integer", "x-semio-state": "artifact" },
    "pointDataRecordLength": { "type": "integer", "x-semio-state": "artifact" },
    "numberOfPointRecords": { "type": "integer", "x-semio-state": "artifact" },
    "pointsByReturn": { "type": "array", "items": { "type": "integer" }, "minItems": 5, "maxItems": 5, "x-semio-state": "artifact" },
    "xScale": { "type": "number", "x-semio-state": "artifact" },
    "yScale": { "type": "number", "x-semio-state": "artifact" },
    "zScale": { "type": "number", "x-semio-state": "artifact" },
    "xOffset": { "type": "number", "x-semio-state": "artifact" },
    "yOffset": { "type": "number", "x-semio-state": "artifact" },
    "zOffset": { "type": "number", "x-semio-state": "artifact" },
    "maxX": { "type": "number", "x-semio-state": "artifact" },
    "minX": { "type": "number", "x-semio-state": "artifact" },
    "maxY": { "type": "number", "x-semio-state": "artifact" },
    "minY": { "type": "number", "x-semio-state": "artifact" },
    "maxZ": { "type": "number", "x-semio-state": "artifact" },
    "minZ": { "type": "number", "x-semio-state": "artifact" },
    "vlrs": { "$ref": "#/definitions/LasVlrsDiff", "x-semio-state": "artifact" },
    "points": { "$ref": "#/definitions/LasPointsDiff", "x-semio-state": "artifact" }
  }
}
