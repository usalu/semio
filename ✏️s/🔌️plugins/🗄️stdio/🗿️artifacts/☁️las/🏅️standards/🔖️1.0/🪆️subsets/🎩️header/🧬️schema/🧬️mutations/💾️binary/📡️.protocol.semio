dialect protocol
protocol stdio.las.mutations
version 1
schema stdio.las
start op
framing record

# Real `LasMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record set-version tag=1
field payload bytes
record set-system-identifier tag=2
field payload bytes
record set-software-info tag=3
field payload bytes
record set-creation-date tag=4
field payload bytes
record set-scale-and-offset tag=5
field payload bytes
record set-bounds tag=6
field payload bytes
record set-points-by-return tag=7
field payload bytes
record insert-vlr tag=8
field payload bytes
record remove-vlr tag=9
field payload bytes
record set-vlr-data tag=10
field payload bytes
record insert-point tag=11
field payload bytes
record remove-point tag=12
field payload bytes
record set-point tag=13
field payload bytes
