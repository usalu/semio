{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/las/1.0/header/mutation/set-version/schema.json",
  "title": "SetVersion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "major",
    "minor"
  ],
  "properties": {
    "major": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "mutation": {
      "const": "setVersion",
      "description": "Aggregate discriminator spliced in by LasMutation; absent when the payload stands alone."
    }
  }
}
