{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/las/1.0/header/mutation/set-version/schema.json",
  "title": "SetVersion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "major",
    "minor"
  ],
  "properties": {
    "mutation": {
      "const": "setVersion",
      "description": "Aggregate discriminator spliced in by LasMutation; absent when the payload stands alone."
    },
    "major": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Major version",
          "de": "Hauptversion"
        },
        "step": 1
      }
    },
    "minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Minor version",
          "de": "Nebenversion"
        },
        "step": 1
      }
    }
  }
}
