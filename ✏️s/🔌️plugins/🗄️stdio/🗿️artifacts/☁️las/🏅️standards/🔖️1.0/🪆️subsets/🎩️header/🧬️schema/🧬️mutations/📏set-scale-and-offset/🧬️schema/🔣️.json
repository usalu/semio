{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/las/1.0/header/mutation/set-scale-and-offset/schema.json",
  "title": "SetScaleAndOffset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "scale",
    "offset"
  ],
  "properties": {
    "mutation": {
      "const": "setScaleAndOffset",
      "description": "Aggregate discriminator spliced in by LasMutation; absent when the payload stands alone."
    },
    "scale": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Scale factors",
          "de": "Skalierungsfaktoren"
        },
        "description": {
          "en": "X, Y and Z factor that turns the stored integer coordinates into real coordinates.",
          "de": "X-, Y- und Z-Faktor, der die gespeicherten ganzzahligen Koordinaten in reale Koordinaten umrechnet."
        },
        "group": "value",
        "order": 10
      }
    },
    "offset": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 3,
      "maxItems": 3,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Offsets",
          "de": "Versätze"
        },
        "description": {
          "en": "X, Y and Z offset added to the scaled coordinates.",
          "de": "X-, Y- und Z-Versatz, der zu den skalierten Koordinaten addiert wird."
        },
        "group": "value",
        "order": 20
