{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/las/1.0/header/mutation/insert-vlr/schema.json",
  "title": "InsertVlr",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "vlr"
  ],
  "properties": {
    "mutation": {
      "const": "insertVlr",
      "description": "Aggregate discriminator spliced in by LasMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the variable length records at which it is inserted, counted from 0.",
          "de": "Position unter den Datensätzen variabler Länge, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "vlr": {
      "$ref": "#/$defs/LasVlr",
      "x-semio-ui": {
        "label": {
          "en": "Variable length record",
          "de": "Datensatz variabler Länge (VLR)"
        }
      }
    }
  },
  "$defs": {
    "LasVlr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "recordId",
        "description",
        "data"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "User ID",
              "de": "Benutzerkennung"
            },
            "description": {
              "en": "Registered VLR owner, e.g. LASF_Projection.",
              "de": "Registrierter VLR-Eigentümer, z. B. LASF_Projection."
            }
          }
        },
        "recordId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Record ID",
              "de": "Datensatz-ID"
            }
          }
        },
        "description": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
