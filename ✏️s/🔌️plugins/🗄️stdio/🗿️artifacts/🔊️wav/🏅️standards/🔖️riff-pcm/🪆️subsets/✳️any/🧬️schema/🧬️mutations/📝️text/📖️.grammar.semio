dialect grammar
grammar stdio.wav.mutations
start operation
comment none
string double backslash

operation = object
value = object | array | json-string | number | "true" | "false" | "null"
object = "{" "}" | "{" member {"," member}* "}"
member = json-string ":" value
array = "[" "]" | "[" value {"," value}* "]"
json-string = TEXT
number = INT | FLOAT
