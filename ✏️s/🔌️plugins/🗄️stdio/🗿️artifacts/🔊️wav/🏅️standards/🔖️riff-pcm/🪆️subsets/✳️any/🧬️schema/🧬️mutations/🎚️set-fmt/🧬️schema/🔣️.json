{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/wav/riff-pcm/any/mutation/set-fmt.json",
  "title": "SetFmt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fmt"
  ],
  "properties": {
    "fmt": {
      "$ref": "#/$defs/WavFmt"
    },
    "mutation": {
      "const": "setFmt",
      "description": "Aggregate discriminator spliced in by WavMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "WavFmt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioFormat",
        "channels",
        "sampleRate",
        "byteRate",
        "blockAlign",
        "bitsPerSample"
      ],
      "properties": {
        "audioFormat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "channels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "byteRate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "blockAlign": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bitsPerSample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ext": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
