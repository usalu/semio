  "_comment": "🧩️ This subset contributes the exhaustive WAV RIFF-PCM mutation vocabulary. The root stdio oracle manifest owns the shared dependency-free PCM16 oracle for both creation and mutation capabilities.",
  "oracles": [
    {
      "id": "riff-wav-riff-pcm-mutate-chunk-reader",
      "kind": "third-party-library",
      "ecosystem": "rust",
      "package": "riff",
      "version": "2.0.0",
      "engine": {
        "family": "riff",
        "implementation": "riff generic RIFF container reader/writer, composed with the PCM16 fmt/data field layout",
        "version": "2.0.0"
      },
      "capabilities": [
        "wav-riff-pcm-mutate"
      ],
      "license": "MIT",
      "testOnly": true,
      "productionReachable": false,
      "networkDuringExecution": false,
      "homepage": "https://github.com/frabert/riff",
      "rationale": "📖️ The RIFF/WAVE oracle this subset's mutation case runs. `riff` 2.0.0 is a from-scratch generic RIFF container reader and writer used nowhere in this repository's WAV path: `riff::Chunk::read` + `.iter()` walk every top-level chunk by id and length, and `riff::ChunkContents::write` frames and pads every chunk this oracle emits. This subset's oracle module composes it with its own reading of the 16-byte PCM `fmt ` layout and the little-endian PCM16 `data` words — the same shape as the AVI oracle's riff composition — so every declared kind (`set-snapshot`, `patch-snapshot`, `set-fmt`, `set-data`, `patch-data`, `set-other-chunks`) is performed and re-serialized without any subject codec code. Verified against this subset's own committed `shared://🎙️bauen-mit-bestand-ausschnitt/🔊️.wav`: the walker reports the real top-level `fmt ` (16 bytes) / `data` (192000 bytes) sequence, and the identity round trip reproduces the canonical 44-byte-header layout byte for byte.",
      "comparisonProfiles": [
        "semantic-audio-v1"
      ]
    }
  ],
