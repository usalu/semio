{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/wav/riff-pcm/any/inference.json",
  "title": "WavInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "duration"
  ],
  "properties": {
    "duration": {
      "$ref": "#/$defs/WavDuration",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "WavDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationSeconds",
        "frameCount",
        "bitsPerSample"
      ],
      "properties": {
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "frameCount": {
          "type": "integer",
          "minimum": 0
        },
        "bitsPerSample": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
