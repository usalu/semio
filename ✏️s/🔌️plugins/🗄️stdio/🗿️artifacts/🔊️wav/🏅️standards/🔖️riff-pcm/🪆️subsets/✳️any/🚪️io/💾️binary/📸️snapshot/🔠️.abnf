; The binary snapshot is the shared `.semio` envelope (store::semio_format::wrap_binary) around the artifact pack of `stdio.wav`;
; the pack's records are declared by the sibling 📡️.protocol.semio.
document   = magic token-len token payload
magic      = %x89 %x53 %x45 %x4D %x0D %x0A %x1A %x0A
token-len  = 4OCTET
token      = *OCTET
payload    = *OCTET
