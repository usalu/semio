{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/wav/riff-pcm/any/diff.json",
  "title": "WavDiff",
  "description": "Sparse editable RIFF/WAVE state delta.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fmt": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/wav/riff-pcm/any/snapshot.json#/$defs/WavFmt" },
    "data": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/wav/riff-pcm/any/snapshot.json#/$defs/WavData" },
    "fmtPadByte": { "type": "integer", "minimum": 0, "maximum": 255 },
    "dataPadByte": { "type": "integer", "minimum": 0, "maximum": 255 },
    "otherChunks": { "type": "array", "items": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/wav/riff-pcm/any/snapshot.json#/$defs/RiffChunk" } },
    "chunkOrder": { "type": "array", "items": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/wav/riff-pcm/any/snapshot.json#/$defs/WavChunkRef" } }
  }
}
