{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/wav/riff-pcm/any/mutation/set-other-chunks/schema.json",
  "title": "SetOtherChunks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "chunks"
  ],
  "properties": {
    "mutation": {
      "const": "setOtherChunks",
      "description": "Aggregate discriminator spliced in by WavMutation; absent when the payload stands alone."
    },
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RiffChunk"
      },
      "x-semio-ui": {
        "label": {
          "en": "Other chunks",
          "de": "Weitere Chunks"
        }
      }
    },
    "chunkOrder": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WavChunkRef"
      },
      "x-semio-ui": {
        "label": {
          "en": "Chunk order",
          "de": "Chunk-Reihenfolge"
        }
      }
    }
  },
  "$defs": {
    "RiffChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourcc",
        "data"
      ],
      "properties": {
        "fourcc": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[ -~]{4}$",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Chunk ID (FourCC)",
              "de": "Chunk-ID (FourCC)"
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "padByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0,
          "description": "Word-alignment byte; must be zero when data has even length.",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Pad byte",
              "de": "Füllbyte"
            },
            "description": {
              "en": "Word-alignment byte; zero when the data length is even.",
              "de": "Byte zur Wortausrichtung; null bei gerader Datenlänge."
            }
          }
        }
      }
    },
    "WavChunkRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "format"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "samples"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "other"
            },
            "value": {
              "$ref": "#/$defs/Unsigned64"
            }
          }
        }
      ]
    },
    "Unsigned64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    }
  }
}
