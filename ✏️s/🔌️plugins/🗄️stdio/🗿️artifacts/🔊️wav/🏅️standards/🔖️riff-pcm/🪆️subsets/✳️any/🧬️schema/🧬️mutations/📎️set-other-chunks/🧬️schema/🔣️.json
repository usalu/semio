{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/wav/riff-pcm/any/mutation/set-other-chunks.json",
  "title": "SetOtherChunks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunks"
  ],
  "properties": {
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RiffChunk"
      }
    },
    "mutation": {
      "const": "setOtherChunks",
      "description": "Aggregate discriminator spliced in by WavMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "RiffChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourcc"
      ],
      "properties": {
        "fourcc": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
