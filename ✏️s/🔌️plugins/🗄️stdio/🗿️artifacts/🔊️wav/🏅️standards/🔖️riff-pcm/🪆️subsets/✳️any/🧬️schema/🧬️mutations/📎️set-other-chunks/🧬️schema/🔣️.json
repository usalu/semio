{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/wav/riff-pcm/any/mutation/set-other-chunks/schema.json",
  "title": "SetOtherChunks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunks"
  ],
  "properties": {
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RiffChunk"
      }
    },
    "mutation": {
      "const": "setOtherChunks",
      "description": "Aggregate discriminator spliced in by WavMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "RiffChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourcc",
        "data"
      ],
      "properties": {
        "fourcc": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[ -~]{4}$"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "padByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0,
          "description": "Word-alignment byte; must be zero when data has even length."
        }
      }
    }
  }
}
