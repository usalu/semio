{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/wav/riff-pcm/any/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "snapshot"
  ],
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/WavSnapshot"
    },
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by WavMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "WavSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "fmt",
        "data",
        "otherChunks",
        "chunkOrder"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Snapshot schema",
              "de": "Snapshot-Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema version.",
              "de": "Kennung der Version des Snapshot-Schemas."
            }
          }
        },
        "fmt": {
          "$ref": "#/$defs/WavFmt",
          "x-semio-ui": {
            "label": {
              "en": "Format chunk (fmt)",
              "de": "Format-Chunk (fmt)"
            }
          }
        },
        "data": {
          "$ref": "#/$defs/WavData"
        },
        "fmtPadByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0,
          "description": "Word-alignment byte; must be zero when the serialized fmt payload length is even.",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Format pad byte",
              "de": "Füllbyte des Formats"
            },
            "description": {
              "en": "Word-alignment byte after the fmt chunk; zero when its length is even.",
              "de": "Byte zur Wortausrichtung nach dem fmt-Chunk; null bei gerader Länge."
            }
          }
        },
        "dataPadByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0,
          "description": "Word-alignment byte; must be zero when the serialized data payload length is even.",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Data pad byte",
              "de": "Füllbyte der Daten"
            },
            "description": {
              "en": "Word-alignment byte after the data chunk; zero when its length is even.",
              "de": "Byte zur Wortausrichtung nach dem Daten-Chunk; null bei gerader Länge."
            }
          }
        },
        "otherChunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RiffChunk"
          },
          "x-semio-ui": {
            "label": {
              "en": "Other chunks",
              "de": "Weitere Chunks"
            },
            "description": {
              "en": "RIFF chunks without a dedicated field, kept verbatim.",
              "de": "RIFF-Chunks ohne eigenes Feld, unverändert erhalten."
            }
          }
        },
        "chunkOrder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WavChunkRef"
          },
          "x-semio-ui": {
            "label": {
              "en": "Chunk order",
              "de": "Chunk-Reihenfolge"
            }
          }
        }
      }
    },
    "WavFmt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioFormat",
        "channels",
        "sampleRate",
        "byteRate",
        "blockAlign",
        "bitsPerSample"
      ],
      "properties": {
        "audioFormat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Audio format",
              "de": "Audioformat"
            },
            "description": {
              "en": "wFormatTag, e.g. 1 = PCM, 3 = IEEE float, 0xFFFE = extensible.",
              "de": "wFormatTag, z. B. 1 = PCM, 3 = IEEE-Gleitkomma, 0xFFFE = Extensible."
            }
          }
        },
        "channels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Channels",
              "de": "Kanäle"
            }
          }
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Sample rate",
              "de": "Abtastrate"
            },
            "unit": "Hz"
          }
        },
        "byteRate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Byte rate",
              "de": "Byterate"
            },
            "description": {
              "en": "Average bytes per second.",
              "de": "Durchschnittliche Bytes pro Sekunde."
            },
            "unit": "B/s"
          }
        },
        "blockAlign": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Block align",
              "de": "Blockausrichtung"
            },
            "description": {
              "en": "Bytes per sample frame across all channels.",
              "de": "Bytes je Sample-Frame über alle Kanäle."
            },
            "unit": "B"
          }
        },
        "bitsPerSample": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Bits per sample",
              "de": "Bits pro Sample"
            },
            "unit": "bit"
          }
        },
        "ext": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 65535,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Format extension",
              "de": "Formaterweiterung"
            },
            "description": {
              "en": "cbSize extension bytes of WAVEFORMATEX.",
              "de": "cbSize-Erweiterungsbytes von WAVEFORMATEX."
            }
          }
        }
      }
    },
    "WavData": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pcm16"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -32768,
                "maximum": 32767
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pcm8"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "float32"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "raw"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "RiffChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourcc",
        "data"
      ],
      "properties": {
        "fourcc": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[ -~]{4}$",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Chunk ID (FourCC)",
              "de": "Chunk-ID (FourCC)"
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "padByte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0,
          "description": "Word-alignment byte; must be zero when data has even length.",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Pad byte",
              "de": "Füllbyte"
            },
            "description": {
              "en": "Word-alignment byte; zero when the data length is even.",
              "de": "Byte zur Wortausrichtung; null bei gerader Datenlänge."
            }
          }
        }
      }
    },
    "WavChunkRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "format" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "samples" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "other" },
            "value": { "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/wav/riff-pcm/any/snapshot.json#/$defs/Unsigned64" }
          }
        }
      ]
    }
  }
}
