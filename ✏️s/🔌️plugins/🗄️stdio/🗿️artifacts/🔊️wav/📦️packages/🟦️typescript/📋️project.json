{
  "name": "@semio-tech/stdio-wav",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:typescript",
    "role:artifact",
    "family:stdio"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🔊️wav/**/*",
        "!{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🔊️wav/📦️packages/**/dist/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🔏️hash/**/*",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/**/*",
        "{workspaceRoot}/bun.lock"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🔊️wav/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🔊️wav/**/*",
        "!{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🔊️wav/📦️packages/**/dist/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🔏️hash/**/*",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/**/*",
        "{workspaceRoot}/bun.lock"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🔊️wav/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🔊️wav/**/*",
        "!{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🔊️wav/📦️packages/**/dist/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🔏️hash/**/*",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/**/*",
        "{workspaceRoot}/bun.lock"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/🔊️wav/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    }
  }
}
