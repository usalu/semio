dialect protocol
protocol stdio.mp3.snapshot
version 1
schema stdio.mp3
start snapshot
framing record
use semio.pack

# These logical records declare native scalar domains. RecordSpec controls field presence,
# ordered collections and Pack framing; optional tags retain absence independently of emptiness.
record snapshot {
  schema utf8
  id3v2 Value
  frames array Mp3Frame
  id3v1 Value
}
record Id3v2Tag {
  frames array Id3Frame
}
record Id3Frame {
  id utf8
  content Value
}
record Id3Text {
  values array utf8
}
record Id3UserText {
  description utf8
  values array utf8
}
record Id3Comment {
  language utf8
  description utf8
  text utf8
}
record Id3Lyrics {
  language utf8
  description utf8
  text utf8
}
record Id3Url {
  url utf8
}
record Id3UserUrl {
  description utf8
  url utf8
}
record Id3Picture {
  mime utf8
  pictureType u8
  description utf8
  payload bytes
}
record Id3Opaque {
  bytes bytes
}
record Mp3Frame {
  header Mp3FrameHeader
  payload bytes
}
record Mp3FrameHeader {
  mpegVersionId u8
  layer u8
  protectionBit u8
  bitrateIndex u8
  sampleRateIndex u8
  padding u8
  privateBit u8
  channelMode u8
  modeExtension u8
  copyright u8
  original u8
  emphasis u8
}
record Id3v1Tag {
  title utf8
  artist utf8
  album utf8
  year utf8
  comment utf8
  track Value
  genre Value
}
