{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp3/mpeg1-layer3/any/mutation/set-id3v2/schema.json",
  "title": "SetId3v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setId3v2"
    },
    "id3v2": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id3v2Tag"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "ID3v2 tag",
          "de": "ID3v2-Tag"
        }
      }
    }
  },
  "$defs": {
    "Id3v2Tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "majorVersion",
        "minorVersion",
        "flags"
      ],
      "properties": {
        "majorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Major version",
              "de": "Hauptversion"
            }
          }
        },
        "minorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Revision",
              "de": "Revision"
            }
          }
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Tag flags",
              "de": "Tag-Flags"
            }
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id3Frame"
          },
          "x-semio-ui": {
            "label": {
              "en": "ID3v2 frames",
              "de": "ID3v2-Frames"
            }
          }
        }
      }
    },
    "Id3Frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "flags"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Frame flags",
              "de": "Frame-Flags"
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
