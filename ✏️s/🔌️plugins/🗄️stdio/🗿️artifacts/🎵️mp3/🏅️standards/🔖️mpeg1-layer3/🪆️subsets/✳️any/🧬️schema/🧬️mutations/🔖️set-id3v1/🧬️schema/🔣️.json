{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp3/mpeg1-layer3/any/mutation/set-id3v1/schema.json",
  "title": "SetId3v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setId3v1"
    },
    "id3v1": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id3v1Tag"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "ID3v1 tag",
          "de": "ID3v1-Tag"
        }
      }
    }
  },
  "$defs": {
    "Id3v1Tag": {
      "type": "object",
      "required": [
        "title",
        "artist",
        "album",
        "year",
        "comment",
        "track",
        "genre"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "pattern": "^(?:[\\x01-\\xff]*[\\x01-\\x1f\\x21-\\xff])?$",
          "maxLength": 30
        },
        "artist": {
          "type": "string",
          "pattern": "^(?:[\\x01-\\xff]*[\\x01-\\x1f\\x21-\\xff])?$",
          "maxLength": 30
        },
        "album": {
          "type": "string",
          "pattern": "^(?:[\\x01-\\xff]*[\\x01-\\x1f\\x21-\\xff])?$",
          "maxLength": 30
        },
        "year": {
          "type": "string",
          "pattern": "^(?:[\\x01-\\xff]*[\\x01-\\x1f\\x21-\\xff])?$",
          "maxLength": 4
        },
        "comment": {
          "type": "string",
          "pattern": "^(?:[\\x01-\\xff]*[\\x01-\\x1f\\x21-\\xff])?$",
          "maxLength": 30
        },
        "track": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          ]
        },
        "genre": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 254
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "track": {
                "type": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "comment": {
                "maxLength": 28
              }
            }
          }
        }
      ]
    }
  }
}
