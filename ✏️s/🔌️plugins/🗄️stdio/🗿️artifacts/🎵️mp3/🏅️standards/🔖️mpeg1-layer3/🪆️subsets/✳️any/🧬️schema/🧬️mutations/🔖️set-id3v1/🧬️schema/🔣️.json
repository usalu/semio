{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp3/mpeg1-layer3/any/mutation/set-id3v1/schema.json",
  "title": "SetId3v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "setId3v1"
    },
    "id3v1": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id3v1Tag"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "ID3v1 tag",
          "de": "ID3v1-Tag"
        }
      }
    }
  },
  "$defs": {
    "Id3v1Tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Raw tag bytes",
              "de": "Rohbytes des Tags"
            },
            "description": {
              "en": "The 128 bytes of the ID3v1 tag.",
              "de": "Die 128 Bytes des ID3v1-Tags."
            }
          }
        }
      }
    }
  }
}
