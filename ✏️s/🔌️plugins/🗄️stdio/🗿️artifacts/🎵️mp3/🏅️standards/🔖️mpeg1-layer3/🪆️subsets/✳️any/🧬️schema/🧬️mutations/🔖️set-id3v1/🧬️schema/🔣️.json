{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/mp3/mpeg1-layer3/any/mutation/set-id3v1.json",
  "title": "SetId3v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id3v1": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id3v1Tag"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "Id3v1Tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
