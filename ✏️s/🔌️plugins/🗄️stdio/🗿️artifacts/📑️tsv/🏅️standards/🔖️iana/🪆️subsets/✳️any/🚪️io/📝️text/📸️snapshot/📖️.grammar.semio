dialect grammar
grammar stdio.tsv.snapshot
extension tsv
start snapshot
comment none

snapshot = "schema" "=" text "trailing-newline" "=" boolean "line-ending" "=" ending "records" "=" "[" row* "]"
row = "[" text* "]"
text = STRING / IDENT / INT / FLOAT
boolean = "true" / "false"
ending = "lf" / "crlf"
