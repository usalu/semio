{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/tsv/iana/any/inference.json",
  "title": "TsvInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outline"
  ],
  "properties": {
    "outline": {
      "$ref": "#/$defs/TsvOutline",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "TsvOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordCount",
        "columnCount"
      ],
      "properties": {
        "recordCount": {
          "type": "integer"
        },
        "columnCount": {
          "type": "integer"
        }
      }
    }
  }
}
