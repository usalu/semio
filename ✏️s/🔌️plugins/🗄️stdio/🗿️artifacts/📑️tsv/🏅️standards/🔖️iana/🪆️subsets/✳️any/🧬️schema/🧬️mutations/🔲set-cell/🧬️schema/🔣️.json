{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tsv/iana/any/mutation/set-cell/schema.json",
  "title": "SetCellMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rowIndex",
    "fieldIndex",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setCell",
      "description": "Aggregate discriminator checked when this payload is embedded in TsvMutation."
    },
    "rowIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Record index",
          "de": "Datensatzindex"
        },
        "description": {
          "en": "Zero-based record (line) of the cell.",
          "de": "Nullbasierter Datensatz (Zeile) der Zelle."
        }
      }
    },
    "fieldIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Field index",
          "de": "Feldindex"
        },
        "description": {
          "en": "Zero-based column of the cell.",
          "de": "Nullbasierte Spalte der Zelle."
        }
      }
    },
    "value": {
      "type": "string"
    }
  }
}
