{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/tsv/iana/any/mutation/set-cell/schema.json",
  "title": "SetCellMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rowIndex",
    "fieldIndex",
    "value"
  ],
  "properties": {
    "rowIndex": {
      "type": "integer",
      "minimum": 0
    },
    "fieldIndex": {
      "type": "integer",
      "minimum": 0
    },
    "value": {
      "type": "string"
    },
    "mutation": {
      "const": "setCell",
      "description": "Aggregate discriminator spliced in by TsvMutation; absent when the payload stands alone."
    }
  }
}
