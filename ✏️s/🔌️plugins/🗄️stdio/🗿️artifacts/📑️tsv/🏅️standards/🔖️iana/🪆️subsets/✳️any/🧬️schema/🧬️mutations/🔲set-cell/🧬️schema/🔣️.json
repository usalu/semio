{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tsv/iana/any/mutation/set-cell/schema.json",
  "title": "SetCellMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rowIndex",
    "fieldIndex",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setCell",
      "description": "Aggregate discriminator checked when this payload is embedded in TsvMutation."
    },
    "rowIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Record index",
          "de": "Datensatzindex"
        },
        "description": {
          "en": "Zero-based record (line) of the cell.",
          "de": "Nullbasierter Datensatz (Zeile) der Zelle."
        },
        "step": 1
      }
    },
    "fieldIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Field index",
          "de": "Feldindex"
        },
        "description": {
          "en": "Zero-based column of the cell.",
          "de": "Nullbasierte Spalte der Zelle."
        },
        "step": 1
      }
    },
    "value": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Field value",
          "de": "Feldwert"
        },
        "description": {
          "en": "Text the field holds afterwards; a tab or a line break cannot be part of a TSV field.",
          "de": "Text, den das Feld danach enthält; Tabulator und Zeilenumbruch können nicht Teil eines TSV-Felds sein."
        },
        "group": "value",
        "order": 30
      }
    }
  }
}
