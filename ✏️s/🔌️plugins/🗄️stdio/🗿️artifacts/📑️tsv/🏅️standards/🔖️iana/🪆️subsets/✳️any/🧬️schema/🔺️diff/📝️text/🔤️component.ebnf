(* Hand-rolled `stdio.tsv.diff` wire text (see 🦀️component.rs `print_tsv_diff`/`parse_tsv_diff`
   for the real, authoritative implementation). *)
diff = token, { sp, token } ;
token = "trailing-newline=", bit
      | "line-ending=", ( "lf" | "crlf" )
      | "records{", removed, ";", modified, ";", added, "}" ;
removed = "[", [ int, { ",", int } ], "]" ;
modified = "[", [ modentry, { ",", modentry } ], "]" ;
modentry = int, ":", rowdiff ;
rowdiff = "[0]" | "[1,[", [ option, { ",", option } ], "]]" ;
added = "[", [ addentry, { ",", addentry } ], "]" ;
addentry = int, ":", "[", [ hex, { ",", hex } ], "]" ;
option = "[0]" | "[1,", hex, "]" ;
hex = { hexdigit, hexdigit } ;
bit = "0" | "1" ;
sp = " " ;
