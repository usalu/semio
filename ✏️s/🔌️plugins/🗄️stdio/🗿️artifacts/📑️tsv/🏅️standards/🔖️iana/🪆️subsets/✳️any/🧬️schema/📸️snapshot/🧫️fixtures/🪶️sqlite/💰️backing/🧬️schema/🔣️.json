{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "schema",
    "records",
    "fields",
    "policy"
  ],
  "properties": {
    "owner": {
      "const": "tsv"
    },
    "schema": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ordinal"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "recordId",
          "ordinal",
          "value"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "recordId": {
            "type": "integer",
            "minimum": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zeroOwnershipBytes",
        "refusalKind",
        "retirementRefund",
        "byteAuthority",
        "indexAuthority"
      ],
      "properties": {
        "zeroOwnershipBytes": {
          "const": 0
        },
        "refusalKind": {
          "const": "ownershipLimit"
        },
        "retirementRefund": {
          "const": false
        },
        "byteAuthority": {
          "const": "literalUTF8Bytes"
        },
        "indexAuthority": {
          "const": "authoredEntityRelations"
        }
      }
    }
  }
}
