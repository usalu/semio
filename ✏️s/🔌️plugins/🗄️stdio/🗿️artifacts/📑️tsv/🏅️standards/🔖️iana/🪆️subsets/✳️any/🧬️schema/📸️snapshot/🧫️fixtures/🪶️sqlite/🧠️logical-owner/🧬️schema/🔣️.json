{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "encodings",
    "snapshots",
    "policy",
    "edit"
  ],
  "properties": {
    "contract": {
      "const": "completeTsvLogicalOwner"
    },
    "encodings": {
      "const": [
        "binary",
        "text"
      ]
    },
    "snapshots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "records",
          "trailingNewline",
          "lineEnding"
        ],
        "properties": {
          "schema": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "trailingNewline": {
            "type": "boolean"
          },
          "lineEnding": {
            "enum": [
              "lf",
              "crlf"
            ]
          }
        }
      }
    },
    "policy": {
      "const": {
        "preserveSchema": true,
        "preserveTrailingNewline": true,
        "preserveLineEnding": true,
        "preserveEmptyRecord": true,
        "nativeOwner": "declaredLogicalRecord",
        "naturalFile": "ianaTsv"
      }
    },
    "edit": {
      "const": {
        "query": "UPDATE tsv_document SET line_ending='lf',trailing_newline=0",
        "snapshotIndex": 3
      }
    }
  }
}
