{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tsv/iana/any/mutation/set-trailing-newline/schema.json",
  "title": "SetTrailingNewlineMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "trailingNewline"
  ],
  "properties": {
    "mutation": {
      "const": "setTrailingNewline",
      "description": "Aggregate discriminator spliced in by TsvMutation; absent when the payload stands alone."
    },
    "trailingNewline": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "label": {
          "en": "Trailing newline",
          "de": "Abschließender Zeilenumbruch"
        },
        "description": {
          "en": "Ends the last record with a line break.",
          "de": "Beendet den letzten Datensatz mit einem Zeilenumbruch."
        }
      }
    }
  }
}
