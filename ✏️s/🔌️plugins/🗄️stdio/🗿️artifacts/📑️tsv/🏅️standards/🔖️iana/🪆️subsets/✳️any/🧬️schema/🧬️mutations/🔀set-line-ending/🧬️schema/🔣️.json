{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tsv/iana/any/mutation/set-line-ending/schema.json",
  "title": "SetLineEnding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineEnding"
  ],
  "properties": {
    "mutation": {
      "const": "setLineEnding",
      "description": "Aggregate discriminator checked when this payload is embedded in TsvMutation."
    },
    "lineEnding": {
      "$ref": "#/$defs/LineEnding",
      "x-semio-ui": {
        "widget": "segmented",
        "label": {
          "en": "Line ending",
          "de": "Zeilenende"
        },
        "options": {
          "lf": {
            "en": "LF (Unix)",
            "de": "LF (Unix)"
          },
          "crlf": {
            "en": "CRLF (Windows)",
            "de": "CRLF (Windows)"
          }
        }
      }
    }
  },
  "$defs": {
    "LineEnding": {
      "type": "string",
      "enum": [
        "lf",
        "crlf"
      ]
    }
  }
}
