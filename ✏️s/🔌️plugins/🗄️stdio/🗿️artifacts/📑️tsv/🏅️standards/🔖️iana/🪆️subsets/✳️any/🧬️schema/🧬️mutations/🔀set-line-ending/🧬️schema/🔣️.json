{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/tsv/iana/any/mutation/set-line-ending/schema.json",
  "title": "SetLineEnding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineEnding"
  ],
  "properties": {
    "lineEnding": {
      "$ref": "#/$defs/LineEnding"
    },
    "mutation": {
      "const": "setLineEnding",
      "description": "Aggregate discriminator spliced in by TsvMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "LineEnding": {
      "type": "string",
      "enum": [
        "lf",
        "crlf"
      ]
    }
  }
}
