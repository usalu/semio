{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tsv/iana/any/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot"
  ],
  "properties": {
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator checked when this payload is embedded in TsvMutation."
    },
    "snapshot": {
      "$ref": "#/$defs/TsvSnapshot"
    }
  },
  "$defs": {
    "TsvSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Snapshot schema",
              "de": "Snapshot-Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema version.",
              "de": "Kennung der Version des Snapshot-Schemas."
            }
          }
        },
        "records": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Records",
              "de": "Datensätze"
            }
          }
        },
        "trailingNewline": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Trailing newline",
              "de": "Abschließender Zeilenumbruch"
            },
            "description": {
              "en": "Ends the last record with a line break.",
              "de": "Beendet den letzten Datensatz mit einem Zeilenumbruch."
            }
          }
        },
        "lineEnding": {
          "$ref": "#/$defs/LineEnding",
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Line ending",
              "de": "Zeilenende"
            },
            "options": {
              "lf": {
                "en": "LF (Unix)",
                "de": "LF (Unix)"
              },
              "crlf": {
                "en": "CRLF (Windows)",
                "de": "CRLF (Windows)"
              }
            }
          }
        }
      }
    },
    "LineEnding": {
      "type": "string",
      "enum": [
        "lf",
        "crlf"
      ]
    }
  }
}
