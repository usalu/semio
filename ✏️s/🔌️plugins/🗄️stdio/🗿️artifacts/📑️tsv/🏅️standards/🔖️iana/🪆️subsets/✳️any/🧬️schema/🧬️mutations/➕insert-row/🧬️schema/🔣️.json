{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tsv/iana/any/mutation/insert-row/schema.json",
  "title": "InsertRowMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "row"
  ],
  "properties": {
    "mutation": {
      "const": "insertRow",
      "description": "Aggregate discriminator spliced in by TsvMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "row": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
