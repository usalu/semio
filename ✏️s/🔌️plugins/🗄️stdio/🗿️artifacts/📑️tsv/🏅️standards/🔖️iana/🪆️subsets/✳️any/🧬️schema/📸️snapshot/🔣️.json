{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/tsv/iana/any/snapshot.json",
  "title": "TsvSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "records",
    "trailingNewline",
    "lineEnding"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "records": {
      "type": "array",
      "x-semio-state": "artifact",
      "description": "Raw row grid; IANA TSV draws no structural header/data distinction.",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "trailingNewline": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "lineEnding": {
      "type": "string",
      "enum": [
        "lf",
        "crlf"
      ],
      "x-semio-state": "artifact"
    }
  }
}
