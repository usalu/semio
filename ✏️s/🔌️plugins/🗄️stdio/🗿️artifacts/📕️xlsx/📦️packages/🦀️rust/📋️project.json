    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/📕️xlsx/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
