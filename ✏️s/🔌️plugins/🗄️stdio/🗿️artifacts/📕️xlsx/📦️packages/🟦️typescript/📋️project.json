    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "options": {
