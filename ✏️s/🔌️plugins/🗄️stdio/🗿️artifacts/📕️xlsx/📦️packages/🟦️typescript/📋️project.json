{
  "name": "@semio-tech/stdio-xlsx",
  "$schema": "../../../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "tags": [
    "language:typescript",
    "role:artifact",
    "family:stdio"
  ],
  "namedInputs": {
    "default": [
      "{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/📰️xml/**/*.{ts,tsx,json,semio,wit,sql}",
