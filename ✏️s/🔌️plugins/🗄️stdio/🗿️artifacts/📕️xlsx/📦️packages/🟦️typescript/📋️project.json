{
  "name": "@semio-tech/stdio-xlsx",
  "$schema": "../../../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "projectType": "library",
  "tags": [
    "language:typescript",
    "role:artifact",
    "family:stdio"
  ],
  "namedInputs": {
    "xlsxSources": [
      "{projectRoot}/../../🏅️standards/**/*",
      "{projectRoot}/../../🟦️.ts",
      "{projectRoot}/../../📜️artifact-definition.json",
      "{workspaceRoot}/✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/📰️xml/**/*.{ts,tsx,json,semio,wit,sql}",
      "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "xlsxSources"
      ],
      "outputs": [
        "{projectRoot}/.🧾️store/build.json"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/📕️xlsx/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "repo:script",
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/📕️xlsx/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts check",
        "forwardAllArgs": true
      },
      "inputs": [
        "production",
        "^production",
        "xlsxSources"
      ]
    },
    "test": {
      "executor": "repo:script",
      "outputs": [],
      "options": {
        "cwd": "✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/📕️xlsx/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "inputs": [
        "production",
        "^production",
        "xlsxSources"
      ]
    }
  },
  "metadata": {
    "semio": {
      "artifactPackage": {
        "kind": "typescript-artifact-package",
        "source": "../../🟦️.ts",
        "target": "build"
      }
    }
  }
}
