dialect protocol
protocol stdio.xlsx.strict.mutations
version 1
schema stdio.xlsx
start document
framing magic 0x8953504B0D0A1A0A

# Semio Pack document v1. Field 1 (`value`) holds the externally tagged
# XlsxStrictMutation defined in the Strict mutation schema. The Pack format defines
# the segments, checksums, and footer.
header fixed 32
field version_major u16
field version_minor u16
field required_flags u32
field optional_flags u32
field header_crc32c u32
field reserved fixed 8
segment pack_segments bytes
footer fixed 84
