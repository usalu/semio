{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xlsx/ecma-376/base/mutation/insert-cell/schema.json",
  "title": "InsertCell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "address",
    "value"
  ],
  "properties": {
    "address": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xlsx/ecma-376/base/cell-vacancy-address.json",
      "x-semio-ui": {
        "label": {
          "en": "Cell",
          "de": "Zelle"
        },
        "description": {
          "en": "Worksheet and reference of the vacant cell that is filled.",
          "de": "Arbeitsblatt und Bezug der leeren Zelle, die gefüllt wird."
        },
        "group": "target",
        "order": 10
      }
    },
    "value": {
      "$ref": "#/$defs/XlsxCellValue",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Cell value",
          "de": "Zellwert"
        },
        "description": {
          "en": "Typed content of the cell: number, shared string, inline string, boolean, error, formula or empty.",
          "de": "Typisierter Inhalt der Zelle: Zahl, gemeinsame Zeichenfolge, Inline-Zeichenfolge, Wahrheitswert, Fehler, Formel oder leer."
        },
        "group": "value",
        "order": 20
      }
    },
    "mutation": {
      "const": "insertCell",
      "description": "Aggregate discriminator spliced in by XlsxMutation; absent when the payload stands alone."
    },
    "node": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlNode",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Verbatim element",
          "de": "Unveränderter Knoten"
        },
        "description": {
          "en": "The cell element inserted verbatim instead of one built from the value.",
          "de": "Das Zellelement, das unverändert eingefügt wird statt eines aus dem Wert aufgebauten."
        },
        "group": "value",
        "order": 40
      }
    }
  },
  "$defs": {
    "XlsxCellValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "sharedString"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "inlineString"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "error"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expr"
          ],
          "properties": {
            "kind": {
              "const": "formula"
            },
            "expr": {
              "type": "string"
            },
            "cached": {
              "anyOf": [
                {
                  "$ref": "#/$defs/XlsxCellValue"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "empty"
            }
          }
        }
      ]
    }
  }
}
