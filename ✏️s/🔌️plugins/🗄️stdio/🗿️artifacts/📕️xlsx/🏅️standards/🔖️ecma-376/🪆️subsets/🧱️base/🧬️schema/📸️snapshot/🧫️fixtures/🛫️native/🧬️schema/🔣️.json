  "type": "object",
  "additionalProperties": false,
  "required": [
    "depth",
    "lateTextBytes",
    "cancelAfter",
    "smallStackBytes"
  ],
  "properties": {
    "depth": {
      "type": "integer",
      "minimum": 1
    },
    "lateTextBytes": {
      "type": "integer",
      "minimum": 1
    },
    "cancelAfter": {
      "type": "integer",
      "minimum": 1
    },
    "smallStackBytes": {
      "type": "integer",
      "minimum": 1
    }
  }
}
