dialect protocol
protocol stdio.xlsx.mutations
version 1
schema stdio.xlsx
start record
framing record

# Real `XlsxMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record set-snapshot tag=1
field payload bytes
record insert-sheet tag=2
field payload bytes
record remove-sheet tag=3
field payload bytes
record rename-sheet tag=4
field payload bytes
record set-cell tag=5
field payload bytes
record remove-cell tag=6
field payload bytes
record insert-shared-string tag=7
field payload bytes
record remove-shared-string tag=8
field payload bytes
record set-shared-string tag=9
field payload bytes
