{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xlsx/ecma-376/base/mutation/insert-sheet/schema.json",
  "title": "InsertSheet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "sheet"
  ],
  "properties": {
    "mutation": {
      "const": "insertSheet",
      "description": "Aggregate discriminator spliced in by XlsxMutation; absent when the payload stands alone."
    },
    "sheet": {
      "$ref": "#/$defs/XlsxSheet"
    }
  },
  "$defs": {
    "XlsxSheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XlsxCell"
          },
          "x-semio-ui": {
            "label": {
              "en": "Cells",
              "de": "Zellen"
            }
          }
        }
      }
    },
    "XlsxCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "col"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Column",
              "de": "Spalte"
            },
            "description": {
              "en": "Zero-based column index of the cell.",
              "de": "Nullbasierter Spaltenindex der Zelle."
            }
          }
        },
        "value": {
          "$ref": "#/$defs/XlsxCellValue"
        }
      }
    },
    "XlsxCellValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "sharedString"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "inlineString"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "error"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expr"
          ],
          "properties": {
            "kind": {
              "const": "formula"
            },
            "expr": {
              "type": "string"
            },
            "cached": {
              "anyOf": [
                {
                  "$ref": "#/$defs/XlsxCellValue"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "empty"
            }
          }
        }
      ]
    }
  }
}
