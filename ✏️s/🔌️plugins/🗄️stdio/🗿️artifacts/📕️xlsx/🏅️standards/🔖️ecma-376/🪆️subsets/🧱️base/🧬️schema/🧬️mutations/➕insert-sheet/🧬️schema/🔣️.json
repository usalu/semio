{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xlsx/ecma-376/base/mutation/insert-sheet/schema.json",
  "title": "InsertSheet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "sheet"
  ],
  "properties": {
    "mutation": {
      "const": "insertSheet",
      "description": "Aggregate discriminator spliced in by XlsxMutation; absent when the payload stands alone."
    },
    "sheet": {
      "$ref": "#/$defs/XlsxSheet",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Sheet",
          "de": "Arbeitsblatt"
        },
        "description": {
          "en": "Name and cells of the worksheet that is inserted.",
          "de": "Name und Zellen des Arbeitsblatts, das eingefügt wird."
        },
        "group": "value",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position the sheet takes among the sheets; the last position when absent.",
          "de": "Position, die das Arbeitsblatt unter den Arbeitsblättern einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    },
    "slot": {
      "$ref": "#/$defs/XlsxSheetSlot",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Verbatim slot",
          "de": "Unveränderter Platz"
        },
        "description": {
          "en": "Everything the workbook holds for the sheet beyond its typed cells, written verbatim; carried when the sheet comes back after a removal.",
          "de": "Alles, was die Arbeitsmappe über die typisierten Zellen hinaus für das Arbeitsblatt hält, unverändert geschrieben; wird mitgeführt, wenn das Arbeitsblatt nach einer Entfernung zurückkehrt."
        },
        "group": "value",
        "order": 40
      }
    }
  },
  "$defs": {
    "XlsxSheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XlsxCell"
          },
          "x-semio-ui": {
            "label": {
              "en": "Cells",
              "de": "Zellen"
            }
          }
        }
      }
    },
    "XlsxCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "col"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Column",
              "de": "Spalte"
            },
            "description": {
              "en": "Zero-based column index of the cell.",
              "de": "Nullbasierter Spaltenindex der Zelle."
            }
          }
        },
        "value": {
          "$ref": "#/$defs/XlsxCellValue"
        }
      }
    },
    "XlsxCellValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "sharedString"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "inlineString"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "error"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expr"
          ],
          "properties": {
            "kind": {
              "const": "formula"
            },
            "expr": {
              "type": "string"
            },
            "cached": {
              "anyOf": [
                {
                  "$ref": "#/$defs/XlsxCellValue"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "empty"
            }
          }
        }
      ]
    },
    "OpcRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relType",
        "target",
        "targetMode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "relType": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "targetMode": {
          "enum": [
            "internal",
            "external"
          ]
        }
      }
    },
    "XlsxSheetSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attrs",
        "relationship",
        "part_path",
        "content_type",
        "document",
        "part_relationships"
      ],
      "properties": {
        "attrs": {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlAttr"
          }
        },
        "relationship": {
          "$ref": "#/$defs/OpcRelationship"
        },
        "part_path": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "document": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlDocument"
        },
        "part_relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpcRelationship"
          }
        }
      }
    }
  }
}
