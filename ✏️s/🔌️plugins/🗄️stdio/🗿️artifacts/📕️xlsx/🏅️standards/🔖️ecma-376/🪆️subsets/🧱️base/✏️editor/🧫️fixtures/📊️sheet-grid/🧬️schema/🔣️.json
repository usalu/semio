{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XlsxSheetGridFixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "cases"],
  "properties": {
    "$schema": {"const": "🧬️schema/🔣️.json"},
    "schemaVersion": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sheetName", "cells", "expectedRows", "expectedColumns", "vacancy"],
        "properties": {
          "id": {"enum": ["sparse-sheet", "blank-sheet", "formula-sheet"]},
          "sheetName": {"type": "string", "minLength": 1},
          "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
          "expectedRows": {"type": "integer", "minimum": 1, "maximum": 1048576},
          "expectedColumns": {"type": "integer", "minimum": 1, "maximum": 16384},
          "formulaDraft": {"type": "string"},
          "vacancy": {"$ref": "#/$defs/vacancy"}
        }
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "value"],
      "properties": {
        "row": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "column": {"type": "integer", "minimum": 0, "maximum": 16383},
        "value": {"type": "object"}
      }
    },
    "vacancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column", "draft"],
      "properties": {
        "row": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "column": {"type": "integer", "minimum": 0, "maximum": 16383},
        "draft": {"type": "string", "minLength": 1}
      }
    }
  }
}
