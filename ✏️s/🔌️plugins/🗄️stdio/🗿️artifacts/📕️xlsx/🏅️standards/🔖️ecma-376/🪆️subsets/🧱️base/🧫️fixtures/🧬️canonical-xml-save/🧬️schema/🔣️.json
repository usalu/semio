{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XlsxCanonicalXmlSaveFixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "namespace",
        "mainPath",
        "sheetPath",
        "calamine",
        "parts",
        "binaryParts",
        "edit",
        "expectedSheetXml",
        "expectedValues"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "mainPath": {
          "type": "string"
        },
        "sheetPath": {
          "type": "string"
        },
        "calamine": {
          "type": "boolean"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "text"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "binaryParts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            }
          }
        },
        "edit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sheetName",
            "row",
            "column",
            "before",
            "after"
          ],
          "properties": {
            "sheetName": {
              "type": "string"
            },
            "row": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 0
            },
            "before": {
              "type": "number"
            },
            "after": {
              "type": "number"
            }
          }
        },
        "expectedSheetXml": {
          "type": "string"
        },
        "expectedValues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "address",
              "kind",
              "before",
              "after",
              "formula"
            ],
            "properties": {
              "address": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "number",
                  "string",
                  "boolean",
                  "error"
                ]
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              },
              "formula": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
