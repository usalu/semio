{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xlsx/ecma-376/base/snapshot.json",
  "title": "XlsxSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "opc",
    "xmlParts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "opc": {
      "$ref": "#/$defs/OpcPackage",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "OPC package",
          "de": "OPC-Paket"
        },
        "description": {
          "en": "Open Packaging Conventions container of the document (ISO/IEC 29500-2).",
          "de": "Container des Dokuments nach Open Packaging Conventions (ISO/IEC 29500-2)."
        }
      }
    },
    "xmlParts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/XlsxXmlPart"
      },
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "XML parts",
          "de": "XML-Teile"
        },
        "description": {
          "en": "Parsed XML parts of the package.",
          "de": "Geparste XML-Teile des Pakets."
        }
      }
    }
  },
  "$defs": {
    "OpcPackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpcPart"
          },
          "x-semio-ui": {
            "label": {
              "en": "Package parts",
              "de": "Paketteile"
            }
          }
        },
        "contentTypes": {
          "$ref": "#/$defs/OpcContentTypes",
          "x-semio-ui": {
            "label": {
              "en": "Content types",
              "de": "Inhaltstypen"
            },
            "description": {
              "en": "Content of the [Content_Types].xml part.",
              "de": "Inhalt des Teils [Content_Types].xml."
            }
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OpcRelationship"
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Relationships",
              "de": "Beziehungen"
            }
          }
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "OpcPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "contentType": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Content type",
              "de": "Inhaltstyp"
            },
            "description": {
              "en": "MIME media type of the package part.",
              "de": "MIME-Medientyp des Paketteils."
            }
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Part bytes",
              "de": "Bytes des Paketteils"
            }
          }
        }
      }
    },
    "OpcContentTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "x-semio-ui": {
            "label": {
              "en": "Default content types",
              "de": "Standard-Inhaltstypen"
            },
            "description": {
              "en": "Content type per file extension.",
              "de": "Inhaltstyp je Dateierweiterung."
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "x-semio-ui": {
            "label": {
              "en": "Content type overrides",
              "de": "Inhaltstyp-Überschreibungen"
            },
            "description": {
              "en": "Content type per part name, overriding the extension default.",
              "de": "Inhaltstyp je Teilname; überschreibt den Standard der Dateierweiterung."
            }
          }
        }
      }
    },
    "OpcRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relType",
        "target",
        "targetMode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "relType": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "targetMode": {
          "$ref": "#/$defs/OpcTargetMode"
        }
      }
    },
    "OpcTargetMode": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "XlsxXmlPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType",
        "document"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "contentType": {
          "type": "string",
          "minLength": 1,
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Content type",
              "de": "Inhaltstyp"
            },
            "description": {
              "en": "MIME media type of the package part.",
              "de": "MIME-Medientyp des Paketteils."
            }
          }
        },
        "document": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlDocument",
          "x-semio-ui": {
            "label": {
              "en": "XML document",
              "de": "XML-Dokument"
            }
          }
        }
      }
    }
  }
}
