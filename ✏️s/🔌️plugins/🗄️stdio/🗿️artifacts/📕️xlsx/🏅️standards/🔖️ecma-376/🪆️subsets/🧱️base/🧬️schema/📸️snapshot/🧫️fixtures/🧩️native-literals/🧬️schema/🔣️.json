{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot",
    "rows",
    "text",
    "binary"
  ],
  "properties": {
    "snapshot": {
      "type": "object"
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string"
    },
    "binary": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  }
}
