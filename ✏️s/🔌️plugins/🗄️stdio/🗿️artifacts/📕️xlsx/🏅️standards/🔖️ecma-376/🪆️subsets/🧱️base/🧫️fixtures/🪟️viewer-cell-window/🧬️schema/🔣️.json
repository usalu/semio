{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "sheets", "sheetIndex", "rowOffset", "rows", "columnOffset", "columns", "expectedKeys", "expectedCells", "labels"],
  "properties": {
    "$schema": { "type": "string" },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "values"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "values": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sheetIndex": { "type": "integer", "minimum": 0 },
    "rowOffset": { "type": "integer", "minimum": 0 },
    "rows": { "type": "integer", "minimum": 1 },
    "columnOffset": { "type": "integer", "minimum": 0 },
    "columns": { "type": "integer", "minimum": 1 },
    "expectedKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^xlsx-viewer-sheet-[0-9]+-row-[1-9][0-9]*$" } },
    "expectedCells": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "$ref": "#/$defs/axes" },
        "de": { "$ref": "#/$defs/axes" }
      }
    }
  },
  "$defs": {
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "column"],
      "properties": {
        "row": { "type": "string", "minLength": 1 },
        "column": { "type": "string", "minLength": 1 }
      }
    }
  }
}
