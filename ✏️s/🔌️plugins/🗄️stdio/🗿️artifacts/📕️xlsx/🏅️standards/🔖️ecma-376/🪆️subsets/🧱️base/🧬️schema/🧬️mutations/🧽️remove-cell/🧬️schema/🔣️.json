{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/xlsx/ecma-376/base/mutation/remove-cell.json",
  "title": "RemoveCell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sheet_name",
    "row",
    "col"
  ],
  "properties": {
    "sheet_name": {
      "type": "string"
    },
    "row": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "col": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "mutation": {
      "const": "removeCell",
      "description": "Aggregate discriminator spliced in by XlsxMutation; absent when the payload stands alone."
    }
  }
}
