{
 "generator": "formulas 1.3.4 via openpyxl 3.1.5",
 "cases": [
  {
   "id": "simple",
   "sheets": [
    {
     "name": "Sheet1",
     "cells": {
      "A1": "=Sheet2!A1*2"
     }
    },
    {
     "name": "Sheet2",
     "cells": {
      "A1": 21
     }
    }
   ],
   "op": {
    "rename": [
     "Sheet2",
     "Data"
    ]
   },
   "expected_formulas": {
    "Sheet1!A1": "=Data!A1*2"
   },
   "expected": {
    "Sheet1!A1": 42
   }
  },
  {
   "id": "quoted-to-bare",
   "sheets": [
    {
     "name": "Sheet1",
     "cells": {
      "A1": "=SUM('Old Name'!A1:B2)"
     }
    },
    {
     "name": "Old Name",
     "cells": {
      "A1": 1,
      "B2": 4
     }
    }
   ],
   "op": {
    "rename": [
     "Old Name",
     "Renamed"
    ]
   },
   "expected_formulas": {
    "Sheet1!A1": "=SUM(Renamed!A1:B2)"
   },
   "expected": {
    "Sheet1!A1": 5
   }
  },
  {
   "id": "bare-to-quoted",
   "sheets": [
    {
     "name": "Sheet1",
     "cells": {
      "A1": "=Sheet2!A1+Sheet2!$B$2"
     }
    },
    {
     "name": "Sheet2",
     "cells": {
      "A1": 1,
      "B2": 4
     }
    }
   ],
   "op": {
    "rename": [
     "Sheet2",
     "New Name"
    ]
   },
   "expected_formulas": {
    "Sheet1!A1": "='New Name'!A1+'New Name'!$B$2"
   },
   "expected": {
    "Sheet1!A1": 5
   }
  },
  {
