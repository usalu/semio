{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/xlsx/ecma-376/transitional/mutation/set-worksheet-content-type/schema.json",
  "title": "SetWorksheetContentType",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "content_type"
  ],
  "properties": {
    "path": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Part",
          "de": "Paketteil"
        },
        "description": {
          "en": "Package part name of the worksheet, for example /xl/worksheets/sheet1.xml.",
          "de": "Name des Paketteils des Arbeitsblatts, zum Beispiel /xl/worksheets/sheet1.xml."
        },
        "ref": {
          "kind": "part"
        },
        "group": "target",
        "order": 10
      }
    },
    "content_type": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Content type",
          "de": "Inhaltstyp"
        },
        "description": {
          "en": "Media type registered for the part in [Content_Types].xml.",
          "de": "Medientyp, der für den Paketteil in [Content_Types].xml eingetragen ist."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
