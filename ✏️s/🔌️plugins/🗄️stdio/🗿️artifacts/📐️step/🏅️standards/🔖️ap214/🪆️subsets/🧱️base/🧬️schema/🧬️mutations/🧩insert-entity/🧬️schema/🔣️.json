{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/step/ap214/base/mutation/insert-entity/schema.json",
  "title": "InsertEntity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "entity"
  ],
  "properties": {
    "mutation": {
      "const": "insertEntity",
      "description": "Aggregate discriminator spliced in by StepMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the entities of the DATA section at which it is inserted, counted from 0.",
          "de": "Position unter den Entitäten des DATA-Abschnitts, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "entity": {
      "$ref": "#/$defs/StepEntity",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Entity",
          "de": "Entität"
        },
        "description": {
          "en": "Instance name, type and arguments of the entity that is inserted.",
          "de": "Instanzname, Typ und Argumente der Entität, die eingefügt wird."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "StepEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "Parameters",
              "de": "Parameter"
            },
            "description": {
              "en": "Attribute values of the entity instance in declaration order.",
              "de": "Attributwerte der Entitätsinstanz in Deklarationsreihenfolge."
            }
          }
        },
        "complex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepComplexType"
          },
          "x-semio-ui": {
            "label": {
              "en": "Partial entity instances",
              "de": "Teilentitätsinstanzen"
            },
            "description": {
              "en": "Subtype records of a complex (multi-leaf) entity instance.",
              "de": "Untertyp-Datensätze einer komplexen Entitätsinstanz."
            }
          }
        }
      }
    },
    "StepValue": {
      "oneOf": [
        {
          "type": "string",
          "const": "unset"
        },
        {
          "type": "string",
          "const": "derived"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integer"
          ],
          "properties": {
            "integer": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "real"
          ],
          "properties": {
            "real": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "string"
          ],
          "properties": {
            "string": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enum"
          ],
          "properties": {
            "enum": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference"
          ],
          "properties": {
            "reference": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aggregate"
          ],
          "properties": {
            "aggregate": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StepValue"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typedValue"
          ],
          "properties": {
            "typedValue": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "typeName": {
                  "type": "string"
                },
                "value": {
                  "$ref": "#/$defs/StepValue"
                }
              },
              "required": [
                "typeName",
                "value"
              ]
            }
          }
        }
      ]
    },
    "StepComplexType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "Parameters",
              "de": "Parameter"
            },
            "description": {
              "en": "Attribute values of the entity instance in declaration order.",
              "de": "Attributwerte der Entitätsinstanz in Deklarationsreihenfolge."
            }
          }
        }
      }
    }
  }
}
