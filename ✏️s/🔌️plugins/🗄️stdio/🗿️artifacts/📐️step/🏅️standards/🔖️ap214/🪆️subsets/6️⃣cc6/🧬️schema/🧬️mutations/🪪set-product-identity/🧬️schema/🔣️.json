{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/step/ap214/cc6/mutation/set-product-identity/schema.json",
  "title": "SetProductIdentity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductIdentity"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "ProductIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "productName",
        "formation",
        "formationId",
        "definition",
        "definitionId"
      ],
      "properties": {
        "product": {
          "type": "integer",
          "minimum": 0
        },
        "productName": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Product name",
              "de": "Produktname"
            }
          }
        },
        "formation": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Product version",
              "de": "Produktversion"
            },
            "description": {
              "en": "Instance number (#n) of the PRODUCT_DEFINITION_FORMATION.",
              "de": "Instanznummer (#n) der PRODUCT_DEFINITION_FORMATION."
            }
          }
        },
        "formationId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Product version ID",
              "de": "Produktversions-ID"
            },
            "description": {
              "en": "`id` attribute of the PRODUCT_DEFINITION_FORMATION.",
              "de": "Attribut `id` der PRODUCT_DEFINITION_FORMATION."
            }
          }
        },
        "definition": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Product definition",
              "de": "Produktdefinition"
            },
            "description": {
              "en": "Instance number (#n) of the PRODUCT_DEFINITION.",
              "de": "Instanznummer (#n) der PRODUCT_DEFINITION."
            }
          }
        },
        "definitionId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Product definition ID",
              "de": "Produktdefinitions-ID"
            },
            "description": {
              "en": "`id` attribute of the PRODUCT_DEFINITION.",
              "de": "Attribut `id` der PRODUCT_DEFINITION."
            }
          }
        }
      }
    }
  }
}
