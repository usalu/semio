{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/step/ap214/base/mutation/set-file-name/schema.json",
  "title": "SetFileName",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "fileName"
  ],
  "properties": {
    "mutation": {
      "const": "setFileName",
      "description": "Aggregate discriminator spliced in by StepMutation; absent when the payload stands alone."
    },
    "fileName": {
      "$ref": "#/$defs/StepFileName",
      "x-semio-ui": {
        "label": {
          "en": "File name (FILE_NAME)",
          "de": "Dateiname (FILE_NAME)"
        }
      }
    }
  },
  "$defs": {
    "StepFileName": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Time stamp",
              "de": "Zeitstempel"
            },
            "description": {
              "en": "ISO 8601 creation time of the file.",
              "de": "Erstellungszeitpunkt der Datei nach ISO 8601."
            }
          }
        },
        "author": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "organization": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Organization",
              "de": "Organisation"
            }
          }
        },
        "preprocessorVersion": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Preprocessor version",
              "de": "Präprozessorversion"
            },
            "description": {
              "en": "STEP translator that wrote the file.",
              "de": "STEP-Übersetzer, der die Datei geschrieben hat."
            }
          }
        },
        "originatingSystem": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Originating system",
              "de": "Ursprungssystem"
            },
            "description": {
              "en": "CAD system that created the data.",
              "de": "CAD-System, das die Daten erzeugt hat."
            }
          }
        },
        "authorization": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Authorization",
              "de": "Freigabe"
            },
            "description": {
              "en": "Person who authorized sending the file.",
              "de": "Person, die den Versand der Datei freigegeben hat."
            }
          }
        }
      }
    }
  }
}
