HEADER;
/* ✍️ HANDCRAFTED. The entity graph below was authored by hand, not exported by any geometry
 * kernel, so this subset has one fixture whose content owes nothing to the same OpenCASCADE that
 * produces its actual. It is a tetrahedron with vertices (0,0,0), (10,0,0), (0,10,0), (0,0,10):
 * 4 VERTEX_POINT, 6 EDGE_CURVE over LINE, 4 ADVANCED_FACE over PLANE with EDGE_LOOP bounds, one
 * CLOSED_SHELL, one MANIFOLD_SOLID_BREP -- the smallest closed advanced B-Rep there is, and every
 * face is oriented outward by hand. Its analytic volume is exactly 10^3/6 = 166.666... mm^3 and its
 * surface area is exactly 150 + 50*sqrt(3) mm^2, which is what makes it worth having: the expected
 * answer is known in closed form and needs no oracle to state.
 * The FILE_NAME timestamp is a fixed constant, not a clock reading, so unlike a kernel export this
 * file is byte-reproducible. Its arithmetic (unit direction vectors, edge magnitudes, plane frames)
 * was emitted by a small generator to keep it exact; the graph, the orientations and the entity
 * choice are the handcrafted part.
 */
FILE_DESCRIPTION(('Handcrafted minimal AP214 advanced B-Rep tetrahedron'),'2;1');
FILE_NAME('handcrafted-tetrahedron','2026-08-27T00:00:00',('semio'),
  ('semio repository test platform'),'handcrafted','handcrafted','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
