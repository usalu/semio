{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/step/ap214/base/mutation/set-file-schema/schema.json",
  "title": "SetFileSchema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "fileSchema"
  ],
  "properties": {
    "mutation": {
      "const": "setFileSchema",
      "description": "Aggregate discriminator spliced in by StepMutation; absent when the payload stands alone."
    },
    "fileSchema": {
      "$ref": "#/$defs/StepFileSchema",
      "x-semio-ui": {
        "label": {
          "en": "File schema (FILE_SCHEMA)",
          "de": "Dateischema (FILE_SCHEMA)"
        },
        "description": {
          "en": "EXPRESS schemas the data section conforms to, e.g. AP214 or AP242.",
          "de": "EXPRESS-Schemata, denen der Datenabschnitt entspricht, z. B. AP214 oder AP242."
        }
      }
    }
  },
  "$defs": {
    "StepFileSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
