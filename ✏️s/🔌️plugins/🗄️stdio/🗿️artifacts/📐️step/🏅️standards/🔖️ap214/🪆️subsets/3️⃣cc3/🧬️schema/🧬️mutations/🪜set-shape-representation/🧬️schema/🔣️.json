{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/step/ap214/cc3/mutation/set-shape-representation/schema.json",
  "title": "SetShapeRepresentation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Shape representation",
          "de": "Formrepräsentation"
        },
        "description": {
          "en": "Instance name (#id) of the SHAPE_REPRESENTATION entity.",
          "de": "Instanzname (#id) der Entität SHAPE_REPRESENTATION."
        },
        "ref": {
          "kind": "entity"
        },
        "group": "target",
        "order": 10
      }
    },
    "representation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShapeRepresentationRow"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Representation",
          "de": "Repräsentation"
        },
        "description": {
          "en": "Type, name, items and context the shape representation carries; cleared, it is removed.",
          "de": "Typ, Name, Elemente und Kontext der Formrepräsentation; geleert wird sie entfernt."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "ShapeRepresentationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeName",
        "name",
        "items"
      ],
      "properties": {
        "typeName": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Entity type",
              "de": "Entitätstyp"
            },
            "description": {
              "en": "EXPRESS entity name, e.g. ADVANCED_BREP_SHAPE_REPRESENTATION.",
              "de": "EXPRESS-Entitätsname, z. B. ADVANCED_BREP_SHAPE_REPRESENTATION."
            }
          }
        },
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "x-semio-ui": {
            "label": {
              "en": "Representation items",
              "de": "Darstellungselemente"
            }
          }
        },
        "context": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Representation context",
              "de": "Darstellungskontext"
            },
            "description": {
              "en": "Instance number (#n) of the geometric representation context.",
              "de": "Instanznummer (#n) des geometrischen Darstellungskontexts."
            }
          }
        }
      }
    }
  }
}
