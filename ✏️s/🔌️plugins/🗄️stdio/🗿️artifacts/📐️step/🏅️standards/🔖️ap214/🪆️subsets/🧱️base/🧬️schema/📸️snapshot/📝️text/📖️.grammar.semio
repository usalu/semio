# 📐️ Complete STEP native records retain schema, headers and owned value forests.
dialect grammar
grammar stdio.step.snapshot
extension step
start document

document = "stdio.step" frame
frame = "schema" "=" text "implementation-level" "=" text "file-name" "=" text "timestamp" "=" text "preprocessor-version" "=" text "originating-system" "=" text "authorization" "=" text "description" "=" texts "author" "=" texts "organization" "=" texts "file-schema" "=" texts "entities" "=" "[" entity* "]" "values" "=" "[" node* "]"
text = TEXT | IDENT
texts = "[" text* "]"
indices = "[" INT* "]"
entity = "{" "id" "=" INT "name" "=" text "arguments" "=" indices "complex" "=" "[" complex* "]" "}"
complex = "{" "name" "=" text "arguments" "=" indices "}"
node = "{" "kind" "=" text integer? real? literal? reference? name? "children" "=" indices "}"
integer = "integer" "=" INT
real = "real" "=" number
number = INT | FLOAT
literal = "text" "=" text
reference = "reference" "=" INT
name = "name" "=" text
