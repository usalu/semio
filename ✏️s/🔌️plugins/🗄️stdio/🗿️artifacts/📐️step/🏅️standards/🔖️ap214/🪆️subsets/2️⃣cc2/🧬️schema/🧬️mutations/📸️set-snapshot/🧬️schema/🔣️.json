{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/step/ap214/cc2/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot"
  ],
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/StepSnapshot"
    }
  },
  "$defs": {
    "StepSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Snapshot schema",
              "de": "Snapshot-Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema version.",
              "de": "Kennung der Version des Snapshot-Schemas."
            }
          }
        },
        "header": {
          "$ref": "#/$defs/StepHeader",
          "x-semio-ui": {
            "label": {
              "en": "Header section",
              "de": "Header-Abschnitt"
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepEntity"
          },
          "x-semio-ui": {
            "label": {
              "en": "Entity instances",
              "de": "Entitätsinstanzen"
            },
            "description": {
              "en": "DATA section instances (#n = …).",
              "de": "Instanzen des DATA-Abschnitts (#n = …)."
            }
          }
        }
      }
    },
    "StepHeader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileDescription": {
          "$ref": "#/$defs/StepFileDescription",
          "x-semio-ui": {
            "label": {
              "en": "File description (FILE_DESCRIPTION)",
              "de": "Dateibeschreibung (FILE_DESCRIPTION)"
            }
          }
        },
        "fileName": {
          "$ref": "#/$defs/StepFileName"
        },
        "fileSchema": {
          "$ref": "#/$defs/StepFileSchema",
          "x-semio-ui": {
            "label": {
              "en": "File schema (FILE_SCHEMA)",
              "de": "Dateischema (FILE_SCHEMA)"
            },
            "description": {
              "en": "EXPRESS schemas the data section conforms to, e.g. AP214 or AP242.",
              "de": "EXPRESS-Schemata, denen der Datenabschnitt entspricht, z. B. AP214 oder AP242."
            }
          }
        }
      }
    },
    "StepFileDescription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementationLevel": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Implementation level",
              "de": "Implementierungsebene"
            },
            "description": {
              "en": "Conformance level of the exchange structure, e.g. 2;1.",
              "de": "Konformitätsstufe der Austauschstruktur, z. B. 2;1."
            }
          }
        }
      }
    },
    "StepFileName": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Time stamp",
              "de": "Zeitstempel"
            },
            "description": {
              "en": "ISO 8601 creation time of the file.",
              "de": "Erstellungszeitpunkt der Datei nach ISO 8601."
            }
          }
        },
        "author": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "organization": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Organization",
              "de": "Organisation"
            }
          }
        },
        "preprocessorVersion": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Preprocessor version",
              "de": "Präprozessorversion"
            },
            "description": {
              "en": "STEP translator that wrote the file.",
              "de": "STEP-Übersetzer, der die Datei geschrieben hat."
            }
          }
        },
        "originatingSystem": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Originating system",
              "de": "Ursprungssystem"
            },
            "description": {
              "en": "CAD system that created the data.",
              "de": "CAD-System, das die Daten erzeugt hat."
            }
          }
        },
        "authorization": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Authorization",
              "de": "Freigabe"
            },
            "description": {
              "en": "Person who authorized sending the file.",
              "de": "Person, die den Versand der Datei freigegeben hat."
            }
          }
        }
      }
    },
    "StepFileSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "StepEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "Parameters",
              "de": "Parameter"
            },
            "description": {
              "en": "Attribute values of the entity instance in declaration order.",
              "de": "Attributwerte der Entitätsinstanz in Deklarationsreihenfolge."
            }
          }
        },
        "complex": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepComplexType"
          },
          "x-semio-ui": {
            "label": {
              "en": "Partial entity instances",
              "de": "Teilentitätsinstanzen"
            },
            "description": {
              "en": "Subtype records of a complex (multi-leaf) entity instance.",
              "de": "Untertyp-Datensätze einer komplexen Entitätsinstanz."
            }
          }
        }
      }
    },
    "StepValue": {
      "oneOf": [
        {
          "type": "string",
          "const": "unset"
        },
        {
          "type": "string",
          "const": "derived"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integer"
          ],
          "properties": {
            "integer": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "real"
          ],
          "properties": {
            "real": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "string"
          ],
          "properties": {
            "string": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enum"
          ],
          "properties": {
            "enum": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference"
          ],
          "properties": {
            "reference": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aggregate"
          ],
          "properties": {
            "aggregate": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StepValue"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typedValue"
          ],
          "properties": {
            "typedValue": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "typeName": {
                  "type": "string"
                },
                "value": {
                  "$ref": "#/$defs/StepValue"
                }
              },
              "required": [
                "typeName",
                "value"
              ]
            }
          }
        }
      ]
    },
    "StepComplexType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepValue"
          },
          "x-semio-ui": {
            "label": {
              "en": "Parameters",
              "de": "Parameter"
            },
            "description": {
              "en": "Attribute values of the entity instance in declaration order.",
              "de": "Attributwerte der Entitätsinstanz in Deklarationsreihenfolge."
            }
          }
        }
      }
    }
  }
}
