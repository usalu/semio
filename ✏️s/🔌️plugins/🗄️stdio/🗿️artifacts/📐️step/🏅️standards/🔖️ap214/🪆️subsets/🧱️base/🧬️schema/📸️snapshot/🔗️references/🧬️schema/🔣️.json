{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Step Reference Closure Cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entities",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "args",
                "complex"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "args": {
                  "type": "array"
                },
                "complex": {
                  "type": "array"
                }
              }
            }
          },
          "error": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "code",
                  "target"
                ],
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "enum": [
                      "mutation.apply.duplicate-entity-id",
                      "mutation.apply.dangling-reference"
                    ]
                  },
                  "target": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
