{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/step/ap214/base/mutation/set-entity-name/schema.json",
  "title": "SetEntityName",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "name"
  ],
  "properties": {
    "mutation": {
      "const": "setEntityName",
      "description": "Aggregate discriminator spliced in by StepMutation; absent when the payload stands alone."
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Entity",
          "de": "Entität"
        },
        "description": {
          "en": "Instance name (#id) of the entity.",
          "de": "Instanzname (#id) der Entität."
        },
        "ref": {
          "kind": "entity"
        },
        "group": "target",
        "order": 10
      }
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Entity type",
          "de": "Entitätstyp"
        },
        "description": {
          "en": "Keyword of the entity, for example CARTESIAN_POINT.",
          "de": "Schlüsselwort der Entität, zum Beispiel CARTESIAN_POINT."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
