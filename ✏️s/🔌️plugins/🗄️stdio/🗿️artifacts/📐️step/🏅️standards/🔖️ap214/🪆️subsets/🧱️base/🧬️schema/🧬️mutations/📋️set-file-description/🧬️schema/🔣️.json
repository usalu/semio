{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/step/ap214/base/mutation/set-file-description/schema.json",
  "title": "SetFileDescription",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file_description"
  ],
  "properties": {
    "file_description": {
      "$ref": "#/$defs/StepFileDescription"
    },
    "mutation": {
      "const": "setFileDescription",
      "description": "Aggregate discriminator spliced in by StepMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "StepFileDescription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementationLevel": {
          "type": "string"
        }
      }
    }
  }
}
