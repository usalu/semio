{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/step/ap214/base/mutation/set-file-description/schema.json",
  "title": "SetFileDescription",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "fileDescription"
  ],
  "properties": {
    "mutation": {
      "const": "setFileDescription",
      "description": "Aggregate discriminator spliced in by StepMutation; absent when the payload stands alone."
    },
    "fileDescription": {
      "$ref": "#/$defs/StepFileDescription",
      "x-semio-ui": {
        "label": {
          "en": "File description (FILE_DESCRIPTION)",
          "de": "Dateibeschreibung (FILE_DESCRIPTION)"
        }
      }
    }
  },
  "$defs": {
    "StepFileDescription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementationLevel": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Implementation level",
              "de": "Implementierungsebene"
            },
            "description": {
              "en": "Conformance level of the exchange structure, e.g. 2;1.",
              "de": "Konformitätsstufe der Austauschstruktur, z. B. 2;1."
            }
          }
        }
      }
    }
  }
}
