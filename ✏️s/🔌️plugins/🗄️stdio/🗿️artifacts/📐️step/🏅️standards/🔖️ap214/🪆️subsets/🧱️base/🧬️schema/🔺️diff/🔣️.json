{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/step/ap214/base/diff.json",
  "title": "StepDiff",
  "$defs": {
    "StepArgModified": {
      "type": "object",
      "required": [
        "index",
        "value"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "$ref": "https://semio.tech/schema/s/stdio/step/ap214/base/snapshot.json#/$defs/StepValue"
        }
      }
    },
    "StepArgAdded": {
      "type": "object",
      "required": [
        "index",
        "value"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "$ref": "https://semio.tech/schema/s/stdio/step/ap214/base/snapshot.json#/$defs/StepValue"
        }
      }
    },
    "StepArgsDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepArgModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepArgAdded"
          }
        }
      }
    },
    "StepEntityDiff": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/StepArgsDiff"
        },
        "complex": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/stdio/step/ap214/base/snapshot.json#/$defs/StepComplexType"
          }
        }
      }
    },
    "StepEntityModified": {
      "type": "object",
      "required": [
        "id",
        "diff"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "diff": {
          "$ref": "#/$defs/StepEntityDiff"
        }
      }
    },
    "StepEntityAdded": {
      "type": "object",
      "required": [
        "index",
        "entity"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "entity": {
          "$ref": "https://semio.tech/schema/s/stdio/step/ap214/base/snapshot.json#/$defs/StepEntity"
        }
      }
    },
    "StepEntitiesDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepEntityModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepEntityAdded"
          }
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "fileDescription": {
      "$ref": "https://semio.tech/schema/s/stdio/step/ap214/base/snapshot.json#/$defs/StepFileDescription",
      "x-semio-state": "artifact"
    },
    "fileName": {
      "$ref": "https://semio.tech/schema/s/stdio/step/ap214/base/snapshot.json#/$defs/StepFileName",
      "x-semio-state": "artifact"
    },
    "fileSchema": {
      "$ref": "https://semio.tech/schema/s/stdio/step/ap214/base/snapshot.json#/$defs/StepFileSchema",
      "x-semio-state": "artifact"
    },
    "entities": {
      "$ref": "#/$defs/StepEntitiesDiff",
      "x-semio-state": "artifact"
    }
  }
}
