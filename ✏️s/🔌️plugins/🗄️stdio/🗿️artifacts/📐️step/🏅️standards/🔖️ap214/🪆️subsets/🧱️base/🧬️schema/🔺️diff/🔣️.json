{
  "$id": "https://semio.tech/schema/s.stdio.step/diff.json",
  "title": "StepDiff",
  "$defs": {
    "StepValue": { "$ref": "../📸️snapshot/🔣️.json#/$defs/StepValue" },
    "StepComplexType": { "$ref": "../📸️snapshot/🔣️.json#/$defs/StepComplexType" },
    "StepEntity": { "$ref": "../📸️snapshot/🔣️.json#/$defs/StepEntity" },
    "StepFileDescription": { "$ref": "../📸️snapshot/🔣️.json#/$defs/StepFileDescription" },
    "StepFileName": { "$ref": "../📸️snapshot/🔣️.json#/$defs/StepFileName" },
    "StepFileSchema": { "$ref": "../📸️snapshot/🔣️.json#/$defs/StepFileSchema" },
    "StepArgModified": {
      "type": "object",
      "required": ["index", "value"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "value": { "$ref": "#/$defs/StepValue" }
      }
    },
    "StepArgAdded": {
      "type": "object",
      "required": ["index", "value"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "value": { "$ref": "#/$defs/StepValue" }
      }
    },
    "StepArgsDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "modified": { "type": "array", "items": { "$ref": "#/$defs/StepArgModified" } },
        "added": { "type": "array", "items": { "$ref": "#/$defs/StepArgAdded" } }
      }
    },
    "StepEntityDiff": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "args": { "$ref": "#/$defs/StepArgsDiff" },
        "complex": { "type": "array", "items": { "$ref": "#/$defs/StepComplexType" } }
      }
    },
    "StepEntityModified": {
      "type": "object",
      "required": ["id", "diff"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "diff": { "$ref": "#/$defs/StepEntityDiff" }
      }
    },
    "StepEntityAdded": {
      "type": "object",
      "required": ["index", "entity"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "entity": { "$ref": "#/$defs/StepEntity" }
      }
    },
    "StepEntitiesDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "modified": { "type": "array", "items": { "$ref": "#/$defs/StepEntityModified" } },
        "added": { "type": "array", "items": { "$ref": "#/$defs/StepEntityAdded" } }
      }
    }
  },
  "type": "object",
  "properties": {
    "fileDescription": { "$ref": "#/$defs/StepFileDescription", "x-semio-state": "artifact" },
    "fileName": { "$ref": "#/$defs/StepFileName", "x-semio-state": "artifact" },
    "fileSchema": { "$ref": "#/$defs/StepFileSchema", "x-semio-state": "artifact" },
    "entities": { "$ref": "#/$defs/StepEntitiesDiff", "x-semio-state": "artifact" }
  }
}
