dialect protocol
protocol stdio.step.mutation
version 1
schema stdio.step
start record
framing record

# Real `StepMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record set-file-description tag=1
field payload bytes
record set-file-name tag=2
field payload bytes
record set-file-schema tag=3
field payload bytes
record insert-entity tag=4
field payload bytes
record remove-entity tag=5
field payload bytes
record set-entity-name tag=6
field payload bytes
record set-entity-arg tag=7
field payload bytes
record insert-entity-arg tag=8
field payload bytes
record remove-entity-arg tag=9
field payload bytes
