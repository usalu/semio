{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/step/ap214/base/mutation/insert-entity-arg/schema.json",
  "title": "InsertEntityArg",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "argIndex",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "insertEntityArg",
      "description": "Aggregate discriminator spliced in by StepMutation; absent when the payload stands alone."
    },
    "id": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Entity",
          "de": "Entität"
        },
        "description": {
          "en": "Instance name (#id) of the entity.",
          "de": "Instanzname (#id) der Entität."
        },
        "ref": {
          "kind": "entity"
        },
        "group": "target",
        "order": 10
      }
    },
    "argIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Argument position",
          "de": "Argumentposition"
        },
        "description": {
          "en": "Position of the argument in the entity's attribute list, counted from 0.",
          "de": "Position des Arguments in der Attributliste der Entität, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "value": {
      "$ref": "#/$defs/StepValue",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Argument value",
          "de": "Argumentwert"
        },
        "description": {
          "en": "Typed Part 21 value of the argument: unset, derived, integer, real, string, enumeration, reference, aggregate or typed value.",
          "de": "Typisierter Part-21-Wert des Arguments: nicht gesetzt, abgeleitet, Ganzzahl, Gleitkommazahl, Zeichenkette, Aufzählung, Referenz, Aggregat oder typisierter Wert."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "StepValue": {
      "oneOf": [
        {
          "type": "string",
          "const": "unset"
        },
        {
          "type": "string",
          "const": "derived"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integer"
          ],
          "properties": {
            "integer": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "real"
          ],
          "properties": {
            "real": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "string"
          ],
          "properties": {
            "string": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enum"
          ],
          "properties": {
            "enum": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference"
          ],
          "properties": {
            "reference": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aggregate"
          ],
          "properties": {
            "aggregate": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StepValue"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typedValue"
          ],
          "properties": {
            "typedValue": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "typeName": {
                  "type": "string"
                },
                "value": {
                  "$ref": "#/$defs/StepValue"
                }
              },
              "required": [
                "typeName",
                "value"
              ]
            }
          }
        }
      ]
    }
  }
}
