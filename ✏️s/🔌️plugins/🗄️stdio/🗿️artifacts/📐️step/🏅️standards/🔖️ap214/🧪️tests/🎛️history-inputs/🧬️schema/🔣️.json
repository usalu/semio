{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["mutation", "before", "after", "oracle"],
  "properties": {
    "mutation": {"type": "object", "minProperties": 1, "maxProperties": 1},
    "before": {"type": "object", "required": ["schema", "header", "entities"]},
    "after": {"type": "object", "required": ["schema", "header", "entities"]},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "params", "patch"],
      "properties": {
        "kind": {"type": "string"},
        "params": {"type": "object"},
        "patch": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["op", "path"]}}
      }
    }
  }
}
