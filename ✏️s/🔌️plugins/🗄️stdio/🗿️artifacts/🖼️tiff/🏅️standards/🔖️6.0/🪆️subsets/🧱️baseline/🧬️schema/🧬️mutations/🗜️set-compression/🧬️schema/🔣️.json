{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/baseline/mutation/set-compression/schema.json",
  "title": "SetCompression",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compression"
  ],
  "properties": {
    "compression": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Compression",
          "de": "Kompression"
        },
        "description": {
          "en": "Compression scheme code (tag 259), e.g. 1 = none, 5 = LZW, 8 = Deflate.",
          "de": "Code des Kompressionsverfahrens (Tag 259), z. B. 1 = keine, 5 = LZW, 8 = Deflate."
        },
        "step": 1
      }
    }
  }
}
