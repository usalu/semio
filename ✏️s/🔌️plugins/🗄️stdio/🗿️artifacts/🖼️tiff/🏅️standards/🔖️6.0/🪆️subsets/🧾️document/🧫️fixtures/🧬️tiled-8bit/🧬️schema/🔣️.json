{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/stdio/tiff/tiled-8bit-fixture.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "width", "height", "tileWidth", "tileLength", "samplesPerPixel", "tiles", "expectedSamples", "edit"],
  "properties": {
    "schema": { "const": "semio.stdio.tiff.tiled-8bit-fixture/v1" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "tileWidth": { "type": "integer", "minimum": 1 },
    "tileLength": { "type": "integer", "minimum": 1 },
    "samplesPerPixel": { "const": 3 },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row", "column", "rgb", "paddingMarker"],
        "properties": {
          "row": { "type": "integer", "minimum": 0 },
          "column": { "type": "integer", "minimum": 0 },
          "rgb": { "$ref": "#/$defs/rgb" },
          "paddingMarker": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "expectedSamples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "rgba"],
        "properties": {
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "rgba": { "$ref": "#/$defs/rgba" }
        }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "rgba"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "rgba": { "$ref": "#/$defs/rgba" }
      }
    }
  },
  "$defs": {
    "rgb": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 }
      ],
      "items": false
    },
    "rgba": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 }
      ],
      "items": false
    }
  }
}
