{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/snapshot.json",
  "title": "TiffSnapshot",
  "type": "object",
  "$defs": {
    "TiffByteOrder": {
      "type": "string",
      "enum": [
        "littleEndian",
        "bigEndian"
      ]
    },
    "TiffFieldType": {
      "type": "string",
      "enum": [
        "byte",
        "ascii",
        "short",
        "long",
        "rational",
        "sByte",
        "undefined",
        "sShort",
        "sLong",
        "sRational",
        "float",
        "double"
      ],
      "description": "TIFF6 §2 Table 2 — the 12 real IFD entry field types."
    },
    "TiffValues": {
      "type": "object",
      "description": "Adjacently-tagged (kind/value) typed union — `value`'s real shape depends on `kind` (number[] for most, string for ascii, [number,number][] for rational/sRational).",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/TiffFieldType",
          "x-semio-ui": {
            "options": {
              "byte": {
                "en": "BYTE (8-bit unsigned)",
                "de": "BYTE (8 Bit, vorzeichenlos)"
              },
              "ascii": {
                "en": "ASCII (7-bit text)",
                "de": "ASCII (7-Bit-Text)"
              },
              "short": {
                "en": "SHORT (16-bit unsigned)",
                "de": "SHORT (16 Bit, vorzeichenlos)"
              },
              "long": {
                "en": "LONG (32-bit unsigned)",
                "de": "LONG (32 Bit, vorzeichenlos)"
              },
              "rational": {
                "en": "RATIONAL (unsigned fraction)",
                "de": "RATIONAL (vorzeichenloser Bruch)"
              },
              "sByte": {
                "en": "SBYTE (8-bit signed)",
                "de": "SBYTE (8 Bit, vorzeichenbehaftet)"
              },
              "undefined": {
                "en": "UNDEFINED (raw bytes)",
                "de": "UNDEFINED (Rohbytes)"
              },
              "sShort": {
                "en": "SSHORT (16-bit signed)",
                "de": "SSHORT (16 Bit, vorzeichenbehaftet)"
              },
              "sLong": {
                "en": "SLONG (32-bit signed)",
                "de": "SLONG (32 Bit, vorzeichenbehaftet)"
              },
              "sRational": {
                "en": "SRATIONAL (signed fraction)",
                "de": "SRATIONAL (vorzeichenbehafteter Bruch)"
              },
              "float": {
                "en": "FLOAT (32-bit IEEE)",
                "de": "FLOAT (32 Bit, IEEE)"
              },
              "double": {
                "en": "DOUBLE (64-bit IEEE)",
                "de": "DOUBLE (64 Bit, IEEE)"
              }
            }
          }
        },
        "value": {}
      }
    },
    "TiffTag": {
      "type": "object",
      "description": "One IFD entry — a weak value (whole-value replaced in diffs).",
      "required": [
        "tag",
        "kind",
        "values"
      ],
      "properties": {
        "tag": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "kind": {
          "$ref": "#/$defs/TiffFieldType",
          "x-semio-ui": {
            "options": {
              "byte": {
                "en": "BYTE (8-bit unsigned)",
                "de": "BYTE (8 Bit, vorzeichenlos)"
              },
              "ascii": {
                "en": "ASCII (7-bit text)",
                "de": "ASCII (7-Bit-Text)"
              },
              "short": {
                "en": "SHORT (16-bit unsigned)",
                "de": "SHORT (16 Bit, vorzeichenlos)"
              },
              "long": {
                "en": "LONG (32-bit unsigned)",
                "de": "LONG (32 Bit, vorzeichenlos)"
              },
              "rational": {
                "en": "RATIONAL (unsigned fraction)",
                "de": "RATIONAL (vorzeichenloser Bruch)"
              },
              "sByte": {
                "en": "SBYTE (8-bit signed)",
                "de": "SBYTE (8 Bit, vorzeichenbehaftet)"
              },
              "undefined": {
                "en": "UNDEFINED (raw bytes)",
                "de": "UNDEFINED (Rohbytes)"
              },
              "sShort": {
                "en": "SSHORT (16-bit signed)",
                "de": "SSHORT (16 Bit, vorzeichenbehaftet)"
              },
              "sLong": {
                "en": "SLONG (32-bit signed)",
                "de": "SLONG (32 Bit, vorzeichenbehaftet)"
              },
              "sRational": {
                "en": "SRATIONAL (signed fraction)",
                "de": "SRATIONAL (vorzeichenbehafteter Bruch)"
              },
              "float": {
                "en": "FLOAT (32-bit IEEE)",
                "de": "FLOAT (32 Bit, IEEE)"
              },
              "double": {
                "en": "DOUBLE (64-bit IEEE)",
                "de": "DOUBLE (64 Bit, IEEE)"
              }
            }
          }
        },
        "values": {
          "$ref": "#/$defs/TiffValues"
        }
      }
    },
    "TiffIfd": {
      "type": "object",
      "description": "One Image File Directory — tag-id-keyed entries (TIFF requires ascending-tag-order) plus this directory's own raster as RAW STRIP BYTES. Empty for IFD 0, whose raster is the snapshot's own canonical RGBA `pixels`, and for a metadata-only directory.",
      "required": [
        "entries",
        "pixels"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TiffTag"
          },
          "x-semio-ui": {
            "label": {
              "en": "Directory entries",
              "de": "Verzeichniseinträge"
            }
          }
        },
        "pixels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "byteOrder",
    "ifds",
    "pixels"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "byteOrder": {
      "$ref": "#/$defs/TiffByteOrder",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "segmented",
        "label": {
          "en": "Byte order",
          "de": "Byte-Reihenfolge"
        },
        "options": {
          "littleEndian": {
            "en": "Little-endian (II)",
            "de": "Little-Endian (II)"
          },
          "bigEndian": {
            "en": "Big-endian (MM)",
            "de": "Big-Endian (MM)"
          }
        }
      }
    },
    "ifds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TiffIfd"
      },
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Image file directories",
          "de": "Bilddateiverzeichnisse (IFDs)"
        }
      }
    },
    "pixels": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "x-semio-state": "artifact"
    }
  }
}
