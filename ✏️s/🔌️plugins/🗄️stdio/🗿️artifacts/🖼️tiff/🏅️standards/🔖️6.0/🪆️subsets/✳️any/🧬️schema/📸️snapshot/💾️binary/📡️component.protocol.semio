dialect protocol stdio.tiff.snapshot
; shared `.semio` binary envelope (store::semio_format::wrap_binary) wrapping the REAL TIFF
; 6.0 file bytes (byte-order mark + IFD chain, TIFF6 §2) this artifact's engine decodes/encodes.
envelope-magic = %x89.53.45.4D.0D.0A.1A.0A
token-len = U32LE
token = UTF8(19)                    ; "stdio.tiff.pack v1"
tiff-file = byte-order-mark:ASCII(2) magic-42:U16 first-ifd-offset:U32 ifd+
; byte-order-mark is "II" (little-endian) or "MM" (big-endian); it governs the endianness of
; EVERY multi-byte field from magic-42 onward, including inside every ifd/ifd-entry.
ifd = entry-count:U16 ifd-entry* next-ifd-offset:U32
; TIFF6 §2 requires entries sorted ascending by tag; next-ifd-offset 0 = end of chain.
ifd-entry = tag:U16 field-type:U16 value-count:U32 value-or-offset:BYTES(4)
; field-type: 1 Byte, 2 Ascii, 3 Short, 4 Long, 5 Rational, 6 SByte, 7 Undefined, 8 SShort,
; 9 SLong, 10 SRational, 11 Float, 12 Double (TIFF6 core table). value-or-offset is inline if
; element_size(field-type) * value-count <= 4, else a file offset — see sibling
; ../🥋️component.ksy for the fully typed per-type value decode.
