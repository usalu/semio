dialect grammar stdio.tiff.snapshot
root = document
; preamble line + its trailing newline are stripped before this grammar runs
; (store::semio_format::split_text_preamble). TIFF has no textual syntax of its own — the
; DSL text is a whitespace-tolerant ASCII hex dump of the REAL binary TIFF bytes (byte-order
; mark + IFD chain + generic tag entries); see ../💾️binary/🥋️component.ksy for that binary's
; own honest grammar.
document = hex_byte (WS hex_byte)*
hex_byte = HEXDIG HEXDIG
HEXDIG = %x30-39 / %x41-46 / %x61-66
WS = *(%x20 / %x09 / %x0D / %x0A)
