{
  "$id": "https://semio.tech/schema/s.stdio.tiff/artifact.json",
  "title": "TiffArtifact",
  "type": "object",
  "required": ["schema", "byteOrder", "ifds", "pixels"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "byteOrder": { "$ref": "https://semio.tech/schema/s.stdio.tiff/snapshot.json#/$defs/TiffByteOrder", "x-semio-state": "artifact" },
    "ifds": { "type": "array", "items": { "$ref": "https://semio.tech/schema/s.stdio.tiff/snapshot.json#/$defs/TiffIfd" }, "x-semio-state": "artifact" },
    "pixels": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "x-semio-state": "artifact" }
  }
}
