dialect protocol stdio.tiff.mutation
; protocol::OpBinary raw JSON encoding of TiffMutation (#[serde(tag = "mutation")]) — NOT
; wrapped in the shared `.semio` binary envelope (contrast with
; ../../📸️snapshot/💾️binary/component.protocol.semio). No length prefix: the entire op body
; IS the JSON document; the "mutation" tag selects one of 8 real variants.
json-object = *OCTET   ; UTF-8 JSON object (see ../📝️text/📖️component.grammar.semio)
