{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "dialect",
    "literalSchemas",
    "domainRows",
    "tableRowCounts",
    "float32Words",
    "float64Words",
    "largeAscii",
    "largePixels",
    "sqliteSignature",
    "externalRaster",
    "laws",
    "controlAudit",
    "constructionAudit",
    "allocationBridge"
  ],
  "properties": {
    "format": {
      "const": "tiff-6.0-owned-snapshot-sqlite"
    },
    "dialect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "const": "s.stdio.tiff"
        },
        "standard": {
          "const": "6.0"
        },
        "subset": {
          "const": "*"
        }
      }
    },
    "literalSchemas": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "domainRows": {
      "const": 52
    },
    "tableRowCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tiff_document",
        "tiff_ifd",
        "tiff_tag",
        "tiff_byte_value",
        "tiff_ascii_value",
        "tiff_short_value",
        "tiff_long_value",
        "tiff_rational_value",
        "tiff_signed_byte_value",
        "tiff_undefined_value",
        "tiff_signed_short_value",
        "tiff_signed_long_value",
        "tiff_signed_rational_value",
        "tiff_float_value",
        "tiff_double_value",
        "tiff_document_pixels",
        "tiff_ifd_pixels"
      ],
      "properties": {
        "tiff_document": {
          "const": 1
        },
        "tiff_ifd": {
          "const": 2
        },
        "tiff_tag": {
          "const": 13
        },
        "tiff_byte_value": {
          "const": 2
        },
        "tiff_ascii_value": {
          "const": 1
        },
        "tiff_short_value": {
          "const": 2
        },
        "tiff_long_value": {
          "const": 2
        },
        "tiff_rational_value": {
          "const": 2
        },
        "tiff_signed_byte_value": {
          "const": 2
        },
        "tiff_undefined_value": {
          "const": 2
        },
        "tiff_signed_short_value": {
          "const": 2
        },
        "tiff_signed_long_value": {
          "const": 2
        },
        "tiff_signed_rational_value": {
          "const": 2
        },
        "tiff_float_value": {
          "const": 7
        },
        "tiff_double_value": {
          "const": 7
        },
        "tiff_document_pixels": {
          "const": 1
        },
        "tiff_ifd_pixels": {
          "const": 2
        }
      }
    },
    "float32Words": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}$"
      }
    },
    "float64Words": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "largeAscii": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "repeat"
      ],
      "properties": {
        "unit": {
          "const": "文🌠"
        },
        "repeat": {
          "const": 20000
        }
      }
    },
    "largePixels": {
      "const": 100000
    },
    "sqliteSignature": {
      "const": "53514c69746520666f726d6174203300"
    },
    "externalRaster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "rgba",
        "byteOrders",
        "envelopeId",
        "wireHex"
      ],
      "properties": {
        "width": {
          "const": 1
        },
        "height": {
          "const": 1
        },
        "rgba": {
          "const": [
            1,
            2,
            3,
            255
          ]
        },
        "byteOrders": {
          "const": [
            "littleEndian",
            "bigEndian"
          ]
        },
        "envelopeId": {
          "const": "stdio.tiff"
        },
        "wireHex": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{262}$"
          }
        }
      }
    },
    "laws": {
      "const": [
        "semantic-file",
        "exact-domain-row-bound",
        "native-input-owner",
        "native-input-controls",
        "native-output-owner",
        "native-output-controls"
      ]
    },
    "controlAudit": {
      "const": {
        "reverseTags": 1024,
        "firstMetadataTag": 40000,
        "duplicateCount": 2,
        "sortWorkFactor": 8,
        "secondaryPixels": [
          21,
          22,
          23
        ],
        "secondaryLength": 1
      }
    },
    "constructionAudit": {
      "const": {
        "schema": "",
        "byteOrder": "littleEndian",
        "tag": 40000,
        "values": [
          0,
          1,
          2,
          4294967295
        ],
        "ifdCount": 1,
        "tagCount": 1,
        "valueCount": 4,
        "domainRows": 9,
        "retainedPixelBytes": 0,
        "minimumValueBackingBytes": 16,
        "refusedBackingBytes": 1
      }
    },
    "allocationBridge": {
      "const": {
        "maximumBytes": 16777216,
        "refusedBytes": 1,
        "copyBytes": 100000,
        "cancelAt": 65536,
        "passes": 2,
        "textDecodeStages": {
          "borrowedHexValidation": {
            "start": 1,
            "admittedByteCopies": 0
          },
          "ownedHexMaterialization": {
            "start": 2,
            "admittedByteCopies": 1
          }
        }
      }
    }
  }
}
