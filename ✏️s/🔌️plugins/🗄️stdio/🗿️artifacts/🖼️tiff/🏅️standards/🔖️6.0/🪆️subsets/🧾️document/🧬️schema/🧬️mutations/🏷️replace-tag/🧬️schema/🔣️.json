{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/mutation/replace-tag/schema.json",
  "title": "ReplaceTagMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ifdIndex",
    "tag",
    "values"
  ],
  "properties": {
    "ifdIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "IFD index",
          "de": "IFD-Index"
        },
        "description": {
          "en": "Zero-based image file directory.",
          "de": "Nullbasiertes Bilddateiverzeichnis."
        },
        "step": 1
      }
    },
    "tag": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tag",
          "de": "Tag"
        },
        "description": {
          "en": "Numeric TIFF tag whose values are replaced, for example 256 (ImageWidth) or 259 (Compression).",
          "de": "Numerisches TIFF-Tag, dessen Werte ersetzt werden, zum Beispiel 256 (ImageWidth) oder 259 (Compression)."
        },
        "ref": {
          "kind": "tag"
        },
        "group": "target",
        "order": 20
      }
    },
    "values": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/snapshot.json#/$defs/TiffValues",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Values",
          "de": "Werte"
        },
        "description": {
          "en": "Field type and values the directory entry of the tag holds.",
          "de": "Feldtyp und Werte, die der Verzeichniseintrag des Tags enthält."
        },
        "group": "value",
        "order": 30
      }
    }
  }
}
