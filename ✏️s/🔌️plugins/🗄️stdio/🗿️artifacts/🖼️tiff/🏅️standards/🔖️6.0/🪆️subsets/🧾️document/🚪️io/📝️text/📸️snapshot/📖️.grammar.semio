dialect grammar
grammar stdio.tiff.snapshot
extension tiff
start document
comment none

document = artifact-mark "schema" "=" text "byteOrder" "=" text "ifds" "=" "[" directory* "]"
artifact-mark = "stdio.tiff"
directory = "{" "entries" "=" "[" tag* "]" "storage" "=" storage "}"
tag = "{" "tag" "=" uint "values" "=" typed-values "}"
typed-values = "{" "kind" "=" text "value" "=" "[" sample* "]" "}"
sample = integer / "[" integer integer "]" / "{" "bits" "=" uint "}"
storage = "{" "byteCountsKind" "=" text "chunks" "=" "[" chunk* "]" "kind" "=" text "offsetsKind" "=" text "}"
chunk = "[" uint* "]"
uint = INT
integer = INT / "-" INT
text = STRING / IDENT
