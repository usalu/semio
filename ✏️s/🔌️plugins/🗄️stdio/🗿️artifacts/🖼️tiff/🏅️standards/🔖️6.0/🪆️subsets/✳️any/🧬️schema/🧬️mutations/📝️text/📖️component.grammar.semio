dialect grammar stdio.tiff.mutation
root = mutation
; wire text IS the JSON serialization of TiffMutation (protocol::OpText — serde_json,
; #[serde(tag = "mutation")]); this names the real 8 variant tags, not RFC 8259's own
; JSON grammar
mutation = "{" '"mutation"' ":" variant_tag ("," member)* "}"
variant_tag = '"noMutation"' / '"setSnapshot"' / '"setByteOrder"' / '"insertIfd"'
            / '"removeIfd"' / '"setTag"' / '"removeTag"' / '"setPixels"'
member = STRING ":" json_value
json_value = "{" (member ("," member)*)? "}" / "[" json_value* "]" / STRING / INT / BOOL / "null"
BOOL = "true" / "false"
