{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/mutation/remove-tag/schema.json",
  "title": "RemoveTagMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ifdIndex",
    "tag"
  ],
  "properties": {
    "ifdIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "IFD index",
          "de": "IFD-Index"
        },
        "description": {
          "en": "Zero-based image file directory.",
          "de": "Nullbasiertes Bilddateiverzeichnis."
        },
        "step": 1
      }
    },
    "tag": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tag",
          "de": "Tag"
        },
        "description": {
          "en": "Numeric TIFF tag that is removed from the directory.",
          "de": "Numerisches TIFF-Tag, das aus dem Verzeichnis entfernt wird."
        },
        "ref": {
          "kind": "tag"
        },
        "group": "target",
        "order": 20
      }
    }
  }
}
