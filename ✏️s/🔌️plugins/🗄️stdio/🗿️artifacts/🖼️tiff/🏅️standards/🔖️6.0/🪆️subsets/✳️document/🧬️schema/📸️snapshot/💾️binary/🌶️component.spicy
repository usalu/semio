module Stdio_tiff_snapshot;

# Shared `.semio` binary envelope wrapping a stdio.tiff payload: the REAL TIFF 6.0 file bytes
# (byte-order mark + IFD chain, TIFF6 §2) that
# crate::artifacts::tiff::engine::{encode_tiff,decode_tiff} produce/consume.

public type Envelope = unit {
    magic: bytes &size=8;                                   # 0x89 "SEM" CR LF SUB LF
    token_len: uint32 &byte-order=spicy::ByteOrder::Little;
    token: bytes &size=self.token_len;                      # UTF-8 "stdio.tiff.pack v1"
    byte_order_mark: bytes &size=2;                          # "II" little-endian / "MM" big-endian
    magic_42: uint16;                                        # byte order per byte_order_mark (spicy
    first_ifd_offset: uint32;                                # can't branch &byte-order on a runtime
                                                               # field portably, so this models the
                                                               # little-endian ("II") case; the
                                                               # authoritative generic rule lives in
                                                               # ../🥋️component.ksy's conditional-endian form).
};

# One Image File Directory: 2-byte entry count, N x 12-byte entries, 4-byte next-IFD offset.
type Ifd = unit {
    entry_count: uint16;
    entries: IfdEntry[self.entry_count];
    next_ifd_offset: uint32;
};

# One tag/type/count/value-or-offset entry (TIFF6 §2 Table 2). `value_or_offset`'s real
# interpretation is generic: inline if element_size(field_type)*value_count <= 4, else a file
# offset — see ../🥋️component.ksy's doc for the full element_size table per field_type.
type IfdEntry = unit {
    tag: uint16;
    field_type: uint16;   # 1 Byte .. 12 Double (TIFF6 core table)
    value_count: uint32;
    value_or_offset: bytes &size=4;
};
