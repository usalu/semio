    "block": { "type": "integer", "minimum": 0, "x-semio-ui": { "widget": "stepper", "label": { "en": "Sample block", "de": "Abtastblock" }, "step": 1, "precision": 0, "group": "target", "order": 20 } },
    "offset": { "type": "integer", "minimum": 0, "x-semio-ui": { "widget": "stepper", "label": { "en": "First word", "de": "Erstes Wort" }, "step": 1, "precision": 0, "group": "target", "order": 30 } },
    "samples": {
      "type": "array",
      "items": {
