{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/editor/ifd-selection-fixture.json",
  "title": "TIFF IFD Selection Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["pages", "selectedIfd", "expectedSelectedRgba"],
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["width", "height", "rgb"],
        "properties": {
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "rgb": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        }
      }
    },
    "selectedIfd": { "type": "integer", "minimum": 0 },
    "expectedSelectedRgba": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    }
  }
}
