{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/mutation/insert-ifd/schema.json",
  "title": "InsertIfdMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "ifd"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the image file directories at which it is inserted, counted from 0.",
          "de": "Position unter den Bildverzeichnissen, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "ifd": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/snapshot.json#/$defs/TiffIfd",
      "x-semio-ui": {
        "label": {
          "en": "Image file directory",
          "de": "Bilddateiverzeichnis (IFD)"
        }
      }
    }
  }
}
