{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/mutation/insert-ifd/schema.json",
  "title": "InsertIfdMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "ifd"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "ifd": {
      "$ref": "#/$defs/TiffIfd",
      "x-semio-ui": {
        "label": {
          "en": "Image file directory",
          "de": "Bilddateiverzeichnis (IFD)"
        }
      }
    }
  },
  "$defs": {
    "TiffIfd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TiffTag"
          },
          "x-semio-ui": {
            "label": {
              "en": "Directory entries",
              "de": "Verzeichniseinträge"
            }
          }
        },
        "pixels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "TiffTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "kind",
        "values"
      ],
      "properties": {
        "tag": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "kind": {
          "$ref": "#/$defs/TiffFieldType",
          "x-semio-ui": {
            "options": {
              "byte": {
                "en": "BYTE (8-bit unsigned)",
                "de": "BYTE (8 Bit, vorzeichenlos)"
              },
              "ascii": {
                "en": "ASCII (7-bit text)",
                "de": "ASCII (7-Bit-Text)"
              },
              "short": {
                "en": "SHORT (16-bit unsigned)",
                "de": "SHORT (16 Bit, vorzeichenlos)"
              },
              "long": {
                "en": "LONG (32-bit unsigned)",
                "de": "LONG (32 Bit, vorzeichenlos)"
              },
              "rational": {
                "en": "RATIONAL (unsigned fraction)",
                "de": "RATIONAL (vorzeichenloser Bruch)"
              },
              "sByte": {
                "en": "SBYTE (8-bit signed)",
                "de": "SBYTE (8 Bit, vorzeichenbehaftet)"
              },
              "undefined": {
                "en": "UNDEFINED (raw bytes)",
                "de": "UNDEFINED (Rohbytes)"
              },
              "sShort": {
                "en": "SSHORT (16-bit signed)",
                "de": "SSHORT (16 Bit, vorzeichenbehaftet)"
              },
              "sLong": {
                "en": "SLONG (32-bit signed)",
                "de": "SLONG (32 Bit, vorzeichenbehaftet)"
              },
              "sRational": {
                "en": "SRATIONAL (signed fraction)",
                "de": "SRATIONAL (vorzeichenbehafteter Bruch)"
              },
              "float": {
                "en": "FLOAT (32-bit IEEE)",
                "de": "FLOAT (32 Bit, IEEE)"
              },
              "double": {
                "en": "DOUBLE (64-bit IEEE)",
                "de": "DOUBLE (64 Bit, IEEE)"
              }
            }
          }
        },
        "values": {
          "$ref": "#/$defs/TiffValues"
        }
      }
    },
    "TiffFieldType": {
      "type": "string",
      "enum": [
        "byte",
        "ascii",
        "short",
        "long",
        "rational",
        "sByte",
        "undefined",
        "sShort",
        "sLong",
        "sRational",
        "float",
        "double"
      ]
    },
    "TiffValues": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "byte"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ascii"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "short"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "long"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rational"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "array",
                "items": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  }
                ],
                "additionalItems": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sByte"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -128,
                "maximum": 127
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "undefined"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sShort"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -32768,
                "maximum": 32767
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sLong"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "sRational"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "array",
                "items": [
                  {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  },
                  {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  }
                ],
                "additionalItems": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "float"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "double"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}
