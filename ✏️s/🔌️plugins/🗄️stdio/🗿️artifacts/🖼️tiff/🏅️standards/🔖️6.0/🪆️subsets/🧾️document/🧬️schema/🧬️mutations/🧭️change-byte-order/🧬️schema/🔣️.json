{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/tiff/6.0/document/mutation/change-byte-order/schema.json",
  "title": "ChangeByteOrderMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "byteOrder"
  ],
  "properties": {
    "byteOrder": {
      "$ref": "#/$defs/TiffByteOrder"
    }
  },
  "$defs": {
    "TiffByteOrder": {
      "type": "string",
      "enum": [
        "littleEndian",
        "bigEndian"
      ]
    }
  }
}
