{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/mutation/change-byte-order/schema.json",
  "title": "ChangeByteOrderMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "byteOrder"
  ],
  "properties": {
    "byteOrder": {
      "$ref": "#/$defs/TiffByteOrder",
      "x-semio-ui": {
        "widget": "segmented",
        "label": {
          "en": "Byte order",
          "de": "Byte-Reihenfolge"
        },
        "options": {
          "littleEndian": {
            "en": "Little-endian (II)",
            "de": "Little-Endian (II)"
          },
          "bigEndian": {
            "en": "Big-endian (MM)",
            "de": "Big-Endian (MM)"
          }
        }
      }
    }
  },
  "$defs": {
    "TiffByteOrder": {
      "type": "string",
      "enum": [
        "littleEndian",
        "bigEndian"
      ]
    }
  }
}
