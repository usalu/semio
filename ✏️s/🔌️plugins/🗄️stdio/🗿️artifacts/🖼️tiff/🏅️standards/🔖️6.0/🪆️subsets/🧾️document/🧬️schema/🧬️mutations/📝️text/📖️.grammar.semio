# Direct identities: change-byte-order, insert-ifd, remove-ifd, replace-tag, remove-tag, replace-pixels
dialect grammar
grammar stdio.tiff.mutations
extension tiff
start document
comment none

document = change-byte-order | insert-ifd | remove-ifd | replace-tag | remove-tag | replace-pixels

change-byte-order = "change-byte-order" "byte-order" "=" byte-order-lit
insert-ifd = "insert-ifd" "index" "=" INT "ifd" "=" ifd-lit
remove-ifd = "remove-ifd" "index" "=" INT
replace-tag = "replace-tag" "ifd-index" "=" INT "tag" "=" INT "kind" "=" INT "values" "=" tiff-values
remove-tag = "remove-tag" "ifd-index" "=" INT "tag" "=" INT
replace-pixels = "replace-pixels" "pixels" "=" hex

byte-order-lit = "0" | "1"

snapshot-lit = "[" hex "," byte-order-lit "," ifds-list "," hex "]"
ifds-list = "[" ifd-item-list? "]"
ifd-item-list = ifd-lit {"," ifd-lit}*

# `enc_ifd` -- `[<entries-list>,<pixels-hex>]`: the bracketed `enc_tag` list followed by this
# directory's OWN raw strip bytes as hex (`TiffIfd::pixels`, added 2026-08-25 by ticket
# 26/08/23/END-TO-END-TESTING-REFACTOR wave 17). The hex run is EMPTY for a metadata-only
# directory and for IFD 0 (whose raster is the snapshot's own `pixels`), which the built-in `hex`
# macro accepts (zero-width floor).
ifd-lit = "[" ifd-entries "," hex "]"
ifd-entries = "[" ifd-entry-list? "]"
ifd-entry-list = tag-lit {"," tag-lit}*
tag-lit = "[" INT "," INT "," tiff-values "]"

tiff-values = "B" "[" hex "]" | "A" "[" hex "]" | "S" number-list | "L" number-list | "R" rational-list | "E" number-list | "U" "[" hex "]" | "H" number-list | "G" number-list | "Q" rational-list | "F" number-list | "D" number-list
number-list = "[" number-comma-list? "]"
number-comma-list = number {"," number}*
number = FLOAT | INT
rational-list = "[" rational-comma-list? "]"
rational-comma-list = rational-item {"," rational-item}*
rational-item = "[" number "," number "]"
