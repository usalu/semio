{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/diff.json",
  "title": "TiffDiff",
  "type": "object",
  "$defs": {
    "TiffTagModified": {
      "type": "object",
      "required": [
        "tag",
        "values"
      ],
      "properties": {
        "tag": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "values": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/snapshot.json#/$defs/TiffValues"
        }
      },
      "additionalProperties": false
    },
    "TiffTagAdded": {
      "type": "object",
      "required": [
        "tag",
        "values"
      ],
      "properties": {
        "tag": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "values": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/snapshot.json#/$defs/TiffValues"
        }
      },
      "additionalProperties": false
    },
    "TiffTagsDiff": {
      "type": "object",
      "description": "Tag-id-keyed entries triple for one IFD.",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TiffTagModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TiffTagAdded"
          }
        }
      }
    },
    "TiffIfdDiff": {
      "type": "object",
      "description": "One IFD's own delta: the recursive tag triple, a whole-value slot for the block list and the sparse sample runs applied after it.",
      "properties": {
        "entries": {
          "$ref": "#/$defs/TiffTagsDiff"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/snapshot.json#/$defs/TiffSampleBlock"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TiffSampleRun"
          }
        }
      },
      "additionalProperties": false
    },
    "TiffIfdModified": {
      "type": "object",
      "required": [
        "index",
        "diff"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "diff": {
          "$ref": "#/$defs/TiffIfdDiff"
        }
      }
    },
    "TiffIfdAdded": {
      "type": "object",
      "required": [
        "index",
        "ifd"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "ifd": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/document/snapshot.json#/$defs/TiffIfd"
        }
      }
    },
    "TiffIfdsDiff": {
      "type": "object",
      "description": "Index-keyed ifds triple (TIFF's IFD chain is positional).",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TiffIfdModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TiffIfdAdded"
          }
        }
      }
    },
    "TiffSampleRun": {
      "type": "object",
      "description": "One contiguous run of replacement words inside a block, starting at the given word offset of the block's pixel-major sample list.",
      "required": [
        "block",
        "offset",
        "samples"
      ],
      "properties": {
        "block": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lo",
              "hi"
            ],
            "properties": {
              "lo": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "hi": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "description": "Sparse diff for stdio.tiff. Every field present = changed to a value. No tri-state fields at this level.",
  "properties": {
    "ifds": {
      "$ref": "#/$defs/TiffIfdsDiff",
      "x-semio-state": "artifact"
    }
  },
  "additionalProperties": false
}
