{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/baseline/mutation/insert-tile-tags/schema.json",
  "title": "InsertTileTags",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tileWidth",
    "tileLength"
  ],
  "properties": {
    "tileWidth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Tile width",
          "de": "Kachelbreite"
        },
        "description": {
          "en": "TileWidth (tag 322) in pixels.",
          "de": "TileWidth (Tag 322) in Pixeln."
        },
        "unit": "px",
        "step": 16
      }
    },
    "tileLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Tile length",
          "de": "Kachelhöhe"
        },
        "description": {
          "en": "TileLength (tag 323) in pixels.",
          "de": "TileLength (Tag 323) in Pixeln."
        },
        "unit": "px",
        "step": 16
      }
    }
  }
}
