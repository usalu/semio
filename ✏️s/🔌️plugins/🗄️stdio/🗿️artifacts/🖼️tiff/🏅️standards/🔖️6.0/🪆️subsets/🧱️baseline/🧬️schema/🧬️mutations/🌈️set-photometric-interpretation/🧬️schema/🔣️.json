{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/tiff/6.0/baseline/mutation/set-photometric-interpretation/schema.json",
  "title": "SetPhotometricInterpretation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "photometric"
  ],
  "properties": {
    "photometric": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Photometric interpretation",
          "de": "Photometrische Interpretation"
        },
        "description": {
          "en": "Tag 262, e.g. 0 = white is zero, 1 = black is zero, 2 = RGB, 3 = palette.",
          "de": "Tag 262, z. B. 0 = Weiß ist null, 1 = Schwarz ist null, 2 = RGB, 3 = Palette."
        },
        "step": 1
      }
    }
  }
}
