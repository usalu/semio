dialect grammar
grammar stdio.pptx.mutations
extension pptx
start document
comment none

# FG-wave: real one-line `OpText::print_op`/`parse_op` shape ALREADY emitted by
# `../../🦀️component.rs` (`print_pptx_mutation`/`parse_pptx_mutation`, ~L227-275), replacing the
# F1-era `*OCTET` hex-dump placeholder. Grammar: `keyword arg=value arg=value ...`
# (space-separated), one alternative per `PptxMutation` variant -- every keyword/arg-name token
# below is copied verbatim from the real `format!(...)` call sites, not invented.
#
# `hex` (bare `hex`, referenced but deliberately NOT defined as a production) is the framework's
# built-in `hex` MACRO -- `📖️grammar-recipe.md` §1.3(f)/§3 pitfall 2.
document = no-mutation | set-snapshot | insert-slide | remove-slide | move-slide | insert-shape | remove-shape | set-shape-text | set-shape-position

no-mutation = "no-mutation"
set-snapshot = "set-snapshot" "snapshot" "=" pptx-snapshot
insert-slide = "insert-slide" "index" "=" INT "slide" "=" slide
remove-slide = "remove-slide" "index" "=" INT
move-slide = "move-slide" "from" "=" INT "to" "=" INT
insert-shape = "insert-shape" "slide-index" "=" INT "shape-index" "=" INT "shape" "=" shape
remove-shape = "remove-shape" "slide-index" "=" INT "shape-index" "=" INT
set-shape-text = "set-shape-text" "slide-index" "=" INT "shape-index" "=" INT "text-frame" "=" paragraphs-list
set-shape-position = "set-shape-position" "slide-index" "=" INT "shape-index" "=" INT "position" "=" transform

# ── `OpcPackage` -- `[parts,defaults,overrides,relationships]` (`enc_opc_package`,
# `../🦀️component.rs`:187-198) -- owners sorted for a deterministic encoding, same `HashMap`
# convention docx's own `enc_opc_package` documents. ────────────────────────────────────────────
opc-package = "[" parts-list "," ct-entries-list "," ct-entries-list "," rel-owner-list "]"
parts-list = "[" opc-part-item* "]"
opc-part-item = opc-part ","?
opc-part = "[" hex "," hex "," hex "]"
ct-entries-list = "[" ct-entry-item* "]"
ct-entry-item = ct-entry ","?
ct-entry = "[" hex "," hex "]"
rel-owner-list = "[" rel-owner-item* "]"
rel-owner-item = rel-owner-entry ","?
rel-owner-entry = "[" hex "," rel-list "]"
rel-list = "[" rel-item* "]"
rel-item = rel ","?
rel = "[" hex "," hex "," hex "," target-mode "]"
target-mode = "0" | "1"

# ── `PptxSnapshot` -- `[schema,opc,slides]` (`enc_snapshot`, `../🦀️component.rs`:213-214) --
# `presentation` collapses to its own single field (`slides: Vec<PptxSlide>`), same convention
# `enc_paragraph`/`enc_slide` use below. ───────────────────────────────────────────────────────
pptx-snapshot = "[" hex "," opc-package "," hex "," slides-list "]"
slides-list = "[" slide-item* "]"
slide-item = slide ","?

# ── Restated whole-item value shapes (identical to this artifact's own `../🔺️diff/📝️text` sibling
# grammar's own `shape`/`paragraph`/`run`/`slide` productions, restated here per-facet since
# grammar files don't cross-reference -- same shape `enc_shape`/`enc_slide` in
# `../🔺️diff/🦀️component.rs` produce, reused by `../🦀️component.rs`'s `OpText` impl too, per that
# file's own doc comment "reuses `PptxDiff`'s `pub(crate)` grammar primitives"). ─────────────────
shape = "B" "[" paragraphs-list "," transform "]" | "P" "[" hex "," transform "]" | "H" "[" hex "," paragraphs-list "," transform "]" | "O" "[" hex "]"
transform = "[" INT "," INT "," INT "," INT "]"
paragraphs-list = "[" paragraph-item* "]"
paragraph-item = paragraph ","?
paragraph = runs-list
runs-list = "[" run-item* "]"
run-item = run ","?
run = "[" hex "," bool-lit "," bool-lit "," opt-int "]"
bool-lit = "0" | "1"
opt-int = "[" "0" "]" | "[" "1" "," INT "]"
slide = shapes-list
shapes-list = "[" shape-item* "]"
shape-item = shape ","?
