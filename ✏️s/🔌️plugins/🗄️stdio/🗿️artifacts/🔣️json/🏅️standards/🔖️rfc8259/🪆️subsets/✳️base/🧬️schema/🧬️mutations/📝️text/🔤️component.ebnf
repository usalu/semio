(* EBNF for one `stdio.json` mutation op line -- same value grammar as
   ../../📸️snapshot/📝️text/🔤️component.ebnf (the op is itself an RFC8259 JSON document). *)
document = header, body ;
header = 'schema', space, 'stdio.json', newline ;
body = value ;

value = object | array | string | number | 'true' | 'false' | 'null' ;
object = '{', [ member, { ',', member } ], '}' ;
member = string, ':', value ;
array = '[', [ value, { ',', value } ], ']' ;
string = '"', { unescaped | escape }, '"' ;
unescaped = ? any unicode character except '"' or '\' or a control character ? ;
escape = '\', ( '"' | '\' | '/' | 'b' | 'f' | 'n' | 'r' | 't' | ( 'u', hex digit, hex digit, hex digit, hex digit ) ) ;
number = [ '-' ], int, [ frac ], [ exp ] ;
int = '0' | ( digit excl zero, { digit } ) ;
frac = '.', digit, { digit } ;
exp = ( 'e' | 'E' ), [ '+' | '-' ], digit, { digit } ;
digit = '0' | digit excl zero ;
digit excl zero = '1' | '2' | '3' | '4' | '5' | '6' | '7' | '8' | '9' ;
hex digit = digit | 'a' | 'b' | 'c' | 'd' | 'e' | 'f' | 'A' | 'B' | 'C' | 'D' | 'E' | 'F' ;
