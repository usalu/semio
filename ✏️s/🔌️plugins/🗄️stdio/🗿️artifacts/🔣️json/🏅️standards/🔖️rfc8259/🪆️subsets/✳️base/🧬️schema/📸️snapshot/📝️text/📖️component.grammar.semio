dialect grammar
grammar json.snapshot
extension json
start document
string double backslash

# P2-P1: real RFC8259 §2-§7 grammar of `stdio.json`'s wire text (replaces the old ABNF placeholder
# that was unparseable by the repo's own `parse_grammar` — wrong header dialect, `;` comments, `/`
# alternation, `%x` char-class ranges all outside this dialect's lexer alphabet). `document` matches
# the m5 harness's own reconstructed body shape (`dsl_body_from_fixture`/`dsl_body_from_fixture` in
# `🧪️fixture-sweep/🦀️component.rs`): the mandatory `semio stdio.json.dsl v1` preamble line is
# stripped and replaced with the bare `envelope_id()` token before recognition, so `artifact-mark`
# below matches literally `stdio.json` (one token: `.` is an ident-continue char in this lexer, see
# `is_ident_continue`), not the full preamble line.
#
# `string double backslash` (P2-M1 item 1) turns on RFC8259 escape decoding for every `"..."` TEXT
# token in this grammar — `\" \\ \/ \b \f \n \r \t \uXXXX` incl. surrogate pairs — matching the real
# parser's own `Parser::parse_string`/`parse_unicode_escape`
# (🔣️json/…/📸️snapshot/🦀️component.rs:193-267). Whitespace/newlines are lexer trivia and are
# stripped before recognition (`Recognizer::recognize`), so no `ws` production is needed anywhere
# below — the shared lexer already treats RFC8259's insignificant whitespace as insignificant.
#
# `value` is genuinely recursive (`object`/`array` reference `value` which references them back) —
# proven end-to-end against JSON's own real recursive `JsonValue` type (`Object(Vec<JsonMember>)`/
# `Array(Vec<JsonValue>)`) by this artifact's own `grammar_conformance_law` conformance test
# (🏅️standards/🔖️rfc8259/⚙️engine/🦀️component.rs's `conformance_laws` module), which recognizes the
# genuinely 3-level-nested `demo_json_snapshot()` fixture end-to-end — not merely trusted from M1's
# abstract pptx-shape-tree proof.
#
# P2-P1-fix: `object`/`array`'s comma-repeated tail groups with `{...}*`, never `(...)*` — this
# dialect's own parser reserves bare `( )` exclusively for macro-call argument lists (`table("a",b)`),
# since whitespace is trivia and can't disambiguate `name (group)` from `name(args)` at the token
# level (see `parse_atom`'s doc comment, `📖️grammar/🦀️component.rs`); `{...}` is the only grouping
# syntax. csv's sibling grammars (`../../../../📊️csv/…/📖️component.grammar.semio`) already use
# `{...}*` correctly — this file originally used `(...)*` by mistake.
artifact-mark = "stdio.json"
document = artifact-mark value

value = object | array | json-string | number | "true" | "false" | "null"

object = "{" "}" | "{" member {"," member}* "}"
member = json-string ":" value

array = "[" "]" | "[" value {"," value}* "]"

# P2-P1-fix: named `json-string`, not the bare `string` RFC8259's own grammar would suggest — this
# dialect's `parse_grammar` main loop recognizes `string`/`extension`/`use`/`start`/`comment` as
# header-directive keywords WHEREVER they appear as a production's leading ident, not only in the
# file's header (the header/body parse is one unified loop, see `parse_grammar`'s `match
# head.text.as_str()`); a production literally named `string` gets parsed as a `string <quote>
# <mode>` header directive instead ("expected Ident, found Equals"). None of those five words can be
# a production name anywhere in a `.grammar.semio` file — a real, narrow, repo-wide dialect
# constraint every future FG-wave author needs to know, not specific to JSON.
json-string = TEXT

# RFC8259 §6: `-? (0 | [1-9][0-9]*) (.[0-9]+)? ([eE][+-]?[0-9]+)?`. The shared lexer's `INT`/`FLOAT`
# scanners (P2-M1's trailing-dot-float work left the leading digit/sign/exponent handling untouched)
# already capture a leading `-` when digit-adjacent and an `e`/`E` exponent with an optional sign,
# matching `🦀️component.rs`'s `parse_number`:271-310 lexeme-for-lexeme — no `%x` char-class rewrite
# needed, only the real terminal names.
number = INT | FLOAT
