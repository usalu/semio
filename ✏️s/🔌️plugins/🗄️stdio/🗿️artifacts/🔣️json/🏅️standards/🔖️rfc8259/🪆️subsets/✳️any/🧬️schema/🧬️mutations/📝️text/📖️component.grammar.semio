dialect grammar
grammar json.mutations
extension json
start document

# P2-P1: real one-line `OpText::print_op`/`parse_op` shape ALREADY emitted by
# `🔣️json/…/🧬️mutations/🦀️component.rs` (`print_json_mutation`/`parse_json_mutation`), replacing the
# F6-era placeholder that described a serde-JSON `JsonMutation` wire struct the Rust codec never
# emits (F6 moved every stdio op codec to `keyword key=value ...` text, see that file's own
# `#region OpCodecs` doc comment). Every keyword/field-name token below is copied verbatim from the
# real `format!(...)` call sites, not invented.
#
# `hex` (bare `hex`, referenced below but deliberately NOT defined as a production in this file) is
# the framework's built-in `hex` MACRO (`📖️grammar/🦀️component.rs`'s `default_macros`/`macro_hex_ok`)
# — a run of lowercase hex digits (`enc_str`/`hex_encode`'s own alphabet), incl. the empty string.
# `Symbol::Ref` already falls back from "no production of this name" to "macro of this name", so
# referencing `hex` with no matching production routes here automatically.
#
# P2-P1-fix: this MUST be a macro, not a `hex = {INT | IDENT}*`-shaped production — a production's
# `Star` is a single greedy pass with NO backtracking (`Symbol::Star`'s doc comment in
# `📖️grammar/🦀️component.rs`), so `hex` directly followed by an unrelated bareword literal it shares
# a token KIND with (`set-member`'s real wire shape is `key=<hex> value=<value>` — the literal
# `value` tokenizes as a plain `IDENT`, exactly like a stray hex letter run would) gets silently
# swallowed INTO the greedy `hex` Star, desyncing everything after it (confirmed live: BOTH
# `set-member` demo cases below failed `ops_grammar_conformance_law` recognition this way,
# independent of and in addition to a second, narrower `{INT|IDENT}*`-as-production gap — a hex run
# containing `<digits>e<digits>` lexes as one `FLOAT` token, not alternating `INT`/`IDENT`, e.g.
# hex-encoding `"2.5e10"` produces `322e35653130`). The macro's own backtracking
# (`Recognizer::match_macro_span` tries the largest token span first and shrinks until `try_match`
# accepts) naturally stops `hex` short of `value` (spelled with `v`/`l`/`u`, none of them valid hex
# digits) with no grammar-file workaround needed. A real, narrow, repo-wide dialect constraint: ANY
# generic opaque/hex content field that could be followed by a bareword keyword needs the `hex` MACRO
# (bare `hex`, no production), never a hand-rolled `{INT|IDENT}*`-style production.
#
# `value` mirrors `enc_json_value`/`dec_json_value`'s tag-prefixed shape 1:1 (`Z`/`B[..]`/`N[..]`/
# `S[..]`/`A[..]`/`O[..]`) and is genuinely recursive — `array`/`object` members reference `value`
# which references them back, exercised end-to-end by this artifact's own
# `ops_grammar_conformance_law` test against real `print_op` output for every `JsonMutation` variant,
# including nested array/object payload values and multi-segment mixed `JsonPath`s.
document = no-mutation | set-snapshot | set-member | remove-member | insert-array-element | remove-array-element | set-scalar

no-mutation = "no-mutation"
set-snapshot = "set-snapshot" "snapshot" "=" snapshot-lit
set-member = "set-member" "path" "=" path "key" "=" hex "value" "=" value
remove-member = "remove-member" "path" "=" path "key" "=" hex
insert-array-element = "insert-array-element" "path" "=" path "index" "=" INT "value" "=" value
remove-array-element = "remove-array-element" "path" "=" path "index" "=" INT
set-scalar = "set-scalar" "path" "=" path "value" "=" value

# `enc_json_path` / `dec_json_path` — `[K[hex],I[INT],...]`, `strip_brackets` + `split_top_level`.
# Every comma-joined list in this grammar (no trailing comma, per `Vec::join(",")`) is modeled as
# `item*` where `item` swallows its own OPTIONAL trailing comma — greedy, zero-width-safe (every
# `item` alternative below is guaranteed to consume at least one token before its optional comma),
# and naturally handles the empty-list case (`Star` matches zero occurrences).
path = "[" path-item* "]"
path-item = path-segment ","?
path-segment = "K" "[" hex "]" | "I" "[" INT "]"

# `enc_json_snapshot` / `dec_json_snapshot` — `[hex(schema),value]`.
snapshot-lit = "[" hex "," value "]"

# `enc_json_value` / `dec_json_value`.
value = "Z" | "B" "[" INT "]" | "N" "[" hex "]" | "S" "[" hex "]" | "A" "[" arr-item* "]" | "O" "[" obj-item* "]"
arr-item = value ","?
obj-item = hex ":" value ","?
