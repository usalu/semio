{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/obj/3.0/geometry/mutation/set-smoothing-groups/schema.json",
  "title": "SetSmoothingGroups",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "smoothingGroups"
  ],
  "properties": {
    "mutation": {
      "const": "setSmoothingGroups",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    },
    "smoothingGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ObjSmoothingRange"
      },
      "x-semio-ui": {
        "label": {
          "en": "Smoothing groups",
          "de": "Glättungsgruppen"
        }
      }
    }
  },
  "$defs": {
    "ObjSmoothingRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faceIndexFrom"
      ],
      "properties": {
        "faceIndexFrom": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "First face",
              "de": "Erste Fläche"
            },
            "description": {
              "en": "Zero-based face index where the range starts.",
              "de": "Nullbasierter Flächenindex, an dem der Bereich beginnt."
            }
          }
        },
        "group": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Smoothing group",
              "de": "Glättungsgruppe"
            },
            "description": {
              "en": "Smoothing group number; 0 turns smoothing off.",
              "de": "Nummer der Glättungsgruppe; 0 schaltet die Glättung aus."
            }
          }
        }
      }
    }
  }
}
