{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/snapshot.json",
  "title": "ObjSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "vertices",
    "texcoords",
    "normals",
    "faces",
    "groups",
    "objects",
    "usemtl",
    "smoothingGroups",
    "unknownStatements"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "vertices": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/artifact.json#/$defs/ObjVertex"
      }
    },
    "texcoords": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/artifact.json#/$defs/ObjTexCoord"
      }
    },
    "normals": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/artifact.json#/$defs/ObjNormal"
      }
    },
    "faces": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/artifact.json#/$defs/ObjFace"
      }
    },
    "groups": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/artifact.json#/$defs/ObjGroup"
      }
    },
    "objects": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/artifact.json#/$defs/ObjObject"
      }
    },
    "mtllib": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "usemtl": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/artifact.json#/$defs/ObjUsemtlRange"
      }
    },
    "smoothingGroups": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/artifact.json#/$defs/ObjSmoothingRange"
      }
    },
    "unknownStatements": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/artifact.json#/$defs/ObjUnknownStatement"
      }
    }
  }
}
