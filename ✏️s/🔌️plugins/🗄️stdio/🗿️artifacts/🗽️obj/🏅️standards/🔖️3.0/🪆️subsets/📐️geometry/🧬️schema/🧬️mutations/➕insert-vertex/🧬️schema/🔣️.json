{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/obj/3.0/geometry/mutation/insert-vertex/schema.json",
  "title": "InsertVertex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "vertex"
  ],
  "properties": {
    "mutation": {
      "const": "insertVertex",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the vertices at which it is inserted, counted from 0.",
          "de": "Position unter den Vertices, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "vertex": {
      "$ref": "#/$defs/ObjVertex",
      "x-semio-ui": {
        "label": {
          "en": "Vertex",
          "de": "Eckpunkt"
        }
      }
    }
  },
  "$defs": {
    "ObjVertex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Weight (w)",
              "de": "Gewicht (w)"
            },
            "description": {
              "en": "Optional fourth component of a geometric vertex; defaults to 1.",
              "de": "Optionale vierte Komponente eines geometrischen Eckpunkts; Standard 1."
            }
          }
        }
      }
    }
  }
}
