dialect grammar
grammar stdio.obj.mutations
start op

# P2-FG1: real one-line `keyword key=value ...` op-text form `ObjMutation`'s GENERIC
# `dsl::DslOps`-derived `print_op`/`parse_op` ALREADY emits (../🦀️.rs `OpCodecs` region:
# `dsl::DslVariants::to_named_record` + `dsl::print(..., dsl::JoinMode::Inline)` — no per-artifact
# custom printer, same mechanism `stdio.zip`/`stdio.txt`'s own already-real mutations grammars
# document). Every token below was captured VERBATIM from a real `print_op()` call over
# `demo_mutation_cases()` (../🦀️.rs), not guessed — e.g. real
# `ObjMutation::InsertVertex{index:1, vertex:ObjVertex{x:9.0,y:9.0,z:9.0,w:Some(1.0)}}.print_op()`
# is exactly `"insert-vertex index=1 vertex { x=9 y=9 z=9 w=1 }"`. Keyword = kebab-case of the
# Rust variant name (`to_kebab`, `🗣️dsl/✨️derive/🦀️.rs`'s own documented convention:
# `InsertVertex` -> `insert-vertex`) EXCEPT where a leaf carries an explicit
# `#[dsl(keyword = "...")]`, which wins: the three tex-coord leaves are spelled `insert-texcoord` /
# `remove-texcoord` / `set-texcoord` on the wire, not the `insert-tex-coord` that `to_kebab` would
# derive from their `InsertTexCoord` variant idents. The oracle catalog, the `.feature` scenario ids
# and `KINDS` all speak the override, so the productions below do too; the leaf DESCRIPTOR's own
# `semanticKind` is the derived `insert-tex-coord`, and those two vocabularies are independent.
# Field keys are likewise kebab-case of the Rust field
# ident (`face_index_from` -> `face-index-from`), printed `key=value` in `keyed_field_rank` order
# (declaration order — every field on every `ObjMutation` variant, and every nested record field,
# is rank 0, so print order is exactly Rust struct-declaration order throughout).
comment none

op = set-snapshot | insert-vertex | remove-vertex | set-vertex | insert-texcoord | remove-texcoord | set-texcoord | insert-normal | remove-normal | set-normal | insert-face | remove-face | set-face | set-group | remove-group | set-object | remove-object | set-mtllib | set-usemtl | set-smoothing-groups | set-unknown-statements

# Rust's own whole-valued-float `Display` (`1.0` -> `"1"`) means every numeric field below
# accepts INT as well as FLOAT — same reasoning as the sibling snapshot grammar's own `number`.
number = FLOAT | INT
# `scalar_to_text` (`🗣️dsl/🧬️schema/🦀️.rs`) prints a `String` field bare (`IDENT`) when
# it lexes back as exactly one identifier, quoted+escaped (`TEXT`) otherwise — covers
# `name`/`material`/`mtllib`/`raw` (real captured examples of both forms: `material=Blue` bare,
# `raw="# b"` quoted, since `"# b"` contains a space `#` doesn't round-trip as one ident).
text-value = IDENT | TEXT


# `#[dsl(block)]` fields print as `key { field=value ... }` — real captured
# `"vertex { x=9 y=9 z=9 w=1 }"` / `"vertex { x=2 y=2 z=2 }"` (w omitted when `None` — a plain
# `Option<f64>` field, simple presence/absence, NOT this artifact's own hand-rolled diff-layer
# `[0]`/`[1,..]` tri-state tagging convention — that convention is unique to `🔺️diff`'s sparse
# per-field patches, never used by the GENERIC derive-driven op printer).
vertex-block = "vertex" "{" "x" "=" number "y" "=" number "z" "=" number {"w" "=" number}? "}"
texcoord-block = "texcoord" "{" "u" "=" number "v" "=" number {"w" "=" number}? "}"
normal-block = "normal" "{" "x" "=" number "y" "=" number "z" "=" number "}"
# One `ObjFaceVertex` list ELEMENT — real captured `"vertex=0"` / `"vertex=1 texcoord=0 normal=0"`
# (no wrapping braces/keyword per element — a `Vec<Record>` field prints as a flat run of each
# element's own fields back-to-back inside one `[...]`, unambiguous here because every element
# deterministically starts with the literal `vertex` key).
face-vertex-item = "vertex" "=" INT {"texcoord" "=" INT}? {"normal" "=" INT}?
face-block = "face" "{" "vertices" "=" "[" face-vertex-item* "]" "}"

insert-vertex = "insert-vertex" "index" "=" INT vertex-block
remove-vertex = "remove-vertex" "index" "=" INT
set-vertex = "set-vertex" "index" "=" INT vertex-block
insert-texcoord = "insert-texcoord" "index" "=" INT texcoord-block
remove-texcoord = "remove-texcoord" "index" "=" INT
set-texcoord = "set-texcoord" "index" "=" INT texcoord-block
insert-normal = "insert-normal" "index" "=" INT normal-block
remove-normal = "remove-normal" "index" "=" INT
set-normal = "set-normal" "index" "=" INT normal-block
insert-face = "insert-face" "index" "=" INT face-block
remove-face = "remove-face" "index" "=" INT
set-face = "set-face" "index" "=" INT face-block

# `SetGroup`/`SetObject`'s own `name`/`faces` fields are PLAIN (not `#[dsl(block)]`) — printed
# directly at the op's own top level, no nested braces. Real captured
# `"set-group name=Base faces=[ 0 0 ]"`.
set-group = "set-group" "name" "=" text-value "faces" "=" "[" INT* "]"
remove-group = "remove-group" "name" "=" text-value
set-object = "set-object" "name" "=" text-value "faces" "=" "[" INT* "]"
remove-object = "remove-object" "name" "=" text-value

# `mtllib: Option<String>` — a plain optional field, omitted entirely when `None` (real captured
# `"set-mtllib"` with NO `mtllib=` token at all for `SetMtllib{mtllib:None}`).
set-mtllib = "set-mtllib" {"mtllib" "=" text-value}?

usemtl-item = "face-index-from" "=" INT "material" "=" text-value
set-usemtl = "set-usemtl" "usemtl" "=" "[" usemtl-item* "]"

smoothing-item = "face-index-from" "=" INT {"group" "=" INT}?
set-smoothing-groups = "set-smoothing-groups" "smoothing-groups" "=" "[" smoothing-item* "]"

unknown-item = "line-index" "=" INT "raw" "=" text-value
set-unknown-statements = "set-unknown-statements" "unknown-statements" "=" "[" unknown-item* "]"

# `SetSnapshot`'s whole `ObjSnapshot` payload — genuinely finite, field-by-field describable
# (every leaf collection bottoms out in a FLAT record, one level deep: `ObjVertex`/`ObjTexCoord`/
# `ObjNormal`/`ObjFaceVertex`/`ObjGroup`/`ObjObject`/`ObjUsemtlRange`/`ObjSmoothingRange`/
# `ObjUnknownStatement` all have zero further nested `Vec<Record>` fields of their own) — unlike
# `stdio.zip`'s own `ZipEntry` (genuinely 2-level nested, forcing `REST`), so this is modeled
# PRECISELY rather than falling back to the raw-span terminal, per real captured
# `print_op(SetSnapshot{...})` output traced end-to-end field-for-field, not guessed.
vertex-item = "x" "=" number "y" "=" number "z" "=" number {"w" "=" number}?
texcoord-item = "u" "=" number "v" "=" number {"w" "=" number}?
normal-item = "x" "=" number "y" "=" number "z" "=" number
face-item = "vertices" "=" "[" face-vertex-item* "]"
# Shared shape for both `groups`/`objects` list elements — `ObjGroup`/`ObjObject` are
# structurally identical (`name`/`faces`), matching the sibling `🔺️diff` file's own `HasFaces`
# intra-file-reuse convention.
group-item = "name" "=" text-value "faces" "=" "[" INT* "]"
snapshot-fields = "schema" "=" text-value "vertices" "=" "[" vertex-item* "]" "texcoords" "=" "[" texcoord-item* "]" "normals" "=" "[" normal-item* "]" "faces" "=" "[" face-item* "]" "groups" "=" "[" group-item* "]" "objects" "=" "[" group-item* "]" {"mtllib" "=" text-value}? "usemtl" "=" "[" usemtl-item* "]" "smoothing-groups" "=" "[" smoothing-item* "]" "unknown-statements" "=" "[" unknown-item* "]"
set-snapshot = "set-snapshot" "snapshot" "{" snapshot-fields "}"
