{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "fields",
    "tables",
    "originalGrant",
    "nativeMaximumBytes",
    "sqlMaximumAllocationBytes",
    "maximumCloseTurns",
    "signedOffsets",
    "textChunkBytes",
    "literal",
    "u64Words",
    "binary64Words",
    "malformed",
    "fieldEdits"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "fields": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "string"
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obj_document",
        "obj_vertex",
        "obj_texcoord",
        "obj_normal",
        "obj_face",
        "obj_face_vertex",
        "obj_group",
        "obj_group_face",
        "obj_object",
        "obj_object_face",
        "obj_face_boundary",
        "obj_material_range",
        "obj_smoothing_range",
        "obj_unknown_statement"
      ],
      "properties": {
        "obj_document": {
          "const": 3
        },
        "obj_vertex": {
          "const": 15
        },
        "obj_texcoord": {
          "const": 12
        },
        "obj_normal": {
          "const": 12
        },
        "obj_face": {
          "const": 3
        },
        "obj_face_vertex": {
          "const": 9
        },
        "obj_group": {
          "const": 4
        },
        "obj_group_face": {
          "const": 6
        },
        "obj_object": {
          "const": 4
        },
        "obj_object_face": {
          "const": 6
        },
        "obj_face_boundary": {
          "const": 4
        },
        "obj_material_range": {
          "const": 7
        },
        "obj_smoothing_range": {
          "const": 7
        },
        "obj_unknown_statement": {
          "const": 6
        }
      }
    },
    "originalGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "nativeMaximumBytes": {
      "const": 67108864
    },
    "sqlMaximumAllocationBytes": {
      "const": 67108864
    },
    "maximumCloseTurns": {
      "const": 65536
    },
    "signedOffsets": {
      "type": "array",
      "items": {
        "type": "integer",
        "maximum": 0
      },
      "minItems": 2
    },
    "textChunkBytes": {
      "const": 256
    },
    "literal": {
      "type": "string"
    },
    "u64Words": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "minItems": 3
    },
    "binary64Words": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      },
      "minItems": 7
    },
    "malformed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 16
    },
    "fieldEdits": {
      "type": "array",
      "minItems": 21,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "table",
          "column",
          "storage",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "table": {
            "enum": [
              "obj_document",
              "obj_vertex",
              "obj_texcoord",
              "obj_normal",
              "obj_face",
              "obj_face_vertex",
              "obj_group",
              "obj_group_face",
              "obj_object",
              "obj_object_face",
              "obj_face_boundary",
              "obj_material_range",
              "obj_smoothing_range",
              "obj_unknown_statement"
            ]
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14
          },
          "storage": {
            "enum": [
              "integer",
              "real",
              "text",
              "null"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "constraint": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "integer"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "integer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "real"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "text"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "null"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
