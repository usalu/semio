{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/obj/3.0/geometry/mutation/insert-texcoord/schema.json",
  "title": "InsertTexcoord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "texcoord"
  ],
  "properties": {
    "mutation": {
      "const": "insertTexcoord",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the texture coordinates at which it is inserted, counted from 0.",
          "de": "Position unter den Texturkoordinaten, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "texcoord": {
      "$ref": "#/$defs/ObjTexCoord",
      "x-semio-ui": {
        "label": {
          "en": "Texture coordinate",
          "de": "Texturkoordinate"
        }
      }
    }
  },
  "$defs": {
    "ObjTexCoord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "u",
        "v"
      ],
      "properties": {
        "u": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "U",
              "de": "U"
            }
          }
        },
        "v": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "V",
              "de": "V"
            }
          }
        },
        "w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Depth (w)",
              "de": "Tiefe (w)"
            },
            "description": {
              "en": "Optional third texture coordinate; defaults to 0.",
              "de": "Optionale dritte Texturkoordinate; Standard 0."
            }
          }
        }
      }
    }
  }
}
