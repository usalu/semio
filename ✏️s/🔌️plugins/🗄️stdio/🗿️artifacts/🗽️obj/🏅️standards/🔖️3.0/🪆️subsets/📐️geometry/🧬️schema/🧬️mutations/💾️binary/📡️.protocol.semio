dialect protocol
protocol stdio.obj.mutations
version 1
schema stdio.obj.op
start op
framing record

# Real op frame (`dsl::variants_binary::encode_tagged_op`): `format u8` (`OP_BINARY_FORMAT`) then `tag varint`,
# then the kind's framework record body (`os_pack::encode_record_body`). Each record is one mutation kind at its
# wire tag; this file is the only source of those tags, which the codec looks up by the kind's keyword.
header fixed 2
field format u8
field tag varint
record set-snapshot tag=0
field payload bytes
record insert-vertex tag=1
field payload bytes
record remove-vertex tag=2
field payload bytes
record set-vertex tag=3
field payload bytes
record insert-texcoord tag=4
field payload bytes
record remove-texcoord tag=5
field payload bytes
record set-texcoord tag=6
field payload bytes
record insert-normal tag=7
field payload bytes
record remove-normal tag=8
field payload bytes
record set-normal tag=9
field payload bytes
record insert-face tag=10
field payload bytes
record remove-face tag=11
field payload bytes
record set-face tag=12
field payload bytes
record set-group tag=13
field payload bytes
record remove-group tag=14
field payload bytes
record set-object tag=15
field payload bytes
record remove-object tag=16
field payload bytes
record set-mtllib tag=17
field payload bytes
record set-usemtl tag=18
field payload bytes
record set-smoothing-groups tag=19
field payload bytes
record set-unknown-statements tag=20
field payload bytes
