{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/obj/3.0/geometry/mutation/set-object/schema.json",
  "title": "SetObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "name",
    "faces"
  ],
  "properties": {
    "mutation": {
      "const": "setObject",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Object",
          "de": "Objekt"
        },
        "description": {
          "en": "Name of the object (`o` statement) that is created or reassigned.",
          "de": "Name des Objekts (`o`-Anweisung), das angelegt oder neu zugeordnet wird."
        },
        "group": "target",
        "order": 10
      }
    },
    "faces": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Faces",
          "de": "Flächen"
        },
        "description": {
          "en": "Indices of the faces that belong to the object, counted from 0.",
          "de": "Indizes der Flächen, die zu dem Objekt gehören, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 20
      }
    }
  }
}
