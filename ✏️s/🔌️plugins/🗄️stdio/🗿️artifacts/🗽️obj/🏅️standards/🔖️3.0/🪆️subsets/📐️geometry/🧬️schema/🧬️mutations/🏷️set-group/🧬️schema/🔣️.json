{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/mutation/set-group/schema.json",
  "title": "SetGroup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "faces"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "faces": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "mutation": {
      "const": "setGroup",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    }
  }
}
