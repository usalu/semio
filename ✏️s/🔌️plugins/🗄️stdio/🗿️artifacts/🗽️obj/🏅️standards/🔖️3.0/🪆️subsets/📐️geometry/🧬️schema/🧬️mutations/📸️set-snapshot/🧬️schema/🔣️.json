{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot"
  ],
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/ObjSnapshot"
    },
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "ObjSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjVertex"
          }
        },
        "texcoords": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjTexCoord"
          }
        },
        "normals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjNormal"
          }
        },
        "faces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjFace"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjGroup"
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjObject"
          }
        },
        "mtllib": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "usemtl": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjUsemtlRange"
          }
        },
        "smoothingGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjSmoothingRange"
          }
        },
        "unknownStatements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjUnknownStatement"
          }
        }
      }
    },
    "ObjVertex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObjTexCoord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "u",
        "v"
      ],
      "properties": {
        "u": {
          "type": "number"
        },
        "v": {
          "type": "number"
        },
        "w": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObjNormal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "ObjFace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertices"
      ],
      "properties": {
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjFaceVertex"
          }
        }
      }
    },
    "ObjFaceVertex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertex"
      ],
      "properties": {
        "vertex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "texcoord": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "normal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObjGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ObjObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ObjUsemtlRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faceIndexFrom",
        "material"
      ],
      "properties": {
        "faceIndexFrom": {
          "type": "integer",
          "minimum": 0
        },
        "material": {
          "type": "string"
        }
      }
    },
    "ObjSmoothingRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faceIndexFrom"
      ],
      "properties": {
        "faceIndexFrom": {
          "type": "integer",
          "minimum": 0
        },
        "group": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObjUnknownStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineIndex",
        "raw"
      ],
      "properties": {
        "lineIndex": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "type": "string"
        }
      }
    }
  }
}
