{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/obj/3.0/geometry/mutation/set-unknown-statements/schema.json",
  "title": "SetUnknownStatements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "unknownStatements"
  ],
  "properties": {
    "mutation": {
      "const": "setUnknownStatements",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    },
    "unknownStatements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ObjUnknownStatement"
      },
      "x-semio-ui": {
        "label": {
          "en": "Unknown statements",
          "de": "Unbekannte Anweisungen"
        },
        "description": {
          "en": "Lines without a dedicated field, kept verbatim.",
          "de": "Zeilen ohne eigenes Feld, unverändert erhalten."
        }
      }
    }
  },
  "$defs": {
    "ObjUnknownStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineIndex",
        "raw"
      ],
      "properties": {
        "lineIndex": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Line index",
              "de": "Zeilenindex"
            },
            "description": {
              "en": "Source line of the statement.",
              "de": "Quellzeile der Anweisung."
            }
          }
        },
        "raw": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Raw line",
              "de": "Rohzeile"
            }
          }
        }
      }
    }
  }
}
