{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/obj/3.0/geometry/mutation/insert-face/schema.json",
  "title": "InsertFace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "face"
  ],
  "properties": {
    "mutation": {
      "const": "insertFace",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "face": {
      "$ref": "#/$defs/ObjFace",
      "x-semio-ui": {
        "label": {
          "en": "Face",
          "de": "Fläche"
        }
      }
    }
  },
  "$defs": {
    "ObjFace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertices"
      ],
      "properties": {
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjFaceVertex"
          },
          "x-semio-ui": {
            "label": {
              "en": "Face vertices",
              "de": "Flächeneckpunkte"
            }
          }
        }
      }
    },
    "ObjFaceVertex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertex"
      ],
      "properties": {
        "vertex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Vertex number",
              "de": "Eckpunktnummer"
            },
            "description": {
              "en": "Zero-based index into the geometric vertices; the file writes it one-based.",
              "de": "Nullbasierter Index in die geometrischen Eckpunkte; die Datei schreibt ihn einsbasiert."
            }
          }
        },
        "texcoord": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Texture coordinate number",
              "de": "Texturkoordinatennummer"
            },
            "description": {
              "en": "Zero-based index into the texture coordinates; the file writes it one-based.",
              "de": "Nullbasierter Index in die Texturkoordinaten; die Datei schreibt ihn einsbasiert."
            }
          }
        },
        "normal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
