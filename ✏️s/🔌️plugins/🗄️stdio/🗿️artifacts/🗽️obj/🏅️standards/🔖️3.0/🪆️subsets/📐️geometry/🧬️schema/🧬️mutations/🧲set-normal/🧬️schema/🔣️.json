{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/obj/3.0/geometry/mutation/set-normal.json",
  "title": "SetNormal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "normal"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "normal": {
      "$ref": "#/$defs/ObjNormal"
    },
    "mutation": {
      "const": "setNormal",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "ObjNormal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
