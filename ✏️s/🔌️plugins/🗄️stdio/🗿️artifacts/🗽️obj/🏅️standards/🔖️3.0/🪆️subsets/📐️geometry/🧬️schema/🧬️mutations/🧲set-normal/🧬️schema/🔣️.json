{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/obj/3.0/geometry/mutation/set-normal/schema.json",
  "title": "SetNormal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "normal"
  ],
  "properties": {
    "mutation": {
      "const": "setNormal",
      "description": "Aggregate discriminator spliced in by ObjMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Normal",
          "de": "Normale"
        },
        "description": {
          "en": "Index of the vertex normal (`vn` statement), counted from 0.",
          "de": "Index der Vertexnormale (`vn`-Anweisung), ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "normal": {
      "$ref": "#/$defs/ObjNormal",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Normal",
          "de": "Normale"
        },
        "description": {
          "en": "Direction of the vertex normal as x, y, z.",
          "de": "Richtung der Vertexnormale als x, y, z."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "ObjNormal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  }
}
