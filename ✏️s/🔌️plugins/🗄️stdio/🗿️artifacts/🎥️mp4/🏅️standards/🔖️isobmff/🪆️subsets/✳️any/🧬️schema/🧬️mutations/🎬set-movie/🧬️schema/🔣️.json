{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp4/isobmff/any/mutation/set-movie/schema.json",
  "title": "SetMovie",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "movie"
  ],
  "properties": {
    "mutation": {
      "const": "setMovie",
      "description": "Aggregate discriminator spliced in by Mp4Mutation; absent when the payload stands alone."
    },
    "movie": {
      "$ref": "#/$defs/Movie",
      "x-semio-ui": {
        "label": {
          "en": "Movie header (mvhd)",
          "de": "Film-Header (mvhd)"
        }
      }
    }
  },
  "$defs": {
    "Movie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creationTime",
        "modificationTime",
        "timescale",
        "duration",
        "rate",
        "volume",
        "matrix",
        "nextTrackId",
        "title",
        "encoder"
      ],
      "properties": {
        "creationTime": {
          "$ref": "#/$defs/U64"
        },
        "modificationTime": {
          "$ref": "#/$defs/U64"
        },
        "timescale": {
          "$ref": "#/$defs/U32"
        },
        "duration": {
          "$ref": "#/$defs/U64"
        },
        "rate": {
          "$ref": "#/$defs/I32"
        },
        "volume": {
          "$ref": "#/$defs/I16"
        },
        "matrix": {
          "$ref": "#/$defs/Matrix"
        },
        "nextTrackId": {
          "$ref": "#/$defs/U32"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoder": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "U32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "I32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "Matrix": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/I32"
      }
    },
    "I16": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    },
    "U64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    }
  }
}
