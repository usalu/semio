{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp4/isobmff/any/mutation/insert-sample/schema.json",
  "title": "InsertSample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "trackIndex",
    "index",
    "sample"
  ],
  "properties": {
    "mutation": {
      "const": "insertSample",
      "description": "Aggregate discriminator spliced in by Mp4Mutation; absent when the payload stands alone."
    },
    "trackIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Track",
          "de": "Spur"
        },
        "description": {
          "en": "Index of the track, counted from 0.",
          "de": "Index der Spur, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "sample": {
      "$ref": "#/$defs/Mp4Sample",
      "x-semio-ui": {
        "label": {
          "en": "Sample",
          "de": "Sample"
        }
      }
    }
  },
  "$defs": {
    "Mp4Sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "sync"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Duration",
              "de": "Dauer"
            },
            "description": {
              "en": "In media timescale units.",
              "de": "In Einheiten der Medienzeitskala."
            }
          }
        },
        "ctsOffset": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Composition time offset",
              "de": "Kompositionszeitversatz"
            },
            "description": {
              "en": "Presentation minus decoding time, in media timescale units.",
              "de": "Präsentations- minus Dekodierzeit in Einheiten der Medienzeitskala."
            }
          }
        },
        "sync": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Sync sample",
              "de": "Synchronisations-Sample"
            },
            "description": {
              "en": "Key frame that decodes without earlier samples.",
              "de": "Schlüsselbild, das ohne frühere Samples dekodierbar ist."
            }
          }
        }
      }
    }
  }
}
