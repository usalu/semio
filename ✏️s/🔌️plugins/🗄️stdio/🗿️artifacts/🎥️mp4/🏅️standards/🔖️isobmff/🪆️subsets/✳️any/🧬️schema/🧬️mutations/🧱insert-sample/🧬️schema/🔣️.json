{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/mp4/isobmff/any/mutation/insert-sample/schema.json",
  "title": "InsertSample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track_index",
    "index",
    "sample"
  ],
  "properties": {
    "track_index": {
      "type": "integer",
      "minimum": 0
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "sample": {
      "$ref": "#/$defs/Mp4Sample"
    },
    "mutation": {
      "const": "insertSample",
      "description": "Aggregate discriminator spliced in by Mp4Mutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "Mp4Sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "sync"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "ctsOffset": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "sync": {
          "type": "boolean"
        }
      }
    }
  }
}
