dialect protocol stdio.mp4.snapshot
; Shared `.semio` envelope around the logical typed RecordSpec payload. Native container syntax
; is created only by the ISO-BMFF serializer and never enters snapshot persistence.
envelope-magic = %x89.53.45.4D.0D.0A.1A.0A
token-len = U32LE
token = UTF8(18)                            ; "stdio.mp4.pack v1"
record-payload = BYTES(*)                   ; store::pack_rt::encode_document
