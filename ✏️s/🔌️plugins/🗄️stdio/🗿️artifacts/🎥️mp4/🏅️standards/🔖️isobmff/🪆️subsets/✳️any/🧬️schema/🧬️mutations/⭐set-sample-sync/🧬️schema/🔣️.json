{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp4/isobmff/any/mutation/set-sample-sync/schema.json",
  "title": "SetSampleSync",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "trackIndex",
    "index",
    "sync"
  ],
  "properties": {
    "mutation": {
      "const": "setSampleSync",
      "description": "Aggregate discriminator spliced in by Mp4Mutation; absent when the payload stands alone."
    },
    "trackIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Track",
          "de": "Spur"
        },
        "description": {
          "en": "Index of the track, counted from 0.",
          "de": "Index der Spur, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Sample",
          "de": "Sample"
        },
        "description": {
          "en": "Index of the sample within the track, counted from 0.",
          "de": "Index des Samples innerhalb der Spur, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "sync": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "label": {
          "en": "Sync sample",
          "de": "Synchronisations-Sample"
        },
        "description": {
          "en": "Key frame that decodes without earlier samples.",
          "de": "Schlüsselbild, das ohne frühere Samples dekodierbar ist."
        }
      }
    }
  }
}
