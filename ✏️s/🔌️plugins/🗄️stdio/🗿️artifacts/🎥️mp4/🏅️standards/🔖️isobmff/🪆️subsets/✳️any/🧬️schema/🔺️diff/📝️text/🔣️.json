{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/mp4/isobmff/any/diff/text.json",
  "title": "Mp4Diff",
  "description": "Sparse per-field diff over logical movie and tracks.",
  "type": "object",
  "properties": {
    "ftyp": {
      "type": "object"
    },
    "tracks": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "modified": {
          "type": "array"
        },
        "added": {
          "type": "array"
        }
      }
    }
  }
}
