  "comparisonProfiles": [
    {
      "id": "semantic-mp4-mutate-v1",
      "description": "ISO-BMFF mutation round trips compared structurally: `ftyp` (major brand, minor version, ordered compatible-brand list), per-track geometry/timescale, a digest of the track's SPS/PPS, and every sample's duration/composition-time-offset/sync-flag/payload digest, arrays order-significant. H.264 sample payloads are container-typed and payload-opaque (never re-encoded pixels), so unlike this wave's lossy raster oracles this comparison is exact, not bucketed — a real per-sample content digest instead of raw bytes only because a single real sample can run tens of kilobytes and the platform's JSON projections are not meant to carry megabytes of payload. Track identifiers are deliberately excluded: `mp4`'s own writer renumbers every track sequentially from 1 on write regardless of what was read, a writer convention this profile treats as producer freedom rather than content, exactly as chunk-to-sample grouping (`stsc`) is excluded for the same reason.",
      "arrays": "ordered",
      "ignoreKeys": []
    }
  ],
