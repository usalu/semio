{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp4/isobmff/any/mutation/set-ftyp/schema.json",
  "title": "SetFtyp",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "ftyp"
  ],
  "properties": {
    "mutation": {
      "const": "setFtyp",
      "description": "Aggregate discriminator spliced in by Mp4Mutation; absent when the payload stands alone."
    },
    "ftyp": {
      "$ref": "#/$defs/Mp4Ftyp",
      "x-semio-ui": {
        "label": {
          "en": "File type (ftyp)",
          "de": "Dateityp (ftyp)"
        }
      }
    }
  },
  "$defs": {
    "Mp4Ftyp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "majorBrand",
        "minorVersion"
      ],
      "properties": {
        "majorBrand": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Major brand",
              "de": "Hauptmarke"
            }
          }
        },
        "minorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Minor version",
              "de": "Nebenversion"
            }
          }
        },
        "compatibleBrands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Compatible brands",
              "de": "Kompatible Marken"
            }
          }
        }
      }
    }
  }
}
