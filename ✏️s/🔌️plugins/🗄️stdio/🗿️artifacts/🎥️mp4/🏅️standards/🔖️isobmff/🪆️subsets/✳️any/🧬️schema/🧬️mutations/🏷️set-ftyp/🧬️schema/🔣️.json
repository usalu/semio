{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/mp4/isobmff/any/mutation/set-ftyp/schema.json",
  "title": "SetFtyp",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ftyp"
  ],
  "properties": {
    "ftyp": {
      "$ref": "#/$defs/Mp4Ftyp"
    },
    "mutation": {
      "const": "setFtyp",
      "description": "Aggregate discriminator spliced in by Mp4Mutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "Mp4Ftyp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "majorBrand",
        "minorVersion"
      ],
      "properties": {
        "majorBrand": {
          "type": "string"
        },
        "minorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "compatibleBrands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
