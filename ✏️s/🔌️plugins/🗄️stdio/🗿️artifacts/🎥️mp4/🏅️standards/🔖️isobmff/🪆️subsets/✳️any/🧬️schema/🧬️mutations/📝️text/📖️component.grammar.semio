dialect grammar stdio.mp4.mutations
root = document
; protocol::OpText::print_op/parse_op (../🦀️component.rs): one compact single-line JSON
; object per op, tagged by "mutation" (camelCase field names, matching the Rust enum's
; #[serde(tag="mutation", rename_all="camelCase")]).
document = json_line
json_line = *(%x20-10FFFF)  ; any non-newline UTF-8 text
