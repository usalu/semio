dialect grammar stdio.mp4.mutations
root = document
; protocol::OpText uses the shared DslVariants named-record form.
document = set-snapshot | set-ftyp | insert-track | remove-track | set-track-dimensions | set-track-codec | insert-sample | remove-sample | set-sample-sync
set-snapshot = "set-snapshot" 1*SP fields
set-ftyp = "set-ftyp" 1*SP fields
insert-track = "insert-track" 1*SP fields
remove-track = "remove-track" 1*SP fields
set-track-dimensions = "set-track-dimensions" 1*SP fields
set-track-codec = "set-track-codec" 1*SP fields
insert-sample = "insert-sample" 1*SP fields
remove-sample = "remove-sample" 1*SP fields
set-sample-sync = "set-sample-sync" 1*SP fields
fields = field *(1*SP field)
field = key "=" value
key = 1*(ALPHA | "-")
value = 1*(%x21-10FFFF)
