{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp4/isobmff/any/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "snapshot"
  ],
  "properties": {
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by Mp4Mutation; absent when the payload stands alone."
    },
    "snapshot": {
      "$ref": "#/$defs/Mp4Snapshot"
    }
  },
  "$defs": {
    "Mp4Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ftyp",
        "movie"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Snapshot schema",
              "de": "Snapshot-Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema version.",
              "de": "Kennung der Version des Snapshot-Schemas."
            }
          }
        },
        "ftyp": {
          "$ref": "#/$defs/Mp4Ftyp",
          "x-semio-ui": {
            "label": {
              "en": "File type (ftyp)",
              "de": "Dateityp (ftyp)"
            }
          }
        },
        "movie": {
          "$ref": "#/$defs/Mp4Movie",
          "x-semio-ui": {
            "label": {
              "en": "Movie (moov)",
              "de": "Film (moov)"
            }
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mp4Track"
          },
          "x-semio-ui": {
            "label": {
              "en": "Tracks",
              "de": "Spuren"
            }
          }
        }
      }
    },
    "Mp4Ftyp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "majorBrand",
        "minorVersion"
      ],
      "properties": {
        "majorBrand": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Major brand",
              "de": "Hauptmarke"
            }
          }
        },
        "minorVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Minor version",
              "de": "Nebenversion"
            }
          }
        },
        "compatibleBrands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-semio-ui": {
            "label": {
              "en": "Compatible brands",
              "de": "Kompatible Marken"
            }
          }
        }
      }
    },
    "Mp4Movie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creationTime",
        "modificationTime",
        "timescale",
        "duration",
        "rate",
        "volume",
        "matrix",
        "nextTrackId"
      ],
      "properties": {
        "creationTime": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Creation time",
              "de": "Erstellungszeit"
            },
            "description": {
              "en": "Seconds since 1904-01-01 UTC.",
              "de": "Sekunden seit 1904-01-01 UTC."
            },
            "unit": "s"
          }
        },
        "modificationTime": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Modification time",
              "de": "Änderungszeit"
            },
            "description": {
              "en": "Seconds since 1904-01-01 UTC.",
              "de": "Sekunden seit 1904-01-01 UTC."
            },
            "unit": "s"
          }
        },
        "timescale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Timescale",
              "de": "Zeitskala"
            },
            "description": {
              "en": "Time units per second.",
              "de": "Zeiteinheiten pro Sekunde."
            },
            "unit": "1/s"
          }
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Duration",
              "de": "Dauer"
            },
            "description": {
              "en": "In movie timescale units.",
              "de": "In Einheiten der Filmzeitskala."
            }
          }
        },
        "rate": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Preferred rate",
              "de": "Bevorzugte Wiedergaberate"
            },
            "description": {
              "en": "16.16 fixed point; 1.0 is normal speed.",
              "de": "16.16-Festkomma; 1,0 ist normale Geschwindigkeit."
            },
            "displayFactor": 1.52587890625e-05,
            "precision": 4
          }
        },
        "volume": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Volume",
              "de": "Lautstärke"
            },
            "description": {
              "en": "8.8 fixed point; 1.0 is full volume.",
              "de": "8.8-Festkomma; 1,0 ist volle Lautstärke."
            },
            "displayFactor": 0.00390625,
            "precision": 3
          }
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "minItems": 9,
          "maxItems": 9,
          "x-semio-ui": {
            "label": {
              "en": "Transformation matrix",
              "de": "Transformationsmatrix"
            },
            "description": {
              "en": "3×3 matrix {a,b,u, c,d,v, x,y,w} in 16.16 and 2.30 fixed point.",
              "de": "3×3-Matrix {a,b,u, c,d,v, x,y,w} in 16.16- und 2.30-Festkomma."
            }
          }
        },
        "nextTrackId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Next track ID",
              "de": "Nächste Spur-ID"
            }
          }
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "encoder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Encoder",
              "de": "Encoder"
            }
          }
        }
      }
    },
    "Mp4Track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackId",
        "timescale",
        "codec",
        "width",
        "height",
        "metadata"
      ],
      "properties": {
        "trackId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Track ID",
              "de": "Spur-ID"
            }
          }
        },
        "timescale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Timescale",
              "de": "Zeitskala"
            },
            "description": {
              "en": "Time units per second.",
              "de": "Zeiteinheiten pro Sekunde."
            },
            "unit": "1/s"
          }
        },
        "codec": {
          "$ref": "#/$defs/Mp4Codec",
          "x-semio-ui": {
            "label": {
              "en": "Codec configuration",
              "de": "Codec-Konfiguration"
            }
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "metadata": {
          "$ref": "#/$defs/Mp4TrackMetadata",
          "x-semio-ui": {
            "label": {
              "en": "Track metadata",
              "de": "Spur-Metadaten"
            }
          }
        },
        "chunkSampleCounts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "x-semio-ui": {
            "label": {
              "en": "Samples per chunk",
              "de": "Samples je Chunk"
            }
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mp4Sample"
          },
          "x-semio-ui": {
            "label": {
              "en": "Samples",
              "de": "Samples"
            }
          }
        }
      }
    },
    "Mp4Codec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nalLengthSize"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "avc1",
            "avc3",
            "hvc1",
            "hev1",
            "jpeg",
            "mjpa"
          ],
          "default": "avc1",
          "x-semio-ui": {
            "widget": "select",
            "label": {
              "en": "Sample entry format",
              "de": "Sample-Eintragsformat"
            },
            "options": {
              "avc1": {
                "en": "AVC / H.264 (avc1)",
                "de": "AVC / H.264 (avc1)"
              },
              "avc3": {
                "en": "AVC / H.264, in-band parameter sets (avc3)",
                "de": "AVC / H.264, Parametersätze im Datenstrom (avc3)"
              },
              "hvc1": {
                "en": "HEVC / H.265 (hvc1)",
                "de": "HEVC / H.265 (hvc1)"
              },
              "hev1": {
                "en": "HEVC / H.265, in-band parameter sets (hev1)",
                "de": "HEVC / H.265, Parametersätze im Datenstrom (hev1)"
              },
              "jpeg": {
                "en": "JPEG (jpeg)",
                "de": "JPEG (jpeg)"
              },
              "mjpa": {
                "en": "Motion JPEG A (mjpa)",
                "de": "Motion JPEG A (mjpa)"
              }
            }
          }
        },
        "sps": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Sequence parameter sets (SPS)",
              "de": "Sequenzparametersätze (SPS)"
            }
          }
        },
        "pps": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Picture parameter sets (PPS)",
              "de": "Bildparametersätze (PPS)"
            }
          }
        },
        "nalLengthSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "NAL length size",
              "de": "Größe des NAL-Längenfelds"
            },
            "description": {
              "en": "Bytes of the length prefix before each NAL unit (1, 2 or 4).",
              "de": "Bytes des Längenpräfixes vor jeder NAL-Unit (1, 2 oder 4)."
            },
            "unit": "B"
          }
        },
        "extension": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mp4AvcExtension"
            },
            {
              "type": "null"
            }
          ]
        },
        "hevc": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mp4HevcConfig"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "HEVC configuration (hvcC)",
              "de": "HEVC-Konfiguration (hvcC)"
            }
          }
        }
      }
    },
    "Mp4AvcExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chromaFormat",
        "bitDepthLumaMinus8",
        "bitDepthChromaMinus8"
      ],
      "properties": {
        "chromaFormat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Chroma format",
              "de": "Chroma-Format"
            },
            "description": {
              "en": "0 = monochrome, 1 = 4:2:0, 2 = 4:2:2, 3 = 4:4:4.",
              "de": "0 = monochrom, 1 = 4:2:0, 2 = 4:2:2, 3 = 4:4:4."
            }
          }
        },
        "bitDepthLumaMinus8": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Luma bit depth − 8",
              "de": "Luma-Bittiefe − 8"
            }
          }
        },
        "bitDepthChromaMinus8": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Chroma bit depth − 8",
              "de": "Chroma-Bittiefe − 8"
            }
          }
        },
        "spsExt": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "SPS extensions",
              "de": "SPS-Erweiterungen"
            }
          }
        }
      }
    },
    "Mp4TrackMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creationTime",
        "modificationTime",
        "flags",
        "duration",
        "layer",
        "alternateGroup",
        "volume",
        "matrix",
        "mediaDuration",
        "mediaCreationTime",
        "mediaModificationTime",
        "language",
        "quality",
        "handlerName",
        "visual"
      ],
      "properties": {
        "creationTime": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Creation time",
              "de": "Erstellungszeit"
            },
            "description": {
              "en": "Seconds since 1904-01-01 UTC.",
              "de": "Sekunden seit 1904-01-01 UTC."
            },
            "unit": "s"
          }
        },
        "modificationTime": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Modification time",
              "de": "Änderungszeit"
            },
            "description": {
              "en": "Seconds since 1904-01-01 UTC.",
              "de": "Sekunden seit 1904-01-01 UTC."
            },
            "unit": "s"
          }
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Track flags",
              "de": "Spur-Flags"
            },
            "description": {
              "en": "Bit 0 enabled, bit 1 in movie, bit 2 in preview.",
              "de": "Bit 0 aktiviert, Bit 1 im Film, Bit 2 in der Vorschau."
            }
          }
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Duration",
              "de": "Dauer"
            },
            "description": {
              "en": "In movie timescale units.",
              "de": "In Einheiten der Filmzeitskala."
            }
          }
        },
        "layer": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "alternateGroup": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Alternate group",
              "de": "Alternativgruppe"
            },
            "description": {
              "en": "Tracks of one group are alternatives; 0 means none.",
              "de": "Spuren einer Gruppe sind Alternativen; 0 bedeutet keine."
            }
          }
        },
        "volume": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Volume",
              "de": "Lautstärke"
            },
            "description": {
              "en": "8.8 fixed point; 1.0 is full volume.",
              "de": "8.8-Festkomma; 1,0 ist volle Lautstärke."
            },
            "displayFactor": 0.00390625,
            "precision": 3
          }
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "minItems": 9,
          "maxItems": 9,
          "x-semio-ui": {
            "label": {
              "en": "Transformation matrix",
              "de": "Transformationsmatrix"
            },
            "description": {
              "en": "3×3 matrix {a,b,u, c,d,v, x,y,w} in 16.16 and 2.30 fixed point.",
              "de": "3×3-Matrix {a,b,u, c,d,v, x,y,w} in 16.16- und 2.30-Festkomma."
            }
          }
        },
        "mediaDuration": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Media duration",
              "de": "Mediendauer"
            },
            "description": {
              "en": "In media timescale units.",
              "de": "In Einheiten der Medienzeitskala."
            }
          }
        },
        "mediaCreationTime": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Media creation time",
              "de": "Erstellungszeit der Medien"
            },
            "description": {
              "en": "Seconds since 1904-01-01 UTC.",
              "de": "Sekunden seit 1904-01-01 UTC."
            },
            "unit": "s"
          }
        },
        "mediaModificationTime": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Media modification time",
              "de": "Änderungszeit der Medien"
            },
            "description": {
              "en": "Seconds since 1904-01-01 UTC.",
              "de": "Sekunden seit 1904-01-01 UTC."
            },
            "unit": "s"
          }
        },
        "language": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Language",
              "de": "Sprache"
            },
            "description": {
              "en": "ISO 639-2/T code of the media.",
              "de": "ISO-639-2/T-Code der Medien."
            }
          }
        },
        "quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Quality",
              "de": "Qualität"
            }
          }
        },
        "handlerName": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Handler name",
              "de": "Handler-Name"
            }
          }
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mp4Edit"
          },
          "x-semio-ui": {
            "label": {
              "en": "Edit list",
              "de": "Schnittliste (Edit List)"
            }
          }
        },
        "visual": {
          "$ref": "#/$defs/Mp4VisualSampleEntry",
          "x-semio-ui": {
            "label": {
              "en": "Visual sample entry",
              "de": "Visueller Sample-Eintrag"
            }
          }
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mp4Color"
            },
            {
              "type": "null"
            }
          ]
        },
        "pixelAspectRatio": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mp4PixelAspectRatio"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Pixel aspect ratio (pasp)",
              "de": "Pixel-Seitenverhältnis (pasp)"
            }
          }
        },
        "bitrate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mp4Bitrate"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "Bitrate (btrt)",
              "de": "Bitrate (btrt)"
            }
          }
        }
      }
    },
    "Mp4Edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentDuration",
        "mediaTime",
        "mediaRateInteger",
        "mediaRateFraction"
      ],
      "properties": {
        "segmentDuration": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Segment duration",
              "de": "Segmentdauer"
            },
            "description": {
              "en": "In movie timescale units.",
              "de": "In Einheiten der Filmzeitskala."
            }
          }
        },
        "mediaTime": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Media time",
              "de": "Medienzeit"
            },
            "description": {
              "en": "Start in media timescale units; -1 is an empty edit.",
              "de": "Start in Einheiten der Medienzeitskala; -1 ist ein leerer Schnitt."
            }
          }
        },
        "mediaRateInteger": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Media rate",
              "de": "Medienrate"
            },
            "description": {
              "en": "Playback rate of the edit; 0 is a dwell.",
              "de": "Wiedergaberate des Schnitts; 0 ist ein Standbild."
            }
          }
        },
