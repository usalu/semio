dialect grammar stdio.mp4.diff
root = document
; op codecs (📸️set-snapshot and every real mutation variant) are the handcrafted OpText/OpBinary
; Shared structured DslRecord text form used by DiffCodec::print_diff/parse_diff.
document = hex_byte (WS hex_byte)*
hex_byte = HEXDIG HEXDIG
HEXDIG = %x30-39 / %x41-46 / %x61-66
WS = *(%x20 / %x09 / %x0D / %x0A)
