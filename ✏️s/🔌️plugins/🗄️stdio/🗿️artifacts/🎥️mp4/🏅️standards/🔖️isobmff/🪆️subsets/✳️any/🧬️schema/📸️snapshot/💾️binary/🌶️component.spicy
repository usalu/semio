module Stdio_mp4_snapshot;
# Shared `.semio` envelope around the logical typed RecordSpec payload.

public type EnvelopeHeader = unit {
    magic: bytes &size=8;
    token_len: uint32;
    token: bytes &size=self.token_len;
};

public type SnapshotPack = unit {
    envelope: EnvelopeHeader;
    record_payload: bytes &eod;
};
