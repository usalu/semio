dialect grammar stdio.mp4.snapshot
root = document
; The preamble is stripped before parsing. The body is a schema-first logical record tree.
document = record
record = IDENT "{" field* "}"
field = IDENT "=" value
value = IDENT / STRING / INT / record / list / object
list = "[" value* "]"
object = "{" field* "}"
IDENT = 1*(ALPHA / DIGIT / "-" / "_")
STRING = DQUOTE *(%x20-21 / %x23-5B / %x5D-10FFFF) DQUOTE
INT = ["-"] 1*DIGIT
