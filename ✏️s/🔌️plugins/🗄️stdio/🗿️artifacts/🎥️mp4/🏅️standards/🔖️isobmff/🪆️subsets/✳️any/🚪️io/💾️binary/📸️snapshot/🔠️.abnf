; abnf stdio.mp4 logical snapshot pack — shared `.semio` envelope plus the typed RecordSpec
; payload produced by store::pack_rt::encode_document. Native ISO-BMFF bytes are not persisted.
document      = envelope-magic token-len token record-payload
envelope-magic = %x89 %x53 %x45 %x4D %x0D %x0A %x1A %x0A
token-len     = 4OCTET                                  ; u32, little-endian
token         = 18OCTET                                 ; UTF-8 "stdio.mp4.pack v1"
record-payload = *OCTET                                 ; shared typed record wire values
