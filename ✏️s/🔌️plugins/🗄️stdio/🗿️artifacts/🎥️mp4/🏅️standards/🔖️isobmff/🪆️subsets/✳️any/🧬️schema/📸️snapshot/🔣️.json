{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp4/isobmff/any/snapshot.json",
  "title": "Mp4Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ftyp",
    "movie",
    "tracks"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "ftyp": {
      "$ref": "#/$defs/Ftyp",
      "x-semio-state": "artifact"
    },
    "movie": {
      "$ref": "#/$defs/Movie",
      "x-semio-state": "artifact"
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Track"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "U8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "U16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "U32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "I16": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767
    },
    "I32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "U64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "I64": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])|-9223372036854775808)$"
    },
    "Bytes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/U8"
      }
    },
    "NalList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Bytes"
      }
    },
    "Matrix": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/I32"
      }
    },
    "Ftyp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "majorBrand",
        "minorVersion",
        "compatibleBrands"
      ],
      "properties": {
        "majorBrand": {
          "type": "string"
        },
        "minorVersion": {
          "$ref": "#/$defs/U32"
        },
        "compatibleBrands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Movie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creationTime",
        "modificationTime",
        "timescale",
        "duration",
        "rate",
        "volume",
        "matrix",
        "nextTrackId",
        "title",
        "encoder"
      ],
      "properties": {
        "creationTime": {
          "$ref": "#/$defs/U64"
        },
        "modificationTime": {
          "$ref": "#/$defs/U64"
        },
        "timescale": {
          "$ref": "#/$defs/U32"
        },
        "duration": {
          "$ref": "#/$defs/U64"
        },
        "rate": {
          "$ref": "#/$defs/I32"
        },
        "volume": {
          "$ref": "#/$defs/I16"
        },
        "matrix": {
          "$ref": "#/$defs/Matrix"
        },
        "nextTrackId": {
          "$ref": "#/$defs/U32"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoder": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "AvcExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chromaFormat",
        "bitDepthLumaMinus8",
        "bitDepthChromaMinus8",
        "spsExt"
      ],
      "properties": {
        "chromaFormat": {
          "$ref": "#/$defs/U8"
        },
        "bitDepthLumaMinus8": {
          "$ref": "#/$defs/U8"
        },
        "bitDepthChromaMinus8": {
          "$ref": "#/$defs/U8"
        },
        "spsExt": {
          "$ref": "#/$defs/NalList"
        }
      }
    },
    "HevcArray": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrayCompleteness",
        "nalUnitType",
        "nalUnits"
      ],
      "properties": {
        "arrayCompleteness": {
          "type": "boolean"
        },
        "nalUnitType": {
          "$ref": "#/$defs/U8"
        },
        "nalUnits": {
          "$ref": "#/$defs/NalList"
        }
      }
    },
    "HevcConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generalProfileSpace",
        "generalTierFlag",
        "generalProfileIdc",
        "generalProfileCompatibilityFlags",
        "generalConstraintIndicatorFlags",
        "generalLevelIdc",
        "minSpatialSegmentationIdc",
        "parallelismType",
        "chromaFormatIdc",
        "bitDepthLumaMinus8",
        "bitDepthChromaMinus8",
        "avgFrameRate",
        "constantFrameRate",
        "numTemporalLayers",
        "temporalIdNested",
        "arrays"
      ],
      "properties": {
        "generalProfileSpace": {
          "$ref": "#/$defs/U8"
        },
        "generalTierFlag": {
          "type": "boolean"
        },
        "generalProfileIdc": {
          "$ref": "#/$defs/U8"
        },
        "generalProfileCompatibilityFlags": {
          "$ref": "#/$defs/U32"
        },
        "generalConstraintIndicatorFlags": {
          "$ref": "#/$defs/U64"
        },
        "generalLevelIdc": {
          "$ref": "#/$defs/U8"
        },
        "minSpatialSegmentationIdc": {
          "$ref": "#/$defs/U16"
        },
        "parallelismType": {
          "$ref": "#/$defs/U8"
        },
        "chromaFormatIdc": {
          "$ref": "#/$defs/U8"
        },
        "bitDepthLumaMinus8": {
          "$ref": "#/$defs/U8"
        },
        "bitDepthChromaMinus8": {
          "$ref": "#/$defs/U8"
        },
        "avgFrameRate": {
          "$ref": "#/$defs/U16"
        },
        "constantFrameRate": {
          "$ref": "#/$defs/U8"
        },
        "numTemporalLayers": {
          "$ref": "#/$defs/U8"
        },
        "temporalIdNested": {
          "type": "boolean"
        },
        "arrays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HevcArray"
          }
        }
      }
    },
    "Codec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sps",
        "pps",
        "nalLengthSize",
        "extension",
        "hevc"
      ],
      "properties": {
        "format": {
          "enum": [
            "avc1",
            "avc3",
            "hvc1",
            "hev1",
            "jpeg",
            "mjpa"
          ]
        },
        "sps": {
          "$ref": "#/$defs/NalList"
        },
        "pps": {
          "$ref": "#/$defs/NalList"
        },
        "nalLengthSize": {
          "$ref": "#/$defs/U8"
        },
        "extension": {
          "anyOf": [
            {
              "$ref": "#/$defs/AvcExtension"
            },
            {
              "type": "null"
            }
          ]
        },
        "hevc": {
          "anyOf": [
            {
              "$ref": "#/$defs/HevcConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "duration",
        "ctsOffset",
        "sync"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/Bytes"
        },
        "duration": {
          "$ref": "#/$defs/U32"
        },
        "ctsOffset": {
          "$ref": "#/$defs/I32"
        },
        "sync": {
          "type": "boolean"
        }
      }
    },
    "Edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentDuration",
        "mediaTime",
        "mediaRateInteger",
        "mediaRateFraction"
      ],
      "properties": {
        "segmentDuration": {
          "$ref": "#/$defs/U64"
        },
        "mediaTime": {
          "$ref": "#/$defs/I64"
        },
        "mediaRateInteger": {
          "$ref": "#/$defs/I16"
        },
        "mediaRateFraction": {
          "$ref": "#/$defs/I16"
        }
      }
    },
    "Visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataReferenceIndex",
        "version",
        "revisionLevel",
        "vendor",
        "temporalQuality",
        "spatialQuality",
        "horizontalResolution",
        "verticalResolution",
        "frameCount",
        "compressorName",
        "depth",
        "colorTableId"
      ],
      "properties": {
        "dataReferenceIndex": {
          "$ref": "#/$defs/U16"
        },
        "version": {
          "$ref": "#/$defs/U16"
        },
        "revisionLevel": {
          "$ref": "#/$defs/U16"
        },
        "vendor": {
          "$ref": "#/$defs/U32"
        },
        "temporalQuality": {
          "$ref": "#/$defs/U32"
        },
        "spatialQuality": {
          "$ref": "#/$defs/U32"
        },
        "horizontalResolution": {
          "$ref": "#/$defs/U32"
        },
        "verticalResolution": {
          "$ref": "#/$defs/U32"
        },
        "frameCount": {
          "$ref": "#/$defs/U16"
        },
        "compressorName": {
          "type": "string"
        },
        "depth": {
          "$ref": "#/$defs/U16"
        },
        "colorTableId": {
          "$ref": "#/$defs/I16"
        }
      }
    },
    "Color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colorType",
        "primaries",
        "transfer",
        "matrix",
        "fullRange"
      ],
      "properties": {
        "colorType": {
          "type": "string"
        },
        "primaries": {
          "$ref": "#/$defs/U16"
        },
        "transfer": {
          "$ref": "#/$defs/U16"
        },
        "matrix": {
          "$ref": "#/$defs/U16"
        },
        "fullRange": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "PixelAspectRatio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizontalSpacing",
        "verticalSpacing"
      ],
      "properties": {
        "horizontalSpacing": {
          "$ref": "#/$defs/U32"
        },
        "verticalSpacing": {
          "$ref": "#/$defs/U32"
        }
      }
    },
    "Bitrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bufferSize",
        "maximum",
        "average"
      ],
      "properties": {
        "bufferSize": {
          "$ref": "#/$defs/U32"
        },
        "maximum": {
          "$ref": "#/$defs/U32"
        },
        "average": {
          "$ref": "#/$defs/U32"
        }
      }
    },
    "TrackMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creationTime",
        "modificationTime",
        "flags",
        "duration",
        "layer",
        "alternateGroup",
        "volume",
        "matrix",
        "mediaDuration",
        "mediaCreationTime",
        "mediaModificationTime",
        "language",
        "quality",
        "handlerName",
        "edits",
        "visual",
        "color",
        "pixelAspectRatio",
        "bitrate"
      ],
      "properties": {
        "creationTime": {
          "$ref": "#/$defs/U64"
        },
        "modificationTime": {
          "$ref": "#/$defs/U64"
        },
        "flags": {
          "$ref": "#/$defs/U32"
        },
        "duration": {
          "$ref": "#/$defs/U64"
        },
        "layer": {
          "$ref": "#/$defs/I16"
        },
        "alternateGroup": {
          "$ref": "#/$defs/I16"
        },
        "volume": {
          "$ref": "#/$defs/I16"
        },
        "matrix": {
          "$ref": "#/$defs/Matrix"
        },
        "mediaDuration": {
          "$ref": "#/$defs/U64"
        },
        "mediaCreationTime": {
          "$ref": "#/$defs/U64"
        },
        "mediaModificationTime": {
          "$ref": "#/$defs/U64"
        },
        "language": {
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/U16"
        },
        "handlerName": {
          "type": "string"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edit"
          }
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "type": "null"
            }
          ]
        },
        "pixelAspectRatio": {
          "anyOf": [
            {
              "$ref": "#/$defs/PixelAspectRatio"
            },
            {
              "type": "null"
            }
          ]
        },
        "bitrate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bitrate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackId",
        "timescale",
        "codec",
        "width",
        "height",
        "metadata",
        "chunkSampleCounts",
        "samples"
      ],
      "properties": {
        "trackId": {
          "$ref": "#/$defs/U32"
        },
        "timescale": {
          "$ref": "#/$defs/U32"
        },
        "codec": {
          "$ref": "#/$defs/Codec"
        },
        "width": {
          "$ref": "#/$defs/U32"
        },
        "height": {
          "$ref": "#/$defs/U32"
        },
        "metadata": {
          "$ref": "#/$defs/TrackMetadata"
        },
        "chunkSampleCounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/U32"
          }
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Sample"
          }
        }
      }
    }
  }
}
