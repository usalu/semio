{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/mp4/isobmff/any/mutation/remove-sample/schema.json",
  "title": "RemoveSample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "trackIndex",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "removeSample",
      "description": "Aggregate discriminator spliced in by Mp4Mutation; absent when the payload stands alone."
    },
    "trackIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Track",
          "de": "Spur"
        },
        "description": {
          "en": "Index of the track, counted from 0.",
          "de": "Index der Spur, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
