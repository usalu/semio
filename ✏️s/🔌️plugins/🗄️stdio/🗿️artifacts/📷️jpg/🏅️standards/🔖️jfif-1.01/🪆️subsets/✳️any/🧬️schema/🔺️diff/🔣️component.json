{
  "$id": "https://semio.tech/schema/s.stdio.jpg/diff.json",
  "title": "JpgDiff",
  "type": "object",
  "$defs": {
    "componentDiff": { "type": "object", "properties": { "hSampling": { "type": "integer" }, "vSampling": { "type": "integer" }, "quantTableId": { "type": "integer" } } },
    "componentsDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer" } },
        "modified": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "integer" }, "diff": { "$ref": "#/$defs/componentDiff" } } } },
        "added": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "item": { "type": "object" } } } }
      }
    },
    "frameChange": {
      "type": "object",
      "properties": {
        "change": { "type": "string", "enum": ["modify", "replace"] },
        "precision": { "type": "integer" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "components": { "$ref": "#/$defs/componentsDiff" },
        "frame": { "type": "object" }
      }
    },
    "quantTableDiff": { "type": "object", "properties": { "precision": { "type": "integer" }, "values": { "type": "array", "items": { "type": "integer" } } } },
    "quantTablesDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer" } },
        "modified": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "integer" }, "diff": { "$ref": "#/$defs/quantTableDiff" } } } },
        "added": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "item": { "type": "object" } } } }
      }
    },
    "huffmanTableKey": { "type": "object", "properties": { "class": { "type": "string", "enum": ["dc", "ac"] }, "id": { "type": "integer" } } },
    "huffmanTableDiff": { "type": "object", "properties": { "bits": { "type": "array", "items": { "type": "integer" } }, "values": { "type": "array", "items": { "type": "integer" } } } },
    "huffmanTablesDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "$ref": "#/$defs/huffmanTableKey" } },
        "modified": { "type": "array", "items": { "type": "object", "properties": { "key": { "$ref": "#/$defs/huffmanTableKey" }, "diff": { "$ref": "#/$defs/huffmanTableDiff" } } } },
        "added": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "item": { "type": "object" } } } }
      }
    },
    "segmentDiff": { "type": "object", "properties": { "marker": { "type": "integer" }, "data": { "type": "array", "items": { "type": "integer" } } } },
    "otherSegmentsDiff": {
      "type": "object",
      "properties": {
        "removed": { "type": "array", "items": { "type": "integer" } },
        "modified": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "diff": { "$ref": "#/$defs/segmentDiff" } } } },
        "added": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "item": { "type": "object" } } } }
      }
    }
  },
  "properties": {
    "width": { "type": "integer", "x-semio-state": "persistent" },
    "height": { "type": "integer", "x-semio-state": "persistent" },
    "pixels": { "type": "array", "items": { "type": "integer" }, "x-semio-state": "persistent" },
    "reEncodeQuality": { "type": ["integer", "null"], "x-semio-state": "persistent" },
    "jfifVersion": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2, "x-semio-state": "persistent" },
    "jfifDensityUnits": { "type": "string", "enum": ["aspect", "pixelsPerInch", "pixelsPerCm"], "x-semio-state": "persistent" },
    "jfifXDensity": { "type": "integer", "x-semio-state": "persistent" },
    "jfifYDensity": { "type": "integer", "x-semio-state": "persistent" },
    "jfifThumbnail": { "type": ["object", "null"], "x-semio-state": "persistent" },
    "frame": { "$ref": "#/$defs/frameChange", "x-semio-state": "persistent" },
    "sofMarker": { "type": "integer", "x-semio-state": "persistent" },
    "arithmetic": { "type": "boolean", "x-semio-state": "persistent" },
    "quantTables": { "$ref": "#/$defs/quantTablesDiff", "x-semio-state": "persistent" },
    "huffmanTables": { "$ref": "#/$defs/huffmanTablesDiff", "x-semio-state": "persistent" },
    "restartInterval": { "type": ["integer", "null"], "x-semio-state": "persistent" },
    "otherSegments": { "$ref": "#/$defs/otherSegmentsDiff", "x-semio-state": "persistent" }
  }
}
