{
  "$id": "https://semio.tech/schema/s.stdio.jpg/snapshot.json",
  "title": "JpgSnapshot",
  "type": "object",
  "$defs": {
    "jfifThumbnail": {
      "type": "object",
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "rgbData": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "jpgFrameComponent": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "hSampling": { "type": "integer" },
        "vSampling": { "type": "integer" },
        "quantTableId": { "type": "integer" }
      }
    },
    "jpgFrameHeader": {
      "type": "object",
      "properties": {
        "precision": { "type": "integer" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/jpgFrameComponent" } }
      }
    },
    "jpgQuantTable": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "precision": { "type": "integer" },
        "values": { "type": "array", "items": { "type": "integer" }, "minItems": 64, "maxItems": 64 }
      }
    },
    "jpgHuffmanTable": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "class": { "type": "string", "enum": ["dc", "ac"] },
        "bits": { "type": "array", "items": { "type": "integer" }, "minItems": 16, "maxItems": 16 },
        "values": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "jpgSegment": {
      "type": "object",
      "properties": {
        "marker": { "type": "integer" },
        "data": { "type": "array", "items": { "type": "integer" } }
      }
    }
  },
  "properties": {
    "schema": { "type": "string", "x-semio-state": "persistent" },
    "width": { "type": "integer", "x-semio-state": "persistent" },
    "height": { "type": "integer", "x-semio-state": "persistent" },
    "pixels": { "type": "array", "x-semio-state": "persistent", "items": { "type": "integer" } },
    "reEncodeQuality": { "type": "integer", "x-semio-state": "persistent" },
    "jfifVersion": { "type": "array", "x-semio-state": "persistent", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "jfifDensityUnits": { "type": "string", "enum": ["aspect", "pixelsPerInch", "pixelsPerCm"], "x-semio-state": "persistent" },
    "jfifXDensity": { "type": "integer", "x-semio-state": "persistent" },
    "jfifYDensity": { "type": "integer", "x-semio-state": "persistent" },
    "jfifThumbnail": { "$ref": "#/$defs/jfifThumbnail", "x-semio-state": "persistent" },
    "frame": { "$ref": "#/$defs/jpgFrameHeader", "x-semio-state": "persistent" },
    "sofMarker": { "type": "integer", "x-semio-state": "persistent" },
    "arithmetic": { "type": "boolean", "x-semio-state": "persistent" },
    "quantTables": { "type": "array", "x-semio-state": "persistent", "items": { "$ref": "#/$defs/jpgQuantTable" } },
    "huffmanTables": { "type": "array", "x-semio-state": "persistent", "items": { "$ref": "#/$defs/jpgHuffmanTable" } },
    "restartInterval": { "type": "integer", "x-semio-state": "persistent" },
    "otherSegments": { "type": "array", "x-semio-state": "persistent", "items": { "$ref": "#/$defs/jpgSegment" } }
  },
  "required": ["schema", "width", "height", "pixels", "jfifVersion", "jfifDensityUnits", "jfifXDensity", "jfifYDensity", "sofMarker", "arithmetic", "quantTables", "huffmanTables", "otherSegments"]
}
