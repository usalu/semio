{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/docx/ecma-376/base/mutation/set-part.json",
  "title": "SetPart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "content_type",
    "bytes"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "mutation": {
      "const": "setPart",
      "description": "Aggregate discriminator spliced in by DocxMutation; absent when the payload stands alone."
    }
  }
}
