{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/inference.json",
  "title": "DocxInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outline"
  ],
  "properties": {
    "outline": {
      "$ref": "#/$defs/DocxOutline",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "DocxOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paragraphCount",
        "tableCount",
        "wordCount"
      ],
      "properties": {
        "paragraphCount": {
          "type": "integer"
        },
        "tableCount": {
          "type": "integer"
        },
        "wordCount": {
          "type": "integer"
        }
      }
    }
  }
}
