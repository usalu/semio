{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/mutation/remove-xml-node/schema.json",
  "title": "RemoveXmlNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent",
    "index",
    "expectedName",
    "revision"
  ],
  "properties": {
    "parent": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/xml-address.json"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedName": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "mutation": {
      "const": "removeXmlNode"
    }
  }
}
