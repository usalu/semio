{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/canonical-xml-authority-fixture/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "parts", "edits", "preservedMarkers"],
  "properties": {
    "schema": { "const": "semio.stdio.docx.canonical-xml-authority-fixture.v1" },
    "parts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contentType", "xml"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "contentType": { "type": "string", "minLength": 1 },
          "xml": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edits": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "partPath", "targetMarker", "kind", "value"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "partPath": { "type": "string", "minLength": 1 },
          "targetMarker": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["setText", "setRunBold", "setParagraphStyle", "insertTableRow"] },
          "value": {}
        }
      }
    },
    "preservedMarkers": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
