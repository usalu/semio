dialect grammar
grammar stdio.docx.snapshot
extension docx
start document
comment none
string double raw
string single raw

document = "stdio.docx" snapshot;
snapshot = "[" octets "," package "," xml-parts "]";
package = "[" binary-parts "," pairs "," pairs "," relationship-owners "," octets "]";
binary-parts = "[" (binary-part ("," binary-part)*)? "]";
binary-part = "[" octets "," octets "," octets "]";
pairs = "[" (pair ("," pair)*)? "]";
pair = "[" octets "," octets "]";
relationship-owners = "[" (relationship-owner ("," relationship-owner)*)? "]";
relationship-owner = "[" octets "," relationships "]";
relationships = "[" (relationship ("," relationship)*)? "]";
relationship = "[" octets "," octets "," octets "," flag "]";
xml-parts = "[" (xml-part ("," xml-part)*)? "]";
xml-part = "[" octets "," octets "," xml-document "]";
xml-document = "[" root "," optional-doctype "," optional-declaration "," nodes "," nodes "]";
root = "[" ("0" | "1" "," node) "]";
optional-doctype = "[" ("0" | "1" "," doctype) "]";
optional-declaration = "[" ("0" | "1" "," declaration) "]";
optional-octets = "[" ("0" | "1" "," octets) "]";
optional-flag = "[" ("0" | "1" "," flag) "]";
declaration = "[" octets "," optional-octets "," optional-flag "," flag "]";
node = element | text | cdata | comment-node | processing;
element = "E" "[" octets "," attributes "," nodes "]";
attributes = "[" (pair ("," pair)*)? "]";
nodes = "[" (node ("," node)*)? "]";
text = "T" "[" octets "]";
cdata = "D" "[" octets "]";
comment-node = "M" "[" octets "]";
processing = "P" "[" octets "," octets "]";
doctype = "[" unsigned "," octets "," external-id "," entities "]";
external-id = "[" ("0" | "1" "," ("S" "[" octets "]" | "P" "[" octets "," octets "]")) "]";
entities = "[" (entity ("," entity)*)? "]";
entity = "E" "[" flag "," octets "," octets "]";
flag = "0" | "1";
unsigned = U64;
octets = HEX_BYTES?;
