{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/mutation/insert-style/schema.json",
  "title": "InsertStyle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "style"
  ],
  "properties": {
    "mutation": {
      "const": "insertStyle",
