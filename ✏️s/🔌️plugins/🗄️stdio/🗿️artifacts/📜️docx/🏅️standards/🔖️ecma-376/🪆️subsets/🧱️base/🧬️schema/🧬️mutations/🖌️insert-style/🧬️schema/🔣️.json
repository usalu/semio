{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/docx/ecma-376/base/mutation/insert-style/schema.json",
  "title": "InsertStyle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "style"
  ],
  "properties": {
    "style": {
      "$ref": "#/$defs/DocxStyle"
    },
    "mutation": {
      "const": "insertStyle",
      "description": "Aggregate discriminator spliced in by DocxMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "DocxStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "basedOn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
