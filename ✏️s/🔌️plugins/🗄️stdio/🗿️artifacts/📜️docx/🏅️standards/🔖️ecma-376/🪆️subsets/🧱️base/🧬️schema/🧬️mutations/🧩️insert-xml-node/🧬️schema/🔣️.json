{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/mutation/insert-xml-node/schema.json",
  "title": "InsertXmlNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "parent",
    "index",
    "node"
  ],
  "properties": {
    "mutation": {
      "const": "insertXmlNode"
    },
    "parent": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/xml-address.json",
      "x-semio-ui": {
        "label": {
          "en": "Parent element",
          "de": "Übergeordnetes Element"
        },
        "description": {
          "en": "Address of the element the node is inserted into.",
          "de": "Adresse des Elements, in das der Knoten eingefügt wird."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Child position",
          "de": "Kindposition"
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "node": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlNode",
      "x-semio-ui": {
        "label": {
          "en": "XML node",
          "de": "XML-Knoten"
        },
        "group": "value",
        "order": 30
      }
    }
  }
}
