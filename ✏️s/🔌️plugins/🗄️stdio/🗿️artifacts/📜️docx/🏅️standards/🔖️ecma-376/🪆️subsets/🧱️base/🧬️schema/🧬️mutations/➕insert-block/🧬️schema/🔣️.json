{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/mutation/insert-block/schema.json",
  "title": "InsertBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "block"
  ],
  "properties": {
    "mutation": {
      "const": "insertBlock",
      "description": "Aggregate discriminator spliced in by DocxMutation; absent when the payload stands alone."
    },
    "path": {
      "$ref": "#/$defs/DocxBlockPath",
      "x-semio-ui": {
        "label": {
          "en": "Block path",
          "de": "Blockpfad"
        },
        "description": {
          "en": "Where the block is inserted.",
          "de": "Wo der Block eingefügt wird."
        },
        "group": "target",
        "order": 10
      }
    },
    "block": {
      "$ref": "#/$defs/DocxBlock",
      "x-semio-ui": {
        "label": {
          "en": "Block",
          "de": "Block"
        },
        "description": {
          "en": "Paragraph or table to insert.",
          "de": "Einzufügender Absatz oder Tabelle."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "DocxBlockPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxPathSegment"
          },
          "x-semio-ui": {
            "label": {
              "en": "Segments",
              "de": "Segmente"
            },
            "description": {
              "en": "Descent through tables: block, row and cell per level.",
              "de": "Abstieg durch Tabellen: Block, Zeile und Zelle je Ebene."
            }
          }
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Block position",
              "de": "Blockposition"
            }
          }
        }
      }
    },
    "DocxPathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockIndex",
        "row",
        "cell"
      ],
      "properties": {
        "blockIndex": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Block",
              "de": "Block"
            },
            "description": {
              "en": "Index of the block, counted from 0.",
              "de": "Index des Blocks, ab 0 gezählt."
            }
          }
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Table row",
              "de": "Tabellenzeile"
            }
          }
        },
        "cell": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Table cell",
              "de": "Tabellenzelle"
            }
          }
        }
      }
    },
    "DocxBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "paragraph"
            },
            "runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocxRun"
              }
            },
            "style": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "extraParagraphProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "table"
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DocxTableRow"
              }
            },
            "extraTableProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlNode"
              }
            }
          }
        }
      ]
    },
    "DocxParagraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxRun"
          }
        },
        "style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraParagraphProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          }
        }
      }
    },
    "DocxRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "extraRunProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          }
        }
      }
    },
    "XmlNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string"
            },
            "attrs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlAttr"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "cData"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "comment"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "processingInstruction"
            },
            "target": {
              "type": "string"
            },
            "data": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "DocxTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxTableRow"
          }
        },
        "extraTableProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          }
        }
      }
    },
    "DocxTableRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxTableCell"
          }
        },
        "extraRowProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          }
        }
      }
    },
    "DocxTableCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxBlock"
          }
        },
        "extraCellProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlNode"
          }
        }
      }
    }
  }
}
