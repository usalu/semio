{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/strict/mutation/insert-alternate-content/schema.json",
  "title": "InsertAlternateContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Part",
          "de": "Paketteil"
        },
        "description": {
          "en": "OPC part name inside the package, e.g. word/document.xml.",
          "de": "OPC-Teilname im Paket, z. B. word/document.xml."
        },
        "group": "target",
        "order": 10
      }
    },
    "node": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlNode",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Fallback node",
          "de": "Rückfallknoten"
        },
        "description": {
          "en": "The fallback element to insert; the canonical one when absent.",
          "de": "Das einzufügende Rückfallelement; ohne Angabe das kanonische."
        },
        "group": "value",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position among the root's children; the last position when absent.",
          "de": "Position unter den Kindern der Wurzel; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    }
  }
}
