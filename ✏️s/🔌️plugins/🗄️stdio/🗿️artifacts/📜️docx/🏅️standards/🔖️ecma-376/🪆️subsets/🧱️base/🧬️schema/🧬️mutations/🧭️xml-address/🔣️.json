{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/xml-address.json",
  "title": "DocxXmlAddress",
  "description": "Canonical XML part and child path with expanded node name and lineage revision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["partPath", "nodePath", "expectedName", "revision"],
  "properties": {
    "partPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$",
      "not": { "pattern": "(^|/)\\.{1,2}(/|$)" }
    },
    "nodePath": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
    "expectedName": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
  }
}
