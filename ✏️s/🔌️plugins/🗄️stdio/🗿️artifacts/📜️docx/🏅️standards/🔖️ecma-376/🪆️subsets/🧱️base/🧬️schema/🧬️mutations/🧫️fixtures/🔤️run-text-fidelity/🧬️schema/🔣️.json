{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/run-text-fidelity-fixture/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "partPath", "cases"],
  "properties": {
    "schema": { "const": "semio.stdio.docx.run-text-fidelity.v1" },
    "partPath": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "targetPath", "xml", "replacement", "textElementCount", "preservedLocalNames"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "targetPath": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
          "xml": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string" },
          "textElementCount": { "type": "integer", "minimum": 1 },
          "preservedLocalNames": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}
