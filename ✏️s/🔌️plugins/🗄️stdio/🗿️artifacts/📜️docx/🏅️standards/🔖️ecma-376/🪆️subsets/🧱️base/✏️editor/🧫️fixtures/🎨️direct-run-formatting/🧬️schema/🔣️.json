{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DOCX direct run formatting fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "documentXml", "stylesXml", "directBefore", "command", "directAfter"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "documentXml": { "type": "string", "minLength": 1 },
    "stylesXml": { "type": "string", "minLength": 1 },
    "directBefore": { "$ref": "#/$defs/direct" },
    "command": { "$ref": "#/$defs/explicit" },
    "directAfter": { "$ref": "#/$defs/explicit" }
  },
  "$defs": {
    "direct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bold", "italic", "underline"],
      "properties": {
        "bold": { "type": ["boolean", "null"] },
        "italic": { "type": ["boolean", "null"] },
        "underline": { "type": ["boolean", "null"] }
      }
    },
    "explicit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bold", "italic", "underline"],
      "properties": {
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" }
      }
    }
  }
}
