{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/fixtures/empty-paragraph-edit-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "replacement", "cases"],
  "properties": {
    "schema": { "const": "semio.stdio.docx.empty-paragraph-edit.v1" },
    "replacement": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "xml", "blocks", "paths", "targetBlock", "targetItem", "preserved"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "xml": { "type": "string", "minLength": 1 },
          "blocks": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "paths": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "integer", "minimum": 0 } } } },
          "targetBlock": { "type": "integer", "minimum": 0 },
          "targetItem": { "type": "integer", "minimum": 0 },
          "preserved": { "type": "array", "items": { "type": "string" } },
          "preservedElements": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["namespace", "localName", "attributes"],
              "properties": {
                "namespace": { "type": "string" },
                "localName": { "type": "string", "minLength": 1 },
                "attributes": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
