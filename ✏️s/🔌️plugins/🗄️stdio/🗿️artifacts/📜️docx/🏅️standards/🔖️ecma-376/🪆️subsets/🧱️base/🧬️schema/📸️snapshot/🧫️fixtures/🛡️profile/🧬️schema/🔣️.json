{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "largeTextCharacters",
    "cancelAfter",
    "smallValueBudget"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subset",
          "xml",
          "relationshipBase",
          "codes",
          "warnings",
          "document"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "subset": {
            "enum": [
              "strict",
              "transitional"
            ]
          },
          "xml": {
            "type": "string"
          },
          "relationshipBase": {
            "type": "string"
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "integer",
            "minimum": 0
          },
          "document": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "prolog",
              "epilog"
            ],
            "properties": {
              "root": {
                "$ref": "#/$defs/node"
              },
              "prolog": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              },
              "epilog": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        }
      }
    },
    "largeTextCharacters": {
      "type": "integer",
      "minimum": 65536
    },
    "cancelAfter": {
      "type": "integer",
      "minimum": 256
    },
    "smallValueBudget": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "attrs",
            "children"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string"
            },
            "attrs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
