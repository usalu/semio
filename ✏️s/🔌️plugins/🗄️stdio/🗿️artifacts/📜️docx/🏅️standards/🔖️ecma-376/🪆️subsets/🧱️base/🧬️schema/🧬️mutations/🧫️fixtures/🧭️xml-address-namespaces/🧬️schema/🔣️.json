{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/xml-address-namespaces-fixture/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "partPath", "targetPath", "cases"],
  "properties": {
    "schema": { "const": "semio.stdio.docx.xml-address-namespaces.v1" },
    "partPath": { "type": "string", "minLength": 1 },
    "targetPath": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "xml"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "xml": { "type": "string", "minLength": 1 },
          "expectedName": { "type": "string", "minLength": 2 },
          "errorContains": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["expectedName"], "not": { "required": ["errorContains"] } },
          { "required": ["errorContains"], "not": { "required": ["expectedName"] } }
        ]
      }
    }
  }
}
