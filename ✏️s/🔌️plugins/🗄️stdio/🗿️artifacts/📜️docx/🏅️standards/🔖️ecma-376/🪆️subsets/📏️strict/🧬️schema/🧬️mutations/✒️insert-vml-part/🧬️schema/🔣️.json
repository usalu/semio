{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/strict/mutation/insert-vml-part/schema.json",
  "title": "InsertVmlPart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "markup"
  ],
  "properties": {
    "path": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Part",
          "de": "Paketteil"
        },
        "description": {
          "en": "OPC part name inside the package, e.g. word/document.xml.",
          "de": "OPC-Teilname im Paket, z. B. word/document.xml."
        },
        "group": "target",
        "order": 10
      }
    },
    "markup": {
      "type": "string",
      "x-semio-ui": {
        "widget": "multiline",
        "label": {
          "en": "VML markup",
          "de": "VML-Markup"
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
