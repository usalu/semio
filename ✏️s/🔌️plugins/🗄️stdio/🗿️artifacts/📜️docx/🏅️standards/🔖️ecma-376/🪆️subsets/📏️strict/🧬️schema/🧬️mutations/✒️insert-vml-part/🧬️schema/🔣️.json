{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/strict/mutation/insert-vml-part/schema.json",
  "title": "InsertVmlPart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "document"
  ],
  "properties": {
    "path": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Part",
          "de": "Paketteil"
        },
        "description": {
          "en": "OPC part name inside the package, e.g. word/document.xml.",
          "de": "OPC-Teilname im Paket, z. B. word/document.xml."
        },
        "group": "target",
        "order": 10
      }
    },
    "document": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlDocument",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "VML document",
          "de": "VML-Dokument"
        },
        "group": "value",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position the part takes among the XML parts; the last position when absent.",
          "de": "Position, die der Paketteil unter den XML-Paketteilen einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    },
    "override_index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Position the content-type override takes among the overrides; the last position when absent.",
          "de": "Position, die der Inhaltstyp-Eintrag unter den Einträgen einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 30
      }
    }
  }
}
