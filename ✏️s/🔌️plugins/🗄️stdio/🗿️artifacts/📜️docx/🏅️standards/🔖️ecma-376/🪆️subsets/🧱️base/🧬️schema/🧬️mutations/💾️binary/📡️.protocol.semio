dialect protocol
protocol stdio.docx.mutations
version 1
schema stdio.docx
start record
framing record

# Real `DocxMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record insert-block tag=1
field payload bytes
record remove-block tag=2
field payload bytes
record set-block-content tag=3
field payload bytes
record set-run-text tag=4
field payload bytes
record set-run-formatting tag=5
field payload bytes
record insert-style tag=6
field payload bytes
record remove-style tag=7
field payload bytes
record set-style-name tag=8
field payload bytes
record set-style-based-on tag=9
field payload bytes
record set-part tag=10
field payload bytes
record remove-part tag=11
field payload bytes
