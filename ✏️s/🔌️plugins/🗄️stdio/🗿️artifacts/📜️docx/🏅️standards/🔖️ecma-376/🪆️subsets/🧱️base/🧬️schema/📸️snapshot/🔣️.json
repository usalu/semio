{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/snapshot.json",
  "title": "DocxSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "opc",
    "xmlParts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Schema",
          "de": "Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema this document follows.",
          "de": "Kennung des Snapshot-Schemas, dem dieses Dokument folgt."
        }
      }
    },
    "opc": {
      "$ref": "#/$defs/OpcPackage",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "OPC package",
          "de": "OPC-Paket"
        }
      }
    },
    "xmlParts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocxXmlPart"
      },
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "XML parts",
          "de": "XML-Teile"
        }
      }
    }
  },
  "$defs": {
    "OpcPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parts",
        "contentTypes",
        "relationships",
        "comment"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpcPart"
          },
          "x-semio-ui": {
            "label": {
              "en": "Parts",
              "de": "Paketteile"
            }
          }
        },
        "contentTypes": {
          "$ref": "#/$defs/OpcContentTypes",
          "x-semio-ui": {
            "label": {
              "en": "Content types",
              "de": "Inhaltstypen"
            }
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OpcRelationship"
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Relationships",
              "de": "Beziehungen"
            }
          }
        },
        "comment": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "ZIP comment",
              "de": "ZIP-Kommentar"
            }
          }
        }
      }
    },
    "OpcPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Part name",
              "de": "Teilname"
            }
          }
        },
        "contentType": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Content type",
              "de": "Inhaltstyp"
            }
          }
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Part bytes",
              "de": "Teilinhalt (Bytes)"
            }
          }
        }
      }
    },
    "OpcContentTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaults",
        "overrides"
      ],
      "properties": {
        "defaults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name","contentType"],
            "properties": {
              "name": {
                "type": "string",
                "x-semio-ui": {
                  "label": {
                    "en": "File extension",
                    "de": "Dateierweiterung"
                  }
                }
              },
              "contentType": {
                "type": "string",
                "x-semio-ui": {
                  "label": {
                    "en": "Content type",
                    "de": "Inhaltstyp"
                  }
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Default mappings",
              "de": "Standardzuordnungen"
            },
            "description": {
              "en": "Extension to content type.",
              "de": "Dateierweiterung zu Inhaltstyp."
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name","contentType"],
            "properties": {
              "name": {
                "type": "string",
                "x-semio-ui": {
                  "label": {
                    "en": "Part name",
                    "de": "Teilname"
                  }
                }
              },
              "contentType": {
                "type": "string",
                "x-semio-ui": {
                  "label": {
                    "en": "Content type",
                    "de": "Inhaltstyp"
                  }
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Override mappings",
              "de": "Überschreibungen"
            },
            "description": {
              "en": "Part name to content type.",
              "de": "Teilname zu Inhaltstyp."
            }
          }
        }
      }
    },
    "OpcRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relType",
        "target",
        "targetMode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Relationship ID",
              "de": "Beziehungs-ID"
            }
          }
        },
        "relType": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Relationship type",
              "de": "Beziehungstyp"
            }
          }
        },
        "target": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Target",
              "de": "Ziel"
            }
          }
        },
        "targetMode": {
          "$ref": "#/$defs/OpcTargetMode",
          "x-semio-ui": {
            "label": {
              "en": "Target mode",
              "de": "Zielmodus"
            },
            "options": {
              "internal": {
                "en": "Internal",
                "de": "Intern"
              },
              "external": {
                "en": "External",
                "de": "Extern"
              }
            }
          }
        }
      }
    },
    "OpcTargetMode": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "DocxXmlPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType",
        "document"
      ],
      "properties": {
        "path": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Part name",
              "de": "Teilname"
            }
          }
        },
        "contentType": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Content type",
              "de": "Inhaltstyp"
            }
          }
        },
        "document": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/RetainedXmlDocument",
          "x-semio-ui": {
            "label": {
              "en": "XML document",
              "de": "XML-Dokument"
            }
          }
        }
      }
    }
  }
}
