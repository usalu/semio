{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/mutation/replace-xml-node/schema.json",
  "title": "ReplaceXmlNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "address",
    "node"
  ],
  "properties": {
    "mutation": {
      "const": "replaceXmlNode"
    },
    "address": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/xml-address.json",
      "x-semio-ui": {
        "label": {
          "en": "Node address",
          "de": "Knotenadresse"
        },
        "description": {
          "en": "XML part, child path, expected element name and revision stamp of the addressed node.",
          "de": "XML-Teil, Kindpfad, erwarteter Elementname und Revisionsstempel des adressierten Knotens."
        },
        "group": "target",
        "order": 10
      }
    },
    "node": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlNode",
      "x-semio-ui": {
        "label": {
          "en": "XML node",
          "de": "XML-Knoten"
        },
        "description": {
          "en": "Node that replaces the addressed one.",
          "de": "Knoten, der den adressierten ersetzt."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
