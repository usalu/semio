{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/mutation/remove-block/schema.json",
  "title": "RemoveBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path"
  ],
  "properties": {
    "mutation": {
      "const": "removeBlock",
      "description": "Aggregate discriminator spliced in by DocxMutation; absent when the payload stands alone."
    },
    "path": {
      "$ref": "#/$defs/DocxBlockPath",
      "x-semio-ui": {
        "label": {
          "en": "Block path",
          "de": "Blockpfad"
        },
        "group": "target",
        "order": 10
      }
    }
  },
  "$defs": {
    "DocxBlockPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxPathSegment"
          },
          "x-semio-ui": {
            "label": {
              "en": "Segments",
              "de": "Segmente"
            },
            "description": {
              "en": "Descent through tables: block, row and cell per level.",
              "de": "Abstieg durch Tabellen: Block, Zeile und Zelle je Ebene."
            }
          }
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Block position",
              "de": "Blockposition"
            }
          }
        }
      }
    },
    "DocxPathSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockIndex",
        "row",
        "cell"
      ],
      "properties": {
        "blockIndex": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Block",
              "de": "Block"
            },
            "description": {
              "en": "Index of the block, counted from 0.",
              "de": "Index des Blocks, ab 0 gezählt."
            }
          }
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Table row",
              "de": "Tabellenzeile"
            }
          }
        },
        "cell": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "label": {
              "en": "Table cell",
              "de": "Tabellenzelle"
            }
          }
        }
      }
    }
  }
}
