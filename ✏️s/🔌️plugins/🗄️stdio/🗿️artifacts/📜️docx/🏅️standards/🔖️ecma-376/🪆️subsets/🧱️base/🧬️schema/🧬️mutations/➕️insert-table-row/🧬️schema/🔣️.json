{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/mutation/insert-table-row/schema.json",
  "title": "InsertTableRow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "address",
    "index",
    "cells"
  ],
  "properties": {
    "mutation": {
      "const": "insertTableRow"
    },
    "address": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/xml-address.json",
      "x-semio-ui": {
        "label": {
          "en": "Node address",
          "de": "Knotenadresse"
        },
        "description": {
          "en": "XML part, child path, expected element name and revision stamp of the addressed node.",
          "de": "XML-Teil, Kindpfad, erwarteter Elementname und Revisionsstempel des adressierten Knotens."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Row position",
          "de": "Zeilenposition"
        },
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "x-semio-ui": {
        "label": {
          "en": "Cell texts",
          "de": "Zelltexte"
        },
        "group": "value",
        "order": 30
      }
    }
  }
}
