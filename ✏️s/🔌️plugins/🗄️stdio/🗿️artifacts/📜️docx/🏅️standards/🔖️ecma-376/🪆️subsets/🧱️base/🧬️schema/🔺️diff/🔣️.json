      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxXmlPartModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocxXmlPart"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
