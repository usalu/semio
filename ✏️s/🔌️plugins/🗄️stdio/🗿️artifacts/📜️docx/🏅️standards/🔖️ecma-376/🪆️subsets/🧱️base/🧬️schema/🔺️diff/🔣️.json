              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/OpcRelationship"
                }
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DocxOpcContentTypesDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "$ref": "#/$defs/DocxOpcCtEntriesDiff"
        },
        "overrides": {
          "$ref": "#/$defs/DocxOpcCtEntriesDiff"
        }
      }
    },
    "DocxOpcDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comment": {
          "type": "string"
