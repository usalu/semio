        "relType": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "targetMode": {
          "$ref": "#/$defs/OpcTargetMode"
        }
      }
    },
    "OpcTargetMode": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ]
    },
    "DocxOpcCtEntriesDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "diff"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "type": "string"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DocxOpcPartDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contentType": {
          "type": "string"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "DocxOpcPartsDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "diff"
