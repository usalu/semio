  "$defs": {
    "OpcPackage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpcPart"
          }
        },
        "contentTypes": {
          "$ref": "#/$defs/OpcContentTypes"
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OpcRelationship"
            }
          }
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "OpcPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "OpcContentTypes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
