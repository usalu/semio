        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DocxOpcRelDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relType": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "targetMode": {
          "$ref": "#/$defs/OpcTargetMode"
        }
      }
    },
    "DocxOpcRelListDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "diff"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "$ref": "#/$defs/DocxOpcRelDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpcRelationship"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DocxOpcRelationshipsDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "diff"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "diff": {
                "$ref": "#/$defs/DocxOpcRelListDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
