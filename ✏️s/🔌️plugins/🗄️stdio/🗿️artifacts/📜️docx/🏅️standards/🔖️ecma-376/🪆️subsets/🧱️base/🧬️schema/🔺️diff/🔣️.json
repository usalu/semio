{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/docx/ecma-376/base/diff.json",
  "title": "DocxDiff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "opc": {
      "$ref": "#/$defs/DocxOpcDiff",
