      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contentType",
        "document"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "contentType": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlDocument"
        }
      }
    },
    "DocxXmlPartDiff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contentType": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/diff.json"
        }
      }
    },
    "DocxXmlPartModified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "diff"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "diff": {
          "$ref": "#/$defs/DocxXmlPartDiff"
