  "comparisonPipelines": [
    {
      "id": "jpg-jfif-1-01-image-compare-v1",
      "description": "Reads two JPEG documents with an independent jpeg-jfif-codec projection (dimensions, colour type, raster digest, xmp/exif/iptc/iccProfile presence+digest) and compares them structurally. GATING for the four mutation kinds this reader can witness (`insert-other-segment`, `remove-other-segment`, `replace-pixels`, `replace-image`); registered as a freestanding pipeline rather than wired into the existing `semantic-jpg-mutate-v1` profile's own `pipeline` field, since that profile is already the live comparison for the reclassified `image-jpeg-jfif-1-01-mutate` (`cross-semio-implementation`) oracle's own scenario (`✏️s/🔌️plugins/🗄️stdio/🗿️artifacts/📸️jpg/🏅️standards/🔖️jfif-1.01/🪆️subsets/🧾️document/🧪️tests/📸️mutate-jpg-jfif-1-01/🥒️.feature`, tags `@oracle-image-jpeg-jfif-1-01-mutate @comparison-semantic-jpg-mutate-v1`) — retargeting that field would have silently redirected an existing, already-registered comparison this ticket was told to leave untouched.",
      "stages": [
        {
          "probe": "jpg-import",
          "description": "An independent reader accepts both files.",
          "inputs": [
            "expected-jpg",
            "actual-jpg"
          ],
          "assertions": {
            "bothImport": true
          }
        },
        {
          "probe": "jpg-compare",
          "description": "Structural equality over the projected fields both files actually carry — the operative equality.",
          "inputs": [
            "expected-jpg",
            "actual-jpg"
          ],
          "assertions": {
            "equal": true
          }
        }
      ]
    },
    {
      "id": "jpg-jfif-1-01-marker-compare-v1",
      "description": "JFIF metadata equality through Pillow. GATING for change-jfif-header, which image-rs does not expose on decode.",
      "stages": [
        {
          "probe": "jpg-marker-project",
          "description": "An independent marker-aware reader accepts both files.",
          "inputs": [
            "expected-before-jpg",
            "expected-after-jpg"
          ],
          "assertions": {
            "bothImport": true
          }
        },
        {
          "probe": "jpg-marker-compare",
          "description": "Equality over the marker facts — the operative equality.",
          "inputs": [
            "expected-before-jpg",
            "expected-after-jpg"
          ],
          "assertions": {
            "equal": true
          }
        }
      ]
    }
  ],
