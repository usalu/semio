{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/jpg/jfif-1.01/document/mutation/insert-other-segment/schema.json",
  "title": "InsertOtherSegmentMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "segment"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "segment": {
      "$ref": "#/$defs/JpgSegment"
    }
  },
  "$defs": {
    "JpgSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker"
      ],
      "properties": {
        "marker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
