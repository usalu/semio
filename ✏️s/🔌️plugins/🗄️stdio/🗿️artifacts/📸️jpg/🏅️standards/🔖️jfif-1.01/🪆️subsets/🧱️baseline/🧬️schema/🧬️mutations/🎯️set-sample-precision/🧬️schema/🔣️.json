{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/baseline/mutation/set-sample-precision/schema.json",
  "title": "SetSamplePrecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "precision"
  ],
  "properties": {
    "precision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Sample precision",
          "de": "Abtastgenauigkeit"
        },
        "unit": "bit",
        "step": 1,
        "snaps": [
          8,
          12
        ]
      }
    }
  }
}
