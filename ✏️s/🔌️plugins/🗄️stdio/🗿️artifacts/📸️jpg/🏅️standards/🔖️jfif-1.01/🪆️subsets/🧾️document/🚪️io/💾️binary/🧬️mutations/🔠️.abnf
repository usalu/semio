; Native declaration tags and structurally typed semantic image fields.
mutation = %x01 (change-jfif / insert-segment / remove-segment / replace-pixels / replace-image)
change-jfif = %x01 version density-units varint varint optional-thumbnail
insert-segment = %x02 varint segment
remove-segment = %x03 varint
replace-pixels = %x04 bytes
replace-image = %x05 image
image = varint varint bytes version density-units varint varint optional-thumbnail segments
version = OCTET OCTET
density-units = %x00 / %x01 / %x02
optional-thumbnail = %x00 / (%x01 thumbnail)
thumbnail = OCTET OCTET bytes
segment = OCTET bytes
segments = varint *segment
bytes = varint *OCTET
varint = *9(%x80-FF) %x00-7F
OCTET = %x00-FF
; Counts declare the exact repetition extent; varints are minimal unsigned64 values.
