{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio-tech.github.io/schema/stdio/jpg/jfif-1.01/document/io/binary/decoded-components",
  "title": "Decoded JPEG Components",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "height",
    "componentIds",
    "samples"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "componentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  },
  "$comment": "Samples are pixel-major original SOF component order, nearest expanded, rounded and clamped before any color conversion. Length equals width * height * componentIds.length."
}
