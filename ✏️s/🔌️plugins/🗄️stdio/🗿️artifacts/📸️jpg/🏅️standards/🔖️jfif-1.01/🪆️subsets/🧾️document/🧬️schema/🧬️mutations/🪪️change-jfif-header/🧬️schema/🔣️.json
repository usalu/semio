{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/jpg/jfif-1.01/document/mutation/change-jfif-header/schema.json",
  "title": "ChangeJfifHeaderMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "densityUnits",
    "xDensity",
    "yDensity"
  ],
  "properties": {
    "version": {
      "type": "array",
      "items": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      ],
      "additionalItems": false,
      "minItems": 2,
      "maxItems": 2
    },
    "densityUnits": {
      "$ref": "#/$defs/JfifDensityUnits"
    },
    "xDensity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "yDensity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "thumbnail": {
      "anyOf": [
        {
          "$ref": "#/$defs/JfifThumbnail"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "JfifDensityUnits": {
      "type": "string",
      "enum": [
        "aspect",
        "pixelsPerInch",
        "pixelsPerCm"
      ]
    },
    "JfifThumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "rgbData": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
