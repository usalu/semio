{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/document/mutation/insert-other-segment/schema.json",
  "title": "InsertOtherSegmentMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "segment"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "segment": {
      "$ref": "#/$defs/JpgSegment",
      "x-semio-ui": {
        "label": {
          "en": "Segment",
          "de": "Segment"
        }
      }
    }
  },
  "$defs": {
    "JpgSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker"
      ],
      "properties": {
        "marker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Marker",
              "de": "Marker"
            },
            "description": {
              "en": "Marker code following the 0xFF prefix.",
              "de": "Markercode nach dem Präfix 0xFF."
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
