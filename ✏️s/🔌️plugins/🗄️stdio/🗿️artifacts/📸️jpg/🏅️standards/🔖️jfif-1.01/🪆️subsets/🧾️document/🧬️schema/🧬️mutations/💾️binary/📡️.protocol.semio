dialect protocol
protocol stdio.jpg.mutations
version 1
schema stdio.jpg.op
start op
framing record

# Real op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload (its leaf's `💾️binary` codec).
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: every leaf
# codec derives its tag from its record at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record change-jfif-header tag=2
field payload bytes
record replace-quant-table tag=3
field payload bytes
record remove-quant-table tag=4
field payload bytes
record replace-huffman-table tag=5
field payload bytes
record remove-huffman-table tag=6
field payload bytes
record change-restart-interval tag=7
field payload bytes
record insert-other-segment tag=8
field payload bytes
record remove-other-segment tag=9
field payload bytes
record replace-pixels tag=10
field payload bytes
record change-re-encode-quality tag=11
field payload bytes
