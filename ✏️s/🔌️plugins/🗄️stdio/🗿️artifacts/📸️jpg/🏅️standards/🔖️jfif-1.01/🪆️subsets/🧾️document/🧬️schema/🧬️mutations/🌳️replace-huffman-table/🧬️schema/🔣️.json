{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/document/mutation/replace-huffman-table/schema.json",
  "title": "ReplaceHuffmanTableMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table"
  ],
  "properties": {
    "table": {
      "$ref": "#/$defs/JpgHuffmanTable"
    }
  },
  "$defs": {
    "JpgHuffmanTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "bits"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "class": {
          "$ref": "#/$defs/JpgHuffmanClass",
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Table class",
              "de": "Tabellenklasse"
            },
            "options": {
              "dc": {
                "en": "DC coefficients",
                "de": "DC-Koeffizienten"
              },
              "ac": {
                "en": "AC coefficients",
                "de": "AC-Koeffizienten"
              }
            }
          }
        },
        "bits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 16,
          "maxItems": 16,
          "x-semio-ui": {
            "label": {
              "en": "Codes per length",
              "de": "Codes je Länge"
            },
            "description": {
              "en": "BITS: number of Huffman codes of each length 1 to 16.",
              "de": "BITS: Anzahl der Huffman-Codes je Länge 1 bis 16."
            }
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "JpgHuffmanClass": {
      "type": "string",
      "enum": [
        "dc",
        "ac"
      ]
    }
  }
}
