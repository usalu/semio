{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/baseline/mutation/remove-huffman-table/schema.json",
  "title": "RemoveHuffmanTable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key"
  ],
  "properties": {
    "key": {
      "$ref": "#/$defs/JpgHuffmanTableKey",
      "x-semio-ui": {
        "label": {
          "en": "Table",
          "de": "Tabelle"
        },
        "description": {
          "en": "Class (DC or AC) and destination id of the Huffman table that is removed.",
          "de": "Klasse (DC oder AC) und Zielkennung der Huffman-Tabelle, die entfernt wird."
        },
        "group": "target",
        "order": 10
      }
    }
  },
  "$defs": {
    "JpgHuffmanTableKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "id"
      ],
      "properties": {
        "class": {
          "$ref": "#/$defs/JpgHuffmanClass",
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Table class",
              "de": "Tabellenklasse"
            },
            "options": {
              "dc": {
                "en": "DC coefficients",
                "de": "DC-Koeffizienten"
              },
              "ac": {
                "en": "AC coefficients",
                "de": "AC-Koeffizienten"
              }
            }
          }
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "JpgHuffmanClass": {
      "type": "string",
      "enum": [
        "dc",
        "ac"
      ]
    }
  }
}
