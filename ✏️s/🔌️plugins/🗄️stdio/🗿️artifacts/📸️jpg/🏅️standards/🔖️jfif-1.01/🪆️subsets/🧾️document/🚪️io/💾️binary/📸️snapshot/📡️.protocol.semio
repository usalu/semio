dialect protocol
protocol stdio.jpg.snapshot
version 1
schema stdio.jpg
start snapshot
framing record
use semio.pack

record snapshot {
  schema utf8
  width u32
  height u32
  pixels array u8
  jfifVersion array u8
  jfifDensityUnits Ref(JfifDensityUnits)
  jfifXDensity u16
  jfifYDensity u16
  jfifThumbnail Ref(OptionalThumbnail)
  otherSegments array Ref(JpgSegment)
}
enum JfifDensityUnits {
  aspect=0
  pixelsPerInch=1
  pixelsPerCm=2
}
record JfifThumbnail {
  width u8
  height u8
  rgbData array u8
}





record JpgSegment {
  marker u8
  data array u8
}

record OptionalOctet {
  present u8
  value u8 if present eq 1
}

record OptionalThumbnail {
  present u8
  value Ref(JfifThumbnail) if present eq 1
}

