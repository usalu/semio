{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/document/mutation/change-jfif-header/schema.json",
  "title": "ChangeJfifHeaderMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "densityUnits",
    "xDensity",
    "yDensity"
  ],
  "properties": {
    "version": {
      "type": "array",
      "items": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      ],
      "additionalItems": false,
      "minItems": 2,
      "maxItems": 2,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "JFIF version",
          "de": "JFIF-Version"
        },
        "description": {
          "en": "Major and minor version of the JFIF header, for example 1 and 2 for 1.02.",
          "de": "Haupt- und Nebenversion des JFIF-Headers, zum Beispiel 1 und 2 für 1.02."
        },
        "group": "value",
        "order": 10
      }
    },
    "densityUnits": {
      "$ref": "#/$defs/JfifDensityUnits",
      "x-semio-ui": {
        "widget": "segmented",
        "label": {
          "en": "Density unit",
          "de": "Dichteeinheit"
        },
        "options": {
          "aspect": {
            "en": "Aspect ratio only",
            "de": "Nur Seitenverhältnis"
          },
          "pixelsPerInch": {
            "en": "Pixels per inch",
            "de": "Pixel pro Zoll"
          },
          "pixelsPerCm": {
            "en": "Pixels per centimeter",
            "de": "Pixel pro Zentimeter"
          }
        }
      }
    },
    "xDensity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Horizontal pixel density",
          "de": "Horizontale Pixeldichte"
        },
        "step": 1
      }
    },
    "yDensity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Vertical pixel density",
          "de": "Vertikale Pixeldichte"
        },
        "step": 1
      }
    },
    "thumbnail": {
      "anyOf": [
        {
          "$ref": "#/$defs/JfifThumbnail"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Thumbnail",
          "de": "Vorschaubild"
        }
      }
    }
  },
  "$defs": {
    "JfifDensityUnits": {
      "type": "string",
      "enum": [
        "aspect",
        "pixelsPerInch",
        "pixelsPerCm"
      ]
    },
    "JfifThumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "rgbData": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "RGB data",
              "de": "RGB-Daten"
            },
            "description": {
              "en": "Uncompressed 24-bit RGB thumbnail pixels.",
              "de": "Unkomprimierte 24-Bit-RGB-Pixel des Vorschaubilds."
            }
          }
        }
      }
    }
  }
}
