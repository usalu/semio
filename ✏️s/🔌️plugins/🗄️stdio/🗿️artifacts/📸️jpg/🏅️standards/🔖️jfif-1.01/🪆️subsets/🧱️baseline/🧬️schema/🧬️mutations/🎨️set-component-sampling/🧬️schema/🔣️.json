{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/baseline/mutation/set-component-sampling/schema.json",
  "title": "SetComponentSampling",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hSampling",
    "vSampling"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Component",
          "de": "Komponente"
        },
        "description": {
          "en": "Component identifier (Ci) in the frame header.",
          "de": "Komponentenkennung (Ci) im Frame-Header."
        },
        "ref": {
          "kind": "component"
        },
        "group": "target",
        "order": 10
      }
    },
    "hSampling": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Horizontal sampling factor",
          "de": "Horizontaler Abtastfaktor"
        },
        "step": 1
      }
    },
    "vSampling": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Vertical sampling factor",
          "de": "Vertikaler Abtastfaktor"
        },
        "step": 1
      }
    }
  }
}
