{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio-tech.github.io/schema/stdio/jpg/jfif-1.01/document/io/binary/encode-options",
  "title": "JPEG Encode Options",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quality",
    "components"
  ],
  "properties": {
    "quality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hSampling",
          "vSampling"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "hSampling": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "vSampling": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      }
    }
  },
  "$comment": "Physical export policy, never part of the semantic artifact snapshot or mutation history. Component count is one for gray or three for Y/Cb/Cr; sampling factors must divide the maxima."
}
