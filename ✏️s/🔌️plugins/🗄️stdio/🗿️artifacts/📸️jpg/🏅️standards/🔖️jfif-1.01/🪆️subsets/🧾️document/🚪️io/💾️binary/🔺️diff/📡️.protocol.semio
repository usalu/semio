dialect protocol
protocol stdio.jpg.diff
version 1
schema stdio.jpg
start Diff
framing literal

record Diff {
 format Format
 flags u16
 width varint if flags bits 1
 height varint if flags bits 2
 pixels bytes if flags bits 4
 jfif_version Version if flags bits 8
 jfif_density_units DensityUnits if flags bits 16
 jfif_x_density varint if flags bits 32
 jfif_y_density varint if flags bits 64
 jfif_thumbnail ThumbnailChange if flags bits 128
 other_segments SegmentCollectionDiff if flags bits 256
}
enum Format { current=1 }
enum Presence { absent=0 present=1 }
enum DensityUnits { aspect=0 pixels_per_inch=1 pixels_per_cm=2 }
record Version { major u8 minor u8 }
record Thumbnail { width u8 height u8 rgb_data bytes }
record ThumbnailChange { presence Presence thumbnail Thumbnail if presence eq 1 }
record Segment { marker u8 data bytes }
record MarkerChange { presence Presence marker u8 if presence eq 1 }
record DataChange { presence Presence data bytes if presence eq 1 }
record SegmentDiff { marker MarkerChange data DataChange }
record ModifiedSegment { index varint diff SegmentDiff }
record AddedSegment { index varint item Segment }
record SegmentCollectionDiff {
 removed Array(varint,Varint)
 modified Array(ModifiedSegment,Varint)
 added Array(AddedSegment,Varint)
}
