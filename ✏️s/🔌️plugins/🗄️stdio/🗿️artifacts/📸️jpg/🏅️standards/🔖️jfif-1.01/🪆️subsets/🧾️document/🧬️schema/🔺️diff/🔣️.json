{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/jpg/jfif-1.01/document/diff.json",
  "title": "JpgDiff",
  "type": "object",
  "properties": {
    "width": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "height": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "pixels": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "x-semio-state": "artifact"
    },
    "reEncodeQuality": {
      "type": [
        "integer",
        "null"
      ],
      "x-semio-state": "artifact"
    },
    "jfifVersion": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2,
      "x-semio-state": "artifact"
    },
    "jfifDensityUnits": {
      "type": "string",
      "enum": [
        "aspect",
        "pixelsPerInch",
        "pixelsPerCm"
      ],
      "x-semio-state": "artifact"
    },
    "jfifXDensity": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "jfifYDensity": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "jfifThumbnail": {
      "type": [
        "object",
        "null"
      ],
      "x-semio-state": "artifact"
    },
    "frame": {
      "$ref": "#/definitions/frameChange",
      "x-semio-state": "artifact"
    },
    "sofMarker": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "arithmetic": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "quantTables": {
      "$ref": "#/definitions/quantTablesDiff",
      "x-semio-state": "artifact"
    },
    "huffmanTables": {
      "$ref": "#/definitions/huffmanTablesDiff",
      "x-semio-state": "artifact"
    },
    "restartInterval": {
      "type": [
        "integer",
        "null"
      ],
      "x-semio-state": "artifact"
    },
    "otherSegments": {
      "$ref": "#/definitions/otherSegmentsDiff",
      "x-semio-state": "artifact"
    }
  },
  "definitions": {
    "componentDiff": {
      "type": "object",
      "properties": {
        "hSampling": {
          "type": "integer"
        },
        "vSampling": {
          "type": "integer"
        },
        "quantTableId": {
          "type": "integer"
        }
      }
    },
    "componentsDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "diff": {
                "$ref": "#/definitions/componentDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "item": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "frameChange": {
      "type": "object",
      "properties": {
        "change": {
          "type": "string",
          "enum": [
            "modify",
            "replace"
          ]
        },
        "precision": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "components": {
          "$ref": "#/definitions/componentsDiff"
        },
        "frame": {
          "type": "object"
        }
      }
    },
    "quantTableDiff": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "integer"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "quantTablesDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "diff": {
                "$ref": "#/definitions/quantTableDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "item": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "huffmanTableKey": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "dc",
            "ac"
          ]
        },
        "id": {
          "type": "integer"
        }
      }
    },
    "huffmanTableDiff": {
      "type": "object",
      "properties": {
        "bits": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "huffmanTablesDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/huffmanTableKey"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/definitions/huffmanTableKey"
              },
              "diff": {
                "$ref": "#/definitions/huffmanTableDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "item": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "segmentDiff": {
      "type": "object",
      "properties": {
        "marker": {
          "type": "integer"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "otherSegmentsDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "diff": {
                "$ref": "#/definitions/segmentDiff"
              }
            }
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "item": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
