{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/document/diff.json",
  "title": "JpgDiff",
  "type": "object",
  "properties": {
    "width": {
      "type": "integer",
      "x-semio-state": "artifact",
      "minimum": 0,
      "maximum": 4294967295
    },
    "height": {
      "type": "integer",
      "x-semio-state": "artifact",
      "minimum": 0,
      "maximum": 4294967295
    },
    "pixels": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "x-semio-state": "artifact"
    },
    "jfifVersion": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 2,
      "maxItems": 2,
      "x-semio-state": "artifact"
    },
    "jfifDensityUnits": {
      "type": "string",
      "enum": [
        "aspect",
        "pixelsPerInch",
        "pixelsPerCm"
      ],
      "x-semio-state": "artifact"
    },
    "jfifXDensity": {
      "type": "integer",
      "x-semio-state": "artifact",
      "minimum": 0,
      "maximum": 65535
    },
    "jfifYDensity": {
      "type": "integer",
      "x-semio-state": "artifact",
      "minimum": 0,
      "maximum": 65535
    },
    "jfifThumbnail": {
      "anyOf": [
        {
          "$ref": "#/definitions/JfifThumbnail"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    },
    "otherSegments": {
      "$ref": "#/definitions/otherSegmentsDiff",
      "x-semio-state": "artifact"
    }
  },
  "definitions": {
    "segmentDiff": {
      "type": "object",
      "properties": {
        "marker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "additionalProperties": false
    },
    "otherSegmentsDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "diff": {
                "$ref": "#/definitions/segmentDiff"
              }
            },
            "additionalProperties": false,
            "required": [
              "index",
              "diff"
            ]
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "item": {
                "$ref": "#/definitions/JpgSegment"
              }
            },
            "additionalProperties": false,
            "required": [
              "index",
              "item"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "JfifThumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "rgbData"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "rgbData": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "RGB data",
              "de": "RGB-Daten"
            },
            "description": {
              "en": "Uncompressed 24-bit RGB thumbnail pixels.",
              "de": "Unkomprimierte 24-Bit-RGB-Pixel des Vorschaubilds."
            }
          }
        }
      }
    },
    "JpgSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker",
        "data"
      ],
      "properties": {
        "marker": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Marker",
              "de": "Marker"
            },
            "description": {
              "en": "Marker code following the 0xFF prefix.",
              "de": "Markercode nach dem Präfix 0xFF."
            }
          },
          "minimum": 0,
          "maximum": 255
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
