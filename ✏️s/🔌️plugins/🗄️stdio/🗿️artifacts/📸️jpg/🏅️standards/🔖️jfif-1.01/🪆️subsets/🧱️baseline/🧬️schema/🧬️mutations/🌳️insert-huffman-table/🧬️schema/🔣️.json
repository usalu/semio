{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/jpg/jfif-1.01/baseline/mutation/insert-huffman-table/schema.json",
  "title": "InsertHuffmanTable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "table"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "table": {
      "$ref": "#/$defs/JpgHuffmanTable"
    }
  },
  "$defs": {
    "JpgHuffmanTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "bits"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "class": {
          "$ref": "#/$defs/JpgHuffmanClass"
        },
        "bits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 16,
          "maxItems": 16
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "JpgHuffmanClass": {
      "type": "string",
      "enum": [
        "dc",
        "ac"
      ]
    }
  }
}
