dialect grammar
grammar stdio.jpg.snapshot
extension jpg
start document
comment none

document = artifact-mark payload
artifact-mark = "stdio.jpg"
payload = "schema" "=" text "width" "=" uint "height" "=" uint "pixels" "=" text "jfifXDensity" "=" uint "jfifYDensity" "=" uint "jfifVersion" "=" version "jfifDensityUnits" "=" text "jfifThumbnail" "=" thumbnail "otherSegments" "=" "[" segment* "]"
version = "[" uint uint "]"
octets = "bytes64" "(" text ")"
thumbnail = "null" / "{" "height" "=" uint "rgbData" "=" octets "width" "=" uint "}"
segment = "{" "data" "=" octets "marker" "=" uint "}"

uint = INT
text = STRING / IDENT / INT / FLOAT
