dialect grammar
grammar stdio.jpg.snapshot
extension jpg
start document
comment none

document = artifact-mark payload
artifact-mark = "stdio.jpg"
payload = "schema" "=" text "width" "=" uint "height" "=" uint "pixels" "=" text "jfifXDensity" "=" uint "jfifYDensity" "=" uint "sofMarker" "=" uint "arithmetic" "=" bool "jfifVersion" "=" version "jfifDensityUnits" "=" text "jfifThumbnail" "=" thumbnail "frame" "=" frame "quantTables" "=" "[" quantizer* "]" "huffmanTables" "=" "[" huffman* "]" "restartInterval" "=" optional-uint "otherSegments" "=" "[" segment* "]"
optional-uint = "null" / uint
version = "[" uint uint "]"
octets = "bytes64" "(" text ")"
thumbnail = "null" / "{" "height" "=" uint "rgbData" "=" octets "width" "=" uint "}"
frame = "null" / "{" "components" "=" "[" component* "]" "height" "=" uint "precision" "=" uint "width" "=" uint "}"
component = "{" "hSampling" "=" uint "id" "=" uint "quantTableId" "=" uint "vSampling" "=" uint "}"
quantizer = "{" "id" "=" uint "precision" "=" uint "values" "=" "[" uint* "]" "}"
huffman = "{" "bits" "=" "[" uint* "]" "class" "=" text "id" "=" uint "values" "=" octets "}"
segment = "{" "data" "=" octets "marker" "=" uint "}"

uint = INT
text = STRING / IDENT / INT / FLOAT
bool = "true" / "false"
