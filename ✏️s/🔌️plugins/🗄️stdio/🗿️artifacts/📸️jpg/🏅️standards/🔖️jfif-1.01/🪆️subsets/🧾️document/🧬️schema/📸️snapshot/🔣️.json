{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/jpg/jfif-1.01/document/snapshot.json",
  "title": "JpgSnapshot",
  "type": "object",
  "$defs": {
    "JfifThumbnail": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "rgbData": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "JpgFrameComponent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "hSampling": {
          "type": "integer"
        },
        "vSampling": {
          "type": "integer"
        },
        "quantTableId": {
          "type": "integer"
        }
      }
    },
    "JpgFrameHeader": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JpgFrameComponent"
          }
        }
      }
    },
    "JpgHuffmanTable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "class": {
          "type": "string",
          "enum": [
            "dc",
            "ac"
          ]
        },
        "bits": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 16,
          "maxItems": 16
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "JpgQuantTable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "precision": {
          "type": "integer"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 64,
          "maxItems": 64
        }
      }
    },
    "JpgSegment": {
      "type": "object",
      "properties": {
        "marker": {
          "type": "integer"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "width": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "height": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "pixels": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "integer"
      }
    },
    "reEncodeQuality": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "jfifVersion": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "jfifDensityUnits": {
      "type": "string",
      "enum": [
        "aspect",
        "pixelsPerInch",
        "pixelsPerCm"
      ],
      "x-semio-state": "artifact"
    },
    "jfifXDensity": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "jfifYDensity": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "jfifThumbnail": {
      "$ref": "#/$defs/JfifThumbnail",
      "x-semio-state": "artifact"
    },
    "frame": {
      "$ref": "#/$defs/JpgFrameHeader",
      "x-semio-state": "artifact"
    },
    "sofMarker": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "arithmetic": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "quantTables": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/JpgQuantTable"
      }
    },
    "huffmanTables": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/JpgHuffmanTable"
      }
    },
    "restartInterval": {
      "type": "integer",
      "x-semio-state": "artifact"
    },
    "otherSegments": {
      "type": "array",
      "x-semio-state": "artifact",
      "items": {
        "$ref": "#/$defs/JpgSegment"
      }
    }
  },
  "required": [
    "schema",
    "width",
    "height",
    "pixels",
    "jfifVersion",
    "jfifDensityUnits",
    "jfifXDensity",
    "jfifYDensity",
    "sofMarker",
    "arithmetic",
    "quantTables",
    "huffmanTables",
    "otherSegments"
  ]
}
