{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/document/snapshot.json",
  "title": "JpgSnapshot",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "JfifThumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "rgbData"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "rgbData": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "RGB data",
              "de": "RGB-Daten"
            },
            "description": {
              "en": "Uncompressed 24-bit RGB thumbnail pixels.",
              "de": "Unkomprimierte 24-Bit-RGB-Pixel des Vorschaubilds."
            }
          }
        }
      }
    },
    "JpgSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker",
        "data"
      ],
      "properties": {
        "marker": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Marker",
              "de": "Marker"
            },
            "description": {
              "en": "Marker code following the 0xFF prefix.",
              "de": "Markercode nach dem Präfix 0xFF."
            }
          },
          "minimum": 0,
          "maximum": 255
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "JpgImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "pixels",
        "jfifVersion",
        "jfifDensityUnits",
        "jfifXDensity",
        "jfifYDensity",
        "otherSegments"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "x-semio-state": "artifact",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "x-semio-state": "artifact",
          "minimum": 0,
          "maximum": 4294967295
        },
        "pixels": {
          "type": "array",
          "x-semio-state": "artifact",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "jfifVersion": {
          "type": "array",
          "x-semio-state": "artifact",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 2,
          "maxItems": 2,
          "x-semio-ui": {
            "widget": "vector",
            "label": {
              "en": "JFIF version",
              "de": "JFIF-Version"
            },
            "description": {
              "en": "Major and minor version of the APP0 JFIF segment.",
              "de": "Haupt- und Nebenversion des APP0-JFIF-Segments."
            }
          }
        },
        "jfifDensityUnits": {
          "type": "string",
          "enum": [
            "aspect",
            "pixelsPerInch",
            "pixelsPerCm"
          ],
          "x-semio-state": "artifact",
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Density unit",
              "de": "Dichteeinheit"
            },
            "options": {
              "aspect": {
                "en": "Aspect ratio only",
                "de": "Nur Seitenverhältnis"
              },
              "pixelsPerInch": {
                "en": "Pixels per inch",
                "de": "Pixel pro Zoll"
              },
              "pixelsPerCm": {
                "en": "Pixels per centimeter",
                "de": "Pixel pro Zentimeter"
              }
            }
          }
        },
        "jfifXDensity": {
          "type": "integer",
          "x-semio-state": "artifact",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Horizontal pixel density",
              "de": "Horizontale Pixeldichte"
            }
          },
          "minimum": 0,
          "maximum": 65535
        },
        "jfifYDensity": {
          "type": "integer",
          "x-semio-state": "artifact",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Vertical pixel density",
              "de": "Vertikale Pixeldichte"
            }
          },
          "minimum": 0,
          "maximum": 65535
        },
        "jfifThumbnail": {
          "$ref": "#/$defs/JfifThumbnail",
          "x-semio-state": "artifact",
          "x-semio-ui": {
            "label": {
              "en": "JFIF thumbnail",
              "de": "JFIF-Vorschaubild"
            }
          }
        },
        "otherSegments": {
          "type": "array",
          "x-semio-state": "artifact",
          "items": {
            "$ref": "#/$defs/JpgSegment"
          },
          "x-semio-ui": {
            "label": {
              "en": "Other segments",
              "de": "Weitere Segmente"
            },
            "description": {
              "en": "Marker segments without a dedicated field, kept verbatim.",
              "de": "Markersegmente ohne eigenes Feld, unverändert erhalten."
            }
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "image": {
      "$ref": "#/$defs/JpgImage"
    }
  },
  "required": [
    "schema",
    "image"
  ]
}
