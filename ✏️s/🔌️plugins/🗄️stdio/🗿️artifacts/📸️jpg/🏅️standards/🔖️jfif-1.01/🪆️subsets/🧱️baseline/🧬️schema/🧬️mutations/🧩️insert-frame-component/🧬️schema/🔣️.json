{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/baseline/mutation/insert-frame-component/schema.json",
  "title": "InsertFrameComponent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "component"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "component": {
      "$ref": "#/$defs/JpgFrameComponent",
      "x-semio-ui": {
        "label": {
          "en": "Frame component",
          "de": "Frame-Komponente"
        }
      }
    }
  },
  "$defs": {
    "JpgFrameComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hSampling",
        "vSampling",
        "quantTableId"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "hSampling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Horizontal sampling factor",
              "de": "Horizontaler Abtastfaktor"
            }
          }
        },
        "vSampling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Vertical sampling factor",
              "de": "Vertikaler Abtastfaktor"
            }
          }
        },
        "quantTableId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Quantization table",
              "de": "Quantisierungstabelle"
            },
            "description": {
              "en": "Tq: destination of the quantization table this component uses.",
              "de": "Tq: Ziel der Quantisierungstabelle, die diese Komponente verwendet."
            }
          }
        }
      }
    }
  }
}
