{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/jpg/jfif-1.01/baseline/mutation/insert-frame-component.json",
  "title": "InsertFrameComponent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "component"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "component": {
      "$ref": "#/$defs/JpgFrameComponent"
    }
  },
  "$defs": {
    "JpgFrameComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hSampling",
        "vSampling",
        "quantTableId"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "hSampling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "vSampling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "quantTableId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
