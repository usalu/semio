{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["width", "height", "pixels", "jfifThumbnail"],
  "properties": {
    "width": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "height": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "pixels": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "jfifThumbnail": {
      "type": "object", "additionalProperties": false, "required": ["width", "height", "rgbData"],
      "properties": {
        "width": {"type": "integer", "minimum": 0, "maximum": 255},
        "height": {"type": "integer", "minimum": 0, "maximum": 255},
        "rgbData": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}}
      }
    }
  }
}
