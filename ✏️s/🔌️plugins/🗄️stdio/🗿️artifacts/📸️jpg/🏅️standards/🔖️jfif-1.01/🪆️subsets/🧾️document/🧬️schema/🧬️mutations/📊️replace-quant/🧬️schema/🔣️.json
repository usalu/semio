{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/document/mutation/replace-quant-table/schema.json",
  "title": "ReplaceQuantTableMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table"
  ],
  "properties": {
    "table": {
      "$ref": "#/$defs/JpgQuantTable",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Quantization table",
          "de": "Quantisierungstabelle"
        },
        "description": {
          "en": "Destination id, precision and the 64 quantization values in zig-zag order.",
          "de": "Zielkennung, Genauigkeit und die 64 Quantisierungswerte in Zickzack-Reihenfolge."
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "JpgQuantTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "precision",
        "values"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Table precision",
              "de": "Tabellengenauigkeit"
            },
            "description": {
              "en": "Pq: 0 = 8-bit, 1 = 16-bit quantization values.",
              "de": "Pq: 0 = 8-Bit-, 1 = 16-Bit-Quantisierungswerte."
            }
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "minItems": 64,
          "maxItems": 64
        }
      }
    }
  }
}
