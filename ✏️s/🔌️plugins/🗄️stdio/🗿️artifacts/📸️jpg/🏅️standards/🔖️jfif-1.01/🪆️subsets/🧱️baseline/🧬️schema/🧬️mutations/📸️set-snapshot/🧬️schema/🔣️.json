{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/jpg/jfif-1.01/baseline/mutation/set-snapshot/schema.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot"
  ],
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/JpgSnapshot"
    }
  },
  "$defs": {
    "JpgSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Snapshot schema",
              "de": "Snapshot-Schema"
            },
            "description": {
              "en": "Identifier of the snapshot schema version.",
              "de": "Kennung der Version des Snapshot-Schemas."
            }
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "pixels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "reEncodeQuality": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Re-encode quality",
              "de": "Qualität der Neukodierung"
            },
            "description": {
              "en": "JPEG quality used when pixels are re-encoded.",
              "de": "JPEG-Qualität beim Neukodieren der Pixel."
            }
          }
        },
        "jfifVersion": {
          "type": "array",
          "items": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2,
          "x-semio-ui": {
            "label": {
              "en": "JFIF version",
              "de": "JFIF-Version"
            },
            "description": {
              "en": "Major and minor version of the APP0 JFIF segment.",
              "de": "Haupt- und Nebenversion des APP0-JFIF-Segments."
            }
          }
        },
        "jfifDensityUnits": {
          "$ref": "#/$defs/JfifDensityUnits",
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Density unit",
              "de": "Dichteeinheit"
            },
            "options": {
              "aspect": {
                "en": "Aspect ratio only",
                "de": "Nur Seitenverhältnis"
              },
              "pixelsPerInch": {
                "en": "Pixels per inch",
                "de": "Pixel pro Zoll"
              },
              "pixelsPerCm": {
                "en": "Pixels per centimeter",
                "de": "Pixel pro Zentimeter"
              }
            }
          }
        },
        "jfifXDensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Horizontal pixel density",
              "de": "Horizontale Pixeldichte"
            }
          }
        },
        "jfifYDensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Vertical pixel density",
              "de": "Vertikale Pixeldichte"
            }
          }
        },
        "jfifThumbnail": {
          "anyOf": [
            {
              "$ref": "#/$defs/JfifThumbnail"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "JFIF thumbnail",
              "de": "JFIF-Vorschaubild"
            }
          }
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/JpgFrameHeader"
            },
            {
              "type": "null"
            }
          ]
        },
        "sofMarker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Start-of-frame marker",
              "de": "SOF-Marker"
            },
            "description": {
              "en": "SOFn marker code that selects the coding process, e.g. 0xC0 baseline.",
              "de": "SOFn-Markercode, der das Kodierverfahren wählt, z. B. 0xC0 Baseline."
            }
          }
        },
        "arithmetic": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Arithmetic coding",
              "de": "Arithmetische Kodierung"
            },
            "description": {
              "en": "Uses arithmetic instead of Huffman entropy coding.",
              "de": "Verwendet arithmetische statt Huffman-Entropiekodierung."
            }
          }
        },
        "quantTables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JpgQuantTable"
          },
          "x-semio-ui": {
            "label": {
              "en": "Quantization tables",
              "de": "Quantisierungstabellen"
            }
          }
        },
        "huffmanTables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JpgHuffmanTable"
          },
          "x-semio-ui": {
            "label": {
              "en": "Huffman tables",
              "de": "Huffman-Tabellen"
            }
          }
        },
        "restartInterval": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Restart interval",
              "de": "Restart-Intervall"
            },
            "description": {
              "en": "MCUs between restart markers (DRI); 0 disables restarts.",
              "de": "MCUs zwischen Restart-Markern (DRI); 0 deaktiviert sie."
            }
          }
        },
        "otherSegments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JpgSegment"
          },
          "x-semio-ui": {
            "label": {
              "en": "Other segments",
              "de": "Weitere Segmente"
            },
            "description": {
              "en": "Marker segments without a dedicated field, kept verbatim.",
              "de": "Markersegmente ohne eigenes Feld, unverändert erhalten."
            }
          }
        }
      }
    },
    "JfifDensityUnits": {
      "type": "string",
      "enum": [
        "aspect",
        "pixelsPerInch",
        "pixelsPerCm"
      ]
    },
    "JfifThumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "rgbData": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "RGB data",
              "de": "RGB-Daten"
            },
            "description": {
              "en": "Uncompressed 24-bit RGB thumbnail pixels.",
              "de": "Unkomprimierte 24-Bit-RGB-Pixel des Vorschaubilds."
            }
          }
        }
      }
    },
    "JpgFrameHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision",
        "width",
        "height",
        "components"
      ],
      "properties": {
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Sample precision",
              "de": "Abtastgenauigkeit"
            },
            "unit": "bit"
          }
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JpgFrameComponent"
          },
          "x-semio-ui": {
            "label": {
              "en": "Frame components",
              "de": "Frame-Komponenten"
            }
          }
        }
      }
    },
    "JpgFrameComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hSampling",
        "vSampling",
        "quantTableId"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "hSampling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Horizontal sampling factor",
              "de": "Horizontaler Abtastfaktor"
            }
          }
        },
        "vSampling": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Vertical sampling factor",
              "de": "Vertikaler Abtastfaktor"
            }
          }
        },
        "quantTableId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Quantization table",
              "de": "Quantisierungstabelle"
            },
            "description": {
              "en": "Tq: destination of the quantization table this component uses.",
              "de": "Tq: Ziel der Quantisierungstabelle, die diese Komponente verwendet."
            }
          }
        }
      }
    },
    "JpgQuantTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "precision",
        "values"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Table precision",
              "de": "Tabellengenauigkeit"
            },
            "description": {
              "en": "Pq: 0 = 8-bit, 1 = 16-bit quantization values.",
              "de": "Pq: 0 = 8-Bit-, 1 = 16-Bit-Quantisierungswerte."
            }
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "minItems": 64,
          "maxItems": 64
        }
      }
    },
    "JpgHuffmanTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "bits"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "class": {
          "$ref": "#/$defs/JpgHuffmanClass",
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Table class",
              "de": "Tabellenklasse"
            },
            "options": {
              "dc": {
                "en": "DC coefficients",
                "de": "DC-Koeffizienten"
              },
              "ac": {
                "en": "AC coefficients",
                "de": "AC-Koeffizienten"
              }
            }
          }
        },
        "bits": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 16,
          "maxItems": 16,
          "x-semio-ui": {
            "label": {
              "en": "Codes per length",
              "de": "Codes je Länge"
            },
            "description": {
              "en": "BITS: number of Huffman codes of each length 1 to 16.",
              "de": "BITS: Anzahl der Huffman-Codes je Länge 1 bis 16."
            }
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "JpgHuffmanClass": {
      "type": "string",
      "enum": [
        "dc",
        "ac"
      ]
    },
    "JpgSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker"
      ],
      "properties": {
        "marker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Marker",
              "de": "Marker"
            },
            "description": {
              "en": "Marker code following the 0xFF prefix.",
              "de": "Markercode nach dem Präfix 0xFF."
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
