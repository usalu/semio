{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/jpg/jfif-1.01/document/mutation/replace-quant-table/schema.json",
  "title": "ReplaceQuantTableMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table"
  ],
  "properties": {
    "table": {
      "$ref": "#/$defs/JpgQuantTable"
    }
  },
  "$defs": {
    "JpgQuantTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "precision",
        "values"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "minItems": 64,
          "maxItems": 64
        }
      }
    }
  }
}
