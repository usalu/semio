{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/txt/utf-8/any/diff.json",
  "title": "TxtDiff",
  "type": "object",
  "definitions": {
    "TxtLineAdded": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "text"
      ]
    },
    "TxtLineModified": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "text"
      ]
    },
    "TxtLinesDiff": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TxtLineModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TxtLineAdded"
          }
        }
      }
    }
  },
  "properties": {
    "trailingNewline": {
      "type": "boolean"
    },
    "lineEnding": {
      "type": "string",
      "enum": [
        "lf",
        "crLf"
      ]
    },
    "lines": {
      "$ref": "#/definitions/TxtLinesDiff"
    }
  }
}
