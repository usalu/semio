grammar Stdio_txt_diff;
document : trailingNewline? lineEnding? lines? EOF;
trailingNewline : 'trailing-newline' '=' ('true' | 'false');
lineEnding : 'line-ending' '=' ('lf' | 'cr-lf');
lines : 'lines' '=' linesDiff;
linesDiff : 'removed' '=' '[' INT* ']' 'modified' '=' '[' lineEntry* ']' 'added' '=' '[' lineEntry* ']';
lineEntry : '{' 'index' '=' INT 'text' '=' textValue '}';
textValue : IDENT | TEXT | 'trailing-newline' | 'line-ending' | 'lines' | 'removed' | 'modified' | 'added' | 'index' | 'text' | 'lf' | 'cr-lf';
INT : [0-9]+;
TEXT : '"' (~["\\\r\n] | '\\' .)* '"';
IDENT : ~[ \t\r\n\u005B\u005D{}=,"]+;
WS : [ \t\r\n]+ -> skip;
