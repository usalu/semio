(* 📖️ The authored semio diff grammar and real inline record printer. *)
diff = [ trailing-newline ], [ line-ending ], [ lines ];
trailing-newline = "trailing-newline", "=", ( "true" | "false" );
line-ending = "line-ending", "=", ( "lf" | "cr-lf" );
lines = "lines", "=", lines-diff;
lines-diff = "removed", "=", "[", { integer }, "]",
             "modified", "=", "[", { line-entry }, "]",
             "added", "=", "[", { line-entry }, "]";
line-entry = "{", "index", "=", integer, "text", "=", text-value, "}";
text-value = identifier | quoted-text;
integer = digit, { digit };
