{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/txt/utf-8/any/net-mutation/schema.json",
  "title": "TextNetMutation",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "set-line",
            "insert-line"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "const": "remove-line"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  ]
}
