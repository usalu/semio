{
  "schema": "semio.stdio.txt.net-leaves.v1",
  "note": "One explicit Apply of the plain-text window is ONE edit of these net line leaves, in application order (design §13.2 of ticket 26/09/30/NON-DESTRUCTIVE-HISTORY-EDITING); `null` is the whole-buffer lowering of an Apply that changes the line ending or the terminator.",
  "cases": [
    {
      "id": "unchanged",
      "before": "alpha\nbeta\ngamma\n",
      "after": "alpha\nbeta\ngamma\n",
      "leaves": []
    },
    {
      "id": "edits-a-line",
      "before": "alpha\nbeta\ngamma\n",
      "after": "alpha\nBETA\ngamma\n",
      "leaves": [
        {
          "kind": "set-line",
          "index": 1,
          "text": "BETA"
        }
      ]
    },
    {
      "id": "inserts-a-line",
      "before": "alpha\nbeta\ngamma\n",
      "after": "alpha\nbeta\ndelta\ngamma\n",
      "leaves": [
        {
          "kind": "insert-line",
          "index": 2,
          "text": "delta"
        }
      ]
    },
    {
      "id": "removes-a-line",
      "before": "alpha\nbeta\ngamma\n",
      "after": "alpha\ngamma\n",
      "leaves": [
        {
          "kind": "remove-line",
          "index": 1
        }
      ]
    },
    {
      "id": "edits-two-adjacent-lines",
      "before": "a\nb\nc\nd\n",
      "after": "a\nB\nC\nd\n",
      "leaves": [
        {
          "kind": "set-line",
          "index": 1,
          "text": "B"
        },
        {
          "kind": "set-line",
          "index": 2,
          "text": "C"
        }
      ]
    },
    {
      "id": "edits-around-a-kept-line",
      "before": "a\nb\nc\nd\n",
      "after": "a\nX\nc\nY\n",
      "leaves": [
        {
          "kind": "set-line",
          "index": 1,
          "text": "X"
        },
        {
          "kind": "set-line",
          "index": 3,
          "text": "Y"
        }
      ]
    },
    {
      "id": "grows-a-span",
      "before": "a\nb\nc\n",
      "after": "a\nx\ny\nz\nc\n",
      "leaves": [
        {
          "kind": "set-line",
          "index": 1,
          "text": "x"
        },
        {
          "kind": "insert-line",
          "index": 2,
          "text": "y"
        },
        {
          "kind": "insert-line",
          "index": 3,
          "text": "z"
        }
      ]
    },
    {
      "id": "shrinks-a-span",
      "before": "a\nb\nc\nd\ne\n",
      "after": "a\nX\ne\n",
      "leaves": [
        {
          "kind": "set-line",
          "index": 1,
          "text": "X"
        },
        {
          "kind": "remove-line",
          "index": 3
        },
        {
          "kind": "remove-line",
          "index": 2
        }
      ]
    },
    {
      "id": "appends-a-line",
      "before": "a\n",
      "after": "a\nb\n",
      "leaves": [
        {
          "kind": "insert-line",
          "index": 1,
          "text": "b"
        }
      ]
    },
    {
      "id": "drops-a-repeated-line",
      "before": "x\nx\nx\n",
      "after": "x\nx\n",
      "leaves": [
        {
          "kind": "remove-line",
          "index": 2
        }
      ]
    },
    {
      "id": "edits-a-crlf-line",
      "before": "a\r\nb\r\n",
      "after": "a\r\nB\r\n",
      "leaves": [
        {
          "kind": "set-line",
          "index": 1,
          "text": "B"
        }
      ]
    },
    {
      "id": "edits-an-unterminated-last-line",
      "before": "a\nb",
      "after": "a\nc",
      "leaves": [
        {
          "kind": "set-line",
          "index": 1,
          "text": "c"
        }
      ]
    },
    {
      "id": "switches-the-line-ending",
      "before": "a\nb\n",
      "after": "a\r\nb\r\n",
      "leaves": null
    },
    {
      "id": "drops-the-terminator",
      "before": "a\nb\n",
      "after": "a\nb",
      "leaves": null
    },
    {
      "id": "empties-the-document",
      "before": "a\n",
      "after": "",
      "leaves": null
    }
  ]
}
