{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/txt/utf-8/any/inference.json",
  "title": "TxtInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outline"
  ],
  "properties": {
    "outline": {
      "$ref": "#/$defs/TxtOutline",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "TxtOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineCount",
        "wordCount",
        "charCount"
      ],
      "properties": {
        "lineCount": {
          "type": "integer"
        },
        "wordCount": {
          "type": "integer"
        },
        "charCount": {
          "type": "integer"
        }
      }
    }
  }
}
