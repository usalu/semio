(* PngDiff's wire text IS its JSON serialization (serde camelCase, sparse fields), per
   🦀️component.rs; this documents the real top-level shape, not RFC 8259's own JSON grammar. *)
diff = "{", [ member, { ",", member } ], "}" ;
member = '"width"', ":", integer
       | '"height"', ":", integer
       | '"bitDepth"', ":", integer
       | '"colorType"', ":", string
       | '"interlace"', ":", bool
       | '"plte"', ":", ( "null" | plte diff )
       | '"trns"', ":", ( "null" | json value )
       | '"gama"', ":", ( "null" | integer )
       | '"chrm"', ":", ( "null" | json value )
       | '"srgb"', ":", ( "null" | string )
       | '"phys"', ":", ( "null" | json value )
       | '"time"', ":", ( "null" | json value )
       | '"bkgd"', ":", ( "null" | json value )
       | '"textChunks"', ":", triple
       | '"pixels"', ":", "[", { integer }, "]"
       | '"chunkOrder"', ":", triple
       | '"unknownChunks"', ":", triple ;
plte diff = "{", [ '"removed"', ":", "[", { integer }, "]"
                  , [ ",", '"modified"', ":", "[", { json value }, "]" ]
                  , [ ",", '"added"', ":", "[", { json value }, "]" ] ], "}" ;
triple = "{", [ '"removed"', ":", "[", { integer }, "]"
              , [ ",", '"modified"', ":", "[", { json value }, "]" ]
              , [ ",", '"added"', ":", "[", { json value }, "]" ] ], "}" ;
bool = "true" | "false" ;
