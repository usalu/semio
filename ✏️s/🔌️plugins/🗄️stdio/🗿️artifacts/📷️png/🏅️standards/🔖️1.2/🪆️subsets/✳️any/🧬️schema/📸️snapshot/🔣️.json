{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/snapshot.json",
  "title": "PngSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "width",
    "height",
    "bitDepth",
    "colorType",
    "interlace",
    "textChunks",
    "pixels",
    "chunkOrder",
    "unknownChunks"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Snapshot schema",
          "de": "Snapshot-Schema"
        },
        "description": {
          "en": "Identifier of the snapshot schema version.",
          "de": "Kennung der Version des Snapshot-Schemas."
        }
      }
    },
    "width": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact"
    },
    "bitDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Bit depth",
          "de": "Bittiefe"
        },
        "description": {
          "en": "Bits per sample or palette index (1, 2, 4, 8 or 16).",
          "de": "Bits je Abtastwert oder Palettenindex (1, 2, 4, 8 oder 16)."
        },
        "unit": "bit"
      }
    },
    "colorType": {
      "$ref": "#/$defs/PngColorType",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "select",
        "label": {
          "en": "Color type",
          "de": "Farbtyp"
        },
        "options": {
          "grayscale": {
            "en": "Grayscale",
            "de": "Graustufen"
          },
          "rgb": {
            "en": "RGB",
            "de": "RGB"
          },
          "palette": {
            "en": "Palette",
            "de": "Palette"
          },
          "grayscaleAlpha": {
            "en": "Grayscale with alpha",
            "de": "Graustufen mit Alpha"
          },
          "rgba": {
            "en": "RGB with alpha",
            "de": "RGB mit Alpha"
          }
        }
      }
    },
    "interlace": {
      "type": "boolean",
      "x-semio-state": "artifact"
    },
    "plte": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PngRgb"
      },
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Palette (PLTE)",
          "de": "Palette (PLTE)"
        }
      }
    },
    "trns": {
      "$ref": "#/$defs/PngTransparency",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Transparency (tRNS)",
          "de": "Transparenz (tRNS)"
        }
      }
    },
    "gama": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Gamma (gAMA)",
          "de": "Gamma (gAMA)"
        },
        "description": {
          "en": "Image gamma times 100000.",
          "de": "Bildgamma mal 100000."
        },
        "displayFactor": 1e-05,
        "precision": 5
      }
    },
    "chrm": {
      "$ref": "#/$defs/PngChromaticities",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Chromaticities (cHRM)",
          "de": "Chromatizität (cHRM)"
        },
        "description": {
          "en": "CIE 1931 x,y of the primaries and white point, times 100000.",
          "de": "CIE-1931-x,y der Primärfarben und des Weißpunkts, mal 100000."
        }
      }
    },
    "srgb": {
      "$ref": "#/$defs/PngSrgbIntent",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "widget": "select",
        "label": {
          "en": "Rendering intent (sRGB)",
          "de": "Rendering Intent (sRGB)"
        },
        "options": {
          "perceptual": {
            "en": "Perceptual",
            "de": "Wahrnehmungsorientiert"
          },
          "relativeColorimetric": {
            "en": "Relative colorimetric",
            "de": "Relativ farbmetrisch"
          },
          "saturation": {
            "en": "Saturation",
            "de": "Sättigung"
          },
          "absoluteColorimetric": {
            "en": "Absolute colorimetric",
            "de": "Absolut farbmetrisch"
          }
        }
      }
    },
    "phys": {
      "$ref": "#/$defs/PngPhysicalDims",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Physical pixel dimensions (pHYs)",
          "de": "Physikalische Pixelmaße (pHYs)"
        }
      }
    },
    "time": {
      "$ref": "#/$defs/PngTimestamp",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Last modification (tIME)",
          "de": "Letzte Änderung (tIME)"
        }
      }
    },
    "bkgd": {
      "$ref": "#/$defs/PngBackground",
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Background color (bKGD)",
          "de": "Hintergrundfarbe (bKGD)"
        }
      }
    },
    "textChunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PngTextChunk"
      },
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Text chunks",
          "de": "Text-Chunks"
        }
      }
    },
    "pixels": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "x-semio-state": "artifact"
    },
    "chunkOrder": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PngChunkMarker"
      },
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Chunk order",
          "de": "Chunk-Reihenfolge"
        }
      }
    },
    "unknownChunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PngChunk"
      },
      "x-semio-state": "artifact",
      "x-semio-ui": {
        "label": {
          "en": "Unknown chunks",
          "de": "Unbekannte Chunks"
        },
        "description": {
          "en": "Ancillary chunks without a dedicated field, kept verbatim.",
          "de": "Zusatz-Chunks ohne eigenes Feld, unverändert erhalten."
        }
      }
    }
  },
  "$defs": {
    "PngColorType": {
      "type": "string",
      "enum": [
        "grayscale",
        "rgb",
        "palette",
        "grayscaleAlpha",
        "rgba"
      ]
    },
    "PngRgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        }
      }
    },
    "PngTransparency": {
      "type": "object",
      "required": [
        "colorType"
      ],
      "properties": {
        "colorType": {
          "type": "string",
          "enum": [
            "indexed",
            "grayscale",
            "rgb"
          ],
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Color type",
              "de": "Farbtyp"
            },
            "options": {
              "indexed": {
                "en": "Indexed color",
                "de": "Indizierte Farben"
              },
              "grayscale": {
                "en": "Grayscale",
                "de": "Graustufen"
              },
              "rgb": {
                "en": "RGB",
                "de": "RGB"
              }
            }
          }
        },
        "alpha": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x-semio-ui": {
            "label": {
              "en": "Palette alpha",
              "de": "Paletten-Alpha"
            },
            "description": {
              "en": "Alpha value per palette entry.",
              "de": "Alphawert je Paletteneintrag."
            }
          }
        },
        "gray": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Gray level",
              "de": "Graustufe"
            }
          }
        },
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        }
      }
    },
    "PngChromaticities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whiteX",
        "whiteY",
        "redX",
        "redY",
        "greenX",
        "greenY",
        "blueX",
        "blueY"
      ],
      "properties": {
        "whiteX": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "White point x",
              "de": "Weißpunkt x"
            },
            "displayFactor": 1e-05,
            "precision": 5
          }
        },
        "whiteY": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "White point y",
              "de": "Weißpunkt y"
            },
            "displayFactor": 1e-05,
            "precision": 5
          }
        },
        "redX": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Red x",
              "de": "Rot x"
            },
            "displayFactor": 1e-05,
            "precision": 5
          }
        },
        "redY": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Red y",
              "de": "Rot y"
            },
            "displayFactor": 1e-05,
            "precision": 5
          }
        },
        "greenX": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Green x",
              "de": "Grün x"
            },
            "displayFactor": 1e-05,
            "precision": 5
          }
        },
        "greenY": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Green y",
              "de": "Grün y"
            },
            "displayFactor": 1e-05,
            "precision": 5
          }
        },
        "blueX": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Blue x",
              "de": "Blau x"
            },
            "displayFactor": 1e-05,
            "precision": 5
          }
        },
        "blueY": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Blue y",
              "de": "Blau y"
            },
            "displayFactor": 1e-05,
            "precision": 5
          }
        }
      }
    },
    "PngSrgbIntent": {
      "type": "string",
      "enum": [
        "perceptual",
        "relativeColorimetric",
        "saturation",
        "absoluteColorimetric"
      ]
    },
    "PngPhysicalDims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ppuX",
        "ppuY",
        "unitIsMeter"
      ],
      "properties": {
        "ppuX": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Pixels per unit, X",
              "de": "Pixel pro Einheit, X"
            }
          }
        },
        "ppuY": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Pixels per unit, Y",
              "de": "Pixel pro Einheit, Y"
            }
          }
        },
        "unitIsMeter": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Unit is meter",
              "de": "Einheit ist Meter"
            },
            "description": {
              "en": "On: pixels per meter; off: aspect ratio only.",
              "de": "An: Pixel pro Meter; aus: nur Seitenverhältnis."
            }
          }
        }
      }
    },
    "PngTimestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "second"
      ],
      "properties": {
        "year": {
          "type": "integer"
        },
        "month": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Month",
              "de": "Monat"
            }
          }
        },
        "day": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Day",
              "de": "Tag"
            }
          }
        },
        "hour": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Hour",
              "de": "Stunde"
            }
          }
        },
        "minute": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Minute",
              "de": "Minute"
            }
          }
        },
        "second": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Second",
              "de": "Sekunde"
            }
          }
        }
      }
    },
    "PngBackground": {
      "type": "object",
      "required": [
        "colorType"
      ],
      "properties": {
        "colorType": {
          "type": "string",
          "enum": [
            "grayscale",
            "rgb",
            "indexed"
          ],
          "x-semio-ui": {
            "widget": "segmented",
            "label": {
              "en": "Color type",
              "de": "Farbtyp"
            },
            "options": {
              "grayscale": {
                "en": "Grayscale",
                "de": "Graustufen"
              },
              "rgb": {
                "en": "RGB",
                "de": "RGB"
              },
              "indexed": {
                "en": "Indexed color",
                "de": "Indizierte Farben"
              }
            }
          }
        },
        "gray": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Gray level",
              "de": "Graustufe"
            }
          }
        },
        "r": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "integer",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        },
        "index": {
          "type": "integer"
        }
      }
    },
    "PngTextKind": {
      "type": "string",
      "enum": [
        "text",
        "zText",
        "iText"
      ]
    },
    "PngTextChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyword",
        "value",
        "compressed",
        "kind",
        "languageTag",
        "translatedKeyword"
      ],
      "properties": {
        "keyword": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Keyword",
              "de": "Schlüsselwort"
            }
          }
        },
        "value": {
          "type": "string"
        },
        "compressed": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Compressed",
              "de": "Komprimiert"
            }
          }
        },
        "kind": {
          "$ref": "#/$defs/PngTextKind",
          "x-semio-ui": {
            "options": {
              "zText": {
                "en": "Compressed text (zTXt)",
                "de": "Komprimierter Text (zTXt)"
              },
              "iText": {
                "en": "International text (iTXt)",
                "de": "Internationaler Text (iTXt)"
              }
            }
          }
        },
        "languageTag": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Language tag",
              "de": "Sprachkennung"
            }
          }
        },
        "translatedKeyword": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Translated keyword",
              "de": "Übersetztes Schlüsselwort"
            }
          }
        }
      }
    },
    "PngChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "PngChunkMarker": {
      "type": "object",
      "required": [
        "chunk"
      ],
      "properties": {
        "chunk": {
          "type": "string",
          "enum": [
            "ihdr",
            "plte",
            "trns",
            "gama",
            "chrm",
            "srgb",
            "phys",
            "time",
            "bkgd",
            "idat",
            "iend",
            "text",
            "unknown"
          ],
          "x-semio-ui": {
            "options": {
              "ihdr": {
                "en": "IHDR (image header)",
                "de": "IHDR (Bildkopf)"
              },
              "plte": {
                "en": "PLTE (palette)",
                "de": "PLTE (Palette)"
              },
              "trns": {
                "en": "tRNS (transparency)",
                "de": "tRNS (Transparenz)"
              },
              "gama": {
                "en": "gAMA (gamma)",
                "de": "gAMA (Gamma)"
              },
              "chrm": {
                "en": "cHRM (chromaticities)",
                "de": "cHRM (Chromatizität)"
              },
              "srgb": {
                "en": "sRGB (rendering intent)",
                "de": "sRGB (Rendering Intent)"
              },
              "phys": {
                "en": "pHYs (physical dimensions)",
                "de": "pHYs (physikalische Maße)"
              },
              "time": {
                "en": "tIME (modification time)",
                "de": "tIME (Änderungszeit)"
              },
              "bkgd": {
                "en": "bKGD (background color)",
                "de": "bKGD (Hintergrundfarbe)"
              },
              "idat": {
                "en": "IDAT (image data)",
                "de": "IDAT (Bilddaten)"
              },
              "iend": {
                "en": "IEND (image end)",
                "de": "IEND (Bildende)"
              },
              "unknown": {
                "en": "Unknown chunk",
                "de": "Unbekannter Chunk"
              }
            }
          }
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
