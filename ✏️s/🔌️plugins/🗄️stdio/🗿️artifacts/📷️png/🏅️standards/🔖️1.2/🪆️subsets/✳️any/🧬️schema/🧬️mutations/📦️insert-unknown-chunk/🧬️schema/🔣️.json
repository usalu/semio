{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/png/1.2/any/mutation/insert-unknown-chunk/schema.json",
  "title": "InsertUnknownChunkMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "chunk"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "chunk": {
      "$ref": "#/$defs/PngChunk"
    }
  },
  "$defs": {
    "PngChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "data"
      ],
      "properties": {
        "kind": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 4,
          "maxItems": 4
        },
        "data": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
