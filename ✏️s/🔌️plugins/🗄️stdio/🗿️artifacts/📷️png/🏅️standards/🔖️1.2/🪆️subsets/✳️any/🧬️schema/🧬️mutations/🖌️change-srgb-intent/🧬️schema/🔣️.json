{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/png/1.2/any/mutation/change-srgb-intent/schema.json",
  "title": "ChangeSrgbIntentMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "srgb": {
      "anyOf": [
        {
          "$ref": "#/$defs/PngSrgbIntent"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "PngSrgbIntent": {
      "type": "string",
      "enum": [
        "perceptual",
        "relativeColorimetric",
        "saturation",
        "absoluteColorimetric"
      ]
    }
  }
}
