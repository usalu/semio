{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/mutation/change-srgb-intent/schema.json",
  "title": "ChangeSrgbIntentMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "srgb": {
      "anyOf": [
        {
          "$ref": "#/$defs/PngSrgbIntent"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "select",
        "label": {
          "en": "Rendering intent (sRGB)",
          "de": "Rendering Intent (sRGB)"
        },
        "options": {
          "perceptual": {
            "en": "Perceptual",
            "de": "Wahrnehmungsorientiert"
          },
          "relativeColorimetric": {
            "en": "Relative colorimetric",
            "de": "Relativ farbmetrisch"
          },
          "saturation": {
            "en": "Saturation",
            "de": "Sättigung"
          },
          "absoluteColorimetric": {
            "en": "Absolute colorimetric",
            "de": "Absolut farbmetrisch"
          }
        }
      }
    }
  },
  "$defs": {
    "PngSrgbIntent": {
      "type": "string",
      "enum": [
        "perceptual",
        "relativeColorimetric",
        "saturation",
        "absoluteColorimetric"
      ]
    }
  }
}
