{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/artifact.json",
  "title": "PngArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bytes"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "stdio.png",
      "x-semio-state": "artifact"
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "x-semio-state": "artifact"
    }
  }
}
