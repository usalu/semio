{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/png/1.2/any/mutation/replace-text-chunk/schema.json",
  "title": "ReplaceTextChunkMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "chunk"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "chunk": {
      "$ref": "#/$defs/PngTextChunk"
    }
  },
  "$defs": {
    "PngTextChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyword",
        "value"
      ],
      "properties": {
        "keyword": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "compressed": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/PngTextKind"
        },
        "languageTag": {
          "type": "string"
        },
        "translatedKeyword": {
          "type": "string"
        }
      }
    },
    "PngTextKind": {
      "type": "string",
      "enum": [
        "text",
        "zText",
        "iText"
      ]
    }
  }
}
