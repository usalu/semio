{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/mutation/replace-text-chunk/schema.json",
  "title": "ReplaceTextChunkMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "chunk"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "chunk": {
      "$ref": "#/$defs/PngTextChunk"
    }
  },
  "$defs": {
    "PngTextChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyword",
        "value"
      ],
      "properties": {
        "keyword": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Keyword",
              "de": "Schlüsselwort"
            }
          }
        },
        "value": {
          "type": "string"
        },
        "compressed": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Compressed",
              "de": "Komprimiert"
            }
          }
        },
        "kind": {
          "$ref": "#/$defs/PngTextKind",
          "x-semio-ui": {
            "options": {
              "zText": {
                "en": "Compressed text (zTXt)",
                "de": "Komprimierter Text (zTXt)"
              },
              "iText": {
                "en": "International text (iTXt)",
                "de": "Internationaler Text (iTXt)"
              }
            }
          }
        },
        "languageTag": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Language tag",
              "de": "Sprachkennung"
            }
          }
        },
        "translatedKeyword": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "label": {
              "en": "Translated keyword",
              "de": "Übersetztes Schlüsselwort"
            }
          }
        }
      }
    },
    "PngTextKind": {
      "type": "string",
      "enum": [
        "text",
        "zText",
        "iText"
      ]
    }
  }
}
