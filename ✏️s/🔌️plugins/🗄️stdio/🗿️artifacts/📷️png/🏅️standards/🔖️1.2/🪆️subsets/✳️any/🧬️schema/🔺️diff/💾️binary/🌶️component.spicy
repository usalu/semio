module Stdio_png_diff;

# protocol::OpBinary raw JSON encoding of PngDiff — no `.semio` envelope header (contrast
# with ../../📸️snapshot/💾️binary/, whose payload IS wrapped). No length prefix: the whole
# op payload IS the UTF-8 JSON document (see sibling ../📝️text/📖️component.grammar.semio).
public type Document = unit {
    : bytes &eod -> self.json_utf8;
    var json_utf8: bytes;
};
