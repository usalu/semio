{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/png/1.2/any/mutation/change-header/schema.json",
  "title": "ChangeHeaderMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "height",
    "bitDepth",
    "colorType",
    "interlace"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "bitDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "colorType": {
      "$ref": "#/$defs/PngColorType"
    },
    "interlace": {
      "type": "boolean"
    }
  },
  "$defs": {
    "PngColorType": {
      "type": "string",
      "enum": [
        "grayscale",
        "rgb",
        "palette",
        "grayscaleAlpha",
        "rgba"
      ]
    }
  }
}
