{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/mutation/change-timestamp/schema.json",
  "title": "ChangeTimestampMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "time": {
      "anyOf": [
        {
          "$ref": "#/$defs/PngTimestamp"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Last modification (tIME)",
          "de": "Letzte Änderung (tIME)"
        }
      }
    }
  },
  "$defs": {
    "PngTimestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "second"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "month": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Month",
              "de": "Monat"
            }
          }
        },
        "day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Day",
              "de": "Tag"
            }
          }
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Hour",
              "de": "Stunde"
            }
          }
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Minute",
              "de": "Minute"
            }
          }
        },
        "second": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Second",
              "de": "Sekunde"
            }
          }
        }
      }
    }
  }
}
