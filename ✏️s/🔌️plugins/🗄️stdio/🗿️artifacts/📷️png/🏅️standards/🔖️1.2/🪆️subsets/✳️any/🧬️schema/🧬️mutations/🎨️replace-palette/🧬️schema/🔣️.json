{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/png/1.2/any/mutation/replace-palette/schema.json",
  "title": "ReplacePaletteMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plte": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PngRgb"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "PngRgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
