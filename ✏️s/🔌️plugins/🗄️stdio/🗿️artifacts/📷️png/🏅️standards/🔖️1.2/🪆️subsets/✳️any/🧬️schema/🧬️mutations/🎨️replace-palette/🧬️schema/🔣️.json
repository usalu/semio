{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/mutation/replace-palette/schema.json",
  "title": "ReplacePaletteMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plte": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PngRgb"
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Palette (PLTE)",
          "de": "Palette (PLTE)"
        }
      }
    }
  },
  "$defs": {
    "PngRgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Red",
              "de": "Rot"
            }
          }
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Green",
              "de": "Grün"
            }
          }
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Blue",
              "de": "Blau"
            }
          }
        }
      }
    }
  }
}
