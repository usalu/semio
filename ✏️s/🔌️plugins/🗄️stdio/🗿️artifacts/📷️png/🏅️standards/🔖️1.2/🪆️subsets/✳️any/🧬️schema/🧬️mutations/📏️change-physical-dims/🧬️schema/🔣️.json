{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/mutation/change-physical-dims/schema.json",
  "title": "ChangePhysicalDimsMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "phys": {
      "anyOf": [
        {
          "$ref": "#/$defs/PngPhysicalDims"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Physical pixel dimensions (pHYs)",
          "de": "Physikalische Pixelmaße (pHYs)"
        }
      }
    }
  },
  "$defs": {
    "PngPhysicalDims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ppuX",
        "ppuY",
        "unitIsMeter"
      ],
      "properties": {
        "ppuX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Pixels per unit, X",
              "de": "Pixel pro Einheit, X"
            }
          }
        },
        "ppuY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Pixels per unit, Y",
              "de": "Pixel pro Einheit, Y"
            }
          }
        },
        "unitIsMeter": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "label": {
              "en": "Unit is meter",
              "de": "Einheit ist Meter"
            },
            "description": {
              "en": "On: pixels per meter; off: aspect ratio only.",
              "de": "An: Pixel pro Meter; aus: nur Seitenverhältnis."
            }
          }
        }
      }
    }
  }
}
