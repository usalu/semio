{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/png/1.2/any/mutation/change-physical-dims/schema.json",
  "title": "ChangePhysicalDimsMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "phys": {
      "anyOf": [
        {
          "$ref": "#/$defs/PngPhysicalDims"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "PngPhysicalDims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ppuX",
        "ppuY",
        "unitIsMeter"
      ],
      "properties": {
        "ppuX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "ppuY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "unitIsMeter": {
          "type": "boolean"
        }
      }
    }
  }
}
