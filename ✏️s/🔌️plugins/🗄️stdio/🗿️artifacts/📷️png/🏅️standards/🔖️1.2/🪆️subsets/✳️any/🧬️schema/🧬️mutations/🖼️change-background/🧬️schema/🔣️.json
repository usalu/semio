{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/png/1.2/any/mutation/change-background/schema.json",
  "title": "ChangeBackgroundMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bkgd": {
      "anyOf": [
        {
          "$ref": "#/$defs/PngBackground"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "PngBackground": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "colorType",
            "gray"
          ],
          "properties": {
            "colorType": {
              "const": "grayscale"
            },
            "gray": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "colorType",
            "r",
            "g",
            "b"
          ],
          "properties": {
            "colorType": {
              "const": "rgb"
            },
            "r": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "g": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "b": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "colorType",
            "index"
          ],
          "properties": {
            "colorType": {
              "const": "indexed"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      ]
    }
  }
}
