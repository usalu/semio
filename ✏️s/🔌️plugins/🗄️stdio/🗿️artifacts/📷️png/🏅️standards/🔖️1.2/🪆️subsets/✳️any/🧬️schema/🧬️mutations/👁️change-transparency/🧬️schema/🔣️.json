{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/png/1.2/any/mutation/change-transparency/schema.json",
  "title": "ChangeTransparencyMutation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "trns": {
      "anyOf": [
        {
          "$ref": "#/$defs/PngTransparency"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "PngTransparency": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "colorType",
            "alpha"
          ],
          "properties": {
            "colorType": {
              "const": "indexed"
            },
            "alpha": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "colorType",
            "gray"
          ],
          "properties": {
            "colorType": {
              "const": "grayscale"
            },
            "gray": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "colorType",
            "r",
            "g",
            "b"
          ],
          "properties": {
            "colorType": {
              "const": "rgb"
            },
            "r": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "g": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "b": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      ]
    }
  }
}
