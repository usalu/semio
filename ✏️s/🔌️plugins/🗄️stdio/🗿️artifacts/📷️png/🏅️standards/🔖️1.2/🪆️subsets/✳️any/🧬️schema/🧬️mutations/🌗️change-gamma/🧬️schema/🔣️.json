{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/mutation/change-gamma/schema.json",
  "title": "ChangeGammaMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision"
  ],
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "x-semio-ui": {
        "label": {"en": "Source revision", "de": "Quellrevision"},
        "group": "target",
        "order": 10
      }
    },
    "gama": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 4294967295,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "PNG gamma",
          "de": "PNG-Gamma"
        },
        "step": 1,
        "precision": 0,
        "snaps": [
          45455,
          55556,
          100000
        ],
        "group": "metadata",
        "order": 20
      }
    }
  }
}
