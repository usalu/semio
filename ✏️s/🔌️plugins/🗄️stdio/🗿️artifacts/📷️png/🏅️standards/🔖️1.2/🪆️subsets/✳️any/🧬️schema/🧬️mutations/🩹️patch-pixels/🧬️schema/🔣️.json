{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/mutation/patch-pixels/schema.json",
  "title": "PatchPixelsMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "x",
    "y",
    "width",
    "height",
    "red",
    "green",
    "blue",
    "alpha"
  ],
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "x-semio-ui": {"label": {"en": "Source revision", "de": "Quellrevision"}, "group": "target", "order": 10}
    },
    "x": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {"label": {"en": "Left", "de": "Links"}, "group": "region", "order": 20}
    },
    "y": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {"label": {"en": "Top", "de": "Oben"}, "group": "region", "order": 30}
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {"label": {"en": "Width", "de": "Breite"}, "group": "region", "order": 40}
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {"label": {"en": "Height", "de": "Höhe"}, "group": "region", "order": 50}
    },
    "red": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {"label": {"en": "Red", "de": "Rot"}, "group": "color", "order": 60}
    },
    "green": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {"label": {"en": "Green", "de": "Grün"}, "group": "color", "order": 70}
    },
    "blue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {"label": {"en": "Blue", "de": "Blau"}, "group": "color", "order": 80}
    },
    "alpha": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "x-semio-ui": {"label": {"en": "Alpha", "de": "Alpha"}, "group": "color", "order": 90}
    }
  }
}
