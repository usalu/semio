{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/png/1.2/any/mutation/patch-pixels/schema.json",
  "title": "PatchPixelsMutation",
  "type": "object",
  "additionalProperties": false,
  "required": ["index", "removeCount", "pixels"],
  "properties": {
    "index": { "type": "integer", "minimum": 0 },
    "removeCount": { "type": "integer", "minimum": 0 },
    "pixels": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "moveTo": { "type": ["integer", "null"], "minimum": 0 }
  }
}
