  "comparisonProfiles": [
    {
      "id": "semantic-svg-1-1-v1",
      "description": "SVG 1.1 mutation round trips compared structurally: element/text/CDATA/comment/PI tree shape and content exact, attributes compared as a name-sorted set (SVG attribute order is real writer freedom -- see this subset's own `write_svg_xml`, which never claims to preserve source attribute order beyond update-in-place), and the `viewBox`/`transform` attribute values specifically decomposed into typed numeric geometry (never compared as raw strings) with a small absolute tolerance for cross-implementation float-formatting noise between quick-xml's writer and this subset's own. Self-closing vs explicit empty open/close tags are equivalent by construction (both parse to zero children) and never distinguished by either side.",
      "tolerance": 1e-09,
      "ignoreKeys": []
    },
    {
      "id": "svg-1-1-quick-xml-reader-v1",
      "description": "SVG 1.1 mutation round trips compared structurally by the INDEPENDENT `quick-xml-svg-1-1-mutate-reader` oracle: element/text/CDATA/comment/PI tree shape and content exact, children order-significant (document order is this format's own semantic identity for a node), attributes compared as a name-sorted set of raw `[name, value]` string pairs. UNLIKE `semantic-svg-1-1-v1` above, `viewBox` and `transform` are NOT decomposed into typed numeric geometry — `quick-xml` has no SVG geometry grammar, so both project as plain attribute strings, same as every other attribute. A `viewBox`/`transform` value that changed is still caught (the string differs), just not at the semantic level. No numeric tolerance: this profile never parses a number, so there is nothing for a float tolerance to apply to.",
      "arrays": "ordered",
      "ignoreKeys": [],
      "pipeline": "svg-1-1-quick-xml-compare-v1"
    }
  ],
