{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/basic/mutation/set-clip-path-reference/schema.json",
  "title": "SetClipPathReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Element path",
          "de": "Elementpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the element, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Element, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "clipPathId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Clipping path",
          "de": "Beschneidungspfad"
        },
        "description": {
          "en": "The `clipPath` element referenced by id.",
          "de": "Das per ID referenzierte Element `clipPath`."
        },
        "ref": {
          "kind": "clipPath"
        }
      }
    }
  }
}
