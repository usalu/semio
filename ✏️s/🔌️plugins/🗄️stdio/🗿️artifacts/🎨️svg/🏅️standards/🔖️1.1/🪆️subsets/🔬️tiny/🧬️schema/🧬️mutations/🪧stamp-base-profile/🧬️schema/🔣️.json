{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/tiny/mutation/stamp-base-profile/schema.json",
  "title": "StampBaseProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "baseProfile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Base profile",
          "de": "Basisprofil"
        },
        "description": {
          "en": "Value of the root `baseProfile` attribute (tiny, basic or full).",
          "de": "Wert des Wurzelattributs `baseProfile` (tiny, basic oder full)."
        }
      }
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "SVG version",
          "de": "SVG-Version"
        },
        "description": {
          "en": "Value of the `version` attribute stamped with the profile, for example 1.1; cleared, the attribute is removed.",
          "de": "Wert des Attributs `version`, das mit dem Profil gesetzt wird, zum Beispiel 1.1; geleert wird das Attribut entfernt."
        },
        "group": "value",
        "order": 20
      }
    }
  }
}
