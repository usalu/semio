dialect grammar stdio.svg.mutations
root = document
document = payload
; SvgMutation's text representation IS its JSON serialization (see the sibling
; ../🔣️component.json for the SvgMutation JSON Schema) -- serde(rename_all = "camelCase"),
; tag-discriminated unions via a "mutation" field. No custom textual grammar beyond JSON's own
; (well-known, not reproduced here).
payload = json-value
