{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/diff.json",
  "title": "SvgDiff",
  "type": "object",
  "properties": {
    "prolog": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/SvgNode"
      }
    },
    "epilog": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/SvgNode"
      }
    },
    "declaration": {
      "$ref": "#/$defs/NullableXmlDeclaration"
    },
    "doctype": {
      "$ref": "#/$defs/NullableXmlDoctype"
    },
    "root": {
      "$ref": "#/$defs/SvgNodeDiff"
    }
  },
  "$defs": {
    "XmlDeclaration": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "standalone": {
          "type": "boolean"
        },
        "quote": {
          "type": "string",
          "enum": [
            "double",
            "single"
          ],
          "description": "🗣️ Delimiter the declaration's pseudo-attributes are written with (XML 1.0 §2.8); absent means the default `\"` spelling."
        }
      }
    },
    "NullableXmlDeclaration": {
      "description": "Tri-state: absent key = unchanged, null = cleared, object = set.",
      "type": [
        "object",
        "null"
      ]
    },
    "NullableXmlDoctype": {
      "description": "Tri-state: absent key = unchanged, null = cleared, object = set.",
      "oneOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/xml/1.0/base/snapshot.json#/$defs/XmlDoctype"
        },
        {
          "type": "null"
        }
      ]
    },
    "SvgAttrModified": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/SvgAttributeValue"
        }
      }
    },
    "SvgAttrAdded": {
      "type": "object",
      "required": [
        "index",
        "name",
        "value"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/SvgAttributeValue"
        }
      }
    },
    "SvgAttributesDiff": {
      "type": "object",
      "required": [
        "removed",
        "modified",
        "added"
      ],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SvgAttrModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SvgAttrAdded"
          }
        }
      }
    },
    "SvgChildModified": {
      "type": "object",
      "required": [
        "index",
        "diff"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "diff": {
          "$ref": "#/$defs/SvgNodeDiff"
        }
      }
    },
    "SvgChildAdded": {
      "type": "object",
      "required": [
        "index",
        "item"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "item": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/SvgNode"
        }
      }
    },
    "SvgChildrenDiff": {
      "type": "object",
      "required": [
        "removed",
        "modified",
        "added"
      ],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SvgChildModified"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SvgChildAdded"
          }
        }
      }
    },
    "SvgElementDiff": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "attributes": {
          "$ref": "#/$defs/SvgAttributesDiff"
        },
        "children": {
          "$ref": "#/$defs/SvgChildrenDiff"
        }
      }
    },
    "SvgNodeDiff": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "element"
            }
          },
          "allOf": [
            {
              "$ref": "#/$defs/SvgElementDiff"
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "replace"
            },
            "node": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/SvgNode"
            }
          }
        }
      ]
    }
  }
}
