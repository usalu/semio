{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/svg/1.1/base/inference.json",
  "title": "SvgInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dimensions"
  ],
  "properties": {
    "dimensions": {
      "$ref": "#/$defs/SvgDimensions",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "SvgDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    }
  }
}
