{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/basic/mutation/insert-clip-path-shape/schema.json",
  "title": "InsertClipPathShape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clipPathId",
    "index",
    "node"
  ],
  "properties": {
    "clipPathId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Clipping path",
          "de": "Beschneidungspfad"
        },
        "description": {
          "en": "The `clipPath` element referenced by id.",
          "de": "Das per ID referenzierte Element `clipPath`."
        },
        "ref": {
          "kind": "clipPath"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "node": {
      "$ref": "#/$defs/XmlNode"
    }
  },
  "$defs": {
    "XmlNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "element"
            },
            "name": {
              "type": "string"
            },
            "attrs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlAttr"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/XmlNode"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "cData"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "comment"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "data"
          ],
          "properties": {
            "kind": {
              "const": "processingInstruction"
            },
            "target": {
              "type": "string"
            },
            "data": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
