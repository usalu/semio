{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/basic/mutation/insert-clip-path-shape/schema.json",
  "title": "InsertClipPathShape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clipPathId",
    "index",
    "node"
  ],
  "properties": {
    "clipPathId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Clipping path",
          "de": "Beschneidungspfad"
        },
        "description": {
          "en": "The `clipPath` element referenced by id.",
          "de": "Das per ID referenzierte Element `clipPath`."
        },
        "ref": {
          "kind": "clipPath"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the shapes of the clipping path at which it is inserted, counted from 0.",
          "de": "Position unter den Formen des Beschneidungspfads, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "node": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/SvgNode",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The element (with its attributes and children) or the character data that is inserted.",
          "de": "Das Element (mit Attributen und Kindknoten) oder die Zeichendaten, die eingefügt werden."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {}
}
