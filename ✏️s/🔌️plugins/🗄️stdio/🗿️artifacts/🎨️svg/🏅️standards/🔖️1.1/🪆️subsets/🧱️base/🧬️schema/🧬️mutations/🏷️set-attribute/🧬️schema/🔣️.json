{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/mutation/set-attribute/schema.json",
  "title": "SetAttributePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "name"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Element path",
          "de": "Elementpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the element, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Element, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Attribute",
          "de": "Attribut"
        },
        "description": {
          "en": "Qualified name of the attribute that is set or removed.",
          "de": "Qualifizierter Name des Attributs, das gesetzt oder entfernt wird."
        },
        "group": "target",
        "order": 20
      }
    },
    "value": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/SvgAttributeValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Attribute position",
          "de": "Attributposition"
        },
        "description": {
          "en": "Position the attribute takes among the element's attributes when it is added; the last position when absent.",
          "de": "Position, die das Attribut beim Hinzufügen unter den Attributen des Elements einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 40
      }
    }
  }
}
