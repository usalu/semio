{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/mutation/set-doctype/schema.json",
  "title": "SetDoctypePayload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "doctype": {
      "anyOf": [
        {
          "$ref": "#/$defs/XmlDoctype"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Document type",
          "de": "Dokumenttyp"
        },
        "description": {
          "en": "The DOCTYPE declaration; cleared, the document carries none.",
          "de": "Die DOCTYPE-Deklaration; geleert trägt das Dokument keine."
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "XmlDoctype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "prologPosition": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "x-semio-ui": {
            "label": {
              "en": "Prolog position",
              "de": "Position im Prolog"
            },
            "description": {
              "en": "Number of prolog nodes before the document type declaration, as an unsigned decimal.",
              "de": "Anzahl der Prolog-Knoten vor der Dokumenttypdeklaration, als vorzeichenlose Dezimalzahl."
            }
          }
        },
        "name": {
          "type": "string"
        },
        "externalId": {
          "anyOf": [
            {
              "$ref": "#/$defs/XmlExternalId"
            },
            {
              "type": "null"
            }
          ],
          "x-semio-ui": {
            "label": {
              "en": "External identifier",
              "de": "Externer Bezeichner"
            },
            "description": {
              "en": "SYSTEM or PUBLIC identifier of the external DTD subset.",
              "de": "SYSTEM- oder PUBLIC-Bezeichner der externen DTD-Teilmenge."
            }
          }
        },
        "declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/XmlDtdDeclaration"
          },
          "x-semio-ui": {
            "label": {
              "en": "Markup declarations",
              "de": "Markup-Deklarationen"
            },
            "description": {
              "en": "Declarations of the internal DTD subset in document order.",
              "de": "Deklarationen der internen DTD-Teilmenge in Dokumentreihenfolge."
            }
          }
        }
      }
    },
    "XmlExternalId": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "system"
            },
            "systemId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "publicId",
            "systemId"
          ],
          "properties": {
            "kind": {
              "const": "public"
            },
            "publicId": {
              "type": "string"
            },
            "systemId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "XmlDtdDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parameter",
            "name",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "parameter": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
