{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/mutation/set-transform/schema.json",
  "title": "SetTransformPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Element path",
          "de": "Elementpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the element, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Element, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "transform": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/TransformOp"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Attribute position",
          "de": "Attributposition"
        },
        "description": {
          "en": "Position the attribute takes among the element's attributes when it is added; the last position when absent.",
          "de": "Position, die das Attribut beim Hinzufügen unter den Attributen des Elements einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 40
      }
    }
  },
  "$defs": {
    "TransformOp": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "a",
            "b",
            "c",
            "d",
            "e",
            "f"
          ],
          "properties": {
            "op": {
              "const": "matrix"
            },
            "a": {
              "type": "number"
            },
            "b": {
              "type": "number"
            },
            "c": {
              "type": "number"
            },
            "d": {
              "type": "number"
            },
            "e": {
              "type": "number"
            },
            "f": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "x"
          ],
          "properties": {
            "op": {
              "const": "translate"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "x"
          ],
          "properties": {
            "op": {
              "const": "scale"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "angle"
          ],
          "properties": {
            "op": {
              "const": "rotate"
            },
            "angle": {
              "type": "number"
            },
            "center": {
              "anyOf": [
                {
                  "type": "array",
                  "items": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "additionalItems": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "angle"
          ],
          "properties": {
            "op": {
              "const": "skewX"
            },
            "angle": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "angle"
          ],
          "properties": {
            "op": {
              "const": "skewY"
            },
            "angle": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
