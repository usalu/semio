{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/mutation/set-transform/schema.json",
  "title": "SetTransformPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Element path",
          "de": "Elementpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the element, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Element, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "transform": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransformOp"
          }
        },
        {
          "type": "null"
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Transform",
          "de": "Transformation"
        },
        "description": {
          "en": "Ordered transform operations (matrix, translate, scale, rotate, skewX, skewY); cleared, the attribute is removed.",
          "de": "Geordnete Transformationsoperationen (matrix, translate, scale, rotate, skewX, skewY); geleert wird das Attribut entfernt."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "TransformOp": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "a",
            "b",
            "c",
            "d",
            "e",
            "f"
          ],
          "properties": {
            "op": {
              "const": "matrix"
            },
            "a": {
              "type": "number"
            },
            "b": {
              "type": "number"
            },
            "c": {
              "type": "number"
            },
            "d": {
              "type": "number"
            },
            "e": {
              "type": "number"
            },
            "f": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "x"
          ],
          "properties": {
            "op": {
              "const": "translate"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "x"
          ],
          "properties": {
            "op": {
              "const": "scale"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "angle"
          ],
          "properties": {
            "op": {
              "const": "rotate"
            },
            "angle": {
              "type": "number"
            },
            "center": {
              "anyOf": [
                {
                  "type": "array",
                  "items": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "additionalItems": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "angle"
          ],
          "properties": {
            "op": {
              "const": "skewX"
            },
            "angle": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "angle"
          ],
          "properties": {
            "op": {
              "const": "skewY"
            },
            "angle": {
              "type": "number"
            }
          }
        }
      ]
    },
    "SetTransformMutation": {
      "description": "The whole wire of SetTransformMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/diff.json"
            }
          }
        }
      ]
    }
  }
}
