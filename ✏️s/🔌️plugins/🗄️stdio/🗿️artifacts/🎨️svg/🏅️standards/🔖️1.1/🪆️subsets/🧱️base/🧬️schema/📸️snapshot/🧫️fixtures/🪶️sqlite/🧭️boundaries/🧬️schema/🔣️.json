{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Svg Owned And External XML Boundaries",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ownedNative",
    "ownedSqlite",
    "externalXml",
    "cases",
    "mutationKinds"
  ],
  "properties": {
    "ownedNative": {
      "const": "preserveLiteralState"
    },
    "ownedSqlite": {
      "const": "preserveLiteralState"
    },
    "externalXml": {
      "const": "validateForPublication"
    },
    "cases": {
      "const": [
        "doctype-position-past-prolog",
        "non-misc-epilog-node",
        "declaration-encoding-quote-injection",
        "declaration-conflicts-with-utf8-transport"
      ]
    },
    "mutationKinds": {
      "const": [
        "set-snapshot",
        "patch-snapshot",
        "set-declaration",
        "set-doctype",
        "insert-element",
        "remove-element",
        "set-element-name",
        "set-attribute",
        "set-text",
        "set-view-box",
        "set-transform"
      ]
    }
  }
}
