{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/mutation/set-element-name/schema.json",
  "title": "SetElementNamePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "name"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Element path",
          "de": "Elementpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the element, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Element, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Element name",
          "de": "Elementname"
        },
        "description": {
          "en": "Qualified name the element carries afterwards.",
          "de": "Qualifizierter Name, den das Element danach trägt."
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "SetElementNameMutation": {
      "description": "The whole wire of SetElementNameMutation: the editable apply payload (this document's root) or the inert restore.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "apply"
            },
            "value": {
              "$ref": "#"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "value"
          ],
          "properties": {
            "phase": {
              "const": "restore"
            },
            "value": {
              "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/diff.json"
            }
          }
        }
      ]
    }
  }
}
