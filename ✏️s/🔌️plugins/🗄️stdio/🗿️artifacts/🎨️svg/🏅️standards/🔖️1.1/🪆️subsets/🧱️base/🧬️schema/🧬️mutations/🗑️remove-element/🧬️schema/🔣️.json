{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/mutation/remove-element/schema.json",
  "title": "RemoveElementPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent",
    "index"
  ],
  "properties": {
    "parent": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Parent path",
          "de": "Elternpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the parent element, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Elternelement, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Child",
          "de": "Kindknoten"
        },
        "description": {
          "en": "Index of the child among the parent's children, counted from 0.",
          "de": "Index des Kindknotens unter den Kindern des Elternelements, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  }
}
