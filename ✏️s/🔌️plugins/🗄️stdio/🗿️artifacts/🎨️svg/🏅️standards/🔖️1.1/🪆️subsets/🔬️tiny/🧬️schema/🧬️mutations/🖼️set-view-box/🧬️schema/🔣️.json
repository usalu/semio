{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/svg/1.1/tiny/mutation/set-view-box.json",
  "title": "SetViewBox",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "view_box": {
      "anyOf": [
        {
          "$ref": "#/$defs/ViewBox"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "ViewBox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minX",
        "minY",
        "width",
        "height"
      ],
      "properties": {
        "minX": {
          "type": "number"
        },
        "minY": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    }
  }
}
