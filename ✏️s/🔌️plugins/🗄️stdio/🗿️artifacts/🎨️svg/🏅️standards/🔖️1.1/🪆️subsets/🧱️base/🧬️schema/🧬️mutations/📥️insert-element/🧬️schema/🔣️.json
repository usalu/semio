{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/mutation/insert-element/schema.json",
  "title": "InsertElementPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent",
    "index",
    "node"
  ],
  "properties": {
    "parent": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Parent path",
          "de": "Elternpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the parent element, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Elternelement, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Child position",
          "de": "Kindposition"
        },
        "description": {
          "en": "Position among the parent's children at which it is inserted, counted from 0.",
          "de": "Position unter den Kindknoten des Elternelements, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "node": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/SvgNode"
    }
  }
}
