  "comparisonProfiles": [
    {
      "id": "semantic-svg-tiny-1-1-v1",
      "description": "SVG Tiny 1.1 mutation round trips compared structurally: element/text/CDATA/comment/PI tree shape and content exact, attributes compared as a name-sorted set (attribute order is real writer freedom), and the viewBox/transform attribute values decomposed into typed numeric geometry rather than compared as raw strings, with a small absolute tolerance for cross-implementation float formatting. Self-closing versus explicit empty open/close tags are equivalent by construction — both parse to zero children — and are never distinguished by either side. Nothing about the PROFILE is narrowed away: the presence or absence of an excluded element or a forbidden presentation attribute is exactly what the tree comparison sees, so strip-non-tiny and the gated authoring kinds are compared on the ground the profile is defined on.",
      "tolerance": 1e-09,
      "ignoreKeys": []
    }
  ],
