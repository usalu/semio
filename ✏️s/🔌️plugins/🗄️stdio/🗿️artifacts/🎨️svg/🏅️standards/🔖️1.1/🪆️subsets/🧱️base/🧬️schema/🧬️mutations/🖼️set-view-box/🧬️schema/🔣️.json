{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/mutation/set-view-box/schema.json",
  "title": "SetViewBoxPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "x-semio-ui": {
        "label": {
          "en": "Element path",
          "de": "Elementpfad"
        },
        "description": {
          "en": "Child indices leading from the root element to the element, each counted from 0.",
          "de": "Kindindizes vom Wurzelelement bis zum Element, jeweils ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "viewBox": {
      "anyOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/stdio/svg/1.1/base/snapshot.json#/$defs/ViewBox"
        },
        {
          "type": "null"
        }
      ]
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Attribute position",
          "de": "Attributposition"
        },
        "description": {
          "en": "Position the attribute takes among the element's attributes when it is added; the last position when absent.",
          "de": "Position, die das Attribut beim Hinzufügen unter den Attributen des Elements einnimmt; ohne Angabe die letzte."
        },
        "step": 1,
        "precision": 0,
        "group": "value",
        "order": 40
      }
    }
  },
  "$defs": {
    "ViewBox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minX",
        "minY",
        "width",
        "height"
      ],
      "properties": {
        "minX": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Minimum X",
              "de": "Minimum X"
            },
            "description": {
              "en": "Left edge of the viewBox in user units.",
              "de": "Linker Rand der viewBox in Benutzereinheiten."
            }
          }
        },
        "minY": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "label": {
              "en": "Minimum Y",
              "de": "Minimum Y"
            },
            "description": {
              "en": "Top edge of the viewBox in user units.",
              "de": "Oberer Rand der viewBox in Benutzereinheiten."
            }
          }
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    }
  }
}
