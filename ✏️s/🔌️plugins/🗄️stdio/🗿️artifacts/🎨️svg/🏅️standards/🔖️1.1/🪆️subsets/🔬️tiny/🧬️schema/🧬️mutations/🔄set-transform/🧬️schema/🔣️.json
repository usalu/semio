{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/svg/1.1/tiny/mutation/set-transform/schema.json",
  "title": "SetTransform",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "transform": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TransformOp"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "TransformOp": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "a",
            "b",
            "c",
            "d",
            "e",
            "f"
          ],
          "properties": {
            "op": {
              "const": "matrix"
            },
            "a": {
              "type": "number"
            },
            "b": {
              "type": "number"
            },
            "c": {
              "type": "number"
            },
            "d": {
              "type": "number"
            },
            "e": {
              "type": "number"
            },
            "f": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "x"
          ],
          "properties": {
            "op": {
              "const": "translate"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "x"
          ],
          "properties": {
            "op": {
              "const": "scale"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "angle"
          ],
          "properties": {
            "op": {
              "const": "rotate"
            },
            "angle": {
              "type": "number"
            },
            "center": {
              "anyOf": [
                {
                  "type": "array",
                  "items": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "additionalItems": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "angle"
          ],
          "properties": {
            "op": {
              "const": "skewX"
            },
            "angle": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "angle"
          ],
          "properties": {
            "op": {
              "const": "skewY"
            },
            "angle": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
