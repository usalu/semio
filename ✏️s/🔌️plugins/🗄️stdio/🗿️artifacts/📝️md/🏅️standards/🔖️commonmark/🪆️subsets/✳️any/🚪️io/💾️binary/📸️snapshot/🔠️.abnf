; abnf stdio.md snapshot -- real pack envelope, mirrors 📡️.protocol.semio
document = magic version schema-id markdown-text
magic = %x53.45.4D.49 ; "SEMI"
version = OCTET
schema-id = length schema-id-bytes
length = 4OCTET ; u32-le
schema-id-bytes = *OCTET
markdown-text = *OCTET ; UTF-8 bytes of the rendered document (see ../📝️text/🔤️.ebnf)
