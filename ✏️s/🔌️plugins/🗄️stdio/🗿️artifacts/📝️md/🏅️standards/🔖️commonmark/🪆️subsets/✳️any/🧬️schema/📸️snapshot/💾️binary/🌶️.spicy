module Stdio_md_snapshot;
# 🧩 Real (honest-subset) pack envelope for stdio.md: magic + version + length-prefixed
# schema id, followed by the UTF-8 rendered-markdown payload (see the sibling
# ../📝️text/📖️.grammar.semio for that payload's own real structure).

type Document = unit {
    magic: bytes &size=4;
    version: uint8;
    schema_id_len: uint32;
    schema_id: bytes &size=self.schema_id_len;
    markdown_text: bytes &restofdata;
};
