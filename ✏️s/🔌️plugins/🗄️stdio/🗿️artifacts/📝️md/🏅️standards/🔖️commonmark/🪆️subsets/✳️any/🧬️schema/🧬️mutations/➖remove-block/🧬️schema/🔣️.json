{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/md/commonmark/any/mutation/remove-block/schema.json",
  "title": "RemoveBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "removeBlock",
      "description": "Aggregate discriminator spliced in by MdMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MdPathStep"
      },
      "x-semio-ui": {
        "label": {
          "en": "Container path",
          "de": "Containerpfad"
        },
        "description": {
          "en": "Steps from the document into the nested block container (a block quote or a list item); empty for the top level.",
          "de": "Schritte vom Dokument in den verschachtelten Blockcontainer (Blockzitat oder Listenelement); leer für die oberste Ebene."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Block",
          "de": "Block"
        },
        "description": {
          "en": "Index of the block within its container, counted from 0.",
          "de": "Index des Blocks in seinem Container, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    }
  },
  "$defs": {
    "MdPathStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "index"
          ],
          "properties": {
            "step": {
              "const": "blockQuote"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "index",
            "item"
          ],
          "properties": {
            "step": {
              "const": "listItem"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "item": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
