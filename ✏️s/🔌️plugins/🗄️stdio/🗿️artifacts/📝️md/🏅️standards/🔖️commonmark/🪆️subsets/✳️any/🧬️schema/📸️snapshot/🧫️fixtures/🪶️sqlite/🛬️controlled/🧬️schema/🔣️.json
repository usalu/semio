{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["depth", "maxRows", "maxAllocationBytes", "allocationLimitRole", "cancelAfter", "schemaRepeat", "orderedStart"],
  "properties": {
    "depth": {"const": 600},
    "maxRows": {"const": 10},
    "maxAllocationBytes": {"const": 4096},
    "allocationLimitRole": {"const": "nativeOwnedBacking"},
    "cancelAfter": {"const": 256},
    "schemaRepeat": {"const": 10000},
    "orderedStart": {"const": 4294967295}
  }
}
