    },
    {
      "allOf": [
        {
          "$ref": "https://semio.tech/schema/s/stdio/md/commonmark/any/mutation/set-snapshot/schema.json"
        },
        {
          "type": "object",
          "required": [
            "mutation"
          ],
          "properties": {
