{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/md/commonmark/any/mutation/insert-block/schema.json",
  "title": "InsertBlock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "path",
    "index",
    "block"
  ],
  "properties": {
    "mutation": {
      "const": "insertBlock",
      "description": "Aggregate discriminator spliced in by MdMutation; absent when the payload stands alone."
    },
    "path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MdPathStep"
      },
      "x-semio-ui": {
        "label": {
          "en": "Container path",
          "de": "Containerpfad"
        },
        "description": {
          "en": "Steps from the document into the nested block container (a block quote or a list item); empty for the top level.",
          "de": "Schritte vom Dokument in den verschachtelten Blockcontainer (Blockzitat oder Listenelement); leer für die oberste Ebene."
        },
        "group": "target",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "description": {
          "en": "Position among the blocks of the container at which it is inserted, counted from 0.",
          "de": "Position unter den Blöcken des Containers, an der eingefügt wird, ab 0 gezählt."
        },
        "step": 1,
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "block": {
      "$ref": "#/$defs/MdBlock",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Block",
          "de": "Block"
        },
        "description": {
          "en": "The block that is inserted: heading, paragraph, list, code block, block quote, thematic break or raw HTML.",
          "de": "Der Block, der eingefügt wird: Überschrift, Absatz, Liste, Codeblock, Blockzitat, Trennlinie oder rohes HTML."
        },
        "group": "value",
        "order": 30
      }
    }
  },
  "$defs": {
    "MdPathStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "index"
          ],
          "properties": {
            "step": {
              "const": "blockQuote"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "index",
            "item"
          ],
          "properties": {
            "step": {
              "const": "listItem"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "item": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "MdBlock": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "level",
            "inlines"
          ],
          "properties": {
            "kind": {
              "const": "heading"
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "inlines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MdInline"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inlines"
          ],
          "properties": {
            "kind": {
              "const": "paragraph"
            },
            "inlines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MdInline"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ordered",
            "tight",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "list"
            },
            "ordered": {
              "type": "boolean"
            },
            "start": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "null"
                }
              ]
            },
            "tight": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/MdBlock"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "literal"
          ],
          "properties": {
            "kind": {
              "const": "codeBlock"
            },
            "info": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "literal": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blocks"
          ],
          "properties": {
            "kind": {
              "const": "blockQuote"
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MdBlock"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "thematicBreak"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "raw"
          ],
          "properties": {
            "kind": {
              "const": "htmlBlock"
            },
            "raw": {
              "type": "string"
            }
          }
        }
      ]
    },
    "MdInline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inlines"
          ],
          "properties": {
            "kind": {
              "const": "emphasis"
            },
            "inlines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MdInline"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "inlines"
          ],
          "properties": {
            "kind": {
              "const": "strong"
            },
            "inlines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MdInline"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "literal"
          ],
          "properties": {
            "kind": {
              "const": "code"
            },
            "literal": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "link"
            },
            "text": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MdInline"
              }
            },
            "url": {
              "type": "string"
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "alt",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "alt": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "softBreak"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "hardBreak"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "raw"
          ],
          "properties": {
            "kind": {
              "const": "htmlInline"
            },
            "raw": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
