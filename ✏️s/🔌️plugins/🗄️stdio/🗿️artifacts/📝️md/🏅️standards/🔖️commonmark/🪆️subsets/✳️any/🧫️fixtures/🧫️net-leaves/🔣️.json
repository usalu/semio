{
  "schema": "semio.stdio.md.net-leaves.v1",
  "note": "One explicit Apply of the markdown window is ONE edit of these net block leaves, in application order (design §13.2 of ticket 26/09/30/NON-DESTRUCTIVE-HISTORY-EDITING). A path step is quote:<block index> (the block quote's own blocks) or item:<list block index>:<item index> (one list item's blocks).",
  "cases": [
    { "id": "unchanged", "before": "# Title\n\nFirst.\n", "after": "# Title\n\nFirst.\n", "leaves": [] },
    { "id": "edits-a-paragraph", "before": "# Title\n\nFirst.\n\nSecond.\n", "after": "# Title\n\nFirst edited.\n\nSecond.\n", "leaves": [{ "kind": "set-inlines", "path": [], "index": 1 }] },
    { "id": "inserts-a-paragraph", "before": "# Title\n\nFirst.\n\nSecond.\n", "after": "# Title\n\nFirst.\n\nMiddle.\n\nSecond.\n", "leaves": [{ "kind": "insert-block", "path": [], "index": 2 }] },
    { "id": "removes-a-paragraph", "before": "# Title\n\nFirst.\n\nSecond.\n", "after": "# Title\n\nSecond.\n", "leaves": [{ "kind": "remove-block", "path": [], "index": 1 }] },
    { "id": "retitles-a-heading", "before": "# Title\n\nBody.\n", "after": "# Better title\n\nBody.\n", "leaves": [{ "kind": "set-inlines", "path": [], "index": 0 }] },
    { "id": "changes-a-heading-level", "before": "# Title\n\nBody.\n", "after": "## Title\n\nBody.\n", "leaves": [{ "kind": "replace-block", "path": [], "index": 0 }] },
    { "id": "edits-inside-a-quote", "before": "Intro.\n\n> one\n>\n> two\n", "after": "Intro.\n\n> one\n>\n> 2\n", "leaves": [{ "kind": "set-inlines", "path": ["quote:1"], "index": 1 }] },
    { "id": "edits-a-list-item", "before": "- one\n- two\n- three\n", "after": "- one\n- 2\n- three\n", "leaves": [{ "kind": "set-inlines", "path": ["item:0:1"], "index": 0 }] },
    { "id": "adds-a-list-item", "before": "- one\n- two\n", "after": "- one\n- two\n- three\n", "leaves": [{ "kind": "replace-block", "path": [], "index": 0 }] },
    { "id": "rewrites-a-code-block", "before": "```\nold\n```\n", "after": "```\nnew\n```\n", "leaves": [{ "kind": "replace-block", "path": [], "index": 0 }] },
    { "id": "replaces-and-trims", "before": "First.\n\nSecond.\n", "after": "# Only\n", "leaves": [{ "kind": "replace-block", "path": [], "index": 0 }, { "kind": "remove-block", "path": [], "index": 1 }] },
    { "id": "appends-two-blocks", "before": "First.\n", "after": "First.\n\nSecond.\n\nThird.\n", "leaves": [{ "kind": "insert-block", "path": [], "index": 1 }, { "kind": "insert-block", "path": [], "index": 2 }] }
  ]
}
