{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/md/commonmark/any/net-mutation/schema.json",
  "title": "MarkdownNetMutationAddress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "path",
    "index"
  ],
  "properties": {
    "kind": {
      "enum": [
        "insert-block",
        "remove-block",
        "replace-block",
        "set-inlines"
      ]
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(quote:[0-9]+|item:[0-9]+:[0-9]+)$"
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
