{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/epw/energyplus/any/mutation/set-data-periods/schema.json",
  "title": "SetDataPeriods",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "dataPeriods"
  ],
  "properties": {
    "mutation": {
      "const": "setDataPeriods",
      "description": "Aggregate discriminator spliced in by EpwMutation; absent when the payload stands alone."
    },
    "dataPeriods": {
      "$ref": "#/$defs/EpwDataPeriods",
      "x-semio-ui": {
        "label": {
          "en": "Data periods",
          "de": "Datenzeiträume"
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "EpwDataPeriods": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordsPerHour",
        "periods"
      ],
      "properties": {
        "recordsPerHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "x-semio-ui": {
            "label": {
              "en": "Records per hour",
              "de": "Datensätze pro Stunde"
            }
          }
        },
        "periods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EpwDataPeriod"
          },
          "x-semio-ui": {
            "label": {
              "en": "Periods",
              "de": "Zeiträume"
            }
          }
        }
      }
    },
    "EpwDataPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "startDayOfWeek",
        "startDate",
        "endDate"
      ],
      "properties": {
        "name": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Period name",
              "de": "Name des Zeitraums"
            }
          }
        },
        "startDayOfWeek": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Start weekday",
              "de": "Wochentag des Beginns"
            }
          }
        },
        "startDate": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Start date",
              "de": "Anfangsdatum"
            }
          }
        },
        "endDate": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "End date",
              "de": "Enddatum"
            }
          }
        }
      }
    }
  }
}
