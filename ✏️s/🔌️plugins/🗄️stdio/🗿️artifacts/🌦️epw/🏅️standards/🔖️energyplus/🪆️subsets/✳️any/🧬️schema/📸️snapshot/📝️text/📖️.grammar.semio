dialect grammar
grammar stdio.epw.snapshot
extension semio
start document

document = schema design-conditions typical-extreme-periods ground-temperatures holidays-dst comments-1 comments-2 location data-periods records
schema = "schema" "=" text
design-conditions = "design-conditions" "=" text
typical-extreme-periods = "typical-extreme-periods" "=" text
ground-temperatures = "ground-temperatures" "=" text
holidays-dst = "holidays-dst" "=" text
comments-1 = "comments-1" "=" text
comments-2 = "comments-2" "=" text
location = "location" "=" "city" "=" text "state-province" "=" text "country" "=" text "source" "=" text "wmo" "=" text "latitude" "=" text "longitude" "=" text "time-zone" "=" text "elevation" "=" text
data-periods = "data-periods" "=" "records-per-hour" "=" INT "periods" "=" "[" period* "]"
period = "name" "=" text "start-day-of-week" "=" text "start-date" "=" text "end-date" "=" text
records = "records" "=" "[" record* "]"
record = "year" "=" text "month" "=" text "day" "=" text "hour" "=" text "minute" "=" text "data-source-uncertainty" "=" text "dry-bulb-temp" "=" text "dew-point-temp" "=" text "relative-humidity" "=" text "atmospheric-pressure" "=" text "extraterrestrial-horizontal-radiation" "=" text "extraterrestrial-direct-normal-radiation" "=" text "horizontal-infrared-radiation" "=" text "global-horizontal-radiation" "=" text "direct-normal-radiation" "=" text "diffuse-horizontal-radiation" "=" text "global-horizontal-illuminance" "=" text "direct-normal-illuminance" "=" text "diffuse-horizontal-illuminance" "=" text "zenith-luminance" "=" text "wind-direction" "=" text "wind-speed" "=" text "total-sky-cover" "=" text "opaque-sky-cover" "=" text "visibility" "=" text "ceiling-height" "=" text "present-weather-observation" "=" text "present-weather-codes" "=" text "precipitable-water" "=" text "aerosol-optical-depth" "=" text "snow-depth" "=" text "days-since-last-snowfall" "=" text "albedo" "=" text "liquid-precip-depth" "=" text "liquid-precip-quantity" "=" text
text = STRING / IDENT / INT / FLOAT
