{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/epw/energyplus/any/mutation/set-location.json",
  "title": "SetLocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location"
  ],
  "properties": {
    "location": {
      "$ref": "#/$defs/EpwLocation"
    },
    "mutation": {
      "const": "setLocation",
      "description": "Aggregate discriminator spliced in by EpwMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "EpwLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city",
        "stateProvince",
        "country",
        "source",
        "wmo",
        "latitude",
        "longitude",
        "timeZone",
        "elevation"
      ],
      "properties": {
        "city": {
          "type": "string"
        },
        "stateProvince": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "wmo": {
          "type": "string"
        },
        "latitude": {
          "type": "string"
        },
        "longitude": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        },
        "elevation": {
          "type": "string"
        }
      }
    }
  }
}
