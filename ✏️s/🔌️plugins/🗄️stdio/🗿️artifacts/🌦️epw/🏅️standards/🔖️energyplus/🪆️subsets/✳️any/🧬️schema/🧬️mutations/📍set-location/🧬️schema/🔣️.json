{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/epw/energyplus/any/mutation/set-location/schema.json",
  "title": "SetLocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "location"
  ],
  "properties": {
    "mutation": {
      "const": "setLocation",
      "description": "Aggregate discriminator spliced in by EpwMutation; absent when the payload stands alone."
    },
    "location": {
      "$ref": "#/$defs/EpwLocation",
      "x-semio-ui": {
        "label": {
          "en": "Location",
          "de": "Standort"
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "EpwLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city",
        "stateProvince",
        "country",
        "source",
        "wmo",
        "latitude",
        "longitude",
        "timeZone",
        "elevation"
      ],
      "properties": {
        "city": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "City",
              "de": "Ort"
            }
          }
        },
        "stateProvince": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "State or province",
              "de": "Bundesland oder Provinz"
            }
          }
        },
        "country": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Country",
              "de": "Land"
            }
          }
        },
        "source": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Data source",
              "de": "Datenquelle"
            }
          }
        },
        "wmo": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "WMO station number",
              "de": "WMO-Stationsnummer"
            }
          }
        },
        "latitude": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Latitude",
              "de": "Geographische Breite"
            },
            "description": {
              "en": "Degrees, north positive.",
              "de": "Grad, nördlich positiv."
            }
          }
        },
        "longitude": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Longitude",
              "de": "Geographische Länge"
            },
            "description": {
              "en": "Degrees, east positive.",
              "de": "Grad, östlich positiv."
            }
          }
        },
        "timeZone": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Time zone",
              "de": "Zeitzone"
            },
            "description": {
              "en": "Offset from UTC in hours.",
              "de": "Abweichung von UTC in Stunden."
            }
          }
        },
        "elevation": {
          "type": "string",
          "x-semio-ui": {
            "label": {
              "en": "Elevation",
              "de": "Höhe über Meeresspiegel"
            },
            "description": {
              "en": "Metres above sea level.",
              "de": "Meter über dem Meeresspiegel."
            }
          }
        }
      }
    }
  }
}
