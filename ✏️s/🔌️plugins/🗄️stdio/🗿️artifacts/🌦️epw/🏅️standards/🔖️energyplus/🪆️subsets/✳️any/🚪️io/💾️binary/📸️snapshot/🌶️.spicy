module Stdio_epw_snapshot;

# Shared `.semio` binary envelope wrapping a stdio.epw payload: the UTF-8 bytes of the
# same EPW document the text facet parses.
type Document = unit {
    magic: bytes &size=8;
    token_len: uint32 &byte-order=spicy::ByteOrder::Little;
    token: bytes &size=self.token_len;   # UTF-8 "stdio.epw.pack v1"
    payload: bytes &eod;                 # UTF-8 EPW text, CRLF line endings
};
