{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/epw/energyplus/any/mutation/remove-record/schema.json",
  "title": "RemoveRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index"
  ],
  "properties": {
    "mutation": {
      "const": "removeRecord",
      "description": "Aggregate discriminator spliced in by EpwMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Record position",
          "de": "Datensatzposition"
        },
        "description": {
          "en": "Index of the hourly data record, counted from 0.",
          "de": "Index des stündlichen Datensatzes, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    }
  }
}
