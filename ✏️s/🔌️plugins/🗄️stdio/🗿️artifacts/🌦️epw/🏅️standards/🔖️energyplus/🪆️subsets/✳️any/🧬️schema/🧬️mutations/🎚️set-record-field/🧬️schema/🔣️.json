{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/epw/energyplus/any/mutation/set-record-field/schema.json",
  "title": "SetRecordField",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "recordIndex",
    "fieldIndex",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setRecordField",
      "description": "Aggregate discriminator spliced in by EpwMutation; absent when the payload stands alone."
    },
    "recordIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Record",
          "de": "Datensatz"
        },
        "description": {
          "en": "Index of the hourly data record, counted from 0.",
          "de": "Index des stündlichen Datensatzes, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "fieldIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Field",
          "de": "Feld"
        },
        "description": {
          "en": "Index of the field within the record, counted from 0.",
          "de": "Index des Feldes im Datensatz, ab 0 gezählt."
        },
        "precision": 0,
        "group": "target",
        "order": 20
      }
    },
    "value": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "label": {
          "en": "Field value",
          "de": "Feldwert"
        },
        "description": {
          "en": "Raw text of the field as written in the file.",
          "de": "Rohtext des Feldes wie in der Datei."
        },
        "group": "value",
        "order": 30
      }
    }
  }
}
