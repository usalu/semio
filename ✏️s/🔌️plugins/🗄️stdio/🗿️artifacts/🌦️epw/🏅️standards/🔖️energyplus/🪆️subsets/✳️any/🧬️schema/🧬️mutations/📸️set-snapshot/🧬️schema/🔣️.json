{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/epw/energyplus/any/mutation/set-snapshot.json",
  "title": "SetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "location",
    "dataPeriods"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string"
        },
        "stateProvince": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "wmo": {
          "type": "string"
        },
        "latitude": {
          "type": "string"
        },
        "longitude": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        },
        "elevation": {
          "type": "string"
        }
      },
      "required": [
        "city",
        "stateProvince",
        "country",
        "source",
        "wmo",
        "latitude",
        "longitude",
        "timeZone",
        "elevation"
      ],
      "additionalProperties": false
    },
    "dataPeriods": {
      "type": "object",
      "properties": {
        "recordsPerHour": {
          "type": "integer",
          "minimum": 0
        },
        "periods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "startDayOfWeek": {
                "type": "string"
              },
              "startDate": {
                "type": "string"
              },
              "endDate": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "startDayOfWeek",
              "startDate",
              "endDate"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "recordsPerHour",
        "periods"
      ],
      "additionalProperties": false
    },
    "mutation": {
      "const": "setSnapshot",
      "description": "Aggregate discriminator spliced in by EpwMutation; absent when the payload stands alone."
    }
  }
}
