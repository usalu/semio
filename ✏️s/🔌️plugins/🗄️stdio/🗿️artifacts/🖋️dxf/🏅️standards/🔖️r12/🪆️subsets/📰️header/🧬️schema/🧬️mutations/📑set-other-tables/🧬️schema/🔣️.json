{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/dxf/r12/header/mutation/set-other-tables/schema.json",
  "title": "SetOtherTables",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "otherTables"
  ],
  "properties": {
    "mutation": {
      "const": "setOtherTables",
      "description": "Aggregate discriminator spliced in by DxfMutation; absent when the payload stands alone."
    },
    "otherTables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DxfOtherTable"
      },
      "x-semio-ui": {
        "label": {
          "en": "Other tables",
          "de": "Weitere Tabellen"
        },
        "description": {
          "en": "Raw-retained TABLES entries the typed model does not interpret.",
          "de": "Roh erhaltene TABLES-Einträge, die das typisierte Modell nicht auswertet."
        },
        "group": "value",
        "order": 10
      }
    }
  },
  "$defs": {
    "DxfTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "value"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "string"
        }
      }
    },
    "DxfOtherTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tags"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DxfTag"
          }
        }
      }
    }
  }
}
