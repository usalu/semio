{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/dxf/r12/header/mutation/insert-linetype/schema.json",
  "title": "InsertLinetype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "linetype"
  ],
  "properties": {
    "mutation": {
      "const": "insertLinetype",
      "description": "Aggregate discriminator spliced in by DxfMutation; absent when the payload stands alone."
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "label": {
          "en": "Insert position",
          "de": "Einfügeposition"
        },
        "precision": 0,
        "group": "target",
        "order": 10
      }
    },
    "linetype": {
      "$ref": "#/$defs/DxfLinetype",
      "x-semio-ui": {
        "label": {
          "en": "Linetype",
          "de": "Linientyp"
        },
        "group": "value",
        "order": 20
      }
    }
  },
  "$defs": {
    "DxfLinetype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "flags",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "flags": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "x-semio-ui": {
            "label": {
              "en": "Standard flags",
              "de": "Standard-Flags"
            },
            "description": {
              "en": "Group code 70.",
              "de": "Gruppencode 70."
            }
          }
        },
        "description": {
          "type": "string"
        },
        "unknownGroupCodes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              {
                "$ref": "#/$defs/DxfValue"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "x-semio-ui": {
            "label": {
              "en": "Unknown group codes",
              "de": "Unbekannte Gruppencodes"
            }
          }
        }
      }
    },
    "DxfValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "str"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "double"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "point"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      ]
    }
  }
}
