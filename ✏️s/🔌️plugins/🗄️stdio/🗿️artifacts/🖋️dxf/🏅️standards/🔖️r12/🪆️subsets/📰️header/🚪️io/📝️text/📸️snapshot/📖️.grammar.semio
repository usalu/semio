dialect grammar
grammar stdio.dxf.snapshot
extension dxf
start document

document = "stdio.dxf" field*
field = "schema" "=" text / value-key "=" value
value-key = "headerVars" / "tables" / "otherTables" / "blocks" / "entities"
text = STRING / IDENT
value = "null" / "true" / "false" / number / STRING / array / object
array = "[" value* "]"
object = "{" member* "}"
member = (IDENT / STRING) "=" value
number = INT / FLOAT / IDENT
