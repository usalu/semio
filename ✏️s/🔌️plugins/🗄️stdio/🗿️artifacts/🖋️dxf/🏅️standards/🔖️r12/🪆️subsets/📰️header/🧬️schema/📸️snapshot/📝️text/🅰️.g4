grammar Stdio_dxf_snapshot;
document: 'stdio.dxf' field* EOF;
field: 'schema' '=' text | valueKey '=' value;
valueKey: 'headerVars' | 'tables' | 'otherTables' | 'blocks' | 'entities';
text: STRING | IDENT;
value: STRING | NUMBER | IDENT | '[' value* ']' | '{' member* '}';
member: (IDENT | STRING | valueKey | 'schema') '=' value;
NUMBER: '-'? [0-9]+ ('.' [0-9]+)? ([eE] [+-]? [0-9]+)?;
IDENT: [a-zA-Z_] [a-zA-Z_0-9.]*;
STRING: '"' ('\\' . | ~["\\])* '"';
WS: [ \t\r\n]+ -> skip;
