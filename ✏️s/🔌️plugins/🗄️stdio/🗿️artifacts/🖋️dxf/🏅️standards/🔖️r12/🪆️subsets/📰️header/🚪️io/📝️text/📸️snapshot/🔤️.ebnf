(* Complete owned DXF snapshot text; six roots are required by RecordSpec. *)
document = 'stdio.dxf', { field } ;
field = 'schema', '=', text | value_key, '=', value ;
value_key = 'headerVars' | 'tables' | 'otherTables' | 'blocks' | 'entities' ;
text = string | identifier ;
value = string | number | 'true' | 'false' | 'null' | array | object ;
array = '[', { value }, ']' ;
object = '{', { member }, '}' ;
member = ( identifier | string ), '=', value ;
number = ? exact semio.dsl signed integer or binary64 scalar including IEEE words ? ;
string = ? semio.dsl quoted UTF-8 string with escapes ? ;
identifier = ? semio.dsl unquoted owner field or text token ? ;
