module Stdio_dxf_diff;

# DxfDiff's wire binary IS its serde_json encoding (protocol::OpBinary); the shared
# `.semio` envelope wraps that JSON payload.
type Document = unit {
    magic: bytes &size=8;
    token_len: uint32 &byte-order=spicy::ByteOrder::Little;
    token: bytes &size=self.token_len;   # UTF-8 "stdio.dxf.diff v1"
    payload: bytes &eod;                 # UTF-8 JSON bytes of DxfDiff
};
