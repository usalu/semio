{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/stdio/dxf/r12/header/mutation/set-linetype/schema.json",
  "title": "SetLinetype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "linetype"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "linetype": {
      "$ref": "#/$defs/DxfLinetype"
    },
    "mutation": {
      "const": "setLinetype",
      "description": "Aggregate discriminator spliced in by DxfMutation; absent when the payload stands alone."
    }
  },
  "$defs": {
    "DxfLinetype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "flags",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "flags": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "description": {
          "type": "string"
        },
        "unknownGroupCodes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              {
                "$ref": "#/$defs/DxfValue"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "DxfValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "str"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "double"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "point"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      ]
    }
  }
}
