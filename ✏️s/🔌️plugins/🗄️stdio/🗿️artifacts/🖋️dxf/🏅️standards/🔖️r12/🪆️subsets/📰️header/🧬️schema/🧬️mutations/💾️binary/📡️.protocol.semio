dialect protocol
protocol stdio.dxf.mutations
version 1
schema stdio.dxf
start record
framing record

# Real `DxfMutation` op frame: `format u8` (`OP_BINARY_FORMAT`) then `tag u8`, then the kind's own payload.
# Each record is one mutation kind at its wire tag. This file is the only source of those tags: the codec
# derives every tag from these records at compile time (`dsl::protocol_record::tag_u8`).
header fixed 2
field format u8
field tag u8
record set-snapshot tag=0
field payload bytes
record set-header-var tag=1
field payload bytes
record remove-header-var tag=2
field payload bytes
record insert-layer tag=3
field payload bytes
record remove-layer tag=4
field payload bytes
record set-layer tag=5
field payload bytes
record insert-style tag=6
field payload bytes
record remove-style tag=7
field payload bytes
record set-style tag=8
field payload bytes
record insert-linetype tag=9
field payload bytes
record remove-linetype tag=10
field payload bytes
record set-linetype tag=11
field payload bytes
record insert-entity tag=12
field payload bytes
record remove-entity tag=13
field payload bytes
record set-entity tag=14
field payload bytes
record insert-block tag=15
field payload bytes
record remove-block tag=16
field payload bytes
record set-block tag=17
field payload bytes
