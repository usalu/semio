{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/stdio/dxf/r12/header/mutation/set-header-var/schema.json",
  "title": "SetHeaderVar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "name",
    "headerVar"
  ],
  "properties": {
    "mutation": {
      "const": "setHeaderVar",
      "description": "Aggregate discriminator spliced in by DxfMutation; absent when the payload stands alone."
    },
    "name": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Header variable",
          "de": "Systemvariable"
        },
        "description": {
          "en": "Name including $, e.g. $ACADVER.",
          "de": "Name mit $, z. B. $ACADVER."
        },
        "ref": {
          "kind": "headerVariable",
          "domain": "dxf"
        },
        "group": "target",
        "order": 10
      }
    },
    "headerVar": {
      "$ref": "#/$defs/DxfHeaderVar",
      "x-semio-ui": {
        "label": {
          "en": "Header variable",
          "de": "Systemvariable"
        },
        "group": "value",
        "order": 20
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "label": {
          "en": "Index",
          "de": "Position"
        },
        "description": {
          "en": "Position to create the variable at; absent appends. Ignored when the name already exists.",
          "de": "Position, an der die Variable angelegt wird; ohne Angabe wird angehängt. Wird ignoriert, wenn der Name bereits existiert."
        },
        "group": "target",
        "order": 20
      }
    }
  },
  "$defs": {
    "DxfHeaderVar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "groupCode",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "groupCode": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "x-semio-ui": {
            "label": {
              "en": "Group code",
              "de": "Gruppencode"
            }
          }
        },
        "value": {
          "$ref": "#/$defs/DxfValue",
          "x-semio-ui": {
            "label": {
              "en": "Value",
              "de": "Wert"
            }
          }
        },
        "extraGroupCodes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              {
                "$ref": "#/$defs/DxfValue"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "x-semio-ui": {
            "label": {
              "en": "Additional group codes",
              "de": "Zusätzliche Gruppencodes"
            }
          }
        }
      }
    },
    "DxfValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "str"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "int"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "double"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "point"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      ]
    }
  }
}
