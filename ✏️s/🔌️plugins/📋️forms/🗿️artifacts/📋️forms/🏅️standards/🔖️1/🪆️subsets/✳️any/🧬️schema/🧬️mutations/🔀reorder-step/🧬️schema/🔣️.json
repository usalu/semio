{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/forms/forms/mutation/reorder-step/schema.json",
  "title": "ReorderStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "toIndex"
  ],
  "properties": {
    "mutation": {
      "const": "reorderStep"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Step",
          "de": "Schritt"
        },
        "description": {
          "en": "The form step this mutation addresses.",
          "de": "Der Formularschritt, den diese Mutation adressiert."
        },
        "ref": {
          "kind": "step",
          "domain": "fields",
          "granularity": "section"
        },
        "group": "target",
        "order": 10
      }
    },
    "toIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "New index",
          "de": "Neuer Index"
        },
        "description": {
          "en": "Position in the list after the move.",
          "de": "Position in der Liste nach dem Verschieben."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 20
      }
    }
  }
}
