{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/forms/forms/definition.json",
  "title": "FormsDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps"
  ],
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      }
    }
  },
  "$defs": {
    "Expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "const",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "value": {
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Value",
                  "de": "Wert"
                },
                "group": "condition",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Constant",
              "de": "Konstante"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "var",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "name": {
              "type": "string",
              "x-semio-ui": {
                "widget": "text",
                "role": "value",
                "label": {
                  "en": "Question",
                  "de": "Frage"
                },
                "description": {
                  "en": "Id of the question whose answer is read.",
                  "de": "ID der Frage, deren Antwort gelesen wird."
                },
                "group": "condition",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Answer of",
              "de": "Antwort von"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "eq",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "left": {
              "$ref": "#/$defs/Expression",
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Left",
                  "de": "Links"
                },
                "group": "condition",
                "order": 20
              }
            },
            "right": {
              "$ref": "#/$defs/Expression",
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Right",
                  "de": "Rechts"
                },
                "group": "condition",
                "order": 30
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Equals",
              "de": "Gleich"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expr"
          ],
          "properties": {
            "kind": {
              "const": "truthy",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "expr": {
              "$ref": "#/$defs/Expression",
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Expression",
                  "de": "Ausdruck"
                },
                "group": "condition",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Is set",
              "de": "Ist gesetzt"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "and",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Conditions",
                  "de": "Bedingungen"
                },
                "group": "condition",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "All of",
              "de": "Alle von"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "or",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Conditions",
                  "de": "Bedingungen"
                },
                "group": "condition",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Any of",
              "de": "Eines von"
            }
          }
        }
      ]
    },
    "Question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique question id in this form.",
              "de": "Eindeutige Fragen-ID in diesem Formular."
            },
            "group": "identity",
            "order": 10
          }
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Question type",
              "de": "Fragetyp"
            },
            "description": {
              "en": "For example text or number.",
              "de": "Zum Beispiel text (Text) oder number (Zahl)."
            },
            "group": "kind",
            "order": 20
          }
        },
        "label": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Label",
              "de": "Beschriftung"
            },
            "group": "content",
            "order": 30
          }
        },
        "required": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Required",
              "de": "Pflichtfeld"
            },
            "description": {
              "en": "The form cannot be submitted without an answer.",
              "de": "Das Formular kann ohne Antwort nicht übermittelt werden."
            },
            "group": "validation",
            "order": 40
          }
        },
        "default": {
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Default",
              "de": "Standardwert"
            },
            "description": {
              "en": "Answer used until the respondent answers.",
              "de": "Antwort, die gilt, bis die befragte Person antwortet."
            },
            "group": "value",
            "order": 50
          }
        },
        "params": {
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Parameters",
              "de": "Parameter"
            },
            "description": {
              "en": "Extra settings of the question type, any JSON value.",
              "de": "Zusätzliche Einstellungen des Fragetyps, ein beliebiger JSON-Wert."
            },
            "group": "kind",
            "order": 60
          }
        },
        "condition": {
          "$ref": "#/$defs/Expression",
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Condition",
              "de": "Bedingung"
            },
            "description": {
              "en": "The question is shown only while this expression holds.",
              "de": "Die Frage wird nur angezeigt, solange dieser Ausdruck gilt."
            },
            "group": "condition",
            "order": 70
          }
        },
        "description": {
          "type": "string",
          "x-semio-ui": {
            "widget": "multiline",
            "role": "value",
            "label": {
              "en": "Description",
              "de": "Beschreibung"
            },
            "group": "content",
            "order": 80
          }
        },
        "placeholder": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Placeholder",
              "de": "Platzhalter"
            },
            "group": "content",
            "order": 90
          }
        },
        "unit": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Unit",
              "de": "Einheit"
            },
            "description": {
              "en": "Unit shown next to a number answer.",
              "de": "Einheit neben einer Zahlenantwort."
            },
            "group": "content",
            "order": 100
          }
        },
        "text": {
          "type": "string",
          "x-semio-ui": {
            "widget": "multiline",
            "role": "value",
            "label": {
              "en": "Text",
              "de": "Text"
            },
            "description": {
              "en": "Static text of an information block.",
              "de": "Fester Text eines Informationsblocks."
            },
            "group": "content",
            "order": 110
          }
        },
        "schema": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Schema",
              "de": "Schema"
            },
            "description": {
              "en": "Schema id the answer follows.",
              "de": "Schema-ID, der die Antwort folgt."
            },
            "group": "source",
            "order": 120
          }
        },
        "src": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Source",
              "de": "Quelle"
            },
            "description": {
              "en": "Address of the file, e.g. an https or data URL.",
              "de": "Adresse der Datei, z. B. eine https- oder data-URL."
            },
            "group": "source",
            "order": 130
          }
        },
        "accept": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Accepted files",
              "de": "Akzeptierte Dateien"
            },
            "description": {
              "en": "File types an upload accepts, e.g. image/*.",
              "de": "Dateitypen, die ein Upload annimmt, z. B. image/*."
            },
            "group": "source",
            "order": 140
          }
        },
        "exampleId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Fixture slug",
              "de": "Fixture-Kürzel"
            },
            "description": {
              "en": "Slug of the bundled fixture the question draws its data from.",
              "de": "Kürzel der mitgelieferten Fixture, aus der die Frage ihre Daten bezieht."
            },
            "group": "source",
            "order": 150
          }
        },
        "min": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Minimum",
              "de": "Minimum"
            },
            "description": {
              "en": "Smallest accepted number.",
              "de": "Kleinste zulässige Zahl."
            },
            "step": 1,
            "precision": 2,
            "group": "validation",
            "order": 160
          }
        },
        "max": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Maximum",
              "de": "Maximum"
            },
            "description": {
              "en": "Largest accepted number.",
              "de": "Größte zulässige Zahl."
            },
            "step": 1,
            "precision": 2,
            "group": "validation",
            "order": 170
          }
        },
        "step": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Step",
              "de": "Schrittweite"
            },
            "description": {
              "en": "Increment of a number answer.",
              "de": "Schrittweite einer Zahlenantwort."
            },
            "step": 0.1,
            "precision": 2,
            "group": "validation",
            "order": 180
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Value",
                    "de": "Wert"
                  },
                  "group": "choices",
                  "order": 10
                }
              },
              "label": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Label",
                    "de": "Beschriftung"
                  },
                  "group": "choices",
                  "order": 20
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Options",
              "de": "Optionen"
            },
            "group": "choices",
            "order": 190
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Key",
                    "de": "Schlüssel"
                  },
                  "group": "choices",
                  "order": 10
                }
              },
              "label": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Label",
                    "de": "Beschriftung"
                  },
                  "group": "choices",
                  "order": 20
                }
              },
              "value": {
                "type": "number",
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Value",
                    "de": "Wert"
                  },
                  "step": 1,
                  "precision": 2,
                  "group": "choices",
                  "order": 30
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Fields",
              "de": "Felder"
            },
            "group": "choices",
            "order": 200
          }
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique step id in this form.",
              "de": "Eindeutige Schritt-ID in diesem Formular."
            },
            "group": "identity",
            "order": 10
          }
        },
        "title": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Title",
              "de": "Titel"
            },
            "group": "identity",
            "order": 20
          }
        },
        "description": {
          "type": "string",
          "x-semio-ui": {
            "widget": "multiline",
            "role": "value",
            "label": {
              "en": "Description",
              "de": "Beschreibung"
            },
            "group": "content",
            "order": 30
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Question"
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Questions",
              "de": "Fragen"
            },
            "group": "content",
            "order": 40
          }
        }
      }
    }
  }
}
