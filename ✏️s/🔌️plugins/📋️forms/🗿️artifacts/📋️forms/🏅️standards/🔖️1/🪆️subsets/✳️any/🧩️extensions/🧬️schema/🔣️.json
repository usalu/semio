{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/forms/extension-render",
  "type": "object",
  "required": [
    "params",
    "authoredParams",
    "questionId",
    "controllerId",
    "surface",
    "interactive"
  ],
  "additionalProperties": false,
  "properties": {
    "exampleId": {
      "type": "string"
    },
    "params": {},
    "questionId": {
      "type": "string",
      "minLength": 1
    },
    "controllerId": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "blueprint",
        "try"
      ]
    },
    "interactive": {
      "type": "boolean"
    },
    "windowId": {
      "type": "string",
      "minLength": 1
    },
    "windowKindId": {
      "const": "forms-try"
    },
    "authoredParams": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "surface": {
            "const": "try"
          },
          "interactive": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "windowId",
          "windowKindId"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "windowId"
            ]
          },
          {
            "required": [
              "windowKindId"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "windowId",
          "windowKindId"
        ],
        "properties": {
          "surface": {
            "const": "try"
          }
        }
      }
    }
  ]
}
