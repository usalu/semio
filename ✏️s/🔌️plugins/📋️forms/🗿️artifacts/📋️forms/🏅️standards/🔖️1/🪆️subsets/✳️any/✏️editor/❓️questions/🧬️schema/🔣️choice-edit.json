{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:forms.choiceEdit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "option",
    "field",
    "value"
  ],
  "properties": {
    "option": {
      "type": "string"
    },
    "field": {
      "enum": [
        "label",
        "value",
        "remove",
        "default"
      ]
    },
    "value": {
      "anyOf": [{ "type": "string" }, { "type": "boolean" }, { "type": "null" }]
    }
  }
}
