dialect grammar
grammar forms.forms
extension forms
start document
comment none

document = "semio" "forms.form.dsl" "v1" snapshot
snapshot = "schema" "=" text "id" "=" text "version" "=" text {"title" "=" text}? "structure" "=" child "results" "=" child "steps" "=" "[" step* "]" "responses" "=" "[" response* "]" "values" "=" "[" value* "]" "conditions" "=" "[" condition* "]"
child = "child_id" "=" text "target" "=" reference
reference = "artifact-id" "=" text "artifact-kind" "=" text "standard" "=" text "subset" "=" text
step = "{" "id" "=" text "title" "=" text {"description" "=" text}? "questions" "=" "[" question* "]" "}"
question = "{" "id" "=" text "label" "=" text "kind" "=" text {"description" "=" text}? {"required" "=" boolean}? {"placeholder" "=" text}? {"default" "=" INT}? {"min" "=" number}? {"max" "=" number}? {"step" "=" number}? {"unit" "=" text}? {"text" "=" text}? {"options" "=" "[" option* "]"}? {"fields" "=" "[" vector* "]"}? {"schema" "=" text}? {"src" "=" text}? {"accept" "=" text}? {"fixture-slug" "=" text}? {"params" "=" INT}? {"condition" "=" INT}? "}"
option = "{" "value" "=" text "label" "=" text "}"
vector = "{" "key" "=" text {"label" "=" text}? {"value" "=" number}? "}"
response = "{" "id" "=" text "submitted-at" "=" INT "definition-version" "=" text "answers" "=" "[" answer* "]" "}"
answer = "{" "question-id" "=" text "label" "=" text "kind" "=" text "value" "=" INT "}"
value = "{" "kind" "=" value-kind {"boolean" "=" boolean}? {"unsigned" "=" INT}? {"signed" "=" INT}? {"float-bits" "=" INT}? {"text" "=" text}? {"bytes" "=" text}? "items" "=" "[" INT* "]" "members" "=" "[" member* "]" "}"
member = "{" "name" "=" text "value" "=" INT "}"
condition = "{" "kind" "=" condition-kind {"value" "=" INT}? {"name" "=" text}? {"left" "=" INT}? {"right" "=" INT}? {"expression" "=" INT}? "items" "=" "[" INT* "]" "}"
value-kind = "null" | "boolean" | "unsigned" | "signed" | "float" | "text" | "bytes" | "array" | "object"
condition-kind = "const" | "var" | "eq" | "and" | "or" | "truthy"
boolean = "true" | "false"
number = FLOAT | INT | IDENT
text = IDENT | TEXT
