dialect grammar
grammar forms.forms
extension forms
use family-scene
start document

# Real grammar for `FormsSnapshot::print_dsl`/`parse_dsl`: the derived spec-driven text of
# `FormsSnapshot`'s own `dsl::DslRecord` spec (📝️text/🦀️.rs), the same record the pack encodes.
# Fields are space-separated `key=value` tokens in any order; `title` is optional. A composed child
# handle is the `ArtifactChild` record printed inline:
# `child_id=<id> target=<artifactId>!<kind>@<standard>/<subset>`. A parsed document must also pass
# `FormsSnapshot::validate`.
artifact-mark = "semio forms.form.dsl v1"
document = artifact-mark field*
field = {"schema" "=" TEXT} | {"id" "=" TEXT} | {"version" "=" TEXT} | {"title" "=" TEXT} | {"structure" "=" child-handle} | {"results" "=" child-handle}
child-handle = {"child_id" "=" TEXT} {"target" "=" TEXT}
