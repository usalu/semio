{
  "base": {
    "contributionsJson": "[]"
  },
  "cases": [
    {
      "kind": "replace-config",
      "mutation": {
        "ReplaceConfig": {
          "config": {
            "contributionsJson": "[{\"pluginId\":\"replace\"}]"
          }
        }
      },
      "expected": {
        "contributionsJson": "[{\"pluginId\":\"replace\"}]"
      },
      "errors": 0
    },
    {
      "kind": "set-contributions",
      "mutation": {
        "SetContributions": {
          "json": "[{\"pluginId\":\"set\"}]"
        }
      },
      "expected": {
        "contributionsJson": "[{\"pluginId\":\"set\"}]"
      },
      "errors": 0
    }
  ]
}
