{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/forms/forms/mutation/replace-block/schema.json",
  "title": "ReplaceBlock",
  "type": "object",
  "additionalProperties": false,
