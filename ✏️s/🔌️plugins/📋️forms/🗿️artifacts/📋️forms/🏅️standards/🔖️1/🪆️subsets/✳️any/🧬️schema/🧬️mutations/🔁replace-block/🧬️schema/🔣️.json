        },
        "group": "target",
        "order": 10
      }
    },
    "block": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/forms/forms/definition.json#/$defs/Question",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Question",
          "de": "Frage"
        },
        "description": {
          "en": "The question that replaces the one with the same id.",
          "de": "Die Frage, die die gleichnamige ersetzt."
