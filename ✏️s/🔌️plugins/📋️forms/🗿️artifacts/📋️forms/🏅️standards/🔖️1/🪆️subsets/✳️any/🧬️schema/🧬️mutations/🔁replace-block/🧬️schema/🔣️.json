      "const": "replaceBlock"
    },
    "stepId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Step",
          "de": "Schritt"
        },
        "description": {
          "en": "The form step this mutation addresses.",
          "de": "Der Formularschritt, den diese Mutation adressiert."
