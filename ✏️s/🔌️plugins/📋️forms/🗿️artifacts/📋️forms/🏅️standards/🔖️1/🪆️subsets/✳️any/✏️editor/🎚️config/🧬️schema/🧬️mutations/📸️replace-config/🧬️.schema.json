      "type": "object",
      "properties": {
        "currentStepIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "tryValues": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "locale": {
          "type": "string"
        },
        "contributionsJson": {
          "type": "string"
        }
      },
      "required": [
        "currentStepIndex",
        "tryValues",
        "locale",
        "contributionsJson"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "config"
  ],
  "additionalProperties": false
}
