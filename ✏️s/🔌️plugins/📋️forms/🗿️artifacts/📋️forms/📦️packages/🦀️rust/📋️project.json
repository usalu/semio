{
  "name": "@semio-tech/forms-forms-rs",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:artifact",
    "family:forms"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "verify-forms-document-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts verify forms-document-contract",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "forms-document-contract"
          ]
        }
      }
    },
    "test-snapshot-sqlite": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/**/*",
        "🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*",
        "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite ",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "forms-test-snapshot-sqlite"
          ]
        }
      }
    },
    "test-snapshot-sqlite-native": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/**/*",
        "🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*",
        "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite native",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "forms-test-snapshot-sqlite-native"
          ]
        }
      }
    },
    "test-snapshot-sqlite-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/**/*",
        "🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*",
        "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📋️forms/🗿️artifacts/📋️forms/📦️packages/🦀️rust",
