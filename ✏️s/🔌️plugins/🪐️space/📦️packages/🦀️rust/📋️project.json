      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🪐️space/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts home-directory-projection-persistence-check"
      }
    },
    "home-directory-projection-persistence-native-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🪐️space/📦️packages/🦀️rust",
