{
  "name": "@semio-tech/space-plugin",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/✏️s/🔌️plugins/🪐️space/**/*.rs",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "home-directory-identity-rows-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🪐️space/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts home-directory-identity-rows-check"
      }
    },
    "home-directory-identity-rows-native-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🪐️space/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts home-directory-identity-rows-check --native"
      }
    },
    "plugin-identity-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🪐️space/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts plugin-identity-check"
      }
    },
    "interactive-job-catalog-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🪐️space/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts interactive-job-catalog-check"
      }
    },
    "interactive-job-catalog-native-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🪐️space/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts interactive-job-catalog-check --native"
      }
    },
    "home-directory-event-page-owner-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/🪐️space/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts home-directory-event-page-owner-check"
