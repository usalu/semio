{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Space Fixture Source Admission",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/SpaceFixtureSource"
  },
  "$defs": {
    "SpaceFixtureSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "format",
        "codec",
        "text"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "json",
            "dsl"
          ]
        },
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
