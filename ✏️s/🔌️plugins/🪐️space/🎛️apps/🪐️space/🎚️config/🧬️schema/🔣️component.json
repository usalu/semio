{
  "$id": "https://semio.tech/schema/app/space/space/config.json",
  "title": "SpaceConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera",
    "selectedNodeIds",
    "collapsedNodeIds",
    "previewOffNodeIds",
    "clipboardNodeIds",
    "workflowEngagementInput",
    "compiledDagEngagementInput",
    "activePanelTab",
    "locale"
  ],
  "properties": {
    "camera": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/SpaceWindowCamera"
      },
      "x-semio-state": "config"
    },
    "selectedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "hoveredNodeId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "collapsedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "previewOffNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "activeNodeId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "focusedNodeId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "clipboardNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "workflowEngagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "compiledDagEngagementInput": {
      "type": "string",
      "x-semio-state": "config"
    },
    "pendingImportNodeId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "pendingImportFormat": {
      "type": "string",
      "x-semio-state": "config"
    },
    "activePanelTab": {
      "type": "string",
      "x-semio-state": "config"
    },
    "spaceId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "clientId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "clientName": {
      "type": "string",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "SpaceWindowCamera": {
      "title": "SpaceWindowCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
