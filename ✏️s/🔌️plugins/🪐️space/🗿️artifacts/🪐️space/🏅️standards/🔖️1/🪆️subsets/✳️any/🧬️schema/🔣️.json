{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/space/space/artifact.json",
  "title": "SSpaceArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spaceId",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "spaceId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SpaceArtifactRow"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "SpaceArtifactDialect": {
      "title": "SpaceArtifactDialect",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "subset": {
          "type": "string"
        }
      }
    },
    "SpaceArtifactRow": {
      "title": "SpaceArtifactRow",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kindId",
        "schema",
        "dialect",
        "createdAtMs",
        "createdBy",
        "updatedAtMs",
        "updatedBy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kindId": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "dialect": {
          "$ref": "#/$defs/SpaceArtifactDialect"
        },
        "createdAtMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "createdBy": {
          "type": "string"
        },
        "updatedAtMs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "updatedBy": {
          "type": "string"
        }
      }
    }
  }
}
