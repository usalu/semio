{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/space/space/mutation/rename-artifact/schema.json",
  "title": "RenameArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newName"
  ],
  "properties": {
    "mutation": {
      "const": "renameArtifact"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Artifact",
          "de": "Artefakt"
        },
        "description": {
          "en": "The artifact this mutation addresses.",
          "de": "Das Artefakt, das diese Mutation adressiert."
        },
        "ref": {
          "kind": "artifact"
        }
      }
    },
    "newName": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "New Name",
          "de": "Neuer Name"
        },
        "description": {
          "en": "Name the artifact shows from now on.",
          "de": "Name, den das Artefakt von nun an trägt."
        }
      }
    }
  }
}
