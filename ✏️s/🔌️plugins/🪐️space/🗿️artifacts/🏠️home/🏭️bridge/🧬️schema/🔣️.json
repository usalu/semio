{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "producedBy",
    "refusedArtifacts",
    "excludedOwnerSegments",
    "aggregates",
    "coordinates"
  ],
  "properties": {
    "artifact": {
      "const": "s.space.home"
    },
    "producedBy": {
      "const": "semio-space-mutation-bridge"
    },
    "refusedArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "const": [
        "s.space.space"
      ]
    },
    "excludedOwnerSegments": {
      "const": [
        "👁️viewer",
        "✏️editor"
      ]
    },
    "aggregates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "standard",
          "subset",
          "surface",
          "owner"
        ],
        "properties": {
          "artifact": {
            "type": "string"
          },
          "standard": {
            "const": "1"
          },
          "subset": {
            "const": "any"
          },
          "surface": {
            "const": ""
          },
          "owner": {
            "type": "string"
          }
        }
      }
    }
  }
}
