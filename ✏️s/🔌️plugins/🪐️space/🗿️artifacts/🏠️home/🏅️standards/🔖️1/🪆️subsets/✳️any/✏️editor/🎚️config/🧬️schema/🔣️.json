{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/space/home/config/schema.json",
  "title": "HomeConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activePanelTab",
    "directoryJson",
    "directorySessionBindingSha256",
    "directoryAuthorizationGeneration",
    "directoryReceiptSha256",
    "clientId",
    "clientName"
  ],
  "properties": {
    "activePanelTab": {
      "type": "string",
      "x-semio-state": "config"
    },
    "directoryJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "directorySessionBindingSha256": {
      "type": "string",
      "x-semio-state": "config"
    },
    "directoryAuthorizationGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-semio-state": "config"
    },
    "directoryReceiptSha256": {
      "type": "string",
      "x-semio-state": "config"
    },
    "clientId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "clientName": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "HomeProjectionPersistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "wire",
        "expectedDocumentIds",
        "expectedIndexedDocumentIds",
        "malformed"
      ],
      "properties": {
        "schema": {
          "const": "semio.space.home.directory-projection-persistence/v1"
        },
        "wire": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spaces",
            "cursor",
            "users"
          ],
          "properties": {
            "spaces": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "view",
                  "members",
                  "documents",
                  "indexedDocuments"
                ],
                "properties": {
                  "view": {
                    "$ref": "#/$defs/HomeProjectionPersistenceSpaceView"
                  },
                  "members": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/HomeProjectionPersistenceMemberView"
                    }
                  },
                  "documents": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/HomeProjectionPersistenceDocumentDescriptor"
                    }
                  },
                  "indexedDocuments": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/HomeProjectionPersistenceIndexedDocument"
                    }
                  }
                }
              }
            },
            "cursor": {
              "const": 3
            },
            "users": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/HomeProjectionPersistenceUserView"
              }
            }
          }
        },
        "expectedDocumentIds": {
          "const": [
            "document-雪"
          ]
        },
        "expectedIndexedDocumentIds": {
          "const": [
            "document-雪"
          ]
        },
        "malformed": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "title": "HomeProjectionPersistence",
      "description": "The Home directory projection persistence wire law: the retained `directoryJson` read model must round-trip every document and indexed document, and corruption must be explicit rather than defaulted.",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeProjectionPersistenceSpaceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "visibility",
        "ownerUserId",
        "role",
        "memberCount",
        "documentCount",
        "activeConnections",
        "createdAtMs",
        "updatedAtMs"
      ],
      "properties": {
        "id": {
          "const": "space-α"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "archive",
            "atelier",
            "catalog",
            "library",
            "portfolio",
            "studio"
          ]
        },
        "visibility": {
          "enum": [
            "private",
            "public",
            "unlisted"
          ]
        },
        "ownerUserId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "author",
            "spectator"
          ]
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0
        },
        "documentCount": {
          "const": 1
        },
        "activeConnections": {
          "type": "integer",
          "minimum": 0
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAtMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeProjectionPersistenceMemberView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "email",
        "displayName",
        "role"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "author",
            "spectator"
          ]
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeProjectionPersistenceUserView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "email",
        "displayName",
        "createdAtMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeProjectionPersistenceIndexedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor",
        "descriptorDigestV1",
        "entry",
        "createdAtMs",
        "createdBy"
      ],
      "properties": {
        "descriptor": {
          "$ref": "#/$defs/HomeProjectionPersistenceDocumentDescriptor"
        },
        "descriptorDigestV1": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "dialect"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "dialect": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifactKind",
                "standard",
                "subset"
              ],
              "properties": {
                "artifactKind": {
                  "type": "string",
                  "minLength": 1
                },
                "standard": {
                  "type": "string",
                  "minLength": 1
                },
                "subset": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeProjectionPersistenceDocumentDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId",
        "artifactKind",
        "artifactSchema",
        "owner",
        "packSchemaHash",
        "bootstrapVersion",
        "bootstrapFrontier",
        "bootstrapSnapshotHash"
      ],
      "properties": {
        "spaceId": {
          "const": "space-α"
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "artifactKind": {
          "type": "string",
          "minLength": 1
        },
        "artifactSchema": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pluginId",
            "packageId",
            "version",
            "packageHash"
          ],
          "properties": {
            "pluginId": {
              "type": "string",
              "minLength": 1
            },
            "packageId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "packageHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "packSchemaHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bootstrapVersion": {
          "type": "integer",
          "minimum": 1
        },
        "bootstrapFrontier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headSeq",
            "commitSeq",
            "epoch"
          ],
          "properties": {
            "headSeq": {
              "type": "integer",
              "minimum": 0
            },
            "commitSeq": {
              "type": "integer",
              "minimum": 0
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "bootstrapSnapshotHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeDirectoryProjectionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sessionBindingSha256",
        "authorizationGeneration",
        "throughSeqInclusive",
        "receiptSha256"
      ],
      "properties": {
        "schema": {
          "const": "semio.space.home.directory-projection-receipt.v1"
        },
        "sessionBindingSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorizationGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "throughSeqInclusive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "title": "HomeDirectoryProjectionReceipt",
      "description": "🏠️ The directory-projection receipt the Home config surface publishes after applying one directory event page.",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
