{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.space.home.directory-projection-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sessionBindingSha256", "authorizationGeneration", "throughSeqInclusive", "receiptSha256"],
  "properties": {
    "schema": { "const": "semio.space.home.directory-projection-receipt.v1" },
    "sessionBindingSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorizationGeneration": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "throughSeqInclusive": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "receiptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
