{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "wire", "expectedDocumentIds", "malformed"],
  "properties": {
    "schema": { "const": "semio.space.home.directory-projection-persistence/v1" },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaces", "cursor", "users"],
      "properties": {
        "spaces": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "members", "documents"],
            "properties": {
              "view": { "$ref": "#/$defs/spaceView" },
              "members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/memberView" } },
              "documents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/documentDescriptor" } }
            }
          }
        },
        "cursor": { "const": 3 },
        "users": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/userView" }
        }
      }
    },
    "expectedDocumentIds": { "const": ["document-雪"] },
    "malformed": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "spaceView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "visibility", "ownerUserId", "role", "memberCount", "documentCount", "activeConnections", "createdAtMs", "updatedAtMs"],
      "properties": {
        "id": { "const": "space-α" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["archive", "atelier", "catalog", "library", "portfolio", "studio"] },
        "visibility": { "enum": ["private", "public", "unlisted"] },
        "ownerUserId": { "type": "string", "minLength": 1 },
        "role": { "enum": ["author", "spectator"] },
        "memberCount": { "type": "integer", "minimum": 0 },
        "documentCount": { "const": 1 },
        "activeConnections": { "type": "integer", "minimum": 0 },
        "createdAtMs": { "type": "integer", "minimum": 0 },
        "updatedAtMs": { "type": "integer", "minimum": 0 }
      }
    },
    "memberView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "email", "displayName", "role"],
      "properties": {
        "userId": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "role": { "enum": ["author", "spectator"] }
      }
    },
    "userView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "email", "displayName", "createdAtMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "createdAtMs": { "type": "integer", "minimum": 0 }
      }
    },
    "documentDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spaceId", "documentId", "artifactKind", "artifactSchema", "owner", "packSchemaHash", "bootstrapVersion", "bootstrapFrontier", "bootstrapSnapshotHash"],
      "properties": {
        "spaceId": { "const": "space-α" },
        "documentId": { "type": "string", "minLength": 1 },
        "artifactKind": { "type": "string", "minLength": 1 },
        "artifactSchema": { "type": "string", "minLength": 1 },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pluginId", "packageId", "version", "packageHash"],
          "properties": {
            "pluginId": { "type": "string", "minLength": 1 },
            "packageId": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "packageHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "packSchemaHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bootstrapVersion": { "type": "integer", "minimum": 1 },
        "bootstrapFrontier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headSeq", "commitSeq", "epoch"],
          "properties": {
            "headSeq": { "type": "integer", "minimum": 0 },
            "commitSeq": { "type": "integer", "minimum": 0 },
            "epoch": { "type": "integer", "minimum": 0 }
          }
        },
        "bootstrapSnapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
