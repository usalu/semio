{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/space/home/transient/schema.json",
  "title": "HomeTransient",
  "description": "🫧️ The Home launcher's app-local transient state: the folded hub directory projection (never persisted, shared or undone; rebuilt from the hub origin whenever a Home surface opens) with the authenticated resume authority of its last folded page — all empty before the first page.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionBindingSha256",
    "authorizationGeneration",
    "receiptSha256",
    "directory"
  ],
  "properties": {
    "sessionBindingSha256": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "authorizationGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "directory": {
      "$ref": "https://json.schemas.assets.semio-tech.com/os/directory/component.json#/$defs/DirectoryReadModel"
    }
  },
  "$defs": {
    "HomeDirectoryProjectionWireSpaceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "visibility",
        "ownerUserId",
        "role",
        "memberCount",
        "documentCount",
        "activeConnections",
        "createdAtMs",
        "updatedAtMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "archive",
            "atelier",
            "catalog",
            "library",
            "portfolio",
            "studio"
          ]
        },
        "visibility": {
          "enum": [
            "private",
            "public",
            "unlisted"
          ]
        },
        "ownerUserId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "author",
            "spectator"
          ]
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0
        },
        "documentCount": {
          "type": "integer",
          "minimum": 0
        },
        "activeConnections": {
          "type": "integer",
          "minimum": 0
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAtMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeDirectoryProjectionWireMemberView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "email",
        "displayName",
        "role"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "author",
            "spectator"
          ]
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeDirectoryProjectionWireUserView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "email",
        "displayName",
        "createdAtMs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeDirectoryProjectionWireIndexedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor",
        "descriptorDigestV1",
        "entry",
        "createdAtMs",
        "createdBy"
      ],
      "properties": {
        "descriptor": {
          "$ref": "#/$defs/HomeDirectoryProjectionWireDocumentDescriptor"
        },
        "descriptorDigestV1": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "dialect"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "dialect": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifactKind",
                "standard",
                "subset"
              ],
              "properties": {
                "artifactKind": {
                  "type": "string",
                  "minLength": 1
                },
                "standard": {
                  "type": "string",
                  "minLength": 1
                },
                "subset": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeDirectoryProjectionWireDocumentDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId",
        "artifactKind",
        "artifactSchema",
        "owner",
        "packSchemaHash",
        "bootstrapVersion",
        "bootstrapFrontier",
        "bootstrapSnapshotHash"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "artifactKind": {
          "type": "string",
          "minLength": 1
        },
        "artifactSchema": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pluginId",
            "packageId",
            "version",
            "packageHash"
          ],
          "properties": {
            "pluginId": {
              "type": "string",
              "minLength": 1
            },
            "packageId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "packageHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "packSchemaHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bootstrapVersion": {
          "type": "integer",
          "minimum": 1
        },
        "bootstrapFrontier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headSeq",
            "commitSeq",
            "epoch"
          ],
          "properties": {
            "headSeq": {
              "type": "integer",
              "minimum": 0
            },
            "commitSeq": {
              "type": "integer",
              "minimum": 0
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "bootstrapSnapshotHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeDirectoryProjectionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sessionBindingSha256",
        "authorizationGeneration",
        "throughSeqInclusive",
        "receiptSha256"
      ],
      "properties": {
        "schema": {
          "const": "semio.space.home.directory-projection-receipt.v1"
        },
        "sessionBindingSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorizationGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "throughSeqInclusive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "title": "HomeDirectoryProjectionReceipt",
      "description": "🏠️ The directory-projection receipt a Home surface publishes after folding one directory event page into its transient projection.",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "HomeDirectoryProjectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaces",
        "cursor",
        "users"
      ],
      "properties": {
        "spaces": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "view",
              "members",
              "documents",
              "indexedDocuments"
            ],
            "properties": {
              "view": {
                "$ref": "#/$defs/HomeDirectoryProjectionWireSpaceView"
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/HomeDirectoryProjectionWireMemberView"
                }
              },
              "documents": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/HomeDirectoryProjectionWireDocumentDescriptor"
                }
              },
              "indexedDocuments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/HomeDirectoryProjectionWireIndexedDocument"
                }
              }
            }
          }
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "users": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/HomeDirectoryProjectionWireUserView"
          }
        }
      }
    }
  }
}
