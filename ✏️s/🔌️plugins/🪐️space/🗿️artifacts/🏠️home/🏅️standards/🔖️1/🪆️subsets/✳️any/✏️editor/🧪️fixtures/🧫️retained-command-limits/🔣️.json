  "boundaryCases": [
    {
      "name": "empty",
      "bytes": 0,
      "accepted": true
    },
    {
      "name": "config-value-limit",
      "bytes": 512,
      "accepted": true
    },
    {
      "name": "config-value-overflow",
      "bytes": 513,
      "accepted": false
