      "disposition": "Migrated",
      "lanes": [
        "HostOnly"
      ],
      "blocker": ""
    },
    {
      "id": "deleteSpace",
      "disposition": "Migrated",
      "lanes": [
        "HostOnly"
      ],
      "blocker": ""
    },
    {
      "id": "renameSpace",
      "disposition": "BatchOnlyPendingRewrite",
