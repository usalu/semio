{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.space.plugin-identity/v1",
  "title": "Space plugin identity tuple",
  "description": "The one identity every authority of the OS host plugin must agree on: the Cargo component package, the plugin root builder id and package_id, the deployment catalog row, the generated registry row and the canonical artifact-kind owner segment. The playground variant that selects this plugin is a different name and is pinned here so the two can never be conflated again.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pluginId", "packageId", "packageName", "moduleDirectoryName", "artifactKindPrefix", "playgroundVariant", "host"],
  "properties": {
    "schema": { "const": "semio.space.plugin-identity/v1" },
    "pluginId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "packageId": { "type": "string", "pattern": "^semio:[a-z][a-z0-9-]*$" },
    "packageName": { "type": "string", "pattern": "^semio-s-plugin-[a-z0-9-]+$" },
    "moduleDirectoryName": { "type": "string", "minLength": 2 },
    "artifactKindPrefix": { "type": "string", "pattern": "^s\\.[a-z][a-z0-9-]*\\.$" },
    "playgroundVariant": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landingAppId", "hostAppId"],
      "properties": {
        "landingAppId": { "type": "string", "minLength": 1 },
        "hostAppId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
