{
  "$id": "https://semio.tech/schema/app/sequence/sequence/config.json",
  "title": "SequenceConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["selectedStepIds", "lastRunJson", "orientation", "camera", "locale"],
  "properties": {
    "selectedStepIds": {
      "type": "array",
      "items": { "type": "string" },
      "x-semio-state": "local-ui"
    },
    "lastRunJson": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "orientation": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "camera": {
      "$ref": "#/$defs/SequenceCamera",
      "x-semio-state": "local-ui"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "local-ui"
    }
  },
  "$defs": {
    "SequenceCamera": {
      "title": "SequenceCamera",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number", "format": "double" },
        "y": { "type": "number", "format": "double" },
        "zoom": { "type": "number", "format": "double" }
      }
    }
  }
}
