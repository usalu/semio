{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Sequence SQLite Ownership Laws",
 "type": "object",
 "additionalProperties": false,
 "required": ["snapshot", "malformedSql", "control"],
 "properties": {
  "snapshot": {"$ref": "https://json.schemas.assets.semio-tech.com/s/sequence/sequence/snapshot.json"},
  "malformedSql": {"type": "array", "minItems": 12, "items": {"type": "string"}},
  "control": {
   "type": "object", "additionalProperties": false,
   "required": ["largeTextBytes", "maxOwnedBytes", "tinyFileBytes"],
   "properties": {
    "largeTextBytes": {"type": "integer", "minimum": 65537},
    "maxOwnedBytes": {"type": "integer", "minimum": 1},
    "tinyFileBytes": {"type": "integer", "minimum": 1}
   }
  }
 }
}
