{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/sequence/sequence/snapshot.json",
  "title": "SequenceSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "steps",
    "edges"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/sequence/sequence/artifact.json#/$defs/SequenceStep"
      },
      "x-semio-state": "artifact"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/sequence/sequence/artifact.json#/$defs/SequenceEdge"
      },
      "x-semio-state": "artifact"
    }
  }
}
