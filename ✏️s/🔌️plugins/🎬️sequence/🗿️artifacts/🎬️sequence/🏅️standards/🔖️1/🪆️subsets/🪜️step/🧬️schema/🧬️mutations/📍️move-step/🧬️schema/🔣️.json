{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sequence/sequence/1/step/mutation/move-step/schema.json",
  "title": "MoveStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "x",
    "y"
  ],
  "properties": {
    "mutation": {
      "const": "moveStep"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Step",
          "de": "Schritt"
        },
        "description": {
          "en": "The step this mutation addresses.",
          "de": "Der Schritt, den diese Mutation adressiert."
        },
        "ref": {
          "kind": "step",
          "domain": "steps",
          "granularity": "step"
        }
      }
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    }
  }
}
