{
  "$id": "https://semio.tech/schema/s/sequence/sequence/inference.json",
  "title": "SequenceInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["topology"],
  "properties": {
    "topology": { "$ref": "#/$defs/SequenceTopology", "x-semio-state": "inferred" }
  },
  "$defs": {
    "SequenceTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topoOrder", "depth", "cycleFree", "nodeCount"],
      "properties": {
        "topoOrder": { "type": "array", "items": { "type": "string" } },
        "depth": { "type": "object", "additionalProperties": { "type": "integer" } },
        "cycleFree": { "type": "boolean" },
        "nodeCount": { "type": "integer" }
      }
    }
  }
}
