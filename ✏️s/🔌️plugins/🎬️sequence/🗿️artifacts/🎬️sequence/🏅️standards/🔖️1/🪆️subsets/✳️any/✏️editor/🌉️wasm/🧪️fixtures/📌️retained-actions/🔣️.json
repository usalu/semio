{
  "owner": "EditorApp<SequencePlayApp>",
  "controller": "s.sequence.sequence@1/*#editor",
  "documentSchema": "sequence.sequence",
  "runtimeLaws": {
    "maximumStepMicros": 7500,
    "cancellation": "perOperation",
    "freshness": "validateImmediatelyBeforeExposure",
    "retirement": "boundedAbandonClose",
    "replay": "operationOwnedCheckpoint",
    "artifactStoreAuthority": true,
    "configStoreAuthority": true
  },
  "locales": [
    "en",
    "de"
  ],
  "accessibility": {
    "progressAnnouncements": true,
    "cancellable": true,
    "keyboardReachable": true
  },
  "customization": {
    "orientation": true,
    "locale": true,
    "viewport": true
  },
  "persistentOracle": {
    "reorganize": {
      "orientation": "leftRight",
      "nodes": [
        "a",
        "b",
        "c"
      ],
      "edges": [
        [
          "a",
          "b"
        ],
        [
          "b",
          "c"
        ]
      ],
      "expected": [
        {
          "id": "a",
          "x": 0,
          "y": 0
        },
        {
          "id": "b",
          "x": 280,
          "y": 0
        },
        {
          "id": "c",
          "x": 560,
          "y": 0
        }
      ]
    },
    "nodeGraphEdit": {
      "baseSteps": [
        {
          "id": "a",
          "kind": "state.set"
        },
        {
          "id": "b",
          "kind": "log.print"
        }
      ],
      "baseEdges": [
        {
          "id": "e1",
          "from": "a",
          "to": "b"
        }
      ],
      "targetSteps": [
        {
          "id": "a",
          "kind": "math.add"
        },
        {
          "id": "c",
          "kind": "log.print"
        }
      ],
      "targetEdges": [
        {
          "id": "e2",
          "from": "a",
          "to": "c"
        }
      ],
      "expectedMutations": [
        "DeleteStep:b",
        "DeleteStep:a",
        "CreateStep:a",
        "CreateStep:c",
        "ConnectSteps:e2"
      ]
    },
    "run": {
      "nodes": [
        "set",
        "log"
      ],
      "edges": [
        [
          "set",
          "log"
        ]
      ],
      "expectedOrder": [
        "set",
        "log"
      ]
    }
  },
  "routes": [
