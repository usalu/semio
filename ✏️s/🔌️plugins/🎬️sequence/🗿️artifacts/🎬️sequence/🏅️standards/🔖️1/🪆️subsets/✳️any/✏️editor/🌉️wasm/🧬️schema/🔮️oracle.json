{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://sequence.browser-abi/oracle/v1",
  "type": "object",
  "required": ["version", "feature", "operation", "requestId", "generation", "session", "input", "semantic"],
  "properties": {
    "version": { "const": 1 },
    "feature": { "const": "editing" },
    "operation": { "const": 2305 },
    "requestId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "session": {
      "type": "object",
      "required": ["slot", "generation"],
      "properties": {
        "slot": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "generation": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["kind", "x", "y", "picked"],
      "properties": {
        "kind": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "picked": { "type": "null" }
      },
      "additionalProperties": false
    },
    "semantic": { "const": "step-101" }
  },
  "additionalProperties": false
}
