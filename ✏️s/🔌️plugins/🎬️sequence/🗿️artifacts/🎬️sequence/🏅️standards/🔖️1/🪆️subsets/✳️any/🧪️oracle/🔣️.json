  "$schema": "../../../../../../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/🧪️test/🧬️schema/🔣️.json",
  "schemaVersion": 2,
  "_comment": "🎬️ One direct semantic vocabulary spans schema payloads and IO codecs. Direct descriptors and payload owners correspond to the transparent SequenceMutation aggregate, the leaf-derived vocabulary, and the reachable specification vectors below.",
  "oracles": [
    {
      "id": "csv-rfc4180-reader",
      "kind": "third-party-library",
      "ecosystem": "rust",
      "package": "csv",
      "version": "1.4.0",
      "source": {
        "repository": "https://github.com/BurntSushi/rust-csv",
