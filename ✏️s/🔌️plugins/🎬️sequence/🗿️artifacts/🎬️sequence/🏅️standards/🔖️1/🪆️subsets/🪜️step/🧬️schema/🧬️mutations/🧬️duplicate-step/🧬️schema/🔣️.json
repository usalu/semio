{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/sequence/sequence/1/step/mutation/duplicate-step.json",
  "title": "DuplicateStep",
  "$ref": "#/$defs/Payload",
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "newId",
        "x",
        "y"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "newId": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "Wire": {
      "title": "DuplicateStepMutation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "sourceId",
        "newId",
        "x",
        "y"
      ],
      "properties": {
        "mutation": {
          "const": "duplicateStep"
        },
        "sourceId": {
          "$ref": "#/$defs/Payload/properties/sourceId"
        },
        "newId": {
          "$ref": "#/$defs/Payload/properties/newId"
        },
        "x": {
          "$ref": "#/$defs/Payload/properties/x"
        },
        "y": {
          "$ref": "#/$defs/Payload/properties/y"
        }
      }
    }
  }
}
