{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sequence/sequence/1/step/mutation/duplicate-step/schema.json",
  "title": "DuplicateStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "sourceId",
    "newId",
    "x",
    "y"
  ],
  "properties": {
    "mutation": {
      "const": "duplicateStep"
    },
    "sourceId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Source Step",
          "de": "Quellschritt"
        },
        "description": {
          "en": "The step to duplicate.",
          "de": "Der zu duplizierende Schritt."
        },
        "ref": {
          "kind": "step",
          "domain": "steps",
          "granularity": "step"
        }
      }
    },
    "newId": {
      "type": "string"
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    }
  }
