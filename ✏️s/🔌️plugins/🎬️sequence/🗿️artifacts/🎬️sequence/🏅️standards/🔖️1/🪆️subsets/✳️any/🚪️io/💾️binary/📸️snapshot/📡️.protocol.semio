dialect protocol
protocol sequence.snapshot
version 1
schema sequence.sequence
start snapshot
framing record
use semio.pack

record snapshot {
  schema utf8
  content Ref(ArtifactChild)
}
record ArtifactChild {
  child_id utf8
  target Ref(ArtifactRef)
}
record ArtifactRef {
  artifact-id utf8
  artifact-kind utf8
  standard utf8
  subset utf8
}
