    "collapsed": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Collapsed",
          "de": "Eingeklappt"
        },
        "description": {
          "en": "The step's body is hidden in the editor.",
          "de": "Der Rumpf des Schritts ist im Editor ausgeblendet."
