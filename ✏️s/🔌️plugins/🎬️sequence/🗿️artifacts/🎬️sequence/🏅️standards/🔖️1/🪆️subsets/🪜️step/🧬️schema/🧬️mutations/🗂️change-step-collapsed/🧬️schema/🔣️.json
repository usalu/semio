{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sequence/sequence/1/step/mutation/change-step-collapsed/schema.json",
  "title": "ChangeStepCollapsed",
  "type": "object",
