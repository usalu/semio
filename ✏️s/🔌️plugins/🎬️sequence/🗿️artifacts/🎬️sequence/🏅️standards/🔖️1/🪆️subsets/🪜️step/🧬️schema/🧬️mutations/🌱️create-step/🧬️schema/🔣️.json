{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sequence/sequence/1/step/mutation/create-step/schema.json",
  "title": "CreateStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "step"
  ],
  "properties": {
    "mutation": {
      "const": "createStep"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NeuralValue"
          }
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "slot": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "name"
              ],
              "properties": {
                "owner": {
                  "type": "string",
                  "x-semio-ui": {
                    "widget": "reference",
                    "role": "value",
                    "label": {
                      "en": "Parent Step",
                      "de": "Übergeordneter Schritt"
                    },
                    "description": {
                      "en": "The step that owns the slot.",
                      "de": "Der Schritt, dem der Slot gehört."
                    },
                    "ref": {
                      "kind": "step",
                      "domain": "steps",
                      "granularity": "step"
                    }
                  }
                },
                "name": {
                  "type": "string",
                  "x-semio-ui": {
                    "widget": "text",
                    "role": "value",
                    "label": {
                      "en": "Slot Name",
                      "de": "Slot-Name"
                    },
                    "description": {
                      "en": "Name of the parent's slot.",
                      "de": "Name des Slots des übergeordneten Schritts."
                    }
                  }
                }
              }
            }
          ],
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Slot",
              "de": "Slot"
            },
            "description": {
              "en": "Slot of the parent step this step belongs to; empty for a top-level step.",
              "de": "Slot des übergeordneten Schritts, zu dem dieser Schritt gehört; leer für einen Schritt der obersten Ebene."
            }
          }
        },
        "collapsed": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Collapsed",
              "de": "Eingeklappt"
            },
            "description": {
              "en": "The step's body is hidden in the editor.",
              "de": "Der Rumpf des Schritts ist im Editor ausgeblendet."
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Step",
          "de": "Schritt"
        },
        "description": {
          "en": "The complete step record to add.",
          "de": "Der vollständige hinzuzufügende Schritt."
        }
      }
    }
  },
  "$defs": {
    "NeuralValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NeuralValue"
          }
        }
      ]
    }
  }
}
