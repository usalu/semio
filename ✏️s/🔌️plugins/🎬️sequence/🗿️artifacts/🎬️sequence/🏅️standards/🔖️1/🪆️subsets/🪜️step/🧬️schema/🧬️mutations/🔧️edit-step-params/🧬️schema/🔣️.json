{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sequence/sequence/1/step/mutation/edit-step-params/schema.json",
  "title": "EditStepParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "params"
  ],
  "properties": {
    "mutation": {
      "const": "editStepParams"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Step",
          "de": "Schritt"
        },
        "description": {
          "en": "The step this mutation addresses.",
          "de": "Der Schritt, den diese Mutation adressiert."
        },
        "ref": {
          "kind": "step",
          "domain": "steps",
          "granularity": "step"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/NeuralValue"
      }
    }
  },
  "$defs": {
    "NeuralValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NeuralValue"
          }
        }
      ]
    }
  }
