dialect grammar
grammar sequence.snapshot
extension sequence
start document

document = preamble? "schema" "=" text "content" "=" child NL?
preamble = "semio" SP "sequence.sequence.dsl" SP "v1" NL
child = "child_id" "=" text "target" "=" reference
reference = "artifact-id" "=" text "artifact-kind" "=" text "standard" "=" text "subset" "=" text
text = STRING / IDENT / INT / FLOAT
