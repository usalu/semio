{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sequence/sequence/inference.json",
  "title": "SequenceInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topology"
  ],
  "properties": {
    "topology": {
      "$ref": "#/$defs/SequenceTopology",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "SequenceTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topoOrder",
        "depth",
        "cycleFree",
        "nodeCount"
      ],
      "properties": {
        "topoOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depth": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "cycleFree": {
          "type": "boolean"
        },
        "nodeCount": {
          "type": "integer"
        }
      }
    }
  }
}
