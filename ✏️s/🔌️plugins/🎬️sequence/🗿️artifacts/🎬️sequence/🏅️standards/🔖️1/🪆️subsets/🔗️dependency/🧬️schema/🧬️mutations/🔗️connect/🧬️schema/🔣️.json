{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sequence/sequence/1/dependency/mutation/connect-steps/schema.json",
  "title": "ConnectSteps",
  "x-semio-invariant": [
    {
      "id": "no-self-loop",
      "description": {
        "en": "A sequence is acyclic: an edge connects two different steps, so from differs from to.",
        "de": "Eine Sequenz ist azyklisch: Eine Kante verbindet zwei verschiedene Schritte, from unterscheidet sich also von to."
      }
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "from",
    "to"
  ],
  "properties": {
    "mutation": {
      "const": "connectSteps"
    },
    "id": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Source Step",
          "de": "Quellschritt"
        },
        "description": {
          "en": "The step the connection starts at.",
          "de": "Der Schritt, an dem die Verbindung beginnt."
        },
        "ref": {
          "kind": "step",
          "domain": "steps",
          "granularity": "step"
        }
      }
    },
    "to": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Target Step",
          "de": "Zielschritt"
        },
        "description": {
          "en": "The step the connection ends at.",
          "de": "Der Schritt, an dem die Verbindung endet."
        },
        "ref": {
          "kind": "step",
          "domain": "steps",
          "granularity": "step"
        }
      }
    }
  }
}
