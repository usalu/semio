{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sequence/sequence/artifact.json",
  "title": "SequenceArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "content": {
      "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child/schema.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.flow"
    }
  },
  "$defs": {
    "SequenceStep": {
      "title": "SequenceStep",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "params",
        "x",
        "y",
        "collapsed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "collapsed": {
          "type": "boolean"
        }
      }
    },
    "SequenceEdge": {
      "title": "SequenceEdge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "SlotRef": {
      "title": "SlotRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "SequenceCamera": {
      "title": "SequenceCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "SequenceRetainedActionsContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumRawBytes",
        "maximumUnits",
        "checkpointBytes",
        "replay",
        "abandonClose"
      ],
      "properties": {
        "maximumRawBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximumUnits": {
          "type": "integer",
          "minimum": 2,
          "maximum": 66049
        },
        "checkpointBytes": {
          "const": 24
        },
        "replay": {
          "const": true
        },
        "abandonClose": {
          "const": true
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "SequenceRetainedActionsRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "publicationLane",
        "contract"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "classification": {
          "enum": [
            "migrated",
            "batch-only-pending-rewrite"
          ]
        },
        "publicationLane": {
          "enum": [
            "child",
            "window-config",
            "window-transient"
          ]
        },
        "contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/SequenceRetainedActionsContract"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "migrated"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "contract": {
                "$ref": "#/$defs/SequenceRetainedActionsContract"
              }
            }
          },
          "else": {
            "properties": {
              "contract": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "addStep",
                  "addStepToSlot",
                  "addStepDropped",
                  "removeStep",
                  "deleteSelection",
                  "moveStep",
                  "connectSteps",
                  "disconnectSteps",
                  "setStepParams",
                  "setStepCollapsed",
                  "reorganize",
                  "nodeGraphEdit"
                ]
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "publicationLane": {
                "const": "child"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "setOrientation",
                  "setViewport"
                ]
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "publicationLane": {
                "const": "window-config"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "run",
                  "stop"
                ]
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "publicationLane": {
                "const": "window-transient"
              }
            }
          }
        }
      ],
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
