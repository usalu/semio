{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/sequence/sequence/artifact.json",
  "title": "SequenceArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "content"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "content": {
      "$ref": "https://semio.tech/schema/os/store/child.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio.flow"
    }
  },
  "$defs": {
    "SequenceStep": {
      "title": "SequenceStep",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "params",
        "x",
        "y",
        "collapsed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "slot": {
          "$ref": "#/$defs/SlotRef"
        },
        "collapsed": {
          "type": "boolean"
        }
      }
    },
    "SequenceEdge": {
      "title": "SequenceEdge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "SlotRef": {
      "title": "SlotRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "SequenceCamera": {
      "title": "SequenceCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "SequenceRetainedActionsContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumRawBytes",
        "maximumUnits",
        "checkpointBytes",
        "replay",
        "abandonClose"
      ],
      "properties": {
        "maximumRawBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximumUnits": {
          "type": "integer",
          "minimum": 2,
          "maximum": 66049
        },
        "checkpointBytes": {
          "const": 24
        },
        "replay": {
          "const": true
        },
        "abandonClose": {
          "const": true
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "SequenceRetainedActionsRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "publicationLane",
        "contract"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "classification": {
          "enum": [
            "migrated",
            "batch-only-pending-rewrite"
          ]
        },
        "publicationLane": {
          "enum": [
            "artifact",
            "config"
          ]
        },
        "contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/SequenceRetainedActionsContract"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "migrated"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "contract": {
                "$ref": "#/$defs/SequenceRetainedActionsContract"
              }
            }
          },
          "else": {
            "properties": {
              "contract": {
                "type": "null"
              }
            }
          }
        }
      ],
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "SequenceRetainedActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "controller",
        "documentSchema",
        "runtimeLaws",
        "locales",
        "accessibility",
        "customization",
        "persistentOracle",
        "routes"
      ],
      "properties": {
        "owner": {
          "const": "EditorApp<SequencePlayApp>"
        },
        "controller": {
          "const": "s.sequence.sequence@1/*#editor"
        },
        "documentSchema": {
          "const": "sequence.sequence"
        },
        "runtimeLaws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumStepMicros",
            "cancellation",
            "freshness",
            "retirement",
            "replay",
            "artifactStoreAuthority",
            "configStoreAuthority"
          ],
          "properties": {
            "maximumStepMicros": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000
            },
            "cancellation": {
              "const": "perOperation"
            },
            "freshness": {
              "const": "validateImmediatelyBeforeExposure"
            },
            "retirement": {
              "const": "boundedAbandonClose"
            },
            "replay": {
              "const": "operationOwnedCheckpoint"
            },
            "artifactStoreAuthority": {
              "const": true
            },
            "configStoreAuthority": {
              "const": true
            }
          }
        },
        "locales": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "en",
              "de"
            ]
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "progressAnnouncements",
            "cancellable",
            "keyboardReachable"
          ],
          "properties": {
            "progressAnnouncements": {
              "const": true
            },
            "cancellable": {
              "const": true
            },
            "keyboardReachable": {
              "const": true
            }
          }
        },
        "customization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orientation",
            "viewport"
          ],
          "properties": {
            "orientation": {
              "const": true
            },
            "viewport": {
              "const": true
            }
          }
        },
        "persistentOracle": {
          "const": {
            "reorganize": {
              "orientation": "leftRight",
              "nodes": [
                "a",
                "b",
                "c"
              ],
              "edges": [
                [
                  "a",
                  "b"
                ],
                [
                  "b",
                  "c"
                ]
              ],
              "expected": [
                {
                  "id": "a",
                  "x": 0,
                  "y": 0
                },
                {
                  "id": "b",
                  "x": 280,
                  "y": 0
                },
                {
                  "id": "c",
                  "x": 560,
                  "y": 0
                }
              ]
            },
            "nodeGraphEdit": {
              "baseSteps": [
                {
                  "id": "a",
                  "kind": "state.set"
                },
                {
                  "id": "b",
                  "kind": "log.print"
                }
              ],
              "baseEdges": [
                {
                  "id": "e1",
                  "from": "a",
                  "to": "b"
                }
              ],
              "targetSteps": [
                {
                  "id": "a",
                  "kind": "math.add"
                },
                {
                  "id": "c",
                  "kind": "log.print"
                }
              ],
              "targetEdges": [
                {
                  "id": "e2",
                  "from": "a",
                  "to": "c"
                }
              ],
              "expectedMutations": [
                "DeleteStep:b",
                "DeleteStep:a",
                "CreateStep:a",
                "CreateStep:c",
                "ConnectSteps:e2"
              ]
            },
            "run": {
              "nodes": [
                "set",
                "log"
              ],
              "edges": [
                [
                  "set",
                  "log"
                ]
              ],
              "expectedOrder": [
                "set",
                "log"
              ]
            }
          }
        },
        "routes": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/SequenceRetainedActionsRoute"
          }
        }
      },
      "title": "SequenceRetainedActions",
      "description": "🎬️ The retained-command law of the Sequence editor: its owner/controller identity, runtime laws, locales, accessibility and customization guarantees, and the seventeen live routes with their classifications and bounded contracts.",
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
