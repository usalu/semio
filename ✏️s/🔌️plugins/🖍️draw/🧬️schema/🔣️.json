{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/draw/schema.json",
  "$defs": {
    "DrawPublicationAuthority": {
      "title": "DrawPublicationAuthority",
      "description": "🖍️ The publication-authority law of the Drawing play app: its routes are the same set in its two tool-id constants, in the artifact publication contracts and — minus the framework-injected ones — in the `Migrated` interactive-job classifications; a `HostOnly` route carries no second lane.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "apps"
      ],
      "properties": {
        "schema": {
          "const": "semio.app.publication-authority.v1"
        },
        "apps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "toolIdsConstants",
              "source",
              "routes",
              "laws",
              "ui"
            ],
            "properties": {
              "owner": {
                "enum": [
                  "DrawingPlayApp"
                ]
              },
              "toolIdsConstants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^DRAWING_[A-Z]+_TOOL_IDS$"
                }
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "routes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "lanes"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][A-Za-z0-9]*$"
                    },
                    "lanes": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "HostOnly",
                          "Artifact",
                          "Config",
                          "Draft",
                          "Presence",
                          "Transient",
                          "Child"
                        ]
                      }
                    },
                    "frameworkInjected": {
                      "const": true
                    }
                  },
                  "if": {
                    "required": [
                      "lanes"
                    ],
                    "properties": {
                      "lanes": {
                        "type": "array",
                        "contains": {
                          "const": "HostOnly"
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "lanes": {
                        "type": "array",
                        "maxItems": 1
                      }
                    }
                  }
                }
              },
              "laws": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bounded",
                  "cancel",
                  "replay",
                  "freshness",
                  "ack",
                  "incrementalClose"
                ],
                "properties": {
                  "bounded": {
                    "const": true
                  },
                  "cancel": {
                    "const": true
                  },
                  "replay": {
                    "const": true
                  },
                  "freshness": {
                    "const": true
                  },
                  "ack": {
                    "const": true
                  },
                  "incrementalClose": {
                    "const": true
                  }
                }
              },
              "ui": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "locales",
                  "accessibleLabels",
                  "customizableUi"
                ],
                "properties": {
                  "locales": {
                    "const": [
                      "en",
                      "de"
                    ]
                  },
                  "accessibleLabels": {
                    "const": true
                  },
                  "customizableUi": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
