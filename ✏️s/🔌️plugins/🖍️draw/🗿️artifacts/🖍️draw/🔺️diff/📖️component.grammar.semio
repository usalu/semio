dialect grammar
grammar draw.diff
extension draw
use family-scene
start diff

artifact-mark = "draw.draw-diff"
diff = artifact-mark canvas-change+
canvas-change = "add-layer" IDENT | "remove-layer" IDENT | "move" "id" "=" IDENT "dx" "=" FLOAT "dy" "=" FLOAT
paint-field = "stroke" "=" TEXT | "fill" "=" TEXT
