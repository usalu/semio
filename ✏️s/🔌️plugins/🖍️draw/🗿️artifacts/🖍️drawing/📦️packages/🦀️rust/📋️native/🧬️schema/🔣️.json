{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "packages"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "name",
          "manifest",
          "check",
          "test"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^semio-s-artifact-draw-drawing(?:-[a-z0-9-]+)?$"
          },
          "manifest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "Cargo\\.toml$"
          },
          "check": {
            "type": "boolean"
          },
          "test": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
