{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "expectedPackages",
    "requiredPackages",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "expectedPackages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "requiredPackages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "effect",
          "schemaAccepted",
          "complete"
        ],
        "additionalProperties": false,
        "properties": {
          "effect": {
            "enum": [
              "none",
              "omit",
              "duplicate",
              "unknown",
              "wrong-manifest",
              "omit-check",
              "omit-test"
            ]
          },
          "schemaAccepted": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
