{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/style/mutation/replace-layer-fill/schema.json",
  "title": "ReplaceLayerFill",
  "type": "object",
  "additionalProperties": false,
  "required": ["layerId"],
  "$defs": {
    "Color": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "Stops": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["offset", "color"],
        "properties": {"offset": {"type": "number"}, "color": {"$ref": "#/$defs/Color"}}
      }
    }
  },
  "properties": {
    "layerId": {"type": "string"},
    "fill": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "color"],
          "properties": {"kind": {"const": "solid"}, "color": {"$ref": "#/$defs/Color"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "x1", "y1", "x2", "y2", "stops"],
          "properties": {
            "kind": {"const": "linearGradient"},
            "x1": {"type": "number"}, "y1": {"type": "number"}, "x2": {"type": "number"}, "y2": {"type": "number"},
            "stops": {"$ref": "#/$defs/Stops"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "cx", "cy", "r", "stops"],
          "properties": {
            "kind": {"const": "radialGradient"},
            "cx": {"type": "number"}, "cy": {"type": "number"}, "r": {"type": "number"},
            "stops": {"$ref": "#/$defs/Stops"}
          }
        }
      ]
    }
  }
}
