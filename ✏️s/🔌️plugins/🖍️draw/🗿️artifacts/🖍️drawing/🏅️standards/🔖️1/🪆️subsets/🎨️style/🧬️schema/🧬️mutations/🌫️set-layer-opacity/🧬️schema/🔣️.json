{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/style/mutation/set-layer-opacity/schema.json",
  "title": "SetLayerOpacity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layerId",
    "opacity"
  ],
  "properties": {
    "mutation": {
      "const": "setLayerOpacity"
    },
    "layerId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "description": {
          "en": "The layer this mutation addresses.",
          "de": "Die Ebene, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "layer",
          "domain": "strokes",
          "granularity": "stroke"
        },
        "group": "target",
        "order": 10
      }
    },
    "opacity": {
      "type": "number",
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Opacity",
          "de": "Deckkraft"
        },
        "displayUnit": "%",
        "displayFactor": 100,
        "step": 0.01,
        "precision": 2,
        "softMin": 0,
        "softMax": 1,
        "snaps": [
          0,
          0.25,
          0.5,
          0.75,
          1
        ],
        "group": "appearance",
        "order": 20
      }
    }
  }
}
