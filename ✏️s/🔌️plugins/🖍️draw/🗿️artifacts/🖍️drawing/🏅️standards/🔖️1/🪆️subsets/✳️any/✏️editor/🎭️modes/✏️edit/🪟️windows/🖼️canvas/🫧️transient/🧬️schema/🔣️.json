{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/app/drawing/drawing/canvas-window-transient/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["engagementInput", "tracePointerGeneration", "tracePointerCompletedWork", "tracePointerPendingWork"],
