{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/transform/mutation/rotate-layers/schema.json",
  "title": "RotateLayers",
  "x-semio-inverse-rows": { "perTarget": { "targets": 1 } },
  "description": "The `rotate-layers` mutation record — a relative, parametric rotation of a set of layers by one angle about one world-space pivot, applied through each layer's parent transform. Internally tagged `\"mutation\": \"rotateLayers\"`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "targets",
    "pivotX",
    "pivotY",
    "angle"
  ],
  "properties": {
    "mutation": {
      "const": "rotateLayers",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Layers",
          "de": "Ebenen"
        },
        "description": {
          "en": "Layers to rotate; a layer inside a rotated group turns with the group, locked, hidden or missing ones are skipped.",
          "de": "Zu drehende Ebenen; eine Ebene in einer gedrehten Gruppe dreht sich mit der Gruppe, gesperrte, ausgeblendete oder fehlende werden übersprungen."
        },
        "ref": {
          "kind": "layer",
          "domain": "strokes",
          "granularity": "stroke"
        },
        "group": "target",
        "order": 10
      }
    },
    "pivotX": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Pivot X",
          "de": "Drehpunkt X"
        },
        "step": 1,
        "precision": 2,
        "group": "pivot",
        "order": 20
      }
    },
    "pivotY": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Pivot Y",
          "de": "Drehpunkt Y"
        },
        "step": 1,
        "precision": 2,
        "group": "pivot",
        "order": 30
      }
    },
    "angle": {
      "type": "number",
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "Angle",
          "de": "Winkel"
        },
        "description": {
          "en": "Rotation angle; positive values turn from the x axis towards the y axis.",
          "de": "Drehwinkel; positive Werte drehen von der x-Achse zur y-Achse."
        },
        "unit": "rad",
        "displayUnit": "deg",
        "displayFactor": 57.29577951308232,
        "step": 0.017453292519943295,
        "precision": 4,
        "softMin": -3.141592653589793,
        "softMax": 3.141592653589793,
        "snaps": [
          -3.141592653589793,
          -1.5707963267948966,
          0,
          1.5707963267948966,
          3.141592653589793
        ],
        "group": "rotation",
        "order": 40
      }
    }
  }
}
