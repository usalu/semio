{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/draw/path-edit",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "points",
        "delta"
      ],
      "properties": {
        "kind": {
          "const": "translate"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "point"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "point": {
                "enum": [
                  "anchor",
                  "control1",
                  "control2"
                ]
              }
            }
          }
        },
        "delta": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index",
        "point",
        "to"
      ],
      "properties": {
        "kind": {
          "const": "position"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "point": {
          "enum": [
            "anchor",
            "control1",
            "control2"
          ]
        },
        "to": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index",
        "other"
      ],
      "properties": {
        "kind": {
          "const": "join"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "other": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "convert"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "enum": [
            "line",
            "cubic"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index",
        "point",
        "axis",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "coordinate"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "point": {
          "enum": [
            "anchor",
            "control1",
            "control2"
          ]
        },
        "axis": {
          "enum": [
            "x",
            "y"
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index",
        "t"
      ],
      "properties": {
        "kind": {
          "const": "split"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "t": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "const": "delete"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "reverse"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "const": "close"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "const": "open"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "points"
      ],
      "properties": {
        "kind": {
          "const": "deletePoints"
        },
        "points": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "point"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "point": {
                "enum": [
                  "anchor",
                  "control1",
                  "control2"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
