{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/draw/point-selection-ref",
  "description": "Snapshot-bound path point: geometry is the BLAKE3 digest of draw-points-v1 followed by tagged little-endian segment coordinates. Canonical ID is layerId:geometry:index:point, parsed from the final three colons.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layerId",
    "geometry",
    "index",
    "point"
  ],
  "properties": {
    "layerId": {
      "type": "string",
      "minLength": 1
    },
    "geometry": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "point": {
      "enum": [
        "anchor",
        "control1",
        "control2"
      ]
    }
  }
}
