{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "drawing.fill-edit.v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "type"
        },
        "value": {
          "enum": [
            "none",
            "solid",
            "linearGradient",
            "radialGradient"
          ]
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "coordinate"
        },
        "axis": {
          "enum": [
            "x1",
            "y1",
            "x2",
            "y2",
            "cx",
            "cy",
            "r"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "axis",
        "value"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "color"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "alpha"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "offset"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "index",
        "value"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "addStop"
        },
        "offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "offset"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "removeStop"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "index"
      ]
    }
  ]
}
