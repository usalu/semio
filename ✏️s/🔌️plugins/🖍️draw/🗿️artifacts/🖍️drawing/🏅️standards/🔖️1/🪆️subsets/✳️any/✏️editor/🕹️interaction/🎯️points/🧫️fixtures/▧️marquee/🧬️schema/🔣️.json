{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "segments",
    "cases",
    "merges"
  ],
  "properties": {
    "segments": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/drawing/drawing/artifact.json#/$defs/PathSegment"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "matrix",
          "start",
          "end",
          "indices"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "matrix": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "number"
            }
          },
          "start": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "end": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "merges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "current",
          "hits",
          "mode",
          "expected"
        ],
        "properties": {
          "current": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "enum": [
              "replace",
              "add",
              "toggle"
            ]
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
