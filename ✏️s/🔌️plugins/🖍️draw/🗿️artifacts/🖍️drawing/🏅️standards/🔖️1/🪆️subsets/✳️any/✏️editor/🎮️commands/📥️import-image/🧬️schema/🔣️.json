{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/draw/import-image",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload"
  ],
  "properties": {
    "payload": {
      "type": "string",
      "minLength": 23,
      "maxLength": 89478512,
      "pattern": "^data:image/png;base64,"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "parentId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1024
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
