{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/draw/editor/patch-layer/history.schema.json",
  "title": "Layer Field History Admission",
  "type": "object",
  "required": [
    "document",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "document": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "mutation",
          "changed",
          "patch"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "mutation": {
            "type": "object"
          },
          "changed": {
            "type": "boolean"
          },
          "patch": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "op",
                "path",
                "value"
              ],
              "properties": {
                "op": {
                  "const": "replace"
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "value": {}
              }
            }
          }
        }
      }
    }
  }
}
