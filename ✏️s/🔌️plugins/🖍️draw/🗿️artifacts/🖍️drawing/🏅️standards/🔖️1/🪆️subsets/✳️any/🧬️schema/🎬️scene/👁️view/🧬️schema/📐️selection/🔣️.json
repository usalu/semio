{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/draw/scene/view/selection-bounds",
  "title": "Prepared Scene Selection Bounds Cases",
  "type": "array",
  "minItems": 13,
  "maxItems": 13,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "source",
      "selected",
      "locked",
      "hidden",
      "zeroOpacity",
      "ordinary",
      "expected"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "selected": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "locked": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "hidden": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "zeroOpacity": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "ordinary": {
        "type": "boolean"
      },
      "expected": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        ]
      }
    }
  }
}
