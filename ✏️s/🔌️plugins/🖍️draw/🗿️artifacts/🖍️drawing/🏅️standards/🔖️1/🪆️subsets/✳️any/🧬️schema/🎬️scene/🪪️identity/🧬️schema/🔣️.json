{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.draw.scene.identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance",
    "base",
    "generation",
    "revision"
  ],
  "properties": {
    "instance": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "base": {
      "$ref": "#/definitions/u64"
    },
    "generation": {
      "$ref": "#/definitions/u64"
    },
    "revision": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  },
  "definitions": {
    "u64": {
      "description": "Canonical unsigned decimal spelling of a full-width u64, without JavaScript number rounding.",
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "not": {
        "pattern": "[^0-9]"
      }
    }
  }
}
