{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:drawing:scene-paint:funding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "axes",
    "image",
    "stock",
    "turn",
    "maximumTurns"
  ],
  "properties": {
    "axes": {
      "type": "array",
      "items": {
        "enum": [
          "items",
          "copy",
          "capacity",
          "release",
          "depth"
        ]
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "transform",
        "bounds"
      ],
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "transform": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "number"
          }
        },
        "bounds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "stock": {
      "$ref": "#/$defs/grant"
    },
    "turn": {
      "$ref": "#/$defs/grant"
    },
    "maximumTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "copy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "release": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    }
  }
}
