{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://s.draw.drawing.1.any.io.image",
  "title": "Drawing Image IO Admission and Emission",
  "$defs": {
    "EmissionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "maximumPixels",
        "maximumEncodedBytes"
      ],
      "properties": {
        "asset": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/drawing/drawing/artifact.json#/$defs/DrawingImageAsset"
        },
        "maximumPixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "maximumEncodedBytes": {
          "type": "integer",
          "minimum": 8,
          "maximum": 67108864
        }
      }
    },
    "WorkGrant": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "EmissionProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "samples",
        "totalSamples",
        "encodedBytes",
        "work",
        "done"
      ],
      "properties": {
        "phase": {
          "enum": [
            "samples",
            "encoding",
            "complete",
            "base64"
          ]
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "totalSamples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "encodedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "boolean"
        }
      }
    }
  }
}
