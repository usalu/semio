{
  "$id": "https://semio.tech/schema/app/drawing/drawing/presence.json",
  "title": "DrawingPresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engagementInput",
    "camera",
    "activeUtilityId"
  ],
  "properties": {
    "engagementInput": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "camera": {
      "$ref": "#/$defs/DrawingCamera",
      "x-semio-state": "presence"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "presence"
    }
  },
  "$defs": {
    "DrawingCamera": {
      "title": "DrawingCamera",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number", "format": "double" },
        "y": { "type": "number", "format": "double" },
        "zoom": { "type": "number", "format": "double" }
      }
    }
  }
}
