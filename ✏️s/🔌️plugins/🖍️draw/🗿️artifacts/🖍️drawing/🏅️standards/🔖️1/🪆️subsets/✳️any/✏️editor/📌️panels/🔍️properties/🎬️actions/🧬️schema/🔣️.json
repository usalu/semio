{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semio:draw:inspector-selection-actions",
  "title": "Drawing Selection Action Eligibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "count",
    "locked",
    "sameParent",
    "convertibleShapes",
    "ungroupableGroups",
    "complete",
    "arrangementCount",
    "arrangeable"
  ],
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "locked": {
      "type": "boolean"
    },
    "sameParent": {
      "type": "boolean"
    },
    "convertibleShapes": {
      "type": "boolean"
    },
    "ungroupableGroups": {
      "type": "boolean"
    },
    "complete": {
      "type": "boolean"
    },
    "arrangementCount": {
      "type": "integer",
      "minimum": 0
    },
    "arrangeable": {
      "type": "boolean"
    }
  },
  "$defs": {
    "action": {
      "enum": [
        "group",
        "ungroup",
        "toPath",
        "duplicate",
        "delete",
        "bringForward",
        "sendBackward",
        "bringToFront",
        "sendToBack",
        "alignLeft",
        "alignCenter",
        "alignRight",
        "alignTop",
        "alignMiddle",
        "alignBottom",
        "distributeHorizontal",
        "distributeVertical"
      ]
    }
  }
}
