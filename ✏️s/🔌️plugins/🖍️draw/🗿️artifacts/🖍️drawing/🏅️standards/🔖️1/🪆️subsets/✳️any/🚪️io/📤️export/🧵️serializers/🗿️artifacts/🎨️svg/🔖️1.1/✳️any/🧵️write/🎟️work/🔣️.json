{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "pageBytes",
    "logicalUtf16Bytes",
    "logicalPageReferenceBytes",
    "quanta",
    "sourceCases",
    "deniedAxes",
    "borrowedScene",
    "output",
    "completedWorkSettlementOnly",
    "childReadyHandoff"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "pageBytes": {
      "const": 3072
    },
    "logicalUtf16Bytes": {
      "const": 2
    },
    "logicalPageReferenceBytes": {
      "const": 8
    },
    "quanta": {
      "const": [
        1,
        7,
        4096
      ]
    },
    "sourceCases": {
      "const": [
        "rectangle",
        "linear gradient",
        "radial gradient",
        "multiply blend",
        "isolated group opacity",
        "evenodd hole"
      ]
    },
    "deniedAxes": {
      "const": [
        "items",
        "copy",
        "capacity",
        "depth",
        "release"
      ]
    },
    "borrowedScene": {
      "const": "unchanged-through-producer-and-output-close"
    },
    "output": {
      "const": "private-owned-byte-pages"
    },
    "completedWorkSettlementOnly": {
      "const": true
    },
    "childReadyHandoff": {
      "const": "separate-paid-control"
    }
  }
}
