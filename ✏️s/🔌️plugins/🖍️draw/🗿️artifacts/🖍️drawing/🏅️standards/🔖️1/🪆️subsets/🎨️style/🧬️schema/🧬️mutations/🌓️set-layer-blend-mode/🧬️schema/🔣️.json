{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/style/mutation/set-layer-blend-mode/schema.json",
  "title": "SetLayerBlendMode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blendMode",
    "layerId"
  ],
  "properties": {
    "layerId": {
      "type": "string"
    },
    "blendMode": {
      "enum": [
        "normal",
        "multiply",
        "screen",
        "overlay",
        "darken",
        "lighten",
        "colorDodge",
        "colorBurn",
        "hardLight",
        "softLight",
        "difference",
        "exclusion",
        "hue",
        "saturation",
        "color",
        "luminosity"
      ]
    }
  }
}
