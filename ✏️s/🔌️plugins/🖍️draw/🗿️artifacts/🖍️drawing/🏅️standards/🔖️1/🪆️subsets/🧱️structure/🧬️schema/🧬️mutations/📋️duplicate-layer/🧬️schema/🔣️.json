{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/structure/mutation/duplicate-layer/schema.json",
  "title": "DuplicateLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layerId",
    "identities"
  ],
  "properties": {
    "mutation": {
      "const": "duplicateLayer"
    },
    "layerId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "description": {
          "en": "The layer this mutation addresses.",
          "de": "Die Ebene, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "layer",
          "domain": "strokes",
          "granularity": "stroke"
        },
        "group": "target",
        "order": 10
      }
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
