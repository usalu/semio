{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:drawing:paint:nonnull-value",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "rules"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "const": [
        {
          "name": "fill-null",
          "field": "fill",
          "value": null,
          "at": "$paint.fill",
          "valid": false
        },
        {
          "name": "fill-missing",
          "field": "fill",
          "at": "$paint.fill",
          "valid": false
        },
        {
          "name": "stroke-null",
          "field": "stroke",
          "value": null,
          "at": "$paint.stroke",
          "valid": false
        },
        {
          "name": "stroke-missing",
          "field": "stroke",
          "at": "$paint.stroke",
          "valid": false
        },
        {
          "name": "fill-value",
          "field": "fill",
          "value": {
            "kind": "solid",
            "color": [
              1,
              0,
              0,
              1
            ]
          },
          "at": "$paint.fill",
          "valid": true
        },
        {
          "name": "stroke-value",
          "field": "stroke",
          "value": {
            "color": [
              0,
              0,
              0,
              1
            ],
            "width": 1,
            "cap": "butt",
            "join": "miter"
          },
          "at": "$paint.stroke",
          "valid": true
        }
      ]
    },
    "rules": {
      "const": {
        "standaloneValuesNonnull": true,
        "attributeNullStillPreserved": true,
        "canonicalTypedRefusalAtSuppliedPosition": true,
        "sameNonnullObjectParser": true
      }
    }
  }
}
