{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/transform/mutation/update-layer-transform/schema.json",
  "title": "UpdateLayerTransform",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layerId",
    "transform"
  ],
  "properties": {
    "mutation": {
      "const": "updateLayerTransform"
    },
    "layerId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "description": {
          "en": "The layer this mutation addresses.",
          "de": "Die Ebene, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "layer",
          "domain": "strokes",
          "granularity": "stroke"
        },
        "group": "target",
        "order": 10
      }
    },
    "transform": {
      "title": "DrawingTransform",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rotation",
        "scaleX",
        "scaleY",
        "x",
        "y",
        "shear"
      ],
      "properties": {
        "x": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "X",
              "de": "X"
            },
            "step": 1,
            "precision": 2,
            "group": "geometry",
            "order": 10
          }
        },
        "y": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Y",
              "de": "Y"
            },
            "step": 1,
            "precision": 2,
            "group": "geometry",
            "order": 20
          }
        },
        "scaleX": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Scale X",
              "de": "Skalierung X"
            },
            "description": {
              "en": "Negative values mirror the layer.",
              "de": "Negative Werte spiegeln die Ebene."
            },
            "step": 0.01,
            "precision": 3,
            "group": "transform",
            "order": 30
          }
        },
        "scaleY": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Scale Y",
              "de": "Skalierung Y"
            },
            "description": {
              "en": "Negative values mirror the layer.",
              "de": "Negative Werte spiegeln die Ebene."
            },
            "step": 0.01,
            "precision": 3,
            "group": "transform",
            "order": 40
          }
        },
        "rotation": {
          "type": "number",
          "x-semio-ui": {
            "widget": "dial",
            "role": "value",
            "label": {
              "en": "Rotation",
              "de": "Drehung"
            },
            "unit": "rad",
            "displayUnit": "deg",
            "displayFactor": 57.29577951308232,
            "step": 0.017453292519943295,
            "precision": 4,
            "softMin": -3.141592653589793,
            "softMax": 3.141592653589793,
            "snaps": [
              -3.141592653589793,
              -1.5707963267948966,
              0,
              1.5707963267948966,
              3.141592653589793
            ],
            "group": "transform",
            "order": 50
          }
        },
        "shear": {
          "type": "number",
          "description": "Upper-right coefficient before rotation, in R(rotation) × [[scaleX, shear], [0, scaleY]].",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Shear",
              "de": "Scherung"
            },
            "step": 0.01,
            "precision": 3,
            "group": "transform",
            "order": 60
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Transform",
          "de": "Transformation"
        },
        "description": {
          "en": "Position, scale, rotation and shear of the layer.",
          "de": "Position, Skalierung, Drehung und Scherung der Ebene."
        },
        "group": "transform",
        "order": 20
      }
    }
  }
}
