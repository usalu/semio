{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/draw/scene/compositing",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "opacity",
      "blendMode"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "opacity": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "blendMode": {
        "enum": [
          "normal",
          "multiply",
          "screen",
          "overlay",
          "darken",
          "lighten",
          "colorDodge",
          "colorBurn",
          "hardLight",
          "softLight",
          "difference",
          "exclusion",
          "hue",
          "saturation",
          "color",
          "luminosity"
        ]
      }
    }
  }
}
