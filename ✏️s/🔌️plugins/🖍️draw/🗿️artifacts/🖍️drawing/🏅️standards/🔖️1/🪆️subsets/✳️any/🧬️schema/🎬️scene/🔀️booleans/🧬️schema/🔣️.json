{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/s/draw/scene/booleans",
 "title": "Bounded Complete Document Boolean Resolution",
 "type": "object",
 "required": [
  "plan",
  "limits"
 ],
 "additionalProperties": false,
 "properties": {
  "plan": {
   "$ref": "https://semio.tech/s/draw/scene/prepare"
  },
  "limits": {
   "$ref": "#/definitions/limits"
  }
 },
 "definitions": {
  "limits": {
   "type": "object",
   "required": [
    "tolerance",
    "epsilon",
    "maxDepth",
    "maxReferences",
    "maxEdges",
    "maxParameters",
    "maxAtomicEdges",
    "maxSegments",
    "maxRetainedSegments",
    "maxWork"
   ],
   "additionalProperties": false,
   "properties": {
    "tolerance": {
     "type": "number",
     "minimum": 1e-06,
     "maximum": 16,
     "description": "World-space curve error after every referenced result transform; unsupported precision fails before geometry publication."
    },
    "epsilon": {
     "type": "number",
     "minimum": 1e-12,
     "maximum": 16
    },
    "maxDepth": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1024
    },
    "maxReferences": {
     "type": "integer",
     "minimum": 1,
     "maximum": 32768
    },
    "maxEdges": {
     "type": "integer",
     "minimum": 1,
     "maximum": 65536
    },
    "maxParameters": {
     "type": "integer",
     "minimum": 1,
     "maximum": 262144
    },
    "maxAtomicEdges": {
     "type": "integer",
     "minimum": 1,
     "maximum": 65536
    },
    "maxSegments": {
     "type": "integer",
     "minimum": 1,
     "maximum": 65536
    },
    "maxRetainedSegments": {
     "type": "integer",
     "minimum": 1,
     "maximum": 262144,
     "description": "Cached world segments and published result-local segments; temporary producer buffers have their separate per-job caps."
    },
    "maxWork": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000000
    }
   }
  },
  "result": {
   "$ref": "https://semio.tech/s/draw/scene/prepare"
  },
  "progress": {
   "type": "object",
   "required": [
    "phase",
    "nodes",
    "resolved",
    "references",
    "segments",
    "work",
    "geometry",
    "done"
   ],
   "additionalProperties": false,
   "properties": {
    "phase": {
     "enum": [
      "indexing",
      "validation",
      "cycles",
      "requirements",
      "traversal",
      "operands",
      "geometry",
      "remapping",
      "publishing",
      "complete"
     ]
    },
    "nodes": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1024
    },
    "resolved": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1024
    },
    "references": {
     "type": "integer",
     "minimum": 0,
     "maximum": 32768
    },
    "segments": {
     "type": "integer",
     "minimum": 0,
     "maximum": 262144
    },
    "work": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1000000000
    },
    "geometry": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "https://semio.tech/framework/2d/booleans/paths#/definitions/progress"
      }
     ]
    },
    "done": {
     "type": "boolean"
    }
   }
  },
  "retirementProgress": {
   "description": "Structural composition of private document, path and scene cleanup. The remaining input plan returns to its caller; only valid completed output may be published. Work is not freed-byte credit.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "phase",
    "work",
    "done"
   ],
   "properties": {
    "phase": {
     "enum": [
      "closing",
      "complete"
     ]
    },
    "work": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "done": {
     "type": "boolean"
    }
   },
   "oneOf": [
    {
     "properties": {
      "phase": {
       "const": "closing"
      },
      "done": {
       "const": false
      }
     }
    },
    {
     "properties": {
      "phase": {
       "const": "complete"
      },
      "done": {
       "const": true
      }
     }
    }
   ]
  }
 }
}
