{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceLayerStroke",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layerId"
  ],
  "properties": {
    "layerId": {
      "type": "string"
    },
    "stroke": {
      "title": "StrokeStyle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cap",
        "color",
        "join",
        "width"
      ],
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "width": {
          "type": "number"
        },
        "cap": {
          "type": "string"
        },
        "join": {
          "type": "string"
        },
        "dash": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
