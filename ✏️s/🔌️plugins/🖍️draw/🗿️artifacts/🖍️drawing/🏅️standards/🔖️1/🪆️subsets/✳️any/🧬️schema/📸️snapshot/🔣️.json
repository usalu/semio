{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/drawing/drawing/snapshot.json",
  "title": "DrawingSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "layers"],
  "properties": {
    "schema": { "type": "string", "x-semio-state": "artifact" },
    "id": { "type": "string", "x-semio-state": "artifact" },
    "title": { "type": "string", "x-semio-state": "artifact" },
    "layers": {
      "type": "array",
      "items": { "$ref": "https://semio.tech/schema/s/drawing/drawing/artifact.json#/$defs/DrawingLayerNode" },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": { "$ref": "https://semio.tech/schema/s/drawing/drawing/artifact.json#/$defs/DrawingImageAsset" },
      "x-semio-state": "artifact"
    },
    "artboard": {
      "$ref": "https://semio.tech/schema/s/drawing/drawing/artifact.json#/$defs/DrawingArtboard",
      "x-semio-state": "artifact"
    }
  }
}
