{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prepared Fill Finite Work Law",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stock",
    "maxTurns",
    "axes",
    "width",
    "stops",
    "expectedStart",
    "expectedEnd"
  ],
  "properties": {
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "copy": {
          "type": "integer",
          "minimum": 1
        },
        "capacity": {
          "type": "integer",
          "minimum": 1
        },
        "release": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1
    },
    "axes": {
      "const": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "stops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset",
          "color"
        ],
        "properties": {
          "offset": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "color": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "expectedStart": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "expectedEnd": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    }
  }
}
