{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceLayerFill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layerId"
  ],
  "properties": {
    "layerId": {
      "type": "string"
    },
    "fill": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Solid"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "LinearGradient"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RadialGradient"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
