{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/draw/update-path-geometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layerId",
    "segments"
  ],
  "properties": {
    "layerId": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/drawing/drawing/artifact.json#/$defs/PathSegment"
      }
    }
  }
}
