{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "drawing.stroke.v1",
  "$defs": {
    "StrokeCap": { "enum": ["butt", "round", "square"] },
    "StrokeJoin": { "enum": ["miter", "round", "bevel"] }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["color", "width", "cap", "join"],
  "properties": {
    "color": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "width": { "type": "number" },
    "cap": { "$ref": "#/$defs/StrokeCap" },
    "join": { "$ref": "#/$defs/StrokeJoin" },
    "dash": { "type": "array", "items": { "type": "number" } }
  }
}
