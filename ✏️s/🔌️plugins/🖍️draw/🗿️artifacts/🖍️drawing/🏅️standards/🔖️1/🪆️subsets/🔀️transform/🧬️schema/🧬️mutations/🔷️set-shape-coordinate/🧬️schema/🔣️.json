{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/transform/mutation/set-shape-coordinate/schema.json",
  "title": "SetShapeCoordinate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layerId",
    "field",
    "value"
  ],
  "properties": {
    "mutation": {
      "const": "setShapeCoordinate"
    },
    "layerId": {
      "type": "string",
      "minLength": 1
    },
    "field": {
      "enum": [
        "rectX",
        "rectY",
        "rectWidth",
        "rectHeight",
        "ellipseCx",
        "ellipseCy",
        "ellipseRx",
        "ellipseRy",
        "circleCx",
        "circleCy",
        "circleR",
        "lineX1",
        "lineY1",
        "lineX2",
        "lineY2",
        "polygonX",
        "polygonY"
      ]
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "value": {
      "type": "number"
    }
  }
}
