{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/structure/mutation/create-layer/schema.json",
  "title": "CreateLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layer"
  ],
  "properties": {
    "mutation": {
      "const": "createLayer"
    },
    "parentId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Parent group",
          "de": "Übergeordnete Gruppe"
        },
        "description": {
          "en": "Group layer that holds the layer; the root when omitted.",
          "de": "Gruppenebene, die die Ebene enthält; ohne Angabe die Wurzel."
        },
        "ref": {
          "kind": "layer",
          "domain": "strokes",
          "granularity": "stroke"
        },
        "group": "placement",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Index",
          "de": "Index"
        },
        "description": {
          "en": "Position in the list; the end when omitted.",
          "de": "Position in der Liste; ohne Angabe am Ende."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 20
      }
    },
    "layer": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/drawing/drawing/artifact.json#/$defs/DrawingLayerNode",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "description": {
          "en": "The complete layer to add.",
          "de": "Die vollständige hinzuzufügende Ebene."
        },
        "group": "record",
        "order": 30
      }
    }
  }
}
