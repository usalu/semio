{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/structure/mutation/create-layer/schema.json",
  "title": "CreateLayer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "layer"
  ],
  "properties": {
    "mutation": {
      "const": "createLayer"
    },
    "parentId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Parent group",
          "de": "Übergeordnete Gruppe"
        },
        "description": {
          "en": "Group layer that holds the layer; the root when omitted.",
          "de": "Gruppenebene, die die Ebene enthält; ohne Angabe die Wurzel."
        },
        "ref": {
          "kind": "layer",
          "domain": "strokes",
          "granularity": "stroke"
        },
        "group": "placement",
        "order": 10
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Index",
          "de": "Index"
        },
        "description": {
          "en": "Position in the list; the end when omitted.",
          "de": "Position in der Liste; ohne Angabe am Ende."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 20
      }
    },
    "layer": {
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "description": {
          "en": "The complete layer to add.",
          "de": "Die vollständige hinzuzufügende Ebene."
        },
        "group": "record",
        "order": 30
      },
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "shape",
            "path",
            "text",
            "image",
            "group",
            "boolean",
            "trace"
          ],
          "x-semio-ui": {
            "widget": "select",
            "role": "value",
            "label": {
              "en": "Kind",
              "de": "Art"
            },
            "options": {
              "shape": {
                "en": "Shape",
                "de": "Form"
              },
              "path": {
                "en": "Path",
                "de": "Pfad"
              },
              "text": {
                "en": "Text",
                "de": "Text"
              },
              "image": {
                "en": "Image",
                "de": "Bild"
              },
              "group": {
                "en": "Group",
                "de": "Gruppe"
              },
              "boolean": {
                "en": "Boolean combination",
                "de": "Boolesche Kombination"
              },
              "trace": {
                "en": "Trace",
                "de": "Nachzeichnung"
              }
            },
            "group": "kind",
            "order": 10
          }
        },
        "blendMode": {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "darken",
            "lighten",
            "colorDodge",
            "colorBurn",
            "hardLight",
            "softLight",
            "difference",
            "exclusion",
            "hue",
            "saturation",
            "color",
            "luminosity"
          ],
          "x-semio-ui": {
            "widget": "select",
            "role": "value",
            "label": {
              "en": "Blend mode",
              "de": "Füllmethode"
            },
            "options": {
              "normal": {
                "en": "Normal",
                "de": "Normal"
              },
              "multiply": {
                "en": "Multiply",
                "de": "Multiplizieren"
              },
              "screen": {
                "en": "Screen",
                "de": "Negativ multiplizieren"
              },
              "overlay": {
                "en": "Overlay",
                "de": "Ineinanderkopieren"
              },
              "darken": {
                "en": "Darken",
                "de": "Abdunkeln"
              },
              "lighten": {
                "en": "Lighten",
                "de": "Aufhellen"
              },
              "colorDodge": {
                "en": "Color dodge",
                "de": "Farbig abwedeln"
              },
              "colorBurn": {
                "en": "Color burn",
                "de": "Farbig nachbelichten"
              },
              "hardLight": {
                "en": "Hard light",
                "de": "Hartes Licht"
              },
              "softLight": {
                "en": "Soft light",
                "de": "Weiches Licht"
              },
              "difference": {
                "en": "Difference",
                "de": "Differenz"
              },
              "exclusion": {
                "en": "Exclusion",
                "de": "Ausschluss"
              },
              "hue": {
                "en": "Hue",
                "de": "Farbton"
              },
              "saturation": {
                "en": "Saturation",
                "de": "Sättigung"
              },
              "color": {
                "en": "Color",
                "de": "Farbe"
              },
              "luminosity": {
                "en": "Luminosity",
                "de": "Luminanz"
              }
            },
            "group": "appearance",
            "order": 30
          }
        }
      },
      "allOf": [
        {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/drawing/drawing/artifact.json#/$defs/DrawingLayerNode"
        }
      ]
    }
  }
}
