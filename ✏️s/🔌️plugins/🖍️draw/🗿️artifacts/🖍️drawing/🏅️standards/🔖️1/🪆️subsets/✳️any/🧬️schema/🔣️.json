{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/drawing/drawing/artifact.json",
  "title": "DrawingArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "layers",
    "assets"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DrawingLayerNode"
      },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DrawingImageAsset"
      },
      "x-semio-state": "artifact"
    },
    "artboard": {
      "$ref": "#/$defs/DrawingArtboard",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "DrawingLayerNode": {
      "title": "DrawingLayerNode",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        }
      }
    },
    "DrawingImageAsset": {
      "title": "DrawingImageAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "data"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "DrawingArtboard": {
      "title": "DrawingArtboard",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "PathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "move"
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "line"
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ctrl",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "quad"
            },
            "ctrl": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ctrl1",
            "ctrl2",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "cubic"
            },
            "ctrl1": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "ctrl2": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rx",
            "ry",
            "rotation",
            "largeArc",
            "sweep",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "arc"
            },
            "rx": {
              "type": "number",
              "minimum": 0
            },
            "ry": {
              "type": "number",
              "minimum": 0
            },
            "rotation": {
              "type": "number"
            },
            "largeArc": {
              "type": "boolean"
            },
            "sweep": {
              "type": "boolean"
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "close"
            }
          }
        }
      ]
    }
  }
}
