{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/drawing/drawing/artifact.json",
  "title": "DrawingArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "layers",
    "assets"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "id": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DrawingLayerNode"
      },
      "x-semio-state": "artifact"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DrawingImageAsset"
      },
      "x-semio-state": "artifact"
    },
    "artboard": {
      "$ref": "#/$defs/DrawingArtboard",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "DrawingLayerNode": {
      "title": "DrawingLayerNode",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Kind",
              "de": "Art"
            },
            "description": {
              "en": "For example shape, path, text, trace or group.",
              "de": "Zum Beispiel shape (Form), path (Pfad), text (Text), trace (Nachzeichnung) oder group (Gruppe)."
            },
            "group": "kind",
            "order": 10
          }
        },
        "attributes": {
          "type": "object",
          "properties": {
            "stroke": {
              "$ref": "#/$defs/StrokeStyle",
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Stroke",
                  "de": "Kontur"
                },
                "group": "style",
                "order": 10
              }
            },
            "fillRule": {
              "$ref": "#/$defs/FillRule",
              "x-semio-ui": {
                "widget": "segmented",
                "role": "value",
                "label": {
                  "en": "Fill rule",
                  "de": "Füllregel"
                },
                "description": {
                  "en": "Which regions of a self-overlapping path count as inside.",
                  "de": "Welche Bereiche eines sich überlappenden Pfads als innen gelten."
                },
                "options": {
                  "evenodd": {
                    "en": "Even-odd",
                    "de": "Gerade-ungerade"
                  },
                  "nonzero": {
                    "en": "Non-zero",
                    "de": "Nicht-null"
                  }
                },
                "group": "style",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Attributes",
              "de": "Attribute"
            },
            "group": "style",
            "order": 20
          }
        },
        "blendMode": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Blend mode",
              "de": "Füllmethode"
            },
            "group": "appearance",
            "order": 30
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "group"
              }
            }
          },
          "then": {
            "properties": {
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/DrawingLayerNode"
                }
              },
              "isolation": {
                "type": "boolean",
                "default": false,
                "description": "Composite the group on a transparent backdrop before blending it into its parent."
              }
            }
          }
        }
      ]
    },
    "DrawingImageAsset": {
      "title": "DrawingImageAsset",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "data"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "DrawingArtboard": {
      "title": "DrawingArtboard",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "PathSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "move",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "x-semio-ui": {
                "widget": "vector",
                "role": "value",
                "label": {
                  "en": "To",
                  "de": "Nach"
                },
                "step": 1,
                "group": "geometry",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Move to",
              "de": "Bewegen nach"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "line",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "x-semio-ui": {
                "widget": "vector",
                "role": "value",
                "label": {
                  "en": "To",
                  "de": "Nach"
                },
                "step": 1,
                "group": "geometry",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Line to",
              "de": "Linie nach"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ctrl",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "quad",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "ctrl": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "x-semio-ui": {
                "widget": "vector",
                "role": "value",
                "label": {
                  "en": "Control point",
                  "de": "Kontrollpunkt"
                },
                "step": 1,
                "group": "geometry",
                "order": 20
              }
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "x-semio-ui": {
                "widget": "vector",
                "role": "value",
                "label": {
                  "en": "To",
                  "de": "Nach"
                },
                "step": 1,
                "group": "geometry",
                "order": 30
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Quadratic curve",
              "de": "Quadratische Kurve"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ctrl1",
            "ctrl2",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "cubic",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "ctrl1": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "x-semio-ui": {
                "widget": "vector",
                "role": "value",
                "label": {
                  "en": "First control point",
                  "de": "Erster Kontrollpunkt"
                },
                "step": 1,
                "group": "geometry",
                "order": 20
              }
            },
            "ctrl2": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "x-semio-ui": {
                "widget": "vector",
                "role": "value",
                "label": {
                  "en": "Second control point",
                  "de": "Zweiter Kontrollpunkt"
                },
                "step": 1,
                "group": "geometry",
                "order": 30
              }
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "x-semio-ui": {
                "widget": "vector",
                "role": "value",
                "label": {
                  "en": "To",
                  "de": "Nach"
                },
                "step": 1,
                "group": "geometry",
                "order": 40
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Cubic curve",
              "de": "Kubische Kurve"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rx",
            "ry",
            "rotation",
            "largeArc",
            "sweep",
            "to"
          ],
          "properties": {
            "kind": {
              "const": "arc",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            },
            "rx": {
              "type": "number",
              "minimum": 0,
              "x-semio-ui": {
                "widget": "stepper",
                "role": "value",
                "label": {
                  "en": "Radius X",
                  "de": "Radius X"
                },
                "step": 1,
                "precision": 2,
                "group": "geometry",
                "order": 20
              }
            },
            "ry": {
              "type": "number",
              "minimum": 0,
              "x-semio-ui": {
                "widget": "stepper",
                "role": "value",
                "label": {
                  "en": "Radius Y",
                  "de": "Radius Y"
                },
                "step": 1,
                "precision": 2,
                "group": "geometry",
                "order": 30
              }
            },
            "rotation": {
              "type": "number",
              "x-semio-ui": {
                "widget": "dial",
                "role": "value",
                "label": {
                  "en": "Axis rotation",
                  "de": "Achsendrehung"
                },
                "description": {
                  "en": "Rotation of the ellipse's x axis.",
                  "de": "Drehung der x-Achse der Ellipse."
                },
                "unit": "deg",
                "step": 1,
                "precision": 1,
                "softMin": -180,
                "softMax": 180,
                "snaps": [
                  -180,
                  -90,
                  0,
                  90,
                  180
                ],
                "group": "geometry",
                "order": 40
              }
            },
            "largeArc": {
              "type": "boolean",
              "x-semio-ui": {
                "widget": "toggle",
                "role": "value",
                "label": {
                  "en": "Large arc",
                  "de": "Großer Bogen"
                },
                "group": "geometry",
                "order": 50
              }
            },
            "sweep": {
              "type": "boolean",
              "x-semio-ui": {
                "widget": "toggle",
                "role": "value",
                "label": {
                  "en": "Clockwise",
                  "de": "Im Uhrzeigersinn"
                },
                "group": "geometry",
                "order": 60
              }
            },
            "to": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "x-semio-ui": {
                "widget": "vector",
                "role": "value",
                "label": {
                  "en": "To",
                  "de": "Nach"
                },
                "step": 1,
                "group": "geometry",
                "order": 70
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Arc",
              "de": "Bogen"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "close",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Kind",
                  "de": "Art"
                }
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Close path",
              "de": "Pfad schließen"
            }
          }
        }
      ]
    },
    "StrokeCap": {
      "enum": [
        "butt",
        "round",
        "square"
      ]
    },
    "StrokeJoin": {
      "enum": [
        "miter",
        "round",
        "bevel"
      ]
    },
    "StrokeStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "width",
        "cap",
        "join"
      ],
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4,
          "x-semio-ui": {
            "widget": "color",
            "role": "value",
            "label": {
              "en": "Color",
              "de": "Farbe"
            },
            "description": {
              "en": "Red, green, blue and alpha, each from 0 to 1.",
              "de": "Rot, Grün, Blau und Alpha, jeweils von 0 bis 1."
            },
            "step": 0.01,
            "group": "style",
            "order": 10
          }
        },
        "width": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Width",
              "de": "Breite"
            },
            "step": 0.5,
            "precision": 2,
            "softMin": 0,
            "softMax": 32,
            "group": "style",
            "order": 20
          }
        },
        "cap": {
          "$ref": "#/$defs/StrokeCap",
          "x-semio-ui": {
            "widget": "segmented",
            "role": "value",
            "label": {
              "en": "Line cap",
              "de": "Linienende"
            },
            "options": {
              "butt": {
                "en": "Butt",
                "de": "Stumpf"
              },
              "round": {
                "en": "Round",
                "de": "Rund"
              },
              "square": {
                "en": "Square",
                "de": "Quadratisch"
              }
            },
            "group": "style",
            "order": 30
          }
        },
        "join": {
          "$ref": "#/$defs/StrokeJoin",
          "x-semio-ui": {
            "widget": "segmented",
            "role": "value",
            "label": {
              "en": "Line join",
              "de": "Linienverbindung"
            },
            "options": {
              "miter": {
                "en": "Miter",
                "de": "Gehrung"
              },
              "round": {
                "en": "Round",
                "de": "Rund"
              },
              "bevel": {
                "en": "Bevel",
                "de": "Abgeschrägt"
              }
            },
            "group": "style",
            "order": 40
          }
        },
        "dash": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Dash pattern",
              "de": "Strichmuster"
            },
            "description": {
              "en": "Alternating dash and gap lengths.",
              "de": "Abwechselnde Strich- und Lückenlängen."
            },
            "group": "style",
            "order": 50
          }
        }
      }
    },
    "FillRule": {
      "enum": [
        "evenodd",
        "nonzero"
      ],
      "default": "evenodd"
    }
  }
}
