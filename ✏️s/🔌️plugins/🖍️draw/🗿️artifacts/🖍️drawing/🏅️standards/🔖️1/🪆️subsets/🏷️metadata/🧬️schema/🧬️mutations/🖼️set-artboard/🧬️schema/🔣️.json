{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/draw/drawing/1/metadata/mutation/set-artboard/schema.json",
  "title": "SetArtboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "artboard"
  ],
  "properties": {
    "mutation": {
      "const": "setArtboard"
    },
    "artboard": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ],
      "x-semio-ui": {
        "label": {
          "en": "Artboard",
          "de": "Zeichenfläche"
        },
        "role": "value",
        "group": "canvas"
      }
    }
  }
}
