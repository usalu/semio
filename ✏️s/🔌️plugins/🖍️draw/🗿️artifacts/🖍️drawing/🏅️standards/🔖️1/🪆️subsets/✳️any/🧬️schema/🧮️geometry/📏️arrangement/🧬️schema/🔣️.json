{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/draw/geometry/arrangement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "bounds"
  ],
  "properties": {
    "operation": {
      "enum": [
        "alignLeft",
        "alignCenter",
        "alignRight",
        "alignTop",
        "alignMiddle",
        "alignBottom",
        "distributeHorizontal",
        "distributeVertical"
      ]
    },
    "bounds": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "number"
        }
      }
    }
  }
}
