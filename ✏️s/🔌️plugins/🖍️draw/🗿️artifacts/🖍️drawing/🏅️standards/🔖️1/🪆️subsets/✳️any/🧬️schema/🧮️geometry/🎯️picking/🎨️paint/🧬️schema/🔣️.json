{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "PaintedPathQueryProgress": {
      "type": "object",
      "required": [
        "phase",
        "work",
        "done"
      ],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "admitting",
            "flattening",
            "flattenCleanup",
            "fill",
            "contours",
            "stroke",
            "strokeCleanup",
            "polygons",
            "cleanup",
            "complete"
          ]
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "boolean"
        }
      }
    },
    "PaintedPathQueryHit": {
      "type": "object",
      "required": [
        "contains",
        "bounds"
      ],
      "additionalProperties": false,
      "properties": {
        "contains": {
          "type": "boolean"
        },
        "bounds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        }
      }
    }
  },
  "title": "Painted Path Query Result",
  "$id": "schema://s.draw.drawing.1.any.geometry.picking.paint",
  "$ref": "#/$defs/PaintedPathQueryHit"
}
