{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.drawing.scene.original-failure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wallet",
    "cases"
  ],
  "properties": {
    "wallet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth",
        "maxTurns"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "copy": {
          "type": "integer",
          "minimum": 1
        },
        "capacity": {
          "type": "integer",
          "minimum": 1
        },
        "release": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "message",
          "expected"
        ],
        "properties": {
          "source": {
            "enum": [
              "literal",
              "owned",
              "flatten",
              "stroke",
              "pixels",
              "retirement",
              "ownedRetirement",
              "incomplete",
              "cancelled",
              "rasterInvalid",
              "rasterIncomplete",
              "rasterCancelled",
              "affineInvalid",
              "affinePixels",
              "affineIncomplete",
              "affineCancelled"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "$ref": "#/definitions/projection"
          }
        }
      }
    }
  },
  "definitions": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "postingRefusal": {
          "type": "string"
        },
        "original": {
          "$ref": "#/definitions/projection"
        }
      }
    }
  }
}
