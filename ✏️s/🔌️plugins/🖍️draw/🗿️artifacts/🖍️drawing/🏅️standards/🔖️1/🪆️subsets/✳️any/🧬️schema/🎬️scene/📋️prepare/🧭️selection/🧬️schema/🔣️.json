{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/draw/scene/selection/ancestry",
  "title": "Prepared Scene Selection Relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourcePath",
    "lockedAncestors",
    "selectedPaths"
  ],
  "properties": {
    "sourcePath": {
      "$ref": "#/definitions/address"
    },
    "lockedAncestors": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "selectedPaths": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/definitions/address"
      }
    }
  },
  "definitions": {
    "address": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pickable",
        "boundsSelection"
      ],
      "properties": {
        "pickable": {
          "type": "boolean"
        },
        "boundsSelection": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
