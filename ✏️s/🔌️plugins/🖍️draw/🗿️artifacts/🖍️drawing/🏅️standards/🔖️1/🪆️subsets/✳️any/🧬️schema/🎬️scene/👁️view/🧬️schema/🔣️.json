{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.draw.scene.view",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "groups",
      "transform",
      "segments",
      "opacity",
      "blendMode",
      "visible"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "groups": {
        "type": "array"
      },
      "transform": {
        "type": "array",
        "minItems": 6,
        "maxItems": 6,
        "items": {
          "type": "number"
        }
      },
      "segments": {
        "type": "array"
      },
      "opacity": {
        "type": "number"
      },
      "blendMode": {
        "type": "string"
      },
      "visible": {
        "type": "boolean"
      },
      "fillRule": {
        "enum": [
          "nonzero",
          "evenodd"
        ]
      },
      "fill": {
        "type": "object"
      },
      "stroke": {
        "type": "object"
      },
      "image": {
        "type": "object",
        "required": [
          "assetId",
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "assetId": {
            "type": "string"
          }
        }
      }
    }
  }
}