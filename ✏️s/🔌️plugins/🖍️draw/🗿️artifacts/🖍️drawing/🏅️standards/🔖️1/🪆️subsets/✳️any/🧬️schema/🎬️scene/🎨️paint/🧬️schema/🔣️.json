{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:draw:painted-regions:v1",
  "title": "Prepared Painted Path Regions",
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "transform",
        "flatness",
        "fill",
        "fillRule",
        "stroke",
        "limits"
      ],
      "additionalProperties": false,
      "properties": {
        "transform": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000000000.0,
            "maximum": 1000000000.0
          },
          "minItems": 6,
          "maxItems": 6
        },
        "flatness": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 16
        },
        "fill": {
          "type": "boolean"
        },
        "fillRule": {
          "enum": [
            "nonzero",
            "evenodd"
          ]
        },
        "stroke": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "width",
                "cap",
                "join",
                "dash"
              ],
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000.0
                },
                "cap": {
                  "enum": [
                    "butt",
                    "round",
                    "square"
                  ]
                },
                "join": {
                  "enum": [
                    "miter",
                    "round",
                    "bevel"
                  ]
                },
                "dash": {
                  "type": "array",
                  "maxItems": 1024,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000.0
                  }
                }
              }
            }
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "maxSegments",
            "maxPoints",
            "maxContours",
            "maxWork"
          ],
          "additionalProperties": false,
          "properties": {
            "maxSegments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "maxPoints": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144,
              "description": "Maximum published canonical points. Raw staging is separately bounded to 262144 points per fill/stroke arrangement."
            },
            "maxContours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536,
              "description": "Maximum published canonical rings. Raw staging is separately bounded to 65536 contours per fill/stroke arrangement."
            },
            "maxWork": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "flatness",
        "fillRule",
        "fill",
        "stroke",
        "bounds",
        "points",
        "contours"
      ],
      "additionalProperties": false,
      "properties": {
        "flatness": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 16
        },
        "fillRule": {
          "enum": [
            "nonzero",
            "evenodd"
          ]
        },
        "fill": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "array",
            "maxItems": 262144,
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "stroke": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "type": "array",
            "maxItems": 262144,
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "description": "Canonical nonzero-winding stroke union rings, including oppositely wound holes; bounded union waves retire internal primitive edges before publication."
        },
        "bounds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "contours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      }
    },
    "progress": {
      "type": "object",
      "required": [
        "phase",
        "work",
        "done"
      ],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "admitting",
            "flattening",
            "flattenCleanup",
            "fill",
            "contours",
            "stroke",
            "strokeCleanup",
            "polygons",
            "strokeCanonical",
            "strokeAccount",
            "canonicalizing",
            "canonicalCleanup",
            "canonicalContours",
            "canonicalSourceCleanup",
            "cleanup",
            "complete"
          ]
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "boolean"
        }
      }
    },
    "queryProgress": {
      "type": "object",
      "required": [
        "phase",
        "work",
        "done"
      ],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "fill",
            "stroke",
            "complete"
          ]
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "maxSegments",
        "maxPoints",
        "maxContours",
        "maxWork"
      ],
      "additionalProperties": false,
      "properties": {
        "maxSegments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maxPoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144,
          "description": "Maximum published canonical points. Raw staging is separately bounded to 262144 points per fill/stroke arrangement."
        },
        "maxContours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536,
          "description": "Maximum published canonical rings. Raw staging is separately bounded to 65536 contours per fill/stroke arrangement."
        },
        "maxWork": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      }
    },
    "queryStamp": {
      "type": "object",
      "required": [
        "source",
        "build",
        "entry",
        "flatness"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "required": [
            "instance",
            "base",
            "generation",
            "revision"
          ],
          "additionalProperties": false,
          "properties": {
            "instance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "base": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "maxLength": 20
            },
            "generation": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "maxLength": 20
            },
            "revision": {
              "type": "array",
              "minItems": 32,
              "maxItems": 32,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "build": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "maxLength": 20
        },
        "entry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "flatness": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 16
        }
      }
    }
  },
  "$ref": "#/$defs/input"
}
