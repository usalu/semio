{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Completed Scene Bounds Cases",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "record",
      "bounds"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "record": {
        "type": "object"
      },
      "bounds": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        ]
      }
    }
  }
}
