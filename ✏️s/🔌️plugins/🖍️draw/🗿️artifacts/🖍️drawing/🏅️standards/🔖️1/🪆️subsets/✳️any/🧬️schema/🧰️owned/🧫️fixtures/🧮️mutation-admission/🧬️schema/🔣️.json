{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schemas/drawing.mutation-admission/v1",
  "title": "Drawing Mutation Admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "limits", "bootstrapYield", "cases"],
  "properties": {
    "schema": { "const": "drawing.mutation-admission/v1" },
    "bootstrapYield": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadlineUs", "clockReadsUs", "expectedStages", "expectedAllocationDelta"],
      "properties": {
        "deadlineUs": { "const": 1 },
        "clockReadsUs": { "const": [0, 1] },
        "expectedStages": { "const": ["yielded", "resumed"] },
        "expectedAllocationDelta": { "const": 0 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentBytes", "fieldBytes"],
      "properties": {
        "documentBytes": { "type": "integer", "const": 262144 },
        "fieldBytes": { "type": "integer", "const": 4096 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "mutation", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "documentBytes"],
            "properties": {
              "profile": { "enum": ["nested", "document-plus-one"] },
              "documentBytes": { "type": "integer", "minimum": 0 }
            }
          },
          "mutation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "fieldBytes"],
            "properties": {
              "operation": { "enum": ["rename-layer", "set-layer-visible", "duplicate-layer"] },
              "fieldBytes": { "type": "integer", "minimum": 0 }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["disposition", "fault", "workClasses"],
            "properties": {
              "disposition": { "enum": ["applied", "rejected"] },
              "fault": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
              "workClasses": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["fixed-arena", "overlay-page", "clone-subtree", "none"] }
              }
            }
          }
        }
      }
    }
  }
}
