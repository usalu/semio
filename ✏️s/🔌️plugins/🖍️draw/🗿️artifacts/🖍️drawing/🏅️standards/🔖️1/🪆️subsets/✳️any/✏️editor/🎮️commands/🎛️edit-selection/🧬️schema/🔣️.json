{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/s/draw/edit-selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "ids"
  ],
  "properties": {
    "operation": {
      "enum": [
        "delete",
        "duplicate",
        "group",
        "toPath",
        "bringToFront",
        "sendToBack",
        "alignLeft",
        "alignCenter",
        "alignRight",
        "alignTop",
        "alignMiddle",
        "alignBottom",
        "distributeHorizontal",
        "distributeVertical"
      ]
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
