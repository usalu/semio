{
  "schema": "semio.draw.browser-journey.v1",
  "locales": [
    "en",
    "de"
  ],
  "ready": "draw",
  "minimumBootLayers": 1,
  "example": {
    "id": "demo",
    "label": "Demo"
  },
  "exampleLayer": "emblem-orange",
  "bootPaint": {
    "color": [250, 149, 0],
    "tolerance": 24,
    "minimumPixels": 200
  },
  "emptyExample": {
    "labels": {
      "en": "No example",
      "de": "Kein Beispiel"
    }
  },
  "blankExample": {
    "id": "blank",
    "labels": {
      "en": "Blank Drawing",
      "de": "Leere Zeichnung"
    }
  },
  "utility": "shapeRect",
  "utilityPressStates": [true, false, true],
  "gesture": {
    "from": [
      0.275,
      0.1
    ],
    "to": [
      0.325,
      0.2
    ],
    "steps": 8
  },
  "layerDelta": 1,
  "persistence": {
    "kind": "folder",
    "dataClass": "persistedLocalOnly",
    "reconnect": "s-folder-reconnect",
    "minimumEventGrowthBytes": 1
  },
  "export": {
    "format": "pdf",
    "pages": 1,
    "change": "renderedPixels"
  },
  "documentLoads": 2,
  "steps": [
    "boot",
    "blank",
    "example",
    "copy",
    "paste",
    "cut",
    "attach",
    "rectangle",
    "undo",
    "redo",
    "persisted",
    "export",
    "reload"
  ],
  "guestFaults": [
    "worker-fault",
    "trap"
  ]
}
