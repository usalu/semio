{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.draw.pdf-oracle.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "relation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "same",
              "different",
              "refuse"
            ]
          },
          "left": {
            "$ref": "#/$defs/page"
          },
          "right": {
            "$ref": "#/$defs/page"
          },
          "malformed": {
            "const": true
          }
        }
      },
      "maxItems": 5,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "name",
              "relation"
            ],
            "properties": {
              "name": {
                "const": "same PDF"
              },
              "relation": {
                "const": "same"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name",
              "relation"
            ],
            "properties": {
              "name": {
                "const": "metadata only"
              },
              "relation": {
                "const": "same"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name",
              "relation"
            ],
            "properties": {
              "name": {
                "const": "edited rectangle"
              },
              "relation": {
                "const": "different"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name",
              "relation"
            ],
            "properties": {
              "name": {
                "const": "empty page"
              },
              "relation": {
                "const": "refuse"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "name",
              "relation"
            ],
            "properties": {
              "name": {
                "const": "malformed document"
              },
              "relation": {
                "const": "refuse"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rectangles",
        "title"
      ],
      "properties": {
        "rectangles": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "title": {
          "enum": [
            "A",
            "B"
          ]
        }
      }
    }
  }
}
