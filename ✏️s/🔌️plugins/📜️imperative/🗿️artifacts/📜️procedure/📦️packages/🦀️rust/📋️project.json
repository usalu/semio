{
  "name": "@semio-tech/imperative-procedure-rs",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:artifact",
    "family:imperative"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📜️imperative/🗿️artifacts/📜️procedure/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/📜️imperative/🗿️artifacts/📜️procedure/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/📜️imperative/🗿️artifacts/📜️procedure/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "verify-procedure-document-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/📜️imperative/🗿️artifacts/📜️procedure/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts verify procedure-document-contract",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "procedure-document-contract"
          ]
        }
      }
    },
    "test-snapshot-sqlite": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🦀️.rs",
        "{projectRoot}/../../🟦️.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📜️imperative/🗿️artifacts/📜️procedure/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite",
        "forwardAllArgs": true
      }
    },
    "test-snapshot-sqlite-native": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🦀️.rs",
        "{projectRoot}/../../🟦️.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📜️imperative/🗿️artifacts/📜️procedure/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite native",
        "forwardAllArgs": true
      }
    },
    "test-snapshot-sqlite-source": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🦀️.rs",
        "{projectRoot}/../../🟦️.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/📜️imperative/🗿️artifacts/📜️procedure/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-snapshot-sqlite source",
        "forwardAllArgs": true
      }
    }
  }
}
