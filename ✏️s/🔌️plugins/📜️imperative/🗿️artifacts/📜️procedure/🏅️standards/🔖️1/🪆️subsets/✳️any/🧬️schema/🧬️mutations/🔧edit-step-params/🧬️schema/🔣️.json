{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/imperative/imperative/mutation/edit-step-params/schema.json",
  "title": "EditStepParams",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "pathRef",
    "id",
    "newParams"
  ],
  "properties": {
    "mutation": {
      "const": "editStepParams"
    },
    "pathRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "reference",
            "role": "value",
            "label": {
              "en": "Owner Step",
              "de": "Übergeordneter Schritt"
            },
            "description": {
              "en": "Control step whose body holds the list; empty for the top-level list.",
              "de": "Steuerschritt, dessen Rumpf die Liste enthält; leer für die oberste Liste."
            },
            "ref": {
              "kind": "step",
              "domain": "steps",
              "granularity": "step"
            }
          }
        },
        "slot": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Body Slot",
              "de": "Rumpf-Slot"
            },
            "description": {
              "en": "Name of the owner's body that holds the list.",
              "de": "Name des Rumpfs des übergeordneten Schritts, der die Liste enthält."
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Path Reference",
          "de": "Pfadreferenz"
        },
        "description": {
          "en": "The step list that holds the step.",
          "de": "Die Schrittliste, die den Schritt enthält."
        }
      }
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Step",
          "de": "Schritt"
        },
        "description": {
          "en": "The step this mutation addresses.",
          "de": "Der Schritt, den diese Mutation adressiert."
        },
        "ref": {
          "kind": "step",
          "domain": "steps",
          "granularity": "step"
        }
      }
    },
    "newParams": {
      "type": "object",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New Parameters",
          "de": "Neue Parameter"
        },
        "description": {
          "en": "Kind-specific parameters of the step.",
          "de": "Artspezifische Parameter des Schritts."
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/NeuralValue"
      }
    }
  },
  "$defs": {
    "NeuralValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NeuralValue"
          }
        }
      ]
    }
  }
}
