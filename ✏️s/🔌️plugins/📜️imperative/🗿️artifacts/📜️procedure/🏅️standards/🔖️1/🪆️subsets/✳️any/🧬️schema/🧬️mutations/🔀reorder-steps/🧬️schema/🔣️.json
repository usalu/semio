{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/imperative/imperative/mutation/reorder-steps/schema.json",
  "title": "ReorderSteps",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "pathRef",
    "id",
    "toIndex"
  ],
  "properties": {
    "mutation": {
      "const": "reorderSteps"
    },
    "pathRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "reference",
            "role": "value",
            "label": {
              "en": "Owner Step",
              "de": "Übergeordneter Schritt"
            },
            "description": {
              "en": "Control step whose body holds the list; empty for the top-level list.",
              "de": "Steuerschritt, dessen Rumpf die Liste enthält; leer für die oberste Liste."
            },
            "ref": {
              "kind": "step",
              "domain": "steps",
              "granularity": "step"
            }
          }
        },
        "slot": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Body Slot",
              "de": "Rumpf-Slot"
            },
            "description": {
              "en": "Name of the owner's body that holds the list.",
              "de": "Name des Rumpfs des übergeordneten Schritts, der die Liste enthält."
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Path Reference",
          "de": "Pfadreferenz"
        },
        "description": {
