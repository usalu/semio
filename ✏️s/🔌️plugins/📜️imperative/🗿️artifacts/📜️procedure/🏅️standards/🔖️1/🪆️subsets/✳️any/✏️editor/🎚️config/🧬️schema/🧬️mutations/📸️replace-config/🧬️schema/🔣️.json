{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/imperative/imperative/config/mutation/replace-config/schema.json",
  "title": "ReplaceConfig",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "runOutputJson": {
          "type": "string",
          "x-semio-ui": {
            "widget": "multiline",
            "role": "value",
            "label": {
              "en": "Run Output",
              "de": "Ausführungsausgabe"
            },
            "description": {
              "en": "Output of the last run as JSON text.",
              "de": "Ausgabe des letzten Laufs als JSON-Text."
            }
          }
        },
        "contributionsJson": {
          "type": "string",
          "x-semio-ui": {
            "widget": "multiline",
            "role": "value",
            "label": {
              "en": "Contributions",
              "de": "Beiträge"
            },
            "description": {
              "en": "Contributions of this editor as JSON text.",
              "de": "Beiträge dieses Editors als JSON-Text."
            }
          }
        }
      },
      "required": [
        "runOutputJson",
        "contributionsJson"
      ],
      "additionalProperties": false,
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Configuration",
          "de": "Konfiguration"
        },
        "description": {
          "en": "Whole view configuration of the imperative editor.",
          "de": "Gesamte Ansichtskonfiguration des Imperativ-Editors."
        }
      }
    }
  },
  "required": [
    "config"
  ],
  "additionalProperties": false
}
