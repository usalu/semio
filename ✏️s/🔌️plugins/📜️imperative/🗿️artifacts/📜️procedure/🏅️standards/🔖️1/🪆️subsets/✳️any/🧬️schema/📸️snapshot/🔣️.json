  "title": "ProcedureSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "path",
    "seed"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "path": {
