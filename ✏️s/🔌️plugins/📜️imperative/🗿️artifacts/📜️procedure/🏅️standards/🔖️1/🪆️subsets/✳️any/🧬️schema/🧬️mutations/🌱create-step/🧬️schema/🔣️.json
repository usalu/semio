{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/imperative/imperative/mutation/create-step/schema.json",
  "title": "CreateStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "pathRef",
    "step"
  ],
  "properties": {
    "mutation": {
      "const": "createStep"
    },
    "pathRef": {
      "$ref": "#/$defs/PathRef",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Path Reference",
          "de": "Pfadreferenz"
        },
        "description": {
          "en": "The step list that receives the step.",
          "de": "Die Schrittliste, die den Schritt aufnimmt."
        }
      }
    },
    "step": {
      "$ref": "#/$defs/Step",
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Step",
          "de": "Schritt"
        },
        "description": {
          "en": "The complete step record to add.",
          "de": "Der vollständige hinzuzufügende Schritt."
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "description": "Step-list position to insert at; absent appends. delete-step's inverse restores exact order with it."
    }
  },
  "$defs": {
    "PathRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "reference",
            "role": "value",
            "label": {
              "en": "Owner Step",
              "de": "Übergeordneter Schritt"
            },
            "description": {
              "en": "Control step whose body holds the list; empty for the top-level list.",
              "de": "Steuerschritt, dessen Rumpf die Liste enthält; leer für die oberste Liste."
            },
            "ref": {
              "kind": "step",
              "domain": "steps",
              "granularity": "step"
            }
          }
        },
        "slot": {
          "type": [
            "string",
            "null"
          ],
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Body Slot",
              "de": "Rumpf-Slot"
            },
            "description": {
              "en": "Name of the owner's body that holds the list.",
              "de": "Name des Rumpfs des übergeordneten Schritts, der die Liste enthält."
            }
          }
        }
      }
    },
    "Path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "params",
        "bodies"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NeuralValue"
          }
        },
        "bodies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Path"
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Bodies",
              "de": "Rümpfe"
            },
            "description": {
              "en": "Nested step lists by body slot.",
              "de": "Verschachtelte Schrittlisten je Rumpf-Slot."
            }
          }
        }
      }
    },
    "NeuralValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NeuralValue"
          }
        }
      ]
    }
  }
}
