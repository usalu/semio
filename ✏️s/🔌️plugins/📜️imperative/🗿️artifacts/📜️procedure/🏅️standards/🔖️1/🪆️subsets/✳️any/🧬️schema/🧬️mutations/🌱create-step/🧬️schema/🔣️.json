{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/imperative/imperative/mutation/create-step/schema.json",
  "title": "CreateStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pathRef",
    "step"
  ],
  "properties": {
    "pathRef": {
      "$ref": "#/$defs/PathRef"
    },
    "step": {
      "$ref": "#/$defs/Step"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "description": "Step-list position to insert at; absent appends. delete-step's inverse restores exact order with it."
    }
  },
  "$defs": {
    "PathRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string"
        },
        "slot": {
          "type": "string"
        }
      }
    },
    "Path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "params",
        "bodies"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "bodies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Path"
          }
        }
      }
    }
  }
}
