{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/imperative/imperative/artifact.json",
  "title": "ProcedureArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "path",
    "seed",
    "selectedStepIds",
    "contributionsJson",
    "runOutputJson"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "path": {
      "$ref": "#/$defs/ProcedurePath",
      "x-semio-state": "artifact"
    },
    "seed": {
      "type": "object",
      "additionalProperties": true,
      "x-semio-state": "artifact"
    },
    "selectedStepIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "contributionsJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "runOutputJson": {
      "type": "string",
      "x-semio-state": "transient"
    }
  },
  "$defs": {
    "ProcedurePath": {
      "title": "ProcedurePath",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProcedureStep"
          }
        }
      }
    },
    "ProcedureStep": {
      "title": "ProcedureStep",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "bodies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ProcedurePath"
          }
        }
      }
    },
    "ProcedureRetainedCommandRoutes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "maximumRawBytes",
        "maximumWorkItems",
        "routes"
      ],
      "properties": {
        "schema": {
          "const": "imperative.retained-command-routes.v1"
        },
        "maximumRawBytes": {
          "type": "integer",
          "const": 8192
        },
        "maximumWorkItems": {
          "type": "integer",
          "const": 1
        },
        "routes": {
          "allOf": [
            {
              "$ref": "https://semio.tech/schema/framework/ui/schema.json#/$defs/RetainedCommandRoutes"
            },
            {
              "type": "array",
              "minItems": 11,
              "maxItems": 11,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "disposition",
                  "lanes",
                  "reason"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "disposition": {
                    "enum": [
                      "migrated",
                      "batch-only-pending-rewrite"
                    ]
                  },
                  "lanes": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "artifact",
                        "config",
                        "transient",
                        "host-only"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
