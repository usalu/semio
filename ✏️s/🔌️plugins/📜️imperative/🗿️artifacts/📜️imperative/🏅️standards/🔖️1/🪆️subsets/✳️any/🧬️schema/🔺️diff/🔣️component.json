{
  "$id": "https://semio.tech/schema/s/imperative/imperative/diff.json",
  "title": "ImperativeDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "title": "ImperativeArtifact",
      "type": "object",
      "x-semio-state": "artifact"
    },
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "path": {
      "$ref": "#/$defs/ImperativePathDelta",
      "x-semio-state": "artifact"
    },
    "seed": {
      "type": "object",
      "additionalProperties": true,
      "x-semio-state": "artifact"
    },
    "selectedStepIds": {
      "$ref": "#/$defs/ImperativeStringList",
      "x-semio-state": "presence"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    },
    "contributionsJson": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "ImperativeStringList": {
      "title": "ImperativeStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ImperativePathRef": {
      "title": "ImperativePathRef",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "owner": {
          "type": "string"
        },
        "slot": {
          "type": "string"
        }
      }
    },
    "ImperativePathDelta": {
      "title": "ImperativePathDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pathRef",
        "steps"
      ],
      "properties": {
        "pathRef": {
          "$ref": "#/$defs/ImperativePathRef"
        },
        "steps": {
          "$ref": "#/$defs/ImperativeStepsDelta"
        }
      }
    },
    "ImperativeStepsDelta": {
      "title": "ImperativeStepsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImperativeStep"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImperativeStepPatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ImperativeStepPatchEntry": {
      "title": "ImperativeStepPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ImperativePath": {
      "title": "ImperativePath",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImperativeStep"
          }
        }
      }
    },
    "ImperativeStep": {
      "title": "ImperativeStep",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "bodies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ImperativePath"
          }
        }
      }
    }
  }
}
