{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "shape", "actor", "operation", "members", "preparationOrder", "successTrace", "invariants", "cancellationCases", "rejectionCases", "canonicalIdentity", "canonicalIdentitySha256"],
  "properties": {
    "schema": { "const": "gis.map.durable-three-store-assembly.v1" },
    "shape": { "const": "parent-drawing-value" },
    "actor": { "type": "string", "minLength": 1, "maxLength": 256 },
    "operation": { "type": "integer", "minimum": 1 },
    "members": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/parent" },
        { "$ref": "#/$defs/drawing" },
        { "$ref": "#/$defs/value" }
      ],
      "items": false
    },
    "preparationOrder": { "const": ["parent", "drawing", "value"] },
    "successTrace": {
      "const": ["admit-parent", "admit-drawing", "admit-value", "prepare-parent", "prepare-drawing", "prepare-value", "bind-once", "mount-host", "journal", "publish-parent", "publish-drawing", "publish-value", "await-ack", "terminal-handoff"]
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publishBeforeAllPrepared", "callerSuppliesGroupId", "exposesPreparedSeal", "terminalReturnsStores", "journalBegins"],
      "properties": {
        "publishBeforeAllPrepared": { "const": false },
        "callerSuppliesGroupId": { "const": false },
        "exposesPreparedSeal": { "const": false },
        "terminalReturnsStores": { "const": 3 },
        "journalBegins": { "const": 1 }
      }
    },
    "cancellationCases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/cancellation" }
    },
    "rejectionCases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/rejection" }
    },
    "canonicalIdentity": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "canonicalIdentitySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "document", "owner"],
      "properties": {
        "role": { "const": "parent" },
        "document": { "const": "map-1!s.gis.gismap@1/*" },
        "owner": { "type": "null" }
      }
    },
    "drawing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "document", "owner"],
      "properties": {
        "role": { "const": "drawing" },
        "document": { "const": "gismap-drawing!s.stdio.semio@v1/drawing" },
        "owner": { "const": "map-1" }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "document", "owner"],
      "properties": {
        "role": { "const": "value" },
        "document": { "const": "gismap-value!s.stdio.semio@v1/value" },
        "owner": { "const": "map-1" }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "prepared", "journalBegins", "terminalStores"],
      "properties": {
        "at": { "enum": ["admit-parent", "prepare-parent", "prepare-drawing", "prepare-value"] },
        "prepared": { "type": "integer", "minimum": 0, "maximum": 3 },
        "journalBegins": { "const": 0 },
        "terminalStores": { "const": 3 }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "priorPreparations", "terminalStores"],
      "properties": {
        "at": { "enum": ["parent", "drawing", "value"] },
        "priorPreparations": { "type": "integer", "minimum": 0, "maximum": 2 },
        "terminalStores": { "const": 3 }
      }
    }
  }
}
