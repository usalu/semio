{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/gis/component-cold-map-patch-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package", "app", "surface", "receipt", "document", "authority", "expected", "hostile"],
  "properties": {
    "schema": { "const": "semio.gis.component-cold-map-patch/v1" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "packageId", "cargoPackage", "componentFile"],
      "properties": {
        "pluginId": { "const": "gis" },
        "packageId": { "const": "semio:gis" },
        "cargoPackage": { "const": "semio-s-plugin-gis" },
        "componentFile": { "const": "semio_s_plugin_gis.wasm" }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "modeId", "windowKindId", "windowInstanceId", "actionId"],
      "properties": {
        "id": { "const": "s.gis.gismap@1/*#editor" },
        "modeId": { "const": "edit" },
        "windowKindId": { "const": "gis2d-main" },
        "windowInstanceId": { "const": "gis2d-main" },
        "actionId": { "const": "patchPositions" }
      }
    },
    "surface": { "const": "1:gis2d.play.composite" },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentSha256", "descriptorSha256"],
      "properties": {
        "componentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "descriptorSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "before", "after"],
      "properties": {
        "id": { "const": "shared-map" },
        "before": { "$ref": "#/$defs/position" },
        "after": { "$ref": "#/$defs/position" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationGeneration", "requestSequence", "transferGeneration", "headEditOrdinal", "headEditId", "lastCommitSeq", "chainSha256"],
      "properties": {
        "activationGeneration": { "const": 41 },
        "requestSequence": { "const": 7 },
        "transferGeneration": { "const": 51 },
        "headEditOrdinal": { "const": 7 },
        "headEditId": { "const": "edit-7" },
        "lastCommitSeq": { "const": 5 },
        "chainSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coldStatuses", "sceneSchema", "beforeMarker", "afterMarker", "patchSequenceMinimum"],
      "properties": {
        "coldStatuses": {
          "type": "array",
          "prefixItems": [{ "const": "applied" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "sceneSchema": { "const": "tiled-map@1" },
        "beforeMarker": { "const": "cold-before" },
        "afterMarker": { "const": "patched-after" },
        "patchSequenceMinimum": { "type": "integer", "minimum": 2 }
      }
    },
    "hostile": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["foreign-package", "stale-lifetime", "wrong-descriptor", "wrong-action-owner", "changed-component-after-receipt"] }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lon", "lat"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    }
  }
}
