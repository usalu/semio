{
  "name": "@semio-tech/gis-gisterrain",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:typescript",
    "role:artifact",
    "family:gis"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
