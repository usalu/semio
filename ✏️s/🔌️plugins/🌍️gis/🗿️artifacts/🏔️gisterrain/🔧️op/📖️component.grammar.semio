dialect grammar
grammar gis.gisterrain.op
extension gisterrain
use family-geo
start operation

operation = op-line*
op-line = ("set-exaggeration" | "set-imported-features" | "set-document") assign* block?
assign = IDENT "=" (TEXT | INT | FLOAT | BOOL | list | map | qty | block)
list = "[" value* "]"
map = "{" assign* "}"
value = TEXT | INT | FLOAT | BOOL | IDENT | qty | list | map | block
qty = (FLOAT | INT) IDENT?
block = "{" record* "}"
record = IDENT assign* block?
table = IDENT table-schema "{" row* "}"
table-schema = "[" col {"," col}* "]"
col = IDENT ":" IDENT
row = field+
field = IDENT "=" value | value
props = "{" prop* "}"
prop = IDENT "=" (TEXT | INT | FLOAT | BOOL | list | map | qty)
