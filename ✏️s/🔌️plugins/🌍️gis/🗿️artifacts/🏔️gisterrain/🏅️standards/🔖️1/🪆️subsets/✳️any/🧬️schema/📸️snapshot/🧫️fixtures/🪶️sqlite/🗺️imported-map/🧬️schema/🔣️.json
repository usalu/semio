{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gisterrain/sqlite/imported-map-fixture.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dialect",
    "words",
    "variantKinds",
    "position",
    "route",
    "region",
    "properties",
    "child",
    "semanticTables"
  ],
  "properties": {
    "dialect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "const": "s.gis.gisterrain"
        },
        "standard": {
          "const": "1"
        },
        "subset": {
          "const": "*"
        }
      }
    },
    "words": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/word"
      }
    },
    "variantKinds": {
      "const": [
        "null",
        "boolean",
        "unsigned",
        "signed",
        "float",
        "text",
        "bytes",
        "array",
        "object"
      ]
    },
    "position": {
      "$ref": "#/definitions/object"
    },
    "route": {
      "$ref": "#/definitions/object"
    },
    "region": {
      "$ref": "#/definitions/object"
    },
    "properties": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/definitions/member"
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "childId",
        "target"
      ],
      "properties": {
        "childId": {
          "type": "string"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactId",
            "dialect"
          ],
          "properties": {
            "artifactId": {
              "type": "string"
            },
            "dialect": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifactKind",
                "standard",
                "subset"
              ],
              "properties": {
                "artifactKind": {
                  "const": "s.stdio.semio"
                },
                "standard": {
                  "const": "v1"
                },
                "subset": {
                  "const": "mesh"
                }
              }
            }
          }
        }
      }
    },
    "semanticTables": {
      "const": [
        "gis_terrain_imported_map",
        "gis_terrain_position",
        "gis_terrain_route",
        "gis_terrain_region",
        "gis_terrain_property",
        "gis_terrain_value",
        "gis_terrain_boolean",
        "gis_terrain_unsigned",
        "gis_terrain_signed",
        "gis_terrain_float",
        "gis_terrain_text",
        "gis_terrain_bytes",
        "gis_terrain_array",
        "gis_terrain_member"
      ]
    }
  },
  "definitions": {
    "word": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/value"
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "members"
      ],
      "properties": {
        "kind": {
          "const": "object"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/member"
          }
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "unsigned"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "signed"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "word"
          ],
          "properties": {
            "kind": {
              "const": "float"
            },
            "word": {
              "$ref": "#/definitions/word"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "hex"
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "hex": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value"
              }
            }
          }
        },
        {
          "$ref": "#/definitions/object"
        }
      ]
    }
  }
}
