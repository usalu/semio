{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gisterrain/mutation/change-imported-features/schema.json",
  "title": "ChangeImportedFeatures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newImportedFeaturesJson"
  ],
  "properties": {
    "newImportedFeaturesJson": {
      "type": "string",
      "contentMediaType": "application/json",
