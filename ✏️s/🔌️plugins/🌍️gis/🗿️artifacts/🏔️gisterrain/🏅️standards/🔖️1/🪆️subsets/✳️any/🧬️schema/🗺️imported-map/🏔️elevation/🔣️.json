{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gisterrain/elevation.json",
  "description": "A rectangular WGS84 grid of elevation point samples in signed millimetres before vertical exaggeration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bounds", "rowsMillimetres"],
  "properties": {
    "bounds": {
      "x-semio-ui": { "label": { "en": "Elevation bounds", "de": "Grenzen des Höhenrasters" } },
      "description": "West, south, east and north sample coordinates in decimal degrees.",
      "type": "array",
      "items": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "missingSamples": {
      "x-semio-ui": { "label": { "en": "Missing sample mask", "de": "Maske für fehlende Rasterpunkte" } },
      "description": "Lowercase hexadecimal bytes, south-to-north and west-to-east, least significant bit first. Set bits mark missing samples with a zero height payload. Omit for a fully present grid.",
      "type": "string",
      "pattern": "^(?=[0-9a-f]*[1-9a-f])(?:[0-9a-f]{2})+(?![\\s\\S])",
      "minLength": 2,
      "maxLength": 1058
    },
    "rowsMillimetres": {
      "x-semio-ui": { "label": { "en": "Elevation rows", "de": "Zeilen des Höhenrasters" } },
      "description": "South-to-north rows with west-to-east samples. All rows have the same width.",
      "type": "array",
      "minItems": 2,
      "maxItems": 65,
      "items": {
        "type": "array",
        "items": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }
      },
      "anyOf": [
        { "items": { "type": "array", "minItems": 2, "maxItems": 2 } },
        { "items": { "type": "array", "minItems": 3, "maxItems": 3 } },
        { "items": { "type": "array", "minItems": 4, "maxItems": 4 } },
        { "items": { "type": "array", "minItems": 5, "maxItems": 5 } },
