{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Edit Terrain Elevation",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "column", "row", "radius", "value"],
  "properties": {
    "operation": { "enum": ["set-sample", "raise-lower", "flatten", "smooth", "offset", "fill-missing"] },
    "column": { "$ref": "#/definitions/sampleIndex" },
    "row": { "$ref": "#/definitions/sampleIndex" },
    "radius": { "$ref": "#/definitions/sampleIndex" },
    "value": { "type": "number" },
    "stroke": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "$ref": "#/definitions/sampleIndex" }
      },
      "description": "Ordered [column, row] brush anchors for raising, lowering or smoothing. The first anchor must match the command coordinates. The expanded stroke is limited to 64 stamps and the anchors must fit the current grid."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "smooth" } } },
      "then": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 100 } } },
      "else": { "properties": { "value": { "$ref": "#/definitions/metres" } } }
    },
    {
      "if": { "required": ["stroke"] },
      "then": { "properties": { "operation": { "enum": ["raise-lower", "smooth"] } } }
    }
  ],
  "definitions": {
    "sampleIndex": { "type": "integer", "minimum": 0, "maximum": 64 },
    "metres": {
      "type": "number",
      "minimum": -2147483.648,
      "maximum": 2147483.647,
      "multipleOf": 0.001,
      "description": "Elevation or elevation change in metres, represented internally by signed millimetres."
    }
  }
}
