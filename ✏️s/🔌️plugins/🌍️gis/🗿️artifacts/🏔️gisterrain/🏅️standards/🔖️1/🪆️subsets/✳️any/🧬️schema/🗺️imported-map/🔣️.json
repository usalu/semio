{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gisterrain/imported-map.json",
  "$ref": "#/definitions/map",
  "definitions": {
    "intrinsic": {
      "$comment": "Finite JSON projection only. Native intrinsic null, boolean, u64, i64, binary64 exact words, text, octets, ordered arrays and ordered members are authoritative in DSL/Pack/Proto. JSON media explicitly refuses inexpressible domains.",
      "type": [
        "null",
        "boolean",
        "number",
        "string",
        "array",
        "object"
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "not": {
            "enum": [
              "positions",
              "routes",
              "regions"
            ]
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Name"
            }
          }
        },
        "value": {
          "$ref": "#/definitions/intrinsic",
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Value",
              "de": "Wert"
            }
          }
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positions",
        "routes",
        "regions",
        "properties"
      ],
      "properties": {
        "positions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Positions",
              "de": "Positionen"
            }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Routes",
              "de": "Routen"
            }
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Regions",
              "de": "Regionen"
            }
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/member"
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Properties",
              "de": "Eigenschaften"
            }
          }
        }
      }
    }
  }
}
