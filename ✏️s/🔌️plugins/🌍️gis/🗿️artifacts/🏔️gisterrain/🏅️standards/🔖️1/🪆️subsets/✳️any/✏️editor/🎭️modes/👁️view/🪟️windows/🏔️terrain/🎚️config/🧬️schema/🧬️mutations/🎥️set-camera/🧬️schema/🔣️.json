{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/gis/gisterrain/window/config/mutation/set-camera/schema.json",
  "title": "SetCamera",
  "type": "object",
  "additionalProperties": false,
