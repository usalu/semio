{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/gis/gisterrain/artifact.json",
  "title": "GisTerrainArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exaggeration",
    "importedFeaturesJson",
    "selectedIds",
    "cameraJson"
  ],
  "properties": {
    "exaggeration": {
      "type": "number",
      "format": "double",
      "x-semio-state": "artifact"
    },
    "importedFeaturesJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "artifact"
    },
    "selectedIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "cameraJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    }
  }
}
