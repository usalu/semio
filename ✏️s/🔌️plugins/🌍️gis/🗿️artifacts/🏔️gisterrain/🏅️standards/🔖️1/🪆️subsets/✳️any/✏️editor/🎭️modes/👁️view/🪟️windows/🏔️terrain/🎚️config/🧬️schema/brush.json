{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/gis/gisterrain/window/config/brush.json",
  "title": "Terrain Brush Settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["radius", "elevationStepMillimetres", "smoothStrength"],
  "properties": {
    "radius": {"type": "integer", "minimum": 0, "maximum": 32},
    "elevationStepMillimetres": {"type": "integer", "minimum": 1, "maximum": 32767000, "description": "Height applied at the centre of the brush in millimetres."},
    "smoothStrength": {"type": "integer", "minimum": 0, "maximum": 100}
  }
}
