dialect protocol
protocol gis.gisterrain.mutations
version 1
schema gis.gisterrain
start record
framing record

# Op frame: `format u8`, `tag varint` and the kind's Pack wire-value record body.
header fixed 2
field format u8
field tag varint
record change-exaggeration tag=0
field payload bytes
record change-imported-features tag=1
field payload bytes
record replace-elevation-source tag=2
field payload bytes
