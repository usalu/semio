{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gisterrain/mutation/change-exaggeration/schema.json",
  "title": "ChangeExaggeration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newExaggeration"
  ],
  "properties": {
    "newExaggeration": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "New Vertical Exaggeration",
          "de": "Neue Überhöhung"
        },
        "description": {
          "en": "Factor that lifts the terrain heights.",
          "de": "Faktor, mit dem die Geländehöhen angehoben werden."
        },
        "step": 0.1,
        "precision": 2
      }
    }
  }
}
