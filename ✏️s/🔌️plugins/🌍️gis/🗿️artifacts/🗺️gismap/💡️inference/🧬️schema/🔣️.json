{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gis:gismap-inference-laws/v1",
  "$defs": {
    "GisMapApprovalHistoryPhase": {
      "enum": [
        "unavailable",
        "available",
        "submitting",
        "applied",
        "failed"
      ]
    },
    "GisMapApprovalHistoryExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "canUndo",
        "retained",
        "oldOwnerRetired"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/GisMapApprovalHistoryPhase"
        },
        "canUndo": {
          "type": "boolean"
        },
        "retained": {
          "type": "boolean"
        },
        "oldOwnerRetired": {
          "type": "boolean"
        }
      }
    },
    "GisMapInferencePortPhase": {
      "enum": [
        "idle",
        "submitting",
        "running",
        "offered",
        "approving",
        "indeterminate",
        "applied",
        "cancelled",
        "stale",
        "failed"
      ]
    },
    "GisMapInferencePortCode": {
      "enum": [
        "inference.unavailable",
        "inference.denied",
        "inference.not-found",
        "inference.invalid",
        "inference.bounds",
        "inference.conflict",
        "inference.capacity",
        "inference.expired",
        "inference.cancelled",
        "approval.commit-unavailable",
        "inference.storage",
        "inference.transport",
        "inference.lease-unverified"
      ]
    },
    "GisMapInferencePortHex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "GisMapInferencePortHex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "GisMapInferencePortSessionCapability": {
      "type": "string",
      "pattern": "^session\\.v1\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
    },
    "GisMapInferencePortJobState": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "GisMapInferencePortProposalState": {
      "enum": [
        "none",
        "offered",
        "approved",
        "stale",
        "cancelled"
      ]
    },
    "GisMapInferencePortPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "proposalHash",
        "regionId",
        "ring"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.gis-map-inference-preview/v1"
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "proposalHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "regionId": {
          "type": "string",
          "pattern": "^inference-[0-9a-f]{32}$"
        },
        "ring": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            ],
            "additionalItems": false
          }
        }
      }
    },
    "GisMapInferencePortStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "jobId",
        "cursor",
        "completed",
        "total",
        "proposalHash",
        "cancelRequested",
        "code"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/GisMapInferencePortPhase"
        },
        "jobId": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex32"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "proposalHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "$ref": "#/$defs/GisMapInferencePortPreview"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortCode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "GisMapInferencePortProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "runEpoch",
        "completed",
        "total",
        "atMs"
      ],
      "properties": {
        "cursor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "runEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "atMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "GisMapInferencePortReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "state",
        "proposalState",
        "proposalHash",
        "cursor",
        "expiresAtMs"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.inference-job-receipt/v1"
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "state": {
          "$ref": "#/$defs/GisMapInferencePortJobState"
        },
        "proposalState": {
          "$ref": "#/$defs/GisMapInferencePortProposalState"
        },
        "proposalHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "GisMapInferencePortPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "state",
        "proposalState",
        "proposalHash",
        "cancelRequested",
        "stale",
        "events",
        "progress",
        "nextCursor"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.inference-job-events/v1"
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "state": {
          "$ref": "#/$defs/GisMapInferencePortJobState"
        },
        "proposalState": {
          "$ref": "#/$defs/GisMapInferencePortProposalState"
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "proposalHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortHex64"
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "$ref": "#/$defs/GisMapInferencePortPreview"
        },
        "events": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object"
          }
        },
        "progress": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/GisMapInferencePortProgress"
          }
        },
        "nextCursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "GisMapInferencePortApprovalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "jobId",
        "mutationId",
        "commandHash",
        "proposalHash",
        "applied",
        "undo"
      ],
      "properties": {
        "schema": {
          "const": "semio.hub.inference-approval-receipt/v1"
        },
        "jobId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "mutationId": {
          "$ref": "#/$defs/GisMapInferencePortHex32"
        },
        "commandHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "proposalHash": {
          "$ref": "#/$defs/GisMapInferencePortHex64"
        },
        "applied": {
          "type": "boolean"
        },
        "undo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetId",
            "expectedCurrent"
          ],
          "properties": {
            "targetId": {
              "$ref": "#/$defs/GisMapInferencePortHex32"
            },
            "expectedCurrent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "documentId",
                "headEditOrdinal",
                "headEditId",
                "lastCommitSeq",
                "chainSha256"
              ],
              "properties": {
                "documentId": {
                  "type": "string",
                  "minLength": 1
                },
                "headEditOrdinal": {
                  "type": "integer",
                  "minimum": 1
                },
                "headEditId": {
                  "type": "string",
                  "minLength": 1
                },
                "lastCommitSeq": {
                  "type": "integer",
                  "minimum": 1
                },
                "chainSha256": {
                  "$ref": "#/$defs/GisMapInferencePortHex64"
                }
              }
            }
          }
        }
      }
    },
    "GisMapInferencePortEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "start",
            "lease-unverified",
            "receipt",
            "page",
            "approve",
            "approval",
            "cancel",
            "indeterminate",
            "failed",
            "clear"
          ]
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/GisMapInferencePortReceipt"
            },
            {
              "$ref": "#/$defs/GisMapInferencePortApprovalReceipt"
            }
          ]
        },
        "page": {
          "$ref": "#/$defs/GisMapInferencePortPage"
        },
        "code": {
          "$ref": "#/$defs/GisMapInferencePortCode"
        }
      }
    },
    "GisMapInferencePendingCancelProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "jobId",
        "cancelRequested"
      ],
      "properties": {
        "phase": {
          "$ref": "#/$defs/GisMapInferencePortPhase"
        },
        "jobId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/GisMapInferencePortHex32"
            }
          ]
        },
        "cancelRequested": {
          "const": true
        }
      }
    },
    "GisMapInferencePortOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "viewBox",
        "path"
      ],
      "properties": {
        "regionId": {
          "type": "string",
          "pattern": "^inference-[0-9a-f]{32}$"
        },
        "viewBox": {
          "const": "0 0 100 100"
        },
        "path": {
          "type": "string",
          "pattern": "^M [0-9.]+ [0-9.]+(?: L [0-9.]+ [0-9.]+){4} Z$"
        }
      }
    },
    "GisMapInferencePortLocaleText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "GisMapInferencePortControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "reject",
        "approve",
        "cancel",
        "overlay"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/GisMapInferencePortLocaleText"
        },
        "reject": {
          "$ref": "#/$defs/GisMapInferencePortLocaleText"
        },
        "approve": {
          "$ref": "#/$defs/GisMapInferencePortLocaleText"
        },
        "cancel": {
          "$ref": "#/$defs/GisMapInferencePortLocaleText"
        },
        "overlay": {
          "$ref": "#/$defs/GisMapInferencePortLocaleText"
        }
      }
    },
    "GisMapInferencePortUiRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "cancel",
        "reject",
        "approve",
        "overlay"
      ],
      "properties": {
        "request": {
          "type": "boolean"
        },
        "cancel": {
          "type": "boolean"
        },
        "reject": {
          "type": "boolean"
        },
        "approve": {
          "type": "boolean"
        },
        "overlay": {
          "type": "boolean"
        }
      }
    },
    "GisMapInferencePortUiAffordances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idle",
        "submitting",
        "running",
        "offered",
        "approving"
      ],
      "properties": {
        "idle": {
          "$ref": "#/$defs/GisMapInferencePortUiRow"
        },
        "submitting": {
          "$ref": "#/$defs/GisMapInferencePortUiRow"
        },
        "running": {
          "$ref": "#/$defs/GisMapInferencePortUiRow"
        },
        "offered": {
          "$ref": "#/$defs/GisMapInferencePortUiRow"
        },
        "approving": {
          "$ref": "#/$defs/GisMapInferencePortUiRow"
        }
      }
    },
    "GisMapPeerRebootstrapHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "GisMapPeerRebootstrapScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "GisMapPeerRebootstrapFrontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "headEditOrdinal",
        "headEditId",
        "lastCommitSeq",
        "chainHash"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "headEditOrdinal": {
          "type": "integer",
          "minimum": 1
        },
        "headEditId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "lastCommitSeq": {
          "type": "integer",
          "minimum": 1
        },
        "chainHash": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "MountedGisMapProbeSourceV1": {
      "description": "🔬️ The mounted state a GIS map probe is taken from: the exact scope, activation identity, checkpoint frontier, content digests and guest-acknowledged UI revision it observed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "clientInstanceId",
        "activationGeneration",
        "catalogGenerationId",
        "componentSha256",
        "descriptorSha256",
        "browserActorSha256",
        "activeCheckpointId",
        "descriptorDigestV1",
        "frontier",
        "uiRevision",
        "verifiedSurfaceId",
        "surface",
        "regions"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/ShellScopeV1"
        },
        "clientInstanceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "activationGeneration": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "catalogGenerationId": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "componentSha256": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "descriptorSha256": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "browserActorSha256": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "activeCheckpointId": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "descriptorDigestV1": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "frontier": {
          "$ref": "#/$defs/MountedArtifactFrontierV1"
        },
        "uiRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "verifiedSurfaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "regions": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "MountedGisMapProbeV1": {
      "description": "🗺️ The projection a mounted GIS map publishes. It repeats the acknowledged checkpoint, frontier and mounted identity exactly and reduces the map root to its region ids; the root kind is fixed by the artifact standard.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "clientInstanceId",
        "activationGeneration",
        "catalogGenerationId",
        "componentSha256",
        "descriptorSha256",
        "browserActorSha256",
        "activeCheckpointId",
        "descriptorDigestV1",
        "frontier",
        "uiRevision",
        "rootKind",
        "regionIds"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/ShellScopeV1"
        },
        "clientInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "activationGeneration": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "catalogGenerationId": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "componentSha256": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "descriptorSha256": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "browserActorSha256": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "activeCheckpointId": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "descriptorDigestV1": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "frontier": {
          "$ref": "#/$defs/MountedArtifactFrontierV1"
        },
        "uiRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rootKind": {
          "const": "tiled-map"
        },
        "regionIds": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "MountedGisMapProbeRefusalV1": {
      "enum": [
        "unacknowledged-identity",
        "unacknowledged-feedback",
        "stale-ui-revision",
        "substituted-checkpoint",
        "stale-frontier",
        "non-map-root",
        "malformed-map-pack",
        "duplicate-region-id"
      ]
    },
    "ShellScopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "documentId"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "Sha256HexV1": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "MountedArtifactFrontierV1": {
      "description": "🌿 The exact scope-bound checkpoint frontier acknowledged by one mounted browser actor.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "headEditOrdinal",
        "headEditId",
        "lastCommitSeq",
        "chainHash"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "headEditOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "headEditId": {
          "type": "string",
          "maxLength": 256
        },
        "lastCommitSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "chainHash": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "headEditOrdinal": {
              "const": 0
            },
            "headEditId": {
              "const": ""
            },
            "lastCommitSeq": {
              "const": 0
            },
            "chainHash": {
              "type": "array",
              "items": {
                "const": 0
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "headEditOrdinal": {
              "type": "integer",
              "minimum": 1
            },
            "headEditId": {
              "type": "string",
              "minLength": 1
            },
            "lastCommitSeq": {
              "type": "integer",
              "minimum": 1
            },
            "chainHash": {
              "type": "array",
              "contains": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/GisMapInferencePortStatus"
}
