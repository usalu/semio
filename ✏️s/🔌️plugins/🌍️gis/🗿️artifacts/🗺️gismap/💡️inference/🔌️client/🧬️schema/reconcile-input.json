{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gis:document-http/reconcile-input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "requestId"
  ],
  "properties": {
    "schema": {
      "const": "semio.framework.job-reconcile/v1"
    },
    "version": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
