{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/map/create-region-group.json",
  "$ref": "#/$defs/GisMapCreateRegionGroupMembership",
  "$defs": {
    "Point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "Feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      }
    },
    "GisMapCreateRegionGroupMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drawingChildId",
        "valueChildId",
        "imageChildId"
      ],
      "properties": {
        "drawingChildId": {
          "const": "gismap-drawing"
        },
        "valueChildId": {
          "const": "gismap-value"
        },
        "imageChildId": {
          "const": null
        }
      }
    }
  }
}
