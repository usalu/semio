dialect grammar
grammar gis.gismap.op
extension gismap
use family-geo
start operation

operation = op-line*
op-line = ("add-position" | "remove-position" | "move-position" | "patch-position" | "add-route" | "remove-route" | "move-route" | "patch-route" | "add-region" | "remove-region" | "move-region" | "patch-region" | "set-document") assign* block?
assign = IDENT "=" (TEXT | INT | FLOAT | BOOL | list | map | qty | block)
list = "[" value* "]"
map = "{" assign* "}"
value = TEXT | INT | FLOAT | BOOL | IDENT | qty | list | map | block
qty = (FLOAT | INT) IDENT?
block = "{" record* "}"
record = IDENT assign* block?
table = IDENT table-schema "{" row* "}"
table-schema = "[" col {"," col}* "]"
col = IDENT ":" IDENT
row = field+
field = IDENT "=" value | value
props = "{" prop* "}"
prop = IDENT "=" (TEXT | INT | FLOAT | BOOL | list | map | qty)
