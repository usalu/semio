{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gismap/mutation/reorder-regions/schema.json",
  "title": "ReorderRegions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "toIndex"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Region",
          "de": "Region"
        },
        "description": {
          "en": "The region this mutation addresses.",
          "de": "Die Region, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "region"
        }
      }
    },
    "toIndex": {
      "type": "integer",
      "minimum": 0
    }
  }
}
