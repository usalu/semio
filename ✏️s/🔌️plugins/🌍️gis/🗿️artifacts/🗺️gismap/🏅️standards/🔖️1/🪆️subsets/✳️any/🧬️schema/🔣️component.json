{
  "$id": "https://semio.tech/schema/s/gis/gismap/artifact.json",
  "title": "GisMapArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "positions",
    "routes",
    "regions",
    "selectedIds",
    "featureSelectionJson",
    "layerVisibility",
    "layerStrokeScale",
    "cameraJson",
    "renderMode",
    "vectorStyle",
    "lodMode",
    "hoverJson",
    "selectionMethod",
    "selectionMode",
    "locale"
  ],
  "properties": {
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GisMapFeature"
      },
      "x-semio-state": "artifact"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GisMapFeature"
      },
      "x-semio-state": "artifact"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GisMapFeature"
      },
      "x-semio-state": "artifact"
    },
    "selectedIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    },
    "featureSelectionJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "presence"
    },
    "layerVisibility": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "x-semio-state": "presence"
    },
    "layerStrokeScale": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "format": "double"
      },
      "x-semio-state": "presence"
    },
    "cameraJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    },
    "renderMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "vectorStyle": {
      "type": "string",
      "x-semio-state": "config"
    },
    "lodMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "hoverJson": {
      "type": "string",
      "contentMediaType": "application/json",
      "x-semio-state": "config"
    },
    "selectionMethod": {
      "type": "string",
      "x-semio-state": "config"
    },
    "selectionMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "GisMapFeature": {
      "title": "GisMapFeature",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "GisMapBoolEntry": {
      "title": "GisMapBoolEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "GisMapNumberEntry": {
      "title": "GisMapNumberEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
