{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gismap/diff.json",
  "title": "GisMapDiff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "positions": {
      "anyOf": [
        {
          "$ref": "#/$defs/GisMapFeaturesDelta"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    },
    "routes": {
      "anyOf": [
        {
          "$ref": "#/$defs/GisMapFeaturesDelta"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    },
    "regions": {
      "anyOf": [
        {
          "$ref": "#/$defs/GisMapFeaturesDelta"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "GisMapFeaturesDelta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GisMapFeatureRemoval"
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GisMapFeatureInsertion"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GisMapFeatureRelocation"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GisMapFeatureModification"
          }
        }
      }
    },
    "GisMapFeatureModification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/gis/gismap/feature.json#/$defs/GisMapFeaturePatch"
        }
      },
      "required": [
        "id",
        "patch"
      ]
    },
    "GisMapFeatureRemoval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "GisMapFeatureInsertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "row"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/gis/gismap/feature.json"
        }
      }
    },
    "GisMapFeatureRelocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
