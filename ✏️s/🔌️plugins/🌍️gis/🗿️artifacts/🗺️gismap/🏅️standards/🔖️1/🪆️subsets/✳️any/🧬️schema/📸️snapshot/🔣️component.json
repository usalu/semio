{
  "$id": "https://semio.tech/schema/s/gis/gismap/snapshot.json",
  "title": "GisMapSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "positions",
    "routes",
    "regions"
  ],
  "properties": {
    "positions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GisMapFeature"
      },
      "x-semio-state": "artifact"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GisMapFeature"
      },
      "x-semio-state": "artifact"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GisMapFeature"
      },
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "GisMapFeature": {
      "title": "GisMapFeature",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
