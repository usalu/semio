{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/window/gis/map/config/mutation/set-layer-stroke-scale/schema.json",
  "title": "SetLayerStrokeScale",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "layerId",
    "value"
  ],
  "properties": {
    "operation": {
      "const": "setLayerStrokeScale"
    },
    "layerId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "Layer",
          "de": "Ebene"
        },
        "group": "layer",
        "order": 10
      }
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Stroke scale",
          "de": "Linienstärkenfaktor"
        },
        "description": {
          "en": "Factor on the layer's line widths; empty resets it.",
          "de": "Faktor auf die Linienstärken der Ebene; leer setzt ihn zurück."
        },
        "step": 0.1,
        "precision": 2,
        "group": "layer",
        "order": 20
      }
    }
  }
}
