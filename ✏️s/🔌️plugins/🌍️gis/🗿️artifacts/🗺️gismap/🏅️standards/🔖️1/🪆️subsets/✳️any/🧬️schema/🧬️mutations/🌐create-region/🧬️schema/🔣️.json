{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gismap/mutation/create-region/schema.json",
  "title": "CreateRegion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "item"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Insertion index",
          "de": "Einfügeindex"
        },
        "step": 1,
        "group": "order"
      }
    },
    "item": {
      "title": "MapFeature",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Feature ID",
              "de": "Kartenobjekt-ID"
            }
          }
        },
        "data": {
          "description": "any JSON value",
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Feature data",
              "de": "Kartenobjektdaten"
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Feature",
          "de": "Kartenobjekt"
        }
      }
    }
  }
}
