{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/gis/gismap/artifact.json",
  "title": "GisMapArtifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "positions": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/gis/gismap/feature.json"
      },
      "x-semio-state": "artifact"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/gis/gismap/feature.json"
      },
      "x-semio-state": "artifact"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/gis/gismap/feature.json"
      },
      "x-semio-state": "artifact"
    },
    "drawing": {
      "$ref": "https://semio.tech/schema/os/store/child.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "image": {
      "anyOf": [
        {
          "$ref": "https://semio.tech/schema/os/store/child.json"
        },
        {
          "type": "null"
        }
      ],
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    },
    "value": {
      "$ref": "https://semio.tech/schema/os/store/child.json",
      "x-semio-state": "artifact",
      "x-semio-child-kind": "s.stdio.semio"
    }
  },
  "required": [
    "positions",
    "routes",
    "regions",
    "drawing",
    "value"
  ]
}
