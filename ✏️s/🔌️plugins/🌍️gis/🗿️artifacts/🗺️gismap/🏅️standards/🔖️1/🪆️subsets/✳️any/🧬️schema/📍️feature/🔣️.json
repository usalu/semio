{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gismap/feature.json",
  "title": "GisMapFeature",
  "$ref": "#/$defs/GisMapFeature",
  "$defs": {
    "GisMapFeature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "data": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json"
        }
      },
      "required": [
        "id",
        "data"
      ]
    },
    "GisMapFeaturePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GisMapFeaturePropertyEdit"
          }
        }
      }
    },
    "GisMapFeaturePropertyEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "set": {
          "$ref": "#/$defs/GisMapFeaturePropertyValue"
        }
      }
    },
    "GisMapFeaturePropertyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json"
        }
      }
    }
  }
}
