dialect protocol
protocol gis.gismap.mutations
version 1
schema gis.gismap
start record

record CreatePosition tag 1
  field index varint

record DeletePosition tag 2
  field id utf8

record ReplacePositionData tag 3
  field id utf8
  field new_data bytes

record ReorderPositions tag 4
  field id utf8
  field to_index varint

record CreateRoute tag 5
  field index varint

record DeleteRoute tag 6
  field id utf8

record ReplaceRouteData tag 7
  field id utf8
  field new_data bytes

record ReorderRoutes tag 8
  field id utf8
  field to_index varint

record CreateRegion tag 9
  field index varint

record DeleteRegion tag 10
  field id utf8

record ReplaceRegionData tag 11
  field id utf8
  field new_data bytes

record ReorderRegions tag 12
  field id utf8
  field to_index varint
