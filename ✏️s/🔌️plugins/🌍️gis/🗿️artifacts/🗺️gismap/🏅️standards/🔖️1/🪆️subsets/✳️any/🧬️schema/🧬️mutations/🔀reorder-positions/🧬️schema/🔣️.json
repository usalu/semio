{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/gis/gismap/mutation/reorder-positions/schema.json",
  "title": "ReorderPositions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "toIndex"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "The position this mutation addresses.",
          "de": "Die Position, die diese Mutation adressiert."
        },
        "ref": {
          "kind": "position"
        }
      }
    },
    "toIndex": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Destination index",
          "de": "Zielindex"
        },
        "step": 1,
        "group": "order"
      }
    }
  }
}
