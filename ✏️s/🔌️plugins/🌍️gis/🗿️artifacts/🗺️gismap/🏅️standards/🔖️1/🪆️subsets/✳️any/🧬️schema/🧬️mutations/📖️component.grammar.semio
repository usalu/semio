dialect grammar
grammar gis.gismap.op
extension gismap
use family-geo
start mutation

artifact-mark = "gis.gismap-op"
mutation = artifact-mark geo-op+
geo-op = "set-crs" crs-field+ | "add-point" point-field+ | "tile-ref" tile-field+
crs-field = "crs" "=" IDENT
point-field = "lat" "=" FLOAT | "lon" "=" FLOAT | "alt" "=" FLOAT
tile-field = "z" "=" INT | "x" "=" INT | "y" "=" INT
point = FLOAT FLOAT FLOAT?
