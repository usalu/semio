{
  "name": "@semio-tech/demonstrator-playground",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:typescript",
    "role:artifact",
    "family:demonstrator"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🟦️.ts",
        "{projectRoot}/📜️script.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🎪️demonstrator/🗿️artifacts/🎪️playground/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🟦️.ts",
        "{projectRoot}/📜️script.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🎪️demonstrator/🗿️artifacts/🎪️playground/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🟦️.ts",
        "{projectRoot}/📜️script.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🎪️demonstrator/🗿️artifacts/🎪️playground/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "verify-snapshot-sqlite-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🟦️.ts",
        "{projectRoot}/📜️script.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🎪️demonstrator/🗿️artifacts/🎪️playground/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts verify snapshot-sqlite-source",
        "forwardAllArgs": true
      }
    }
  }
}
