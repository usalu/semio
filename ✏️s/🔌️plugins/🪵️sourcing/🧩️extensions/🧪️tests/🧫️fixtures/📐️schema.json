{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 3,
  "maxItems": 3,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "moduleId",
      "typology",
      "kindIds",
      "availability"
    ],
    "properties": {
      "moduleId": {
        "enum": [
          "beams",
          "slabs",
          "windows"
        ]
      },
      "typology": {
        "$ref": "#/definitions/node"
      },
      "kindIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "availability": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    }
  }
}
