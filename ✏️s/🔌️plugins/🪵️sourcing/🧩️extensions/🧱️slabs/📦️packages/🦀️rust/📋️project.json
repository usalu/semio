{
  "name": "@semio-tech/sourcing-extension-slabs-rust",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/✏️s/🔌️plugins/🪵️sourcing/🧩️extensions/🧱️slabs/**/*.rs",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🪵️sourcing/🧩️extensions/🧱️slabs/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🪵️sourcing/🧩️extensions/🧱️slabs/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🪵️sourcing/🧩️extensions/🧱️slabs/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🪵️sourcing/🧩️extensions/🧱️slabs/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🪵️sourcing/🧩️extensions/🧱️slabs/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts package",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/sourcing-module-slabs.sxt"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🏪️store/**/*.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/**/*.ts"
      ]
    },
    "describe": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/🪵️sourcing/🧩️extensions/🧱️slabs/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts describe",
        "forwardAllArgs": true
      },
      "outputs": [
        "{workspaceRoot}/✏️s/🔌️plugins/🪵️sourcing/🧩️extensions/🧱️slabs/🛂️.descriptor.semio",
        "{workspaceRoot}/✏️s/🔌️plugins/🪵️sourcing/🧩️extensions/🧱️slabs/🔣️.json"
      ]
    }
  }
}
