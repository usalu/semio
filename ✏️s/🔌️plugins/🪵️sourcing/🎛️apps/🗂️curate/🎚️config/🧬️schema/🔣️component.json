{
  "$id": "https://semio.tech/schema/app/sourcing/curate/config.json",
  "title": "SourcingCurateConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filters",
    "locale",
    "contributionsJson"
  ],
  "properties": {
    "filters": {
      "$ref": "#/$defs/Filters",
      "x-semio-state": "local-ui"
    },
    "selectedObjectId": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "local-ui"
    },
    "contributionsJson": {
      "type": "string",
      "x-semio-state": "local-ui"
    }
  },
  "$defs": {
    "SortDirection": {
      "title": "SortDirection",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "TableSort": {
      "title": "TableSort",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columnId",
        "direction"
      ],
      "properties": {
        "columnId": {
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/SortDirection"
        }
      }
    },
    "Filters": {
      "title": "Filters",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "moduleIds",
        "typologyPath",
        "minAvailability"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typologyPath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minAvailability": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sort": {
          "$ref": "#/$defs/TableSort"
        }
      }
    }
  }
}
