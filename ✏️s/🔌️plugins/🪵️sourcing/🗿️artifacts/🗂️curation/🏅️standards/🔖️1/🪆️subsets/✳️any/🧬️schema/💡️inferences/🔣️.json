{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sourcing/curation/inference.json",
  "title": "CurationInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "$ref": "#/$defs/CurationEntries",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "CurationEntries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stockCount",
        "entryCount",
        "totalCount"
      ],
      "properties": {
        "stockCount": {
          "type": "integer"
        },
        "entryCount": {
          "type": "integer"
        },
        "totalCount": {
          "type": "integer"
        }
      }
    }
  }
}
