{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/sourcing/curation/config/schema.json",
  "title": "SourcingCurationConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filters",
    "contributionsJson"
  ],
  "properties": {
    "filters": {
      "$ref": "#/$defs/Filters",
      "x-semio-state": "config"
    },
    "contributionsJson": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "Filters": {
      "title": "Filters",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "moduleIds",
        "typologyPath",
        "minAvailability"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typologyPath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minAvailability": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sort": {
          "$ref": "https://semio.tech/schema/s/sourcing/curation/artifact.json#/$defs/TableSort"
        }
      }
    }
  }
}
