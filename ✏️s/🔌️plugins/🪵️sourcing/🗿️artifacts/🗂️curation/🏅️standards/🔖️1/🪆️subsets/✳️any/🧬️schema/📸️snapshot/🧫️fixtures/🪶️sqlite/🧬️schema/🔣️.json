{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot",
    "binary64Words",
    "binary32Words",
    "malformedSql",
    "control",
    "literalChildIds",
    "literalChildAliases"
  ],
  "properties": {
    "literalChildAliases":{"type":"array","minItems":3,"items":{"type":"object","additionalProperties":false,"required":["childId","artifactId"],"properties":{"childId":{"type":"string"},"artifactId":{"type":"string"}}}},
    "snapshot": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/sourcing/curation/snapshot.json"
    },
    "binary64Words": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "binary32Words": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}$"
      }
    },
    "malformedSql": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectionLength",
        "largeTextBytes",
        "maxOwnedBytes",
        "tinyFileBytes"
      ],
      "properties": {
        "collectionLength": {
          "type": "integer",
          "minimum": 1024
        },
        "largeTextBytes": {
          "type": "integer",
          "minimum": 131073
        },
        "maxOwnedBytes": {
          "type": "integer",
          "minimum": 65536
        },
        "tinyFileBytes": {
          "type": "integer",
          "minimum": 512
        }
      }
    },
    "literalChildIds": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    }
  }
}
