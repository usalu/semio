{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/sourcing/curation/mutation/create-curated-item/schema.json",
  "title": "CreateCuratedItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "item"
  ],
  "properties": {
    "mutation": {
      "const": "createCuratedItem"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "count"
      ],
      "properties": {
        "objectId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "value",
            "label": {
              "en": "Object",
              "de": "Objekt"
            },
            "description": {
              "en": "The pool object to curate.",
              "de": "Das zu kuratierende Pool-Objekt."
            },
            "ref": {
              "kind": "object",
              "domain": "rows",
              "granularity": "object"
            }
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    }
  }
}
