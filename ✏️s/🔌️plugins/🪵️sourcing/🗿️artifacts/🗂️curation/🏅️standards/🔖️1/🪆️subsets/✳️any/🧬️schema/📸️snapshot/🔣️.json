{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/sourcing/curation/snapshot.json",
  "title": "CurationSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog",
    "stockExtra",
    "curated"
  ],
  "properties": {
    "catalog": {
      "$ref": "https://semio.tech/schema/s/stdio/semio/v1/base/child.json#/$defs/kit",
      "x-semio-state": "artifact",
      "x-semio-child": "s.stdio.semio"
    },
    "stockExtra": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/sourcing/curation/artifact.json#/$defs/ObjectKindExtra"
      },
      "x-semio-state": "artifact"
    },
    "curated": {
      "type": "array",
      "items": {
        "$ref": "https://semio.tech/schema/s/sourcing/curation/artifact.json#/$defs/CuratedItem"
      },
      "x-semio-state": "artifact"
    }
  }
}
