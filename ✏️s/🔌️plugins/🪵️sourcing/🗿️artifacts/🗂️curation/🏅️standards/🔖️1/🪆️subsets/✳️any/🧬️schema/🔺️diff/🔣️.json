{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/sourcing/curation/diff.json",
  "title": "CurationDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "title": "CurationArtifact",
      "type": "object",
      "x-semio-state": "artifact"
    },
    "catalog": {
      "type": "object",
      "x-semio-state": "artifact",
      "x-semio-child": "s.stdio.semio.kit"
    },
    "stockExtra": {
      "$ref": "#/$defs/CurationStockExtraDelta",
      "x-semio-state": "artifact"
    },
    "curated": {
      "$ref": "#/$defs/CurationCuratedDelta",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "CurationStringList": {
      "title": "CurationStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CurationStockExtraDelta": {
      "title": "CurationStockExtraDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/sourcing/curation/artifact.json#/$defs/ObjectKindExtra"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CurationObjectKindExtraPatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CurationObjectKindExtraPatchEntry": {
      "title": "CurationObjectKindExtraPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "extra"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "extra": {
          "$ref": "https://semio.tech/schema/s/sourcing/curation/artifact.json#/$defs/ObjectKindExtra"
        }
      }
    },
    "CurationCuratedDelta": {
      "title": "CurationCuratedDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "https://semio.tech/schema/s/sourcing/curation/artifact.json#/$defs/CuratedItem"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CurationCuratedPatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CurationCuratedPatchEntry": {
      "title": "CurationCuratedPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId"
      ],
      "properties": {
        "objectId": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "uint32"
        }
      }
    }
  }
}
