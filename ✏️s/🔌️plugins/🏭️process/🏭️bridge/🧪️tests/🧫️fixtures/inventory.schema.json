{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Process mutation bridge inventory fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bridgeVersion", "producedBy", "document", "refusals"],
  "properties": {
    "schema": { "type": "string", "minLength": 1 },
    "bridgeVersion": { "type": "integer", "minimum": 1 },
    "producedBy": { "type": "string", "minLength": 1 },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "ids"],
      "properties": {
        "request": { "type": "array", "minItems": 4, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
        "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "array", "items": { "type": "string" } }
    }
  }
}
