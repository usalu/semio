{
  "$id": "https://semio.tech/schema/app/process/3d/presence.json",
  "title": "Process3dPresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectionMethod",
    "engagementInput",
    "cameraPosition",
    "cameraTarget",
    "cameraFov",
    "activeUtilityId"
  ],
  "properties": {
    "selectedId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "hoveredId": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "selectedFaceId": {
      "type": "integer",
      "minimum": 0,
      "x-semio-state": "presence"
    },
    "selectionMethod": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "engagementInput": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "cameraPosition": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-state": "presence"
    },
    "cameraTarget": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "x-semio-state": "presence"
    },
    "cameraFov": {
      "type": "number",
      "x-semio-state": "presence"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "presence"
    }
  }
}
