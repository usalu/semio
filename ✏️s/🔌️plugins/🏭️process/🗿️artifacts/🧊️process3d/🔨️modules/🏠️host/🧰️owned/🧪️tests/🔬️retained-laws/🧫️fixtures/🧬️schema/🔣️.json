{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stops",
    "zeroReleaseBytes",
    "releaseBytes",
    "maximumCloseSteps",
    "expected",
    "physicalBacking",
    "maximumAdmittedReleaseBytes",
    "maximumWorkItems",
    "decoderBacking",
    "structuralWork"
  ],
  "properties": {
    "stops": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 128
      }
    },
    "zeroReleaseBytes": {
      "const": 0
    },
    "releaseBytes": {
      "const": 4096
    },
    "maximumCloseSteps": {
      "const": 100000
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepLength",
        "stepCapacity",
        "toolLength",
        "toolCapacity",
        "flow",
        "writer",
        "output",
        "jsonRetirement",
        "payloadRetirement"
      ],
      "properties": {
        "stepLength": {
          "const": 0
        },
        "stepCapacity": {
          "const": 0
        },
        "toolLength": {
          "const": 0
        },
        "toolCapacity": {
          "const": 0
        },
        "flow": {
          "const": false
        },
        "writer": {
          "const": false
        },
        "output": {
          "const": false
        },
        "jsonRetirement": {
          "const": false
        },
        "payloadRetirement": {
          "const": false
        }
      }
    },
    "physicalBacking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacityItems",
        "underGrantOffset",
        "expectedUnderGrantReleasedItems",
        "expectedUnderGrantReleasedBytes",
        "expectedFullGrantReleasedItems"
      ],
      "properties": {
        "capacityItems": {
          "const": 1
        },
        "underGrantOffset": {
          "const": 1
        },
        "expectedUnderGrantReleasedItems": {
          "const": 0
        },
        "expectedUnderGrantReleasedBytes": {
          "const": 0
        },
        "expectedFullGrantReleasedItems": {
          "const": 1
        }
      }
    },
    "maximumAdmittedReleaseBytes": {
      "const": 262144
    },
    "maximumWorkItems": {
      "const": 1
    },
    "structuralWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextByteDemand", "physicalReleaseBytes"],
      "properties": {
        "nextByteDemand": { "const": 1 },
        "physicalReleaseBytes": { "const": 0 }
      }
    },
    "decoderBacking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacityItems",
        "maximumAdvertisedTurns",
        "queryEachDemand",
        "expectedTerminal"
      ],
      "properties": {
        "capacityItems": {
          "const": 64
        },
        "maximumAdvertisedTurns": {
          "const": 8
        },
        "queryEachDemand": {
          "const": true
        },
        "expectedTerminal": {
          "const": true
        }
      }
    }
  }
}
