field format u8
field ordinal varint
field body bytes
record SetStock tag=3
field format u8
field ordinal varint
field body bytes
record SetCursor tag=4
field format u8
field ordinal varint
field body bytes
record SetSnapshot tag=5
field format u8
field ordinal varint
field body bytes
chain hash u64
