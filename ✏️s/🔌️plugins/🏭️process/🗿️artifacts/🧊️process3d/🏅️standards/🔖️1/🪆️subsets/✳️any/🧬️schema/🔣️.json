{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/process/process3d/artifact.json",
  "title": "Process3dArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workshop",
    "stockId",
    "stockLabel",
    "stockPose",
    "stockPayload",
    "stockSolid",
    "steps",
    "stepPayloads",
    "toolSolids"
  ],
  "properties": {
    "workshop": {
      "$ref": "#/$defs/Process3dWorkshop",
      "x-semio-state": "artifact"
    },
    "stockId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "stockLabel": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "stockPose": {
      "$ref": "#/$defs/Process3dPose",
      "x-semio-state": "artifact"
    },
    "stockPayload": {
      "$ref": "#/$defs/Process3dStock",
      "x-semio-state": "artifact"
    },
    "stockSolid": {
      "$ref": "#/$defs/ArtifactChildHandle",
      "x-semio-state": "artifact"
    },
    "steps": {
      "$ref": "#/$defs/ArtifactChildHandle",
      "x-semio-state": "artifact"
    },
    "stepPayloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Process3dStep"
      },
      "x-semio-state": "artifact"
    },
    "toolSolids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactChildHandle"
      },
      "x-semio-state": "artifact"
    },
    "resolvedUpTo": {
      "type": "integer",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "Process3dWorkshop": {
      "title": "Process3dWorkshop",
      "type": "object"
    },
    "Process3dStock": {
      "title": "Process3dStock",
      "type": "object"
    },
    "Process3dPose": {
      "title": "Process3dPose",
      "type": "object"
    },
    "ArtifactChildHandle": {
      "title": "ArtifactChildHandle",
      "type": "object",
      "required": [
        "childId",
        "target"
      ],
      "properties": {
        "childId": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      }
    },
    "Process3dStep": {
      "title": "Process3dStep",
      "type": "object"
    },
    "Process3dRetainedRouteLaws": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source",
        "routeCount",
        "migratedCount",
        "limits",
        "groups",
        "oracleCases",
        "laws"
      ],
      "properties": {
        "schema": {
          "const": "semio.process3d.retained-route-laws.v1"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "routeCount": {
          "const": 33
        },
        "migratedCount": {
          "type": "integer",
          "minimum": 0
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rawBytes",
            "workItems",
            "chunkBytes",
            "stepMicros",
            "storeBytes",
            "documentGrantBytes",
            "documentMaximumBytes"
          ],
          "properties": {
            "rawBytes": {
              "const": 8192
            },
            "workItems": {
              "const": 64
            },
            "chunkBytes": {
              "const": 256
            },
            "stepMicros": {
              "const": 7500
            },
            "storeBytes": {
              "const": 16384
            },
            "documentGrantBytes": {
              "const": 4096
            },
            "documentMaximumBytes": {
              "const": 524288
            }
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "execution",
              "lanes",
              "routes"
            ],
            "properties": {
              "status": {
                "const": "migrated"
              },
              "execution": {
                "enum": [
                  "bounded",
                  "resumable"
                ]
              },
              "lanes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "artifact",
                    "config",
                    "draft",
                    "presence",
                    "transient",
                    "child",
                    "host-only"
                  ]
                }
              },
              "routes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "oracleCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bytes",
              "expectedExtent"
            ],
            "properties": {
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "expectedExtent": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          }
        },
        "laws": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exactRoutePartition",
            "perOperationCursor",
            "oneChunkPerStep",
            "checkpointIdentity",
            "cancellationOwnedByRetainedJob",
            "freshnessValidatedBySharedPublisher",
            "configStoreOneItemPreparation",
            "artifactStoreOneItemPreparation",
            "documentGrantIsFixedPerTurn",
            "terminalEmptyRetirement",
            "scanThenMonolithRoutes"
          ],
          "properties": {
            "exactRoutePartition": {
              "const": true
            },
            "perOperationCursor": {
              "const": true
            },
            "oneChunkPerStep": {
              "const": true
            },
            "checkpointIdentity": {
              "const": true
            },
            "cancellationOwnedByRetainedJob": {
              "const": true
            },
            "freshnessValidatedBySharedPublisher": {
              "const": true
            },
            "configStoreOneItemPreparation": {
              "const": true
            },
            "artifactStoreOneItemPreparation": {
              "const": true
            },
            "documentGrantIsFixedPerTurn": {
              "const": true
            },
            "terminalEmptyRetirement": {
              "const": true
            },
            "scanThenMonolithRoutes": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
