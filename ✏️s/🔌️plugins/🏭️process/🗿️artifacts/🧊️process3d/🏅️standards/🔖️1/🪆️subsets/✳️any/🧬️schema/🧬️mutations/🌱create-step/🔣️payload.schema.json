{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "step"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "step": {
      "title": "ProcessStep",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "id",
        "label",
        "measure"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "origin": {
          "title": "StepOrigin",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capabilityId",
            "machineId"
          ],
          "properties": {
            "machineId": {
              "type": "string"
            },
            "capabilityId": {
              "type": "string"
            }
          }
        },
        "measure": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "measure": {
                  "const": "Cut"
                }
              },
              "required": [
                "measure"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "measure": {
                  "const": "Drill"
                }
              },
              "required": [
                "measure"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "measure": {
                  "const": "Attach"
                }
              },
              "required": [
                "measure"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  }
}
