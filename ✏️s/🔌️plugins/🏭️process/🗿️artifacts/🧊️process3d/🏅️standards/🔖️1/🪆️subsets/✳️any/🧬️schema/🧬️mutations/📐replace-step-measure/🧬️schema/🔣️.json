{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/process/process3d/mutation/replace-step-measure/schema.json",
  "title": "ReplaceStepMeasure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "newMeasure"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "newMeasure": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "measure": {
              "const": "Cut"
            }
          },
          "required": [
            "measure"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "measure": {
              "const": "Drill"
            }
          },
          "required": [
            "measure"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "measure": {
              "const": "Attach"
            }
          },
          "required": [
            "measure"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
