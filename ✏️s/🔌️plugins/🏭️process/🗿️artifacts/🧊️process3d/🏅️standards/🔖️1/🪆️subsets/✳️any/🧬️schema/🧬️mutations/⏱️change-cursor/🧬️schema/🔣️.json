{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/process/process3d/mutation/change-cursor/schema.json",
  "title": "ChangeCursor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation"
  ],
  "properties": {
    "mutation": {
      "const": "changeCursor"
    },
    "newResolvedUpTo": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Playback Cursor",
          "de": "Wiedergabe-Cursor"
        },
        "description": {
          "en": "Number of timeline steps applied to the stock; empty applies all.",
          "de": "Anzahl der auf das Rohteil angewendeten Zeitleistenschritte; leer wendet alle an."
        },
        "step": 1,
        "precision": 0
      }
    }
  }
}
