{
  "$id": "https://semio.tech/schema/s/process/process3d/snapshot.json",
  "title": "Process3dSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workshop",
    "stockId",
    "stockLabel",
    "stockPose",
    "stockPayload",
    "stockSolid",
    "steps",
    "stepPayloads",
    "toolSolids"
  ],
  "properties": {
    "workshop": {
      "$ref": "#/$defs/Process3dWorkshop",
      "x-semio-state": "artifact"
    },
    "stockId": { "type": "string", "x-semio-state": "artifact" },
    "stockLabel": { "type": "string", "x-semio-state": "artifact" },
    "stockPose": { "$ref": "#/$defs/Process3dPose", "x-semio-state": "artifact" },
    "stockPayload": {
      "$ref": "#/$defs/Process3dStock",
      "x-semio-state": "artifact"
    },
    "stockSolid": { "$ref": "#/$defs/ArtifactChildHandle", "x-semio-state": "artifact" },
    "steps": { "$ref": "#/$defs/ArtifactChildHandle", "x-semio-state": "artifact" },
    "stepPayloads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Process3dStep"
      },
      "x-semio-state": "artifact"
    },
    "toolSolids": {
      "type": "array",
      "items": { "$ref": "#/$defs/ArtifactChildHandle" },
      "x-semio-state": "artifact"
    },
    "resolvedUpTo": {
      "type": "integer",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "Process3dWorkshop": {
      "title": "Process3dWorkshop",
      "type": "object"
    },
    "Process3dStock": {
      "title": "Process3dStock",
      "type": "object"
    },
    "Process3dPose": { "title": "Process3dPose", "type": "object" },
    "ArtifactChildHandle": {
      "title": "ArtifactChildHandle",
      "type": "object",
      "required": ["childId", "target"],
      "properties": { "childId": { "type": "string" }, "target": { "type": "string" } }
    },
    "Process3dStep": {
      "title": "Process3dStep",
      "type": "object"
    }
  }
}
