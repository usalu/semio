{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/process/process3d/mutation/resize-stock/schema.json",
  "title": "ResizeStock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "field",
    "size"
  ],
  "properties": {
    "mutation": {
      "const": "resizeStock"
    },
    "field": {
      "enum": [
        "width",
        "depth",
        "height",
        "radius"
      ],
      "x-semio-ui": {
        "label": {
          "en": "Dimension",
          "de": "Abmessung"
        },
        "options": {
          "depth": {
            "en": "Depth",
            "de": "Tiefe"
          }
        }
      }
    },
    "size": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "label": {
          "en": "Size",
          "de": "Größe"
        }
      }
    }
  }
}
