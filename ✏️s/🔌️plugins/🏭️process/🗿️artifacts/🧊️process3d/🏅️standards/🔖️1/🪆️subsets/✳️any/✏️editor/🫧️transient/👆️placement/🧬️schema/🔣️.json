{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "utility": {
      "type": [
        "string",
        "null"
      ]
    },
    "position": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      ]
    },
    "machineId": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilityId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "machineId": [
      "capabilityId"
    ],
    "capabilityId": [
      "machineId"
    ]
  }
}
