{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/process/process3d/diff.json",
  "title": "Process3dDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "title": "Process3dArtifact",
      "type": "object",
      "x-semio-state": "artifact"
    },
    "workshop": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/process/process3d/artifact.json#/$defs/Process3dWorkshop",
      "x-semio-state": "artifact"
    },
    "stockId": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "stockLabel": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "stockPose": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/process/process3d/artifact.json#/$defs/Process3dPose",
      "x-semio-state": "artifact"
    },
    "stockPayload": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/process/process3d/artifact.json#/$defs/Process3dStock",
      "x-semio-state": "artifact"
    },
    "stockSolid": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/process/process3d/artifact.json#/$defs/ArtifactChildHandle",
      "x-semio-state": "artifact"
    },
    "steps": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/process/process3d/artifact.json#/$defs/ArtifactChildHandle",
      "x-semio-state": "artifact"
    },
    "stepPayloads": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/process/process3d/artifact.json#/$defs/Process3dStep"
      },
      "x-semio-state": "artifact"
    },
    "toolSolids": {
      "type": "array",
      "items": {
        "$ref": "https://json.schemas.assets.semio-tech.com/s/process/process3d/artifact.json#/$defs/ArtifactChildHandle"
      },
      "x-semio-state": "artifact"
    },
    "resolvedUpTo": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer"
        }
      ],
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "Process3dStepsDelta": {
      "title": "Process3dStepsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "patched"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patched": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Process3dStepPatchEntry"
          }
        },
        "reordered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Process3dStepPatchEntry": {
      "title": "Process3dStepPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "patch": {
          "type": "object"
        }
      }
    }
  }
}
