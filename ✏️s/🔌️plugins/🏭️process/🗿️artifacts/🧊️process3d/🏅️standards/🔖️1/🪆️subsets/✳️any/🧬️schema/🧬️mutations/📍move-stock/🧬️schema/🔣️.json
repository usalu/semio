{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/process/process3d/mutation/move-stock/schema.json",
  "title": "MoveStock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newPose"
  ],
  "properties": {
    "mutation": {
      "const": "moveStock"
    },
    "newPose": {
      "title": "Pose",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle",
        "axis",
        "position"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "axis": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Rotation Axis",
              "de": "Drehachse"
            },
            "description": {
              "en": "Direction the stock rotates about.",
              "de": "Richtung, um die sich das Rohteil dreht."
            }
          }
        },
        "angle": {
          "type": "number",
          "x-semio-ui": {
            "widget": "dial",
            "role": "value",
            "label": {
              "en": "Angle",
              "de": "Winkel"
            },
            "description": {
              "en": "Counter-clockwise rotation about the axis.",
              "de": "Drehung gegen den Uhrzeigersinn um die Achse."
            },
            "unit": "rad",
            "displayUnit": "deg",
            "displayFactor": 57.29577951308232,
            "step": 0.017453292519943295,
            "softMin": -3.141592653589793,
            "softMax": 3.141592653589793,
            "snaps": [
              -3.141592653589793,
              -1.5707963267948966,
              0,
              1.5707963267948966,
              3.141592653589793
            ]
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New Pose",
          "de": "Neue Lage"
        },
        "description": {
          "en": "Position and axis-angle rotation of the stock.",
          "de": "Position und Achse-Winkel-Drehung des Rohteils."
        }
      }
    }
  }
}
