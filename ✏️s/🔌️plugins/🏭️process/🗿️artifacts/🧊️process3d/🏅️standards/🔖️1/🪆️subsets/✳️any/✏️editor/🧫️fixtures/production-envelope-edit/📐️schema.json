{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "edit",
          "accepted"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "edit": {
            "type": "object"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
