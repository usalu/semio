{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/process/process3d/mutation/replace-stock-solid/schema.json",
  "title": "ReplaceStockSolid",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newSolid"
  ],
  "properties": {
    "mutation": {
      "const": "replaceStockSolid"
    },
    "newSolid": {
      "type": "object",
      "properties": {
        "childId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Child ID",
              "de": "Kind-ID"
            },
            "description": {
              "en": "Id of the child slot in this document.",
              "de": "ID des Kind-Slots in diesem Dokument."
            }
          }
        },
        "target": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/io/schema.json#/$defs/ArtifactRef",
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Target",
              "de": "Ziel"
            },
            "description": {
              "en": "Artifact the solid child points at.",
              "de": "Artefakt, auf das das Körper-Kind verweist."
            }
          }
        }
      },
      "required": [
        "childId",
        "target"
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "New Stock Solid",
          "de": "Neuer Rohteilkörper"
        },
        "description": {
          "en": "Child handle of the stock's solid body.",
          "de": "Kind-Verweis auf den Volumenkörper des Rohteils."
        }
      },
      "additionalProperties": false
    }
  }
}
