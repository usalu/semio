{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/process/process3d/mutation/change-machine-icon/schema.json",
  "title": "ChangeMachineIcon",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "newIconId"
  ],
  "properties": {
    "mutation": {
      "const": "changeMachineIcon"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Machine",
          "de": "Maschine"
        },
        "description": {
          "en": "The workshop machine to change.",
          "de": "Die zu ändernde Werkstattmaschine."
        },
        "ref": {
          "kind": "machine"
        }
      }
    },
    "newIconId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "text",
        "role": "value",
        "label": {
          "en": "New Icon",
          "de": "Neues Symbol"
        },
        "description": {
          "en": "Icon id shown for the machine.",
          "de": "Für die Maschine angezeigte Symbol-ID."
        }
      }
    }
  }
}
