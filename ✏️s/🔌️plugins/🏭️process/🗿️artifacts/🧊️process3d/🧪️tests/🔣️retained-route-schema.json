{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.process3d.retained-route-laws.schema.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "routeCount", "migratedCount", "batchOnlyCount", "limits", "groups", "oracleCases", "laws"],
  "properties": {
    "schema": { "const": "semio.process3d.retained-route-laws.v1" },
    "source": { "type": "string", "minLength": 1 },
    "routeCount": { "const": 33 },
    "migratedCount": { "type": "integer", "minimum": 0 },
    "batchOnlyCount": { "type": "integer", "minimum": 0 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawBytes", "workItems", "chunkBytes", "stepMicros", "storeBytes"],
      "properties": {
        "rawBytes": { "const": 8192 },
        "workItems": { "const": 64 },
        "chunkBytes": { "const": 256 },
        "stepMicros": { "const": 7500 },
        "storeBytes": { "const": 16384 }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "execution", "lanes", "routes"],
        "properties": {
          "status": { "enum": ["Migrated", "BatchOnlyPendingRewrite"] },
          "execution": { "enum": ["bounded", "resumable", "batch"] },
          "lanes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["Artifact", "Config", "Draft", "Presence", "Transient", "Child", "HostOnly"] }
          },
          "routes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "blocker": { "type": "string", "minLength": 1 }
        }
      }
    },
    "oracleCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bytes", "expectedExtent"],
        "properties": {
          "bytes": { "type": "integer", "minimum": 0 },
          "expectedExtent": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "laws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactRoutePartition", "perOperationCursor", "oneChunkPerStep", "checkpointIdentity", "cancellationOwnedByRetainedJob", "freshnessValidatedBySharedPublisher", "configStoreOneItemPreparation", "terminalEmptyRetirement", "scanThenMonolithRoutes"],
      "properties": {
        "exactRoutePartition": { "const": true },
        "perOperationCursor": { "const": true },
        "oneChunkPerStep": { "const": true },
        "checkpointIdentity": { "const": true },
        "cancellationOwnedByRetainedJob": { "const": true },
        "freshnessValidatedBySharedPublisher": { "const": true },
        "configStoreOneItemPreparation": { "const": true },
        "terminalEmptyRetirement": { "const": true },
        "scanThenMonolithRoutes": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
