{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/reasoning/wires/mutation/resize-node/schema.json",
  "title": "ResizeNode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "nodeId"
  ],
  "properties": {
    "mutation": {
      "const": "resizeNode"
    },
    "nodeId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Node",
          "de": "Knoten"
        },
        "description": {
          "en": "The node this mutation addresses.",
          "de": "Der Knoten, den diese Mutation adressiert."
        },
        "ref": {
          "kind": "node",
          "domain": "graph",
          "granularity": "node"
        }
      }
    },
    "newRadius": {
      "type": "number"
    },
    "newWidth": {
      "type": "number"
    },
    "newHeight": {
      "type": "number"
    }
  }
}
