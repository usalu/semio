{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/reasoning/wires/canvas-window/config/mutation/set-camera/schema.json",
  "title": "SetCamera",
  "type": "object",
  "additionalProperties": false,
  "required": ["camera"],
  "properties": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
