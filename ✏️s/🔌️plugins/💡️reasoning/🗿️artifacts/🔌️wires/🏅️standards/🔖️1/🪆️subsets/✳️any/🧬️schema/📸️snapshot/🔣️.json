{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/reasoning/wires/snapshot.json",
  "title": "WiresSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wiresFixture",
    "content",
    "camera",
    "meta"
  ],
  "properties": {
    "wiresFixture": {
      "$ref": "https://semio.tech/schema/framework/value/schema.json",
      "x-semio-state": "artifact"
    },
    "content": {
      "$ref": "https://semio.tech/schema/os/store/child.json",
      "x-semio-state": "artifact"
    },
    "camera": {
      "$ref": "https://semio.tech/schema/framework/value/schema.json",
      "x-semio-state": "artifact"
    },
    "meta": {
      "$ref": "https://semio.tech/schema/framework/value/schema.json",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "WiresStringList": {
      "title": "WiresStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
