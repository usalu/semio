{
  "$id": "https://semio.tech/schema/s/reasoning/wires/inference.json",
  "title": "WiresInference",
  "type": "object",
  "additionalProperties": false,
  "required": ["topology"],
  "properties": {
    "topology": { "$ref": "#/$defs/WiresTopology", "x-semio-state": "inferred" }
  },
  "$defs": {
    "WiresTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeCount", "edgeCount", "componentCount", "cycleFree"],
      "properties": {
        "nodeCount": { "type": "integer", "minimum": 0 },
        "edgeCount": { "type": "integer", "minimum": 0 },
        "componentCount": { "type": "integer", "minimum": 0 },
        "cycleFree": { "type": "boolean" }
      }
    }
  }
}
