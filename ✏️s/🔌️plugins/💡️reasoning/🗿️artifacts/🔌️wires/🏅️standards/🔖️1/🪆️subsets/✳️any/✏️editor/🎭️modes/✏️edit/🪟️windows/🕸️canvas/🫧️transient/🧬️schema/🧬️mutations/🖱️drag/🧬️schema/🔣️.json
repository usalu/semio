{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/reasoning/wires/canvas-window-transient/mutation/set-drag/schema.json",
  "title": "SetDrag",
  "type": "object",
  "properties": {
    "nodeId": {
      "type": [
        "string",
        "null"
      ],
      "x-semio-ui": {
        "widget": "reference",
        "role": "value",
        "label": {
          "en": "Dragged Node",
          "de": "Gezogener Knoten"
        },
        "description": {
          "en": "The node being dragged; empty while panning.",
          "de": "Der gezogene Knoten; leer beim Verschieben der Ansicht."
        },
        "ref": {
          "kind": "node",
          "domain": "graph",
          "granularity": "node"
        }
      }
    },
    "startX": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Drag Start X",
          "de": "Ziehbeginn X"
        },
        "description": {
          "en": "Pointer x where the drag began.",
          "de": "Zeiger-x-Position zu Beginn des Ziehens."
        },
        "step": 1,
        "precision": 2
      }
    },
    "startY": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Drag Start Y",
          "de": "Ziehbeginn Y"
        },
        "description": {
          "en": "Pointer y where the drag began.",
          "de": "Zeiger-y-Position zu Beginn des Ziehens."
        },
        "step": 1,
        "precision": 2
      }
    },
    "lastX": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Last Pointer X",
          "de": "Letzte Zeigerposition X"
        },
        "description": {
          "en": "Pointer x at the latest drag event.",
          "de": "Zeiger-x-Position beim letzten Ziehereignis."
        },
        "step": 1,
        "precision": 2
      }
    },
    "lastY": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Last Pointer Y",
          "de": "Letzte Zeigerposition Y"
        },
        "description": {
          "en": "Pointer y at the latest drag event.",
          "de": "Zeiger-y-Position beim letzten Ziehereignis."
        },
        "step": 1,
        "precision": 2
      }
    },
    "zoom": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-ui": {
        "widget": "slider",
        "role": "value",
        "label": {
          "en": "Zoom",
          "de": "Zoom"
        },
        "description": {
          "en": "Zoom factor of the view while the drag runs; pointer offsets are divided by it.",
          "de": "Zoomfaktor der Ansicht während des Ziehens; Zeigerversätze werden durch ihn geteilt."
        },
        "step": 0.05,
        "precision": 2,
        "softMin": 0.1,
        "softMax": 8,
        "scale": "log",
        "snaps": [
          0.25,
          0.5,
          1,
          2,
          4
        ]
      }
    }
  },
  "required": [
    "nodeId",
    "startX",
    "startY",
    "lastX",
    "lastY",
    "zoom"
  ],
  "additionalProperties": false
}
