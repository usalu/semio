{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/reasoning/wires/canvas-window-transient/schema.json",
  "title": "WiresCanvasTransient",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dragStartX",
    "dragStartY",
    "dragLastX",
    "dragLastY",
    "dragZoom"
  ],
  "properties": {
    "dragNodeId": {
      "type": "string",
      "x-semio-state": "transient"
    },
    "dragStartX": {
      "type": "number",
      "x-semio-state": "transient"
    },
    "dragStartY": {
      "type": "number",
      "x-semio-state": "transient"
    },
    "dragLastX": {
      "type": "number",
      "x-semio-state": "transient"
    },
    "dragLastY": {
      "type": "number",
      "x-semio-state": "transient"
    },
    "dragZoom": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-semio-state": "transient"
    }
  }
}
