{
  "name": "@semio-tech/reasoning-wires-rs",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:rust",
    "role:artifact",
    "family:reasoning"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/💡️reasoning/🗿️artifacts/🔌️wires/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "graph-generate"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/💡️reasoning/🗿️artifacts/🔌️wires/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "graph-generate"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔌️plugins/💡️reasoning/🗿️artifacts/🔌️wires/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "dependsOn": [
        "graph-generate"
      ]
    },
    "verify-wires-document-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/💡️reasoning/🗿️artifacts/🔌️wires/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts verify wires-document-contract",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "wires-document-contract"
          ]
        }
      }
    },
    "verify-wires-window-transient": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/💡️reasoning/🗿️artifacts/🔌️wires/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts verify wires-window-transient",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "wires-window-transient"
          ]
        }
      }
    },
    "graph-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "✏️s/🔌️plugins/💡️reasoning/🗿️artifacts/🔌️wires/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts graph-generate"
      },
      "inputs": [
        "{workspaceRoot}/✏️s/🔌️plugins/💡️reasoning/🗿️artifacts/🔌️wires/**/*manifest.json",
        "{workspaceRoot}/🧰️framework/🔨️modules/🕸️graph/🛂️manifest/**/*",
        "{projectRoot}/../../🛂️manifest/📇️outputs.json",
        "{projectRoot}/📜️script.ts",
        "{projectRoot}/📋️project.json",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔍️discovery/🟦️.ts",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔣️taxonomy.json"
      ],
      "outputs": [
        "{projectRoot}/../../🤖️generated"
      ],
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "generate",
            "reasoning-wires-graph"
          ]
        }
      }
    },
    "graph-wire-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "graph-generate"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/💡️reasoning/🗿️artifacts/🔌️wires/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts graph-wire-check"
      },
      "outputs": [],
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "check",
            "reasoning-wires-graph-wire"
          ]
        }
      }
    }
  }
}
