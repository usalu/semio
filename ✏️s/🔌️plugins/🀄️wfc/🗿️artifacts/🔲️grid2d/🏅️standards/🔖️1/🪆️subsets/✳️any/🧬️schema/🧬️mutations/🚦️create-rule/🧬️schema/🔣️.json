{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/grid2d/1/any/mutation/create-rule/schema.json",
  "title": "CreateRule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule"
  ],
  "properties": {
    "rule": {
      "title": "WfcAdjacencyRule2d",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tileAId",
        "tileBId",
        "direction",
        "allowed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "tileAId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Tile A",
              "de": "Kachel A"
            },
            "ref": {
              "kind": "tile"
            },
            "group": "target",
            "order": 20
          }
        },
        "tileBId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Tile B",
              "de": "Kachel B"
            },
            "ref": {
              "kind": "tile"
            },
            "group": "target",
            "order": 30
          }
        },
        "direction": {
          "enum": [
            "LEFT",
            "RIGHT",
            "TOP",
            "BOTTOM"
          ],
          "x-semio-ui": {
            "widget": "select",
            "role": "value",
            "label": {
              "en": "Direction",
              "de": "Richtung"
            },
            "options": {
              "LEFT": {
                "en": "Left",
                "de": "Links"
              },
              "RIGHT": {
                "en": "Right",
                "de": "Rechts"
              },
              "TOP": {
                "en": "Top",
                "de": "Oben"
              },
              "BOTTOM": {
                "en": "Bottom",
                "de": "Unten"
              }
            },
            "group": "rule",
            "order": 40
          }
        },
        "allowed": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Allowed",
              "de": "Erlaubt"
            },
            "description": {
              "en": "Whether the pair may be neighbours; off forbids it.",
              "de": "Ob das Paar benachbart sein darf; aus verbietet es."
            },
            "group": "rule",
            "order": 50
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Adjacency rule",
          "de": "Nachbarschaftsregel"
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
