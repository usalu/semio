{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/grid2d/1/any/mutation/mask-cell/schema.json",
  "title": "MaskCell",
  "x-semio-inverse-rows": { "bounded": 2 },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "x",
    "y"
  ],
  "properties": {
    "x": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Column",
          "de": "Spalte"
        },
        "step": 1,
        "precision": 0,
        "group": "cell",
        "order": 10
      }
    },
    "y": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Row",
          "de": "Zeile"
        },
        "step": 1,
        "precision": 0,
        "group": "cell",
        "order": 20
      }
    }
  }
}
