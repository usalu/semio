{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/grid2d/1/any/mutation/change-periodicity/schema.json",
  "title": "ChangePeriodicity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "periodicX",
    "periodicY"
  ],
  "properties": {
    "periodicX": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Periodic in X",
          "de": "Periodisch in X"
        },
        "description": {
          "en": "Neighbourhoods wrap around the grid edge in X.",
          "de": "Nachbarschaften laufen in X über den Rasterrand um."
        },
        "group": "grid",
        "order": 10
      }
    },
    "periodicY": {
      "type": "boolean",
      "x-semio-ui": {
        "widget": "toggle",
        "role": "value",
        "label": {
          "en": "Periodic in Y",
          "de": "Periodisch in Y"
        },
        "description": {
          "en": "Neighbourhoods wrap around the grid edge in Y.",
          "de": "Nachbarschaften laufen in Y über den Rasterrand um."
        },
        "group": "grid",
        "order": 20
      }
    }
  }
}
