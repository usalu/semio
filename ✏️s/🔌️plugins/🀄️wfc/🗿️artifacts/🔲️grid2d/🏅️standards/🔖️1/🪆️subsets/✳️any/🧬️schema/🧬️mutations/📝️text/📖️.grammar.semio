dialect grammar
grammar wfc.grid2d.op
extension wfcgrid2dop
start operation

operation = keyword (SP arguments)?
keyword = "change-seed" / "resize-grid" / "change-cell-size" / "change-periodicity" / "create-tile" / "delete-tile" / "change-tile-weight" / "change-tile-media" / "create-rule" / "delete-rule" / "pin-cell" / "unpin-cell" / "mask-cell" / "unmask-cell"
arguments = OCTET+
