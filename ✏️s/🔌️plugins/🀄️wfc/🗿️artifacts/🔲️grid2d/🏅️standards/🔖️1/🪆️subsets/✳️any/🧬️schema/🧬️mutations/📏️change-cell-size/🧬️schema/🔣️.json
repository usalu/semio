{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/grid2d/1/any/mutation/change-cell-size/schema.json",
  "title": "ChangeCellSize",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cellWidth",
    "cellHeight"
  ],
  "properties": {
    "cellWidth": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Cell width",
          "de": "Zellbreite"
        },
        "step": 1,
        "precision": 2,
        "group": "grid",
        "order": 10
      }
    },
    "cellHeight": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Cell height",
          "de": "Zellhöhe"
        },
        "step": 1,
        "precision": 2,
        "group": "grid",
        "order": 20
      }
    }
  }
}
