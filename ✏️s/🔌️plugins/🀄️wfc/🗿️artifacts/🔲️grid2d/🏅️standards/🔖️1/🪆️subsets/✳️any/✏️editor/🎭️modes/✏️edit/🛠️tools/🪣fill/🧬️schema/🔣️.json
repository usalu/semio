{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s.wfc.grid2d.fill.tick.v1",
  "title": "Grid2d fill tick payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignments", "contradiction", "done"],
  "properties": {
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "tileId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contradiction": { "type": "boolean" },
    "done": { "type": "boolean" },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "tileId", "discarded"],
        "properties": {
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "tileId": { "type": "string", "minLength": 1 },
          "discarded": { "type": "boolean" }
        }
      }
    }
  }
}
