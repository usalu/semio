{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/grid3d/1/any/snapshot/schema.json",
  "title": "Grid3dSnapshot",
  "description": "The persisted WFC problem for a non-uniform box grid. The SOLVE is an inference over this document and is never stored here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seed",
    "width",
    "height",
    "depth",
    "cellSizesX",
    "cellSizesY",
    "cellSizesZ",
    "periodicX",
    "periodicY",
    "periodicZ",
    "tiles",
    "rules",
    "pinned",
    "masked"
  ],
  "properties": {
    "schema": {
      "const": "s.wfc.grid3d"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "depth": {
      "type": "integer",
      "minimum": 1
    },
    "cellSizesX": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "cellSizesY": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "cellSizesZ": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "periodicX": {
      "type": "boolean"
    },
    "periodicY": {
      "type": "boolean"
    },
    "periodicZ": {
      "type": "boolean"
    },
    "tiles": {
      "type": "array",
      "items": {
        "title": "Grid3dTile",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "weight",
          "media"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "media": {
            "$ref": "#/$defs/Grid3dTileMedia"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "title": "Grid3dRule",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tileAId",
          "tileBId",
          "direction",
          "allowed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tileAId": {
            "type": "string"
          },
          "tileBId": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "LEFT",
              "RIGHT",
              "FRONT",
              "BACK",
              "BOTTOM",
              "TOP"
            ]
          },
          "allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "pinned": {
      "type": "array",
      "items": {
        "title": "Grid3dPinnedCell",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "z",
          "tileId"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "z": {
            "type": "integer",
            "minimum": 0
          },
          "tileId": {
            "type": "string"
          }
        }
      }
    },
    "masked": {
      "type": "array",
      "items": {
        "title": "Grid3dCell",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "z"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "z": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "Grid3dTileMedia": {
      "title": "Grid3dTileMedia",
      "description": "Tagged by `kind`: inline `mesh` geometry, or a `meshChild` handle into s.stdio.semio@v1/mesh.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "mesh"
          ],
          "properties": {
            "kind": {
              "const": "mesh",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Media Kind",
                  "de": "Medienart"
                }
              }
            },
            "mesh": {
              "title": "Grid3dMesh",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "positions",
                "indices"
              ],
              "properties": {
                "positions": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "xyz triples in the tile-space unit box 0..1",
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Positions",
                      "de": "Positionen"
                    },
                    "description": {
                      "en": "xyz triples in the tile-space unit box 0..1.",
                      "de": "xyz-Tripel in der Einheitsbox 0..1 des Kachelraums."
                    }
                  }
                },
                "indices": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "x-semio-ui": {
                    "widget": "hidden",
                    "role": "value",
                    "label": {
                      "en": "Triangle Indices",
                      "de": "Dreiecksindizes"
                    },
                    "description": {
                      "en": "Vertex indices, three per triangle.",
                      "de": "Eckpunktindizes, drei je Dreieck."
                    }
                  }
                },
                "color": {
                  "title": "Grid3dColor",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "r",
                    "g",
                    "b",
                    "a"
                  ],
                  "properties": {
                    "r": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255,
                      "x-semio-ui": {
                        "widget": "slider",
                        "role": "value",
                        "label": {
                          "en": "Red",
                          "de": "Rot"
                        },
                        "step": 1,
                        "precision": 0
                      }
                    },
                    "g": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255,
                      "x-semio-ui": {
                        "widget": "slider",
                        "role": "value",
                        "label": {
                          "en": "Green",
                          "de": "Grün"
                        },
                        "step": 1,
                        "precision": 0
                      }
                    },
                    "b": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255,
                      "x-semio-ui": {
                        "widget": "slider",
                        "role": "value",
                        "label": {
                          "en": "Blue",
                          "de": "Blau"
                        },
                        "step": 1,
                        "precision": 0
                      }
                    },
                    "a": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255,
                      "x-semio-ui": {
                        "widget": "slider",
                        "role": "value",
                        "label": {
                          "en": "Alpha",
                          "de": "Deckkraft"
                        },
                        "step": 1,
                        "precision": 0
                      }
                    }
                  },
                  "x-semio-ui": {
                    "role": "value",
                    "label": {
                      "en": "Color",
                      "de": "Farbe"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "child"
          ],
          "properties": {
            "kind": {
              "const": "meshChild",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Media Kind",
                  "de": "Medienart"
                }
              }
            },
            "child": {
              "$ref": "https://json.schemas.assets.semio-tech.com/os/store/child/schema.json",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "value",
                "label": {
                  "en": "Mesh Child",
                  "de": "Netz-Kindartefakt"
                },
                "description": {
                  "en": "Handle of the s.stdio.semio mesh child the tile renders.",
                  "de": "Verweis auf das s.stdio.semio-Netz, das die Kachel darstellt."
                }
              }
            }
          }
        }
      ]
    }
  }
}
