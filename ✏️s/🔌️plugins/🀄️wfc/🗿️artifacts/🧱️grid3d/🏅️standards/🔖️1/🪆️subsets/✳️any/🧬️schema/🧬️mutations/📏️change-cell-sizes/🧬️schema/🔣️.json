{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/grid3d/1/any/mutation/change-cell-sizes/schema.json",
  "title": "ChangeCellSizes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "axis",
    "sizes"
  ],
  "properties": {
    "axis": {
      "type": "string",
      "enum": [
        "x",
        "y",
        "z"
      ],
      "x-semio-ui": {
        "widget": "segmented",
        "role": "value",
        "label": {
          "en": "Axis",
          "de": "Achse"
        },
        "options": {
          "x": {
            "en": "X axis",
            "de": "x-Achse"
          },
          "y": {
            "en": "Y axis",
            "de": "y-Achse"
          },
          "z": {
            "en": "Z axis",
            "de": "z-Achse"
          }
        },
        "group": "grid",
        "order": 10
      }
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Cell sizes",
          "de": "Zellgrößen"
        },
        "description": {
          "en": "Size of every cell along the axis, in order.",
          "de": "Größe jeder Zelle entlang der Achse, der Reihe nach."
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
