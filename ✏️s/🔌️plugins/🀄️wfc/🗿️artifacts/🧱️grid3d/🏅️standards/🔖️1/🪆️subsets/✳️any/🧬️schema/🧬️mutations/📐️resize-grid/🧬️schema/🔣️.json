{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/grid3d/1/any/mutation/resize-grid/schema.json",
  "title": "ResizeGrid",
  "x-semio-inverse-rows": { "fixed": 4 },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "height",
    "depth"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Width in cells",
          "de": "Breite in Zellen"
        },
        "step": 1,
        "precision": 0,
        "group": "grid",
        "order": 10
      }
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Height in cells",
          "de": "Höhe in Zellen"
        },
        "step": 1,
        "precision": 0,
        "group": "grid",
        "order": 20
      }
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Depth in cells",
          "de": "Tiefe in Zellen"
        },
        "step": 1,
        "precision": 0,
        "group": "grid",
        "order": 30
      }
    }
  }
}
