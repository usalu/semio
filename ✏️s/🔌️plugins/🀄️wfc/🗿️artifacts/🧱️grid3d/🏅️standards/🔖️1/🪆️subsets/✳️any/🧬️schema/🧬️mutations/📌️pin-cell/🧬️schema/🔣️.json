{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/grid3d/1/any/mutation/pin-cell/schema.json",
  "title": "PinCell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pinned"
  ],
  "properties": {
    "pinned": {
      "title": "Grid3dPinnedCell",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "tileId"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Column",
              "de": "Spalte"
            },
            "step": 1,
            "precision": 0,
            "group": "cell",
            "order": 10
          }
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Row",
              "de": "Zeile"
            },
            "step": 1,
            "precision": 0,
            "group": "cell",
            "order": 20
          }
        },
        "z": {
          "type": "integer",
          "minimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Layer",
              "de": "Lage"
            },
            "step": 1,
            "precision": 0,
            "group": "cell",
            "order": 30
          }
        },
        "tileId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Tile",
              "de": "Kachel"
            },
            "ref": {
              "kind": "tile"
            },
            "group": "target",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Pinned cell",
          "de": "Fixierte Zelle"
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
