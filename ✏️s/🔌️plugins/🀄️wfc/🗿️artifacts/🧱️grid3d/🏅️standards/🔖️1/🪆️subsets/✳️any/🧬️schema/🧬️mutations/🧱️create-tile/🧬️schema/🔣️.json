{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/grid3d/1/any/mutation/create-tile/schema.json",
  "title": "CreateTile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tile"
  ],
  "properties": {
    "tile": {
      "title": "Grid3dTile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "media"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "label": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Label",
              "de": "Bezeichnung"
            },
            "group": "value",
            "order": 20
          }
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Weight",
              "de": "Gewicht"
            },
            "description": {
              "en": "Relative frequency of the tile in a solution.",
              "de": "Relative Häufigkeit der Kachel in einer Lösung."
            },
            "step": 0.1,
            "precision": 2,
            "group": "solver",
            "order": 30
          }
        },
        "media": {
          "$ref": "https://json.schemas.assets.semio-tech.com/s/wfc/grid3d/1/any/snapshot/schema.json#/$defs/Grid3dTileMedia",
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Tile media",
              "de": "Kachelmedien"
            },
            "group": "record",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Tile",
          "de": "Kachel"
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
