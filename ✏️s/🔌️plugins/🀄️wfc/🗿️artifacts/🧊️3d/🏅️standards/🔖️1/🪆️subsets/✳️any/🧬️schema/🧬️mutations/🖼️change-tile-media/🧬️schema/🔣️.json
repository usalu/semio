{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/wfc3d/1/any/mutation/change-tile-media/schema.json",
  "title": "ChangeTileMedia",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "media"
  ],
  "properties": {
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Tile",
          "de": "Kachel"
        },
        "ref": {
          "kind": "tile"
        },
        "group": "target",
        "order": 10
      }
    },
    "media": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "mesh",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Media kind",
                  "de": "Medienart"
                }
              }
            },
            "positions": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Vertex positions",
                  "de": "Eckpunktkoordinaten"
                },
                "description": {
                  "en": "Flat x, y, z list of the mesh vertices.",
                  "de": "Flache x-, y-, z-Liste der Netzeckpunkte."
                },
                "group": "record",
                "order": 20
              }
            },
            "indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Triangle indices",
                  "de": "Dreiecksindizes"
                },
                "description": {
                  "en": "Three vertex indices per triangle.",
                  "de": "Drei Eckpunktindizes je Dreieck."
                },
                "group": "record",
                "order": 30
              }
            },
            "color": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "a",
                "b",
                "g",
                "r"
              ],
              "properties": {
                "r": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "x-semio-ui": {
                    "widget": "slider",
                    "role": "value",
                    "label": {
                      "en": "Red",
                      "de": "Rot"
                    },
                    "step": 1,
                    "precision": 0,
                    "group": "color",
                    "order": 10
                  }
                },
                "g": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "x-semio-ui": {
                    "widget": "slider",
                    "role": "value",
                    "label": {
                      "en": "Green",
                      "de": "Grün"
                    },
                    "step": 1,
                    "precision": 0,
                    "group": "color",
                    "order": 20
                  }
                },
                "b": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "x-semio-ui": {
                    "widget": "slider",
                    "role": "value",
                    "label": {
                      "en": "Blue",
                      "de": "Blau"
                    },
                    "step": 1,
                    "precision": 0,
                    "group": "color",
                    "order": 30
                  }
                },
                "a": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "x-semio-ui": {
                    "widget": "slider",
                    "role": "value",
                    "label": {
                      "en": "Alpha",
                      "de": "Alpha"
                    },
                    "step": 1,
                    "precision": 0,
                    "group": "color",
                    "order": 40
                  }
                }
              },
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Color",
                  "de": "Farbe"
                },
                "group": "record",
                "order": 40
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Mesh",
              "de": "Netz"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "child",
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "meshChild",
              "x-semio-ui": {
                "widget": "hidden",
                "role": "discriminator",
                "label": {
                  "en": "Media kind",
                  "de": "Medienart"
                }
              }
            },
            "child": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "childId",
                "target"
              ],
              "properties": {
                "childId": {
                  "type": "string",
                  "x-semio-ui": {
                    "widget": "text",
                    "role": "value",
                    "label": {
                      "en": "Child ID",
                      "de": "Kind-ID"
                    },
                    "group": "identity",
                    "order": 10
                  }
                },
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifactId",
                    "dialect"
                  ],
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "x-semio-ui": {
                        "widget": "text",
                        "role": "value",
                        "label": {
                          "en": "Artifact ID",
                          "de": "Artefakt-ID"
                        },
                        "group": "identity",
                        "order": 10
                      }
                    },
                    "dialect": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "artifactKind",
                        "standard",
                        "subset"
                      ],
                      "properties": {
                        "artifactKind": {
                          "type": "string",
                          "x-semio-ui": {
                            "widget": "text",
                            "role": "value",
                            "label": {
                              "en": "Artifact kind",
                              "de": "Artefaktart"
                            },
                            "group": "kind",
                            "order": 10
                          }
                        },
                        "standard": {
                          "type": "string",
                          "x-semio-ui": {
                            "widget": "text",
                            "role": "value",
                            "label": {
                              "en": "Standard",
                              "de": "Standard"
                            },
                            "group": "kind",
                            "order": 20
                          }
                        },
                        "subset": {
                          "type": "string",
                          "x-semio-ui": {
                            "widget": "text",
                            "role": "value",
                            "label": {
                              "en": "Subset",
                              "de": "Teilmenge"
                            },
                            "group": "kind",
                            "order": 30
                          }
                        }
                      },
                      "x-semio-ui": {
                        "role": "value",
                        "label": {
                          "en": "Dialect",
                          "de": "Dialekt"
                        },
                        "group": "record",
                        "order": 20
                      }
                    }
                  },
                  "x-semio-ui": {
                    "role": "value",
                    "label": {
                      "en": "Target artifact",
                      "de": "Zielartefakt"
                    },
                    "group": "record",
                    "order": 20
                  }
                }
              },
              "x-semio-ui": {
                "role": "value",
                "label": {
                  "en": "Child artifact",
                  "de": "Kindartefakt"
                },
                "group": "record",
                "order": 20
              }
            }
          },
          "x-semio-ui": {
            "label": {
              "en": "Child mesh",
              "de": "Kindnetz"
            }
          }
        }
      ],
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Tile media",
          "de": "Kachelmedien"
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
