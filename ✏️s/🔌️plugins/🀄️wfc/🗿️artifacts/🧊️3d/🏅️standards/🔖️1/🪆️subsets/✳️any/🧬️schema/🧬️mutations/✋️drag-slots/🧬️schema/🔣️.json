{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/wfc3d/1/any/mutation/drag-slots/schema.json",
  "title": "DragSlots",
  "description": "A set of slots moved by one relative offset in document units, read off each slot's base position. Slots the document lacks are skipped (`mutation.partial`); none present is `mutation.target-missing`; a zero offset is `mutation.no-op`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets",
    "dx",
    "dy",
    "dz"
  ],
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Slots",
          "de": "Slots"
        },
        "description": {
          "en": "Slots to drag; ones the document lacks are skipped.",
          "de": "Zu ziehende Slots; im Dokument fehlende werden übersprungen."
        },
        "ref": {
          "kind": "slot",
          "domain": "slot",
          "granularity": "slot"
        },
        "group": "target",
        "order": 10
      }
    },
    "dx": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Offset X",
          "de": "Versatz X"
        },
        "description": {
          "en": "Offset every slot moves by along x.",
          "de": "Versatz, um den jeder Slot entlang x verschoben wird."
        },
        "step": 1,
        "precision": 2,
        "group": "offset",
        "order": 20
      }
    },
    "dy": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Offset Y",
          "de": "Versatz Y"
        },
        "description": {
          "en": "Offset every slot moves by along y.",
          "de": "Versatz, um den jeder Slot entlang y verschoben wird."
        },
        "step": 1,
        "precision": 2,
        "group": "offset",
        "order": 30
      }
    },
    "dz": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Offset Z",
          "de": "Versatz Z"
        },
        "description": {
          "en": "Offset every slot moves by along z.",
          "de": "Versatz, um den jeder Slot entlang z verschoben wird."
        },
        "step": 1,
        "precision": 2,
        "group": "offset",
        "order": 40
      }
    }
  }
}
