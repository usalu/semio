  "$schema": "../../../../../../../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/🧪️test/🧬️schema/🔣️.json",
  "schemaVersion": 2,
  "_comment": "🔮️ wfc3d's second-implementation oracle. The SOLVE is an inference and is NOT under oracle here: it is pinned by the artifact's own deterministic-seed and contradiction tests plus the committed example outcomes. What this oracle covers is the EDITING ALGEBRA — the fifteen mutations, their guards, their cascades and their sparse deltas.",
  "oracles": [
    {
      "id": "wfc3d-python-independent",
      "ecosystem": "python",
      "package": "",
      "version": "",
      "capabilities": [
        "wfc3d-1-mutate"
      ],
      "comparisonProfiles": [
        "ordered-json-v1"
      ],
      "license": "AGPL-3.0-only",
      "testOnly": true,
      "rationale": "A second implementation of the `s.wfc.wfc3d` document and all fifteen typed mutations, in Python, at `../../../../../🧪️tests/🧩️mutate-wfc3d-1/🐍️.py`. It is a real second implementation, not a replay: it decodes each committed `⬅️before` snapshot, applies the committed mutation with its OWN guard order and its OWN cascade rules (delete-slot drops incident edges; delete-tile drops every rule naming the tile and releases every pin on it), builds its own sparse delta, and compares that delta and the resulting document against the committed `🔺️diff` and `➡️after`. Nothing in it links the Rust crate, so a bug that lives in the Rust diff builder cannot also live here. No third-party survey candidate exists: a WFC library computes a COLLAPSE, and none of them carries the problem statement as a document, let alone reads this carrier — the mutation vocabulary under test is this artifact's own editing algebra, not wave function collapse.",
      "kind": "verified-native-second-implementation",
      "engine": {
        "family": "none",
        "implementation": "in-repository second implementation",
        "version": "0"
      },
      "productionReachable": false,
      "networkDuringExecution": false,
      "nativeSecondImplementation": {
        "format": "s.wfc.wfc3d",
        "noThirdPartySurvey": {
          "ecosystemsSearched": [
            "python/pypi"
          ],
          "candidatesConsidered": [
            {
              "package": "wfc",
              "reason": "a WFC library computes a COLLAPSE over a grid or graph; it models no document and reads no carrier, so it cannot answer what `delete-tile` does to a rule set."
            },
            {
              "package": "jsonpatch",
              "reason": "a generic JSON patch library has no notion of this vocabulary's guards, cascades or canonical insertion indices — it would restate the fixture, not verify it."
            }
          ]
        },
        "subjectImplementationLanguage": "rust",
        "secondImplementationLanguage": "python",
        "specificationSource": "../🧬️schema/📸️snapshot/🔣️.json; ../🧬️schema/🧬️mutations/🔣️.json; each ../🧬️schema/🧬️mutations/*/🧬️schema/🔣️.json",
        "fixtureCoverage": {
          "vectors": 15,
          "capabilitiesCovered": [
            "wfc3d-1-mutate"
          ]
        }
      }
    }
  ],
