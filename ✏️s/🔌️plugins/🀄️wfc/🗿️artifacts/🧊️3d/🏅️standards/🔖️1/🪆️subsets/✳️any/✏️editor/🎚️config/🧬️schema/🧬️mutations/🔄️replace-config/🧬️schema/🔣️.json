{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/wfc3d/1/any/config/mutation/replace-config/schema.json",
  "title": "ReplaceConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config"
  ],
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeTileId",
        "cameraX",
        "cameraY",
        "cameraZoom"
      ],
      "properties": {
        "cameraX": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Camera X",
              "de": "Kamera X"
            },
            "step": 1,
            "precision": 2,
            "group": "camera",
            "order": 10
          }
        },
        "cameraY": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Camera Y",
              "de": "Kamera Y"
            },
            "step": 1,
            "precision": 2,
            "group": "camera",
            "order": 20
          }
        },
        "cameraZoom": {
          "type": "number",
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "Camera zoom",
              "de": "Kamerazoom"
            },
            "step": 0.01,
            "precision": 2,
            "softMin": 0.1,
            "softMax": 10,
            "scale": "log",
            "snaps": [
              0.25,
              0.5,
              1,
              2,
              4
            ],
            "group": "camera",
            "order": 30
          }
        },
        "activeTileId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Active tile",
              "de": "Aktive Kachel"
            },
            "ref": {
              "kind": "tile"
            },
            "group": "target",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Configuration",
          "de": "Konfiguration"
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
