{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/wfc3d/1/any/mutation/create-rule/schema.json",
  "title": "CreateRule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "rule"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Index",
          "de": "Index"
        },
        "description": {
          "en": "Position in the list; empty appends at the end.",
          "de": "Position in der Liste; leer hängt am Ende an."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "rule": {
      "title": "GraphRule",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "id",
        "tileAId",
        "tileBId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "tileAId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Tile A",
              "de": "Kachel A"
            },
            "ref": {
              "kind": "tile"
            },
            "group": "target",
            "order": 20
          }
        },
        "tileBId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Tile B",
              "de": "Kachel B"
            },
            "ref": {
              "kind": "tile"
            },
            "group": "target",
            "order": 30
          }
        },
        "relation": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Relation",
              "de": "Relation"
            },
            "description": {
              "en": "Adjacency class, e.g. adjacent, above or beside.",
              "de": "Nachbarschaftsklasse, z. B. adjacent, above oder beside."
            },
            "group": "rule",
            "order": 40
          }
        },
        "allowed": {
          "type": "boolean",
          "x-semio-ui": {
            "widget": "toggle",
            "role": "value",
            "label": {
              "en": "Allowed",
              "de": "Erlaubt"
            },
            "description": {
              "en": "Whether the pair may be neighbours; off forbids it.",
              "de": "Ob das Paar benachbart sein darf; aus verbietet es."
            },
            "group": "rule",
            "order": 50
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Adjacency rule",
          "de": "Nachbarschaftsregel"
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
