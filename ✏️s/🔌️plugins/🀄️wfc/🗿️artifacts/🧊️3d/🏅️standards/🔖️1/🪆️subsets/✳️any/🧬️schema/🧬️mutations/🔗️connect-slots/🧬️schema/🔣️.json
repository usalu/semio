{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/wfc3d/1/any/mutation/connect-slots/schema.json",
  "title": "ConnectSlots",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edge",
    "index"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Index",
          "de": "Index"
        },
        "description": {
          "en": "Position in the list; empty appends at the end.",
          "de": "Position in der Liste; leer hängt am Ende an."
        },
        "step": 1,
        "precision": 0,
        "group": "order",
        "order": 10
      }
    },
    "edge": {
      "title": "SlotEdge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromSlotId",
        "id",
        "relation",
        "toSlotId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "fromSlotId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "From slot",
              "de": "Von Slot"
            },
            "ref": {
              "kind": "slot",
              "domain": "slot",
              "granularity": "slot"
            },
            "group": "target",
            "order": 20
          }
        },
        "toSlotId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "To slot",
              "de": "Zu Slot"
            },
            "ref": {
              "kind": "slot",
              "domain": "slot",
              "granularity": "slot"
            },
            "group": "target",
            "order": 30
          }
        },
        "relation": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Relation",
              "de": "Relation"
            },
            "description": {
              "en": "Adjacency class, e.g. adjacent, above or beside.",
              "de": "Nachbarschaftsklasse, z. B. adjacent, above oder beside."
            },
            "group": "rule",
            "order": 40
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Connection",
          "de": "Verbindung"
        },
        "group": "record",
        "order": 20
      }
    }
  }
}
