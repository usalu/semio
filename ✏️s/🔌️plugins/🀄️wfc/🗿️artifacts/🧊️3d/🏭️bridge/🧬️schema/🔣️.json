{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "producedBy",
    "excludedOwnerSegments",
    "aggregates",
    "coordinates"
  ],
  "properties": {
    "artifact": {
      "type": "string"
    },
    "producedBy": {
      "type": "string"
    },
    "excludedOwnerSegments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "aggregates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "standard",
          "subset",
          "surface",
          "owner"
        ],
        "properties": {
          "artifact": {
            "type": "string"
          },
          "standard": {
            "type": "string"
          },
          "subset": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    }
  }
}
