      "engine": {
        "family": "none",
        "implementation": "in-repository second implementation",
        "version": "0"
      },
      "productionReachable": false,
      "networkDuringExecution": false,
      "nativeSecondImplementation": {
        "format": "s.wfc.bitmap",
        "noThirdPartySurvey": {
          "ecosystemsSearched": [
            "python/pypi"
          ],
          "candidatesConsidered": [
            {
              "package": "wfc",
              "reason": "an overlapping-model collapser over PNG input; it carries no problem document and no mutation vocabulary, so it can neither read this carrier nor adjudicate an edit to it."
            },
            {
              "package": "wavefunctioncollapse",
              "reason": "same shape — a solver, not a document model; it has no notion of a palette-indexed base64 buffer, a pin lane or an output specification."
            }
          ]
        },
        "subjectImplementationLanguage": "rust",
        "secondImplementationLanguage": "python",
        "specificationSource": "../🧬️schema/📸️snapshot/🔣️.json; ../🧬️schema/🧬️mutations/🔣️.json; ../🧪️tests/🧫️fixtures/🧬️mutations",
        "fixtureCoverage": {
          "vectors": 14,
          "capabilitiesCovered": [
            "wfc-bitmap-1-mutate"
          ]
        }
      }
    }
