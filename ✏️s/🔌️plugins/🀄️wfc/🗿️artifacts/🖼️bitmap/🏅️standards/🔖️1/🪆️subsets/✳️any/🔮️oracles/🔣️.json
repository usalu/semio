  "oracles": [
    {
      "id": "wfc-bitmap-python-independent",
      "ecosystem": "python",
      "package": "",
      "version": "",
      "capabilities": [
        "wfc-bitmap-1-mutate"
      ],
      "comparisonProfiles": [
        "ordered-json-v1"
