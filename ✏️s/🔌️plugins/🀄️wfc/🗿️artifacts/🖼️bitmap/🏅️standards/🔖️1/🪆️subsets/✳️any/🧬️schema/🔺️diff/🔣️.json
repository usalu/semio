{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/bitmap/1/any/diff.json",
  "title": "BitmapDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seed",
    "input",
    "palette",
    "output",
    "model",
    "pinned"
  ],
  "properties": {
    "schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "input": {
      "title": "BitmapInputPatch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "writes"
      ],
      "properties": {
        "size": {
          "anyOf": [
            {
              "title": "BitmapSize",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 0
                },
                "height": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "writes": {
          "type": "array",
          "items": {
            "title": "BitmapInputWrite",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "region"
                ],
                "properties": {
                  "op": {
                    "const": "region"
                  },
                  "region": {
                    "title": "BitmapPixelRegion",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height",
                      "pixels"
                    ],
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "pixels": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "cells"
                ],
                "properties": {
                  "op": {
                    "const": "cells"
                  },
                  "cells": {
                    "type": "array",
                    "items": {
                      "title": "BitmapPixelCell",
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "y",
                        "value"
                      ],
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "value": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "palette": {
      "title": "BitmapPaletteDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed",
        "inserted",
        "recolored"
      ],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "color"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "color": {
                "title": "BitmapColor",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "r",
                  "g",
                  "b",
                  "a"
                ],
                "properties": {
                  "r": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "g": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "b": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "a": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "recolored": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "color"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "color": {
                "title": "BitmapColor",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "r",
                  "g",
                  "b",
                  "a"
                ],
                "properties": {
                  "r": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "g": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "b": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "a": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "output": {
      "anyOf": [
        {
          "title": "BitmapOutputSpec",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "periodic"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0
            },
            "periodic": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "title": "BitmapOverlappingModel",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "patternSize",
            "symmetry",
            "periodicInput",
            "ground"
          ],
          "properties": {
            "patternSize": {
              "type": "integer",
              "minimum": 0
            },
            "symmetry": {
              "type": "integer",
              "minimum": 0
            },
            "periodicInput": {
              "type": "boolean"
            },
            "ground": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "pinned": {
      "title": "PinnedDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed",
        "inserted",
        "moved",
        "modified"
      ],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "title": "PinnedRemoval",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "index"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "title": "PinnedInsertion",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "row"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "row": {
                "title": "BitmapPinnedPixel",
                "type": "object"
              }
            }
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "title": "PinnedRelocation",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "title": "PinnedModification",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "patch"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "patch": {
                "title": "PinnedPatch",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "color"
                ],
                "properties": {
                  "color": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
