{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/bitmap/1/any/mutation/change-model/schema.json",
  "title": "ChangeModel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patternSize",
    "symmetry",
    "periodicInput"
  ],
  "properties": {
    "patternSize": { "type": "integer", "minimum": 2, "maximum": 5 },
    "symmetry": { "type": "integer", "minimum": 1, "maximum": 8 },
    "periodicInput": { "type": "boolean" },
    "ground": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 }
  }
}
