              "domain": "slot",
              "granularity": "slot"
            },
            "group": "target",
            "order": 20
          }
        },
        "toSlotId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "To slot",
              "de": "Zu Slot"
            },
            "ref": {
              "kind": "slot",
              "domain": "slot",
              "granularity": "slot"
            },
            "group": "target",
            "order": 30
          }
        },
        "relation": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Relation",
              "de": "Relation"
            },
            "description": {
              "en": "Adjacency class, e.g. adjacent, above or beside.",
              "de": "Nachbarschaftsklasse, z. B. adjacent, above oder beside."
            },
            "group": "rule",
            "order": 40
          }
        }
