{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/wfc/wfc2d/1/any/mutation/create-slot/schema.json",
  "title": "CreateSlot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slot"
  ],
  "properties": {
    "slot": {
      "title": "Wfc2dSlot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique id of the record.",
              "de": "Eindeutige ID des Eintrags."
            },
            "group": "identity",
            "order": 10
          }
        },
        "x": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "X",
              "de": "X"
            },
            "step": 1,
            "precision": 2,
            "group": "position",
            "order": 20
          }
        },
        "y": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Y",
              "de": "Y"
            },
            "step": 1,
            "precision": 2,
            "group": "position",
            "order": 30
          }
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Width",
              "de": "Breite"
            },
            "step": 1,
            "precision": 2,
            "group": "geometry",
            "order": 40
          }
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Height",
              "de": "Höhe"
            },
            "step": 1,
            "precision": 2,
            "group": "geometry",
            "order": 50
          }
        },
        "pinnedTileId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "reference",
            "role": "target",
            "label": {
              "en": "Pinned tile",
              "de": "Fixierte Kachel"
            },
            "ref": {
              "kind": "tile"
            },
            "group": "target",
            "order": 60
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Slot",
          "de": "Slot"
        },
        "group": "record",
        "order": 10
      }
    }
  }
}
