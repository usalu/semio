{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "width",
          "height",
          "contradiction",
          "cancelled",
          "admitted",
          "commit"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "contradiction": {
            "type": "boolean"
          },
          "cancelled": {
            "type": "boolean"
          },
          "admitted": {
            "type": "boolean"
          },
          "commit": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
