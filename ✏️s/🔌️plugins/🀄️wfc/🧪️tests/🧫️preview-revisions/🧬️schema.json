{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "s.wfc.preview.revisions.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceRevision",
          "currentRevision",
          "visible"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceRevision": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "currentRevision": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 32,
                "maxItems": 32,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            ]
          },
          "visible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
