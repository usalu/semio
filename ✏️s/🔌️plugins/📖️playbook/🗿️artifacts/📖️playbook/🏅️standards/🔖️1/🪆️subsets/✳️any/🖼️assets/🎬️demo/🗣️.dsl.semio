semio playbook.playbook.dsl v1
schema=playbook.program id=facade-generator version="1" title="Facade Panel Generator" steps="[{\"id\":\"basics\",\"title\":\"Project Basics\",\"blocks\":[{\"id\":\"project-name\",\"label\":\"Project Name\",\"kind\":\"text\",\"required\":true,\"placeholder\":\"e.g. Riverside Tower\"},{\"id\":\"project-description\",\"label\":\"Description\",\"kind\":\"longText\",\"description\":\"Shown on the cover page.\",\"required\":false,\"placeholder\":\"One paragraph project summary\",\"default\":\"A mixed-use tower with a responsive facade.\"},{\"id\":\"panel-count\",\"label\":\"Panel Count\",\"kind\":\"number\",\"required\":true,\"default\":12,\"min\":4.0,\"max\":64.0,\"step\":1.0,\"unit\":\"panels\"},{\"id\":\"panel-width\",\"label\":\"Panel Width\",\"kind\":\"slider\",\"default\":1.2,\"min\":0.4,\"max\":2.4,\"step\":0.1,\"unit\":\"m\"},{\"id\":\"mirror-layout\",\"label\":\"Mirror Layout\",\"kind\":\"boolean\",\"default\":false},{\"id\":\"material\",\"label\":\"Material\",\"kind\":\"single\",\"required\":true,\"default\":\"aluminum\",\"options\":[{\"value\":\"aluminum\",\"label\":\"Aluminum\"},{\"value\":\"timber\",\"label\":\"Timber\"},{\"value\":\"terracotta\",\"label\":\"Terracotta\"}]},{\"id\":\"finishes\",\"label\":\"Finishes\",\"kind\":\"multi\",\"default\":[\"anodized\"],\"options\":[{\"value\":\"anodized\",\"label\":\"Anodized\"},{\"value\":\"powder-coated\",\"label\":\"Powder Coated\"},{\"value\":\"raw\",\"label\":\"Raw\"}]}]},{\"id\":\"schedule\",\"title\":\"Schedule & Look\",\"description\":\"Timing and finish details reviewers check before sign-off.\",\"blocks\":[{\"id\":\"install-date\",\"label\":\"Install Date\",\"kind\":\"date\",\"default\":\"2027-03-01\"},{\"id\":\"accent-color\",\"label\":\"Accent Color\",\"kind\":\"color\",\"default\":\"#2f6fed\"},{\"id\":\"panel-offset\",\"label\":\"Panel Offset\",\"kind\":\"vector\",\"unit\":\"m\",\"fields\":[{\"key\":\"x\",\"label\":\"X\",\"value\":0.0},{\"key\":\"y\",\"label\":\"Y\",\"value\":0.15},{\"key\":\"z\",\"label\":\"Z\",\"value\":0.0}]},{\"id\":\"notes-intro\",\"label\":\"Reviewer Notes\",\"kind\":\"note\",\"text\":\"Confirm structural clearances before approving the pattern below.\"},{\"id\":\"reference-photo\",\"label\":\"Reference Photo\",\"kind\":\"image\",\"src\":\"https://example.test/facade-reference.jpg\",\"accept\":\"image/*\"},{\"id\":\"cad-upload\",\"label\":\"CAD Reference\",\"kind\":\"file\",\"schema\":\"cad.reference.v1\",\"accept\":\".dwg,.ifc\"}]},{\"id\":\"pattern\",\"title\":\"Pattern Logic\",\"blocks\":[{\"id\":\"pattern-rule\",\"label\":\"Pattern Rule\",\"kind\":\"generative.pattern\",\"description\":\"Contributed by the procedural extension module.\",\"fixtureSlug\":\"voronoi-facade\",\"params\":{\"algorithm\":\"voronoi\",\"density\":0.6,\"seed\":7},\"condition\":{\"kind\":\"and\",\"items\":[{\"kind\":\"eq\",\"left\":{\"kind\":\"var\",\"name\":\"material\"},\"right\":{\"kind\":\"const\",\"value\":\"aluminum\"}},{\"kind\":\"truthy\",\"expr\":{\"kind\":\"var\",\"name\":\"mirror-layout\"}}]}},{\"id\":\"fallback-material\",\"label\":\"Fallback Material\",\"kind\":\"single\",\"options\":[{\"value\":\"aluminum\",\"label\":\"Aluminum (fallback)\"}],\"condition\":{\"kind\":\"or\",\"items\":[{\"kind\":\"eq\",\"left\":{\"kind\":\"var\",\"name\":\"material\"},\"right\":{\"kind\":\"const\",\"value\":\"timber\"}},{\"kind\":\"eq\",\"left\":{\"kind\":\"var\",\"name\":\"material\"},\"right\":{\"kind\":\"const\",\"value\":\"terracotta\"}}]}}]}]" document=child_id=playbook-document-f356fa146bfa9677 target="playbook-document-f356fa146bfa9677!s.stdio.semio@v1/document" flow=child_id=playbook-flow-7df9848f8967ac69 target="playbook-flow-7df9848f8967ac69!s.stdio.semio@v1/flow"
