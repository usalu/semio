{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/playbook/playbook/mutation/add-step/schema.json",
  "title": "AddStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "step"
  ],
  "properties": {
    "mutation": {
      "const": "addStep"
    },
    "step": {
      "title": "PlaybookStep",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks",
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "title": "PlaybookBlock",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Block Kind",
                    "de": "Blockart"
                  },
                  "description": {
                    "en": "Built-in kind (text, number, slider, single, …) or a module-contributed kind.",
                    "de": "Eingebaute Art (Text, Zahl, Schieberegler, Einfachauswahl, …) oder eine von einem Modul beigetragene Art."
                  }
                }
              },
              "description": {
                "type": "string"
              },
              "required": {
                "type": "boolean",
                "x-semio-ui": {
                  "widget": "toggle",
                  "role": "value",
                  "label": {
                    "en": "Required",
                    "de": "Pflichtfeld"
                  },
                  "description": {
                    "en": "The block must be answered.",
                    "de": "Der Block muss beantwortet werden."
                  }
                }
              },
              "placeholder": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Placeholder",
                    "de": "Platzhalter"
                  },
                  "description": {
                    "en": "Hint shown while the answer is empty.",
                    "de": "Hinweis, solange die Antwort leer ist."
                  }
                }
              },
              "default": {
                "description": "any JSON value",
                "x-semio-ui": {
                  "role": "value",
                  "label": {
                    "en": "Default Value",
                    "de": "Standardwert"
                  },
                  "description": {
                    "en": "Initial answer; any JSON value.",
                    "de": "Anfangsantwort; beliebiger JSON-Wert."
                  }
                }
              },
              "min": {
                "type": "number",
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Minimum",
                    "de": "Minimum"
                  },
                  "description": {
                    "en": "Lowest allowed answer of a number or slider block.",
                    "de": "Kleinste zulässige Antwort eines Zahlen- oder Schieberegler-Blocks."
                  },
                  "step": 1
                }
              },
              "max": {
                "type": "number",
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Maximum",
                    "de": "Maximum"
                  },
                  "description": {
                    "en": "Highest allowed answer of a number or slider block.",
                    "de": "Größte zulässige Antwort eines Zahlen- oder Schieberegler-Blocks."
                  },
                  "step": 1
                }
              },
              "step": {
                "type": "number",
                "x-semio-ui": {
                  "widget": "stepper",
                  "role": "value",
                  "label": {
                    "en": "Step Size",
                    "de": "Schrittweite"
                  },
                  "description": {
                    "en": "Increment of a number or slider block.",
                    "de": "Schrittweite eines Zahlen- oder Schieberegler-Blocks."
                  },
                  "step": 0.1
                }
              },
              "unit": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Unit",
                    "de": "Einheit"
                  },
                  "description": {
                    "en": "Unit shown next to a number answer.",
                    "de": "Neben einer Zahlenantwort angezeigte Einheit."
                  }
                }
              },
              "text": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "title": "PlaybookBlockOption",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                },
                "x-semio-ui": {
                  "role": "value",
                  "label": {
                    "en": "Options",
                    "de": "Optionen"
                  },
                  "description": {
                    "en": "Choices of a single or multiple choice block.",
                    "de": "Auswahlmöglichkeiten eines Einfach- oder Mehrfachauswahl-Blocks."
                  }
                }
              },
              "fields": {
                "type": "array",
                "items": {
                  "title": "PlaybookVectorField",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                },
                "x-semio-ui": {
                  "role": "value",
                  "label": {
                    "en": "Vector Fields",
                    "de": "Vektorfelder"
                  },
                  "description": {
                    "en": "Components of a vector block.",
                    "de": "Komponenten eines Vektor-Blocks."
                  }
                }
              },
              "schema": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Schema",
                    "de": "Schema"
                  },
                  "description": {
                    "en": "Schema id of the block's value, e.g. solid.step.",
                    "de": "Schema-ID des Blockwerts, z. B. solid.step."
                  }
                }
              },
              "src": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Source URL",
                    "de": "Quell-URL"
                  },
                  "description": {
                    "en": "Location of the image an image block shows.",
                    "de": "Ort des Bildes, das ein Bild-Block zeigt."
                  }
                }
              },
              "accept": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Accepted File Types",
                    "de": "Akzeptierte Dateitypen"
                  },
                  "description": {
                    "en": "File type filter of a file block, e.g. image/*.",
                    "de": "Dateitypfilter eines Datei-Blocks, z. B. image/*."
                  }
                }
              },
              "fixtureSlug": {
                "type": "string",
                "x-semio-ui": {
                  "widget": "text",
                  "role": "value",
                  "label": {
                    "en": "Fixture",
                    "de": "Vorlage"
                  },
                  "description": {
                    "en": "Procedural fixture the block renders.",
                    "de": "Prozedurale Vorlage, die der Block darstellt."
                  }
                }
              },
              "params": {
                "description": "any JSON value"
              },
              "condition": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Const"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Var"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Eq"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "And"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Or"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "Truthy"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                ],
                "x-semio-ui": {
                  "role": "value",
                  "label": {
                    "en": "Condition",
                    "de": "Bedingung"
                  },
                  "description": {
                    "en": "Expression that must hold for the block to apply.",
                    "de": "Ausdruck, der gelten muss, damit der Block gilt."
                  }
                }
              }
            }
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Blocks",
              "de": "Blöcke"
            },
            "description": {
              "en": "The step's blocks in order.",
              "de": "Die Blöcke des Schritts in Reihenfolge."
            }
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Step",
          "de": "Schritt"
        },
        "description": {
          "en": "The complete step record to add.",
          "de": "Der vollständige hinzuzufügende Schritt."
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
