{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/playbook/playbook/mutation/move-step/schema.json",
  "title": "MoveStep",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "index",
    "stepId"
  ],
  "properties": {
    "mutation": {
      "const": "moveStep"
    },
    "stepId": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Step",
          "de": "Schritt"
        },
        "description": {
          "en": "The step this mutation addresses.",
          "de": "Der Schritt, den diese Mutation adressiert."
        },
        "ref": {
          "kind": "step",
          "domain": "blocks",
          "granularity": "step"
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
