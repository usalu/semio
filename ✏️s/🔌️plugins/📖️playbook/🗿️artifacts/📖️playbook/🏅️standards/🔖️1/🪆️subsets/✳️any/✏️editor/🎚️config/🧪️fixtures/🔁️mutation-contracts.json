{
  "base": {
    "locale": "en-US",
    "contributionsJson": "[]"
  },
  "cases": [
    {
      "kind": "replace-config",
      "mutation": {
        "ReplaceConfig": {
          "config": {
            "locale": "de-DE",
            "contributionsJson": "[{\"kind\":\"über\"}]"
          }
        }
      },
      "expected": {
        "locale": "de-DE",
        "contributionsJson": "[{\"kind\":\"über\"}]"
      }
    },
    {
      "kind": "set-locale",
      "mutation": {
        "SetLocale": {
          "value": "de-DE"
        }
      },
      "expected": {
        "locale": "de-DE",
        "contributionsJson": "[]"
      }
    },
    {
      "kind": "set-contributions",
      "mutation": {
        "SetContributions": {
          "json": "[{\"kind\":\"über\"}]"
        }
      },
      "expected": {
        "locale": "en-US",
        "contributionsJson": "[{\"kind\":\"über\"}]"
      }
    }
  ]
}
