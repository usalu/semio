protocol playbook.mutations
version 1
schema playbook.playbook
start record
framing record

# Real op frame (`dsl::variants_binary::encode_tagged_op`): `format u8` (`OP_BINARY_FORMAT`) then `tag varint`,
# then the kind's framework record body (`os_pack::encode_record_body`). Each record is one mutation kind at its
# wire tag; this file is the only source of those tags, which the codec looks up by the kind's keyword.
header fixed 2
field format u8
field tag varint
record add-step tag=0
field payload bytes
record remove-step tag=1
field payload bytes
record move-step tag=2
field payload bytes
record add-block tag=3
field payload bytes
record remove-block tag=4
field payload bytes
record move-block tag=5
field payload bytes
record replace-block tag=6
field payload bytes
record update-step tag=7
field payload bytes
record change-title tag=8
field payload bytes
