{
  "$id": "https://semio.tech/schema/s/playbook/playbook/diff.json",
  "title": "PlaybookDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": { "title": "PlaybookArtifact", "type": "object", "x-semio-state": "persistent" },
    "schema": { "type": "string", "x-semio-state": "persistent" },
    "id": { "type": "string", "x-semio-state": "persistent" },
    "version": { "type": "string", "x-semio-state": "persistent" },
    "title": {
      "oneOf": [{ "type": "null" }, { "type": "string" }],
      "x-semio-state": "persistent"
    },
    "steps": { "$ref": "#/$defs/PlaybookStepsDelta", "x-semio-state": "persistent" },
    "selectedIds": { "$ref": "#/$defs/PlaybookStringList", "x-semio-state": "shared-ui" },
    "locale": { "type": "string", "x-semio-state": "local-ui" },
    "contributionsJson": { "type": "string", "x-semio-state": "local-ui" }
  },
  "$defs": {
    "PlaybookStringList": {
      "title": "PlaybookStringList",
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PlaybookStepsDelta": {
      "title": "PlaybookStepsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "patched"],
      "properties": {
        "added": { "type": "array", "items": { "$ref": "#/$defs/PlaybookStep" } },
        "removed": { "type": "array", "items": { "type": "string" } },
        "patched": { "type": "array", "items": { "$ref": "#/$defs/PlaybookStepPatchEntry" } },
        "reordered": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PlaybookBlocksDelta": {
      "title": "PlaybookBlocksDelta",
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "patched"],
      "properties": {
        "added": { "type": "array", "items": { "$ref": "#/$defs/PlaybookBlock" } },
        "removed": { "type": "array", "items": { "type": "string" } },
        "patched": { "type": "array", "items": { "$ref": "#/$defs/PlaybookBlockPatchEntry" } },
        "reordered": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PlaybookStepPatchEntry": {
      "title": "PlaybookStepPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "patch"],
      "properties": {
        "id": { "type": "string" },
        "patch": { "$ref": "#/$defs/PlaybookStepPatch" }
      }
    },
    "PlaybookBlockPatchEntry": {
      "title": "PlaybookBlockPatchEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "patch"],
      "properties": {
        "id": { "type": "string" },
        "patch": { "$ref": "#/$defs/PlaybookBlockPatch" }
      }
    },
    "PlaybookStepPatch": {
      "title": "PlaybookStepPatch",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "blocks": { "$ref": "#/$defs/PlaybookBlocksDelta" }
      }
    },
    "PlaybookBlockPatch": {
      "title": "PlaybookBlockPatch",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block": { "$ref": "#/$defs/PlaybookBlock" }
      }
    },
    "PlaybookStep": {
      "title": "PlaybookStep",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/PlaybookBlock" } }
      }
    },
    "PlaybookBlock": {
      "title": "PlaybookBlock",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "kind": { "type": "string" }
      }
    }
  }
}
