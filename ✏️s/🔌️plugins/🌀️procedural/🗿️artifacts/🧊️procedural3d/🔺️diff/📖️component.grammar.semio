dialect grammar
grammar procedural.procedural3d.diff
extension procedural3d
use family-scene
start diff

artifact-mark = "procedural.procedural3d-diff"
diff = artifact-mark mesh-change+
mesh-change = "add-vertex" vtx+ | "drop-face" INT | "transform" xfm+ | "revolve-profile" rev+
rev = "profile" "=" IDENT | "axis" "=" IDENT | "angle" "=" FLOAT
vtx = "x" "=" FLOAT | "y" "=" FLOAT | "z" "=" FLOAT
xfm = "axis" "=" IDENT | "delta" "=" FLOAT
layer = IDENT "@" FLOAT FLOAT
