{
  "$id": "https://semio.tech/schema/s/procedural/procedural2d/diff.json",
  "title": "Procedural2dDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "$ref": "#/$defs/Procedural2dArtifact",
      "x-semio-state": "artifact"
    },
    "fixture": {
      "$ref": "#/$defs/FlowFixture",
      "x-semio-state": "artifact"
    },
    "generation": {
      "$ref": "#/$defs/GenerationPlayState",
      "x-semio-state": "artifact"
    },
    "selectedIds": {
      "$ref": "#/$defs/Procedural2dStringList",
      "x-semio-state": "presence"
    },
    "graphCamera": {
      "$ref": "#/$defs/CameraJson",
      "x-semio-state": "config"
    },
    "showMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "selectedGenerationId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ],
      "x-semio-state": "presence"
    },
    "generationPreviewText": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ],
      "x-semio-state": "artifact"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "CameraJson": {
      "title": "CameraJson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "WidgetLayout": {
      "title": "WidgetLayout",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "SynapseSpec": {
      "title": "SynapseSpec",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "fromPort",
        "toPort"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "fromPort": {
          "type": "string"
        },
        "toPort": {
          "type": "string"
        }
      }
    },
    "Widget": {
      "title": "Widget",
      "type": "string",
      "contentMediaType": "application/json"
    },
    "FlowFixture": {
      "title": "FlowFixture",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "camera",
        "widgets",
        "synapses",
        "layout"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "camera": {
          "$ref": "#/$defs/CameraJson"
        },
        "widgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Widget"
          }
        },
        "synapses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SynapseSpec"
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/WidgetLayout"
          }
        }
      }
    },
    "FormGeneration": {
      "title": "FormGeneration",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "valuesJson"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "valuesJson": {
          "type": "string",
          "contentMediaType": "application/json"
        }
      }
    },
    "GenerationPlayState": {
      "title": "GenerationPlayState",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generations"
      ],
      "properties": {
        "generations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormGeneration"
          }
        },
        "selectedGenerationId": {
          "type": "string"
        },
        "previewText": {
          "type": "string"
        }
      }
    },
    "Procedural2dStringList": {
      "title": "Procedural2dStringList",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Procedural2dArtifact": {
      "title": "Procedural2dArtifact",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture",
        "generation",
        "selectedIds",
        "graphCamera",
        "showMode",
        "locale"
      ],
      "properties": {
        "fixture": {
          "$ref": "#/$defs/FlowFixture"
        },
        "generation": {
          "$ref": "#/$defs/GenerationPlayState"
        },
        "selectedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graphCamera": {
          "$ref": "#/$defs/CameraJson"
        },
        "showMode": {
          "type": "string"
        },
        "selectedGenerationId": {
          "type": "string"
        },
        "generationPreviewText": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        }
      }
    }
  }
}
