{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoveWidget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "layout"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "layout": {
      "title": "WidgetLayout",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
