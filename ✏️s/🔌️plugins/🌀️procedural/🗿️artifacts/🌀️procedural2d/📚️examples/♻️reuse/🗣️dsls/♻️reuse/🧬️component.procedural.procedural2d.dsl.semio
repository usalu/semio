semio procedural.procedural2d.dsl v1
schema="flow.fixture"
camera {
  x=0 y=0 zoom=1
}
layout={
}
synapses [id:TEXT wire:WIRE] {
  s1 rect@draw.drawing->fill@drawing
  s2 fill@draw.drawing->preview
}
generations [id:TEXT name:TEXT values:VAL] {
}
widgets {
  neuron id="rect" neuron-kind=draw.shape.rect preview=true input-ports=[ ] output-ports=[ ] params=[ ]
  neuron id="fill" neuron-kind=draw.style.fill preview=true input-ports=[ ] output-ports=[ ] params=[ ]
  output-preview id="preview" preview=[ ] expanded=[ ]
}
