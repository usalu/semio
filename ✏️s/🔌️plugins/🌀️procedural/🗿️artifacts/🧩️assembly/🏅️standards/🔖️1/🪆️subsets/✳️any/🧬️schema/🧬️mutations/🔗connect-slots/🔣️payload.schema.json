{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConnectSlots",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edge",
    "index"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "edge": {
      "title": "AssemblySlotEdge",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromSlotId",
        "id",
        "toSlotId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "fromSlotId": {
          "type": "string"
        },
        "toSlotId": {
          "type": "string"
        }
      }
    }
  }
}
