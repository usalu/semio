{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/procedural/assembly/1/any/mutation/create-slot.json",
  "title": "CreateSlot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "slot"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "slot": {
      "title": "AssemblySlot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "y",
        "z"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "pinnedModuleId": {
          "type": "string"
        }
      }
    }
  }
}
