{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:generation2d:media-import:fixtures",
  "type": "object",
  "required": ["port", "schema", "initialValue", "cases"],
  "additionalProperties": false,
  "properties": {
    "port": { "const": "params:in" },
    "schema": { "const": "params" },
    "initialValue": { "const": 3 },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "input", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "input": { "type": "object" },
          "expected": { "type": "number" }
        }
      }
    }
  }
}
