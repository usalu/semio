{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/procedural/generation2d/mutation/update-camera/schema.json",
  "title": "UpdateCamera",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera"
  ],
  "properties": {
    "camera": {
      "title": "CameraJson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Pan X",
              "de": "Verschiebung X"
            },
            "step": 1,
            "precision": 1,
            "group": "camera",
            "order": 10
          }
        },
        "y": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Pan Y",
              "de": "Verschiebung Y"
            },
            "step": 1,
            "precision": 1,
            "group": "camera",
            "order": 20
          }
        },
        "zoom": {
          "type": "number",
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "Zoom",
              "de": "Zoom"
            },
            "step": 0.01,
            "precision": 2,
            "softMin": 0.1,
            "softMax": 10,
            "scale": "log",
            "snaps": [
              0.5,
              1,
              2
            ],
            "group": "camera",
            "order": 30
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Graph camera",
          "de": "Graphkamera"
        },
        "description": {
          "en": "Pan and zoom of the graph canvas.",
          "de": "Verschiebung und Zoom der Graphfläche."
        },
        "group": "camera",
        "order": 10
      }
    }
  }
}
