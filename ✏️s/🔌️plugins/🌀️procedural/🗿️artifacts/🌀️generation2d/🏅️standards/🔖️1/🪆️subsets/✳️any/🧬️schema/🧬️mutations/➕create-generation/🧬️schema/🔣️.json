{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/procedural/generation2d/mutation/create-generation/schema.json",
  "title": "CreateGeneration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation"
  ],
  "properties": {
    "generation": {
      "title": "FormGeneration",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "values"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "ID",
              "de": "ID"
            },
            "description": {
              "en": "Unique generation id.",
              "de": "Eindeutige Generierungs-ID."
            },
            "group": "identity",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Name",
              "de": "Name"
            },
            "group": "identity",
            "order": 20
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "description": "the answer, any JSON value"
          },
          "x-semio-ui": {
            "role": "value",
            "label": {
              "en": "Answers",
              "de": "Antworten"
            },
            "description": {
              "en": "Answer per question id.",
              "de": "Antwort je Fragen-ID."
            },
            "group": "value",
            "order": 30
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Generation",
          "de": "Generierung"
        },
        "description": {
          "en": "The complete generation to add.",
          "de": "Die vollständige hinzuzufügende Generierung."
        },
        "group": "record",
        "order": 10
      }
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0,
      "description": "Zero-based insertion position among the generations; absent or past the end appends.",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "step": 1,
        "precision": 0,
        "group": "placement",
        "order": 900
      }
    }
  }
}
