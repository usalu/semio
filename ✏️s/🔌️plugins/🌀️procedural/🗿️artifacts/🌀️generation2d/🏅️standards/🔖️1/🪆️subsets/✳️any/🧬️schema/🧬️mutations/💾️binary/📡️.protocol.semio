dialect protocol
protocol generation2d.mutations
version 1
schema procedural.generation2d.mutations
start record
framing record

# Real op frame (`dsl::variants_binary::encode_tagged_op`): `format u8` (`OP_BINARY_FORMAT`) then `tag varint`,
# then the kind's framework record body (`os_pack::encode_record_body`). Each record is one mutation kind at its
# wire tag; this file is the only source of those tags, which the codec looks up by the kind's keyword.
header fixed 2
field format u8
field tag varint
record create-widget tag=0
field payload bytes
record replace-widget tag=1
field payload bytes
record delete-widget tag=2
field payload bytes
record connect-synapse tag=3
field payload bytes
record replace-synapse tag=4
field payload bytes
record disconnect-synapse tag=5
field payload bytes
record move-widget tag=6
field payload bytes
record clear-widget-layout tag=7
field payload bytes
record update-camera tag=8
field payload bytes
record change-schema tag=9
field payload bytes
record create-generation tag=10
field payload bytes
record delete-generation tag=11
field payload bytes
record rename-generation tag=12
field payload bytes
record change-generation-value tag=13
field payload bytes
