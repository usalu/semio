{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/app/procedural/2d/presence/schema.json",
  "title": "Generation2dPresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera",
    "showMode"
  ],
  "properties": {
    "camera": {
      "$ref": "#/$defs/CameraJson",
      "x-semio-state": "presence"
    },
    "showMode": {
      "type": "string",
      "x-semio-state": "presence"
    },
    "selectedGenerationId": {
      "type": "string",
      "x-semio-state": "presence"
    }
  },
  "$defs": {
    "CameraJson": {
      "title": "CameraJson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
