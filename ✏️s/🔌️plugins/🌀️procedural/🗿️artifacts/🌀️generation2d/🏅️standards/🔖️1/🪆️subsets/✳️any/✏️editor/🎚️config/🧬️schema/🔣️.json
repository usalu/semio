{
  "$id": "https://semio.tech/schema/app/procedural/2d/config.json",
  "title": "Generation2dConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera",
    "showMode",
    "locale"
  ],
  "properties": {
    "camera": {
      "$ref": "#/$defs/CameraJson",
      "x-semio-state": "config"
    },
    "showMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "selectedGenerationId": {
      "type": "string",
      "x-semio-state": "config"
    },
    "generationPreviewText": {
      "type": "string",
      "x-semio-state": "config"
    },
    "locale": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "CameraJson": {
      "title": "CameraJson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
