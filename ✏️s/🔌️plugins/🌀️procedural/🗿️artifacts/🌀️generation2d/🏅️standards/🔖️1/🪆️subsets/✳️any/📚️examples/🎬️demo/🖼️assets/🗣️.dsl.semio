semio procedural.generation2d.dsl v1
schema=flow.host_snapshot
camera {
  x=0 y=0 zoom=1
}
widgets {
  input-slider id=slider label="Width" value=30 min=1 max=100 step=1
  neuron id=rect neuron-kind=draw.shape.rect preview=true input-ports=[ "x" "y" "width" "height" ] output-ports=[ ]
  params [key:TEXT value:BLOCK] {
  }
  neuron id=outline neuron-kind=draw.style.stroke preview=true input-ports=[ "drawing" "width" "colorR" "colorG" "colorB" "colorA" ] output-ports=[ ]
  params [key:TEXT value:BLOCK] {
  }
  output-preview id=preview expanded=[ ]
  preview [key:TEXT value:BLOCK] {
  }
}
layout={
  outline=x=240 y=-40 preview=x=360 y=-40 rect=x=120 y=-40 slider=x=40 y=-40
}
synapses [id:TEXT wire:WIRE] {
  s1 slider@number->rect@width
  s2 rect@draw.drawing->outline@drawing
  s3 outline@draw.drawing->preview
}
generations [id:TEXT name:TEXT values:MAP] {
}
