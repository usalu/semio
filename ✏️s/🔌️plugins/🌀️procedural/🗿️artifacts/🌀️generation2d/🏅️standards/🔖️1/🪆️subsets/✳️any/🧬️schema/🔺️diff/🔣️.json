    },
    "selectedIds": {
      "$ref": "https://semio.tech/schema/s/procedural/generation2d/artifact.json#/$defs/Generation2dStringList",
      "x-semio-state": "presence"
    },
    "graphCamera": {
      "$ref": "https://semio.tech/schema/s/procedural/generation2d/artifact.json#/$defs/CameraJson",
