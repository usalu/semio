{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/procedural/generation2d/diff.json",
  "title": "Generation2dDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "artifact": {
      "$ref": "#/$defs/Generation2dArtifact",
      "x-semio-state": "artifact"
    },
    "fixture": {
      "$ref": "https://semio.tech/schema/s/procedural/generation2d/artifact.json#/$defs/FlowFixture",
