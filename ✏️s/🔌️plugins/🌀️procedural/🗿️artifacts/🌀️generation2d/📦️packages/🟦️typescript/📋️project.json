{
  "name": "@semio-tech/procedural-generation2d",
  "$schema": "../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": [
    "language:typescript",
    "role:artifact",
    "family:procedural"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🟦️.ts",
        "{workspaceRoot}/✏️s/🔌️plugins/🌀️procedural/🫀️core/🧬️generation/🪶️sqlite/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🌀️procedural/🗿️artifacts/🌀️generation2d/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🟦️.ts",
        "{workspaceRoot}/✏️s/🔌️plugins/🌀️procedural/🫀️core/🧬️generation/🪶️sqlite/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🌀️procedural/🗿️artifacts/🌀️generation2d/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/../../🏅️standards/**/*",
        "{projectRoot}/../../🟦️.ts",
        "{workspaceRoot}/✏️s/🔌️plugins/🌀️procedural/🫀️core/🧬️generation/🪶️sqlite/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🪶️sqlite-snapshot/**/*",
        "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/📦️artifacts/**/*"
      ],
      "options": {
        "cwd": "✏️s/🔌️plugins/🌀️procedural/🗿️artifacts/🌀️generation2d/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "verify-snapshot-sqlite-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "✏️s/🔌️plugins/🌀️procedural/🗿️artifacts/🌀️generation2d/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts verify snapshot-sqlite-source",
        "forwardAllArgs": true
      }
    }
  }
}
