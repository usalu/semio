{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "initial",
      "writes",
      "expected",
      "live",
      "matches"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "initial": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "writes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window",
            "ids"
          ],
          "properties": {
            "window": {
              "type": "string"
            },
            "ids": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "expected": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "items": false,
          "minItems": 2
        }
      },
      "live": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "items": false,
          "minItems": 2
        }
      },
      "matches": {
        "type": "boolean"
      }
    }
  }
}
