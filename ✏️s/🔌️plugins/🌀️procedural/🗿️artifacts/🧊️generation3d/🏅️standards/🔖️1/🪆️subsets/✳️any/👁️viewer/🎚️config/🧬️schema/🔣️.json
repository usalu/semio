{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/app/procedural/3d/viewer/config/schema.json",
  "title": "Generation3dViewConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lodMode",
    "showMode",
    "previewCamera",
    "sunJson"
  ],
  "properties": {
    "lodMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "showMode": {
      "type": "string",
      "x-semio-state": "config"
    },
    "previewCamera": {
      "$ref": "#/$defs/Generation3dViewCamera",
      "x-semio-state": "config"
    },
    "sunJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "activeExampleId": {
      "type": "string",
      "x-semio-state": "config"
    }
  },
  "$defs": {
    "Generation3dViewCamera": {
      "title": "Generation3dViewCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "fov"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Position",
              "de": "Position"
            },
            "description": {
              "en": "Where the camera stands.",
              "de": "Standpunkt der Kamera."
            },
            "step": 0.1,
            "group": "camera",
            "order": 10
          }
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3,
          "x-semio-ui": {
            "widget": "vector",
            "role": "value",
            "label": {
              "en": "Look at",
              "de": "Blickziel"
            },
            "description": {
              "en": "The point the camera looks at.",
              "de": "Der Punkt, auf den die Kamera blickt."
            },
            "step": 0.1,
            "group": "camera",
            "order": 20
          }
        },
        "fov": {
          "type": "number",
          "format": "double",
          "x-semio-ui": {
            "widget": "slider",
            "role": "value",
            "label": {
              "en": "Field of view",
              "de": "Sichtfeld"
            },
            "description": {
              "en": "Vertical opening angle of the camera.",
              "de": "Vertikaler Öffnungswinkel der Kamera."
            },
            "unit": "deg",
            "step": 1,
            "precision": 1,
            "softMin": 10,
            "softMax": 120,
            "snaps": [
              30,
              45,
              60,
              90
            ],
            "group": "camera",
            "order": 30
          }
        }
      }
    }
  }
}
