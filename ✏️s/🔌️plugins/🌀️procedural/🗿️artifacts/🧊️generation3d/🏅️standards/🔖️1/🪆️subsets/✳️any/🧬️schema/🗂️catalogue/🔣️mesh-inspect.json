{
  "category": {
    "id": "mesh.inspect",
    "emoji": "🔎️",
    "order": 260,
    "label": {
      "en": "Mesh inspection",
      "de": "Netzinspektion"
    },
    "description": {
      "en": "Read positions, endpoints, normals and centers of single mesh components.",
      "de": "Positionen, Endpunkte, Normalen und Mittelpunkte einzelner Netzelemente auslesen."
    }
  },
  "kinds": [
    {
      "id": "mesh.inspect.vertex",
      "category": "mesh.inspect",
      "emoji": "📍️",
      "label": {
        "en": "Inspect vertex",
        "de": "Eckpunkt untersuchen"
      },
      "description": {
        "en": "Reads the position of one vertex without changing the mesh.",
        "de": "Liest die Position eines Eckpunkts, ohne das Netz zu ändern."
      },
      "inputs": [
        {
          "name": "mesh",
          "label": {
            "en": "Mesh",
            "de": "Netz"
          },
          "description": {
            "en": "The polygon mesh to edit.",
            "de": "Das zu bearbeitende Polygonnetz."
          },
          "type": "mesh"
        },
        {
          "name": "vertex",
          "label": {
            "en": "Vertex",
            "de": "Eckpunkt"
          },
          "description": {
            "en": "The vertex to read.",
            "de": "Der auszulesende Eckpunkt."
          },
          "type": "selection",
          "selection": {
            "component": "vertex",
            "source": "mesh",
            "multiple": false
          },
          "minItems": 1,
          "maxItems": 1,
          "default": [
            0
          ]
        }
      ],
      "outputs": [
        {
          "name": "position",
          "label": {
            "en": "Position",
            "de": "Position"
          },
          "description": {
            "en": "The position of the vertex.",
            "de": "Die Position des Eckpunkts."
          },
          "type": "point"
        }
      ],
      "quality": "polygon-mesh",
      "interaction": {
        "pick": [
          {
            "component": "mesh",
            "port": "mesh"
          },
          {
            "component": "vertex",
            "port": "vertex"
          }
        ]
      },
      "preview": false
    },
