{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/procedural/generation3d/mutation/rotate-transforms/schema.json",
  "title": "RotateTransforms",
  "x-semio-inverse-rows": { "perTarget": { "targets": 1 } },
  "description": "The `rotate-transforms` mutation record — one gumball rotation as intent: the world-axis rotation every addressed rotate operator composes after its own rotation, read off the BASE graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "targets",
    "ax",
    "ay",
    "az",
    "angle"
  ],
  "properties": {
    "mutation": {
      "const": "rotateTransforms",
      "x-semio-ui": {
        "widget": "hidden",
        "role": "discriminator",
        "label": {
          "en": "Mutation",
          "de": "Mutation"
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true,
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Transforms",
          "de": "Transformationen"
        },
        "description": {
          "en": "The gumball transform operators of the generator graph this gesture composes into; missing or other operators are skipped.",
          "de": "Die Gumball-Transformationsoperatoren des Generatorgraphen, in die diese Geste einrechnet; fehlende oder andere Operatoren werden übersprungen."
        },
        "ref": {
          "kind": "widget",
          "domain": "graph",
          "granularity": "node"
        },
        "group": "target",
        "order": 10
      }
    },
    "ax": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Axis X",
          "de": "Achse X"
        },
        "step": 0.1,
        "precision": 3,
        "group": "axis",
        "order": 20
      }
    },
    "ay": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Axis Y",
          "de": "Achse Y"
        },
        "step": 0.1,
        "precision": 3,
        "group": "axis",
        "order": 30
      }
    },
    "az": {
      "type": "number",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "Axis Z",
          "de": "Achse Z"
        },
        "step": 0.1,
        "precision": 3,
        "group": "axis",
        "order": 40
      }
    },
    "angle": {
      "type": "number",
      "x-semio-ui": {
        "widget": "dial",
        "role": "value",
        "label": {
          "en": "Angle",
          "de": "Winkel"
        },
        "step": 0.017453292519943295,
        "precision": 4,
        "group": "angle",
        "order": 50,
        "unit": "rad",
        "displayUnit": "°",
        "displayFactor": 57.29577951308232
      }
    }
  },
  "x-semio-invariant": [
    {
      "id": "axis-nonzero",
      "description": {
        "en": "The rotation axis is not the zero vector.",
        "de": "Die Drehachse ist nicht der Nullvektor."
      }
    }
  ]
}
