{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Procedural Component Target",
  "type": "string",
  "pattern": "^[^@#~]+@[^@#~]+#(0|[1-9][0-9]*)\\.(vertex|edge|face)\\.(0|[1-9][0-9]*)(~[0-9a-f]{64}~[1-9][0-9]{0,19}~[0-9a-f]{64})?(?![\\s\\S])",
  "$defs": {
    "AnalyticComponentSource": {
      "type": "object",
      "required": [
        "handle",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
