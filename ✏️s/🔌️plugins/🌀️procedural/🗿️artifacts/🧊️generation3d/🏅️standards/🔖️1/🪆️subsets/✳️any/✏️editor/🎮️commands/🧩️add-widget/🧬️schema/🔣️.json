{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generation3d Widget Creation",
  "type": "object",
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "neuron",
        "inputSlider",
        "inputNote",
        "inputImage",
        "outputPreview",
        "outputExport",
        "outputAction",
        "variable"
      ]
    },
    "neuronKind": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "enum": [
        "stl",
        "obj",
        "ply",
        "gltf",
        "las",
        "dwg",
        "txt"
      ],
      "default": "gltf"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "sourceWidget": {
      "type": "string",
      "minLength": 1
    },
    "sourcePort": {
      "type": "string",
      "minLength": 1
    },
    "targetPort": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "neuron"
          }
        }
      },
      "then": {
        "required": [
          "neuronKind"
        ]
      },
      "else": {
        "not": {
          "required": [
            "neuronKind"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "outputExport"
          }
        }
      },
      "then": {},
      "else": {
        "not": {
          "required": [
            "format"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "outputAction"
          }
        }
      },
      "then": {
        "required": [
          "action"
        ]
      },
      "else": {
        "not": {
          "required": [
            "action"
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "sourceWidget"
            ]
          },
          {
            "required": [
              "sourcePort"
            ]
          },
          {
            "required": [
              "targetPort"
            ]
          },
          {
            "required": [
              "sourceRevision"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "neuron"
          }
        }
      }
    }
  ],
  "dependencies": {
    "sourceWidget": [
      "sourcePort",
      "targetPort",
      "sourceRevision"
    ],
    "sourcePort": [
      "sourceWidget",
      "targetPort",
      "sourceRevision"
    ],
    "targetPort": [
      "sourceWidget",
      "sourcePort",
      "sourceRevision"
    ],
    "sourceRevision": [
      "sourceWidget",
      "sourcePort",
      "targetPort"
    ]
  }
}
