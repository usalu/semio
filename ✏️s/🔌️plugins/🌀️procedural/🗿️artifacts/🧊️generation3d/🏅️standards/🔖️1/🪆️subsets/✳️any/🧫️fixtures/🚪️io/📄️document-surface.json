    { "id": "dwg", "extension": ".dwg" },
    { "id": "json", "extension": ".json" },
    { "id": "txt", "extension": ".txt" }
  ],
  "importWithheld": [
    { "id": "las", "reason": "LAS is export-only in this artifact — its import leaf is an honest Err, so offering it in the picker could only ever fail." },
    { "id": "png", "reason": "A raster carries no recoverable flow graph, so its import leaf is an honest Err." }
  ],
  "acceptFilter": ".stl,.obj,.ply,.gltf,.dwg,.json,.txt",
  "editorActions": [
    { "id": "importDocumentRequest", "kind": "Shell", "inPalette": true, "labelEn": "Import Document…", "labelDe": "Dokument importieren…", "chord": "mod+o" },
    { "id": "exportDocument", "kind": "Shell", "inPalette": true, "labelEn": "Export Document…", "labelDe": "Dokument exportieren…", "chord": "mod+shift+e" },
    { "id": "importDocument", "kind": "Mutation", "inPalette": false, "labelEn": "Import Document File", "labelDe": "Dokumentdatei importieren" }
  ],
  "viewerActions": [
    { "id": "exportDocument", "kind": "View", "inPalette": true, "labelEn": "Export Document…", "labelDe": "Dokument exportieren…", "chord": "mod+shift+e" }
  ],
  "publicationLanes": {
    "editor": { "importDocumentRequest": ["HostOnly"], "importDocument": ["Artifact", "Config"], "exportDocument": ["HostOnly"] },
    "viewer": { "exportDocument": ["HostOnly"] }
  },
  "chunking": {
    "note": "One chunk crosses as ONE `payload` string inside one public invocation, and the host's envelope validator refuses any string above its own cap BEFORE the addressed tool's contract is consulted — so the chunk extent IS that cap. `chunkCount` counts the chunks one payload is cut into; `chunk` is the zero-based position, and the run's chunks arrive in order. Two rules about an out-of-order arrival, and they are different: a chunk the run has ALREADY admitted (position above zero, below the cursor) is a RETRANSMISSION, acknowledged at the cursor it stands on rather than costing the whole upload; position ZERO is never a retransmission but a RESTART, because that is what re-picking the same file looks like, so the run reopens and the cursor returns to one. Anything ahead of the cursor is a gap and drops the run.",
    "chunkBytes": 4096,
    "cases": [
      { "id": "empty", "payloadBytes": 0, "chunks": 1 },
      { "id": "one-byte", "payloadBytes": 1, "chunks": 1 },
      { "id": "exactly-one-chunk", "payloadBytes": 4096, "chunks": 1 },
      { "id": "one-over", "payloadBytes": 4097, "chunks": 2 },
      { "id": "three-chunks", "payloadBytes": 9000, "chunks": 3 }
    ],
    "staging": [
      { "id": "single-chunk-completes", "events": [{ "chunk": 0, "chunkCount": 1 }], "outcome": "complete" },
      { "id": "two-chunks-stage-then-complete", "events": [{ "chunk": 0, "chunkCount": 2 }, { "chunk": 1, "chunkCount": 2 }], "outcome": "complete" },
      { "id": "open-run-emits-nothing", "events": [{ "chunk": 0, "chunkCount": 2 }], "outcome": "staged", "nextChunk": 1 },
      { "id": "retransmission-is-acknowledged", "events": [{ "chunk": 0, "chunkCount": 3 }, { "chunk": 1, "chunkCount": 3 }, { "chunk": 1, "chunkCount": 3 }], "outcome": "staged", "nextChunk": 2 },
      { "id": "restart-at-zero-reopens-the-run", "events": [{ "chunk": 0, "chunkCount": 3 }, { "chunk": 1, "chunkCount": 3 }, { "chunk": 0, "chunkCount": 3 }], "outcome": "staged", "nextChunk": 1 },
      { "id": "gap-drops-the-run", "events": [{ "chunk": 0, "chunkCount": 3 }, { "chunk": 2, "chunkCount": 3 }], "outcome": "gap" },
      { "id": "resume-without-an-open-run-is-a-gap", "events": [{ "chunk": 1, "chunkCount": 2 }], "outcome": "gap" },
      { "id": "zero-chunk-count-is-an-envelope-fault", "events": [{ "chunk": 0, "chunkCount": 0 }], "outcome": "envelope" },
      { "id": "chunk-beyond-its-count-is-an-envelope-fault", "events": [{ "chunk": 2, "chunkCount": 2 }], "outcome": "envelope" }
    ]
  },
  "faultCodes": {
    "envelope": "generation3d-import-envelope",
    "chunk": "generation3d-import-chunk",
    "gap": "generation3d-import-gap",
    "capacity": "generation3d-import-capacity"
  },
  "dataUrl": {
    "note": "`RequestFileOpen { read_as: \"dataUrl\" }` answers with a base64 data URL. A shell that answers with raw text instead is read as its own UTF-8 bytes, which is what every headless harness sends.",
    "cases": [
      { "id": "base64-data-url", "payload": "data:model/stl;base64,aGVsbG8=", "bytes": "hello" },
      { "id": "plain-data-url", "payload": "data:text/plain,hello", "bytes": "hello" },
      { "id": "raw-text", "payload": "hello", "bytes": "hello" }
    ]
  }
}
