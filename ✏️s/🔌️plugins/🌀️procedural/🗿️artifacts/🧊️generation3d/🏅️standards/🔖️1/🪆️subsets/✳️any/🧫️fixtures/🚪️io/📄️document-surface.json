{
  "schema": "generation3d.document-io-surface.v1",
  "note": "The USER-FACING law of this artifact's IO. `📓️io-codecs-2026-09-09.md` proved the nine leaves round-trip; `📓️audit-user-journey-gaps-2026-09-13.md` §6 found that nothing in the editor or the viewer named them, so a user could not import or export anything. This fixture states what the surface must offer: which formats the export picker lists, which extensions the file picker accepts, what filename and MIME each download carries, which leaves are deliberately withheld from import and why, and how one picked file is cut into the chunks the public-invocation envelope admits. Language-agnostic: an implementation in any language must publish the same roster, build the same download envelope and cut the same chunks. Rust drives these rows against the real `document_io` module and the real app manifests; the TypeScript twin re-derives every one of them from this file's own prose without importing the Rust implementation.",
  "artifactKind": "s.procedural.generation3d",
  "exportFormats": [
    { "id": "stl", "labelEn": "STL Mesh", "labelDe": "STL-Netz", "kindId": "s.stdio.stl.standard.ascii.representation.document", "extension": ".stl", "mime": "model/stl", "binary": true, "filename": "generation3d.stl", "geometry": true },
    { "id": "obj", "labelEn": "OBJ Mesh", "labelDe": "OBJ-Netz", "kindId": "s.stdio.obj.standard.3-0.representation.document", "extension": ".obj", "mime": "model/obj", "binary": false, "filename": "generation3d.obj", "geometry": true },
    { "id": "ply", "labelEn": "PLY Mesh", "labelDe": "PLY-Netz", "kindId": "s.stdio.ply.standard.1-0.representation.document", "extension": ".ply", "mime": "model/ply", "binary": false, "filename": "generation3d.ply", "geometry": true },
    { "id": "gltf", "labelEn": "glTF Mesh", "labelDe": "glTF-Netz", "kindId": "s.stdio.gltf.standard.2-0.representation.document", "extension": ".gltf", "mime": "model/gltf+json", "binary": false, "filename": "generation3d.gltf", "geometry": true },
    { "id": "las", "labelEn": "LAS Point Cloud", "labelDe": "LAS-Punktwolke", "kindId": "s.stdio.las.standard.1-0.representation.document", "extension": ".las", "mime": "application/vnd.las", "binary": true, "filename": "generation3d.las", "geometry": true },
    { "id": "dwg", "labelEn": "DWG Drawing", "labelDe": "DWG-Zeichnung", "kindId": "s.stdio.dwg.standard.ac1018.representation.document", "extension": ".dwg", "mime": "image/vnd.dwg", "binary": true, "filename": "generation3d.dwg", "geometry": true },
    { "id": "txt", "labelEn": "Semio Text (whole document)", "labelDe": "Semio-Text (ganzes Dokument)", "kindId": "s.stdio.txt.standard.utf-8.representation.document", "extension": ".txt", "mime": "text/plain", "binary": false, "filename": "generation3d.txt", "geometry": false }
  ],
  "importFormats": [
