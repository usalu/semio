  "properties":{
    "version":{"const":1},
    "widgets":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["id","kind","params"],"properties":{"id":{"type":"string","minLength":1},"kind":{"enum":["brep.curve.circle","brep.curve.ellipse","brep.evaluate.curvePoint"]},"params":{"type":"object","additionalProperties":false,"properties":{"center":{"$ref":"#/definitions/triple"},"normal":{"$ref":"#/definitions/triple"},"radius":{"type":"number","exclusiveMinimum":0},"semiMajor":{"type":"number","exclusiveMinimum":0},"semiMinor":{"type":"number","exclusiveMinimum":0},"parameter":{"type":"number","minimum":0}}}}}},
