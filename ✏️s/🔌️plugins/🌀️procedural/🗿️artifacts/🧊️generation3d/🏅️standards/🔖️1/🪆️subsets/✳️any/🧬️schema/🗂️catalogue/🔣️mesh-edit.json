    {
      "id": "mesh.edit.difference",
      "category": "mesh.edit",
      "emoji": "➖️",
      "label": {
        "en": "Subtract meshes",
        "de": "Netze subtrahieren"
      },
      "description": {
        "en": "Removes the volume of a closed convex tool from a closed convex mesh for a face cut, a corner cut, an opposing slab, a four-wall through tunnel, a blind pocket, or an enclosed cavity. A slab can leave separate shells, and full coverage yields an empty mesh.",
        "de": "Entfernt das Volumen eines geschlossenen konvexen Werkzeugs aus einem geschlossenen konvexen Netz bei einem Flächen- oder Eckenschnitt, einer Platte, einem Durchgang mit vier Wänden, einer blinden Tasche oder einem geschlossenen Hohlraum. Eine Platte kann getrennte Schalen hinterlassen, und eine vollständige Überdeckung ergibt ein leeres Netz."
      },
      "inputs": [
        {
          "name": "first",
          "label": {
            "en": "Stock mesh",
            "de": "Ausgangsnetz"
          },
          "description": {
            "en": "The closed convex mesh to cut.",
            "de": "Das geschlossene konvexe Netz, das geschnitten wird."
          },
          "type": "mesh"
        },
        {
          "name": "second",
          "label": {
            "en": "Tool mesh",
            "de": "Werkzeugnetz"
          },
          "description": {
            "en": "A closed convex mesh defining the volume to remove.",
            "de": "Ein geschlossenes konvexes Netz, das das zu entfernende Volumen festlegt."
          },
          "type": "mesh"
        }
      ],
      "outputs": [
        {
          "name": "mesh",
          "label": {
            "en": "Mesh",
            "de": "Netz"
          },
          "description": {
            "en": "The remaining part of the stock mesh.",
            "de": "Der verbleibende Teil des Ausgangsnetzes."
          },
          "type": "mesh"
        }
      ],
      "quality": "polygon-mesh",
      "preview": true
    },
