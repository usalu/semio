{
  "category": {
    "id": "mesh.edit",
    "emoji": "✏️",
    "order": 240,
    "label": {
      "en": "Mesh editing",
      "de": "Netzbearbeitung"
    },
    "description": {
      "en": "Modeling operations on selected edges, vertices and faces: bevel, cut, extrude, inset, subdivide, flip and delete.",
      "de": "Modellieroperationen auf ausgewählten Kanten, Eckpunkten und Flächen: Abschrägen, Schneiden, Extrudieren, Einsetzen, Unterteilen, Umkehren und Löschen."
    }
  },
  "kinds": [
    {
      "id": "mesh.edit.bevel",
      "category": "mesh.edit",
      "emoji": "🔶️",
      "label": {
        "en": "Bevel edges",
        "de": "Kanten abschrägen"
      },
      "description": {
        "en": "Rounds the selected edges of a closed convex mesh with several profile segments.",
        "de": "Rundet die ausgewählten Kanten eines geschlossenen konvexen Netzes mit mehreren Profilsegmenten ab."
      },
      "inputs": [
        {
          "name": "mesh",
          "label": {
            "en": "Mesh",
            "de": "Netz"
          },
          "description": {
            "en": "The polygon mesh to edit.",
            "de": "Das zu bearbeitende Polygonnetz."
          },
          "type": "mesh"
        },
        {
          "name": "edges",
          "label": {
            "en": "Edges",
            "de": "Kanten"
          },
          "description": {
            "en": "The edges to bevel.",
            "de": "Die abzuschrägenden Kanten."
          },
          "type": "selection",
          "selection": {
            "component": "edge",
            "source": "mesh",
            "multiple": true
          },
          "minItems": 1,
          "default": [
            0
          ]
        },
        {
          "name": "amount",
          "label": {
            "en": "Width",
            "de": "Breite"
          },
          "description": {
            "en": "Width of the bevel; it must not reach past neighbouring vertices.",
            "de": "Breite der Abschrägung; sie darf nicht über benachbarte Eckpunkte hinausreichen."
          },
          "type": "length",
          "default": 0.1,
          "min": 0,
          "exclusiveMin": true,
          "step": 0.1
        },
        {
          "name": "segments",
          "label": {
            "en": "Segments",
            "de": "Segmente"
          },
          "description": {
            "en": "Number of segments in the bevel profile.",
            "de": "Anzahl der Segmente im Abschrägungsprofil."
          },
          "type": "integer",
          "default": 1,
          "min": 1,
          "max": 64,
          "step": 1
        }
      ],
      "outputs": [
        {
          "name": "mesh",
          "label": {
            "en": "Mesh",
            "de": "Netz"
          },
          "description": {
            "en": "The bevelled mesh.",
            "de": "Das abgeschrägte Netz."
          },
          "type": "mesh"
        }
      ],
      "quality": "polygon-mesh",
      "interaction": {
        "pick": [
          {
            "component": "mesh",
            "port": "mesh"
          },
          {
            "component": "edge",
            "port": "edges"
          }
        ]
      },
      "preview": true
    },
