      "outputs": [
        {
          "name": "mesh",
          "label": {
            "en": "Mesh",
            "de": "Netz"
          },
          "description": {
            "en": "The polygon mesh enclosing the shared volume.",
            "de": "Das Polygonnetz, das das gemeinsame Volumen umschließt."
