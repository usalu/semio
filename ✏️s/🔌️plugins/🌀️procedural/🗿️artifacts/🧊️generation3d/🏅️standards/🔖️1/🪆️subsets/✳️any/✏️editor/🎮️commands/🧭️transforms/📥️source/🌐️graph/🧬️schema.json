{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "base",
    "rows",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "base": {
      "type": "object"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "created",
          "updated",
          "rewired",
          "links",
          "widgets",
          "previews",
          "wires"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "created": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "updated": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "rewired": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "widgets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "previews": {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          },
          "wires": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
