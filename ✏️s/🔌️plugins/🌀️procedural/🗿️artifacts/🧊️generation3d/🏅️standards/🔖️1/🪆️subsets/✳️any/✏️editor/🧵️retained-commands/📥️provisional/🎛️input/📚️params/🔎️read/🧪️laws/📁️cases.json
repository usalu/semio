    ]
  },
  {
    "name": "Vector Schema Is Deliberately Ignored",
    "kind": "vector",
    "key": "offset",
    "fallback": [
      0,
      0,
      0
    ],
    "params": {
      "offset": {
        "$schema": "other",
        "x": 1.5,
        "y": 2.5,
        "z": 3.5
      }
    },
    "expected": [
      1.5,
      2.5,
      3.5
    ]
  },
  {
    "name": "Untyped Root Uses Fallback",
    "kind": "vector",
    "key": "axis",
    "fallback": [
      0,
      0,
      1
    ],
    "params": {
      "axis": 5
    },
    "expected": [
      0,
      0,
      1
    ]
  },
  {
    "name": "Scale Missing Lanes Retain Ones",
