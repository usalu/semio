  "kinds": [
    {
      "id": "mesh.component.moveVertices",
      "category": "mesh.component",
      "emoji": "📍️",
      "label": {
        "en": "Move vertices",
        "de": "Eckpunkte verschieben"
      },
      "description": {
        "en": "Moves the selected vertices by an offset vector.",
        "de": "Verschiebt die ausgewählten Eckpunkte um einen Versatzvektor."
      },
      "inputs": [
        {
          "name": "mesh",
          "label": {
            "en": "Mesh",
            "de": "Netz"
          },
          "description": {
            "en": "The polygon mesh to edit.",
            "de": "Das zu bearbeitende Polygonnetz."
          },
          "type": "mesh"
        },
        {
          "name": "vertices",
          "label": {
            "en": "Vertices",
            "de": "Eckpunkte"
          },
          "description": {
            "en": "The vertices to move.",
            "de": "Die zu verschiebenden Eckpunkte."
          },
          "type": "selection",
          "selection": {
            "component": "vertex",
            "source": "mesh",
            "multiple": true
          },
          "minItems": 1,
          "default": [
            0
          ]
        },
        {
          "name": "offset",
          "label": {
            "en": "Offset",
            "de": "Verschiebung"
          },
          "description": {
            "en": "Displacement along each axis.",
            "de": "Verschiebung entlang jeder Achse."
          },
          "type": "vector",
          "default": [
            0,
            0,
            1
          ]
        }
      ],
      "outputs": [
        {
          "name": "mesh",
          "label": {
            "en": "Mesh",
            "de": "Netz"
          },
          "description": {
            "en": "The mesh with moved vertices.",
            "de": "Das Netz mit verschobenen Eckpunkten."
          },
          "type": "mesh"
        }
      ],
      "quality": "polygon-mesh",
      "interaction": {
        "pick": [
          {
            "component": "mesh",
            "port": "mesh"
          },
          {
            "component": "vertex",
            "port": "vertices"
          }
        ],
        "gumball": [
          {
            "motion": "translate",
            "port": "offset"
          }
        ]
      },
      "preview": true
    },
