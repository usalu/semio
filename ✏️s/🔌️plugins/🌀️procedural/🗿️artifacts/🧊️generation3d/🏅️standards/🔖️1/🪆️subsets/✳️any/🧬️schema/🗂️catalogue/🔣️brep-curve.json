      ],
      "outputs": [
        {
          "name": "shape",
          "label": {
            "en": "Curve",
            "de": "Kurve"
          },
          "description": {
            "en": "The circle as a closed curve.",
            "de": "Der Kreis als geschlossene Kurve."
          },
          "type": "shape",
          "shapeKinds": [
            "curve"
          ]
        }
      ],
      "quality": "exact-analytic",
      "preview": true
    },
    {
      "id": "brep.curve.arc",
      "category": "brep.curve",
      "emoji": "🌙️",
      "label": {
        "en": "Arc",
        "de": "Kreisbogen"
      },
      "description": {
        "en": "Creates a circular arc between a start and an end angle.",
        "de": "Erzeugt einen Kreisbogen zwischen einem Start- und einem Endwinkel."
      },
      "inputs": [
        {
          "name": "center",
          "label": {
            "en": "Center",
            "de": "Mittelpunkt"
          },
          "description": {
            "en": "Center point.",
            "de": "Mittelpunkt."
          },
          "type": "point",
          "default": [
            0,
            0,
            0
          ]
        },
        {
          "name": "normal",
          "label": {
            "en": "Normal",
            "de": "Normale"
          },
          "description": {
            "en": "Normal of the plane that contains the shape.",
            "de": "Normale der Ebene, in der die Form liegt."
          },
          "type": "vector",
          "default": [
            0,
            0,
            1
          ]
        },
        {
          "name": "radius",
          "label": {
            "en": "Radius",
            "de": "Radius"
          },
          "description": {
            "en": "Distance from the center to the outline.",
            "de": "Abstand vom Mittelpunkt zum Rand."
          },
          "type": "length",
          "default": 1,
          "min": 0,
          "exclusiveMin": true,
          "step": 0.1
        },
        {
          "name": "startAngle",
          "label": {
            "en": "Start angle",
            "de": "Startwinkel"
          },
          "description": {
            "en": "Angle at which the arc begins, measured counter-clockwise from the local X axis (the world X axis projected into the plane; the world Y axis when the normal lies along X).",
            "de": "Winkel, bei dem der Bogen beginnt, gegen den Uhrzeigersinn gemessen von der lokalen X-Achse (die in die Ebene projizierte Welt-X-Achse; die Welt-Y-Achse, wenn die Normale entlang X liegt)."
          },
          "type": "angle",
          "default": 0,
          "step": 0.017453292519943295,
          "unit": "rad"
        },
        {
          "name": "endAngle",
          "label": {
            "en": "End angle",
            "de": "Endwinkel"
          },
          "description": {
            "en": "Angle at which the arc ends; must differ from the start angle. The arc runs counter-clockwise, so an end angle below the start angle continues past a full turn.",
            "de": "Winkel, bei dem der Bogen endet; muss vom Startwinkel abweichen. Der Bogen läuft gegen den Uhrzeigersinn, ein Endwinkel unter dem Startwinkel führt daher über die volle Drehung hinaus."
          },
          "type": "angle",
          "default": 1.5707963267948966,
          "step": 0.017453292519943295,
          "unit": "rad"
        }
      ],
      "outputs": [
        {
          "name": "shape",
          "label": {
            "en": "Curve",
            "de": "Kurve"
          },
          "description": {
            "en": "The arc as a curve.",
            "de": "Der Kreisbogen als Kurve."
          },
          "type": "shape",
          "shapeKinds": [
            "curve"
          ]
        }
      ],
      "quality": "exact-analytic",
      "preview": true
    },
