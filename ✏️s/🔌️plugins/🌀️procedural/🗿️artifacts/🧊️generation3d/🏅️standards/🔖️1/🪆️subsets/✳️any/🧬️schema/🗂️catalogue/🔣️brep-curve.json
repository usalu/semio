    {
      "id": "brep.curve.circle",
      "category": "brep.curve",
      "emoji": "⭕️",
      "label": {
        "en": "Circle",
        "de": "Kreis"
      },
      "description": {
        "en": "Creates a full circle around a center in the plane given by its normal.",
        "de": "Erzeugt einen Vollkreis um einen Mittelpunkt in der durch die Normale gegebenen Ebene."
      },
      "inputs": [
        {
          "name": "center",
          "label": {
            "en": "Center",
            "de": "Mittelpunkt"
          },
          "description": {
            "en": "Center point.",
            "de": "Mittelpunkt."
          },
          "type": "point",
          "default": [
            0,
            0,
            0
          ]
        },
        {
          "name": "normal",
          "label": {
            "en": "Normal",
            "de": "Normale"
          },
          "description": {
            "en": "Normal of the plane that contains the shape.",
            "de": "Normale der Ebene, in der die Form liegt."
          },
          "type": "vector",
          "default": [
            0,
            0,
            1
          ]
        },
        {
          "name": "radius",
          "label": {
            "en": "Radius",
            "de": "Radius"
          },
          "description": {
            "en": "Distance from the center to the outline.",
            "de": "Abstand vom Mittelpunkt zum Rand."
