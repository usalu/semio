    {"name": "polygon of two sides", "kind": "brep.curve.polygon", "inputs": {"radius": 2, "sides": 2}, "fault": {"code": "generation3d.geometry.degenerate-size", "port": "sides"}},
    {"name": "interpolated cubic through four points", "kind": "brep.curve.interpolate", "inputs": {"points": [[0, 0, 0], [1, 1, 0], [2, 0, 0], [3, 1, 0]], "degree": 3}, "outputs": {"shape": {"kind": "curve", "start": [0, 0, 0], "end": [3, 1, 0], "through": [[0, 0, 0], [1, 1, 0], [2, 0, 0], [3, 1, 0]], "length": 4.767890925875383}}, "tolerance": 0.0001},
    {"name": "interpolated line through two points", "kind": "brep.curve.interpolate", "inputs": {"points": [[0, 0, 0], [2, 0, 0]], "degree": 1}, "outputs": {"shape": {"kind": "curve", "length": 2, "start": [0, 0, 0], "end": [2, 0, 0]}}},
    {"name": "interpolation of degree four through four points", "kind": "brep.curve.interpolate", "inputs": {"points": [[0, 0, 0], [1, 1, 0], [2, 0, 0], [3, 1, 0]], "degree": 4}, "fault": {"code": "generation3d.geometry.degree-points", "port": "degree"}},
    {"name": "approximation with four control points", "kind": "brep.curve.approximate", "inputs": {"points": [[0, 0, 0], [1, 1, 0], [2, 0, 0], [3, 1, 0], [4, 0, 0]], "degree": 3, "controlPoints": 4}, "outputs": {"shape": {"kind": "curve", "start": [0, 0, 0], "end": [4, 0, 0], "length": 4.3109336470132575}}, "tolerance": 0.0001},
    {"name": "approximation with too few control points", "kind": "brep.curve.approximate", "inputs": {"points": [[0, 0, 0], [1, 1, 0], [2, 0, 0], [3, 1, 0], [4, 0, 0]], "degree": 3, "controlPoints": 3}, "fault": {"code": "generation3d.geometry.degree-points", "port": "controlPoints"}},
    {"name": "one turn of a helix", "kind": "brep.curve.helix", "inputs": {"origin": [0, 0, 0], "axis": [0, 0, 1], "radius": 1, "pitch": 1, "turns": 1}, "outputs": {"shape": {"kind": "wire", "closed": false, "length": 6.352302396311437, "start": [1, 0, 0], "end": [1, 0, 1], "bbox": [[-1, -1, 0], [1, 1, 1]]}}},
    {"name": "helix without pitch", "kind": "brep.curve.helix", "inputs": {"origin": [0, 0, 0], "axis": [0, 0, 1], "radius": 1, "pitch": 0, "turns": 1}, "fault": {"code": "generation3d.geometry.degenerate-size", "port": "pitch"}}
  ]
}
