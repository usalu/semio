{
  "description": "Language-agnostic laws of the brep.curve widgets. A shape output is checked by its kind and by the measures it states: length, closed, start and end points, bounding box and points the spline passes through. TypeScript recomputes every measure with three's curves (LineCurve3, EllipseCurve, CatmullRomCurve3) and plain polyline sums as independent oracles; Rust measures the kernel's exported value by sampling its curves.",
  "tolerance": 1e-06,
  "cases": [
    {"name": "line", "kind": "brep.curve.line", "inputs": {"start": [0, 0, 0], "end": [3, 4, 0]}, "outputs": {"shape": {"kind": "curve", "length": 5, "start": [0, 0, 0], "end": [3, 4, 0], "bbox": [[0, 0, 0], [3, 4, 0]]}}},
    {"name": "line with equal ends", "kind": "brep.curve.line", "inputs": {"start": [1, 1, 1], "end": [1, 1, 1]}, "fault": {"code": "generation3d.geometry.degenerate-curve", "port": "end"}},
    {"name": "circle", "kind": "brep.curve.circle", "inputs": {"center": [1, 2, 3], "normal": [0, 0, 1], "radius": 2}, "outputs": {"shape": {"kind": "curve", "length": 12.566370614359172, "bbox": [[-1, 0, 3], [3, 4, 3]]}}},
    {"name": "circle in a tilted plane", "kind": "brep.curve.circle", "inputs": {"center": [0, 0, 0], "normal": [0, 1, 0], "radius": 1}, "outputs": {"shape": {"kind": "curve", "length": 6.283185307179586, "bbox": [[-1, 0, -1], [1, 0, 1]]}}},
    {"name": "circle without radius", "kind": "brep.curve.circle", "inputs": {"center": [0, 0, 0], "normal": [0, 0, 1], "radius": 0}, "fault": {"code": "generation3d.geometry.degenerate-size", "port": "radius"}},
    {"name": "circle without a normal", "kind": "brep.curve.circle", "inputs": {"center": [0, 0, 0], "normal": [0, 0, 0], "radius": 1}, "fault": {"code": "generation3d.geometry.degenerate-direction", "port": "normal"}},
    {"name": "quarter arc", "kind": "brep.curve.arc", "inputs": {"center": [0, 0, 0], "normal": [0, 0, 1], "radius": 2, "startAngle": 0, "endAngle": 1.5707963267948966}, "outputs": {"shape": {"kind": "curve", "length": 3.141592653589793, "start": [2, 0, 0], "end": [0, 2, 0], "bbox": [[0, 0, 0], [2, 2, 0]]}}},
    {"name": "arc whose end angle lies below its start angle runs counter-clockwise", "kind": "brep.curve.arc", "inputs": {"center": [0, 0, 0], "normal": [0, 0, 1], "radius": 1, "startAngle": 1.5707963267948966, "endAngle": 0}, "outputs": {"shape": {"kind": "curve", "length": 4.71238898038469, "start": [0, 1, 0], "end": [1, 0, 0], "bbox": [[-1, -1, 0], [1, 1, 0]]}}},
    {"name": "arc with equal angles", "kind": "brep.curve.arc", "inputs": {"center": [0, 0, 0], "normal": [0, 0, 1], "radius": 1, "startAngle": 1, "endAngle": 1}, "fault": {"code": "generation3d.geometry.degenerate-curve", "port": "endAngle"}},
    {"name": "arc over more than a turn", "kind": "brep.curve.arc", "inputs": {"center": [0, 0, 0], "normal": [0, 0, 1], "radius": 1, "startAngle": 0, "endAngle": 7}, "fault": {"code": "generation3d.geometry.arc-span", "port": "endAngle"}},
    {"name": "ellipse", "kind": "brep.curve.ellipse", "inputs": {"center": [0, 0, 0], "normal": [0, 0, 1], "semiMajor": 3, "semiMinor": 1}, "outputs": {"shape": {"kind": "curve", "length": 13.364893220555254, "bbox": [[-3, -1, 0], [3, 1, 0]]}}, "tolerance": 1e-05},
    {"name": "ellipse in a plane with a normal along X", "kind": "brep.curve.ellipse", "inputs": {"center": [0, 0, 0], "normal": [1, 0, 0], "semiMajor": 3, "semiMinor": 1}, "outputs": {"shape": {"kind": "curve", "length": 13.364893220555254, "bbox": [[0, -3, -1], [0, 3, 1]]}}, "tolerance": 1e-05},
    {"name": "ellipse without a minor axis", "kind": "brep.curve.ellipse", "inputs": {"center": [0, 0, 0], "normal": [0, 0, 1], "semiMajor": 3, "semiMinor": 0}, "fault": {"code": "generation3d.geometry.degenerate-size", "port": "semiMinor"}},
    {"name": "open polyline", "kind": "brep.curve.polyline", "inputs": {"points": [[0, 0, 0], [1, 0, 0], [1, 1, 0]]}, "outputs": {"shape": {"kind": "wire", "closed": false, "length": 2, "start": [0, 0, 0], "end": [1, 1, 0], "bbox": [[0, 0, 0], [1, 1, 0]]}}},
