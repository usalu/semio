{
  "description": "Language-agnostic laws of the math.vector geometry widgets. Vectors and points are [x, y, z] arrays, planes are { origin, normal } with a unit normal. Outputs match to `tolerance` (absolute, relative above magnitude one). Rust and TypeScript run the same cases; TypeScript recomputes every outcome with three's Vector3 and Plane.",
  "tolerance": 1e-12,
  "angleTolerance": 1e-7,
  "cases": [
    { "name": "vector from components", "kind": "math.vectorFromComponents", "inputs": { "x": 1, "y": -2, "z": 3.5 }, "outputs": { "vector": [1, -2, 3.5] } },
    { "name": "point from components", "kind": "math.pointFromComponents", "inputs": { "x": 4, "y": 5, "z": -6 }, "outputs": { "point": [4, 5, -6] } },
    { "name": "vector components", "kind": "math.vectorComponents", "inputs": { "vector": [4, 5, 6] }, "outputs": { "x": 4, "y": 5, "z": 6 } },
    { "name": "point components", "kind": "math.pointComponents", "inputs": { "point": [-1, 0.5, 2] }, "outputs": { "x": -1, "y": 0.5, "z": 2 } },
    { "name": "vector add", "kind": "math.vectorAdd", "inputs": { "a": [1, 2, 3], "b": [4, -5, 6] }, "outputs": { "vector": [5, -3, 9] } },
    { "name": "vector add overflows", "kind": "math.vectorAdd", "inputs": { "a": [1.7e308, 0, 0], "b": [1.7e308, 0, 0] }, "fault": { "code": "generation3d.geometry.math-overflow" } },
    { "name": "vector subtract", "kind": "math.vectorSubtract", "inputs": { "a": [1, 2, 3], "b": [4, -5, 6] }, "outputs": { "vector": [-3, 7, -3] } },
    { "name": "vector scale", "kind": "math.vectorScale", "inputs": { "vector": [1, 2, 3], "factor": -2 }, "outputs": { "vector": [-2, -4, -6] } },
    { "name": "vector scale by zero", "kind": "math.vectorScale", "inputs": { "vector": [1, 2, 3], "factor": 0 }, "outputs": { "vector": [0, 0, 0] } },
    { "name": "vector length pythagorean", "kind": "math.vectorLength", "inputs": { "vector": [3, 4, 12] }, "outputs": { "length": 13 } },
    { "name": "vector length of zero", "kind": "math.vectorLength", "inputs": { "vector": [0, 0, 0] }, "outputs": { "length": 0 } },
    { "name": "vector normalize", "kind": "math.vectorNormalize", "inputs": { "vector": [0, 3, 4] }, "outputs": { "vector": [0, 0.6, 0.8] } },
    { "name": "vector normalize of zero", "kind": "math.vectorNormalize", "inputs": { "vector": [0, 0, 0] }, "fault": { "code": "generation3d.geometry.zero-vector", "port": "vector" } },
    { "name": "vector dot", "kind": "math.vectorDot", "inputs": { "a": [1, 2, 3], "b": [4, -5, 6] }, "outputs": { "result": 12 } },
    { "name": "vector dot of perpendicular vectors", "kind": "math.vectorDot", "inputs": { "a": [1, 0, 0], "b": [0, 1, 0] }, "outputs": { "result": 0 } },
    { "name": "vector cross of the axes", "kind": "math.vectorCross", "inputs": { "a": [1, 0, 0], "b": [0, 1, 0] }, "outputs": { "vector": [0, 0, 1] } },
    { "name": "vector cross general", "kind": "math.vectorCross", "inputs": { "a": [1, 2, 3], "b": [4, 5, 6] }, "outputs": { "vector": [-3, 6, -3] } },
    { "name": "vector angle perpendicular", "kind": "math.vectorAngle", "inputs": { "a": [1, 0, 0], "b": [0, 1, 0] }, "outputs": { "angle": 1.5707963267948966 } },
    { "name": "vector angle opposite", "kind": "math.vectorAngle", "inputs": { "a": [1, 0, 0], "b": [-2, 0, 0] }, "outputs": { "angle": 3.141592653589793 } },
    { "name": "vector angle diagonal", "kind": "math.vectorAngle", "inputs": { "a": [1, 0, 0], "b": [3, 3, 0] }, "outputs": { "angle": 0.7853981633974483 } },
    { "name": "vector angle parallel", "kind": "math.vectorAngle", "inputs": { "a": [0, 2, 0], "b": [0, 5, 0] }, "outputs": { "angle": 0 } },
    { "name": "vector angle with a zero vector", "kind": "math.vectorAngle", "inputs": { "a": [0, 0, 0], "b": [1, 0, 0] }, "fault": { "code": "generation3d.geometry.zero-vector", "port": "a" } },
    { "name": "vector angle with a second zero vector", "kind": "math.vectorAngle", "inputs": { "a": [1, 0, 0], "b": [0, 0, 0] }, "fault": { "code": "generation3d.geometry.zero-vector", "port": "b" } },
    { "name": "point offset", "kind": "math.pointOffset", "inputs": { "point": [1, 1, 1], "offset": [0, 0, 2.5] }, "outputs": { "point": [1, 1, 3.5] } },
    { "name": "point distance", "kind": "math.pointDistance", "inputs": { "a": [0, 0, 0], "b": [1, 2, 2] }, "outputs": { "distance": 3 } },
    { "name": "point distance of equal points", "kind": "math.pointDistance", "inputs": { "a": [2, 2, 2], "b": [2, 2, 2] }, "outputs": { "distance": 0 } },
    { "name": "point interpolate quarter", "kind": "math.pointInterpolate", "inputs": { "a": [0, 0, 0], "b": [4, 8, -4], "t": 0.25 }, "outputs": { "point": [1, 2, -1] } },
    { "name": "point interpolate extrapolates", "kind": "math.pointInterpolate", "inputs": { "a": [1, 0, 0], "b": [2, 0, 0], "t": 2 }, "outputs": { "point": [3, 0, 0] } },
    { "name": "vector between", "kind": "math.vectorBetween", "inputs": { "from": [1, 2, 3], "to": [4, 6, 3] }, "outputs": { "vector": [3, 4, 0] } },
    { "name": "plane from point and normal", "kind": "math.planeFromPointNormal", "inputs": { "origin": [1, 2, 3], "normal": [0, 0, 5] }, "outputs": { "plane": { "origin": [1, 2, 3], "normal": [0, 0, 1] } } },
    { "name": "plane from point and a tilted normal", "kind": "math.planeFromPointNormal", "inputs": { "origin": [0, 0, 0], "normal": [0, 3, 4] }, "outputs": { "plane": { "origin": [0, 0, 0], "normal": [0, 0.6, 0.8] } } },
    { "name": "plane from point and a zero normal", "kind": "math.planeFromPointNormal", "inputs": { "origin": [0, 0, 0], "normal": [0, 0, 0] }, "fault": { "code": "generation3d.geometry.zero-vector", "port": "normal" } },
    { "name": "plane from three points", "kind": "math.planeFromPoints", "inputs": { "a": [0, 0, 0], "b": [1, 0, 0], "c": [0, 1, 0] }, "outputs": { "plane": { "origin": [0, 0, 0], "normal": [0, 0, 1] } } },
    { "name": "plane from three points keeps the winding", "kind": "math.planeFromPoints", "inputs": { "a": [0, 0, 2], "b": [0, 1, 2], "c": [1, 0, 2] }, "outputs": { "plane": { "origin": [0, 0, 2], "normal": [0, 0, -1] } } },
    { "name": "plane from three points on a line", "kind": "math.planeFromPoints", "inputs": { "a": [0, 0, 0], "b": [1, 1, 1], "c": [2, 2, 2] }, "fault": { "code": "generation3d.geometry.plane-degenerate", "port": "c" } },
    { "name": "plane from three equal points", "kind": "math.planeFromPoints", "inputs": { "a": [1, 1, 1], "b": [1, 1, 1], "c": [1, 1, 1] }, "fault": { "code": "generation3d.geometry.plane-degenerate", "port": "c" } },
    { "name": "plane components", "kind": "math.planeComponents", "inputs": { "plane": { "origin": [1, 2, 3], "normal": [0, 1, 0] } }, "outputs": { "origin": [1, 2, 3], "normal": [0, 1, 0] } }
  ]
}
