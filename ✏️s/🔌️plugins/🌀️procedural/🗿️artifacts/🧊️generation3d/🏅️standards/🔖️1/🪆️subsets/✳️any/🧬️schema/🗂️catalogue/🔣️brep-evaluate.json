    {
      "id": "brep.evaluate.curveClosestParameter",
      "category": "brep.evaluate",
      "emoji": "🎯️",
      "label": {
        "en": "Closest parameter on curve",
        "de": "Nächster Kurvenparameter"
      },
      "description": {
        "en": "Finds the parameter on a curve that is closest to a point.",
        "de": "Findet den Parameter auf einer Kurve, der einem Punkt am nächsten liegt."
      },
      "inputs": [
        {
          "name": "curve",
          "label": {
            "en": "Curve",
            "de": "Kurve"
          },
          "description": {
            "en": "The curve to evaluate.",
            "de": "Die auszuwertende Kurve."
          },
          "type": "shape",
          "shapeKinds": [
            "curve",
            "wire",
            "edge"
          ]
        },
        {
          "name": "point",
          "label": {
            "en": "Point",
            "de": "Punkt"
          },
          "description": {
            "en": "The point to measure from.",
            "de": "Der Punkt, von dem aus gemessen wird."
          },
          "type": "point",
          "default": [
            0,
            0,
            0
          ]
        }
      ],
      "outputs": [
        {
          "name": "parameter",
          "label": {
            "en": "Parameter",
            "de": "Parameter"
          },
          "description": {
            "en": "The curve parameter of the closest position.",
            "de": "Der Kurvenparameter der nächsten Position."
          },
          "type": "number"
        },
        {
          "name": "point",
          "label": {
            "en": "Closest point",
            "de": "Nächster Punkt"
          },
          "description": {
            "en": "The closest position on the curve.",
            "de": "Die nächste Position auf der Kurve."
          },
          "type": "point"
        },
        {
          "name": "distance",
          "label": {
            "en": "Distance",
            "de": "Abstand"
          },
          "description": {
            "en": "The achieved distance between the input point and the closest point.",
            "de": "Der erreichte Abstand zwischen dem Eingabepunkt und dem nächsten Punkt."
          },
          "type": "length"
        }
      ],
      "quality": "exact-numerical",
      "interaction": {
        "pick": [
          {
            "component": "edge",
            "port": "curve"
          },
          {
            "component": "shape",
            "port": "curve"
          }
        ]
      },
      "preview": false
    },
