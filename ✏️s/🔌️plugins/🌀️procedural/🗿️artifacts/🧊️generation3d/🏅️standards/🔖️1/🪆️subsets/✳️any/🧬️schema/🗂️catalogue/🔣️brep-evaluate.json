{
  "category": {
    "id": "brep.evaluate",
    "emoji": "🎯️",
    "order": 90,
    "label": {
      "en": "Evaluate curves and surfaces",
      "de": "Kurven und Flächen auswerten"
    },
    "description": {
      "en": "Read points, tangents, normals, curvature and closest positions from curves and surfaces.",
      "de": "Punkte, Tangenten, Normalen, Krümmung und nächste Positionen von Kurven und Flächen auslesen."
    }
  },
  "kinds": [
    {
      "id": "brep.evaluate.curvePoint",
      "category": "brep.evaluate",
      "emoji": "📍️",
      "label": {
        "en": "Point on curve",
        "de": "Punkt auf Kurve"
      },
      "description": {
        "en": "Evaluates the position on a curve at a parameter.",
        "de": "Berechnet die Position auf einer Kurve an einem Parameter."
      },
      "inputs": [
        {
          "name": "curve",
          "label": {
            "en": "Curve",
            "de": "Kurve"
          },
          "description": {
            "en": "The curve to evaluate.",
            "de": "Die auszuwertende Kurve."
          },
          "type": "shape",
          "shapeKinds": [
            "curve",
            "wire",
            "edge"
          ]
        },
        {
          "name": "parameter",
          "label": {
            "en": "Parameter",
            "de": "Parameter"
          },
          "description": {
            "en": "Position along the curve in its own parameter domain.",
            "de": "Position entlang der Kurve in ihrem eigenen Parameterbereich."
          },
          "type": "number",
          "default": 0,
          "step": 0.1
        }
      ],
      "outputs": [
        {
          "name": "point",
          "label": {
            "en": "Point",
            "de": "Punkt"
          },
          "description": {
            "en": "The position on the curve.",
            "de": "Die Position auf der Kurve."
          },
          "type": "point"
        }
      ],
      "quality": "exact-analytic",
      "interaction": {
        "pick": [
          {
            "component": "edge",
            "port": "curve"
          },
          {
            "component": "shape",
            "port": "curve"
          }
        ]
      },
      "preview": false
    },
