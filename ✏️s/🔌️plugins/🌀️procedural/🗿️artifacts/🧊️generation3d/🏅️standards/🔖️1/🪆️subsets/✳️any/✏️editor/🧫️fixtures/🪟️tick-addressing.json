{
  "format": "semio.generation3d.tick-addressing",
  "version": 1,
  "note": "The window address of the self-dispatched flowEvalTick chain, declared as data. `arming` is what Generation3dPlayApp::pending_effects may put on the wire for a given attached-window roster; `dispatch` is which of those addresses the retained route's own preflight admits. Language-agnostic: an implementation in any language must answer these exact rows.",
  "windowKinds": {
    "flow": "procedural-main",
    "preview": "procedural-preview",
    "generations": "generation3d-generations",
    "form": "generation3d-generate-form",
    "generatePreview": "generation3d-generate-preview"
  },
  "arming": [
    {
      "id": "no-surface-mounted",
      "attached": [],
      "armedWindowIds": [],
      "why": "Before the first SurfaceVisible there is no roster and no window transient to publish into — the chain waits instead of spinning an address that cannot land."
    },
    {
      "id": "flow-window-only",
      "attached": [
        {
          "id": "main",
          "kind": "flow"
        }
      ],
      "armedWindowIds": [],
      "why": "The flow window holds no evaluation publication; arming a tick it can only refuse is the served-app stall."
    },
    {
      "id": "flow-and-preview",
      "attached": [
        {
          "id": "main",
          "kind": "flow"
        },
        {
          "id": "preview",
          "kind": "preview"
        }
      ],
      "armedWindowIds": [
        "preview"
      ],
      "why": "The preview window owns the retained evaluation, so the tick names it — never the current window."
    },
    {
      "id": "two-previews",
      "attached": [
        {
          "id": "main",
          "kind": "flow"
        },
        {
          "id": "left",
          "kind": "preview"
        },
        {
          "id": "right",
          "kind": "preview"
        }
      ],
      "armedWindowIds": [
        "left",
        "right"
      ],
      "why": "Every preview window holds its OWN publication, so every one gets its own addressed chain."
    },
    {
      "id": "generate-preview-attached",
      "attached": [
        {
          "id": "generations",
          "kind": "generations"
        },
        {
          "id": "form",
          "kind": "form"
        },
        {
          "id": "generation3d-generate-preview",
          "kind": "generatePreview"
        }
      ],
      "armedWindowIds": [
        "generation3d-generate-preview"
      ],
      "why": "Generate preview owns the same retained evaluation chain as edit preview, addressed at its own window id."
    }
  ],
  "dispatch": [
    {
      "id": "unaddressed",
      "attached": [
        {
          "id": "main",
          "kind": "flow"
        },
        {
          "id": "preview",
          "kind": "preview"
        }
      ],
      "currentWindowId": "main",
      "payloadWindowId": "",
      "admitted": false,
      "why": "The defect: an Effect::DispatchAction carries no window, so the shell redispatches under the current window and the route refuses.",
      "payloadWindowKind": "preview"
    },
    {
      "id": "flow-window-addressed",
      "attached": [
        {
          "id": "main",
          "kind": "flow"
        },
        {
          "id": "preview",
          "kind": "preview"
        }
      ],
      "currentWindowId": "main",
      "payloadWindowId": "main",
      "admitted": false,
      "why": "An attached window of the wrong KIND is refused, not silently accepted.",
      "payloadWindowKind": "flow"
    },
    {
      "id": "preview-addressed-from-the-flow-window",
      "attached": [
        {
          "id": "main",
          "kind": "flow"
        },
        {
          "id": "preview",
          "kind": "preview"
        }
      ],
      "currentWindowId": "main",
      "payloadWindowId": "preview",
      "admitted": true,
      "why": "The fix: the payload names the preview window, so the runtime captures THAT window's transient authority while the shell stays focused on the flow window.",
      "payloadWindowKind": "preview"
    },
    {
      "id": "detached-window-addressed",
      "attached": [
        {
          "id": "main",
          "kind": "flow"
        },
        {
          "id": "preview",
          "kind": "preview"
        }
      ],
      "currentWindowId": "main",
      "payloadWindowId": "closed-preview",
      "admitted": false,
      "why": "A window that left the roster fails closed — the chain ends and the next refresh re-arms it, rather than spinning.",
      "payloadWindowKind": "preview"
    },
    {
      "id": "generate-preview-addressed-from-generations",
      "attached": [
        {
          "id": "generations",
          "kind": "generations"
        },
        {
          "id": "form",
          "kind": "form"
        },
        {
          "id": "generation3d-generate-preview",
          "kind": "generatePreview"
        }
      ],
      "currentWindowId": "generations",
      "payloadWindowId": "generation3d-generate-preview",
      "payloadWindowKind": "generatePreview",
      "admitted": true,
      "why": "The generate preview tick is window-scoped: the payload names generation3d-generate-preview while the shell stays on the generations list."
    }
  ]
}
