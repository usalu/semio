{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://generation3d/preview/reply-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "source",
    "valid",
    "faultFirst",
    "sourceHeldOnDenial",
    "sourceClosedOnFailure",
    "terminalDropBytes"
  ],
  "properties": {
    "action": {
      "enum": [
        "flowEvalResolve",
        "flowTessellateResolve",
        "flowTessellateCancelResolve"
      ]
    },
    "source": {},
    "valid": {
      "type": "boolean"
    },
    "faultFirst": {
      "const": true
    },
    "sourceHeldOnDenial": {
      "const": true
    },
    "sourceClosedOnFailure": {
      "const": true
    },
    "terminalDropBytes": {
      "const": 0
    }
  }
}
