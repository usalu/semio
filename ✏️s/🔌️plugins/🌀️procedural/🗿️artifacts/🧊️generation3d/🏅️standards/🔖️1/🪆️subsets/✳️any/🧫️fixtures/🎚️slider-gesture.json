        { "operations": [{ "operation": "setSlider", "widgetId": "height", "value": 7.5, "gesture": "g1", "commit": false }] },
        { "operations": [{ "operation": "setSlider", "widgetId": "height", "value": 9.0, "gesture": "g1", "commit": true }] }
