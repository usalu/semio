semio procedural.generation3d.dsl v1
schema="flow.fixture"
camera {
  x=120 y=-60 zoom=2.2
}
layout={
  rect=x=60 y=-60 face=x=200 y=-60 extrude=x=340 y=-60 height=x=60 y=-100 width=x=60 y=-120
}
synapses [id:TEXT wire:WIRE] {
  e1 width@number->rect@width
  e2 height@number->rect@height
  e3 rect@wire->face@wire
  e4 face@face->extrude@face
  e5 distance@number->vector@z
  e6 vector@vector->extrude@vector
}
generations [id:TEXT name:TEXT values:VAL] {
}
widgets {
  input-slider id="width" label="Width" value=2 min=0.5 max=6 step=0.1
  input-slider id="height" label="Height" value=1.5 min=0.5 max=6 step=0.1
  input-slider id="distance" label="Extrusion Distance" value=4 min=0.5 max=10 step=0.1
  neuron id="rect" neuron-kind=brep.curve.rectangle preview=false input-ports=[ "width" "height" ] output-ports=[ ] params=[ ]
  neuron id="face" neuron-kind=brep.surf.planarFaceWire preview=false input-ports=[ "wire" ] output-ports=[ ] params=[ ]
  neuron id="vector" neuron-kind=math.vector preview=false input-ports=[ "x" "y" "z" ] output-ports=[ ] params=[ ]
  neuron id="extrude" neuron-kind=brep.sweep.extrude preview=true input-ports=[ "face" "vector" ] output-ports=[ ] params=[ ]
}
