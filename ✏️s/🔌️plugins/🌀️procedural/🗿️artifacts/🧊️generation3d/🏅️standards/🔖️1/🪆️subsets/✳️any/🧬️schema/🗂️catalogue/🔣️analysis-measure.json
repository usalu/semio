            "de": "Der erste Operand."
          },
          "type": "shape"
        },
        {
          "name": "b",
          "label": {
            "en": "Shape B",
            "de": "Form B"
          },
          "description": {
            "en": "The second operand.",
            "de": "Der zweite Operand."
          },
          "type": "shape"
        }
      ],
      "outputs": [
        {
          "name": "distance",
          "label": {
            "en": "Distance",
            "de": "Abstand"
