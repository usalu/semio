          },
          "description": {
            "en": "The first planar face or straight edge.",
            "de": "Die erste ebene Fläche oder gerade Kante."
          },
          "type": "shape",
          "shapeKinds": [
            "face",
            "edge"
          ]
        },
        {
          "name": "b",
          "label": {
            "en": "Second",
            "de": "Zweites"
          },
          "description": {
            "en": "The second planar face or straight edge.",
            "de": "Die zweite ebene Fläche oder gerade Kante."
          },
          "type": "shape",
          "shapeKinds": [
            "face",
            "edge"
          ]
        }
      ],
      "outputs": [
        {
          "name": "angle",
          "label": {
            "en": "Angle",
            "de": "Winkel"
          },
          "description": {
            "en": "The angle between the two, from 0 to 180 degrees.",
            "de": "Der Winkel zwischen beiden, von 0 bis 180 Grad."
          },
          "type": "angle"
        }
      ],
      "quality": "exact-analytic",
      "interaction": {
        "pick": [
          {
            "component": "face",
            "port": "a"
          },
          {
            "component": "edge",
            "port": "a"
          }
        ]
      },
      "preview": false
    },
    {
      "id": "analysis.selectionArea",
      "category": "analysis.measure",
      "emoji": "🔲️",
      "label": {
        "en": "Area of selection",
        "de": "Fläche der Auswahl"
      },
      "description": {
        "en": "Adds up the area of the selected faces.",
        "de": "Summiert den Flächeninhalt der ausgewählten Flächen."
      },
      "inputs": [
        {
          "name": "shape",
          "label": {
            "en": "Shape",
            "de": "Form"
          },
          "description": {
            "en": "The shape to operate on.",
            "de": "Die Form, auf die der Vorgang angewendet wird."
          },
          "type": "shape"
        },
        {
          "name": "faces",
          "label": {
            "en": "Faces",
            "de": "Flächen"
          },
          "description": {
            "en": "The faces to measure.",
            "de": "Die zu messenden Flächen."
          },
          "type": "selection",
          "selection": {
            "component": "face",
            "source": "shape",
            "multiple": true
          },
          "minItems": 1,
          "default": []
        }
      ],
      "outputs": [
        {
          "name": "area",
          "label": {
            "en": "Area",
            "de": "Flächeninhalt"
          },
          "description": {
            "en": "The combined area of the selected faces.",
            "de": "Der gemeinsame Flächeninhalt der gewählten Flächen."
          },
          "type": "number",
          "unit": "length²"
        }
      ],
      "quality": "exact-numerical",
      "interaction": {
        "pick": [
          {
            "component": "shape",
            "port": "shape"
          },
          {
            "component": "face",
            "port": "faces"
          }
        ]
      },
      "preview": false
    }
  ]
