  "kinds": [
    {
      "id": "analysis.volume",
      "category": "analysis.measure",
      "emoji": "🧊️",
      "label": {
        "en": "Volume",
        "de": "Volumen"
      },
      "description": {
        "en": "Measures the volume enclosed by a solid.",
        "de": "Misst das von einem Körper eingeschlossene Volumen."
      },
      "inputs": [
        {
          "name": "solid",
          "label": {
            "en": "Solid",
            "de": "Körper"
          },
          "description": {
            "en": "The solid to operate on.",
            "de": "Der Körper, auf den der Vorgang angewendet wird."
          },
          "type": "shape",
          "shapeKinds": [
            "solid",
            "compound"
          ]
        }
      ],
      "outputs": [
        {
          "name": "volume",
          "label": {
            "en": "Volume",
            "de": "Volumen"
          },
          "description": {
            "en": "The enclosed volume.",
            "de": "Das eingeschlossene Volumen."
          },
          "type": "number",
          "unit": "length³"
        }
      ],
      "quality": "exact-numerical",
      "interaction": {
        "pick": [
          {
            "component": "shape",
            "port": "solid"
          }
        ]
      },
      "preview": false
    },
