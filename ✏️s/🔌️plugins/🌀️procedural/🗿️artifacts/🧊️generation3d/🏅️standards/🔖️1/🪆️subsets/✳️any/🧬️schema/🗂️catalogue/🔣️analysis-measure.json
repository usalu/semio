    {
      "id": "analysis.massProperties",
      "category": "analysis.measure",
      "emoji": "🏋️",
      "label": {
        "en": "Mass properties",
        "de": "Masseneigenschaften"
      },
      "description": {
        "en": "Computes mass, centroid, inertia tensor and principal axes of a solid of uniform density.",
        "de": "Berechnet Masse, Schwerpunkt, Trägheitstensor und Hauptachsen eines Körpers gleichmäßiger Dichte."
      },
      "inputs": [
        {
          "name": "solid",
          "label": {
            "en": "Solid",
            "de": "Körper"
          },
          "description": {
            "en": "The solid to operate on.",
            "de": "Der Körper, auf den der Vorgang angewendet wird."
          },
          "type": "shape",
          "shapeKinds": [
            "solid",
            "compound"
          ]
        },
        {
          "name": "density",
          "label": {
            "en": "Density",
            "de": "Dichte"
          },
          "description": {
            "en": "Mass per unit volume.",
            "de": "Masse pro Volumeneinheit."
          },
          "type": "number",
          "default": 1,
          "min": 0,
          "exclusiveMin": true,
          "step": 0.1
        }
      ],
      "outputs": [
        {
          "name": "mass",
          "label": {
            "en": "Mass",
            "de": "Masse"
          },
          "description": {
            "en": "Volume times density.",
            "de": "Volumen mal Dichte."
          },
          "type": "number",
          "unit": "mass"
        },
        {
          "name": "volume",
          "label": {
            "en": "Volume",
            "de": "Volumen"
          },
          "description": {
            "en": "The enclosed volume.",
            "de": "Das eingeschlossene Volumen."
          },
          "type": "number",
          "unit": "length³"
        },
        {
          "name": "centroid",
          "label": {
            "en": "Centroid",
            "de": "Schwerpunkt"
          },
          "description": {
            "en": "The center of mass.",
            "de": "Der Massenschwerpunkt."
          },
          "type": "point"
        },
        {
          "name": "inertia",
          "label": {
            "en": "Inertia tensor",
            "de": "Trägheitstensor"
          },
          "description": {
            "en": "The nine tensor entries row by row, taken about the centroid.",
            "de": "Die neun Tensoreinträge zeilenweise, bezogen auf den Schwerpunkt."
          },
          "type": "number",
          "list": true
        },
        {
          "name": "principalMoments",
          "label": {
            "en": "Principal moments",
            "de": "Hauptträgheitsmomente"
          },
          "description": {
            "en": "The three principal moments of inertia, ascending.",
            "de": "Die drei Hauptträgheitsmomente in aufsteigender Reihenfolge."
          },
          "type": "vector"
        },
        {
          "name": "principalAxes",
          "label": {
            "en": "Principal axes",
            "de": "Hauptachsen"
          },
          "description": {
            "en": "The three principal axes matching the moments.",
            "de": "Die drei zu den Momenten gehörenden Hauptachsen."
          },
          "type": "vector",
          "list": true
        }
      ],
      "quality": "exact-numerical",
      "interaction": {
        "pick": [
          {
            "component": "shape",
            "port": "solid"
          }
        ]
      },
      "preview": false
    },
    {
