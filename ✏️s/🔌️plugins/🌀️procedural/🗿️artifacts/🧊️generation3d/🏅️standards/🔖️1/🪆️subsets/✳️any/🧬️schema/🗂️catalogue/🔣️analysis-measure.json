      ],
      "quality": "exact-numerical",
      "interaction": {
        "pick": [
          {
            "component": "shape",
            "port": "shape"
          }
        ]
      },
      "preview": false
    },
    {
      "id": "analysis.classifyPoint",
      "category": "analysis.measure",
      "emoji": "🧭️",
      "label": {
        "en": "Classify point",
        "de": "Punkt klassifizieren"
      },
      "description": {
        "en": "Tells whether a point lies inside, outside or on the boundary of a solid.",
        "de": "Gibt an, ob ein Punkt innerhalb, außerhalb oder auf dem Rand eines Körpers liegt."
      },
      "inputs": [
        {
          "name": "solid",
          "label": {
            "en": "Solid",
            "de": "Körper"
          },
          "description": {
            "en": "The solid to operate on.",
            "de": "Der Körper, auf den der Vorgang angewendet wird."
          },
          "type": "shape",
          "shapeKinds": [
            "solid",
            "compound"
          ]
        },
        {
          "name": "point",
          "label": {
            "en": "Point",
            "de": "Punkt"
          },
          "description": {
            "en": "The point to classify.",
            "de": "Der zu klassifizierende Punkt."
          },
          "type": "point",
          "default": [
            0,
            0,
            0
          ]
        }
      ],
      "outputs": [
        {
          "name": "classification",
          "label": {
            "en": "Position",
            "de": "Lage"
          },
          "description": {
            "en": "Where the point lies relative to the solid.",
            "de": "Wo der Punkt relativ zum Körper liegt."
          },
          "type": "enum",
          "options": [
            {
              "value": "inside",
              "label": {
                "en": "Inside",
                "de": "Innen"
              }
            },
            {
              "value": "outside",
              "label": {
                "en": "Outside",
                "de": "Außen"
              }
            },
            {
              "value": "boundary",
              "label": {
                "en": "On boundary",
                "de": "Auf dem Rand"
              }
            }
          ]
        }
      ],
      "quality": "exact-numerical",
      "interaction": {
        "pick": [
          {
            "component": "shape",
            "port": "solid"
          }
        ]
      },
      "preview": false
    },
    {
      "id": "analysis.angle",
      "category": "analysis.measure",
      "emoji": "📐️",
      "label": {
