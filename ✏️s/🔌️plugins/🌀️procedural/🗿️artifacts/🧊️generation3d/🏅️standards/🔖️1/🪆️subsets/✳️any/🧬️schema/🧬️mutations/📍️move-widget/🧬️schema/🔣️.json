{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/procedural/generation3d/mutation/move-widget/schema.json",
  "title": "MoveWidget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "id",
    "layout"
  ],
  "properties": {
    "mutation": {
      "const": "moveWidget"
    },
    "id": {
      "type": "string",
      "x-semio-ui": {
        "widget": "reference",
        "role": "target",
        "label": {
          "en": "Widget",
          "de": "Baustein"
        },
        "description": {
          "en": "The graph widget this mutation addresses.",
          "de": "Der Graph-Baustein, den diese Mutation adressiert."
        },
        "ref": {
          "kind": "widget",
          "domain": "graph",
          "granularity": "node"
        },
        "group": "target",
        "order": 10
      }
    },
    "layout": {
      "title": "WidgetLayout",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "X",
              "de": "X"
            },
            "step": 1,
            "precision": 1,
            "group": "layout",
            "order": 10
          }
        },
        "y": {
          "type": "number",
          "x-semio-ui": {
            "widget": "stepper",
            "role": "value",
            "label": {
              "en": "Y",
              "de": "Y"
            },
            "step": 1,
            "precision": 1,
            "group": "layout",
            "order": 20
          }
        }
      },
      "x-semio-ui": {
        "role": "value",
        "label": {
          "en": "Position",
          "de": "Position"
        },
        "description": {
          "en": "Where the widget sits on the graph canvas.",
          "de": "Lage des Bausteins auf der Graphfläche."
        },
        "group": "layout",
        "order": 20
      }
    }
  }
}
