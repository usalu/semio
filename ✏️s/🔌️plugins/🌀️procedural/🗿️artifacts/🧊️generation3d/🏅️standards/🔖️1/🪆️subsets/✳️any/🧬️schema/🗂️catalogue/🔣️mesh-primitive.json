{
  "category": {
    "id": "mesh.primitive",
    "emoji": "🥽️",
    "order": 200,
    "label": {
      "en": "Mesh primitives",
      "de": "Netz-Grundformen"
    },
    "description": {
      "en": "Create polygon meshes from numbers: boxes, planes, spheres, cylinders, cones, tori or raw vertex and face data.",
      "de": "Polygonnetze aus Zahlen erzeugen: Quader, Ebenen, Kugeln, Zylinder, Kegel, Tori oder rohe Eckpunkt- und Flächendaten."
    }
  },
  "kinds": [
    {
      "id": "mesh.primitive.construct",
      "category": "mesh.primitive",
      "emoji": "🧮️",
      "label": {
        "en": "Mesh from data",
        "de": "Netz aus Daten"
      },
      "description": {
        "en": "Builds a mesh from JSON text with vertex positions and zero-based face indices.",
        "de": "Baut ein Netz aus JSON-Text mit Eckpunktpositionen und nullbasierten Flächenindizes."
      },
      "inputs": [
        {
          "name": "data",
          "label": {
            "en": "Mesh data",
            "de": "Netzdaten"
          },
          "description": {
            "en": "JSON with a \"vertices\" list of positions and a \"faces\" list of index lists.",
            "de": "JSON mit einer Liste \"vertices\" aus Positionen und einer Liste \"faces\" aus Indexlisten."
          },
          "type": "text",
          "default": "{\"vertices\":[[0,0,0],[1,0,0],[0,1,0]],\"faces\":[[0,1,2]]}"
        }
      ],
      "outputs": [
        {
          "name": "mesh",
          "label": {
            "en": "Mesh",
            "de": "Netz"
          },
          "description": {
            "en": "The constructed mesh.",
            "de": "Das erzeugte Netz."
          },
          "type": "mesh"
        }
      ],
      "quality": "polygon-mesh",
      "preview": true
    },
