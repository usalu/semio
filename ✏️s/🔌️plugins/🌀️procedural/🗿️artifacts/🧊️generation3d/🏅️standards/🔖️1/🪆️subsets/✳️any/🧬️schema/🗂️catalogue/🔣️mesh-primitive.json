        {
          "name": "subdivisions",
          "label": {
            "en": "Subdivisions",
            "de": "Unterteilungen"
          },
          "description": {
            "en": "Each step quadruples the number of triangles; 0 to 5.",
            "de": "Jeder Schritt vervierfacht die Dreieckszahl; 0 bis 5."
