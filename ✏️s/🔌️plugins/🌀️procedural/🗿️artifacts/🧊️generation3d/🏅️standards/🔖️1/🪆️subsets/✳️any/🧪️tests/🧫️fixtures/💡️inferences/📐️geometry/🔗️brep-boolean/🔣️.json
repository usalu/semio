{
  "description": "Language-agnostic laws of the brep.boolean widgets. A solid input is an oracle recipe (box, translate, cylinder, compound) or the output of another widget. A shape output is checked by its kind, volume, area and bounding box. TypeScript recomputes every case with manifold-3d (add, subtract, intersect on cuboids and a 256-sided cylinder) as the independent oracle and with closed forms for the bored block.",
  "tolerance": 1e-6,
  "cases": [
    {"name": "fuse two overlapping cubes", "kind": "brep.boolean.fuse", "inputs": {"a": {"recipe": "box", "size": [2, 2, 2]}, "b": {"recipe": "translate", "of": {"recipe": "box", "size": [2, 2, 2]}, "by": [1, 0, 0]}}, "outputs": {"shape": {"kind": "solid", "volume": 12, "area": 32, "bbox": [[0, 0, 0], [3, 2, 2]]}}},
    {"name": "cut a cube by an overlapping cube", "kind": "brep.boolean.cut", "inputs": {"a": {"recipe": "box", "size": [2, 2, 2]}, "b": {"recipe": "translate", "of": {"recipe": "box", "size": [2, 2, 2]}, "by": [1, 0, 0]}}, "outputs": {"shape": {"kind": "solid", "volume": 4, "area": 16, "bbox": [[0, 0, 0], [1, 2, 2]]}}},
    {"name": "intersect two overlapping cubes", "kind": "brep.boolean.intersect", "inputs": {"a": {"recipe": "box", "size": [2, 2, 2]}, "b": {"recipe": "translate", "of": {"recipe": "box", "size": [2, 2, 2]}, "by": [1, 0, 0]}}, "outputs": {"shape": {"kind": "solid", "volume": 4, "area": 16, "bbox": [[1, 0, 0], [2, 2, 2]]}}},
    {"name": "bore a block with a cylinder", "kind": "brep.boolean.cut", "inputs": {"a": {"recipe": "box", "size": [4, 4, 4]}, "b": {"recipe": "translate", "of": {"recipe": "cylinder", "radius": 1, "height": 6}, "by": [2, 2, -1]}}, "outputs": {"shape": {"kind": "solid", "volume": 51.43362938564083, "area": 114.84955592153875, "bbox": [[0, 0, 0], [4, 4, 4]]}}, "tolerance": 0.002},
    {"name": "fuse a compound with a bridge", "kind": "brep.boolean.fuse", "inputs": {"a": {"recipe": "compound", "of": [{"recipe": "box", "size": [1, 1, 1]}, {"recipe": "translate", "of": {"recipe": "box", "size": [1, 1, 1]}, "by": [2, 0, 0]}]}, "b": {"recipe": "translate", "of": {"recipe": "box", "size": [3, 1, 1]}, "by": [0, 0.5, 0]}}, "outputs": {"shape": {"kind": "solid", "volume": 4, "bbox": [[0, 0, 0], [3, 1.5, 1]]}}},
    {"name": "cut a compound by a cube", "kind": "brep.boolean.cut", "inputs": {"a": {"recipe": "compound", "of": [{"recipe": "box", "size": [1, 1, 1]}, {"recipe": "translate", "of": {"recipe": "box", "size": [1, 1, 1]}, "by": [2, 0, 0]}]}, "b": {"recipe": "translate", "of": {"recipe": "box", "size": [1, 1, 1]}, "by": [0.5, 0, 0]}}, "outputs": {"shape": {"kind": "solid", "volume": 1.5, "bbox": [[0, 0, 0], [3, 1, 1]]}}},
    {"name": "compound cut with two through tools", "kind": "brep.boolean.compoundCut", "inputs": {"target": {"recipe": "box", "size": [4, 4, 1]}, "tools": [{"recipe": "translate", "of": {"recipe": "box", "size": [1, 1, 3]}, "by": [0.5, 0.5, -1]}, {"recipe": "translate", "of": {"recipe": "box", "size": [1, 1, 3]}, "by": [2.5, 2.5, -1]}]}, "outputs": {"shape": {"kind": "solid", "volume": 14, "area": 52, "bbox": [[0, 0, 0], [4, 4, 1]]}}},
    {"name": "compound cut by a compound of tools", "kind": "brep.boolean.compoundCut", "inputs": {"target": {"recipe": "box", "size": [4, 4, 1]}, "tools": [{"recipe": "compound", "of": [{"recipe": "translate", "of": {"recipe": "box", "size": [1, 1, 3]}, "by": [0.5, 0.5, -1]}, {"recipe": "translate", "of": {"recipe": "box", "size": [1, 1, 3]}, "by": [2.5, 2.5, -1]}]}]}, "outputs": {"shape": {"kind": "solid", "volume": 14, "area": 52}}},
    {"name": "compound cut without tools", "kind": "brep.boolean.compoundCut", "inputs": {"target": {"recipe": "box", "size": [4, 4, 1]}, "tools": []}, "fault": {"code": "generation3d.geometry.too-few-tools", "port": "tools"}},
    {"name": "fuse a face", "kind": "brep.boolean.fuse", "inputs": {"a": {"recipe": "widget", "kind": "brep.surface.planarFace", "inputs": {"points": [[0, 0, 0], [1, 0, 0], [1, 1, 0]]}}, "b": {"recipe": "box", "size": [2, 2, 2]}}, "fault": {"code": "generation3d.geometry.shape-kind", "port": "a"}},
    {"name": "cut a cube by itself", "kind": "brep.boolean.cut", "inputs": {"a": {"recipe": "box", "size": [2, 2, 2]}, "b": {"recipe": "box", "size": [2, 2, 2]}}, "fault": {"code": "generation3d.geometry.boolean-empty"}},
    {"name": "intersect two distant cubes", "kind": "brep.boolean.intersect", "inputs": {"a": {"recipe": "box", "size": [2, 2, 2]}, "b": {"recipe": "translate", "of": {"recipe": "box", "size": [2, 2, 2]}, "by": [10, 0, 0]}}, "fault": {"code": "generation3d.geometry.boolean-empty"}}
  ]
}
