{
  "$id": "https://semio.tech/schema/app/procedural/3d/presence.json",
  "title": "Procedural3dPresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedNodeIds",
    "camera",
    "previewCamera",
    "selectionMethod",
    "activeUtilityId",
    "showMode"
  ],
  "properties": {
    "selectedNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "shared-ui"
    },
    "hoveredNodeId": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "camera": {
      "$ref": "#/$defs/CameraJson",
      "x-semio-state": "shared-ui"
    },
    "previewCamera": {
      "$ref": "#/$defs/Procedural3dPreviewCamera",
      "x-semio-state": "shared-ui"
    },
    "selectionMethod": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "activeUtilityId": {
      "type": "string",
      "x-semio-state": "shared-ui"
    },
    "showMode": {
      "type": "string",
      "x-semio-state": "shared-ui"
    }
  },
  "$defs": {
    "CameraJson": {
      "title": "CameraJson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "zoom": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "Procedural3dPreviewCamera": {
      "title": "Procedural3dPreviewCamera",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "fov"
      ],
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "fov": {
          "type": "number",
          "format": "double"
        }
      }
    }
  }
}
