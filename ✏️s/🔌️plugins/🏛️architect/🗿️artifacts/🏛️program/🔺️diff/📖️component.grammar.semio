dialect grammar
grammar architect.program.diff
extension program
use family-sheet
start diff

artifact-mark = "architect.program-diff"
diff = artifact-mark change+
change = "set" | "unset" | "replace"
change-field = change ("architect.program-title" | "architect.program-clause") ("=" value)?
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
