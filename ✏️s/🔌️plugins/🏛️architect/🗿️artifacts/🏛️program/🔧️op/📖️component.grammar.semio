 "scenarios-add" | "scenarios-remove" | "scenarios-move" | "scenarios-patch" | "scenarios-set" | "options-add" | "options-remove" | "options-move" | "options-patch" | "options-set" | "decisions-add" | "decisions-remove" | "decisions-move" | "decisions-patch" | "decisions-set" | "validations-add" | "validations-remove" | "validations-move" | "validations-patch" | "validations-set" | "performance-add" | "performance-remove" | "performance-move" | "performance-patch" | "performance-set" | "quality-add" | "quality-remove" | "quality-move" | "quality-patch" | "quality-set" | "documents-add" | "documents-remove" | "documents-move" | "documents-patch" | "documents-set" | "changes-add" | "changes-remove" | "changes-move" | "changes-patch" | "changes-set" | "collaboration-add" | "collaboration-remove" | "collaboration-move" | "collaboration-patch" | "collaboration-set" | "analyses-add" | "analyses-remove" | "analyses-move" | "analyses-patch" | "analyses-set" | "reports-add" | "reports-remove" | "reports-move" | "reports-patch" | "reports-set" | "search-filters-add" | "search-filters-remove" | "search-filters-move" | "search-filters-patch" | "search-filters-set" | "status-records-add" | "status-records-remove" | "status-records-move" | "status-records-patch" | "status-records-set" | "workshops-add" | "workshops-remove" | "workshops-move" | "workshops-patch" | "workshops-set" | "surveys-add" | "surveys-remove" | "surveys-move" | "surveys-patch" | "surveys-set" | "issues-add" | "issues-remove" | "issues-move" | "issues-patch" | "issues-set" | "audit-events-add" | "audit-events-remove" | "audit-events-move" | "audit-events-patch" | "audit-events-set" | "templates-add" | "templates-remove" | "templates-move" | "templates-patch" | "templates-set" | "knowledge-add" | "knowledge-remove" | "knowledge-move" | "knowledge-patch" | "knowledge-set" | "benchmarks-add" | "benchmarks-remove" | "benchmarks-move" | "benchmarks-patch" | "benchmarks-set" | "assumptions-add" | "assumptions-remove" | "assumptions-move" | "assumptions-patch" | "assumptions-set" | "constraints-add" | "constraints-remove" | "constraints-move" | "constraints-patch" | "constraints-set" | "compliance-records-add" | "compliance-records-remove" | "compliance-records-move" | "compliance-records-patch" | "compliance-records-set" | "approvals-add" | "approvals-remove" | "approvals-move" | "approvals-patch" | "approvals-set" | "meetings-add" | "meetings-remove" | "meetings-move" | "meetings-patch" | "meetings-set" | "traces-add" | "traces-remove" | "traces-move" | "traces-patch" | "traces-set" | "update-meta" | "update-project" | "update-governance" | "set-adjacency" | "clear-adjacency" | "set-program") assign* block?
assign = IDENT "=" (TEXT | INT | FLOAT | BOOL | list | map | qty | block)
list = "[" value* "]"
map = "{" assign* "}"
value = TEXT | INT | FLOAT | BOOL | IDENT | qty | list | map | block
qty = (FLOAT | INT) IDENT?
block = "{" record* "}"
record = IDENT assign* block?
table = IDENT table-schema "{" row* "}"
table-schema = "[" col {"," col}* "]"
col = IDENT ":" IDENT
row = field+
field = IDENT "=" value | value
props = "{" prop* "}"
prop = IDENT "=" (TEXT | INT | FLOAT | BOOL | list | map | qty)
