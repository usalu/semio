{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplacePrivacyRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "privacyRequirement"
  ],
  "properties": {
    "privacyRequirement": {
      "title": "PrivacyRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessRestrictions",
        "acousticPrivacy",
        "breachResponse",
        "culturalConsiderations",
        "dataPrivacy",
        "elementIds",
        "enclosureRequired",
        "id",
        "monitoringRestrictions",
        "name",
        "notes",
        "ownership",
        "priority",
        "privacyKind",
        "privacyType",
        "regulatoryBasis",
        "screeningRequired",
        "signage",
        "status",
        "subjectIds",
        "tags",
        "technologyControls",
        "timestamps",
        "visualPrivacy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "privacyKind": {
          "type": "string",
          "enum": [
            "Public",
            "SemiPublic",
            "SemiPrivate",
            "Private",
            "Confidential",
            "Restricted",
            "Anonymous"
          ]
        },
        "privacyType": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "subjectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visualPrivacy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acousticPrivacy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataPrivacy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "screeningRequired": {
          "type": "boolean"
        },
        "enclosureRequired": {
          "type": "boolean"
        },
        "accessRestrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observationRisk": {
          "type": "string"
        },
        "regulatoryBasis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "culturalConsiderations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technologyControls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitoringRestrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retentionPolicy": {
          "type": "string"
        },
        "breachResponse": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        }
      }
    }
  }
}
