  "properties": {
    "sustainabilityRequirement": {
      "title": "SustainabilityRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biodiversity",
        "certification",
        "elementIds",
        "energyStrategy",
        "id",
        "materialsPreferences",
        "name",
        "notes",
        "ownership",
        "priority",
        "reportingRequirements",
        "standards",
        "status",
        "strategies",
        "tags",
        "timestamps",
        "topic",
        "wasteStrategy",
        "waterStrategy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "topic": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "baseline": {
          "type": "number"
        },
        "targetValue": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "certification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strategies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "materialsPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "energyStrategy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waterStrategy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wasteStrategy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "biodiversity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "embodiedCarbon": {
          "type": "number"
        },
        "operationalCarbon": {
          "type": "number"
        },
        "reportingRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verificationPlan": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        }
      }
    }
  }
}
