{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateRisk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk"
  ],
  "properties": {
    "risk": {
      "title": "Risk",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affectedElementIds",
        "affectedRequirementIds",
        "category",
        "causes",
        "contingency",
        "effects",
        "escalationPath",
        "id",
        "impact",
        "mitigation",
        "name",
        "notes",
        "ownership",
        "priority",
        "probability",
        "relatedConflictIds",
        "riskStatement",
        "status",
        "tags",
        "timestamps",
        "triggerIndicators"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "riskStatement": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "category": {
          "type": "string"
        },
        "probability": {
          "type": "string",
          "enum": [
            "Negligible",
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "impact": {
          "type": "string",
          "enum": [
            "Negligible",
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "riskScore": {
          "type": "number"
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affectedElementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affectedRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mitigation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contingency": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        },
        "reviewDate": {
          "type": "string"
        },
        "triggerIndicators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "residualProbability": {
          "type": "string",
          "enum": [
            "Negligible",
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "residualImpact": {
          "type": "string",
          "enum": [
            "Negligible",
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "relatedConflictIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "escalationPath": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitoringPlan": {
          "type": "string"
        }
      }
    }
  }
}
