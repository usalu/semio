{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateValidationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validationRecord"
  ],
  "properties": {
    "validationRecord": {
      "title": "ValidationRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctiveActions",
        "criteria",
        "evidence",
        "findings",
        "id",
        "name",
        "nonConformities",
        "notes",
        "ownership",
        "priority",
        "result",
        "standards",
        "status",
        "subjectId",
        "subjectKind",
        "tags",
        "timestamps",
        "traceLinks",
        "validationNotes",
        "validationType",
        "validatorIds",
        "waivers"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "subjectId": {
          "type": "string"
        },
        "subjectKind": {
          "type": "string"
        },
        "validationType": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result": {
          "type": "string",
          "enum": [
            "Pending",
            "Passed",
            "Failed",
            "Waived",
            "Deferred"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validatorIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validationDate": {
          "type": "string"
        },
        "nextReviewDate": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nonConformities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correctiveActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traceLinks": {
          "type": "array",
          "items": {
            "title": "TraceLink",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromId",
              "id",
              "kind",
              "toId"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "fromId": {
                "type": "string"
              },
              "toId": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ObjectiveToRequirement",
                  "StakeholderToRequirement",
                  "UserToActivity",
                  "ActivityToFunction",
                  "FunctionToProgramElement",
                  "RequirementToDecision",
                  "RequirementToRisk",
                  "RequirementToStandard",
                  "RequirementToValidation",
                  "RequirementToApproval",
                  "RequirementToChange",
                  "EquipmentToActivity",
                  "ProcessToResource",
                  "ConstraintToImpact",
                  "ScenarioToDecision",
                  "IssueToAction",
                  "ActionToOwner",
                  "DecisionToOutcome",
                  "VersionToChange",
                  "FullAuditTrail"
                ]
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "reportId": {
          "type": "string"
        },
        "confidenceLevel": {
          "type": "string"
        },
        "validationNotes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
