{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceFlexibilityRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flexibilityRequirement"
  ],
  "properties": {
    "flexibilityRequirement": {
      "title": "FlexibilityRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adaptationScenarios",
        "contractionScenario",
        "demountablePartitions",
        "elementIds",
        "expansionDirection",
        "flexibilityType",
        "furnitureStrategy",
        "futureFunctionIds",
        "id",
        "infrastructureSpareCapacity",
        "leaseImplications",
        "multiUsePotential",
        "name",
        "notes",
        "overheadServices",
        "ownership",
        "priority",
        "raisedFloor",
        "status",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "flexibilityType": {
          "type": "string"
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adaptationScenarios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modularityLevel": {
          "type": "string"
        },
        "reconfigurationTime": {
          "type": "string"
        },
        "costOfChange": {
          "type": "number"
        },
        "technologyReadiness": {
          "type": "string"
        },
        "futureFunctionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "demountablePartitions": {
          "type": "boolean"
        },
        "raisedFloor": {
          "type": "boolean"
        },
        "overheadServices": {
          "type": "boolean"
        },
        "expansionDirection": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contractionScenario": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "multiUsePotential": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "furnitureStrategy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "infrastructureSpareCapacity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "leaseImplications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        }
      }
    }
  }
}
