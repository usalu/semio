{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceEnvironmentalRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environmentalRequirement"
  ],
  "properties": {
    "environmentalRequirement": {
      "title": "EnvironmentalRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificationTargets",
        "elementIds",
        "energyImplications",
        "id",
        "name",
        "notes",
        "outdoorConditions",
        "ownership",
        "parameter",
        "parameterKind",
        "priority",
        "seasonalVariation",
        "standards",
        "status",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "parameterKind": {
          "type": "string",
          "enum": [
            "Temperature",
            "Humidity",
            "AirQuality",
            "Lighting",
            "Acoustics",
            "Ventilation",
            "Radiation",
            "Vibration",
            "Pressure",
            "Iaq"
          ]
        },
        "parameter": {
          "type": "string"
        },
        "targetValue": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "minValue": {
          "type": "number"
        },
        "maxValue": {
          "type": "number"
        },
        "comfortBand": {
          "type": "string"
        },
        "measurementMethod": {
          "type": "string"
        },
        "monitoringFrequency": {
          "type": "string"
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "occupancyBasis": {
          "type": "string"
        },
        "seasonalVariation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "energyImplications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "certificationTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outdoorConditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ventilationStrategy": {
          "type": "string"
        },
        "daylightTarget": {
          "type": "string"
        },
        "acousticTarget": {
          "type": "string"
        },
        "iaqTarget": {
          "type": "string"
        },
        "verificationPlan": {
          "type": "string"
        }
      }
    }
  }
}
