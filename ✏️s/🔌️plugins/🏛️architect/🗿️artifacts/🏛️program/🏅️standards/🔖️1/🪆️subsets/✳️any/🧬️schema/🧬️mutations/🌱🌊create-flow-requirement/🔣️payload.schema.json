{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateFlowRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flowRequirement"
  ],
  "properties": {
    "flowRequirement": {
      "title": "FlowRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessLevel",
        "barrierFree",
        "conflictIds",
        "direction",
        "emergencyRoute",
        "escortRequired",
        "flowType",
        "fromElementId",
        "id",
        "kind",
        "monitoringRequired",
        "name",
        "notes",
        "ownership",
        "priority",
        "separationRequirements",
        "signageRequired",
        "status",
        "tags",
        "timeWindows",
        "timestamps",
        "toElementId",
        "volume"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "fromElementId": {
          "type": "string"
        },
        "toElementId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "People",
            "Material",
            "Information",
            "Service",
            "Equipment",
            "Waste",
            "Emergency",
            "Vehicle"
          ]
        },
        "flowType": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "OneWay",
            "TwoWay",
            "BidirectionalPeak",
            "Restricted"
          ]
        },
        "volume": {
          "title": "QuantitySpec",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            },
            "current": {
              "type": "number"
            },
            "forecast": {
              "type": "number"
            },
            "peak": {
              "type": "number"
            },
            "average": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "peakRate": {
          "type": "number"
        },
        "clearWidthM": {
          "type": "number"
        },
        "clearHeightM": {
          "type": "number"
        },
        "separationRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Acoustic",
              "Visual",
              "Security",
              "Olfactory",
              "Thermal",
              "Fire",
              "Hygienic",
              "Circulation",
              "Operational",
              "InfectionControl"
            ]
          }
        },
        "accessLevel": {
          "type": "string",
          "enum": [
            "Public",
            "Restricted",
            "Controlled",
            "Private",
            "Secure",
            "EmergencyOnly"
          ]
        },
        "timeWindows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "equipmentClearance": {
          "type": "string"
        },
        "signageRequired": {
          "type": "boolean"
        },
        "escortRequired": {
          "type": "boolean"
        },
        "emergencyRoute": {
          "type": "boolean"
        },
        "barrierFree": {
          "type": "boolean"
        },
        "monitoringRequired": {
          "type": "boolean"
        },
        "processId": {
          "type": "string"
        },
        "conflictIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verificationMethod": {
          "type": "string"
        }
      }
    }
  }
}
