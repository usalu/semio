{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceAnalysisRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysisRecord"
  ],
  "properties": {
    "analysisRecord": {
      "title": "AnalysisRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "charts",
        "findings",
        "id",
        "inputEntityIds",
        "kind",
        "limitations",
        "metrics",
        "name",
        "notes",
        "outputSummary",
        "ownership",
        "parameters",
        "priority",
        "recommendations",
        "status",
        "tags",
        "timestamps",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "Gap",
            "Conflict",
            "Dependency",
            "Capacity",
            "Demand",
            "Utilization",
            "Workflow",
            "Risk",
            "Cost",
            "Scenario",
            "Sensitivity",
            "Impact",
            "Trend",
            "RequirementComparison",
            "RequirementClustering",
            "RequirementFiltering",
            "RequirementSorting",
            "RequirementScoring",
            "RequirementWeighting",
            "RelationshipAnalysis"
          ]
        },
        "title": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputEntityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputSummary": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runBy": {
          "type": "string"
        },
        "runAt": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "toolVersion": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "reportId": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rawResultRef": {
          "type": "string"
        }
      }
    }
  }
}
