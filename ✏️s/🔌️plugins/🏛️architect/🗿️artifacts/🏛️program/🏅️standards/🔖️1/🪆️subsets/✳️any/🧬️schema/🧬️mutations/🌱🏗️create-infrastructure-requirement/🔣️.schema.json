{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateInfrastructureRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "infrastructureRequirement"
  ],
  "properties": {
    "infrastructureRequirement": {
      "title": "InfrastructureRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity",
        "category",
        "commissioning",
        "distribution",
        "elementIds",
        "entryPoints",
        "futureExpansion",
        "id",
        "interfaceRequirements",
        "maintenanceAccess",
        "monitoring",
        "name",
        "notes",
        "ownership",
        "priority",
        "standards",
        "standbyPower",
        "status",
        "system",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "system": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "capacity": {
          "title": "QuantitySpec",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            },
            "current": {
              "type": "number"
            },
            "forecast": {
              "type": "number"
            },
            "peak": {
              "type": "number"
            },
            "average": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "redundancy": {
          "type": "string"
        },
        "distribution": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entryPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "utilitySource": {
          "type": "string"
        },
        "standbyPower": {
          "type": "boolean"
        },
        "monitoring": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maintenanceAccess": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "peakDemand": {
          "type": "number"
        },
        "diversityFactor": {
          "type": "number"
        },
        "futureExpansion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaceRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commissioning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycleCost": {
          "type": "number"
        },
        "ownerId": {
          "type": "string"
        }
      }
    }
  }
}
