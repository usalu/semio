{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceResource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource"
  ],
  "properties": {
    "resource": {
      "title": "Resource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activityIds",
        "category",
        "cleaningRequirements",
        "code",
        "customization",
        "disposalNotes",
        "elementIds",
        "ergonomicNotes",
        "id",
        "name",
        "notes",
        "ownership",
        "priority",
        "quantity",
        "resourceType",
        "standards",
        "status",
        "tags",
        "timestamps",
        "userProfileIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "code": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        },
        "quantity": {
          "title": "QuantitySpec",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            },
            "current": {
              "type": "number"
            },
            "forecast": {
              "type": "number"
            },
            "peak": {
              "type": "number"
            },
            "average": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "mobility": {
          "type": "string"
        },
        "sharingModel": {
          "type": "string"
        },
        "allocation": {
          "type": "string"
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "userProfileIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storageRequirementId": {
          "type": "string"
        },
        "durability": {
          "type": "string"
        },
        "cleaningRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replacementCycle": {
          "type": "string"
        },
        "costPerUnit": {
          "type": "number"
        },
        "supplier": {
          "type": "string"
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ergonomicNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customization": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disposalNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "furnitureClass": {
          "type": "string"
        },
        "ergonomicsRating": {
          "type": "string"
        },
        "sharingRatio": {
          "type": "number"
        }
      }
    }
  }
}
