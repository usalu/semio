{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateQualityRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "qualityRecord"
  ],
  "properties": {
    "qualityRecord": {
      "title": "QualityRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptanceCriteria",
        "certificationTargets",
        "continuousImprovement",
        "correctiveActionProcess",
        "defectCategories",
        "documentationRequirements",
        "elementIds",
        "id",
        "inspectionPoints",
        "kpis",
        "name",
        "notes",
        "ownership",
        "priority",
        "qualityTopic",
        "requirementIds",
        "status",
        "supplierRequirements",
        "tags",
        "testingRequirements",
        "timestamps",
        "trainingRequirements"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "qualityTopic": {
          "type": "string"
        },
        "standard": {
          "type": "string"
        },
        "targetLevel": {
          "type": "string"
        },
        "inspectionPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "testingRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sampleRate": {
          "type": "string"
        },
        "defectCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correctiveActionProcess": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supplierRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documentationRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trainingRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auditSchedule": {
          "type": "string"
        },
        "kpis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        },
        "certificationTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "continuousImprovement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
