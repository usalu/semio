{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceReportRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportRecord"
  ],
  "properties": {
    "reportRecord": {
      "title": "ReportRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisIds",
        "approvalStatus",
        "audience",
        "distributionList",
        "id",
        "kind",
        "name",
        "notes",
        "ownership",
        "parameters",
        "priority",
        "relatedDecisionIds",
        "sections",
        "status",
        "tags",
        "timestamps",
        "title",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "ExecutiveSummary",
            "ProgramOverview",
            "StakeholderSummary",
            "RequirementsMatrix",
            "AdjacencyMatrix",
            "GapAnalysis",
            "RiskRegister",
            "DecisionLog",
            "ValidationSummary",
            "Recommendation",
            "UserSummary",
            "FunctionalSummary",
            "CapacitySummary",
            "WorkflowSummary",
            "ComplianceSummary",
            "CostSummary",
            "ScheduleSummary",
            "ChangeSummary",
            "OpenIssueSummary",
            "PrioritySummary",
            "ScenarioSummary"
          ]
        },
        "title": {
          "type": "string"
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generatedAt": {
          "type": "string"
        },
        "generatedBy": {
          "type": "string"
        },
        "analysisIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "format": {
          "type": "string"
        },
        "fileRef": {
          "type": "string"
        },
        "distributionList": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvalStatus": {
          "type": "string",
          "enum": [
            "Pending",
            "Passed",
            "Failed",
            "Waived",
            "Deferred"
          ]
        },
        "approverId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidentiality": {
          "type": "string"
        },
        "expiryDate": {
          "type": "string"
        },
        "relatedDecisionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
