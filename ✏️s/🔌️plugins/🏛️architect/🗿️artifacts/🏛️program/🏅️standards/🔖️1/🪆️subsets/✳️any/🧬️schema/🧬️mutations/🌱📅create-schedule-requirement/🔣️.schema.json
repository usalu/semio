{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateScheduleRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scheduleRequirement"
  ],
  "properties": {
    "scheduleRequirement": {
      "title": "ScheduleRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical",
        "decantRequirements",
        "dependencies",
        "id",
        "milestone",
        "name",
        "notes",
        "occupancyImpact",
        "ownership",
        "phase",
        "predecessors",
        "priority",
        "resourceRequirements",
        "riskIds",
        "stakeholderIds",
        "status",
        "successors",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "milestone": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "Concept",
            "Schematic",
            "DesignDevelopment",
            "ConstructionDocuments",
            "Procurement",
            "Construction",
            "Commissioning",
            "Occupancy"
          ]
        },
        "startDate": {
          "type": "string"
        },
        "endDate": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "predecessors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critical": {
          "type": "boolean"
        },
        "floatDays": {
          "type": "integer",
          "minimum": 0
        },
        "resourceRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "occupancyImpact": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phasingStrategy": {
          "type": "string"
        },
        "decantRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commissioningWindow": {
          "type": "string"
        },
        "stakeholderIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "riskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contingencyDays": {
          "type": "integer",
          "minimum": 0
        },
        "reportingCadence": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        }
      }
    }
  }
}
