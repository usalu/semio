{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateSiteContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "siteContext"
  ],
  "properties": {
    "siteContext": {
      "title": "SiteContext",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessRoads",
        "environmentalConstraints",
        "heritageConstraints",
        "id",
        "name",
        "neighbors",
        "noiseSources",
        "notes",
        "ownership",
        "priority",
        "publicTransit",
        "siteName",
        "soilConditions",
        "status",
        "tags",
        "timestamps",
        "utilitiesAvailable",
        "views"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "siteName": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "elevationM": {
          "type": "number"
        },
        "climateZone": {
          "type": "string"
        },
        "seismicZone": {
          "type": "string"
        },
        "floodRisk": {
          "type": "string"
        },
        "soilConditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "utilitiesAvailable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessRoads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publicTransit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "neighbors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noiseSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environmentalConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heritageConstraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "zoning": {
          "type": "string"
        },
        "maxHeightM": {
          "type": "number"
        },
        "maxCoverage": {
          "type": "number"
        }
      }
    }
  }
}
