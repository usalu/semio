{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceStakeholder",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stakeholder"
  ],
  "properties": {
    "stakeholder": {
      "title": "Stakeholder",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "communicationChannels",
        "communicationPreferences",
        "concerns",
        "decisionAuthority",
        "engagement",
        "expectations",
        "id",
        "influence",
        "interest",
        "involvementPhases",
        "name",
        "notes",
        "organization",
        "ownership",
        "powerInterestNotes",
        "priority",
        "requirementIds",
        "role",
        "stakeholderType",
        "status",
        "successMetrics",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "role": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "department": {
          "type": "string"
        },
        "contactEmail": {
          "type": "string"
        },
        "contactPhone": {
          "type": "string"
        },
        "influence": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "interest": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "engagement": {
          "type": "string",
          "enum": [
            "Unaware",
            "Resistant",
            "Neutral",
            "Supportive",
            "Leading"
          ]
        },
        "expectations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisionAuthority": {
          "type": "boolean"
        },
        "communicationPreferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reportingFrequency": {
          "type": "string"
        },
        "involvementPhases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "availability": {
          "type": "string"
        },
        "representativeOf": {
          "type": "string"
        },
        "delegatedTo": {
          "type": "string"
        },
        "relationshipToClient": {
          "type": "string"
        },
        "powerInterestNotes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "stakeholderType": {
          "type": "string"
        },
        "influenceStrategy": {
          "type": "string"
        },
        "communicationChannels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successMetrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
