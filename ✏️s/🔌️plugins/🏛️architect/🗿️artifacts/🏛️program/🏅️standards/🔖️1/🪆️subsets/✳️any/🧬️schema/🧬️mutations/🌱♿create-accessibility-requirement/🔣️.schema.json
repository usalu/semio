{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateAccessibilityRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accessibilityRequirement"
  ],
  "properties": {
    "accessibilityRequirement": {
      "title": "AccessibilityRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companionSeating",
        "elementIds",
        "emergencyEvacuation",
        "exceptions",
        "hearingLoop",
        "id",
        "liftRequired",
        "name",
        "notes",
        "ownership",
        "priority",
        "routeIds",
        "signageRequirements",
        "standard",
        "status",
        "tactileGuidance",
        "tags",
        "timestamps",
        "universalDesignPrinciples",
        "userProfileIds",
        "visualContrast"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "standard": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "userProfileIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clearWidthM": {
          "type": "number"
        },
        "clearHeightM": {
          "type": "number"
        },
        "turningCircleM": {
          "type": "number"
        },
        "rampSlope": {
          "type": "number"
        },
        "liftRequired": {
          "type": "boolean"
        },
        "tactileGuidance": {
          "type": "boolean"
        },
        "hearingLoop": {
          "type": "boolean"
        },
        "visualContrast": {
          "type": "boolean"
        },
        "signageRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "controlsHeight": {
          "type": "string"
        },
        "emergencyEvacuation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceAnimalPolicy": {
          "type": "string"
        },
        "companionSeating": {
          "type": "boolean"
        },
        "verificationPlan": {
          "type": "string"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wcagConformance": {
          "type": "string"
        },
        "universalDesignPrinciples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
