{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateFunction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "function"
  ],
  "properties": {
    "function": {
      "title": "Function",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activityIds",
        "code",
        "conflictIds",
        "constraints",
        "criticality",
        "dependencies",
        "elementIds",
        "equipmentIds",
        "futureChanges",
        "id",
        "interfaces",
        "kind",
        "name",
        "notes",
        "ownership",
        "performanceTargets",
        "priority",
        "purpose",
        "qualityCriteria",
        "regulatoryRefs",
        "resourceIds",
        "staffing",
        "status",
        "successMetrics",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "code": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Primary",
            "Secondary",
            "Support",
            "Administrative",
            "Service",
            "Technical",
            "Public",
            "Private",
            "Shared",
            "Restricted",
            "Temporary",
            "Future",
            "Operational",
            "Circulation"
          ]
        },
        "purpose": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "criticality": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "performanceTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceLevel": {
          "type": "string"
        },
        "operatingHours": {
          "type": "string"
        },
        "staffing": {
          "title": "QuantitySpec",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            },
            "current": {
              "type": "number"
            },
            "forecast": {
              "type": "number"
            },
            "peak": {
              "type": "number"
            },
            "average": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "equipmentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualityCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regulatoryRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "futureChanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerStakeholderId": {
          "type": "string"
        },
        "successMetrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hierarchyParentId": {
          "type": "string"
        },
        "conflictIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
