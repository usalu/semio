{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplacePresence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "presence"
  ],
  "properties": {
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeRegister": {
          "type": "string"
        },
        "adjacencyKindFilter": {
          "type": "string",
          "enum": [
            "required",
            "preferred",
            "optional",
            "prohibited"
          ]
        },
        "graphCameraX": {
          "type": "number"
        },
        "graphCameraY": {
          "type": "number"
        },
        "graphCameraZoom": {
          "type": "number"
        }
      },
      "required": [
        "activeRegister",
        "graphCameraX",
        "graphCameraY",
        "graphCameraZoom"
      ]
    }
  }
}
