            "type": "string"
          }
        },
        "visitorManagement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keyManagement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
