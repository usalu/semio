{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateSurvey",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "survey"
  ],
  "properties": {
    "survey": {
      "title": "Survey",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consentProcess",
        "distributionChannels",
        "findings",
        "id",
        "name",
        "notes",
        "objectives",
        "ownership",
        "priority",
        "questions",
        "recommendations",
        "responseCount",
        "status",
        "surveyStatus",
        "surveyType",
        "tags",
        "targetAudience",
        "themes",
        "timestamps",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "surveyType": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetAudience": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distributionChannels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "launchDate": {
          "type": "string"
        },
        "closeDate": {
          "type": "string"
        },
        "responseCount": {
          "type": "integer",
          "minimum": 0
        },
        "responseRate": {
          "type": "number"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidentiality": {
          "type": "string"
        },
        "consentProcess": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysisId": {
          "type": "string"
        },
        "workshopId": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "surveyStatus": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        }
      }
    }
  }
}
