{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceComplianceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "complianceRecord"
  ],
  "properties": {
    "complianceRecord": {
      "title": "ComplianceRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affectedEntityIds",
        "artifactRefs",
        "complianceStatus",
        "correctiveActions",
        "evidenceRefs",
        "gapAnalysis",
        "id",
        "name",
        "notes",
        "obligation",
        "ownership",
        "penalties",
        "priority",
        "relatedRequirementIds",
        "remediationPlan",
        "severity",
        "standardRef",
        "status",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "standardRef": {
          "type": "string"
        },
        "obligation": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "complianceStatus": {
          "type": "string",
          "enum": [
            "Pending",
            "Passed",
            "Failed",
            "Waived",
            "Deferred"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auditorId": {
          "type": "string"
        },
        "auditDate": {
          "type": "string"
        },
        "nextReview": {
          "type": "string"
        },
        "affectedEntityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gapAnalysis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remediationPlan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "Negligible",
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "regulatoryBody": {
          "type": "string"
        },
        "certificationTarget": {
          "type": "string"
        },
        "waiverStatus": {
          "type": "string"
        },
        "relatedRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitoringMethod": {
          "type": "string"
        },
        "reportingFrequency": {
          "type": "string"
        },
        "penalties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correctiveActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
