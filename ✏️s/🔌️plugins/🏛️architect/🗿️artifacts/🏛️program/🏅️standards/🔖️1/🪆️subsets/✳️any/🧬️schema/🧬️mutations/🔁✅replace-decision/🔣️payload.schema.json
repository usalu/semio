{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision"
  ],
  "properties": {
    "decision": {
      "title": "Decision",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalStatus",
        "artifactRefs",
        "consultedIds",
        "context",
        "decisionMakerIds",
        "decisionStatement",
        "id",
        "impactedElementIds",
        "impactedRequirementIds",
        "informedIds",
        "name",
        "notes",
        "optionsConsidered",
        "ownership",
        "priority",
        "rationale",
        "reversalConditions",
        "riskImpact",
        "status",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "decisionStatement": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "context": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "optionsConsidered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selectedOptionId": {
          "type": "string"
        },
        "rationale": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "decisionMakerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consultedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "informedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisionDate": {
          "type": "string"
        },
        "effectiveDate": {
          "type": "string"
        },
        "reversalConditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impactedRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impactedElementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "costImpact": {
          "type": "number"
        },
        "scheduleImpact": {
          "type": "string"
        },
        "riskImpact": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvalStatus": {
          "type": "string",
          "enum": [
            "Pending",
            "Passed",
            "Failed",
            "Waived",
            "Deferred"
          ]
        },
        "meetingRef": {
          "type": "string"
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
