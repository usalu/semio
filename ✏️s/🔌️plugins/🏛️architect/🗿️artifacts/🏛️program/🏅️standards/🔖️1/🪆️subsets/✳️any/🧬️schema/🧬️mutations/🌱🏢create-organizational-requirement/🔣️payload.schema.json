{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateOrganizationalRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizationalRequirement"
  ],
  "properties": {
    "organizationalRequirement": {
      "title": "OrganizationalRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brandingRequirements",
        "cultureNotes",
        "decisionMaking",
        "department",
        "diversityGoals",
        "elementIds",
        "headcount",
        "hierarchyLevels",
        "id",
        "name",
        "notes",
        "ownership",
        "priority",
        "serviceRequirementIds",
        "stakeholderIds",
        "status",
        "tags",
        "timestamps",
        "trainingNeeds",
        "unionConsiderations",
        "wellnessPlugins",
        "workPatterns"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "department": {
          "type": "string"
        },
        "reportingLine": {
          "type": "string"
        },
        "headcount": {
          "title": "QuantitySpec",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            },
            "current": {
              "type": "number"
            },
            "forecast": {
              "type": "number"
            },
            "peak": {
              "type": "number"
            },
            "average": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "growthPlanId": {
          "type": "string"
        },
        "workPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collaborationModel": {
          "type": "string"
        },
        "hierarchyLevels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisionMaking": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cultureNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changeReadiness": {
          "type": "string"
        },
        "unionConsiderations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trainingNeeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stakeholderIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brandingRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wellnessPlugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diversityGoals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        }
      }
    }
  }
}
