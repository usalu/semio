{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document"
  ],
  "properties": {
    "document": {
      "title": "ArtifactRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessControls",
        "approverIds",
        "authorIds",
        "distributionList",
        "documentStatus",
        "documentType",
        "id",
        "name",
        "notes",
        "ownership",
        "priority",
        "relatedEntityIds",
        "reviewerIds",
        "status",
        "tags",
        "timestamps",
        "title",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "documentType": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "fileRef": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "authorIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewerIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approverIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issueDate": {
          "type": "string"
        },
        "revisionDate": {
          "type": "string"
        },
        "distributionList": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedEntityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classification": {
          "type": "string"
        },
        "retentionPeriod": {
          "type": "string"
        },
        "accessControls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "string"
        },
        "documentStatus": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "checksum": {
          "type": "string"
        },
        "sourceSystem": {
          "type": "string"
        }
      }
    }
  }
}
