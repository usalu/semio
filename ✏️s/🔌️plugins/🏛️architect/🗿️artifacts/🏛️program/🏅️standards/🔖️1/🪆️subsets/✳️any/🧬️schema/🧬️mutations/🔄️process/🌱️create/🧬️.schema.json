{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateProcess",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "process"
  ],
  "properties": {
    "process": {
      "title": "Process",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors",
        "bottlenecks",
        "category",
        "code",
        "criticalPath",
        "dependencies",
        "elementIds",
        "equipmentIds",
        "failureModes",
        "handoffPoints",
        "id",
        "improvementOpportunities",
        "inputs",
        "kpis",
        "name",
        "notes",
        "outputs",
        "ownership",
        "priority",
        "qualityGates",
        "regulatoryRefs",
        "status",
        "steps",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "code": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "equipmentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "criticalPath": {
          "type": "boolean"
        },
        "bottlenecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kpis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "automationLevel": {
          "type": "string"
        },
        "failureModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "improvementOpportunities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regulatoryRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        },
        "workflowType": {
          "type": "string"
        },
        "handoffPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualityGates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
