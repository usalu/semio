          "type": "string"
        },
        "resolvedDate": {
          "type": "string"
        },
        "relatedConflictIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedRiskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisionId": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "attachments": {
          "type": "array",
          "items": {
