{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceKnowledgeRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledgeRecord"
  ],
  "properties": {
    "knowledgeRecord": {
      "title": "KnowledgeRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicableSectors",
        "attachments",
        "authorIds",
        "bestPractices",
        "category",
        "citations",
        "content",
        "id",
        "keywords",
        "lessonsLearned",
        "name",
        "notes",
        "ownership",
        "priority",
        "references",
        "relatedEntityKinds",
        "sources",
        "status",
        "summary",
        "tags",
        "timestamps",
        "topic",
        "usageCount",
        "validationStatus"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "topic": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "summary": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "content": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lessonsLearned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bestPractices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicableSectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedEntityKinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authorIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expertiseLevel": {
          "type": "string"
        },
        "validationStatus": {
          "type": "string",
          "enum": [
            "Pending",
            "Passed",
            "Failed",
            "Waived",
            "Deferred"
          ]
        },
        "lastReviewed": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usageCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
