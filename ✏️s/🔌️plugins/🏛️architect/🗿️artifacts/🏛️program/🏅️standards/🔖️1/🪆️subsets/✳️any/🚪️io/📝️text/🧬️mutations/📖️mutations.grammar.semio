dialect grammar
grammar program.mutations
extension program
start line

line = create-register-row / delete-register-row / rename-register-row / replace-register-row
     / connect-adjacency / disconnect-adjacency / connect-trace / disconnect-trace
     / rename-meta / replace-meta / rename-project / replace-project
     / rename-governance / replace-governance

create-register-row = "create-register-row" SP register-row-block
delete-register-row = "delete-register-row" SP register SP id
rename-register-row = "rename-register-row" SP register SP id SP text
replace-register-row = "replace-register-row" SP register-row-block
register = "informationRequirement" / "sustainabilityRequirement" / "accessibilityRequirement" / "conflict" / "optionEvaluation" / "function" / "risk" / "decision" / "validationRecord" / "priorityRecord" / "flowRequirement" / "environmentalRequirement" / "workshop" / "scenario" / "benchmarkRecord" / "activity" / "infrastructureRequirement" / "organizationalRequirement" / "issue" / "approvalRecord" / "stakeholder" / "qualityRecord" / "resilienceRequirement" / "assumption" / "costRequirement" / "document" / "scheduleRequirement" / "growthPlan" / "performanceCriterion" / "operationalRequirement" / "requirement" / "siteContext" / "templateRecord" / "reportRecord" / "auditEvent" / "knowledgeRecord" / "regulatoryRequirement" / "communicationRequirement" / "resource" / "statusRecord" / "changeRecord" / "process" / "searchFilter" / "accessRule" / "privacyRequirement" / "quantityRequirement" / "analysisRecord" / "relationship" / "storageRequirement" / "meetingRecord" / "survey" / "deliveryConstraint" / "constraintRecord" / "complianceRecord" / "serviceRequirement" / "equipment" / "securityRequirement" / "collaborationRecord" / "safetyRequirement" / "userProfile" / "humanFactorRequirement" / "flexibilityRequirement" / "wayfindingRequirement" / "programElement"
register-row-block = "{" NL OCTET+ "}"
connect-adjacency = "connect-adjacency" SP adjacency-block
disconnect-adjacency = "disconnect-adjacency" SP id
connect-trace = "connect-trace" SP trace-block
disconnect-trace = "disconnect-trace" SP id
rename-meta = "rename-meta" SP text
replace-meta = "replace-meta" SP text
rename-project = "rename-project" SP text
replace-project = "replace-project" SP text
rename-governance = "rename-governance" SP text
replace-governance = "replace-governance" SP text

adjacency-block = "{" NL OCTET+ "}"
trace-block = "{" NL OCTET+ "}"
id = OCTET+
text = OCTET+
number = OCTET+
boolean = "true" / "false"
