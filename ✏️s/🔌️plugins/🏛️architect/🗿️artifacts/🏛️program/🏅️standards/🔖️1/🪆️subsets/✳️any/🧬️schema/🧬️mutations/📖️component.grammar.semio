dialect grammar
grammar architect.program.op
extension program
use family-sheet
start mutation

artifact-mark = "architect.program-op"
mutation = artifact-mark op-stmt+
op-stmt = "set-field" field+ | "patch-field" field+ | "remove-field" field+
field = ("architect.program-title" | "architect.program-clause" | "architect.program-quantity") "=" value
value = TEXT | INT | FLOAT | BOOL | QUANTITY
QUANTITY = FLOAT UNIT | INT UNIT
UNIT = IDENT
