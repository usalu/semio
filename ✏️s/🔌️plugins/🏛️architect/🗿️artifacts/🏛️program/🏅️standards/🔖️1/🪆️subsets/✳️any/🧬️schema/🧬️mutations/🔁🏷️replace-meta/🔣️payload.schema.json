{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceMeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "newMeta"
  ],
  "properties": {
    "newMeta": {
      "title": "ProgramMeta",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorIds",
        "classification",
        "documentId",
        "industrySector",
        "locale",
        "projectType",
        "purpose",
        "revision",
        "schema",
        "terminology",
        "timestamps",
        "title"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "purpose": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "terminology": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "industrySector": {
          "type": "string"
        },
        "projectType": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "authorIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sourceSystem": {
          "type": "string"
        },
        "exportProfile": {
          "type": "string"
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "integer",
              "minimum": 0
            },
            "updatedBy": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
