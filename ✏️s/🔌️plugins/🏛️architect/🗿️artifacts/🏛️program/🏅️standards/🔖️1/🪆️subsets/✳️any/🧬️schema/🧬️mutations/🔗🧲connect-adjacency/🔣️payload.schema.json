{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConnectAdjacency",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adjacency"
  ],
  "properties": {
    "adjacency": {
      "title": "Adjacency",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "circulationOverlap",
        "conflictIds",
        "connection",
        "elementAId",
        "elementBId",
        "id",
        "kind",
        "name",
        "normalized",
        "notes",
        "ownership",
        "priority",
        "separations",
        "sharedEntry",
        "sharedWall",
        "status",
        "tags",
        "timestamps",
        "trafficIsolation",
        "verificationStatus",
        "weight"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "elementAId": {
          "type": "string"
        },
        "elementBId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Required",
            "Preferred",
            "Optional",
            "Prohibited"
          ]
        },
        "connection": {
          "type": "string",
          "enum": [
            "Direct",
            "Indirect",
            "Controlled",
            "SharedAccess",
            "None"
          ]
        },
        "separations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Acoustic",
              "Visual",
              "Security",
              "Olfactory",
              "Thermal",
              "Fire",
              "Hygienic",
              "Circulation",
              "Operational",
              "InfectionControl"
            ]
          }
        },
        "weight": {
          "type": "number"
        },
        "rationale": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "distanceMaxM": {
          "type": "number"
        },
        "distanceMinM": {
          "type": "number"
        },
        "levelConstraint": {
          "type": "string"
        },
        "accessPath": {
          "type": "string"
        },
        "sharedWall": {
          "type": "boolean"
        },
        "sharedEntry": {
          "type": "boolean"
        },
        "trafficIsolation": {
          "type": "boolean"
        },
        "circulationOverlap": {
          "type": "boolean"
        },
        "conflictIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "normalized": {
          "type": "boolean"
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "Pending",
            "Passed",
            "Failed",
            "Waived",
            "Deferred"
          ]
        },
        "sourceRelationshipId": {
          "type": "string"
        },
        "internalExternalAccess": {
          "type": "string"
        }
      }
    }
  }
}
