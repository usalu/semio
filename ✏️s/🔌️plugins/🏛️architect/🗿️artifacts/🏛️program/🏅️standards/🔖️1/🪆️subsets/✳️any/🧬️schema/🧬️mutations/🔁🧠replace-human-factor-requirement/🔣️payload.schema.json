            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
