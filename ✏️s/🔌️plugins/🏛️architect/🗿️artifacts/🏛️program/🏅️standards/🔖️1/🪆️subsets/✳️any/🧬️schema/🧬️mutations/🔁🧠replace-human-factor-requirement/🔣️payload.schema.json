          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "socialInteraction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stressFactors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mitigationMeasures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trainingNeeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "researchBasis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
