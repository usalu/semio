        "fundingSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "riskFactors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisionPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenarioIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decommissionPlan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relocationStrategy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stakeholderImpact": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regulatoryConsiderations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        }
