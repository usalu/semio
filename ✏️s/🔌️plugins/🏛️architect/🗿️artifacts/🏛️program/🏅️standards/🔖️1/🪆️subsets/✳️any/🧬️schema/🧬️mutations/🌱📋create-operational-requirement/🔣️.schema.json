{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateOperationalRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationalRequirement"
  ],
  "properties": {
    "operationalRequirement": {
      "title": "OperationalRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contingencyPlan",
        "elementIds",
        "equipmentIds",
        "id",
        "kpiTargets",
        "name",
        "notes",
        "operation",
        "ownership",
        "priority",
        "processIds",
        "sopReferences",
        "staffing",
        "status",
        "tags",
        "timestamps",
        "trainingRequirements",
        "utilities",
        "wasteStreams"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "operation": {
          "type": "string"
        },
        "serviceLevel": {
          "type": "string"
        },
        "operatingHours": {
          "type": "string"
        },
        "staffing": {
          "title": "QuantitySpec",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            },
            "current": {
              "type": "number"
            },
            "forecast": {
              "type": "number"
            },
            "peak": {
              "type": "number"
            },
            "average": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "maintenanceInterval": {
          "type": "string"
        },
        "cleaningRegime": {
          "type": "string"
        },
        "turnaroundTime": {
          "type": "string"
        },
        "redundancy": {
          "type": "string"
        },
        "uptimeTarget": {
          "type": "number"
        },
        "responseTime": {
          "type": "string"
        },
        "equipmentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "utilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wasteStreams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contingencyPlan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trainingRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sopReferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kpiTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        },
        "serviceCategory": {
          "type": "string"
        },
        "shiftPattern": {
          "type": "string"
        },
        "slaTarget": {
          "type": "string"
        },
        "escalationContactId": {
          "type": "string"
        }
      }
    }
  }
}
