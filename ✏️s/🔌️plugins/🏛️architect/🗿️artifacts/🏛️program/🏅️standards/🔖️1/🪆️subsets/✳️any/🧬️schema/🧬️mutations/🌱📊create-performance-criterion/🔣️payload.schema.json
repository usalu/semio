{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreatePerformanceCriterion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "performanceCriterion"
  ],
  "properties": {
    "performanceCriterion": {
      "title": "PerformanceCriterion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "elementIds",
        "id",
        "metric",
        "name",
        "notes",
        "ownership",
        "priority",
        "requirementIds",
        "status",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "criterion": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "target": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "measurementMethod": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline": {
          "type": "number"
        },
        "benchmarkRef": {
          "type": "string"
        },
        "weight": {
          "type": "number"
        },
        "dataSource": {
          "type": "string"
        },
        "reportingCadence": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "verificationPlan": {
          "type": "string"
        },
        "penaltyThreshold": {
          "type": "number"
        },
        "incentiveThreshold": {
          "type": "number"
        }
      }
    }
  }
}
