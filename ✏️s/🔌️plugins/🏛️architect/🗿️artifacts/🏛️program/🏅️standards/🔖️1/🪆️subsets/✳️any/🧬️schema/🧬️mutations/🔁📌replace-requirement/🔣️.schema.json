{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement"
  ],
  "properties": {
    "requirement": {
      "title": "Requirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptanceCriteria",
        "childRequirementIds",
        "code",
        "conflictIds",
        "elementIds",
        "functionIds",
        "id",
        "kind",
        "name",
        "notes",
        "ownership",
        "priority",
        "regulatoryRefs",
        "riskIds",
        "stakeholderIds",
        "statement",
        "status",
        "tags",
        "timestamps",
        "traceLinks",
        "validationStatus"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "code": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Functional",
            "Spatial",
            "Performance",
            "Regulatory",
            "Operational",
            "Technical",
            "Aesthetic",
            "Sustainability"
          ]
        },
        "statement": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "rationale": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "source": {
          "type": "string"
        },
        "stakeholderIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "functionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parentRequirementId": {
          "type": "string"
        },
        "childRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verificationMethod": {
          "type": "string"
        },
        "validationStatus": {
          "type": "string",
          "enum": [
            "Pending",
            "Passed",
            "Failed",
            "Waived",
            "Deferred"
          ]
        },
        "conflictIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "riskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "costEstimate": {
          "type": "number"
        },
        "scheduleConstraint": {
          "type": "string"
        },
        "regulatoryRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traceLinks": {
          "type": "array",
          "items": {
            "title": "TraceLink",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromId",
              "id",
              "kind",
              "toId"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "fromId": {
                "type": "string"
              },
              "toId": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ObjectiveToRequirement",
                  "StakeholderToRequirement",
                  "UserToActivity",
                  "ActivityToFunction",
                  "FunctionToProgramElement",
                  "RequirementToDecision",
                  "RequirementToRisk",
                  "RequirementToStandard",
                  "RequirementToValidation",
                  "RequirementToApproval",
                  "RequirementToChange",
                  "EquipmentToActivity",
                  "ProcessToResource",
                  "ConstraintToImpact",
                  "ScenarioToDecision",
                  "IssueToAction",
                  "ActionToOwner",
                  "DecisionToOutcome",
                  "VersionToChange",
                  "FullAuditTrail"
                ]
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "supersededBy": {
          "type": "string"
        }
      }
    }
  }
}
