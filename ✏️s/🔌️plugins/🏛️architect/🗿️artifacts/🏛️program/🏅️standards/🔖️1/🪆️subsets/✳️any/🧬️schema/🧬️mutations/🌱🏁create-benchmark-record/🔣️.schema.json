{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateBenchmarkRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmarkRecord"
  ],
  "properties": {
    "benchmarkRecord": {
      "title": "BenchmarkRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicableElementKinds",
        "benchmarkName",
        "comparisonNotes",
        "id",
        "limitations",
        "metric",
        "name",
        "notes",
        "ownership",
        "priority",
        "relatedRequirementIds",
        "sector",
        "status",
        "tags",
        "timestamps",
        "unit",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "benchmarkName": {
          "type": "string"
        },
        "sector": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string"
        },
        "collectionYear": {
          "type": "integer",
          "minimum": 0
        },
        "geography": {
          "type": "string"
        },
        "buildingType": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "methodology": {
          "type": "string"
        },
        "applicableElementKinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relatedRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparisonNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        },
        "knowledgeId": {
          "type": "string"
        },
        "lastVerified": {
          "type": "string"
        }
      }
    }
  }
}
