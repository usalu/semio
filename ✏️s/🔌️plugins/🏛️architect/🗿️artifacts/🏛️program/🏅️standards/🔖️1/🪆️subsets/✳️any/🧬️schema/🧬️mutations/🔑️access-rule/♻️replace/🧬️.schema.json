{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceAccessRule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accessRule"
  ],
  "properties": {
    "accessRule": {
      "title": "AccessRule",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessLevel",
        "accessMode",
        "auditRequired",
        "authentication",
        "authorization",
        "badgeRequired",
        "biometricRequired",
        "emergencyOverride",
        "exceptions",
        "id",
        "name",
        "notes",
        "ownership",
        "priority",
        "regulatoryBasis",
        "resourceIds",
        "status",
        "subjectIds",
        "tags",
        "timeRestrictions",
        "timestamps",
        "trainingRequired",
        "zoneIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "subjectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessLevel": {
          "type": "string",
          "enum": [
            "Public",
            "Restricted",
            "Controlled",
            "Private",
            "Secure",
            "EmergencyOnly"
          ]
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "Unrestricted",
            "CardControlled",
            "Biometric",
            "Keyed",
            "EscortRequired",
            "TimeRestricted",
            "RoleBased",
            "EmergencyOnly"
          ]
        },
        "authentication": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authorization": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeRestrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "escortPolicy": {
          "type": "string"
        },
        "visitorPolicy": {
          "type": "string"
        },
        "emergencyOverride": {
          "type": "boolean"
        },
        "auditRequired": {
          "type": "boolean"
        },
        "badgeRequired": {
          "type": "boolean"
        },
        "biometricRequired": {
          "type": "boolean"
        },
        "zoneIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regulatoryBasis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enforcementMethod": {
          "type": "string"
        },
        "revocationPolicy": {
          "type": "string"
        },
        "trainingRequired": {
          "type": "boolean"
        },
        "ownerId": {
          "type": "string"
        }
      }
    }
  }
}
