{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreateEquipment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "equipment"
  ],
  "properties": {
    "equipment": {
      "title": "Equipment",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activityIds",
        "activityLinkIds",
        "category",
        "code",
        "commissioningNotes",
        "elementIds",
        "id",
        "installationRequirements",
        "maintenanceAccess",
        "name",
        "notes",
        "ownership",
        "priority",
        "quantity",
        "spareParts",
        "standards",
        "status",
        "tags",
        "timestamps",
        "utilityConnections"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "code": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "quantity": {
          "title": "QuantitySpec",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            },
            "current": {
              "type": "number"
            },
            "forecast": {
              "type": "number"
            },
            "peak": {
              "type": "number"
            },
            "average": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        "dimensions": {
          "type": "string"
        },
        "weightKg": {
          "type": "number"
        },
        "powerKw": {
          "type": "number"
        },
        "utilityConnections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ventilation": {
          "type": "string"
        },
        "noiseLevelDb": {
          "type": "number"
        },
        "clearance": {
          "type": "string"
        },
        "mounting": {
          "type": "string"
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maintenanceAccess": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycleYears": {
          "type": "integer",
          "minimum": 0
        },
        "replacementCost": {
          "type": "number"
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supplier": {
          "type": "string"
        },
        "activityLinkIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "installationRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commissioningNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spareParts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
