{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplaceInformationRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "informationRequirement"
  ],
  "properties": {
    "informationRequirement": {
      "title": "InformationRequirement",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessControls",
        "auditTrail",
        "backupRequirements",
        "destinationSystems",
        "disasterRecovery",
        "elementIds",
        "id",
        "informationType",
        "integrationPoints",
        "metadataRequirements",
        "name",
        "notes",
        "ownership",
        "priority",
        "privacyControls",
        "qualityCriteria",
        "stakeholderIds",
        "standards",
        "status",
        "tags",
        "timestamps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "title": "TextField",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Proposed",
            "UnderReview",
            "Validated",
            "Approved",
            "Rejected",
            "Deferred",
            "Superseded",
            "Archived",
            "Open",
            "Closed",
            "AtRisk",
            "Blocked",
            "InProgress",
            "Complete"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Mandatory",
            "Essential",
            "Preferred",
            "Optional",
            "Deferred",
            "Prohibited"
          ]
        },
        "ownership": {
          "title": "Ownership",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consultantIds",
            "participantIds"
          ],
          "properties": {
            "ownerId": {
              "type": "string"
            },
            "authorityId": {
              "type": "string"
            },
            "consultantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "participantIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "title": "TaggedNote",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "text"
            ],
            "properties": {
              "tag": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "timestamps": {
          "title": "TimestampMeta",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "updated"
          ],
          "properties": {
            "created": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            },
            "createdBy": {
              "type": "string"
            },
            "updatedBy": {
              "type": "string"
            }
          }
        },
        "informationType": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sourceSystem": {
          "type": "string"
        },
        "destinationSystems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updateFrequency": {
          "type": "string"
        },
        "retentionPeriod": {
          "type": "string"
        },
        "accessControls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classification": {
          "type": "string"
        },
        "qualityCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadataRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "integrationPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backupRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disasterRecovery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "privacyControls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auditTrail": {
          "type": "boolean"
        },
        "elementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stakeholderIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownerId": {
          "type": "string"
        }
      }
    }
  }
}
