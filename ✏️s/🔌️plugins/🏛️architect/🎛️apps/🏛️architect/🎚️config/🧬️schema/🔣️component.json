{
  "$id": "https://semio.tech/schema/app/architect/architect/config.json",
  "title": "ArchitectConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedIds",
    "activeRegister",
    "searchQuery",
    "searchHistoryJson",
    "activeReportJson",
    "lastResultJson",
    "lastAnalysisJson",
    "graphCameraX",
    "graphCameraY",
    "graphCameraZoom"
  ],
  "properties": {
    "selectedIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "config"
    },
    "activeRegister": {
      "type": "string",
      "x-semio-state": "config"
    },
    "searchQuery": {
      "type": "string",
      "x-semio-state": "config"
    },
    "searchHistoryJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "activeReportJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "lastResultJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "lastAnalysisJson": {
      "type": "string",
      "x-semio-state": "config"
    },
    "adjacencyKindFilter": {
      "type": "string",
      "enum": ["required", "preferred", "optional", "prohibited"],
      "x-semio-state": "config"
    },
    "graphCameraX": {
      "type": "number",
      "x-semio-state": "config"
    },
    "graphCameraY": {
      "type": "number",
      "x-semio-state": "config"
    },
    "graphCameraZoom": {
      "type": "number",
      "x-semio-state": "config"
    }
  }
}
