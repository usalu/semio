{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/vcs/vcs/mutation/change-counter/schema.json",
  "title": "ChangeCounter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mutation",
    "newCounter"
  ],
  "properties": {
    "mutation": {
      "const": "changeCounter"
    },
    "newCounter": {
      "type": "integer",
      "x-semio-ui": {
        "widget": "stepper",
        "role": "value",
        "label": {
          "en": "New Counter",
          "de": "Neuer Zähler"
        },
        "step": 1,
        "precision": 0
      }
    }
  }
}
