{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VCS SQLite Snapshot Laws",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot",
    "signed64",
    "invalidSigned64",
    "malformedSql",
    "control"
  ],
  "properties": {
    "snapshot": {
      "$ref": "https://json.schemas.assets.semio-tech.com/s/vcs/vcs/snapshot.json"
    },
    "signed64": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "pattern": "^-?[0-9]+$"
      }
    },
    "invalidSigned64": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^-?[0-9]+$"
      }
    },
    "malformedSql": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string"
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tagCount",
        "cancelAt",
        "largeTextBytes",
        "maxOwnedBytes",
        "tinyFileBytes"
      ],
      "properties": {
        "tagCount": {
          "const": 2048
        },
        "cancelAt": {
          "const": 256
        },
        "largeTextBytes": {
          "const": 131073
        },
        "maxOwnedBytes": {
          "const": 65536
        },
        "tinyFileBytes": {
          "const": 1024
        }
      }
    }
  }
}

