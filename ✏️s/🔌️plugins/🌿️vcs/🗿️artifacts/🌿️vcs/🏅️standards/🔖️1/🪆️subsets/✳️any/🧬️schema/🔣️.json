{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/vcs/vcs/artifact.json",
  "title": "VcsArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "counter",
    "notes",
    "status",
    "tags",
    "selectedCheckpointIds"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "counter": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "artifact"
    },
    "notes": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "status": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "artifact"
    },
    "selectedCheckpointIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-semio-state": "presence"
    }
  },
  "$defs": {
    "VcsRetainedCommandRoutes": {
      "allOf": [
        {
          "$ref": "https://semio.tech/schema/framework/ui/schema.json#/$defs/RetainedCommandRoutesDocument"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "routes"
          ],
          "properties": {
            "schema": {
              "const": "vcs.retained-command-routes.v1"
            },
            "routes": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "execution",
                  "lanes",
                  "reason"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "execution": {
                    "enum": [
                      "bounded-first-step",
                      "resumable"
                    ]
                  },
                  "lanes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "enum": [
                        "artifact",
                        "config",
                        "host-only"
                      ]
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ],
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
