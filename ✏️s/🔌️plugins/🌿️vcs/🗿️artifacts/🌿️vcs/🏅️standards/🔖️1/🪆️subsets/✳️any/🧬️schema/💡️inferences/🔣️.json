{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/vcs/vcs/inference.json",
  "title": "VcsInference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary"
  ],
  "properties": {
    "summary": {
      "$ref": "#/$defs/VcsSummary",
      "x-semio-derived": true
    }
  },
  "$defs": {
    "VcsSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tagCount",
        "notesWordCount",
        "hasNotes"
      ],
      "properties": {
        "tagCount": {
          "type": "integer"
        },
        "notesWordCount": {
          "type": "integer"
        },
        "hasNotes": {
          "type": "boolean"
        }
      }
    }
  }
}
