{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.dev/schema/vcs/retained-command-routes.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "routes"],
  "properties": {
    "schema": { "const": "vcs.retained-command-routes.v1" },
    "routes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "execution", "lanes", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "execution": { "enum": ["bounded-first-step", "resumable"] },
          "lanes": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "enum": ["artifact", "config", "host-only"] } },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
