{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/vcs/vcs/diff.json",
  "title": "VcsDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "schema": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "title": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "counter": {
      "type": "integer",
      "format": "int64",
      "x-semio-state": "artifact"
    },
    "notes": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "status": {
      "type": "string",
      "x-semio-state": "artifact"
    },
    "tags": {
      "$ref": "#/$defs/VcsTagsDelta",
      "x-semio-state": "artifact"
    }
  },
  "$defs": {
    "VcsTagsDelta": {
      "title": "VcsTagsDelta",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VcsTagRemoval"
          }
        },
        "inserted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VcsTagInsertion"
          }
        },
        "moved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VcsTagRelocation"
          }
        }
      }
    },
    "VcsTagRemoval": {
      "title": "VcsTagRemoval",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "VcsTagInsertion": {
      "title": "VcsTagInsertion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "row"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "row": {
          "type": "string"
        }
      }
    },
    "VcsTagRelocation": {
      "title": "VcsTagRelocation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    }
  }
}
