{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/s/vcs/schema.json",
  "$defs": {
    "VcsNativeOpenableIdentityAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "packageId",
        "artifactKind",
        "artifactSchema",
        "dialectKind",
        "standard",
        "subset",
        "viewerApp",
        "editorApp",
        "execution",
        "viewerWindowKindId",
        "rendererTarget"
      ],
      "properties": {
        "pluginId": {
          "const": "vcs"
        },
        "packageId": {
          "const": "semio:vcs"
        },
        "artifactKind": {
          "const": "vcs.vcs"
        },
        "artifactSchema": {
          "const": "vcs.vcs"
        },
        "dialectKind": {
          "const": "s.vcs.vcs"
        },
        "standard": {
          "const": "1"
        },
        "subset": {
          "const": "*"
        },
        "viewerApp": {
          "const": "s.vcs.vcs@1/*#viewer"
        },
        "editorApp": {
          "const": "s.vcs.vcs@1/*#editor"
        },
        "viewerWindowKindId": {
          "const": "framework.window.tree"
        },
        "rendererTarget": {
          "const": "wasm"
        },
        "execution": {
          "const": "isolated"
        }
      }
    },
    "VcsNativeOpenableIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "snapshotProtocolSha256",
        "authority",
        "hostileCases"
      ],
      "properties": {
        "schema": {
          "const": "semio.vcs.native-openable-identity/v1"
        },
        "snapshotProtocolSha256": {
          "const": "e16083d1e963d571b44c3cc4eac8d5d3992aeecf606cd4a4a6b1095c101605d3"
        },
        "authority": {
          "$ref": "#/$defs/VcsNativeOpenableIdentityAuthority"
        },
        "hostileCases": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "field",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "field": {
                "enum": [
                  "pluginId",
                  "packageId",
                  "artifactKind",
                  "artifactSchema",
                  "dialectKind",
                  "viewerApp",
                  "editorApp",
                  "execution",
                  "viewerWindowKindId",
                  "rendererTarget"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 128
              }
            }
          }
        }
      },
      "title": "VcsNativeOpenableIdentity"
    },
    "VcsNativeCodecsReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factoryId",
        "kind",
        "schema",
        "extension",
        "capability",
        "protocolPath",
        "protocolBytes",
        "protocolSha256"
      ],
      "properties": {
        "factoryId": {
          "const": "vcs.vcs.v1"
        },
        "kind": {
          "const": "s.vcs.vcs"
        },
        "schema": {
          "const": "vcs.vcs"
        },
        "extension": {
          "const": "vcs"
        },
        "capability": {
          "const": "s.vcs.vcs.codec.document"
        },
        "protocolPath": {
          "const": "🗿️artifacts/🌿️vcs/🏅️standards/🔖️1/🪆️subsets/✳️any/🚪️io/📸️snapshot/💾️binary/📡️.protocol.semio"
        },
        "protocolBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "protocolSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "VcsNativeCodecs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "pluginId",
        "packageId",
        "packageVersion",
        "receipts",
        "hostile"
      ],
      "properties": {
        "schema": {
          "const": "semio.vcs.native-codec-receipts/v1"
        },
        "pluginId": {
          "const": "vcs"
        },
        "packageId": {
          "const": "semio:vcs"
        },
        "packageVersion": {
          "const": "0.1.0"
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/VcsNativeCodecsReceipt"
          }
        },
        "hostile": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "enum": [
              "missing",
              "duplicate",
              "foreign-package",
              "wrong-version",
              "bare-kind",
              "legacy-schema",
              "legacy-kind",
              "wrong-extension",
              "zero-hash"
            ]
          },
          "uniqueItems": true
        }
      },
      "title": "VcsNativeCodecs",
      "description": "🌿️ The native-openable codec receipt projection VCS publishes to the hub: provider identity plus one receipt per artifact codec."
    }
  }
}
