{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/dev/flow/component.json",
  "title": "SFlowComposition",
  "type": "object",
  "$defs": {
    "SFlowCompositionV1": {
      "type": "object",
      "additionalProperties": false,
      "x-semio-formats": [
        "\ud83d\udd23\ufe0fjsonschema"
      ],
      "required": [
        "schema",
        "owner",
        "tests",
        "extensions"
      ],
      "properties": {
        "schema": {
          "const": "semio.s.flow-composition/v1"
        },
        "owner": {
          "const": "\u270f\ufe0fs/\ud83e\uddd1\u200d\ud83d\udcbbdev/\ud83c\udf0a\ufe0fflow"
        },
        "tests": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "laws"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "laws": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "extensions": {
          "const": [
            "bim",
            "brep",
            "dictionary",
            "draw",
            "list",
            "logic",
            "math",
            "primitive",
            "text"
          ]
        }
      }
    },
    "SFlowGeometryCompositionV1": {
      "x-semio-formats": [
        "\ud83d\udd23\ufe0fjsonschema"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operator",
        "boxes",
        "tessellationGrant",
        "maximumTessellationSteps"
      ],
      "properties": {
        "schema": {
          "const": "semio.s.flow-geometry-composition/v1"
        },
        "operator": {
          "const": "brep.prim3d.box"
        },
        "boxes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "depth",
              "height",
              "volume"
            ],
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "volume": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "tessellationGrant": {
          "type": "integer",
          "minimum": 1
        },
        "maximumTessellationSteps": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
