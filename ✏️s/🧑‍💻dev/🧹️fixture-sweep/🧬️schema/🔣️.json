{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://s.dev.fixture-sweep",
  "$ref": "#/$defs/SweepEvidence",
  "$defs": {
    "SweepEvidence": {
      "type": "object",
      "required": [
        "directories",
        "fixtures",
        "checks",
        "registered",
        "unmapped",
        "covered",
        "skipped"
      ],
      "additionalProperties": false,
      "properties": {
        "directories": {
          "type": "integer",
          "minimum": 1
        },
        "fixtures": {
          "type": "integer",
          "minimum": 1
        },
        "checks": {
          "type": "integer",
          "minimum": 1
        },
        "registered": {
          "type": "integer",
          "minimum": 1
        },
        "unmapped": {
          "type": "integer",
          "minimum": 0
        },
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
