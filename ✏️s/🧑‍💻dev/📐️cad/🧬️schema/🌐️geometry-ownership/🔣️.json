{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:cad:geometry-ownership:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kernelPackage",
    "sessionPackage",
    "kernelRoot",
    "sessionManifest",
    "moves",
    "formatOwner",
    "excludedKernelVerbs",
    "retainedSessionLaws"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "excludedKernelVerbs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "retainedSessionLaws": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "kernelPackage": {
      "type": "string",
      "minLength": 1
    },
    "sessionPackage": {
      "type": "string",
      "minLength": 1
    },
    "kernelRoot": {
      "type": "string",
      "minLength": 1
    },
    "sessionManifest": {
      "type": "string",
      "minLength": 1
    },
    "formatOwner": {
      "type": "string",
      "minLength": 1
    }
  }
}
