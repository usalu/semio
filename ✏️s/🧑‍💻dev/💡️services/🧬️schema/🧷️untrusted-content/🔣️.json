{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.s.services.untrusted-content-composition/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "lawPath",
    "plants"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "lawPath": {
      "const": "🧰️framework/🛍️products/💻️os/🔨️modules/🌉️mcp/🗿️artifact/🧫️fixtures/🧷️untrusted-content-law.json"
    },
    "plants": {
      "description": "How a collaborator writes the canary into a document, per lane: create `artifactKind`, then invoke `capabilityId` with `input`, every `{{canary}}` in its strings replaced by the canary.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "artifactKind",
          "capabilityId",
          "input"
        ],
        "properties": {
          "lane": {
            "enum": [
              "headless",
              "shell"
            ]
          },
          "artifactKind": {
            "type": "string",
            "minLength": 1
          },
          "capabilityId": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object"
          }
        }
      }
    }
  }
}
