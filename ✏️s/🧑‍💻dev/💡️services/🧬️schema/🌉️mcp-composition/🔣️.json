{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.s.services.mcp-composition-ownership/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "packageRoot",
    "genericProject",
    "genericPackageRoot",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "const": "@semio-tech/s-services-native"
    },
    "packageRoot": {
      "const": "✏️s/🧑‍💻dev/💡️services/📦️packages/🦀️rust"
    },
    "genericProject": {
      "const": "@semio-tech/framework-os-mcp-rs"
    },
    "genericPackageRoot": {
      "const": "🧰️framework/🛍️products/💻️os/🔨️modules/🌉️mcp/📦️packages/🦀️rust"
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "source",
          "removedSource",
          "command"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "removedSource": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
