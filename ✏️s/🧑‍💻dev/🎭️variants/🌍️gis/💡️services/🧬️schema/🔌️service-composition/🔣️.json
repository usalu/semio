{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.s.native-service-composition/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binary",
    "services",
    "initialStatus",
    "requestAction"
  ],
  "properties": {
    "schema": {
      "const": "semio.s.native-service-composition/v1"
    },
    "binary": {
      "const": "semio-s-gis-services-native"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "serviceId"
        ],
        "properties": {
          "owner": {
            "const": "gis"
          },
          "serviceId": {
            "const": "s.gis.gismap.inference"
          }
        }
      }
    },
    "initialStatus": {
      "const": {
        "phase": "idle",
        "jobId": null,
        "cursor": 0,
        "completed": 0,
        "total": 0,
        "proposalHash": null,
        "cancelRequested": false,
        "code": null
      }
    },
    "requestAction": {
      "const": "submit"
    }
  }
}
