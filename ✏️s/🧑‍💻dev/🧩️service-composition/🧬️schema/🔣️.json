{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "admission"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "installed",
          "cancel",
          "fail",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "installed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "cancel": {
            "enum": [
              "none",
              "before",
              "mount"
            ]
          },
          "fail": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "admission": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "accepted"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {},
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "definitions": {
    "browserInventory": {
      "type": "object",
      "required": [
        "plugins",
        "documentServices",
        "surfaceSessionFactories"
      ],
      "properties": {
        "plugins": {
          "type": "array"
        },
        "documentServices": {
          "type": "array"
        },
        "surfaceSessionFactories": {
          "type": "array"
        }
      }
    }
  }
}
