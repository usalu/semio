{
  "cases": [
    {
      "name": "Empty Inventory",
      "installed": [],
      "cancel": "none",
      "fail": null,
      "expected": []
    },
    {
      "name": "One Installed Owner",
      "installed": [
        "alpha"
      ],
      "cancel": "none",
      "fail": null,
      "expected": [
        "mount:alpha",
        "dispose:alpha"
      ]
    },
    {
      "name": "Ordered Owners",
      "installed": [
        "alpha",
        "beta",
        "gamma"
      ],
      "cancel": "none",
      "fail": null,
      "expected": [
        "mount:alpha",
        "mount:beta",
        "mount:gamma",
        "dispose:gamma",
        "dispose:beta",
        "dispose:alpha"
      ]
    },
    {
      "name": "Cancelled Before Mount",
      "installed": [
        "alpha"
      ],
      "cancel": "before",
      "fail": null,
      "expected": []
    },
    {
      "name": "Cancelled During Mount",
      "installed": [
        "alpha",
        "beta"
      ],
      "cancel": "mount",
      "fail": null,
      "expected": [
        "mount:alpha",
        "dispose:alpha"
      ]
    },
    {
      "name": "Mount Failure Rollback",
      "installed": [
        "alpha",
        "beta",
        "gamma"
      ],
      "cancel": "none",
      "fail": "beta",
      "expected": [
        "mount:alpha",
        "mount:beta",
        "dispose:alpha"
      ]
    }
  ],
