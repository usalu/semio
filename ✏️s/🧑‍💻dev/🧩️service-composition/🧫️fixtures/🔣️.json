        "dispose:alpha"
      ]
    },
    {
      "name": "Cancelled Before Mount",
      "installed": [
        "alpha"
      ],
      "cancel": "before",
      "fail": null,
      "expected": []
    },
    {
      "name": "Cancelled During Mount",
      "installed": [
        "alpha",
        "beta"
      ],
      "cancel": "mount",
      "fail": null,
      "expected": [
        "mount:alpha",
        "dispose:alpha"
      ]
    },
    {
      "name": "Mount Failure Rollback",
      "installed": [
        "alpha",
        "beta",
        "gamma"
      ],
      "cancel": "none",
      "fail": "beta",
