{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/dev/composition-laws/component.json",
  "title": "SCompositionLawContracts",
  "$defs": {
    "SCompositionLawsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "package",
        "suites",
        "retainedArtifactUnits"
      ],
      "properties": {
        "schema": {
          "const": "semio.test.s-composition-laws/v1"
        },
        "package": {
          "const": "semio-s-composition-laws"
        },
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "path",
              "previousPath",
              "sha256",
              "laws",
              "targetPath"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "previousPath": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "laws": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "targetPath": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "retainedArtifactUnits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "laws"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "laws": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  }
}
