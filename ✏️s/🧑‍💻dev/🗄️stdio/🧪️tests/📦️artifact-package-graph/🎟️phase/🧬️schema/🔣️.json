{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "function", "phases", "cases"],
  "properties": {
    "version": {"const": 1},
    "owner": {"type": "string", "minLength": 1, "maxLength": 256},
    "function": {"const": "stdioCargoMetadata"},
    "phases": {"const": ["entry", "tools", "cargo"]},
    "cases": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "cancelAtRecheck", "capture"],
        "properties": {
          "name": {"enum": ["live", "cancelled-generation"]},
          "cancelAtRecheck": {"type": "boolean"},
          "capture": {"type": "boolean"}
        }
      }
    }
  }
}
