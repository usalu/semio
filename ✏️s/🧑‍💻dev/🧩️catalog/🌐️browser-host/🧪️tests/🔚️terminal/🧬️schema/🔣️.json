{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "trace",
          "primary"
        ],
        "properties": {
          "kind": {
            "enum": [
              "error",
              "undefined",
              "success"
            ]
          },
          "trace": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "primary": {
            "enum": [
              "same-error",
              "undefined",
              "none"
            ]
          }
        }
      }
    }
  }
}
