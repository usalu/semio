{
  "name": "@semio-tech/s-dev-composition",
  "root": "✏️s/🧑‍💻dev",
  "projectType": "library",
  "tags": [
    "lang:typescript",
    "role:tool"
  ],
  "targets": {
    "composition-check": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts composition-check",
        "cwd": "✏️s/🧑‍💻dev",
        "forwardAllArgs": true
      }
    },
    "mcp-client-e2e": {
      "executor": "repo:script",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "@semio-tech/framework-os-mcp-rs"
          ]
        }
      ],
      "options": {
        "command": "bun ./📜️script.ts mcp-client-e2e",
        "cwd": "✏️s/🧑‍💻dev",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "source-check": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts source-check",
        "cwd": "✏️s/🧑‍💻dev",
        "forwardAllArgs": true
      }
    },
    "catalog-check": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts catalog-check",
        "cwd": "✏️s/🧑‍💻dev",
        "forwardAllArgs": true
      }
    },
    "jack-graph-check": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "command": "bun ./📜️script.ts jack-graph-check",
