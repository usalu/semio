      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts playground-session"
      }
    },
    "check-playground-session": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts playground-session check"
      }
    },
    "preview-playground-session": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts playground-session preview"
