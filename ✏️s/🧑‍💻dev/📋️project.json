{
  "name": "@semio-tech/s-dev-composition",
  "root": "✏️s/🧑‍💻dev",
  "projectType": "library",
  "tags": [
    "lang:typescript",
    "role:tool"
  ],
  "namedInputs": {
    "default": [
      "{workspaceRoot}/✏️s/**/*",
      "{workspaceRoot}/✏️s/**/*.{ts,tsx,json,semio,wit,sql}",
      "{workspaceRoot}/✏️s/tsconfig.json/**/*.{ts,tsx,json,semio,wit,sql}",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/**/*.{ts,tsx,json,semio,wit,sql}",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/📇️registry/📣️publication/🏗️build/🧪️tests/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/📇️registry/📣️publication/🧪️tests/**/*"
    ]
  },
  "targets": {
    "composition-check": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "command": "bun ./📜️script.ts composition-check",
        "cwd": "✏️s/🧑‍💻dev",
        "forwardAllArgs": true
      }
    },
    "mcp-client-e2e": {
      "executor": "repo:script",
      "cache": false,
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "@semio-tech/framework-os-mcp-rs"
          ]
        }
      ],
      "options": {
        "command": "bun ./📜️script.ts mcp-client-e2e",
        "cwd": "✏️s/🧑‍💻dev",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "source-check": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "command": "bun ./📜️script.ts source-check",
        "cwd": "✏️s/🧑‍💻dev",
        "forwardAllArgs": true
      }
    },
    "catalog-check": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "command": "bun ./📜️script.ts catalog-check",
        "cwd": "✏️s/🧑‍💻dev",
        "forwardAllArgs": true
      }
    },
    "jack-graph-check": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "command": "bun ./📜️script.ts jack-graph-check",
        "cwd": "✏️s/🧑‍💻dev",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/✏️s/**/*.{ts,tsx,json}",
        "{workspaceRoot}/🧰️framework/**/*.{ts,tsx,json}",
        "{workspaceRoot}/tsconfig.json",
        {"externalDependencies":["typescript"]}
      ],
      "cache": true,
      "dependsOn": [
        "@semio-tech/writer-writer:build",
        "@semio-tech/gis-gisterrain:build",
        "@semio-tech/gis-gismap-js:build",
        "@semio-tech/lowpoly-lowpoly:build",
        "@semio-tech/reasoning-wires:build",
        "@semio-tech/forms-js:build",
        "@semio-tech/space-home:build",
        "@semio-tech/space-space:build",
        "@semio-tech/stdio-docx:build",
        "@semio-tech/puzzle-plugin:wasm"
      ],
      "outputs": [],
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts typecheck",
        "forwardAllArgs": true
      }
    },
    "generate-playground-session": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [
        "{workspaceRoot}/✏️s/🧑‍💻dev/🤖️generated/🎮️playground-session/🟦️.ts"
      ],
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts playground-session"
      }
    },
    "check-playground-session": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts playground-session check"
      }
    },
    "preview-playground-session": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts playground-session preview"
      }
    },
    "verify-catalog": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts catalog-publication verify"
      }
    },
    "test-catalog-publication": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts catalog-publication-test"
      }
    },
    "generate": {
      "executor": "repo:script",
      "cache": true,
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts catalog-publication generate"
      },
      "outputs": [
        "{workspaceRoot}/✏️s/🧑‍💻dev/🧩️catalog/🤖️generated"
      ]
    },
    "check-generated": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts catalog-publication check"
      }
    },
    "preview-generated": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "✏️s/🧑‍💻dev",
        "command": "bun ./📜️script.ts catalog-publication preview"
      }
    }
  }
}
