{
  "name": "@semio-tech/mindmap-rs",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": ["{workspaceRoot}/✏️s/🔨️modules/💭️mindmap/**/*.rs", "{projectRoot}/**/*"]
  },
  "targets": {
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔨️modules/💭️mindmap/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts wasm"
      },
      "outputs": [
        "{projectRoot}/pkg"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔨️modules/💭️mindmap/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔨️modules/💭️mindmap/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔨️modules/💭️mindmap/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "✏️s/🔨️modules/💭️mindmap/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      }
    }
  }
}
