{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://fem/engine/analyses/merge-refusal",
  "title": "FEM assembly merge refusal and retry",
  "type": "object",
  "additionalProperties": false,
  "required": ["oracle", "cases"],
  "properties": {
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "implementation"],
      "properties": {
        "package": { "const": "fast-json-patch" },
        "version": { "const": "3.1.1" },
        "implementation": { "type": "string", "minLength": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "triplet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "row", "column", "value"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "row": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 },
        "value": { "type": "number" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCursor", "candidate", "destination"],
      "properties": {
        "sourceCursor": { "type": "integer", "minimum": 0 },
        "candidate": { "oneOf": [{ "$ref": "#/$defs/triplet" }, { "type": "null" }] },
        "destination": { "type": "array", "items": { "$ref": "#/$defs/triplet" } }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "sourceCursor", "candidate", "destinationCapacity", "destination", "refused", "retried"],
      "properties": {
        "lane": { "enum": ["full", "free"] },
        "sourceCursor": { "type": "integer", "minimum": 0 },
        "candidate": { "$ref": "#/$defs/triplet" },
        "destinationCapacity": { "type": "integer", "minimum": 1 },
        "destination": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/triplet" } },
        "refused": { "$ref": "#/$defs/state" },
        "retried": { "$ref": "#/$defs/state" }
      }
    }
  }
}
