{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:fem:geometric-cell-fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["tolerance", "oracle", "cases"],
  "properties": {
    "tolerance": { "type": "number", "exclusiveMinimum": 0 },
    "oracle": { "const": "mathjs-matrix-contraction-hermite-quadrature" },
    "cases": {
      "type": "array", "minItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "properties", "positions", "displacement", "matrix"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["bar3", "frame3", "tet4"] },
          "properties": {
            "type": "object", "additionalProperties": false, "required": ["e"],
            "properties": {
              "e": { "type": "number", "exclusiveMinimum": 0 },
              "a": { "type": "number", "exclusiveMinimum": 0 },
              "nu": { "type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5 },
              "roll": { "type": "number" }
            }
          },
          "positions": {
            "type": "array", "minItems": 2, "maxItems": 4,
            "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
          },
          "displacement": { "type": "array", "minItems": 6, "maxItems": 12, "items": { "type": "number" } },
          "matrix": { "type": "array", "minItems": 36, "maxItems": 144, "items": { "type": "number" } }
        }
      }
    }
  }
}
