{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workControlEntries",
    "workRetirementLanes",
    "stickyFaultCases",
    "matrixRestoreCases",
    "closeCases",
    "restoreFaultCases",
    "pageBytes",
    "headerBytes",
    "lengthBytes",
    "scalarBytes",
    "cases",
    "boundaryCases"
  ],
  "properties": {
    "workControlEntries": { "const": 12 },
    "workRetirementLanes": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "enum": [0, 11] } },
    "stickyFaultCases": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["first", "later", "expected"],
        "properties": {
          "first": { "enum": ["Admission", "Stale"] },
          "later": { "const": "Truncated" },
          "expected": { "enum": ["Admission", "Stale"] }
        }
      }
    },
    "matrixRestoreCases": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "rows", "cols", "length", "pageItems"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rows": { "type": "integer", "minimum": 0, "maximum": 64 },
          "cols": { "type": "integer", "minimum": 0, "maximum": 64 },
          "length": { "type": "integer", "minimum": 0, "maximum": 2048 },
          "pageItems": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "closeCases": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "grant", "expectedRetiredOwners"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "grant": { "enum": ["zero", "subexact", "exact"] },
          "expectedRetiredOwners": { "enum": [0, 1] }
        }
      }
    },
    "restoreFaultCases": {
      "type": "array", "minItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "continuation", "owner", "item", "length", "bodyBytes", "fault"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "continuation": { "type": "boolean" },
          "owner": { "type": "integer", "minimum": 0, "maximum": 2 },
          "item": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 0 },
          "bodyBytes": { "type": "integer", "minimum": 0, "maximum": 16352 },
          "fault": { "enum": ["Field", "Envelope", "Truncated"] }
        }
      }
    },
    "pageBytes": {
      "const": 16384
    },
    "headerBytes": {
      "const": 32
    },
    "lengthBytes": {
      "const": 8
    },
    "scalarBytes": {
      "const": 8
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "count",
          "pages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "item",
                "bytes",
                "scalars"
              ],
              "properties": {
                "owner": {
                  "enum": [
                    0,
                    1
                  ]
                },
                "item": {
                  "type": "integer",
                  "minimum": 0
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 32,
                  "maximum": 16384
                },
                "scalars": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "boundaryCases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "width",
          "remaining",
          "expected"
        ],
        "properties": {
          "kind": {
            "enum": [
              "length",
              "u32",
              "usize",
              "u64",
              "f64",
              "paged-u32",
              "paged-f64",
              "pair",
              "matrix-shape",
              "matrix-scalar"
            ]
          },
          "width": {
            "enum": [
              4,
              8,
              12,
              24
            ]
          },
          "remaining": {
            "type": "integer",
            "minimum": 0,
            "maximum": 24
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "committed",
              "owner",
              "item",
              "entry"
            ],
            "properties": {
              "committed": {
                "type": "boolean"
              },
              "owner": {
                "const": 1
              },
              "item": {
                "enum": [
                  0,
                  1
                ]
              },
              "entry": {
                "type": "array",
                "minItems": 4,
                "maxItems": 24,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            }
          }
        }
      }
    }
  }
}
