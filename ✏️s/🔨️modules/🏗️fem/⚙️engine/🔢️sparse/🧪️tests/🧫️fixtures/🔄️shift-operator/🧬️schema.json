{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "oracle", "relativeTolerance", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "oracle": { "type": "string" },
    "relativeTolerance": { "type": "number", "exclusiveMinimum": 0 },
    "cases": { "type": "array", "minItems": 4, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "order", "columns", "shift", "stiffness", "right", "x", "solved", "rhs"],
      "properties": {
        "name": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "shift": { "type": "number", "minimum": 0 },
        "stiffness": { "$ref": "#/$defs/matrix" }, "right": { "$ref": "#/$defs/matrix" },
        "x": { "$ref": "#/$defs/matrix" }, "solved": { "$ref": "#/$defs/matrix" }, "rhs": { "$ref": "#/$defs/matrix" }
      }
    } }
  },
  "$defs": {
    "vector": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "matrix": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vector" } }
  }
}
