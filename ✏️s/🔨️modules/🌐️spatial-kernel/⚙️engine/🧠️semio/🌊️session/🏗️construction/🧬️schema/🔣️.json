{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "families",
    "phases",
    "copyGrants",
    "cancelStops",
    "closePolicy",
    "terminalDrop",
    "stock",
    "fuel",
    "clock",
    "deadline",
    "sourceBinding",
    "foreignSourceEffects"
