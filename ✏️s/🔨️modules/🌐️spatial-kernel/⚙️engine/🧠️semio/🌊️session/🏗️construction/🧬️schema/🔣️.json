      "const": [
        "kernel",
        "cache",
        "claims",
        "authorityCounter",
        "retirement",
        "session"
      ]
    },
    "phases": {
      "const": [
        "bindSource",
        "reserveClaims",
        "insertClaim",
        "birthKernel",
        "birthCache",
        "birthClaims",
        "birthCounter",
        "birthRetirement",
        "birthSession",
