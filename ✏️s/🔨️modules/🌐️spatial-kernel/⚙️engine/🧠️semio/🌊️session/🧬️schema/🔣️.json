{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/s/modules/spatial-kernel/engines/semio/session/component.json",
  "title": "SemioGeometrySession",
  "description": "🌐️ First-party Semio session invocation verbs and explicit geometry authority laws.",
  "$defs": {
    "SemioGeometryVerb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "kernelOperation",
        "args",
        "result",
        "label"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z]*$"
        },
        "kernelOperation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemioGeometryArgument"
          }
        },
        "result": {
          "enum": [
            "handle",
            "handles",
            "number",
            "vec3",
            "string",
            "mesh",
            "topology",
            "unit"
          ]
        },
        "label": {
          "$ref": "#/$defs/SemioGeometryLabel"
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "SemioGeometryArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z]*$"
        },
        "type": {
          "enum": [
            "handle",
            "handles",
            "vec3",
            "points",
            "number",
            "integer",
            "boolean",
            "string"
          ]
        },
        "default": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "SemioGeometryLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "SemioGeometryVerbsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema",
        "verbs"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schema": {
          "const": "semio.flow.brep-invoke.verbs/v1"
        },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SemioGeometryVerb"
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "SemioGeometryCloseReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "items",
        "copyBytes",
        "capacityBytes",
        "releaseBytes"
      ],
      "properties": {
        "phase": {
          "enum": [
            "blocked",
            "pending",
            "complete"
          ]
        },
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "copyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "SemioTopologySelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edgeLabels": {
          "$ref": "#/$defs/SemioComponentLabels"
        },
        "faceLabels": {
          "$ref": "#/$defs/SemioComponentLabels"
        },
        "sourceHandle": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$",
          "default": ""
        }
      },
      "required": [
        "edgeLabels",
        "faceLabels",
        "sourceHandle"
      ]
    },
    "SemioComponentLabels": {
      "type": "array",
      "maxItems": 600000,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,19}$",
        "description": "Exact positive uint64 decimal persistent label, scoped to the source topology."
      }
    },
    "SemioGeometryCloseGrantV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "copyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    }
  },
  "$ref": "#/$defs/SemioGeometryCloseReceiptV1"
}
