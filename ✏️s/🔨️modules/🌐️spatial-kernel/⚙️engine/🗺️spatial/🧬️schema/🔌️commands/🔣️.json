{
  "type": "object",
  "required": [
    "schema",
    "command",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "s.spatial-kernel.command-contributions/v1"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operation",
          "expect"
        ],
        "additionalProperties": false,
        "properties": {
          "operation": {
            "enum": [
              "inspect",
              "register",
              "remove"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "expect": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
