workshop {
  machines=[ id=saw label="Generic Saw" icon-id=scissors capabilities=[ id=cut label=Cut icon-id=scissors parameters=[ id=kerf label=Kerf value=0.05m id=length label=Length value=0.5m id=depth label=Depth value=0.5m ]
  rules {
  }
  blade-cut kerf=kerf length=length depth=depth ] id=drill label="Generic Drill" icon-id=circle-dot capabilities=[ id=drill label=Drill icon-id=circle-dot parameters=[ id=radius label=Radius value=0.05m id=depth label=Depth value=0.3m ]
  rules {
  }
  bore-drill radius=radius depth=depth ] id=attacher label="Generic Attacher" icon-id=plus capabilities=[ id=attach label=Attach icon-id=plus parameters=[ id=radius label=Radius value=0.03m id=length label=Length value=0.2m ]
  rules {
  }
  cylinder-attach radius=radius length=length ] id=circularSaw label="Circular Saw" icon-id=scissors catalog-id=wood capabilities=[ id=crosscut label=Crosscut icon-id=scissors parameters=[ id=bladeDiameter label="Blade Diameter" value=0.184m id=kerf label=Kerf value=0.002m id=maxCutDepth label="Max Cut Depth" value=0.065m ]
  rules {
    max quantity=height parameter=maxCutDepth margin=0m
  }
  disc-cut diameter=bladeDiameter kerf=kerf ] id=tableSaw label="Table Saw" icon-id=scissors catalog-id=wood capabilities=[ id=rip label=Rip icon-id=scissors parameters=[ id=bladeDiameter label="Blade Diameter" value=0.315m id=kerf label=Kerf value=0.0032m id=maxCutDepth label="Max Cut Depth" value=0.102m id=fenceWidth label="Fence Width" value=0.8m ]
  rules {
    max quantity=height parameter=maxCutDepth margin=0m
    max quantity=width parameter=fenceWidth margin=0m
  }
  disc-cut diameter=bladeDiameter kerf=kerf ] id=drillPress label="Drill Press" icon-id=circle-dot catalog-id=wood capabilities=[ id=bore label=Bore icon-id=circle-dot parameters=[ id=bitRadius label="Bit Radius" value=0.005m id=strokeDepth label="Stroke Depth" value=0.1m id=throatDepth label="Throat Depth" value=0.16m ]
  rules {
    max quantity=height parameter=strokeDepth margin=0m
  }
  bore-drill radius=bitRadius depth=strokeDepth ] id=dowelJig label="Doweling Jig" icon-id=plus catalog-id=wood capabilities=[ id=dowel label=Dowel icon-id=plus parameters=[ id=dowelRadius label="Dowel Radius" value=0.004m id=dowelLength label="Dowel Length" value=0.04m id=minStockThickness label="Min Stock Thickness" value=0.018m ]
  rules {
    min quantity=height parameter=minStockThickness margin=0m
  }
  cylinder-attach radius=dowelRadius length=dowelLength ] ]
}
