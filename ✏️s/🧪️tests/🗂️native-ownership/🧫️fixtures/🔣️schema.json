{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "ownershipCases"],
  "properties": {
    "version": { "const": 1 },
    "ownershipCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "manifests", "boundaries", "accepted"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "accepted": { "type": "boolean" },
          "manifests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "source"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 }
              }
            }
          },
          "boundaries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["owner", "children"],
              "properties": {
                "owner": { "type": "string", "minLength": 1 },
                "children": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "members", "children", "accepted"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "members": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "children": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
