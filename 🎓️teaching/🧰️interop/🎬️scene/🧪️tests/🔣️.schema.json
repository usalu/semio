{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "frame",
    "positions",
    "threshold",
    "maxPixelDifference"
  ],
  "additionalProperties": false,
  "properties": {
    "frame": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "positions": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maxPixelDifference": {
      "type": "integer",
      "minimum": 0
    }
  }
}
