{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "mode",
    "command",
    "dependsOn",
    "cache",
    "continuous",
    "port",
    "portEnvironment",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "target": {
      "const": "serve-release"
    },
    "mode": {
      "const": "release"
    },
    "command": {
      "const": "repo ./📜️script.ts serve-release"
    },
    "dependsOn": {
      "const": [
        "build"
      ]
    },
    "cache": {
      "const": false
    },
    "continuous": {
      "const": true
    },
    "port": {
      "const": 8791
    },
    "portEnvironment": {
      "const": "PROCTOR_PORT"
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "requested",
          "accepted"
        ],
        "properties": {
          "target": {
            "enum": [
              "dev",
              "serve-release"
            ]
          },
          "requested": {
            "enum": [
              "prototype",
              "release"
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
