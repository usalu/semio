{
  "name": "@teaching/proctor",
  "$schema": "../../../../🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "root": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
  "sourceRoot": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
  "projectType": "application",
  "tags": [
    "lang:rust",
    "role:hub",
    "family:course"
  ],
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🎓️teaching/🛂️proctor/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/📚️course/**/*.rs",
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/**/*.rs",
      "{projectRoot}/**/*",
      "!{workspaceRoot}/🎓️teaching/🛂️proctor/**/target/**",
      "!{workspaceRoot}/🎓️teaching/🛂️proctor/**/dist/**",
      "sharedGlobals"
    ],
    "proctorRust": [
      "{workspaceRoot}/🎓️teaching/🛂️proctor/**/*.rs",
      "{workspaceRoot}/🎓️teaching/🛂️proctor/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/⏱️trace/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/⏱️trace/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/⏳️async/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/⏳️async/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/⚠️diagnostic/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/⚠️diagnostic/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/⚠️error/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/⚠️error/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/🔤️json/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/🔤️json/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/🚰️source/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/🚰️source/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/🧭️routing/🏠️workspace/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/🧭️routing/🏠️workspace/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/📡️replication/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/📡️replication/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🔀️dispatch/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🔀️dispatch/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🔏️hash/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🔏️hash/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🗣️dsl/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🗣️dsl/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/⏱️control/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/⏱️control/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🔤️base64/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🚪️io/🔤️base64/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/🧲️fixture-reader/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/🧲️fixture-reader/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/📶️state/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/📶️state/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🛍️products/📚️course/**/*.rs",
      "{workspaceRoot}/🧰️framework/🛍️products/📚️course/**/Cargo.toml",
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/**/*.rs",
      "{workspaceRoot}/🧰️framework/🛍️products/🖥️server/**/Cargo.toml",
      "{workspaceRoot}/🎓️teaching/Cargo.toml",
      "{workspaceRoot}/🎓️teaching/Cargo.lock",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/🧬️retained-clone/🌐️wire/🧬️schema/🔣️.json",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/🧬️retained-clone/🌐️wire/🧬️schema/🧾️progress.json",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/🧬️schema/🔗️.graphql",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/🧬️schema/🔣️.json",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/🧬️schema/🛰️.proto",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/🧬️schema/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/📚️course/🧬️schema/🔣️.json",
      "!{workspaceRoot}/**/target/**",
      "!{workspaceRoot}/**/dist/**",
      "!{workspaceRoot}/**/node_modules/**"
    ],
    "cargoSources": [
      "cargoToolchain",
      "proctorRust",
      "sharedGlobals",
      "{projectRoot}/📜️script.ts",
      "{workspaceRoot}/🎓️teaching/🛂️proctor/🏗️bootstrap/**/*.ts",
      "{workspaceRoot}/🎓️teaching/🛂️proctor/🏗️bootstrap/**/*.json",
      "!{workspaceRoot}/🎓️teaching/🛂️proctor/**/target/**"
    ],
    "cargoTests": [
      "cargoSources",
      "default",
      "{workspaceRoot}/🧰️framework/🛍️products/📚️course/🧫️fixtures/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/📚️course/🧬️schema/**/*"
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "inputs": [
        "cargoSources"
      ],
      "outputs": [
        "{projectRoot}/dist/build/prototype",
        "{projectRoot}/dist/build/release"
      ]
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "cache": true,
      "inputs": [
        "cargoTests"
      ],
      "outputs": []
    },
    "dev": {
      "metadata": {
        "semio": {
          "dashboard": {
            "ready": {
              "port": 8791,
              "portEnv": "PROCTOR_PORT"
            },
            "parameters": [
              {
                "id": "stack",
                "kind": "choice",
                "values": [
                  {
                    "id": "beside",
                    "env": {
                      "PROCTOR_PORT": "8793",
                      "PROCTOR_DATA": "{workspace}/.🧬semio/🎓️teaching/proctor-beside"
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts dev"
      },
      "cache": false,
      "continuous": true
    },
    "check": {
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts check",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [],
      "inputs": [
        "{projectRoot}/📜️script.ts",
        "sharedGlobals",
        {
          "dependentTasksOutputFiles": "**/receipt.json",
          "transitive": false
        },
        {
          "env": "SEMIO_TEST_LEVEL"
        },
        {
          "env": "SEMIO_TEST_BUDGET_MS"
        },
        {
          "env": "SEMIO_BUILD_BUDGET_MS"
        },
        "{workspaceRoot}/🎓️teaching/🏛️architecture/📚️course/**/*",
        {
          "env": "PROCTOR_COURSE"
        }
      ]
    },
    "rebuild": {
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts rebuild"
      },
      "cache": false,
      "metadata": {
        "semio": {
          "cache": {
            "version": 1,
            "class": "side-effecting",
            "reason": "mutates-host-store"
          }
        }
      }
    },
    "health": {
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts health"
      },
      "cache": false,
      "metadata": {
        "semio": {
          "cache": {
            "version": 1,
            "class": "live",
            "reason": "drives-running-process"
          }
        }
      }
    },
    "backup": {
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts backup",
        "forwardAllArgs": true
      },
      "cache": false,
      "metadata": {
        "semio": {
          "cache": {
            "version": 1,
            "class": "side-effecting",
            "reason": "mutates-host-store"
          }
        }
      }
    },
    "restore": {
      "metadata": {
        "semio": {
          "dashboard": {
            "parameters": [
              {
                "id": "file",
                "kind": "text",
                "required": true,
                "valuePositional": true
              }
            ]
          },
          "cache": {
            "version": 1,
            "class": "side-effecting",
            "reason": "mutates-host-store"
          }
        }
      },
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts restore",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "erase": {
      "metadata": {
        "semio": {
          "dashboard": {
            "parameters": [
              {
                "id": "handle",
                "kind": "text",
                "valueFlag": "--handle"
              },
              {
                "id": "tag",
                "kind": "text",
                "valueFlag": "--tag"
              },
              {
                "id": "learner",
                "kind": "text",
                "valueFlag": "--learner"
              },
              {
                "id": "dry-run",
                "kind": "flag",
                "args": [
                  "--dry-run"
                ]
              }
            ]
          },
          "cache": {
            "version": 1,
            "class": "side-effecting",
            "reason": "mutates-host-store"
          }
        }
      },
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts erase",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "prune": {
      "metadata": {
        "semio": {
          "dashboard": {
            "parameters": [
              {
                "id": "older-than",
                "kind": "text",
                "default": "7d",
                "required": true,
                "valueFlag": "--older-than"
              },
              {
                "id": "dry-run",
                "kind": "flag",
                "args": [
                  "--dry-run"
                ]
              }
            ]
          },
          "cache": {
            "version": 1,
            "class": "side-effecting",
            "reason": "mutates-host-store"
          }
        }
      },
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts prune",
        "forwardAllArgs": true
      },
      "cache": false
    },
    "capacity": {
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts capacity",
        "forwardAllArgs": true
      },
      "cache": false,
      "metadata": {
        "semio": {
          "cache": {
            "version": 1,
            "class": "live",
            "reason": "drives-running-process"
          }
        }
      }
    },
    "serve-release": {
      "executor": "repo:script",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "🎓️teaching/🛂️proctor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts serve-release"
      },
      "cache": false,
      "continuous": true,
      "metadata": {
        "semio": {
          "buildMode": {
            "fixed": "release"
          },
          "cache": {
            "version": 1,
            "class": "live",
            "reason": "drives-running-process"
          },
          "dashboard": {
            "ready": {
              "port": 8791,
              "portEnv": "PROCTOR_PORT"
            },
            "parameters": [
              {
                "id": "execution-mode",
                "title": {
                  "en": "Required build mode",
                  "de": "Erforderlicher Build-Modus"
                },
                "kind": "choice",
                "default": "release",
                "values": [
                  {
                    "id": "release",
                    "env": {
                      "SEMIO_BUILD_MODE": "release"
                    }
                  }
                ]
              },
              {
                "id": "stack",
                "title": {
                  "en": "Port and data directory",
                  "de": "Port und Datenverzeichnis"
                },
                "kind": "choice",
                "values": [
                  {
                    "id": "beside",
                    "env": {
                      "PROCTOR_PORT": "8793",
                      "PROCTOR_DATA": "{workspace}/.🧬semio/🎓️teaching/proctor-beside"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
