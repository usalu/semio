{
  "version": 1,
  "description": "--proctor of test-e2e resolves against the repository root, never the package directory; absolute values stay. Oracles: Python posixpath/ntpath.",
  "posix": [
    {
      "id": "posix-0",
      "root": "/repo",
      "value": "build/proctor",
      "expected": "/repo/build/proctor"
    },
    {
      "id": "posix-1",
      "root": "/repo",
      "value": "./dist/proctor",
      "expected": "/repo/dist/proctor"
    },
    {
      "id": "posix-2",
      "root": "/repo",
      "value": "/opt/proctor",
      "expected": "/opt/proctor"
    },
    {
      "id": "posix-3",
      "root": "/repo",
      "value": "../sibling/proctor",
      "expected": "/sibling/proctor"
    },
    {
      "id": "posix-4",
      "root": "/repo",
      "value": "a//b/../proctor",
      "expected": "/repo/a/proctor"
    }
  ],
  "win32": [
    {
      "id": "win32-0",
      "root": "C:\\repo",
      "value": "build\\proctor",
      "expected": "C:\\repo\\build\\proctor"
    },
    {
      "id": "win32-1",
      "root": "C:\\repo",
      "value": "dist/proctor.exe",
      "expected": "C:\\repo\\dist\\proctor.exe"
    },
    {
      "id": "win32-2",
      "root": "C:\\repo",
      "value": "D:\\tools\\proctor.exe",
      "expected": "D:\\tools\\proctor.exe"
    },
    {
      "id": "win32-3",
      "root": "C:\\repo",
      "value": "..\\sibling\\proctor.exe",
      "expected": "C:\\sibling\\proctor.exe"
    }
  ]
}
