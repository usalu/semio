{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "description",
    "posix",
    "win32"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "posix": {
      "$ref": "#/definitions/rows"
    },
    "win32": {
      "$ref": "#/definitions/rows"
    }
  },
  "definitions": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "root",
          "value",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
