{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 2,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "link", "accepted"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "link": { "enum": ["none", "generated", "nx"] },
      "accepted": { "type": "boolean" }
    },
    "oneOf": [
      { "properties": { "link": { "const": "none" }, "accepted": { "const": true } } },
      { "properties": { "link": { "enum": ["generated", "nx"] }, "accepted": { "const": false } } }
    ]
  }
}
