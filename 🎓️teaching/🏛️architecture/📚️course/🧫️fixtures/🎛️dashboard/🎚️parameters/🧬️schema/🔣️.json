{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architecture Course Dashboard Parameter Vectors",
  "type": "object",
  "required": ["targets", "cases", "invalid"],
  "additionalProperties": false,
  "properties": {
    "invalid": { "type": "array", "minItems": 5, "items": { "type": "object", "required": ["args", "error"], "additionalProperties": false, "properties": { "args": { "type": "array", "items": { "type": "string" } }, "error": { "type": "string" } } } },
    "targets": { "type": "object", "minProperties": 3, "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } },
    "cases": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "target", "values", "extra", "args", "env", "parsed"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "target": { "enum": ["test-e2e", "docker-stack-bundle", "docker-stack-check"] },
          "values": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "boolean" }] } },
          "extra": { "type": "array", "items": { "type": "string" } },
          "args": { "type": "array", "items": { "type": "string" } },
          "env": { "type": "object", "additionalProperties": { "type": "string" } },
          "parsed": { "type": "object" }
        }
      }
    }
  }
}
