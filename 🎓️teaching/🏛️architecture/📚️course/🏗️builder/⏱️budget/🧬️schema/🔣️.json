{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "environment", "requestedMilliseconds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "environment": { "type": "object", "additionalProperties": { "type": "string" } },
          "requestedMilliseconds": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
