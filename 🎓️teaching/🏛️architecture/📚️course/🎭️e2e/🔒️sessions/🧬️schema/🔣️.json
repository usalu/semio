{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serial", "failure", "trace"],
        "properties": {
          "serial": { "type": "boolean" },
          "failure": { "enum": [null, "rehearsal", "open dev"] },
          "trace": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
