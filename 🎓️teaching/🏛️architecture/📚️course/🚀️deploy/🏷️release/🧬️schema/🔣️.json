{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "revision", "imageId"],
  "properties": {
    "version": { "const": 1 },
    "revision": { "type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[a-f0-9]{40}$" },
    "imageId": { "type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "definitions": {
    "Tag": { "type": "string", "minLength": 81, "maxLength": 81, "pattern": "^sha-[a-f0-9]{12}-[a-f0-9]{64}$" }
  }
}
