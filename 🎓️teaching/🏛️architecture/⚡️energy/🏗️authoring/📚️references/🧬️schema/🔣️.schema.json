{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:teaching/energy/references",
  "title": "Reference registry of the energy videos",
  "type": "object",
  "required": ["version", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": ["de", "en"],
      "additionalProperties": false,
      "properties": {"de": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}}
    },
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "edition": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$"},
    "entry": {
      "type": "object",
      "required": ["id", "kind", "designation", "title", "status", "url", "verified", "locators"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["standard", "guideline", "law", "book", "article", "thesis", "agency", "dataset"]},
        "designation": {"type": "string", "minLength": 1},
        "edition": {"$ref": "#/$defs/edition"},
        "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "year": {"type": "integer", "minimum": 1800, "maximum": 2100},
        "editionNumber": {"type": "integer", "minimum": 1},
        "full": {"$ref": "#/$defs/text"},
        "title": {"$ref": "#/$defs/text"},
        "status": {"enum": ["current", "withdrawn", "superseded"]},
        "successor": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/text"},
        "citeAs": {"$ref": "#/$defs/text"},
        "shownWithoutStatus": {"type": "boolean"},
        "url": {"type": "string", "pattern": "^https://"},
        "verified": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "note": {"type": "string"},
        "locators": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/text"}
        },
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "publisher": {"type": "string"},
        "place": {"type": "string"},
        "isbn": {"type": "string", "pattern": "^978-[0-9]-[0-9]+-[0-9]+-[0-9]$"},
        "journal": {"type": "string"},
        "volume": {"type": "integer"},
        "pages": {"type": "string"},
        "doi": {"type": "string"},
        "institution": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["standard", "guideline"]}}}, "then": {"required": ["edition"]}},
        {"if": {"properties": {"kind": {"const": "law"}}}, "then": {"required": ["version", "full"]}},
        {"if": {"properties": {"kind": {"enum": ["book", "article", "thesis", "agency", "dataset"]}}}, "then": {"required": ["year", "authors"]}},
        {"if": {"properties": {"kind": {"const": "book"}}}, "then": {"required": ["publisher", "place"]}},
        {"if": {"properties": {"kind": {"const": "article"}}}, "then": {"required": ["journal", "volume", "pages"]}},
        {"if": {"properties": {"kind": {"const": "thesis"}}}, "then": {"required": ["institution"]}},
        {"if": {"properties": {"status": {"enum": ["withdrawn", "superseded"]}}}, "then": {"required": ["successor"]}}
      ]
    }
  }
}
