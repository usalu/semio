{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inline TeX symbol table of narration clauses",
  "description": "Every command the narration TeX subset accepts besides the structural ones (frac, dot, sqrt, mathrm, text, textcolor, left, right). Caption typesetting, plain-text rendering and the spoken lexicon all derive from this one table.",
  "type": "object",
  "required": ["symbols", "spaces"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "symbols": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z]+$"},
      "additionalProperties": {
        "type": "object",
        "required": ["char", "kind"],
        "additionalProperties": false,
        "properties": {
          "char": {"type": "string", "minLength": 1, "maxLength": 1},
          "kind": {"enum": ["letter", "binary", "relation", "ordinary"]},
          "alias": {"type": "string", "pattern": "^[A-Za-z]+$"}
        }
      }
    },
    "spaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["char", "width"],
        "additionalProperties": false,
        "properties": {
          "char": {"type": "string", "maxLength": 1},
          "width": {"type": "number"}
        }
      }
    }
  }
}
