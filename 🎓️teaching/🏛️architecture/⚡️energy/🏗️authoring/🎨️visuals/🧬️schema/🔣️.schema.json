{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architectural Energy Drawing Contract",
  "type": "object",
  "required": [
    "version",
    "dimensions",
    "section_material"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "dimensions": {
      "type": "object",
      "required": [
        "radiator_height",
        "radiator_width",
        "house_wall",
        "storey_height"
      ],
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "section_material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "fill_opacity",
        "stroke_width",
        "stroke_opacity"
      ],
      "properties": {
        "color": {
          "const": "light"
        },
        "fill_opacity": {
          "const": 1
        },
        "stroke_width": {
          "const": 0
        },
        "stroke_opacity": {
          "const": 0
        }
      }
    }
  }
}
