{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact Semio Presentation Window Geometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rect",
    "title",
    "control",
    "body",
    "surface",
    "outline",
    "border_outline",
    "top_chips",
    "title_text",
    "metrics"
  ],
  "properties": {
    "rect": {
      "$ref": "#/$defs/rect"
    },
    "title": {
      "$ref": "#/$defs/rect"
    },
    "control": {
      "$ref": "#/$defs/rect"
    },
    "body": {
      "$ref": "#/$defs/rect"
    },
    "surface": {
      "$ref": "#/$defs/rect"
    },
    "outline": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "border_outline": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "top_chips": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "title_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "font_size",
        "line_height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "font_size": {
          "type": "number"
        },
        "line_height": {
          "type": "number"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spacing",
        "navbar_height",
        "footer_height",
        "title_height",
        "control_size",
        "icon_size",
        "title_font_size",
        "title_line_height",
        "title_max_width",
        "inset",
        "path_inset",
        "border_width"
      ],
      "properties": {
        "spacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "navbar_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "footer_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "title_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "control_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "icon_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "title_font_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "title_line_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "title_max_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "inset": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "path_inset": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "border_width": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
