{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable Actual UI Boundary Asset",
  "type": "object",
  "required": [
    "version",
    "identity",
    "sha256",
    "size",
    "metadata"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
