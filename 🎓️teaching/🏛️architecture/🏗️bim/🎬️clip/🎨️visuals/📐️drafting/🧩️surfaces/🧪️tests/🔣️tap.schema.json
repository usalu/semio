{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "facets"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "facets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rings",
          "normal",
          "material"
        ],
        "additionalProperties": false,
        "properties": {
          "rings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "normal": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 3,
            "maxItems": 3
          },
          "material": {
            "type": "object",
            "required": [
              "appearance",
              "material"
            ],
            "properties": {
              "appearance": {
                "type": "string"
              },
              "material": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
