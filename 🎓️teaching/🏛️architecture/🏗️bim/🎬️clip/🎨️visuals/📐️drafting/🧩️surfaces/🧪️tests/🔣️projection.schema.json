{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Captured projected beam facets",
  "type": "object",
  "required": [
    "facets",
    "matrix",
    "exact_ring"
  ],
  "additionalProperties": false,
  "properties": {
    "matrix": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "facets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "rings",
          "material"
        ],
        "properties": {
          "rings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "material": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "exact_ring": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        }
      }
    }
  }
}