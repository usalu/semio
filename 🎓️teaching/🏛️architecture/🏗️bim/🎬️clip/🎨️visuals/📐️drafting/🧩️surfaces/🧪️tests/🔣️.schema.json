{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cases",
    "visible_cases",
    "coverage_cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "boxes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "annulus": {
            "type": "object",
            "required": [
              "outer",
              "inner",
              "z"
            ],
            "additionalProperties": false,
            "properties": {
              "outer": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "inner": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "z": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "boxes"
            ]
          },
          {
            "required": [
              "annulus"
            ]
          }
        ]
      }
    },
    "visible_cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "facets"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "facets": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "rings",
                "material"
              ],
              "additionalProperties": false,
              "properties": {
                "material": {
                  "type": "string"
                },
                "rings": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "coverage_cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "opacity",
          "split"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "split": {
            "type": "number"
          }
        }
      }
    }
  }
}