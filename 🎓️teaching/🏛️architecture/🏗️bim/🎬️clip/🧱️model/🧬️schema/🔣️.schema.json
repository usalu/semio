{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Villa Savoye BIM Teaching Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "languages", "revision", "schema_id", "orientation_note", "notes", "classes", "property_names", "project", "site", "building", "storeys", "grid", "types", "materials", "elements", "spaces", "relations", "models", "loads", "car", "rules", "demo_events", "translation", "links"],
  "properties": {
    "version": {"const": 2},
    "languages": {"const": ["en", "de"]},
    "revision": {"type": "integer", "minimum": 1},
    "schema_id": {"const": "IFC4X3_ADD2"},
    "orientation_note": {"$ref": "#/$defs/localized"},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": {"id": {"$ref": "#/$defs/tag"}, "text": {"$ref": "#/$defs/localized"}}}},
    "classes": {"type": "object", "minProperties": 10, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["supertype", "adds"],
      "properties": {"supertype": {"type": ["string", "null"], "pattern": "^Ifc[A-Za-z]+$"}, "adds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}},
    "property_names": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["name", "unit"],
      "properties": {"name": {"$ref": "#/$defs/localized"}, "unit": {"type": "string"}, "meaning": {"$ref": "#/$defs/localized"}}}},
    "project": {"$ref": "#/$defs/spatial"},
    "site": {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "class", "name", "address", "latitude", "longitude"],
      "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"}, "class": {"const": "IfcSite"}, "name": {"$ref": "#/$defs/localized"}, "address": {"type": "string", "minLength": 1},
        "latitude": {"$ref": "#/$defs/quantity"}, "longitude": {"$ref": "#/$defs/quantity"}}},
    "building": {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "class", "name", "architects", "clients", "years", "box"],
      "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"}, "class": {"const": "IfcBuilding"}, "name": {"$ref": "#/$defs/localized"},
        "architects": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "clients": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "years": {"type": "object", "additionalProperties": false, "required": ["design_start", "completed", "listed", "restoration_start", "restoration_end", "unesco", "basis"],
          "properties": {"design_start": {"type": "integer"}, "completed": {"type": "integer"}, "listed": {"type": "integer"}, "restoration_start": {"type": "integer"},
            "restoration_end": {"type": "integer"}, "unesco": {"type": "integer"}, "basis": {"$ref": "#/$defs/basis"}}},
        "box": {"type": "object", "additionalProperties": false, "required": ["length", "width", "height"],
          "properties": {"length": {"$ref": "#/$defs/positive"}, "width": {"$ref": "#/$defs/positive"}, "height": {"$ref": "#/$defs/positive"}}}}},
    "storeys": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "id", "class", "name", "elevation"],
      "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"}, "id": {"enum": ["ground", "first", "roof"]}, "class": {"const": "IfcBuildingStorey"},
        "name": {"$ref": "#/$defs/localized"}, "elevation": {"$ref": "#/$defs/quantity"}}}},
    "grid": {"type": "object", "additionalProperties": false, "required": ["x", "y", "labels_x", "labels_y", "spacing", "initial_spacing"],
      "properties": {"x": {"$ref": "#/$defs/axes"}, "y": {"$ref": "#/$defs/axes"}, "labels_x": {"$ref": "#/$defs/labels"}, "labels_y": {"$ref": "#/$defs/labels"},
        "spacing": {"$ref": "#/$defs/positive"}, "initial_spacing": {"$ref": "#/$defs/positive"}}},
    "types": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/type"}},
    "materials": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/material"}},
    "elements": {"type": "array", "minItems": 25, "items": {"$ref": "#/$defs/element"}},
    "spaces": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/space"}},
    "relations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "class", "relating", "related", "name"],
      "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"},
        "class": {"enum": ["IfcRelAggregates", "IfcRelContainedInSpatialStructure", "IfcRelDefinesByType", "IfcRelVoidsElement", "IfcRelFillsElement", "IfcRelAssociatesMaterial", "IfcRelConnectsElements"]},
        "relating": {"$ref": "#/$defs/tag"}, "related": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tag"}}, "name": {"$ref": "#/$defs/localized"}}}},
    "models": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["id", "schema_id", "author", "name", "revision", "element_tags"],
      "properties": {"id": {"enum": ["architecture", "structure", "services"]}, "schema_id": {"const": "IFC4X3_ADD2"}, "author": {"type": "string", "minLength": 1}, "author_label": {"$ref": "#/$defs/localized"}, "name": {"$ref": "#/$defs/localized"},
        "revision": {"type": "integer", "minimum": 1}, "element_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}}}}},
    "loads": {"type": "object", "additionalProperties": false, "required": ["finishes", "imposed"],
      "properties": {"finishes": {"type": "object", "additionalProperties": false, "required": ["first"], "properties": {"first": {"$ref": "#/$defs/positive"}}},
        "imposed": {"type": "object", "additionalProperties": false, "required": ["first", "roof_planted", "solarium"],
          "properties": {"first": {"$ref": "#/$defs/positive"}, "roof_planted": {"$ref": "#/$defs/positive"}, "solarium": {"$ref": "#/$defs/positive"}}}}},
    "car": {"type": "object", "additionalProperties": false, "required": ["name", "length", "width", "turning_radius", "wall_clearance", "min_side_margin"],
      "properties": {"name": {"$ref": "#/$defs/localized"}, "length": {"$ref": "#/$defs/positive"}, "width": {"$ref": "#/$defs/positive"}, "turning_radius": {"$ref": "#/$defs/positive"},
        "wall_clearance": {"$ref": "#/$defs/positive"}, "min_side_margin": {"$ref": "#/$defs/positive"}}},
    "rules": {"type": "object", "additionalProperties": false, "required": ["clearance", "ids"],
      "properties": {"clearance": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "a_class", "a_system", "b_class", "required"],
        "properties": {"id": {"$ref": "#/$defs/tag"}, "name": {"$ref": "#/$defs/localized"}, "a_class": {"$ref": "#/$defs/ifc_class"}, "a_system": {"type": "string", "minLength": 1},
          "b_class": {"$ref": "#/$defs/ifc_class"}, "required": {"$ref": "#/$defs/positive"}}}},
        "ids": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "entity", "pset", "property", "cardinality"],
          "properties": {"id": {"$ref": "#/$defs/tag"}, "name": {"$ref": "#/$defs/localized"}, "entity": {"$ref": "#/$defs/ifc_class"}, "pset": {"type": "string", "pattern": "^Pset_[A-Za-z]+$"},
            "property": {"type": "string", "minLength": 1}, "cardinality": {"enum": ["required", "optional", "prohibited"]}}}}}},
    "demo_events": {"type": "object", "additionalProperties": false, "required": ["sill", "roof_soil", "roof_soil_alt"],
      "properties": {"sill": {"$ref": "#/$defs/event_opening"}, "roof_soil": {"$ref": "#/$defs/event_layer"}, "roof_soil_alt": {"$ref": "#/$defs/event_layer"}}},
    "translation": {"type": "object", "additionalProperties": false, "required": ["id", "source_schema", "target_schema", "target_domain", "mesh", "boundary", "mapping", "assumptions", "losses"],
      "properties": {"id": {"$ref": "#/$defs/tag"}, "source_schema": {"const": "IFC4X3_ADD2"}, "target_schema": {"type": "string", "minLength": 1}, "target_domain": {"type": "string", "pattern": "^Ifc[A-Za-z]+$"},
        "mesh": {"type": "object", "additionalProperties": false, "required": ["x_lines", "y_lines", "surface_source", "node_level"],
          "properties": {"x_lines": {"type": "array", "minItems": 2, "items": {"type": "number"}}, "y_lines": {"const": "grid"}, "surface_source": {"$ref": "#/$defs/tag"}, "node_level": {"const": "mid-surface"}}},
        "boundary": {"type": "object", "additionalProperties": false, "required": ["id", "class", "en", "de", "basis"],
          "properties": {"id": {"type": "string", "minLength": 1}, "class": {"const": "IfcBoundaryNodeCondition"}, "en": {"type": "string", "minLength": 1}, "de": {"type": "string", "minLength": 1}, "basis": {"$ref": "#/$defs/basis"}}},
        "mapping": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_class", "target_class", "kind", "en", "de"],
          "properties": {"source_class": {"$ref": "#/$defs/ifc_class"}, "source_predefined": {"type": "string"}, "target_class": {"type": "string", "pattern": "^Ifc[A-Za-z]+$"},
            "kind": {"enum": ["curve", "surface", "support"]}, "en": {"type": "string", "minLength": 1}, "de": {"type": "string", "minLength": 1}}}},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "en", "de", "basis"],
          "properties": {"id": {"$ref": "#/$defs/tag"}, "en": {"type": "string", "minLength": 1}, "de": {"type": "string", "minLength": 1}, "basis": {"$ref": "#/$defs/basis"}}}},
        "losses": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["applies_to", "property", "en", "de"],
          "properties": {"applies_to": {"type": "object", "additionalProperties": false, "required": ["class"], "properties": {"class": {"$ref": "#/$defs/loss_selector_class"}, "predefined_type": {"type": "string"}}},
            "property": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}, "de": {"type": "string", "minLength": 1}}}}}},
    "links": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "model", "kind", "object_guid", "source_revision", "used"],
      "properties": {"id": {"$ref": "#/$defs/tag"}, "model": {"const": "analysis"}, "kind": {"enum": ["slab-load", "roof-load", "piloti-section"]}, "object_guid": {"$ref": "#/$defs/guid"},
        "source_revision": {"type": "integer", "minimum": 1}, "used": {"type": "object", "additionalProperties": {"type": "number"}}}}}
  },
  "$defs": {
    "localized": {"type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": {"en": {"type": "string", "minLength": 1}, "de": {"type": "string", "minLength": 1}}},
    "guid": {"type": "string", "pattern": "^[0-3][0-9A-Za-z_$]{21}$"},
    "tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "basis": {"enum": ["sourced", "assumed", "inferred"]},
    "unit": {"enum": ["m", "m²", "m³", "kN", "kN/m²", "kN/m³", "°"]},
    "ifc_class": {"enum": ["IfcColumn", "IfcSlab", "IfcWall", "IfcWindow", "IfcOpeningElement", "IfcCurtainWall", "IfcRamp", "IfcRampFlight", "IfcBoiler", "IfcSpaceHeater", "IfcWasteTerminal", "IfcPipeSegment"]},
    "loss_selector_class": {"anyOf": [{"$ref": "#/$defs/ifc_class"}, {"$ref": "#/$defs/space/properties/class"}]},
    "level": {"enum": ["ground", "first", "roof"]},
    "quantity": {"type": "object", "additionalProperties": false, "required": ["value", "unit", "basis"],
      "properties": {"value": {"type": "number"}, "unit": {"$ref": "#/$defs/unit"}, "basis": {"$ref": "#/$defs/basis"}, "source": {"type": "string", "minLength": 1}}},
    "positive": {"type": "object", "additionalProperties": false, "required": ["value", "unit", "basis"],
      "properties": {"value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"$ref": "#/$defs/unit"}, "basis": {"$ref": "#/$defs/basis"}, "source": {"type": "string", "minLength": 1}}},
    "axes": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number", "minimum": 0}},
    "labels": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "point2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "point3": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"type": "number"}, {"type": "number"}, {"anyOf": [{"type": "number"}, {"type": "string"}]}], "items": false},
    "arc": {"type": "object", "additionalProperties": false, "required": ["arc"],
      "properties": {"arc": {"type": "object", "additionalProperties": false, "required": ["centre", "radius", "start", "end"],
        "properties": {"centre": {"$ref": "#/$defs/point2"}, "radius": {"type": "number", "exclusiveMinimum": 0}, "start": {"type": "number"}, "end": {"type": "number"}}}}},
    "arc_of": {"type": "object", "additionalProperties": false, "required": ["arc_of"], "properties": {"arc_of": {"$ref": "#/$defs/tag"}, "reverse": {"type": "boolean"}}},
    "outline_item": {"oneOf": [{"$ref": "#/$defs/point2"}, {"$ref": "#/$defs/arc"}, {"$ref": "#/$defs/arc_of"}]},
    "outline": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/outline_item"}},
    "property": {"type": "object", "additionalProperties": false, "required": ["value", "ifc_type", "basis"],
      "properties": {"value": {"anyOf": [{"type": "boolean"}, {"type": "string"}, {"type": "number"}]}, "ifc_type": {"enum": ["IfcBoolean", "IfcLabel", "IfcText", "IfcReal"]}, "basis": {"$ref": "#/$defs/basis"}, "source": {"type": "string", "minLength": 1}}},
    "psets": {"type": "object", "additionalProperties": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/property"}}},
    "attributes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/positive"}},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["author", "revision", "domains"],
      "properties": {"author": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1},
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["architecture", "structure", "services"]}}}},
    "spatial": {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "class", "name"],
      "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"}, "class": {"const": "IfcProject"}, "name": {"$ref": "#/$defs/localized"}}},
    "geometry": {"type": "object", "additionalProperties": false,
      "properties": {"axis": {"$ref": "#/$defs/point2"}, "base_level": {"$ref": "#/$defs/level"}, "top_level": {"type": "string", "pattern": "^(ground|first|roof|overall|soffit:[A-Za-z0-9-]+)$"},
        "outline": {"$ref": "#/$defs/outline"}, "voids": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["tag", "outline"],
          "properties": {"tag": {"$ref": "#/$defs/tag"}, "outline": {"$ref": "#/$defs/outline"}}}},
        "level": {"$ref": "#/$defs/level"}, "zones": {"type": "object", "additionalProperties": {"$ref": "#/$defs/tag"}},
        "path": {"$ref": "#/$defs/outline"}, "wall": {"$ref": "#/$defs/tag"}, "opening": {"$ref": "#/$defs/tag"}, "ramp": {"$ref": "#/$defs/tag"},
        "centre": {"$ref": "#/$defs/point2"}, "south_y": {"type": "number"}, "radius_from": {"const": "car"},
        "from_level": {"$ref": "#/$defs/level"}, "to_level": {"$ref": "#/$defs/level"},
        "portion": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "landings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["outline", "portion"],
          "properties": {"outline": {"$ref": "#/$defs/outline"}, "portion": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point3"}},
        "size": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}}}},
    "element": {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "class", "predefined_type", "name", "storey", "geometry", "attributes", "metadata"],
      "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"}, "class": {"$ref": "#/$defs/ifc_class"}, "predefined_type": {"type": "string", "pattern": "^[A-Z_]+$"},
        "name": {"$ref": "#/$defs/localized"}, "storey": {"$ref": "#/$defs/level"}, "type": {"$ref": "#/$defs/tag"}, "material": {"$ref": "#/$defs/tag"},
        "system": {"enum": ["heating", "rainwater"]}, "geometry": {"$ref": "#/$defs/geometry"}, "attributes": {"$ref": "#/$defs/attributes"}, "psets": {"$ref": "#/$defs/psets"},
        "metadata": {"$ref": "#/$defs/metadata"}}},
    "space": {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "class", "predefined_type", "name", "storey", "outline", "metadata"],
      "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"}, "class": {"const": "IfcSpace"}, "predefined_type": {"enum": ["INTERNAL", "EXTERNAL", "PARKING", "SPACE"]},
        "name": {"$ref": "#/$defs/localized"}, "storey": {"$ref": "#/$defs/level"}, "outline": {"$ref": "#/$defs/outline"}, "reference_area": {"$ref": "#/$defs/positive"}, "metadata": {"$ref": "#/$defs/metadata"}}},
    "type": {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "class", "predefined_type", "name", "material", "attributes", "psets", "metadata"],
      "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"}, "class": {"enum": ["IfcColumnType", "IfcWindowType", "IfcWallType"]},
        "predefined_type": {"type": "string", "pattern": "^[A-Z_]+$"}, "name": {"$ref": "#/$defs/localized"}, "material": {"$ref": "#/$defs/tag"},
        "profile": {"type": "object", "additionalProperties": false, "required": ["shape", "diameter"], "properties": {"shape": {"const": "circle"}, "diameter": {"$ref": "#/$defs/positive"}}},
        "attributes": {"$ref": "#/$defs/attributes"}, "psets": {"$ref": "#/$defs/psets"}, "metadata": {"$ref": "#/$defs/metadata"}}},
    "material": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "class", "name", "density"],
        "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"}, "class": {"const": "IfcMaterial"}, "name": {"$ref": "#/$defs/localized"}, "density": {"$ref": "#/$defs/positive"}}},
      {"type": "object", "additionalProperties": false, "required": ["guid", "tag", "class", "name", "layers"],
        "properties": {"guid": {"$ref": "#/$defs/guid"}, "tag": {"$ref": "#/$defs/tag"}, "class": {"const": "IfcMaterialLayerSet"}, "name": {"$ref": "#/$defs/localized"},
          "layers": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "material", "name", "thickness"],
            "properties": {"id": {"$ref": "#/$defs/tag"}, "material": {"$ref": "#/$defs/tag"}, "name": {"$ref": "#/$defs/localized"}, "thickness": {"$ref": "#/$defs/positive"},
              "zones": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["planted", "solarium"]}}}}}}}]},
    "event_opening": {"type": "object", "additionalProperties": false, "required": ["type", "object_guid", "sill", "head"],
      "properties": {"type": {"const": "OpeningResized"}, "object_guid": {"$ref": "#/$defs/guid"}, "sill": {"type": "number", "minimum": 0}, "head": {"type": "number", "exclusiveMinimum": 0}}},
    "event_layer": {"type": "object", "additionalProperties": false, "required": ["type", "object_guid", "layer", "value", "unit"],
      "properties": {"type": {"const": "LayerThicknessChanged"}, "object_guid": {"$ref": "#/$defs/guid"}, "layer": {"$ref": "#/$defs/tag"}, "value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"const": "m"}}}
  }
}
