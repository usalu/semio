{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "historical_state",
    "evidence",
    "types",
    "curtain",
    "tolerance"
  ],
  "properties": {
    "$schema": {
      "const": "🪚️source.schema.json"
    },
    "historical_state": {
      "const": "original-completed-1930-1931"
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "dimensions"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frame_width",
              "frame_depth",
              "sash_width",
              "sash_depth",
              "panel_thickness"
            ],
            "properties": {
              "frame_width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "frame_depth": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sash_width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sash_depth": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "panel_thickness": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "curtain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "type",
        "transom",
        "height"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "transom": {
          "type": "string",
          "minLength": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
