{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "comparison",
    "analytic_guards"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parts",
          "partitioned",
          "volume"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "parts": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "outline"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "prism",
                    "graded"
                  ]
                },
                "outline": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "z": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "holes": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "plane": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "depth": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "prism"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "z"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "graded"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "plane",
                      "depth"
                    ]
                  }
                }
              ]
            }
          },
          "partitioned": {
            "type": "boolean"
          },
          "volume": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volume"
      ],
      "properties": {
        "volume": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "analytic_guards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "radius",
          "outline",
          "box"
        ],
        "properties": {
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "outline": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "box": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
