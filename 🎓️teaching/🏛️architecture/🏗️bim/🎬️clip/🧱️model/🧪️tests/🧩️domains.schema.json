{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "languages",
    "domains",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "languages": {
      "const": [
        "en",
        "de"
      ]
    },
    "domains": {
      "const": [
        "architecture",
        "structure",
        "services"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "domains"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "architecture",
                "structure",
                "services"
              ]
            }
          }
        }
      }
    }
  }
}
