{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "member",
    "source_parts",
    "cached_slab",
    "expected"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "member": {
      "type": "string"
    },
    "source_parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "outline",
          "z0",
          "z1"
        ]
      }
    },
    "cached_slab": {
      "type": "object",
      "required": [
        "parts",
        "shared_parts",
        "full_parts",
        "finish_parts",
        "marker"
      ]
    },
    "expected": {
      "type": "object",
      "required": [
        "shared_count",
        "full_volume",
        "soffit"
      ],
      "properties": {
        "shared_count": {
          "type": "integer"
        },
        "full_volume": {
          "type": "number"
        },
        "soffit": {
          "type": "number"
        }
      }
    }
  }
}
