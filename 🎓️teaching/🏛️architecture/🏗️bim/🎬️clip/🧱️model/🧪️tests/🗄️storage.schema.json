{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed Cabinet Material Acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "floor",
    "cabinets",
    "roles",
    "materials",
    "tolerance"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "floor": {
      "type": "number"
    },
    "cabinets": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "bounds",
          "cavities"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "bounds": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "number"
            }
          },
          "cavities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "materials": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
