{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model query memoisation cases",
  "type": "object",
  "required": ["queries"],
  "additionalProperties": false,
  "properties": {
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "call", "arg", "digest"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "call": {"enum": ["quantities", "solid_geometry", "service_geometry", "wall_geometry", "building_geometry"]},
          "arg": {"type": ["string", "null"], "description": "Element tag, or a role name prefixed with role: that resolves to a tag; null for building_geometry"},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the canonical JSON (sorted keys, compact separators, repr for non-JSON values) of the result computed before the memoisation change"}
        }
      }
    }
  }
}
