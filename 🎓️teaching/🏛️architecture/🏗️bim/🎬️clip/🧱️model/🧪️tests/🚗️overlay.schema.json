{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parking Overlay JSON Interface",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "ring": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "polygon": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ring"
      }
    },
    "polygons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/polygon"
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "actual",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "actual": {
                "$ref": "#/$defs/polygons"
              },
              "expected": {
                "$ref": "#/$defs/polygons"
              }
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "cases"
      ],
      "properties": {
        "engine": {
          "enum": [
            "fraction-sweep",
            "polygon-clipping"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "xor_area"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "xor_area": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
