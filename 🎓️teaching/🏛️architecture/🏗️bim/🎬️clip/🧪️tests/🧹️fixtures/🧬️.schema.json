{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "owned_attributes",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "owned_attributes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mutate",
          "setup_error",
          "expected_errors"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "mutate": {
            "type": "boolean"
          },
          "setup_error": {
            "type": "boolean"
          },
          "expected_errors": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
