{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.dev/teaching/morph/export-request.schema.json",
  "title": "Morph export request",
  "description": "A persisted export request: which transitions to render, for what purpose, and under which explicit render profile. There is no default profile; a publication request is always final.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "purpose", "profile", "fingerprint", "language", "transitions"],
  "properties": {
    "version": { "const": 1 },
    "purpose": { "enum": ["review", "publication"] },
    "profile": { "enum": ["preview", "final"] },
    "fingerprint": { "type": "string", "minLength": 1 },
    "language": { "enum": ["en", "de"] },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$" }
    }
  },
  "if": { "properties": { "purpose": { "const": "publication" } }, "required": ["purpose"] },
  "then": { "properties": { "profile": { "const": "final" } } }
}
