{
  "description": "Language-agnostic placement cases: scene-space bounds in, affine (p -> scale * p + translation) out. Expected values are derived by hand from the anchor/fit definitions and cross-checked with shapely.affinity.",
  "cases": [
    {"name": "center-none-moves-only", "source": {"lo": [0, 0], "hi": [2, 1]}, "target": {"lo": [10, 10], "hi": [14, 18]}, "placement": {"space": "scene", "anchor": "center", "fit": "none", "uniform": true}, "expect": {"scale": [1, 1], "translation": [11, 13.5]}},
    {"name": "contain-uniform-takes-smaller-ratio", "source": {"lo": [0, 0], "hi": [2, 1]}, "target": {"lo": [0, 0], "hi": [4, 4]}, "placement": {"space": "scene", "anchor": "center", "fit": "contain", "uniform": true}, "expect": {"scale": [2, 2], "translation": [0, 1]}},
    {"name": "contain-non-uniform-fills-both-axes", "source": {"lo": [0, 0], "hi": [2, 1]}, "target": {"lo": [0, 0], "hi": [4, 4]}, "placement": {"space": "scene", "anchor": "center", "fit": "contain", "uniform": false}, "expect": {"scale": [2, 4], "translation": [0, 0]}},
    {"name": "width-uniform", "source": {"lo": [0, 0], "hi": [2, 1]}, "target": {"lo": [10, 0], "hi": [16, 2]}, "placement": {"space": "scene", "anchor": "center", "fit": "width", "uniform": true}, "expect": {"scale": [3, 3], "translation": [10, -0.5]}},
    {"name": "height-uniform", "source": {"lo": [0, 0], "hi": [2, 1]}, "target": {"lo": [10, 0], "hi": [16, 2]}, "placement": {"space": "scene", "anchor": "center", "fit": "height", "uniform": true}, "expect": {"scale": [2, 2], "translation": [11, 0]}},
    {"name": "width-non-uniform-keeps-height", "source": {"lo": [0, 0], "hi": [2, 1]}, "target": {"lo": [10, 0], "hi": [16, 2]}, "placement": {"space": "scene", "anchor": "center", "fit": "width", "uniform": false}, "expect": {"scale": [3, 1], "translation": [10, 0.5]}},
    {"name": "bottom-anchor-contain-keeps-foot-line", "source": {"lo": [0, 0], "hi": [2, 1]}, "target": {"lo": [10, 0], "hi": [16, 2]}, "placement": {"space": "scene", "anchor": "bottom", "fit": "contain", "uniform": true}, "expect": {"scale": [2, 2], "translation": [11, 0]}},
    {"name": "top-anchor-none", "source": {"lo": [0, 0], "hi": [2, 1]}, "target": {"lo": [10, 5], "hi": [14, 9]}, "placement": {"space": "scene", "anchor": "top", "fit": "none", "uniform": true}, "expect": {"scale": [1, 1], "translation": [11, 8]}},
    {"name": "left-anchor-asymmetric-bounds", "source": {"lo": [-1, 0], "hi": [3, 2]}, "target": {"lo": [5, 5], "hi": [7, 9]}, "placement": {"space": "scene", "anchor": "left", "fit": "none", "uniform": true}, "expect": {"scale": [1, 1], "translation": [6, 6]}},
    {"name": "right-anchor-asymmetric-bounds", "source": {"lo": [-1, 0], "hi": [3, 2]}, "target": {"lo": [5, 5], "hi": [7, 9]}, "placement": {"space": "scene", "anchor": "right", "fit": "none", "uniform": true}, "expect": {"scale": [1, 1], "translation": [4, 6]}},
    {"name": "origin-anchor-foot-contact", "source": {"lo": [0, 0], "hi": [2, 4], "origin": [1, 0]}, "target": {"lo": [10, 10], "hi": [14, 12], "origin": [12, 10]}, "placement": {"space": "scene", "anchor": "origin", "fit": "none", "uniform": true}, "expect": {"scale": [1, 1], "translation": [11, 10]}},
    {"name": "zero-size-source-is-pure-translation", "source": {"lo": [3, 3], "hi": [3, 3]}, "target": {"lo": [0, 0], "hi": [4, 2]}, "placement": {"space": "scene", "anchor": "center", "fit": "contain", "uniform": true}, "expect": {"scale": [1, 1], "translation": [-1, -2]}},
    {"name": "zero-height-source-uses-width-axis-only", "source": {"lo": [0, 1], "hi": [4, 1]}, "target": {"lo": [0, 0], "hi": [2, 2]}, "placement": {"space": "scene", "anchor": "center", "fit": "contain", "uniform": true}, "expect": {"scale": [0.5, 0.5], "translation": [0, 0.5]}},
    {"name": "zero-size-target-keeps-scale-one", "source": {"lo": [0, 0], "hi": [2, 2]}, "target": {"lo": [5, 5], "hi": [5, 5]}, "placement": {"space": "scene", "anchor": "center", "fit": "contain", "uniform": true}, "expect": {"scale": [1, 1], "translation": [4, 4]}},
    {"name": "nested-entity-uniform-parent-scale", "source": {"lo": [10, 0], "hi": [14, 2]}, "target": {"lo": [10, 0], "hi": [18, 8]}, "placement": {"space": "entity:a", "anchor": "center", "fit": "contain", "uniform": true}, "frames": {"a": {"scale": [2, 2], "translation": [10, 0], "parent": null}}, "expect": {"scale": [2, 2], "translation": [-10, 2]}},
    {"name": "nested-entity-anisotropic-parent-is-uniform-in-local-space", "source": {"lo": [0, 0], "hi": [4, 2]}, "target": {"lo": [10, 0], "hi": [18, 4]}, "placement": {"space": "entity:a", "anchor": "center", "fit": "contain", "uniform": true}, "frames": {"a": {"scale": [2, 1], "translation": [0, 0], "parent": null}}, "expect": {"scale": [2, 2], "translation": [10, 0]}},
    {"name": "nested-two-levels", "source": {"lo": [0, 0], "hi": [2, 2]}, "target": {"lo": [20, 0], "hi": [24, 4]}, "placement": {"space": "entity:b", "anchor": "center", "fit": "contain", "uniform": true}, "frames": {"b": {"scale": [2, 2], "translation": [0, 0], "parent": "a"}, "a": {"scale": [1, 1], "translation": [10, 0], "parent": null}}, "expect": {"scale": [2, 2], "translation": [20, 0]}},
    {"name": "error-inverted-bounds", "source": {"lo": [2, 0], "hi": [0, 1]}, "target": {"lo": [0, 0], "hi": [1, 1]}, "placement": {"space": "scene", "anchor": "center", "fit": "none", "uniform": true}, "error": "inverted"},
    {"name": "error-non-finite-bounds", "source": {"lo": [0, 0], "hi": [1e999, 1]}, "target": {"lo": [0, 0], "hi": [1, 1]}, "placement": {"space": "scene", "anchor": "center", "fit": "none", "uniform": true}, "error": "finite"},
    {"name": "error-unknown-anchor", "source": {"lo": [0, 0], "hi": [1, 1]}, "target": {"lo": [0, 0], "hi": [1, 1]}, "placement": {"space": "scene", "anchor": "middle", "fit": "none", "uniform": true}, "error": "unknown anchor"},
    {"name": "error-unknown-fit", "source": {"lo": [0, 0], "hi": [1, 1]}, "target": {"lo": [0, 0], "hi": [1, 1]}, "placement": {"space": "scene", "anchor": "center", "fit": "cover", "uniform": true}, "error": "unknown fit"},
    {"name": "error-origin-not-declared", "source": {"lo": [0, 0], "hi": [1, 1]}, "target": {"lo": [0, 0], "hi": [1, 1]}, "placement": {"space": "scene", "anchor": "origin", "fit": "none", "uniform": true}, "error": "origin"},
    {"name": "error-missing-frame", "source": {"lo": [0, 0], "hi": [1, 1]}, "target": {"lo": [0, 0], "hi": [1, 1]}, "placement": {"space": "entity:ghost", "anchor": "center", "fit": "none", "uniform": true}, "error": "no logical frame"},
    {"name": "error-frame-cycle", "source": {"lo": [0, 0], "hi": [1, 1]}, "target": {"lo": [0, 0], "hi": [1, 1]}, "placement": {"space": "entity:a", "anchor": "center", "fit": "none", "uniform": true}, "frames": {"a": {"scale": [1, 1], "translation": [0, 0], "parent": "b"}, "b": {"scale": [1, 1], "translation": [0, 0], "parent": "a"}}, "error": "cycle"},
    {"name": "error-zero-frame-scale", "source": {"lo": [0, 0], "hi": [1, 1]}, "target": {"lo": [0, 0], "hi": [1, 1]}, "placement": {"space": "entity:a", "anchor": "center", "fit": "none", "uniform": true}, "frames": {"a": {"scale": [0, 1], "translation": [0, 0], "parent": null}}, "error": "not invertible"},
    {"name": "error-unknown-space", "source": {"lo": [0, 0], "hi": [1, 1]}, "target": {"lo": [0, 0], "hi": [1, 1]}, "placement": {"space": "screen", "anchor": "center", "fit": "none", "uniform": true}, "error": "unknown coordinate space"}
  ]
}
