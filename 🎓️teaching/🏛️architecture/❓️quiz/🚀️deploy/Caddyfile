# 🔒️ quizze.architektur-und-technologie.de — Caddy on the host terminates TLS (certificates are obtained and renewed
# automatically once the DNS records point at this host and ports 80 and 443 are reachable) and forwards to the proctor
# published on loopback by compose.yaml. Caddy sets X-Forwarded-Proto itself and replaces any value a client sent, which is
# the statement PROCTOR_TRUSTED_FORWARDING=proxy relies on; the event-stream WebSockets are proxied without extra settings.

quizze.architektur-und-technologie.de {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
	reverse_proxy 127.0.0.1:8791
}
