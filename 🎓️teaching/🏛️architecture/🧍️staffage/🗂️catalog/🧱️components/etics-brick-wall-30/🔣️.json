      "references": [
        {
          "id": "en-iso-6946",
          "citation": "EN ISO 6946:2017 Building components and building elements, thermal resistance and thermal transmittance (surface resistances R_si 0.13 and R_se 0.04 m2K/W for horizontal heat flow, R_si 0.10 for upward heat flow)."
        },
        {
          "id": "en-iso-10456",
          "citation": "EN ISO 10456:2007 Building materials and products, hygrothermal properties (design thermal conductivity, specific heat capacity: solid brick 0.75 W/mK, lime-cement plaster 0.70 W/mK, mineral wool 0.035 W/mK)."
        },
        {
          "id": "geg-2024",
          "citation": "GEG 2024 Gebaeudeenergiegesetz, Anlage 7: maximum U-values of renovated components (exterior wall 0.24, roof 0.20, windows 1.3, exterior doors 1.8 W/m2K)."
        },
        {
          "id": "din-1356-1",
          "citation": "DIN 1356-1:1995 Building drawings, part 1: types of drawings, contents and basic principles of presentation (scales, line groups, symbols for walls, doors, windows)."
        },
        {
          "id": "din-iso-128-50",
          "citation": "DIN ISO 128-50:2002 Technical drawings, general principles of presentation, part 50: basic conventions for areas on sections and cuts (hatching)."
        }
      ],
      "notes": {
        "en": "The wall is drawn in section as the heat-conduction lesson shows it: interior at the left, exterior at the right. One thermal region carries the layers from the inside out, so the solver gives the interior and exterior surface temperature of the scenario.",
        "de": "Die Wand ist im Schnitt gezeichnet, wie ihn die Wärmeleitungs-Lektion zeigt: innen links, außen rechts. Eine thermische Region trägt die Schichten von innen nach außen, damit der Löser die innere und äußere Oberflächentemperatur des Szenarios liefert."
      }
    },
