 "asset": {
  "id": "panel-radiator",
  "category": "components",
  "title": {
   "en": "Panel Radiator Type 22",
   "de": "Plattenheizkörper Typ 22"
  },
  "summary": {
   "en": "A compact type 22 steel panel radiator (two water panels, two convectors; 600 mm high, 1000 mm long, 100 mm deep, rated 1.2 kW at 75/65/20 degC) shown in vertical section on two wall brackets 35 mm off a plastered wall, with its thermostatic valve; output scales with the EN 442 exponent n = 1.3 and rises as a convection plume.",
   "de": "Ein kompakter Stahl-Plattenheizkörper Typ 22 (zwei Wasserplatten, zwei Konvektoren; 600 mm hoch, 1000 mm lang, 100 mm tief, 1,2 kW bei 75/65/20 °C) im Vertikalschnitt an zwei Wandkonsolen 35 mm vor einer verputzten Wand, mit Thermostatventil; die Leistung folgt dem EN-442-Exponenten n = 1,3 und steigt als Konvektionsfahne auf."
  },
  "tags": [
   "component",
   "heating",
   "radiator",
   "operating",
   "convection",
   "thermal"
  ],
  "provenance": {
   "author": "Semio staffage component authors (NW-C)",
   "method": "handcrafted",
   "created": "2026-10-29",
   "references": [
    {
     "id": "en-442-2",
     "citation": "EN 442-2:2014 Radiators and convectors, test methods and rating: heat output Phi = K_m * dT^n, standard rating at 75/65/20 degC (dT = 50 K) with exponent n typically 1.2 to 1.4 for panel radiators."
    },
    {
     "id": "en-442-1",
     "citation": "EN 442-1:2014 Radiators and convectors, technical specifications and requirements (panel and convector designation: type 22 = two panels and two convectors)."
    },
    {
     "id": "radiator-catalogues",
     "citation": "Manufacturer catalogues for compact panel radiators type 22, height 600 mm, length 1000 mm, depth 100 mm (rated output about 1.1 to 1.3 kW at 75/65/20 degC, mass about 25 kg with water). Typical values consulted, not a table look-up."
    },
    {
     "id": "en-iso-10456",
     "citation": "EN ISO 10456:2007 Building materials and products, hygrothermal properties (clay masonry rho 1800, lambda 0.8 W/mK; steel 50 W/mK, 450 J/kgK; emissivity of paint 0.9)."
    },
    {
     "id": "din-iso-128-50",
     "citation": "DIN ISO 128-50:2002 Technical drawings, basic conventions for areas on sections and cuts (hatching)."
    },
    {
     "id": "din-1356-1",
     "citation": "DIN 1356-1:1995 Building drawings, types of drawings and basic principles of presentation."
    },
    {
     "id": "en-iso-6946",
     "citation": "EN ISO 6946:2017 Building components, thermal resistance and transmittance (surface resistances)."
    },
    {
     "id": "din-4701",
     "citation": "Kuchling, Taschenbuch der Physik, and common heating practice: a panel radiator gives about 25 to 35 % of its output by radiation, the rest by convection (convector channels deliver most of the convective share)."
    }
   ],
   "notes": {
    "en": "Output per level uses Phi = Phi_50 (dT/50)^n with n = 1.3; the 1.2 kW rating and the convective share are catalogue-typical authored estimates.",
    "de": "Die Leistung je Stufe folgt Phi = Phi_50 (dT/50)^n mit n = 1,3; die Nennleistung 1,2 kW und der Konvektionsanteil sind katalogtypische Schätzwerte."
   }
