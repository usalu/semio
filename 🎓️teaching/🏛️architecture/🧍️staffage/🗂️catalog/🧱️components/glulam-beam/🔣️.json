            "de": "Kontur 0,35 mm, Leimfugen 0,1 mm, Keilzinken 0,18 mm."
          },
          "overlays": {
            "en": "Faces are one merged bar cell, bearing plates their own cells.",
            "de": "Die Flächen sind eine zusammengefasste Balkenzelle, die Lagerplatten eigene Zellen."
          }
        }
      }
