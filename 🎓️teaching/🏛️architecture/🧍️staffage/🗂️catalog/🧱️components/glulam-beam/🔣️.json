          "silhouette": {
            "en": "Side elevation of the 600 mm deep beam (12 mm tall and 160 mm long on paper) with fifteen lamellae, six staggered finger joints and two steel bearing plates.",
            "de": "Seitenansicht des 600 mm hohen Balkens (12 mm hoch und 160 mm lang auf Papier) mit fünfzehn Lamellen, sechs versetzten Keilzinkenstößen und zwei Stahllagerplatten."
          },
          "retained": {
            "en": "All 14 glue lines at 40 mm spacing (0.8 mm), the two 120 x 20 mm bearing plates (2.4 x 0.4 mm), staggered finger joints.",
            "de": "Alle 14 Leimfugen im Abstand von 40 mm (0,8 mm), die beiden Lagerplatten 120 x 20 mm (2,4 x 0,4 mm), versetzte Keilzinkenstöße."
          },
          "merged": {
            "en": "Side faces, top and soffit remain one bar shape; the glue lines are bound to the side faces.",
            "de": "Seitenflächen, Oberseite und Unterseite bleiben eine Balkenform; die Leimfugen sind an die Seitenflächen gebunden."
          },
          "omitted": {
            "en": "Plate bolts (12 mm, 0.24 mm) and the real finger pitch (12 mm).",
            "de": "Lagerschrauben (12 mm, 0,24 mm) und die reale Zinkenteilung (12 mm)."
          },
          "thinElements": {
            "en": "Finger joints are two-tooth symbols with a 40 mm pitch (0.8 mm), because the real pitch (0.24 mm) is below the printable minimum.",
            "de": "Keilzinkenstöße sind Zeichen mit zwei Zinken und 40 mm Teilung (0,8 mm), weil die echte Teilung (0,24 mm) unter dem druckbaren Minimum liegt."
          },
          "hatching": {
            "en": "No hatch fill: the glue lines are the grain indication of the longitudinal view.",
            "de": "Keine Schraffurfüllung: die Leimfugen sind die Faserandeutung der Längsansicht."
          },
          "styles": {
