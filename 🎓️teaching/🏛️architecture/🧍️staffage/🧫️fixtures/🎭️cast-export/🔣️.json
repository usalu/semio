{
  "description": "Language-agnostic vectors of the cast exporter: a manifest of casts in, the index fields every implementation must write out. Frame counts follow round(durationS · fps) (+1 for a non-looping clip or a transient pose), a pose is one frame at fps 1 and durationS 0. The theme is required on every cast; the analytic views (thermal, forces, moments) draw its ink, so a dark cast must not contain the light-theme ink and a light cast must not contain the dark-theme ink.",
  "manifest": {
    "version": 1,
    "casts": {
      "walker-line": { "asset": "walking-commuter", "viewpoint": "elevation", "clip": "walk-cycle", "view": "dark-line", "theme": "dark", "scale": 50, "fps": 15 },
      "walker-line-mirrored": { "asset": "walking-commuter", "viewpoint": "elevation", "clip": "walk-cycle", "view": "dark-line", "theme": "dark", "scale": 50, "fps": 15, "mirror": true },
      "radiator-rated": { "asset": "panel-radiator", "viewpoint": "elevation", "pose": "rated", "view": "dark-solid", "theme": "dark", "scale": 50 },
      "walker-thermal": { "asset": "walking-commuter", "viewpoint": "elevation", "clip": "walk-cycle", "view": "thermal", "theme": "dark", "scale": 50, "fps": 10, "environment": "winter-overcast" },
      "radiator-transient": { "asset": "panel-radiator", "viewpoint": "elevation", "pose": "comfort", "view": "thermal", "theme": "dark", "scale": 50, "fps": 2, "timeline": [{ "t": 0, "environment": "office-neutral", "ease": "linear" }, { "t": 4, "environment": "summer-hot-sun", "ease": "linear" }] },
      "radiator-thermal-dark": { "asset": "panel-radiator", "viewpoint": "elevation", "pose": "rated", "view": "thermal", "theme": "dark", "scale": 50, "environment": "indoor-heated-winter" },
      "radiator-thermal-light": { "asset": "panel-radiator", "viewpoint": "elevation", "pose": "rated", "view": "thermal", "theme": "light", "scale": 50, "environment": "indoor-heated-winter" },
      "breather-plain": { "asset": "standing-adult", "viewpoint": "elevation", "clip": "idle-breathing", "view": "thermal", "theme": "dark", "scale": 50, "fps": 4, "environment": "office-neutral" },
      "breather-plume": { "asset": "standing-adult", "viewpoint": "elevation", "clip": "idle-breathing", "view": "thermal", "theme": "dark", "scale": 50, "fps": 4, "environment": "office-neutral", "transport": ["parcels"], "transportAgeS": 3 },
      "radiator-transient-unsorted": { "asset": "panel-radiator", "viewpoint": "elevation", "pose": "comfort", "view": "thermal", "theme": "dark", "scale": 50, "fps": 2, "timeline": [{ "t": 4, "environment": "summer-hot-sun", "ease": "linear" }, { "t": 0, "environment": "office-neutral", "ease": "linear" }] },
      "commuter-plan": { "asset": "walking-commuter", "clip": "walk-cycle", "view": "dark-line", "theme": "dark", "scale": 50, "fps": 15, "viewpoint": "plan" },
      "window-front": { "asset": "tilt-window", "pose": "tilted-open", "view": "dark-line", "theme": "dark", "scale": 50, "viewpoint": "front" },
      "window-side": { "asset": "tilt-window", "viewpoint": "elevation", "pose": "tilted-open", "view": "dark-line", "theme": "dark", "scale": 50 }
    }
  },
  "inks": { "dark": "#f7f3e3", "light": "#001117" },
  "expected": {
    "walker-line": { "asset": "walking-commuter", "view": "dark-line", "frames": 18, "fps": 15, "durationS": 1.2, "loop": true, "mmPerMetre": 20, "scale": 50 },
    "walker-line-mirrored": { "asset": "walking-commuter", "view": "dark-line", "frames": 18, "fps": 15, "durationS": 1.2, "loop": true, "mmPerMetre": 20, "scale": 50 },
    "radiator-rated": { "asset": "panel-radiator", "view": "dark-solid", "frames": 1, "fps": 1, "durationS": 0, "loop": false, "mmPerMetre": 20, "scale": 50 },
    "walker-thermal": { "asset": "walking-commuter", "view": "thermal", "frames": 12, "fps": 10, "durationS": 1.2, "loop": true, "mmPerMetre": 20, "scale": 50 },
    "radiator-transient": { "asset": "panel-radiator", "view": "thermal", "frames": 9, "fps": 2, "durationS": 4, "loop": false, "mmPerMetre": 20, "scale": 50 },
    "radiator-thermal-dark": { "asset": "panel-radiator", "view": "thermal", "frames": 1, "fps": 1, "durationS": 0, "loop": false, "mmPerMetre": 20, "scale": 50 },
    "radiator-thermal-light": { "asset": "panel-radiator", "view": "thermal", "frames": 1, "fps": 1, "durationS": 0, "loop": false, "mmPerMetre": 20, "scale": 50 },
    "breather-plain": { "asset": "standing-adult", "view": "thermal", "frames": 20, "fps": 4, "durationS": 5, "loop": true, "mmPerMetre": 20, "scale": 50 },
    "breather-plume": { "asset": "standing-adult", "view": "thermal", "frames": 20, "fps": 4, "durationS": 5, "loop": true, "mmPerMetre": 20, "scale": 50 },
    "radiator-transient-unsorted": { "asset": "panel-radiator", "view": "thermal", "frames": 9, "fps": 2, "durationS": 4, "loop": false, "mmPerMetre": 20, "scale": 50 },
    "commuter-plan": { "asset": "walking-commuter", "view": "dark-line", "frames": 18, "fps": 15, "durationS": 1.2, "loop": true, "mmPerMetre": 20, "scale": 50 },
    "window-front": { "asset": "tilt-window", "view": "dark-line", "frames": 1, "fps": 1, "durationS": 0, "loop": false, "mmPerMetre": 20, "scale": 50 },
    "window-side": { "asset": "tilt-window", "view": "dark-line", "frames": 1, "fps": 1, "durationS": 0, "loop": false, "mmPerMetre": 20, "scale": 50 }
  },
  "viewpoints": { "commuter-plan": "plan", "window-front": "front", "window-side": "elevation", "walker-line": "elevation" },
  "viewpointsDiffer": [["window-front", "window-side"], ["commuter-plan", "walker-line"]],
  "identicalOutput": { "radiator-transient-unsorted": "radiator-transient" },
  "mirrorOf": { "walker-line-mirrored": "walker-line" },
  "refused": [
    { "name": "an unknown pose", "cast": { "asset": "panel-radiator", "pose": "no-such-pose", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "scale": 50 }, "message": "has no pose" },
    { "name": "an unknown clip", "cast": { "asset": "walking-commuter", "clip": "no-such-clip", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "scale": 50, "fps": 15 }, "message": "has no clip" },
    { "name": "an unknown environment preset", "cast": { "asset": "panel-radiator", "pose": "rated", "view": "thermal", "viewpoint": "elevation", "theme": "dark", "scale": 50, "environment": "no-such-preset" }, "message": "unknown environment preset" },
    { "name": "an unknown asset", "cast": { "asset": "no-such-asset", "pose": "rated", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "scale": 50 }, "message": "is not in the catalog" },
    { "name": "a scale the asset marks unavailable", "cast": { "asset": "hosta-clump", "pose": "summer-full", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "scale": 500 }, "message": "has no authored representation at 1:500" }
  ],
  "invalid": [
    { "name": "a mirrored plan", "cast": { "asset": "walking-commuter", "clip": "walk-cycle", "view": "dark-line", "viewpoint": "plan", "theme": "dark", "mirror": true }, "issue": "mirror needs viewpoint elevation" },
    { "name": "a mirrored front", "cast": { "asset": "tilt-window", "pose": "tilted-open", "view": "dark-line", "viewpoint": "front", "theme": "dark", "mirror": true }, "issue": "mirror needs viewpoint elevation" },
    { "name": "missing viewpoint", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "dark-line", "theme": "dark" }, "issue": "viewpoint" },
    { "name": "pose and clip together", "cast": { "asset": "walking-commuter", "pose": "standing", "clip": "walk-cycle", "view": "dark-line", "viewpoint": "elevation", "theme": "dark" }, "issue": "exactly one of pose and clip" },
    { "name": "neither pose nor clip", "cast": { "asset": "walking-commuter", "view": "dark-line", "viewpoint": "elevation", "theme": "dark" }, "issue": "exactly one of pose and clip" },
    { "name": "environment outside the thermal view", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "environment": "winter-overcast" }, "issue": "thermal view only" },
    { "name": "fps of a plain pose", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "fps": 15 }, "issue": "needs a clip or a timeline" },
    { "name": "unknown view", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "sepia", "viewpoint": "elevation", "theme": "dark" }, "issue": "view" },
    { "name": "missing theme", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "thermal" }, "issue": "theme is required" },
    { "name": "unknown theme", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "thermal", "viewpoint": "elevation", "theme": "sepia" }, "issue": "theme" },
    { "name": "unknown transport layer", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "thermal", "viewpoint": "elevation", "theme": "dark", "transport": ["fog"] }, "issue": "transport" },
    { "name": "duplicate transport layers", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "thermal", "viewpoint": "elevation", "theme": "dark", "transport": ["parcels", "parcels"] }, "issue": "transport" },
    { "name": "transport age without transport layers", "cast": { "asset": "standing-adult", "clip": "idle-breathing", "view": "thermal", "viewpoint": "elevation", "theme": "dark", "transportAgeS": 5 }, "issue": "needs transport layers" },
    { "name": "transport age of a pose", "cast": { "asset": "standing-adult", "pose": "relaxed", "view": "thermal", "viewpoint": "elevation", "theme": "dark", "transport": ["pathlines"], "transportAgeS": 5 }, "issue": "needs a clip" },
    { "name": "transport trail without transport layers", "cast": { "asset": "standing-adult", "clip": "idle-breathing", "view": "thermal", "viewpoint": "elevation", "theme": "dark", "transportTrailS": 1 }, "issue": "needs transport layers" },
    { "name": "transport trail of zero", "cast": { "asset": "standing-adult", "clip": "idle-breathing", "view": "thermal", "viewpoint": "elevation", "theme": "dark", "transport": ["pathlines"], "transportTrailS": 0 }, "issue": "positive number" },
    { "name": "transport stroke of zero", "cast": { "asset": "standing-adult", "pose": "relaxed", "view": "thermal", "viewpoint": "elevation", "theme": "dark", "transport": ["pathlines"], "transportStrokeMm": 0 }, "issue": "positive number" },
    { "name": "unknown viewpoint", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "dark-line", "theme": "dark", "viewpoint": "back" }, "issue": "viewpoint" },
    { "name": "scale of zero", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "scale": 0 }, "issue": "scale" },
    { "name": "fps of zero", "cast": { "asset": "walking-commuter", "clip": "walk-cycle", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "fps": 0 }, "issue": "fps" },
    { "name": "fps above 120", "cast": { "asset": "walking-commuter", "clip": "walk-cycle", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "fps": 121 }, "issue": "fps" },
    { "name": "fractional fps", "cast": { "asset": "walking-commuter", "clip": "walk-cycle", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "fps": 7.5 }, "issue": "fps" },
    { "name": "mirror as text", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "mirror": "yes" }, "issue": "mirror" },
    { "name": "language on a cast", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "language": "en" }, "issue": "unknown property language" },
    { "name": "unknown property", "cast": { "asset": "walking-commuter", "pose": "standing", "view": "dark-line", "viewpoint": "elevation", "theme": "dark", "color": "red" }, "issue": "unknown property" },
    { "name": "asset that is no slug", "cast": { "asset": "Walking Commuter", "pose": "standing", "view": "dark-line", "viewpoint": "elevation", "theme": "dark" }, "issue": "asset" },
    { "name": "missing asset", "cast": { "pose": "standing", "view": "dark-line", "viewpoint": "elevation", "theme": "dark" }, "issue": "asset is required" },
    { "name": "environment together with a timeline", "cast": { "asset": "panel-radiator", "pose": "rated", "view": "thermal", "theme": "dark", "environment": "office-neutral", "timeline": [{ "t": 0, "environment": "office-neutral" }] }, "issue": "exclude each other" },
    { "name": "empty timeline", "cast": { "asset": "panel-radiator", "pose": "rated", "view": "thermal", "viewpoint": "elevation", "theme": "dark", "timeline": [] }, "issue": "timeline" },
    { "name": "timeline at a negative time", "cast": { "asset": "panel-radiator", "pose": "rated", "view": "thermal", "theme": "dark", "timeline": [{ "t": -1, "environment": "office-neutral" }] }, "issue": "timeline" },
    { "name": "timeline with an unknown ease", "cast": { "asset": "panel-radiator", "pose": "rated", "view": "thermal", "theme": "dark", "timeline": [{ "t": 0, "environment": "office-neutral", "ease": "cubic" }] }, "issue": "ease" },
    { "name": "timeline outside the thermal view", "cast": { "asset": "panel-radiator", "pose": "rated", "view": "dark-line", "theme": "dark", "timeline": [{ "t": 0, "environment": "office-neutral" }] }, "issue": "thermal view only" }
  ]
}
