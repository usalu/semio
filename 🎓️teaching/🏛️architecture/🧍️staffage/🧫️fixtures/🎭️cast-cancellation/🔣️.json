{
  "manifest": {
    "version": 1,
    "casts": {
      "quick": { "asset": "panel-radiator", "viewpoint": "elevation", "pose": "rated", "view": "dark-solid", "theme": "dark", "scale": 50 },
      "slow-a": { "asset": "panel-radiator", "viewpoint": "elevation", "pose": "comfort", "view": "thermal", "theme": "dark", "scale": 50, "fps": 15, "timeline": [{ "t": 0, "environment": "office-neutral", "ease": "linear" }, { "t": 100, "environment": "summer-hot-sun", "ease": "linear" }] },
      "slow-b": { "asset": "panel-radiator", "viewpoint": "elevation", "pose": "comfort", "view": "thermal", "theme": "dark", "scale": 50, "fps": 15, "timeline": [{ "t": 0, "environment": "summer-hot-sun", "ease": "linear" }, { "t": 100, "environment": "office-neutral", "ease": "linear" }] },
      "slow-c": { "asset": "panel-radiator", "viewpoint": "elevation", "pose": "comfort", "view": "thermal", "theme": "light", "scale": 50, "fps": 15, "timeline": [{ "t": 0, "environment": "office-neutral", "ease": "linear" }, { "t": 100, "environment": "summer-hot-sun", "ease": "linear" }] }
