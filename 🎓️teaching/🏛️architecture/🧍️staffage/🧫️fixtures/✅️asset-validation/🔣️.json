{
  "description": "Broken variants of the sample figure (semio.staffage/v2); every case applies its JSON-patch-like operations (path segments `id=<slug>` select the array element with that id, `-` appends) and must report at least the listed codes. The unpatched asset and manifest must report none.",
  "patchPaths": "RFC 6901 pointers with the id= selector",
  "cases": [
    {
      "name": "duplicate bone id",
      "patch": [
        {
          "op": "replace",
          "path": "/rig/bones/id=head/id",
          "value": "torso"
        }
      ],
      "expectCodes": [
        "duplicate-id"
      ]
    },
    {
      "name": "rig root is not a bone",
      "patch": [
        {
          "op": "replace",
          "path": "/rig/root",
          "value": "ghost"
        }
      ],
      "expectCodes": [
        "rig-root"
      ]
    },
