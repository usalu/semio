{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.staffage.load-cases/v1",
  "title": "Structural load cases",
  "description": "The imposed (occupancy) loads and the material densities the structural mode draws its loads from. Self-weight is mass times gravity at the centroid; an imposed load is the characteristic value of the standard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "gravityMS2", "standard", "occupancy", "materials"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "gravityMS2": { "type": "number", "exclusiveMinimum": 0 },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": { "id": { "$ref": "#/$defs/Slug" }, "title": { "$ref": "#/$defs/Text" } }
    },
    "occupancy": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Occupancy" } },
    "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Material" } }
  },
  "$defs": {
    "Slug": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "Text": { "type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } } },
    "Occupancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "title", "areaKNPerM2", "pointKN", "table"],
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "category": { "type": "string", "pattern": "^[A-H][0-9]?$" },
        "title": { "$ref": "#/$defs/Text" },
        "areaKNPerM2": { "description": "Characteristic uniformly distributed load q_k in kN/m2 of floor.", "type": "number", "exclusiveMinimum": 0 },
        "pointKN": { "description": "Characteristic concentrated load Q_k in kN.", "type": "number", "exclusiveMinimum": 0 },
        "table": { "type": "string", "pattern": "^[0-9A]\\.[0-9]+$" }
      }
    },
    "Material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "densityKNPerM3", "table"],
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "title": { "$ref": "#/$defs/Text" },
        "densityKNPerM3": { "description": "Weight density in kN/m3.", "type": "number", "exclusiveMinimum": 0 },
        "table": { "type": "string", "pattern": "^[0-9A]\\.[0-9]+$" }
      }
    }
  }
}
