    },
    "typecheck": {
      "executor": "repo:script",
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🎓️teaching/🏛️architecture/🧍️staffage/🎯️targets/⚛️react/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts typecheck",
        "forwardAllArgs": true
      }
    }
  }
}
