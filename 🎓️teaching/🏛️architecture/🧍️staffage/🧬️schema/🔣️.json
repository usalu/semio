{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.staffage/v1",
  "title": "Staffage",
  "description": "Handcrafted architectural staffage with real dimensions, rigs, poses, clips, thermal and structural models. A document is a category file or the manifest.",
  "oneOf": [
    {
      "$ref": "#/$defs/CategoryDocument"
    },
    {
      "$ref": "#/$defs/Manifest"
    }
  ],
  "$defs": {
    "Slug": {
      "description": "A kebab-case identifier, unique within its scope.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "Text": {
      "description": "A human-readable text in every supported language; there is no default language.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Category": {
      "description": "One of the six archive categories.",
      "enum": [
        "humans",
        "vegetation",
        "animals",
        "objects",
        "vehicles",
        "components"
      ]
    },
    "ParameterSource": {
      "description": "How a physical parameter is known.",
      "enum": [
        "measured",
        "literature",
        "authored-estimate",
        "illustrative"
      ]
    },
    "Viewpoint": {
      "description": "The projection an authored geometry set is drawn in.",
      "enum": [
        "elevation",
        "plan"
      ]
    },
    "ExportFormat": {
      "description": "The output kinds an asset can be exported to.",
      "enum": [
        "svg",
        "pdf",
        "dxf",
        "dwg",
        "png-sequence",
        "mp4",
        "webm",
        "component"
      ]
    },
    "Completion": {
      "description": "How far an asset has come.",
      "enum": [
        "planned",
        "authored",
        "verified"
      ]
    },
    "Reference": {
      "description": "A source a parameter or a shape relies on.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "citation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Provenance": {
      "description": "Who made an asset and how.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "method",
        "created",
        "references"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "const": "handcrafted"
        },
        "created": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reference"
          }
        },
        "notes": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "Material": {
      "description": "A material with the properties the thermal and structural models read.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "emissivity",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "emissivity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "solarAbsorptivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "densityKgM3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conductivityWmK": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "elasticModulusPa": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "strengthPa": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source": {
          "$ref": "#/$defs/ParameterSource"
        },
        "reference": {
          "$ref": "#/$defs/Slug"
        }
      }
    },
    "JointType": {
      "description": "How a bone may move relative to its parent.",
      "enum": [
        "fixed",
        "revolute",
        "prismatic"
      ]
    },
    "Joint": {
      "description": "A joint and its limits; revolute limits are angle offsets from rest, prismatic limits are offsets along axisDeg.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/JointType"
        },
        "minDeg": {
          "type": "number"
        },
        "maxDeg": {
          "type": "number"
        },
        "axisDeg": {
          "type": "number"
        },
        "minM": {
          "type": "number"
        },
        "maxM": {
          "type": "number"
        }
      }
    },
    "SegmentMass": {
      "description": "A segment mass: point mass at the local centre, or spread uniformly along the bone.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kg",
        "comX",
        "comY",
        "distribution",
        "source"
      ],
      "properties": {
        "kg": {
          "type": "number",
          "minimum": 0
        },
        "comX": {
          "type": "number"
        },
        "comY": {
          "type": "number"
        },
        "distribution": {
          "enum": [
            "point",
            "uniform"
          ]
        },
        "source": {
          "$ref": "#/$defs/ParameterSource"
        },
        "reference": {
          "$ref": "#/$defs/Slug"
        }
      }
    },
    "Section": {
      "description": "A member cross-section for stress.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaM2",
        "secondMomentM4",
        "extremeFibreM",
        "material"
      ],
      "properties": {
        "areaM2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "secondMomentM4": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "extremeFibreM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "material": {
          "$ref": "#/$defs/Slug"
        },
        "title": {
          "$ref": "#/$defs/Text"
        }
      }
    },
    "Bone": {
      "description": "A rigid frame placed at (x, y) and rotated by angleDeg in its parent's frame at rest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent",
        "title",
        "x",
        "y",
        "angleDeg",
        "lengthM",
        "joint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug"
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/Slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "angleDeg": {
          "type": "number"
        },
        "lengthM": {
          "type": "number",
          "minimum": 0
        },
        "joint": {
          "$ref": "#/$defs/Joint"
        },
        "mass": {
          "$ref": "#/$defs/SegmentMass"
        },
        "section": {
          "$ref": "#/$defs/Section"
        }
      }
    },
    "Rig": {
      "description": "A transform hierarchy with exactly one root.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "root",
        "bones"
      ],
      "properties": {
        "kind": {
          "enum": [
            "anatomical",
            "botanical",
            "mechanical",
            "structural"
          ]
        },
        "root": {
          "$ref": "#/$defs/Slug"
        },
        "bones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bone"
          },
          "minItems": 1
        }
      }
    },
    "AnchorKind": {
      "description": "What an anchor is for.",
      "enum": [
        "contact",
        "support",
        "attachment",
        "emitter",
        "load"
      ]
    },
    "SupportType": {
      "description": "How a support restrains.",
      "enum": [
        "contact",
        "pin",
        "roller",
        "fixed"
      ]
    },
    "Anchor": {
      "description": "A point fixed on a bone (local coordinates).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bone",
        "x",
        "y",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug"
        },
        "bone": {
          "$ref": "#/$defs/Slug"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "kind": {
          "$ref": "#/$defs/AnchorKind"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "support": {
          "$ref": "#/$defs/SupportType"
        },
        "normalDeg": {
          "type": "number"
        },
        "footprintLengthM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "footprintWidthM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frictionCoefficient": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ShapeRole": {
      "description": "The line-hierarchy role of a shape.",
      "enum": [
        "body",
        "detail",
        "texture",
        "glazing",
        "ground"
      ]
    },
    "Lod": {
      "description": "The level of detail a shape needs.",
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "CapsuleShape": {
      "description": "A stadium between two local points with radii r0 and r1 (tangent hull of two circles).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "x0",
        "y0",
        "x1",
        "y1",
        "r0",
        "r1"
      ],
      "properties": {
        "kind": {
          "const": "capsule"
        },
        "x0": {
          "type": "number"
        },
        "y0": {
          "type": "number"
        },
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        },
        "r0": {
          "type": "number",
          "minimum": 0
        },
        "r1": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "EllipseShape": {
      "description": "An ellipse in local coordinates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "cx",
        "cy",
        "rx",
        "ry"
      ],
      "properties": {
        "kind": {
          "const": "ellipse"
        },
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "rx": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ry": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotationDeg": {
          "type": "number"
        }
      }
    },
    "RectShape": {
      "description": "A rectangle with optional corner radius, lower-left at (x, y).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "kind": {
          "const": "rect"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "r": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "PolyShape": {
      "description": "A polygon or polyline through local points.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "points",
        "closed"
      ],
      "properties": {
        "kind": {
          "const": "poly"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2
        },
        "closed": {
          "type": "boolean"
        }
      }
    },
    "PathShape": {
      "description": "An SVG-style path (M L H V C S Q T A Z, absolute or relative) in local metres, y up.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "d"
      ],
      "properties": {
        "kind": {
          "const": "path"
        },
        "d": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ShapeGeometry": {
      "description": "One of the shape primitives.",
      "oneOf": [
        {
          "$ref": "#/$defs/CapsuleShape"
        },
        {
          "$ref": "#/$defs/EllipseShape"
        },
        {
          "$ref": "#/$defs/RectShape"
        },
        {
          "$ref": "#/$defs/PolyShape"
        },
        {
          "$ref": "#/$defs/PathShape"
        }
      ]
    },
    "Shape": {
      "description": "An authored shape bound to a bone: one geometry plus the common fields.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "bone",
            "role",
            "lod",
            "z",
            "filled",
            "tone",
            "x0",
            "y0",
            "x1",
            "y1",
            "r0",
            "r1"
          ],
          "properties": {
            "kind": {
              "const": "capsule"
            },
            "id": {
              "$ref": "#/$defs/Slug"
            },
            "bone": {
              "$ref": "#/$defs/Slug"
            },
            "role": {
              "$ref": "#/$defs/ShapeRole"
            },
            "lod": {
              "$ref": "#/$defs/Lod"
            },
            "z": {
              "type": "number"
            },
            "filled": {
              "type": "boolean"
            },
            "tone": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "region": {
              "$ref": "#/$defs/Slug"
            },
            "material": {
              "$ref": "#/$defs/Slug"
            },
            "x0": {
              "type": "number"
            },
            "y0": {
              "type": "number"
            },
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "r0": {
              "type": "number",
              "minimum": 0
            },
            "r1": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "bone",
            "role",
            "lod",
            "z",
            "filled",
            "tone",
            "cx",
            "cy",
            "rx",
            "ry"
          ],
          "properties": {
            "kind": {
              "const": "ellipse"
            },
            "id": {
              "$ref": "#/$defs/Slug"
            },
            "bone": {
              "$ref": "#/$defs/Slug"
            },
            "role": {
              "$ref": "#/$defs/ShapeRole"
            },
            "lod": {
              "$ref": "#/$defs/Lod"
            },
            "z": {
              "type": "number"
            },
            "filled": {
              "type": "boolean"
            },
            "tone": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "region": {
              "$ref": "#/$defs/Slug"
            },
            "material": {
              "$ref": "#/$defs/Slug"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "rx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ry": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rotationDeg": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "bone",
            "role",
            "lod",
            "z",
            "filled",
            "tone",
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "kind": {
              "const": "rect"
            },
            "id": {
              "$ref": "#/$defs/Slug"
            },
            "bone": {
              "$ref": "#/$defs/Slug"
            },
            "role": {
              "$ref": "#/$defs/ShapeRole"
            },
            "lod": {
              "$ref": "#/$defs/Lod"
            },
            "z": {
              "type": "number"
            },
            "filled": {
              "type": "boolean"
            },
            "tone": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "region": {
              "$ref": "#/$defs/Slug"
            },
            "material": {
              "$ref": "#/$defs/Slug"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "r": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "bone",
            "role",
            "lod",
            "z",
            "filled",
            "tone",
            "points",
            "closed"
          ],
          "properties": {
            "kind": {
              "const": "poly"
            },
            "id": {
              "$ref": "#/$defs/Slug"
            },
            "bone": {
              "$ref": "#/$defs/Slug"
            },
            "role": {
              "$ref": "#/$defs/ShapeRole"
            },
            "lod": {
              "$ref": "#/$defs/Lod"
            },
            "z": {
              "type": "number"
            },
            "filled": {
              "type": "boolean"
            },
            "tone": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "region": {
              "$ref": "#/$defs/Slug"
            },
            "material": {
              "$ref": "#/$defs/Slug"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 2
            },
            "closed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "bone",
            "role",
            "lod",
            "z",
            "filled",
            "tone",
            "d"
          ],
          "properties": {
            "kind": {
              "const": "path"
            },
            "id": {
              "$ref": "#/$defs/Slug"
            },
            "bone": {
              "$ref": "#/$defs/Slug"
            },
            "role": {
              "$ref": "#/$defs/ShapeRole"
            },
            "lod": {
              "$ref": "#/$defs/Lod"
            },
            "z": {
              "type": "number"
            },
            "filled": {
              "type": "boolean"
            },
            "tone": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "region": {
              "$ref": "#/$defs/Slug"
            },
            "material": {
              "$ref": "#/$defs/Slug"
            },
            "d": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "BoneOffset": {
      "description": "An offset from rest for one bone.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "angleDeg": {
          "type": "number"
        },
        "dx": {
          "type": "number"
        },
        "dy": {
          "type": "number"
        }
      }
    },
    "AppliedLoad": {
      "description": "A load applied at an anchor or a bone point, in world newtons.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "fxN",
        "fyN",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Slug"
        },
        "kind": {
          "enum": [
            "carried",
            "imposed",
            "live",
            "wind",
            "snow",
            "occupant",
            "equipment"
          ]
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "anchor": {
          "$ref": "#/$defs/Slug"
        },
        "bone": {
          "$ref": "#/$defs/Slug"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "fxN": {
          "type": "number"
        },
        "fyN": {
          "type": "number"
        },
        "momentNm": {
          "type": "number"
        },
        "distributed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bone",
            "fromM",
            "toM",
            "wxNPerM",
            "wyNPerM"
          ],
          "properties": {
            "bone": {
              "$ref": "#/$defs/Slug"
            },
            "fromM": {
              "type": "number"
            },
            "toM": {
              "type": "number"
            },
            "wxNPerM": {
              "type": "number"
            },
            "wyNPerM": {
              "type": "number"
            }
          }
        },
        "source": {
          "$ref": "#/$defs/ParameterSource"
        },
        "reference": {
          "$ref": "#/$defs/Slug"
        }
      }
    },
    "ThermalBinding": {
      "description": "The thermal state a pose binds.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "activityMet": {
          "type": "number",
          "minimum": 0
