{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "placements": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "integer",
                  "minimum": 0
                },
                "type": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D"
                  ]
                },
                "family": {
                  "enum": [
                    "Slash",
                    "Backslash",
                    "J",
                    "L",
                    "P",
                    "S"
                  ]
                },
                "origin": {
                  "$ref": "#/$defs/point"
                },
                "axes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/point"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "slot",
                "type",
                "family",
                "origin",
                "axes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "placements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "cases"
  ],
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
