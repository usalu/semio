{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source",
    "basis",
    "contact_tolerance",
    "minimum_volume",
    "layouts",
    "controls",
    "links",
    "corner_probes"
  ],
  "properties": {
    "source": {
      "const": "domus"
    },
    "basis": {
      "const": "assumed"
    },
    "contact_tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "minimum_volume": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "layouts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    },
    "links": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": [
          "mount",
          "contacts"
        ],
        "additionalProperties": false,
        "properties": {
          "mount": {
            "type": "string"
          },
          "contacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "corner_probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "part",
          "point"
        ],
        "properties": {
          "part": {
            "type": "string"
          },
          "point": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
