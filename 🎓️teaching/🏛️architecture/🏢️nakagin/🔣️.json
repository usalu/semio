  "notes": [
    {
      "id": "teaching-model",
      "text": {
        "en": "Simplified, rounded teaching model of the Nakagin Capsule Tower (Kisho Kurokawa, Ginza, Tokyo, 1970-1972, demolished 2022); not a survey.",
        "de": "Vereinfachtes, gerundetes Lehrmodell des Nakagin Capsule Tower (Kisho Kurokawa, Ginza, Tokio, 1970-1972, 2022 abgerissen); keine Bauaufnahme."
      }
    },
    {
      "id": "interior-size",
      "text": {
        "en": "The historical interior size 2.3 x 3.8 x 2.1 m is kept as sourced interior size; the outer size is 2.5 x 4.0 x 2.5 m.",
        "de": "Die historische Innenmasse 2,3 x 3,8 x 2,1 m bleibt als belegte Innenmasse erhalten; die Aussenmasse ist 2,5 x 4,0 x 2,5 m."
      }
    },
    {
      "id": "facade-gap",
      "text": {
        "en": "Tower A carries no capsules on its west facade (index 3): it faces Tower B and the three bridges. Tower B has no capsule on its west facade (index 3) on the top capsule storey, where the capital's service side lies.",
        "de": "Turm A trägt an seiner Westfassade (Index 3) keine Kapseln: sie liegt zu Turm B und den drei Brücken hin. Turm B hat im obersten Kapselgeschoss an der Westfassade (Index 3) keine Kapsel, dort liegt die Wartungsseite des Kopfbaus."
      }
    },
    {
      "id": "type-pattern",
      "text": {
        "en": "The capsule type of each slot follows a deterministic modular pattern; type counts are derived, not typed. Only the capsule shape is historical, the room programs are teaching proposals.",
        "de": "Der Kapseltyp jedes Platzes folgt einem deterministischen Modulo-Muster; die Typanzahlen werden abgeleitet, nicht eingetippt. Historisch ist nur die Kapselform, die Raumprogramme sind Lehrvorschläge."
      }
    }
  ],
