{
  "name": "@repo/coordinator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/server/coordinator",
        "command": "go run .",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/server/coordinator",
        "command": "bun scripts/build-server.ts",
        "forwardAllArgs": true
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/server/coordinator",
        "command": "go run .",
        "forwardAllArgs": true
      }
    },
    "worker": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/server/coordinator",
        "command": "bun lib/worker.ts",
        "forwardAllArgs": true
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/server/coordinator",
        "command": "bun lib/migrate.ts",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/server/coordinator",
        "command": "bunx vitest run",
        "forwardAllArgs": true
      }
    }
  }
}