{
  "name": "@semio-tech/repo-vscode",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/client/vscode",
        "command": "bun ./script.ts dev",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/client/vscode",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/client/vscode",
        "command": "bun ./script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/client/vscode",
        "command": "bun ./script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/client/vscode",
        "command": "bun ./script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/client/vscode",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/client/vscode",
        "command": "bun ./script.ts lint",
        "forwardAllArgs": true
      }
    },
    "build-vsix": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "repo/client/vscode",
        "command": "bun ./script.ts build-vsix",
        "forwardAllArgs": true
      }
    }
  }
}
