{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "compose/js/*": [
        "../../compose/js/*"
      ],
      "compose/js": [
        "../../compose/js/index.ts"
      ],
      "compose/asset/*": [
        "../../compose/asset/*"
      ]
    }
  },
  "include": [
    "extension.test.ts",
    "extension.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "test"
  ]
}