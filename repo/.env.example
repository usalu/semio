# PostgreSQL
POSTGRES_DB=semio_repo
POSTGRES_USER=semio
POSTGRES_PASSWORD=changeme

# Server
DATABASE_URL=postgresql://semio:changeme@localhost:5432/semio_repo
APP_BASE_URL=https://repo.semio.dev

# Discord (optional)
DISCORD_WEBHOOK_URL=

# GitHub webhook secret (optional)
GITHUB_WEBHOOK_SECRET=

# Caddy domain
DOMAIN=repo.semio.dev

# Blob storage root
UPLOAD_BLOB_ROOT=/srv/semio/blob
