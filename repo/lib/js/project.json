{
  "name": "@semio-tech/repo-lib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "repo/lib/js",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/repo/lib/js",
        "command": "bun ./script.ts lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}/repo/lib/js",
        "command": "bun ./script.ts test"
      }
    }
  }
}
