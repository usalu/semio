{
  "name": "@semio-tech/repo-cli-rs",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/cli/rs",
        "command": "bun ./script.ts build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/cli/rs",
        "command": "bun ./script.ts test"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "repo/cli/rs",
        "command": "bun ./script.ts run",
        "forwardAllArgs": true
      }
    }
  }
}
