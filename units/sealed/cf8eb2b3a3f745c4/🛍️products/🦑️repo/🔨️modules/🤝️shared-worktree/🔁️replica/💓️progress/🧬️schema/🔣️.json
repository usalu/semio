{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Scope": {
      "enum": [
        "git-health-metadata",
        "git-heal-metadata"
      ]
    },
    "Policy": {
      "const": {
        "quietMs": 120000,
        "probeMs": 5000,
        "probeIntervalMs": 10000,
        "pollMs": 1000,
        "maximumLagMs": 2000,
        "restartPauseMs": 1800000
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "reason",
        "scope",
        "pid",
        "began",
        "attested",
        "at"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "reason": {
          "const": "git-metadata-progress-stall"
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "began": {
          "type": "integer",
          "minimum": 1
        },
        "attested": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
