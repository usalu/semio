{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/framework/repo/shared-worktree/packgate/v1",
 "title": "Shared worktree pack gate: which packs of .git/objects/pack may leave this machine",
 "definitions": {
  "StagePackedPolicy": {"const":{"maximumIndexBytes":67108864,"maximumBatchObjects":5000,"maximumHeaderBytes":128}},
  "PackAuthorisation": {
   "description": ".git/semio-packs.json, written only by the consolidator on the machine that consolidates: publish lists the stems of packs the replica may publish, retire the stems (and 'multi-pack-index') whose deletion it may publish; each maps to the wall clock milliseconds of the entry, older entries are dropped after 12 hours. Every other pack of the directory stays on its machine.",
   "type": "object",
   "additionalProperties": false,
   "required": ["version", "publish", "retire"],
   "properties": {
    "version": {"type": "integer", "const": 1},
    "publish": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "retire": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
   }
  },
  "Rescue": {
   "description": "What one rescue pass did: local packs examined, objects the fleet lacked that were written as loose objects, packs retired locally, packs kept because their missing objects could not be saved.",
   "type": "object",
   "additionalProperties": false,
   "required": ["examined", "objects", "retired", "kept"],
   "properties": {
    "examined": {"type": "integer", "minimum": 0},
    "objects": {"type": "integer", "minimum": 0},
    "retired": {"type": "integer", "minimum": 0},
    "kept": {"type": "integer", "minimum": 0}
   }
  },
    "RescueProbeFixture": {"type":"object","additionalProperties":false,"required":["minimumAgeMilliseconds","cases"],"properties":{"minimumAgeMilliseconds":{"type":"integer","minimum":1},"cases":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","rows"],"properties":{"id":{"type":"string"},"rows":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["stem","role","files","ageMilliseconds"],"properties":{"stem":{"type":"string","pattern":"^pack-[a-z-]+$"},"role":{"enum":["fleet","authorised","local"]},"files":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["idx","pack"]}},"ageMilliseconds":{"type":"integer","minimum":0}}}}}}}}}
  }
}
