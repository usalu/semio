{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/framework/repo/shared-worktree/canary/v1",
 "title": "Shared worktree canary: the admission of new code (who goes first, who follows), the refusal records of the store and the language-agnostic fixture",
 "definitions": {
  "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "OriginId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
  "Count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
  "Reason": {"type": "string", "minLength": 1, "maxLength": 512},
  "Refusal": {
   "type": "object",
   "additionalProperties": false,
   "required": ["digest", "reason", "wallMs"],
   "properties": {
    "digest": {"$ref": "#/definitions/Sha256"},
    "reason": {"$ref": "#/definitions/Reason"},
    "wallMs": {"$ref": "#/definitions/Count"}
   }
  },
  "Refusals": {
   "type": "object",
   "additionalProperties": false,
   "required": ["originId", "refused", "version"],
   "properties": {
    "version": {"const": 1},
    "originId": {"$ref": "#/definitions/OriginId"},
    "refused": {"type": "array", "maxItems": 64, "items": {"$ref": "#/definitions/Refusal"}}
   }
  },
  "RefusalBy": {
   "type": "object",
   "additionalProperties": false,
   "required": ["digest", "originId", "reason", "wallMs"],
   "properties": {
    "digest": {"$ref": "#/definitions/Sha256"},
    "originId": {"$ref": "#/definitions/OriginId"},
    "reason": {"$ref": "#/definitions/Reason"},
    "wallMs": {"$ref": "#/definitions/Count"}
   }
  },
  "Peer": {
   "type": "object",
   "additionalProperties": false,
   "required": ["code", "fallback", "groupId", "originId", "sync", "wallMs"],
   "properties": {
    "originId": {"$ref": "#/definitions/OriginId"},
    "groupId": {"$ref": "#/definitions/OriginId"},
    "code": {"$ref": "#/definitions/Sha256"},
    "wallMs": {"$ref": "#/definitions/Count"},
    "sync": {"type": "boolean"},
    "fallback": {"type": "boolean"}
   }
  },
  "Limits": {
   "type": "object",
   "additionalProperties": false,
   "required": ["canaryMs", "freshMs", "turnMs", "waitMs"],
   "properties": {
    "freshMs": {"$ref": "#/definitions/Count"},
    "waitMs": {"$ref": "#/definitions/Count"},
    "turnMs": {"$ref": "#/definitions/Count"},
    "canaryMs": {"$ref": "#/definitions/Count"}
   }
  },
  "Input": {
   "type": "object",
   "additionalProperties": false,
   "required": ["authored", "digest", "groupId", "healthy", "limits", "now", "originId", "peers", "refusals", "retired", "running", "snapshots", "waitedMs"],
   "properties": {
    "digest": {"$ref": "#/definitions/Sha256"},
    "running": {"$ref": "#/definitions/Sha256"},
    "originId": {"$ref": "#/definitions/OriginId"},
    "groupId": {"$ref": "#/definitions/OriginId"},
    "now": {"$ref": "#/definitions/Count"},
    "waitedMs": {"$ref": "#/definitions/Count"},
    "authored": {"type": "boolean"},
    "peers": {"type": "array", "items": {"$ref": "#/definitions/Peer"}},
    "retired": {"type": "array", "items": {"$ref": "#/definitions/OriginId"}},
    "snapshots": {"type": "array", "items": {"$ref": "#/definitions/Sha256"}},
    "refusals": {"type": "array", "items": {"$ref": "#/definitions/RefusalBy"}},
    "healthy": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Count"}},
    "limits": {"$ref": "#/definitions/Limits"}
   }
  },
  "Verdict": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": ["ok", "role"],
     "properties": {
      "ok": {"const": true},
      "role": {"enum": ["running", "snapshot", "follower", "author", "leader"]}
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": ["ok", "origin", "seconds", "why"],
     "properties": {
      "ok": {"const": false},
      "why": {"enum": ["refused", "canary", "turn", "mixed"]},
      "origin": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/OriginId"}]},
      "seconds": {"$ref": "#/definitions/Count"}
     }
    }
   ]
  },
  "DecisionCase": {
   "type": "object",
   "additionalProperties": false,
   "required": ["expected", "input", "name"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "input": {"$ref": "#/definitions/Input"},
    "expected": {"$ref": "#/definitions/Verdict"}
   }
  },
  "TrackerStep": {
   "type": "object",
   "additionalProperties": false,
   "required": ["expected", "now", "peers"],
   "properties": {
    "now": {"$ref": "#/definitions/Count"},
    "peers": {"type": "array", "items": {"$ref": "#/definitions/Peer"}},
    "expected": {"type": "object", "additionalProperties": {"$ref": "#/definitions/Count"}}
   }
  },
  "TrackerCase": {
   "type": "object",
   "additionalProperties": false,
   "required": ["digest", "freshMs", "name", "originId", "steps"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "digest": {"$ref": "#/definitions/Sha256"},
    "originId": {"$ref": "#/definitions/OriginId"},
    "freshMs": {"$ref": "#/definitions/Count"},
    "steps": {"type": "array", "items": {"$ref": "#/definitions/TrackerStep"}}
   }
  },
  "Fixture": {
   "type": "object",
   "additionalProperties": false,
   "required": ["decisions", "trackers", "version"],
   "properties": {
    "version": {"const": 1},
    "decisions": {"type": "array", "items": {"$ref": "#/definitions/DecisionCase"}},
    "trackers": {"type": "array", "items": {"$ref": "#/definitions/TrackerCase"}}
   }
  }
 }
}
