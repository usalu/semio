{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/repo/cargo-component-runs/v1",
  "definitions": {
    "Collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needBytes", "candidates", "measured", "removed"],
      "properties": {
        "needBytes": { "type": "integer", "minimum": 1 },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "ageMilliseconds", "components"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "ageMilliseconds": { "type": "integer", "minimum": 0 },
              "components": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "measured": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Policy": {
      "const": {
        "directory": "components/runs",
        "materializedDirectory": "w",
        "linkedSuffix": ".linked",
        "artifactMarker": ".semio-artifact.json",
        "activityDirectories": ["l", "r", "j"],
        "heldMilliseconds": 1800000,
        "retainedFailedRuns": 3,
        "reportedRemovals": 8,
        "yieldEvery": 8
      }
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "lastUsedMs", "components", "held"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "lastUsedMs": { "type": "integer", "minimum": 0 },
        "components": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "held": { "type": "boolean" }
      }
    },
    "Removal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "Vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input", "remove"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["needBytes", "runs"],
          "properties": {
            "needBytes": { "type": "integer", "minimum": 0 },
            "runs": { "type": "array", "items": { "$ref": "#/definitions/Run" } }
          }
        },
        "remove": { "type": "array", "items": { "$ref": "#/definitions/Removal" } }
      }
    },
    "Messages": {
      "const": {
        "scan": {
          "en": "[repo cache] scanning component runs below {root}",
          "de": "[repo cache] durchsuche Komponentenläufe unter {root}"
        },
        "would": {
          "en": "[repo cache] would remove component run {path} ({bytes}, a newer run materialized all its components)",
          "de": "[repo cache] würde Komponentenlauf {path} entfernen ({bytes}, ein neuerer Lauf hat alle seine Komponenten erzeugt)"
        },
        "removed": {
          "en": "[repo cache] removed component run {path} ({bytes}, a newer run materialized all its components)",
          "de": "[repo cache] Komponentenlauf {path} entfernt ({bytes}, ein neuerer Lauf hat alle seine Komponenten erzeugt)"
        },
        "changed": {
          "en": "[repo cache] kept component run {path}: it changed while the collection planned",
          "de": "[repo cache] Komponentenlauf {path} behalten: er hat sich während der Planung verändert"
        },
        "summaryPlan": {
          "en": "[repo cache] component runs: would remove {count} of {total} ({bytes}); {held} held by a running build, {kept} kept",
          "de": "[repo cache] Komponentenläufe: würde {count} von {total} entfernen ({bytes}); {held} von einem laufenden Build gehalten, {kept} behalten"
        },
        "summaryApply": {
          "en": "[repo cache] component runs: removed {count} of {total} ({bytes}); {held} held by a running build, {kept} kept",
          "de": "[repo cache] Komponentenläufe: {count} von {total} entfernt ({bytes}); {held} von einem laufenden Build gehalten, {kept} behalten"
        }
      }
    }
  }
}
