{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native storage verification observations",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "maximumCounter": 9007199254740991
      }
    },
    "Backend": {"enum": ["mounted-image", "directory-partition"]},
    "Phase": {"enum": ["storeIdentity", "reservationOperation", "allocationJournal", "journalGrant", "journalRead", "mappingGrant", "volumeIdentity", "mappingProof", "physicalGateCached", "physicalGateJoin", "physicalGateVerify", "imageInventory", "descendantChecks", "allocatedUsage"]},
    "Counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "Timing": {
      "description": "Inclusive elapsed milliseconds summed over occurrences, including the active portion. Nested phases can overlap. Counts do not measure filesystem operations.",
      "type": "object",
      "additionalProperties": false,
      "required": ["started", "active", "milliseconds"],
      "properties": {
        "started": {"$ref":"#/definitions/Counter"},
        "active": {"$ref":"#/definitions/Counter"},
        "milliseconds": {"$ref":"#/definitions/Counter"}
      }
    },
    "Snapshot": {
      "type": "object",
      "propertyNames": {"$ref":"#/definitions/Backend"},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"$ref":"#/definitions/Phase"},
        "additionalProperties": {"$ref":"#/definitions/Timing"}
      }
    }
  }
}
