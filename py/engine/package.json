{
  "name": "@semio/engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "py/engine",
  "projectType": "application",
  "scripts": {
    "dev": "tsx ./dev.ts",
    "build": "tsx ./build.ts",
    "test": "tsx ./test.ts",
    "preflight": "ruff format . && ruff check --fix . || echo \"Warning: ruff not found. Install with: pip install ruff\""
  },
  "targets": {
    "update": {
      "executor": "@nxlv/python:update"
    },
    "lock": {
      "executor": "@nxlv/python:lock"
    }
  },
  "devDependencies": {
    "@semio/assets": "*"
  },
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  }
}