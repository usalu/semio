{
  "name": "@semio-tech/architect-program",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "architect/program",
        "command": "bun ./script.ts test",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "architect/program",
        "command": "bun ./script.ts lint",
        "forwardAllArgs": true
      }
    }
  }
}
