# Auto detect text files and normalize to LF
* text=auto eol=lf

# Shell scripts must always use LF
*.sh text eol=lf

# Batch files should use CRLF on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.wasm binary
