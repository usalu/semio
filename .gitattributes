# Auto detect text files and normalize to LF
* text=auto eol=lf

# Shell scripts must always use LF
*.sh text eol=lf
repo/hooks/* text eol=lf

# Batch files should use CRLF on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.wasm binary
*.pack.semio binary
*.spr.semio binary

# 🧫️ Fixture bytes are evidence (every fixture manifest pins a sha256). Line-ending normalization
# rewrote a real terminal log's two CRLF sequences to LF on commit, so nothing under a fixture tree is
# ever normalized; `-text` disables EOL conversion only and keeps textual diffs.
**/🧫️fixtures/** -text

# 🧫️ Real-world artifact fixtures. `* text=auto` leaves these to git's content heuristic; a binary
# that heuristic misreads gets line-ending normalized on checkout and is then corrupt for every
# byte-exact round-trip test that reads it.
*.pdf binary
*.glb binary
*.gltf binary
*.3dm binary
*.dwg binary
*.mp4 binary
*.mp3 binary
*.avi binary
*.wav binary
*.bmp binary
*.tif binary
*.tiff binary
*.stl binary
*.ply binary
*.las binary
*.laz binary
*.xlsx binary
*.docx binary
*.pptx binary
*.bcf binary
*.ttf binary
*.woff binary
*.woff2 binary
