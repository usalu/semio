{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "bun"
  },
  "useDaemonProcess": true,
  "defaultBase": "⛳wip",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/📜️script.ts",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🟨️.mjs",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/**/*",
      {
        "runtime": "node -p \"process.platform.concat(process.arch)\""
      },
      {
        "runtime": "bun --version"
      }
    ],
    "schemaSources": [
      "sharedGlobals",
      "{workspaceRoot}/**/🧬️schema/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔣️taxonomy.json",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔍️discovery/🟦️.ts"
    ],
    "production": ["default", "!{projectRoot}/**/🧪️tests/**/*", "!{projectRoot}/**/?(*.)+(stories|story|mdx).[cmjtshx]?([sx])?(.snap)?", "!{projectRoot}/.storybook/**"],
    "cargo": ["{projectRoot}/**/*.rs", "{projectRoot}/Cargo.toml", "{workspaceRoot}/Cargo.lock"],
    "go": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum", "{workspaceRoot}/go.work", "{workspaceRoot}/go.work.sum"],
    "uv": ["{projectRoot}/**/*.py", "{projectRoot}/pyproject.toml", "{workspaceRoot}/uv.lock"],
    "dotnet": ["{projectRoot}/**/*.cs", "{projectRoot}/**/*.csproj", "{workspaceRoot}/Monorepo.sln"]
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzePackageJson": false,
      "analyzeSourceFiles": false,
      "analyzeLockfile": false
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js",
      "options": {
        "analyzePackageJson": false,
        "analyzeSourceFiles": false
      }
    },
    {
      "plugin": "@nxlv/python",
      "options": {}
    },
    {
      "plugin": "./🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🟨️.mjs",
      "include": ["**/📋️project.json", "**/Cargo.toml", "bun.lock", "**/*.patch"],
      "options": { "analyzeLockfile": true }
    },
    {
      "plugin": "./🧰️framework/🛍️products/🦑️repo/🔨️modules/🧪️test/🟨️.mjs",
      "options": {}
    }
  ],
  "parallel": 3,
  "cacheDirectory": ".nx/cache",
  "maxCacheSize": "8GB",
  "analytics": false
}
