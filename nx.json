{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "bun"
  },
  "useDaemonProcess": true,
  "defaultBase": "⛳wip",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      {
        "runtime": "node -p \"process.platform.concat(process.arch)\""
      },
      {
        "runtime": "bun --version"
      },
      {
        "env": "SEMIO_BUILD_MODE"
      }
    ],
    "schemaSources": [
      "sharedGlobals",
      "{workspaceRoot}/**/🧬️schema/**/*",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔣️taxonomy.json",
      "{workspaceRoot}/🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🔍️discovery/**/*.ts"
    ],
    "production": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "!{projectRoot}/**/🧪️tests/**/*",
      "!{projectRoot}/{🧫️fixtures,🧫️examples,🧪️fixtures,🧪️examples}/**/*",
      "!{projectRoot}/**/!(🔨️modules)/{🧫️fixtures,🧫️examples,🧪️fixtures,🧪️examples}/**/*",
      "!{projectRoot}/**/?(*.)+(stories|story|mdx).[cmjtshx]?([sx])?(.snap)?",
      "!{projectRoot}/.storybook/**"
    ],
    "cargo": [
      "{projectRoot}/**/*.rs",
      "{projectRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml"
    ],
    "go": [
      "{projectRoot}/**/*.go",
      "{projectRoot}/go.mod",
      "{projectRoot}/go.sum",
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum"
    ],
    "uv": [
      "{projectRoot}/**/*.py",
      "{projectRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock"
    ],
    "dotnet": [
      "{projectRoot}/**/*.cs",
      "{projectRoot}/**/*.csproj"
    ],
    "nativeSources": [
      "production"
    ],
    "nativeTestSources": [
      "default"
    ]
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzePackageJson": false,
      "analyzeSourceFiles": false,
      "analyzeLockfile": false
    },
    "@repo/emoji-project-json": {
      "dependencyResolutionAuthority": {
        "module": "./🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🟨️.mjs",
        "export": "dependencyResolutionAuthority"
      }
    }
  },
  "plugins": [
    {
      "plugin": "./🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/🟨️.mjs",
      "include": [
        "📋️project.json"
      ],
      "options": {}
    }
  ],
  "cacheDirectory": ".🧬semio/🦑️repo/⚡️cache/rust/fixed/m/nx/artifacts",
  "analytics": false
}
