        },
        {
          "command": "semio.filter.toggle.definition.constant",
          "when": "view == semio.filter && viewItem == filter_definition",
          "group": "inline@3"
        },
        {
          "command": "semio.filter.toggle.goal.open",
          "when": "view == semio.filter && viewItem == filter_goal",
          "group": "inline@1"
        },
        {
          "command": "semio.filter.toggle.goal.closed",
          "when": "view == semio.filter && viewItem == filter_goal",
          "group": "inline@2"
        },
        {
          "command": "semio.filter.toggle.ticket.open",
          "when": "view == semio.filter && viewItem == filter_ticket",
          "group": "inline@1"
        },
        {
          "command": "semio.filter.toggle.ticket.closed",
          "when": "view == semio.filter && viewItem == filter_ticket",
          "group": "inline@2"
        },
        {
          "command": "semio.sectionRename",
          "when": "view == semio.sections && viewItem == section",
          "group": "inline"
        },
        {
          "command": "semio.sectionCreateChild",
          "when": "view == semio.sections && viewItem == section",
          "group": "inline"
        },
        {
          "command": "semio.sectionRemove",
          "when": "view == semio.sections && viewItem == section",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "semio-repo",
      "properties": {
        "semio.repo.showIgnored": {
          "type": "boolean",
          "default": false,
          "description": "Show ignored folders and files in the codebase view"
        },
        "semio.repo.showGenerated": {
          "type": "boolean",
          "default": false,
          "description": "Show generated folders and files in the codebase view"
        },
        "semio.repo.excludeKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "code",
              "script",
              "config",
              "test",
              "docs",
              "resource",
              "license"
            ]
          },
          "default": [],
          "description": "Exclude specific kinds of files from the codebase view"
        }
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "test": "vscode-test",
    "build": "npm run build:codegen && vite build && vite build --config vite.test.config.ts",
    "build:codegen": "graphql-codegen --config codegen.ts",
    "package": "vsce package --no-dependencies --out semio-repo.vsix",
    "preflight": "tsc --noEmit",
    "vscode:prepublish": "npm run build"
  },
