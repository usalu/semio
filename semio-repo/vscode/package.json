    "keybindings": [
      {
        "command": "semio.sectionRename",
        "key": "f2",
        "when": "view == semio.sections && viewItem == section"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "semio.refreshMonorepo",
          "when": "view == semio.monorepo",
          "group": "navigation@1"
        },
        {
          "command": "semio.refreshCodebase",
          "when": "view == semio.filter",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "semio.refreshItem",
          "when": "view == semio.monorepo && viewItem =~ /^(root_projects|root_goals|root_tickets|root_policies|root_contributors|root_commits|project|bundle|folder|file|section)$/",
          "group": "inline@98"
        },
        {
          "command": "semio.copyId",
          "when": "view == semio.monorepo && viewItem =~ /^(project|bundle|folder|file|section|definition|goal|ticket|policy|violation|contributor|commit|ticket_year|ticket_month|ticket_day|contributor_email|contributor_link)$/",
          "group": "inline@99"
        },
        {
          "command": "semio.ticketClose",
          "when": "view == semio.monorepo && viewItem == ticket",
          "group": "inline@1"
        },
        {
          "command": "semio.ticketReopen",
          "when": "view == semio.monorepo && viewItem == ticket",
          "group": "inline@2"
        },
        {
          "command": "semio.copyCommitSha",
          "when": "view == semio.monorepo && viewItem == commit",
          "group": "inline@1"
        },
        {
          "command": "semio.openCommitInGitHub",
          "when": "view == semio.monorepo && viewItem == commit",
          "group": "inline@2"
        },
        {
          "command": "semio.checkPolicy",
          "when": "view == semio.monorepo && viewItem == policy",
          "group": "inline@1"
        },
        {
          "command": "semio.filter.toggle.project.user",
          "when": "view == semio.filter && viewItem == filter_project",
          "group": "inline@1"
        },
        {
          "command": "semio.filter.toggle.project.infrastructure",
