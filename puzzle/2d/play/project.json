{
  "name": "@semio-tech/puzzle-2d-play",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "puzzle/2d/play",
        "command": "bun ./script.ts dev",
        "env": {
          "PUZZLE_2D_PLAY_PORT": "6012",
          "NODE_OPTIONS": "",
          "NX_NATIVE_COMMAND_RUNNER": "false",
          "NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
          "NX_TUI": "false",
          "VSCODE_INSPECTOR_OPTIONS": ""
        },
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "puzzle/2d/play",
        "command": "bun ./script.ts build",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "puzzle/2d/play",
        "command": "bun ./script.ts test",
        "env": {
          "PUZZLE_2D_PLAY_PORT": "6027"
        },
        "forwardAllArgs": true
      }
    }
  }
}
