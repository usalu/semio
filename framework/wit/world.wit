package semio:framework;

interface types {
  record plugin-manifest-json {
    json: string,
  }

  record action-invocation-json {
    json: string,
  }

  record action-context-json {
    json: string,
  }

  record action-response-json {
    json: string,
  }

  record window-input-json {
    json: string,
  }

  record window-output-json {
    json: string,
  }

  record plugin-tools-json {
    json: string,
  }

  record plugin-window-engagements-json {
    json: string,
  }

  record plugin-window-measures-json {
    json: string,
  }

  record app-labels-json {
    json: string,
  }

  record migrate-document-input {
    from-version: string,
    to-version: string,
    data: list<u8>,
  }

  record migrate-document-output {
    data: list<u8>,
  }

  variant plugin-error {
    message(string),
  }
}

interface plugin {
  use types.{
    plugin-manifest-json,
    action-invocation-json,
    action-context-json,
    action-response-json,
    window-input-json,
    window-output-json,
    plugin-tools-json,
    plugin-window-engagements-json,
    plugin-window-measures-json,
    app-labels-json,
    migrate-document-input,
    migrate-document-output,
    plugin-error,
  };

  manifest: func() -> plugin-manifest-json;
  instantiate-app: func(app-id: string, instance-id: string) -> result<u32, plugin-error>;
  handle-action: func(
    instance-id: u32,
    action: action-invocation-json,
    context: action-context-json,
  ) -> result<action-response-json, plugin-error>;
  update-window: func(
    instance-id: u32,
    input: window-input-json,
  ) -> result<window-output-json, plugin-error>;
  list-tools: func(
    instance-id: u32,
    context: action-context-json,
  ) -> result<plugin-tools-json, plugin-error>;
  window-engagements: func(
    instance-id: u32,
    context: action-context-json,
  ) -> result<plugin-window-engagements-json, plugin-error>;
  window-measures: func(
    instance-id: u32,
    context: action-context-json,
  ) -> result<plugin-window-measures-json, plugin-error>;
  app-labels: func(
    instance-id: u32,
    context: action-context-json,
  ) -> result<app-labels-json, plugin-error>;
  migrate-document: func(input: migrate-document-input) -> result<migrate-document-output, plugin-error>;
}

interface host {
  log: func(level: string, message: string);
  now-ms: func() -> s64;
  read-document: func(handle: u64) -> result<string, string>;
  write-document: func(handle: u64, payload-json: string) -> result<_, string>;
  open-window: func(kind: string, params-json: string) -> result<u64, string>;
  invoke-action: func(target: string, invocation-json: string) -> result<string, string>;
  read-asset: func(handle: u64) -> result<list<u8>, string>;
  network-fetch: func(origin: string, path: string) -> result<list<u8>, string>;
  backbone-send: func(uri: string, message-json: string) -> result<_, string>;
  backbone-poll: func(uri: string) -> result<list<string>, string>;
}

world plugin-world {
  import host;
  export plugin;
}
