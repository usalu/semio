package semio:framework;

interface types {
  record plugin-manifest-json {
    json: string,
  }

  record command-invocation-json {
    json: string,
  }

  record command-context-json {
    json: string,
  }

  record command-response-json {
    json: string,
  }

  record window-input-json {
    json: string,
  }

  record window-output-json {
    json: string,
  }

  record migrate-model-input {
    from-version: string,
    to-version: string,
    data: list<u8>,
  }

  record migrate-model-output {
    data: list<u8>,
  }

  variant plugin-error {
    message(string),
  }
}

interface plugin {
  use types.{
    plugin-manifest-json,
    command-invocation-json,
    command-context-json,
    command-response-json,
    window-input-json,
    window-output-json,
    migrate-model-input,
    migrate-model-output,
    plugin-error,
  };

  manifest: func() -> plugin-manifest-json;
  instantiate-app: func(app-id: string, instance-id: string) -> result<u32, plugin-error>;
  handle-command: func(
    instance-id: u32,
    command: command-invocation-json,
    context: command-context-json,
  ) -> result<command-response-json, plugin-error>;
  update-window: func(
    instance-id: u32,
    input: window-input-json,
  ) -> result<window-output-json, plugin-error>;
  migrate-model: func(input: migrate-model-input) -> result<migrate-model-output, plugin-error>;
}

interface host {
  log: func(level: string, message: string);
  now-ms: func() -> s64;
  read-model: func(handle: u64) -> result<string, string>;
  write-model: func(handle: u64, payload-json: string) -> result<_, string>;
  open-window: func(kind: string, params-json: string) -> result<u64, string>;
  invoke-command: func(target: string, invocation-json: string) -> result<string, string>;
  read-asset: func(handle: u64) -> result<list<u8>, string>;
  network-fetch: func(origin: string, path: string) -> result<list<u8>, string>;
  backbone-read: func(uri: string) -> result<string, string>;
  backbone-write: func(uri: string, payload: string) -> result<_, string>;
}

world plugin-world {
  import host;
  export plugin;
}
