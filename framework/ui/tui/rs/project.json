{
  "name": "@semio-tech/ui-tui-rs",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/ui/tui/rs",
        "command": "bun ./script.ts test"
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/ui/tui/rs",
        "command": "bun ./script.ts test quick"
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/ui/tui/rs",
        "command": "bun ./script.ts test long"
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/ui/tui/rs",
        "command": "bun ./script.ts test exhaustive"
      }
    },
    "check-wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/ui/tui/rs",
        "command": "bun ./script.ts check-wasm"
      }
    }
  }
}
