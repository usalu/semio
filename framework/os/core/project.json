{
  "name": "@semio-tech/framework-os-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/os/core",
        "command": "bun ./script.ts wasm"
      },
      "outputs": ["{projectRoot}/rs/pkg"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/os/core",
        "command": "bun ./script.ts test"
      },
      "dependsOn": ["wasm"]
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/os/core",
        "command": "bun ./script.ts test quick"
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/os/core",
        "command": "bun ./script.ts test long"
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/os/core",
        "command": "bun ./script.ts test exhaustive"
      }
    }
  }
}
