{
  "name": "os-hub",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/product/os/hub",
        "command": "bun ./script.ts setup"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/product/os/hub",
        "command": "bun ./script.ts build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/product/os/hub",
        "command": "bun ./script.ts test"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/product/os/hub",
        "command": "bun ./script.ts dev"
      }
    }
  }
}
