{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react", "react-dom", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@ui/react": ["../../../../ui/react/i18n-types.ts"],
      "@ui/react/i18n-types": ["../../../../ui/react/i18n-types.ts"],
      "@ui/react/*": ["../../../../ui/react/*"],
      "@framework/platform/renderer/react": ["./index.tsx"],
      "@puzzle/2d/react": ["../../../../puzzle/2d/react/index.tsx"],
      "@puzzle/3d/react": ["../../../../puzzle/3d/react/index.tsx"],
      "@puzzle/5d/react": ["../../../../puzzle/5d/react/index.tsx"]
    }
  },
  "include": ["i18n-typecheck.ts"]
}
