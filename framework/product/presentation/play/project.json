{
	"name": "@semio-tech/framework-presentation-play",
	"$schema": "../../../../node_modules/nx/schemas/project-schema.json",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "framework/product/presentation/play",
				"command": "bun ./script.ts dev",
				"env": {
					"PRESENTATION_PLAY_PORT": "6051",
					"NODE_OPTIONS": "",
					"NX_NATIVE_COMMAND_RUNNER": "false",
					"NX_TASKS_RUNNER_DYNAMIC_OUTPUT": "false",
					"NX_TUI": "false",
					"VSCODE_INSPECTOR_OPTIONS": ""
				},
				"forwardAllArgs": true
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"dependsOn": [],
			"options": {
				"cwd": "framework/product/presentation/play",
				"command": "bun ./script.ts build",
				"forwardAllArgs": true
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"dependsOn": [],
			"options": {
				"cwd": "framework/product/presentation/play",
				"command": "bun ./script.ts test",
				"env": {
					"PRESENTATION_PLAY_PORT": "6052"
				},
				"forwardAllArgs": true
			}
		}
	}
}
