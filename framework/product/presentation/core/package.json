{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "@semio-tech/framework-presentation-core",
  "version": "0.1.0",
  "description": "framework · presentation declarative core (render-independent)",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./js/index.ts"
  },
  "dependencies": {
    "@semio-tech/vcs-core": "workspace:*",
    "@semio-tech/framework-os-core": "workspace:*",
    "@semio-tech/framework-platform-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "framework/product/presentation/core"
  },
  "bundleKind": "library",
  "semio": {
    "app": {
      "kind": "presentation",
      "aliases": [
        "presentation"
      ],
      "packageRoot": "framework/product/presentation",
      "corePackage": "@semio-tech/framework-presentation-core",
      "definitionExport": "presentationPlayAppDefinition",
      "hostKind": "presentation",
      "port": {
        "dev": 6051,
        "test": 6052,
        "env": "PRESENTATION_PLAY_PORT"
      },
      "programExport": "presentationProgramContribution",
      "programId": "presentation",
      "programIds": [
        "presentation.deck"
      ],
      "rendererPackage": "@semio-tech/framework-presentation-renderer-react",
      "rendererExport": "presentationAppRenderer"
    }
  }
}
