{
  "name": "@semio-tech/framework-schema",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/module/schema",
        "command": "bun ./script.ts generate",
        "forwardAllArgs": true
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/module/schema",
        "command": "bun ./script.ts check",
        "forwardAllArgs": true
      }
    }
  },
  "tags": [
    "scope:framework"
  ]
}
