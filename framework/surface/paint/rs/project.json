{
  "name": "@semio-tech/framework-surface-paint-rs",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/surface/paint/rs",
        "command": "bun ./script.ts wasm"
      },
      "outputs": ["{projectRoot}/pkg"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "framework/surface/paint/rs",
        "command": "bun ./script.ts test"
      }
    }
  }
}
