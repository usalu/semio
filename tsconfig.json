{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "incremental": false,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", "js/compose/.storybook/**/*.ts", "js/compose/.storybook/**/*.tsx"],
  "exclude": ["**/node_modules/**", "js/temp", "temp", "reports", "log"]
}
