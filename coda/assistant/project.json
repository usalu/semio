{
  "name": "@coda/assistant",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "coda/assistant",
        "command": "uv run main.py",
        "forwardAllArgs": true
      }
    },
    "build-mcp-app": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "coda/assistant",
        "command": "bunx vite build --config vite.mcp-app.config.ts",
        "forwardAllArgs": true
      }
    }
  }
}
