{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@ui/react": ["../../../ui/react/i18n-types.ts"],
      "@ui/react/i18n-types": ["../../../ui/react/i18n-types.ts"],
      "@ui/react/*": ["../../../ui/react/*"]
    }
  },
  "include": ["i18n-typecheck.ts"]
}
