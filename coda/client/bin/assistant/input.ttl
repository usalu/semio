:EscapeRoute rdf:type owl:Class .


###  http://test#ExternalStaircase
:ExternalStaircase rdf:type owl:Class .


###  http://test#MustBeLocatedInSeparateStairwell
:MustBeLocatedInSeparateStairwell rdf:type owl:Class ;
                                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                                        owl:onProperty :in ;
                                                        owl:someValuesFrom :SeparateStairwell
                                                      ] .


###  http://test#NecessaryStaircase
:NecessaryStaircase rdf:type owl:Class .


###  http://test#NecessaryStaircaseInSeparateStairwell
:NecessaryStaircaseInSeparateStairwell rdf:type owl:Class ;
                                       owl:equivalentClass [ rdf:type owl:Class ;
                                                             owl:intersectionOf ( [ rdf:type owl:Class ;
                                                                                    owl:complementOf :ExternalStaircase
                                                                                  ]
                                                                                  [ rdf:type owl:Class ;
                                                                                    owl:complementOf [ rdf:type owl:Restriction ;
                                                                                                       owl:onProperty :in ;
                                                                                                       owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                            owl:unionOf ( :BuildingClass1
                                                                                                                                          :BuildingClass2
                                                                                                                                        )
                                                                                                                          ]
                                                                                                     ]
                                                                                  ]
                                                                                  [ rdf:type owl:Class ;
                                                                                    owl:complementOf [ rdf:type owl:Restriction ;
                                                                                                       owl:onProperty :connects ;
                                                                                                       owl:onClass [ rdf:type owl:Class ;
                                                                                                                     owl:intersectionOf ( :Storey
                                                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                                                            owl:onProperty :isConnectedTo ;
                                                                                                                                            owl:someValuesFrom :EscapeRoute
                                                                                                                                          ]
                                                                                                                                          [ rdf:type owl:Restriction ;
                                                                                                                                            owl:onProperty :in ;
                                                                                                                                            owl:onClass [ rdf:type owl:Class ;
                                                                                                                                                          owl:intersectionOf ( :UsageUnit
                                                                                                                                                                               [ rdf:type owl:Restriction ;
                                                                                                                                                                                 owl:onProperty :totalGrossFloorArea ;
                                                                                                                                                                                 owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                                                                      owl:onDatatype xsd:float ;
                                                                                                                                                                                                      owl:withRestrictions ( [ xsd:maxInclusive 200.0 ]
                                                                                                                                                                                                                           )
                                                                                                                                                                                                    ]
                                                                                                                                                                               ]
                                                                                                                                                                             )
                                                                                                                                                        ] ;
                                                                                                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
                                                                                                                                          ]
                                                                                                                                        )
                                                                                                                   ] ;
                                                                                                       owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger
                                                                                                     ]
                                                                                  ]
                                                                                )
                                                           ] ;
                                       rdfs:subClassOf :MustBeLocatedInSeparateStairwell ,
                                                       :NecessaryStaircase .


