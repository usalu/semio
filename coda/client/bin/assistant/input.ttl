:Storey rdf:type owl:Class .


###  http://test#UsageUnit
:UsageUnit rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  Generated Individuals based on test-case-staircase-cleaned.json

### Usage Units (representing the two blocks)
:usage_unit_0 rdf:type owl:NamedIndividual ,
                       :UsageUnit ;
              :totalGrossFloorArea "306.6"^^xsd:float . # 4*Tambour(24.21) + 24*Capsule(8.74)

:usage_unit_1 rdf:type owl:NamedIndividual ,
                       :UsageUnit ;
              :totalGrossFloorArea "306.6"^^xsd:float . # 4*Tambour(24.21) + 24*Capsule(8.74)

### Storeys (representing floors within each block)
# Block 0 Storeys
:storey_0_0 rdf:type owl:NamedIndividual ,
                     :Storey ;
            :in :usage_unit_0 .

:storey_0_1 rdf:type owl:NamedIndividual ,
                     :Storey ;
            :in :usage_unit_0 .

:storey_0_2 rdf:type owl:NamedIndividual ,
                     :Storey ;
            :in :usage_unit_0 .

:storey_0_3 rdf:type owl:NamedIndividual ,
                     :Storey ;
            :in :usage_unit_0 .

# Block 1 Storeys
:storey_1_0 rdf:type owl:NamedIndividual ,
                     :Storey ;
            :in :usage_unit_1 .

:storey_1_1 rdf:type owl:NamedIndividual ,
                     :Storey ;
            :in :usage_unit_1 .

:storey_1_2 rdf:type owl:NamedIndividual ,
                     :Storey ;
            :in :usage_unit_1 .

:storey_1_3 rdf:type owl:NamedIndividual ,
                     :Storey ;
            :in :usage_unit_1 .

### Necessary Staircases (representing the internal Tambour cores)
:necessary_staircase_0 rdf:type owl:NamedIndividual ,
                               :NecessaryStaircase ; # Represents t-0-* stack
                      :connects :storey_0_0 ,
                                :storey_0_1 ,
                                :storey_0_2 ,
                                :storey_0_3 .

:necessary_staircase_1 rdf:type owl:NamedIndividual ,
                               :NecessaryStaircase ; # Represents t-1-* stack
                      :connects :storey_1_0 ,
                                :storey_1_1 ,
                                :storey_1_2 ,
                                :storey_1_3 .

### Separate Stairwell (representing the physical external stair structure b-*)
:separate_stairwell_1 rdf:type owl:NamedIndividual ,
                              :SeparateStairwell . # Represents b-* structure

### External Staircase (representing the circulation function within the external stairwell)
:external_staircase_1 rdf:type owl:NamedIndividual ,
                              :ExternalStaircase ; # Represents circulation via b-*
                     :in :separate_stairwell_1 ;
                     # Connections based on JSON: t-x-y <-> b-i links
                     :connects :storey_0_0 , # via t-0-0 <-> b-0 connection
                               :storey_1_0 , # via b-1 <-> t-1-0 connection
                               :storey_0_1 , # via t-0-1 <-> b-2 connection
                               :storey_1_1 , # via b-3 <-> t-1-1 connection
                               :storey_0_2 , # via t-0-2 <-> b-4 connection
                               :storey_1_2 , # via b-5 <-> t-1-2 connection
                               :storey_0_3 , # via t-0-3 <-> b-6 connection
                               :storey_1_3 . # via b-7 <-> t-1-3 connection

# Note: Capsule individuals (c-x-y-z) are not explicitly created as there's no corresponding class.
# Their contribution is captured in the UsageUnit's totalGrossFloorArea and their implicit location on a Storey.
# BuildingClass1/2 are not assigned as the JSON doesn't provide this classification.
# EscapeRoute is not explicitly instantiated from the JSON data provided.

