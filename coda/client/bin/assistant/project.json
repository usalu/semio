{
  "name": "@coda/assistant",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun ./script.ts dev",
        "cwd": "coda/client/bin/assistant",
        "forwardAllArgs": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun ./script.ts build",
        "cwd": "coda/client/bin/assistant",
        "forwardAllArgs": true
      }
    }
  }
}
