{
  "name": "semio",
  "version": "1.0.0",
  "type": "module",
  "description": "🧩 Design-Information-Modeling for Kit-of-Parts 🏘️",
  "workspaces": [
    "semio-elements/ui",
    "semio/assets/logo",
    "semio/assets/icons",
    "semio/assets",
    "semio/py",
    "semio/engine",
    "semio/js",
    "semio/docs",
    "semio/play",
    "semio/desktop",
    "semio-repo/vscode",
    "semio/net/Semio",
    "semio/grasshopper/Semio.Grasshopper",
    "semio/go",
    "semio-repo/cli",
    "semio-repo/server",
    "semio/rs",
    "semio/grasshopper/Semio.Grasshopper/yak",
    "semio/sqlite",
    "semio-repo/sqlite",
    "semio-coda/py",
    "semio-coda/desktop",
    "semio-coda/desktop",
    "semio/sketchpad",
    "semio/3dm/Semio.Rhino",
    "semio/3dm/ui"
  ],
  "engines": {
    "node": ">=22.13.1"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "dev": "npx nx run-many -t dev",
    "dev:3dm:ui": "npx nx dev @semio/3dm-ui",
    "dev:coda-desktop": "cd semio-coda/desktop && npm run dev",
    "dev:js:js:storybook": "npx nx dev semio-elements/ui",
    "dev:js:js:sketchpad": "npx nx dev:sketchpad semio/js",
    "analyze": "semio-repo/cli/cli analyze",
    "fix": "semio-repo/cli/cli fix",
    "test": "npx nx run-many -t test",
    "test:repo": "npx nx test semio-repo/cli",
    "build": "npx nx run-many -t build",
    "update": "semio-repo/cli/cli update",
    "publish:test": "npx nx run-many -t publish:test",
    "publish": "npx nx run-many -t publish",
    "benchmark": "semio-repo/cli/cli benchmark",
    "pre-commit": "uv run --group dev pre-commit run --all-files",
    "pre-commit:install": "uv run --group dev pre-commit install --install-hooks",
    "configure": "semio-repo/cli/cli configure",
    "mcp:inspector": "HOST=0.0.0.0 npx @modelcontextprotocol/inspector --config .cursor/mcp.json --server semio-repo"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^21.6.10",
    "@nxlv/python": "^21.2.3",
    "@types/node": "^22.19.6",
    "@types/react": "^19.2.8",
    "lint-staged": "^16.2.7",
    "nx": "^21.4.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "kit-of-parts",
    "port-based thinking",
    "shape grammar",
    "graph-based design",
    "graph transformations",
    "graph rewriting",
    "design prototypes",
    "design systems",
    "computer-based design synthesis",
    "computer-generated architecture",
    "generative design",
    "procedural modeling",
    "parametric design",
    "computer aided architectural design",
    "building information modeling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/usalu/semio/issues"
  },
  "homepage": "https://docs.semio-tech.com",
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "dependencies": {
    "esbuild": "^0.27.2"
  },
  "overrides": {
    "diff": "^8.0.3",
    "tmp": "^0.2.5"
  }
}
