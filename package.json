{
  "name": "semio",
  "version": "1.0.0",
  "type": "module",
  "description": "🧩 Design-Information-Modeling for Kit-of-Parts 🏘️",
  "workspaces": [
    "elements/ui",
    "coda/client/ui/*",
    "coda/client/lib/*/*",
    "repo/client",
    "repo/client/*",
    "repo/client/mcp/*",
    "repo/lib/*",
    "repo/server/*",
    "semio/assets",
    "semio/assets/*",
    "semio/client/bin/*",
    "semio/client/lib/*",
    "semio/client/lib/net/*",
    "semio/client/ui/*",
    "semio/client/ui/3dm/*",
    "semio/client/ui/gh/*",
    "semio/dev/*",
    "semio/schema/*",
    "semio/server/*",
    "semio/site/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.5",
  "scripts": {
    "postinstall": "bun ./setup.script.ts --postinstall",
    "setup": "bun ./setup.script.ts",
    "start": "bun ./start.script.ts",
    "git:setup": "bun ./git.script.ts setup",
    "generate": "bun ./generate.script.ts",
    "dev": "bun nx run @semio/desktop:dev",
    "dev:mcp": "bun ./dev-mcp.script.ts",
    "dev:mcp:engine": "bun ./dev-mcp.script.ts engine",
    "dev:mcp:repo": "bun ./dev-mcp.script.ts repo",
    "dev:elements:ui:storybook": "bun nx run @elements/ui:dev",
    "dev:algorithms": "bun nx run @semio/algorithms:dev",
    "dev:sites:play": "bun nx run @semio/play:dev",
    "dev:ui": "bun nx run @semio/ui:dev",
    "dev:coda:desktop": "bun nx run @coda/desktop:dev",
    "lint": "bun ./lint.script.ts",
    "lint:repo": "bun ./lint.script.ts repo",
    "build": "bun ./build.script.ts",
    "build:3dm": "bun nx run @semio/3dm-ui:build",
    "build:assets": "bun nx run @semio/assets:build",
    "build:desktop": "bun nx run @semio/desktop:build",
    "build:engine": "bun nx run @semio/engine:build",
    "build:sites": "bun nx run-many -t build -p @semio/play @semio/docs",
    "build:coda:desktop": "bun nx run @coda/desktop:build",
    "build:repo:cli": "bun nx run @repo/client:build",
    "build:repo:server": "bun nx run @repo/coordinator:build",
    "build:repo:vscode": "bun nx run repo:build-vsix",
    "test": "bun ./test.script.ts",
    "publish:desktop": "bun nx run @semio/desktop:publish",
    "publish:play": "bun nx run @semio/play:publish",
    "publish:sketchpad": "bun nx run @semio/sketchpad:publish",
    "publish:docs": "bun nx run @semio/docs:publish",
    "publish:coda:desktop": "bun nx run @coda/desktop:publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "^1.3.2",
    "@nx/js": "21.4.1",
    "@nxlv/python": "^21.2.3",
    "@types/node": "^22.19.6",
    "@types/react": "^19.2.8",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "lint-staged": "^16.2.7",
    "nx": "^21.4.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "kit-of-parts",
    "port-based thinking",
    "shape grammar",
    "graph-based design",
    "graph transformations",
    "graph rewriting",
    "design prototypes",
    "design systems",
    "computer-based design synthesis",
    "computer-generated architecture",
    "generative design",
    "procedural modeling",
    "parametric design",
    "computer aided architectural design",
    "building information modeling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/usalu/semio/issues"
  },
  "homepage": "https://docs.semio-tech.com",
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "dependencies": {
    "esbuild": "^0.27.2"
  },
  "overrides": {
    "@semio/assets": "workspace:*",
    "@semio/js": "workspace:*",
    "diff": "^8.0.3",
    "tmp": "^0.2.5"
  }
}
