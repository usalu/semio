{
  "name": "semio",
  "version": "1.0.0",
  "type": "module",
  "description": "🧩 Design-Information-Modeling for Kit-of-Parts 🏘️",
  "workspaces": [
    "@semio/assets/logo",
    "@semio/assets/icons",
    "@semio/assets",
    "@semio/py",
    "@semio/engine",
    "@semio/js",
    "@semio/docs",
    "@semio/play",
    "@semio/desktop",
    "@semio-repo/vscode",
    "@semio/net/Semio",
    "@semio/grasshopper/Semio.Grasshopper",
    "@semio/go",
    "@semio-repo/go",
    "@semio-repo/server",
    "@semio/rs",
    "@semio/grasshopper/Semio.Grasshopper/yak",
    "@semio/sqlite",
    "@semio-repo/sqlite",
    "@coda/py",
    "@semio/sketchpad"
  ],
  "engines": {
    "node": ">=22.13.1"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "dev": "npx nx run-many -t dev",
    "dev:js:js:storybook": "npx nx dev:storybook @semio/js",
    "dev:js:js:sketchpad": "npx nx dev:sketchpad @semio/js",
    "analyze": "@semio-repo/go/repo analyze",
    "fix": "@semio-repo/go/repo fix",
    "preflight": "@semio-repo/go/repo preflight",
    "test": "@semio-repo/go/repo preflight test",
    "test:repo": "npx nx test @semio-repo/go",
    "build": "@semio-repo/go/repo preflight build",
    "update": "@semio-repo/go/repo update",
    "publish:test": "@semio-repo/go/repo preflight publish:test",
    "publish": "@semio-repo/go/repo preflight publish",
    "benchmark": "@semio-repo/go/repo benchmark",
    "prepare": "husky",
    "mcp:inspector": "npx @modelcontextprotocol/inspector"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^21.6.10",
    "@nxlv/python": "^21.2.3",
    "@types/node": "^22.19.6",
    "@types/react": "^19.2.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nx": "^21.4.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "kit-of-parts",
    "port-based thinking",
    "shape grammar",
    "graph-based design",
    "graph transformations",
    "graph rewriting",
    "design prototypes",
    "design systems",
    "computer-based design synthesis",
    "computer-generated architecture",
    "generative design",
    "procedural modeling",
    "parametric design",
    "computer aided architectural design",
    "building information modeling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/usalu/semio/issues"
  },
  "homepage": "https://docs.semio-tech.com",
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
