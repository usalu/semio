    "coda/client/ui/*",
    "coda/client/lib/*/*",
    "repo/client",
    "repo/client/*",
    "repo/client/mcp/*",
    "repo/lib/*",
    "repo/server/*",
    "semio/assets",
    "semio/assets/*",
    "semio/client/bin/*",
    "semio/client/lib/*",
    "semio/client/lib/net/*",
    "semio/client/ui/*",
    "semio/client/ui/3dm/*",
    "semio/client/ui/gh/*",
    "semio/dev/*",
    "semio/schema/*",
    "semio/server/*",
    "semio/site/*"
