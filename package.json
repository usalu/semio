{
  "name": "semio",
  "version": "1.0.0",
  "description": "🧩 Design-Information-Modeling for Kit-of-Parts 🏘️",
  "workspaces": [
    "assets/logo",
    "assets/icons",
    "assets",
    "py/engine",
    "js/js",
    "js/docs",
    "js/play",
    "js/desktop",
    "js/vscode",
    "net/Semio",
    "net/Semio.Grasshopper",
    "yak"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npx nx run-many -t dev",
    "dev:storybook": "npx nx dev-storybook @semio/js",
    "dev:sketchpad": "npx nx dev-sketchpad @semio/js",
    "dev:js:js:storybook": "npm run dev:storybook",
    "dev:js:js:sketchpad": "npm run dev:sketchpad",
    "build": "npx nx run-many -t build",
    "test": "npx nx run-many -t test",
    "preflight": "npx nx run-many -t preflight",
    "update": "npx nx run-many -t update",
    "prepublish": "npx nx run-many -t prepublish",
    "publish": "npx nx run-many -t publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^21.6.8",
    "@nxlv/python": "^21.2.0",
    "@types/node": "^22.10.5",
    "csv-parse": "^5.6.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nx": "^21.4.1",
    "sharp": "^0.33.5",
    "tsx": "^4.20.6"
  },
  "keywords": [
    "kit-of-parts",
    "port-based thinking",
    "shape grammar",
    "graph-based design",
    "graph transformations",
    "graph rewriting",
    "design prototypes",
    "design systems",
    "computer-based design synthesis",
    "computer-generated architecture",
    "generative design",
    "procedural modeling",
    "parametric design",
    "computer aided architectural design",
    "building information modeling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/usalu/semio/issues"
  },
  "homepage": "https://docs.semio-tech.com",
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "dependencies": {
    "esbuild": "^0.27.0"
  }
}
