  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.5",
  "scripts": {
    "setup": "bun nx run workspace:setup",
    "postinstall": "bun scripts/postinstall-lightningcss.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "^1.3.2",
    "@nx/js": "21.4.1",
    "@nxlv/python": "^21.2.3",
    "@types/node": "^22.19.6",
    "@types/react": "^19.2.8",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "lint-staged": "^16.2.7",
    "nx": "^21.4.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "kit-of-parts",
    "port-based thinking",
    "shape grammar",
    "graph-based design",
    "graph transformations",
    "graph rewriting",
    "design prototypes",
    "design systems",
    "computer-based design synthesis",
    "computer-generated architecture",
    "generative design",
    "procedural modeling",
    "parametric design",
    "computer aided architectural design",
    "building information modeling"
