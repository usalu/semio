    "test:raster": "bun nx run @semio-tech/raster-core:test && bun nx run @semio-tech/raster-react:test && bun nx run @semio-tech/raster-play:test",
    "test:draw": "bun nx run @semio-tech/draw-core:test && bun nx run @semio-tech/draw-react:test && bun nx run @semio-tech/draw-play:test",
