{
  "name": "semio",
  "version": "1.0.0",
  "type": "module",
  "description": "🧩 Design-Information-Modeling for Kit-of-Parts 🏘️",
  "workspaces": [
    "assets/logo",
    "assets/icons",
    "assets",
    "py/engine",
    "js/js",
    "js/docs",
    "js/play",
    "js/desktop",
    "js/vscode",
    "net/Semio",
    "net/Semio.Grasshopper",
    "yak"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npx nx run-many -t dev",
    "dev:js:js:storybook": "npx nx dev:storybook @semio/js",
    "dev:js:js:sketchpad": "npx nx dev:sketchpad @semio/js",
    "analyze": "npx tsx preflight.ts analyze",
    "fix": "npx tsx preflight.ts fix",
    "preflight": "npx tsx preflight.ts preflight",
    "test": "npx tsx preflight.ts test",
    "test:repo": "vitest run repo.tests.ts",
    "build": "npx tsx preflight.ts build",
    "update": "npx nx run-many -t update",
    "publish:test": "npx tsx preflight.ts publish:test",
    "publish": "npx tsx preflight.ts publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@esbuild-kit/esm-loader": "^2.6.5",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.4",
    "@nx/eslint-plugin": "^21.6.8",
    "@nxlv/python": "^21.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "csv-parse": "^5.6.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "ink": "^6.6.0",
    "lint-staged": "^16.2.7",
    "nx": "^21.4.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.33.5",
    "tree-sitter": "^0.22.4",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.1",
    "tree-sitter-typescript": "^0.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^3.0.8"
  },
  "keywords": [
    "kit-of-parts",
    "port-based thinking",
    "shape grammar",
    "graph-based design",
    "graph transformations",
    "graph rewriting",
    "design prototypes",
    "design systems",
    "computer-based design synthesis",
    "computer-generated architecture",
    "generative design",
    "procedural modeling",
    "parametric design",
    "computer aided architectural design",
    "building information modeling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/usalu/semio/issues"
  },
  "homepage": "https://docs.semio-tech.com",
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "dependencies": {
    "esbuild": "^0.27.0"
  }
}