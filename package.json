{
  "name": "semio",
  "version": "1.0.0",
  "type": "module",
  "description": "🧩 Design-Information-Modeling for Kit-of-Parts 🏘️",
  "workspaces": [
    "ui/react",
    "ui/styling/js",
    "framework/platform/core",
    "framework/platform/renderer/react",
    "framework/playground/core",
    "framework/playground/renderer/react",
    "puzzle/assets",
    "puzzle/2d/react",
    "puzzle/2d/play",
    "puzzle/3d/react",
    "puzzle/3d/play",
    "puzzle/5d/react",
    "puzzle/5d/play",
    "cad/js/core",
    "cad/js/kernel/brepjs",
    "cad/js/machine/stately",
    "cad/js/query",
    "cad/js/renderer",
    "coda/client/ui/*",
    "coda/client/lib/*/*",
    "repo/client/*",
    "repo/client/mcp/*",
    "repo/lib/*",
    "repo/server/*",
    "semio/assets",
    "semio/assets/*",
    "semio/fixtures",
    "semio/client/bin/*",
    "semio/client/lib/*",
    "semio/client/lib/net/*",
    "semio/client/lib/react/*",
    "semio/client/lib/sketchpad/*",
    "semio/client/schema/*",
    "semio/client/ui/*",
    "semio/client/ui/3dm/*",
    "semio/client/ui/gh/*",
    "semio/dev/*",
    "semio/server/*",
    "semio/site/*",
    "mit-bestand/präsentation/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.5",
  "scripts": {
    "postinstall": "bun ./script.ts setup postinstall",
    "nx": "bun ./script.ts nx",
    "setup": "bun ./script.ts setup",
    "start": "bun ./script.ts start",
    "dev": "bun ./script.ts dev",
    "dev:storybook": "bun nx run workspace:dev-storybook",
    "dev:storybook:ui": "bun nx run workspace:dev-storybook-ui",
    "dev:storybook:puzzle": "bun nx run workspace:dev-storybook-puzzle",
    "dev:storybook:puzzle:2d": "bun nx run workspace:dev-storybook-puzzle-2d",
    "dev:storybook:semio": "bun nx run workspace:dev-storybook-semio",
    "dev:storybook:semio:algorithms": "bun nx run workspace:dev-storybook-semio-algorithms",
    "dev:storybook:semio:ui": "bun nx run workspace:dev-storybook-semio-ui",
    "dev:puzzle:2d": "bun ./script.ts dev 2d",
    "dev:puzzle:3d": "bun ./script.ts dev 3d",
    "dev:puzzle:5d": "bun ./script.ts dev 5d",
    "dev:cad": "bun ./script.ts dev cad",
    "generate": "bun ./script.ts generate",
    "lint": "bun ./script.ts lint",
    "format": "bun ./script.ts format",
    "test": "bun ./script.ts test",
    "test:storybook": "bun ./script.ts test storybook",
    "build": "bun ./script.ts build",
    "build:storybook": "bun ./script.ts build storybook",
    "cpp": "bun nx run workspace:cpp --",
    "cpp:setup": "bun nx run workspace:cpp-setup",
    "cpp:configure": "bun nx run workspace:cpp-configure --",
    "cpp:build": "bun nx run workspace:cpp-build --",
    "cpp:test": "bun nx run workspace:cpp-test --",
    "publish": "bun ./script.ts publish",
    "purge": "bun ./script.ts purge",
    "query:build": "bun nx run @semio/query:build",
    "query:test": "bun nx run @semio/query:test",
    "query:wasm": "bun ./script.ts query wasm"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "^1.3.2",
    "@nx/devkit": "21.6.11",
    "@nx/js": "21.6.11",
    "@nxlv/python": "^21.2.3",
    "@types/node": "^22.19.6",
    "@types/react": "^19.2.8",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "lint-staged": "^16.2.7",
    "nx": "21.6.11",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "storybook": "^10.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.0.17",
    "eslint-plugin-storybook": "10.4.0",
    "chevrotain": "^11.0.3"
  },
  "keywords": [
    "kit-of-parts",
    "port-based thinking",
    "shape grammar",
    "graph-based design",
    "graph transformations",
    "graph rewriting",
    "design prototypes",
    "design systems",
    "computer-based design synthesis",
    "computer-generated architecture",
    "generative design",
    "procedural modeling",
    "parametric design",
    "computer aided architectural design",
    "building information modeling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/usalu/semio/issues"
  },
  "homepage": "https://docs.semio-tech.com",
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "dependencies": {
    "esbuild": "^0.27.2"
  },
  "overrides": {
    "@semio/assets": "workspace:*",
    "@semio/js": "workspace:*",
    "diff": "^8.0.3",
    "tmp": "^0.2.5"
  }
}
