{
  "name": "workspace",
  "version": "1.0.0",
  "type": "module",
  "description": "🧩️ Design-Information-Modeling for Kit-of-Parts 🏘️",
  "workspaces": [
    "🧰️framework/**",
    "!**/🧫️fixtures/**",
    "!**/node_modules/**",
    "!**/target/**",
    "!**/dist/**",
    "!**/build/**",
    "!**/storybook-static/**",
    "!**/temp/**",
    "!**/coverage/**",
    "!**/🔌️plugin-modules/**",
    "!**/compose/**",
    "!**/.*",
    "!**/🗑️generated/**",
    "!🧰️framework/🔨️modules/✍️editor/📦️packages/🦀️rust/pkg",
    "!🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust/pkg",
    "!🧰️framework/🔨️modules/🗺️surface/📦️packages/🦀️rust/🕸️bindings",
    "!🧰️framework/🛍️products/💻️os/🔨️modules/📺️renderer/🧑‍🎨engine/🧱️elements/🕸️NodeGraph/📦️packages/🦀️rust/🕸️bindings"
  ],
  "engines": {
    "bun": ">=1.2.0",
    "node": "24.15.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "nx": "bun ./🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🚀️bootstrap/📜️script.ts nx",
    "setup": "bun nx run workspace:setup",
    "dashboard": "bun nx run @semio-tech/repo-dashboard-rs:run --outputStyle=stream",
    "dashboard:install": "bun nx run @semio-tech/repo-dashboard-rs:build --excludeTaskDependencies --skip-nx-cache --outputStyle=stream"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iarna/toml": "2.2.5",
    "@nx/devkit": "23.2.0",
    "@nx/js": "23.2.0",
    "@nxlv/python": "23.0.2",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@types/bun": "^1.4.2",
    "@types/markdown-it": "^14.2.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.19.6",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.8",
    "@vitest/coverage-v8": "^4.0.17",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "binaryen": "^130.0.0",
    "chevrotain": "^11.0.3",
    "decimal.js": "10.6.0",
    "dependency-cruiser": "^16.10.0",
    "emoji-regex": "^10.6.0",
    "eslint": "^10.0.1",
    "eslint-plugin-storybook": "10.4.0",
    "fast-json-patch": "3.1.1",
    "graphology": "0.26.0",
    "graphql": "^17.0.2",
    "jsonschema": "1.5.0",
    "manifold-3d": "3.5.1",
    "markdown-it": "^15.0.2",
    "micromatch": "^4.0.8",
    "nx": "23.2.0",
    "picomatch": "^4.0.7",
    "playwright": "^1.57.0",
    "protobufjs": "^8.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "storybook": "^10.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "kit-of-parts",
    "port-based thinking",
    "shape grammar",
    "graph-based design",
    "graph transformations",
    "graph rewriting",
    "design prototypes",
    "design systems",
    "computer-based design synthesis",
    "computer-generated architecture",
    "generative design",
    "procedural modeling",
    "parametric design",
    "computer aided architectural design",
    "building information modeling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/usalu/semio/issues"
  },
  "homepage": "https://docs.semio-tech.com",
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "dependencies": {
    "esbuild": "^0.27.2"
  },
  "overrides": {
    "@semio-tech/assets": "workspace:*",
    "diff": "^8.0.3",
    "tmp": "^0.2.5"
  },
  "nx": {
    "includedScripts": []
  },
  "patchedDependencies": {
    "nx@23.2.0": "🧰️framework/🛍️products/🦑️repo/🔨️modules/📚️library/⚡️caching/🩹️patches/nx@23.2.0.patch"
  },
  "semio": {
    "workspace": {
      "schemaVersion": 1,
      "members": [
        "🧰️framework/**",
        "!**/🧫️fixtures/**",
        "!**/node_modules/**",
        "!**/target/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/storybook-static/**",
        "!**/temp/**",
        "!**/coverage/**",
        "!**/🔌️plugin-modules/**",
        "!**/compose/**",
        "!**/.*",
        "!**/🗑️generated/**"
      ],
      "owners": [
        "*/package.json"
      ]
    }
  }
}
