{
  "name": "semio",
  "version": "1.0.0",
  "type": "module",
  "description": "🧩 Design-Information-Modeling for Kit-of-Parts 🏘️",
  "workspaces": [
    "elements/ui",
    "semio/assets/logo",
    "semio/assets/icons",
    "semio/assets",
    "semio/py",
    "semio/engine",
    "semio/js",
    "semio/sites/docs",
    "semio/sites/play",
    "semio/desktop",
    "semio/algorithms",
    "repo/vscode",
    "semio/net/Semio",
    "semio/grasshopper/Semio.Grasshopper",
    "semio/go",
    "repo/cli",
    "repo/server",
    "semio/rs",
    "semio/grasshopper/Semio.Grasshopper/yak",
    "semio/sqlite",
    "repo/sqlite",
    "coda/engine",
    "coda/desktop",
    "coda/desktop",
    "semio/sketchpad",
    "semio/studio",
    "semio/vscode",
    "semio/3dm/Semio.Rhino",
    "semio/3dm/ui",
    "semio/ui"
  ],
  "engines": {
    "node": ">=22.13.1"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "mcp:inspector": "HOST=0.0.0.0 npx @mcpjam/inspector@latest uv --directory /workspaces/semio/semio/engine run main.py --mcp-stdio",
    "mcp:inspector:repo": "HOST=0.0.0.0 npx @modelcontextprotocol/inspector --config .cursor/mcp.json --server repo",
    "dev:elements:ui:storybook": "npx nx dev elements/ui",
    "dev:js:sketchpad": "npx nx dev:sketchpad semio/js",
    "dev:3dm:ui": "npx nx dev @semio/3dm-ui",
    "dev:sites:play": "npx nx dev semio/sites/play",
    "dev:sites:docs": "npx nx dev semio/sites/docs",
    "dev:desktop": "npx nx dev semio/desktop",
    "dev:ui": "npx nx dev @semio/ui",
    "dev:algorithms": "npx nx dev @semio/algorithms",
    "dev:sketchpad": "npx nx dev semio/sketchpad",
    "dev:coda-desktop": "npx nx dev @coda/desktop",
    "build:engine": "npx nx build semio/engine",
    "build:sites": "npx nx build semio/sites",
    "build:desktop": "npx nx build semio/desktop",
    "build:3dm": "npx nx build @semio/3dm",
    "build:assets": "npx nx build semio/assets",
    "build:repo-cli": "npx nx build repo/cli",
    "build:repo-server": "npx nx build repo/server",
    "build:repo-vscode": "npx nx build repo/vscode",
    "build:coda-desktop": "npx nx build @coda/desktop",
    "publish:docs": "npx nx publish semio/sites/docs",
    "publish:play": "npx nx publish semio/sites/play",
    "publish:sketchpad": "npx nx publish semio/sketchpad",
    "publish:desktop": "npx nx publish semio/desktop",
    "publish:coda-desktop": "npx nx publish @coda/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nxlv/python": "^21.2.3",
    "@types/node": "^22.19.6",
    "@types/react": "^19.2.8",
    "eslint": "^10.0.1",
    "globals": "^16.4.0",
    "jiti": "^2.4.2",
    "lint-staged": "^16.2.7",
    "nx": "^21.4.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "kit-of-parts",
    "port-based thinking",
    "shape grammar",
    "graph-based design",
    "graph transformations",
    "graph rewriting",
    "design prototypes",
    "design systems",
    "computer-based design synthesis",
    "computer-generated architecture",
    "generative design",
    "procedural modeling",
    "parametric design",
    "computer aided architectural design",
    "building information modeling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git"
  },
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/usalu/semio/issues"
  },
  "homepage": "https://docs.semio-tech.com",
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "dependencies": {
    "esbuild": "^0.27.2"
  },
  "overrides": {
    "diff": "^8.0.3",
    "tmp": "^0.2.5"
  }
}