{
  "schema": "raster.document/v1",
  "id": "default",
  "title": "Default Composite",
  "camera": { "x": 0, "y": 0, "zoom": 1 },
  "activeTool": "selectMarquee",
  "brushSize": 24,
  "layers": [
    {
      "kind": "pixel",
      "id": "bg",
      "name": "Background",
      "visible": true,
      "opacity": 1,
      "blendMode": "normal",
      "width": 512,
      "height": 512,
      "transform": { "x": 0, "y": 0, "scaleX": 1, "scaleY": 1, "rotation": 0 },
      "mask": { "enabled": true, "linked": true, "invert": false, "width": 512, "height": 512 }
    },
    {
      "kind": "pixel",
      "id": "accent",
      "name": "Accent",
      "visible": true,
      "opacity": 0.85,
      "blendMode": "multiply",
      "width": 256,
      "height": 256,
      "transform": { "x": 80, "y": -40, "scaleX": 1, "scaleY": 1, "rotation": 0.2 }
    },
    {
      "kind": "adjustment",
      "id": "brighten",
      "name": "Brighten",
      "visible": true,
      "opacity": 1,
      "blendMode": "normal",
      "adjustmentKind": "brightnessContrast",
      "params": { "brightness": 0.08, "contrast": 0.12 },
      "transform": { "x": 0, "y": 0, "scaleX": 1, "scaleY": 1, "rotation": 0 }
    }
  ]
}
