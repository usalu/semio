{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kinds",
    "unknown",
    "missing",
    "getterHeap",
    "sameReceipt",
    "sameParam",
    "parentTimeTravel"
  ],
  "properties": {
    "kinds": {
      "const": [
        "invalidValue",
        "canceled",
        "ownershipLimit",
        "allocationFailed",
        "workLimit",
        "depthLimit",
        "unsupportedOwner",
        "invariantViolated"
      ]
    },
    "unknown": {
      "const": [
        "",
        "inventedKind"
      ]
    },
    "missing": {
      "const": null
    },
    "getterHeap": {
      "const": [
        0,
        0
      ]
    },
    "sameReceipt": {
      "const": true
    },
    "sameParam": {
      "const": true
    },
    "parentTimeTravel": {
      "const": "same-original-kind-and-receipt"
    }
  }
}
