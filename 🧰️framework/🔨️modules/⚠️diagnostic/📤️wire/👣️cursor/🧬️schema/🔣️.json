{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "originalGrant",
    "cuts",
    "metadataCopyBytes",
    "heapBytesPerTurn",
    "cpu"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "originalGrant": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 5,
      "maxItems": 5
    },
    "cuts": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "const": "complete"
          }
        ]
      },
      "minItems": 4
    },
    "metadataCopyBytes": {
      "const": 0
    },
    "heapBytesPerTurn": {
      "const": 0
    },
    "cpu": {
      "const": {
        "denied": 0,
        "readonlyRefusal": 0,
        "admitted": 1,
        "targetExhaustion": 1,
        "cached": 0
      }
    }
  }
}
