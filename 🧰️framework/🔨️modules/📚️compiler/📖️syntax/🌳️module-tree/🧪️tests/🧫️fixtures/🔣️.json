{
  "schemaVersion": 1,
  "mounts": [
    {
      "id": "plain-path-mount",
      "source": "#[path = \"alpha/🦀️.rs\"]\nmod alpha;\n",
      "expected": [
        {
          "path": "alpha/🦀️.rs",
          "modules": []
        }
      ]
    },
    {
      "id": "attributes-and-visibility-in-any-order",
      "source": "#[cfg(test)]\n#[path = \"a/🦀️.rs\"]\npub(crate) mod a;\n#[path = \"b/🦀️.rs\"]\n#[cfg(not(test))]\npub mod b;\n#[doc = \"x\"] #[path = \"c/🦀️.rs\"] #[allow(dead_code)] pub(super) mod c;\n",
      "expected": [
        {
          "path": "a/🦀️.rs",
          "modules": []
        },
        {
          "path": "b/🦀️.rs",
          "modules": []
        },
        {
          "path": "c/🦀️.rs",
          "modules": []
        }
      ]
    },
    {
      "id": "inline-module-nesting-is-kept",
      "source": "mod outer {\n    #[path = \"gamma/🦀️.rs\"]\n    pub(crate) mod gamma;\n    mod inner {\n        #[path = \"delta.rs\"]\n        mod delta;\n    }\n}\n#[path = \"renamed\"]\nmod relocated {\n    #[path = \"epsilon.rs\"]\n    mod epsilon;\n}\n",
      "expected": [
        {
          "path": "gamma/🦀️.rs",
          "modules": [
            "outer"
          ]
        },
        {
          "path": "delta.rs",
          "modules": [
            "outer",
            "inner"
          ]
        },
        {
          "path": "epsilon.rs",
          "modules": [
            "renamed"
          ]
        }
      ]
    },
    {
      "id": "decoys-are-not-mounts",
      "source": "// #[path = \"comment.rs\"] mod comment;\n/* #[path = \"block.rs\"] mod block; */\nconst TEXT: &str = \"#[path = \\\"string.rs\\\"] mod string;\";\nmod without_path;\nmacro_rules! m { () => { #[path = \"macro.rs\"] mod from_macro; }; }\nfn body() {\n    #[path = \"function.rs\"]\n    mod in_function {}\n}\nstruct Holder {\n    field: u8,\n}\n#[path = \"real.rs\"]\nmod real;\n",
      "expected": [
        {
          "path": "real.rs",
          "modules": []
        }
      ]
    },
    {
      "id": "items-between-mounts-are-skipped-whole",
      "source": "use std::fmt;\nconst TABLE: [u8; 3] = [1, 2, 3];\nstatic NAMES: &[&str] = &[\"a\", \"b\"];\nimpl Holder {\n    fn f(&self) -> u8 { 1 }\n}\n#[path = \"first.rs\"]\nmod first;\nstruct Holder { a: u8 }\n#[derive(Debug)]\nenum Kind { A, B }\n#[path = \"second.rs\"]\npub mod second;\n",
      "expected": [
        {
          "path": "first.rs",
          "modules": []
        },
        {
          "path": "second.rs",
          "modules": []
        }
      ]
    }
  ],
  "trees": [
    {
      "id": "rust-nested-children-in-declaration-order",
      "kind": "rust",
      "root": "owner/🦀️.rs",
      "files": {
        "owner/🦀️.rs": "#[path = \"alpha/🦀️.rs\"]\nmod alpha;\npub(crate) use alpha::*;\n#[cfg(any(test, not(test)))]\n#[path = \"🌱️seed/🦀️.rs\"]\npub mod beta;\nmod outer {\n    #[path = \"gamma/🦀️.rs\"]\n    pub(crate) mod gamma;\n}\n#[cfg(test)]\n#[path = \"🧪️tests/🔬️unit/🦀️.rs\"]\nmod unit;\n",
        "owner/alpha/🦀️.rs": "#[path = \"deep/🦀️.rs\"]\nmod deep;\npub fn alpha() {}\n",
        "owner/alpha/deep/🦀️.rs": "pub fn deep() {}",
        "owner/🌱️seed/🦀️.rs": "pub fn seed() {}\n",
        "owner/outer/gamma/🦀️.rs": "pub fn gamma() {}\n",
        "owner/🧪️tests/🔬️unit/🦀️.rs": "pub fn unit() {}\n"
      },
      "production": [
        "owner/🦀️.rs",
        "owner/alpha/🦀️.rs",
        "owner/alpha/deep/🦀️.rs",
        "owner/🌱️seed/🦀️.rs",
        "owner/outer/gamma/🦀️.rs"
      ],
      "withTests": [
