        "owner/alpha/🦀️.rs",
        "owner/alpha/deep/🦀️.rs",
        "owner/🌱️seed/🦀️.rs",
        "owner/outer/gamma/🦀️.rs",
        "owner/🧪️tests/🔬️unit/🦀️.rs"
      ],
      "oracle": "rustc",
      "slices": [
        {
          "id": "within-one-file",
