          "to": "pub fn nothing",
          "expected": "pub fn seed() {}\n"
        },
        {
          "id": "no-end-marker",
          "from": "pub fn gamma",
          "expected": "pub fn gamma() {}\n"
        },
        {
          "id": "first-file-holding-the-start",
