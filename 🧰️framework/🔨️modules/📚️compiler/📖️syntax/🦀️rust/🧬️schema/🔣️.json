{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/compiler/syntax/rust/corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases",
    "unsupported",
    "oracle"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "https://json.schemas.assets.semio-tech.com/framework/compiler/syntax/rust#/$defs/reference"
            }
          }
        }
      }
    },
    "unsupported": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "oracle": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "references"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "https://json.schemas.assets.semio-tech.com/framework/compiler/syntax/rust#/$defs/reference"
            }
          }
        }
      }
    }
  }
}
