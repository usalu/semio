{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/pixels/affine-sampling",
  "title": "Affine Image Sampling Input",
  "type": "object",
  "required": [
    "source",
    "width",
    "height",
    "origin",
    "transform",
    "sampling"
  ],
  "additionalProperties": false,
  "properties": {
    "source": {
      "$ref": "#/definitions/image"
    },
    "width": {
      "$ref": "#/definitions/side"
    },
    "height": {
      "$ref": "#/definitions/side"
    },
    "origin": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/coordinate"
      }
    },
    "transform": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/coordinate"
      }
    },
    "sampling": {
      "enum": [
        "nearest",
        "bilinear",
        "area",
        "auto"
      ]
    }
  },
  "definitions": {
    "grant": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "completed", "total", "sampled", "sampleTotal", "work", "done"],
      "properties": {
        "phase": {"enum": ["coverage", "coverageCleanup", "sampling", "complete"]},
        "completed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "sampled": {"type": "integer", "minimum": 0},
        "sampleTotal": {"type": "integer", "minimum": 0},
        "work": {"type": "integer", "minimum": 0},
        "done": {"type": "boolean"}
      }
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "work", "done"],
      "properties": {
        "phase": {"enum": ["closing", "complete"]},
        "work": {"type": "integer", "minimum": 0},
        "done": {"type": "boolean"}
      }
    },
    "coordinate": {
      "type": "number",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "side": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "image": {
      "type": "object",
      "required": [
        "width",
        "height",
        "pixels"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "$ref": "#/definitions/side"
        },
        "height": {
          "$ref": "#/definitions/side"
        },
        "pixels": {
          "type": "array",
          "maxItems": 67108864,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
