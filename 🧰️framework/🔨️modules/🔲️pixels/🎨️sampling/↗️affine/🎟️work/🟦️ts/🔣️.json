{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "quanta",
    "maximumTurns",
    "sourceCases",
    "scratchBytes",
    "pairCopyBytes",
    "pixelCopyBytes",
    "deniedCpu",
    "cachedCpu",
    "oracleTolerance",
    "cancelPhases"
  ],
  "properties": {
    "contract": {
      "const": "affine-same-bank-v1"
    },
    "quanta": {
      "const": [
        1,
        7,
        4096
      ]
    },
    "maximumTurns": {
      "const": 1000000
    },
    "sourceCases": {
      "const": 21
    },
    "scratchBytes": {
      "const": 448
    },
    "pairCopyBytes": {
      "const": 16
    },
    "pixelCopyBytes": {
      "const": 4
    },
    "deniedCpu": {
      "const": 0
    },
    "cachedCpu": {
      "const": 0
    },
    "oracleTolerance": {
      "const": 2
    },
    "cancelPhases": {
      "const": [
        "coverage",
        "coverageCleanup",
        "sampling",
        "complete"
      ]
    }
  }
}
