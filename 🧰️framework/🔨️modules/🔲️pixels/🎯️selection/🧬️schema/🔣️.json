{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/pixels/selection/component.json",
  "title": "PixelLayerSelectionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layerId",
    "target",
    "width",
    "height",
    "spans"
  ],
  "x-semio-admission": {
    "maxSpans": 65536,
    "maxPixels": 16777216,
    "maxDimension": 16384
  },
  "$defs": {
    "PixelSelectionSpanV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "length",
        "coverage"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "coverage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  },
  "properties": {
    "layerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target": {
      "enum": [
        "pixels",
        "mask"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "spans": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/PixelSelectionSpanV1"
      }
    }
  }
}
