{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/framework/pixels/png-decoding",
  "title": "PngDecodeInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "maxPixels",
    "maxBytes",
    "maxChunks"
  ],
  "properties": {
    "data": {
      "type": "array",
      "minItems": 8,
      "maxItems": 67108864,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "maxPixels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 8,
      "maximum": 67108864
    },
    "maxChunks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    }
  },
  "$defs": {
    "receipt": {
      "$ref": "https://semio.tech/framework/value/retained-clone-contract#/$defs/receipt"
    },
    "grant": {
      "$ref": "https://semio.tech/framework/value/retained-clone-contract#/$defs/grant"
    }
  }
}
