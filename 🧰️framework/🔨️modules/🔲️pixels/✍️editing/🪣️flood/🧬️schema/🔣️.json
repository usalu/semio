{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://framework/pixels/FloodRegionTurn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "grant",
    "quote",
    "outcome"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "grant": {
      "$ref": "#/definitions/Grant"
    },
    "quote": {
      "$ref": "#/definitions/Quote"
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "result"
      ],
      "properties": {
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "oneOf": [
                    {
                      "$ref": "#/definitions/Progress"
                    },
                    {
                      "$ref": "#/definitions/CloseProgress"
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "error"
              ],
              "properties": {
                "ok": {
                  "const": false
                },
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "message",
                    "progress"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "invalidValue",
                        "canceled",
                        "ownershipLimit",
                        "allocationFailed"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "progress": {
                      "$ref": "#/definitions/Receipt"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "properties": {
        "copyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copiedItems",
        "copiedBytes",
        "retainedCapacityBytes",
        "releasedBytes"
      ],
      "properties": {
        "copiedItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "copiedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "retainedCapacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "releasedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "completed",
        "total",
        "done",
        "progress"
      ],
      "properties": {
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "done": {
          "type": "boolean"
        },
        "progress": {
          "$ref": "#/definitions/Receipt"
        }
      }
    },
    "CloseProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "done",
        "progress"
      ],
      "properties": {
        "done": {
          "type": "boolean"
        },
        "progress": {
          "$ref": "#/definitions/Receipt"
        }
      }
    }
  }
}
