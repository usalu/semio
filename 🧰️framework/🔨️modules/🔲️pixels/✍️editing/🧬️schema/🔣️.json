{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/pixels/editing.json",
  "title": "Pixel Editing Contract",
  "description": "RGBA8 straight-alpha sRGB pixels. Selection coverage is 0–255. Coordinates use pixel edges and sample centers. Operations return new pixels; cancellation never publishes partial output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "operation"
  ],
  "properties": {
    "image": {
      "$ref": "#/$defs/Image"
    },
    "selection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Byte"
      }
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    }
  },
  "$defs": {
    "Byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "Image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "pixels"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "pixels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Byte"
          }
        }
      }
    },
    "Operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "points",
            "size",
            "opacity",
            "hardness",
            "color",
            "erase"
          ],
          "properties": {
            "kind": {
              "const": "stroke"
            },
            "points": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2048,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "size": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 4096
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hardness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "color": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/Byte"
              }
            },
            "erase": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "invert",
                "grayscale",
                "flipHorizontal",
                "flipVertical",
                "rotateClockwise",
                "rotateCounterclockwise",
                "clear"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "brightness",
                "contrast",
                "saturation",
                "gamma",
                "threshold",
                "posterize",
                "blur",
                "sharpen"
              ]
            },
            "value": {
              "type": "number"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "brightness",
                      "contrast",
                      "saturation"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "minimum": -1,
                    "maximum": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "gamma"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "minimum": 0.01,
                    "maximum": 10
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "threshold"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "minimum": 0,
                    "maximum": 255
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "posterize"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 256
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "blur"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "sharpen"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "minimum": 0,
                    "maximum": 5
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "width",
            "height",
            "sampling"
          ],
          "properties": {
            "kind": {
              "const": "resize"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "sampling": {
              "enum": [
                "nearest",
                "bilinear"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "kind": {
              "const": "crop"
            },
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "color"
          ],
          "properties": {
            "kind": {
              "const": "fill"
            },
            "color": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/Byte"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "points",
            "size",
            "opacity",
            "hardness",
            "alpha"
          ],
          "properties": {
            "kind": {
              "const": "alphaStroke"
            },
            "points": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2048,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "size": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 4096
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hardness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "alpha": {
              "$ref": "#/$defs/Byte"
            }
          },
          "description": "Paints alpha toward the target byte using maximum stroke coverage multiplied by brush opacity and selection coverage exactly once. RGB bytes are preserved even at zero alpha. Repeated overlapping segments do not accumulate opacity within one stroke."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "alpha",
            "opacity"
          ],
          "properties": {
            "kind": {
              "const": "alphaFill"
            },
            "alpha": {
              "$ref": "#/$defs/Byte"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "description": "Replaces alpha toward a target byte with opacity multiplied by selection coverage exactly once. RGB is preserved."
        }
      ]
    },
    "SelectionCombination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next",
        "mode"
      ],
      "description": "Combines soft selection coverage without mutating inputs. Missing current coverage is zero. Result is available only after completion; cancellation discards it. Processing grants contain at most 32768 pixels.",
      "properties": {
        "current": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16777216,
          "items": {
            "$ref": "#/$defs/Byte"
          }
        },
        "next": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16777216,
          "items": {
            "$ref": "#/$defs/Byte"
          }
        },
        "mode": {
          "enum": [
            "replace",
            "add",
            "subtract",
            "intersect"
          ]
        }
      }
    },
    "SelectionShape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "kind": {
              "enum": [
                "rectangle",
                "ellipse"
              ]
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "points"
          ],
          "properties": {
            "kind": {
              "const": "polygon"
            },
            "points": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4096,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      ]
    },
    "SelectionRasterization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "shape"
      ],
      "description": "Rasterizes sample-center coverage in grants of 1–64 rows. Progress counts rows; results are unavailable before completion. Cancellation discards every partial result. Total pixels cannot exceed 16777216.",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "shape": {
          "$ref": "#/$defs/SelectionShape"
        }
      }
    }
  }
}
