{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ordinalMaximum", "registrationMaximum", "traces"],
  "properties": {
    "version": { "const": 1 },
    "ordinalMaximum": { "const": 4294967295 },
    "registrationMaximum": { "const": "18446744073709551615" },
    "traces": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "events", "grants", "actorRetained"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "events": { "type": "array", "minItems": 1, "items": { "enum": ["reserve", "submit", "tick", "bind", "abort", "foreign-bind", "attempt-transitions", "quarantined-bind"] } },
          "grants": { "type": "integer", "minimum": 0, "maximum": 1 },
          "actorRetained": { "type": "boolean" }
        }
      }
    }
  }
}
