    "poolPreparation": { "const": { "controllerFields": ["uiResidentRecord", "uiResidentPool", "uiResidentPhase", "uiResidentWitness", "uiResidentFault"], "controllerEnvelope": { "bytes": 144, "slots": 1, "owners": 1 }, "uiEnvelope": { "bytes": 192, "slots": 4, "owners": 4 }, "intrinsicEnvelope": { "bytes": 256, "slots": 3, "owners": 3 }, "total": { "bytes": 592, "slots": 8, "owners": 8 }, "prepareBytes": 256, "samePreparedBytes": 0, "secondRecord": false, "foreignLedgerBeforeAllocation": true } },
