    "parentClose": { "const": { "releaseBytes": [64,64,64,64,64,64,256,64], "releaseKinds": ["pending","pending","pending","pending","pending","pending","pending","complete"], "maxChildCallsPerTurn": 1, "observeAfterChild": true, "retryBytes": 0, "poolCallerRequired": false } },
    "parentFault": { "const": { "values": ["null","undefined","false","zero","object"], "afterActualBeginClose": true, "first": "rejected", "retry": "blocked", "phase": "actor-resident.pool-fault-retirement", "getterReads": 0, "refund": false, "independentPeer": true, "arbitraryFaultRetirement": false } },
    "binding": { "const": { "requiredOption": "residentLedger", "sameLedger": true, "foreignLedger": false, "structuralClient": false, "publicLedgerProperty": false } },
    "refusals": { "const": ["missing-ledger", "structural-ledger", "prototype-ledger", "proxy-ledger"] },
    "boundaries": { "const": { "workersBeforeValidLedger": 0, "createdLedgers": 0, "constructorFallback": false, "liveResponseAdmission": false, "uiPoolInstalled": false } }
