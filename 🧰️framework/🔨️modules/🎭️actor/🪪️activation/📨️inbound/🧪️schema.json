{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Actor Inbound Activation Authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["actorId", "requestId", "cases"],
  "properties": {
    "actorId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "effects", "traps"],
        "properties": {
          "name": { "enum": ["exact", "missing-generation", "foreign-generation", "replaced-worker", "reactivated", "closing", "foreign-envelope"] },
          "effects": { "type": "integer", "minimum": 0, "maximum": 1 },
          "traps": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
