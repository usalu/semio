{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Captured Actor Return Authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["actorId", "responseSlots", "returnSequence", "pageSequence", "pageBytes", "boundaries", "expected"],
  "properties": {
    "actorId": { "type": "string", "minLength": 1 },
    "responseSlots": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "returnSequence": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "pageSequence": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "pageBytes": { "type": "array", "maxItems": 4096, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "boundaries": { "const": { "publicRawResponse": false, "ordinaryTurnWhileOwned": false, "lifecycleTurnWhileOwned": false, "lostOriginalWorkerControlPosts": 0, "cancellationAfterMalformedResult": true } },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["originalControlPosts", "replacementControlPosts", "sameOrigin", "sameParent", "retainedResponses", "inputAckAvailable"],
      "properties": {
        "originalControlPosts": { "const": 2 }, "replacementControlPosts": { "const": 0 },
        "sameOrigin": { "const": true }, "sameParent": { "const": true },
        "retainedResponses": { "const": 3 }, "inputAckAvailable": { "const": false }
      }
    }
  }
}
