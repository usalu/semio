{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/actor/activation/instance/output/schema.json",
  "title": "Actor Activation Instance Output Schema Module",
  "$defs": {
    "Output": {
      "title": "Captured Actor Turn Output Reservation",
      "description": "Pre-admitted strong output ownership. Admission and empty reservation cancellation do not discharge returned payloads.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity",
        "sequence",
        "phase",
        "retained"
      ],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "sequence": {
          "$ref": "https://semio.tech/schema/framework/actor/lifetime/schema.json#/$defs/U64"
        },
        "phase": {
          "enum": [
            "reserved",
            "pending",
            "returned",
            "cancelled"
          ]
        },
        "retained": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "returned"
              }
            }
          },
          "then": {
            "properties": {
              "retained": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "retained": {
                "const": false
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/Output"
    }
  ]
}
