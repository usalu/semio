{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original paid persistent guest source JSON transport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "expected",
    "copies",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "object"
    },
    "expected": {
      "type": "string"
    },
    "copies": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "items": {
      "const": 1
    }
  }
}
