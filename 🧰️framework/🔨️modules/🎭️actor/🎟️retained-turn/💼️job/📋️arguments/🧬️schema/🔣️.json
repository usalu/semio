{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Guest Job Scalar Arguments",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "slots",
    "budget",
    "arguments"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "slots": {
      "type": "array",
      "items": [
        {
          "const": "operation"
        },
        {
          "const": "generation"
        },
        {
          "const": "epoch"
        },
        {
          "const": "clockBinding"
        },
        {
          "const": "absoluteDeadlineUs"
        },
        {
          "const": "totalFuel"
        },
        {
          "const": "maximumItems"
        },
        {
          "const": "maximumCopyBytes"
        },
        {
          "const": "maximumCapacityBytes"
        },
        {
          "const": "maximumReleaseBytes"
        },
        {
          "const": "maximumDepth"
        },
        {
          "const": "policyMaximumItems"
        },
        {
          "const": "policyMaximumCopyBytes"
        },
        {
          "const": "policyMaximumCapacityBytes"
        },
        {
          "const": "policyMaximumReleaseBytes"
        },
        {
          "const": "policyMaximumDepth"
        },
        {
          "const": "fuel"
        },
        {
          "const": "deadlineUs"
        },
        {
          "const": "cancelled"
        }
      ],
      "additionalItems": false,
      "minItems": 19,
      "maxItems": 19
    },
    "budget": {
      "type": "object"
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 19,
      "maxItems": 19
    }
  }
}
