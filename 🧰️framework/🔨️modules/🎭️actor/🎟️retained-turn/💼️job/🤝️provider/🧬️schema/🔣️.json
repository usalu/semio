{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Actor Job Provider Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "providerIdentity"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "generation",
        "epoch",
        "grant"
      ],
      "properties": {
        "operation": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumItems",
            "maximumCopyBytes",
            "maximumCapacityBytes",
            "maximumReleaseBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumCopyBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumCapacityBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumReleaseBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumDepth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "providerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "generation"
      ],
      "properties": {
        "operation": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
