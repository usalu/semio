{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schemas/actor/original-bootstrap-port/v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "request",
        "command"
      ],
      "properties": {
        "kind": {
          "const": "original-stock-request"
        },
        "version": {
          "const": 1
        },
        "request": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "command": {
          "const": "admit"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "request",
        "command",
        "operation",
        "generation",
        "receipt"
      ],
      "properties": {
        "kind": {
          "const": "original-stock-request"
        },
        "version": {
          "const": 1
        },
        "request": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "command": {
          "const": "receive"
        },
        "operation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "spent",
            "workUnitsSpent"
          ],
          "properties": {
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation",
                "generation",
                "epoch",
                "grant"
              ],
              "properties": {
                "operation": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "generation": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "epoch": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "grant": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "maximumItems",
                    "maximumCopyBytes",
                    "maximumCapacityBytes",
                    "maximumReleaseBytes",
                    "maximumDepth"
                  ],
                  "properties": {
                    "maximumItems": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maximumCopyBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maximumCapacityBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maximumReleaseBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maximumDepth": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                }
              }
            },
            "spent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "copiedItems",
                "copiedBytes",
                "retainedCapacityBytes",
                "releasedBytes"
              ],
              "properties": {
                "copiedItems": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "copiedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "retainedCapacityBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "releasedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            "workUnitsSpent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "nativeReceipt": {
              "type": "object"
            },
            "nativeRemaining": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maximumItems",
                "maximumCopyBytes",
                "maximumCapacityBytes",
                "maximumReleaseBytes",
                "maximumDepth"
              ],
              "properties": {
                "maximumItems": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maximumCopyBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maximumCapacityBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maximumReleaseBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maximumDepth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "request",
        "command",
        "operation",
        "generation",
        "refusal"
      ],
      "properties": {
        "kind": {
          "const": "original-stock-request"
        },
        "version": {
          "const": 1
        },
        "request": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "command": {
          "const": "hold"
        },
        "operation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "refusal": {
          "description": "Opaque original refusal remains held; this port never evaluates or claims its ownership release."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "request",
        "command",
        "operation",
        "generation",
        "sourceClosed"
      ],
      "properties": {
        "kind": {
          "const": "original-stock-request"
        },
        "version": {
          "const": 1
        },
        "request": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "command": {
          "const": "close"
        },
        "operation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "sourceClosed": {
          "type": "boolean"
        }
      }
    }
  ]
}
