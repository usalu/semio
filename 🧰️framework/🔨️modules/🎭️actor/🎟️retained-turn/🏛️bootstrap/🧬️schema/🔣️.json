{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.actor.original-bootstrap-stock/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stock",
    "operation"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant",
        "fuel",
        "maximumElapsedUs"
      ],
      "properties": {
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumItems",
            "maximumCopyBytes",
            "maximumCapacityBytes",
            "maximumReleaseBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumCopyBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumCapacityBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumReleaseBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumDepth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "fuel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumElapsedUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant",
        "fuel",
        "maximumElapsedUs"
      ],
      "properties": {
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumItems",
            "maximumCopyBytes",
            "maximumCapacityBytes",
            "maximumReleaseBytes",
            "maximumDepth"
          ],
          "properties": {
            "maximumItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumCopyBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumCapacityBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumReleaseBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumDepth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "fuel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumElapsedUs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
