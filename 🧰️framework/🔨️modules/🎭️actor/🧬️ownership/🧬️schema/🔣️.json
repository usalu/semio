{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owners",
    "limits",
    "valueConsumers",
    "runtimeLaws"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owners": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "root",
          "symbols",
          "dependencies"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "symbols": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limits": {
      "const": {
        "version": 1,
        "maxSourceBytes": 262144,
        "maxSourceFiles": 32,
        "maxActiveLines": 4000
      }
    },
    "valueConsumers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          ".",
          "🎟️retained-turn",
          "📖️vocabulary",
          "💼️job/📨️publication"
        ]
      }
    },
    "runtimeLaws": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
