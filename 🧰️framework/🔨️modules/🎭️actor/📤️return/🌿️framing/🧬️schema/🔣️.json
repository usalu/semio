{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/actor/return/framing/schema.json",
  "title": "Actor Return Framing Schema Module",
  "definitions": {
    "pageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "receipt",
        "payloadOffset"
      ],
      "properties": {
        "kind": {
          "const": "page"
        },
        "receipt": {
          "$ref": "https://semio.tech/schema/framework/actor/return/schema.json#/definitions/pageReceipt"
        },
        "payloadOffset": {
          "type": "integer",
          "minimum": 7,
          "maximum": 42
        }
      }
    }
  },
  "$defs": {
    "Framing": {
      "title": "Canonical Return Result Framing Projection",
      "description": "Bytewise validation of the existing canonical return result, without payload storage or ownership authority. Page offsets are relative to the result's first byte. The caller must retain the original input and admit parser metadata separately. No producer identity, resident lease, semantic input ACK or final retirement is minted by this public format projection.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumFeedBytes",
        "maximumPayloadCopies",
        "maximumBufferedPayloadBytes",
        "pageOffsetBasis",
        "formatMintsAuthority",
        "failureIsSticky"
      ],
      "properties": {
        "maximumFeedBytes": {
          "const": 1
        },
        "maximumPayloadCopies": {
          "const": 0
        },
        "maximumBufferedPayloadBytes": {
          "const": 0
        },
        "pageOffsetBasis": {
          "const": "resultStart"
        },
        "formatMintsAuthority": {
          "const": false
        },
        "failureIsSticky": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/Framing"
    }
  ]
}
