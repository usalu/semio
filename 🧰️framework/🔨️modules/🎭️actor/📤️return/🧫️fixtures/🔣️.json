  "laws": [
    {"name": "admission-before-execution", "requirement": "Reserve native typed owner, source page and host response before semantic work; capacity refusal performs zero semantic work."},
    {"name": "duplicate-execute", "requirement": "Same origin replays the existing result without executing twice or replacing retained content; another origin is refused while the owner remains active. The activation retains the monotonic last-admitted origin after final ACK and newer admissions, so an older delayed execute never executes again."},
    {"name": "exact-original-activation", "requirement": "Public numbers are validated through the original captured activation and native runtime, never a current name, instance or worker lookup."},
    {"name": "repeated-page", "requirement": "Repeated delivery has identical identity, sequence, length, final flag and bytes; source stays retained until exact input ACK succeeds."},
    {"name": "exact-input-ack", "requirement": "Wrong activation, origin, return sequence, page sequence, length or final flag refuses without changing any owner."},
    {"name": "input-close-before-ack", "requirement": "Host page decoding or cancellation and all borrowed input descendants become terminal before it sends the exact ACK; raw delivery and semantic UI ACK are insufficient."},
    {"name": "ack-only-control", "requirement": "Input ACK, cancel and retired ACK return a fixed correlated control result, never a new page; mixed semantic events or command pages refuse before work."},
    {"name": "cancel-outstanding-page", "requirement": "Cancel keeps an already issued page available for exact input retirement; typed source retirement cannot report terminal while that page remains owned."},
    {"name": "final-root-retirement", "requirement": "Final page ACK begins bounded source retirement; Retired is published only after exact typed descendants and final root release pass the final strict clock verdict."},
    {"name": "lost-final-ack-reply", "requirement": "The exact last retired ACK remains an idempotent fixed tombstone until the next admitted execute; repeated ACK returns duplicate without allocating or releasing twice."},
    {"name": "checked-exhaustion", "requirement": "Origin, native return and page sequences never wrap; exhaustion occurs before new ownership or semantic work and retains any previous owner."},
    {"name": "clock-and-caller-fault", "requirement": "Missing/backward clock, elapsed at least 8000us, synchronous consumer throw, malformed decode and transport failure retain the exact source, receipt and pending control for retry or bounded close."},
    {"name": "zero-grant", "requirement": "Zero item or byte grants do not encode, copy, release or mutate a page or source cursor."},
    {"name": "same-id-reopen", "requirement": "Delayed pages and control receipts target the captured old activation owner; reopening the same numeric instance does not authorize replacement lookup."}
  ]
