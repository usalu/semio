{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/actor/return/response/schema.json",
  "title": "Actor Return Response Schema Module",
  "definitions": {
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "transportFault": {
      "enum": [
        "requestRefused",
        "executionFault",
        "resultFault"
      ]
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "activationGeneration",
        "transportRequestSequence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "result",
            "fault"
          ]
        },
        "activationGeneration": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/NonZeroU64"
        },
        "transportRequestSequence": {
          "$ref": "#/$defs/TransportRequestSequence"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "activationGeneration",
        "transportRequestSequence",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "result"
        },
        "activationGeneration": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/NonZeroU64"
        },
        "transportRequestSequence": {
          "$ref": "#/$defs/TransportRequestSequence"
        },
        "result": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/actor/return/schema.json#/$defs/Result"
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "activationGeneration",
        "transportRequestSequence",
        "fault"
      ],
      "properties": {
        "kind": {
          "const": "fault"
        },
        "activationGeneration": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/NonZeroU64"
        },
        "transportRequestSequence": {
          "$ref": "#/$defs/TransportRequestSequence"
        },
        "fault": {
          "$ref": "#/definitions/transportFault"
        }
      }
    }
  },
  "$defs": {
    "Response": {
      "title": "Captured Worker Return Response",
      "description": "Single replacement for the canonical return-drive worker response. Fixed magic 73727201, one tag byte (result 0, fault 1), positive activationGeneration ULEB64, actual transportRequestSequence canonical ULEB53, then canonical ActorReturnResult bytes to EOF or exactly one closed transport fault byte. Maximum 4161 bytes. This does not change WIT or native return origin.",
      "oneOf": [
        {
          "$ref": "#/definitions/result"
        },
        {
          "$ref": "#/definitions/fault"
        }
      ]
    },
    "TransportRequestSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
