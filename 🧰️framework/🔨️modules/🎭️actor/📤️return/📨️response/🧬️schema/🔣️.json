{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/actor/return/response/schema.json",
  "title": "Actor Return Response Schema Module",
  "definitions": {
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "transportFault": {
      "enum": [
        "requestRefused",
        "executionFault",
        "resultFault"
      ]
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "activationGeneration",
        "transportRequestSequence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "result",
            "fault"
          ]
        },
        "activationGeneration": {
          "$ref": "https://semio.tech/schema/framework/actor/return/schema.json#/$defs/U64"
        },
        "transportRequestSequence": {
          "$ref": "#/$defs/TransportRequestSequence"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "activationGeneration",
        "transportRequestSequence",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "result"
        },
        "activationGeneration": {
          "$ref": "https://semio.tech/schema/framework/actor/return/schema.json#/$defs/U64"
        },
        "transportRequestSequence": {
          "$ref": "#/$defs/TransportRequestSequence"
        },
        "result": {
          "$ref": "https://semio.tech/schema/framework/actor/return/schema.json#/$defs/Result"
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "activationGeneration",
        "transportRequestSequence",
        "fault"
      ],
      "properties": {
        "kind": {
          "const": "fault"
        },
        "activationGeneration": {
          "$ref": "https://semio.tech/schema/framework/actor/return/schema.json#/$defs/U64"
        },
        "transportRequestSequence": {
          "$ref": "#/$defs/TransportRequestSequence"
        },
        "fault": {
          "$ref": "#/definitions/transportFault"
        }
      }
    }
  },
  "$defs": {
    "ResponseFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "magicHex",
        "maximumBytes",
        "tags",
        "faultTags",
        "vectors",
        "maximumPage",
        "headerCases",
        "invalidHex",
        "backings",
        "transfer",
        "authority"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "magicHex": {
          "const": "73727201"
        },
        "maximumBytes": {
          "const": 4161
        },
        "tags": {
          "const": {
            "result": 0,
            "fault": 1
          }
        },
        "faultTags": {
          "const": {
            "requestRefused": 0,
            "executionFault": 1,
            "resultFault": 2
          }
        },
        "vectors": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "resultHex",
              "hex"
            ],
            "properties": {
              "value": {
                "$ref": "https://semio.tech/schema/framework/actor/return/response/schema.json#/$defs/Response"
              },
              "resultHex": {
                "$ref": "#/definitions/hex"
              },
              "hex": {
                "$ref": "#/definitions/hex"
              }
            }
          }
        },
        "maximumPage": {
          "const": {
            "sharedPageVector": 1,
            "headerHex": "7372720100ffffffffffffffffff01ffffffffffffff0f",
            "wireBytes": 4161
          }
        },
        "headerCases": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hex",
              "header",
              "bodyValid"
            ],
            "properties": {
              "hex": {
                "$ref": "#/definitions/hex"
              },
              "header": {
                "$ref": "#/definitions/header"
              },
              "bodyValid": {
                "const": false
              }
            }
          }
        },
        "invalidHex": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/hex"
          }
        },
        "backings": {
          "const": {
            "wholeFixed": true,
            "offsetView": false,
            "wholeView": false,
            "shared": false,
            "resizable": false,
            "detached": false,
            "proxy": false,
            "oversized": false
          }
        },
        "transfer": {
          "const": {
            "senderDetached": true,
            "receiverResizable": false,
            "receiverWholeBacking": true,
            "customPropertyTransferred": false,
            "bytesEqual": true
          }
        },
        "authority": {
          "const": {
            "formatMintsPage": false,
            "transportDiffersFromReturnOrigin": true,
            "protocolFaultNeedsTransportCorrelation": true,
            "unknownRootsRetained": true,
            "workerSlotRequired": true,
            "noVariableErrors": true
          }
        }
      }
    },
    "Response": {
      "title": "Captured Worker Return Response",
      "description": "Single replacement for the canonical return-drive worker response. Fixed magic 73727201, one tag byte (result 0, fault 1), positive activationGeneration ULEB64, actual transportRequestSequence canonical ULEB53, then canonical ActorReturnResult bytes to EOF or exactly one closed transport fault byte. Maximum 4161 bytes. This does not change WIT or native return origin.",
      "oneOf": [
        {
          "$ref": "#/definitions/result"
        },
        {
          "$ref": "#/definitions/fault"
        }
      ]
    },
    "TransportRequestSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
