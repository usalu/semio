{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/actor/return/response/credit/schema.json",
  "title": "Actor Return Response Credit Schema Module",
  "definitions": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationGeneration",
        "transportRequestSequence"
      ],
      "properties": {
        "activationGeneration": {
          "$ref": "https://semio.tech/schema/framework/actor/return/schema.json#/definitions/u64"
        },
        "transportRequestSequence": {
          "$ref": "https://semio.tech/schema/framework/actor/return/response/schema.json#/definitions/transportRequestSequence"
        }
      }
    },
    "receiverPhase": {
      "enum": [
        "reserved",
        "posted",
        "captured",
        "heldFault",
        "cancelled"
      ]
    },
    "workerPhase": {
      "enum": [
        "admitted",
        "captured",
        "ready",
        "posted",
        "heldFault"
      ]
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "rawBackingBytes",
        "captures",
        "emergencyRoots",
        "sealed",
        "pendingRetained",
        "rawRetained",
        "faultRetained"
      ],
      "properties": {
        "phase": {
          "$ref": "#/definitions/receiverPhase"
        },
        "rawBackingBytes": {
          "enum": [
            0,
            4161
          ]
        },
        "captures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "emergencyRoots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "sealed": {
          "type": "boolean"
        },
        "pendingRetained": {
          "type": "boolean"
        },
        "rawRetained": {
          "type": "boolean"
        },
        "faultRetained": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "rawBackingBytes": {
                "const": 0
              },
              "captures": {
                "const": 0
              },
              "emergencyRoots": {
                "const": 0
              },
              "pendingRetained": {
                "const": false
              },
              "rawRetained": {
                "const": false
              },
              "faultRetained": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "rawBackingBytes": {
                "const": 4161
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "captures": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "rawRetained": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "rawRetained": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "captured"
              }
            }
          },
          "then": {
            "properties": {
              "captures": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "enum": [
                  "reserved",
                  "posted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "captures": {
                "const": 0
              },
              "pendingRetained": {
                "const": true
              },
              "sealed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "heldFault"
              }
            }
          },
          "then": {
            "properties": {
              "sealed": {
                "const": true
              },
              "faultRetained": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "emergencyRoots": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "sealed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "transferCreditsSpent",
        "rawRetained",
        "backingRetained",
        "faultRetained"
      ],
      "properties": {
        "phase": {
          "$ref": "#/definitions/workerPhase"
        },
        "transferCreditsSpent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "rawRetained": {
          "type": "boolean"
        },
        "backingRetained": {
          "type": "boolean"
        },
        "faultRetained": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transferCreditsSpent": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "backingRetained": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "admitted"
              }
            }
          },
          "then": {
            "properties": {
              "transferCreditsSpent": {
                "const": 0
              },
              "rawRetained": {
                "const": false
              },
              "backingRetained": {
                "const": false
              },
              "faultRetained": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "transferCreditsSpent": {
                "const": 0
              },
              "rawRetained": {
                "const": true
              },
              "backingRetained": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "posted"
              }
            }
          },
          "then": {
            "properties": {
              "transferCreditsSpent": {
                "const": 1
              },
              "rawRetained": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "heldFault"
              }
            }
          },
          "then": {
            "properties": {
              "faultRetained": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "receiverAction": {
      "enum": [
        "post",
        "cancelEmpty",
        "postRefused",
        "capture",
        "settle",
        "bodyFault",
        "headerFault",
        "foreignWorker",
        "foreignActivation",
        "foreignRequest",
        "duplicate",
        "callbackFault"
      ]
    },
    "workerAction": {
      "enum": [
        "capture",
        "normalize",
        "normalizationFault",
        "post",
        "postRefused",
        "detachedPostFault",
        "duplicate"
      ]
    }
  },
  "$defs": {
    "CreditFixture": {
      "title": "Return Response Credit Laws",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "returnOriginRequestSequence",
        "maximumBackingBytes",
        "ownerBinding",
        "reservationOrder",
        "captureOrder",
        "receiverInitial",
        "workerInitial",
        "receiverCases",
        "workerCases",
        "boundaries"
      ],
      "properties": {
        "authority": {
          "$ref": "https://semio.tech/schema/framework/actor/return/response/credit/schema.json#/definitions/authority"
        },
        "returnOriginRequestSequence": {
          "const": 9
        },
        "maximumBackingBytes": {
          "const": 4161
        },
        "ownerBinding": {
          "const": [
            "originalWorkerObject",
            "originalActivationObject",
            "actualTransportRequest"
          ]
        },
        "reservationOrder": {
          "const": [
            "sharedLedgerAdmission",
            "strongRawSlotRegistration",
            "pendingDispatchRegistration",
            "post"
          ]
        },
        "captureOrder": {
          "const": [
            "originalRootRetention",
            "headerCorrelation",
            "creditedCapture",
            "boundedBodyValidation",
            "pendingRemoval",
            "callback"
          ]
        },
        "receiverInitial": {
          "$ref": "https://semio.tech/schema/framework/actor/return/response/credit/schema.json#/definitions/receiver"
        },
        "workerInitial": {
          "$ref": "https://semio.tech/schema/framework/actor/return/response/credit/schema.json#/definitions/worker"
        },
        "receiverCases": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "actions",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "https://semio.tech/schema/framework/actor/return/response/credit/schema.json#/definitions/receiverAction"
                }
              },
              "expected": {
                "$ref": "https://semio.tech/schema/framework/actor/return/response/credit/schema.json#/definitions/receiver"
              }
            }
          }
        },
        "workerCases": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "actions",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "https://semio.tech/schema/framework/actor/return/response/credit/schema.json#/definitions/workerAction"
                }
              },
              "expected": {
                "$ref": "https://semio.tech/schema/framework/actor/return/response/credit/schema.json#/definitions/worker"
              }
            }
          }
        },
        "boundaries": {
          "const": {
            "operationRevocationReleasesCredit": false,
            "oldWorkerReplyMayBeRetained": true,
            "formatMintsProvenance": false,
            "callbackReleasesRawLease": false,
            "responseCountIsByteAdmission": false,
            "fieldCopyIsNativeInputAck": false,
            "fixedFaultReleasesOriginalError": false,
            "emergencyMayOverwrite": false,
            "rogueFloodIsBounded": false,
            "wireLayout": "https://semio.tech/schema/framework/actor/return/response/schema.json#/$defs/Response"
          }
        }
      }
    },
    "Credit": {
      "title": "Captured Return Response Credit",
      "description": "Local ownership protocol on the existing actual worker request, not a new wire identity or WIT ABI. The original worker object, activation object and actual positive safe request sequence identify each credit. A composition-owned neutral ledger reserves the full canonical 4161-byte receiver backing allowance and every retained owner record before dispatch. Receipt capture precedes decoding, pending removal and callbacks. One private worker reply owner permits at most one successful transfer; the receiver permits at most one credited capture. First protocol violation seals new admissions and retains the first emergency root and all existing pending roots. Arbitrary uncredited flooding is outside the finite credited contract, never a bounded-memory or disposal claim.",
      "oneOf": [
        {
          "$ref": "#/definitions/receiver"
        },
        {
          "$ref": "#/definitions/worker"
        }
      ]
    }
  }
}
