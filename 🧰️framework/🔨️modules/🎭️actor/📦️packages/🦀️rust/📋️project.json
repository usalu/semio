{
  "name": "@semio-tech/framework-actor-rs",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
  "namedInputs": {
    "default": ["{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/**/*.rs", "{projectRoot}/**/*"]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test quick"
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test long"
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test exhaustive"
      }
    },
    "typegen": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts typegen"
      },
      "outputs": ["{projectRoot}/../../🤖️generated"]
    },
    "wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts wasm"
      },
      "outputs": ["{projectRoot}/pkg"]
    }
  }
}
