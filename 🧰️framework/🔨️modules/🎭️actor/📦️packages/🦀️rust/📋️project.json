{
  "name": "@semio-tech/framework-actor-rs",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/**/*.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/📬️mailbox/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/📮️shard-client/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/🧪️tests/🧬️typegen/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/🧬️typegen/🏃️execution/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/🧬️typegen/📋️plan/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/🧬️typegen/📤️publication/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/📦️artifacts/🗂️files/🟦️.ts"
    ],
    "nativeSources": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🎭️actor/🧩️component/**/*"
    ]
  },
  "targets": {
    "test-original-receiving-source": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-original-receiving-source",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "source"
          }
        }
      }
    },
    "test-original-receiving-native": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework",
        "command": "bun ./🔨️modules/🏃️process/📜️script.ts command --config ./⚙️configuration/🏃️process/🔣️.json --cwd 🔨️modules/🎭️actor/📦️packages/🦀️rust --manifest 🔨️modules/🎭️actor/📦️packages/🦀️rust/Cargo.toml -- bun ./📜️script.ts test long --lib original_actor_ --success-output immediate -- --nocapture",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    },
    "typegen": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts typegen"
      },
      "outputs": [
        "{projectRoot}/../../🤖️generated/🎭️actor"
      ]
    },
    "preview-generated": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts preview-generated"
      },
      "outputs": []
    },
    "wasm": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts wasm"
      },
      "outputs": [
        "{projectRoot}/pkg"
      ],
      "cache": true
    },
    "test-original-owned-async-source": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-original-owned-async source",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "source"
          }
        }
      }
    },
    "test-original-owned-async-native": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-original-owned-async native",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "native",
            "scope": "test"
          }
        }
      }
    },
    "test-original-context-native": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🎭️actor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-original-context-native",
        "forwardAllArgs": true
      },
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "native",
            "scope": "test"
          }
        }
      }
    }
  }
}
