{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/actor/shard-client/segmented-download/schema.json",
  "title": "Segmented Download Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunkBytes",
    "maximumOutstandingChunks",
    "maximumTotalBytes",
    "maximumOperationId"
  ],
  "properties": {
    "chunkBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maximumOutstandingChunks": {
      "type": "integer",
      "minimum": 1
    },
    "maximumTotalBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maximumOperationId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    }
  }
}
