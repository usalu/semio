{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/actor/shard-client/component-codec/schema.json",
  "title": "Actor Component Codec Lane",
  "$defs": {
    "Hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$"
    },
    "DocumentPair": {
      "title": "Codec Document Pair",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packHex",
        "sprHex"
      ],
      "properties": {
        "packHex": {
          "$ref": "#/$defs/Hex"
        },
        "sprHex": {
          "$ref": "#/$defs/Hex"
        }
      }
    },
    "ShardCodecRequest": {
      "title": "One Codec Interface Call",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "artifactKind"
          ],
          "properties": {
            "operation": {
              "const": "pack-schema-hash"
            },
            "artifactKind": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "artifactKind",
            "documentId"
          ],
          "properties": {
            "operation": {
              "const": "genesis"
            },
            "artifactKind": {
              "type": "string",
              "minLength": 1
            },
            "documentId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "artifactKind",
            "pair"
          ],
          "properties": {
            "operation": {
              "const": "print-mirror"
            },
            "artifactKind": {
              "type": "string",
              "minLength": 1
            },
            "pair": {
              "$ref": "#/$defs/DocumentPair"
            }
          }
        }
      ]
    }
  }
}
