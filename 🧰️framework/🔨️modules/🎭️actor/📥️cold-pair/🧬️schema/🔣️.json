{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.actor.cold-pair-ingress-status.v1",
  "title": "Actor Cold Document Pair Ingress Status",
  "$defs": {
    "hash": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"type": "integer", "minimum": 0, "maximum": 255}, "not": {"items": {"const": 0}}},
    "lifetime": {
      "type": "object", "additionalProperties": false,
      "required": ["activationGeneration", "instanceId", "guestLifetime"],
      "properties": {
        "activationGeneration": {"type": "integer", "minimum": 1},
        "instanceId": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "guestLifetime": {"type": "integer", "minimum": 1}
      }
    },
    "cursor": {
      "type": "object", "additionalProperties": false,
      "required": ["lifetime", "transferGeneration", "pageIndex", "pageCount"],
      "properties": {
        "lifetime": {"$ref": "#/$defs/lifetime"},
        "transferGeneration": {"type": "integer", "minimum": 1},
        "pageIndex": {"type": "integer", "minimum": 0, "maximum": 63},
        "pageCount": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "frontier": {
      "type": "object", "additionalProperties": false,
      "required": ["documentId", "headEditOrdinal", "headEditId", "lastCommitSeq", "chainSha256"],
      "properties": {
        "documentId": {"type": "string", "minLength": 1, "maxLength": 512},
        "headEditOrdinal": {"type": "integer", "minimum": 0},
        "headEditId": {"type": "string", "minLength": 1, "maxLength": 512},
        "lastCommitSeq": {"type": "integer", "minimum": 0},
        "chainSha256": {"$ref": "#/$defs/hash"}
      }
    },
    "applied": {
      "type": "object", "additionalProperties": false,
      "required": ["lifetime", "transferGeneration", "baselineFrontier", "aggregateSha256"],
      "properties": {
        "lifetime": {"$ref": "#/$defs/lifetime"},
        "transferGeneration": {"type": "integer", "minimum": 1},
        "baselineFrontier": {"$ref": "#/$defs/frontier"},
        "aggregateSha256": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "idle"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "cursor"], "properties": {"kind": {"enum": ["pageAccepted", "backpressure", "loading"]}, "cursor": {"$ref": "#/$defs/cursor"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "receipt"], "properties": {"kind": {"const": "applied"}, "receipt": {"$ref": "#/$defs/applied"}}},
    {"type": "object", "additionalProperties": false, "required": ["kind", "cursor", "fault"], "properties": {"kind": {"const": "fault"}, "cursor": {"$ref": "#/$defs/cursor"}, "fault": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "integer", "minimum": 0, "maximum": 255}}}}
  ]
}
