{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.actor.instance-close.fault-fixture.v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "callbackLimitUs", "callbacks", "terminalPump", "clocks", "owners"],
  "properties": {
    "version": { "const": 1 }, "callbackLimitUs": { "const": 8000 },
    "callbacks": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["candidate", "elapsedUs", "published"],
        "properties": {
          "candidate": { "$ref": "#/definitions/status" },
          "elapsedUs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "published": { "$ref": "#/definitions/status" }
        }
      }
    },
    "terminalPump": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["complete", "faulted", "blocked", "status"],
        "properties": {
          "complete": { "type": "boolean" }, "faulted": { "type": "boolean" }, "blocked": { "type": "boolean" },
          "status": { "$ref": "#/definitions/status" }
        }
      }
    },
    "clocks": {
      "type": "array", "minItems": 7,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["samples", "workEntered", "published"],
        "properties": {
          "samples": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 } },
          "workEntered": { "type": "boolean" }, "published": { "$ref": "#/definitions/status" }
        }
      }
    },
    "owners": {
      "type": "object", "additionalProperties": false,
      "required": ["terminalVisibleBeforeWatchdog", "sharedRestoreKeepsExactAllocation", "nonterminalPreflightKeepsExactAllocation", "contendedPumpPreservesSession", "contendedOutcomePreservesSource", "secondOwnerLockRequired", "forgottenPayloads"],
      "properties": {
        "terminalVisibleBeforeWatchdog": { "const": false }, "sharedRestoreKeepsExactAllocation": { "const": true },
        "nonterminalPreflightKeepsExactAllocation": { "const": true }, "contendedPumpPreservesSession": { "const": true }, "contendedOutcomePreservesSource": { "const": true }, "secondOwnerLockRequired": { "const": false }, "forgottenPayloads": { "const": 0 }
      }
    }
  },
  "definitions": { "status": { "enum": ["ready", "complete", "external-wait", "fault"] } }
}
