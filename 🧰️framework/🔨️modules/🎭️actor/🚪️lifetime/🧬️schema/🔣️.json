{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/actor/lifetime/schema.json",
  "title": "Actor Lifetime Schema Module",
  "definitions": {
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "activationGeneration",
        "instanceId",
        "requestSequence"
      ],
      "properties": {
        "kind": {
          "const": "open"
        },
        "activationGeneration": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/NonZeroU64"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "requestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lifetime",
        "requestSequence"
      ],
      "properties": {
        "kind": {
          "const": "close"
        },
        "lifetime": {
          "$ref": "#/$defs/InstanceLifetime"
        },
        "requestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "captured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lifetime",
        "requestSequence"
      ],
      "properties": {
        "kind": {
          "const": "captured"
        },
        "lifetime": {
          "$ref": "#/$defs/InstanceLifetime"
        },
        "requestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "closedReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lifetime",
        "requestSequence",
        "closeGeneration"
      ],
      "properties": {
        "kind": {
          "enum": [
            "accepted",
            "retired"
          ]
        },
        "lifetime": {
          "$ref": "#/$defs/InstanceLifetime"
        },
        "requestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "closeGeneration": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/NonZeroU64"
        }
      }
    },
    "receipt": {
      "oneOf": [
        {
          "$ref": "#/definitions/captured"
        },
        {
          "$ref": "#/definitions/closedReceipt"
        }
      ]
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "receipt"
      ],
      "properties": {
        "kind": {
          "const": "ack"
        },
        "receipt": {
          "$ref": "#/definitions/receipt"
        }
      }
    },
    "status": {
      "enum": [
        "ready",
        "complete",
        "external-wait",
        "fault",
        "deadline-yield"
      ]
    }
  },
  "$defs": {
    "Lifetime": {
      "oneOf": [
        {
          "$ref": "#/definitions/open"
        },
        {
          "$ref": "#/definitions/request"
        },
        {
          "$ref": "#/definitions/receipt"
        },
        {
          "$ref": "#/definitions/ack"
        }
      ]
    },
    "InstanceLifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationGeneration",
        "instanceId",
        "guestLifetime"
      ],
      "properties": {
        "activationGeneration": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/NonZeroU64"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "guestLifetime": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/NonZeroU64"
        }
      }
    }
  }
}
