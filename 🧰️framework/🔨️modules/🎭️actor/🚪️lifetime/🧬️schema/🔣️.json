{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/actor/lifetime/schema.json",
  "title": "Actor Lifetime Schema Module",
  "definitions": {
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "activationGeneration",
        "instanceId",
        "requestSequence"
      ],
      "properties": {
        "kind": {
          "const": "open"
        },
        "activationGeneration": {
          "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/NonZeroU64"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "requestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lifetime",
        "requestSequence"
      ],
      "properties": {
        "kind": {
          "const": "close"
        },
        "lifetime": {
          "$ref": "#/$defs/InstanceLifetime"
        },
        "requestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "captured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lifetime",
        "requestSequence"
      ],
      "properties": {
        "kind": {
          "const": "captured"
        },
        "lifetime": {
          "$ref": "#/$defs/InstanceLifetime"
        },
        "requestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "closedReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lifetime",
        "requestSequence",
        "closeGeneration"
      ],
      "properties": {
        "kind": {
          "enum": [
            "accepted",
            "retired"
          ]
        },
        "lifetime": {
          "$ref": "#/$defs/InstanceLifetime"
        },
        "requestSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "closeGeneration": {
          "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/NonZeroU64"
        }
      }
    },
    "receipt": {
      "oneOf": [
        {
          "$ref": "#/definitions/captured"
        },
        {
          "$ref": "#/definitions/closedReceipt"
        }
      ]
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "receipt"
      ],
      "properties": {
        "kind": {
          "const": "ack"
        },
        "receipt": {
          "$ref": "#/definitions/receipt"
        }
      }
    },
    "status": {
      "enum": [
        "ready",
        "complete",
        "external-wait",
        "fault",
        "deadline-yield"
      ]
    }
  },
  "$defs": {
    "LifetimeFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "vectors",
        "turnResults",
        "reopen",
        "completion",
        "leaseReceipts",
        "nativeCases",
        "leaseFailures",
        "publishedClose"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "vectors": {
          "type": "array",
          "minItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "hex"
            ],
            "properties": {
              "value": {
                "$ref": "https://semio.tech/schema/framework/actor/lifetime/schema.json#/$defs/Lifetime"
              },
              "hex": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})+$",
                "maxLength": 88
              }
            }
          }
        },
        "turnResults": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vector",
              "hex"
            ],
            "properties": {
              "vector": {
                "enum": [
                  null,
                  1,
                  4,
                  8
                ]
              },
              "hex": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})+$",
                "maxLength": 152
              }
            }
          }
        },
        "reopen": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prior",
            "current",
            "oldRequestAccepted",
            "oldReceiptAccepted"
          ],
          "properties": {
            "prior": {
              "$ref": "https://semio.tech/schema/framework/actor/lifetime/schema.json#/$defs/InstanceLifetime"
            },
            "current": {
              "$ref": "https://semio.tech/schema/framework/actor/lifetime/schema.json#/$defs/InstanceLifetime"
            },
            "oldRequestAccepted": {
              "const": false
            },
            "oldReceiptAccepted": {
              "const": false
            }
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "participants",
            "acceptedIsTerminal",
            "idleIsTerminal",
            "mapRemovalIsTerminal",
            "allExactOwnersRetiredIsTerminal"
          ],
          "properties": {
            "participants": {
              "const": [
                "app",
                "reactor",
                "nativeUi",
                "hostUi",
                "ingress",
                "publication",
                "transport"
              ]
            },
            "acceptedIsTerminal": {
              "const": false
            },
            "idleIsTerminal": {
              "const": false
            },
            "mapRemovalIsTerminal": {
              "const": false
            },
            "allExactOwnersRetiredIsTerminal": {
              "const": true
            }
          }
        },
        "nativeCases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sameIdReplacementRejected",
            "overflowPreservesLiveOwner",
            "quarantineRemovalPreservesTerminalWitness",
            "repeatCloseKeepsReplacement",
            "scopeAfterSurfaceClear"
          ],
          "properties": {
            "sameIdReplacementRejected": {
              "const": true
            },
            "overflowPreservesLiveOwner": {
              "const": true
            },
            "quarantineRemovalPreservesTerminalWitness": {
              "const": true
            },
            "repeatCloseKeepsReplacement": {
              "const": true
            },
            "scopeAfterSurfaceClear": {
              "const": true
            }
          }
        },
        "leaseFailures": {
          "const": [
            "postMessage-throw",
            "worker-error"
          ]
        },
        "publishedClose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "granularity",
            "owners",
            "remaining",
            "complete"
          ],
          "properties": {
            "granularity": {
              "const": "owner-transition"
            },
            "owners": {
              "const": [
                "metadata",
                "credit",
                "handback"
              ]
            },
            "remaining": {
              "const": [
                [
                  "credit",
                  "handback"
                ],
                [
                  "handback"
                ],
                [],
                []
              ]
            },
            "complete": {
              "const": [
                false,
                false,
                false,
                true
              ]
            }
          }
        },
        "leaseReceipts": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "events",
              "settled"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "enum": [
                    "accepted",
                    "retired",
                    "foreign-worker-accepted",
                    "old-activation-accepted",
                    "wrong-request-accepted",
                    "wrong-generation-retired"
                  ]
                }
              },
              "settled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "Lifetime": {
      "oneOf": [
        {
          "$ref": "#/definitions/open"
        },
        {
          "$ref": "#/definitions/request"
        },
        {
          "$ref": "#/definitions/receipt"
        },
        {
          "$ref": "#/definitions/ack"
        }
      ]
    },
    "CloseFaultFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "callbackLimitUs",
        "callbacks",
        "terminalPump",
        "clocks",
        "owners"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "callbackLimitUs": {
          "const": 8000
        },
        "callbacks": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate",
              "elapsedUs",
              "published"
            ],
            "properties": {
              "candidate": {
                "$ref": "#/definitions/status"
              },
              "elapsedUs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "published": {
                "$ref": "#/definitions/status"
              }
            }
          }
        },
        "terminalPump": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "complete",
              "faulted",
              "blocked",
              "status"
            ],
            "properties": {
              "complete": {
                "type": "boolean"
              },
              "faulted": {
                "type": "boolean"
              },
              "blocked": {
                "type": "boolean"
              },
              "status": {
                "$ref": "#/definitions/status"
              }
            }
          }
        },
        "clocks": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "samples",
              "workEntered",
              "published"
            ],
            "properties": {
              "samples": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "workEntered": {
                "type": "boolean"
              },
              "published": {
                "$ref": "#/definitions/status"
              }
            }
          }
        },
        "owners": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terminalVisibleBeforeWatchdog",
            "sharedRestoreKeepsExactAllocation",
            "nonterminalPreflightKeepsExactAllocation",
            "contendedPumpPreservesSession",
            "contendedOutcomePreservesSource",
            "secondOwnerLockRequired",
            "forgottenPayloads",
            "lateResumeRepeatsPhysicalClose"
          ],
          "properties": {
            "terminalVisibleBeforeWatchdog": {
              "const": false
            },
            "sharedRestoreKeepsExactAllocation": {
              "const": true
            },
            "nonterminalPreflightKeepsExactAllocation": {
              "const": true
            },
            "contendedPumpPreservesSession": {
              "const": true
            },
            "contendedOutcomePreservesSource": {
              "const": true
            },
            "secondOwnerLockRequired": {
              "const": false
            },
            "forgottenPayloads": {
              "const": 0
            },
            "lateResumeRepeatsPhysicalClose": {
              "const": false
            }
          }
        }
      }
    },
    "InstanceLifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activationGeneration",
        "instanceId",
        "guestLifetime"
      ],
      "properties": {
        "activationGeneration": {
          "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/NonZeroU64"
        },
        "instanceId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "guestLifetime": {
          "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/NonZeroU64"
        }
      }
    }
  }
}
