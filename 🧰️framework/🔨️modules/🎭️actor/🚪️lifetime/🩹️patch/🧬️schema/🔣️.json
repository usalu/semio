{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/actor/lifetime/patch/schema.json",
  "title": "Actor Lifetime Patch Schema Module",
  "$defs": {
    "Patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifetime",
        "patchSequence"
      ],
      "properties": {
        "lifetime": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/actor/lifetime/schema.json#/$defs/InstanceLifetime"
        },
        "patchSequence": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json#/$defs/NonZeroU64"
        }
      }
    },
    "PatchIdentityReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      }
    }
  }
}
