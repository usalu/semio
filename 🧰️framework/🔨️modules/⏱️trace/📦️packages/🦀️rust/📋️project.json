{
  "name": "@semio-tech/framework-trace-rs",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🔨️modules/⏱️trace/📦️packages/🦀️rust",
  "namedInputs": {
    "default": ["{workspaceRoot}/🧰️framework/🔨️modules/⏱️trace/**/*.rs", "{projectRoot}/**/*", "sharedGlobals"],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/🧲️fixture-reader/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/⏱️trace/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    }
  }
}
