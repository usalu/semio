{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/trace/clock/contention/schema.json",
  "title": "Trace Clock Contention Schema Module",
  "$defs": {
    "Contention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sustainedOverrunSteps",
        "cases",
        "verdicts",
        "overruns"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "verdicts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "start",
              "end",
              "fault",
              "clockFault",
              "sessionTerminal"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "fault": {
                "type": "boolean"
              },
              "clockFault": {
                "enum": [
                  null,
                  "Missing",
                  "Backward"
                ]
              },
              "sessionTerminal": {
                "type": "boolean"
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "lock",
              "callback",
              "returnsWhileHeld",
              "violationRetained",
              "returnedEvent"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "lock": {
                "enum": [
                  "site",
                  "violation",
                  "event"
                ]
              },
              "callback": {
                "enum": [
                  "timer",
                  "watchdog",
                  "event"
                ]
              },
              "returnsWhileHeld": {
                "const": true
              },
              "violationRetained": {
                "type": "boolean"
              },
              "returnedEvent": {
                "type": "boolean"
              }
            }
          }
        },
        "sustainedOverrunSteps": {
          "const": 4
        },
        "overruns": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "elapsedUs",
              "terminalIndex",
              "consecutive",
              "longestRun",
              "total",
              "worstElapsedUs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "elapsedUs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "terminalIndex": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 3,
                "maximum": 15
              },
              "consecutive": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16
              },
              "longestRun": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16
              },
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16
              },
              "worstElapsedUs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/Contention"
    }
  ]
}
