{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "verdicts"],
  "properties": {
    "version": {"const":1},
    "verdicts": {
      "type":"array", "minItems":5, "maxItems":5,
      "items": {
        "type":"object", "additionalProperties":false,
        "required":["id","start","end","fault","clockFault"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "start":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
          "end":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
          "fault":{"type":"boolean"},
          "clockFault":{"enum":[null,"Missing","Backward"]}
        }
      }
    },
    "cases": {
      "type":"array", "minItems":4, "maxItems":4,
      "items": {
        "type":"object", "additionalProperties":false,
        "required":["id","lock","callback","returnsWhileHeld","violationRetained","returnedEvent"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "lock":{"enum":["site","violation","event"]},
          "callback":{"enum":["timer","watchdog","event"]},
          "returnsWhileHeld":{"const":true},
          "violationRetained":{"type":"boolean"},
          "returnedEvent":{"type":"boolean"}
        }
      }
    }
  }
}
