{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped Allocation Request Corpus",
  "type": "object",
  "required": [
    "cases",
    "unwindProbeBytes",
    "overflowProbeBytes"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/scope"
      }
    },
    "unwindProbeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "overflowProbeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "required": [
        "op",
        "name",
        "expectedRequestedBytes",
        "operations"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "scope"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expectedRequestedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "allocate",
                "zeroed",
                "reallocate"
              ]
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "deallocate"
            }
          }
        },
        {
          "$ref": "#/$defs/scope"
        }
      ]
    }
  }
}
