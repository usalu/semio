{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "label", "delayMs", "budgetMs", "expectedStdout", "expectedChannel"],
  "properties": {
    "version": {"const": 1},
    "label": {"type": "string", "minLength": 1},
    "delayMs": {"type": "integer", "minimum": 10000, "maximum": 12000},
    "budgetMs": {"type": "integer", "minimum": 13000, "maximum": 15000},
    "expectedStdout": {"type": "string", "minLength": 1},
    "expectedChannel": {"const": "stderr"}
  }
}
