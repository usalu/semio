{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "code", "signal", "stdout", "stderr"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "code": {"type": ["integer", "null"], "minimum": 0},
          "signal": {"type": ["string", "null"], "minLength": 1},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"}
        }
      }
    }
  }
}
