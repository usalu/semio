{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "timeoutMs",
          "settleMs",
          "expected"
        ],
        "properties": {
          "mode": {
            "enum": [
              "timeout",
              "abort",
              "stop"
            ]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 5000
          },
          "settleMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 8000
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "settled",
              "survivors",
              "unrelatedAlive",
              "reason"
            ],
            "properties": {
              "settled": {
                "const": true
              },
              "survivors": {
                "const": 0
              },
              "unrelatedAlive": {
                "const": true
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
