{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "callerCeilingMilliseconds", "progressIntervalMilliseconds", "childMilliseconds", "publicationMilliseconds", "cases"],
  "properties": {
    "version": {"const": 1},
    "callerCeilingMilliseconds": {"const": 15000},
    "progressIntervalMilliseconds": {"const": 10000},
    "childMilliseconds": {"const": 10500},
    "publicationMilliseconds": {"const": 800},
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rejectPublication", "terminal", "publishedBeforeTerminal"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rejectPublication": {"type": "boolean"},
          "terminal": {"enum": ["completed", "rejected"]},
          "publishedBeforeTerminal": {"const": true}
        }
      }
    }
  }
}
