{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Owned Captured Command Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stdout",
    "stderr",
    "status",
    "signal"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "stdout": {
      "type": "string",
      "maxLength": 16777216
    },
    "stderr": {
      "type": "string",
      "maxLength": 16777216
    },
    "status": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        {
          "type": "null"
        }
      ]
    },
    "signal": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+$",
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "anyOf": [
    {
      "properties": {
        "status": {
          "type": "integer"
        }
      }
    },
    {
      "properties": {
        "signal": {
          "type": "string"
        }
      }
    }
  ],
  "definitions": {
    "OutputOverflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "program",
        "programTruncated",
        "stream",
        "observedBytes",
        "observedLines",
        "maximumBytes",
        "maximumLines"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "output-limit"
        },
        "program": {
          "type": "string",
          "maxLength": 256
        },
        "programTruncated": {
          "type": "boolean"
        },
        "stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "observedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
