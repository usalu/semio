{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Owned Captured Command Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stdout",
    "stderr",
    "status",
    "signal"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "stdout": {
      "type": "string",
      "maxLength": 16777216
    },
    "stderr": {
      "type": "string",
      "maxLength": 16777216
    },
    "status": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        {
          "type": "null"
        }
      ]
    },
    "signal": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+$",
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "anyOf": [
    {
      "properties": {
        "status": {
          "type": "integer"
        }
      }
    },
    {
      "properties": {
        "signal": {
          "type": "string"
        }
      }
    }
  ]
}
