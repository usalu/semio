{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false, "required": ["cases"],
  "properties": { "cases": { "type": "array", "minItems": 1, "items": {
    "type": "object", "additionalProperties": false, "required": ["name", "mutation", "accepted"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "mutation": { "enum": ["none", "missing", "tamper", "extra", "junction", "hardlink"] },
      "accepted": { "type": "boolean" }
    }
  } } }
}
