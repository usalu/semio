{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native Windows Compiler Inventory",
  "definitions": { "Policy": { "const": { "maximumTotalBytes": 4294967296 } } },
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recipeSha256", "files"],
  "properties": {
    "version": { "const": 1 },
    "recipeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 12000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 180 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 268435456 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
