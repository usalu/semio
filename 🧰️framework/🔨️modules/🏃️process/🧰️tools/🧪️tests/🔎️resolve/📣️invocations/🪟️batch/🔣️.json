{
  "version": 1,
  "flags": [
    "/d",
    "/v:off",
    "/s",
    "/c"
  ],
  "maximumUtf16": 8191,
  "cases": [
    {
      "id": "plain",
      "program": "C:/tools/runner.cmd",
      "args": [
        "x",
        "package"
      ],
      "accepted": true,
      "expected": "\"C:/tools/runner.cmd ^\"x^\" ^\"package^\"\""
    },
    {
      "id": "spaces-unicode",
      "program": "C:/Program Files/Ω/runner.cmd",
      "args": [
        "x",
        "two words",
        "Grüße Ω"
      ],
      "accepted": true,
      "expected": "\"C:/Program^ Files/Ω/runner.cmd ^\"x^\" ^\"two^ words^\" ^\"Grüße^ Ω^\"\""
    },
    {
      "id": "metacharacters",
      "program": "C:/tools/runner.cmd",
      "args": [
        "x",
        "a&b|c(d)^e!f<g>h"
      ],
      "accepted": true,
      "expected": "\"C:/tools/runner.cmd ^\"x^\" ^\"a^&b^|c^(d^)^^e^!f^<g^>h^\"\""
    },
    {
      "id": "empty",
      "program": "C:/tools/runner.cmd",
      "args": [
        "x",
        ""
      ],
      "accepted": true,
      "expected": "\"C:/tools/runner.cmd ^\"x^\" ^\"^\"\""
    },
    {
      "id": "trailing-backslash",
      "program": "C:/tools/runner.cmd",
      "args": [
        "x",
        "C:\\path\\"
      ],
      "accepted": true,
      "expected": "\"C:/tools/runner.cmd ^\"x^\" ^\"C:\\path\\\\^\"\""
    },
    {
      "id": "embedded-quote",
      "program": "C:/tools/runner.cmd",
      "args": [
        "x",
        "a\"b"
      ],
      "accepted": false,
      "reason": "quote",
      "expected": null
    },
    {
      "id": "percent-expansion",
      "program": "C:/tools/runner.cmd",
      "args": [
        "x",
        "%PATH%"
      ],
      "accepted": false,
      "reason": "percent",
      "expected": null
    },
    {
      "id": "control",
      "program": "C:/tools/runner.cmd",
      "args": [
        "x",
        "line\nnext"
      ],
      "accepted": false,
      "reason": "control",
      "expected": null
    },
    {
      "id": "target-percent",
      "program": "C:/%HOME%/runner.cmd",
      "args": [
        "x"
      ],
      "accepted": false,
      "reason": "percent",
      "expected": null
    },
    {
      "id": "target-alias",
      "program": "C:/tools/runner.cmd. ",
      "args": [
        "x"
      ],
      "accepted": false,
      "reason": "target-alias",
      "expected": null
    },
    {
      "id": "line-bound",
      "program": "C:/tools/runner.cmd",
      "args": [
        "x",
        ""
      ],
      "accepted": false,
      "reason": "line-bound",
      "expected": null
    }
  ],
  "provider": "go-safe-batch"
}
