{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "failure",
          "expected"
        ],
        "properties": {
          "owner": {
            "enum": [
              "physical",
              "baseline"
            ]
          },
          "failure": {
            "enum": [
              "open",
              "before",
              "named",
              "identity",
              "retain",
              "hash",
              "buffer",
              "read",
              "short",
              "update",
              "after",
              "mutated",
              "digest",
              "none"
            ]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "opened",
              "closed",
              "retained",
              "error",
              "digest"
            ],
            "properties": {
              "opened": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "closed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "retained": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
