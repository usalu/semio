{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maximumDatabaseBytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "maximumDatabaseBytes": {
      "type": "integer",
      "minimum": 16384,
      "maximum": 1048576,
      "multipleOf": 4096
    }
  },
  "$defs": {
    "InitializationRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryCode",
        "inTransaction"
      ],
      "properties": {
        "primaryCode": {
          "const": 13
        },
        "inTransaction": {
          "const": false
        }
      }
    }
  }
}
