{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "table": "semio_resource_retirement",
        "tableSql": "CREATE TABLE semio_resource_retirement (id INTEGER PRIMARY KEY CHECK (id IN (1, 2)), after_name TEXT NOT NULL CHECK (after_name = '' OR length(after_name) = 71 AND substr(after_name, 65) = '.sqlite' AND substr(after_name, 1, 64) NOT GLOB '*[^0-9a-f]*'))",
        "rows": 2,
        "slots": {
          "resources": 1,
          "claims": 2
        }
      }
    },
    "Name": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^(?:|[a-f0-9]{64}\\.sqlite)$"
    },
    "Kind": {
      "enum": [
        "resources",
        "claims"
      ]
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "claims"
      ],
      "properties": {
        "resources": {
          "$ref": "#/definitions/Name"
        },
        "claims": {
          "$ref": "#/definitions/Name"
        }
      }
    },
    "LeasePhases": {
      "const": {
        "held": true,
        "transition": false,
        "closing": false,
        "closed": false
      }
    }
  }
}
