{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "field",
          "kind",
          "valid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "enum": [
              "cwd",
              "cacheRoot",
              "leaseDirectory"
            ]
          },
          "kind": {
            "enum": [
              "normal",
              "nul-prefix",
              "nul-suffix",
              "relative"
            ]
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
