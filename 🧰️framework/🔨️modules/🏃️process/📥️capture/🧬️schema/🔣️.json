{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.process.owned-capture/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "budgetMs", "maximumBytes", "cancelAfterMs", "reason", "status", "stdout", "stderr"],
        "properties": {
          "id": { "enum": ["nonzero", "unicode", "timeout", "cancelled", "output-limit", "spawn-error"] },
          "source": { "type": "string", "maxLength": 1024 },
          "budgetMs": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
          "cancelAfterMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000 },
          "reason": { "enum": ["exit", "timeout", "cancelled", "output-limit", "spawn-error"] },
          "status": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
          "stdout": { "type": ["string", "null"] },
          "stderr": { "type": ["string", "null"] }
        }
      }
    }
  }
}
