{
  "schema": "semio.process.wasm-build.fixture/v1",
  "policy": {
    "version": 1,
    "cwd": "/owner",
    "workspaceRoot": "/repository",
    "sourceBoundary": {
      "version": 1,
      "maxSourceBytes": 262144,
      "maxSourceFiles": 32,
      "maxActiveLines": 4000
    },
    "mode": "prototype",
    "artifactDirectory": "/captures",
    "buildDirectory": "/compiler",
    "budgetMs": 0,
    "packageName": "fixture-package",
    "bindgen": {
      "command": "wasm-bindgen",
      "args": []
    },
    "wasmPack": {
      "command": "wasm-pack",
      "args": []
    },
    "searchPath": "/selected/tools",
    "leaseDirectory": "/leases",
    "sourceOwner": "owner"
  },
  "wasmHex": "0061736d01000000",
  "wasm": [
    {
      "name": "success",
      "status": 0,
      "output": true
    },
    {
      "name": "failure",
      "status": 1,
      "output": false
    },
    {
      "name": "missing",
      "status": 0,
      "output": false
    },
    {
      "name": "threaded",
      "status": 0,
      "output": true,
      "threads": true
    },
    {
      "name": "release",
      "status": 0,
      "output": true,
      "mode": "release"
    },
    {
      "name": "refused",
      "status": 0,
      "output": false,
      "refused": true
    }
  ],
  "modePublications": [
    {
      "mode": "prototype",
      "wasmHex": "0061736d01000000"
    },
    {
      "mode": "release",
      "wasmHex": "0061736d01000000000100"
    }
  ]
}
