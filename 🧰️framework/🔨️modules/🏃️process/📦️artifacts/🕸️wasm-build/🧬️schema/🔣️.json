{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cwd",
    "mode",
    "artifactDirectory",
    "buildDirectory",
    "budgetMs",
    "packageName",
    "bindgen",
    "wasmPack",
    "searchPath",
    "leaseDirectory"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "dev",
        "ship"
      ]
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "artifactDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "buildDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "budgetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "bindgen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "args"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "wasmPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "args"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "searchPath": {
      "type": "string",
      "minLength": 1
    },
    "leaseDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    }
  },
  "$id": "https://semio.tech/framework/process/wasm-build/policy/v1",
  "$defs": {
    "Fixture": {
      "type": "object",
      "required": [
        "schema",
        "policy",
        "wasmHex",
        "wasm"
      ],
      "properties": {
        "schema": {
          "const": "semio.process.wasm-build.fixture/v1"
        },
        "policy": {
          "$ref": "#"
        },
        "wasmHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})+$"
        },
        "wasm": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "output"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "output": {
                "type": "boolean"
              },
              "threads": {
                "type": "boolean"
              },
              "mode": {
                "enum": [
                  "dev",
                  "ship"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
