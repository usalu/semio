{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cwd",
    "mode",
    "artifactDirectory",
    "buildDirectory",
    "budgetMs",
    "packageName",
    "bindgen",
    "wasmPack",
    "searchPath",
    "leaseDirectory",
    "sourceOwner",
    "workspaceRoot",
    "sourceBoundary"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "artifactDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "buildDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "budgetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "bindgen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "args"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "wasmPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "args"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "searchPath": {
      "type": "string",
      "minLength": 1
    },
    "leaseDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "sourceOwner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/|[A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "compilerConfiguration": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "sourceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maxSourceBytes",
        "maxSourceFiles",
        "maxActiveLines"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "maxSourceBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxSourceFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maxActiveLines": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$id": "https://semio.tech/framework/process/wasm-build/policy/v1",
  "definitions": {
    "PackageOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sourceOwner",
        "mode",
        "output"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sourceOwner": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/|[A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "mode": {
          "enum": [
            "prototype",
            "release"
          ]
        },
        "output": {
          "enum": [
            "dist/wasm/prototype",
            "dist/wasm/release"
          ]
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode",
            "output"
          ],
          "properties": {
            "mode": {
              "const": "prototype"
            },
            "output": {
              "const": "dist/wasm/prototype"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "mode",
            "output"
          ],
          "properties": {
            "mode": {
              "const": "release"
            },
            "output": {
              "const": "dist/wasm/release"
            }
          }
        }
      ]
    }
  }
}
