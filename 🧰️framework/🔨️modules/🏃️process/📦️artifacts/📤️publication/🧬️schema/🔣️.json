{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "files",
    "cancelReason",
    "cancellation",
    "replacement"
  ],
  "properties": {
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "cancelReason": {
      "type": "string",
      "minLength": 1
    },
    "cancellation": {
      "const": {
        "point": "identical-eof",
        "outcome": "rejected",
        "unchanged": true
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "transient",
        "permanent",
        "cancellation",
        "persistent",
        "initial"
      ],
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "transient": {
          "const": {
            "code": "EPERM",
            "failures": 2,
            "outcome": "published"
          }
        },
        "permanent": {
          "const": {
            "code": "EIO",
            "outcome": "rejected",
            "unchanged": true
          }
        },
        "cancellation": {
          "const": {
            "code": "EBUSY",
            "outcome": "rejected",
            "unchanged": true
          }
        },
        "persistent": {
          "const": {
            "code": "EPERM",
            "timeoutMs": 5000,
            "outcome": "rejected",
            "unchanged": true
          }
        },
        "initial": {
          "const": {
            "absentBefore": true,
            "code": "EPERM",
            "failures": 2,
            "outcome": "published"
          }
        }
      }
    }
  }
}
