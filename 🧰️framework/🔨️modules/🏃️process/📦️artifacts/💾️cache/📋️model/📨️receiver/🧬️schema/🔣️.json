{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false, "required": ["version", "cases"],
  "properties": {
    "version": {"const": 1},
    "cases": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "failure", "expectedNewEffects", "expectedRefusals", "expectedSiblingCompletions"],
        "properties": {
          "kind": {"enum": ["read", "replace"]},
          "failure": {"enum": ["error", "undefined"]},
          "expectedNewEffects": {"const": 0},
          "expectedRefusals": {"const": 2},
          "expectedSiblingCompletions": {"type": "integer", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
