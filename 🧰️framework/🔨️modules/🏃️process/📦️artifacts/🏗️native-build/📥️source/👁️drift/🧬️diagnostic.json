{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Running Cargo Source Digest Mismatch",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "path", "expected", "observed"],
  "properties": {
    "version": {"const": 1},
    "path": {"type": "string", "minLength": 1, "maxLength": 256},
    "expected": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
