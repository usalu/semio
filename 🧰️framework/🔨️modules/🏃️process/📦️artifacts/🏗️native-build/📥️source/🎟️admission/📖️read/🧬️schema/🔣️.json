{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "maximumBytes",
        "remainingFiles"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remainingFiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "bytes",
        "maximumBytes",
        "remainingFiles",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "regular",
            "missing",
            "symlink",
            "ancestor",
            "hardlink"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 0
        },
        "remainingFiles": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "boolean"
        }
      }
    }
  }
}
