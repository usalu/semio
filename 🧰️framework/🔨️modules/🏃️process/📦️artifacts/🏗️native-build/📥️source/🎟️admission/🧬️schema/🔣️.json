{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "maxSourceBytes",
    "maxSourceFiles",
    "maxActiveLines"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "maxSourceBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maxSourceFiles": {
      "type": "integer",
      "minimum": 1
    },
    "maxActiveLines": {
      "type": "integer",
      "minimum": 1
    }
  },
  "definitions": {
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "phase",
        "unit",
        "units",
        "packageName",
        "readOperations",
        "files",
        "bytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "phase": {
          "enum": [
            "cfg",
            "read",
            "complete"
          ]
        },
        "unit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "packageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "readOperations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "readCheckpoint": {
      "const": 8
    }
  }
}
