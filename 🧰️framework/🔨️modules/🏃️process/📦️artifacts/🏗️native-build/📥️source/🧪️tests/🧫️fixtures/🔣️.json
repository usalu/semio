{
  "version": 1,
  "cases": [
    {
      "name": "production excludes test mount",
      "cfg": [],
      "source": "#[cfg(test)] #[path = \"test.rs\"] mod tests; pub fn production() {}",
      "expected": "pub fn production() {}"
    },
    {
      "name": "feature selects module",
      "cfg": [
        "feature=engine"
      ],
      "source": "#[cfg(feature = \"engine\")] mod engine; #[cfg(not(feature = \"engine\"))] mod portable;",
      "expected": "mod engine;"
    },
    {
      "name": "nested target predicates",
      "cfg": [
        "target_arch=wasm32",
        "target_env=p2"
      ],
      "source": "#[cfg(all(target_arch = \"wasm32\", not(target_env = \"p2\")))] mod browser; #[cfg(any(test, target_env = \"p2\"))] mod guest;",
      "expected": "mod guest;"
    },
    {
      "name": "inline module inherits exclusion",
      "cfg": [],
      "source": "#[cfg(test)] mod tests { #[path = \"fixture.rs\"] mod fixture; } mod production { #[cfg(test)] mod nested; pub fn live() {} }",
      "expected": "mod production { pub fn live() {} }"
    },
    {
      "name": "cfg attribute selects literal path",
      "cfg": [
        "target_os=windows"
      ],
      "source": "#[cfg_attr(target_os = \"windows\", path = \"windows.rs\")] #[cfg_attr(not(target_os = \"windows\"), path = \"unix.rs\")] mod platform;",
      "expected": "#[path = \"windows.rs\"] mod platform;"
    },
    {
      "name": "macro_rules bodies keep metavariable cfg attributes for their expansion site",
      "cfg": [
        "unix"
      ],
      "source": "macro_rules! scoped { ($scope:meta, $name:ident) => { #[cfg($scope)] pub fn $name() {} }; } #[cfg(test)] mod tests; #[cfg(unix)] scoped!(unix, native);",
      "expected": "macro_rules! scoped { ($scope:meta, $name:ident) => { #[cfg($scope)] pub fn $name() {} }; } scoped!(unix, native);"
    },
    {
      "name": "inner file cfg excludes whole owning Source",
      "cfg": [],
      "source": "#![cfg(test)] mod missing; pub struct Inactive;",
      "expected": ""
    },
    {
      "name": "inner inline cfg excludes its owned contents",
      "cfg": [],
      "source": "mod gate { #![cfg(test)] mod missing; pub struct Inactive; } pub struct Active;",
      "expected": "mod gate { } pub struct Active;"
    },
    {
      "name": "inner cfg_attr selects active file metadata",
      "cfg": [
        "unix"
      ],
      "source": "#![cfg_attr(unix, allow(dead_code))] mod child;",
      "expected": "#![allow(dead_code)] mod child;"
    }
  ],
  "closures": [
    {
      "name": "inner attributes preserve children",
      "cfg": [],
      "entry": "lib.rs",
      "files": {
        "lib.rs": "#![allow(dead_code)] mod child; mod inline { #![allow(dead_code)] mod nested; }",
        "child.rs": "pub struct Child;",
        "inline/nested.rs": "pub struct Nested;"
      },
      "expected": [
        {
          "path": "child.rs",
          "kind": "source"
        },
        {
          "path": "inline/nested.rs",
          "kind": "source"
        },
        {
          "path": "lib.rs",
          "kind": "source"
        }
      ]
    },
    {
      "name": "embedded-first same-base source dominance",
      "cfg": [],
      "entry": "lib.rs",
      "files": {
        "lib.rs": "pub static CHILD:&str=include_str!(\"child.rs\"); #[path=\"child.rs\"] mod child;",
        "child.rs": "mod nested; pub struct Child;",
        "nested.rs": "pub struct Nested;"
      },
      "expected": [
        {
          "path": "child.rs",
          "kind": "source"
        },
        {
          "path": "lib.rs",
          "kind": "source"
        },
        {
          "path": "nested.rs",
          "kind": "source"
        }
      ]
    },
    {
      "name": "inactive inner file Source",
      "cfg": [],
      "entry": "lib.rs",
      "files": {
        "lib.rs": "#![cfg(test)] mod missing; pub struct Inactive;"
      },
      "expected": [
        {
          "path": "lib.rs",
          "kind": "source"
        }
      ]
    },
    {
      "name": "inactive inner inline Source",
      "cfg": [],
      "entry": "lib.rs",
      "files": {
        "lib.rs": "mod gate { #![cfg(test)] mod missing; pub struct Inactive; } pub struct Active;"
      },
      "expected": [
        {
          "path": "lib.rs",
          "kind": "source"
        }
      ]
    }
  ]
}
