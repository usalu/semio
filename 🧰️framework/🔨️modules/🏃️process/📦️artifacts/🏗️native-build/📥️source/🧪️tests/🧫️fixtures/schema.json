{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "closures",
    "refusals"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cfg",
          "source",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cfg": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "oracle": {
            "type": "boolean"
          }
        }
      }
    },
    "closures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cfg",
          "entry",
          "files",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cfg": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "entry": {
            "type": "string"
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "kind"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "source",
                    "embedded"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "refusals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "key",
          "values"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          }
        }
      }
    }
  }
}
