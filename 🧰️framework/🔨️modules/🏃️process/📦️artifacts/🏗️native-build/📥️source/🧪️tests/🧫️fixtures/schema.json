{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object","additionalProperties":false,"required":["version","cases"],
  "properties":{
    "version":{"const":1},
    "cases":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,"required":["name","cfg","source","expected"],
