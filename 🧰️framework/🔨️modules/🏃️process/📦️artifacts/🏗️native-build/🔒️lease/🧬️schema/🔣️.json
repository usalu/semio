{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.cargo-build/CargoBuildLeaseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "buildDirectory",
    "profile",
    "mode"
  ],
  "properties": {
    "buildDirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "mode": {
      "const": "exclusive"
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "namespace": "semio.cargo.build-lease/v1",
        "directory": "agents/resource-leases",
        "defaultProfile": "dev",
        "profileDirectories": {
          "dev": "debug",
          "test": "debug",
          "bench": "release"
        },
        "pollMs": 1000
      }
    }
  }
}
