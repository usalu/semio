{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.cargo-build/CargoBuildLeaseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "buildDirectory",
    "profile",
    "mode"
  ],
  "properties": {
    "buildDirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "mode": {
      "const": "exclusive"
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "namespace": "semio.cargo.build-lease/v1",
        "directory": "agents/resource-leases",
        "defaultProfile": "dev",
        "profileDirectories": {
          "dev": "debug",
          "test": "debug",
          "bench": "release"
        },
        "pollMs": 1000
      }
    }
  },
  "$defs": {
    "PortableCorpusV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "identities",
        "hostileArgs",
        "cases"
      ],
      "properties": {
        "schema": {
          "const": "repo.cargo-build-lease.portable/v1"
        },
        "identities": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "args",
              "profile"
            ],
            "properties": {
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "profile": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              }
            }
          }
        },
        "hostileArgs": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "first",
              "second",
              "action"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "first": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "second": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "action": {
                "enum": [
                  "parallel",
                  "release-first",
                  "cancel-second",
                  "kill-first"
                ]
              }
            }
          }
        }
      }
    }
  }
}
