{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.cargo-build/CargoLeaseCasesV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identities",
    "hostileArgs",
    "cases",
    "maximumWaitMilliseconds",
    "fairness",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "repo.cargo-build-lease.portable/v1"
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "args",
          "profile"
        ],
        "properties": {
          "args": {
            "$ref": "#/definitions/args"
          },
          "profile": {
            "$ref": "#/definitions/profile"
          }
        }
      }
    },
    "hostileArgs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/args"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "first",
          "second",
          "firstAccess",
          "secondAccess",
          "action"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "first": {
            "$ref": "#/definitions/profile"
          },
          "second": {
            "$ref": "#/definitions/profile"
          },
          "firstAccess": {
            "enum": [
              "compile",
              "maintain"
            ]
          },
          "secondAccess": {
            "enum": [
              "compile",
              "maintain"
            ]
          },
          "action": {
            "enum": [
              "parallel",
              "release-first",
              "cancel-second",
              "kill-first"
            ]
          }
        }
      }
    },
    "maximumWaitMilliseconds": {
      "type": "integer",
      "minimum": 1
    },
    "fairness": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "profile",
          "writerAccess"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "$ref": "#/definitions/profile"
          },
          "writerAccess": {
            "enum": [
              "maintain",
              "store-maintain"
            ]
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "firstBuild",
          "firstTarget",
          "secondBuild",
          "secondTarget",
          "secondAccess",
          "action"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "firstBuild": {
            "enum": [
              "b",
              "t"
            ]
          },
          "firstTarget": {
            "enum": [
              "b",
              "t"
            ]
          },
          "secondBuild": {
            "enum": [
              "b",
              "t"
            ]
          },
          "secondTarget": {
            "enum": [
              "b",
              "t"
            ]
          },
          "secondAccess": {
            "enum": [
              "compile",
              "maintain",
              "store-maintain"
            ]
          },
          "action": {
            "enum": [
              "parallel",
              "release-first",
              "cancel-second"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  }
}
