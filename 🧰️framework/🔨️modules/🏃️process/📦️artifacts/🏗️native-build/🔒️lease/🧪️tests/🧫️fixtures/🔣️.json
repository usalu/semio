{
  "schema": "repo.cargo-build-lease.portable/v1",
  "identities": [
    {
      "args": [],
      "profile": "debug"
    },
    {
      "args": [
        "--release"
      ],
      "profile": "release"
    },
    {
      "args": [
        "--profile",
        "wasm-prototype"
      ],
      "profile": "wasm-prototype"
    },
    {
      "args": [
        "--profile=wasm-release"
      ],
      "profile": "wasm-release"
    },
    {
      "args": [
        "--profile",
        "test"
      ],
      "profile": "debug"
    },
    {
      "args": [
        "--profile",
        "bench"
      ],
      "profile": "release"
    }
  ],
  "hostileArgs": [
    [
      "--profile"
    ],
    [
      "--profile",
      "../escape"
    ],
    [
      "--profile",
      "dev",
      "--release"
    ],
    [
      "--profile",
      "dev",
      "--profile",
      "wasm-prototype"
    ]
  ],
  "cases": [
    {
      "name": "same-profile-builders-queued",
      "first": "prototype",
      "second": "prototype",
      "action": "release-first",
      "firstAccess": "compile",
      "secondAccess": "compile"
    },
    {
      "name": "same-profile-maintenance-exclusion",
      "first": "prototype",
      "second": "prototype",
      "firstAccess": "maintain",
      "secondAccess": "compile",
      "action": "release-first"
    },
    {
      "name": "native-profile-independent",
      "first": "wasm-prototype",
      "second": "dev",
      "action": "parallel",
      "firstAccess": "compile",
      "secondAccess": "compile"
    },
    {
      "name": "release-profile-independent",
      "first": "wasm-prototype",
      "second": "wasm-release",
      "action": "parallel",
      "firstAccess": "compile",
      "secondAccess": "compile"
    },
    {
      "name": "cancelled-waiter",
      "first": "wasm-prototype",
      "second": "wasm-prototype",
      "action": "cancel-second",
      "firstAccess": "maintain",
      "secondAccess": "compile"
    },
    {
      "name": "crashed-holder",
      "first": "wasm-prototype",
      "second": "wasm-prototype",
      "action": "kill-first",
      "firstAccess": "maintain",
      "secondAccess": "compile"
    }
  ],
  "maximumWaitMilliseconds": 3000,
  "fairness": [
    {
      "name": "profile-writer-barrier",
      "profile": "prototype",
      "writerAccess": "maintain"
    },
    {
      "name": "store-writer-barrier",
      "profile": "prototype",
      "writerAccess": "store-maintain"
    }
  ],
  "targets": [
    {
      "name": "same-store-distinct-directories",
      "firstBuild": "b",
      "firstTarget": "t",
      "secondBuild": "b",
      "secondTarget": "t",
      "secondAccess": "compile",
      "action": "release-first"
    },
    {
      "name": "target-profile-maintenance",
      "firstBuild": "b",
      "firstTarget": "t",
      "secondBuild": "t",
      "secondTarget": "t",
      "secondAccess": "maintain",
      "action": "release-first"
    },
    {
      "name": "target-store-maintenance",
      "firstBuild": "b",
      "firstTarget": "t",
      "secondBuild": "t",
      "secondTarget": "t",
      "secondAccess": "store-maintain",
      "action": "release-first"
    },
    {
      "name": "target-maintenance-cancellation",
      "firstBuild": "b",
      "firstTarget": "t",
      "secondBuild": "t",
      "secondTarget": "t",
      "secondAccess": "store-maintain",
      "action": "cancel-second"
    }
  ]
}
