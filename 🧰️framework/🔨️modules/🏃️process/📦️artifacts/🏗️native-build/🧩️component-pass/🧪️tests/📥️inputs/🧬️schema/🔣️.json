{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "arguments",
          "cancel"
        ],
        "properties": {
          "kind": {
            "enum": [
              "unit-graph",
              "batch",
              "job",
              "cancelled"
            ]
          },
          "arguments": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "cancel": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
