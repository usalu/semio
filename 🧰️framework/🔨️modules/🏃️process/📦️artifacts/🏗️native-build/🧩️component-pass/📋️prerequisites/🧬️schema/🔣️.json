{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "maxItems": 256,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "after"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9._-]+$"
      },
      "after": {
        "type": "array",
        "maxItems": 256,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 5,
          "maxLength": 132,
          "pattern": "^job:[a-zA-Z0-9._-]+$"
        }
      }
    }
  }
}
