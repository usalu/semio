{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Capacity": {
      "enum": [
        "single",
        "available",
        "whole-host",
        "cleanup"
      ]
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity",
        "held",
        "host"
      ],
      "properties": {
        "capacity": {
          "$ref": "#/definitions/Capacity"
        },
        "held": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "host": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "CompilationLifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "compileBusy",
        "consumerFree",
        "inputHeld",
        "cpuRetired",
        "reacquired",
        "inputFree",
        "outputHeld",
        "outputFree",
        "childJoined",
        "consumerDrained",
        "bytesExact"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "compileBusy": {
          "type": "boolean"
        },
        "consumerFree": {
          "type": "boolean"
        },
        "inputHeld": {
          "type": "boolean"
        },
        "cpuRetired": {
          "type": "boolean"
        },
        "reacquired": {
          "type": "boolean"
        },
        "inputFree": {
          "type": "boolean"
        },
        "outputHeld": {
          "type": "boolean"
        },
        "outputFree": {
          "type": "boolean"
        },
        "childJoined": {
          "type": "boolean"
        },
        "consumerDrained": {
          "type": "boolean"
        },
        "bytesExact": {
          "type": "boolean"
        }
      }
    },
    "InputFailureKind": {
      "enum": [
        "input-error",
        "input-undefined"
      ]
    }
  }
}
