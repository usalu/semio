{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "opt_level",
    "lto",
    "codegen_backend",
    "codegen_units",
    "debuginfo",
    "split_debuginfo",
    "debug_assertions",
    "overflow_checks",
    "rpath",
    "incremental",
    "panic",
    "strip"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "opt_level": {
      "enum": [
        "0",
        "1",
        "2",
        "3",
        "s",
        "z"
      ]
    },
    "lto": {
      "enum": [
        "false",
        "off",
        "thin",
        "fat",
        "true"
      ]
    },
    "codegen_backend": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "codegen_units": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 256
    },
    "debuginfo": {
      "enum": [
        null,
        0,
        1,
        2,
        "none",
        "limited",
        "full",
        "line-tables-only",
        "line-directives-only"
      ]
    },
    "split_debuginfo": {
      "enum": [
        null,
        "off",
        "packed",
        "unpacked"
      ]
    },
    "debug_assertions": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "overflow_checks": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "rpath": {
      "type": "boolean"
    },
    "incremental": {
      "type": "boolean"
    },
    "panic": {
      "enum": [
        "abort",
        "unwind"
      ]
    },
    "strip": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolved"
          ],
          "properties": {
            "resolved": {
              "oneOf": [
                {
                  "const": "None"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "Named"
                  ],
                  "properties": {
                    "Named": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deferred"
          ],
          "properties": {
            "deferred": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "trim_paths": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {
        "enum": [
          "diagnostics",
          "macro",
          "object"
        ]
      }
    }
  },
  "definitions": {
    "SchedulerSuffix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "-Zthreads=1"
      }
    }
  }
}
