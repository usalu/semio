{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "execution",
    "planning",
    "forwardedArguments",
    "defaultBinary"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "execution": {
      "const": "run"
    },
    "planning": {
      "const": "build"
    },
    "forwardedArguments": {
      "const": "exclude"
    },
    "defaultBinary": {
      "const": "metadata"
    }
  }
}
