{
  "version": 1,
  "cases": [
    {
      "id": "owned-present",
      "source": "pub static V:&str=env!(\"CARGO_PKG_DESCRIPTION\");",
      "cfg": [],
      "environment": {
        "CARGO_PKG_DESCRIPTION": "description"
      },
      "expected": {
        "CARGO_PKG_DESCRIPTION": "description"
      }
    },
    {
      "id": "owned-absent",
      "source": "pub static V:Option<&str>=option_env!(\"RUST_MIN_STACK\");",
      "cfg": [],
      "environment": {},
      "expected": {
        "RUST_MIN_STACK": null
      }
    },
    {
      "id": "raw-comment",
      "source": "// option_env!(\"TMPDIR\")\n/* env!(\"TEMP\") */\npub static V:&str=env!(r#\"CARGO_PKG_NAME\"#);",
      "cfg": [],
      "environment": {
        "CARGO_PKG_NAME": "leaf"
      },
      "expected": {
        "CARGO_PKG_NAME": "leaf"
      }
    },
    {
