{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "cfg",
    "environment"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "cfg": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
