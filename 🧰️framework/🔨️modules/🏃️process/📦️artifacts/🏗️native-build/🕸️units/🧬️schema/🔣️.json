{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "units",
    "roots",
    "workspaceRoot"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "packageId",
          "packageName",
          "manifest",
          "sourceRoot",
          "entry",
          "name",
          "kind",
          "operation",
          "platform",
          "roles",
          "profileName",
          "profileDigest",
          "compilerArguments",
          "features",
          "dependencies",
          "boundary",
          "support",
          "provenance",
          "sourceInputs",
          "compiler",
          "compilerCfg",
          "compilationDigest",
          "configurationDigest",
          "compilerFlags",
          "planningDigest",
          "compilerEnvironment",
          "compilerProfile",
          "packageVersion",
          "edition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "packageName": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "sourceRoot": {
            "type": [
              "string",
              "null"
            ]
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "library",
              "binary",
              "proc-macro",
              "build-script",
              "build-script-run",
              "test",
              "documentation"
            ]
          },
          "operation": {
            "enum": [
              "build",
              "check",
              "test",
              "doc",
              "doctest",
              "run-custom-build"
            ]
          },
          "platform": {
            "type": [
              "string",
              "null"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "enum": [
                "host",
                "target"
              ]
            },
            "uniqueItems": true
          },
          "profileName": {
            "type": "string",
            "minLength": 1
          },
          "profileDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "compilerArguments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "externName",
                "public",
                "noprelude"
              ],
              "properties": {
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "externName": {
                  "type": "string",
                  "minLength": 1
                },
                "public": {
                  "type": "boolean"
                },
                "noprelude": {
                  "type": "boolean"
                }
              }
            },
            "uniqueItems": true
          },
          "boundary": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "maxSourceBytes",
                  "maxSourceFiles",
                  "maxActiveLines"
                ],
                "properties": {
                  "maxSourceBytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxSourceFiles": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxActiveLines": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "support": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reason"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "supported",
                  "unsupported"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "identity"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "workspace",
                  "registry",
                  "git",
                  "external-path"
                ]
              },
              "identity": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "sourceInputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "compiler": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "program",
                  "digest",
                  "hostTriple"
                ],
                "properties": {
                  "program": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "hostTriple": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]+$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "compilerCfg": {
            "anyOf": [
              {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "compilationDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "configurationDigest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "compilerFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "planningDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "compilerEnvironment": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "title": "Cargo Crate Compile Environment",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "CARGO",
                  "CARGO_MANIFEST_DIR",
                  "CARGO_MANIFEST_PATH",
                  "CARGO_PKG_VERSION",
                  "CARGO_PKG_VERSION_MAJOR",
                  "CARGO_PKG_VERSION_MINOR",
                  "CARGO_PKG_VERSION_PATCH",
                  "CARGO_PKG_VERSION_PRE",
                  "CARGO_PKG_AUTHORS",
                  "CARGO_PKG_NAME",
                  "CARGO_PKG_DESCRIPTION",
                  "CARGO_PKG_HOMEPAGE",
                  "CARGO_PKG_REPOSITORY",
                  "CARGO_PKG_LICENSE",
                  "CARGO_PKG_LICENSE_FILE",
                  "CARGO_PKG_RUST_VERSION",
                  "CARGO_PKG_README",
                  "CARGO_CRATE_NAME",
                  "CARGO_BIN_NAME",
                  "OUT_DIR",
                  "CARGO_PRIMARY_PACKAGE",
                  "CARGO_TARGET_TMPDIR"
                ],
                "properties": {
                  "CARGO": {
                    "type": "string"
                  },
                  "CARGO_MANIFEST_DIR": {
                    "type": "string"
                  },
                  "CARGO_MANIFEST_PATH": {
                    "type": "string"
                  },
                  "CARGO_PKG_VERSION": {
                    "type": "string"
                  },
                  "CARGO_PKG_VERSION_MAJOR": {
                    "type": "string"
                  },
                  "CARGO_PKG_VERSION_MINOR": {
                    "type": "string"
                  },
                  "CARGO_PKG_VERSION_PATCH": {
                    "type": "string"
                  },
                  "CARGO_PKG_VERSION_PRE": {
                    "type": "string"
                  },
                  "CARGO_PKG_AUTHORS": {
                    "type": "string"
                  },
                  "CARGO_PKG_NAME": {
                    "type": "string"
                  },
                  "CARGO_PKG_DESCRIPTION": {
                    "type": "string"
                  },
                  "CARGO_PKG_HOMEPAGE": {
                    "type": "string"
                  },
                  "CARGO_PKG_REPOSITORY": {
                    "type": "string"
                  },
                  "CARGO_PKG_LICENSE": {
                    "type": "string"
                  },
                  "CARGO_PKG_LICENSE_FILE": {
                    "type": "string"
                  },
                  "CARGO_PKG_RUST_VERSION": {
                    "type": "string"
                  },
                  "CARGO_PKG_README": {
                    "type": "string"
                  },
                  "CARGO_CRATE_NAME": {
                    "type": "string"
                  },
                  "CARGO_BIN_NAME": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "OUT_DIR": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "CARGO_PRIMARY_PACKAGE": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "CARGO_TARGET_TMPDIR": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "PATH": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "SystemRoot": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "WINDIR": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "PATHEXT": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "RUSTUP_HOME": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "RUSTC_BOOTSTRAP": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "RUST_MIN_STACK": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "compilerProfile": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "opt_level",
              "lto",
              "codegen_backend",
              "codegen_units",
              "debuginfo",
              "split_debuginfo",
              "debug_assertions",
              "overflow_checks",
              "rpath",
              "incremental",
              "panic",
              "strip"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "opt_level": {
                "enum": [
                  "0",
                  "1",
                  "2",
                  "3",
                  "s",
                  "z"
                ]
              },
              "lto": {
                "enum": [
                  "false",
                  "off",
                  "thin",
                  "fat",
                  "true"
                ]
              },
              "codegen_backend": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 128
              },
              "codegen_units": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 256
              },
              "debuginfo": {
                "enum": [
                  null,
                  0,
                  1,
                  2,
                  "none",
                  "limited",
                  "full",
                  "line-tables-only",
                  "line-directives-only"
                ]
              },
              "split_debuginfo": {
                "enum": [
                  null,
                  "off",
                  "packed",
                  "unpacked"
                ]
              },
              "debug_assertions": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "overflow_checks": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "rpath": {
                "type": "boolean"
              },
              "incremental": {
                "type": "boolean"
              },
              "panic": {
                "enum": [
                  "abort",
                  "unwind"
                ]
              },
              "strip": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "resolved"
                    ],
                    "properties": {
                      "resolved": {
                        "oneOf": [
                          {
                            "const": "None"
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "Named"
                            ],
                            "properties": {
                              "Named": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "deferred"
                    ],
                    "properties": {
                      "deferred": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    }
                  }
                ]
              },
              "trim_paths": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 3,
                "items": {
                  "enum": [
                    "diagnostics",
                    "macro",
                    "object"
                  ]
                }
              }
            },
            "definitions": {
              "SchedulerSuffix": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "const": "-Zthreads=1"
                }
              }
            }
          },
          "packageVersion": {
            "type": "string",
            "minLength": 1
          },
          "edition": {
            "enum": [
              "2015",
              "2018",
              "2021",
              "2024"
            ]
          }
        }
      },
      "uniqueItems": true
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
