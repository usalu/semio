    {
      "id": "interleaved-stderr-is-not-machine-data",
      "capture": {
        "stdout": "{\n \"build\": {\"jobs\": 1}\n}\n",
        "stderr": "warning: before JSON\nwarning: between JSON rows\nwarning: after JSON\n",
        "status": 0,
        "signal": null
      },
      "accepted": true,
      "value": {
        "build": {
          "jobs": 1
        }
      }
    },
    {
