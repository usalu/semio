      "accepted": true,
      "value": {
        "build": {
          "jobs": 1
        }
      }
    },
    {
      "id": "pretty-success-warning",
      "capture": {
        "stdout": "{\n \"build\": {\"jobs\": 1}\n}\n",
        "stderr": "warning: fixture diagnostic\n",
        "status": 0,
        "signal": null
      },
      "accepted": true,
      "value": {
        "build": {
          "jobs": 1
        }
      }
    },
    {
      "id": "stderr-object-is-not-data",
      "capture": {
        "stdout": "",
