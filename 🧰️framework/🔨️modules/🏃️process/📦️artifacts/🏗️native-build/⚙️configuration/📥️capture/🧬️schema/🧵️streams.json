{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chunks",
          "terminal",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stream",
                "bytes"
              ],
              "properties": {
                "stream": {
                  "enum": [
                    "stdout",
                    "stderr"
                  ]
                },
                "bytes": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                }
              }
            }
          },
          "terminal": {
            "enum": [
              "success",
              "nonzero",
              "cancelled",
              "output-limit"
            ]
          },
          "accepted": {
            "const": false
          }
        }
      }
    }
  }
}
