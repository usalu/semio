{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capture",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stdout",
              "stderr",
              "status",
              "signal"
            ],
            "properties": {
              "stdout": {
                "type": "string"
              },
              "stderr": {
                "type": "string"
              },
              "status": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "signal": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "accepted": {
            "type": "boolean"
          },
          "value": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "accepted": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
