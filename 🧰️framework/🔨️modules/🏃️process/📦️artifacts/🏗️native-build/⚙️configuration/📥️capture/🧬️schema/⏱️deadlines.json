{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "remaining",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "remaining": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "accepted": {
            "type": "boolean"
          },
          "milliseconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "accepted": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "milliseconds"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "milliseconds"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
