{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "substitutions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "threads",
          "outcome",
          "releaseFails",
          "settlement",
          "trace"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "tests",
              "lint",
              "wasm"
            ]
          },
          "threads": {
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "success",
              "undefined",
              "frozen",
              "cancelled",
              "cleanup"
            ]
          },
          "releaseFails": {
            "type": "boolean"
          },
          "trace": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32
          },
          "settlement": {
            "enum": [
              "settles",
              "rejects"
            ]
          }
        }
      }
    },
    "substitutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "occurrence",
          "port"
        ],
        "properties": {
          "kind": {
            "enum": [
              "tests",
              "lint",
              "wasm"
            ]
          },
          "occurrence": {
            "type": "integer",
            "minimum": 0
          },
          "port": {
            "enum": [
              "planning",
              "lease",
              "admit",
              "run"
            ]
          }
        }
      }
    }
  }
}
