{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "threads",
          "outcome",
          "releaseFails",
          "trace"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "tests",
              "lint",
              "wasm"
            ]
          },
          "threads": {
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "success",
              "undefined",
              "frozen",
              "cancelled",
              "cleanup"
            ]
          },
          "releaseFails": {
            "type": "boolean"
          },
          "trace": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32
          }
        }
      }
    }
  }
}
