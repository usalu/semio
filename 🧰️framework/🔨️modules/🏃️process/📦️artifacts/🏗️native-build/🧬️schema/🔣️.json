{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cwd",
    "buildDirectory",
    "leaseDirectory",
    "captureDirectory",
    "budgetMs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "buildDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "leaseDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "captureDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "budgetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    }
  },
  "$id": "https://semio.tech/framework/process/native-build/policy/v1",
  "$defs": {
    "Fixture": {
      "type": "object",
      "required": [
        "schema",
        "policy",
        "files",
        "vectors",
        "cargo"
      ],
      "properties": {
        "schema": {
          "const": "semio.process.cargo-artifacts.fixture/v1"
        },
        "policy": {
          "$ref": "#"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hex"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "hex": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})+$"
              }
            }
          }
        },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "mode",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "success",
                  "wait",
                  "fail",
                  "empty"
                ]
              },
              "accepted": {
                "type": "boolean"
              }
            }
          }
        },
        "cargo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "stdout"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "stdout": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
