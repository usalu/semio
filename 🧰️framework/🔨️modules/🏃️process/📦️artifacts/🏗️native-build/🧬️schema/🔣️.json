{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cwd",
    "buildDirectory",
    "leaseDirectory",
    "captureDirectory",
    "budgetMs",
    "mode"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "buildDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "leaseDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "captureDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    },
    "budgetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "mode": {
      "enum": [
        "prototype",
        "release"
      ]
    }
  },
  "$id": "https://semio.tech/framework/process/native-build/policy/v1"
}
