{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/native-build/observation-output/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "directory"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
    }
  }
}
