{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/native-storage/v1",
  "definitions": {
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "capacityBytes",
        "maximumWorkspaceBytes",
        "maximumArtifactBytes",
        "leaseDirectory"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumWorkspaceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumArtifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leaseDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "Allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "kind",
        "bytes",
        "phase"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "compiler-workspace",
            "compiler-state",
            "artifact-publication",
            "artifact-restore",
            "persistent-state"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "phase": {
          "enum": [
            "reserved",
            "committed",
            "retiring"
          ]
        },
        "child": {
          "$ref": "#/definitions/ChildRequest"
        }
      }
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sequence",
        "allocations"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allocations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Allocation"
          }
        }
      }
    },
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "allocation"
          ],
          "properties": {
            "type": {
              "const": "reserved"
            },
            "allocation": {
              "$ref": "#/definitions/Allocation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "expectedSequence",
            "allocation",
            "bytes"
          ],
          "properties": {
            "type": {
              "const": "rebudgeted"
            },
            "expectedSequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "allocation": {
              "$ref": "#/definitions/Allocation"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "committed",
                "retiring",
                "retired"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "state"
          ],
          "properties": {
            "type": {
              "const": "checkpoint"
            },
            "state": {
              "$ref": "#/definitions/State"
            }
          }
        }
      ]
    },
    "ImageMaintenanceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "wait"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "wait": {
          "type": "boolean"
        }
      }
    },
    "ImageMaintenanceResult": {
      "description": "Closed nonblocking admission or the exact original maintenance callback value.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquired"
          ],
          "properties": {
            "acquired": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquired",
            "value"
          ],
          "properties": {
            "acquired": {
              "const": true
            },
            "value": {}
          }
        }
      ]
    },
    "ImageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystemBytes",
        "maximumPhysicalBytes"
      ],
      "properties": {
        "filesystemBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 9007199254740991
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 34603008,
          "maximum": 9007199254740991
        }
      }
    },
    "ImageProtocol": {
      "const": {
        "format": "UDIF",
        "filesystem": "Case-sensitive HFS+",
        "minimumFilesystemBytes": 33554432,
        "unitBytes": 1048576,
        "journalMaximumBytes": 1048576,
        "mountDirectory": "m",
        "journalCheckpointBytes": 524288,
        "journalCheckpointFile": "storage-checkpoint.jsonl",
        "journalProjectionCacheEntries": 8,
        "informationMaximumBytes": 1048576,
        "informationMaximumLines": 32768,
        "publicationDirectory": ".publication"
      }
    },
    "ImageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "filesystemBytes",
        "maximumPhysicalBytes",
        "dev",
        "ino",
        "size",
        "mountDirectory"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "filesystemBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "dev": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mountDirectory": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/process/artifacts/native-build/storage/platform/contract/mount/component.json"
        }
      }
    },
    "ImageMaintenanceCustody": {
      "description": "Disposition data alone grants no authority; kernel-ex carries a privately issued live proof.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "proof"
          ],
          "properties": {
            "kind": {
              "const": "kernel-ex"
            },
            "proof": {
              "type": "object",
              "additionalProperties": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "fresh-private"
            }
          }
        }
      ]
    },
    "ImageRetirementExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptSha256",
        "dev",
        "ino",
        "size",
        "allocatedBytes"
      ],
      "properties": {
        "receiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "allocatedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ImageRetirementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "wait"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "wait": {
          "type": "boolean"
        },
        "expectedImage": {
          "$ref": "#/definitions/ImageRetirementExpectation"
        }
      }
    },
    "RebudgetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "expectedSequence",
        "allocation",
        "bytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "expectedSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allocation": {
          "$ref": "#/definitions/Allocation"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "CleanupProtocol": {
      "const": {
        "version": 1,
        "maximumPending": 32,
        "journalMaximumBytes": 1048576,
        "chunkBytes": 65536,
        "maximumReadWork": 32
      }
    },
    "ParentFactoryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mode",
        "parent",
        "custody",
        "stopped",
        "accepted",
        "mutate"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mode": {
          "enum": [
            "body",
            "maintenance"
          ]
        },
        "parent": {
          "enum": [
            "actual",
            "copy"
          ]
        },
        "custody": {
          "enum": [
            "actual",
            "copy",
            "none"
          ]
        },
        "stopped": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        },
        "mutate": {
          "type": "boolean"
        }
      }
    },
    "ParentLifetimeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "body",
        "close",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "body": {
          "enum": [
            "value",
            "undefined",
            "frozen"
          ]
        },
        "close": {
          "enum": [
            "ok",
            "frozen"
          ]
        },
        "expected": {
          "enum": [
            "value",
            "undefined",
            "frozen",
            "close"
          ]
        }
      }
    },
    "DisposableChildCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "body",
        "terminal",
        "binding",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "body": {
          "enum": [
            "value",
            "undefined",
            "frozen",
            "cancel",
            "accepted-failure",
            "cancel-ex",
            "cancel-ready",
            "cancel-sh",
            "cancel-prebody"
          ]
        },
        "terminal": {
          "enum": [
            "ok",
            "busy",
            "parent-changed",
            "failure",
            "deadline",
            "loan-copy",
            "lease-substitution",
            "loan-replay"
          ]
        },
        "binding": {
          "enum": [
            "actual",
            "none",
            "foreign",
            "duplicate",
            "extra"
          ]
        },
        "expected": {
          "enum": [
            "value",
            "undefined",
            "frozen",
            "cancel",
            "accepted-failure",
            "cleanup",
            "aggregate"
          ]
        }
      }
    },
    "DisposableTransitionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "states",
        "fault",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "enum": [
              "mounted",
              "underlying",
              "foreign"
            ]
          }
        },
        "fault": {
          "enum": [
            "none",
            "backing",
            "receipt",
            "parent",
            "underlying"
          ]
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "ChildRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "allocation",
        "parentIdentity",
        "directory",
        "filesystemBytes",
        "maximumPhysicalBytes",
        "policySha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "allocation": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "parentIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "filesystemBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "ChildDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "filesystemBytes",
        "maximumPhysicalBytes",
        "policySha256"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "filesystemBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
