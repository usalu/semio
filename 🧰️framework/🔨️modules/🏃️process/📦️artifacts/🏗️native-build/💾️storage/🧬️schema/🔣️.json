{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/native-storage/v1",
  "definitions": {
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "root",
        "capacityBytes",
        "maximumWorkspaceBytes",
        "maximumArtifactBytes",
        "leaseDirectory"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumWorkspaceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumArtifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leaseDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "Allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "kind",
        "bytes",
        "phase"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "compiler-workspace",
            "compiler-state",
            "artifact-publication",
            "artifact-restore"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "phase": {
          "enum": [
            "reserved",
            "committed",
            "retiring"
          ]
        }
      }
    },
    "State": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sequence",
        "allocations"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allocations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Allocation"
          }
        }
      }
    },
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "allocation"
          ],
          "properties": {
            "type": {
              "const": "reserved"
            },
            "allocation": {
              "$ref": "#/definitions/Allocation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "enum": [
                "committed",
                "retiring",
                "retired"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "state"
          ],
          "properties": {
            "type": {
              "const": "checkpoint"
            },
            "state": {
              "$ref": "#/definitions/State"
            }
          }
        }
      ]
    },
    "ImageMaintenanceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "wait"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "wait": {
          "type": "boolean"
        }
      }
    },
    "ImageMaintenanceResult": {
      "description": "Closed nonblocking admission or the exact original maintenance callback value.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquired"
          ],
          "properties": {
            "acquired": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquired",
            "value"
          ],
          "properties": {
            "acquired": {
              "const": true
            },
            "value": {}
          }
        }
      ]
    },
    "ImageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystemBytes",
        "maximumPhysicalBytes"
      ],
      "properties": {
        "filesystemBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 9007199254740991
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 34603008,
          "maximum": 9007199254740991
        }
      }
    },
    "ImageProtocol": {
      "const": {
        "format": "UDIF",
        "filesystem": "Case-sensitive HFS+",
        "minimumFilesystemBytes": 33554432,
        "unitBytes": 1048576,
        "journalMaximumBytes": 1048576,
        "mountDirectory": "m",
        "journalCheckpointBytes": 524288,
        "journalCheckpointFile": "storage-checkpoint.jsonl",
        "journalProjectionCacheEntries": 8,
        "informationMaximumBytes": 1048576,
        "informationMaximumLines": 32768
      }
    },
    "ImageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "filesystemBytes",
        "maximumPhysicalBytes",
        "dev",
        "ino",
        "size"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "filesystemBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "dev": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "ImageMaintenanceCustody": {
      "description": "Disposition data alone grants no authority; kernel-ex carries a privately issued live proof.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "proof"
          ],
          "properties": {
            "kind": {
              "const": "kernel-ex"
            },
            "proof": {
              "type": "object",
              "additionalProperties": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "fresh-private"
            }
          }
        }
      ]
    },
    "ImageRetirementExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptSha256",
        "dev",
        "ino",
        "size",
        "allocatedBytes"
      ],
      "properties": {
        "receiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "allocatedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ImageRetirementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "wait"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "wait": {
          "type": "boolean"
        },
        "expectedImage": {
          "$ref": "#/definitions/ImageRetirementExpectation"
        }
      }
    }
  }
}
