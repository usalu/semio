{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 4,
  "maxItems": 4,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "requests",
      "accepted"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "requests": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "enum": [
            "before",
            "inside",
            "concurrent",
            "after"
          ]
        }
      },
      "accepted": {
        "type": "array",
        "minItems": 1,
        "maxItems": 2,
        "items": {
          "type": "boolean"
        }
      }
    }
  }
}
