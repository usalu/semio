{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "receipt",
      "publish",
      "events",
      "pending",
      "funding"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "receipt": {
        "enum": [
          "stale",
          "current",
          "absent",
          "unreadable"
        ]
      },
      "publish": {
        "enum": [
          "ok",
          "refuse"
        ]
      },
      "events": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "enum": [
            "authenticate",
            "read",
            "publish",
            "reader",
            "pending",
            "funding-observe",
            "parent",
            "prepare",
            "retire",
            "reconcile"
          ]
        }
      },
      "pending": {
        "enum": [
          "absent",
          "present",
          "unreadable"
        ]
      },
      "funding": {
        "enum": [
          "old",
          "current",
          "reserved",
          "settled-marker-old"
        ]
      }
    }
  }
}
