{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "authored",
      "requested",
      "backing",
      "allocated",
      "physical",
      "identity",
      "custody",
      "accept"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "authored": {
        "type": "integer",
        "minimum": 1
      },
      "requested": {
        "type": "integer",
        "minimum": 1
      },
      "backing": {
        "type": "integer",
        "minimum": 1
      },
      "allocated": {
        "type": "integer",
        "minimum": 1
      },
      "physical": {
        "type": "integer",
        "minimum": 1
      },
      "identity": {
        "type": "boolean"
      },
      "custody": {
        "type": "boolean"
      },
      "accept": {
        "type": "boolean"
      }
    }
  }
}
