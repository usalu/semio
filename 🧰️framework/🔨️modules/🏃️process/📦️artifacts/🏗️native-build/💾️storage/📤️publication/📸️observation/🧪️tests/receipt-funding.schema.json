{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 9,
  "maxItems": 9,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "receipt",
      "live",
      "sameScope",
      "action",
      "pending",
      "files",
      "bytes",
      "accept"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "receipt": {
        "type": "boolean"
      },
      "live": {
        "type": "boolean"
      },
      "sameScope": {
        "type": "boolean"
      },
      "pending": {
        "type": "boolean"
      },
      "files": {
        "type": "boolean"
      },
      "accept": {
        "type": "boolean"
      },
      "action": {
        "enum": [
          "retain-allocation-payload",
          "retire-allocation"
        ]
      },
      "bytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9
      }
    }
  }
}
