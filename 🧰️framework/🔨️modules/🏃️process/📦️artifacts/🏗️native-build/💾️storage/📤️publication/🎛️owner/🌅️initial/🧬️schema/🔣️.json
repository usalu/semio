{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "Protocol": {
      "const": {
        "version": 1,
        "platform": "darwin",
        "baseRoles": [
          ".publication",
          "fixed.dmg",
          "image.json",
          "m"
        ],
        "metadataRoles": [
          "intent.json",
          "receipt.json"
        ],
        "maximumMetadataBytes": 4096,
        "maximumMetadataEntries": 2,
        "namespaceMode": 448,
        "metadataMode": 384,
        "maximumInformationBytes": 1048576,
        "maximumInformationLines": 32768,
        "maximumImages": 4096,
        "maximumEntities": 16384,
        "maximumInformationCommands": 1,
        "equalCurrent": "retain-qualified-recovery-required",
        "readinessAuthority": false,
        "historicalPreservationClaim": false
      }
    },
    "Facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "declaration",
        "baseNames",
        "parent",
        "backing",
        "receipt",
        "namespace",
        "root",
        "imageMatches",
        "associations",
        "platform",
        "ancestry"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filesystemBytes",
            "maximumPhysicalBytes"
          ],
          "properties": {
            "filesystemBytes": {
              "type": "integer",
              "minimum": 33554432,
              "maximum": 1099511627776
            },
            "maximumPhysicalBytes": {
              "type": "integer",
              "minimum": 33554432,
              "maximum": 1099511627776
            }
          }
        },
        "baseNames": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino",
            "mode"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "backing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino",
            "mode",
            "kind",
            "nlink",
            "size",
            "allocatedBytes"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "kind": {
              "enum": [
                "file",
                "directory",
                "link"
              ]
            },
            "nlink": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "allocatedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "filesystemBytes",
            "maximumPhysicalBytes",
            "dev",
            "ino",
            "size",
            "mountDirectory",
            "bootSession",
            "ancestry"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "filesystemBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximumPhysicalBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "dev": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "ino": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "mountDirectory": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dev",
                "ino",
                "mode"
              ],
              "properties": {
                "dev": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                },
                "ino": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                "mode": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                }
              }
            },
            "bootSession": {
              "type": "string",
              "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
            },
            "ancestry": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              }
            }
          }
        },
        "namespace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino",
            "mode",
            "entries"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "entries": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "kind",
                  "dev",
                  "ino",
                  "mode",
                  "nlink",
                  "size"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "kind": {
                    "enum": [
                      "file",
                      "directory",
                      "link"
                    ]
                  },
                  "dev": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  },
                  "ino": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "nlink": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4096
                  }
                }
              }
            }
          }
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino",
            "mode",
            "filesystemBytes"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "filesystemBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            }
          }
        },
        "imageMatches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "associations": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "imagePath",
              "mountPoint",
              "device"
            ],
            "properties": {
              "imagePath": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "mountPoint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "device": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "platform": {
          "const": "darwin"
        },
        "ancestry": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        }
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "purpose",
        "entries",
        "ordinaryCurrentAdmitted"
      ],
      "properties": {
        "authority": {
          "const": false
        },
        "purpose": {
          "const": "current-predecessor-mounted-publication-metadata"
        },
        "entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "ordinaryCurrentAdmitted": {
          "const": false
        }
      }
    }
  }
}
