{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unsupported Native Image Publication Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "directory",
    "receiptStamp",
    "receiptSha256"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "unsupported-receipt-shape"
    },
    "directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "receiptStamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
