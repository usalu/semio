{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "metadata",
    "commands",
    "reads",
    "dispatches",
    "windowsMetadata",
    "windowsCandidates",
    "observerChecks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fault",
          "pending",
          "released",
          "reject",
          "initialState"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fault": {
            "enum": [
              "none",
              "accepted",
              "observed",
              "witnessed",
              "detached",
              "underlying",
              "staged",
              "published",
              "attached",
              "verified",
              "settled",
              "cancel-detached",
              "undefined-detached",
              "cleanup-attach",
              "cleanup-observe",
              "release-success",
              "release-primary",
              "mutable-options",
              "descriptor-before-effect",
              "inactive-association",
              "inactive-underlying",
              "inactive-attach",
              "inactive-witness"
            ]
          },
          "pending": {
            "type": "boolean"
          },
          "released": {
            "type": "boolean"
          },
          "reject": {
            "type": "boolean"
          },
          "initialState": {
            "enum": [
              "mounted",
              "inactive"
            ]
          }
        }
      }
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "file",
          "symlink",
          "sameDevice",
          "links",
          "mode",
          "bytes",
          "admit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "boolean"
          },
          "symlink": {
            "type": "boolean"
          },
          "sameDevice": {
            "type": "boolean"
          },
          "links": {
            "type": "string"
          },
          "mode": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "admit": {
            "type": "boolean"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "initialState",
          "fault",
          "admit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "platform": {
            "enum": [
              "darwin",
              "linux"
            ]
          },
          "initialState": {
            "enum": [
              "mounted",
              "inactive"
            ]
          },
          "fault": {
            "enum": [
              "none",
              "not-durable",
              "no-witness",
              "no-mapping",
              "duplicate"
            ]
          },
          "admit": {
            "type": "boolean"
          }
        }
      }
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fault",
          "admit",
          "unresolved"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fault": {
            "enum": [
              "none",
              "short",
              "growth",
              "changed",
              "close",
              "undefined-close",
              "frozen-close"
            ]
          },
          "admit": {
            "type": "boolean"
          },
          "unresolved": {
            "type": "boolean"
          }
        }
      }
    },
    "dispatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "initialState",
          "fault",
          "admit",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "platform": {
            "enum": [
              "darwin",
              "linux",
              "win32"
            ]
          },
          "initialState": {
            "enum": [
              "mounted",
              "inactive"
            ]
          },
          "fault": {
            "enum": [
              "none",
              "reorder",
              "exhausted",
              "pending"
            ]
          },
          "admit": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          }
        }
      }
    },
    "windowsMetadata": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "fault",
          "admit"
        ],
        "properties": {
          "action": {
            "enum": [
              "pending",
              "published",
              "settled"
            ]
          },
          "fault": {
            "enum": [
              "none",
              "order",
              "cancel",
              "receipt",
              "undefined",
              "frozen"
            ]
          },
          "admit": {
            "type": "boolean"
          }
        }
      }
    },
    "windowsCandidates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "initialState",
          "fault",
          "admit"
        ],
        "properties": {
          "initialState": {
            "enum": [
              "mounted",
              "inactive"
            ]
          },
          "fault": {
            "enum": [
              "none",
              "pending",
              "published",
              "settled"
            ]
          },
          "admit": {
            "type": "boolean"
          }
        }
      }
    },
    "observerChecks": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fault",
          "admit",
          "parents",
          "observations",
          "stats"
        ],
        "properties": {
          "fault": {
            "enum": [
              "none",
              "phase-cancel",
              "writer",
              "ancestor-0",
              "ancestor-1",
              "ancestor-2",
              "ancestor-file",
              "ancestor-symlink",
              "folder-cas",
              "backing-dev",
              "backing-ino",
              "backing-size",
              "backing-allocation",
              "backing-links",
              "backing-file",
              "backing-symlink",
              "root-dev",
              "root-ino",
              "root-file",
              "root-symlink"
            ]
          },
          "admit": {
            "type": "boolean"
          },
          "parents": {
            "const": 3
          },
          "observations": {
            "const": 3
          },
          "stats": {
            "const": 18
          }
        }
      }
    }
  }
}
