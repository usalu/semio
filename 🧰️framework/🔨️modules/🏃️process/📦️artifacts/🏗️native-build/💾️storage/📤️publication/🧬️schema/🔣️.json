{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://process/native-image-publication",
  "definitions": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "initialState",
        "receiptSha256",
        "directory",
        "backing",
        "root"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "enum": [
            "current-publication",
            "current-exact-publication",
            "current-prepared-publication",
            "current-retained-inactive-publication"
          ]
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "directory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            },
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            }
          }
        },
        "backing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino",
            "size",
            "allocatedBytes"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            },
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "allocatedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            },
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "maxLength": 20
            }
          }
        },
        "initialState": {
          "enum": [
            "mounted",
            "inactive"
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "purpose": {
                  "enum": [
                    "current-publication",
                    "current-exact-publication",
                    "current-prepared-publication"
                  ]
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "purpose": {
                  "const": "current-retained-inactive-publication"
                },
                "initialState": {
                  "const": "mounted"
                }
              }
            }
          ]
        }
      ]
    },
    "Witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest",
        "files",
        "directories",
        "links",
        "sockets",
        "bytes",
        "journalSha256",
        "applicationSha256",
        "service"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "directories": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "integer",
          "minimum": 0
        },
        "sockets": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "journalSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "service": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identity",
                "digest",
                "files",
                "directories",
                "bytes"
              ],
              "properties": {
                "identity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "uuid",
                    "directory",
                    "file"
                  ],
                  "properties": {
                    "kind": {
                      "const": "darwin-fsevents"
                    },
                    "uuid": {
                      "type": "string",
                      "pattern": "^[A-F0-9]{8}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{12}$"
                    },
                    "directory": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "ino",
                        "mode",
                        "uid",
                        "gid"
                      ],
                      "properties": {
                        "ino": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$"
                        },
                        "mode": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4095
                        },
                        "uid": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)$"
                        },
                        "gid": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)$"
                        }
                      }
                    },
                    "file": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "ino",
                        "mode",
                        "uid",
                        "gid",
                        "sha256"
                      ],
                      "properties": {
                        "ino": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$"
                        },
                        "mode": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4095
                        },
                        "uid": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)$"
                        },
                        "gid": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]*)$"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  }
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "files": {
                  "type": "integer",
                  "minimum": 1
                },
                "directories": {
                  "const": 1
                },
                "bytes": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          ]
        },
        "exactServicePayload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "withoutServiceMetadataSha256",
            "serviceContentSha256",
            "serviceMetadataSha256",
            "authority"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "withoutServiceMetadataSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "serviceContentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "serviceMetadataSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "authority": {
              "const": false
            }
          }
        }
      }
    },
    "Producer": {
      "const": {
        "role": "current-publication",
        "maximumBodyCommands": 5,
        "maximumCleanupCommands": 3,
        "actions": [
          "information",
          "detach",
          "inactive",
          "attach",
          "verify"
        ],
        "inactiveActions": [
          "information",
          "attach",
          "verify"
        ]
      }
    },
    "NativeGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumElapsedMilliseconds",
        "maximumBytes",
        "maximumLines"
      ],
      "properties": {
        "maximumElapsedMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "maximumLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "MetadataEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "file",
        "symlink",
        "sameDevice",
        "links",
        "mode",
        "bytes"
      ],
      "properties": {
        "name": {
          "enum": [
            "intent.json",
            "receipt.json"
          ]
        },
        "file": {
          "const": true
        },
        "symlink": {
          "const": false
        },
        "sameDevice": {
          "const": true
        },
        "links": {
          "const": "1"
        },
        "mode": {
          "const": 384
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "StageOrders": {
      "const": {
        "mounted": [
          "accepted",
          "observed",
          "witnessed",
          "detached",
          "underlying",
          "staged",
          "published",
          "attached",
          "verified",
          "settled"
        ],
        "inactive": [
          "accepted",
          "observed",
          "underlying",
          "staged",
          "published",
          "attached",
          "verified",
          "settled"
        ]
      }
    },
    "Qualification": {
      "enum": [
        "mounted-application-preserved",
        "inactive-current"
      ]
    },
    "DispatchOrders": {
      "const": {
        "darwin": {
          "mounted": [
            "image:information",
            "image:detach",
            "image:inactive",
            "image:attach",
            "image:verify"
          ],
          "inactive": [
            "image:information",
            "image:attach",
            "image:verify"
          ]
        },
        "linux": {
          "mounted": [
            "image:information",
            "image:detach",
            "image:inactive",
            "image:attach",
            "image:verify"
          ],
          "inactive": [
            "image:information",
            "image:attach",
            "image:verify"
          ]
        },
        "win32": {
          "mounted": [
            "image:information",
            "image:detach",
            "image:inactive",
            "image:attach",
            "image:verify"
          ],
          "inactive": [
            "image:information",
            "image:attach",
            "image:verify"
          ]
        }
      }
    },
    "ServiceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uuid",
        "directory",
        "file"
      ],
      "properties": {
        "kind": {
          "const": "darwin-fsevents"
        },
        "uuid": {
          "type": "string",
          "pattern": "^[A-F0-9]{8}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{12}$"
        },
        "directory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ino",
            "mode",
            "uid",
            "gid"
          ],
          "properties": {
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            },
            "uid": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "gid": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ino",
            "mode",
            "uid",
            "gid",
            "sha256"
          ],
          "properties": {
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            },
            "uid": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "gid": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "ReceiptConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "stampEqual",
        "bytesEqual",
        "expectedStamp",
        "actualStamp",
        "expectedSha256",
        "actualSha256",
        "expectedBytes",
        "actualBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "qualified-receipt-conflict"
        },
        "stampEqual": {
          "type": "boolean"
        },
        "bytesEqual": {
          "type": "boolean"
        },
        "expectedStamp": {
          "type": "string",
          "maxLength": 448,
          "pattern": "^[0-9]+(:[0-9]+){6}$"
        },
        "actualStamp": {
          "type": "string",
          "maxLength": 448,
          "pattern": "^[0-9]+(:[0-9]+){6}$"
        },
        "expectedSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actualSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "actualBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "ExactServicePayloadDiagnostic": {
      "$ref": "#/definitions/Witness/properties/exactServicePayload"
    },
    "PreservationRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "before",
        "after",
        "authority"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "publication-preservation-refusal"
        },
        "before": {
          "$ref": "#/definitions/Witness"
        },
        "after": {
          "$ref": "#/definitions/Witness"
        },
        "authority": {
          "const": false
        }
      }
    },
    "PreservationRefusalProtocol": {
      "const": {
        "maximumBytes": 8192,
        "authority": false
      }
    },
    "PreservationDiagnosticDeliveryProtocol": {
      "const": {
        "maximumNodes": 128,
        "maximumDepth": 8,
        "maximumStringUnits": 256,
        "maximumKeyUnits": 64
      }
    },
    "PreservationDiagnosticDeliveryCase": {
      "type": "object",
      "required": [
        "effect",
        "reported"
      ],
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "valid",
            "error-proxy",
            "cause-accessor",
            "cause-proxy",
            "nested-proxy",
            "nested-accessor",
            "symbol",
            "inherited",
            "unknown-field",
            "overbounds",
            "sink-failure",
            "undefined-primary"
          ]
        },
        "reported": {
          "type": "boolean"
        }
      }
    },
    "PreparedServicePolicy": {
      "const": {
        "purpose": "current-prepared-publication",
        "platform": "darwin"
      }
    },
    "PreparedDispatchOrders": {
      "const": {
        "mounted": [
          "image:information",
          "service:before",
          "image:detach",
          "image:inactive",
          "image:attach",
          "image:verify",
          "service:after"
        ],
        "inactive": [
          "image:information",
          "image:attach",
          "image:verify",
          "service:current"
        ]
      }
    },
    "PreparedParentCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "accepted",
        "children"
      ],
      "properties": {
        "effect": {
          "enum": [
            "before",
            "after",
            "current",
            "linux",
            "ordinary-purpose",
            "wrong-stage",
            "inactive-mapping",
            "pending",
            "root-changed",
            "worker-status",
            "worker-signal",
            "worker-json",
            "worker-open",
            "worker-stderr",
            "worker-undefined",
            "worker-frozen"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "children": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "RetainedInactivePolicy": {
      "const": {
        "purpose": "current-retained-inactive-publication",
        "initialState": "mounted",
        "qualification": "inactive-application-preserved",
        "maximumBodyCommands": 7,
        "actions": [
          "information",
          "detach",
          "inactive",
          "attach",
          "verify",
          "detach",
          "inactive"
        ],
        "standalone": false,
        "terminal": "inactive"
      }
    },
    "RetainedInactiveDispatchOrders": {
      "const": {
        "darwin": [
          "image:information",
          "service:before",
          "image:detach",
          "image:inactive",
          "image:attach",
          "image:verify",
          "service:after",
          "image:detach",
          "image:inactive"
        ],
        "linux": [
          "image:information",
          "image:detach",
          "image:inactive",
          "image:attach",
          "image:verify",
          "image:detach",
          "image:inactive"
        ],
        "win32": [
          "image:information",
          "image:detach",
          "image:inactive",
          "image:attach",
          "image:verify",
          "image:detach",
          "image:inactive"
        ]
      }
    }
  }
}
