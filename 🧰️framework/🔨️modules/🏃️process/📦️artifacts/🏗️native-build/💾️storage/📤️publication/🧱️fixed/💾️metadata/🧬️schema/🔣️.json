    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode",
        "bytes"
      ],
      "properties": {
        "device": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "inode": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        }
      }
    },
