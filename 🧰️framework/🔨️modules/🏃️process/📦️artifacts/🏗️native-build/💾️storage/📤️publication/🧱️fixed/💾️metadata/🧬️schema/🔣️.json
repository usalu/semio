          "pending": [
            "authenticate",
            "namespace",
            "intent",
            "flush",
            "verify",
            "close"
          ],
          "published": [
            "authenticate",
            "namespace",
            "candidate",
            "replace",
            "flush",
            "verify",
            "close"
          ],
          "settled": [
            "authenticate",
            "namespace",
            "clear",
            "flush",
            "verify",
            "close"
