  "$id": "semio:native-fixed-publication-metadata:v1",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "actions": [
          "pending",
          "published",
          "settled"
        ],
        "maximumMetadataCommands": 3,
        "maximumEntries": 2,
        "maximumBytes": 4096,
        "maximumAclEntries": 64,
        "maximumOutputBytes": 8192,
        "maximumOutputLines": 8,
        "maximumPathUnits": 256,
        "maximumParents": 64,
        "bufferUnits": 305,
        "deniedAttributes": 24064,
        "writeMask": 1343029590,
        "trustedSids": [
          "S-1-5-18",
          "S-1-5-32-544"
        ],
        "namespace": ".publication",
        "intent": "intent.json",
        "candidate": "receipt.json",
        "receipt": "image.json",
        "backing": "fixed.vhd",
