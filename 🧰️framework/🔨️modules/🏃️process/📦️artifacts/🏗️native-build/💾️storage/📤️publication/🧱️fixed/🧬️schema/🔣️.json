{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:native-fixed-publication:v1",
  "definitions": {
    "Protocol": {
      "const": {
        "actions": [
          "information",
          "detach",
          "inactive",
          "attach",
          "verify"
        ],
        "platforms": [
          "linux",
          "win32"
        ]
      }
    },
    "DirectoryMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "anchor",
        "volume"
      ],
      "properties": {
        "kind": {
          "const": "directory-partition"
        },
        "anchor": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "volume": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "ino",
            "mode"
          ],
          "properties": {
            "dev": {
              "type": "string",
              "pattern": "^[0-9]{1,20}$"
            },
            "ino": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "change",
        "accepted"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "linux",
            "win32"
          ]
        },
        "change": {
          "enum": [
            "none",
            "backing",
            "image",
            "volume",
            "extra"
          ]
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "ObservationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "platform",
        "effect",
        "accepted",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "linux",
            "win32"
          ]
        },
        "effect": {
          "enum": [
            "mounted",
            "inactive",
            "duplicate",
            "missing-association",
            "observer",
            "foreign-text"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "mounted",
            "inactive"
          ]
        }
      }
    }
  }
}
