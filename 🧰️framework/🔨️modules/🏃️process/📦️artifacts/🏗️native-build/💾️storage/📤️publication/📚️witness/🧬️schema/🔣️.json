{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://process/native-image-publication/witness",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "nameWindow": 64,
        "chunkBytes": 65536,
        "maximumDepth": 64,
        "maximumPathUnits": 256,
        "workUnitsPerLogicalByte": 1,
        "censuses": 2,
        "progressWorkUnits": 256,
        "journalNames": [
          "storage-checkpoint.jsonl",
          "storage-events.jsonl"
        ],
        "exclusions": []
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "effect",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "ordinary",
            "symlink",
            "hardlink",
            "changed-journal",
            "system-payload",
            "copied-control",
            "observer",
            "cancelled",
            "unsafe",
            "overwork",
            "growth",
            "short-read",
            "ancestry",
            "cross-device",
            "close",
            "body-undefined-close",
            "body-frozen-close",
            "wide",
            "deep",
            "journal-link",
            "journal-directory",
            "acquire-file-cancel",
            "acquire-directory-cancel",
            "acquire-file-observer",
            "acquire-directory-observer",
            "census-change",
            "directory-close",
            "body-undefined-directory-close",
            "body-frozen-directory-close"
          ]
        },
        "accepted": {
          "type": "boolean"
        }
      }
    },
    "Fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directories",
        "files"
      ],
      "properties": {
        "directories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "bytes": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "repeat",
                  "count"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "repeat": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 131073
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
