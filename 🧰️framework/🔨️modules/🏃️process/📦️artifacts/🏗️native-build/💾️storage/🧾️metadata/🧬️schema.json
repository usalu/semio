{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FaultCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fault",
              "allowed"
            ],
            "properties": {
              "fault": {
                "enum": [
                  "none",
                  "symlink",
                  "foreign-device",
                  "changed-name",
                  "descriptor",
                  "sync-undefined",
                  "sync-frozen",
                  "cancelled",
                  "expired"
                ]
              },
              "allowed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
