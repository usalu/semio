{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "operation": "sync-metadata",
        "maximumPending": 1,
        "maximumBytes": 8192,
        "maximumLines": 8,
        "platforms": [
          "darwin",
          "linux",
          "win32"
        ]
      }
    },
    "Mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "device",
        "disk",
        "unique",
        "partition",
        "volume",
        "bytes"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "device": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "disk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unique": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "partition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "volume": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operation",
        "before",
        "after",
        "returnValue"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operation": {
          "const": "sync-metadata"
        },
        "before": {
          "$ref": "#/definitions/Mapping"
        },
        "after": {
          "$ref": "#/definitions/Mapping"
        },
        "returnValue": {
          "const": 0
        }
      }
    },
    "FaultCorpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fault",
              "allowed"
            ],
            "properties": {
              "fault": {
                "enum": [
                  "none",
                  "symlink",
                  "foreign-device",
                  "changed-name",
                  "descriptor",
                  "sync-undefined",
                  "sync-frozen",
                  "cancelled",
                  "expired"
                ]
              },
              "allowed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "ReceiptCases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "result",
              "changed",
              "allowed"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "result": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "changed": {
                "type": "boolean"
              },
              "allowed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
