{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.dev/native/recomputable-retirement/v1",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "maximumEntries": 131072,
        "maximumDepth": 64,
        "maximumRecordBytes": 33554432,
        "batchEntries": 64
      }
    },
    "Allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "kind",
        "bytes",
        "phase"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "compiler-workspace",
            "compiler-state",
            "artifact-publication",
            "artifact-restore"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "const": "committed"
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino",
        "mode"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "ino": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "identity",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "identity": {
          "$ref": "#/definitions/Identity"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "Intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "directory",
        "leaseDirectory",
        "filesystemBytes",
        "maximumPhysicalBytes",
        "journalSha256",
        "allocation",
        "entries",
        "ancestry",
        "phase",
        "receiptSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "purpose": {
          "const": "complete-authenticated-native-recomputable-retirement"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "leaseDirectory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "filesystemBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 1
        },
        "journalSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "allocation": {
          "$ref": "#/definitions/Allocation"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 131072,
          "items": {
            "$ref": "#/definitions/Entry"
          }
        },
        "ancestry": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "identity"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "identity": {
                "$ref": "#/definitions/Identity"
              }
            }
          }
        },
        "phase": {
          "enum": [
            "payload",
            "evidence",
            "receipt"
          ]
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "CoordinatorLeaseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heldDirectory",
        "heldResource",
        "requestedDirectory",
        "requestedResource",
        "waitedMilliseconds",
        "refused"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "heldDirectory": {
          "type": "string",
          "minLength": 1
        },
        "heldResource": {
          "type": "string",
          "minLength": 1
        },
        "requestedDirectory": {
          "type": "string",
          "minLength": 1
        },
        "requestedResource": {
          "type": "string",
          "minLength": 1
        },
        "waitedMilliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "boolean"
        }
      }
    }
  }
}
