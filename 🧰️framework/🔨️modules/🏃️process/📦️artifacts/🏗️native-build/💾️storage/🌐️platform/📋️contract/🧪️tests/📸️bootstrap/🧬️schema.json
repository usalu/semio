{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "platform",
      "backend",
      "fault",
      "accept"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "platform": {
        "enum": [
          "darwin",
          "linux",
          "win32"
        ]
      },
      "backend": {
        "enum": [
          "mounted-image",
          "directory-partition"
        ]
      },
      "fault": {
        "enum": [
          "none",
          "backing",
          "receipt",
          "capacity",
          "root",
          "detached",
          "custody"
        ]
      },
      "accept": {
        "type": "boolean"
      }
    }
  }
}
