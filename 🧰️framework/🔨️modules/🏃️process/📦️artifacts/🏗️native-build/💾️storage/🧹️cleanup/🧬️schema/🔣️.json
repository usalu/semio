{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/native-image-cleanup/v1",
  "description": "Evidence contracts describe accepted physical ownership. Data alone never grants platform operation authority.",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "maximumCleanupMilliseconds": 10000,
        "maximumInformationBytes": 1048576,
        "maximumInformationLines": 32768,
        "maximumCleanupAttempts": 1
      }
    },
    "PhysicalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "platform", "directory", "backing", "activation"],
      "properties": {
        "version": {"const": 1},
        "platform": {"enum": ["darwin", "linux", "win32"]},
        "directory": {"type": "string", "minLength": 1, "maxLength": 256},
        "backing": {"type": "string", "minLength": 1, "maxLength": 1024},
        "activation": {"type": ["string", "null"], "minLength": 1, "maxLength": 1024}
      }
    },
    "Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lifecycle", "interruption", "identity", "physical", "commandSettled", "budgetMilliseconds", "deactivation", "publication", "primaryFailure", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "lifecycle": {"enum": ["temporary", "fresh-persistent", "published-persistent"]},
        "interruption": {"enum": ["none", "cancelled", "deadline"]},
        "identity": {"enum": ["exact", "changed", "unknown"]},
        "physical": {"enum": ["active", "inactive", "unknown"]},
        "commandSettled": {"type": "boolean"},
        "budgetMilliseconds": {"type": "integer", "minimum": 0, "maximum": 10000},
        "deactivation": {"enum": ["complete", "failed", "deadline", "cancelled", "still-active"]},
        "publication": {"enum": ["none", "accepted", "failed"]},
        "primaryFailure": {"type": "boolean"},
        "expected": {"$ref": "#/definitions/Decision"}
      }
    },
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "custody", "primaryFailure", "cleanupFailure"],
      "properties": {
        "effect": {"enum": ["release-reader", "await-command", "remove-owned", "deactivate-and-remove", "deactivate-and-retain", "retain-unresolved"]},
        "custody": {"enum": ["persistent", "settled", "held", "unresolved"]},
        "primaryFailure": {"type": "boolean"},
        "cleanupFailure": {"type": "boolean"}
      }
    },
    "Corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cases"],
      "properties": {
        "version": {"const": 1},
        "cases": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/definitions/Scenario"}}
      }
    }
  },
  "$ref": "#/definitions/Corpus"
}
