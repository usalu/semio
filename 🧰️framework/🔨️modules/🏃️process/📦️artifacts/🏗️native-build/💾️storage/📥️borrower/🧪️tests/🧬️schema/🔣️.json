{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "expired",
          "cancelled",
          "sameLease",
          "samePin",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "expired": {
            "type": "boolean"
          },
          "cancelled": {
            "type": "boolean"
          },
          "sameLease": {
            "type": "boolean"
          },
          "samePin": {
            "type": "boolean"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "body",
              "release"
            ],
            "properties": {
              "body": {
                "type": "boolean"
              },
              "release": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
