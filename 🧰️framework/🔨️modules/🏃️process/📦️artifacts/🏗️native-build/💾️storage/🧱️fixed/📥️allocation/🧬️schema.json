{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:native-fixed-allocation:v1",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "chunkBytes": 1048576,
        "maximumReceiptBytes": 4096,
        "maximumPathUnits": 256,
        "deniedAttributes": 19984,
        "allowedAttributes": 8352
      }
    },
    "Facts": {
      "type": "object",
      "required": [
        "volume",
        "index",
        "fileId",
        "allocation",
        "eof",
        "links",
        "attributes",
        "volumeId"
      ],
      "properties": {
        "volume": {
          "type": "string",
          "pattern": "^[0-9]{1,10}$"
        },
        "index": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "fileId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "allocation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "eof": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "links": {
          "const": 1
        },
        "attributes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "volumeId": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        }
      },
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "required": [
        "version",
        "path",
        "written",
        "footerSha256",
        "before",
        "after",
        "named",
        "closed"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "path": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256
        },
        "written": {
          "type": "integer",
          "minimum": 33554944,
          "maximum": 1099510579712
        },
        "footerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "before": {
          "$ref": "#/definitions/Facts"
        },
        "after": {
          "$ref": "#/definitions/Facts"
        },
        "named": {
          "$ref": "#/definitions/Facts"
        },
        "closed": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "Corpus": {
      "type": "object",
      "required": [
        "version",
        "cases",
        "faults"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "object",
            "required": [
              "id",
              "change",
              "value",
              "accepted"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "change": {
                "enum": [
                  "none",
                  "closed",
                  "allocation",
                  "eof",
                  "links",
                  "attributes",
                  "index",
                  "fileId",
                  "volume",
                  "written",
                  "sha",
                  "extra",
                  "volumeId"
                ]
              },
              "value": {},
              "accepted": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "faults": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 9,
          "items": {
            "enum": [
              "success",
              "missing-receipt",
              "partial-output",
              "short-footer",
              "body-undefined",
              "body-frozen",
              "close-fault",
              "undefined-and-close",
              "frozen-and-close",
              "swap-after-close"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "required": [
        "filesystemBytes",
        "maximumPhysicalBytes",
        "timestampSeconds",
        "uuid",
        "path"
      ],
      "properties": {
        "filesystemBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 1099510579200,
          "multipleOf": 1048576
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 34603008,
          "maximum": 1099511627776,
          "multipleOf": 1048576
        },
        "timestampSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "uuid": {
          "type": "string",
          "pattern": "^(?!0{32}$)[0-9a-f]{32}$"
        },
        "path": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256
        }
      },
      "additionalProperties": false
    }
  }
}
