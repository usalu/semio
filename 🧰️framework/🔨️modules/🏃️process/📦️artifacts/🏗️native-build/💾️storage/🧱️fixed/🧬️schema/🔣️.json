{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:native-fixed-platform:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root",
    "image",
    "filesystemBytes",
    "maximumPhysicalBytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "filesystemBytes": {
      "type": "integer",
      "minimum": 33554432,
      "maximum": 1099511627776
    },
    "maximumPhysicalBytes": {
      "type": "integer",
      "minimum": 33554432,
      "maximum": 1099511627776
    }
  },
  "definitions": {
    "UnpublishedBirthRetention": {
      "const": {
        "version": 1,
        "leaseMode": "exclusive",
        "rootOnly": true,
        "maximumEntries": 2,
        "retainedPrefix": "birth-",
        "identityDigestCharacters": 24,
        "receipt": "absent",
        "publication": "settled",
        "association": "inactive",
        "mountEntries": 0,
        "effect": "atomic-same-parent-retention",
        "payload": "preserve",
        "collision": "refuse",
        "authorityFromData": false
      }
    },
    "UnpublishedBirthCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fault", "retained"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "fault": {"enum": ["none", "associated", "mount-payload", "foreign-entry", "collision", "changed-backing", "changed-parent", "writer", "child"]},
        "retained": {"type": "boolean"}
      }
    },
    "ImageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "platform",
        "dev",
        "ino",
        "size",
        "filesystemBytes",
        "maximumPhysicalBytes",
        "mountDirectory"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "platform": {
          "enum": [
            "linux",
            "win32"
          ]
        },
        "dev": {
          "type": "integer",
          "minimum": 0
        },
        "ino": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "filesystemBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 1099511627776
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 1099511627776
        },
        "mountDirectory": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/process/artifacts/native-build/storage/platform/contract/mount/component.json"
        }
      }
    },
    "Command": {
      "definitions": {
        "Protocol": {
          "const": {
            "maximumOutputBytes": 1048576,
            "maximumOutputLines": 32768,
            "maximumBodyCommands": 16,
            "maximumCleanupCommands": 3,
            "maximumPendingCommands": 1,
            "maximumKernelRows": 16384,
            "maximumKernelBytes": 1048576,
            "maximumKernelValueBytes": 4096
          }
        },
        "Request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "platform",
            "phase",
            "action",
            "writer",
            "accepted",
            "activationAccepted",
            "mapping",
            "commands"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "platform": {
              "enum": [
                "linux",
                "win32"
              ]
            },
            "phase": {
              "enum": [
                "body",
                "cleanup"
              ]
            },
            "action": {
              "enum": [
                "allocate",
                "format",
                "activate",
                "information",
                "inactive",
                "deactivate"
              ]
            },
            "writer": {
              "type": "boolean"
            },
            "accepted": {
              "type": "boolean"
            },
            "activationAccepted": {
              "type": "boolean"
            },
            "mapping": {
              "enum": [
                "unknown",
                "inactive",
                "exact-active",
                "ambiguous",
                "changed"
              ]
            },
            "commands": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            }
          }
        },
        "Case": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input",
            "expected"
          ],
          "properties": {
            "input": {
              "$ref": "#/definitions/Command/definitions/Request"
            },
            "expected": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "PreparationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "before",
        "after",
        "expected"
      ],
      "properties": {
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "platform",
            "dev",
            "ino",
            "size",
            "filesystemBytes",
            "maximumPhysicalBytes"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "platform": {
              "enum": [
                "linux",
                "win32"
              ]
            },
            "dev": {
              "type": "integer",
              "minimum": 0
            },
            "ino": {
              "type": "integer",
              "minimum": 0
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            },
            "filesystemBytes": {
              "type": "integer",
              "minimum": 33554432,
              "maximum": 1099511627776
            },
            "maximumPhysicalBytes": {
              "type": "integer",
              "minimum": 33554432,
              "maximum": 1099511627776
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "platform",
            "dev",
            "ino",
            "size",
            "filesystemBytes",
            "maximumPhysicalBytes"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "platform": {
              "enum": [
                "linux",
                "win32"
              ]
            },
            "dev": {
              "type": "integer",
              "minimum": 0
            },
            "ino": {
              "type": "integer",
              "minimum": 0
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            },
            "filesystemBytes": {
              "type": "integer",
              "minimum": 33554432,
              "maximum": 1099511627776
            },
            "maximumPhysicalBytes": {
              "type": "integer",
              "minimum": 33554432,
              "maximum": 1099511627776
            }
          }
        },
        "before": {
          "type": "string",
          "maxLength": 4096
        },
        "after": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "MaterializedPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "directoryLength",
        "leaseLength",
        "filename",
        "canonicalDirectory",
        "canonicalLease",
        "expectedAcquisitions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "directoryLength": {
          "type": "integer",
          "minimum": 2,
          "maximum": 257
        },
        "leaseLength": {
          "type": "integer",
          "minimum": 2,
          "maximum": 257
        },
        "filename": {
          "enum": [
            "fixed.img",
            "fixed.vhd"
          ]
        },
        "canonicalDirectory": {
          "type": "boolean"
        },
        "canonicalLease": {
          "type": "boolean"
        },
        "expectedAcquisitions": {
          "enum": [
            0,
            1
          ]
        }
      }
    },
    "PreparationObservation": {
      "definitions": {
        "Protocol": {
          "const": {
            "version": 1,
            "steps": [
              "prepare",
              "observe"
            ],
            "maximumFailures": 2,
            "primary": "first-thrown",
            "undefined": "failure",
            "authority": false
          }
        },
        "Case": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "prepare",
            "oversized",
            "primary",
            "failures"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 64
            },
            "prepare": {
              "enum": [
                "success",
                "body",
                "undefined"
              ]
            },
            "oversized": {
              "type": "boolean"
            },
            "primary": {
              "enum": [
                "value",
                "body",
                "undefined",
                "observation"
              ]
            },
            "failures": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "enum": [
                  "body",
                  "undefined",
                  "observation"
                ]
              }
            }
          }
        }
      }
    },
    "Slot": {
      "const": {
        "directory": ".publication",
        "intent": "intent.json",
        "candidate": "receipt.json",
        "maximumFileBytes": 4096
      }
    },
    "Namespace": {
      "const": {
        "mode": 448,
        "fileMode": 384,
        "maximumEntries": 2
      }
    },
    "WindowsBackingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volumeSerial",
        "fileId",
        "volume",
        "attributes",
        "creationTime",
        "securitySha256",
        "streamsSha256"
      ],
      "properties": {
        "volumeSerial": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "fileId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "volume": {
          "type": "string",
          "pattern": "^\\\\\\\\\\?\\\\Volume\\{[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}\\}\\\\$"
        },
        "attributes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "creationTime": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,19})$"
        },
        "securitySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "streamsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "WindowsImageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "platform",
        "dev",
        "ino",
        "size",
        "filesystemBytes",
        "maximumPhysicalBytes",
        "mountDirectory",
        "backing"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "platform": {
          "const": "win32"
        },
        "dev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ino": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "filesystemBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 1099511627776
        },
        "maximumPhysicalBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 1099511627776
        },
        "mountDirectory": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/process/artifacts/native-build/storage/platform/contract/mount/component.json#/definitions/WindowsDirectory"
        },
        "backing": {
          "$ref": "#/definitions/WindowsBackingIdentity"
        }
      }
    },
    "WindowsReceiptObservation": {
      "const": {
        "version": 1,
        "maximumReceiptBytes": 4096,
        "legacyMaximum": 9007199254740991,
        "unsignedMaximum": "18446744073709551615",
        "signedMinimum": "-9223372036854775808",
        "signedMaximum": "9223372036854775807",
        "backingKind": "file",
        "backingLinks": 1,
        "deniedAttributes": 1024,
        "identityFields": [
          "volumeSerial",
          "fileId",
          "volume",
          "attributes",
          "creationTime",
          "securitySha256",
          "streamsSha256"
        ],
        "authority": false
      }
    },
    "WindowsCurrentObservation": {
      "const": {
        "version": 1,
        "names": [
          "fixed.vhd",
          "image.json",
          "m"
        ],
        "navigation": [
          ".",
          ".."
        ],
        "maximumParents": 64,
        "maximumHostEntries": 3,
        "maximumNavigationEntries": 2,
        "maximumReceiptBytes": 4096,
        "footerBytes": 512,
        "authority": false
      }
    },
    "WindowsOrdinaryReadPolicy": {
      "const": {
        "version": 1,
        "factsPerHandle": 16,
        "workPerFacts": 16,
        "workPerHandle": 8,
        "ancestorReplays": 4,
        "extraHandles": 8,
        "workPerRead": 8,
        "directoryCensuses": 2,
        "workPerDirectoryNext": 8,
        "libraryWork": 6,
        "progressWork": 64,
        "callerBudget": false,
        "originalRenewal": false,
        "authority": false
      }
    },
    "WindowsOrdinaryReceiverPolicy": {
      "const": {
        "version": 1,
        "bodyStages": [
          "reserved",
          "shared",
          "ready"
        ],
        "cleanupStage": "ready",
        "leaseMode": "shared",
        "rootOnly": true,
        "bodyAcceptedCleanup": false,
        "guardChange": "refuse"
      }
    },
    "WindowsMappedObservation": {
      "const": {
        "version": 1,
        "purpose": "ordinary-mapped-root-observation",
        "physicalSnapshotCount": 1,
        "metadataAuthority": false,
        "rootOnly": true,
        "rootMustDifferFromHostVolume": true,
        "sameAccount": true,
        "maximumExtraRootHandles": 1
      }
    },
    "WindowsOrdinaryMappingPolicy": {
      "const": {
        "version": 1,
        "purpose": "ordinary-receiver-mapping",
        "observationsPerRead": 2,
        "canonicalAction": "information",
        "rootOnly": true,
        "sameAccount": true,
        "callerProgram": false,
        "authorityFromMapping": false
      }
    },
    "WindowsHeldCurrentObservation": {
      "const": {
        "version": 1,
        "purpose": "held-current-receiver-read",
        "rootOnly": true,
        "sampledDataAuthority": false,
        "exactIssuedHandles": true,
        "maximumHeldViews": 4,
        "sameAccount": true,
        "consumerOwnChildrenDrain": true,
        "copyAndEscape": "refuse",
        "finalCloseBeforeResult": true
      }
    },
    "WindowsReceiverObservation": {
      "const": {
        "version": 1,
        "purpose": "ordinary-native-receiver-observation",
        "leaseMode": "shared",
        "baseline": "private-current-native",
        "sameFrameNested": true,
        "sampledAuthority": false,
        "bodyStage": "ready",
        "mutableFields": [
          "writeTime",
          "changeTime"
        ]
      }
    },
    "WindowsReceiverOperationAccount": {
      "const": {
        "version": 1,
        "purpose": "actual-outer-borrower-operation-account",
        "key": "private-outermost-borrower-frame",
        "callerBudget": false,
        "nested": "same-account",
        "receiverFailure": "sticky",
        "newAfter": "successful-drain-close-and-association",
        "concurrent": "refuse-before-effects"
      }
    }
  }
}
