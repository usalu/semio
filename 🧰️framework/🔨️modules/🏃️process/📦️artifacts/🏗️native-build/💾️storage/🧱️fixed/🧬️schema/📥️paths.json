{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "directoryLength",
    "leaseLength",
    "filename",
    "canonicalDirectory",
    "canonicalLease",
    "expectedAcquisitions"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "directoryLength": {
      "type": "integer",
      "minimum": 2,
      "maximum": 257
    },
    "leaseLength": {
      "type": "integer",
      "minimum": 2,
      "maximum": 257
    },
    "filename": {
      "enum": [
        "fixed.img",
        "fixed.vhd"
      ]
    },
    "canonicalDirectory": {
      "type": "boolean"
    },
    "canonicalLease": {
      "type": "boolean"
    },
    "expectedAcquisitions": {
      "enum": [
        0,
        1
      ]
    }
  }
}
