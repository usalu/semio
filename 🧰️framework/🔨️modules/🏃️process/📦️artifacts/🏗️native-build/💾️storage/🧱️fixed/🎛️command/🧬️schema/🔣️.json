{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:native-fixed-command:v1",
  "definitions": {
    "Protocol": {
      "const": {
        "maximumOutputBytes": 1048576,
        "maximumOutputLines": 32768,
        "maximumBodyCommands": 16,
        "maximumCleanupCommands": 3,
        "maximumPendingCommands": 1,
        "maximumKernelRows": 16384,
        "maximumKernelBytes": 1048576,
        "maximumKernelValueBytes": 4096
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "platform",
        "phase",
        "action",
        "writer",
        "accepted",
        "activationAccepted",
        "mapping",
        "commands"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "platform": {
          "enum": [
            "linux",
            "win32"
          ]
        },
        "phase": {
          "enum": [
            "body",
            "cleanup"
          ]
        },
        "action": {
          "enum": [
            "allocate",
            "format",
            "activate",
            "information",
            "inactive",
            "deactivate"
          ]
        },
        "writer": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        },
        "activationAccepted": {
          "type": "boolean"
        },
        "mapping": {
          "enum": [
            "unknown",
            "inactive",
            "exact-active",
            "ambiguous",
            "changed"
          ]
        },
        "commands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "expected"
      ],
      "properties": {
        "input": {
          "$ref": "#/definitions/Request"
        },
        "expected": {
          "type": "boolean"
        }
      }
    }
  }
}
