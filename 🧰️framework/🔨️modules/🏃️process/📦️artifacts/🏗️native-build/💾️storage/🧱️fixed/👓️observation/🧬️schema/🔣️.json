{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/process/artifacts/native-build/storage/fixed/observation/component.json",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "steps": [
          "prepare",
          "observe"
        ],
        "maximumFailures": 2,
        "primary": "first-thrown",
        "undefined": "failure",
        "authority": false
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "prepare",
        "oversized",
        "primary",
        "failures"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "prepare": {
          "enum": [
            "success",
            "body",
            "undefined"
          ]
        },
        "oversized": {
          "type": "boolean"
        },
        "primary": {
          "enum": [
            "value",
            "body",
            "undefined",
            "observation"
          ]
        },
        "failures": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "enum": [
              "body",
              "undefined",
              "observation"
            ]
          }
        }
      }
    }
  }
}
