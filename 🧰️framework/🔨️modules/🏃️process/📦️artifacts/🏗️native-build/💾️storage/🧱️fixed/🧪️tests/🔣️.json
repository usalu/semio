{
  "version": 1,
  "platforms": [
    {
      "platform": "darwin",
      "backend": "mounted-image"
    },
    {
      "platform": "linux",
      "backend": "directory-partition"
    },
    {
      "platform": "win32",
      "backend": "directory-partition"
    },
    {
      "platform": "freebsd",
      "backend": null
    }
  ],
  "paths": [
    {
      "path": "nested/output",
      "accepted": true
    },
    {
      "path": "../outside/output",
      "accepted": false
    },
    {
      "path": "dangling/output",
      "accepted": false
    },
    {
      "path": "..cache/output",
      "accepted": true
    }
  ]
}
