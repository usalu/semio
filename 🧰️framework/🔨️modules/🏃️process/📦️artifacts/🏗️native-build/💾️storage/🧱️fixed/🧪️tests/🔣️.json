{
  "version": 1,
  "platforms": [
    {
      "platform": "darwin",
      "backend": "mounted-image"
    },
    {
      "platform": "linux",
      "backend": "directory-partition"
    },
    {
      "platform": "win32",
      "backend": "directory-partition"
    },
    {
      "platform": "freebsd",
      "backend": null
    }
  ],
  "paths": [
    {
      "path": "nested/output",
      "accepted": true
    },
    {
      "path": "../outside/output",
      "accepted": false
    },
    {
      "path": "dangling/output",
      "accepted": false
    },
    {
      "path": "..cache/output",
      "accepted": true
    }
  ],
  "incompleteBirths": [
    {
      "name": "interrupted before backing",
      "entries": [
        "m"
      ],
      "attached": false,
      "accepted": true
    },
    {
      "name": "published receipt",
      "entries": [
        "m",
        "image.json"
      ],
      "attached": false,
      "accepted": false
    },
    {
      "name": "backing exists",
      "entries": [
        "m",
        "fixed.dir"
      ],
      "attached": false,
      "accepted": false
    },
    {
      "name": "unknown sibling",
      "entries": [
        "m",
        "unknown"
      ],
      "attached": false,
      "accepted": false
    },
    {
      "name": "missing root",
      "entries": [],
      "attached": false,
      "accepted": false
    },
    {
      "name": "attached",
      "entries": [
        "m"
      ],
      "attached": true,
      "accepted": false
    }
  ],
  "receiptDirectorySync": {
    "requiredCall": "syncNativeDirectoryMetadataV1",
    "forbiddenCall": "fsyncSync"
  }
}
                                                                                                                                                                                                                                      