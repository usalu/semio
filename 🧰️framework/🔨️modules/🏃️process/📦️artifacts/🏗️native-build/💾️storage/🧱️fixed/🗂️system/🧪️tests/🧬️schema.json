        "required": [
          "windows",
          "system",
          "accepted"
        ],
        "properties": {
          "windows": {
            "type": "string"
          },
          "system": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "ffi": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
