{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/process/artifacts/native-build/storage/birth/claim/component.json",
  "definitions": {
    "Protocol": {
      "const": {
        "version": 1,
        "maximumBytes": 16384,
        "maximumRecords": 3,
        "maximumOwners": 32,
        "filename": ".native-birth-",
        "suffix": ".jsonl",
        "stages": [
          "declared",
          "directory",
          "root"
        ],
        "unknown": "retain-refuse",
        "numericRetry": false,
        "metadataOrder": [
          "directory-parent-sync",
          "directory-claim",
          "root-parent-sync",
          "root-claim"
        ],
        "retirement": {
          "owner": "existing-private-removed-creator",
          "scope": "same-closed-complete-claim",
          "identity": "original-final-inode-and-bytes",
          "order": [
            "physical-removal",
            "claim-unlink",
            "parent-sync",
            "original-guard-release"
          ],
          "unknown": "retain-refuse"
        },
        "successfulRetirement": {
          "owner": "existing-private-recovered-kernel-maintenance",
          "request": "same-private-captured-request-and-closed-immutable-data",
          "records": "complete-original-three-stage-claim",
          "order": [
            "reader-drain",
            "kernel-ex",
            "complete-descriptor-census",
            "mapping-recheck",
            "detach",
            "inactive-observation",
            "physical-removal",
            "entry-parent-sync",
            "claim-unlink",
            "claim-parent-sync",
            "kernel-close",
            "original-reader-close",
            "namespace-remove-sync",
            "journal-retiring-retired-sync"
          ],
          "unknown": "retain-charge",
          "residualMetadataBytes": 0
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "ino",
        "mode"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "ino": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "Request": {
      "$ref": "https://semio.tech/framework/process/native-storage/v1#/definitions/ChildRequest"
    },
    "Record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request",
        "stage",
        "parent",
        "directory",
        "root"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "request": {
          "$ref": "#/definitions/Request"
        },
        "stage": {
          "enum": [
            "declared",
            "directory",
            "root"
          ]
        },
        "parent": {
          "$ref": "#/definitions/Identity"
        },
        "directory": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/Identity"
            }
          ]
        },
        "root": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/Identity"
            }
          ]
        }
      }
    },
    "SuccessfulRecoveryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mutation",
        "valid"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mutation": {
          "enum": [
            "none",
            "partial",
            "request",
            "parent",
            "directory",
            "unknown-field",
            "incomplete"
          ]
        },
        "valid": {
          "type": "boolean"
        }
      }
    }
  },
  "$ref": "#/definitions/Record"
}
