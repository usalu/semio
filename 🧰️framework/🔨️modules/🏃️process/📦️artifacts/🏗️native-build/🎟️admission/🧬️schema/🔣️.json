    "ObservationV1": {
      "description": "One observation of a unit key, one newline-terminated JSON line of units.jsonl; the unterminated tail of the file is an interrupted append and is dropped. Identity is (key, atMs): a later row of the same identity (the end-of-run refinement with the critical-path remainingMs) replaces an earlier one (the row appended when the unit completed, remainingMs = wallMs).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "key",
        "peakRssBytes",
        "outputBytes",
        "wallMs",
        "cpuMs",
        "remainingMs",
        "atMs"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "peakRssBytes": {
          "description": "The larger of the unit's peak resident bytes and its largest charged sample (phys_footprint on macOS): what the OS charges the compiler with, also when its pages are compressed or swapped.",
          "type": "integer",
          "minimum": 0
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "wallMs": {
          "type": "integer",
          "minimum": 0
        },
