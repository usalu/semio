{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.build/AdmissionV1",
  "title": "Memory-aware rustc admission: policy, wrapper wire protocol and recorded unit observations",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "maximumReserveBytes": 6442450944,
        "reserveBasisPoints": 2500,
        "floorBytes": 268435456,
        "coldBaseBytes": 644245094,
        "coldBytesPerKloc": 41943040,
        "componentFinalBytes": 6442450944,
        "componentColdQuantile": 0.5,
        "componentColdMinimumRows": 3,
        "headroom": 1.15,
        "quantile": 0.95,
        "window": 8,
        "swapOutBytesPerSecond": 67108864,
        "resumeFraction": 0.9,
        "nonRustcWindowMs": 10000,
        "brokerEnvironment": "SEMIO_BUILD_BROKER",
        "passEnvironment": "SEMIO_BUILD_PASS",
        "storeNamespace": "semio.build-telemetry/v1",
        "storeDirectory": "build-telemetry",
        "storeFile": "units.jsonl",
        "sourceExtension": ".rs",
        "sourceSkipDirectories": [
          "target",
          "node_modules",
          "dist",
          ".git"
        ],
        "available": {
          "description": "Admission against the measured available memory of the host, on top of the resident-set budget: a unit starts only when its predicted peak fits the available bytes less the margin (a share of total memory) and less what running units have yet to realize; the host warden's guard and danger levels hold every start; a machine that never has the room starts one unit after the wait (twice the wait for a unit the warden cancelled, whose prediction is raised to the cancelled megabytes times the factor).",
          "marginBasisPoints": 1500,
          "waitMilliseconds": 180000,
          "pollMilliseconds": 1000,
          "cancelledFactorBasisPoints": 12500,
          "cancelledMemoryMilliseconds": 3600000
        },
        "unitCeiling": {
          "description": "The most one compile unit may hold at its peak so that it fits a 16 GB worker that also runs its own stage. `carving` is the closed list of units known to exceed it, each with its measured peak and the reduction it waits for; the list may only shrink.",
          "megabytes": 4096,
          "hostMegabytes": 16384,
          "carving": [
            {
              "crate": "semio_hub_cad_component",
              "target": "wasm32-wasip2",
              "measuredMegabytes": 6550,
              "action": "thin-lto-closure"
            },
            {
              "crate": "semio_hub_puzzle_component",
              "target": "wasm32-wasip2",
              "measuredMegabytes": 6148,
              "action": "thin-lto-closure"
            },
            {
              "crate": "semio_s_artifact_stdio_dwg_snapshot_objects",
              "target": "wasm32-unknown-unknown",
              "measuredMegabytes": 4894,
              "action": "split-families"
            }
          ]
        }
      }
    },
    "UnitCeilingVerdictV1": {
      "description": "The unit ceiling applied to recorded observations: every unit above the ceiling (listed on the carving list or not), every carving entry that no longer exceeds it, and whether the ledger is within the law.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ceilingMegabytes",
        "exceeded",
        "resolved",
        "ok"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "ceilingMegabytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "exceeded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "crate",
              "target",
              "peakMegabytes",
              "listed"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "crate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "peakMegabytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "listed": {
                "type": "boolean"
              }
            }
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "crate",
              "target",
              "peakMegabytes"
            ],
            "properties": {
              "crate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "peakMegabytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "ok": {
          "type": "boolean"
        }
      }
    },
    "Messages": {
      "const": {
        "en": {
          "held": {
            "available": "unit {unit} is held back: it needs about {predicted} MB, the host has {available} MB available with a margin of {margin} MB (warden level {level}); waited {seconds} s",
            "warden": "unit {unit} is held back: the host warden is at level {level} ({available} MB available, it needs about {predicted} MB); waited {seconds} s",
            "cancelled": "unit {unit} was cancelled by the host warden before and is held back until it fits: it needs about {predicted} MB, the host has {available} MB available with a margin of {margin} MB (warden level {level}); waited {seconds} s"
          },
          "unitCeiling": {
            "exceeded": "unit {key} peaked at {peak} MB, above the unit ceiling of {ceiling} MB (16 GB class); it is not on the carving list: reduce it or declare it",
            "resolved": "carving entry {crate} now peaks at {peak} MB, at or below the ceiling of {ceiling} MB: remove it from the carving list"
          }
        },
        "de": {
          "held": {
            "available": "Einheit {unit} wird zurückgehalten: sie braucht etwa {predicted} MB, der Host hat {available} MB verfügbar bei einem Abstand von {margin} MB (Warden-Stufe {level}); {seconds} s gewartet",
            "warden": "Einheit {unit} wird zurückgehalten: der Host-Warden steht auf Stufe {level} ({available} MB verfügbar, sie braucht etwa {predicted} MB); {seconds} s gewartet",
            "cancelled": "Einheit {unit} wurde zuvor vom Host-Warden abgebrochen und wird zurückgehalten, bis sie passt: sie braucht etwa {predicted} MB, der Host hat {available} MB verfügbar bei einem Abstand von {margin} MB (Warden-Stufe {level}); {seconds} s gewartet"
          },
          "unitCeiling": {
            "exceeded": "Einheit {key} erreichte {peak} MB und liegt über der Einheiten-Obergrenze von {ceiling} MB (16-GB-Klasse); sie steht nicht auf der Carving-Liste: verkleinern oder eintragen",
            "resolved": "Carving-Eintrag {crate} erreicht jetzt {peak} MB, höchstens die Obergrenze von {ceiling} MB: aus der Carving-Liste entfernen"
          }
        }
      }
    },
    "Path": {
      "type": "string",
      "maxLength": 4096
    },
    "AdmitRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op",
        "pass",
        "pid",
        "crate",
        "package",
        "version",
        "target",
        "crateTypes",
        "outDir",
        "extraFilename",
        "source",
        "manifestDir",
        "primary",
        "buildScriptOutDir",
        "externs"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op": {
          "const": "admit"
        },
        "pass": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "crate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,128}$"
        },
        "package": {
          "type": "string",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "maxLength": 128
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "crateTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "lib",
              "rlib",
              "dylib",
              "cdylib",
              "staticlib",
              "proc-macro",
              "bin"
            ]
          }
        },
        "outDir": {
          "$ref": "#/definitions/Path"
        },
        "extraFilename": {
          "type": "string",
          "maxLength": 128
        },
        "source": {
          "$ref": "#/definitions/Path"
        },
        "manifestDir": {
          "$ref": "#/definitions/Path"
        },
        "primary": {
          "type": "boolean"
        },
        "buildScriptOutDir": {
          "anyOf": [
            {
              "$ref": "#/definitions/Path"
            },
            {
              "type": "null"
            }
          ]
        },
        "externs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Path"
          }
        }
      }
    },
    "ProvenanceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peakRssBytes", "userMs", "sysMs", "wallMs", "rmetaOffsetMs"],
      "properties": {
        "peakRssBytes": {"type": "integer", "minimum": 0},
        "userMs": {"type": "integer", "minimum": 0},
        "sysMs": {"type": "integer", "minimum": 0},
        "wallMs": {"type": "integer", "minimum": 0},
        "rmetaOffsetMs": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
      }
    },
    "CachedRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "op", "pass", "pid", "crate", "package", "version", "target", "crateTypes", "outDir", "extraFilename", "source", "manifestDir", "primary", "buildScriptOutDir", "externs", "cacheKey", "provenance"],
      "properties": {
        "v": {"const": 1},
        "op": {"const": "cached"},
        "pass": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
        "pid": {"type": "integer", "minimum": 1},
        "crate": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,128}$"},
        "package": {"type": "string", "maxLength": 128},
        "version": {"type": "string", "maxLength": 128},
        "target": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
        "crateTypes": {"type": "array", "minItems": 1, "items": {"enum": ["lib", "rlib", "dylib", "cdylib", "staticlib", "proc-macro", "bin"]}},
        "outDir": {"$ref": "#/definitions/Path"},
        "extraFilename": {"type": "string", "maxLength": 128},
        "source": {"$ref": "#/definitions/Path"},
        "manifestDir": {"$ref": "#/definitions/Path"},
        "primary": {"type": "boolean"},
        "buildScriptOutDir": {"anyOf": [{"$ref": "#/definitions/Path"}, {"type": "null"}]},
        "externs": {"type": "array", "items": {"$ref": "#/definitions/Path"}},
        "cacheKey": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provenance": {"anyOf": [{"$ref": "#/definitions/ProvenanceV1"}, {"type": "null"}]}
      }
    },
    "HeadroomV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op",
        "wait"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op": {
          "const": "headroom"
        },
        "wait": {
          "type": "boolean"
        }
      }
    },
    "RecallRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "op", "pass", "crate", "outDir", "extraFilename"],
      "properties": {
        "v": {"const": 1},
        "op": {"const": "recall"},
        "pass": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
        "crate": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,128}$"},
        "outDir": {"$ref": "#/definitions/Path"},
        "extraFilename": {"type": "string", "maxLength": 128}
      }
    },
    "VerdictV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op",
        "admitted"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op": {
          "const": "verdict"
        },
        "admitted": {
          "type": "boolean"
        }
      }
    },
    "RssReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op",
        "bytes",
        "chargedBytes"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op": {
          "const": "rss"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "chargedBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DoneReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op",
        "exit",
        "peakRssBytes",
        "userMs",
        "sysMs",
        "startMs",
        "endMs",
        "rmetaMs"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op": {
          "const": "done"
        },
        "exit": {
          "type": "integer"
        },
        "peakRssBytes": {
          "type": "integer",
          "minimum": 0
        },
        "userMs": {
          "type": "integer",
          "minimum": 0
        },
        "sysMs": {
          "type": "integer",
          "minimum": 0
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "rmetaMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObservationV1": {
      "description": "One observation of a unit key, one newline-terminated JSON line of units.jsonl; the unterminated tail of the file is an interrupted append and is dropped. Identity is (key, atMs): a later row of the same identity (the end-of-run refinement with the critical-path remainingMs) replaces an earlier one (the row appended when the unit completed, remainingMs = wallMs).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "key",
        "peakRssBytes",
        "outputBytes",
        "wallMs",
        "cpuMs",
        "remainingMs",
        "atMs"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "peakRssBytes": {
          "type": "integer",
          "minimum": 0
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "wallMs": {
          "type": "integer",
          "minimum": 0
        },
        "cpuMs": {
          "type": "integer",
          "minimum": 0
        },
        "remainingMs": {
          "type": "integer",
          "minimum": 0
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "MemoryCapacityV1": {
      "description": "Actual physical memory and process memory constraint; zero constraint means unknown or unbounded. Effective capacity is their minimum when constraint is positive, independent of transient free memory.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalBytes",
        "constrainedBytes"
      ],
      "properties": {
        "physicalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "constrainedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "MemoryShareV1": {
      "description": "Allocate the admitted CPU fraction only after effective memory and unchanged policy reserve. Never reconstruct above effective capacity when capacity is below reserve.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectiveBytes",
        "tokens",
        "parallelism"
      ],
      "properties": {
        "effectiveBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "SchedulerSelectionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "args"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "args": {
          "type": "array",
          "minItems": 6,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
