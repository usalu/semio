{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.build/AdmissionV1",
  "title": "Memory-aware rustc admission: policy, wrapper wire protocol and recorded unit observations",
  "definitions": {
    "Policy": {
      "const": {
        "version": 1,
        "reserveBytes": 6442450944,
        "floorBytes": 268435456,
        "coldBaseBytes": 644245094,
        "coldBytesPerKloc": 41943040,
        "componentFinalBytes": 6442450944,
        "headroom": 1.15,
        "quantile": 0.95,
        "window": 8,
        "swapOutBytesPerSecond": 67108864,
        "resumeFraction": 0.9,
        "nonRustcWindowMs": 10000,
        "brokerEnvironment": "SEMIO_BUILD_BROKER",
        "passEnvironment": "SEMIO_BUILD_PASS",
        "storeNamespace": "semio.build-telemetry/v1",
        "storeDirectory": "build-telemetry",
        "storeFile": "units.jsonl",
        "sourceExtension": ".rs",
        "sourceSkipDirectories": [
          "target",
          "node_modules",
          "dist",
          ".git"
        ]
      }
    },
    "Path": {
      "type": "string",
      "maxLength": 4096
    },
    "AdmitRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op",
        "pass",
        "pid",
        "crate",
        "package",
        "version",
        "target",
        "crateTypes",
        "outDir",
        "extraFilename",
        "source",
        "manifestDir",
        "primary",
        "buildScriptOutDir",
        "externs"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op": {
          "const": "admit"
        },
        "pass": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "crate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,128}$"
        },
        "package": {
          "type": "string",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "maxLength": 128
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "crateTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "lib",
              "rlib",
              "dylib",
              "cdylib",
              "staticlib",
              "proc-macro",
              "bin"
            ]
          }
        },
        "outDir": {
          "$ref": "#/definitions/Path"
        },
        "extraFilename": {
          "type": "string",
          "maxLength": 128
        },
        "source": {
          "$ref": "#/definitions/Path"
        },
        "manifestDir": {
          "$ref": "#/definitions/Path"
        },
        "primary": {
          "type": "boolean"
        },
        "buildScriptOutDir": {
          "anyOf": [
            {
              "$ref": "#/definitions/Path"
            },
            {
              "type": "null"
            }
          ]
        },
        "externs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Path"
          }
        }
      }
    },
    "VerdictV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op",
        "admitted"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op": {
          "const": "verdict"
        },
        "admitted": {
          "type": "boolean"
        }
      }
    },
    "RssReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op",
        "bytes"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op": {
          "const": "rss"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DoneReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "op",
        "exit",
        "peakRssBytes",
        "userMs",
        "sysMs",
        "startMs",
        "endMs",
        "rmetaMs"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "op": {
          "const": "done"
        },
        "exit": {
          "type": "integer"
        },
        "peakRssBytes": {
          "type": "integer",
          "minimum": 0
        },
        "userMs": {
          "type": "integer",
          "minimum": 0
        },
        "sysMs": {
          "type": "integer",
          "minimum": 0
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "rmetaMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ObservationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "key",
        "peakRssBytes",
        "outputBytes",
        "wallMs",
        "cpuMs",
        "remainingMs",
        "atMs"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "peakRssBytes": {
          "type": "integer",
          "minimum": 0
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "wallMs": {
          "type": "integer",
          "minimum": 0
        },
        "cpuMs": {
          "type": "integer",
          "minimum": 0
        },
        "remainingMs": {
          "type": "integer",
          "minimum": 0
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "MemoryCapacityV1": {
      "description": "Actual physical memory and process memory constraint; zero constraint means unknown or unbounded. Effective capacity is their minimum when constraint is positive, independent of transient free memory.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalBytes",
        "constrainedBytes"
      ],
      "properties": {
        "physicalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "constrainedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "MemoryShareV1": {
      "description": "Allocate the admitted CPU fraction only after effective memory and unchanged policy reserve. Never reconstruct above effective capacity when capacity is below reserve.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectiveBytes",
        "tokens",
        "parallelism"
      ],
      "properties": {
        "effectiveBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
