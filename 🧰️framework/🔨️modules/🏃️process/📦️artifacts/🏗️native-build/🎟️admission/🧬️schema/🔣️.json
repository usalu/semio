          "type": "integer",
          "minimum": 0
        },
        "atMs": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "description": "The Rust source lines of the unit's crate directory when it was observed: the input size the peak was measured for. A forecast only uses rows whose size is within the policy tolerance of the unit's current size; rows without it are stale.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "MemoryCapacityV1": {
      "description": "Actual physical memory and process memory constraint; zero constraint means unknown or unbounded. Effective capacity is their minimum when constraint is positive, independent of transient free memory.",
