    "Messages": {
      "const": {
        "en": {
          "held": {
            "available": "unit {unit} is held back: it needs about {predicted} MB, the host has {available} MB available with a margin of {margin} MB (warden level {level}); waited {seconds} s",
            "warden": "unit {unit} is held back: the host warden is at level {level} ({available} MB available, it needs about {predicted} MB); waited {seconds} s",
            "swap": "unit {unit} is held back: the host is actively swapping (it needs about {predicted} MB); waited {seconds} s",
            "cancelled": "unit {unit} was cancelled by the host warden before and is held back until it fits: it needs about {predicted} MB, the host has {available} MB available with a margin of {margin} MB (warden level {level}); waited {seconds} s"
          },
          "unitCeiling": {
            "kinds": {
              "library": "library",
              "final": "final link"
            },
            "exceeded": "unit {key} peaked at {peak} MB, above the {kind} budget of {budget} MB ({class} worker class); it is not on the carving list: carve it along the domain taxonomy or declare it",
            "cold": "unit {key} has no measured peak and its cold estimate is {peak} MB, above the {kind} budget of {budget} MB ({class} worker class): carve it before it builds on a small worker",
            "resolved": "carving entry {crate} now peaks at {peak} MB, within its budget of {budget} MB: remove it from the carving list"
          }
        },
        "de": {
          "held": {
            "available": "Einheit {unit} wird zurückgehalten: sie braucht etwa {predicted} MB, der Host hat {available} MB verfügbar bei einem Abstand von {margin} MB (Warden-Stufe {level}); {seconds} s gewartet",
            "warden": "Einheit {unit} wird zurückgehalten: der Host-Warden steht auf Stufe {level} ({available} MB verfügbar, sie braucht etwa {predicted} MB); {seconds} s gewartet",
            "swap": "Einheit {unit} wird zurückgehalten: der Host lagert aktiv Speicher aus (die Einheit braucht etwa {predicted} MB); {seconds} s gewartet",
            "cancelled": "Einheit {unit} wurde zuvor vom Host-Warden abgebrochen und wird zurückgehalten, bis sie passt: sie braucht etwa {predicted} MB, der Host hat {available} MB verfügbar bei einem Abstand von {margin} MB (Warden-Stufe {level}); {seconds} s gewartet"
          },
          "unitCeiling": {
            "kinds": {
              "library": "Bibliothek",
              "final": "Final-Link"
            },
            "exceeded": "Einheit {key} erreichte {peak} MB und liegt über dem Budget {kind} von {budget} MB (Worker-Klasse {class}); sie steht nicht auf der Carving-Liste: entlang der Domänen-Taxonomie schneiden oder eintragen",
            "cold": "Einheit {key} hat keinen gemessenen Spitzenwert und ihre Kaltschätzung beträgt {peak} MB, über dem Budget {kind} von {budget} MB (Worker-Klasse {class}): schneiden, bevor sie auf einem kleinen Worker gebaut wird",
            "resolved": "Carving-Eintrag {crate} erreicht jetzt {peak} MB, innerhalb seines Budgets von {budget} MB: aus der Carving-Liste entfernen"
          }
        }
      }
