{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schemas/native-build/admission/ceiling-cancel-corpus.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key", "exit", "peakRssBytes", "cache", "recorded"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "exit": { "type": "integer", "minimum": 0, "maximum": 255 },
          "peakRssBytes": { "type": "integer", "minimum": 0 },
          "cache": { "type": "boolean" },
          "recorded": { "type": "boolean", "description": "Whether the unit supplies a forecast observation: a successful compile, or a unit the warden cancelled above its runtime ceiling." }
        }
      }
    }
  }
}
