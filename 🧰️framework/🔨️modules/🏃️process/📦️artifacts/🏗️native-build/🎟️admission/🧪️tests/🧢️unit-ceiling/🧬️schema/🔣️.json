{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://repo.build/UnitCeilingCorpusV1",
  "title": "Unit ceiling corpus: ledger rows per case",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "peakRssBytes"],
              "properties": {
                "key": { "type": "string" },
                "peakRssBytes": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
