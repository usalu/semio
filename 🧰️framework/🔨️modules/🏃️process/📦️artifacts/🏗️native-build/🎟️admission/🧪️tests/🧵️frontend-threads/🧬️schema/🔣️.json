{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:build:frontend-threads-corpus:v1",
  "title": "Front-End Thread Bound Corpus",
  "description": "Language-agnostic cases of the rustc front-end thread bound: the arguments of a compile, the parallelism the run was admitted (absent or 0 when none) and the arguments the scheduler must hand to rustc.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "args",
          "tokens",
          "note",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}