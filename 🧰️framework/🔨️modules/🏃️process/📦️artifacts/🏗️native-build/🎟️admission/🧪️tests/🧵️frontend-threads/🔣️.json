    "-Z",
    "threads=0",
    "a.rs"
   ],
   "tokens": 8,
   "note": "a cdylib final gets one front-end thread whatever the grant; with 8 granted cores its back end still runs serial",
   "expected": [
    "--crate-type",
    "cdylib",
    "-Z",
    "threads=1",
    "a.rs",
    "-Z",
    "no-parallel-backend"
   ]
  },
  {
   "id": "cdylib-final-joined",
   "args": [
    "--crate-type=cdylib",
    "-Zthreads=4",
    "a.rs"
   ],
   "tokens": 8,
   "note": "the joined crate-type spelling is a cdylib final too; its back end runs serial too",
   "expected": [
    "--crate-type=cdylib",
    "-Zthreads=1",
    "a.rs",
    "-Z",
    "no-parallel-backend"
   ]
  },
  {
   "id": "lib-keeps-grant",
   "args": [
    "--crate-type",
    "lib",
    "-Z",
    "threads=0",
    "a.rs"
   ],
   "tokens": 8,
   "note": "a library keeps the admitted grant",
   "expected": [
    "--crate-type",
    "lib",
    "-Z",
    "threads=8",
    "a.rs"
   ]
  },
  {
   "id": "cdylib-no-grant",
   "args": [
    "--crate-type",
    "cdylib",
    "-Z",
    "threads=0"
   ],
   "tokens": null,
   "note": "without a positive admission the compiler uses one front-end thread",
   "expected": [
    "--crate-type",
    "cdylib",
    "-Z",
    "threads=1",
    "-Z",
    "no-parallel-backend"
   ]
  },
  {
   "id": "cdylib-one-job",
   "args": [
    "--crate-type",
    "cdylib",
    "-Z",
    "threads=0",
    "a.rs"
   ],
   "tokens": 1,
   "note": "one admitted job leaves rustc no token beside its implicit slot, so its back end stays serial",
   "expected": [
    "--crate-type",
    "cdylib",
    "-Z",
    "threads=1",
    "a.rs",
    "-Z",
    "no-parallel-backend"
   ]
  },
  {
   "id": "cdylib-two-jobs",
   "args": [
    "--crate-type=cdylib",
    "-Zthreads=0",
    "a.rs"
   ],
   "tokens": 2,
   "note": "two admitted jobs still run the back end serial: a final is bounded by memory, not by idle tokens",
   "expected": [
    "--crate-type=cdylib",
    "-Zthreads=1",
    "a.rs",
    "-Z",
    "no-parallel-backend"
   ]
  },
  {
   "id": "stable-cdylib-no-grant",
   "args": [
    "--crate-type",
    "cdylib",
