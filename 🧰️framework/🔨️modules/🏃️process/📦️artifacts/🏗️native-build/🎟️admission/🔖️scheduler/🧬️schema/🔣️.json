{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Protocol": {
      "const": {"version": 1, "file": ".semio-build-scheduler.json", "maximumReceiptBytes": 65536, "maximumInputBytes": 4194304, "environmentPrefixes": ["CARGO_", "RUST"]}
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "identity", "inputs", "executables"],
      "properties": {
        "version": {"const": 1},
        "identity": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "inputs": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 1024}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
        "executables": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["name", "path", "size", "ino", "mtimeNs"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "path": {"type": "string", "minLength": 1, "maxLength": 1024}, "size": {"type": "integer", "minimum": 1}, "ino": {"type": "string", "pattern": "^[0-9]+$"}, "mtimeNs": {"type": "string", "pattern": "^[0-9]+$"}}}}
      }
    }
  }
}
