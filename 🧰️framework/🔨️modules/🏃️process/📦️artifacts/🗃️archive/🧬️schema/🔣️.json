{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Request",
  "definitions": {
    "Policy": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "maximumCompressedBytes", "maximumInflatedBytes", "maximumEntries", "maximumFileBytes", "maximumPathBytes", "maximumMetadataBytes", "progressEntries"],
      "properties": {
        "version": {"const": 1},
        "maximumCompressedBytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "maximumInflatedBytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "maximumEntries": {"type": "integer", "minimum": 1, "maximum": 4096},
        "maximumFileBytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "maximumPathBytes": {"type": "integer", "minimum": 1, "maximum": 256},
        "maximumMetadataBytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "progressEntries": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "Request": {
      "type": "object", "additionalProperties": false, "required": ["version", "format", "prefix", "policy"],
      "properties": {
        "version": {"const": 1}, "format": {"enum": ["tar.gz", "zip"]},
        "prefix": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64}]},
        "policy": {"$ref": "#/definitions/Policy"}
      }
    }
  }
}
