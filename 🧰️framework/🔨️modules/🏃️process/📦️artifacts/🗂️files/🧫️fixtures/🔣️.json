{
  "schema": "semio.framework.process.artifact-files/v1",
  "writes": [
    { "name": "byte-identical", "initial": "stable generated bytes\n", "next": "stable generated bytes\n", "rewritten": false },
    { "name": "changed", "initial": "stale generated bytes\n", "next": "current generated bytes\n", "rewritten": true },
    { "name": "unicode", "initial": "🌿 Ä\n", "next": "🌿 Ä\n", "rewritten": false },
    { "name": "empty", "initial": "stale", "next": "", "rewritten": true }
  ],
  "collections": [
    { "name": "empty", "files": {}, "ordered": [] },
    { "name": "portable-order", "files": { "z.txt": "last", "nested/b.bin": "binary", ".hidden": "hidden", "nested/a.txt": "first", "ä.txt": "unicode" }, "ordered": [".hidden", "nested/a.txt", "nested/b.bin", "z.txt", "ä.txt"] }
  ],
  "refusals": ["generated-directory", "generated-link", "artifact-file-root", "artifact-link-root", "artifact-link-child", "cancelled-before-walk"]
}
