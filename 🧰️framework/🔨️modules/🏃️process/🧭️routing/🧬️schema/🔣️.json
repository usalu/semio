{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:framework:process:command-routing:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "mainCases",
    "workspaceCases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "commands",
          "requests",
          "parallel",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "mode",
                "refuse"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]+(?:-[a-z]+)*$"
                },
                "mode": {
                  "enum": [
                    "eager",
                    "lazy"
                  ]
                },
                "refuse": {
                  "type": "boolean"
                }
              }
            }
          },
          "requests": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "parallel": {
            "type": "boolean"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trace",
              "rejected"
            ],
            "properties": {
              "trace": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rejected": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "mainCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "commands",
          "argv",
          "defaultCommand",
          "interception",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultCommand": {
            "type": [
              "string",
              "null"
            ]
          },
          "interception": {
            "enum": [
              "continue",
              "consume",
              "refuse",
              "none"
            ]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trace",
              "rejected"
            ],
            "properties": {
              "trace": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rejected": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "workspaceCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "markers",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "minLength": 1
          },
          "markers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "directory",
                "files"
              ],
              "properties": {
                "directory": {
                  "type": "string"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "nx.json",
                      "package.json"
                    ]
                  }
                }
              }
            }
          },
          "expected": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
