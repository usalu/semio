{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workspace",
    "store",
    "vitest",
    "runtime",
    "coverageRuntime",
    "python",
    "nextest",
    "nextestConfig",
    "buildBudgetMs",
    "commandBudgetMs",
    "maximumOutputBytes",
    "assertionBudgets",
    "assertionThreads",
    "rustMinStack",
    "workspaceManifest"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]*$"
    },
    "store": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]*$"
    },
    "vitest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]*$"
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]*$"
    },
    "coverageRuntime": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]*$"
    },
    "python": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]*$"
    },
    "nextest": {
      "type": "boolean"
    },
    "nextestConfig": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]*$"
    },
    "buildBudgetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "commandBudgetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maximumOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "assertionBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fundamental",
        "quick",
        "long",
        "exhaustive"
      ],
      "properties": {
        "fundamental": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "long": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exhaustive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "assertionThreads": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "const": "available-minus-quarter"
        }
      ]
    },
    "rustMinStack": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "workspaceManifest": {
      "type": "string",
      "minLength": 1
    }
  }
}
