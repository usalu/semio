{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workspace Identity Cases",
  "type": "object",
  "required": [
    "schemaVersion",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "files",
          "start",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "start": {
            "type": "string"
          },
          "expected": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
