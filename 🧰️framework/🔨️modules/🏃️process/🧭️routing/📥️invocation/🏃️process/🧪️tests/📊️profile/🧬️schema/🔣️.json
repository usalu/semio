{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:script:neutral-build-profile:test",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "neutralName",
    "retiredName",
    "consumers",
    "cases"
  ],
  "properties": {
    "neutralName": {
      "const": "SEMIO_BUILD_PROFILE_INPUTS"
    },
    "retiredName": {
      "const": "SEMIO_NX_PROFILE_INPUTS"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "neutral",
          "retired",
          "enabled"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "neutral": {
            "type": [
              "string",
              "null"
            ]
          },
          "retired": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
