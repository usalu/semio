{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "holders",
    "samplers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "holders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "idleMilliseconds",
          "maximumMilliseconds",
          "beatEveryMilliseconds",
          "workMilliseconds",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "idleMilliseconds": {
            "type": "integer",
            "minimum": 1
          },
          "maximumMilliseconds": {
            "type": "integer",
            "minimum": 1
          },
          "beatEveryMilliseconds": {
            "type": "integer",
            "minimum": 0
          },
          "workMilliseconds": {
            "type": "integer",
            "minimum": 1
          },
          "expected": {
            "enum": [
              "kept",
              "reclaimed"
            ]
          }
        }
      }
    },
    "samplers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intervalMilliseconds",
          "firstSampleMilliseconds",
          "observeMilliseconds",
          "fails",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "intervalMilliseconds": {
            "type": "integer",
            "minimum": 1
          },
          "firstSampleMilliseconds": {
            "type": "integer",
            "minimum": 1
          },
          "observeMilliseconds": {
            "type": "integer",
            "minimum": 1
          },
          "fails": {
            "type": "boolean"
          },
          "expected": {
            "enum": [
              "success",
              "failure"
            ]
          }
        }
      }
    }
  }
}
