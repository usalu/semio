{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policy",
    "deadlineEpochMilliseconds",
    "capabilities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "policy": {
      "$ref": "urn:semio:framework:process:script-policy"
    },
    "deadlineEpochMilliseconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "capabilities": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "policy": {
          "type": "object",
          "properties": {
            "maximumElapsedMilliseconds": {
              "type": "integer",
              "const": 0
            }
          }
        },
        "deadlineEpochMilliseconds": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "policy": {
          "type": "object",
          "properties": {
            "maximumElapsedMilliseconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "deadlineEpochMilliseconds": {
          "type": "integer"
        }
      }
    }
  ],
  "definitions": {
    "ControlDescendant": {
      "const": {
        "version": 1,
        "purpose": "exact-issued-control-lineage",
        "includeSelf": true,
        "liveIssuance": true,
        "relation": "private-parent-control",
        "restrictionEquivalence": false
      }
    },
    "DeadlineTimer": {
      "const": {
        "renewable": false,
        "retiredCallbacks": "refused",
        "finiteRemaining": "minimum-wall-and-monotonic",
        "maximumChunkSource": "semio.framework.process.execution-budget/v1#/$defs/TimerMaximumMilliseconds"
      }
    },
    "DeadlineTimerCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "remaining",
        "unref",
        "expectedDelays",
        "expectedExpirations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "remaining": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "unref": {
          "type": "boolean"
        },
        "cancelBeforeCheck": {
          "type": "integer",
          "minimum": 0
        },
        "expectedDelays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "expectedExpirations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "PhysicalBodyTimerRetirement": {
      "const": {
        "scheduled": 4,
        "bodyRetired": 2,
        "wholeRetained": 2,
        "staleCallbackAborts": false,
        "staleCallbackRearms": false
      }
    }
  }
}
