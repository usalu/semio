{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "const": {
    "version": 1,
    "purpose": "neutral-long-activity-message",
    "minimumElapsedMilliseconds": 15000,
    "secondsRounding": "nearest-integer",
    "template": "{command} remains active on {resource} ({mode}, {seconds} s)",
    "sourceProvider": {
      "resourcePrefix": "javascript-source-provider:",
      "minimumPublicationMilliseconds": 250,
      "maximumCompleted": 65536,
      "counterPattern": "^(?:0|[1-9][0-9]*)$",
      "maximumResourceCharacters": 64,
      "maximumCommandCharacters": 256,
      "commandPattern": "^[A-Za-z0-9:_/.-]+$",
      "labels": {
        "en": "{command} · Checking declared package providers: {completed} edges",
        "de": "{command} · Deklarierte Paketanbieter prüfen: {completed} Kanten"
      },
      "scope": "original-process-presentation-only",
      "flush": ["resource-change", "phase-change", "counter-reset", "clock-refusal", "settlement"],
      "preserved": ["all-original-publish-calls", "all-guards", "all-yields", "command-streams", "errors", "semantic-receipts"]
    },
    "sourceAdmission": {
      "resourcePrefix": "cargo:source-admission:",
      "maximumResourceCharacters": 1024,
      "maximumCommandCharacters": 256,
      "systemVariables": [
        "SEMIO_DASHBOARD_LOCALE",
        "LC_ALL",
        "LC_MESSAGES",
        "LANG"
      ],
      "fallback": [
        "en",
        "de"
      ],
      "labels": {
        "en": {
          "template": "{command} · {phase}: {unit}/{units} {package} · {reads} reads · {files} files · {bytes} bytes",
          "phases": {
            "cfg": "Checking source configuration",
            "read": "Reading sources",
            "complete": "Source admitted"
          }
        },
        "de": {
          "template": "{command} · {phase}: {unit}/{units} {package} · {reads} Lesevorgänge · {files} Dateien · {bytes} Bytes",
          "phases": {
            "cfg": "Quellkonfiguration prüfen",
            "read": "Quellen lesen",
            "complete": "Quellen zugelassen"
          }
        }
      }
    },
    "parserSource": {
      "resourcePrefix": "build:parser-source:",
      "maximumResourceCharacters": 128,
      "maximumCommandCharacters": 256,
      "maximumCompleted": 9007199254740991,
      "completedPattern": "^[1-9][0-9]*$",
      "commandPattern": "^[A-Za-z0-9:_/.-]+$",
      "labels": {
        "en": {
          "template": "{command} · {operation}: {completed} {units}",
          "units": "operations",
          "operations": {
            "state": "Inspecting source metadata",
            "list": "Listing source entries",
            "readText": "Reading source text",
            "membership": "Checking source membership",
            "frontier": "Rechecking source evidence",
            "selection": "Checking source selection",
            "publication": "Verifying source publication"
          }
        },
        "de": {
          "template": "{command} · {operation}: {completed} {units}",
          "units": "Vorgänge",
          "operations": {
            "state": "Quellmetadaten prüfen",
            "list": "Quelleinträge auflisten",
            "readText": "Quelltext lesen",
            "membership": "Quellzugehörigkeit prüfen",
            "frontier": "Quellnachweise erneut prüfen",
            "selection": "Quellauswahl prüfen",
            "publication": "Quellveröffentlichung prüfen"
          }
        }
      }
    },
    "queueWait": {
      "resourcePrefix": "lease-queue:",
      "maximumResourceCharacters": 1024,
      "maximumCommandCharacters": 256,
      "commandPattern": "^[A-Za-z0-9:_/.-]+$",
      "labels": {
        "en": {
          "template": "{command} · Waiting for access to {resource} ({mode}): position {position} of {queued}, behind the request of process {holderPid} ({holderMode}, queued {holderSeconds} s ago)",
          "modes": {
            "shared": "shared",
            "exclusive": "exclusive"
          }
        },
        "de": {
          "template": "{command} · Wartet auf Zugriff auf {resource} ({mode}): Position {position} von {queued}, hinter der Anfrage von Prozess {holderPid} ({holderMode}, seit {holderSeconds} s eingereiht)",
          "modes": {
            "shared": "geteilt",
            "exclusive": "exklusiv"
          }
        }
      }
    }
  },
  "definitions": {
    "ProviderClockCases": {
      "type": "array",
      "items": {
        "type":"object","additionalProperties":false,"required":["name","steps","expected"],
        "properties": {
          "name":{"type":"string","minLength":1},
          "steps":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["at","count","kind"],"properties":{"at":{"type":"number","minimum":0},"elapsed":{"type":"number","minimum":0},"count":{"type":"integer","minimum":0,"maximum":65536},"kind":{"enum":["provider","other","complete"]}}}},
          "expected":{"type":"array","items":{"type":"string"}}
        }
      }
    },
    "SourceCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "environment",
          "resource",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resource": {
            "type": "string"
          },
          "expected": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "ParserCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "environment",
          "resource",
          "command",
          "mode",
          "elapsedMs",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resource": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "shared",
              "exclusive"
            ]
          },
          "elapsedMs": {
            "type": "number"
          },
          "expected": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "QueueWait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "position",
        "queued",
        "holderMode",
        "holderPid",
        "holderSeconds",
        "resource"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "position": {
          "type": "integer",
          "minimum": 2,
          "maximum": 999999
        },
        "queued": {
          "type": "integer",
          "minimum": 2,
          "maximum": 999999
        },
        "holderMode": {
          "enum": [
            "shared",
            "exclusive"
          ]
        },
        "holderPid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999999
        },
        "holderSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 401
        }
      }
    },
    "QueueCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "environment",
          "resource",
          "command",
          "mode",
          "elapsedMs",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resource": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "shared",
              "exclusive"
            ]
          },
          "elapsedMs": {
            "type": "number"
          },
          "expected": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
