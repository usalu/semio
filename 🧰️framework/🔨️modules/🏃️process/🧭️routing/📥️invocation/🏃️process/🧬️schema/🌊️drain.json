{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "hops", "expected"],
        "properties": {
          "scope": {"enum": ["process", "control"]},
          "hops": {"type": "integer", "minimum": 0, "maximum": 8},
          "expected": {"enum": ["joined", "joined-or-refused"]}
        }
      }
    }
  }
}
