{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:framework:process:accepted-physical-cleanup-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "resource", "reserveMilliseconds"],
  "properties": {
    "version": {"const": 1},
    "kind": {"const": "native-image"},
    "resource": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$"},
    "reserveMilliseconds": {"type": "integer", "minimum": 1, "maximum": 60000}
  }
}
