{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema://process.routing/OriginalResourceControlRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "command",
    "maximumElapsedMilliseconds"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "maximumElapsedMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
