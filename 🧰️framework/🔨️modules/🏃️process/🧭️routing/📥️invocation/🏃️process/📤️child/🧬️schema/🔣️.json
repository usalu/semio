{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "baseMilliseconds",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "baseMilliseconds": {
      "const": 20000
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestedMilliseconds",
          "expectedMaximum"
        ],
        "properties": {
          "requestedMilliseconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 40000
          },
          "expectedMaximum": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000
          }
        }
      }
    }
  }
}
