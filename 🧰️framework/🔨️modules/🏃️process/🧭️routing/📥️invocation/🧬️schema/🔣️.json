{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:framework:process:script-policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "owner",
    "maximumElapsedMilliseconds"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "maximumElapsedMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    }
  }
}
