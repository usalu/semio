{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "cancelAtLoad", "trace", "rejected"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "cancelAtLoad": { "type": "boolean" },
    "trace": { "type": "array", "items": { "enum": ["load", "run"] } },
    "rejected": { "type": "boolean" }
  }
}
