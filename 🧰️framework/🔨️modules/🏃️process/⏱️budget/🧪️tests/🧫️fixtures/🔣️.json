    { "name": "infinite", "environment": { "SEMIO_ORCHESTRATOR_BUDGET_MS": "Infinity" }, "expected": null },
    { "name": "text", "environment": { "SEMIO_DAEMON_BUDGET_MS": "not-number" }, "expected": null },
