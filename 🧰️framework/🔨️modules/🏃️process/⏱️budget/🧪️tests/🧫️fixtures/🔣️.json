{
  "schema": "semio.framework.process.execution-budget/v1",
  "cases": [
    {
      "name": "default",
      "environment": {},
      "expected": {
        "build": 0,
        "command": 0,
        "orchestrator": 0,
        "daemon": 0
      }
    },
    {
      "name": "build",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "15000"
      },
      "expected": {
        "build": 15000,
        "command": 0,
        "orchestrator": 0,
        "daemon": 0
      }
    },
    {
      "name": "command-exponent",
      "environment": {
        "SEMIO_CMD_BUDGET_MS": "12e2"
      },
      "expected": {
        "build": 0,
        "command": 1200,
        "orchestrator": 0,
        "daemon": 0
      }
    },
    {
      "name": "explicit-zero-and-daemon",
      "environment": {
        "SEMIO_ORCHESTRATOR_BUDGET_MS": "0",
        "SEMIO_DAEMON_BUDGET_MS": "45000"
      },
      "expected": {
        "build": 0,
        "command": 0,
        "orchestrator": 0,
        "daemon": 45000
      }
    },
    {
      "name": "blank-keeps-zero",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": " "
      },
      "expected": {
        "build": 0,
        "command": 0,
        "orchestrator": 0,
        "daemon": 0
      }
    },
    {
      "name": "negative",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "-1"
      },
      "expected": null
    },
    {
      "name": "fractional",
      "environment": {
        "SEMIO_CMD_BUDGET_MS": "1.5"
      },
      "expected": null
    },
    {
      "name": "infinite",
      "environment": {
        "SEMIO_ORCHESTRATOR_BUDGET_MS": "Infinity"
      },
      "expected": null
    },
    {
      "name": "text",
      "environment": {
        "SEMIO_DAEMON_BUDGET_MS": "not-number"
      },
      "expected": null
    },
    {
      "name": "unsafe-integer",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "9007199254740992"
      },
      "expected": null
    }
  ],
  "preparation": [
    {
      "name": "default-finite-preparation",
      "environment": {},
      "expected": 21600000
    },
    {
      "name": "ordinary-unbounded-finite-preparation",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "0"
      },
      "expected": 21600000
    },
    {
      "name": "explicit-smaller-preparation",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "1200"
      },
      "expected": 1200
    },
    {
      "name": "explicit-larger-preparation",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "28800000"
      },
      "expected": 28800000
    },
    {
      "name": "invalid-preparation",
      "environment": {
        "SEMIO_BUILD_BUDGET_MS": "no"
      },
      "expected": null
    }
  ],
  "timers": [
    {
      "name": "unbounded",
      "budget": 0,
      "checks": [
        100
      ],
      "expectedDelays": [],
      "expectedExpirations": 0
    },
    {
      "name": "ordinary",
      "budget": 1200,
      "checks": [
        1200
      ],
      "expectedDelays": [
        1200
      ],
      "expectedExpirations": 1
    },
    {
      "name": "maximum-native-timer",
      "budget": 2147483647,
      "checks": [
        2147483647
      ],
      "expectedDelays": [
        2147483647
      ],
      "expectedExpirations": 1
    },
    {
      "name": "one-millisecond-overflow",
      "budget": 2147483648,
      "checks": [
        2147483647,
        2147483648
      ],
      "expectedDelays": [
        2147483647,
        1
      ],
      "expectedExpirations": 1
    },
    {
      "name": "maximum-safe-budget",
      "budget": 9007199254740991,
      "checks": [
        2147483647,
        4294967294,
        9007199254740991
      ],
      "expectedDelays": [
        2147483647,
        2147483647,
        2147483647
      ],
      "expectedExpirations": 1
    },
    {
      "name": "early-check-keeps-deadline",
      "budget": 100,
      "checks": [
        10,
        100
      ],
      "expectedDelays": [
        100,
        90
      ],
      "expectedExpirations": 1
    },
    {
      "name": "late-check-expires-once",
      "budget": 100,
      "checks": [
        150,
        200
      ],
      "expectedDelays": [
        100
      ],
      "expectedExpirations": 1
    },
    {
      "name": "cancelled-overflow-callback",
      "budget": 2147483648,
      "checks": [
        2147483647
      ],
      "cancelBeforeCheck": 0,
      "expectedDelays": [
        2147483647
      ],
      "expectedExpirations": 0
    },
    {
      "name": "cancelled-next-segment",
      "budget": 2147483648,
      "checks": [
        2147483647,
        2147483648
      ],
      "cancelBeforeCheck": 1,
      "expectedDelays": [
        2147483647,
        1
      ],
      "expectedExpirations": 0
    }
  ],
  "timerInputs": [
    {
      "name": "zero-unbounded",
      "budget": 0,
      "callback": true,
      "accepted": true
    },
    {
      "name": "native-limit",
      "budget": 2147483647,
      "callback": true,
      "accepted": true
    },
    {
      "name": "above-native-limit",
      "budget": 2147483648,
      "callback": true,
      "accepted": true
    },
    {
      "name": "safe-integer-maximum",
      "budget": 9007199254740991,
      "callback": true,
      "accepted": true
    },
    {
      "name": "negative",
      "budget": -1,
      "callback": true,
      "accepted": false
    },
    {
      "name": "fractional",
      "budget": 0.5,
      "callback": true,
      "accepted": false
    },
    {
      "name": "unsafe-integer",
      "budget": 9007199254740992,
      "callback": true,
      "accepted": false
    },
    {
      "name": "string",
      "budget": "1",
      "callback": true,
      "accepted": false
    },
    {
      "name": "null",
      "budget": null,
      "callback": true,
      "accepted": false
    },
    {
      "name": "missing-callback",
      "budget": 1,
      "callback": false,
      "accepted": false
    }
  ],
  "progressDeadlines": [
    {
      "name": "a quiet action expires exactly after the idle window",
      "idleMilliseconds": 100,
      "maximumMilliseconds": 1000,
      "progress": [],
      "waits": [],
      "checks": [
        0,
        50,
        99,
        100,
        101
      ],
      "expected": [
        {
          "remaining": 100,
          "expiry": null
        },
        {
          "remaining": 50,
          "expiry": null
        },
        {
          "remaining": 1,
          "expiry": null
        },
        {
          "remaining": 0,
          "expiry": "idle"
        },
        {
          "remaining": -1,
          "expiry": "idle"
        }
      ]
    },
    {
      "name": "progress renews the window",
      "idleMilliseconds": 100,
      "maximumMilliseconds": 1000,
      "progress": [
        60
      ],
      "waits": [],
      "checks": [
        0,
        59,
        60,
        100,
        159,
        160
      ],
      "expected": [
        {
          "remaining": 100,
          "expiry": null
        },
        {
          "remaining": 41,
          "expiry": null
        },
        {
          "remaining": 100,
          "expiry": null
        },
        {
          "remaining": 60,
          "expiry": null
        },
        {
          "remaining": 1,
          "expiry": null
        },
        {
          "remaining": 0,
          "expiry": "idle"
        }
      ]
    },
    {
      "name": "renewal never moves the nonrenewable maximum",
      "idleMilliseconds": 100,
      "maximumMilliseconds": 250,
      "progress": [
        90,
        180,
        270
      ],
      "waits": [],
      "checks": [
        200,
        249,
        250
      ],
      "expected": [
        {
          "remaining": 50,
          "expiry": null
        },
        {
          "remaining": 1,
          "expiry": null
        },
        {
          "remaining": 0,
          "expiry": "maximum"
        }
      ]
    },
    {
      "name": "a declared wait keeps the window full and ends it at the wait end",
      "idleMilliseconds": 100,
      "maximumMilliseconds": 1000,
      "progress": [],
      "waits": [
        [
          10,
          500
        ]
      ],
      "checks": [
        5,
        10,
        300,
        499,
        500,
        599,
        600
      ],
      "expected": [
        {
          "remaining": 95,
          "expiry": null
        },
        {
          "remaining": 100,
          "expiry": null
        },
        {
          "remaining": 100,
          "expiry": null
        },
        {
          "remaining": 100,
          "expiry": null
        },
        {
          "remaining": 100,
          "expiry": null
        },
        {
          "remaining": 1,
          "expiry": null
        },
        {
          "remaining": 0,
          "expiry": "idle"
        }
      ]
    },
    {
      "name": "a declared wait cannot defeat the maximum",
      "idleMilliseconds": 100,
      "maximumMilliseconds": 1000,
      "progress": [],
      "waits": [
        [
          0,
          2000
        ]
      ],
      "checks": [
        999,
        1000
      ],
      "expected": [
        {
          "remaining": 1,
          "expiry": null
        },
        {
          "remaining": 0,
          "expiry": "maximum"
        }
      ]
    },
    {
      "name": "overlapping declared waits are one wait",
      "idleMilliseconds": 30,
      "maximumMilliseconds": 1000,
      "progress": [],
      "waits": [
        [
          0,
          100
        ],
        [
          50,
          200
        ]
      ],
      "checks": [
        150,
        199,
        200,
        229,
        230
      ],
      "expected": [
        {
          "remaining": 30,
          "expiry": null
        },
        {
          "remaining": 30,
          "expiry": null
        },
        {
          "remaining": 30,
          "expiry": null
        },
        {
          "remaining": 1,
          "expiry": null
        },
        {
          "remaining": 0,
          "expiry": "idle"
        }
      ]
    },
    {
      "name": "progress at the check instant counts",
      "idleMilliseconds": 100,
      "maximumMilliseconds": 1000,
      "progress": [
        100
      ],
      "waits": [],
      "checks": [
        100,
        199,
        200
      ],
      "expected": [
        {
          "remaining": 100,
          "expiry": null
        },
        {
          "remaining": 1,
          "expiry": null
        },
        {
          "remaining": 0,
          "expiry": "idle"
        }
      ]
    },
    {
      "name": "idle window equal to the maximum behaves as a fixed deadline",
      "idleMilliseconds": 500,
      "maximumMilliseconds": 500,
      "progress": [
        100,
        200,
        300
      ],
      "waits": [],
      "checks": [
        0,
        300,
        499,
        500
      ],
      "expected": [
        {
          "remaining": 500,
          "expiry": null
        },
        {
          "remaining": 200,
          "expiry": null
        },
        {
          "remaining": 1,
          "expiry": null
        },
        {
          "remaining": 0,
          "expiry": "maximum"
        }
      ]
    }
  ],
