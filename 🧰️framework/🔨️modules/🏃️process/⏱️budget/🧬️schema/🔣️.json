{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.framework.process.execution-budget/v1",
  "$defs": {
    "Milliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "Budgets": { "type": "object", "additionalProperties": false, "required": ["build", "command", "orchestrator", "daemon"], "properties": { "build": { "$ref": "#/$defs/Milliseconds" }, "command": { "$ref": "#/$defs/Milliseconds" }, "orchestrator": { "$ref": "#/$defs/Milliseconds" }, "daemon": { "$ref": "#/$defs/Milliseconds" } } }
  },
  "type": "object", "additionalProperties": false, "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "semio.framework.process.execution-budget/v1" },
    "cases": { "type": "array", "minItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["name", "environment", "expected"], "properties": { "name": { "type": "string", "minLength": 1 }, "environment": { "type": "object", "additionalProperties": { "type": "string" } }, "expected": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Budgets" }] } } } }
  }
}
