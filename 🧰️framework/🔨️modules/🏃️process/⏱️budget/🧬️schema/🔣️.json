{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.framework.process.execution-budget/v1",
  "$defs": {
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "command",
        "orchestrator",
        "daemon"
      ],
      "properties": {
        "build": {
          "$ref": "#/$defs/Milliseconds"
        },
        "command": {
          "$ref": "#/$defs/Milliseconds"
        },
        "orchestrator": {
          "$ref": "#/$defs/Milliseconds"
        },
        "daemon": {
          "$ref": "#/$defs/Milliseconds"
        }
      }
    },
    "BuildPreparationDefault": {
      "const": 21600000
    },
    "BuildPreparationMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "TimerMaximumMilliseconds": {
      "const": 2147483647
    },
    "TimerCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "budget",
        "checks",
        "expectedDelays",
        "expectedExpirations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "$ref": "#/$defs/Milliseconds"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Milliseconds"
          }
        },
        "cancelBeforeCheck": {
          "type": "integer",
          "minimum": 0
        },
        "expectedDelays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "expectedExpirations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "TimerInputCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "budget",
        "callback",
        "accepted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "budget": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "callback": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    }
  },
  "$ref": "#/$defs/Milliseconds"
}
