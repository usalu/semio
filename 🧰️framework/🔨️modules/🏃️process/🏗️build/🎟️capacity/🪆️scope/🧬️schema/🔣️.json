{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Policy": {
      "const": {
        "maximumDepth": 16,
        "maximumAcceptedChildren": 32,
        "maximumQueuedChildren": 32
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent",
        "requested"
      ],
      "properties": {
        "parent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "requested": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "parallelism"
              ],
              "properties": {
                "kind": {
                  "const": "exact"
                },
                "parallelism": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "maximumParallelism"
              ],
              "properties": {
                "kind": {
                  "const": "available"
                },
                "maximumParallelism": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "minimumParallelism": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "whole-host"
                }
              }
            }
          ]
        }
      }
    },
    "ChildCase": {
      "enum": [
        "error",
        "undefined",
        "cancel",
        "root-drain",
        "input-error",
        "input-undefined",
        "sampler-error",
        "sampler-undefined",
        "consumer-error",
        "consumer-undefined",
        "sampler-cancel",
        "sampler-birth-close",
        "available-cancel"
      ]
    },
    "CensusMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "accepted"
      ],
      "properties": {
        "kind": {
          "enum": [
            "removed",
            "forwarded"
          ]
        },
        "accepted": {
          "const": false
        }
      }
    }
  }
}
