{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/compiler-capacity/inherited-proof/v1",
  "definitions": {
    "ChildResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "entered", "outcome", "parallelism"],
      "properties": {
        "version": {"const": 1},
        "entered": {"type": "boolean"},
        "outcome": {"enum": ["granted", "refused"]},
        "parallelism": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "parentExclusiveBefore", "parentExclusiveAfter", "childEntered", "childCoreDatabases"],
      "properties": {
        "version": {"const": 1},
        "parentExclusiveBefore": {"type": "boolean"},
        "parentExclusiveAfter": {"type": "boolean"},
        "childEntered": {"type": "boolean"},
        "childCoreDatabases": {"type": "integer", "minimum": 0}
      }
    }
  }
}
