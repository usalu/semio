{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/compiler-capacity/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource",
    "mode",
    "parallelism"
  ],
  "properties": {
    "resource": {
      "const": "semio.compiler.host-capacity/v1"
    },
    "mode": {
      "enum": [
        "shared",
        "exclusive"
      ]
    },
    "parallelism": {
      "type": "integer",
      "minimum": 1
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "inheritedEnvironment": "SEMIO_COMPILER_CAPACITY_HELD",
        "parallelismEnvironment": "SEMIO_COMPILER_PARALLELISM",
        "coreResourcePrefix": "semio.compiler.cpu/v1/",
        "pollMs": 40
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestedParallelism": {
          "const": 1
        }
      }
    }
  }
}
