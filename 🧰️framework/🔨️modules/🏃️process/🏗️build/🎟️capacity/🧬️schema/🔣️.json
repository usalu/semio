{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/compiler-capacity/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource",
    "mode",
    "parallelism"
  ],
  "properties": {
    "resource": {
      "const": "semio.compiler.host-capacity/v1"
    },
    "mode": {
      "enum": [
        "shared",
        "exclusive"
      ]
    },
    "parallelism": {
      "type": "integer",
      "minimum": 1
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "inheritedEnvironment": "SEMIO_COMPILER_CAPACITY_HELD",
        "parallelismEnvironment": "SEMIO_COMPILER_PARALLELISM",
        "coreResourcePrefix": "semio.compiler.cpu/v1/",
        "pickerResource": "semio.compiler.cpu-picker/v1",
        "pollMs": 40
      }
    },
    "Request": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parallelism"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "parallelism": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "maximumParallelism"
          ],
          "properties": {
            "kind": {
              "const": "available"
            },
            "maximumParallelism": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "minimumParallelism": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "whole-host"
            }
          }
        }
      ]
    }
  }
}
