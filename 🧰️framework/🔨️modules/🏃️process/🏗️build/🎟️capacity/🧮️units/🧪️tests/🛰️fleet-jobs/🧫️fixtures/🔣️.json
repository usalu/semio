    {"name": "negative idle slots", "host": {"local": 2, "fleetIdle": -1, "availableMegabytes": null, "pressure": null, "unitMegabytes": 512}},
    {"name": "unknown pressure", "host": {"local": 2, "fleetIdle": 3, "availableMegabytes": null, "pressure": "bogus", "unitMegabytes": 512}},
    {"name": "fractional idle slots", "host": {"local": 2, "fleetIdle": 1.5, "availableMegabytes": null, "pressure": null, "unitMegabytes": 512}}
