{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tools"
  ],
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "versionArguments",
          "distributions"
        ],
        "properties": {
          "id": {
            "enum": [
              "cargo-nextest",
              "cargo-llvm-cov"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "versionArguments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "distributions": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "host",
                "archive",
                "bytes",
                "sha256"
              ],
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "archive": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
