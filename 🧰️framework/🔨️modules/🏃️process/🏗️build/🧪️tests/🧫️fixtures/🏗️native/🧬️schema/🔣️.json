{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries",
    "refusedOwner",
    "compilerConfiguration"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "refusedOwner": {
      "const": "🧰️framework/🛍️products/"
    },
    "compilerConfiguration": {
      "type": "string",
      "minLength": 1
    }
  }
}
