{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/process/cargo-grant/v1",
  "title": "Cargo grant: how an ad-hoc Cargo invocation of the tool registry is classified, sized and limited by the machine-wide capacity ledger",
  "definitions": {
    "Policy": {
      "description": "The authored constants: the operation the invocation is admitted as, the environment variable the granted jobs are handed over in, the flags a command line may name its own jobs with and the longest class name part.",
      "const": {
        "operation": "cargo",
        "jobsVariable": "CARGO_BUILD_JOBS",
        "jobsFlags": ["-j", "--jobs"],
        "workspaceFlags": ["--workspace", "--all"],
        "workspaceClass": "workspace",
        "partMaximumLength": 120,
        "unitPeakClassesMegabytes": [2150, 1450],
        "typicalUnitMegabytes": 1088,
        "unitPeakSource": "ps rss of the largest process per rustc crate over every build of 2026-11-27 (ticket PREVENT-OUT-OF-APPLICATION-MEMORY-PAUSES-ON-LOW-RESOURCE-MACHINES, unit-peaks.md section 2.3): 2006 MB for the test crate kernel_event_receiving (class 2150 MB), 1445 MB for semio_framework_kernel (class 1450 MB), 33 to 1064 MB for the other 129 of 131 units (class 1088 MB)"
      }
    },
    "MemoryCase": {
      "type": "object",
      "required": ["name", "megabytes", "units"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "megabytes": {"type": "integer", "minimum": 0},
        "units": {"type": "integer", "minimum": 1}
      }
    },
    "Arguments": {
      "type": "array",
      "items": {"type": "string"}
    },
    "Environment": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "LineageCase": {
      "type": "object",
      "required": ["name", "arguments", "lineage"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "arguments": {"$ref": "#/definitions/Arguments"},
        "lineage": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "JobsCase": {
      "type": "object",
      "required": ["name", "arguments", "environment", "cores", "jobs"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "arguments": {"$ref": "#/definitions/Arguments"},
        "environment": {"$ref": "#/definitions/Environment"},
        "cores": {"type": "integer", "minimum": 1},
        "jobs": {"type": "integer", "minimum": 1}
      }
    },
    "CapCase": {
      "type": "object",
      "required": ["name", "arguments", "granted", "capped"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "arguments": {"$ref": "#/definitions/Arguments"},
        "granted": {"type": "integer", "minimum": 1},
        "capped": {"$ref": "#/definitions/Arguments"}
      }
    },
    "Toolchain": {
      "type": "object",
      "required": ["name", "file", "triple", "toolchain"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "file": {"type": "string"},
        "triple": {"type": "string"},
        "toolchain": {"type": ["string", "null"]}
      }
    },
    "Sizing": {
      "type": "object",
      "required": ["name", "history", "default", "ratioBasisPoints"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "history": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "default": {"type": "integer", "minimum": 1},
        "ratioBasisPoints": {"type": "integer", "minimum": 1}
      }
    }
  }
}
