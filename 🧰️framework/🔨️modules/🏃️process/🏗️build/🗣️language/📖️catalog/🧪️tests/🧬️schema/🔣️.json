{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Language Catalog Corpus",
  "description": "Language-agnostic cases of the catalog renderer: every implementation and the independent oracle must produce the expected text or the expected refusal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "catalog", "render", "templates", "documents"],
  "properties": {
    "version": { "const": 1 },
    "catalog": { "type": "object" },
    "render": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "key", "language", "values"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "key": { "type": "string" },
          "language": { "type": "string" },
          "values": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }] } },
          "expected": { "type": "string" },
          "refusal": { "enum": ["language-required", "language-unavailable", "unknown-key", "missing-placeholder", "unknown-placeholder"] }
        },
        "oneOf": [{ "required": ["expected"], "properties": { "expected": { "type": "string" } } }, { "required": ["refusal"], "properties": { "refusal": { "type": "string" } } }]
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template"],
        "properties": {
          "template": { "type": "string" },
          "placeholders": { "type": "array", "items": { "type": "string" } },
          "refusal": { "const": "invalid-template" }
        },
        "oneOf": [{ "required": ["placeholders"], "properties": { "placeholders": { "type": "array" } } }, { "required": ["refusal"], "properties": { "refusal": { "type": "string" } } }]
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "valid", "schemaValid", "document"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "valid": { "type": "boolean" },
          "schemaValid": { "type": "boolean" },
          "document": {}
        }
      }
    }
  }
}
