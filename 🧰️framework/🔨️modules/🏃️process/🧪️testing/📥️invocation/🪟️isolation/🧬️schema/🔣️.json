{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/process/testing/invocation/isolation/schema.json",
  "title": "IsolatedBuildTestPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bodyMilliseconds",
    "scope"
  ],
  "properties": {
    "bodyMilliseconds": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2147483647
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "body"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "maximumElapsedMilliseconds"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "maximumElapsedMilliseconds": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2147483647
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "Protocol": {
      "const": {
        "observerGraceMilliseconds": 5000,
        "maximumReasonCharacters": 8192,
        "maximumFailures": 64,
        "maximumFailureDepth": 8,
        "primaryPrefix": "[isolated-primary] "
      }
    },
    "IsolatedBuildTestFailureV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "reason"
      ],
      "properties": {
        "phase": {
          "enum": [
            "body",
            "callback",
            "fixture",
            "cleanup",
            "receiver"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 8192
        }
      }
    },
    "IsolatedBuildTestPrimaryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "test",
        "overflow",
        "failures"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "overflow": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/IsolatedBuildTestFailureV1"
          }
        }
      }
    },
    "IsolatedBuildTestFailureReasonV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "overflow"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 8192
        },
        "overflow": {
          "type": "boolean"
        }
      }
    }
  }
}
