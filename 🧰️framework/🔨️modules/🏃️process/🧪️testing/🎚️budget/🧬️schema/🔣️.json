{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "levels",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.framework.process.test-level-budgets/v1"
    },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fundamental",
        "quick",
        "long",
        "exhaustive"
      ],
      "properties": {
        "fundamental": {
          "type": "integer",
          "minimum": 1
        },
        "quick": {
          "type": "integer",
          "minimum": 1
        },
        "long": {
          "type": "integer",
          "minimum": 1
        },
        "exhaustive": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segments",
          "environment",
          "minimum",
          "expected"
        ],
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "minimum": {
            "enum": [
              "fundamental",
              "quick",
              "long",
              "exhaustive"
            ]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "rest",
              "budgetMs",
              "rank",
              "coverage"
            ],
            "properties": {
              "level": {
                "enum": [
                  "fundamental",
                  "quick",
                  "long",
                  "exhaustive"
                ]
              },
              "rest": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "budgetMs": {
                "type": "integer",
                "minimum": 0
              },
              "rank": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "coverage": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
