{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "thresholdMilliseconds", "forms", "skippedDirectories", "testFile", "ceilings"],
  "properties": {
    "version": { "const": 1 },
    "thresholdMilliseconds": { "type": "integer", "minimum": 1 },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "pattern": { "type": "string", "minLength": 1 } }
      }
    },
    "skippedDirectories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "testFile": { "type": "string", "minLength": 1 },
    "ceilings": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
  }
}
