{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/process/testing/vitest/policy.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cwd",
    "toolPath",
    "runtime",
    "coverageRuntime",
    "cacheRoot",
    "coverageDirectory",
    "budgetMs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "toolPath": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "coverageRuntime": {
      "type": "string",
      "minLength": 1
    },
    "cacheRoot": {
      "type": "string",
      "minLength": 1
    },
    "coverageDirectory": {
      "type": "string",
      "minLength": 1
    },
    "budgetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
