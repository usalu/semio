{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "byteLength", "byte", "sha256", "cases"],
  "properties": {
    "version": { "const": 1 },
    "byteLength": { "type": "integer", "minimum": 65537 },
    "byte": { "type": "integer", "minimum": 0, "maximum": 255 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "interruption", "admitted", "progress"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "interruption": { "enum": ["none", "cancel-before", "cancel-publication", "deadline-before", "deadline-publication", "replace-publication", "reject-publication"] },
          "admitted": { "type": "boolean" },
          "progress": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
        }
      }
    }
  }
}
