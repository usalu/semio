{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "command",
    "args",
    "cwd",
    "environment",
    "maximumOutputLines"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "maximumOutputLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  }
}
