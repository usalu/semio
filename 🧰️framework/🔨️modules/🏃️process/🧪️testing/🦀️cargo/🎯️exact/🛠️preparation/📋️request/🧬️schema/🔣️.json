{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.process.exact-cargo.preparation-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "args",
    "cwd",
    "environment",
    "maximumOutputLines"
  ],
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "maximumOutputLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "definitions": {
    "BoundedEnvironmentKeys": {
      "const": [
        "CARGO_HOME",
        "CARGO_TARGET_DIR",
        "CARGO_BUILD_BUILD_DIR",
        "TMPDIR",
        "TMP",
        "TEMP",
        "SEMIO_TEST_ARTIFACT_DIR"
      ]
    }
  }
}
