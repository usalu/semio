{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "invalid"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "args",
          "compiler"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compiler": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "invalid": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
