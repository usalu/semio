{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "cargo-failed-build-output.v1" },
    "cases": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "exitCode", "splitBytes", "stdout"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer", "minimum": 1, "maximum": 255 },
          "splitBytes": { "type": "integer", "minimum": 1 },
          "stdout": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
