{
  "name": "@semio-tech/framework-transient",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test-contract": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "{projectRoot}/**/*",
        "sharedGlobals"
      ],
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🫧️transient",
        "command": "repo ./📜️script.ts test contract",
        "forwardAllArgs": true
      }
    },
    "test-retained": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "{projectRoot}/**/*",
        "sharedGlobals"
      ],
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🫧️transient",
        "command": "repo ./📜️script.ts test retained",
        "forwardAllArgs": true
      }
    }
  }
}
