{
  "name": "@semio-tech/framework-transient",
  "targets": {
    "test-contract": {
      "executor": "repo:script",
      "cache": false,
      "inputs": [
        "{projectRoot}/**/*",
        "sharedGlobals"
      ],
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🫧️transient",
        "command": "bun ./📜️script.ts test contract",
        "forwardAllArgs": true
      }
    },
    "test-retained": {
      "executor": "repo:script",
      "cache": false,
      "inputs": [
        "{projectRoot}/**/*",
        "sharedGlobals"
      ],
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🫧️transient",
        "command": "bun ./📜️script.ts test retained",
        "forwardAllArgs": true
      }
    }
  }
}
