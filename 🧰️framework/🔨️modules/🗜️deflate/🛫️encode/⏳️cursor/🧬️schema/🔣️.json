{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retained Fixed Huffman Deflate Producer",
  "type": "object",
  "additionalProperties": false,
  "required": ["maximumPageBytes", "maximumInlineBytes", "vectors", "cancellationPhases"],
  "properties": {
    "maximumPageBytes": { "const": 4096 },
    "maximumInlineBytes": { "const": 1024 },
    "vectors": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "raw", "stored"], "properties": { "id": { "type": "string" }, "raw": { "type": "array", "items": { "$ref": "#/definitions/byte" } }, "stored": { "type": "array", "items": { "$ref": "#/definitions/byte" } } } } },
    "cancellationPhases": { "type": "array", "items": { "enum": ["initialize", "input", "search", "compare", "token", "insert", "finish", "complete"] }, "uniqueItems": true }
  },
  "definitions": { "byte": { "type": "integer", "minimum": 0, "maximum": 255 } }
}
