{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/identity/grapheme/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases",
    "removal"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value",
          "expected",
          "oracleEmoji"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "value": {
            "type": "string"
          },
          "oracleEmoji": {
            "type": "string"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "emoji",
              "rest",
              "first"
            ],
            "properties": {
              "emoji": {
                "type": "string"
              },
              "rest": {
                "type": "string"
              },
              "first": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "removal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "selectedLaws"
      ],
      "properties": {
        "owner": {
          "const": "🧰️framework/🔨️modules/🪪️identity/🧩️grapheme"
        },
        "selectedLaws": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": [
            {
              "const": "neutral grapheme vectors preserve exact leading emoji, first grapheme and original rest"
            },
            {
              "const": "independent TypeScript runtime keeps the neutral implementation"
            }
          ],
          "additionalItems": false
        }
      }
    }
  }
}
