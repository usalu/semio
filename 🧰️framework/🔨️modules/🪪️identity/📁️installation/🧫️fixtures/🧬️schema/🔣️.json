{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "directories",
    "collisions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "directories": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "accepted"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {},
          "accepted": {
            "type": "boolean"
          },
          "emoji": {
            "type": "string"
          }
        }
      }
    },
    "collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "directoryName",
          "siblings",
          "conflict"
        ],
        "properties": {
          "directoryName": {
            "$ref": "semio:installation-directory/v1"
          },
          "siblings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflict": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
