{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "schema-source-reference-closure"
    },
    "cases": {
      "type": "array",
      "minItems": 44,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "request",
          "expected",
          "oracle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "boolean-root",
              "empty-pointer-segments",
              "escaped-pointer",
              "percent-pointer",
              "annotation-data",
              "nested-relative-id",
              "static-anchor",
              "boolean-target",
              "explicit-external",
              "repeated-external",
              "cyclic-external",
              "unused-input",
              "utf8-document-order",
              "declared-annotation",
              "recursive-object",
              "escaped-duplicate",
              "nested-id-collision",
              "unknown-reference",
              "unknown-pointer",
              "data-target-refusal",
              "bad-percent",
              "bad-tilde",
              "malformed-json",
              "dynamic-ref",
              "dynamic-anchor",
              "unknown-keyword",
              "lone-surrogate-name",
              "wrong-schema-child",
              "wrong-dialect-items",
              "wrong-anchor-dialect",
              "bad-reference-type",
              "id-fragment",
              "duplicate-root-external",
              "duplicate-anchor",
              "duplicate-input-id",
              "invalid-absolute-base",
              "nested-relative-pointer",
              "retrieval-static-anchor",
              "percent-escaped-pointer",
              "draft07-dependency-positions",
              "2020-dependent-schema",
              "2020-prefix-items",
              "draft07-prefix-items-refusal",
              "dialect-disagreement"
            ]
          },
          "request": {
            "$ref": "https://schemas.semio.dev/framework/schema/source/closure#/$defs/request"
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "documents",
                  "targets"
                ],
                "properties": {
                  "documents": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "error"
                ],
                "properties": {
                  "error": {
                    "$ref": "https://schemas.semio.dev/framework/schema/source/closure#/$defs/errorCode"
                  }
                }
              }
            ]
          },
          "oracle": {
            "oneOf": [
              {
                "const": null
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "compile",
                  "instances"
                ],
                "properties": {
                  "compile": {
                    "type": "boolean"
                  },
                  "instances": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "valid"
                      ],
                      "properties": {
                        "value": {},
                        "valid": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "oracleFailure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vendor",
              "stage",
              "message"
            ],
            "properties": {
              "vendor": {
                "const": "ajv"
              },
              "stage": {
                "const": "compile"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "maxItems": 44
    }
  }
}
