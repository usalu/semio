{
  "name": "@semio-tech/schema-source-closure-ts",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/**/*"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/📄️source/🔗️closure/**/*",
        "sharedGlobals"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧬️schema/📄️source/🔗️closure/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-absence": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/📄️source/🔗️closure/**/*",
        "sharedGlobals"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧬️schema/📄️source/🔗️closure/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test-absence",
        "forwardAllArgs": true
      }
    }
  }
}
