    {
      "id": "custom-type-map",
      "reason": "validation failed: $: unsupported JSON Schema keyword `types`",
      "expected": "unknownKeyword"
    },
    {
      "id": "later-dialect",
      "reason": "validation failed: $: unsupported JSON Schema keyword `prefixItems`",
      "expected": "nonDraft07Keyword"
    },
    {
      "id": "duplicate-id",
      "reason": "ambiguous schema document identifier",
      "expected": "ambiguousIdentifier"
    },
    {
      "id": "missing-target",
      "reason": "validation failed: $.$ref: unresolved cross-document reference `urn:missing`",
      "expected": "unresolvedReference"
    },
    {
      "id": "boundary-engine",
      "reason": "validation failed: $.pattern: word boundaries are outside the supported subset",
      "expected": "patternCompatibilityFailure"
    },
    {
      "id": "surrogate-engine",
      "reason": "validation failed: $.pattern: invalid code point escape `D800`",
      "expected": "patternCompatibilityFailure"
    },
    {
      "id": "invalid-enum",
      "reason": "validation failed: $.enum: duplicate enum value",
      "expected": "metaSchemaViolation"
    }
