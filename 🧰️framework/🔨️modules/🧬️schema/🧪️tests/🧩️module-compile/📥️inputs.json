  "referenceCases": [
    {
      "id": "transitive",
      "root": "{\"$id\":\"https://example.invalid/schema-input/a\",\"$ref\":\"https://example.invalid/schema-input/b\"}",
      "documents": [
        "{\"$id\":\"https://example.invalid/schema-input/b\",\"$ref\":\"https://example.invalid/schema-input/c\"}",
        "{\"$id\":\"https://example.invalid/schema-input/c\",\"type\":\"integer\"}",
        "{\"$id\":\"https://example.invalid/schema-input/unused\",\"type\":\"string\"}"
      ],
      "expected": [
        "https://example.invalid/schema-input/b",
        "https://example.invalid/schema-input/c"
      ],
      "compiles": true
    },
    {
      "id": "duplicate-reference",
      "root": "{\"$id\":\"https://example.invalid/schema-input/a\",\"type\":\"object\",\"properties\":{\"first\":{\"$ref\":\"https://example.invalid/schema-input/b\"},\"second\":{\"$ref\":\"https://example.invalid/schema-input/b\"}}}",
      "documents": [
        "{\"$id\":\"https://example.invalid/schema-input/b\",\"type\":\"integer\"}"
      ],
      "expected": [
        "https://example.invalid/schema-input/b"
      ],
      "compiles": true
    },
    {
      "id": "local",
