{
  "$comment": "Language-agnostic draft-07 structural-validation vectors. Consumed by the owned Rust validator (⚛️component.rs test `owned_validator_matches_the_draft07_oracle_vectors`) and by the ajv oracle spec (✅️draft07-oracle.test.ts). `errorPath` is a JSON Pointer into the instance, ajv's `instancePath` spelling; the Rust twin renders it as `$`, `$.name`, `$.items[0]`.",
  "dialect": "http://json-schema.org/draft-07/schema#",
  "cases": [
    {
      "id": "object-required-and-additional-properties",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/object.json",
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "count"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 8 },
          "count": { "type": "integer", "minimum": 0, "maximum": 10 },
          "enabled": { "type": "boolean" }
        }
      },
      "valid": [{ "name": "ok", "count": 0 }, { "name": "abcdefgh", "count": 10, "enabled": true }],
      "invalid": [
        { "instance": { "count": 1 }, "errorPath": "" },
        { "instance": { "name": "a", "count": 1 }, "errorPath": "/name" },
        { "instance": { "name": "abcdefghi", "count": 1 }, "errorPath": "/name" },
        { "instance": { "name": "ok", "count": 11 }, "errorPath": "/count" },
        { "instance": { "name": "ok", "count": -1 }, "errorPath": "/count" },
        { "instance": { "name": "ok", "count": 1.5 }, "errorPath": "/count" },
        { "instance": { "name": 1, "count": 1 }, "errorPath": "/name" },
        { "instance": [], "errorPath": "" },
        { "instance": null, "errorPath": "" }
      ]
    },
    {
      "id": "string-pattern-and-enum-and-const",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/string.json",
        "type": "object",
        "required": ["scope", "lane", "kind"],
        "properties": {
          "scope": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" },
          "lane": { "enum": ["artifact", "config", "presence", "transient"] },
          "kind": { "const": "scope-owned" },
          "revision": { "type": "string", "pattern": "^v\\d{1,3}$" }
        }
      },
      "valid": [
        { "scope": "s.trinity.jack", "lane": "artifact", "kind": "scope-owned" },
        { "scope": "hub.inference", "lane": "presence", "kind": "scope-owned", "revision": "v12" }
      ],
      "invalid": [
        { "instance": { "scope": "Trinity.Jack", "lane": "artifact", "kind": "scope-owned" }, "errorPath": "/scope" },
        { "instance": { "scope": "trinity", "lane": "artifact", "kind": "scope-owned" }, "errorPath": "/scope" },
        { "instance": { "scope": "s.trinity.jack", "lane": "draft", "kind": "scope-owned" }, "errorPath": "/lane" },
        { "instance": { "scope": "s.trinity.jack", "lane": "artifact", "kind": "fixture-owned" }, "errorPath": "/kind" },
        { "instance": { "scope": "s.trinity.jack", "lane": "artifact", "kind": "scope-owned", "revision": "v1234" }, "errorPath": "/revision" },
        { "instance": { "scope": "s.trinity.jack", "lane": "artifact", "kind": "scope-owned", "revision": "12" }, "errorPath": "/revision" }
      ]
    },
    {
      "id": "array-list-items-and-bounds",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/array.json",
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" }
      },
      "valid": [["Artifact"], ["Artifact", "Snapshot", "Diff"]],
      "invalid": [
        { "instance": [], "errorPath": "" },
        { "instance": ["Artifact", "Snapshot", "Diff", "Mutations"], "errorPath": "" },
        { "instance": ["Artifact", "Artifact"], "errorPath": "" },
        { "instance": ["artifact"], "errorPath": "/0" },
        { "instance": ["Artifact", 7], "errorPath": "/1" }
      ]
    },
    {
      "id": "array-tuple-items-and-additional-items",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/tuple.json",
        "type": "array",
        "items": [{ "type": "string" }, { "type": "integer", "minimum": 1 }],
        "additionalItems": false,
        "minItems": 2
      },
      "valid": [["rust", 1], ["typescript", 5]],
      "invalid": [
        { "instance": ["rust"], "errorPath": "" },
        { "instance": [1, 1], "errorPath": "/0" },
        { "instance": ["rust", 0], "errorPath": "/1" },
        { "instance": ["rust", 1, "extra"], "errorPath": "/2" }
      ]
    },
    {
      "id": "combinators-one-of-any-of-all-of",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/combinators.json",
        "allOf": [{ "type": ["string", "integer"] }],
        "anyOf": [{ "type": "string", "minLength": 3 }, { "type": "integer" }],
        "oneOf": [{ "type": "string" }, { "type": "integer", "maximum": 4 }]
      },
      "valid": ["rust", "typescript", 1, 4],
      "invalid": [
        { "instance": "ab", "errorPath": "" },
        { "instance": 5, "errorPath": "" },
        { "instance": true, "errorPath": "" },
        { "instance": null, "errorPath": "" }
      ]
    },
    {
      "id": "local-ref-into-definitions",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/local-ref.json",
        "definitions": {
          "ExportId": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" }
        },
        "type": "object",
        "required": ["export"],
        "additionalProperties": false,
        "properties": {
          "export": { "$ref": "#/definitions/ExportId" },
          "aliases": { "type": "array", "items": { "$ref": "#/definitions/ExportId" } }
        }
      },
      "valid": [{ "export": "ArtifactSchemaDescriptor" }, { "export": "FacetLeaves", "aliases": ["SchemaExport"] }],
      "invalid": [
        { "instance": { "export": "facetLeaves" }, "errorPath": "/export" },
        { "instance": { "export": "FacetLeaves", "aliases": ["schemaExport"] }, "errorPath": "/aliases/0" },
        { "instance": { "aliases": [] }, "errorPath": "" }
      ]
    },
    {
      "id": "cross-document-ref-by-id",
      "documents": [
        {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "$id": "https://semio.tech/schema/framework/schema/vectors/shared.json",
          "definitions": {
            "ScopeId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$" },
            "FormatId": { "enum": ["rust", "typescript", "graphql", "jsonschema", "protobuf"] }
          }
        }
      ],
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/cross-ref.json",
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "format"],
        "properties": {
          "scope": { "$ref": "https://semio.tech/schema/framework/schema/vectors/shared.json#/definitions/ScopeId" },
          "format": { "$ref": "https://semio.tech/schema/framework/schema/vectors/shared.json#/definitions/FormatId" }
        }
      },
      "valid": [{ "scope": "framework.schema", "format": "jsonschema" }, { "scope": "s.trinity.jack", "format": "rust" }],
      "invalid": [
        { "instance": { "scope": "FrameworkSchema", "format": "rust" }, "errorPath": "/scope" },
        { "instance": { "scope": "framework.schema", "format": "wit" }, "errorPath": "/format" },
        { "instance": { "scope": "framework.schema" }, "errorPath": "" }
      ]
    }
  ]
}
