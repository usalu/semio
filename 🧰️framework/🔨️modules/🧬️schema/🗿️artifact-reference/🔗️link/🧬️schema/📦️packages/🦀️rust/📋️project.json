{
  "name": "@semio-tech/os-store-link-schema-rs",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ],
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ]
  },
  "tags": [
    "scope:framework",
    "language:rust"
  ],
  "targets": {
    "test-contract": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧬️schema/🗿️artifact-reference/🔗️link/🧬️schema/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-contract",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    },
    "test-native": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧬️schema/🗿️artifact-reference/🔗️link/🧬️schema/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-native",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    }
  }
}
