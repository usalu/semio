{
  "name": "@semio-tech/os-store-blob-identity-rs",
  "tags": [
    "scope:framework",
    "language:rust"
  ],
  "targets": {
    "test-contract": {
      "executor": "repo:script",
      "cache": false,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧬️schema/🗿️artifact-reference/📦️blob/🧬️schema/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-contract",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    },
    "test-native": {
      "executor": "repo:script",
      "cache": false,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧬️schema/🗿️artifact-reference/📦️blob/🧬️schema/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-native",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    }
  }
}
