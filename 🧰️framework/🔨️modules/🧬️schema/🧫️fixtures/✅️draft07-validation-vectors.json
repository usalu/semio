    {
      "id": "conditional-if-then-else",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/conditional.json",
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "blocked"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "if": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "blocked"
            }
          }
        },
        "then": {
          "type": "object",
          "required": [
            "detail"
          ],
          "properties": {
            "detail": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "else": {
          "type": "object",
          "not": {
            "required": [
              "detail"
            ]
          }
        }
      },
      "valid": [
        {
          "status": "ready"
        },
        {
          "status": "blocked",
          "detail": "quorum"
        }
      ],
      "invalid": [
        {
          "instance": {
            "status": "blocked"
          },
          "errorPath": ""
        },
        {
          "instance": {
            "status": "blocked",
            "detail": "no"
          },
          "errorPath": "/detail"
        },
        {
          "instance": {
            "status": "ready",
            "detail": "extra"
          },
          "errorPath": ""
        },
        {
          "instance": {
            "status": "unknown"
          },
          "errorPath": "/status"
        }
      ]
    },
