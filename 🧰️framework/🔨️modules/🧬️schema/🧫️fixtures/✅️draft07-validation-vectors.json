{
  "$comment": "Language-agnostic draft-07 structural-validation vectors. Consumed by the owned Rust validator (⚛️component.rs test `owned_validator_agrees_with_the_shared_draft07_vectors`) and by the ajv + ajv-formats oracle spec (✅️draft07-oracle.test.ts). `errorPath` is a JSON Pointer into the instance, ajv's `instancePath` spelling; the Rust twin renders it as `$`, `$.name`, `$.items[0]`.",
  "dialect": "http://json-schema.org/draft-07/schema#",
  "cases": [
    {
      "id": "object-required-and-additional-properties",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/object.json",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "count"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "valid": [
        {
          "name": "ok",
          "count": 0
        },
        {
          "name": "abcdefgh",
          "count": 10,
          "enabled": true
        }
      ],
      "invalid": [
        {
          "instance": {
            "count": 1
          },
          "errorPath": ""
        },
        {
          "instance": {
            "name": "a",
            "count": 1
          },
          "errorPath": "/name"
        },
        {
          "instance": {
            "name": "abcdefghi",
            "count": 1
          },
          "errorPath": "/name"
        },
        {
          "instance": {
            "name": "ok",
            "count": 11
          },
          "errorPath": "/count"
        },
        {
          "instance": {
            "name": "ok",
            "count": -1
          },
          "errorPath": "/count"
        },
        {
          "instance": {
            "name": "ok",
            "count": 1.5
          },
          "errorPath": "/count"
        },
        {
          "instance": {
            "name": 1,
            "count": 1
          },
          "errorPath": "/name"
        },
        {
          "instance": [],
          "errorPath": ""
        },
        {
          "instance": null,
          "errorPath": ""
        }
      ]
    },
    {
      "id": "string-pattern-and-enum-and-const",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "https://semio.tech/schema/framework/schema/vectors/string.json",
        "type": "object",
        "required": [
          "scope",
          "lane",
          "kind"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "lane": {
            "enum": [
              "artifact",
              "config",
              "presence",
              "transient"
            ]
          },
          "kind": {
            "const": "scope-owned"
          },
          "revision": {
            "type": "string",
            "pattern": "^v\\d{1,3}$"
          }
        }
      },
      "valid": [
        {
          "scope": "s.trinity.jack",
          "lane": "artifact",
          "kind": "scope-owned"
        },
        {
          "scope": "hub.inference",
          "lane": "presence",
          "kind": "scope-owned",
          "revision": "v12"
        }
      ],
      "invalid": [
        {
          "instance": {
            "scope": "Trinity.Jack",
            "lane": "artifact",
            "kind": "scope-owned"
          },
          "errorPath": "/scope"
        },
        {
          "instance": {
            "scope": "trinity",
            "lane": "artifact",
            "kind": "scope-owned"
          },
          "errorPath": "/scope"
        },
        {
          "instance": {
            "scope": "s.trinity.jack",
            "lane": "draft",
            "kind": "scope-owned"
          },
          "errorPath": "/lane"
        },
        {
          "instance": {
            "scope": "s.trinity.jack",
            "lane": "artifact",
            "kind": "fixture-owned"
          },
          "errorPath": "/kind"
        },
        {
          "instance": {
            "scope": "s.trinity.jack",
            "lane": "artifact",
            "kind": "scope-owned",
            "revision": "v1234"
          },
          "errorPath": "/revision"
        },
        {
          "instance": {
            "scope": "s.trinity.jack",
            "lane": "artifact",
            "kind": "scope-owned",
            "revision": "12"
          },
          "errorPath": "/revision"
        }
      ]
