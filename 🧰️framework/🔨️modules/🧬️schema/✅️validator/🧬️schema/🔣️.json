{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:json-schema-subset-cases:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "comparisons"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "schema",
          "value",
          "valid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "schema": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "value": {},
          "valid": {
            "type": "boolean"
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "left",
          "right",
          "equal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "left": {},
          "right": {},
          "equal": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
