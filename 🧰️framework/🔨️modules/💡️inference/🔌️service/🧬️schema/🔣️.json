{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.os.installed-service-operation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "serviceId",
    "action",
    "operationEpoch",
    "payload"
  ],
  "properties": {
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "serviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "operationEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "payload": {}
  },
  "$defs": {
    "SchemaRecord": {
      "type": "object"
    },
    "AdmittedDocumentServiceOperationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "method",
        "route",
        "sendBody",
        "cursorField",
        "requestMaxBytes",
        "responseMaxBytes",
        "inputSchema",
        "outputSchema"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "route": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "sendBody": {
          "type": "boolean"
        },
        "cursorField": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestMaxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "responseMaxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "inputSchema": {
          "$ref": "#/$defs/SchemaRecord"
        },
        "outputSchema": {
          "$ref": "#/$defs/SchemaRecord"
        }
      }
    },
    "AdmittedDocumentServiceDeclarationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "owner",
        "serviceId",
        "operations"
      ],
      "properties": {
        "schema": {
          "const": "semio.os.document-http-port/v1"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/AdmittedDocumentServiceOperationV1"
          }
        }
      }
    }
  }
}
