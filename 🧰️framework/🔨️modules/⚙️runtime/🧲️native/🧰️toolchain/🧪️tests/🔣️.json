{
 "scenarios": [
  {
   "id": "linux-all-on-path",
   "platform": "linux",
   "arch": "x64",
   "env": {
    "PATH": "/usr/local/bin:/usr/bin:/home/dev/.cargo/bin"
   },
   "home": "/home/dev",
   "files": [
    "/usr/bin/cc",
    "/home/dev/.cargo/bin/rustc"
   ],
   "directories": [],
   "commands": [],
   "expected": [
    {
     "id": "cc",
     "found": true,
     "location": "/usr/bin/cc",
     "how": "path"
    },
    {
     "id": "rust",
     "found": true,
     "location": "/home/dev/.cargo/bin/rustc",
     "how": "path"
    }
   ]
  },
