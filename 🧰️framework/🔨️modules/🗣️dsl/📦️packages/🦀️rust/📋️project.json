{
  "name": "@semio-tech/framework-dsl-rs",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🔨️modules/🗣️dsl",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🗣️dsl/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/⚠️diagnostic/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/✅️validator/**/*",
      "sharedGlobals"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/⏳️async/✨️macros/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/⏳️async/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/🧲️fixture-reader/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ],
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ]
  },
  "targets": {
    "test-ownership": {
      "executor": "repo:script",
      "outputs": [],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗣️dsl/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-ownership"
      }
    },
    "test-native": {
      "executor": "repo:script",
      "outputs": [],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗣️dsl/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-native"
      }
    },
    "test-reference": {
      "executor": "repo:script",
      "outputs": [],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🗣️dsl/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-reference"
      }
    }
  }
}
