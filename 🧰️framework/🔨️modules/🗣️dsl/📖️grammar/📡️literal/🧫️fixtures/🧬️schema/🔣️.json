{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "binary",
    "entries",
    "revision",
    "tail",
    "depth",
    "textBytes",
    "cancelAfter",
    "minimumOwnershipBudget",
    "fullOwnershipBudget",
    "lexical",
    "scalars"
  ],
  "properties": {
    "scalars":{"type":"object","additionalProperties":false,"required":["grammar","cases"],"properties":{"grammar":{"type":"string"},"cases":{"type":"array","minItems":9,"items":{"type":"object","additionalProperties":false,"required":["source","signed","unsigned","valid"],"properties":{"source":{"type":"string"},"signed":{"type":"string"},"unsigned":{"type":"string"},"valid":{"type":"boolean"}}}}}},
    "source": {
      "type": "string"
    },
    "binary": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "revision": {
      "const": 1
    },
    "tail": {
      "const": 7
    },
    "depth": {
      "const": 8192
    },
    "textBytes": {
      "const": 100000
    },
    "cancelAfter": {
      "const": 256
    },
    "minimumOwnershipBudget": {
      "const": 1
    },
    "fullOwnershipBudget": {
      "const": 16777216
    },
    "lexical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grammar",
        "cases"
      ],
      "properties": {
        "grammar": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "valid",
              "hex",
              "integer"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "valid": {
                "type": "boolean"
              },
              "hex": {
                "type": "string"
              },
              "integer": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flag",
        "label",
        "child"
      ],
      "properties": {
        "flag": {
          "enum": [
            0,
            1
          ]
        },
        "label": {
          "type": "string"
        },
        "child": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/entry"
            }
          ]
        }
      }
    }
  }
}
