{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stock",
    "body",
    "cancelAt",
    "cases"
  ],
  "properties": {
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth",
        "fuel"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "copyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "fuel": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "body": {
      "type": "integer",
      "minimum": 1
    },
    "cancelAt": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "source",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "const": "set"
              },
              "source": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "source",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "const": "map"
              },
              "source": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "source",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "const": "value"
              },
              "source": {},
              "expected": {}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "source",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "const": "block"
              },
              "source": {
                "type": "object",
                "required": [
                  "id",
                  "weight"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "expected": {
                "type": "object",
                "required": [
                  "id",
                  "weight"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
