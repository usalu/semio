{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Borrowed Object Ordering Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "depth",
    "payloadBytes",
    "allocationMultiplier",
    "unsigned",
    "binary64Bits",
    "wrapperKeys",
    "payloadKeys"
  ],
  "properties": {
    "wrapperKeys": {"const": ["z", "a"]},
    "payloadKeys": {"const": ["zPayload", "wide", "exceptional"]},
    "depth": {
      "type": "integer",
      "minimum": 1
    },
    "payloadBytes": {
      "type": "integer",
      "minimum": 1
    },
    "allocationMultiplier": {
      "type": "integer",
      "minimum": 1
    },
    "unsigned": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "binary64Bits": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "schema": {
      "const": "semio.dsl.borrowed-object-printing/v1"
    }
  }
}
