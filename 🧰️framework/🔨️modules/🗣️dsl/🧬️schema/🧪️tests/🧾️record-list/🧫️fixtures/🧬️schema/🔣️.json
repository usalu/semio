{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "invalid",
    "optionalBlocks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rows",
          "source",
          "nestedTableSource"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/row"
            }
          },
          "source": {
            "type": "string"
          },
          "nestedTableSource": {
            "type": "string"
          }
        }
      }
    },
    "invalid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optionalBlocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "source"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        }
      }
    }
  }
}
