{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio:framework:dsl:record:original-receiving",
  "title": "Original Typed Record Receiving",
  "type": "object",
  "required": [
    "text",
    "items",
    "optional",
    "grant",
    "laws",
    "ownedCases",
    "declaredCases",
    "shapeCases"
  ],
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional": {
      "type": [
        "string",
        "null"
      ]
    },
    "grant": {
      "type": "object",
      "required": [
        "items",
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "copyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "laws": {
      "const": [
        "sameOriginalLedger",
        "sameOriginalCallback",
        "sameOriginalRecipient",
        "sameOutputAsSerdeJson",
        "retainedPartialFields",
        "paidRetirement"
      ]
    },
    "ownedCases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "items",
          "capacityBytes",
          "ready",
          "sourceSame"
        ],
        "properties": {
          "kind": {
            "enum": [
              "text",
              "bytes",
              "list"
            ]
          },
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "capacityBytes": {
            "type": "integer",
            "minimum": 0
          },
          "ready": {
            "type": "boolean"
          },
          "sourceSame": {
            "type": "boolean"
          }
        }
      }
    },
    "declaredCases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "source",
          "accepted"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "normal",
              "opaque",
              "skipped"
            ]
          },
          "source": {
            "type": "object"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "shapeCases": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "declarations",
          "fields",
          "turns",
          "work",
          "inspected",
          "ready",
          "refused"
        ],
        "properties": {
          "declarations": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                {
                  "type": "boolean"
                }
              ],
              "items": false,
              "minItems": 2
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                {
                  "type": "boolean"
                }
              ],
              "items": false,
              "minItems": 2
            }
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          },
          "work": {
            "type": "integer",
            "minimum": 0
          },
          "inspected": {
            "type": "integer",
            "minimum": 0
          },
          "ready": {
            "type": "boolean"
          },
          "refused": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
