{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owner",
    "package",
    "capture",
    "mappings",
    "specificFamilies",
    "originalLawCohorts",
    "consumers",
    "composition",
    "independentCases",
    "refusedEscapes",
    "lexicalCases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "owner": {
      "const": "🧰️framework/🔨️modules/🗣️dsl"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "library",
        "manifest"
      ],
      "properties": {
        "name": {
          "const": "semio-framework-dsl"
        },
        "library": {
          "const": "semio_framework_dsl"
        },
        "manifest": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "inputs",
        "callerCandidates",
        "constructorReferences"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "inputs": {
          "type": "integer",
          "minimum": 1
        },
        "callerCandidates": {
          "type": "integer",
          "minimum": 1
        },
        "constructorReferences": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "source",
          "destination",
          "sha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "token",
              "lexer",
              "trust",
              "grammar",
              "literal",
              "idiom"
            ]
          },
          "source": {
            "$ref": "#/$defs/path"
          },
          "destination": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "specificFamilies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "sha256",
          "owner"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "owner": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "originalLawCohorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "sha256",
          "count"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "manifest",
          "source",
          "root",
          "boundary"
        ],
        "properties": {
          "owner": {
            "$ref": "#/$defs/path"
          },
          "manifest": {
            "$ref": "#/$defs/path"
          },
          "source": {
            "$ref": "#/$defs/path"
          },
          "root": {
            "$ref": "#/$defs/path"
          },
          "boundary": {
            "enum": [
              "complete-package",
              "language-only"
            ]
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragments",
        "macroMatchers",
        "unknownFragment",
        "defaultFamilyKnowledge",
        "formatClassification",
        "publicCompatibilityForwards"
      ],
      "properties": {
        "fragments": {
          "const": "explicit-selected-registration"
        },
        "macroMatchers": {
          "const": "explicit-selected-registration"
        },
        "unknownFragment": {
          "const": "refuse"
        },
        "defaultFamilyKnowledge": {
          "const": "specific-owner"
        },
        "formatClassification": {
          "const": "specific-owner"
        },
        "publicCompatibilityForwards": {
          "const": false
        }
      }
    },
    "independentCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "escaped",
          "jsonWire"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/path"
          },
          "text": {
            "type": "string"
          },
          "escaped": {
            "type": "string"
          },
          "jsonWire": {
            "type": "string"
          }
        }
      }
    },
    "refusedEscapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "escaped",
          "error"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/path"
          },
          "escaped": {
            "type": "string"
          },
          "error": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "lexicalCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "tokens"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/path"
          },
          "text": {
            "type": "string"
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "text",
                "start",
                "end"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "Ident",
                    "Int",
                    "Equals",
                    "Comma"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
