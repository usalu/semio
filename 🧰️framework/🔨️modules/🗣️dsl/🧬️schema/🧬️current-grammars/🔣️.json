{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "minItems": 503,
      "maxItems": 503,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "originalSha256",
          "currentSha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "originalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "currentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "current": {
            "type": "string"
          }
        }
      }
    }
  }
}
