{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["objectKeys", "grants", "words", "numberKinds"],
  "properties": {
    "objectKeys": {"const": ["z", "a", "z", "int", "positiveInt", "float", "text", "bytes", "array", "object"]},
    "grants": {"const": [1, 7, 256]},
    "words": {"const": ["0000000000000000", "8000000000000000", "3ff0000000000000", "0000000000000001", "7ff0000000000000", "fff0000000000000", "7ff8000000000042", "7ff0000000000001", "fff8000000000011"]},
    "numberKinds": {"const": ["uint", "int", "float"]}
  }
}
