{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cardinalities",
    "primitive",
    "policies",
    "descriptor"
  ],
  "properties": {
    "cardinalities": {
      "const": [
        0,
        1,
        3,
        4,
        7,
        8,
        15,
        16,
        255,
        256,
        4095
      ]
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldIdStart",
        "integerStart"
      ],
      "properties": {
        "fieldIdStart": {
          "const": 1
        },
        "integerStart": {
          "const": -2048
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestAuthority",
        "admission",
        "exactCeiling",
        "minusOne",
        "zero",
        "retirement"
      ],
      "properties": {
        "requestAuthority": {
          "const": "observedAllocatorLayouts"
        },
        "admission": {
          "const": "atLeastAllBackingRequests"
        },
        "exactCeiling": {
          "const": "accept"
        },
        "minusOne": {
          "const": "ownershipLimit"
        },
        "zero": {
          "const": "onlyAllocationFree"
        },
        "retirement": {
          "const": "noCumulativeRefund"
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinctIds",
        "insertionsEqualDeclaredCount"
      ],
      "properties": {
        "distinctIds": {
          "const": true
        },
        "insertionsEqualDeclaredCount": {
          "const": true
        }
      }
    }
  }
}
