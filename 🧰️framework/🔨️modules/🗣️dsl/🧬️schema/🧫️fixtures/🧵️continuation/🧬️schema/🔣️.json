{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.dsl.record.continuation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "textUnit",
    "textRepeats",
    "budgets",
    "retirementBytes",
    "maximumBytes",
    "cancelUnits",
    "firstStep",
    "sourceReleases",
    "projection",
    "intrinsic",
    "nested",
    "table",
    "containers",
    "wire",
    "depthCases"
  ],
  "properties": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "textRepeats",
        "sourceIdentity",
        "staleSource",
        "intrinsic",
        "taggedAndWire",
        "sourceCapacity"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "textRepeats": {
          "type": "integer",
          "minimum": 1
        },
        "sourceIdentity": {
          "const": "immutable"
        },
        "staleSource": {
          "const": "refuse"
        },
        "intrinsic": {
          "const": true
        },
        "taggedAndWire": {
          "const": true
        },
        "sourceCapacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "measureBeforeAllocation",
            "ownershipSourceMultiples",
            "overSourceBytes"
          ],
          "properties": {
            "measureBeforeAllocation": {
              "const": true
            },
            "ownershipSourceMultiples": {
              "const": 32
            },
            "overSourceBytes": {
              "const": 1
            }
          }
        }
      }
    },
    "schema": {
      "const": "semio.dsl.record.continuation/v1"
    },
    "textUnit": {
      "type": "string"
    },
    "textRepeats": {
      "type": "integer",
      "minimum": 1
    },
    "budgets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "retirementBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maximumBytes": {
      "type": "integer",
      "minimum": 1
    },
    "cancelUnits": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "firstStep": {
      "const": "progress"
    },
    "sourceReleases": {
      "const": 1
    },
    "intrinsic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyPrefix",
        "keyRepeats",
        "textRepeats",
        "bytes",
        "cases"
      ],
      "properties": {
        "keyPrefix": {
          "type": "string"
        },
        "keyRepeats": {
          "type": "integer",
          "minimum": 1
        },
        "textRepeats": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "nested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "keyword",
        "labelPrefix"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "keyword": {
          "type": "string"
        },
        "labelPrefix": {
          "type": "string"
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "labelPrefix",
        "columns"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "labelPrefix": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "containers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "list",
        "tuple"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tuple": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "fromKind",
        "fromPort",
        "to",
        "toKind",
        "toPort",
        "labelId",
        "labelKind",
        "repeats"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "fromKind": {
          "type": "string"
        },
        "fromPort": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "toKind": {
          "type": "string"
        },
        "toPort": {
          "type": "string"
        },
        "labelId": {
          "type": "string"
        },
        "labelKind": {
          "type": "string"
        },
        "repeats": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "depthCases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wraps",
          "accept"
        ],
        "properties": {
          "wraps": {
            "type": "integer",
            "minimum": 0
          },
          "accept": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
