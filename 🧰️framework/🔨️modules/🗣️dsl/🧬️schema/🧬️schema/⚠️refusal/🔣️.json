{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/dsl/record/refusal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "boundary",
          "message",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "invalidValue",
              "canceled",
              "ownershipLimit",
              "allocationFailed",
              "workLimit",
              "depthLimit",
              "unsupportedOwner",
              "invariantViolated"
            ]
          },
          "boundary": {
            "enum": [
              "field",
              "record",
              "boxed"
            ]
          },
          "message": {
            "type": "string"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "message"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "invalidValue",
                  "canceled",
                  "ownershipLimit",
                  "allocationFailed",
                  "workLimit",
                  "depthLimit",
                  "unsupportedOwner",
                  "invariantViolated"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
