{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "cases"
  ],
  "properties": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window",
        "locale"
      ],
      "properties": {
        "window": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "enum": [
            "en",
            "de"
          ]
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "window",
          "locale",
          "generation",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "window": {
            "type": "string"
          },
          "locale": {
            "enum": [
              "en",
              "de"
            ]
          },
          "generation": {
            "type": "string"
          },
          "expected": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
