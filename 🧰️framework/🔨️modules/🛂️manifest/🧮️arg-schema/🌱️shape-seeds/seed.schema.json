{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/manifest/action-arg-shape-seeds.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaPath",
      "value"
    ],
    "properties": {
      "schemaPath": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "value": {},
      "variantSelector": {
        "type": "integer",
        "minimum": 0
      },
      "key": {
        "type": "string"
      },
      "children": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "singleton": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {}
      }
    }
  }
}
