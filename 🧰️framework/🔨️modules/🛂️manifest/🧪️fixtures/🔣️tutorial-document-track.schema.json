{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false, "required": ["document", "cases"],
  "properties": {
    "document": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["at", "kind"],
      "properties": {
        "at": { "type": "integer", "minimum": 0 },
        "kind": { "type": "object", "additionalProperties": false, "required": ["kind", "documentDsl", "previousDsl"], "properties": {
          "kind": { "const": "load" }, "documentDsl": { "type": "string" }, "previousDsl": { "type": "string" }
        } }
      }
    } },
    "cases": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "forward", "expectedAt"], "properties": {
        "from": { "type": "number", "minimum": 0 }, "to": { "type": "number", "minimum": 0 }, "forward": { "type": "boolean" },
        "expectedAt": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    } }
  }
}
