{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/manifest/artifact-kind-formats-fixture-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "sourceFormat", "componentKind", "dimension", "mediaCapability", "mediaType", "schema", "exportFormats", "importFormats", "exportStdioKinds", "importStdioKinds"],
  "properties": {
    "id": { "const": "s.fixture.document" },
    "name": { "const": "Format Roundtrip" },
    "sourceFormat": { "const": "fixture.document" },
    "componentKind": { "const": "fixture" },
    "dimension": { "const": "2d" },
    "mediaCapability": { "const": "meshOnly" },
    "mediaType": { "const": { "class": "twoD", "form": "vector" } },
    "schema": { "const": "fixture.document" },
    "exportFormats": { "const": [] },
    "importFormats": { "const": [] },
    "exportStdioKinds": { "const": ["stdio.svg", "stdio.png"] },
    "importStdioKinds": { "const": ["stdio.dwg", "stdio.svg"] }
  }
}
