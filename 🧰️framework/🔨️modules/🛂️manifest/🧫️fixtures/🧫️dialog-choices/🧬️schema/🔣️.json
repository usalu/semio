{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/manifest/dialog-choices.fixture.json",
  "title": "DialogChoicesFixture",
  "description": "A dialog with decision choices, its seed context, the focus order every renderer lays its controls out in, per staged field values the buttons enabled and disabled and the dispatch each enabled button sends, and the assembly verdicts on dialogs breaking the choice law.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "note", "dialog", "seed", "focusOrder", "cases", "invalid"],
  "$defs": {
    "text": { "type": "object", "additionalProperties": false, "required": ["en", "de"], "properties": { "en": { "type": "string", "minLength": 1 }, "de": { "type": "string", "minLength": 1 } } },
    "label": { "type": "object", "additionalProperties": false, "required": ["native", "reuse"], "properties": { "native": { "$ref": "#/$defs/text" }, "reuse": { "$ref": "#/$defs/text" } } },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/label" },
        "action": { "type": "string", "minLength": 1 },
        "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tone": { "enum": ["neutral", "primary", "secondary", "tertiary", "info", "success", "warning", "danger"] },
        "destructive": { "type": "boolean" }
      }
    },
    "button": { "type": "string", "pattern": "^(submit|cancel|choice:[A-Za-z0-9_-]+|field:[A-Za-z0-9_-]+)$" }
  },
  "properties": {
    "$schema": { "const": "./🧬️schema/🔣️.json" },
    "note": { "type": "string", "minLength": 1 },
    "dialog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "args", "submitAction", "submitLabel", "choices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/label" },
        "body": { "$ref": "#/$defs/label" },
        "args": { "type": "array", "items": { "type": "object", "required": ["id", "label", "schema", "required"], "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "$ref": "#/$defs/label" }, "schema": { "type": "object" }, "required": { "type": "boolean" }, "default": {} } } },
        "submitAction": { "type": "string", "minLength": 1 },
        "submitLabel": { "$ref": "#/$defs/label" },
        "cancelAction": { "type": "string", "minLength": 1 },
        "cancelLabel": { "$ref": "#/$defs/label" },
        "choices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/choice" } }
      }
    },
    "seed": { "type": "object" },
    "focusOrder": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/button" } },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "staged", "enabled", "disabled", "dispatches"],
        "properties": {
          "case": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "staged": { "type": "object" },
          "enabled": { "type": "array", "items": { "$ref": "#/$defs/button" } },
          "disabled": { "type": "array", "items": { "$ref": "#/$defs/button" } },
          "dispatches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["button", "action", "args"],
              "properties": { "button": { "$ref": "#/$defs/button" }, "action": { "type": "string", "minLength": 1 }, "args": { "type": ["object", "null"] } }
            }
          }
        }
      }
    },
    "invalid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "choiceIds", "argIds", "reason"],
        "properties": { "case": { "type": "string", "minLength": 1 }, "choiceIds": { "type": "array", "items": { "type": "string" } }, "argIds": { "type": "array", "items": { "type": "string" } }, "requires": { "type": "array", "items": { "type": "string" } }, "reason": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
