          "schema": { "kind": "number", "min": -3.141592653589793, "max": 3.141592653589793, "step": 0.017453292519943295, "integer": false, "unit": "rad", "snaps": [0, 1.5707963267948966, 3.141592653589793], "precision": 1, "displayUnit": "°", "displayFactor": 57.29577951308232 },
          "presentation": { "kind": "dial" },
          "required": true
        },
        {
          "id": "/pivotX",
          "label": { "native": { "en": "Pivot X", "de": "Drehpunkt X" }, "reuse": { "en": "Pivot X", "de": "Drehpunkt X" } },
          "schema": { "kind": "number", "integer": false },
          "required": true
        },
        {
          "id": "/pivotY",
          "label": { "native": { "en": "Pivot Y", "de": "Drehpunkt Y" }, "reuse": { "en": "Pivot Y", "de": "Drehpunkt Y" } },
          "schema": { "kind": "number", "integer": false },
          "required": true
        }
      ]
    },
