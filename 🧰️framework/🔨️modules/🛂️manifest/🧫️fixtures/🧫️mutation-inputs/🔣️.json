    {
      "name": "nested-object-array-and-vector",
      "leafSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "placements"],
        "properties": {
          "node": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "kind": { "type": "string", "enum": ["fixed", "derived"], "x-semio-ui": { "options": { "fixed": { "en": "Fixed", "de": "Fest" }, "derived": { "en": "Derived", "de": "Abgeleitet" } } } }
            },
            "x-semio-ui": { "label": { "en": "Node", "de": "Knoten" }, "group": "node" }
          },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["objectId", "newOrigin"],
              "properties": {
                "objectId": { "type": "string" },
                "newOrigin": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
              }
            }
          },
          "newPosition": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "x-semio-ui": { "widget": "vector", "unit": "m", "step": 0.5 } }
        }
      },
      "expectedInputs": [
        {
          "id": "/node",
          "label": { "native": { "en": "Node", "de": "Knoten" }, "reuse": { "en": "Node", "de": "Knoten" } },
          "schema": {
            "kind": "object",
            "fields": [
              { "id": "/x", "label": { "native": { "en": "X", "de": "X" }, "reuse": { "en": "X", "de": "X" } }, "schema": { "kind": "number", "integer": false }, "required": true },
              { "id": "/y", "label": { "native": { "en": "Y", "de": "Y" }, "reuse": { "en": "Y", "de": "Y" } }, "schema": { "kind": "number", "integer": false }, "required": true },
              {
                "id": "/kind",
                "label": { "native": { "en": "Kind", "de": "Art" }, "reuse": { "en": "Kind", "de": "Art" } },
                "schema": {
                  "kind": "string",
                  "options": [
                    { "value": "fixed", "label": { "native": { "en": "Fixed", "de": "Fest" }, "reuse": { "en": "Fixed", "de": "Fest" } } },
                    { "value": "derived", "label": { "native": { "en": "Derived", "de": "Abgeleitet" }, "reuse": { "en": "Derived", "de": "Abgeleitet" } } }
                  ]
                },
                "required": false
              }
            ]
          },
          "required": true,
          "group": "node"
        },
        {
          "id": "/placements",
          "label": { "native": { "en": "Placements", "de": "Platzierungen" }, "reuse": { "en": "Placements", "de": "Platzierungen" } },
          "schema": {
            "kind": "array",
            "items": {
              "kind": "object",
              "fields": [
                { "id": "/objectId", "label": { "native": { "en": "Object ID", "de": "Objekt-ID" }, "reuse": { "en": "Object ID", "de": "Objekt-ID" } }, "schema": { "kind": "reference", "kinds": ["object"] }, "required": true },
                { "id": "/newOrigin", "label": { "native": { "en": "New Origin", "de": "Neuer Ursprung" }, "reuse": { "en": "New Origin", "de": "Neuer Ursprung" } }, "schema": { "kind": "vector", "dims": 3 }, "required": true }
              ]
            }
          },
          "required": true
        },
        {
          "id": "/newPosition",
          "label": { "native": { "en": "New Position", "de": "Neue Position" }, "reuse": { "en": "New Position", "de": "Neue Position" } },
          "schema": { "kind": "vector", "dims": 3, "unit": "m", "step": 0.5 },
          "required": false
        }
      ]
    },
