  "cases": [
    {
      "name": "annotated-drag-selection",
      "leafSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "DragSelection",
        "type": "object",
        "additionalProperties": false,
        "required": ["mutation", "targets", "dx", "dy"],
        "properties": {
          "mutation": { "const": "dragSelection", "x-semio-ui": { "role": "discriminator", "widget": "hidden" } },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" },
            "x-semio-ui": {
              "widget": "reference",
              "role": "target",
              "label": { "en": "Targets", "de": "Ziele" },
              "description": { "en": "Nodes and target regions to drag.", "de": "Zu ziehende Knoten und Zielbereiche." },
              "ref": { "kind": ["node", "targetRegion"], "domain": "vortex", "granularity": "node" },
              "group": "targets",
              "order": 0
            }
          },
          "dx": { "type": "number", "x-semio-ui": { "widget": "stepper", "label": { "en": "Offset X", "de": "Versatz X" }, "step": 1, "precision": 2, "unit": "px", "snapSource": { "config": "gridFactor" }, "group": "offset", "order": 1 } },
          "dy": { "type": "number", "x-semio-ui": { "widget": "stepper", "label": { "en": "Offset Y", "de": "Versatz Y" }, "step": 1, "precision": 2, "unit": "px", "snapSource": { "config": "gridFactor" }, "group": "offset", "order": 2 } }
        }
      },
      "expectedInputs": [
        {
          "id": "/targets",
          "label": { "native": { "en": "Targets", "de": "Ziele" }, "reuse": { "en": "Targets", "de": "Ziele" } },
          "schema": { "kind": "reference", "kinds": ["node", "targetRegion"], "domain": "vortex", "granularity": "node", "many": true, "minItems": 1 },
          "required": true,
          "description": { "native": { "en": "Nodes and target regions to drag.", "de": "Zu ziehende Knoten und Zielbereiche." }, "reuse": { "en": "Nodes and target regions to drag.", "de": "Zu ziehende Knoten und Zielbereiche." } },
          "group": "targets",
          "order": 0
        },
        {
          "id": "/dx",
          "label": { "native": { "en": "Offset X", "de": "Versatz X" }, "reuse": { "en": "Offset X", "de": "Versatz X" } },
          "schema": { "kind": "number", "step": 1, "integer": false, "unit": "px", "snapSource": { "kind": "config", "key": "gridFactor" }, "precision": 2 },
          "presentation": { "kind": "stepper" },
          "required": true,
          "group": "offset",
          "order": 1
        },
        {
          "id": "/dy",
          "label": { "native": { "en": "Offset Y", "de": "Versatz Y" }, "reuse": { "en": "Offset Y", "de": "Versatz Y" } },
          "schema": { "kind": "number", "step": 1, "integer": false, "unit": "px", "snapSource": { "kind": "config", "key": "gridFactor" }, "precision": 2 },
          "presentation": { "kind": "stepper" },
          "required": true,
          "group": "offset",
          "order": 2
        }
      ]
    },
    {
      "name": "dial-in-degrees",
      "leafSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": ["angle", "pivotX", "pivotY"],
        "properties": {
          "angle": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793,
