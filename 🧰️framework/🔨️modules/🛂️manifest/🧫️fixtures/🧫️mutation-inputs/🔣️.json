        "type": "object",
        "additionalProperties": false,
        "properties": {
          "factor": { "type": "number", "exclusiveMinimum": 0, "maximum": 100, "default": 1, "x-semio-ui": { "widget": "slider", "label": { "en": "Factor", "de": "Faktor" }, "softMin": 0.1, "softMax": 10, "scale": "log", "snaps": [0.5, 1, 2], "precision": 2 } }
        }
