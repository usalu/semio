    {
      "name": "discriminated-union-annotated-variants",
      "leafSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [{ "$ref": "#/$defs/SetOpacity" }, { "$ref": "#/$defs/SetVisible" }, { "$ref": "#/$defs/SetName" }, { "$ref": "#/$defs/SetCount" }, { "$ref": "#/$defs/Reset" }],
        "$defs": {
          "SetOpacity": {
            "type": "object",
