{
  "schema": "semio.manifest.mutation-input-corpus/v1",
  "documents": {
    "https://json.schemas.assets.semio-tech.com/test/input-ui/shared.json": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "https://json.schemas.assets.semio-tech.com/test/input-ui/shared.json",
      "$defs": {
        "Length": { "type": "number", "minimum": 0, "x-semio-ui": { "unit": "m", "step": 0.1, "precision": 3, "label": { "en": "Length", "de": "Länge" } } },
        "Radius": { "$ref": "#/$defs/Length", "x-semio-ui": { "label": { "en": "Radius", "de": "Radius" } } }
      }
