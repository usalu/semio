        { "id": "/id", "label": { "native": { "en": "ID", "de": "ID" }, "reuse": { "en": "ID", "de": "ID" } }, "schema": { "kind": "string" }, "required": true },
        { "id": "/index", "label": { "native": { "en": "Index", "de": "Index" }, "reuse": { "en": "Index", "de": "Index" } }, "schema": { "kind": "number", "min": 0, "step": 1, "integer": true }, "required": true },
        { "id": "/newName", "label": { "native": { "en": "New Name", "de": "Neuer Name" }, "reuse": { "en": "New Name", "de": "Neuer Name" } }, "schema": { "kind": "string", "minLen": 1, "maxLen": 64 }, "required": true },
        { "id": "/value", "label": { "native": { "en": "Value", "de": "Wert" }, "reuse": { "en": "Value", "de": "Wert" } }, "schema": { "kind": "number", "min": 0, "max": 1, "integer": false }, "required": false },
        { "id": "/visible", "label": { "native": { "en": "Visible", "de": "Sichtbar" }, "reuse": { "en": "Visible", "de": "Sichtbar" } }, "schema": { "kind": "boolean" }, "required": false },
        { "id": "/layerId", "label": { "native": { "en": "Layer ID", "de": "Ebenen-ID" }, "reuse": { "en": "Layer ID", "de": "Ebenen-ID" } }, "schema": { "kind": "reference", "kinds": ["layer"] }, "required": false },
        { "id": "/newZoneId", "label": { "native": { "en": "New Zone ID", "de": "Neue Zonen-ID" }, "reuse": { "en": "New Zone ID", "de": "Neue Zonen-ID" } }, "schema": { "kind": "reference", "kinds": ["zone"] }, "required": false },
        { "id": "/ids", "label": { "native": { "en": "IDs", "de": "IDs" }, "reuse": { "en": "IDs", "de": "IDs" } }, "schema": { "kind": "array", "items": { "kind": "string" }, "maxItems": 8 }, "required": false },
        { "id": "/count", "label": { "native": { "en": "Count", "de": "Anzahl" }, "reuse": { "en": "Count", "de": "Anzahl" } }, "schema": { "kind": "number", "min": 1, "step": 1, "integer": true }, "required": false, "nullable": true }
      ]
    },
    {
      "name": "local-defs-override-options-nullable",
      "leafSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": ["opacity"],
        "properties": {
          "opacity": { "$ref": "#/$defs/UnitInterval", "x-semio-ui": { "label": { "en": "Opacity", "de": "Deckkraft" }, "order": 20 } },
          "blendMode": { "$ref": "#/$defs/BlendMode", "x-semio-ui": { "label": { "native": { "en": "Blend Mode", "de": "Mischmodus" }, "reuse": { "en": "Blending", "de": "Überblendung" } } } },
          "tint": { "oneOf": [{ "$ref": "#/$defs/UnitInterval" }, { "type": "null" }], "x-semio-ui": { "label": { "en": "Tint", "de": "Tönung" } } }
        },
        "$defs": {
          "UnitInterval": { "type": "number", "minimum": 0, "maximum": 1, "x-semio-ui": { "widget": "slider", "step": 0.01, "precision": 2, "label": { "en": "Fraction", "de": "Anteil" }, "group": "appearance" } },
          "BlendMode": { "type": "string", "enum": ["normal", "multiply"], "x-semio-ui": { "widget": "segmented", "options": { "normal": { "en": "Normal", "de": "Normal" }, "multiply": { "en": "Multiply", "de": "Multiplizieren" } } } }
        }
      },
      "expectedInputs": [
        {
          "id": "/opacity",
          "label": { "native": { "en": "Opacity", "de": "Deckkraft" }, "reuse": { "en": "Opacity", "de": "Deckkraft" } },
          "schema": { "kind": "number", "min": 0, "max": 1, "step": 0.01, "integer": false, "precision": 2 },
          "presentation": { "kind": "slider" },
          "required": true,
          "group": "appearance",
          "order": 20
        },
        {
          "id": "/blendMode",
          "label": { "native": { "en": "Blend Mode", "de": "Mischmodus" }, "reuse": { "en": "Blending", "de": "Überblendung" } },
          "schema": {
            "kind": "string",
            "options": [
              { "value": "normal", "label": { "native": { "en": "Normal", "de": "Normal" }, "reuse": { "en": "Normal", "de": "Normal" } } },
              { "value": "multiply", "label": { "native": { "en": "Multiply", "de": "Multiplizieren" }, "reuse": { "en": "Multiply", "de": "Multiplizieren" } } }
            ]
          },
          "presentation": { "kind": "segmented" },
          "required": false
        },
        {
          "id": "/tint",
          "label": { "native": { "en": "Tint", "de": "Tönung" }, "reuse": { "en": "Tint", "de": "Tönung" } },
          "schema": { "kind": "number", "min": 0, "max": 1, "step": 0.01, "integer": false, "precision": 2 },
          "presentation": { "kind": "slider" },
          "required": false,
          "nullable": true,
          "group": "appearance"
        }
      ]
    },
