{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/manifest/schema.json",
  "title": "Manifest Schema Module",
  "$defs": {
    "TutorialLocalInteractionFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainOrder",
        "cases",
        "captureIdentityIsHistoricalContent",
        "restoreUsesCurrentIdentity",
        "fullRestoreClearsAbsentDomains",
        "absentCaptureDefaultsToEmpty"
      ],
      "properties": {
        "domainOrder": {
          "const": "utf16-code-unit-lexicographic"
        },
        "cases": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "before",
              "after",
              "changes"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/State"
              },
              "after": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/State"
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "domainId",
                    "patch"
                  ],
                  "properties": {
                    "kind": {
                      "const": "localInteractionDomain"
                    },
                    "domainId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "patch": {
                      "$ref": "https://json.schemas.assets.semio-tech.com/framework/replication/wire/local-interaction/schema.json#/$defs/DomainPatch"
                    }
                  }
                }
              }
            }
          }
        },
        "captureIdentityIsHistoricalContent": {
          "const": false
        },
        "restoreUsesCurrentIdentity": {
          "const": true
        },
        "fullRestoreClearsAbsentDomains": {
          "const": true
        },
        "absentCaptureDefaultsToEmpty": {
          "const": false
        }
      }
    },
    "ActionSemanticsFixture": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "semantics"
        ],
        "properties": {
          "kind": {
            "enum": [
              "mutation",
              "view",
              "interaction",
              "history",
              "clipboard",
              "shell"
            ]
          },
          "semantics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effects",
              "policy",
              "execution",
              "useWhen",
              "examples"
            ],
            "properties": {
              "effects": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reads",
                  "writes",
                  "external",
                  "destructive",
                  "reversible"
                ],
                "properties": {
                  "reads": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "writes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "external": {
                    "type": "boolean"
                  },
                  "destructive": {
                    "type": "boolean"
                  },
                  "reversible": {
                    "type": "boolean"
                  }
                }
              },
              "policy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scopes",
                  "approval"
                ],
                "properties": {
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "approval": {
                    "enum": [
                      "never",
                      "whenDestructive",
                      "always"
                    ]
                  }
                }
              },
              "execution": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "preview",
                  "undo",
                  "idempotency",
                  "expectedRevision",
                  "cancellable",
                  "class",
                  "interactiveJob"
                ],
                "properties": {
                  "preview": {
                    "enum": [
                      "none",
                      "dryRun",
                      "diff"
                    ]
                  },
                  "undo": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "none",
                          "inverse"
                        ]
                      }
                    }
                  },
                  "idempotency": {
                    "enum": [
                      "natural",
                      "key",
                      "none"
                    ]
                  },
                  "expectedRevision": {
                    "type": "boolean"
                  },
                  "cancellable": {
                    "type": "boolean"
                  },
                  "class": {
                    "enum": [
                      "interactive",
                      "background",
                      "job"
                    ]
                  },
                  "interactiveJob": {
                    "const": "unclassified"
                  }
                }
              },
              "useWhen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "CapabilityDescription": {
      "description": "💬️ What an agent-published verb says about itself in `semantics.description` — every `ActionDefinition`/`CommandDefinition` whose resolved `CapabilityAudience` is `agent` MUST declare one. The `LocalizedLabel` matrix (terminology × locale): every cell is one to three sentences on one line saying what the verb does, to what, and with which consequence; a destructive or export verb names exactly what is lost or written. English AND German, no default language. Three cross-field rules a JSON Schema cannot state are part of this contract and are enforced identically by Rust `catalog::description_problems` and TypeScript `capabilityDescriptionProblems` (`🌉️mcp/🗂️catalog`): the German cell differs from the English cell, no cell repeats the verb's own title in that locale, and no two verbs of one app share an English description.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native",
        "reuse"
      ],
      "properties": {
        "native": {
          "$ref": "#/$defs/CapabilityDescriptionLocales"
        },
        "reuse": {
          "$ref": "#/$defs/CapabilityDescriptionLocales"
        }
      }
    },
    "CapabilityDescriptionLocales": {
      "description": "🌐️ One terminology row of a `CapabilityDescription`: an English and a German sentence, both required.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "de",
        "en"
      ],
      "properties": {
        "de": {
          "$ref": "#/$defs/CapabilityDescriptionSentence"
        },
        "en": {
          "$ref": "#/$defs/CapabilityDescriptionSentence"
        }
      }
    },
    "CapabilityDescriptionSentence": {
      "description": "✍️ One cell of a `CapabilityDescription`: starts with a capital letter or digit, stays on one line, ends with sentence punctuation, and is long enough to name an object and a consequence.",
      "type": "string",
      "minLength": 24,
      "maxLength": 480,
      "pattern": "^[A-ZÄÖÜ0-9].*[.!?]$"
    },
    "CapabilityDescriptionFixture": {
      "description": "⚖️ Language-agnostic law cases for `CapabilityDescription`: each row is one app's agent-published verbs (id, localized title, declared description or null) and the exact `(verb, problem)` list both implementations must report.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "verbs",
          "problems"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "verbs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "de",
                    "en"
                  ],
                  "properties": {
                    "de": {
                      "type": "string"
                    },
                    "en": {
                      "type": "string"
                    }
                  }
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verb",
                "problem"
              ],
              "properties": {
                "verb": {
                  "type": "string",
                  "minLength": 1
                },
                "problem": {
                  "enum": [
                    "missing",
                    "schema",
                    "untranslated",
                    "repeatsTitle",
                    "sharedWithinApp"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "ArtifactKindFormatsFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "sourceFormat",
        "componentKind",
        "dimension",
        "mediaCapability",
        "mediaType",
        "schema",
        "exportFormats",
        "importFormats",
        "exportStdioKinds",
        "importStdioKinds"
      ],
      "properties": {
        "id": {
          "const": "s.fixture.document"
        },
        "label": {
          "const": {
            "native": {
              "de": "Format-Rundlauf",
              "en": "Format Roundtrip"
            },
            "reuse": {
              "de": "Format-Rundlauf",
              "en": "Format Roundtrip"
            }
          }
        },
        "sourceFormat": {
          "const": "fixture.document"
        },
        "componentKind": {
          "const": "hostSnapshot"
        },
        "dimension": {
          "const": "2d"
        },
        "mediaCapability": {
          "const": "meshOnly"
        },
        "mediaType": {
          "const": {
            "class": "twoD",
            "form": "vector"
          }
        },
        "schema": {
          "const": "fixture.document"
        },
        "exportFormats": {
          "const": []
        },
        "importFormats": {
          "const": []
        },
        "exportStdioKinds": {
          "const": [
            "stdio.svg",
            "stdio.png"
          ]
        },
        "importStdioKinds": {
          "const": [
            "stdio.dwg",
            "stdio.svg"
          ]
        }
      }
    },
    "TutorialDocumentTrackFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "cases"
      ],
      "properties": {
        "document": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "kind"
            ],
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "documentDsl",
                  "previousDsl"
                ],
                "properties": {
                  "kind": {
                    "const": "load"
                  },
                  "documentDsl": {
                    "type": "string"
                  },
                  "previousDsl": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "forward",
              "expectedAt"
            ],
            "properties": {
              "from": {
                "type": "number",
                "minimum": 0
              },
              "to": {
                "type": "number",
                "minimum": 0
              },
              "forward": {
                "type": "boolean"
              },
              "expectedAt": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "AppRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "appId"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "Plugin",
              "de": "Plugin"
            },
            "group": "app",
            "order": 10
          }
        },
        "appId": {
          "type": "string",
          "x-semio-ui": {
            "widget": "text",
            "role": "value",
            "label": {
              "en": "App",
              "de": "App"
            },
            "group": "app",
            "order": 20
          }
        }
      }
    },
    "AppRole": {
      "type": "string",
      "enum": [
        "viewer",
        "editor"
      ]
    },
    "ExamplePickerFixture": {
      "description": "📚️ THE example-picker predicate, language-agnostically: which authored examples one app surface may offer. An example carries the DIALECT it was authored for, so the editor and the viewer of one artifact resolve exactly the same picker. Answered by Rust `manifest::examples_for_app` and by TypeScript `examplesForApp` (🛂️manifest/🟦️.ts).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examples",
        "cases"
      ],
      "properties": {
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "dialect"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "dialect": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifactKind",
                  "standard",
                  "subset"
                ],
                "properties": {
                  "artifactKind": {
                    "type": "string"
                  },
                  "standard": {
                    "type": "string"
                  },
                  "subset": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "app",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "app": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "role",
                  "dialect"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "role": {
                    "enum": [
                      "editor",
                      "viewer"
                    ]
                  },
                  "dialect": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "artifactKind",
                      "standard",
                      "subset"
                    ],
                    "properties": {
                      "artifactKind": {
                        "type": "string"
                      },
                      "standard": {
                        "type": "string"
                      },
                      "subset": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "ToolRunDefinition": {
      "$ref": "https://json.schemas.assets.semio-tech.com/framework/tool-run/schema.json#/$defs/ToolRunDefinition"
    },
    "ToolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "iconId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/tool-run/schema.json#/$defs/LocalizedLabel"
        },
        "iconId": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "string",
          "minLength": 1
        },
        "run": {
          "$ref": "#/$defs/ToolRunDefinition"
        }
      }
    },
    "UtilityDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "iconId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/tool-run/schema.json#/$defs/LocalizedLabel"
        },
        "iconId": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        },
        "keys": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "type": "string"
        },
        "category": {
          "enum": [
            "selection",
            "utilities",
            "history",
            "sync"
          ]
        },
        "allowsActionsWhileActive": {
          "type": "boolean"
        },
        "run": {
          "$ref": "#/$defs/ToolRunDefinition"
        }
      }
    },
    "ToolRunActionsFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actions",
        "reservedChords",
        "cases"
      ],
      "properties": {
        "kind": {
          "const": "history"
        },
        "actions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "iconId",
              "label",
              "args"
            ],
            "oneOf": [
              {
                "required": [
                  "keys"
                ],
                "properties": {
                  "keys": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "panelChord"
                ],
                "properties": {
                  "panelChord": {
                    "type": "string"
                  }
                }
              }
            ],
            "properties": {
              "id": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/tool-run/schema.json#/$defs/ToolRunActionId"
              },
              "iconId": {
                "type": "string",
                "minLength": 1
              },
              "keys": {
                "type": "string",
                "pattern": "^[a-z0-9.+]+$"
              },
              "panelChord": {
                "type": "string",
                "pattern": "^[a-z0-9.+]+$"
              },
              "label": {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/tool-run/schema.json#/$defs/LocaleText"
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "schema",
                    "required",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "enum": [
                        "toolId",
                        "windowId",
                        "runId",
                        "generation"
                      ]
                    },
                    "schema": {
                      "enum": [
                        "text",
                        "integer"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "label": {
                      "$ref": "https://json.schemas.assets.semio-tech.com/framework/tool-run/schema.json#/$defs/LocaleText"
                    }
                  }
                }
              }
            }
          }
        },
        "reservedChords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "tools",
              "utilities",
              "injected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tools": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ToolDefinition"
                }
              },
              "utilities": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/UtilityDefinition"
                }
              },
              "injected": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "ShellFooterItemV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "placement",
        "caption",
        "logos"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "enum": [
            "leading",
            "trailing"
          ]
        },
        "caption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "de"
          ],
          "properties": {
            "en": {
              "type": "string"
            },
            "de": {
              "type": "string"
            }
          }
        },
        "separator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "de"
          ],
          "properties": {
            "en": {
              "type": "string"
            },
            "de": {
              "type": "string"
            }
          }
        },
        "logos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "href",
              "src",
              "alt"
            ],
            "properties": {
              "href": {
                "type": "string",
                "pattern": "^https://"
              },
              "src": {
                "type": "string",
                "pattern": "^/"
              },
              "darkSrc": {
                "type": "string",
                "pattern": "^/"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "x-semio-formats": [
        "🔣️jsonschema"
      ]
    },
    "InputLabel": {
      "description": "🌐️ A localized input label or description: one text per locale ({en, de}), or the full LocalizedLabel matrix ({native: {en, de}, reuse: {en, de}}). Every locale is required and no text is empty — there is no default language.",
      "oneOf": [
        { "$ref": "#/$defs/InputLabelLocales" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["native", "reuse"],
          "properties": {
            "native": { "$ref": "#/$defs/InputLabelLocales" },
            "reuse": { "$ref": "#/$defs/InputLabelLocales" }
          }
        }
      ],
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"]
    },
    "InputLabelLocales": {
      "description": "🌐️ One non-empty text per shell locale.",
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      },
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"]
    },
    "SchemaInvariant": {
      "description": "🧷️ One payload-intrinsic invariant a schema states that JSON Schema draft-07 cannot express (a cross-field or ordering rule): a stable kebab-case id, which a refusal outcome (`🎯️outcome`, code mutation.invariant) names as `invariant`, and its description per locale.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "$ref": "#/$defs/InputLabelLocales" }
      },
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"]
    },
    "SchemaInvariants": {
      "description": "🧷️ The value of one x-semio-invariant annotation: the invariants the annotated schema node states, each id unique within the annotation (one id may annotate every node it governs). Read by parseSchemaInvariants (TypeScript) and the schema-mutation-payload-parity lint.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/SchemaInvariant" },
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"]
    },
    "FaultNoticeCode": {
      "description": "📢️ An app fault notice code: three or more dot-separated kebab segments — the app, the area, the refusal (generation3d.gumball.mesh-missing). Read by manifest::is_fault_notice_code (Rust) and isFaultNoticeCode (TypeScript).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*){2,}$"
    },
    "FaultNoticeText": {
      "description": "🗣️ One notice text: not blank, each {name} placeholder a param name ([a-z][A-Za-z0-9]*) filled from Fault.params, no other brace. That every cell of a notice names the same placeholders is checked by validate_fault_notices / validateFaultNotices.",
      "allOf": [
        { "type": "string", "pattern": "\\S" },
        { "type": "string", "pattern": "^[^{}]*(?:\\{[a-z][A-Za-z0-9]*\\}[^{}]*)*$" }
      ]
    },
    "FaultNoticeLocales": {
      "description": "🌐️ One notice text per shell locale.",
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "$ref": "#/$defs/FaultNoticeText" },
        "de": { "$ref": "#/$defs/FaultNoticeText" }
      }
    },
    "FaultNoticeDefinition": {
      "description": "📢️ One app-declared fault notice (design §20.12, AppDefinition.faultNotices): the code a guest refusal carries and its text in every terminology × locale cell. Codes are unique within an app (validate_fault_notices).",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label"],
      "properties": {
        "code": { "$ref": "#/$defs/FaultNoticeCode" },
        "label": {
          "type": "object",
          "additionalProperties": false,
          "required": ["native", "reuse"],
          "properties": {
            "native": { "$ref": "#/$defs/FaultNoticeLocales" },
            "reuse": { "$ref": "#/$defs/FaultNoticeLocales" }
          }
        }
      }
    },
    "FaultNoticeTable": {
      "description": "📋️ An app's published fault notices, in declaration order.",
      "type": "array",
      "items": { "$ref": "#/$defs/FaultNoticeDefinition" }
    },
    "FaultNoticeCorpus": {
      "description": "📢️ The language-agnostic corpus of app fault notices (🧫️fixtures/🧫️fault-notices): tables with the exact refusals validate_fault_notices / validateFaultNotices answer and their schema-only verdict, and faults with the notice kernel::fault_notice / faultNotice and both shells resolve.",
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "appNotices", "tables", "resolutions"],
      "properties": {
        "note": { "type": "string", "minLength": 1 },
        "appNotices": { "type": "string", "minLength": 1 },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "schemaValid", "notices", "errors"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "schemaValid": { "type": "boolean" },
              "notices": { "type": "array", "items": { "type": "object" } },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["rule", "code"],
                  "properties": {
                    "rule": { "enum": ["syntax", "duplicate", "emptyText", "placeholder"] },
                    "code": { "type": "string" },
                    "terminology": { "enum": ["native", "reuse"] },
                    "locale": { "enum": ["en", "de"] }
                  }
                }
              }
            }
          }
        },
        "resolutions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "fault", "terminology", "locale", "expected"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "fault": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code"],
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "message": { "type": "string" },
                  "params": { "type": "object", "additionalProperties": { "type": "string" } },
                  "causes": {
                    "type": "array",
                    "items": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "type": "string", "minLength": 1 } } }
                  }
                }
              },
              "terminology": { "enum": ["native", "reuse"] },
              "locale": { "enum": ["en", "de"] },
              "expected": {
                "anyOf": [
                  { "type": "null" },
                  { "type": "object", "additionalProperties": false, "required": ["code", "text"], "properties": { "code": { "type": "string" }, "text": { "type": "string", "minLength": 1 } } }
                ]
              }
            }
          }
        }
      }
    },
    "InputUi": {
      "description": "🎛️ The value of the x-semio-ui annotation on one mutation input (a leaf payload property or the $defs entry it references): UI facts only, never a validation constraint — hard bounds stay in the standard keywords. An outer annotation overrides the one on its $ref target key by key. Read by manifest::mutation_input_defs (Rust) and mutationInputDefs (TypeScript).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "widget": { "enum": ["slider", "stepper", "dial", "toggle", "select", "segmented", "text", "multiline", "vector", "color", "reference", "hidden"] },
        "role": { "enum": ["value", "target", "discriminator"] },
        "label": { "$ref": "#/$defs/InputLabel" },
        "description": { "$ref": "#/$defs/InputLabel" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 15 },
        "softMin": { "type": "number" },
        "softMax": { "type": "number" },
        "snaps": { "type": "array", "items": { "type": "number" } },
        "optionSource": {
          "description": "🗝️ A string choice's options when no enum lists them: the KEYS of the object this RFC 6901 pointer template leads to in the document the editor previews; each {field} segment takes the edited payload's top-level member of that name — an object's key, or, on an array, the record whose own member of that name equals it (/hostSnapshot/widgets/{id}/params). A UI fact only — the payload schema stays open, so the fold decides an unknown key.",
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshot"],
          "properties": { "snapshot": { "type": "string", "pattern": "^/" } }
        },
        "snapSource": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["step"], "properties": { "step": { "const": true } } },
            { "type": "object", "additionalProperties": false, "required": ["config"], "properties": { "config": { "type": "string", "minLength": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["snapshot"], "properties": { "snapshot": { "type": "string", "pattern": "^(/.*)?$" } } }
          ]
        },
        "unit": { "type": "string", "minLength": 1 },
        "displayUnit": { "type": "string", "minLength": 1 },
        "displayFactor": { "type": "number", "not": { "const": 0 } },
        "scale": { "enum": ["linear", "log"] },
        "group": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" },
        "options": { "type": "object", "additionalProperties": { "$ref": "#/$defs/InputLabel" } },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              ]
            },
            "domain": { "type": "string", "minLength": 1 },
            "granularity": { "type": "string", "minLength": 1 }
          }
        }
      },
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"]
    },
    "InputLabelGlossary": {
      "description": "📚️ The framework input-label glossary (🛂️manifest/🔣️input-labels.json): a label in every locale for the most frequent mutation input names, the fallback when an input carries no x-semio-ui.label.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "labels"],
      "properties": {
        "schema": { "const": "semio.manifest.input-label-glossary/v1" },
        "labels": { "type": "object", "minProperties": 200, "additionalProperties": { "$ref": "#/$defs/InputLabelLocales" } }
      },
      "x-semio-formats": ["🔣️jsonschema", "🟦️typescript"]
    },
    "MutationInputCorpus": {
      "description": "🧫️ The language-agnostic mutation-input corpus (🧫️fixtures/🧫️mutation-inputs): leaf payload schemas, the schema documents their cross-document $refs resolve to, and per case either the canonical input descriptors (ActionArgDef JSON) every reader must produce or the error class and input pointer every reader must refuse with (and, when it differs from that single refusal, every finding the collecting read reports, in reading order); plus the reference id table every host converts a selected id text by (idType, text → the payload value, or null when refused; spelled = that value's text back).",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "documents", "cases", "referenceIds"],
      "properties": {
        "schema": { "const": "semio.manifest.mutation-input-corpus/v1" },
        "referenceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["idType", "text", "value"],
            "properties": { "idType": { "enum": ["string", "integer"] }, "text": { "type": "string" }, "value": { "type": ["string", "integer", "null"] }, "spelled": { "type": "string" } }
          }
        },
        "documents": { "type": "object", "additionalProperties": { "type": "object", "required": ["$id"] } },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "leafSchema"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "leafSchema": { "type": "object" },
              "expectedFindings": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["code", "pointer"], "properties": { "code": { "enum": ["malformed", "refUnresolved", "uiInvalid", "widgetIncompatible", "labelMissing", "optionLabelMissing", "localeMissing", "wordOnlyFloat"] }, "pointer": { "type": "string" } } } },
              "expectedInputs": { "type": "array", "items": { "type": "object", "required": ["id", "label", "schema", "required"] } },
              "expectedError": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "pointer"],
                "properties": {
                  "code": { "enum": ["malformed", "refUnresolved", "uiInvalid", "widgetIncompatible", "labelMissing", "optionLabelMissing", "localeMissing", "wordOnlyFloat"] },
                  "pointer": { "type": "string" }
                }
              }
            },
            "oneOf": [{ "required": ["expectedInputs"] }, { "required": ["expectedError"] }]
          }
        }
      },
      "x-semio-formats": ["🔣️jsonschema"]
    }
  }
}
