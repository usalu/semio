{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.dev/schema/view-context/integer-carriers",
  "title": "View Context Integer Dictionary Wire Contract",
  "description": "Closed typed dictionary producers emit field keys in canonical UTF8 byte order before entering the ordered intrinsic encoder. The existing exact packHex oracle is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "note",
    "viewContext",
    "integerPaths",
    "packHex",
    "guestRefusal",
    "nonIntegral",
    "canonicalDictionaryOrder"
  ],
  "properties": {
    "note": {
      "type": "string"
    },
    "viewContext": {
      "$ref": "https://json.schemas.assets.semio-tech.com/framework/view-context/schema.json"
    },
    "integerPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "packHex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})+$"
    },
    "guestRefusal": {
      "type": "string"
    },
    "nonIntegral": {
      "type": "number"
    },
    "canonicalDictionaryOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ViewModel",
        "ToolRunTraceCursor"
      ],
      "properties": {
        "ViewModel": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "activeModeId",
              "activeToolId",
              "activeUtilityByWindowId",
              "activeUtilityId",
              "activeWindowKindId",
              "extensionInputJson",
              "focusedWindowId",
              "locale",
              "panelJson",
              "sessionIdentity",
              "terminology",
              "toolRunTraceCursorByWindowId",
              "treeViewportRows",
              "treeWindows",
              "windowId",
              "windowInstances"
            ]
          }
        },
        "ToolRunTraceCursor": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "generation",
              "page",
              "run"
            ]
          }
        }
      }
    }
  }
}
