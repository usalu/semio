{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/view-context/schema.json",
  "title": "ResolvedPluginViewState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locale",
    "terminology"
  ],
  "properties": {
    "activeModeId": {
      "$ref": "#/$defs/Identifier"
    },
    "activeWindowKindId": {
      "$ref": "#/$defs/Identifier"
    },
    "activeUtilityId": {
      "$ref": "#/$defs/Identifier"
    },
    "activeToolId": {
      "$ref": "#/$defs/Identifier"
    },
    "windowId": {
      "$ref": "#/$defs/Identifier"
    },
    "focusedWindowId": {
      "$ref": "#/$defs/Identifier"
    },
    "panelJson": {
      "type": "string",
      "maxLength": 65536
    },
    "sessionIdentity": {
      "$ref": "#/$defs/SessionIdentity"
    },
    "locale": {
      "enum": [
        "en",
        "de"
      ]
    },
    "terminology": {
      "enum": [
        "native",
        "reuse"
      ]
    },
    "activeUtilityByWindowId": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/Identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Identifier"
      }
    },
    "windowInstances": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "windowKindId"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/Identifier"
          },
          "windowKindId": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "toolRunTraceCursorByWindowId": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/Identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/ToolRunTraceCursor"
      }
    },
    "treeWindows": {
      "description": "Every tree container the host holds open/window state for, flattened over all panel bodies — the one source of truth a guest materialises its tree rows from.",
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/TreeWindowRequest"
      }
    },
    "treeViewportRows": {
      "description": "Rows the tallest visible panel body fits — the shared first-paint budget a guest spends over containers the host has not yet seen.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "$defs": {
    "TreeWindowRequest": {
      "description": "One tree container's host-known state: whether the user opened or closed it (absent = the author's own default still stands) and the row window on screen, overscan included.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bodyKey",
        "nodeKey",
        "offset",
        "rows"
      ],
      "properties": {
        "bodyKey": {
          "$ref": "#/$defs/Identifier"
        },
        "nodeKey": {
          "$ref": "#/$defs/Identifier"
        },
        "open": {
          "type": "boolean"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "SessionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "displayName"
      ],
      "properties": {
        "userId": {
          "$ref": "#/$defs/Identifier"
        },
        "displayName": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "ToolRunTraceCursor": {
      "description": "The tool run trace cursor a window instance's renderer echoes: the next page it expects of run `run` at `generation` (tool-run schema ToolRunTraceCursor, run bounded to exact JavaScript integers).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "generation",
        "page"
      ],
      "properties": {
        "run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
