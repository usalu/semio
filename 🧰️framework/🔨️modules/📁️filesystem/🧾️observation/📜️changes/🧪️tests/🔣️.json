    {"name": "everything after zero", "segments": [{"first": 1, "lines": [1, 2, 3]}], "after": 0, "expect": {"ok": true, "seqs": [1, 2, 3], "head": 3}},
    {"name": "tail after two", "segments": [{"first": 1, "lines": [1, 2, 3, 4]}], "after": 2, "expect": {"ok": true, "seqs": [3, 4], "head": 4}},
    {"name": "nothing new", "segments": [{"first": 1, "lines": [1, 2, 3]}], "after": 3, "expect": {"ok": true, "seqs": [], "head": 3}},
    {"name": "cursor beyond the head", "segments": [{"first": 1, "lines": [1, 2, 3]}], "after": 9, "expect": {"ok": false, "reason": "gap"}},
    {"name": "across two segments", "segments": [{"first": 1, "lines": [1, 2]}, {"first": 3, "lines": [3, 4, 5]}], "after": 1, "expect": {"ok": true, "seqs": [2, 3, 4, 5], "head": 5}},
    {"name": "cursor at a segment border", "segments": [{"first": 1, "lines": [1, 2]}, {"first": 3, "lines": [3, 4]}], "after": 2, "expect": {"ok": true, "seqs": [3, 4], "head": 4}},
    {"name": "oldest segment dropped", "segments": [{"first": 5, "lines": [5, 6]}, {"first": 7, "lines": [7]}], "after": 2, "expect": {"ok": false, "reason": "floor"}},
    {"name": "cursor exactly at the floor", "segments": [{"first": 5, "lines": [5, 6]}], "after": 4, "expect": {"ok": true, "seqs": [5, 6], "head": 6}},
    {"name": "newest segment empty, cursor at head", "segments": [{"first": 1, "lines": [1, 2]}, {"first": 3, "lines": []}], "after": 2, "expect": {"ok": true, "seqs": [], "head": 2}},
    {"name": "newest segment empty, cursor behind", "segments": [{"first": 1, "lines": [1, 2]}, {"first": 3, "lines": []}], "after": 1, "expect": {"ok": true, "seqs": [2], "head": 2}},
    {"name": "hole in the sequence", "segments": [{"first": 1, "lines": [1, 2, 4]}], "after": 0, "expect": {"ok": false, "reason": "gap"}},
    {"name": "hole between segments", "segments": [{"first": 1, "lines": [1, 2]}, {"first": 4, "lines": [4]}], "after": 0, "expect": {"ok": false, "reason": "gap"}},
    {"name": "garbage line", "segments": [{"first": 1, "lines": [1, "garbage", 3]}], "after": 0, "expect": {"ok": false, "reason": "gap"}},
    {"name": "undecodable record in range", "segments": [{"first": 1, "lines": [1, "{\"s\":2,\"t\":1,\"r\":[[\"z\",0,\"a\"]]}"]}], "after": 0, "expect": {"ok": false, "reason": "gap"}},
    {"name": "torn last line is ignored", "segments": [{"first": 1, "lines": [1, 2], "torn": "{\"s\":3,\"t\":1,\"r\":[[\"m\",0,\"a"}], "after": 0, "expect": {"ok": true, "seqs": [1, 2], "head": 2}},
    {"name": "foreign epoch is ignored", "segments": [{"first": 1, "lines": [1, 2], "epoch": "fedcba9876543210"}], "after": 0, "expect": {"ok": true, "seqs": [], "head": 0}},
    {"name": "lost record is a record", "segments": [{"first": 1, "lines": [1, "lost:2", 3]}], "after": 1, "expect": {"ok": true, "seqs": [2, 3], "head": 3}}
