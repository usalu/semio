{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "type":"object","additionalProperties":false,"required":["version","entries","preservations","refusals"],
 "properties":{
  "version":{"const":1},
  "entries":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","text"],"properties":{"name":{"type":"string","minLength":1},"text":{"type":"string"}}}},
  "preservations":{"type":"array","items":{"enum":["file","directory"]}},
  "refusals":{"type":"array","items":{"enum":["copied","cancelled","undefined","after-capsule","late-payload"]}}
 }
}
