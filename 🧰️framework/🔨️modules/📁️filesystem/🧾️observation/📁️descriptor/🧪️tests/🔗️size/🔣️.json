{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 3,
  "maxItems": 3,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "suffix",
      "utf8Bytes"
    ],
    "properties": {
      "name": {
        "enum": [
          "ascii",
          "bmp",
          "non-bmp"
        ]
      },
      "suffix": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16
      },
      "utf8Bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64
      }
    }
  }
}
