{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policy",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "policy": {
      "const": {
        "identity": "anchored-namespace-continuity",
        "coordinates": "canonical-u64-text",
        "liveProofs": "root-journal-entry-nofollow",
        "volumeMigration": "refused-unless-namespace-chain-preserved"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "input",
          "schemaValid",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {},
          "schemaValid": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "u64": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)$"
        },
        {
          "pattern": "^(?:[0-9]{1,19}|18446744073709551615|0[0-9]{19}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4])$"
        }
      ]
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "inode"
      ],
      "properties": {
        "device": {
          "$ref": "#/$defs/u64"
        },
        "inode": {
          "allOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "not": {
                "const": "0"
              }
            }
          ]
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "journal",
        "entry"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/coordinate"
        },
        "journal": {
          "$ref": "#/$defs/coordinate"
        },
        "entry": {
          "$ref": "#/$defs/coordinate"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published",
        "current"
      ],
      "properties": {
        "published": {
          "$ref": "#/$defs/namespace"
        },
        "current": {
          "$ref": "#/$defs/namespace"
        }
      }
    }
  }
}
