{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Guided Workspace Management Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "policy",
    "cases",
    "trees",
    "hierarchy"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "policy": {
      "const": {
        "commands": [
          "create-file",
          "create-directory",
          "rename-entry",
          "retain-entry"
        ],
        "maximumPathUnits": 256,
        "maximumFileBytes": 1048576,
        "directoryMutation": "bounded-tree",
        "destination": "absent-only",
        "removal": "retained-event-history",
        "cancellation": "before-publication",
        "lateCancellation": "settle-committed-outcome",
        "maximumTreeNodes": 4096,
        "treeOrder": "utf8",
        "maximumManagedFileBytes": 67108864
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/Case"
      }
    },
    "trees": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/TreeCase"
      }
    },
    "hierarchy": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "path",
          "contains"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "contains": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "Command": {
      "enum": [
        "create-file",
        "create-directory",
        "rename-entry",
        "retain-entry"
      ]
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "path",
        "initial",
        "destinationExists",
        "stale",
        "cancel",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "command": {
          "$ref": "#/$defs/Command"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "initial": {
          "enum": [
            "missing",
            "file",
            "empty-directory",
            "nonempty-directory"
          ]
        },
        "destinationExists": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "cancel": {
          "enum": [
            "none",
            "before-publication",
            "after-publication"
          ]
        },
        "expected": {
          "enum": [
            "committed",
            "conflict",
            "cancelled"
          ]
        }
      }
    },
    "Request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "create-file"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "create-directory"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "destination"
          ],
          "properties": {
            "kind": {
              "const": "rename-entry"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "destination": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "retain-entry"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "TreeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "destination",
        "physicalRootUnits",
        "nodes",
        "expected",
        "nodeCount"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "physicalRootUnits": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "suffix",
              "identity",
              "directory"
            ],
            "properties": {
              "suffix": {
                "type": "string"
              },
              "identity": {
                "type": "string"
              },
              "directory": {
                "type": "boolean"
              }
            }
          }
        },
        "expected": {
          "enum": [
            "accepted",
            "too-many-entries",
            "invalid-path",
            "conflict"
          ]
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4097,
          "description": "🔢️ Total rows; after explicit nodes, append file rows named by zero-padded four-digit index with the decimal index identity."
        }
      }
    },
    "RetainedDestination": {
      "type": "string",
      "pattern": "^\\.workspace-events/segments/[0-9a-f]{8}/[0-9a-z-]{1,64}\\.retained$"
    }
  }
}
