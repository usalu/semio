{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/Case"
      }
    }
  },
  "$defs": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "dirty",
        "operation",
        "roots",
        "recovery",
        "destination",
        "loaded",
        "expectedPath",
        "readOnly",
        "expectedRecovery",
        "changed",
        "reloadRefused"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dirty": {
          "type": "boolean"
        },
        "operation": {
          "enum": [
            "uncertain",
            "rename"
          ]
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "recovery": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination": {
          "type": [
            "string",
            "null"
          ]
        },
        "loaded": {
          "type": "boolean"
        },
        "expectedPath": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "expectedRecovery": {
          "type": [
            "string",
            "null"
          ]
        },
        "changed": {
          "type": "boolean"
        },
        "reloadRefused": {
          "type": "boolean"
        }
      }
    }
  }
}
