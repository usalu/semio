{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "messageCapacity",
    "cases",
    "saturation"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "messageCapacity": {
      "const": 32
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/Case"
      }
    },
    "saturation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishes",
        "queued",
        "dropped",
        "wakes"
      ],
      "properties": {
        "publishes": {
          "const": 1032
        },
        "queued": {
          "const": 32
        },
        "dropped": {
          "const": 1000
        },
        "wakes": {
          "const": 32
        }
      }
    }
  },
  "$defs": {
    "Policy": {
      "const": {
        "messageCapacity": 32,
        "progress": "bounded-samples",
        "completion": "lossless",
        "cancellation": "same-flag",
        "wake": "progress-and-settlement"
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "cancelled",
        "outcome",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "list",
            "load",
            "recovery-list"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 256
        },
        "cancelled": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "List",
            "Load",
            "RecoveryList",
            "Cancelled"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
