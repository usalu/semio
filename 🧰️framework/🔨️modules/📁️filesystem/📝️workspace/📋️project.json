{
  "name": "@semio-tech/framework-source-workspace",
  "targets": {
    "test-source": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/**/*",
        { "env": "SEMIO_TEST_LEVEL" },
        { "env": "SEMIO_TEST_BUDGET_MS" },
        { "env": "SEMIO_BUILD_BUDGET_MS" }
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/📁️filesystem/📝️workspace",
        "command": "bun ./📜️script.ts test"
      },
      "metadata": {
        "semio": {
          "execution": {
            "version": 1,
            "kind": "source"
          },
          "dashboard": {
            "title": {
              "en": "Verify Source Workspace",
              "de": "Quellarbeitsbereich Prüfen"
            },
            "description": {
              "en": "Verify portable source paths, optimistic saves, cancellation and retained conflict events.",
              "de": "Portable Quellpfade, optimistisches Speichern, Abbruch und erhaltene Konfliktereignisse prüfen."
            }
          },
          "sourceInputObservation": "freshness",
          "runtimeSourceEntries": [
            "{workspaceRoot}/🧰️framework/🔨️modules/📁️filesystem/📝️workspace/🧪️tests/🟦️.ts"
          ]
        }
      }
    }
  }
}
