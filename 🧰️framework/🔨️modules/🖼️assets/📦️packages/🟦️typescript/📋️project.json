{
  "name": "@semio-tech/assets",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖌️raster/🎥️video/🖋️svg-export/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧬️schema/✅️validator/🟦️.ts"
    ]
  },
  "targets": {
    "build": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖼️assets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts build",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/../../README.md",
        "{projectRoot}/../../🌱️metabolism/🔣️icons/🤖️generated",
        "{projectRoot}/../../🔣️icons/🤖️generated/🖼️icons",
        "{projectRoot}/../../🔣️icons/🤖️generated/🖼️icon_svgs",
        "{projectRoot}/../../🔣️icons/🤖️generated/🔤️shortcodes",
        "{projectRoot}/../../🔣️icons/🤖️generated/🪪️icon-name/🦀️.rs"
      ]
    },
    "preview-generated": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖼️assets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts preview-generated"
      },
      "outputs": []
    },
    "check-generated": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖼️assets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts check-generated"
      }
    },
    "logo": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖼️assets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts export-logo",
        "forwardAllArgs": true
      },
      "cache": true,
      "dependsOn": [
        "generate-logo",
        "workspace:deps-browsers"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "runtime": "ffmpeg -version"
        },
        {
          "env": "PLAYWRIGHT_BROWSERS_PATH"
        }
      ],
      "outputs": [
        "{projectRoot}/../../🪧️logos/🎞️animation/🎬️animation.mp4"
      ]
    },
    "logo-dev": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖼️assets/📦️packages/🟦️typescript",
        "command": "bun --watch ./📜️script.ts generate-logo",
        "forwardAllArgs": true
      },
      "cache": false,
      "continuous": true,
      "outputs": []
    },
    "generate-logo": {
      "cache": true,
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/../../🪧️logos/🎞️animation/⚡️animated.svg"
      ],
      "options": {
        "command": "bun ./📜️script.ts generate-logo",
        "cwd": "🧰️framework/🔨️modules/🖼️assets/📦️packages/🟦️typescript"
      }
    },
    "test-mesh-contract": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖼️assets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test-mesh-contract"
      }
    },
    "test-tile-proxy-contract": {
      "executor": "repo:script",
      "cache": false,
      "outputs": [],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖼️assets/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test-tile-proxy-contract"
      }
    },
    "test-dispatch-contract": {
      "executor": "repo:script",
      "cache": false,
      "dependsOn": [],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun ./📜️script.ts test-dispatch-contract"
      }
    },
    "test-svg-video-contract": {
      "executor": "repo:script",
      "cache": false,
      "dependsOn": [],
      "outputs": [],
      "options": {
        "cwd": "{projectRoot}",
        "command": "bun ./📜️script.ts test-svg-video-contract"
      }
    }
  }
}
