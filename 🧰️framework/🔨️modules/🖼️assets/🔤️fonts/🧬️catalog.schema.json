{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "encodings", "weights", "families"],
  "properties": {
    "$schema": { "const": "./🧬️catalog.schema.json" },
    "version": { "const": 1 },
    "encodings": {
      "type": "object", "additionalProperties": false, "required": ["ttf", "woff", "woff2"],
      "properties": { "ttf": { "const": "🔤️outline.ttf" }, "woff": { "const": "🌐️web.woff" }, "woff2": { "const": "🗜️compressed.woff2" } }
    },
    "weights": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "$ref": "#/definitions/directory" },
      "additionalProperties": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 }
    },
    "families": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["directory", "family", "weights", "subsets"],
        "properties": {
          "directory": { "$ref": "#/definitions/directory" },
          "family": { "type": "string", "pattern": "^[A-Za-z]+(?: [A-Za-z]+)*$" },
          "weights": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/directory" } },
          "subsets": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["directory", "sourceSubset"],
              "properties": {
                "directory": { "$ref": "#/definitions/directory" },
                "sourceSubset": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }] }
              }
            }
          }
        }
      }
    }
  },
  "definitions": { "directory": { "type": "string", "pattern": "^\\p{Extended_Pictographic}\\uFE0F[a-z]+(?:-[a-z]+)*$" } }
}
