{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/assets/metabolism/representation/schema.json",
  "title": "Assets Metabolism Representation Schema Module",
  "$defs": {
    "RepresentationCatalog": {
      "title": "Mesh Source Catalog",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "version",
        "entries"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "path"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^/mesh/[^/\\\\%?#]+\\.glb$"
              },
              "path": {
                "type": "string",
                "pattern": "^[^/\\\\%?#.]+(?:/[^/\\\\%?#.]+)*\\.glb$"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/RepresentationCatalog"
    }
  ]
}
