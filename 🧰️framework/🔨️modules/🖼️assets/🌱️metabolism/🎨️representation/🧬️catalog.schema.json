{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mesh Source Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "path"],
        "properties": {
          "url": { "type": "string", "pattern": "^/mesh/[^/\\\\%?#]+\\.glb$" },
          "path": { "type": "string", "pattern": "^[^/\\\\%?#.]+(?:/[^/\\\\%?#.]+)*\\.glb$" }
        }
      }
    }
  }
}
