{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:framework:assets:dispatch:v1",
  "type": "object",
  "required": ["kind", "route"],
  "properties": {
    "kind": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "route": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/[^\\\\?#\\u0000-\\u001f\\u007f]*$" }
  },
  "additionalProperties": true
}
