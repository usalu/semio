{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/assets/mesh/schema.json",
  "title": "Assets Mesh Schema Module",
  "definitions": {
    "directory": {
      "type": "string",
      "pattern": "^[^/\\\\%?#.]+(?:/[^/\\\\%?#.]+)*$"
    },
    "meshPath": {
      "type": "string",
      "pattern": "^[^/\\\\%?#.]+(?:/[^/\\\\%?#.]+)*\\.glb$"
    }
  },
  "$defs": {
    "MeshCatalog": {
      "title": "Mesh Delivery Catalog",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "version",
        "collections",
        "entries"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "collections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "catalog",
              "root",
              "output"
            ],
            "properties": {
              "catalog": {
                "type": "string",
                "pattern": "^[^/\\\\%?#.]+(?:/[^/\\\\%?#.]+)*\\.json$"
              },
              "root": {
                "$ref": "#/definitions/directory"
              },
              "output": {
                "$ref": "#/definitions/directory"
              }
            }
          }
        },
        "entries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "source",
              "path"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^/mesh/[^/\\\\%?#.]+\\.glb$"
              },
              "source": {
                "$ref": "#/definitions/meshPath"
              },
              "path": {
                "$ref": "#/definitions/meshPath"
              }
            }
          }
        }
      }
    },
    "MeshTransportCasesV1": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "output",
          "valid",
          "isolatedCatalogOnly"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "output": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid": {
            "type": "boolean"
          },
          "isolatedCatalogOnly": {
            "const": true
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/MeshCatalog"
    }
  ]
}
