{
  "name": "@semio-tech/framework-editor-rs",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "nativeSources": [
      "{workspaceRoot}/🧰️framework/🔨️modules/✍️editor/🧩️component/**/*"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/✍️editor/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖼️canvas/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🗣️dsl/🧬️schema/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test-owned-error": {
      "executor": "repo:script",
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🔨️modules/✍️editor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test-owned-error",
        "forwardAllArgs": true
      },
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain",
        "{workspaceRoot}/🧰️framework/🔨️modules/✍️editor/⚠️error/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/**/*"
      ]
    },
    "wasm": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/✍️editor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts wasm"
      },
      "outputs": ["{projectRoot}/.🧾️store/wasm.json"],
      "cache": true,
      "metadata": {
        "semio": {
          "wasmPackageSourceV1": {
            "version": 1,
            "sourceOwner": "🧰️framework/🔨️modules/✍️editor/📦️packages/🦀️rust"
          }
        }
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/✍️editor/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test"
      }
    }
  }
}
