{
  "name": "@semio-tech/framework-editor-rs",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "nativeSources": [
      "{workspaceRoot}/🧰️framework/🔨️modules/✍️editor/🧩️component/**/*"
    ]
  },
  "targets": {
    "test-owned-error": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework/🔨️modules/✍️editor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-owned-error",
        "forwardAllArgs": true
      },
      "inputs": [
        "default",
        "{workspaceRoot}/🧰️framework/🔨️modules/✍️editor/⚠️error/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/**/*"
      ]
    },
    "wasm": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/✍️editor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts wasm"
      },
      "outputs": [
        "{projectRoot}/pkg"
      ],
      "cache": true
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/✍️editor/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test"
      }
    }
  }
}
