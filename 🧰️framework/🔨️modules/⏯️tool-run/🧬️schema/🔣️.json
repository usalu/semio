{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/tool-run/schema.json",
  "title": "ToolRunSchema",
  "description": "Source of record for the ⏯️tool-run framework module: run identity, lifecycle states, events and the pure reducer transition, progress and step ring, trace pages, trace delta, ticks, the static ToolRunDefinition and the lifecycle, trace page and tick fixtures. Wire names are camelCase; u64 values are JSON integers; byte strings are lowercase hex.",
  "$defs": {
    "U16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "U32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "U64": {
      "type": "integer",
      "minimum": 0
    },
    "Hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$"
    },
    "Hash32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "LocaleText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "de"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LocalizedLabel": {
      "title": "LocalizedLabel",
      "description": "Locale × terminology matrix, the wire shape of the framework LocalizedLabel.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native",
        "reuse"
      ],
      "properties": {
        "native": {
          "$ref": "#/$defs/LocaleText"
        },
        "reuse": {
          "$ref": "#/$defs/LocaleText"
        }
      }
    },
    "ToolRunId": {
      "title": "ToolRunId",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appInstanceId",
        "run"
      ],
      "properties": {
        "appInstanceId": {
          "$ref": "#/$defs/U32"
        },
        "run": {
          "$ref": "#/$defs/U64"
        }
      }
    },
    "ToolRunIdentity": {
      "title": "ToolRunIdentity",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generation",
        "baseRevision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ToolRunId"
        },
        "generation": {
          "$ref": "#/$defs/U32"
        },
        "baseRevision": {
          "$ref": "#/$defs/Hash32"
        }
      }
    },
    "ToolRunState": {
      "title": "ToolRunState",
      "enum": [
        "starting",
        "running",
        "paused",
        "complete",
        "finalizing",
        "finalized",
        "aborting",
        "aborted",
        "faulted"
      ]
    },
    "ToolRunSlotState": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolRunState"
        },
        {
          "const": "none"
        }
      ]
    },
    "ToolRunSlot": {
      "title": "ToolRunSlot",
      "description": "The reducer's view of the single per-instance ledger slot. Absence (null) means no run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "generation",
        "state"
      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/U64"
        },
        "generation": {
          "$ref": "#/$defs/U32"
        },
        "state": {
          "$ref": "#/$defs/ToolRunState"
        }
      }
    },
    "ToolRunEvent": {
      "title": "ToolRunEvent",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "run"
          ],
          "properties": {
            "type": {
              "const": "start"
            },
            "run": {
              "$ref": "#/$defs/U64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "run",
            "generation"
          ],
          "properties": {
            "type": {
              "enum": [
                "jobAdmitted",
                "pause",
                "resume",
                "step",
                "jobComplete",
                "jobFault",
                "finalize",
                "publicationComplete",
                "revalidationConflicts",
                "storeRejected",
                "abortComplete"
              ]
            },
            "run": {
              "$ref": "#/$defs/U64"
            },
            "generation": {
              "$ref": "#/$defs/U32"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "run",
            "generation",
            "publishing"
          ],
          "properties": {
            "type": {
              "const": "abort"
            },
            "run": {
              "$ref": "#/$defs/U64"
            },
            "generation": {
              "$ref": "#/$defs/U32"
            },
            "publishing": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "run"
          ],
          "properties": {
            "type": {
              "enum": [
                "settingsChanged",
                "baseChanged",
                "dismiss"
              ]
            },
            "run": {
              "$ref": "#/$defs/U64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "closed"
            }
          }
        }
      ]
    },
    "ToolRunEventKey": {
      "title": "ToolRunEventKey",
      "description": "Matrix column of an event: the event type, except that abort with publishing=true is keyed abortWhilePublishing.",
      "enum": [
        "start",
        "jobAdmitted",
        "pause",
        "resume",
        "step",
        "jobComplete",
        "jobFault",
        "settingsChanged",
        "baseChanged",
        "finalize",
        "publicationComplete",
        "revalidationConflicts",
        "storeRejected",
        "abort",
        "abortWhilePublishing",
        "abortComplete",
        "dismiss",
        "closed"
      ]
    },
    "ToolRunEffect": {
      "title": "ToolRunEffect",
      "enum": [
        "spawnJob",
        "schedule",
        "stopScheduling",
        "driveOneUnit",
        "holdResult",
        "reconfigure",
        "refold",
        "beginFinalize",
        "releaseProvisional",
        "retractConflicts",
        "keepProvisional",
        "closeJob",
        "cancelBatch",
        "retireProvisional",
        "discardProvisional",
        "clearTrace",
        "retireAll"
      ]
    },
    "ToolRunRejection": {
      "title": "ToolRunRejection",
      "enum": [
        "toolRun.stale",
        "toolRun.busy",
        "toolRun.illegal"
      ]
    },
    "ToolRunTransition": {
      "title": "ToolRunTransition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "effect"
      ],
      "properties": {
        "slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolRunSlot"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect": {
          "$ref": "#/$defs/ToolRunEffect"
        }
      }
    },
    "ToolRunVerdict": {
      "title": "ToolRunVerdict",
      "enum": [
        "testing",
        "success",
        "warning",
        "danger"
      ]
    },
    "ToolRunStepKind": {
      "title": "ToolRunStepKind",
      "enum": [
        "info",
        "success",
        "warning",
        "danger"
      ]
    },
    "ToolRunStepArg": {
      "title": "ToolRunStepArg",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unsigned"
          ],
          "properties": {
            "unsigned": {
              "$ref": "#/$defs/U64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "float"
          ],
          "properties": {
            "float": {
              "type": "number"
            }
          }
        }
      ]
    },
    "ToolRunStep": {
      "title": "ToolRunStep",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "kind",
        "stage",
        "reason",
        "repeat",
        "args"
      ],
      "properties": {
        "sequence": {
          "$ref": "#/$defs/U64"
        },
        "kind": {
          "$ref": "#/$defs/ToolRunStepKind"
        },
        "stage": {
          "$ref": "#/$defs/U16"
        },
        "reason": {
          "$ref": "#/$defs/U16"
        },
        "subject": {
          "$ref": "#/$defs/U64"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "args": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/ToolRunStepArg"
          }
        }
      }
    },
    "ToolRunStepRing": {
      "title": "ToolRunStepRing",
      "description": "Newest ≤ 64 steps, oldest first, overwrite-oldest, identical consecutive steps coalesced into repeat.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/ToolRunStep"
      }
    },
    "ToolRunCounter": {
      "title": "ToolRunCounter",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counter",
        "value"
      ],
      "properties": {
        "counter": {
          "$ref": "#/$defs/U16"
        },
        "value": {
          "$ref": "#/$defs/U64"
        }
      }
    },
    "ToolRunProgress": {
      "title": "ToolRunProgress",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "sequence",
        "state",
        "stage",
        "completed",
        "counters",
        "unitsPerSecond",
        "conflicts",
        "steps"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/ToolRunIdentity"
        },
        "sequence": {
          "$ref": "#/$defs/U64"
        },
        "state": {
          "$ref": "#/$defs/ToolRunState"
        },
        "stage": {
          "$ref": "#/$defs/U16"
        },
        "completed": {
          "$ref": "#/$defs/U64"
        },
        "total": {
          "$ref": "#/$defs/U64"
        },
        "counters": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/ToolRunCounter"
          }
        },
        "unitsPerSecond": {
          "type": "number"
        },
        "conflicts": {
          "$ref": "#/$defs/U32"
        },
        "steps": {
          "$ref": "#/$defs/ToolRunStepRing"
        }
      }
    },
    "F32Tuple2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "F32Tuple3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "F32Tuple4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "ToolRunTraceSubject": {
      "title": "ToolRunTraceSubject",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "mesh",
            "position",
            "rotation",
            "scale"
          ],
          "properties": {
            "kind": {
              "const": "instance3d"
            },
            "mesh": {
              "$ref": "#/$defs/U32"
            },
            "position": {
              "$ref": "#/$defs/F32Tuple3"
            },
            "rotation": {
              "$ref": "#/$defs/F32Tuple4"
            },
            "scale": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "shape",
            "position",
            "rotation"
          ],
          "properties": {
            "kind": {
              "const": "placement2d"
            },
            "shape": {
              "$ref": "#/$defs/U32"
            },
            "position": {
              "$ref": "#/$defs/F32Tuple2"
            },
            "rotation": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entity"
          ],
          "properties": {
            "kind": {
              "const": "entity"
            },
            "entity": {
              "$ref": "#/$defs/U64"
            }
          }
        }
      ]
    },
    "ToolRunTraceOp": {
      "title": "ToolRunTraceOp",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key",
            "verdict",
            "reason",
            "subject"
          ],
          "properties": {
            "op": {
              "const": "upsert"
            },
            "key": {
              "$ref": "#/$defs/U64"
            },
            "verdict": {
              "$ref": "#/$defs/ToolRunVerdict"
            },
            "reason": {
              "$ref": "#/$defs/U16"
            },
            "subject": {
              "$ref": "#/$defs/ToolRunTraceSubject"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key"
          ],
          "properties": {
            "op": {
              "const": "retire"
            },
            "key": {
              "$ref": "#/$defs/U64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "clear"
            }
          }
        }
      ]
    },
    "ToolRunTracePage": {
      "title": "ToolRunTracePage",
      "description": "Columnar pack record body: identity, page, opKinds u8, keys u64le, verdicts u8, reasons u16le, subjectKinds u8, meshes u32le, shapes u32le, entities u64le, floats f32le. Empty columns are omitted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "page",
        "ops"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/ToolRunIdentity"
        },
        "page": {
          "$ref": "#/$defs/U32"
        },
        "ops": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/ToolRunTraceOp"
          }
        }
      }
    },
    "ToolRunTraceDelta": {
      "title": "ToolRunTraceDelta",
      "description": "One refresh worth of trace pages for a window: clear=true means drop every record before applying pages; next is the cursor page to echo back.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "clear",
        "next",
        "pages"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/ToolRunIdentity"
        },
        "clear": {
          "type": "boolean"
        },
        "next": {
          "$ref": "#/$defs/U32"
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolRunTracePage"
          }
        }
      }
    },
    "ToolRunTraceCursor": {
      "title": "ToolRunTraceCursor",
      "description": "Echoed by a renderer in its window instance view state; page is the next page it expects.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "generation",
        "page"
      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/U64"
        },
        "generation": {
          "$ref": "#/$defs/U32"
        },
        "page": {
          "$ref": "#/$defs/U32"
        }
      }
    },
    "ToolRunTick": {
      "title": "ToolRunTick",
      "description": "Pack record body carried by a RetainedJobPayload page: retractTo applies before appendOps.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "sequence",
        "steps",
        "trace",
        "appendOps",
        "appendEntities"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/ToolRunIdentity"
        },
        "sequence": {
          "$ref": "#/$defs/U64"
        },
        "progress": {
          "$ref": "#/$defs/ToolRunProgress"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolRunStep"
          }
        },
        "trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolRunTracePage"
          }
        },
        "appendOps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hex"
          }
        },
        "appendEntities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/U64"
          }
        },
        "retractTo": {
          "$ref": "#/$defs/U32"
        },
        "payload": {
          "description": "Opaque plugin bytes the run's windows read back through the run view; the newest tick carrying one wins.",
          "$ref": "#/$defs/Hex"
        }
      }
    },
    "ToolRunRebasePolicy": {
      "title": "ToolRunRebasePolicy",
      "enum": [
        "revalidate",
        "restart",
        "freeze"
      ]
    },
    "ToolRunReconfigurePolicy": {
      "title": "ToolRunReconfigurePolicy",
      "enum": [
        "resume",
        "restart"
      ]
    },
    "ToolRunTraceKind": {
      "title": "ToolRunTraceKind",
      "enum": [
        "instance3d",
        "placement2d",
        "entity",
        "none"
      ]
    },
    "JobKindId": {
      "title": "JobKindId",
      "type": "string",
      "minLength": 1
    },
    "ToolRunStageDefinition": {
      "title": "ToolRunStageDefinition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/LocalizedLabel"
        }
      }
    },
    "ToolRunCounterDefinition": {
      "title": "ToolRunCounterDefinition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/LocalizedLabel"
        }
      }
    },
    "ToolRunReasonDefinition": {
      "title": "ToolRunReasonDefinition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "id",
        "verdict",
        "template"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65279
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "$ref": "#/$defs/ToolRunVerdict"
        },
        "template": {
          "$ref": "#/$defs/LocalizedLabel"
        }
      }
    },
    "ToolRunDefinition": {
      "title": "ToolRunDefinition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutating",
        "rebase",
        "reconfigure",
        "unit",
        "stages",
        "counters",
        "reasons",
        "trace",
        "runJob"
      ],
      "properties": {
        "mutating": {
          "type": "boolean"
        },
        "rebase": {
          "$ref": "#/$defs/ToolRunRebasePolicy"
        },
        "reconfigure": {
          "$ref": "#/$defs/ToolRunReconfigurePolicy"
        },
        "unit": {
          "$ref": "#/$defs/LocalizedLabel"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/ToolRunStageDefinition"
          }
        },
        "counters": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/ToolRunCounterDefinition"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolRunReasonDefinition"
          }
        },
        "trace": {
          "$ref": "#/$defs/ToolRunTraceKind"
        },
        "runJob": {
          "$ref": "#/$defs/JobKindId"
        },
        "revalidateJob": {
          "$ref": "#/$defs/JobKindId"
        },
        "settings": {
          "$ref": "#/$defs/ToolRunSettingsReads"
        },
        "windows": {
          "description": "Window kind ids whose bodies render this run's state; every tick refreshes them next to the ToolRun panel, and no other window.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "member": {
          "description": "The composed-child slot whose owned member store a mutating run edits; absent: the document's own store.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ToolRunActionId": {
      "title": "ToolRunActionId",
      "enum": [
        "toolRunStart",
        "toolRunPause",
        "toolRunResume",
        "toolRunStep",
        "toolRunAbort",
        "toolRunFinalize",
        "toolRunDismiss"
      ]
    },
    "ToolRunLabelKey": {
      "title": "ToolRunLabelKey",
      "enum": [
        "stateStarting",
        "stateRunning",
        "statePaused",
        "stateComplete",
        "stateFinalizing",
        "stateFinalized",
        "stateAborting",
        "stateAborted",
        "stateFaulted",
        "actionStart",
        "actionPause",
        "actionResume",
        "actionStep",
        "actionAbort",
        "actionFinalize",
        "actionDismiss",
        "finalizeDisabled",
        "readyToStart",
        "rebasingStep",
        "conflictStep",
        "traceTruncatedStep",
        "provisionalCapStep",
        "progressValueText"
      ]
    },
    "ToolRunSettingsPointer": {
      "title": "ToolRunSettingsPointer",
      "description": "RFC 6901 JSON Pointer into a settings document: empty, or `/`-separated reference tokens where `~` only appears as `~0` or `~1`.",
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)*$"
    },
    "ToolRunSettingsReads": {
      "title": "ToolRunSettingsReads",
      "description": "The settings a run's jobs read (§3.3): pointers into the app config document and, per window kind id, into that kind's window config documents. `settingsChanged` fires only when a value behind one of them changes; absent or empty reads no settings.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolRunSettingsPointer"
          }
        },
        "windowConfig": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
