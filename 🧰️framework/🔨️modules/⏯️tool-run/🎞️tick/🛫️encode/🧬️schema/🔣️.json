{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "counts",
    "payloadBytes",
    "grant",
    "outputQuantum",
    "metadataFunding",
    "streamingCase"
  ],
  "properties": {
    "counts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "payloadBytes": {
      "type": "integer",
      "minimum": 0
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "const": 1
        },
        "maximumCopyBytes": {
          "const": 4096
        },
        "maximumCapacityBytes": {
          "const": 4096
        },
        "maximumReleaseBytes": {
          "const": 262144
        },
        "maximumDepth": {
          "const": 64
        }
      }
    },
    "outputQuantum": {
      "const": 64
    },
    "metadataFunding": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "streamingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumCopyBytes",
        "nativeColumnBytes",
        "expectedChunks"
      ],
      "properties": {
        "maximumCopyBytes": {
          "const": 17
        },
        "nativeColumnBytes": {
          "const": 32
        },
        "expectedChunks": {
          "const": [
            17,
            15
          ]
        }
      }
    }
  }
}
