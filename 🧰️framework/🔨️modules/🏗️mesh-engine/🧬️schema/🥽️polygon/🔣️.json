  "$defs": {
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "semantic",
        "interpolation",
        "values"
      ],
      "properties": {
        "domain": {
          "enum": [
            "vertex",
            "corner",
            "face",
            "edge"
          ],
          "description": "Edge values follow serialized halfedge identifiers, including each directed use; corner values follow face boundary order."
        },
        "semantic": {
          "enum": [
            "normal",
            "uv",
            "color",
            "material",
            "custom"
          ]
        },
        "interpolation": {
          "enum": [
            "linear",
            "nearest",
            "constant"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 600000,
          "items": {}
        },
        "indices": {
          "type": "array",
          "maxItems": 600000,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 599999
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "interpolation": {
                "const": "linear"
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/numericValue"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "semantic": {
                "const": "normal"
              }
            }
          },
          "then": {
            "properties": {
              "domain": {
                "enum": [
                  "vertex",
                  "corner",
                  "face"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": -3.4028234663852886e+38,
                    "maximum": 3.4028234663852886e+38
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "semantic": {
                "const": "uv"
              }
            }
          },
          "then": {
            "properties": {
              "domain": {
                "enum": [
                  "vertex",
                  "corner",
                  "face"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -3.4028234663852886e+38,
                    "maximum": 3.4028234663852886e+38
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "semantic": {
                "const": "color"
              }
            }
          },
          "then": {
            "properties": {
              "domain": {
                "enum": [
                  "vertex",
                  "corner",
                  "face"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": -3.4028234663852886e+38,
                    "maximum": 3.4028234663852886e+38
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "semantic": {
                "const": "material"
              }
            }
          },
          "then": {
            "properties": {
              "domain": {
                "const": "face"
              },
              "interpolation": {
                "enum": [
                  "nearest",
                  "constant"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        }
      ],
      "description": "Effective domain cardinality is indices.length when present and values.length otherwise. Every index must reference values; runtime validation checks domain cardinality and bounds."
    },
    "numericValue": {
      "oneOf": [
        {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "number",
            "minimum": -3.4028234663852886e+38,
            "maximum": 3.4028234663852886e+38
          }
        }
      ]
    }
