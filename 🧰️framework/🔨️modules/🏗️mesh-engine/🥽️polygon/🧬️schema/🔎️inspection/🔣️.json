{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio:flow:mesh:inspection",
  "title": "Mesh Component Inspection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "index"
  ],
  "properties": {
    "kind": {
      "enum": [
        "vertex",
        "edge",
        "face"
      ]
    },
    "index": {
      "type": "integer",
      "minimum": 0
    }
  }
}
