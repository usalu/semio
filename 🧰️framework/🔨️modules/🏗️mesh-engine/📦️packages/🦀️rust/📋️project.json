{
  "name": "@semio-tech/framework-mesh-engine-rs",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🔨️modules/🏗️mesh-engine",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🏗️mesh-engine/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🎒️pack/**/*",
      "sharedGlobals"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/⏳️async/✨️macros/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/📡️replication/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/🧲️fixture-reader/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test-native": {
      "executor": "repo:script",
      "outputs": [],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🏗️mesh-engine/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-native"
      }
    }
  }
}
