{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work",
    "copyBytes",
    "stock",
    "cancellation"
  ],
  "properties": {
    "work": {
      "const": {
        "denied": 0,
        "sharedProbe": 1,
        "wrongWitness": 1,
        "aliasReturn": 1,
        "cached": 0
      }
    },
    "copyBytes": {
      "const": 0
    },
    "stock": {
      "const": {
        "items": 10000,
        "copyBytes": 1048576,
        "capacityBytes": 1048576,
        "releaseBytes": 1048576,
        "depth": 128,
        "maximumTurns": 10000
      }
    },
    "cancellation": {
      "const": [
        false,
        true
      ]
    }
  }
}
