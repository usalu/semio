{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy",
    "nodes",
    "phases",
    "retention",
    "terminalDrop",
    "metadata",
    "denied",
    "waiterGate",
    "gateContended"
  ],
  "properties": {
    "schema": {
      "const": "cancel-token-retirement.v1"
    },
    "policy": {
      "const": {
        "items": 1,
        "copy": 4096,
        "capacity": 65536,
        "release": 262144,
        "depth": 64
      }
    },
    "nodes": {
      "const": [
        1,
        3,
        64
      ]
    },
    "phases": {
      "const": [
        "original-arc",
        "empty-waiter-backing",
        "node-parent-transfer"
      ]
    },
    "retention": {
      "const": [
        "shared-alias",
        "weak-alias",
        "registered-waiter"
      ]
    },
    "terminalDrop": {
      "const": 0
    },
    "metadata": {
      "const": "original-node-kept-until-separate-parent-transfer"
    },
    "denied": {
      "const": [
        "items",
        "copy",
        "release",
        "depth"
      ]
    },
    "waiterGate": {
      "const": "original-inline-atomic-guard"
    },
    "gateContended": {
      "const": "blocked-original-retained"
    }
  }
}
