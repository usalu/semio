{
  "name": "@semio-tech/framework-async",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "{workspaceRoot}/🧰️framework/🔨️modules/⏳️async/🧪️tests/🎚️config/🟦️.ts"]
  },
  "targets": {
    "info": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/⏳️async/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts info"
      },
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/⏳️async/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "twin": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/⏳️async/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts twin",
        "forwardAllArgs": true
      },
      "cache": false,
      "outputs": [],
      "description": "Checks live event-loop deadlines and measures chained scheduling on the current host."
    }
  }
}
