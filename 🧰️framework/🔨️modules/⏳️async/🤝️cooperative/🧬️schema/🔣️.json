{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "unitCost", "cases"],
  "properties": {
    "version": { "const": 1 },
    "unitCost": { "const": 8 },
    "cases": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lane", "weight", "deficits", "selected"],
        "properties": {
          "lane": { "enum": ["Maintenance", "Background", "UserVisible", "Io", "Timer", "Interactive"] },
          "weight": { "enum": [1, 2, 3, 4, 8] },
          "deficits": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "integer", "minimum": 0, "maximum": 7 } },
          "selected": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "boolean" } }
        }
      }
    }
  }
}
