{
  "version": 1,
  "states": [
    "open",
    "closing",
    "stopped"
  ],
  "cases": [
    {
      "id": "held-use-refuses-shutdown",
      "steps": [
        "acquire",
        "shutdown-busy"
      ],
      "expected": {
        "state": "open",
        "retainedUses": 1,
        "executable": true
      }
    },
    {
      "id": "arc-clones-count-one-use-cell",
      "steps": [
        "acquire",
        "clone",
        "drop",
        "shutdown-busy"
      ],
      "expected": {
        "state": "open",
        "retainedUses": 1,
        "executable": true
      }
    },
    {
      "id": "final-drop-enables-shutdown",
      "steps": [
        "acquire",
        "drop",
        "shutdown"
      ],
      "expected": {
        "state": "stopped",
        "retainedUses": 0,
        "executable": false
      }
    },
    {
      "id": "closing-fences-racing-acquire",
      "steps": [
        "shutdown",
        "acquire-rejected"
      ],
      "expected": {
        "state": "stopped",
        "retainedUses": 0,
        "executable": false
      }
    },
    {
      "id": "stopped-shutdown-is-idempotent",
      "steps": [
        "shutdown",
        "shutdown-idempotent"
      ],
      "expected": {
        "state": "stopped",
        "retainedUses": 0,
        "executable": false
      }
    }
  ]
}
