{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/async/worker-pool-use-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "states", "mountedCases", "cases"],
  "properties": {
    "version": { "const": 1 },
    "states": { "const": ["open", "closing", "stopped"] },
    "mountedCases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pool", "database", "authority", "externalUses", "databaseActivities", "expectedShutdown"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pool": { "enum": ["open", "stopped"] },
          "database": { "enum": ["absent", "open", "opening-non-runnable", "terminal"] },
          "authority": { "enum": ["empty", "ready"] },
          "externalUses": { "type": "integer", "minimum": 0, "maximum": 1 },
          "databaseActivities": { "enum": ["open", "closed", "blocked"] },
          "expectedShutdown": { "enum": ["busy-1", "stopped"] }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "steps": { "type": "array", "minItems": 1, "items": { "enum": ["acquire", "clone", "drop", "shutdown-busy", "shutdown", "acquire-rejected", "shutdown-idempotent"] } },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "retainedUses", "executable"],
            "properties": {
              "state": { "enum": ["open", "stopped"] },
              "retainedUses": { "type": "integer", "minimum": 0, "maximum": 2 },
              "executable": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
