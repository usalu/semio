{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/async/use/schema.json",
  "title": "Async Use Schema Module",
  "$defs": {
    "UseFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "states",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "states": {
          "const": [
            "open",
            "closing",
            "stopped"
          ]
        },
        "cases": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "steps",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "acquire",
                    "clone",
                    "drop",
                    "shutdown-busy",
                    "shutdown",
                    "acquire-rejected",
                    "shutdown-idempotent"
                  ]
                }
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "retainedUses",
                  "executable"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "open",
                      "stopped"
                    ]
                  },
                  "retainedUses": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "executable": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/UseFixture"
    }
  ]
}
