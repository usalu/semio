{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/async/publication/checkpoint.json",
  "title": "Owned Publication Checkpoint Laws",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/Case"
      }
    }
  },
  "$defs": {
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomes",
        "attempts",
        "progressEvents",
        "gateHeld",
        "reacquired"
      ],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "live",
              "parked",
              "cancelled"
            ]
          }
        },
        "attempts": {
          "const": 1
        },
        "progressEvents": {
          "const": 1
        },
        "gateHeld": {
          "const": true
        },
        "reacquired": {
          "const": true
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "depth",
        "maxTokenNodes",
        "actions",
        "expected"
      ],
      "properties": {
        "id": {
          "enum": [
            "live-owner",
            "cancel-current",
            "park-current-resume",
            "cancel-parent",
            "park-parent-resume",
            "cancel-parent-dominates-park",
            "exact-ancestry-bound",
            "unrelated-token"
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxTokenNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "checkpoint",
              "cancel-current",
              "park-current",
              "unpark-current",
              "cancel-parent",
              "park-parent",
              "unpark-parent",
              "cancel-other"
            ]
          }
        },
        "expected": {
          "$ref": "#/$defs/Result"
        }
      }
    }
  }
}
