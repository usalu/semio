{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/async/publication/admission.json",
  "title": "Neutral Publication Admission Laws",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tokenNodeCeiling", "cases"],
  "properties": {
    "version": { "const": 1 },
    "tokenNodeCeiling": { "const": 4096 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Case" }
    }
  },
  "$defs": {
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "maxTokenNodes"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "maxTokenNodes": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "RequestedLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "maxTokenNodes"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "maxTokenNodes": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "TokenChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "baseline", "overrides"],
      "properties": {
        "depth": { "type": "integer", "minimum": 1, "maximum": 4097 },
        "baseline": { "const": "live" },
        "overrides": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "state"],
            "properties": {
              "index": { "type": "integer", "minimum": 0, "maximum": 4096 },
              "state": { "enum": ["parked", "cancelled"] }
            }
          }
        }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "attempts", "progressEvents"],
      "properties": {
        "outcome": {
          "enum": ["acquired", "busy", "cancelled", "parked", "bound-attempts", "bound-token-nodes", "unavailable", "observer-panicked"]
        },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "progressEvents": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "limits", "tokenChain", "actions", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "limits": { "$ref": "#/$defs/RequestedLimits" },
        "tokenChain": { "$ref": "#/$defs/TokenChain" },
        "actions": {
          "type": "array",
          "items": {
            "enum": ["try", "hold-other", "release-other", "release-current", "poison", "cancel-current", "park-current", "unpark-current", "arm-cancel-on-progress", "arm-park-on-progress", "arm-panic-on-progress"]
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["construction", "results"],
          "properties": {
            "construction": { "enum": ["ready", "invalid-limits"] },
            "results": { "type": "array", "items": { "$ref": "#/$defs/Result" } }
          }
        }
      }
    }
  }
}
