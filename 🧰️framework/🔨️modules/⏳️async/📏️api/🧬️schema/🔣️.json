{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/async/api/schema.json",
  "title": "Async Public Export Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "exports", "retired", "testOwners"],
  "properties": {
    "version": { "const": 1 },
    "testOwners": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["🧪️tests/🧱️boxed-fixed-slots/🟦️.ts", "🪃️continuation/🧪️tests/🪃️scheduler/🟦️.ts"] }
    },
    "exports": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "owner"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "kind": { "enum": ["type", "value"] },
          "owner": { "enum": ["wire", "scheduler"] }
        }
      }
    },
    "retired": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
    }
  }
}
