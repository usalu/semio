{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/async/deferred-wake/schema.json",
  "title": "Async Deferred-wake Schema Module",
  "$defs": {
    "DeferredWakeFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "capacity",
        "dispatch",
        "shutdown",
        "cases",
        "runtimeMarkers"
      ],
      "properties": {
        "schema": {
          "const": "https://json.schemas.assets.semio-tech.com/framework/async/deferred-wake/schema.json#/$defs/DeferredWakeFixture"
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maintenanceHooks",
            "partitions",
            "slotsPerPartition",
            "totalWaiters"
          ],
          "properties": {
            "maintenanceHooks": {
              "const": 64
            },
            "partitions": {
              "const": 64
            },
            "slotsPerPartition": {
              "const": 32
            },
            "totalWaiters": {
              "const": 2048
            }
          }
        },
        "dispatch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lane",
            "workKind",
            "sources",
            "sourceRotation",
            "wakesPerTurn",
            "waiterTransfer",
            "enqueueNeverCallsWaker",
            "catchPanics",
            "locksReleasedBeforeWake",
            "forbiddenEnqueueEffects"
          ],
          "properties": {
            "lane": {
              "const": "io"
            },
            "workKind": {
              "const": "deferred-wake"
            },
            "sources": {
              "const": [
                "job",
                "maintenance",
                "deferred-wake"
              ]
            },
            "sourceRotation": {
              "const": "round-robin-within-lane"
            },
            "wakesPerTurn": {
              "const": 1
            },
            "waiterTransfer": {
              "const": "move"
            },
            "enqueueNeverCallsWaker": {
              "const": true
            },
            "catchPanics": {
              "const": true
            },
            "locksReleasedBeforeWake": {
              "const": [
                "maintenance-registry",
                "scheduler-lane",
                "deferred-wake-ring"
              ]
            },
            "forbiddenEnqueueEffects": {
              "const": [
                "waker-callback",
                "job-allocation",
                "user-closure",
                "external-task",
                "lost-owner",
                "io"
              ]
            }
          }
        },
        "shutdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native",
            "cooperative",
            "afterTerminalEnqueue"
          ],
          "properties": {
            "native": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "admission",
                "workersExitAfter"
              ],
              "properties": {
                "admission": {
                  "const": "close-then-drain-accepted-wakes"
                },
                "workersExitAfter": {
                  "const": "deferred-wake-ring-empty"
                }
              }
            },
            "cooperative": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "admission",
                "hasPendingWhile",
                "pump"
              ],
              "properties": {
                "admission": {
                  "const": "close-then-drain-accepted-wakes"
                },
                "hasPendingWhile": {
                  "const": "deferred-wake-ring-nonempty"
                },
                "pump": {
                  "const": "one-deferred-wake-per-turn-until-empty"
                }
              }
            },
            "afterTerminalEnqueue": {
              "const": "return-owner-for-exact-cell-restoration"
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "parkedWaiters",
              "supersededWaiters",
              "transferredWaiters",
              "restoredWaiters",
              "enqueuePhase",
              "requestMayHoldExternalLock",
              "expected"
            ],
            "properties": {
              "id": {
                "enum": [
                  "cross-key-refusal",
                  "retry-supersedes-self",
                  "maintenance-capacity-independent",
                  "shutdown-drains-accepted",
                  "terminal-shutdown-restores-owner"
                ]
              },
              "parkedWaiters": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "supersededWaiters": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2048
              },
              "transferredWaiters": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2048
              },
              "restoredWaiters": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2048
              },
              "enqueuePhase": {
                "enum": [
                  "open",
                  "maintenance-full",
                  "before-shutdown",
                  "after-terminal-shutdown"
                ]
              },
              "requestMayHoldExternalLock": {
                "const": true
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inlineWakes",
                  "drainedWakes",
                  "jobs",
                  "externalTasks",
                  "lostOwners",
                  "io"
                ],
                "properties": {
                  "inlineWakes": {
                    "const": 0
                  },
                  "drainedWakes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2048
                  },
                  "jobs": {
                    "const": 0
                  },
                  "lostOwners": {
                    "const": 0
                  },
                  "io": {
                    "const": 0
                  },
                  "externalTasks": {
                    "const": 0
                  }
                }
              }
            }
          }
        },
        "runtimeMarkers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "async"
          ],
          "properties": {
            "async": {
              "const": [
                "WorkerDeferredWakeTicket",
                "WorkerDeferredWakeRegistry",
                "PoolWork::DeferredWake",
                "WORKER_DEFERRED_WAKE_PARTITIONS",
                "WORKER_DEFERRED_WAKES_PER_PARTITION"
              ]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/DeferredWakeFixture"
    }
  ]
}
