{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/geometry/placement",
  "type": "object",
  "required": [
    "placements",
    "z_planes"
  ],
  "additionalProperties": false,
  "properties": {
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "ops",
          "point",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ops": {
            "type": "array",
            "items": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "rotation_z": {
                  "type": "number"
                },
                "translation": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "scaling": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "rotation_axis": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "angle": {
                  "type": "number"
                }
              }
            }
          },
          "point": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "expected": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "z_planes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "anchor",
          "z",
          "direction",
          "slope",
          "queries"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "z": {
            "type": "number"
          },
          "direction": {
            "type": "number"
          },
          "slope": {
            "type": "number"
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "point",
                "z"
              ],
              "additionalProperties": false,
              "properties": {
                "point": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "z": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
