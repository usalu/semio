{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/geometry/loops",
  "type": "object",
  "required": [
    "loops",
    "offsets"
  ],
  "additionalProperties": false,
  "properties": {
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "vertices",
          "expected",
          "contains"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "vertices": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          },
          "expected": {
            "type": "object",
            "required": [
              "signed_area",
              "area",
              "perimeter",
              "centroid",
              "bounds",
              "ccw"
            ],
            "additionalProperties": false,
            "properties": {
              "signed_area": {
                "type": "number"
              },
              "area": {
                "type": "number"
              },
              "perimeter": {
                "type": "number"
              },
              "centroid": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "bounds": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "ccw": {
                "type": "boolean"
              }
            }
          },
          "contains": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "point",
                "at"
              ],
              "additionalProperties": false,
              "properties": {
                "point": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "at": {
                  "enum": [
                    "inside",
                    "outside",
                    "boundary"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "offsets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "vertices",
          "distance",
          "miter_limit",
          "expected_area",
          "expected_perimeter"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "vertices": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          },
          "distance": {
            "type": "number"
          },
          "miter_limit": {
            "type": "number",
            "minimum": 1
          },
          "expected_area": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_perimeter": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
