{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/geometry/section",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "outer",
      "holes",
      "bottom",
      "top",
      "z",
      "expected"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "outer": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      },
      "holes": {
        "type": "array",
        "items": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      },
      "bottom": {
        "type": "number"
      },
      "top": {
        "type": "number"
      },
      "z": {
        "type": "number"
      },
      "expected": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "closed",
            "area",
            "points"
          ],
          "additionalProperties": false,
          "properties": {
            "closed": {
              "type": "boolean"
            },
            "area": {
              "type": "number"
            },
            "points": {
              "type": "integer",
              "minimum": 2
            }
          }
        }
      }
    }
  }
}
