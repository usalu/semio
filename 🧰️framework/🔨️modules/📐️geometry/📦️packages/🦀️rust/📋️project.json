      "options": {
        "cwd": "🧰️framework/🔨️modules/📐️geometry/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test oracle three",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [],
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain",
        "{workspaceRoot}/🧰️framework/🔨️modules/◻️2d/🧱️regions/**/*"
      ]
    },
    "test-oracle-shapely": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/📐️geometry/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test oracle shapely",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [],
      "dependsOn": [
        "workspace:deps-python"
      ],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain",
        "{workspaceRoot}/🧰️framework/🔨️modules/◻️2d/🧱️regions/**/*"
      ]
    }
  }
}
