{
  "name": "semio-framework-geometry",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/📐️geometry/**/*",
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ],
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ]
  },
  "targets": {
    "test-selection-oracle": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "cache": true,
      "dependsOn": ["workspace:deps-python"],
      "options": {
        "cwd": "🧰️framework/🔨️modules/📐️geometry/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test oracle selection",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/📐️geometry/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-oracle": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/📐️geometry/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test oracle",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [],
      "dependsOn": [
        "workspace:deps-python"
      ],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain",
        "{workspaceRoot}/🧰️framework/🔨️modules/◻️2d/🧱️regions/**/*"
