{
  "name": "semio-framework-expression",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧮️expression/**/*",
      "{projectRoot}/**/*"
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧮️expression/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-oracle": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧮️expression/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test oracle",
        "forwardAllArgs": true
      },
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "workspace:deps-python"
      ],
      "inputs": [
        "default"
      ]
    },
    "test-oracle-python": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧮️expression/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test oracle python",
        "forwardAllArgs": true
      },
      "cache": false,
      "outputs": [],
      "dependsOn": [
        "workspace:deps-python"
      ],
      "inputs": [
        "default"
      ]
    }
  }
}
