{
  "name": "semio-framework-expression",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧮️expression/**/*",
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/🧲️fixture-reader/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧮️expression/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-oracle": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧮️expression/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test oracle",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [],
      "dependsOn": [
        "workspace:deps-python"
      ],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ]
    },
    "test-oracle-python": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧮️expression/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test oracle python",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [],
      "dependsOn": [
        "workspace:deps-python"
      ],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ]
    }
  }
}
