{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "grants", "pages", "foreign", "ownership", "trace"],
  "properties": {
    "version": { "const": 1 },
    "grants": { "const": [1, 64, 4096] },
    "pages": { "const": 384 },
    "foreign": { "const": { "foreign": ["Grüße 🌊"] } },
    "ownership": { "const": { "occupiedTransfer": false, "zeroGrantAdvances": false, "rejectedChildrenRetired": true, "typedFieldsRetired": true, "globalQueueAdvances": false, "handbackTransfersWholeOwner": true, "terminalBeforeReadmission": true } },
    "trace": { "const": [
      { "event": "begin-a", "active": "a", "source": null },
      { "event": "zero-grant", "active": "a", "source": null },
      { "event": "begin-b-occupied", "active": "a", "source": "b" },
      { "event": "handback-a", "active": null, "source": "b", "handback": "a" },
      { "event": "finish-handback-a", "active": null, "source": "b", "handback": null },
      { "event": "begin-b", "active": "b", "source": null },
      { "event": "finish-b", "active": null, "source": null }
    ] }
  }
}
