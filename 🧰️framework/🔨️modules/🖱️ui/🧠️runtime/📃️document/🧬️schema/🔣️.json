{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/ui/runtime/document/schema.json",
  "title": "Ui Runtime Document Schema Module",
  "$defs": {
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "surfaces",
        "surfaceCeilingBytes",
        "aggregateCeilingBytes",
        "workBytes",
        "physicalBytes",
        "comparisonHeapAllocations",
        "comparisonLogicalDepth",
        "unwindPhases",
        "freshCompletionFields",
        "completionTransferUsesSeparateGrant",
        "sameRootForReader",
        "oldReaderSurvivesReplacement",
        "readerReleaseGrants"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "surfaces": {
          "const": 9
        },
        "surfaceCeilingBytes": {
          "const": 8388608
        },
        "aggregateCeilingBytes": {
          "const": 33554432
        },
        "workBytes": {
          "const": 4096
        },
        "physicalBytes": {
          "const": 32768
        },
        "comparisonHeapAllocations": {
          "const": 0
        },
        "comparisonLogicalDepth": {
          "const": 256
        },
        "unwindPhases": {
          "const": [
            "comparison",
            "copy",
            "source-returned",
            "candidate-returned"
          ]
        },
        "freshCompletionFields": {
          "const": [
            "component",
            "bindings"
          ]
        },
        "completionTransferUsesSeparateGrant": {
          "const": true
        },
        "sameRootForReader": {
          "const": true
        },
        "oldReaderSurvivesReplacement": {
          "const": true
        },
        "readerReleaseGrants": {
          "const": [
            1,
            64,
            4096
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/Document"
    }
  ]
}
