{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "geometry",
    "numbers",
    "alignment",
    "precision",
    "icons"
  ],
  "properties": {
    "geometry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "bounds",
          "segments",
          "inline",
          "border"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "segments": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "inline": {
            "enum": [
              "ltr",
              "rtl"
            ]
          },
          "border": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "numbers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "text"
        ],
        "properties": {
          "value": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "alignment": {
      "const": "center"
    },
    "precision": {
      "const": 12
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "case",
        "rects"
      ],
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "case": {
          "type": "string"
        },
        "rects": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
