{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/ui/schema.json",
  "title": "Ui Schema Module",
  "$defs": {
    "UIDialogModalFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "cases",
        "expected",
        "scoped"
      ],
      "properties": {
        "schema": {
          "const": "semio.ui.dialog-accessibility-fixture.v1"
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "locale",
              "title",
              "description",
              "field",
              "kind",
              "cancel",
              "submit"
            ],
            "properties": {
              "locale": {
                "enum": [
                  "en",
                  "de"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "cancel": {
                "type": "string",
                "minLength": 1
              },
              "submit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "modal",
            "isolated",
            "focusReturns",
            "escapeCancels",
            "outsideCancels",
            "buttonEnterSubmits",
            "requiredMissingSubmits",
            "validSubmits"
          ],
          "properties": {
            "role": {
              "const": "dialog"
            },
            "modal": {
              "const": "true"
            },
            "isolated": {
              "const": "true"
            },
            "focusReturns": {
              "const": true
            },
            "escapeCancels": {
              "const": 1
            },
            "outsideCancels": {
              "const": 1
            },
            "buttonEnterSubmits": {
              "const": 0
            },
            "requiredMissingSubmits": {
              "const": 0
            },
            "validSubmits": {
              "const": 1
            }
          }
        },
        "scoped": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modal",
            "ownAppIsolated",
            "siblingShellIsolated",
            "bodySiblingIsolated",
            "position",
            "foreignEscapeCancels",
            "ownEscapeCancels"
          ],
          "properties": {
            "modal": {
              "const": "false"
            },
            "ownAppIsolated": {
              "const": true
            },
            "siblingShellIsolated": {
              "const": false
            },
            "bodySiblingIsolated": {
              "const": false
            },
            "position": {
              "const": "absolute"
            },
            "foreignEscapeCancels": {
              "const": 0
            },
            "ownEscapeCancels": {
              "const": 1
            }
          }
        }
      }
    }
  }
}
