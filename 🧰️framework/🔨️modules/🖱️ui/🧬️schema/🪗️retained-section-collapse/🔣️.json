{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://ui/retained-section-collapse.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "section", "states"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "defaultOpen", "childId", "childLabel"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "defaultOpen": { "type": "boolean" },
        "childId": { "type": "string", "minLength": 1 },
        "childLabel": { "type": "string", "minLength": 1 }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed", "open"],
      "properties": {
        "closed": { "$ref": "#/$defs/state" },
        "open": { "$ref": "#/$defs/state" }
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expanded", "childLayout", "childPaint", "childHit", "childAccessibility"],
      "properties": {
        "expanded": { "type": "boolean" },
        "childLayout": { "type": "boolean" },
        "childPaint": { "type": "boolean" },
        "childHit": { "type": "boolean" },
        "childAccessibility": { "type": "boolean" }
      }
    }
  }
}
