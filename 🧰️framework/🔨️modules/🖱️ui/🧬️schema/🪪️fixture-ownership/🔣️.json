{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/ui/fixture-ownership.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture",
          "schema",
          "removed",
          "schemaId"
        ],
        "properties": {
          "fixture": {
            "type": "string",
            "pattern": "^🧰️framework/🔨️modules/🖱️ui/🧫️fixtures/"
          },
          "schema": {
            "type": "string",
            "pattern": "^🧰️framework/🔨️modules/🖱️ui/🧬️schema/"
          },
          "removed": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "schemaId": {
            "type": "string",
            "pattern": "^https://semio.tech/framework/ui/"
          }
        }
      }
    }
  }
}
