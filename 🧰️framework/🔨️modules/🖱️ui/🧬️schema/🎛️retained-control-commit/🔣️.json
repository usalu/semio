{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance",
    "rules",
    "cases"
  ],
  "properties": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what",
        "why",
        "rule",
        "implementations",
        "reference"
      ],
      "properties": {
        "what": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "implementations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rust",
            "typescript"
          ],
          "properties": {
            "rust": {
              "type": "string"
            },
            "typescript": {
              "type": "string"
            }
          }
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namedByTrigger",
        "mergedOverArgs",
        "unboundIsSilent",
        "inputTriggerByCommitPolicy",
        "inputNumberIsNumeric",
        "toggleCommitsTheFlip",
        "sliderReadsItsOwnTrack",
        "ringReadsItsOwnCircle",
        "stepperThirds",
        "continuousPress",
        "dragReportsEveryValue"
      ],
      "properties": {
        "namedByTrigger": {
          "type": "string"
        },
        "mergedOverArgs": {
          "type": "string"
        },
        "unboundIsSilent": {
          "type": "string"
        },
        "inputTriggerByCommitPolicy": {
          "type": "string"
        },
        "inputNumberIsNumeric": {
          "type": "string"
        },
        "toggleCommitsTheFlip": {
          "type": "string"
        },
        "sliderReadsItsOwnTrack": {
          "type": "string"
        },
        "ringReadsItsOwnCircle": {
          "type": "string"
        },
        "stepperThirds": {
          "type": "string"
        },
        "continuousPress": {
          "type": "string"
        },
        "dragReportsEveryValue": {
          "type": "string"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "why",
          "node",
          "binding",
          "bounds",
          "gesture",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "node": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "input",
                  "toggle",
                  "slider",
                  "numberStepper",
                  "ring",
                  "iconSelect"
                ]
              },
              "id": {
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "inputKind": {
                "type": "string"
              },
              "commit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "on": {
                "type": "boolean"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "uniform": {
                "type": "boolean"
              },
              "orbId": {
                "type": "string"
              },
              "t": {
                "type": "number"
              },
              "classifierKind": {
                "type": "string"
              }
            }
          },
          "binding": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "trigger",
                  "action",
                  "args"
                ],
                "properties": {
                  "trigger": {
                    "enum": [
                      "change",
                      "delta",
                      "commit"
                    ]
                  },
                  "action": {
                    "type": "string"
                  },
                  "args": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                      "generationId": {
                        "type": "string"
                      },
                      "questionId": {
                        "type": "string"
                      },
                      "windowId": {
                        "type": "string"
                      },
                      "widgetId": {
                        "type": "string"
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      "delta": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            ]
          },
          "deltaBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trigger",
              "action",
              "args"
            ],
            "properties": {
              "trigger": {
                "enum": [
                  "change",
                  "delta",
                  "commit"
                ]
              },
              "action": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "generationId": {
                    "type": "string"
                  },
                  "questionId": {
                    "type": "string"
                  },
                  "windowId": {
                    "type": "string"
                  },
                  "widgetId": {
                    "type": "string"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "delta": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "bounds": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "gesture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "at"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "press",
                  "drag",
                  "type",
                  "typeThenEnter",
                  "typeThenBlur"
                ]
              },
              "at": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "to": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "text": {
                "type": "string"
              }
            }
          },
          "expected": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "args"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "args": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                      "generationId": {
                        "type": "string"
                      },
                      "questionId": {
                        "type": "string"
                      },
                      "windowId": {
                        "type": "string"
                      },
                      "widgetId": {
                        "type": "string"
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      "delta": {
                        "type": "number"
                      }
                    }
                  },
                  "press": {
                    "enum": [
                      "open",
                      "released"
                    ]
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "node": {
                  "properties": {
                    "kind": {
                      "const": "ring"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "node"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "object",
                  "required": [
                    "press"
                  ],
                  "properties": {
                    "press": {
                      "const": "released"
                    }
                  }
                }
              },
              "required": [
                "expected"
              ],
              "type": "object"
            }
          }
        ]
      }
    }
  }
}
