{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "crates"],
  "properties": {
    "version": {"const": 1},
    "crates": {"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["package","manifest","entry","dependencies","forbiddenDependencies"],
      "properties":{
        "package":{"type":"string","pattern":"^semio-framework-[a-z0-9-]+$"},
        "manifest":{"type":"string"},"entry":{"type":"string"},
        "dependencies":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "forbiddenDependencies":{"type":"array","uniqueItems":true,"items":{"type":"string"}}
      }
    }}
  }
}
