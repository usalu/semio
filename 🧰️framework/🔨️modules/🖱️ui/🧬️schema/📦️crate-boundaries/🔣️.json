{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "crates",
    "tuiTest",
    "identifiers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "crates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "manifest",
          "entry",
          "dependencies",
          "forbiddenDependencies"
        ],
        "properties": {
          "package": {
            "type": "string",
            "pattern": "^semio-[a-z0-9-]+$"
          },
          "manifest": {
            "type": "string"
          },
          "entry": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "forbiddenDependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tuiTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packages",
        "features",
        "cases"
      ],
      "properties": {
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "manifest"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^semio-ui-tui-[a-z0-9-]+$"
              },
              "manifest": {
                "type": "string"
              }
            }
          }
        },
        "features": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "args",
              "forwarded"
            ],
            "properties": {
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "forwarded": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "accepted"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
