{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/ui/section-field-presentation.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "density", "section", "field"],
  "properties": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "implementations"],
      "properties": {
        "what": { "type": "string", "minLength": 1 },
        "implementations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rust", "typescript"],
          "properties": {
            "rust": { "type": "string", "minLength": 1 },
            "typescript": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap", "fieldLabelFontSize", "fieldLabelLineHeight", "fieldDetailFontSize", "fieldDetailLineHeight", "sectionTitleFontSize", "sectionTitleLineHeight", "sectionTitleBodyGap", "sectionTrailingMargin"],
      "properties": {
        "gap": { "const": 3.2 },
        "fieldLabelFontSize": { "const": 12.8 },
        "fieldLabelLineHeight": { "const": 19.2 },
        "fieldDetailFontSize": { "const": 11.2 },
        "fieldDetailLineHeight": { "const": 16.0 },
        "sectionTitleFontSize": { "const": 21.6 },
        "sectionTitleLineHeight": { "const": 30.4 },
        "sectionTitleBodyGap": { "const": 16.0 },
        "sectionTrailingMargin": { "const": 32.0 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "title", "titleLines", "titleHeight", "contentTop", "trailingMargin"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "titleLines": { "const": 2 },
        "titleHeight": { "const": 60.8 },
        "contentTop": { "const": 76.8 },
        "trailingMargin": { "const": 32.0 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "label", "description", "error", "detailLines", "controlHeight", "controlTop", "errorTop", "totalHeight"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 },
        "detailLines": { "const": 2 },
        "controlHeight": { "const": 22.4 },
        "controlTop": { "const": 57.6 },
        "errorTop": { "const": 83.2 },
        "totalHeight": { "const": 115.2 }
      }
    }
  }
}
