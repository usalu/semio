{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/ui/graph-timeline-authors.json",
  "title": "Graph Timeline Authors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkpointId", "avatarSize", "overlap", "advance", "authors", "replacementAvatar"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checkpointId": { "type": "string", "minLength": 1 },
    "avatarSize": { "const": 16.0 },
    "overlap": { "const": 8.0 },
    "advance": { "const": 8.0 },
    "authors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "initials"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "avatar": { "type": "string", "minLength": 1 },
          "initials": { "type": "string", "minLength": 1, "maxLength": 2 }
        }
      }
    },
    "replacementAvatar": { "type": "string", "minLength": 1 }
  }
}
