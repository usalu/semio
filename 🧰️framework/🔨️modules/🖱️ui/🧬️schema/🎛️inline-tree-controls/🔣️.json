{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inline Tree Resolution Controls",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conflict",
    "rowId",
    "controls",
    "expected"
  ],
  "properties": {
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "message",
        "quarantined"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "quarantined": {
          "type": "boolean"
        }
      }
    },
    "rowId": {
      "type": "string",
      "minLength": 1
    },
    "controls": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suffix",
          "label",
          "icon",
          "accept"
        ],
        "properties": {
          "suffix": {
            "enum": [
              "accept",
              "discard"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "enum": [
              "check",
              "x"
            ]
          },
          "accept": {
            "type": "boolean"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowCount",
        "controlComponent",
        "containerRole",
        "axis"
      ],
      "properties": {
        "rowCount": {
          "const": 1
        },
        "controlComponent": {
          "const": "button"
        },
        "containerRole": {
          "const": "toolbar"
        },
        "axis": {
          "const": "horizontal"
        }
      }
    }
  }
}
