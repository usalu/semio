{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Native Command Dispatch Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/Case"
      }
    }
  },
  "$defs": {
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "calls",
        "rejected",
        "level",
        "coverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "inheritedLevel": {
          "enum": [
            "fundamental",
            "quick",
            "long",
            "exhaustive"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Call"
          }
        },
        "rejected": {
          "type": "boolean"
        },
        "level": {
          "enum": [
            "fundamental",
            "quick",
            "long",
            "exhaustive"
          ]
        },
        "coverage": {
          "type": "boolean"
        }
      }
    },
    "Call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "args"
      ],
      "properties": {
        "kind": {
          "enum": [
            "test",
            "check",
            "axes"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "level": {
          "enum": [
            "fundamental",
            "quick",
            "long",
            "exhaustive"
          ]
        },
        "coverage": {
          "type": "boolean"
        },
        "budgetMs": {
          "const": 4242
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "test"
            },
            "level": {},
            "coverage": {}
          },
          "required": [
            "level",
            "coverage"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "check"
            },
            "budgetMs": {}
          },
          "required": [
            "budgetMs"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "axes"
            }
          }
        }
      ]
    }
  }
}
