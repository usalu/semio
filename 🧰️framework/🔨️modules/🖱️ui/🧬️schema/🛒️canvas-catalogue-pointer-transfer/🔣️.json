{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/ui/canvas-catalogue-pointer-transfer.json",
  "title": "Canvas catalogue pointer transfer fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mime", "surface", "cases"],
  "properties": {
    "version": { "const": 1 },
    "mime": { "type": "string", "minLength": 1 },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "controllerId", "left", "top", "width", "height"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "controllerId": { "type": "string", "minLength": 1 },
        "left": { "type": "number" },
        "top": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rawPayload", "moves", "terminal", "terminalPoint", "expectedActions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rawPayload": { "type": "string", "minLength": 1 },
          "moves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              }
            }
          },
          "terminal": { "enum": ["up", "cancel"] },
          "terminalPoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "expectedActions": {
            "type": "array",
            "items": { "enum": ["canvasDragOver", "canvasDragLeave", "canvasDrop"] }
          }
        }
      }
    }
  }
}
