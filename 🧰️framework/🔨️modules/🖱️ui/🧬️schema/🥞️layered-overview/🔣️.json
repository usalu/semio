{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/ui/layered-overview-v1.json",
  "title": "Layered overview geometry and lifecycle vectors",
  "description": "🥞️ Input/expected pairs every implementation of the layered overview (strip of panes, glass veil with a hole, card overlay) reads: grid shapes, centred last rows, pan clamps, easing, glides, follow steps, strip transforms, veil polygons with their evenodd areas, windowing, warm boots, budget and time-based release, the share of the gap a follow closes within an elapsed time, and the swipe mode — nearest and resting cells, the axis a touch locks to, the step a released swipe takes, the neighbouring cell it lands on, the rubber band, the strip under a dragging finger, the settle, a flung card scroll, the landing of a swipe on the wrapping strip (its cell and the slot beside the view it comes in from), the neighbours warmed around the resting cell and the neighbours its hints name. Percent values are rounded to 1e-4; a null time means never.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "grids", "invalidGridCounts", "rowSpans", "cells", "occupied", "clamps", "pointers", "easing", "glides", "follows", "stripTransforms", "veils", "windows", "windowedCells", "lifecycles", "warmBoots", "warmDelays", "budgets", "releases", "followFactors", "nearestCells", "restingCells", "swipeAxes", "swipeSteps", "swipeTargets", "rubberBands", "swipeDrags", "settles", "flings", "neighbourWarmBoots", "swipeWrapTargets", "swipeNeighbours"],
  "definitions": {
    "cell": { "type": "object", "additionalProperties": false, "required": ["column", "row"], "properties": { "column": { "type": "integer", "minimum": 0 }, "row": { "type": "integer", "minimum": 0 } } },
    "offset": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "grid": { "type": "object", "additionalProperties": false, "required": ["columns", "rows"], "properties": { "columns": { "type": "integer", "minimum": 1 }, "rows": { "type": "integer", "minimum": 1 } } },
    "span": { "type": "object", "additionalProperties": false, "required": ["first", "last"], "properties": { "first": { "type": "integer" }, "last": { "type": "integer" } } },
    "ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "time": { "type": ["number", "null"], "minimum": 0 },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget", "warmStartMs", "warmIntervalMs", "suspendIdleMs", "suspendOffscreenMs", "suspendHiddenMs", "sweepMs"],
      "properties": {
        "budget": { "type": "integer", "minimum": 1 },
        "warmStartMs": { "$ref": "#/definitions/time" },
        "warmIntervalMs": { "$ref": "#/definitions/time" },
        "suspendIdleMs": { "$ref": "#/definitions/time" },
        "suspendOffscreenMs": { "$ref": "#/definitions/time" },
        "suspendHiddenMs": { "$ref": "#/definitions/time" },
        "sweepMs": { "$ref": "#/definitions/time" }
      }
    },
    "partialLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": { "type": "integer", "minimum": 1 },
        "warmStartMs": { "type": "number", "minimum": 0 },
        "warmIntervalMs": { "type": "number", "minimum": 0 },
        "suspendIdleMs": { "type": "number", "minimum": 0 },
        "suspendOffscreenMs": { "type": "number", "minimum": 0 },
        "suspendHiddenMs": { "type": "number", "minimum": 0 },
        "sweepMs": { "type": "number", "minimum": 0 }
      }
    },
    "named": { "type": "string", "minLength": 1 },
    "landing": { "type": "object", "additionalProperties": false, "required": ["cell", "slot"], "properties": { "cell": { "$ref": "#/definitions/cell" }, "slot": { "$ref": "#/definitions/offset" } } }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "grids": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "grid"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "grid": { "$ref": "#/definitions/grid" } } } },
    "invalidGridCounts": { "type": "array", "items": { "type": "number" } },
    "rowSpans": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "row", "span"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "row": { "type": "integer", "minimum": 0 }, "span": { "$ref": "#/definitions/span" } } } },
    "cells": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "index", "cell"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "index": { "type": "integer", "minimum": 0 }, "cell": { "$ref": "#/definitions/cell" } } } },
    "occupied": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "y", "span"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "y": { "type": "number" }, "span": { "$ref": "#/definitions/span" } } } },
    "clamps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "offset", "clamped"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "offset": { "$ref": "#/definitions/offset" }, "clamped": { "$ref": "#/definitions/offset" } } } },
    "pointers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "grid", "fx", "fy", "offset"], "properties": { "name": { "$ref": "#/definitions/named" }, "grid": { "$ref": "#/definitions/grid" }, "fx": { "type": "number" }, "fy": { "type": "number" }, "offset": { "$ref": "#/definitions/offset" } } } },
    "easing": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["t", "eased"], "properties": { "t": { "type": "number", "minimum": 0, "maximum": 1 }, "eased": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    "glides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "from", "to", "durationMs", "samples"],
        "properties": {
          "name": { "$ref": "#/definitions/named" },
          "from": { "$ref": "#/definitions/offset" },
          "to": { "$ref": "#/definitions/offset" },
          "durationMs": { "type": "number", "exclusiveMinimum": 0 },
          "samples": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["elapsedMs", "offset", "done"], "properties": { "elapsedMs": { "type": "number" }, "offset": { "$ref": "#/definitions/offset" }, "done": { "type": "boolean" } } } }
        }
      }
    },
    "follows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "current", "target", "offset", "settled"], "properties": { "name": { "$ref": "#/definitions/named" }, "elapsedMs": { "type": "number", "minimum": 0 }, "current": { "$ref": "#/definitions/offset" }, "target": { "$ref": "#/definitions/offset" }, "offset": { "$ref": "#/definitions/offset" }, "settled": { "type": "boolean" } } } },
    "stripTransforms": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "offset", "grid", "transform"], "properties": { "name": { "$ref": "#/definitions/named" }, "offset": { "$ref": "#/definitions/offset" }, "grid": { "$ref": "#/definitions/grid" }, "transform": { "type": "string", "pattern": "^translate3d\\(" } } } },
    "veils": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cell", "offset", "kind", "area"],
        "properties": {
          "name": { "$ref": "#/definitions/named" },
          "cell": { "oneOf": [{ "$ref": "#/definitions/cell" }, { "type": "null" }] },
          "offset": { "$ref": "#/definitions/offset" },
          "kind": { "enum": ["whole", "clear", "hole"] },
          "hole": { "type": "object", "additionalProperties": false, "required": ["left", "top", "right", "bottom"], "properties": { "left": { "type": "number" }, "top": { "type": "number" }, "right": { "type": "number" }, "bottom": { "type": "number" } } },
          "polygon": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 100 } } },
          "clipPath": { "type": "string" },
          "area": { "type": "number", "minimum": 0, "maximum": 10000 }
        }
      }
    },
    "windows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "offset", "radius", "window"], "properties": { "name": { "$ref": "#/definitions/named" }, "offset": { "$ref": "#/definitions/offset" }, "radius": { "type": "integer", "minimum": 0 }, "window": { "type": "object", "additionalProperties": false, "required": ["firstColumn", "lastColumn", "firstRow", "lastRow"], "properties": { "firstColumn": { "type": "integer" }, "lastColumn": { "type": "integer" }, "firstRow": { "type": "integer" }, "lastRow": { "type": "integer" } } } } } },
    "windowedCells": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "offset", "radius", "windowed"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "offset": { "$ref": "#/definitions/offset" }, "radius": { "type": "integer", "minimum": 0 }, "windowed": { "type": "integer", "minimum": 0 } } } },
    "lifecycles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "given", "resolved"], "properties": { "name": { "$ref": "#/definitions/named" }, "given": { "$ref": "#/definitions/partialLifecycle" }, "resolved": { "$ref": "#/definitions/lifecycle" } } } },
    "warmBoots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ids", "booted", "liveCount", "openedId", "budget", "step"],
        "properties": {
          "name": { "$ref": "#/definitions/named" },
          "ids": { "$ref": "#/definitions/ids" },
          "booted": { "$ref": "#/definitions/ids" },
          "liveCount": { "type": "integer", "minimum": 0 },
          "openedId": { "type": ["string", "null"] },
          "budget": { "type": "integer", "minimum": 1 },
          "step": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "boot" }, "id": { "type": "string" } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": { "kind": { "const": "hold" }, "reason": { "enum": ["opened", "budget", "complete"] } } }] }
        }
      }
    },
    "warmDelays": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "warmedBefore", "lifecycle", "delayMs"], "properties": { "name": { "$ref": "#/definitions/named" }, "warmedBefore": { "type": "boolean" }, "lifecycle": { "$ref": "#/definitions/partialLifecycle" }, "delayMs": { "type": "number", "minimum": 0 } } } },
    "budgets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "liveByRecency", "keep", "budget", "released"], "properties": { "name": { "$ref": "#/definitions/named" }, "liveByRecency": { "$ref": "#/definitions/ids" }, "keep": { "$ref": "#/definitions/ids" }, "budget": { "type": "integer", "minimum": 1 }, "released": { "$ref": "#/definitions/ids" } } } },
    "followFactors": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["name", "elapsedMs", "factor"], "properties": { "name": { "$ref": "#/definitions/named" }, "elapsedMs": { "type": "number" }, "factor": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    "nearestCells": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "offset", "cell"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "offset": { "$ref": "#/definitions/offset" }, "cell": { "$ref": "#/definitions/cell" } } } },
    "restingCells": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "offset", "cell"], "properties": { "name": { "$ref": "#/definitions/named" }, "offset": { "$ref": "#/definitions/offset" }, "cell": { "oneOf": [{ "$ref": "#/definitions/cell" }, { "type": "null" }] } } } },
    "swipeAxes": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "dx", "dy", "axis"], "properties": { "name": { "$ref": "#/definitions/named" }, "dx": { "type": "number" }, "dy": { "type": "number" }, "axis": { "enum": ["x", "y", null] } } } },
    "swipeSteps": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "movedPx", "velocityPxPerMs", "viewPx", "step"], "properties": { "name": { "$ref": "#/definitions/named" }, "movedPx": { "type": "number" }, "velocityPxPerMs": { "type": "number" }, "viewPx": { "type": "number", "exclusiveMinimum": 0 }, "step": { "enum": [-1, 0, 1] } } } },
    "swipeTargets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "from", "axis", "step", "target"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "from": { "$ref": "#/definitions/cell" }, "axis": { "enum": ["x", "y"] }, "step": { "enum": [-1, 0, 1] }, "target": { "oneOf": [{ "$ref": "#/definitions/cell" }, { "type": "null" }] } } } },
    "rubberBands": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["overshoot", "pull"], "properties": { "overshoot": { "type": "number" }, "pull": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 } } } },
    "swipeDrags": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "from", "axis", "shift", "offset"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "from": { "$ref": "#/definitions/cell" }, "axis": { "enum": ["x", "y"] }, "shift": { "type": "number" }, "offset": { "$ref": "#/definitions/offset" } } } },
    "settles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "from", "to", "durationMs", "samples"],
        "properties": {
          "name": { "$ref": "#/definitions/named" },
          "from": { "$ref": "#/definitions/offset" },
          "to": { "$ref": "#/definitions/offset" },
          "durationMs": { "type": "number", "exclusiveMinimum": 0 },
          "samples": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["elapsedMs", "offset", "done"], "properties": { "elapsedMs": { "type": "number" }, "offset": { "$ref": "#/definitions/offset" }, "done": { "type": "boolean" } } } }
        }
      }
    },
    "swipeWrapTargets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "from", "axis", "step", "landing"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "from": { "$ref": "#/definitions/cell" }, "axis": { "enum": ["x", "y"] }, "step": { "enum": [-1, 0, 1] }, "landing": { "oneOf": [{ "$ref": "#/definitions/landing" }, { "type": "null" }] } } } },
    "swipeNeighbours": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "count", "from", "neighbours"], "properties": { "name": { "$ref": "#/definitions/named" }, "count": { "type": "integer", "minimum": 1 }, "from": { "$ref": "#/definitions/cell" }, "neighbours": { "type": "array", "maxItems": 4, "items": { "type": "object", "additionalProperties": false, "required": ["direction", "cell", "slot"], "properties": { "direction": { "enum": ["up", "left", "right", "down"] }, "cell": { "$ref": "#/definitions/cell" }, "slot": { "$ref": "#/definitions/offset" } } } } } } },
    "flings": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "velocityPxPerMs", "elapsedMs", "distance", "velocity", "done"], "properties": { "name": { "$ref": "#/definitions/named" }, "velocityPxPerMs": { "type": "number" }, "elapsedMs": { "type": "number" }, "distance": { "type": "number" }, "velocity": { "type": "number" }, "done": { "type": "boolean" } } } },
    "neighbourWarmBoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "count", "at", "live", "openedId", "budget", "step"],
        "properties": {
          "name": { "$ref": "#/definitions/named" },
          "count": { "type": "integer", "minimum": 1 },
          "at": { "$ref": "#/definitions/cell" },
          "live": { "$ref": "#/definitions/ids" },
          "openedId": { "type": ["string", "null"] },
          "budget": { "type": "integer", "minimum": 1 },
          "step": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "boot" }, "id": { "type": "string" } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": { "kind": { "const": "hold" }, "reason": { "enum": ["opened", "budget", "complete"] } } }] }
        }
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "lifecycle", "live", "keep", "now", "opened", "hidden", "released"],
        "properties": {
          "name": { "$ref": "#/definitions/named" },
          "lifecycle": { "$ref": "#/definitions/partialLifecycle" },
          "live": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "since"], "properties": { "id": { "type": "string" }, "since": { "type": "number", "minimum": 0 } } } },
          "keep": { "$ref": "#/definitions/ids" },
          "now": { "type": "number", "minimum": 0 },
          "opened": { "type": "boolean" },
          "hidden": { "type": "boolean" },
          "released": { "$ref": "#/definitions/ids" }
        }
      }
    }
  }
}
