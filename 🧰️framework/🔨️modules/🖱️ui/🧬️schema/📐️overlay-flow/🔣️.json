{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.ui.overlay-flow-fixture.schema.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "viewport", "root", "overlay", "content", "absolute", "following"],
  "properties": {
    "schema": { "const": "semio.ui.overlay-flow-fixture.v1" },
    "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } },
    "root": {
      "type": "object", "additionalProperties": false, "required": ["layout", "expectedRect"],
      "properties": {
        "layout": {
          "type": "object", "additionalProperties": false, "required": ["kind", "axis", "gap", "padding", "align", "justify", "grow", "wrap"],
          "properties": {
            "kind": { "const": "stack" }, "axis": { "const": "vertical" }, "gap": { "const": "none" },
            "padding": { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "const": "none" } } },
            "align": { "const": "stretch" }, "justify": { "const": "start" }, "grow": { "type": "boolean" }, "wrap": { "type": "boolean" }
          }
        },
        "expectedRect": { "$ref": "#/$defs/rectangle" }
      }
    },
    "overlay": {
      "type": "object", "additionalProperties": false, "required": ["layout", "expectedCss", "expectedRect"],
      "properties": {
        "layout": {
          "type": "object", "additionalProperties": false, "required": ["kind", "anchor", "inset", "dismissible"],
          "properties": {
            "kind": { "const": "overlay" }, "anchor": { "const": "center" }, "dismissible": { "type": "boolean" },
            "inset": {
              "type": "object", "additionalProperties": false, "required": ["each"],
              "properties": {
                "each": { "type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": { "top": { "$ref": "#/$defs/space" }, "right": { "$ref": "#/$defs/space" }, "bottom": { "$ref": "#/$defs/space" }, "left": { "$ref": "#/$defs/space" } } }
              }
            }
          }
        },
        "expectedCss": {
          "type": "object", "additionalProperties": false, "required": ["position", "padding", "inset"],
          "properties": { "position": { "const": "relative" }, "padding": { "type": "string", "pattern": "^calc\\([0-9]+ \\* var\\(--ui-spacing\\)\\)( calc\\([0-9]+ \\* var\\(--ui-spacing\\)\\)){3}$" }, "inset": { "const": "" } }
        },
        "expectedRect": { "$ref": "#/$defs/rectangle" }
      }
    },
    "content": { "$ref": "#/$defs/leaf" },
    "absolute": {
      "type": "object", "additionalProperties": false, "required": ["layout", "expectedCss", "expectedRect"],
      "properties": {
        "layout": { "type": "object", "additionalProperties": false, "required": ["kind", "sizingWidth", "sizingHeight"], "properties": { "kind": { "const": "absolute" }, "sizingWidth": { "$ref": "#/$defs/fixed" }, "sizingHeight": { "$ref": "#/$defs/fixed" } } },
        "expectedCss": { "type": "object", "additionalProperties": false, "required": ["position", "width", "height"], "properties": { "position": { "const": "absolute" }, "width": { "$ref": "#/$defs/cssSpace" }, "height": { "$ref": "#/$defs/cssSpace" } } },
        "expectedRect": { "$ref": "#/$defs/rectangle" }
      }
    },
    "following": { "$ref": "#/$defs/leaf" }
  },
  "$defs": {
    "space": { "enum": ["none", "xs", "sm", "md", "lg", "xl", "xxl"] },
    "fixed": { "type": "object", "additionalProperties": false, "required": ["fixed"], "properties": { "fixed": { "$ref": "#/$defs/space" } } },
    "cssSpace": { "type": "string", "pattern": "^calc\\([0-9]+ \\* var\\(--ui-spacing\\)\\)$" },
    "rectangle": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 } } },
    "leaf": {
      "type": "object", "additionalProperties": false, "required": ["layout", "expectedRect"],
      "properties": {
        "layout": { "type": "object", "additionalProperties": false, "required": ["kind", "width", "height"], "properties": { "kind": { "const": "leaf" }, "width": { "$ref": "#/$defs/fixed" }, "height": { "$ref": "#/$defs/fixed" } } },
        "expectedRect": { "$ref": "#/$defs/rectangle" }
      }
    }
  }
}
