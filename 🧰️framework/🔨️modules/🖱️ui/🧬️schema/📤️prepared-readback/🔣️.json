{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["alignment", "maxSide", "maxPixels", "srgbClear", "cases", "admission"],
  "properties": {
    "alignment": { "const": 256 },
    "maxSide": { "const": 16384 },
    "maxPixels": { "const": 16777216 },
    "srgbClear": {
      "type": "object", "additionalProperties": false, "required": ["linear", "rgba"],
      "properties": {
        "linear": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "rgba": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
      }
    },
    "cases": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "width", "height", "format", "paddedBytesPerRow", "rgba"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "format": { "enum": ["rgba8unorm", "bgra8unorm"] },
          "paddedBytesPerRow": { "type": "integer", "minimum": 256, "multipleOf": 256 },
          "rgba": { "type": "array", "minItems": 4, "items": { "type": "integer", "minimum": 0, "maximum": 255 } }
        }
      }
    },
    "admission": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["width", "height", "accepted"],
        "properties": {
          "width": { "type": "integer", "minimum": 0 },
          "height": { "type": "integer", "minimum": 0 },
          "accepted": { "type": "boolean" },
          "paddedBytesPerRow": { "type": "integer", "minimum": 256, "multipleOf": 256 }
        }
      }
    }
  }
}
