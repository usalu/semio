{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tolerance",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "icon-render-camera-v1"
    },
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "request",
          "model",
          "preview",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assetUrl",
              "format",
              "width",
              "height",
              "camera",
              "fit"
            ],
            "properties": {
              "assetUrl": {
                "type": "string"
              },
              "format": {
                "enum": [
                  "svg",
                  "png"
                ]
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "camera": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "target",
                  "zoom",
                  "fov",
                  "projection"
                ],
                "properties": {
                  "position": {
                    "$ref": "#/$defs/vector"
                  },
                  "target": {
                    "$ref": "#/$defs/vector"
                  },
                  "zoom": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "fov": {
                    "type": "number"
                  },
                  "projection": {
                    "enum": [
                      "perspective",
                      "orthographic"
                    ]
                  }
                }
              },
              "fit": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "enabled",
                  "padding"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "padding": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum",
              "maximum"
            ],
            "properties": {
              "minimum": {
                "$ref": "#/$defs/vector"
              },
              "maximum": {
                "$ref": "#/$defs/vector"
              }
            }
          },
          "preview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "target",
              "zoom",
              "effectiveFov",
              "previewZoom",
              "targetNdc"
            ],
            "properties": {
              "position": {
                "$ref": "#/$defs/vector"
              },
              "target": {
                "$ref": "#/$defs/vector"
              },
              "zoom": {
                "type": "number"
              },
              "effectiveFov": {
                "type": "number"
              },
              "previewZoom": {
                "type": "number"
              },
              "targetNdc": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  }
}
