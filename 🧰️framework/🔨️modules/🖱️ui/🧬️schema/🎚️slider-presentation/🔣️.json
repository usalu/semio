{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/ui/slider-presentation.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "tokens", "cases", "unit", "pointer"],
  "properties": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "implementations"],
      "properties": {
        "what": { "type": "string", "minLength": 1 },
        "implementations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rust", "typescript"],
          "properties": {
            "rust": { "type": "string", "minLength": 1 },
            "typescript": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spacing", "rowHeight", "readoutWidth", "railHeight", "thumbSize"],
      "properties": {
        "spacing": { "const": 3.2 },
        "rowHeight": { "const": 22.4 },
        "readoutWidth": { "const": 28.8 },
        "railHeight": { "const": 3.2 },
        "thumbSize": { "const": 16.0 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "inline", "bounds", "value", "min", "max", "formatted", "trackCell", "valueCell", "rail", "range", "thumb"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "inline": { "enum": ["ltr", "rtl"] },
          "bounds": { "$ref": "#/$defs/rect" },
          "value": { "type": "number" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "formatted": { "type": "string" },
          "trackCell": { "$ref": "#/$defs/rect" },
          "valueCell": { "$ref": "#/$defs/rect" },
          "rail": { "$ref": "#/$defs/rect" },
          "range": { "$ref": "#/$defs/rect" },
          "thumb": { "$ref": "#/$defs/rect" }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "internalReadout", "externalReadout", "accessibleValueText", "gap", "placements"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "internalReadout": { "type": "string", "minLength": 1 },
        "externalReadout": { "type": "string", "minLength": 1 },
        "accessibleValueText": { "type": "string", "minLength": 1 },
        "gap": { "const": 3.2 },
        "placements": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "inline", "bounds", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "inline": { "enum": ["ltr", "rtl"] },
              "bounds": { "$ref": "#/$defs/rect" },
              "kind": { "enum": ["standalone", "treeControl"] }
            }
          }
        }
      }
    },
    "pointer": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "point", "emits"],
        "properties": {
          "case": { "type": "string", "minLength": 1 },
          "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "emits": { "type": ["number", "null"] }
        }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    }
  }
}
