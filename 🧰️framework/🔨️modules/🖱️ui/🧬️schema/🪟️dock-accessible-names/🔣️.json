{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "windows",
    "locales",
    "publication",
    "semantics",
    "stackedActiveId"
  ],
  "properties": {
    "schema": {
      "const": "dock-accessible-names-v1"
    },
    "publication": {
      "const": "accepted-frame"
    },
    "windows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "title": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "locales": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "focus",
          "unfocus",
          "close",
          "drag"
        ],
        "properties": {
          "id": {
            "enum": [
              "en",
              "de"
            ]
          },
          "focus": {
            "$ref": "#/$defs/text"
          },
          "unfocus": {
            "$ref": "#/$defs/text"
          },
          "close": {
            "$ref": "#/$defs/text"
          },
          "drag": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tabRole",
        "panelRole",
        "selected",
        "panelActionable"
      ],
      "properties": {
        "tabRole": {
          "const": "tab"
        },
        "panelRole": {
          "const": "tabpanel"
        },
        "selected": {
          "const": true
        },
        "panelActionable": {
          "const": false
        }
      }
    },
    "stackedActiveId": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
