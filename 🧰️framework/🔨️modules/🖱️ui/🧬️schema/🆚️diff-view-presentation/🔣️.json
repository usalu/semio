{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.ui.diff-view-presentation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "host", "typography", "colors", "unified", "split", "preWrap"],
  "properties": {
    "schema": { "const": "semio.ui.diff-view-presentation.v1" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "inset"],
      "properties": {
        "width": { "const": 400 },
        "height": { "const": 160 },
        "inset": { "const": 3.2 }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "size", "lineHeight", "gap"],
      "properties": {
        "family": { "const": "Share Tech Mono" },
        "size": { "const": 11.2 },
        "lineHeight": { "const": 16 },
        "gap": { "const": 3.2 }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equal", "added", "removed"],
      "properties": {
        "equal": { "$ref": "#/$defs/rgba" },
        "added": { "$ref": "#/$defs/rgba" },
        "removed": { "$ref": "#/$defs/rgba" }
      }
    },
    "unified": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentWidth", "rowHeight", "textX"],
      "properties": {
        "contentWidth": { "const": 393.625 },
        "rowHeight": { "const": 16 },
        "textX": { "const": 107.9375 }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paneWidth", "rightX", "leftTextX", "rightTextX"],
      "properties": {
        "paneWidth": { "const": 193.125 },
        "rightX": { "const": 203.6875 },
        "leftTextX": { "const": 49.5625 },
        "rightTextX": { "const": 250.0625 }
      }
    },
    "preWrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostWidth", "text", "expectedLines"],
      "properties": {
        "hostWidth": { "const": 160 },
        "text": { "const": "a  b  c  d" },
        "expectedLines": {
          "const": ["a  b  c  ", "d"]
        }
      }
    }
  },
  "$defs": {
    "rgba": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "const": 255 }
      ],
      "items": false
    }
  }
}
