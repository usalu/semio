{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Correlated Action Receipts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "controller",
    "surface",
    "text",
    "receipts",
    "refusedToken",
    "stagedToken",
    "dispatch",
    "cancelled",
    "closed"
  ],
  "properties": {
    "schema": {
      "const": "semio.ui.correlated-action-receipts/v1"
    },
    "controller": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "member",
          "action",
          "abort"
        ],
        "properties": {
          "token": {
            "type": "integer",
            "minimum": 1
          },
          "member": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "action": {
            "type": "string"
          },
          "abort": {
            "type": "boolean"
          }
        }
      }
    },
    "stagedToken": {
      "type": "integer",
      "minimum": 1
    },
    "refusedToken": {
      "type": "integer",
      "minimum": 1
    },
    "dispatch": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cancelled": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
