{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "owners",
    "values",
    "custody",
    "dependencyCases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "owners": {
      "type": "array",
      "minItems": 7,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "name",
          "root",
          "declarations"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "companion": {
            "const": true
          },
          "declarations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "wire"
        ],
        "properties": {
          "value": {},
          "wire": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "custody": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "original",
          "caller",
          "retained",
          "valid"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "original": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caller": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "retained": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    },
    "dependencyCases": {
      "type": "array",
      "minItems": 7,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "declared",
          "required",
          "missing"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "declared": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "missing": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
