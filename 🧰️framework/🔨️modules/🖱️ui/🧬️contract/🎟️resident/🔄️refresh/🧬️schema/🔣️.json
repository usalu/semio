{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/ui/contract/resident/refresh/schema.json",
  "title": "Ui Contract Resident Refresh Cycle Schema Module",
  "$defs": {
    "ResidentRefreshSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    },
    "ResidentRefreshMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "run",
        "seconds",
        "surfaces",
        "residentRoots",
        "residentBytes",
        "fixedBackingBytes",
        "capacityFaults"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "seconds": {
          "type": "integer",
          "minimum": 1
        },
        "surfaces": {
          "type": "integer",
          "minimum": 1
        },
        "residentRoots": {
          "type": "integer",
          "minimum": 0
        },
        "residentBytes": {
          "type": "integer",
          "minimum": 0
        },
        "fixedBackingBytes": {
          "type": "integer",
          "minimum": 0
        },
        "capacityFaults": {
          "const": 0
        }
      }
    }
  }
}
