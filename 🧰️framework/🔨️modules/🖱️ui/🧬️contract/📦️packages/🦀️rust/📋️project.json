{
  "name": "@semio-tech/ui-contract-rs",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "built-tree-retirement-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts built-tree-retirement-check",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🧪️tests/🧫️fixtures/🎛️inline-tree-controls/🔣️.json",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🧪️tests/🧫️fixtures/🖼️scene-raster-ownership/🔣️.json",
        "{workspaceRoot}/🧰️framework/🔨️modules/🗺️surface/🎨️paint/🧪️tests/🧫️fixtures/✏️editing/🔣️.json"
      ]
    },
    "conformance": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts conformance",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "check-wasm": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check-wasm"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts generate"
      }
    },
    "preview-generated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts preview-generated"
      },
      "outputs": []
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🧬️contract/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check"
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🧪️tests/🧫️fixtures/🎛️inline-tree-controls/🔣️.json",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🧪️tests/🧫️fixtures/🖼️scene-raster-ownership/🔣️.json",
        "{workspaceRoot}/🧰️framework/🔨️modules/🗺️surface/🎨️paint/🧪️tests/🧫️fixtures/✏️editing/🔣️.json"
      ]
    }
  },
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🧬️contract/**/*",
      "sharedGlobals"
    ]
  }
}
