{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.ui.resident.metadata.v1",
  "title": "Owned UI Fixed Metadata Admission",
  "description": "Declared logical metadata records charged in the same composition ledger as raw input and destination backing. These are not physical heap sizes or work grants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "records"],
  "properties": {
    "kind": { "enum": ["pool", "instance", "payload", "builder", "reader", "page", "evidence"] },
    "records": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "fields"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "fields": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
