{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/ui/contract/retained/operations/wire/pages/schema.json",
  "title": "Ui Contract Retained Operations Wire Pages Schema Module",
  "definitions": {
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "Pages": {
      "title": "Retained Operation Payload Admission",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredBytes",
        "destinationPageBytes",
        "inputOwner",
        "residentOwner",
        "completion"
      ],
      "properties": {
        "declaredBytes": {
          "$ref": "https://json.schemas.assets.semio-tech.com/framework/actor/page/schema.json#/$defs/Word",
          "description": "Neutral canonical decimal integer domain from zero through u64::MAX. This field length is not byte-page, allocation or release authority."
        },
        "destinationPageBytes": {
          "const": 256
        },
        "inputOwner": {
          "const": "native-private-field-and-fragment"
        },
        "residentOwner": {
          "const": "shared-host-exact-instance-payload"
        },
        "completion": {
          "const": "copied-input-is-not-publication"
        }
      }
    }
  }
}
