{
  "$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "additionalProperties": false,
  "required": ["version", "capacity", "node", "versions", "laws"],
  "properties": {
    "version": { "const": 1 }, "capacity": { "const": 2 }, "node": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "versions": { "type": "array", "minItems": 3, "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
    "laws": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
