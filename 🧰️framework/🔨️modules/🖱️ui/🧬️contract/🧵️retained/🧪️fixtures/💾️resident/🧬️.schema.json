{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capacitySource",
    "capacitySchema",
    "pageBytes",
    "grant",
    "trace",
    "bytes",
    "cancelPrefixes",
    "invalidCapacities",
    "saturation",
    "forgedAccepted",
    "lostWriterRecovered",
    "operationRevocationPreservesAlias",
    "parentClosesRegisteredAlias",
    "earlyInstanceWitness"
  ],
  "properties": {
    "capacitySource": {
      "const": "../../💾️resident/🪪️metadata/🧪️fixture/🔣️.json#/compositionCapacity"
    },
    "capacitySchema": {
      "const": "semio.value.resident.capacity.v1"
    },
    "pageBytes": {
      "const": 256
    },
    "grant": {
      "const": {
        "maxItems": 1,
        "maxBytes": 4096
      }
    },
    "trace": {
      "const": [
        "reserve-first-page",
        "reserve-second-page",
        "admit-first-reader",
        "capture-first-alias",
        "retire-first-alias",
        "retire-first-page",
        "retire-first-payload",
        "retire-second-payload"
      ]
    },
    "bytes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "cancelPrefixes": {
      "const": [
        0,
        1,
        2,
        4,
        6,
        7
      ]
    },
    "invalidCapacities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object"
      }
    },
    "saturation": {
      "const": {
        "partition": "data",
        "controlRemainsAvailable": true,
        "externalUnsubmitted": true,
        "refusalChangesUsage": false
      }
    },
    "forgedAccepted": {
      "const": false
    },
    "lostWriterRecovered": {
      "const": true
    },
    "operationRevocationPreservesAlias": {
      "const": true
    },
    "parentClosesRegisteredAlias": {
      "const": true
    },
    "earlyInstanceWitness": {
      "const": false
    }
  }
}
