{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "parent", "child", "replacement", "expected", "laws"],
  "properties": {
    "version": { "const": 1 },
    "parent": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "child": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "replacement": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "text" }, "value": { "type": "string" } } },
    "expected": { "type": "object", "additionalProperties": false, "required": ["removedIds", "replacementId", "remainingIds"], "properties": { "removedIds": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } }, "replacementId": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "remainingIds": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } } } },
    "laws": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
