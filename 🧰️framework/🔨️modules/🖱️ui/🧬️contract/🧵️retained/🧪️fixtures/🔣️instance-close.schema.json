{
  "$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "additionalProperties": false,
  "required": ["childBytes", "surfaceReleaseBytes", "inputTokenBytes", "wireOwners", "lookupRefusals", "earlyWitness"],
  "properties": {
    "childBytes": { "const": 4096 }, "surfaceReleaseBytes": { "const": 1152 }, "inputTokenBytes": { "const": 128 },
    "wireOwners": { "type": "array", "items": { "enum": ["patch", "instance"] }, "minItems": 2, "maxItems": 2, "uniqueItems": true },
    "lookupRefusals": { "type": "array", "items": { "enum": ["blocked", "rejected"] }, "minItems": 2, "maxItems": 2, "uniqueItems": true },
    "earlyWitness": { "const": false }
  }
}
