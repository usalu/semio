    "childClose": {"type": "object", "additionalProperties": false, "required": ["issuedRoots", "readersPerRoot", "retirementSlots", "foreignTransfer", "detachedTransfer", "managedUnsubscribe"], "properties": {"issuedRoots": {"const": 2}, "readersPerRoot": {"const": 2}, "retirementSlots": {"const": 4}, "foreignTransfer": {"const": false}, "detachedTransfer": {"const": true}, "managedUnsubscribe": {"const": true}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["actor", "instance", "surface"], "properties": {"actor": {"type": "string"}, "instance": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "surface": {"type": "string"}}},
    "root": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
