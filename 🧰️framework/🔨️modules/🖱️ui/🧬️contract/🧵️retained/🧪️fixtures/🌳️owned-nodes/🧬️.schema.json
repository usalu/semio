{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "ids", "removed", "expectedReinsertedOrder", "oldBytes", "grants", "laws"],
  "properties": {
    "version": { "const": 1 },
    "ids": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
    "removed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expectedReinsertedOrder": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
    "oldBytes": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
    "grants": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["maxItems", "maxBytes"], "properties": { "maxItems": { "type": "integer", "minimum": 0 }, "maxBytes": { "type": "integer", "minimum": 0 } } } },
    "laws": { "type": "array", "minItems": 9, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
