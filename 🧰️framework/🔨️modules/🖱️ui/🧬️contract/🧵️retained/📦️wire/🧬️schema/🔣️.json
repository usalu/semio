            "add": {
              "const": 3
            },
            "modulo": {
              "const": 256
            }
          }
        },
        "invalidLengths": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4
        }
      }
    },
    "TypedFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "grant",
        "components",
        "defaults",
        "hostile",
        "lifecycle"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxItems",
            "maxBytes"
