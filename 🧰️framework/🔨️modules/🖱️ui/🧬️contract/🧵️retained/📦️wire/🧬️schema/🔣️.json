      "properties": {
        "maximumBytes": {
          "const": 32768
        },
        "pageBytes": {
          "const": 256
        },
        "lengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32768
          },
          "minItems": 7
