            "accessibility": {
              "type": "object"
            }
          }
        },
        "hostile": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object"
          }
        },
        "lifecycle": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cancel-before-decode",
              "cancel-during-value",
              "cancel-during-normalization",
              "cancel-after-byte-capture",
              "decoder-close-before-publication",
              "two-snapshot-readers",
              "older-reader-closes-last",
              "zero-grant-close"
