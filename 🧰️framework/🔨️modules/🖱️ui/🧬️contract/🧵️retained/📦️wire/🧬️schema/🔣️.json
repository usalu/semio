        "fieldNames": {
          "const": [
            "component",
            "layout",
            "style",
            "accessibility",
            "bindings",
            "menu",
            "children"
          ]
        },
        "node": {
          "type": "object"
        },
        "replacement": {
          "type": "object"
        },
        "repeat": {
          "const": 1024
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directFieldOwners",
            "ancestorOwners",
            "oldBytesAfterReplacement",
            "id",
            "component"
          ],
          "properties": {
            "directFieldOwners": {
              "const": 7
            },
            "ancestorOwners": {
              "const": 0
            },
            "oldBytesAfterReplacement": {
              "const": [
                3,
                7,
                11
              ]
            },
            "id": {
              "const": 9007199254740991
