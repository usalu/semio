{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/ui/contract/retained/wire/schema.json",
  "title": "Ui Contract Retained Wire Schema Module",
  "$defs": {
    "FieldsFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "fieldNames",
        "node",
        "replacement",
        "repeat",
        "expected",
        "laws"
      ],
      "properties": {
        "version": {
          "const": 1
