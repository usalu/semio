              "expected": {}
            }
          }
        },
        "hostile": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hex"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "hex": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})*$"
              }
            }
          }
        },
        "large": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows",
            "text",
            "repeat"
          ],
          "properties": {
            "rows": {
              "const": 128
            },
            "text": {
              "const": "😀ä\"\\"
            },
            "repeat": {
              "const": 48
            }
          }
        }
      }
