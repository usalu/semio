            "component": {
              "const": {
                "type": "text",
                "value": "Neu 😀",
                "emphasize": null,
                "dataAttributes": null
              }
            }
          }
        },
        "laws": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "old-reader-holds-replaced-bytes",
              "unchanged-field-allocation-identity",
              "fixed-seven-direct-fields",
              "cancelled-candidate-does-not-close-current",
              "last-reader-releases-old-bytes",
              "wrong-field-owner-rejected-before-move",
              "zero-grant-close-preserves-fields",
              "capabilities-cannot-be-shadowed",
              "capture-saturation-is-atomic"
            ]
          }
        }
      }
    },
    "DecodeFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeBounds",
        "vectors",
        "hostile",
        "large"
      ],
      "properties": {
        "nativeBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "textBytes",
            "collectionItems",
            "grantBytes"
