{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/ui/contract/number-controls.fixture.json",
  "title": "NumberControlsFixture",
  "description": "The shared number-control laws: slider detent validity, pointer resolution, page-key detent jumps, the keyboard law, fixed-precision formatting and rounding, and the validator's verdict on documents carrying them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "note", "validity", "pointer", "adjacent", "keys", "fixed", "valueTexts", "documents"],
  "$defs": {
    "case": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "snaps": { "type": "array", "maxItems": 32, "items": { "type": "number" } }
  },
  "properties": {
    "$schema": { "const": "./🧬️schema/🔣️.json" },
    "note": { "type": "string", "minLength": 1 },
    "validity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "min", "max", "snaps", "valid"],
        "properties": { "case": { "$ref": "#/$defs/case" }, "min": { "type": "number" }, "max": { "type": "number" }, "snaps": { "$ref": "#/$defs/snaps" }, "valid": { "type": "boolean" } }
      }
    },
    "pointer": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "value", "min", "max", "step", "snaps", "expected"],
        "properties": { "case": { "$ref": "#/$defs/case" }, "value": { "type": "number" }, "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number", "minimum": 0 }, "snaps": { "$ref": "#/$defs/snaps" }, "expected": { "type": "number" } }
      }
    },
    "adjacent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "current", "snaps", "forward", "expected"],
        "properties": { "case": { "$ref": "#/$defs/case" }, "current": { "type": "number" }, "snaps": { "$ref": "#/$defs/snaps" }, "forward": { "type": "boolean" }, "expected": { "type": ["number", "null"] } }
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "current", "min", "max", "step", "snaps", "key", "large", "expected"],
        "properties": { "case": { "$ref": "#/$defs/case" }, "current": { "type": "number" }, "min": { "type": ["number", "null"] }, "max": { "type": ["number", "null"] }, "step": { "type": "number" }, "snaps": { "$ref": "#/$defs/snaps" }, "key": { "enum": ["decrement", "increment", "pageDown", "pageUp", "home", "end"] }, "large": { "type": "boolean" }, "expected": { "type": "number" } }
      }
    },
    "fixed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "value", "precision", "expected", "rounded"],
        "properties": { "case": { "$ref": "#/$defs/case" }, "value": { "type": "number" }, "precision": { "type": "integer", "minimum": 0, "maximum": 65535 }, "expected": { "type": "string" }, "rounded": { "type": "number" } }
      }
    },
    "valueTexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "component", "valueText"],
        "properties": { "case": { "$ref": "#/$defs/case" }, "component": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["input", "numberStepper"] } } }, "valueText": { "type": "string" } }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "component", "violation"],
        "properties": {
          "case": { "$ref": "#/$defs/case" },
          "component": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["slider", "input", "numberStepper"] } } },
          "violation": { "enum": [null, "invalidSnaps"] }
        }
      }
    }
  }
}
