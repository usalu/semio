{
  "law": "A retained surface host is created once per window instance and survives every refresh. builtNodeToSnapshot mints UiNodeIds by pre-order DFS over the whole window body, so a refresh that grows the body ahead of a surface renumbers that surface; reconciliation must therefore key a sibling run on each node's AUTHORED key, never on the minted id, or the surface subtree is unmounted and rebuilt for a change that never touched it.",
  "measuredOn": "http://127.0.0.1:6018/?plugin=generation3d window:procedural-main, ticket 26/09/09/PROCEDURAL-3D-END-TO-END, 2026-09-12",
  "surface": "window:procedural-main",
  "surfaceKey": "procedural.play",
  "canvasKey": "procedural-play-main.canvas",
  "expected": {
    "surfaceHostMounts": 1,
    "surfaceAttaches": 1,
    "surfaceDomId": "window:procedural-main/procedural.play",
    "canvasDomId": "window:procedural-main/procedural-play-main.canvas",
    "surfaceReactKeyPath": ["k:procedural-play-main.canvas", "k:procedural.play"],
    "surfaceNodeIdByRefresh": [30, 34, 34, 30],
    "bodyNodeCountByRefresh": [30, 34, 34, 30]
  },
  "siblingKeyCases": [
    {
      "name": "authored-keys-win",
      "why": "Every sibling carries an authored key, so none of them is addressed by a number that renumbers.",
      "siblings": [{ "id": 2, "key": "procedural-play-graph" }, { "id": 29, "key": "procedural-play-main.canvas" }],
      "expected": ["k:procedural-play-graph", "k:procedural-play-main.canvas"]
    },
    {
      "name": "renumbered-siblings-keep-their-keys",
      "why": "The SAME two siblings one refresh later, renumbered by four inserted port rows upstream. The keys are byte-identical to the case above: that is the whole point.",
      "siblings": [{ "id": 2, "key": "procedural-play-graph" }, { "id": 33, "key": "procedural-play-main.canvas" }],
      "expected": ["k:procedural-play-graph", "k:procedural-play-main.canvas"]
    },
    {
      "name": "keyless-falls-back-to-the-minted-id",
      "why": "A keyless node has no stable identity to offer; the minted id is still sibling-unique, so reconciliation stays correct — only not stable.",
      "siblings": [{ "id": 7, "key": "" }, { "id": 8, "key": "" }],
      "expected": ["#7", "#8"]
    },
    {
      "name": "ambiguous-keys-fall-back-to-the-minted-id",
      "why": "React needs sibling-local uniqueness. Two siblings authoring one key would collide, so BOTH take the id — never one of each, which would silently reorder them against each other.",
      "siblings": [{ "id": 4, "key": "row" }, { "id": 5, "key": "row" }, { "id": 6, "key": "other" }],
      "expected": ["#4", "#5", "k:other"]
    },
    {
      "name": "a-key-never-collides-with-an-id-fallback",
      "why": "A node may author the literal key \"7\". Namespacing the two spellings keeps it off its keyless sibling's fallback.",
      "siblings": [{ "id": 3, "key": "7" }, { "id": 7, "key": "" }],
      "expected": ["k:7", "#7"]
    }
  ],
