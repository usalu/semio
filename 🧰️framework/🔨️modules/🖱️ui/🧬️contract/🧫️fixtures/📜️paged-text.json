          "children": [
            2,
            3
          ]
        },
        {
          "id": 3,
          "key": "p0-1",
          "children": [
            12
          ]
        },
        {
          "id": 2,
          "key": "p0-0",
          "children": [
            10,
            11
          ]
        },
        {
          "id": 12,
          "key": "c12",
          "text": {
            "value": "\"action\":\"setFillCount\"}}]}"
          },
          "children": []
        },
        {
          "id": 11,
          "key": "c11",
          "text": {
            "value": "0,\"onChange\":{\"controllerId\":\"puzzle3d\","
          },
          "children": []
        },
        {
          "id": 10,
          "key": "c10",
          "text": {
            "value": "{\"puzzle3d-main\":[{\"kind\":\"number\",\"id\":",
            "dataAttributes": {
