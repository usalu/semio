          "children": [
            5
          ]
        },
        {
          "id": 5,
          "key": "c5",
          "text": {
            "value": "{\"operators\":{}}"
          },
          "children": []
        }
      ],
      "expectedPayload": "{\"operators\":{}}"
    },
    {
      "name": "measures-two-pages-packed-attributes-reverse-insertion",
      "root": 1,
      "records": [
