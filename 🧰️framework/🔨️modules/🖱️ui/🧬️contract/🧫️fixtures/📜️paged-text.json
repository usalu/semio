        }
      ],
      "expectedPayload": "{\"puzzle3d-main\":[{\"kind\":\"number\",\"id\":\"puzzle3d-fill-count\",\"label\":\"Anzahl · Count\",\"value\":12.0,\"min\":0.0,\"step\":1.0,\"onChange\":{\"controllerId\":\"puzzle3d\",\"action\":\"setFillCount\"}}]}",
