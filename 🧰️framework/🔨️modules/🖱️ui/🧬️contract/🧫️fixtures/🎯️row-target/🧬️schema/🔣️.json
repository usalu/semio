{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/ui/contract/row-target.fixture.json",
  "title": "RowTargetFixture",
  "description": "One row target (scope, version, argument map, activation verb), the row-action verbs a tree row and a table row name on it, the binding every verb dispatches as — identical for both rows — or the typed refusal a disabled action answers, and the validator's verdict on rows whose verbs and target disagree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "target",
    "rowActions",
    "dispatch",
    "rows"
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "version"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "args": {
          "type": "object"
        },
        "activation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rowAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "icon",
        "label",
        "verb"
      ],
      "properties": {
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "verb": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "enum": [
            "row",
            "menu"
          ]
        },
        "disabled": {
          "type": "boolean",
          "description": "Painted and announced disabled; every host refuses its dispatch typed. Present only when true."
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "rowActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rowAction"
      }
    },
    "dispatch": {
      "description": "The ActionBinding each verb (activation first, then every row action in order) dispatches as, whichever row carries it — or the typed refusal a disabled row action answers.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verb"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "minLength": 1
          },
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trigger",
              "action"
            ],
            "properties": {
              "trigger": {
                "const": "activate"
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "name",
                  "version"
                ],
                "properties": {
                  "scope": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer"
                  }
                }
              },
              "args": {
                "type": "object"
              }
            }
          },
          "refusal": {
            "const": "disabled",
            "description": "The typed refusal a disabled row action answers instead of a binding."
          }
        },
        "oneOf": [
          {
            "required": [
              "binding"
            ]
          },
          {
            "required": [
              "refusal"
            ]
          }
        ]
      }
    },
    "rows": {
      "description": "Single-record documents: `component` is the row, `bindings` its record bindings, `violation` the validator's verdict (null = admitted).",
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "component",
          "bindings",
          "violation"
        ],
        "properties": {
          "case": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "treeItem",
                  "tableRow"
                ]
              }
            }
          },
          "bindings": {
            "type": "array"
          },
          "violation": {
            "enum": [
              null,
              "invalidRowTarget"
            ]
          }
        }
      }
    }
  }
}
