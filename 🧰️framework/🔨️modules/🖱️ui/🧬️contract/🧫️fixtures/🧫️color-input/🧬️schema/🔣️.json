{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/ui/contract/color-input.fixture.json",
  "title": "ColorInputFixture",
  "description": "The shared colour law of the color_input recipe: hex formatting of sRGB components and parsing of typed hex colours.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "note",
    "hex",
    "parse"
  ],
  "$defs": {
    "case": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  },
  "properties": {
    "$schema": {
      "const": "./🧬️schema/🔣️.json"
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "hex": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "rgba",
          "alpha",
          "expected"
        ],
        "properties": {
          "case": {
            "$ref": "#/$defs/case"
          },
          "rgba": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "alpha": {
            "type": "boolean"
          },
          "expected": {
            "type": "string",
            "pattern": "^#([0-9a-f]{6}|[0-9a-f]{8})$"
          }
        }
      }
    },
    "parse": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "text",
          "expected"
        ],
        "properties": {
          "case": {
            "$ref": "#/$defs/case"
          },
          "text": {
            "type": "string"
          },
          "expected": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            ]
          }
        }
      }
    }
  }
}
