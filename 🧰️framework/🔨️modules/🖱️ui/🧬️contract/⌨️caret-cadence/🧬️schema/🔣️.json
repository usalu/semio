{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["halfPeriodMs", "cases"],
  "properties": {
    "halfPeriodMs": { "type": "integer", "minimum": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event", "advanceMs", "visible", "armed"],
              "properties": {
                "event": { "enum": ["focus", "edit", "tick", "blur", "hide"] },
                "advanceMs": { "type": "integer", "minimum": 0 },
                "visible": { "type": "boolean" },
                "armed": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
