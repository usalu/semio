{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 6,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["items", "copyRows", "work", "rows"],
    "properties": {
      "items": {"type": "integer", "minimum": 0},
      "copyRows": {"type": "integer", "minimum": 0},
      "work": {"type": "integer", "minimum": 0},
      "rows": {"type": "integer", "minimum": 0, "maximum": 32}
    }
  }
}
