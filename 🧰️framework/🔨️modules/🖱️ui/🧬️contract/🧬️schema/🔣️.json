{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/ui/contract/schema.json",
  "title": "Ui Contract Schema Module",
  "$defs": {
    "ConformanceCatalogFixture": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "roles",
        "groups"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot",
            "expect",
            "patch"
          ],
          "properties": {
            "snapshot": {
              "const": "📸️snapshot.json"
            },
            "expect": {
              "const": "🎯️expect.json"
            },
            "patch": {
              "const": "🩹️patch.json"
            }
          }
        },
        "groups": {
          "type": "object",
          "minProperties": 6,
          "maxProperties": 6,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patch",
              "cases"
            ],
            "properties": {
              "patch": {
                "type": "boolean"
              },
              "cases": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 2,
                  "pattern": "^[^/\\\\.]+$"
                }
              }
            }
          }
        }
      }
    },
    "ContractFixture": {
      "x-semio-formats": [
        "🔣️jsonschema",
        "🦀️rust"
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "update",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "update": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "surface",
                  "nodeKey",
                  "own",
                  "ttlMs"
                ],
                "properties": {
                  "surface": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nodeKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "own": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "selected": {
                        "const": true
                      },
                      "hovered": {
                        "const": true
                      },
                      "previewed": {
                        "const": true
                      }
                    }
                  },
                  "ttlMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                }
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selected",
                  "hovered",
                  "previewed"
                ],
                "properties": {
                  "selected": {
                    "type": "boolean"
                  },
                  "hovered": {
                    "type": "boolean"
                  },
                  "previewed": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
