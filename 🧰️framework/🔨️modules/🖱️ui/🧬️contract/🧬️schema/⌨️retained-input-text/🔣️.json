{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retained Input Text V1",
  "description": "A semantic text Input with blur and keyboard commit. A retained value reference addresses a packed text carrier child. Long intent strings use the existing bounded UI value pages.",
  "definitions": {
    "bodyKey": {
      "type": "string",
      "pattern": "^framework\\.input\\.value\\.(0|[1-9][0-9]*)\\.[0-9a-f]{16}$",
      "description": "UTF-8 byte count and scene lane content digest."
    },
    "inline": {
      "type": "object",
      "properties": {
        "commit": {
          "const": "blurRetained"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "commit",
        "value"
      ]
    },
    "retained": {
      "type": "object",
      "properties": {
        "commit": {
          "const": "blurRetainedBody"
        },
        "value": {
          "$ref": "#/definitions/bodyKey"
        }
      },
      "required": [
        "commit",
        "value"
      ]
    },
    "intentPages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/definitions/inline"
    },
    {
      "$ref": "#/definitions/retained"
    }
  ]
}
