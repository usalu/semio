{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.dev/schema/ui/node-key/borrow/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "cases",
    "borrowedText",
    "copiedHeapBytes",
    "releasedHeapBytes"
  ],
  "properties": {
    "contract": {
      "const": "semio.ui.node-key.borrow.v1"
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owned",
          "borrowed",
          "matches"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "owned": {
            "$ref": "#/$defs/key"
          },
          "borrowed": {
            "$ref": "#/$defs/key"
          },
          "matches": {
            "type": "boolean"
          }
        }
      }
    },
    "borrowedText": {
      "const": "originalBacking"
    },
    "copiedHeapBytes": {
      "const": 0
    },
    "releasedHeapBytes": {
      "const": 0
    }
  },
  "$defs": {
    "key": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "explicit"
          ],
          "properties": {
            "explicit": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "positional"
          ],
          "properties": {
            "positional": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        }
      ]
    }
  }
}
