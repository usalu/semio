{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPU Animation Clock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "periodUs",
    "shaderPeriodsUs",
    "samples",
    "primitives",
    "activity"
  ],
  "properties": {
    "periodUs": {
      "const": 3200000
    },
    "shaderPeriodsUs": {
      "type": "array",
      "items": {
        "enum": [
          1600000,
          3200000
        ]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nowUs",
          "phaseUs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "nowUs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "phaseUs": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMaximum": 3200000
          }
        }
      }
    },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "draw",
          "overlay",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "draw": {
            "type": "array",
            "items": {
              "enum": [
                0,
                6,
                7,
                8,
                9
              ]
            }
          },
          "overlay": {
            "type": "array",
            "items": {
              "enum": [
                0,
                6,
                7,
                8,
                9
              ]
            }
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "activity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "atMs",
          "nextMs",
          "wake"
        ],
        "properties": {
          "kind": {
            "enum": [
              "tick",
              "present",
              "discard"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "atMs": {
            "type": "number",
            "minimum": 0
          },
          "nextMs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "wake": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
