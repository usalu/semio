{
  "name": "@semio-tech/ui-render-rs",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🖌️render/📮️packet/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "$schema": "../../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🖌️render/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "check-wasm": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🖌️render/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check-wasm"
      }
    },
    "boundaries": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "reads",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🖌️render/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts boundaries"
      },
      "outputs": []
    }
  }
}
