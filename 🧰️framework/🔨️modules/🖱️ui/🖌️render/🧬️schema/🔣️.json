{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/ui/render/schema.json",
  "title": "Ui Render Schema Module",
  "$defs": {
    "WebgpuSurfacePort": {
      "title": "Browser WebGPU Surface Port",
      "type": "object",
      "required": [
        "version",
        "operations",
        "hostStatuses",
        "lossReasons",
        "outcomes",
        "limits",
        "binary"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operations": {
          "const": {
            "create": 1825,
            "resize": 1826,
            "frame": 1827,
            "deviceLoss": 1828,
            "recover": 1829,
            "drop": 1830
          }
        },
        "hostStatuses": {
          "const": {
            "ready": 0,
            "missingCanvas": 1,
            "badCanvas": 2,
            "unsupportedAdapter": 3
          }
        },
        "lossReasons": {
          "const": {
            "surface": 1,
            "device": 2,
            "timeout": 3
          }
        },
        "outcomes": {
          "const": {
            "created": 1,
            "resized": 2,
            "frameAccepted": 3,
            "lost": 4,
            "recovered": 5,
            "dropped": 6,
            "cancelled": 7,
            "rejected": 8
          }
        },
        "limits": {
          "const": {
            "sessions": 8,
            "inFlightFrames": 4,
            "inFlightPages": 8,
            "inFlightControls": 8,
            "frameBytes": 4096,
            "outcomeBytes": 8192,
            "callbackWorkUnits": 64,
            "callbackMilliseconds": 8
          }
        },
        "binary": {
          "const": {
            "endianness": "little",
            "create": [
              "version:u8",
              "hostStatus:u8",
              "surface:u32",
              "canvas:u32",
              "generation:u32",
              "width:u32",
              "height:u32",
              "scaleFactor:f32"
            ],
            "resize": [
              "version:u8",
              "surface:u32",
              "generation:u32",
              "width:u32",
              "height:u32",
              "scaleFactor:f32"
            ],
            "frame": [
              "version:u8",
              "surface:u32",
              "generation:u32",
              "frame:u64",
              "bytes:u32+bytes"
            ],
            "deviceLoss": [
              "version:u8",
              "surface:u32",
              "generation:u32",
              "reason:u8"
            ],
            "recover": [
              "version:u8",
              "surface:u32",
              "generation:u32"
            ],
            "drop": [
              "version:u8",
              "surface:u32",
              "generation:u32"
            ],
            "outcomePage": [
              "version:u8",
              "outcome:u8",
              "request:u64",
              "surface:u32",
              "generation:u32",
              "detail:variant"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "SceneListTransferAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controllerId",
        "action",
        "args"
      ],
      "properties": {
        "controllerId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        }
      }
    },
    "SceneListTransferPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceId",
        "type",
        "id"
      ],
      "properties": {
        "surfaceId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "table-row",
            "step",
            "block",
            "palette",
            "label",
            "outside"
          ]
        },
        "id": {
          "type": "string"
        },
        "stepId": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "mime": {
          "type": "string"
        },
        "payload": {}
      }
    },
    "World3dEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambient",
        "sun",
        "material"
      ],
      "properties": {
        "ambient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intensity",
            "color"
          ],
          "properties": {
            "intensity": {
              "type": "number"
            },
            "color": {
              "type": "string"
            }
          }
        },
        "sun": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "azimuth",
            "elevation",
            "intensity",
            "color"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "azimuth": {
              "type": "number"
            },
            "elevation": {
              "type": "number"
            },
            "intensity": {
              "type": "number"
            },
            "color": {
              "type": "string"
            }
          }
        },
        "shadow": {
          "$ref": "#/$defs/World3dShadow"
        },
        "material": {
          "$ref": "#/$defs/World3dMaterial"
        }
      }
    },
    "World3dShadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "opacity",
        "softness"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "softness": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "World3dMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "metalness",
        "roughness",
        "emissive",
        "emissiveIntensity"
      ],
      "properties": {
        "color": {
          "type": "string"
        },
        "metalness": {
          "type": "number"
        },
        "roughness": {
          "type": "number"
        },
        "emissive": {
          "type": "string"
        },
        "emissiveIntensity": {
          "type": "number"
        }
      }
    },
    "World3dVec3": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "World3dVec2": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "World3dBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/World3dVec3"
        },
        "max": {
          "$ref": "#/$defs/World3dVec3"
        }
      }
    },
    "World3dMat4": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "number"
      }
    }
  }
}
