{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/framework/ui/viewport/2d",
  "title": "Viewport2d",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "x",
    "y",
    "zoom"
  ],
  "properties": {
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "zoom": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
