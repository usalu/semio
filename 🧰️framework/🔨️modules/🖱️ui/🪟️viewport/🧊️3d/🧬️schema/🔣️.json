{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/framework/ui/viewport/3d",
  "title": "Viewport3dOrbit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "position",
    "target",
    "zoom"
  ],
  "properties": {
    "position": {
      "$ref": "#/$defs/vector3"
    },
    "target": {
      "$ref": "#/$defs/vector3"
    },
    "zoom": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "up": {
      "$ref": "#/$defs/vector3"
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
