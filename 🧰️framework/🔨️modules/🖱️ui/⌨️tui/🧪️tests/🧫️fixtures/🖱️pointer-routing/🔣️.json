  "cases": [
    {
      "name": "a left press on an inactive chip activates that tab and focuses its window",
      "model": "chrome",
      "events": [
        {
          "t": "down",
          "b": "left",
          "x": 15,
          "y": 2
        }
      ],
      "signals": [
        "w1:WindowFocus",
        "w1:WindowTabActivated(1)"
      ],
      "focus": "w1.wizard",
      "hovered": null
    },
    {
      "name": "the close glyph of an inactive chip closes that chip and leaves focus alone",
      "model": "chrome",
      "events": [
        {
          "t": "down",
          "b": "left",
          "x": 21,
          "y": 2
        }
      ],
      "signals": [
        "w1:WindowClose(1)"
      ],
      "focus": null,
      "hovered": null
    },
    {
      "name": "the close glyph of the active chip names its own index",
      "model": "chrome",
      "events": [
        {
          "t": "down",
          "b": "left",
          "x": 10,
          "y": 2
        }
      ],
      "signals": [
        "w1:WindowClose(0)"
      ],
      "focus": null,
      "hovered": null
    },
    {
      "name": "right and middle presses on a close glyph do nothing",
