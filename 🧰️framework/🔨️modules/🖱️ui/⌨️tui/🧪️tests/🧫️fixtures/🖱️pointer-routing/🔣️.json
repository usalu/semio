        {
          "t": "up",
          "b": "right",
          "x": 21,
          "y": 2
        },
        {
          "t": "down",
          "b": "middle",
          "x": 21,
          "y": 2
        },
        {
          "t": "up",
          "b": "middle",
          "x": 21,
          "y": 2
        }
      ],
      "signals": [],
      "focus": null,
      "hovered": null
