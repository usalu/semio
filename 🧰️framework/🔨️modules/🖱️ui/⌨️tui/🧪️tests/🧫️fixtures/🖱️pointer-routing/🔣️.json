{
  "contract": {
    "onlyTheLeftButtonActivates": true,
    "everyControlCarriesItsTabIndex": true,
    "clickingFocusesTheContainingFocusable": true,
    "theWheelGoesToTheWidgetUnderThePointer": true,
    "dragsAreCapturedByWhatWasPressed": true,
    "hitTestingUsesTheGeometryThatIsPainted": true,
    "mountedGripsKeepControlColumnsStable": true,
    "cornerInsertionExcludesTheHeldSource": true,
    "windowDragsReportCanonicalDockIntents": true
  },
  "scene": {
    "size": [
      80,
      40
    ],
    "layout": {
      "kind": "row",
      "stacks": [
        {
          "active": "w1",
          "windows": [
            {
              "id": "w1",
              "title": "alpha"
            },
            {
              "id": "w3",
              "title": "beta"
            },
            {
              "id": "w4",
              "title": "gamma"
            }
          ]
        },
        {
          "active": "w2",
          "windows": [
            {
              "id": "w2",
              "title": "delta"
            }
          ]
        }
      ]
    },
    "widgets": {
      "w1": "wizard",
      "w2": "tabs"
    }
  },
  "frame": {
    "first": 1,
    "rows": [
      "┬───────────┬──────────┬───────────┬────┬───────────┬───────────────────────────",
      "│⠿alpha ⤢ ✕ │⠿beta ⤢ ✕ │⠿gamma ⤢ ✕ │    │⠿delta ⤢ ✕ │                           ",
      "│           └──────────┴───────────┴────┤           └──────────────────────────┐"
    ]
  },
  "windows": [
    {
      "window": "w1",
      "x": 0,
      "right": 40,
      "textRow": 2,
      "active": 0
    },
    {
      "window": "w2",
      "x": 40,
      "right": 79,
      "textRow": 2,
      "active": 0
    }
  ],
  "chips": [
    {
      "window": "w1",
      "index": 0,
      "corner": "top-left",
      "x": 0,
      "right": 12,
      "drag": 1,
      "maximize": 8,
      "close": 10
    },
    {
      "window": "w1",
      "index": 1,
      "corner": "top-left",
      "x": 12,
      "right": 23,
      "drag": 13,
      "maximize": 19,
