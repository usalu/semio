    {
      "window": "w2",
      "index": 0,
      "corner": "top-left",
      "x": 40,
      "right": 52,
      "drag": 41,
      "maximize": 48,
      "close": 50
    }
  ],
  "elision": [
    {
      "text": "short",
      "max": 10,
      "out": "short"
    },
    {
      "text": "a longer label",
      "max": 8,
      "out": "a longe…"
    },
    {
      "text": "anything",
      "max": 1,
      "out": "…"
    },
    {
      "text": "anything",
      "max": 0,
      "out": ""
    },
    {
      "text": "task number 11 with a long tail",
      "max": 18,
      "out": "task number 11 wi…"
    },
    {
      "text": "日本語のタスク名",
      "max": 7,
      "out": "日本語…"
    },
    {
      "text": "日本語のタスク名",
      "max": 16,
      "out": "日本語のタスク名"
    }
