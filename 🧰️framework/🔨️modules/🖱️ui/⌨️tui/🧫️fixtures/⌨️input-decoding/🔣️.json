  "grammar": {
    "key": "key:<name>[+ctrl][+alt][+shift]; <name> is the character itself, Space, Plus, or Enter Esc Tab BackTab Backspace Delete Insert Up Down Left Right Home End PageUp PageDown F1..F20, or Keypad0..Keypad9 KeypadEnter KeypadPlus KeypadMinus KeypadMultiply KeypadDivide KeypadDecimal KeypadEqual KeypadSeparator",
    "mouse": "mouse:<down|up|drag>:<left|middle|right>@<x>,<y>#<clicks>[mods] | mouse:move@<x>,<y>#<clicks>[mods] | mouse:scroll:<dx>,<dy>@<x>,<y>#<clicks>[mods]",
    "paste": "paste:<text>",
    "focus": "focus:gained | focus:lost"
  },
  "decoding": [
