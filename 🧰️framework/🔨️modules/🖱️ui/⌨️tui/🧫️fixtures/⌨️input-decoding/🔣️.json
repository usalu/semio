    { "id": "arrow-modifiers", "input": "\u001b[1;5C\u001b[1;2A\u001b[1;3D\u001b[1;6B", "events": ["key:Right+ctrl", "key:Up+shift", "key:Left+alt", "key:Down+ctrl+shift"], "oracle": ["readline"] },
