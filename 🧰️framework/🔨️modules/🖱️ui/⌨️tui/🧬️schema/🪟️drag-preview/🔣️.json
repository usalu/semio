{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handle",
    "preview",
    "scope",
    "overflowPriority",
    "cases",
    "mountScope"
  ],
  "properties": {
    "handle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unicode",
        "ascii",
        "paddingColumn"
      ],
      "properties": {
        "unicode": {
          "const": "⠿"
        },
        "ascii": {
          "const": ":"
        },
        "paddingColumn": {
          "const": 1
        }
      }
    },
    "preview": {
      "const": "committed-active-tab-and-seam"
    },
    "scope": {
      "const": "mounted-canvas-node-identities"
    },
    "overflowPriority": {
      "const": [
        "counted",
        "glyph",
        "one-glyph",
        "active-controls"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "weights",
          "sourcePeer",
          "sameStack",
          "compact",
          "placement"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "weights": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "sourcePeer": {
            "type": "boolean"
          },
          "sameStack": {
            "type": "boolean"
          },
          "compact": {
            "type": "boolean"
          },
          "overflow": {
            "type": "boolean"
          },
          "cap": {
            "type": "boolean"
          },
          "placement": {
            "enum": [
              "top-left",
              "top-right",
              "bottom-left",
              "bottom-right",
              "left",
              "right",
              "top",
              "bottom",
              "reorder",
              "overflow-next"
            ]
          }
        }
      }
    },
    "mountScope": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "firstKnown",
          "secondKnown",
          "canvasAlive",
          "matched"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "firstKnown": {
            "type": "boolean"
          },
          "secondKnown": {
            "type": "boolean"
          },
          "canvasAlive": {
            "type": "boolean"
          },
          "matched": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
