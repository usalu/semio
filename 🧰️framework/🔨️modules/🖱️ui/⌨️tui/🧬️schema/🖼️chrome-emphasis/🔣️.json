{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["size", "labels", "cases", "corners", "ancestorTransitions"],
  "additionalProperties": false,
  "properties": {
    "size": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } },
    "labels": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["active", "hover", "roles"],
        "additionalProperties": false,
        "properties": {
          "active": { "type": "integer", "minimum": 0 },
          "hover": { "type": ["integer", "null"], "minimum": 0 },
          "roles": { "type": "array", "items": { "enum": ["active", "normal", "emphasized"] } }
        }
      }
    },
    "corners": { "type": "array", "items": { "enum": ["top-left", "top-right", "bottom-left", "bottom-right"] } },
    "ancestorTransitions": { "type": "array", "items": { "type": "string" } }
  }
}
