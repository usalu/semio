{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio://framework/ui/render/metal/objc2-runtime-abi/1",
  "title": "Owned Objective-C Runtime ABI Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "oracle", "layout", "ownership", "boundaries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "owned-objective-c-runtime" },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version"],
      "properties": {
        "package": { "const": "objc2" },
        "version": { "const": "0.6.4" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownedBytes", "ownedAlign", "optionalOwnedBytes"],
      "properties": {
        "ownedBytes": { "const": 8 },
        "ownedAlign": { "const": 8 },
        "optionalOwnedBytes": { "const": 8 }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloneRetainDelta", "dropRestores", "nullOwnedAccepted", "autoreleasePoolDrained"],
      "properties": {
        "cloneRetainDelta": { "const": 1 },
        "dropRestores": { "const": true },
        "nullOwnedAccepted": { "const": false },
        "autoreleasePoolDrained": { "const": true }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["empty", "single", "maximum", "maximumPlusOne", "hostileNull"],
      "properties": {
        "empty": { "const": "accepted" },
        "single": { "const": "accepted" },
        "maximum": { "const": 4096 },
        "maximumPlusOne": { "const": "rejected" },
        "hostileNull": { "const": "rejected" }
      }
    }
  }
}
