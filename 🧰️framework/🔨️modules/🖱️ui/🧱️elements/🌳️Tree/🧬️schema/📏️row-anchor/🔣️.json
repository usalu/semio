{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inheritedRowPx", "uiSpacingPx", "indentPx", "togglePx", "cases", "directions"],
  "properties": {
    "version": { "const": 1 },
    "inheritedRowPx": { "const": 24 },
    "uiSpacingPx": { "const": 3.2 },
    "indentPx": { "const": 10 },
    "togglePx": { "const": 14 },
    "directions": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["down", "up"] } },
    "cases": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "workbenchPx", "rowPx", "centerPx", "expectedPx"],
        "properties": {
          "id": { "enum": ["inherited-row", "custom-row", "custom-center"] },
          "workbenchPx": { "type": "number", "exclusiveMinimum": 0 },
          "rowPx": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "centerPx": { "type": ["number", "null"], "minimum": 0 },
          "expectedPx": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
