{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "root",
    "flows",
    "labels"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "rowInline"],
      "properties": {
        "direction": { "const": "auto" },
        "rowInline": { "const": "ltr" }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "enum": [
          "ltr",
          "rtl"
        ]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "labels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "locale",
          "text",
          "visual"
        ],
        "additionalProperties": false,
        "properties": {
          "locale": {
            "enum": [
              "en",
              "de"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
