{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "bodyTop",
          "surfaceTop",
          "chromeBottom",
          "edgeless",
          "overlay",
          "scrollTop",
          "inset"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bodyTop": {
            "type": "number"
          },
          "surfaceTop": {
            "type": "number"
          },
          "chromeBottom": {
            "type": "number"
          },
          "edgeless": {
            "type": "boolean"
          },
          "overlay": {
            "type": "boolean"
          },
          "scrollTop": {
            "type": "number",
            "minimum": 0
          },
          "inset": {
            "type": "number",
            "minimum": 0
          },
          "nestedEdgeless": {
            "type": "boolean"
          },
          "nestedChromeBottom": {
            "type": "number"
          },
          "nestedScroller": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
