{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["version", "cases"],
  "properties": {
    "version": { "const": 1 },
    "cases": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "clicks", "actions", "search"],
        "properties": {
          "id": { "enum": ["folded", "actions-only", "search-only", "both", "close-actions", "close-search"] },
          "clicks": { "type": "array", "maxItems": 3, "items": { "enum": ["engagement", "search"] } },
          "actions": { "type": "boolean" }, "search": { "type": "boolean" }
        }
      }
    }
  }
}
