{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["cases"], "additionalProperties": false,
  "properties": { "cases": { "type": "array", "items": {
    "type": "object", "required": ["name", "rectangles", "point", "expected"], "additionalProperties": false,
    "properties": {
      "name": { "type": "string" },
      "rectangles": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 6, "maxItems": 6 } },
      "point": { "$ref": "#/$defs/point" }, "expected": { "$ref": "#/$defs/point" }
    }
  } } },
  "$defs": { "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } }
}
