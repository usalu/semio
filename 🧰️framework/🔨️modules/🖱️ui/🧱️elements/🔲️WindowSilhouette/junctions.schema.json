    "properties": {
      "name": { "type": "string" },
      "rectangles": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 6, "maxItems": 6 } },
      "point": { "$ref": "#/$defs/point" }, "expected": { "$ref": "#/$defs/point" }
    }
  } }, "paintSpans": { "type": "array", "items": {
    "type": "object", "required": ["name", "horizontal", "centerline", "from", "to", "expected"], "additionalProperties": false,
    "properties": {
      "name": { "type": "string" }, "horizontal": { "type": "boolean" }, "centerline": { "type": "number" },
      "from": { "$ref": "#/$defs/point" }, "to": { "$ref": "#/$defs/point" }, "expected": { "type": "array", "items": { "$ref": "#/$defs/point" } }
