{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Silhouette Chip Span Cases",
  "type": "object",
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "silhouette-chip-span/v1" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "width", "height", "depth", "chips", "outline", "paint"],
        "properties": {
          "name": { "type": "string" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "depth": { "type": "number" },
          "chips": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
          "outline": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
          "paint": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
