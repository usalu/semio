{
  "$schema": "./chip-abut.schema.json",
  "cases": [
    { "name": "title chip and controls with an open gap of 120 px keep the gap", "chips": [ { "left": 0, "right": 200, "natural": 200, "reach": "next" }, { "left": 320, "right": 420, "natural": 100, "reach": "none" } ], "expected": [false, false] },
    { "name": "a gap of exactly 40 px stays open", "chips": [ { "left": 0, "right": 200, "natural": 200, "reach": "next" }, { "left": 240, "right": 340, "natural": 100, "reach": "none" } ], "expected": [false, false] },
    { "name": "a gap of 39.79 px makes the title chip reach the controls", "chips": [ { "left": 0, "right": 200, "natural": 200, "reach": "next" }, { "left": 239.79, "right": 340, "natural": 100, "reach": "none" } ], "expected": [true, false] },
    { "name": "an abutting pair is left alone", "chips": [ { "left": 0, "right": 200, "natural": 200, "reach": "next" }, { "left": 200, "right": 300, "natural": 100, "reach": "none" } ], "expected": [false, false] },
    { "name": "a reaching chip already grown over a sliver is measured by its natural width and stays grown", "chips": [ { "left": 0, "right": 239.79, "natural": 200, "reach": "next" }, { "left": 239.79, "right": 340, "natural": 100, "reach": "none" } ], "expected": [true, false] },
    { "name": "a reaching chip grown over room reopens the gap", "chips": [ { "left": 0, "right": 300, "natural": 200, "reach": "next" }, { "left": 300, "right": 400, "natural": 100, "reach": "none" } ], "expected": [false, false] },
    { "name": "footer right chip with room to the centre chip keeps the gap", "chips": [ { "left": 0, "right": 100, "natural": 100, "reach": "next" }, { "left": 200, "right": 300, "natural": 100, "reach": "none" }, { "left": 320, "right": 500, "natural": 150, "reach": "prev" } ], "expected": [false, false, false] },
    { "name": "footer right chip with a sliver to the centre chip stretches", "chips": [ { "left": 150, "right": 250, "natural": 100, "reach": "none" }, { "left": 250, "right": 500, "natural": 220, "reach": "prev" } ], "expected": [false, true] },
    { "name": "pane chips: a sliver between the middle and the right-anchored chip stretches the right one", "chips": [ { "left": 0, "right": 75, "natural": 75, "reach": "next" }, { "left": 156, "right": 228, "natural": 72, "reach": "none" }, { "left": 266, "right": 384, "natural": 118, "reach": "prev" } ], "expected": [false, false, true] },
    { "name": "pane chips: a sliver between the left-anchored and the middle chip stretches the left one", "chips": [ { "left": 0, "right": 75, "natural": 75, "reach": "next" }, { "left": 100, "right": 172, "natural": 72, "reach": "none" }, { "left": 300, "right": 384, "natural": 84, "reach": "prev" } ], "expected": [true, false, false] },
    { "name": "chips that cannot reach stay open", "chips": [ { "left": 0, "right": 200, "natural": 200, "reach": "none" }, { "left": 230, "right": 330, "natural": 100, "reach": "none" } ], "expected": [false, false] }
  ]
}
