{
  "$schema": "./bands.schema.json",
  "cases": [
    { "name": "no footer above: the cap row starts on the bottom line", "cards": [ { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [] }, { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 90 }], "footerChips": [] } ], "expected": [{ "mode": "none", "lift": 0, "cap": 0, "footer": 0 }] },
    { "name": "right footer chip and left title chip share one band", "cards": [ { "cap": 28, "footer": 28, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [{ "left": 300, "right": 400 }] }, { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 90 }], "footerChips": [] } ], "expected": [{ "mode": "shared", "lift": 28, "cap": 28, "footer": 28 }] },
    { "name": "a taller footer chip grows the band for both rows", "cards": [ { "cap": 28, "footer": 52, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [{ "left": 300, "right": 400 }] }, { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 90 }], "footerChips": [] } ], "expected": [{ "mode": "shared", "lift": 52, "cap": 52, "footer": 52 }] },
    { "name": "a taller title chip grows the band for both rows", "cards": [ { "cap": 28, "footer": 28, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [{ "left": 300, "right": 400 }] }, { "cap": 56, "footer": 0, "capChips": [{ "left": 0, "right": 90 }], "footerChips": [] } ], "expected": [{ "mode": "shared", "lift": 56, "cap": 56, "footer": 56 }] },
    { "name": "chips that would collide are stacked in two bands", "cards": [ { "cap": 28, "footer": 28, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [{ "left": 60, "right": 400 }] }, { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [] } ], "expected": [{ "mode": "stacked", "lift": 0, "cap": 0, "footer": 0 }] },
    { "name": "a left footer chip always collides with the left title chip", "cards": [ { "cap": 28, "footer": 28, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [{ "left": 0, "right": 80 }] }, { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 90 }], "footerChips": [] } ], "expected": [{ "mode": "stacked", "lift": 0, "cap": 0, "footer": 0 }] },
    { "name": "chips a few pixels apart are stacked, not left with a gap", "cards": [ { "cap": 28, "footer": 28, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [{ "left": 124, "right": 400 }] }, { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [] } ], "expected": [{ "mode": "stacked", "lift": 0, "cap": 0, "footer": 0 }] },
    { "name": "chips 40 px apart or more stay in one band", "cards": [ { "cap": 28, "footer": 28, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [{ "left": 160, "right": 400 }] }, { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 120 }], "footerChips": [] } ], "expected": [{ "mode": "shared", "lift": 28, "cap": 28, "footer": 28 }] },
    { "name": "touching chips do not collide", "cards": [ { "cap": 28, "footer": 28, "capChips": [], "footerChips": [{ "left": 100, "right": 400 }] }, { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 100 }], "footerChips": [] } ], "expected": [{ "mode": "shared", "lift": 28, "cap": 28, "footer": 28 }] },
    { "name": "three cards: each pair is resolved on its own", "cards": [ { "cap": 28, "footer": 28, "capChips": [{ "left": 0, "right": 100 }], "footerChips": [{ "left": 300, "right": 400 }] }, { "cap": 28, "footer": 0, "capChips": [{ "left": 0, "right": 100 }], "footerChips": [] }, { "cap": 28, "footer": 28, "capChips": [{ "left": 0, "right": 100 }], "footerChips": [{ "left": 0, "right": 100 }] } ], "expected": [{ "mode": "shared", "lift": 28, "cap": 28, "footer": 28 }, { "mode": "none", "lift": 0, "cap": 0, "footer": 0 }] },
    { "name": "a single card has no pair", "cards": [ { "cap": 28, "footer": 28, "capChips": [{ "left": 0, "right": 100 }], "footerChips": [{ "left": 300, "right": 400 }] } ], "expected": [] }
  ]
}
