{
  "name": "@semio-tech/ui-locale-rs",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/⏳️async/✨️macros/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "$schema": "../../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain",
        "{projectRoot}/../../**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎚️axes/**/*"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🌐️locale/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-retirement": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain",
        "{projectRoot}/../../**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎚️axes/**/*"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🌐️locale/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test retirement"
      }
    }
  },
  "tags": [
    "scope:framework"
  ]
}
