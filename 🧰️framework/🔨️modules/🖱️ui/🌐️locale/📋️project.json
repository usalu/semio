{
  "name": "@semio-tech/ui-locale",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test-contract": {
      "executor": "repo:script",
      "options": {
        "command": "repo ./📜️script.ts test contract",
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🌐️locale",
        "forwardAllArgs": true
      },
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "{projectRoot}/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎚️axes/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/**/*",
        "sharedGlobals"
      ],
      "outputs": []
    },
    "check-types": {
      "executor": "repo:script",
      "options": {
        "command": "repo ./📜️script.ts check types",
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🌐️locale",
        "forwardAllArgs": true
      },
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎚️axes/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/**/*",
        "sharedGlobals"
      ],
      "outputs": []
    }
  }
}
