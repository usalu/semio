      },
      "expected": {
        "native": {
          "en": "Rename layer \"roof\" to \"deck\"",
          "de": "Ebene \"roof\" in \"deck\" umbenennen"
        },
        "reuse": {
          "en": "Rename layer \"roof\" to \"deck\"",
          "de": "Ebene \"roof\" in \"deck\" umbenennen"
        }
      }
    },
    {
