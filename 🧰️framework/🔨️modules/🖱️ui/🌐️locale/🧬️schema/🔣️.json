        "axisProjection": "🧰️framework/🔨️modules/🖱️ui/🎚️axes/📽️projection/🟦️.ts",
        "wireTest": "🧰️framework/🔨️modules/🖱️ui/🧪️tests/🔬️targets-wgpu-component-ui-ui-node-wire-format/🦀️.rs",
        "oldLocaleSource": "🧰️framework/🛍️products/💻️os/🔨️modules/🌐️locale/🦀️.rs",
        "localeManifest": "🧰️framework/🔨️modules/🖱️ui/🌐️locale/📦️packages/🦀️rust/Cargo.toml",
        "localeSource": "🧰️framework/🔨️modules/🖱️ui/🌐️locale/🦀️.rs",
        "kernelRoot": "🧰️framework/🛍️products/💻️os/📦️packages/🦀️rust/🦀️.rs",
        "pluginSource": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🦀️.rs",
        "package": "semio-framework-ui-locale",
        "forbidden": "semio-framework-os-kernel",
        "viewport": "semio_framework_ui_viewport::Viewport2d",
        "localeAuthority": "explicit"
