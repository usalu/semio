{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "maximumBytes",
    "maximumDepth",
    "maximumItems",
    "copyBudgets",
    "cancelAt",
    "source",
    "refusal"
  ],
  "properties": {
    "contract": {
      "const": "framework.ui.scene.draft-wire"
    },
    "maximumBytes": {
      "const": 1024
    },
    "maximumDepth": {
      "const": 3
    },
    "maximumItems": {
      "const": 64
    },
    "copyBudgets": {
      "const": [
        0,
        1,
        3,
        64
      ]
    },
    "cancelAt": {
      "const": [
        0,
        1,
        3,
        9
      ]
    },
    "source": {
      "const": "originalTextSpliceDraftJson"
    },
    "refusal": {
      "const": "retainAcceptedPrefixAndOriginalSource"
    }
  }
}
