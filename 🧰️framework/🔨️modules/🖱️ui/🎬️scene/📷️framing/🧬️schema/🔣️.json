{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.canvas2d.framing",
  "title": "Canvas Framing Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "bounds",
    "padding"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "padding": {
      "type": "number",
      "minimum": 0
    }
  }
}
