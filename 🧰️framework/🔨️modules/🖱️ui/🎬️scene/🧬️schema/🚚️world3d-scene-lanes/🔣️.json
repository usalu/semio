{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showGrid": { "type": "boolean", "default": true },
        "showGizmo": { "type": "boolean", "default": true },
        "interactive": { "type": "boolean", "default": true },
        "viewportMask": { "enum": ["rectangle", "ellipse"], "default": "rectangle" },
        "clear": { "enum": ["theme", "transparent"], "default": "theme" },
        "sourceAspect": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "field", "bodyKey", "optional"],
      "properties": {
        "lane": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "bodyKey": { "type": "string", "pattern": "^framework\\.scene\\.world3d\\." },
        "optional": { "type": "boolean" }
      }
    }
  },
  "type": "object",
  "required": ["schema", "laneKeyPrefix", "spineFields", "carrier", "lanes", "presentation", "roundTrip", "paging"],
  "properties": {
    "$comment": { "type": "string" },
    "schema": { "const": "world-3d@1" },
    "laneKeyPrefix": { "const": "framework.scene.world3d." },
    "spineFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "carrier": { "type": "object" },
    "lanes": { "type": "array", "minItems": 22, "maxItems": 22, "items": { "$ref": "#/$defs/lane" } },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults", "icon", "rejections"],
      "properties": {
        "$comment": { "type": "string" },
        "defaults": { "$ref": "#/$defs/presentation" },
        "icon": { "$ref": "#/$defs/presentation" },
        "rejections": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "roundTrip": { "type": "object" },
    "paging": { "type": "object" }
  },
  "additionalProperties": false
}
