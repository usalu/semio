{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.ui.scene.block-list.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "palette": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/palette"
      }
    },
    "selectedId": {
      "type": "string"
    },
    "draggingId": {
      "type": "string"
    },
    "domainId": {
      "type": "string"
    }
  },
  "required": [
    "steps",
    "palette"
  ],
  "definitions": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "granularity": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "granularity",
        "id"
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "target": {
          "$ref": "#/definitions/target"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/block"
          }
        },
        "target": {
          "$ref": "#/definitions/target"
        }
      },
      "required": [
        "id",
        "title",
        "blocks"
      ]
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockKind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "iconId": {
          "type": "string"
        }
      },
      "required": [
        "blockKind",
        "label",
        "iconId"
      ]
    }
  }
}
