{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original Mesh Component Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "references", "cases", "invalidLabels"],
  "properties": {
    "schema": {"const": "ui.mesh-component-source.v1"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["handle", "revision"],
      "properties": {"handle": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "references": {
      "type": "object", "additionalProperties": false, "required": ["face", "edge", "vertex"],
      "properties": {"face": {"$ref": "#/$defs/labels"}, "edge": {"$ref": "#/$defs/labels"}, "vertex": {"$ref": "#/$defs/labels"}}
    },
    "cases": {
      "type": "array", "minItems": 4,
      "items": {"type": "object", "additionalProperties": false, "required": ["kind", "group", "label"], "properties": {"kind": {"enum": ["face", "edge", "vertex"]}, "group": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "label": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}}}
    },
    "invalidLabels": {"type": "array", "minItems": 5, "items": {"type": "string"}}
  },
  "$defs": {"labels": {"type": "array", "items": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}}}
}
