{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.ui.scene.text-splice.v1",
  "title": "Range-text operations (text splices) and their language-neutral vectors",
  "type": "object",
  "required": [
    "schema",
    "contextScalars",
    "minTwoSidedScalars",
    "edits",
    "applications",
    "concurrent",
    "rebases",
    "offsets",
    "hostTyping",
    "compositions",
    "typingRuns",
    "hostSignals"
  ],
  "additionalProperties": false,
  "definitions": {
    "splice": {
      "type": "object",
      "required": [
        "start",
        "deleted",
        "insert",
        "before",
        "after"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "string"
        },
        "insert": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "located": {
      "type": "object",
      "required": [
        "start",
        "deleteLength",
        "clamped"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "deleteLength": {
          "type": "integer",
          "minimum": 0
        },
        "clamped": {
          "type": "boolean"
        }
      }
    },
    "typing": {
      "$comment": "TextEditorTypingV1 — `settingsJson.typing` of a text editor scene whose window takes `textSplice`.",
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "splice"
        }
      }
    },
    "selectionEcho": {
      "$comment": "`selectionJson` of such a scene: the selection plus the last host splice `seq` the window applied.",
      "type": "object",
      "required": [
        "start",
        "end",
        "splice"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "splice": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "view": {
      "$comment": "What a splice-typing host's editor shows after a scene or a refusal (scalar selection), or null when it already shows it.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "text",
            "anchor",
            "caret"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "anchor": {
              "type": "integer",
              "minimum": 0
            },
            "caret": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "composition": {
      "$comment": "How a typed splice joins its run (TextSplice::then / composeTextSplicesV1): the net splice, a run that changed nothing, or a caret that jumped away.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "splice"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "composed"
            },
            "splice": {
              "$ref": "#/definitions/splice"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "cancelled",
                "disjoint"
              ]
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema": {
      "const": "semio.ui.scene.text-splice.v1"
    },
    "contextScalars": {
      "const": 32
    },
    "minTwoSidedScalars": {
      "const": 4
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "previous",
          "next",
          "splice"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "previous": {
            "type": "string"
          },
          "next": {
            "type": "string"
          },
          "splice": {
            "oneOf": [
              {
                "$ref": "#/definitions/splice"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "note",
          "text",
          "splice",
          "located",
          "result",
          "inverse"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "splice": {
            "$ref": "#/definitions/splice"
          },
          "located": {
            "$ref": "#/definitions/located"
          },
          "result": {
            "type": "string"
          },
          "inverse": {
            "$ref": "#/definitions/splice"
          }
        }
      }
    },
    "concurrent": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "note",
          "base",
          "order",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "order": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "author",
                "splice"
              ],
              "additionalProperties": false,
              "properties": {
                "author": {
                  "type": "string"
                },
                "splice": {
                  "$ref": "#/definitions/splice"
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "required": [
              "text",
              "clamped",
              "runs"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "clamped": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "runs": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "rebases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "note",
          "remote",
          "unapplied",
          "local",
          "selection",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "remote": {
            "type": "string"
          },
          "unapplied": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/splice"
            }
          },
          "local": {
            "type": "string"
          },
          "selection": {
            "type": "object",
            "required": [
              "anchor",
              "caret"
            ],
            "additionalProperties": false,
            "properties": {
              "anchor": {
                "type": "integer",
                "minimum": 0
              },
              "caret": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "expected": {
            "type": "object",
            "required": [
              "text",
              "anchor",
              "caret"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "anchor": {
                "type": "integer",
                "minimum": 0
              },
              "caret": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "offsets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "utf8",
          "scalar"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "utf8": {
            "type": "integer",
            "minimum": 0
          },
          "scalar": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "hostTyping": {
      "$comment": "A splice-typing host over one window (TS reference: textEditorSpliceHostV1 / sendTextEditorSpliceV1 / receiveTextEditorSceneV1 / refuseTextEditorSpliceV1): `local` = the editor now shows this text with a collapsed caret; `send` = the ONE splice the host sends for everything typed since its last send, numbered `seq`; `scene` = the window published this text having applied the host's splices up to `applied` (below an earlier `applied`: a reincarnated window, the document reopened); `refuse` = the window refused splice `refuse`. `show` is what the editor shows afterwards (null: unchanged), `unapplied` the sequence numbers still in flight.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "note",
          "init",
          "events"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "init": {
            "type": "object",
            "required": [
              "buffer",
              "applied"
            ],
            "additionalProperties": false,
            "properties": {
              "buffer": {
                "type": "string"
              },
              "applied": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "local",
                    "caret"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "local": {
                      "type": "string"
                    },
                    "caret": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "send"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "send": {
                      "type": "object",
                      "required": [
                        "seq",
                        "splice"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "seq": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "splice": {
                          "$ref": "#/definitions/splice"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "scene",
                    "applied",
                    "show",
                    "unapplied"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "scene": {
                      "type": "string"
                    },
                    "applied": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "show": {
                      "$ref": "#/definitions/view"
                    },
                    "unapplied": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "refuse",
                    "show",
                    "unapplied"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "refuse": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "show": {
                      "$ref": "#/definitions/view"
                    },
                    "unapplied": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "settle",
                    "unapplied"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "settle": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "unapplied": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "compositions": {
      "$comment": "net takes text T0 to T1, next takes T1 to T2 (same author); a composed splice is textSpliceFromEditV1(T0, T2).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "note",
          "text",
          "net",
          "next",
          "composition"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "net": {
            "$ref": "#/definitions/splice"
          },
          "next": {
            "$ref": "#/definitions/splice"
          },
          "composition": {
            "$ref": "#/definitions/composition"
          }
        }
      }
    },
    "typingRuns": {
      "$comment": "One author typing through texts[0..]: folding the textSpliceFromEditV1 of every consecutive pair with composition yields exactly runs (a disjoint edit starts a new run, a cancelled run leaves none).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "note",
          "texts",
          "runs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "texts": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/splice"
            }
          }
        }
      }
    },
    "hostSignals": {
      "$comment": "How a text-editor host ends its typing run (design §13.2 of ticket 26/09/30/NON-DESTRUCTIVE-HISTORY-EDITING): every host maps each signal to exactly this `typingCommit` reason, and every signal appears once.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "signal",
          "commit",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "signal": {
            "enum": [
              "idle",
              "caretMove",
              "blur",
              "hidden"
            ]
          },
          "commit": {
            "enum": [
              "idle",
              "selectionJump",
              "blur",
              "enter",
              "hidden",
              "apply",
              "otherVerb"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
