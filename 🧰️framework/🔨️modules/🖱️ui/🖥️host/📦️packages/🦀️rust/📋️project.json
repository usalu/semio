{
  "name": "@semio-tech/ui-host-rs",
  "$schema": "../../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🔨️modules/🖱️ui/🖥️host/📦️packages/🦀️rust",
  "projectType": "library",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🖥️host/**/*",
      "sharedGlobals"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ],
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ]
  },
  "targets": {
    "test-source": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🖥️host/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test source",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "test": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🖥️host/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "check": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "cargoToolchain"
      ],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🖥️host/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "check-wasm": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "cargoToolchain"
      ],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🖥️host/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check-wasm",
        "forwardAllArgs": true
      },
      "outputs": []
    }
  }
}
