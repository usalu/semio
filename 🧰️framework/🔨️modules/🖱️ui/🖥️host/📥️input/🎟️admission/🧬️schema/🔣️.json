{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schemas/ui-host/input-admission-fixture.json",
  "title": "UI Host Input Admission Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "limits",
    "ownedEvent",
    "physicalRetirement",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclusiveCallbackCeilingUs",
        "discreteEvents",
        "discreteLogicalBytes",
        "eventLogicalBytes",
        "runtimeCompletions"
      ],
      "properties": {
        "exclusiveCallbackCeilingUs": {
          "const": 8000
        },
        "discreteEvents": {
          "const": 256
        },
        "discreteLogicalBytes": {
          "const": 1048576
        },
        "eventLogicalBytes": {
          "const": 4096
        },
        "runtimeCompletions": {
          "const": 128
        }
      }
    },
    "ownedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "utf8Hex"
      ],
      "properties": {
        "text": {
          "const": "a\u0000é🧪"
        },
        "utf8Hex": {
          "const": "6100c3a9f09fa7aa"
        }
      }
    },
    "physicalRetirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialQueueBackingBytes", "payloadMinimumCapacity", "logicalBytes", "logicalGrants", "remaining", "separateBackingRelease", "terminalRequiresEmptyBacking"],
      "properties": {
        "initialQueueBackingBytes": { "const": 0 },
        "payloadMinimumCapacity": { "const": 64 },
        "logicalBytes": { "const": 8 },
        "logicalGrants": { "const": [0, 1, 7] },
        "remaining": { "const": [8, 7, 0] },
        "separateBackingRelease": { "const": true },
        "terminalRequiresEmptyBacking": { "const": true }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "startUs",
          "finishUs",
          "cancelled",
          "grant",
          "receiver",
          "frameGeneration",
          "inputGeneration",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "event",
              "metrics"
            ]
          },
          "startUs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "finishUs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cancelled": {
            "type": "boolean"
          },
          "grant": {
            "enum": [
              "zero",
              "exact"
            ]
          },
          "receiver": {
            "enum": [
              "available",
              "eventFull",
              "mailboxFull",
              "mailboxBusy",
              "mailboxPoisoned",
              "surfaceClosing"
            ]
          },
          "frameGeneration": {
            "$ref": "#/$defs/u64"
          },
          "inputGeneration": {
            "$ref": "#/$defs/u64"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "sourcePreserved",
              "eventCommits",
              "surfaceCommits",
              "mailboxCommits",
              "generationDelta"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "accepted",
                  "blocked",
                  "cancelled",
                  "fault",
                  "exhausted"
                ]
              },
              "sourcePreserved": {
                "type": "boolean"
              },
              "eventCommits": {
                "enum": [
                  0,
                  1
                ]
              },
              "surfaceCommits": {
                "enum": [
                  0,
                  1
                ]
              },
              "mailboxCommits": {
                "enum": [
                  0,
                  1
                ]
              },
              "generationDelta": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
    }
  }
}
