{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/ui/host/input/admission/schema.json",
  "title": "Ui Host Input Admission Schema Module",
  "$defs": {
    "AdmissionFixture": {
      "title": "UI Host Input Admission Fixture",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "limits",
        "ownedEvent",
        "physicalRetirement",
        "cases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exclusiveCallbackCeilingUs",
            "discreteEvents",
            "discreteLogicalBytes",
            "eventLogicalBytes",
            "runtimeCompletions"
          ],
          "properties": {
            "exclusiveCallbackCeilingUs": {
              "const": 8000
            },
            "discreteEvents": {
              "const": 256
            },
            "discreteLogicalBytes": {
              "const": 1048576
            },
            "eventLogicalBytes": {
              "const": 4096
            },
            "runtimeCompletions": {
              "const": 128
            }
          }
        },
        "ownedEvent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "utf8Hex"
          ],
          "properties": {
            "text": {
              "const": "a\u0000é🧪"
            },
            "utf8Hex": {
              "const": "6100c3a9f09fa7aa"
            }
          }
        },
        "physicalRetirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initialQueueBackingBytes",
            "payloadMinimumCapacity",
            "logicalBytes",
            "logicalGrants",
            "remaining",
            "separateBackingRelease",
            "terminalRequiresEmptyBacking"
          ],
          "properties": {
            "initialQueueBackingBytes": {
              "const": 0
            },
            "payloadMinimumCapacity": {
              "const": 64
            },
            "logicalBytes": {
              "const": 8
            },
            "logicalGrants": {
              "const": [
                0,
                1,
                7
              ]
            },
            "remaining": {
              "const": [
                8,
                7,
                0
              ]
            },
            "separateBackingRelease": {
              "const": true
            },
            "terminalRequiresEmptyBacking": {
              "const": true
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind",
              "startUs",
              "finishUs",
              "cancelled",
              "grant",
              "receiver",
              "frameGeneration",
              "inputGeneration",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "event",
                  "metrics"
                ]
              },
              "startUs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "finishUs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cancelled": {
                "type": "boolean"
              },
              "grant": {
                "enum": [
                  "zero",
                  "exact"
                ]
              },
              "receiver": {
                "enum": [
                  "available",
                  "eventFull",
                  "mailboxFull",
                  "mailboxBusy",
                  "mailboxPoisoned",
                  "surfaceClosing"
                ]
              },
              "frameGeneration": {
                "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
              },
              "inputGeneration": {
                "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "outcome",
                  "sourcePreserved",
                  "eventCommits",
                  "surfaceCommits",
                  "mailboxCommits",
                  "generationDelta"
                ],
                "properties": {
                  "outcome": {
                    "enum": [
                      "accepted",
                      "blocked",
                      "cancelled",
                      "fault",
                      "exhausted"
                    ]
                  },
                  "sourcePreserved": {
                    "type": "boolean"
                  },
                  "eventCommits": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "surfaceCommits": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "mailboxCommits": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "generationDelta": {
                    "enum": [
                      0,
                      1
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/AdmissionFixture"
    }
  ]
}
