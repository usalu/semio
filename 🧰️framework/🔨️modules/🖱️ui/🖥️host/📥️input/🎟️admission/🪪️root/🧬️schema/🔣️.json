{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/ui/host/input/admission/root/schema.json",
  "title": "Ui Host Input Admission Root Schema Module",
  "$defs": {
    "RootFixture": {
      "title": "UI Host Input Root Identity Fixture",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "storage",
        "cases",
        "reuse",
        "failureAfterInstall",
        "concurrent"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "scope": {
          "const": "linked-ui-host-instance"
        },
        "storage": {
          "const": {
            "atomicCount": 1,
            "nativeAtomicBytes": 8,
            "heapAllocations": 0,
            "maximumCasAttempts": 1
          }
        },
        "cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "before",
              "atCas",
              "grant",
              "outcome",
              "after",
              "root",
              "rootLeHex"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
              },
              "atCas": {
                "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
              },
              "grant": {
                "enum": [
                  "zero",
                  "short",
                  "admitted"
                ]
              },
              "outcome": {
                "enum": [
                  "blocked",
                  "admitted",
                  "exhausted",
                  "busy"
                ]
              },
              "after": {
                "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
              },
              "root": {
                "anyOf": [
                  {
                    "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rootLeHex": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "reuse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "firstRoot",
            "secondRoot",
            "firstEpoch",
            "secondEpoch",
            "oldKeyAccepted"
          ],
          "properties": {
            "initial": {
              "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
            },
            "firstRoot": {
              "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
            },
            "secondRoot": {
              "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
            },
            "firstEpoch": {
              "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
            },
            "secondEpoch": {
              "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
            },
            "oldKeyAccepted": {
              "const": false
            }
          }
        },
        "failureAfterInstall": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retainedRoot",
            "nextRoot",
            "returnedToSequence"
          ],
          "properties": {
            "retainedRoot": {
              "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
            },
            "nextRoot": {
              "$ref": "https://semio.tech/schema/framework/value/schema.json#/$defs/U64"
            },
            "returnedToSequence": {
              "const": false
            }
          }
        },
        "concurrent": {
          "const": {
            "workers": 8,
            "attemptsPerWorker": 4,
            "attempts": 32,
            "minimumSuccesses": 1,
            "maximumSuccesses": 32,
            "successfulRootsUnique": true
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/RootFixture"
    }
  ]
}
