{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/ui-host-ordered-scroll-v1.json",
  "title": "Ordered Scroll Ingress",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "capacity", "cases", "overflow"],
  "properties": {
    "version": { "const": 1 },
    "capacity": { "const": 256 },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "physical", "expectedDom", "expectedQueue"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "physical": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/event" } },
          "expectedDom": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/event" } },
          "expectedQueue": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } }
        }
      }
    },
    "overflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fill", "fillCount", "candidate", "expectedOutcome", "expectedOverflowCount", "expectedPreservedCount"],
      "properties": {
        "fill": { "$ref": "#/$defs/keyDown" },
        "fillCount": { "const": 256 },
        "candidate": { "$ref": "#/$defs/scroll" },
        "expectedOutcome": { "const": "overflow" },
        "expectedOverflowCount": { "const": 1 },
        "expectedPreservedCount": { "const": 256 }
      }
    }
  },
  "$defs": {
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shift", "ctrl", "alt", "meta"],
      "properties": {
        "shift": { "type": "boolean" },
        "ctrl": { "type": "boolean" },
        "alt": { "type": "boolean" },
        "meta": { "type": "boolean" }
      }
    },
    "scroll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "x", "y", "deltaX", "deltaY", "modifiers"],
      "properties": {
        "kind": { "const": "scroll" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "deltaX": { "type": "number" },
        "deltaY": { "type": "number" },
        "modifiers": { "$ref": "#/$defs/modifiers" }
      }
    },
    "pointerMove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "x", "y", "modifiers"],
      "properties": {
        "kind": { "const": "pointer-move" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "modifiers": { "$ref": "#/$defs/modifiers" }
      }
    },
    "keyDown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "modifiers"],
      "properties": {
        "kind": { "const": "key-down" },
        "key": { "type": "string" },
        "modifiers": { "$ref": "#/$defs/modifiers" }
      }
    },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/scroll" },
        { "$ref": "#/$defs/pointerMove" },
        { "$ref": "#/$defs/keyDown" }
      ]
    }
  }
}
