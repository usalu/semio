  "hitTests": [
    {
      "case": "two-sections-stack-in-order",
      "point": {
        "x": 86.0,
        "y": 84.0
      },
      "expects": "actions/add-generation",
      "why": "The painted 'Add Generation' label. Under the defect this point fell outside the published 6.4 px row and dispatched nothing."
    },
    {
      "case": "two-sections-stack-in-order",
      "point": {
        "x": 40.0,
        "y": 30.0
      },
      "expects": "generations/gen-a",
      "why": "The first list row under its section header."
    },
    {
      "case": "two-sections-stack-in-order",
      "point": {
        "x": 40.0,
        "y": 60.0
      },
      "expects": "generations/gen-b",
      "why": "The second list row - proof the pitch is the row metric and not a distributed remainder."
    },
    {
      "case": "an-expanded-row-owns-its-nested-rows",
      "point": {
        "x": 10.0,
        "y": 36.0
      },
      "expects": "outline/branch/leaf-a",
      "why": "A nested row wins over the branch row that contains it."
    },
    {
      "case": "a-collapsed-row-hides-its-nested-rows",
      "point": {
        "x": 10.0,
        "y": 36.0
      },
      "expects": "outline/after",
      "why": "The row beneath a collapsed branch keeps the pointer — the branch's unpainted nested rows measure zero and cannot intercept it."
    }
  ]
