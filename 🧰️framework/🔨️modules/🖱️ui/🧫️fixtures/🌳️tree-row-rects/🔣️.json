{
  "provenance": {
    "what": "The language-neutral oracle for a tree's row geometry: theme metrics + an authored tree of N rows -> the rect of every row, in that row's own parent space.",
    "why": "On the wgpu target a tree row mounted as a keyed Stack with no arena children of its own (its icon, label, description and actions live inline on the owning Tree's spec), so the retained mounted layout measured it as padding_standard * 2 = 6.4 px and published THAT as the row's rect, while the painter stepped its own private cursor by a hardcoded 24.0. Hit-testing reads the published rects, so five clicks on the painted 'Add Generation' label dispatched nothing. Ticket 26/09/09/PROCEDURAL-3D-END-TO-END, 📓️wgpu-tree-row-hit-test-2026-09-12.md.",
    "rule": "Layout and paint share ONE row metric, and hit registration derives from the rects layout published - never a second geometry.",
    "implementations": {
      "rust": "🧰️framework/🔨️modules/🖱️ui/🧪️tests/🌳️tree-row-rects/🦀️.rs",
      "typescript": "🧰️framework/🛍️products/💻️os/🔨️modules/📺️renderer/🧑‍🎨engine/🧪️tests/🌳️tree-row-rects/🟦️.ts"
    }
  },
  "metrics": {
    "source": "🖱️ui/🎨️styling/🔣️.json metrics.dom.treeRowUiSpacing x metrics.chrome.uiSpacingCompactPx",
    "uiSpacingCompactPx": 3.2,
    "treeRowUiSpacing": 7.5,
    "rowHeightPx": 24.0,
    "reactTwin": "domSizePx(\"treeRowUiSpacing\") in 🧱️elements/🌳️Tree/🟦️.tsx (treeRowHeightPx), --size-workbench = 1.5 * --size-small",
    "rustTwin": "Theme::tree_row_height / layout::TreeRowMetrics::from_theme"
  },
  "rules": {
    "sectionHeader": "A section contributes one header row of rowHeightPx when it is labelled, and none when it is not.",
    "itemRow": "Every visible item contributes exactly one row of rowHeightPx, plus the rows of its nested items when it is expanded (default_open) and has any.",
    "hidden": "An item whose presence is not visible contributes no row and no rect.",
    "collapsed": "A collapsed item's nested rows contribute nothing.",
    "width": "A row spans its tree's full width; x is 0 in its parent's space.",
    "y": "A row's y is its parent's own header band (a section) or own row (an item), plus the heights of the preceding sibling rows.",
    "unreachedRows": "A collapsed branch's nested rows are still MOUNTED (the arena holds every authored row) and are never painted, so they measure zero and occupy no band — a row that is not drawn must never take the pointer from the row drawn beneath it."
  },
