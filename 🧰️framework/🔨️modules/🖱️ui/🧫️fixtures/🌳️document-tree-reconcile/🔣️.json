  "ingressGeneration": {
    "rule": "A surface's document is admitted by its ingress generation alone: `document_status` answers Published while it equals the published one, and `begin_document` refuses StaleGeneration unless it is strictly greater. A producer therefore mints one counter per surface, held still while that surface's own revision holds still.",
    "cases": [
      {
        "label": "first document of a surface",
        "minted": null,
        "revision": 1,
        "generation": 1
      },
      {
        "label": "the same surface republished unchanged",
        "minted": [
          1,
          1
        ],
        "revision": 1,
        "generation": 1
      },
      {
        "label": "the surface's revision moved",
        "minted": [
          1,
          1
        ],
        "revision": 2,
        "generation": 2
      },
      {
        "label": "the revision moved again",
        "minted": [
          2,
          2
        ],
        "revision": 7,
        "generation": 3
      },
      {
        "label": "a reopened surface whose revision restarted",
        "minted": [
          7,
          3
        ],
        "revision": 1,
        "generation": 4
      }
    ],
    "constantProducerIsRefused": {
      "why": "Minting one constant for every surface and every republish — the plugin instance id — makes every document after a surface's first answer Published, so the arena keeps the first tree for the life of the session.",
      "generations": [
        1,
        1,
        1
      ],
      "admittedIngresses": 1
    }
  }
