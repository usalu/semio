{
  "provenance": {
    "what": "The language-neutral oracle for projecting a published UiDocumentTree into a renderer's paintable node arena.",
    "why": "UiTree::publish_document stored the document in a field nothing read back, so the wgpu engine's arena root stayed None forever and frame_into_step answered Missing on its first line. Ticket 26/09/09/PROCEDURAL-3D-END-TO-END, 📓️wgpu-blank-paint-2026-09-12.md §5.",
    "shape": "Modelled on generation3d's edit-mode Flow window body (✏️s/🔌️plugins/🌀️procedural/…/✏️editor/🎭️modes/✏️edit/🪟️windows/🕸️flow/🦀️.rs::render): a horizontal row holding an outline column and a canvas column whose only child is the node-graph surface, with the surface's out-of-doc payload lane carrier beneath it.",
    "implementations": {
      "rust": "🧰️framework/🔨️modules/🖱️ui/🧪️tests/🌳️document-tree-reconcile/🦀️.rs",
      "typescript": "🧰️framework/🛍️products/💻️os/🔨️modules/📺️renderer/🧑‍🎨engine/🧪️tests/🌳️wgpu-document-reconcile/🟦️.ts"
    }
  },

  "identityRule": {
    "keyedBy": "uiNodeId",
    "why": "The producer mints one UiNodeId per (parent, key) and reuses it while that identity survives (🖱️ui/🧠️runtime's SurfaceReconcileStage::AllocateIdentities), so a node that only moved or changed props must keep its arena slot — and with it its widget state, focused edit buffer, scroll offset and interaction flags.",
    "reactTwin": "uiChildReactKeys in 📺️renderer/🧑‍🎨engine/🧱️elements/🗣️Interpreter/🟦️.tsx"
  },

  "phases": ["adopt", "plan", "unlink", "mount", "retire", "publish"],
  "unitsPerStep": 1,
  "framePhaseOrder": ["ingress", "reconcile", "viewport", "layout", "paint", "complete"],

  "consumesSubtree": {
    "surface": {
      "rule": "A surface's children are NOT rendered chrome — a renderer draws props and nothing else; its children are the out-of-doc payload lane carriers, folded back into the scene.",
      "source": "🧰️framework/🔨️modules/🖱️ui/🧬️contract/🏗️builder/🦀️.rs SurfaceBuilder"
    },
    "tree": {
      "rule": "A tree carries its sections and items inline in the one retained spec the renderer paints, so the section/item records never become nodes of their own.",
      "reactTwin": "collectTreeItems"
    },
    "everyOtherComponent": false
  },

  "componentProjection": {
    "container.plain": "stack",
    "container.form": "stack",
    "container.toolbar": "stack",
    "container.section": "section",
    "container.group": "group",
    "container.field": "field",
    "text": "text",
    "button": "button",
    "separator": "separator",
    "input": "input",
    "select": "select",
    "toggle": "toggle",
    "keyValueList": "keyValue",
    "slider": "slider",
    "numberStepper": "numberStepper",
    "ring": "ring",
    "iconSelect": "iconSelect",
    "tree": "tree",
    "treeSection": "tree",
    "treeItem": "tree",
    "image": "image",
    "surface": "componentScene",
    "extension": "externalSlot"
  },

  "surfaceIdentity": {
    "surfaceId": "the owning document's surface",
    "controllerId": "the owning app's controller",
    "paneId": "the record's own key",
    "bindingId": null,
    "reactTwin": "surfaceHostIdentityV1"
  },

