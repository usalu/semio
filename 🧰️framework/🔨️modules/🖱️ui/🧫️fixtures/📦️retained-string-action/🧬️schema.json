  "properties": {
    "$schema": { "type": "string" },
    "controllerId": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "largeDraftBytes": { "type": "integer", "minimum": 65536 },
    "expectedSteps": { "type": "integer", "minimum": 2 }
  },
  "additionalProperties": false
}
