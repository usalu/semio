  {
   "name": "bundles added later merge deeply and overwrite equal paths, in a language that had none or one",
   "options": {
    "language": "en",
    "fallbackLanguage": "en",
    "supportedLanguages": [
     "en",
     "de"
    ]
   },
   "bundles": {
    "en": {
     "a": {
      "x": "1",
      "y": "2"
     }
    }
   },
   "steps": [
    {
     "call": "t",
     "key": "a.x",
     "expected": "1"
    },
    {
     "call": "t",
     "key": "b.z",
     "expected": "b.z"
    },
    {
     "call": "addBundle",
     "language": "en",
     "tree": {
      "a": {
       "y": "two",
       "w": "3"
      },
      "b": {
       "z": "zed"
      }
     }
    },
    {
     "call": "t",
     "key": "a.x",
     "expected": "1"
    },
    {
     "call": "t",
     "key": "a.y",
     "expected": "two"
    },
    {
     "call": "t",
     "key": "a.w",
     "expected": "3"
    },
    {
     "call": "t",
     "key": "b.z",
     "expected": "zed"
    },
    {
     "call": "addBundle",
     "language": "de",
     "tree": {
      "a": {
       "x": "eins"
      }
     }
    },
    {
     "call": "changeLanguage",
     "language": "de"
    },
    {
     "call": "t",
     "key": "a.x",
     "expected": "eins"
    },
    {
     "call": "t",
     "key": "a.y",
     "expected": "two"
    }
   ]
  }
 ]
