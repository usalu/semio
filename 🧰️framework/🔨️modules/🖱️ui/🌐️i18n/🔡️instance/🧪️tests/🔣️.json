    "supportedLanguages": [
     "en",
     "de"
    ]
   },
   "bundles": {
    "en": {
     "nav": {
      "back": {
       "label": {
        "normal": "Back",
        "beginner": "Go back"
       }
      },
      "title": "Hello {{name}}"
     },
     "only": {
      "en": "English only"
     },
     "list": {
      "count": "{{node}}, {{position}} of {{count}}"
     },
     "nested": {
      "user": "{{user.name}} ({{ user.id }})"
     },
     "plain": "Plain",
     "empty": ""
    },
    "de": {
     "nav": {
      "back": {
       "label": {
        "normal": "Zurück",
        "beginner": "Zurück gehen"
       }
      },
      "title": "Hallo {{name}}"
     },
     "list": {
      "count": "{{node}}, {{position}} von {{count}}"
     },
     "plain": "Schlicht"
    }
   },
   "steps": [
    {
     "call": "exists",
     "key": "only.en",
     "expected": true
    },
    {
     "call": "exists",
     "key": "only.en",
     "expected": true,
     "options": {
      "lng": "de"
     }
    },
    {
     "call": "exists",
     "key": "nav.nope",
     "expected": false
    },
    {
     "call": "exists",
     "key": "plain.deeper",
     "expected": false
    },
    {
     "call": "exists",
     "key": "",
     "expected": false
