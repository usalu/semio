{
 "version": 1,
 "instances": [
  {
   "name": "nested key, own language first, fallback language for a key the language lacks",
   "options": {
    "language": "de",
    "fallbackLanguage": "en",
    "supportedLanguages": [
     "en",
     "de"
    ]
   },
   "bundles": {
    "en": {
     "nav": {
      "back": {
       "label": {
        "normal": "Back",
        "beginner": "Go back"
       }
      },
      "title": "Hello {{name}}"
     },
     "only": {
      "en": "English only"
     },
     "list": {
      "count": "{{node}}, {{position}} of {{count}}"
     },
     "nested": {
      "user": "{{user.name}} ({{ user.id }})"
     },
     "plain": "Plain",
     "empty": ""
    },
    "de": {
     "nav": {
      "back": {
       "label": {
        "normal": "Zurück",
        "beginner": "Zurück gehen"
       }
      },
      "title": "Hallo {{name}}"
     },
     "list": {
      "count": "{{node}}, {{position}} von {{count}}"
     },
     "plain": "Schlicht"
    }
   },
   "steps": [
    {
     "call": "t",
     "key": "plain",
     "expected": "Schlicht"
    },
    {
     "call": "t",
     "key": "nav.title",
     "expected": "Hallo {{name}}"
    },
    {
     "call": "t",
     "key": "only.en",
     "expected": "English only"
    },
    {
     "call": "t",
     "key": "nav.title",
     "expected": "Hallo Ada",
     "options": {
      "name": "Ada"
     }
    },
    {
     "call": "t",
     "key": "plain",
     "expected": "Plain",
     "options": {
      "lng": "en"
     }
    },
    {
     "call": "changeLanguage",
     "language": "de"
    },
    {
     "call": "language",
     "expected": "de"
    },
    {
     "call": "resolvedLanguage",
     "expected": "de"
    }
   ]
  },
  {
   "name": "a missing key answers itself, a default value answers in its place, an empty string is a translation",
   "options": {
    "language": "de",
    "fallbackLanguage": "en",
    "supportedLanguages": [
     "en",
     "de"
    ]
   },
   "bundles": {
    "en": {
     "nav": {
      "back": {
       "label": {
        "normal": "Back",
        "beginner": "Go back"
       }
      },
      "title": "Hello {{name}}"
     },
     "only": {
      "en": "English only"
     },
     "list": {
      "count": "{{node}}, {{position}} of {{count}}"
     },
     "nested": {
      "user": "{{user.name}} ({{ user.id }})"
     },
     "plain": "Plain",
     "empty": ""
    },
    "de": {
     "nav": {
      "back": {
       "label": {
        "normal": "Zurück",
        "beginner": "Zurück gehen"
       }
      },
      "title": "Hallo {{name}}"
     },
     "list": {
      "count": "{{node}}, {{position}} von {{count}}"
     },
     "plain": "Schlicht"
    }
   },
   "steps": [
    {
     "call": "t",
     "key": "nav.missing",
     "expected": "nav.missing"
    },
    {
     "call": "t",
     "key": "nav.missing",
     "expected": "fallback Ada",
     "options": {
      "defaultValue": "fallback {{name}}",
      "name": "Ada"
     }
    },
    {
     "call": "t",
     "key": "empty",
     "expected": ""
    },
    {
     "call": "t",
     "key": "nav.title.deeper",
     "expected": "nav.title.deeper"
    }
   ]
  },
  {
   "name": "interpolation: spaces, numbers, repeated names, dotted variable paths, absent variables stay as written",
   "options": {
    "language": "de",
    "fallbackLanguage": "en",
    "supportedLanguages": [
     "en",
     "de"
    ]
   },
   "bundles": {
    "en": {
     "nav": {
      "back": {
       "label": {
        "normal": "Back",
        "beginner": "Go back"
       }
      },
      "title": "Hello {{name}}"
     },
     "only": {
      "en": "English only"
     },
     "list": {
      "count": "{{node}}, {{position}} of {{count}}"
     },
     "nested": {
      "user": "{{user.name}} ({{ user.id }})"
     },
     "plain": "Plain",
     "empty": ""
    },
    "de": {
     "nav": {
      "back": {
       "label": {
        "normal": "Zurück",
        "beginner": "Zurück gehen"
       }
      },
      "title": "Hallo {{name}}"
     },
     "list": {
      "count": "{{node}}, {{position}} von {{count}}"
     },
     "plain": "Schlicht"
    }
   },
   "steps": [
    {
     "call": "t",
     "key": "list.count",
     "expected": "Knoten, 2 von 5",
     "options": {
      "node": "Knoten",
      "position": 2,
      "count": 5
     }
    },
    {
     "call": "t",
     "key": "list.count",
     "expected": "{{node}}, 2 von {{count}}",
     "options": {
      "position": 2
     }
    },
    {
     "call": "t",
     "key": "nested.user",
     "expected": "Ada (7)",
     "options": {
      "lng": "en",
      "user": {
       "name": "Ada",
       "id": 7
      }
     }
    },
    {
     "call": "t",
     "key": "nav.title",
     "expected": "Hallo Bob",
     "options": {
      "replace": {
       "name": "Bob"
      }
     }
    },
    {
     "call": "t",
     "key": "nav.title",
     "expected": "Hallo <b>&amp;",
     "options": {
      "name": "<b>&amp;"
     }
    }
   ]
  },
  {
   "name": "a group resolves to a copy of its tree with every string interpolated",
   "options": {
    "language": "de",
    "fallbackLanguage": "en",
    "supportedLanguages": [
     "en",
     "de"
    ]
   },
   "bundles": {
    "en": {
     "nav": {
      "back": {
       "label": {
        "normal": "Back",
        "beginner": "Go back"
       }
      },
      "title": "Hello {{name}}"
     },
     "only": {
      "en": "English only"
     },
     "list": {
      "count": "{{node}}, {{position}} of {{count}}"
     },
     "nested": {
      "user": "{{user.name}} ({{ user.id }})"
     },
     "plain": "Plain",
     "empty": ""
    },
    "de": {
     "nav": {
      "back": {
       "label": {
        "normal": "Zurück",
        "beginner": "Zurück gehen"
       }
      },
      "title": "Hallo {{name}}"
     },
     "list": {
      "count": "{{node}}, {{position}} von {{count}}"
     },
     "plain": "Schlicht"
    }
   },
   "steps": [
    {
     "call": "t",
     "key": "nav.back",
     "expected": {
      "label": {
       "normal": "Zurück",
       "beginner": "Zurück gehen"
      }
     }
    },
    {
     "call": "t",
     "key": "nav.back",
     "expected": {
      "label": {
       "normal": "Back",
       "beginner": "Go back"
      }
     },
     "options": {
      "lng": "en"
     }
    },
    {
     "call": "exists",
     "key": "nav.back",
     "expected": true
    },
    {
     "call": "exists",
     "key": "nav",
     "expected": true
    },
    {
     "call": "exists",
     "key": "nav.back.label.normal",
     "expected": true
    }
   ]
  },
  {
   "name": "exists follows the fallback chain and the lng call option, and refuses unknown keys",
