     "de"
    ]
   },
   "bundles": {
    "en": {
     "nav": {
      "back": {
       "label": {
        "normal": "Back",
        "beginner": "Go back"
       }
      },
      "title": "Hello {{name}}"
     },
     "only": {
      "en": "English only"
     },
     "list": {
      "count": "{{node}}, {{position}} of {{count}}"
     },
     "nested": {
      "user": "{{user.name}} ({{ user.id }})"
     },
     "plain": "Plain",
     "empty": ""
    },
    "de": {
     "nav": {
      "back": {
       "label": {
        "normal": "Zurück",
        "beginner": "Zurück gehen"
       }
      },
      "title": "Hallo {{name}}"
