{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/ui/i18n/schema.json",
  "title": "UiTranslationTotalityLaws",
  "x-semio-formats": [
    "🔣️jsonschema"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "key",
          "options",
          "normal",
          "beginner"
        ],
        "properties": {
          "locale": {
            "enum": [
              "en",
              "de"
            ]
          },
          "key": {
            "enum": [
              "ui.host.documentPlaceholder",
              "ui.host.languageDocument",
              "ui.mutation.history.foreignTransition"
            ]
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "normal": {
            "type": "string",
            "minLength": 1
          },
          "beginner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
