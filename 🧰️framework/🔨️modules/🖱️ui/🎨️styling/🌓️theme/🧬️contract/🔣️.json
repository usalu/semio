{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/ui/styling/theme/schema.json",
  "title": "Ui Theme",
  "type": "object",
  "required": [
    "id",
    "label",
    "colors",
    "spacing",
    "fontStacks",
    "canvasFonts",
    "strokes",
    "radii",
    "opacities",
    "metrics",
    "appearances"
  ],
  "properties": {
    "colors": {
      "type": "object"
    },
    "fontStacks": {
      "type": "object"
    },
    "canvasFonts": {
      "type": "object"
    },
    "strokes": {
      "type": "object"
    },
    "radii": {
      "type": "object"
    },
    "opacities": {
      "type": "object"
    },
    "appearances": {
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "spacing": {
      "type": "object",
      "properties": {
        "compact": {
          "$ref": "geometry/schema.json#/properties/compact"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "dom": {
          "type": "object",
          "properties": {
            "rootRemPx": {
              "$ref": "geometry/schema.json#/properties/rootRemPx"
            },
            "treeRowUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "treeIndentPerLevelUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "treeToggleUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "layoutPanelMinUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "layoutPanelMaxUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "layoutPanelRailUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "layoutEngagementMaxUiSpacing": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "textSmPx": {
              "type": "number",
              "minimum": 0
            },
            "textXsPx": {
              "type": "number",
              "minimum": 0
            },
            "textBasePx": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "chrome": {
          "type": "object",
          "properties": {
            "navbarHeightUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "footerHeightUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "panelHeaderHeightUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "controlHeightUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "controlHeightSmallUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "gapStandardUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "paddingStandardUiSpacing": {
              "type": "number",
              "minimum": 0
            },
            "panelInsetUiSpacing": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "icons": {
      "type": "object"
    }
  },
  "x-semio-resolved-geometry": true
}
