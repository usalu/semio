{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.ui.styling.conditional-delivery-fixture/v1",
  "title": "🏷️ Conditional delivery of dev-served files — request cases and their exact answers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "file", "rewrite", "cases"],
  "properties": {
    "schema": { "const": "semio.ui.styling.conditional-delivery-fixture/v1" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "content", "contentType"], "properties": { "path": { "type": "string", "minLength": 1 }, "content": { "type": "string" }, "contentType": { "type": "string" } } },
    "rewrite": { "type": "string", "description": "Content the file is rewritten with before every case marked `afterRewrite`." },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "method", "headers", "afterRewrite", "status", "body"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "method": { "enum": ["GET", "HEAD"] },
          "headers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "if-none-match": { "type": "string", "description": "`{etag}` = the tag the first plain GET answered, `{etag:weakless}` = the same without `W/`." },
              "if-modified-since": { "type": "string", "description": "`{lastModified}` ± `<n>s`, or an HTTP date." }
            }
          },
          "afterRewrite": { "type": "boolean" },
          "status": { "enum": [200, 304] },
          "body": { "enum": ["full", "none"] }
        }
      }
    }
  }
}
