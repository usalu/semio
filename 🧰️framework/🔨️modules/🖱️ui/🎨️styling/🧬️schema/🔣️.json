{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/ui/styling/schema.json",
  "title": "Ui Styling Schema Module",
  "$defs": {
    "Favicon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "version",
        "svg",
        "ico"
      ],
      "properties": {
        "$schema": {
          "const": "./🧬️favicon.schema.json"
        },
        "version": {
          "const": 1
        },
        "svg": {
          "const": "🛡️favicon.svg"
        },
        "ico": {
          "const": "🔖️favicon.ico"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/Favicon"
    }
  ]
}
