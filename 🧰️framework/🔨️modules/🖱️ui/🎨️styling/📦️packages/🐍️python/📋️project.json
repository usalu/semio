{
  "name": "@semio-tech/ui-styling-py",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🐍️python",
        "command": "bun ./📜️script.ts generate"
      },
      "cache": true,
      "outputs": [],
      "dependsOn": [
        "@semio-tech/ui-styling-tokens:generate"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🐍️python",
        "command": "bun ../../🏗️builder/🐍️python/📜️script.ts build"
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/dist/build"
      ],
      "dependsOn": [
        "deps",
        "@semio-tech/ui-styling-tokens:generate"
      ],
      "parallelism": false,
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/uv.lock",
        {
          "dependentTasksOutputFiles": "**/*"
        },
        {
          "env": "SOURCE_DATE_EPOCH"
        },
        {
          "runtime": "uv --version"
        },
        {
          "runtime": "node -p \"process.platform.concat(process.arch)\""
        }
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🐍️python",
        "command": "bun ./📜️script.ts test"
      },
      "outputs": [],
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "default",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ]
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🐍️python",
        "command": "bun ./📜️script.ts test quick"
      },
      "outputs": [],
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "default",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ]
    },
    "test-long": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🐍️python",
        "command": "bun ./📜️script.ts test long"
      },
      "outputs": [],
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "default",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ]
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🐍️python",
        "command": "bun ./📜️script.ts test exhaustive"
      },
      "outputs": [],
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "default",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*"
        }
      ]
    },
    "deps": {
      "cache": false,
      "outputs": [],
      "options": {
        "command": "bun ../../🏗️builder/🐍️python/📜️script.ts deps"
      },
      "parallelism": false
    }
  }
}
