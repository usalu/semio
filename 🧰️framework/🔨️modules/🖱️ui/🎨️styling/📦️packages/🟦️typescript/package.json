{
  "$schema": "https://json.schemastore.org/package.json",
  "projectType": "library",
  "name": "@semio-tech/ui-styling",
  "version": "0.1.0",
  "description": "ui · Tailwind/CSS surface; canonical tokens + codegen live in framework/ui/styling (@semio-tech/ui-styling-tokens)",
  "type": "module",
  "semio": {
    "dependencyRole": "ui",
    "role": "framework",
    "id": "ui-styling-ts",
    "storybook": {
      "id": "styling",
      "titlePrefix": "🎨️styling",
      "sourceRoots": [
        "📦️packages/🟦️typescript"
      ],
      "storyGlobs": [
        "📖️stories/**/🧪️.story.tsx"
      ]
    }
  },
  "exports": {
    ".": "./🟦️.ts",
    "./🖌️ui.css": "./🖌️ui.css",
    "./🎨️palette.css": "./🎨️palette.css",
    "./tokens": "./🔤️tokens/🟦️.ts",
    "./builder/vite": "./🏗️builder/🌐️vite/🟦️.ts",
    "./builder/vite/mode": "./🏗️builder/🌐️vite/🎚️mode/🟦️.ts",
    "./builder/vite/wasm/delivery": "./🏗️builder/🌐️vite/🕸️wasm/📦️delivery/🟦️.ts",
    "./mixing": "./🌗️mixing/🟦️.ts",
    "./verification/testing/color-oracle": "./🛡️verification/🧪️testing/⚖️color-oracle/🟦️.ts",
    "./builder/python/contract": "./🏗️builder/🐍️python/📋️contract/🟦️.ts",
    "./theme": "./🌓️theme/🟦️.ts",
    "./theme/model": "./🌓️theme/🏛️model/🟦️.ts",
    "./verification": "./🛡️verification/🟦️.ts"
  },
  "dependencies": {
    "@semio-tech/assets": "workspace:*",
    "@semio-tech/framework": "workspace:*",
    "@semio-tech/schema-validator-ts": "workspace:*",
    "@semio-tech/ui-react": "workspace:*",
    "@tailwindcss/typography": "^0.5.19",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@csstools/css-calc": "2.1.4",
    "ajv": "8.20.0",
    "@csstools/css-tokenizer": "3.0.4",
    "@semio-tech/process": "workspace:*"
  },
  "author": {
    "name": "Ueli Saluz",
    "email": "ueli@semio-tech.com",
    "url": "https://github.com/usalu"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/usalu/semio.git",
    "directory": "framework/module/ui/styling/js"
  },
  "bundleKind": "library",
  "scripts": {
    "test-geometry": "bun --cwd \"../../../../../..\" repo run @semio-tech/ui-styling:test-geometry"
  }
}
