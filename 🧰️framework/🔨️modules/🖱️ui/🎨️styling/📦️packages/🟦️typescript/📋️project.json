{
  "name": "@semio-tech/ui-styling",
  "$schema": "../../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎨️styling/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎨️styling/💨️tailwind/🟦️.ts",
      "sharedGlobals"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖼️assets/**/*"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "generate": {
      "executor": "repo:noop",
      "metadata": {
        "semio": {
          "cache": { "version": 1, "class": "aggregate", "reason": "orders-prerequisites" }
        }
      },
      "dependsOn": [
        "@semio-tech/ui-styling-tokens:generate"
      ]
    },
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts test"
      },
      "metadata": {
        "semio": {
          "closure": {
            "resources": [
              "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🧑‍💻dev/🌐️.html",
              "{workspaceRoot}/🧰️framework/🛍️products/💻️os/🔨️modules/🧑‍💻dev/📤️distribution/🌐️.html"
            ]
          }
        }
      }
    },
    "twin": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "reads"
      ],
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts twin",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": []
    },
    "test-geometry": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🟦️typescript",
        "command": "repo ./📜️script.ts test-geometry"
      },
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        {
          "externalDependencies": [
            "@csstools/css-calc",
            "@csstools/css-tokenizer",
            "ajv",
            "jsdom",
            "vitest"
          ]
        }
      ]
    },
    "test-asset-transport": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads"
      ],
      "outputs": [],
      "options": {
        "command": "repo 📜️script.ts test-asset-transport",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      },
      "dependsOn": [],
      "metadata": {
        "workspaceCommand": [
          "test-asset-transport"
        ]
      }
    }
  }
}
