{
  "name": "@semio-tech/ui-styling",
  "$schema": "../../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎨️styling/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎨️styling/💨️tailwind/🟦️.ts",
      "sharedGlobals"
    ]
  },
  "targets": {
    "generate": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts generate",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": [],
      "dependsOn": [
        "@semio-tech/ui-styling-tokens:generate"
      ]
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test"
      }
    },
    "twin": {
      "executor": "repo:script",
      "dependsOn": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts twin",
        "forwardAllArgs": true
      },
      "cache": true,
      "outputs": []
    },
    "test-geometry": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎨️styling/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test-geometry"
      },
      "cache": false,
      "outputs": [],
      "inputs": [
        "default",
        {
          "externalDependencies": [
            "@csstools/css-calc",
            "@csstools/css-tokenizer",
            "ajv",
            "jsdom",
            "vitest"
          ]
        }
      ]
    },
    "test-asset-transport": {
      "executor": "repo:script",
      "options": {
        "command": "bun 📜️script.ts test-asset-transport",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      },
      "dependsOn": [],
      "metadata": {
        "workspaceCommand": [
          "test-asset-transport"
        ]
      }
    }
  }
}
