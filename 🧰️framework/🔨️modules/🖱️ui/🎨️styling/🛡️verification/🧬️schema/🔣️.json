{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:ui:styling-verification:v1",
  "$defs": {
    "PathV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+[^/\\\\\\u0000-\\u001f\\u007f]$(?![\\s\\S])|^[^/\\\\.\\u0000-\\u001f\\u007f]$(?![\\s\\S])"
    },
    "SourceLanguageV1": {"enum": ["typescript", "rust", "css"]},
    "SourceManifestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "files"],
      "properties": {
        "roots": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/PathV1"}},
        "files": {"type": "array", "maxItems": 262144, "items": {"$ref": "#/$defs/PathV1"}}
      }
    },
    "ScopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/PathV1"
          }
        }
      }
    },
    "CasesV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopes",
        "sources",
        "scans"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "input", "accepted", "files"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "input": {},
              "accepted": {"type": "boolean"},
              "files": {"type": "array", "items": {"$ref": "#/$defs/PathV1"}}
            }
          }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "input",
              "accepted",
              "roots"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "input": {},
              "accepted": {
                "type": "boolean"
              },
              "roots": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/PathV1"
                }
              }
            }
          }
        },
        "scans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "roots",
              "files",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "roots": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/PathV1"
                }
              },
              "files": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "expected": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "px",
                  "color"
                ],
                "properties": {
                  "px": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "color": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "RuleV1": {
      "enum": [
        "px",
        "color"
      ]
    },
    "ViolationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "kind",
        "text"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/PathV1"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "kind": {
          "enum": [
            "tailwind-arbitrary-px",
            "raw-hex-color",
            "raw-rgb-hsl-color",
            "tailwind-palette-color-class",
            "manual-dark-variant-palette"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 16777216
        }
      }
    },
    "ColorApplicationPathV1": {
      "allOf": [
        {"$ref": "#/$defs/ApplicationPathV1"},
        {"type": "string", "pattern": "^(?!.*(?:^|/)(?:🔤️tokens|🎨️palette)(?:/|$))[\\s\\S]+$"}
      ]
    },
    "ApplicationPathV1": {
      "allOf": [
        {
          "$ref": "#/$defs/PathV1"
        },
        {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)(?:🧪️tests|🧫️fixtures|🤖️generated|node_modules|\\.🧬semio|\\.git|dist|target|\\.vite|\\.stage)(?:/|$))[\\s\\S]+$"
        }
      ]
    }
  }
}
