{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:semio:ui:relative-sizing-cases:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rootFontSizesPx",
    "sizes"
  ],
  "properties": {
    "rootFontSizesPx": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 256
      }
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rem",
          "pixels"
        ],
        "properties": {
          "rem": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?rem$(?![\\s\\S])"
          },
          "pixels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 65536
            }
          }
        }
      }
    }
  }
}
