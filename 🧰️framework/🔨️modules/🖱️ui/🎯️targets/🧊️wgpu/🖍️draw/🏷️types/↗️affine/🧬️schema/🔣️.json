{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semio.ui.affine-quad.v1",
  "title": "Affine Quad Witness",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "rect", "matrix", "corners"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "rect": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "matrix": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}},
          "corners": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
        }
      }
    }
  }
}
