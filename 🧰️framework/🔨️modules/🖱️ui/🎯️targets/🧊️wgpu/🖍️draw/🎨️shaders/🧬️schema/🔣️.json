{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "constants"
  ],
  "additionalProperties": false,
  "properties": {
    "constants": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minProperties": 12,
      "maxProperties": 12
    }
  }
}
