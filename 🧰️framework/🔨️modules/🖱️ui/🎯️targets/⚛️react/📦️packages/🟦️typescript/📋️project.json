{
  "name": "@semio-tech/ui-react",
  "$schema": "../../../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🔨️modules/🖱️ui/🎯️targets/⚛️react",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎯️targets/⚛️react/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎯️targets/⚛️react/🧹️lint/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🧱️elements/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🔨️modules/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🧪️tests/🧫️fixtures/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🧬️schema/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎯️targets/⚛️react/🧪️tests/🎚️config/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/🖱️ui/🎯️targets/⚛️react/🛠️build-tooling/🎨️styling/🟦️.ts"
    ]
  },
  "targets": {
    "lint": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎯️targets/⚛️react/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts lint",
        "forwardAllArgs": true
      }
    },
    "test": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎯️targets/⚛️react/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "typecheck": {
      "executor": "repo:script",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎯️targets/⚛️react/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts typecheck",
        "forwardAllArgs": true
      }
    },
    "canonical-architecture": {
      "executor": "repo:script",
      "cache": false,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖱️ui/🎯️targets/⚛️react/📦️packages/🟦️typescript",
        "command": "bun ./📜️script.ts canonical-architecture"
      }
    }
  }
}
