{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.AsyncIterable", "DOM.Iterable", "ESNext"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "noEmit": true,
    "types": ["bun", "node", "react", "react-dom", "vite/client", "vitest/importMeta"],
    "baseUrl": ".",
    "paths": {
      "@semio-tech/ui-react": ["./🟦️.tsx"],
      "@semio-tech/ui-react/runtime": ["./🟦️.tsx"],
      "@semio-tech/ui-react/test": ["./🟦️.ts"],
      "vitest": ["./node_modules/vitest/dist/index.d.ts"],
      "dom-accessibility-api": ["../../../../../../../node_modules/dom-accessibility-api/dist/index.d.ts"],
      "@semio-tech/ui-react/introduction": ["./👋️introduction.ts"]
    }
  },
  "include": ["../../**/*.ts", "../../**/*.tsx", "../../../../🧱️elements/**/*.ts", "../../../../🧱️elements/**/*.tsx", "../../../../🔨️modules/**/*.ts", "../../../../🔨️modules/**/*.tsx", "../../../../🧪️tests/**/*.ts", "../../../../🧪️tests/**/*.tsx"],
  "exclude": ["node_modules", "storybook-static"]
}
