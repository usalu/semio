{
  "schema": "semio.ui.wrapped-and-grid-flow-fixture.v1",
  "cases": [
    {
      "name": "a space-between row wraps onto two lines that share the spare cross space",
      "viewport": { "width": 100.0, "height": 100.0 },
      "container": { "kind": "stack", "axis": "horizontal", "gap": "xs", "padding": { "all": "none" }, "align": "start", "justify": "spaceBetween", "grow": false, "wrap": true },
      "children": [
        { "kind": "leaf", "layout": { "kind": "leaf", "width": { "fixed": "xxl" }, "height": { "fixed": "lg" } } },
        { "kind": "leaf", "layout": { "kind": "leaf", "width": { "fixed": "xxl" }, "height": { "fixed": "lg" } } },
        { "kind": "leaf", "layout": { "kind": "leaf", "width": { "fixed": "xxl" }, "height": { "fixed": "lg" } } },
        { "kind": "leaf", "layout": { "kind": "leaf", "width": { "fixed": "xxl" }, "height": { "fixed": "lg" } } }
      ],
      "expected": [
        { "x": 0.0, "y": 0.0, "width": 38.4, "height": 19.2 },
        { "x": 61.6, "y": 0.0, "width": 38.4, "height": 19.2 },
        { "x": 0.0, "y": 51.6, "width": 38.4, "height": 19.2 },
        { "x": 61.6, "y": 51.6, "width": 38.4, "height": 19.2 }
      ]
    },
    {
      "name": "a two to one fraction grid sizes its columns from the leftover and stretches its implicit auto rows",
      "viewport": { "width": 198.4, "height": 100.0 },
      "container": { "kind": "grid", "columns": [{ "fraction": 1 }, { "fraction": 2 }], "rows": [], "columnGap": "sm", "rowGap": "xs", "padding": { "all": "none" }, "align": "start", "justify": "start" },
      "children": [
        { "kind": "leaf", "layout": { "kind": "leaf", "width": { "fixed": "sm" }, "height": { "fixed": "md" } } },
        { "kind": "leaf", "layout": { "kind": "leaf", "width": { "fixed": "sm" }, "height": { "fixed": "md" } } },
        { "kind": "leaf", "layout": { "kind": "leaf", "width": { "fixed": "sm" }, "height": { "fixed": "md" } } }
      ],
      "expected": [
        { "x": 0.0, "y": 0.0, "width": 6.4, "height": 12.8 },
        { "x": 70.4, "y": 0.0, "width": 6.4, "height": 12.8 },
        { "x": 0.0, "y": 51.6, "width": 6.4, "height": 12.8 }
      ]
    },
    {
      "name": "a stretching wrapped column breaks where its height runs out and gives each line its widest child",
      "viewport": { "width": 60.0, "height": 50.0 },
      "container": { "kind": "stack", "axis": "vertical", "gap": "none", "padding": { "all": "xs" }, "align": "stretch", "justify": "center", "grow": false, "wrap": true },
      "children": [
        { "kind": "text", "size": [30.0, 10.0] },
        { "kind": "leaf", "layout": { "kind": "leaf", "width": { "fixed": "xl" }, "height": { "fixed": "lg" } } },
        { "kind": "text", "size": [40.0, 20.0] }
      ],
      "expected": [
        { "x": 3.2, "y": 10.4, "width": 30.0, "height": 10.0 },
        { "x": 3.2, "y": 20.4, "width": 25.6, "height": 19.2 },
        { "x": 33.2, "y": 15.0, "width": 40.0, "height": 20.0 }
      ]
    }
  ]
}
