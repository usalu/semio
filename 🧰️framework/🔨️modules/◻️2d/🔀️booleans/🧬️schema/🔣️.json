{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/2d/booleans",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "operands",
    "epsilon",
    "maxEdges",
    "maxParameters",
    "maxAtomicEdges",
    "maxSegments",
    "maxWork"
  ],
  "properties": {
    "operation": {
      "enum": [
        "union",
        "difference",
        "intersection",
        "xor"
      ]
    },
    "operands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contours",
          "fillRule"
        ],
        "properties": {
          "contours": {
            "type": "array",
            "maxItems": 65536,
            "items": {
              "type": "array",
              "maxItems": 262144,
              "items": {
                "$ref": "#/definitions/point"
              }
            }
          },
          "fillRule": {
            "enum": [
              "nonzero",
              "evenodd"
            ]
          }
        }
      }
    },
    "epsilon": {
      "type": "number",
      "minimum": 1e-12,
      "maximum": 16
    },
    "maxEdges": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "maxParameters": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "maxAtomicEdges": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "maxSegments": {
      "type": "integer",
      "minimum": 1,
      "maximum": 327680
    },
    "maxWork": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    }
  },
  "definitions": {
    "coordinate": {
      "type": "number",
      "minimum": -1000000000000,
      "maximum": 1000000000000
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/coordinate"
      }
    },
    "result": {
      "type": "array",
      "maxItems": 327680,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "move",
                  "line"
                ]
              },
              "to": {
                "$ref": "#/definitions/point"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "close"
              }
            }
          }
        ]
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "operands",
        "vertices",
        "edges",
        "parameters",
        "pairs",
        "atomicEdges",
        "boundaryEdges",
        "contours",
        "segments",
        "work",
        "done"
      ],
      "properties": {
        "phase": {
          "enum": [
            "preparing",
            "indexing",
            "intersections",
            "splitting",
            "classifying",
            "contours",
            "compacting",
            "emitting",
            "complete"
          ]
        },
        "operands": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "vertices": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "edges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "parameters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "pairs": {
          "type": "integer",
          "minimum": 0
        },
        "atomicEdges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "boundaryEdges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "contours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "segments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 327680
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "done": {
          "type": "boolean"
        }
      }
    },
    "retirementProgress": {
      "description": "Structural private-owner cleanup after source operands and valid completed output move to the caller. Work is not allocator byte credit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "work",
        "done"
      ],
      "properties": {
        "phase": {
          "enum": [
            "closing",
            "complete"
          ]
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "phase": {
              "const": "closing"
            },
            "done": {
              "const": false
            }
          }
        },
        {
          "properties": {
            "phase": {
              "const": "complete"
            },
            "done": {
              "const": true
            }
          }
        }
      ]
    }
  }
}
