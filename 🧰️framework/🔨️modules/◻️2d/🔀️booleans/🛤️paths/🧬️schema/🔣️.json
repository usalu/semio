{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://semio.tech/framework/2d/booleans/paths",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "operation",
  "operands",
  "epsilon",
  "maxEdges",
  "maxParameters",
  "maxAtomicEdges",
  "maxSegments",
  "maxWork"
 ],
 "properties": {
  "operation": {
   "enum": [
    "union",
    "difference",
    "intersection",
    "xor"
   ]
  },
  "operands": {
   "type": "array",
   "minItems": 1,
   "maxItems": 1024,
   "items": {
    "type": "object",
    "required": [
     "segments",
     "transform",
     "tolerance",
     "fillRule"
    ],
    "additionalProperties": false,
    "properties": {
     "segments": {
      "$ref": "https://semio.tech/framework/2d/flatten#/properties/segments"
     },
     "transform": {
      "$ref": "https://semio.tech/framework/2d/flatten#/properties/transform"
     },
     "tolerance": {
      "$ref": "https://semio.tech/framework/2d/flatten#/properties/tolerance"
     },
     "fillRule": {
      "enum": [
       "nonzero",
       "evenodd"
      ]
     }
    }
   }
  },
  "epsilon": {
   "type": "number",
   "minimum": 1e-12,
   "maximum": 16
  },
  "maxEdges": {
   "type": "integer",
   "minimum": 1,
   "maximum": 65536,
   "description": "Caps aggregate source segments and aggregate flattened points."
  },
  "maxParameters": {
   "type": "integer",
   "minimum": 1,
   "maximum": 262144
  },
  "maxAtomicEdges": {
   "type": "integer",
   "minimum": 1,
   "maximum": 65536
  },
  "maxSegments": {
   "type": "integer",
   "minimum": 1,
   "maximum": 65536
  },
  "maxWork": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1000000000
  }
 },
 "definitions": {
  "coordinate": {
   "type": "number",
   "minimum": -1000000000000,
   "maximum": 1000000000000
  },
  "point": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "$ref": "#/definitions/coordinate"
   }
  },
  "result": {
   "$ref": "https://semio.tech/framework/2d/booleans#/definitions/result"
  },
  "progress": {
   "type": "object",
   "required": [
    "phase",
    "operands",
    "sourceSegments",
    "points",
    "work",
    "flatten",
    "boolean",
    "done"
   ],
   "additionalProperties": false,
   "properties": {
    "phase": {
     "enum": [
      "admitting",
      "flattening",
      "transforming",
      "boolean",
      "complete"
     ]
    },
    "operands": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1024
    },
    "sourceSegments": {
     "type": "integer",
     "minimum": 0,
     "maximum": 65536
    },
    "points": {
     "type": "integer",
     "minimum": 0,
     "maximum": 65536
    },
    "work": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1000000000
    },
    "flatten": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "phase",
        "completed",
        "total",
        "points",
        "work",
        "done"
       ],
       "additionalProperties": false,
       "properties": {
        "phase": {
         "enum": [
          "preparing",
          "subdividing",
          "complete"
         ]
        },
        "completed": {
         "type": "integer",
         "minimum": 0
        },
        "total": {
         "type": "integer",
         "minimum": 0
        },
        "points": {
         "type": "integer",
         "minimum": 0
        },
        "work": {
         "type": "integer",
         "minimum": 0
        },
        "done": {
         "type": "boolean"
        }
       }
      }
     ]
    },
    "boolean": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "$ref": "https://semio.tech/framework/2d/booleans#/definitions/progress"
      }
     ]
    },
    "done": {
     "type": "boolean"
    }
   }
  },
  "retirementProgress": {
   "description": "Composed child cleanup and private parent state retire under structural work grants; only valid completed paths move to the caller. TypeScript source arrays remain caller-owned. Work is not allocator byte credit.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "phase",
    "work",
    "done"
   ],
   "properties": {
    "phase": {
     "enum": [
      "closing",
      "complete"
     ]
    },
    "work": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991
    },
    "done": {
     "type": "boolean"
    }
   },
   "oneOf": [
    {
     "properties": {
      "phase": {
       "const": "closing"
      },
      "done": {
       "const": false
      }
     }
    },
    {
     "properties": {
      "phase": {
       "const": "complete"
      },
      "done": {
       "const": true
      }
     }
    }
   ]
  }
 }
}
