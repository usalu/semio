{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Drawing Text Line Fixtures",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "content",
          "lines",
          "size",
          "extent"
        ],
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "extent": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
