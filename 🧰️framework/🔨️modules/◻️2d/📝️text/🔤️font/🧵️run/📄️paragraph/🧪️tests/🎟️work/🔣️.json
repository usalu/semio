{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "font",
    "quanta",
    "cancelPhases",
    "invalidSpan",
    "flow",
    "rules"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "font": {
      "const": "⌨️share-tech-mono/🏛️latin/📖️regular"
    },
    "quanta": {
      "const": [
        1,
        7
      ]
    },
    "cancelPhases": {
      "const": [
        "source",
        "measure",
        "childArchive",
        "order",
        "sort",
        "metrics",
        "wrap",
        "emitLine",
        "lineStyle",
        "lineShape",
        "glyph",
        "segment",
        "archive"
      ]
    },
    "invalidSpan": {
      "const": {
        "start": 1,
        "end": 2,
        "size": 12,
        "tracking": 0,
        "face": 32
      }
    },
    "flow": {
      "const": {
        "text": "one two three",
        "width": 45,
        "height": 16,
        "origin": [
          0,
          0
        ],
        "expectedPauses": 2,
        "expectedSourceEnds": [
          4,
          8
        ],
        "expectedLines": [
          "one ",
          "two ",
          "three"
        ]
      }
    },
    "rules": {
      "const": {
        "sameCatalogOriginalBank": true,
        "actualLineBreakRunSources": true,
        "sourceAnalysisOnce": true,
        "realReadonlySpansNoArrayClone": true,
        "paidMergeSortWrites": true,
        "actualChildCpuSemantic": true,
        "twoLineRowsSeparate": true,
        "pausedCachedZero": true,
        "linePlacementBorrowedReadonly": true,
        "failureFinalCpuPositive": true,
        "producerOutputSameBankClose": true,
        "reference": "original-paragraph-goldens-opentype-sharp-sql"
      }
    }
  }
}
