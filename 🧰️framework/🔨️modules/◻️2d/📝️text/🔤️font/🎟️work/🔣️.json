{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/framework/text/font/work",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "values",
    "elementBytes",
    "maximumHolds",
    "materializationValues",
    "admission",
    "typographyOriginal",
    "sourceIdentity"
  ],
  "properties": {
    "values": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 17
    },
    "elementBytes": {
      "const": 8
    },
    "maximumHolds": {
      "const": 64
    },
    "materializationValues": {
      "type": "integer",
      "minimum": 4097
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font",
        "text",
        "original"
      ],
      "properties": {
        "font": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "original": {
          "$ref": "#/$defs/grant"
        }
      }
    },
    "typographyOriginal": {
      "$ref": "#/$defs/grant"
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sameLengthReplacement",
        "sameOwner"
      ],
      "properties": {
        "sameLengthReplacement": {
          "const": "refuse"
        },
        "sameOwner": {
          "const": "resume"
        }
      }
    }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "retirementDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "properties": {
        "copyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "retirementStates": {
      "enum": [
        "payload",
        "backing",
        "empty"
      ]
    }
  }
}
