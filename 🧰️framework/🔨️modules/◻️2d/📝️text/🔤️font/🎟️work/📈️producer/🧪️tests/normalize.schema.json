{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Actual Unicode Normalizer Funding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stock",
    "fuel",
    "turn",
    "cases",
    "rules"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "stock": {
      "const": [
        2048,
        131072,
        131072,
        131072,
        64
      ]
    },
    "fuel": {
      "const": 2048
    },
    "turn": {
      "const": [
        1,
        131072,
        131072,
        131072,
        64
      ]
    },
    "cases": {
      "const": [
        {
          "name": "ascii",
          "text": "ab",
          "expected": "ab"
        },
        {
          "name": "hangul-pair",
          "text": "가",
          "expected": "가"
        },
        {
          "name": "hangul-triple",
          "text": "각",
          "expected": "각"
        }
      ]
    },
    "rules": {
      "const": {
        "sameFiniteStock": true,
        "preparationSemanticZero": true,
        "sameLedger": true,
        "fixedHangulHeader": true,
        "actualCpuIndependent": true,
        "reference": "system-icu-nfc",
        "closeReleaseConserved": true
      }
    }
  }
}
