{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "type":"array","minItems":16,"maxItems":16,
 "items":{"type":"object","additionalProperties":false,"required":["name","source","stop","work","output"],
  "properties":{
   "name":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},
   "stop":{"enum":["fresh","preparing","source","offset","walk","finish","outline","queue","round","done","failure","cancelled"]},
   "repeat":{"type":"integer","minimum":1,"maximum":4096},"publishedBeforeCancel":{"type":"boolean"},"cancelBeforeTransfer":{"type":"boolean"},"output":{"type":"boolean"},
   "work":{"type":"object","additionalProperties":false,"required":["native","typescript"],"properties":{"native":{"type":"integer","minimum":10,"maximum":200000},"typescript":{"type":"integer","minimum":10,"maximum":200000}}}
  },
  "allOf":[{"if":{"required":["publishedBeforeCancel"],"properties":{"publishedBeforeCancel":{"const":true}}},"then":{"properties":{"stop":{"const":"done"},"output":{"const":false}}}},{"if":{"required":["cancelBeforeTransfer"],"properties":{"cancelBeforeTransfer":{"const":true}}},"then":{"properties":{"stop":{"const":"done"},"output":{"const":false}}}}]
 }
}
