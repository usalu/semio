[
 {"name":"empty","input":{"segments":[],"transform":[1,0,0,1,0,0],"tolerance":0.5},"expected":[]},
 {"name":"implicit origin","input":{"segments":[{"kind":"line","to":[2,1]}],"transform":[1,0,0,1,0,0],"tolerance":0.5},"expected":[{"points":[[0,0],[2,1]],"closed":false}]},
 {"name":"open polyline","input":{"segments":[{"kind":"move","to":[1,2]},{"kind":"line","to":[3,2]},{"kind":"line","to":[3,4]}],"transform":[1,0,0,1,0,0],"tolerance":0.5},"expected":[{"points":[[1,2],[3,2],[3,4]],"closed":false}]},
 {"name":"closed contour","input":{"segments":[{"kind":"move","to":[1,2]},{"kind":"line","to":[3,2]},{"kind":"line","to":[3,4]},{"kind":"close"}],"transform":[1,0,0,1,0,0],"tolerance":0.5},"expected":[{"points":[[1,2],[3,2],[3,4]],"closed":true}]},
 {"name":"line after close","input":{"segments":[{"kind":"move","to":[1,2]},{"kind":"line","to":[3,2]},{"kind":"close"},{"kind":"line","to":[4,4]}],"transform":[1,0,0,1,0,0],"tolerance":0.5},"expected":[{"points":[[1,2],[3,2]],"closed":true},{"points":[[1,2],[4,4]],"closed":false}]},
 {"name":"multiple contours","input":{"segments":[{"kind":"move","to":[0,0]},{"kind":"line","to":[1,0]},{"kind":"move","to":[2,1]},{"kind":"line","to":[2,1]},{"kind":"close"}],"transform":[1,0,0,1,0,0],"tolerance":0.5},"expected":[{"points":[[0,0],[1,0]],"closed":false},{"points":[[2,1],[2,1]],"closed":true}]},
 {"name":"quadratic subdivision","input":{"segments":[{"kind":"move","to":[0,0]},{"kind":"quad","ctrl":[1,2],"to":[2,0]}],"transform":[1,0,0,1,0,0],"tolerance":0.5},"expected":[{"points":[[0,0],[1,1],[2,0]],"closed":false}]},
 {"name":"cubic subdivision","input":{"segments":[{"kind":"move","to":[0,0]},{"kind":"cubic","ctrl1":[0,1],"ctrl2":[1,1],"to":[1,0]}],"transform":[1,0,0,1,0,0],"tolerance":0.3},"expected":[{"points":[[0,0],[0.5,0.75],[1,0]],"closed":false}]},
 {"name":"transformed flatness retains local points","input":{"segments":[{"kind":"move","to":[0,0]},{"kind":"quad","ctrl":[1,2],"to":[2,0]}],"transform":[4,0,0,4,3,2],"tolerance":1},"expected":[{"points":[[0,0],[0.5,0.75],[1,1],[1.5,0.75],[2,0]],"closed":false}]},
 {"name":"collinear reversing cubic","input":{"segments":[{"kind":"move","to":[0,0]},{"kind":"cubic","ctrl1":[3,0],"ctrl2":[-3,0],"to":[0,0]}],"transform":[1,0,0,1,0,0],"tolerance":1},"expected":[{"points":[[0,0],[0.84375,0],[0,0],[-0.84375,0],[0,0]],"closed":false}]},
 {"name":"zero arc radius becomes line","input":{"segments":[{"kind":"move","to":[1,0]},{"kind":"arc","rx":0,"ry":1,"rotation":20,"largeArc":false,"sweep":true,"to":[0,1]}],"transform":[1,0,0,1,0,0],"tolerance":0.5},"expected":[{"points":[[1,0],[0,1]],"closed":false}]},
 {"name":"equal arc endpoints are omitted","input":{"segments":[{"kind":"move","to":[1,0]},{"kind":"arc","rx":1,"ry":1,"rotation":0,"largeArc":true,"sweep":true,"to":[1,0]}],"transform":[1,0,0,1,0,0],"tolerance":0.5},"expected":[{"points":[[1,0]],"closed":false}]},
 {"name":"quarter circle","input":{"segments":[{"kind":"move","to":[1,0]},{"kind":"arc","rx":1,"ry":1,"rotation":0,"largeArc":false,"sweep":true,"to":[0,1]}],"transform":[1,0,0,1,0,0],"tolerance":0.6},"expected":[{"points":[[1,0],[0,1]],"closed":false}]},
 {"name":"semicircle exact midpoint","input":{"segments":[{"kind":"move","to":[1,0]},{"kind":"arc","rx":1,"ry":1,"rotation":0,"largeArc":false,"sweep":true,"to":[-1,0]}],"transform":[1,0,0,1,0,0],"tolerance":1},"expected":[{"points":[[1,0],[0,1],[-1,0]],"closed":false}]},
 {"name":"corrected radii","input":{"segments":[{"kind":"move","to":[-2,0]},{"kind":"arc","rx":1,"ry":1,"rotation":0,"largeArc":false,"sweep":true,"to":[2,0]}],"transform":[1,0,0,1,0,0],"tolerance":2},"expected":[{"points":[[-2,0],[0,-2],[2,0]],"closed":false}]},
 {"name":"singular transform permits coarse curve","input":{"segments":[{"kind":"move","to":[0,0]},{"kind":"quad","ctrl":[1,2],"to":[2,0]}],"transform":[0,0,0,0,5,5],"tolerance":0.5},"expected":[{"points":[[0,0],[2,0]],"closed":false}]},
 {"name":"tiny radii correction avoids overflowing endpoint ratios","input":{"segments":[{"kind":"move","to":[-2,0]},{"kind":"arc","rx":1e-300,"ry":1e-300,"rotation":0,"largeArc":false,"sweep":true,"to":[2,0]}],"transform":[1,0,0,1,0,0],"tolerance":2},"expected":[{"points":[[-2,0],[0,-2],[2,0]],"closed":false}]}
]
