{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.geometry.work-retirement/v1",
  "$ref": "#/$defs/WorkRetirementProgress",
  "$defs": {
    "WorkRetirementProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "work",
        "done"
      ],
      "properties": {
        "phase": {
          "enum": [
            "closing",
            "complete"
          ]
        },
        "work": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "done": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "const": "complete"
              }
            }
          },
          "else": {
            "properties": {
              "phase": {
                "const": "closing"
              }
            }
          }
        }
      ]
    }
  }
}
