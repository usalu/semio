{
  "name": "@semio-tech/compute-ownership-runner",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "sharedGlobals",
