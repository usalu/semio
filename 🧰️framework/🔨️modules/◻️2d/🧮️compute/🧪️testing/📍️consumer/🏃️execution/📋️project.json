        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/🧪️testing/**/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🏃️process/🧭️routing/**/*"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/◻️2d/🧮️compute/🧪️testing/📍️consumer/🏃️execution",
        "command": "repo ./📜️script.ts test"
      }
