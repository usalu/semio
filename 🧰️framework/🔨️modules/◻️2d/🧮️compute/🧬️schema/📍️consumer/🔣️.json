{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/2d/compute/consumer.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "source",
    "manifest",
    "bindings"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "EngineKey",
          "EngineHandle",
          "EngineFault",
          "Engine",
          "EngineHandles",
          "EngineCache",
          "EngineRep"
        ]
      }
    }
  }
}
