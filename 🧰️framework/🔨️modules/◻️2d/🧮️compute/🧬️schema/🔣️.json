{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Neutral Compute Engine Portable Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "keyEncoding",
    "retainedNativeLaws",
    "keys",
    "distinctTuples",
    "representations",
    "scenarios",
    "invalidIdentities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "keyEncoding": {
      "const": "u64le-length-fields"
    },
    "retainedNativeLaws": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "register_and_derive_echoes_input",
          "derive_twice_same_key_is_cache_hit",
          "eviction_when_budget_exceeded",
          "unknown_engine_fault",
          "engine_key_is_stable",
          "engine_rep_build_is_deterministic"
        ]
      }
    },
    "keys": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "engineId",
          "inputHex",
          "preimageHex",
          "keyHex"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "engineId": {
            "type": "string",
            "pattern": "^[^\\uD800-\\uDFFF]*$"
          },
          "inputHex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "preimageHex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "keyHex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "distinctTuples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "left",
          "right"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "representations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "values",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "total",
              "len"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "len": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "budgetBytes",
          "operations",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "budgetBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/Operation"
            }
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/Result"
            }
          }
        }
      }
    },
    "invalidIdentities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "utf16Units",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "const": "non-scalar-unicode"
          },
          "utf16Units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        }
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "$defs": {
    "Operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "engineId",
            "mode"
          ],
          "properties": {
            "op": {
              "const": "register"
            },
            "engineId": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "echo",
                "double",
                "empty",
                "compute-fault",
                "invalid-input"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key",
            "handle"
          ],
          "properties": {
            "op": {
              "const": "derive"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "handle"
          ],
          "properties": {
            "op": {
              "const": "read"
            },
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "key"
          ],
          "properties": {
            "op": {
              "const": "read-key"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "handle",
            "engineId"
          ],
          "properties": {
            "op": {
              "const": "read-forged"
            },
            "handle": {
              "type": "string",
              "minLength": 1
            },
            "engineId": {
              "type": "string"
            }
          }
        }
      ]
    },
    "Result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries",
            "usedBytes",
            "lru"
          ],
          "properties": {
            "kind": {
              "const": "registered"
            },
            "entries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "usedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lru": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "entries",
            "usedBytes",
            "lru"
          ],
          "properties": {
            "kind": {
              "const": "derived"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "entries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "usedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lru": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outputHex",
            "entries",
            "usedBytes",
            "lru"
          ],
          "properties": {
            "kind": {
              "const": "read"
            },
            "outputHex": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$"
            },
            "entries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "usedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lru": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "entries",
            "usedBytes",
            "lru"
          ],
          "properties": {
            "kind": {
              "const": "fault"
            },
            "code": {
              "enum": [
                "UnknownEngine",
                "Compute",
                "InvalidInput",
                "Evicted"
              ]
            },
            "entries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "usedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lru": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
