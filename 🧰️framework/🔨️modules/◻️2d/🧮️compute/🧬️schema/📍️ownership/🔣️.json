{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/2d/compute/ownership.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "unit",
    "retainedUnitSha256",
    "removed",
    "family",
    "laws",
    "cacheBehavior",
    "consumers",
    "constructorPolicy"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "const": "🧰️framework/🔨️modules/◻️2d/🧮️compute/🦀️.rs"
    },
    "unit": {
      "const": "🧰️framework/🔨️modules/◻️2d/🧮️compute/🧪️tests/🔬️unit/🦀️.rs"
    },
    "retainedUnitSha256": {
      "const": "96ea271d3e9e0e809d325e1f7a33d6d21d1f767129d654009c069b7b358962dc"
    },
    "removed": {
      "const": "🧰️framework/🛍️products/💻️os/🔨️modules/⚙️engine/🦀️.rs"
    },
    "family": {
      "const": [
        "EngineKey",
        "EngineHandle",
        "EngineFault",
        "Engine",
        "EngineHandles",
        "EngineCache",
        "EngineRep"
      ]
    },
    "laws": {
      "const": [
        "register_and_derive_echoes_input",
        "derive_twice_same_key_is_cache_hit",
        "eviction_when_budget_exceeded",
        "unknown_engine_fault",
        "engine_key_is_stable",
        "engine_rep_build_is_deterministic"
      ]
    },
    "cacheBehavior": {
      "const": {
        "oversizedOutput": "retain-after-evicting-all",
        "registerReplacement": "keep-existing-entries",
        "readHandle": "key-only",
        "readRecency": "unchanged"
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "manifest",
          "bindings"
        ],
        "properties": {
          "id": {
            "enum": [
              "flow-drawing",
              "puzzle-brush-cache",
              "plugin-sdk",
              "host-component-fixture",
              "hub-space"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "bindings": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "enum": [
                "EngineKey",
                "EngineHandle",
                "EngineFault",
                "Engine",
                "EngineHandles",
                "EngineCache",
                "EngineRep"
              ]
            }
          }
        }
      }
    },
    "constructorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owners",
        "cases"
      ],
      "properties": {
        "owners": {
          "const": [
            "🧰️framework/🔨️modules/◻️2d/🧮️compute",
            "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin"
          ]
        },
        "cases": {
          "type": "array",
          "const": [
            {"id":"canonical-owner","path":"🧰️framework/🔨️modules/◻️2d/🧮️compute/🦀️.rs","allowed":true},
            {"id":"canonical-original-laws","path":"🧰️framework/🔨️modules/◻️2d/🧮️compute/🧪️tests/🔬️unit/🦀️.rs","allowed":true},
            {"id":"retained-plugin-owner","path":"🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🦀️.rs","allowed":true},
            {"id":"retained-plugin-child","path":"🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🖥️host/🦀️.rs","allowed":true},
            {"id":"removed-os-owner","path":"🧰️framework/🛍️products/💻️os/🔨️modules/⚙️engine/🦀️.rs","allowed":false},
            {"id":"canonical-sibling-prefix","path":"🧰️framework/🔨️modules/◻️2d/🧮️compute-foreign/🦀️.rs","allowed":false},
            {"id":"plugin-sibling-prefix","path":"🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin-shadow/🦀️.rs","allowed":false},
            {"id":"foreign-owner","path":"✏️s/🔌️plugins/🧩️puzzle/🦀️.rs","allowed":false},
            {"id":"native-windows-owner","path":"🧰️framework\\🔨️modules\\◻️2d\\🧮️compute\\🦀️.rs","allowed":true},
            {"id":"raw-parent-traversal","path":"🧰️framework/🔨️modules/◻️2d/🧮️compute/../foreign/🦀️.rs","allowed":false},
            {"id":"legacy-rep-debt-path","path":"🧰️framework/🔨️modules/◻️2d/🗄️store/🦀️.rs","allowed":false}
          ],
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "allowed"
            ],
            "properties": {
              "id": {
                "enum": [
                  "canonical-owner",
                  "canonical-original-laws",
                  "retained-plugin-owner",
                  "retained-plugin-child",
                  "removed-os-owner",
                  "canonical-sibling-prefix",
                  "plugin-sibling-prefix",
                  "foreign-owner",
                  "native-windows-owner",
                  "raw-parent-traversal",
                  "legacy-rep-debt-path"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "allowed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
