{
  "name": "@semio-tech/framework-2d-js",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/◻️2d/🧪️tests/🎚️config/🟦️.ts",
      "{workspaceRoot}/🧰️framework/🔨️modules/◻️2d/🛤️path/**/*",
