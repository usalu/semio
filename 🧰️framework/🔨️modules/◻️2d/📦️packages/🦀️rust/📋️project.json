{
  "name": "semio-framework-2d",
  "$schema": "../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/◻️2d/**/*.rs",
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/◻️2d/🛤️path/**/*.json",
      "{workspaceRoot}/🧰️framework/🔨️modules/◻️2d/🔍️trace/**/*.json",
      "{workspaceRoot}/🧰️framework/🔨️modules/◻️2d/🔀️booleans/**/*.json",
      "sharedGlobals"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ],
    "cargoToolchain": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml"
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/◻️2d/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-compute": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain",
        "^production"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/◻️2d/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test compute",
        "forwardAllArgs": true
      }
    },
    "test-compute-keys": {
      "executor": "repo:script",
      "cache": true,
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain",
        "^production"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/◻️2d/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test compute keys",
        "forwardAllArgs": true
      }
    }
  }
}
