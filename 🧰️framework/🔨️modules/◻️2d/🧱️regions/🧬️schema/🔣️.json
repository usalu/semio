{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/2d/regions",
  "type": "object",
  "required": ["offsets", "booleans"],
  "additionalProperties": false,
  "properties": {
    "offsets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "outer", "holes", "distance", "join", "expected"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "outer": { "$ref": "#/definitions/ring" },
          "holes": { "type": "array", "items": { "$ref": "#/definitions/ring" } },
          "distance": { "type": "number" },
          "join": {
            "oneOf": [
              { "type": "object", "required": ["kind", "limit"], "additionalProperties": false, "properties": { "kind": { "const": "miter" }, "limit": { "type": "number", "minimum": 1 } } },
              { "type": "object", "required": ["kind"], "additionalProperties": false, "properties": { "kind": { "const": "bevel" } } },
              { "type": "object", "required": ["kind", "tolerance"], "additionalProperties": false, "properties": { "kind": { "const": "round" }, "tolerance": { "type": "number", "exclusiveMinimum": 0 } } }
            ]
          },
          "expected": {
            "type": "object",
            "required": ["regions", "holes", "area", "tolerance"],
            "additionalProperties": false,
            "properties": {
              "regions": { "type": "integer", "minimum": 0 },
              "holes": { "type": "integer", "minimum": 0 },
              "area": { "type": "number", "minimum": 0 },
              "tolerance": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "booleans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "operation", "subject", "clip", "expected"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "operation": { "enum": ["union", "difference", "intersection", "xor"] },
          "subject": { "type": "array", "items": { "$ref": "#/definitions/ring" } },
          "clip": { "type": "array", "items": { "$ref": "#/definitions/ring" } },
          "expected": {
            "type": "object",
            "required": ["regions", "holes", "area"],
            "additionalProperties": false,
            "properties": {
              "regions": { "type": "integer", "minimum": 0 },
              "holes": { "type": "integer", "minimum": 0 },
              "area": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "ring": { "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/point" } }
  }
}
