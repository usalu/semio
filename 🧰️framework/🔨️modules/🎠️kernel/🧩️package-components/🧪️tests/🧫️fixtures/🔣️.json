    { "id": "an app in two components", "roster": ["a"], "components": [{ "id": "c", "apps": ["a"] }, { "id": "d", "apps": ["a"] }], "code": "package-components.shared-app", "shapeValid": true },
    { "id": "a roster app in no component", "roster": ["a", "b"], "components": [{ "id": "c", "apps": ["a"] }], "code": "package-components.unowned-app", "shapeValid": true }
