{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/kernel/package-components/cases.json",
  "title": "Package Component Cases",
  "description": "Language-neutral cases of the package components a descriptor declares: the builder registrations that produce them (Rust `PluginBuilder::component`), the component every activation loads (TypeScript `packageComponentForApp`) and the descriptors a host refuses (`readPackageComponents`).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registrations", "descriptors"],
  "definitions": {
    "appId": { "type": "string", "minLength": 1 },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "apps"],
      "properties": { "id": { "type": "string" }, "apps": { "type": "array", "items": { "$ref": "#/definitions/appId" } } }
    }
  },
  "properties": {
    "schema": { "const": "semio.kernel.package-components-cases/v1" },
    "registrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["component", "apps"],
              "properties": { "component": { "type": ["string", "null"] }, "apps": { "type": "array", "items": { "$ref": "#/definitions/appId" } } }
            }
          },
          "components": { "type": ["array", "null"], "items": { "$ref": "#/definitions/declaration" } },
          "activations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["app", "component"],
              "properties": { "app": { "type": ["string", "null"] }, "component": { "type": ["string", "null"] } }
            }
          },
          "refusal": { "type": "string", "minLength": 1 }
        },
        "oneOf": [{ "required": ["components", "activations"] }, { "required": ["refusal"] }]
      }
    },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "roster", "components", "code", "shapeValid"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "roster": { "type": "array", "items": { "$ref": "#/definitions/appId" } },
          "components": {},
          "code": { "type": "string", "pattern": "^package-components\\.[a-z-]+$" },
          "shapeValid": { "type": "boolean", "description": "Whether the descriptor admission schema's `components` member accepts the value on its own, before it is held against the roster." }
        }
      }
    }
  }
}
