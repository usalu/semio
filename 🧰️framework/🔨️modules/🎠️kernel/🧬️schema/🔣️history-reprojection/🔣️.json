{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/kernel/history-reprojection/schema.json",
  "title": "HistoryReprojectionStatusFixture",
  "description": "Framework-owned EN/DE copy every shell announces in its polite status region while a history change replays before this replica adopts it (`HistoryPatch.reprojection`: a remote change, this replica's own deferred history step, a whole-document load), and the status each reprojection reads to. `{done}`/`{total}` are replayed operations, `{reason}` a refusal's history notice or the unnamed reason; a raw fault code is never shown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "note", "labels", "cases"],
  "definitions": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "de"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string", "minLength": 1 },
    "labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "en", "de"],
        "properties": {
          "key": { "type": "string", "pattern": "^(remote|step|load|reason)\\.[a-z]+$" },
          "en": { "type": "string", "minLength": 1 },
          "de": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reprojection", "title", "text", "paused", "fault"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "reprojection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["done", "total"],
            "properties": {
              "done": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "total": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "kind": { "enum": ["remote", "step", "load"] },
              "paused": { "type": "boolean" },
              "fault": { "type": "string", "minLength": 1 }
            }
          },
          "title": { "$ref": "#/definitions/localized" },
          "text": { "$ref": "#/definitions/localized" },
          "paused": { "type": "boolean" },
          "fault": { "type": ["string", "null"] }
        }
      }
    }
  }
}
