{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/pure-command/schema.json",
  "title": "PureCommandRequest",
  "type": "object",
  "required": ["invocation"],
  "additionalProperties": false,
  "properties": {
    "invocation": {
      "oneOf": [
        {"type": "object", "required": ["action"], "additionalProperties": false, "properties": {"action": {"$ref": "#/$defs/ActionInvocation"}}},
        {"type": "object", "required": ["command"], "additionalProperties": false, "properties": {"command": {"$ref": "#/$defs/CommandInvocation"}}}
      ]
    },
    "viewState": {"$ref": "https://json.schemas.assets.semio-tech.com/framework/view-context/schema.json"}
  },
  "$defs": {
    "Identifier": {"type": "string", "minLength": 1},
    "ActionInvocation": {
      "type": "object", "required": ["address", "arguments"], "additionalProperties": false,
      "properties": {
        "address": {
          "type": "object", "required": ["pluginId", "appId", "modeId", "windowKindId", "windowInstanceId", "actionId"], "additionalProperties": false,
          "properties": {
            "pluginId": {"$ref": "#/$defs/Identifier"}, "appId": {"$ref": "#/$defs/Identifier"}, "modeId": {"$ref": "#/$defs/Identifier"},
            "windowKindId": {"$ref": "#/$defs/Identifier"}, "windowInstanceId": {"$ref": "#/$defs/Identifier"}, "actionId": {"$ref": "#/$defs/Identifier"}
          }
        },
        "arguments": {"type": "object"}
      }
    },
    "CommandInvocation": {
      "type": "object", "required": ["address", "arguments"], "additionalProperties": false,
      "properties": {
        "address": {
          "type": "object", "required": ["owner", "commandId"], "additionalProperties": false,
          "properties": {"owner": {"oneOf": [
            {"const": "os"},
            {"type": "object", "required": ["plugin"], "additionalProperties": false, "properties": {"plugin": {"$ref": "#/$defs/PluginOwner"}}},
            {"type": "object", "required": ["app"], "additionalProperties": false, "properties": {"app": {"$ref": "#/$defs/AppOwner"}}},
            {"type": "object", "required": ["mode"], "additionalProperties": false, "properties": {"mode": {"$ref": "#/$defs/ModeOwner"}}}
          ]}, "commandId": {"$ref": "#/$defs/Identifier"}}
        },
        "arguments": {"type": "object"}
      }
    },
    "PluginOwner": {"type": "object", "required": ["pluginId"], "additionalProperties": false, "properties": {"pluginId": {"$ref": "#/$defs/Identifier"}}},
    "AppOwner": {"type": "object", "required": ["pluginId", "appId"], "additionalProperties": false, "properties": {"pluginId": {"$ref": "#/$defs/Identifier"}, "appId": {"$ref": "#/$defs/Identifier"}}},
    "ModeOwner": {"type": "object", "required": ["pluginId", "appId", "modeId"], "additionalProperties": false, "properties": {"pluginId": {"$ref": "#/$defs/Identifier"}, "appId": {"$ref": "#/$defs/Identifier"}, "modeId": {"$ref": "#/$defs/Identifier"}}}
  }
}
