{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Host Extension Resolution Cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["hostExtensionIds", "cases"],
  "properties": {
    "hostExtensionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "props", "retained"],
        "properties": {
          "id": { "type": "string" },
          "props": { "type": "object" },
          "retained": { "type": "boolean" }
        }
      }
    }
  }
}
