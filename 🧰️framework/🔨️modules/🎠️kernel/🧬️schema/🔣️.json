{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/kernel/schema.json",
  "title": "Kernel Schema Module",
  "definitions": {
    "dialect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "standard",
        "subset"
      ],
      "properties": {
        "artifactKind": {
          "type": "string",
          "minLength": 1
        },
        "standard": {
          "type": "string",
          "minLength": 1
        },
        "subset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "appRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "appId"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
