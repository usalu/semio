{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/kernel/history-notices/schema.json",
  "title": "History Notice Catalog",
  "description": "Framework-owned EN/DE notices of the refusals a history-lane dispatch answers outside a history-edit session (an open tool transaction, an exhausted history). Every shell shows these bytes for the code; `{n}` is the edit count a refusal names when it carries one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notices"
  ],
  "properties": {
    "notices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "en",
          "de"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-zA-Z]+\\.[a-z-]+$"
          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "de": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
