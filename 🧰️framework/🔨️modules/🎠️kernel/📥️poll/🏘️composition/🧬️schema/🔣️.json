{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/kernel/poll/composition/schema.json",
  "title": "Kernel Poll Composition Schema Module",
  "$defs": {
    "Composition": {
      "title": "Required Poll Composition Projection",
      "description": "The composition field projected from the existing poll input, not a second poll envelope or an allocation permit. The caller retains the original private activation and admitted composition owner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition"
      ],
      "properties": {
        "composition": {
          "$ref": "https://semio.tech/schema/framework/value/resident/schema.json#/$defs/Resident"
        }
      }
    },
    "CompositionFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "valid",
        "invalid",
        "partitionRefusals",
        "bindingCases"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "valid": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "input",
              "words"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "input": {
                "$ref": "https://semio.tech/schema/framework/kernel/poll/composition/schema.json#/$defs/Composition"
              },
              "words": {
                "type": "array",
                "minItems": 6,
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            }
          }
        },
        "invalid": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "input"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "input": {}
            }
          }
        },
        "partitionRefusals": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "https://semio.tech/schema/framework/value/resident/schema.json#/$defs/Resident"
          }
        },
        "bindingCases": {
          "type": "array",
          "minItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "phase",
              "sameActivation",
              "sameOwner",
              "sameConfiguration",
              "cleanup",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "phase": {
                "enum": [
                  "empty",
                  "opening",
                  "ready",
                  "closing"
                ]
              },
              "sameActivation": {
                "type": "boolean"
              },
              "sameOwner": {
                "type": "boolean"
              },
              "sameConfiguration": {
                "type": "boolean"
              },
              "cleanup": {
                "type": "boolean"
              },
              "expected": {
                "enum": [
                  "initialize-original",
                  "resume-original",
                  "close-original-opening",
                  "use-original",
                  "drain-original",
                  "refuse-retain-original"
                ]
              }
            }
          }
        }
      }
    }
  }
}
