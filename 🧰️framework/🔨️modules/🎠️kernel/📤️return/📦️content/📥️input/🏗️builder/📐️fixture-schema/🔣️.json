{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kernel-return-builder-binding-tests.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "traces",
    "readiness"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "traces": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "initial",
          "trace"
        ],
        "properties": {
          "mode": {
            "enum": [
              "bound",
              "abandoned",
              "source-release-pending",
              "revoked"
            ]
          },
          "initial": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "binding",
              "body",
              "uiSource",
              "observation",
              "evidence"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "unbound",
                  "bound",
                  "detached",
                  "settled"
                ]
              },
              "binding": {
                "enum": [
                  "null",
                  "originalBuilder",
                  "originalWitness",
                  "consumedSentinel"
                ]
              },
              "body": {
                "type": "boolean"
              },
              "uiSource": {
                "type": "boolean"
              },
              "observation": {
                "type": "boolean"
              },
              "evidence": {
                "type": "boolean"
              }
            }
          },
          "trace": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action",
                "expected"
              ],
              "properties": {
                "action": {
                  "enum": [
                    "detach",
                    "body-retire",
                    "detach-short",
                    "observe-detached-after-wrapper-fault",
                    "settle",
                    "ui-detach",
                    "settle-short",
                    "observe-settled-after-wrapper-fault",
                    "rebind",
                    "ui-forget",
                    "detach-foreign",
                    "evidence-settled",
                    "settle-foreign",
                    "operation-revoked"
                  ]
                },
                "expected": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "bytes",
                    "phase",
                    "binding",
                    "body",
                    "uiSource",
                    "observation"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "pending",
                        "ready",
                        "complete",
                        "blocked",
                        "rejected"
                      ]
                    },
                    "bytes": {
                      "enum": [
                        0,
                        64
                      ]
                    },
                    "phase": {
                      "enum": [
                        "unbound",
                        "bound",
                        "detached",
                        "settled"
                      ]
                    },
                    "binding": {
                      "enum": [
                        "null",
                        "originalBuilder",
                        "originalWitness",
                        "consumedSentinel"
                      ]
                    },
                    "body": {
                      "type": "boolean"
                    },
                    "uiSource": {
                      "type": "boolean"
                    },
                    "observation": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeBodyWitness",
        "rawPageAcknowledged",
        "wholeSourceRetired",
        "sourceMetadataAdmitted"
      ],
      "properties": {
        "runtimeBodyWitness": {
          "const": false
        },
        "rawPageAcknowledged": {
          "const": false
        },
        "wholeSourceRetired": {
          "const": false
        },
        "sourceMetadataAdmitted": {
          "const": false
        }
      }
    }
  }
}
