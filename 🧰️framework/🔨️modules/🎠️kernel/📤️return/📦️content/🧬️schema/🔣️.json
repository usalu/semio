{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/kernel/return/content/schema.json",
  "title": "Kernel Return Content Schema Module",
  "definitions": {
    "u64": {
      "$ref": "https://semio.tech/schema/framework/actor/page/schema.json#/$defs/Word"
    },
    "hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$"
    },
    "bytes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    }
  },
  "$defs": {
    "Content": {
      "title": "Canonical Kernel Return Content Declaration",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "magicHex",
        "recordFrame",
        "lengthIsAllocationPermission",
        "recordMayCrossPages",
        "finalPageEndsAtEndRecord",
        "declarationSource",
        "primitiveEncoding",
        "records",
        "uiOperations",
        "packedValue",
        "fieldDialects",
        "inputOwnership"
      ],
      "properties": {
        "id": {
          "const": "semio.kernel.return-content.v1"
        },
        "version": {
          "const": 1
        },
        "magicHex": {
          "const": "73727401"
        },
        "recordFrame": {
          "const": [
            "tag:u8",
            "bodyLength:canonical-uleb64",
            "body:exact-bodyLength-bytes"
          ]
        },
        "lengthIsAllocationPermission": {
          "const": false
        },
        "recordMayCrossPages": {
          "const": true
        },
        "finalPageEndsAtEndRecord": {
          "const": true
        },
        "declarationSource": {
          "const": "🧰️framework/🛍️products/💻️os/🔨️modules/🔌️plugin/🧬️schema/📜️.wit"
        },
        "primitiveEncoding": {
          "type": "object",
          "minProperties": 17,
          "maxProperties": 17,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "records": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "name",
              "cardinality"
            ],
            "properties": {
              "tag": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "name": {
                "enum": [
                  "metadata",
                  "lifecycle",
                  "uiBegin",
                  "uiOp",
                  "uiEnd",
                  "effect",
                  "presence",
                  "commandIngress",
                  "statusPayload",
                  "end"
                ]
              },
              "cardinality": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "statusTags": {
                "const": {
                  "idle": 0,
                  "moreWork": 1,
                  "checkpointReady": 2,
                  "faulted": 3
                }
              },
              "maximumOperationCount": {
                "const": 1153
              },
              "encoding": {
                "const": "primitiveEncoding-applied-to-exact-WIT-declaration"
              },
              "fieldsByStatus": {
                "const": {
                  "checkpointReady": [
                    "checkpoint:reactor.job-checkpoint"
                  ],
                  "faulted": [
                    "detail:list<u8>"
                  ]
                }
              }
            }
          }
        },
        "uiOperations": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "opcode",
              "name",
              "fields"
            ],
            "properties": {
              "opcode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "name": {
                "enum": [
                  "upsert",
                  "setComponent",
                  "setLayout",
                  "setActivity",
                  "setChildren",
                  "setStyle",
                  "setAccessibility",
                  "setBindings",
                  "setMenu",
                  "remove",
                  "setRoot"
                ]
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "profile": {
                "enum": [
                  "node",
                  "component"
                ]
              }
            }
          }
        },
        "packedValue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "nativeOracle",
            "recordField",
            "recordFieldType",
            "symbolTable",
            "wholeTypedToDslConversionAllowed",
            "wholePackedFieldAllocationAllowed",
            "measureAndEncode",
            "existingSceneDocumentBytesDialect"
          ],
          "properties": {
            "scope": {
              "const": "explicit-ui-operation-fields-and-presence-update-only"
            },
            "nativeOracle": {
              "const": "store::pack_rt::encode_wire_value"
            },
            "recordField": {
              "const": 1
            },
            "recordFieldType": {
              "const": "Any"
            },
            "symbolTable": {
              "const": "independent-for-each-packed-field"
            },
            "wholeTypedToDslConversionAllowed": {
              "const": false
            },
            "wholePackedFieldAllocationAllowed": {
              "const": false
            },
            "measureAndEncode": {
              "const": "retained-borrowed-typed-cursors-under-separate-item-byte-grants"
            },
            "existingSceneDocumentBytesDialect": {
              "const": "unchanged-opaque-child-of-Surface"
            }
          }
        },
        "fieldDialects": {
          "const": {
            "effects.send-message-effect.payload": "exact-original-payload-AppFrame-when-routed-from-app-exchange",
            "effects.publish-event-effect.payload": "producer-declared-event-payload-not-inferred-from-pack-alias",
            "ui-operation.packed-fields": "independent-store-wire-value-document-per-field",
            "presence.update": "independent-store-wire-value-document-of-PresenceUpdate",
            "other-pack-fields": "existing-field-owned-dialect-no-global-pack-dispatch"
          }
        },
        "inputOwnership": {
          "const": {
            "pageBufferMayOutliveInputAck": false,
            "borrowMayWaitForNextPage": false,
            "semanticStorage": "independently-owned-bounded-pages-before-inputAck",
            "semanticStorageAdmissionBeforeCopy": true,
            "pageAckPublishesUi": false,
            "uiEndPublishesWithoutValidation": false,
            "cancelAfterUiBegin": "retire-current-raw-page-and-owned-incomplete-semantic-storage-without-ui-publication"
          }
        }
      }
    },
    "ContentFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "magicHex",
        "metadata",
        "uiBegin",
        "recordVectors",
        "scalarOperationVectors",
        "invocation",
        "presence",
        "crossPage",
        "negativeSequences",
        "cancellation",
        "laws"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "magicHex": {
          "const": "73727401"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "nextWake",
            "fuelUsed",
            "effectCount",
            "presenceCount"
          ],
          "properties": {
            "status": {
              "enum": [
                "idle",
                "moreWork",
                "checkpointReady",
                "faulted"
              ]
            },
            "nextWake": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/u64"
                }
              ]
            },
            "fuelUsed": {
              "$ref": "#/definitions/u64"
            },
            "effectCount": {
              "$ref": "#/definitions/u64"
            },
            "presenceCount": {
              "$ref": "#/definitions/u64"
            }
          }
        },
        "uiBegin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipt",
            "surface",
            "baseRevision",
            "revision",
            "operationCount"
          ],
          "properties": {
            "receipt": {
              "$ref": "https://semio.tech/schema/framework/actor/lifetime/patch/schema.json#/$defs/Patch"
            },
            "surface": {
              "type": "string",
              "minLength": 1
            },
            "baseRevision": {
              "$ref": "#/definitions/u64"
            },
            "revision": {
              "$ref": "#/definitions/u64"
            },
            "operationCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1153
            }
          }
        },
        "recordVectors": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag",
              "bodyHex",
              "frameHex"
            ],
            "properties": {
              "tag": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              },
              "bodyHex": {
                "$ref": "#/definitions/hex"
              },
              "frameHex": {
                "$ref": "#/definitions/hex"
              }
            }
          }
        },
        "scalarOperationVectors": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "opcode",
              "node",
              "hex"
            ],
            "properties": {
              "name": {
                "enum": [
                  "remove",
                  "setRoot",
                  "setChildren"
                ]
              },
              "opcode": {
                "enum": [
                  4,
                  9,
                  10
                ]
              },
              "node": {
                "$ref": "#/definitions/u64"
              },
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/u64"
                }
              },
              "hex": {
                "$ref": "#/definitions/hex"
              }
            }
          }
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inReplyTo",
            "output",
            "diagnostics",
            "uiScope",
            "historyPatch",
            "messages",
            "mutations",
            "inverseGroup",
            "appFrameHex",
            "shellInstance",
            "effectBodyHex",
            "effectRecordHex",
            "uiAcknowledgement"
          ],
          "properties": {
            "inReplyTo": {
              "type": "integer",
              "minimum": 1
            },
            "output": {
              "$ref": "#/definitions/bytes"
            },
            "diagnostics": {
              "$ref": "#/definitions/bytes"
            },
            "uiScope": {
              "$ref": "#/definitions/bytes"
            },
            "historyPatch": {
              "$ref": "#/definitions/bytes"
            },
            "messages": {
              "$ref": "#/definitions/bytes"
            },
            "mutations": {
              "$ref": "#/definitions/bytes"
            },
            "inverseGroup": {
              "$ref": "#/definitions/bytes"
            },
            "appFrameHex": {
              "$ref": "#/definitions/hex"
            },
            "shellInstance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "effectBodyHex": {
              "$ref": "#/definitions/hex"
            },
            "effectRecordHex": {
              "$ref": "#/definitions/hex"
            },
            "uiAcknowledgement": {
              "const": false
            }
          }
        },
        "presence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "nodeKeyUtf8Hex",
            "labelUtf8Hex",
            "recordTag",
            "documentMutation",
            "uiAcknowledgement"
          ],
          "properties": {
            "value": {
              "const": {
                "surface": "document",
                "nodeKey": "item:根,1",
                "own": {
                  "hovered": true,
                  "selected": true
                },
                "peers": [
                  {
                    "actor": "peer-1",
                    "color": 3,
                    "hovered": true,
                    "label": "Ü"
                  }
                ],
                "ttlMs": 1000
              }
            },
            "nodeKeyUtf8Hex": {
              "$ref": "#/definitions/hex"
            },
            "labelUtf8Hex": {
              "$ref": "#/definitions/hex"
            },
            "recordTag": {
              "const": 6
            },
            "documentMutation": {
              "const": false
            },
            "uiAcknowledgement": {
              "const": false
            }
          }
        },
        "crossPage": {
          "const": {
            "pageBytes": [
              1,
              64,
              4096
            ],
            "splitEveryPrefix": true,
            "splitUtf8": true,
            "splitVarint": true,
            "largeSurfaceBytes": 8193,
            "largeOperationExceedsPage": true,
            "retainedBorrowWaitingForNextPage": false,
            "inputAckRequiresIndependentOwnedStorage": true
          }
        },
        "negativeSequences": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            }
          }
        },
        "cancellation": {
          "const": {
            "afterUiBeginBeforeUiEnd": true,
            "publishesUi": false,
            "dropsIncompletePackedRoot": false,
            "retainsExactRawInputUntilClose": true,
            "retiresOwnedSemanticPages": true
          }
        },
        "laws": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
