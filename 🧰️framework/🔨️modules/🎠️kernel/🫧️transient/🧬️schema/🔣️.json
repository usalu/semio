{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "keyed-box"
              },
              "expected": {
                "const": {
                  "same": true,
                  "current": 2
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "function-init"
              },
              "expected": {
                "const": {
                  "same": true,
                  "before": 0,
                  "after": 1,
                  "result": "ui.nav.back"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "collection-keyspaces"
              },
              "expected": {
                "const": {
                  "box": 1,
                  "map": 2,
                  "set": true,
                  "weak": 4,
                  "reused": [
                    true,
                    true,
                    true,
                    true
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "reset"
              },
              "expected": {
                "const": {
                  "replaced": [
                    true,
                    true,
                    true,
                    true
                  ],
                  "old": [
                    1,
                    2,
                    true,
                    4
                  ],
                  "fresh": [
                    9,
                    0,
                    0,
                    false
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "isolation"
              },
              "expected": {
                "const": {
                  "left": 11,
                  "right": 2,
                  "same": false,
                  "maps": [
                    1,
                    0
                  ],
                  "sets": [
                    1,
                    0
                  ],
                  "weak": [
                    true,
                    false
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "default-helpers"
              },
              "expected": {
                "const": {
                  "shared": [
                    true,
                    true,
                    true,
                    true
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "key-identities"
              },
              "expected": {
                "const": {
                  "values": [
                    1,
                    2,
                    3
                  ],
                  "distinct": [
                    true,
                    true,
                    true
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "retained-function-init"
              },
              "expected": {
                "const": {
                  "type": "function",
                  "value": "ui.nav.back"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "retained-noop-init"
              },
              "expected": {
                "const": {
                  "type": "function",
                  "before": 0,
                  "after": 1
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expected"
            ],
            "properties": {
              "id": {
                "const": "retained-isolation-reset"
              },
              "expected": {
                "const": {
                  "same": true,
                  "rightValue": 3,
                  "replaced": true,
                  "freshSize": 0,
                  "retainedWidth": 42
                }
              }
            }
          }
        ]
      }
    }
  }
}
