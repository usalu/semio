  "wireOptionShapes": {
    "note": "A WIT `option<string>` reaches a renderer decoder in either shape: the actor boundary hands over the tagged variant record, jco's direct binding hands over the bare value. A decoder that reads only one of them drops every binary export (measured on 6018: `typeof val.encoding === \"string\"` was false for {tag:\"some\",val:\"base64\"}).",
    "tagged": {
      "tag": "some",
      "val": "base64"
    },
    "taggedNone": {
      "tag": "none"
    },
    "bare": "base64"
  }
