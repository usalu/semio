{
  "schema": "semio.framework.kernel.media-export-encoding.v1",
  "owner": "🧰️framework/🔨️modules/🎠️kernel - Effect::DownloadMediaExport",
  "baseEncoding": "base64",
  "textEncoding": "utf-8",
  "note": "The law both renderers answer to: a DownloadMediaExport envelope's (data, encoding) pair becomes exactly `bytes`. `encoding: null` means `data` is the file as UTF-8 text; \"base64\" means `data` carries the bytes. Anything else is a refusal, never a silent text save.",
  "cases": [
    {
      "id": "text-utf8-ascii",
      "note": "a textual format declares no encoding and `data` IS the file",
      "filename": "generation3d.txt",
      "mimeType": "text/plain",
      "encoding": null,
      "data": "semio procedural.generation3d.dsl v1\n",
      "bytes": [115, 101, 109, 105, 111, 32, 112, 114, 111, 99, 101, 100, 117, 114, 97, 108, 46, 103, 101, 110, 101, 114, 97, 116, 105, 111, 110, 51, 100, 46, 100, 115, 108, 32, 118, 49, 10]
    },
    {
      "id": "text-utf8-multibyte",
      "note": "a textual export is UTF-8 bytes, not UTF-16 code units",
      "filename": "saeule.txt",
      "mimeType": "text/plain",
      "encoding": null,
      "data": "Säule — Höhe 3 m\n",
      "bytes": [83, 195, 164, 117, 108, 101, 32, 226, 128, 148, 32, 72, 195, 182, 104, 101, 32, 51, 32, 109, 10]
    },
    {
      "id": "text-utf8-declared-encoding",
      "note": "puzzle3d's `exportFixture` states `utf-8` EXPLICITLY; it must mean what an absent encoding means, and must not fall through an \"anything that is not base64 is text\" branch that would also swallow a genuinely unknown encoding",
      "filename": "puzzle-3d.json",
      "mimeType": "application/json",
      "encoding": "utf-8",
      "data": "{\n  \"id\": \"cube\"\n}\n",
      "bytes": [123, 10, 32, 32, 34, 105, 100, 34, 58, 32, 34, 99, 117, 98, 101, 34, 10, 125, 10]
    },
    {
      "id": "binary-dwg-base64",
      "note": "the export roster's binary row: the DWG version header must survive as bytes",
      "filename": "generation3d.dwg",
      "mimeType": "image/vnd.dwg",
      "encoding": "base64",
      "data": "QUMxMDE4AAAAAAAPAAA=",
      "bytes": [65, 67, 49, 48, 49, 56, 0, 0, 0, 0, 0, 15, 0, 0]
    },
    {
      "id": "binary-png-base64",
      "note": "PNG signature + IHDR - one byte of drift and no viewer opens it",
      "filename": "generation3d.png",
      "mimeType": "image/png",
      "encoding": "base64",
      "data": "iVBORw0KGgoAAAANSUhEUg==",
      "bytes": [137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82]
    },
    {
      "id": "binary-glb-base64",
      "note": "process3d's own binary export magic",
      "filename": "generation3d.glb",
      "mimeType": "model/gltf-binary",
      "encoding": "base64",
      "data": "Z2xURgIAAAAgAAAA",
      "bytes": [103, 108, 84, 70, 2, 0, 0, 0, 32, 0, 0, 0]
    },
    {
      "id": "binary-empty-base64",
      "note": "an empty binary export is empty bytes, never the empty string as text",
      "filename": "empty.bin",
      "mimeType": "application/octet-stream",
      "encoding": "base64",
      "data": "",
