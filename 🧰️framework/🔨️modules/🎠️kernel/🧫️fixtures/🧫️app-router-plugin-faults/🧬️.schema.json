{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppRouter per-plugin fault isolation vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "manifests", "expectedOwners", "expectedRoutes", "expectedFaults"],
  "definitions": {
    "dialect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "standard", "subset"],
      "properties": {
        "artifactKind": { "type": "string", "minLength": 1 },
        "standard": { "type": "string", "minLength": 1 },
        "subset": { "type": "string", "minLength": 1 }
      }
    },
    "appRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "appId"],
      "properties": {
        "pluginId": { "type": "string", "minLength": 1 },
        "appId": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pluginId", "apps"],
        "properties": {
          "pluginId": { "type": "string", "minLength": 1 },
          "artifactKinds": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pluginId", "version"],
              "properties": { "pluginId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
            }
          },
          "apps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "role", "dialect"],
              "properties": { "id": { "type": "string", "minLength": 1 }, "role": { "enum": ["viewer", "editor"] }, "dialect": { "$ref": "#/definitions/dialect" } }
            }
          }
        }
      }
    },
    "expectedOwners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactKind", "pluginId"],
        "properties": { "artifactKind": { "type": "string", "minLength": 1 }, "pluginId": { "type": "string", "minLength": 1 } }
      }
    },
    "expectedRoutes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dialect", "role", "entries"],
        "properties": {
          "dialect": { "$ref": "#/definitions/dialect" },
          "role": { "enum": ["viewer", "editor"] },
          "entries": { "type": "array", "items": { "$ref": "#/definitions/appRef" } }
        }
      }
    },
    "expectedFaults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pluginId", "code", "origin", "severity"],
        "properties": {
          "pluginId": { "type": "string", "minLength": 1 },
          "code": { "enum": ["surface.contribution-not-permitted", "surface.conflict"] },
          "origin": { "const": "framework" },
          "severity": { "const": "error" }
        }
      }
    }
  }
}
