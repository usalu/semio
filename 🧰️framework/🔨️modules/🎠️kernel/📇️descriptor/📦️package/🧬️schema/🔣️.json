{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/framework/kernel/package-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pluginId", "packageId", "componentSha256"],
  "properties": {
    "version": {"const": 1},
    "pluginId": {"type": "string", "minLength": 1},
    "packageId": {"type": "string", "minLength": 1},
    "componentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"}
  }
}
