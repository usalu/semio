{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original Tool Factory Admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceFields",
    "contextSource",
    "payloadSource",
    "inputSource",
    "pendingSource",
    "refusedSource",
    "demandAxes",
    "frameBirth",
    "payloadArcBirth",
    "payloadBoxRelease",
    "headerCopyBytes",
    "cancellationSource",
    "coldDefault",
    "terminalDropBytes",
    "copies",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.action-bus.original-factory-admission.v1"
    },
    "sourceFields": {
      "const": [
        "payload",
        "input",
        "checkpoint"
      ]
    },
    "contextSource": {
      "const": "originalStepContext"
    },
    "payloadSource": {
      "const": "sameOriginalBox"
    },
    "inputSource": {
      "const": "sameOriginalPages"
    },
    "pendingSource": {
      "const": "callerSlots"
    },
    "refusedSource": {
      "const": "callerSlotsAndWholeValueError"
    },
    "demandAxes": {
      "const": [
        "items",
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ]
    },
    "frameBirth": {
      "const": "exactOriginalJobLayout"
    },
    "payloadArcBirth": {
      "const": "exactSharedAllocationLayout"
    },
    "payloadBoxRelease": {
      "const": "exactOriginalPayloadLayout"
    },
    "headerCopyBytes": {
      "const": 0
    },
    "cancellationSource": {
      "const": "actualOperationDecimalPaidCursor"
    },
    "coldDefault": {
      "const": false
    },
    "terminalDropBytes": {
      "const": 0
    },
    "copies": {
      "const": [
        1,
        3,
        64
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "wire",
          "checkpoint",
          "operation",
          "generation"
        ],
        "properties": {
          "kind": {
            "enum": [
              "typed",
              "wire",
              "refusedCheckpoint"
            ]
          },
          "wire": {
            "type": "boolean"
          },
          "checkpoint": {
            "type": "boolean"
          },
          "operation": {
            "type": "integer",
            "minimum": 0
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
