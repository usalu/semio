{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 7,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "issuer",
      "work",
      "grant",
      "vacant",
      "refused",
      "accepted",
      "stage",
      "publish"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "issuer": {
        "type": "boolean"
      },
      "work": {
        "type": "boolean"
      },
      "grant": {
        "type": "boolean"
      },
      "vacant": {
        "type": "boolean"
      },
      "refused": {
        "type": "boolean"
      },
      "accepted": {
        "type": "boolean"
      },
      "stage": {
        "type": "boolean"
      },
      "publish": {
        "type": "boolean"
      }
    }
  }
}
