{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "stock",
    "cases",
    "body",
    "probe",
    "expected"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fuel",
        "capacityBytes"
      ],
      "properties": {
        "fuel": {
          "const": 4
        },
        "capacityBytes": {
          "const": 128
        }
      }
    },
    "cases": {
      "const": [
        "absent-refusal",
        "zero-loan-denial",
        "actual-body",
        "nested-same-loan",
        "actual-probe-failure",
        "paid-body-release",
        "cached-zero"
      ]
    },
    "body": {
      "const": [
        3,
        7
      ]
    },
    "probe": {
      "const": [
        255
      ]
    },
    "expected": {
      "const": {
        "work": 4,
        "copiedBytes": 0,
        "callbackDebits": 0,
        "workAfterDenial": 0,
        "nestedRecipientSubstitution": false
      }
    }
  }
}
