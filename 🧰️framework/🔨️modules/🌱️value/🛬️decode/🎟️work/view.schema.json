{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stock", "reserved", "committed", "cancelled", "views", "nextScope", "actual", "admissionCalls"],
  "properties": {
    "version": {"const": 1},
    "stock": {"type": "integer", "minimum": 0},
    "reserved": {"type": "integer", "minimum": 0},
    "committed": {"type": "integer", "minimum": 0},
    "cancelled": {"type": "integer", "minimum": 0},
    "views": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "integer", "minimum": 0}},
    "nextScope": {"type": "integer", "minimum": 0},
    "actual": {"type": "integer", "minimum": 0},
    "admissionCalls": {"type": "integer", "minimum": 0}
  }
}
