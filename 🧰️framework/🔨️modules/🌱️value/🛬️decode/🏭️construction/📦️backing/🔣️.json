{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "count",
    "text",
    "deniedWork",
    "nullWork",
    "birthWork",
    "nullOwnedBytes",
    "stock",
    "requireActualWorkRecipient",
    "unscopedWork",
    "observedBirthWork",
    "copiedHeader",
    "layoutCases",
    "workSettlement",
    "outcomeCases"
  ],
  "properties": {
    "count": {
      "const": 2
    },
    "text": {
      "const": "Native UTF8🧱"
    },
    "deniedWork": {
      "const": 0
    },
    "nullWork": {
      "const": 1
    },
    "birthWork": {
      "const": 1
    },
    "nullOwnedBytes": {
      "const": 0
    },
    "stock": {
      "const": {
        "items": 100000,
        "copyBytes": 33554432,
        "capacityBytes": 33554432,
        "releaseBytes": 33554432,
        "depth": 64,
        "fuel": 100000,
        "maximumTurns": 100000
      }
    },
    "requireActualWorkRecipient": {
      "const": true
    },
    "unscopedWork": {
      "const": 0
    },
    "observedBirthWork": {
      "const": 3
    },
    "copiedHeader": {
      "const": "target-header-size"
    },
    "layoutCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "count",
          "elementBytes",
          "allocatedBytes",
          "allocationEvent"
        ],
        "properties": {
          "kind": {
            "enum": [
              "empty",
              "zeroSized",
              "ordinary",
              "text"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "elementBytes": {
            "type": "integer",
            "minimum": 0
          },
          "allocatedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "allocationEvent": {
            "enum": [
              "none",
              "quote-post"
            ]
          }
        }
      }
    },
    "workSettlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual",
        "incorrect"
      ],
      "properties": {
        "actual": {
          "const": 1
        },
        "incorrect": {
          "const": 0
        }
      }
    },
    "outcomeCases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bytes",
          "born",
          "event"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "born": {
            "type": "boolean"
          },
          "event": {
            "enum": [
              "none",
              "cancel",
              "post"
            ]
          }
        }
      }
    }
  }
}
