{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.native-construction.typed-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "admitted",
          "primary",
          "accept",
          "output",
          "receipt"
        ],
        "properties": {
          "name": {
            "enum": [
              "denied",
              "complete",
              "resultAndReceipt",
              "primaryOnly",
              "primaryAndReceipt"
            ]
          },
          "admitted": {
            "type": "boolean"
          },
          "primary": {
            "type": "boolean"
          },
          "accept": {
            "type": "boolean"
          },
          "output": {
            "type": "boolean"
          },
          "receipt": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
