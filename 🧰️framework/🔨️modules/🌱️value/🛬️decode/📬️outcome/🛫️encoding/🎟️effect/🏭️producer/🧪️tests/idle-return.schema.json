{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "closed",
          "inert",
          "request",
          "allowed"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "closed": {
            "type": "boolean"
          },
          "inert": {
            "type": "boolean"
          },
          "request": {
            "type": "boolean"
          },
          "allowed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
