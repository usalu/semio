{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 3,
  "maxItems": 3,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind",
      "before",
      "after"
    ],
    "properties": {
      "kind": {
        "enum": [
          "success",
          "refusal",
          "panic"
        ]
      },
      "before": {
        "const": 0
      },
      "after": {
        "const": 0
      }
    }
  }
}
