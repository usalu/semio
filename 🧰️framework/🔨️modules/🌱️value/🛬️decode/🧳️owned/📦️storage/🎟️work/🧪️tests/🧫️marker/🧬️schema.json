{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "marker"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "denied",
              "zero_size",
              "failed",
              "allocated",
              "denied_preserved"
            ]
          },
          "marker": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
