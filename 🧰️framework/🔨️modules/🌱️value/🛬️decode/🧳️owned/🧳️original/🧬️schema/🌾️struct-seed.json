{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Derived Record Receiver Seed Parts",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixedParts", "partsPerField", "partsPerDefault", "cases"],
  "properties": {
    "fixedParts": {"type": "integer", "minimum": 1},
    "partsPerField": {"type": "integer", "minimum": 1},
    "partsPerDefault": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "fields", "defaults", "parts"],
        "properties": {
          "owner": {"type": "string"},
          "fields": {"type": "integer", "minimum": 0},
          "defaults": {"type": "integer", "minimum": 0},
          "parts": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
