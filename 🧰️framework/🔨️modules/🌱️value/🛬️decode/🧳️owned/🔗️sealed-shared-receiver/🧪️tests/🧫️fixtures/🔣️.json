{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "maximumCopyBytes",
    "cases",
    "laws",
    "stock",
    "ownershipCopyBytes",
    "deniedWork",
    "ownedHandoffWork"
  ],
  "properties": {
    "schema": {
      "const": "semio.native-shared-receive/v1"
    },
    "maximumCopyBytes": {
      "const": 4096
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "original",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "laws": {
      "const": [
        "original-source-binding",
        "paid-child-birth",
        "child-close-before-seal",
        "original-intrinsic-issuer",
        "denied-zero-allocation",
        "prefix-cancellation",
        "exact-physical-receipts",
        "original-output-transfer"
      ]
    },
    "stock": {
      "const": {
        "items": 100000,
        "copyBytes": 33554432,
        "capacityBytes": 33554432,
        "releaseBytes": 33554432,
        "depth": 64,
        "fuel": 100000
      }
    },
    "ownershipCopyBytes": {
      "const": 0
    },
    "deniedWork": {
      "const": 0
    },
    "ownedHandoffWork": {
      "const": 1
    },
    "workLoan": {
      "const": {
        "single": 1,
        "batch": 257,
        "origin": "same-wallet-remaining-fuel"
      }
    }
  }
}
