{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "before",
    "expected",
    "refusals",
    "foreignSourceAccepted",
    "coldConstructionRequired",
    "refusedEntries",
    "callbackRefusalAt"
  ],
  "properties": {
    "before": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "refusals": {
      "const": [
        "items",
        "copy",
        "capacity",
        "release",
        "depth"
      ]
    },
    "foreignSourceAccepted": {
      "const": false
    },
    "coldConstructionRequired": {
      "const": false
    },
    "refusedEntries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": [
          {
            "type": "string"
          },
          {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          }
        ],
        "additionalItems": false
      }
    },
    "callbackRefusalAt": {
      "const": "after-first-seal"
    }
  }
}
