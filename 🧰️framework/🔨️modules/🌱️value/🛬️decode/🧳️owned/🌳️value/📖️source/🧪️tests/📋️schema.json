{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "storage"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "input",
          "expected"
        ],
        "properties": {
          "kind": {
            "enum": [
              "sequence",
              "record"
            ]
          },
          "input": {
            "oneOf": [
              {
                "type": "array"
              },
              {
                "type": "object"
              }
            ]
          },
          "expected": {
            "type": "array"
          }
        }
      }
    },
    "storage": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "capacity",
          "index",
          "occupied",
          "value",
          "accepted"
        ],
        "properties": {
          "kind": {
            "enum": [
              "vector",
              "array"
            ]
          },
          "capacity": {
            "type": "integer",
            "minimum": 0
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "occupied": {
            "type": "boolean"
          },
          "value": {
            "type": "integer",
            "minimum": 0
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
