{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stock",
    "input",
    "cancelCuts",
    "moveWork",
    "freeWork",
    "deniedWork",
    "cachedWork",
    "poisonDropCalls",
    "freshBoxAllocations",
    "handoff"
  ],
  "properties": {
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "fuel",
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "fuel": {
          "type": "integer",
          "minimum": 1
        },
        "copyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "input": {
      "$ref": "#/$defs/node"
    },
    "cancelCuts": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "moveWork": {
      "const": 2
    },
    "freeWork": {
      "const": 2
    },
    "deniedWork": {
      "const": 0
    },
    "cachedWork": {
      "const": 0
    },
    "poisonDropCalls": {
      "const": 1
    },
    "freshBoxAllocations": {
      "const": 0
    },
    "handoff": {
      "const": [
        {
          "pointerBytes": 4,
          "copyBytes": 9
        },
        {
          "pointerBytes": 8,
          "copyBytes": 17
        }
      ]
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "children"
      ],
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
