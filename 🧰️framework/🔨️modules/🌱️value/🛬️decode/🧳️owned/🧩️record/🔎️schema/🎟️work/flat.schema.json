{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "fields",
    "cases",
    "cancelAfter"
  ],
  "additionalProperties": false,
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "ordinal"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "field",
          "comparisons"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "ordinal"
            ]
          }
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "kind": {
            "enum": [
              "field",
              "missing",
              "ambiguous"
            ]
          },
          "field": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "comparisons": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "cancelAfter": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
