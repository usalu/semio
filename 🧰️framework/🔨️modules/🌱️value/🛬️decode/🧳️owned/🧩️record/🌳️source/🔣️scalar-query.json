{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queries",
    "events",
    "calls",
    "work",
    "preserveError",
    "destination",
    "operation",
    "transfer",
    "binding",
    "bindWork",
    "transferWork"
  ],
  "properties": {
    "queries": {
      "const": [
        "kind",
        "null",
        "boolean",
        "number",
        "enumOrdinal",
        "recordLength",
        "sequenceLength"
      ]
    },
    "events": {
      "const": [
        "bind",
        "receive",
        "performed",
        "recordError",
        "unwind",
        "recoverRecorded",
        "recordOuter",
        "transfer"
      ]
    },
    "calls": {
      "const": 1
    },
    "work": {
      "const": 2
    },
    "preserveError": {
      "const": true
    },
    "destination": {
      "const": "residentFrame"
    },
    "operation": {
      "const": "immutable"
    },
    "transfer": {
      "const": "separatelyPaid"
    },
    "binding": {
      "const": "originalRetainedSource"
    },
    "bindWork": {
      "const": 1
    },
    "transferWork": {
      "const": 1
    }
  }
}
