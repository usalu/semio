{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "prefix",
    "stride",
    "firstRepeat",
    "cases",
    "cuts",
    "invalidRows",
    "interactionQuantum",
    "ownedWrapperCuts",
    "bodyReservations",
    "childCustody"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "prefix": {
      "type": "string"
    },
    "stride": {
      "type": "integer"
    },
    "firstRepeat": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "invalidRows": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "interactionQuantum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyBytes",
        "workItems",
        "maximumTurns"
      ],
      "properties": {
        "copyBytes": {
          "const": 4096
        },
        "workItems": {
          "const": 257
        },
        "maximumTurns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ownedWrapperCuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "bodyReservations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bodyBytes",
          "metadataBytes",
          "childBytes"
        ],
        "properties": {
          "bodyBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "metadataBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "childBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    "childCustody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "rows"
      ],
      "properties": {
        "storage": {
          "const": "stable-owned-allocation"
        },
        "rows": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "childBytes",
              "pointerBytes",
              "metadataBytes",
              "childCopyBytes",
              "copyBytes",
              "capacityBytes",
              "releaseBytes"
            ],
            "properties": {
              "event": {
                "enum": [
                  "birth",
                  "terminal-release"
                ]
              },
              "childBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "pointerBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "metadataBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "childCopyBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "copyBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "capacityBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "releaseBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        }
      }
    }
  }
}
