{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "prefix",
    "stride",
    "firstRepeat",
    "cases",
    "cuts",
    "invalidRows",
    "interactionQuantum",
    "ownedWrapperCuts",
    "bodyReservations",
    "childCustody",
    "controlBatch",
    "stock"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "prefix": {
      "type": "string"
    },
    "stride": {
      "type": "integer"
    },
    "firstRepeat": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "invalidRows": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "interactionQuantum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyBytes",
        "workItems",
        "maximumTurns",
        "workUnits"
      ],
      "properties": {
        "copyBytes": {
          "const": 4096
        },
        "workItems": {
          "const": 257
        },
        "maximumTurns": {
          "type": "integer",
          "minimum": 1
        },
        "workUnits": {
          "const": 257
        }
      }
    },
    "ownedWrapperCuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "bodyReservations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bodyBytes",
          "metadataBytes",
          "childBytes"
        ],
        "properties": {
          "bodyBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "metadataBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "childBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    "childCustody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage",
        "rows"
      ],
      "properties": {
        "storage": {
          "const": "stable-owned-allocation"
        },
        "rows": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "childBytes",
              "pointerBytes",
              "childOptionBytes",
              "copyBytes",
              "capacityBytes",
              "releaseBytes",
              "work"
            ],
            "properties": {
              "event": {
                "enum": [
                  "reserve",
                  "initialize",
                  "take-box",
                  "release-box",
                  "release-raw"
                ]
              },
              "childBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "pointerBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "childOptionBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "copyBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "capacityBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "releaseBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "work": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        }
      }
    },
    "controlBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumChildPosts",
        "ownershipCopyBytes",
        "independentWork",
        "matcherProbeBatch",
        "recordControlBatch",
        "sharedControlBatch",
        "compositionLaw",
        "custodyBatch"
      ],
      "properties": {
        "maximumChildPosts": {
          "const": 1
        },
        "ownershipCopyBytes": {
          "const": 0
        },
        "independentWork": {
          "const": true
        },
        "matcherProbeBatch": {
          "const": true
        },
        "recordControlBatch": {
          "const": true
        },
        "sharedControlBatch": {
          "const": true
        },
        "compositionLaw": {
          "const": {
            "items": 2,
            "value": 7,
            "copiedItems": 1,
            "copyBytes": 0,
            "workBeforeFailure": 1,
            "workLoanFromSameRemainingFuel": true,
            "noItemToCpuConversion": true,
            "independentProbeWork": 1,
            "singleTurnWork": 1,
            "batchTurnWork": 257
          }
        },
        "custodyBatch": {
          "const": true
        }
      }
    },
    "stock": {
      "const": {
        "items": 100000,
        "fuel": 100000,
        "copyBytes": 33554432,
        "capacityBytes": 33554432,
        "releaseBytes": 33554432,
        "depth": 64
      }
    }
  }
}
