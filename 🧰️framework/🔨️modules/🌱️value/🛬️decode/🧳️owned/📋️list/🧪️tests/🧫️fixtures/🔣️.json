{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "prefix",
    "stride",
    "firstRepeat",
    "cases",
    "cuts",
    "invalidRows",
    "interactionQuantum",
    "ownedWrapperCuts",
    "bodyReservations",
    "childCustody",
    "stock",
    "controlBatch"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "prefix": {
      "type": "string"
    },
    "stride": {
      "type": "integer"
    },
    "firstRepeat": {
      "type": "integer"
    },
    "cases": {
      "type": "array"
    },
    "cuts": {
      "type": "array"
    },
    "invalidRows": {
      "type": "array"
    },
    "interactionQuantum": {
      "const": {
        "copyBytes": 4096,
        "workItems": 257,
        "maximumTurns": 2048,
        "workUnits": 257
      }
    },
    "ownedWrapperCuts": {
      "type": "array"
    },
    "bodyReservations": {
      "type": "array"
    },
    "childCustody": {
      "type": "object"
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "fuel",
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "fuel": {
          "type": "integer",
          "minimum": 1
        },
        "copyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "controlBatch": {
      "const": {
        "maximumChildPosts": 1,
        "ownershipCopyBytes": 0,
        "independentWork": true,
        "matcherProbeBatch": true,
        "recordControlBatch": true,
        "sharedControlBatch": true,
        "compositionLaw": {
          "items": 2,
          "value": 7,
          "copiedItems": 1,
          "copyBytes": 25,
          "workBeforeFailure": 1,
          "workLoanFromSameRemainingFuel": true,
          "noItemToCpuConversion": true,
          "independentProbeWork": 1,
          "singleTurnWork": 1,
          "batchTurnWork": 257
        },
        "custodyBatch": true
      }
    }
  }
}
