{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "childId",
    "artifactId",
    "artifactKind",
    "standard",
    "subset",
    "repeatCount",
    "cancelAt"
  ],
  "properties": {
    "childId": {
      "type": "string"
    },
    "artifactId": {
      "type": "string"
    },
    "artifactKind": {
      "type": "string"
    },
    "standard": {
      "type": "string"
    },
    "subset": {
      "type": "string"
    },
    "repeatCount": {
      "type": "integer",
      "minimum": 1
    },
    "cancelAt": {
      "type": "integer",
      "minimum": 1
    }
  }
}
