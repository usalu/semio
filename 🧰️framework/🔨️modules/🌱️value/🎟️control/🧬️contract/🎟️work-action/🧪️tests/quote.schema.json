{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "written",
          "verdict",
          "recovered"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "written": {
            "type": "boolean"
          },
          "verdict": {
            "enum": [
              "accepted",
              "denied",
              "refused"
            ]
          },
          "recovered": {
            "enum": [
              "pending",
              "accepted",
              "denied",
              "refused"
            ]
          }
        }
      }
    }
  }
}
