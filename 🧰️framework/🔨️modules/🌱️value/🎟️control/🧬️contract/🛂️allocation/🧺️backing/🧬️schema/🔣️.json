{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vectors",
    "strings"
  ],
  "properties": {
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "count",
          "bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "byte",
              "word",
              "wide",
              "zero"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          }
        }
      }
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65536
      }
    }
  }
}
