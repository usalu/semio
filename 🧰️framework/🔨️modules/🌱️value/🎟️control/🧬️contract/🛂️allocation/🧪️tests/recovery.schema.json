{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "stored",
          "available"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "stored": {
            "enum": [
              null,
              "accepted",
              "refused"
            ]
          },
          "available": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
