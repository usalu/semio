{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/value/retirement/schema.json",
  "title": "Owned Value Retirement",
  "$ref": "#/$defs/OwnedRetirement",
  "$defs": {
    "OwnedRetirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "cases",
        "budgets",
        "hostile",
        "leases",
        "capacityAdmission",
        "continuation"
      ],
      "properties": {
        "schema": {
          "const": "semio.artifact.owned-retirement/v1"
        },
        "cases": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "value",
              "bytes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "string",
                  "strings",
                  "optionalString",
                  "pair",
                  "stringMap",
                  "value",
                  "bytes",
                  "words"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "object"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  }
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "budgets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "items",
              "bytes"
            ],
            "properties": {
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "hostile": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "leases": {
          "$ref": "#/$defs/SourceLeaseLaw"
        },
        "capacityAdmission": {
          "$ref": "#/$defs/CapacityAdmissionLaw"
        },
        "continuation": {
          "$ref": "#/$defs/ContinuationLaw"
        }
      }
    },
    "PortableCapacityNumber": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        {
          "enum": [
            "usizeMax",
            "isizeMax"
          ]
        }
      ]
    },
    "SourceLeaseLaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "orders",
        "items",
        "bytes",
        "canceled",
        "sourceReleases"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "orders": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "canceled": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "boolean"
          }
        },
        "sourceReleases": {
          "const": 1
        }
      }
    },
    "ContinuationLaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumBytes",
        "initialBytes",
        "finalBytes",
        "total",
        "initialUnits",
        "finalUnits"
      ],
      "properties": {
        "maximumBytes": {
          "type": "integer",
          "minimum": 0
        },
        "initialBytes": {
          "type": "integer",
          "minimum": 0
        },
        "finalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "initialUnits": {
          "type": "integer",
          "minimum": 0
        },
        "finalUnits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CapacityAdmissionLaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sourceBytes",
        "sourceMultiples",
        "scaffoldBytes",
        "maximumBytes",
        "refusedBytes",
        "overrunBytes",
        "cases"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sourceMultiples": {
          "type": "integer",
          "minimum": 0
        },
        "scaffoldBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumBytes": {
          "type": "integer",
          "minimum": 0
        },
        "refusedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "overrunBytes": {
          "type": "integer",
          "minimum": 1
        },
        "cases": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "ownedBytes",
              "sourceBytes",
              "multiples",
              "scaffoldBytes",
              "accepted",
              "maximumBytes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "ownedBytes": {
                "$ref": "#/$defs/PortableCapacityNumber"
              },
              "sourceBytes": {
                "$ref": "#/$defs/PortableCapacityNumber"
              },
              "multiples": {
                "$ref": "#/$defs/PortableCapacityNumber"
              },
              "scaffoldBytes": {
                "$ref": "#/$defs/PortableCapacityNumber"
              },
              "accepted": {
                "type": "boolean"
              },
              "maximumBytes": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PortableCapacityNumber"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "accepted": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "maximumBytes": {
                      "$ref": "#/$defs/PortableCapacityNumber"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "maximumBytes": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
