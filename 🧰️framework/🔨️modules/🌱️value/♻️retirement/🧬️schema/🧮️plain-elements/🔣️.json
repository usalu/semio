{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "law",
    "workBytes",
    "overheadTurns",
    "counts",
    "elementWiseControlCount",
    "elementWiseControlMinimumTurns",
    "widthCases"
  ],
  "properties": {
    "schema": {
      "const": "semio.artifact.plain-element-retirement/v1"
    },
    "law": {
      "type": "string",
      "minLength": 1
    },
    "workBytes": {
      "const": 65536
    },
    "overheadTurns": {
      "const": 16
    },
    "counts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      }
    },
    "elementWiseControlCount": {
      "const": 512
    },
    "elementWiseControlMinimumTurns": {
      "const": 512
    },
    "widthCases": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sizeBytes",
          "needsDrop",
          "componentBytes",
          "expectedBytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          },
          "needsDrop": {
            "type": "boolean"
          },
          "componentBytes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            }
          },
          "expectedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          }
        }
      }
    }
  }
}
