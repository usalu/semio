{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "copyGrants"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "copyGrants": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 3
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "weakAliases",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "weakAliases": {
            "type": "integer",
            "minimum": 0
          },
          "value": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
