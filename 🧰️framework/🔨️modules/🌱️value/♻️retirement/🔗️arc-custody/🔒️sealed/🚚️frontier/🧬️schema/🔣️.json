{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "admission"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "aliases",
          "expectedChildHandoffs",
          "expectedNativePayloadFrames",
          "expectedNestedQueues"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "aliases": {
            "type": "integer",
            "minimum": 0
          },
          "expectedChildHandoffs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "expectedNativePayloadFrames": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "expectedNestedQueues": {
            "const": 0
          }
        }
      }
    },
    "admission": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "supported",
          "birthKnown",
          "items",
          "capacity",
          "depth",
          "accepted"
        ],
        "properties": {
          "supported": {
            "type": "boolean"
          },
          "birthKnown": {
            "type": "boolean"
          },
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "capacity": {
            "enum": [
              "short",
              "exact"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
