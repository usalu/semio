      "present",
      "terminal",
      "child",
      "spare",
      "expected"
    ],
    "properties": {
      "pending": {
        "type": "boolean"
      },
      "present": {
        "type": "boolean"
      },
      "terminal": {
        "type": "boolean"
      },
      "child": {
        "type": "boolean"
      },
      "spare": {
        "type": "boolean"
      },
      "expected": {
