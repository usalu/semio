{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "maximumItems",
    "maximumCopyBytes",
    "maximumCapacityBytes",
    "maximumReleaseBytes",
    "cases",
    "zeroWorkInert",
    "physicalReleaseMatchesAllocator"
  ],
  "properties": {
    "schema": {
      "const": "owned-retirement-physical-work/v1"
    },
    "maximumItems": {
      "const": 1
    },
    "maximumCopyBytes": {
      "const": 64
    },
    "maximumCapacityBytes": {
      "const": 4096
    },
    "maximumReleaseBytes": {
      "const": 4096
    },
    "zeroWorkInert": {
      "const": true
    },
    "physicalReleaseMatchesAllocator": {
      "const": true
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "value",
          "processedBytes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "u32",
              "text",
              "u32-list"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "array"
            ],
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "processedBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
