{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grants", "cases", "demandObservationAllocatesBytes", "zeroOrBelowInert", "copyTurnReleasesBytes", "maximumTurnBytes"],
  "properties": {
    "schema": {"const": "controlled-retirement-copy-demand/v1"},
    "grants": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "cases": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "value", "minimumCopyBytes", "totalCopyBytes"],
        "properties": {
          "kind": {"enum": ["u32", "text", "u32-list"]},
          "value": {"anyOf": [{"type": "integer"}, {"type": "string"}, {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}}]},
          "minimumCopyBytes": {"type": "integer", "minimum": 1},
          "totalCopyBytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "demandObservationAllocatesBytes": {"const": 0},
    "zeroOrBelowInert": {"const": true},
    "copyTurnReleasesBytes": {"const": 0},
    "maximumTurnBytes": {"const": 4096}
  }
}
