{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workBytes",
    "maximumTurns",
    "buffer",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "semio.value.shared-physical-retirement.v1"
    },
    "workBytes": {
      "const": [
        1,
        3,
        5,
        4096
      ]
    },
    "maximumTurns": {
      "const": 100000
    },
    "buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "workBytes",
        "maximumTurns"
      ],
      "properties": {
        "bytes": {
          "const": 2097152
        },
        "workBytes": {
          "const": 65536
        },
        "maximumTurns": {
          "const": 36
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "capacity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "capacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          }
        }
      }
    }
  }
}
