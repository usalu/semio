{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "copyPolicies",
    "source",
    "metadataBytes",
    "rootItems",
    "sameSource",
    "heapClone",
    "coldFallback",
    "childNarrowDelegation",
    "rootCopyIsHeaderQuote",
    "unsupportedOriginal"
  ],
  "properties": {
    "copyPolicies": {
      "const": [
        1,
        3,
        64
      ]
    },
    "source": {
      "const": "Original↔Retained"
    },
    "metadataBytes": {
      "const": 256
    },
    "rootItems": {
      "const": 1
    },
    "sameSource": {
      "const": true
    },
    "heapClone": {
      "const": false
    },
    "coldFallback": {
      "const": false
    },
    "childNarrowDelegation": {
      "const": true
    },
    "rootCopyIsHeaderQuote": {
      "const": true
    },
    "unsupportedOriginal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained",
        "constructorHeapBytes",
        "demandRefusal",
        "stepRefusal",
        "refusalHeapBytes",
        "sameOriginalRecoverable"
      ],
      "properties": {
        "retained": {
          "const": true
        },
        "constructorHeapBytes": {
          "const": 0
        },
        "demandRefusal": {
          "const": "UnsupportedOwner"
        },
        "stepRefusal": {
          "const": "UnsupportedOwner"
        },
        "refusalHeapBytes": {
          "const": 0
        },
        "sameOriginalRecoverable": {
          "const": true
        }
      }
    }
  }
}
