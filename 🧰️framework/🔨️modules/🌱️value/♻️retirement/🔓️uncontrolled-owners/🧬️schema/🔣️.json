{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UncontrolledOwners",
  "description": "The complete, reasoned list of hand-written RetireOwned impls that declare controlled_retirement_supported() == false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["roots", "allowed"],
  "properties": {
    "roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "owner", "reason"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
