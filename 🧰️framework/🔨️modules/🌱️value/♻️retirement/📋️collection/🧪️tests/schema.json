{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owners",
    "values",
    "maximumItems",
    "maximumWork",
    "body",
    "remaining",
    "releaseItems",
    "minimumQuotes",
    "selectedBodyDenial",
    "fixedArray",
    "controlledPending"
  ],
  "properties": {
    "owners": {
      "const": [
        "vector",
        "deque"
      ]
    },
    "values": {
      "const": [
        11,
        23,
        37
      ]
    },
    "maximumItems": {
      "const": 1
    },
    "maximumWork": {
      "const": 1
    },
    "body": {
      "const": 64
    },
    "remaining": {
      "const": [
        2,
        1,
        0
      ]
    },
    "releaseItems": {
      "const": 1
    },
    "minimumQuotes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "body",
          "copyBytes"
        ],
        "properties": {
          "body": {
            "type": "integer",
            "minimum": 0
          },
          "copyBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "selectedBodyDenial": {
      "const": {
        "body": 64,
        "selectedCopy": 11,
        "physicalCopy": 10,
        "performedWork": 0,
        "remaining": 3
      }
    },
    "fixedArray": {
      "const": {
        "body": 64,
        "slotBytes": 2,
        "headerBytes": 8,
        "selectedCopy": 14,
        "physicalCopy": 13,
        "remaining": 3,
        "performedWork": 0
      }
    },
    "controlledPending": {
      "const": {
        "body": 64,
        "childCopyBytes": 12,
        "quotedChildWork": 2,
        "parentWork": 10,
        "receiveWork": 1,
        "recoverWork": 1,
        "calls": 1,
        "recoveries": 1,
        "initialSelectedDepth": 3,
        "shortDepth": 2,
        "deniedDepthWork": 0
      }
    }
  }
}
