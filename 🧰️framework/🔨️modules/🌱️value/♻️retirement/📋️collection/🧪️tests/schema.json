{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maximumItems",
    "maximumWork",
    "releaseItems",
    "cases"
  ],
  "properties": {
    "maximumItems": {
      "const": 1
    },
    "maximumWork": {
      "const": 1
    },
    "releaseItems": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "body",
          "run",
          "values",
          "remaining"
        ],
        "properties": {
          "owner": {
            "enum": [
              "vector",
              "deque"
            ]
          },
          "body": {
            "type": "integer",
            "minimum": 0
          },
          "run": {
            "type": "integer",
            "minimum": 1
          },
          "values": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
