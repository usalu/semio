{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/value/type/schema.json",
  "$defs": {
    "valueType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "boolean",
                "integer",
                "decimal",
                "text",
                "any"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "list"
            },
            "of": {
              "$ref": "#/$defs/valueType"
            }
          },
          "required": [
            "kind",
            "of"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "schema"
            },
            "of": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "of"
          ],
          "additionalProperties": false
        }
      ]
    },
    "valueKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "null",
                "boolean",
                "integer",
                "decimal",
                "text"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "dictionary"
            },
            "schema": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/valueType"
}
