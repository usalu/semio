{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/value/bytes/schema.json",
  "$defs": {
    "Octets": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "OutputLimit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "completed",
        "total"
      ],
      "properties": {
        "phase": {
          "enum": [
            "encode",
            "validate",
            "decode"
          ]
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
