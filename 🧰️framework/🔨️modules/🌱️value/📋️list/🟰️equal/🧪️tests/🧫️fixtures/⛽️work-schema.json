{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 6,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["left", "right", "payloadBodyBytes", "maximumWork", "work", "ready", "equal"],
    "properties": {
      "left": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
      "right": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
      "maximumWork": { "type": "integer", "minimum": 0 },
      "payloadBodyBytes": { "type": "integer", "minimum": 0 },
      "work": { "type": "integer", "minimum": 0 },
      "ready": { "type": "boolean" },
      "equal": { "type": ["boolean", "null"] }
    }
  }
}
