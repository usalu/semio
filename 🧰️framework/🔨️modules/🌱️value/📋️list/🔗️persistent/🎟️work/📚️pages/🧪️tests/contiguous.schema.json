{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exact Completed Page Admission Quote",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "elementLogicalBytes",
    "target",
    "actualPageElements",
    "actualPageLogicalBytes",
    "cachedCompletionDemand",
    "rules",
    "nested"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "elementLogicalBytes": {
      "const": 8
    },
    "target": {
      "const": 8
    },
    "actualPageElements": {
      "const": 16
    },
    "actualPageLogicalBytes": {
      "const": 128
    },
    "cachedCompletionDemand": {
      "const": {
        "copyBytes": 0,
        "capacityBytes": 0,
        "releaseBytes": 0,
        "depth": 1
      }
    },
    "rules": {
      "const": {
        "sameFiniteWallet": true,
        "noExtraDirectory": true,
        "noExtraBodyForCachedQuery": true,
        "fundedFinally": true,
        "unchangedLimits": true
      }
    },
    "nested": {
      "const": {
        "parentValue": 99,
        "parentHeldCopy": 8,
        "scopes": 2,
        "birthDepth": 5,
        "completedDepth": 2
      }
    }
  }
}
