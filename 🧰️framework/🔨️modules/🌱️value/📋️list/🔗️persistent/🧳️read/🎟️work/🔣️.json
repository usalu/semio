{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "count",
    "copyBytes",
    "stock",
    "rules"
  ],
  "properties": {
    "count": {
      "const": 33
    },
    "copyBytes": {
      "const": 0
    },
    "stock": {
      "const": {
        "items": 100000,
        "copyBytes": 33554432,
        "capacityBytes": 33554432,
        "releaseBytes": 33554432,
        "depth": 64,
        "fuel": 100000,
        "maximumTurns": 100000
      }
    },
    "rules": {
      "const": {
        "rowBorrowsOriginal": true,
        "noPayloadCopy": true,
        "pageProbeActualWork": true,
        "cachedZero": true,
        "sameFiniteBank": true,
        "independentVectorOracle": true
      }
    }
  }
}
