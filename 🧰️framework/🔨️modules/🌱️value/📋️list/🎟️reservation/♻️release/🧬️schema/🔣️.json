{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageItems",
    "maximumRows",
    "cases"
  ],
  "properties": {
    "pageItems": {
      "const": 1
    },
    "maximumRows": {
      "const": 4096
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rows",
          "extraReleaseSteps",
          "kind",
          "depth",
          "selectionWork",
          "releaseWork",
          "retainedEmptyMetadata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "extraReleaseSteps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "kind": {
            "enum": [
              "none",
              "metadata",
              "payload"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "selectionWork": {
            "type": "integer",
            "minimum": 0,
            "maximum": 512
          },
          "releaseWork": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "retainedEmptyMetadata": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
