{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageItems",
    "maximumRows",
    "cases"
  ],
  "properties": {
    "pageItems": {
      "const": 1
    },
    "maximumRows": {
      "const": 4096
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rows",
          "extraReserveSteps",
          "limit",
          "kind",
          "depth",
          "selectionWork",
          "reserveWork",
          "stagedSelectionWork"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "extraReserveSteps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "kind": {
            "enum": [
              "none",
              "metadata",
              "payload"
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "selectionWork": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "reserveWork": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          },
          "stagedSelectionWork": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          }
        }
      }
    }
  }
}
