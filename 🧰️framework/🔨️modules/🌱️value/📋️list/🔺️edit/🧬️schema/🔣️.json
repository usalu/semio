{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "title":"Indexed Edit Coordinates",
 "type":"object",
 "additionalProperties":false,
 "required":["base","removed","modified","added"],
 "properties":{
  "base":{"type":"integer","minimum":0},
  "removed":{"$ref":"#/$defs/indices"},
  "modified":{"$ref":"#/$defs/indices"},
  "added":{"$ref":"#/$defs/indices"}
 },
 "$defs":{"indices":{"type":"array","items":{"type":"integer","minimum":0}}}
}
