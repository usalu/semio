{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original Post Read Custody",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "value",
          "reads",
          "cancel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "object"
          },
          "reads": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "cancel": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
