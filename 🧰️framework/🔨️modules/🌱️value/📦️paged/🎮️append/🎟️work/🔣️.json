{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stock",
    "chunkBytes",
    "bodies",
    "cancelCuts",
    "texts",
    "metadataCopyBytes",
    "nullWork",
    "deniedWork",
    "cachedWork",
    "changedSource",
    "closeLaw",
    "receiveLaw",
    "sharedUtf8"
  ],
  "properties": {
    "stock": {
      "const": {
        "items": 100000,
        "fuel": 100000,
        "copyBytes": 33554432,
        "capacityBytes": 33554432,
        "releaseBytes": 33554432,
        "depth": 64,
        "maximumTurns": 100000
      }
    },
    "chunkBytes": {
      "const": 1024
    },
    "bodies": {
      "const": [
        1,
        17,
        1024
      ]
    },
    "cancelCuts": {
      "const": [
        0,
        1,
        2,
        4,
        10,
        128
      ]
    },
    "texts": {
      "const": [
        "",
        "α🙂",
        "🙂"
      ]
    },
    "metadataCopyBytes": {
      "const": 0
    },
    "nullWork": {
      "const": 1
    },
    "deniedWork": {
      "const": 0
    },
    "cachedWork": {
      "const": 0
    },
    "changedSource": {
      "const": {
        "before": "éa",
        "after": "aé",
        "afterCopiedBytes": 1,
        "failure": "native UTF-8 append source changed"
      }
    },
    "closeLaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turns",
        "copyBytes",
        "headerIdentity"
      ],
      "properties": {
        "turns": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case",
              "work"
            ],
            "properties": {
              "case": {
                "enum": [
                  "denied",
                  "invalid",
                  "cachedInvalid",
                  "underDepth",
                  "clear",
                  "cachedComplete"
                ]
              },
              "work": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "copyBytes": {
          "const": 0
        },
        "headerIdentity": {
          "const": [
            [
              17,
              3
            ],
            [
              29,
              7
            ]
          ]
        }
      }
    },
    "receiveLaw": {
      "type": "object",
      "required": [
        "stock",
        "cases",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "stock": {
          "type": "object"
        },
        "cases": {
          "type": "array",
          "minItems": 4
        },
        "rules": {
          "type": "object"
        }
      }
    },
    "sharedUtf8": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "const": {
        "schema": "semio.shared-utf8-admission/v1",
        "text": "shared original 源\u0000\r\n",
        "stock": {
          "items": 100000,
          "fuel": 100000,
          "copyBytes": 16777216,
          "capacityBytes": 16777216,
          "releaseBytes": 16777216,
          "depth": 128
        },
        "turn": {
          "items": 1,
          "copyBytes": 4096,
          "capacityBytes": 65536,
          "releaseBytes": 65536,
          "depth": 128
        },
        "expect": {
          "deniedWork": 0,
          "nullWork": 1,
          "nullAttempts": 1,
          "birthWork": 1,
          "birthCopyBytes": 0,
          "aliasWork": 1,
          "sameStringPointer": true,
          "sameText": true,
          "paidClose": true
        },
        "native": {
          "schema": "semio.shared-utf8-native/v1",
          "text": "native actor 源",
          "stock": {
            "items": 100000,
            "fuel": 100000,
            "copyBytes": 16777216,
            "capacityBytes": 16777216,
            "releaseBytes": 16777216,
            "depth": 128
          },
          "turn": {
            "items": 1,
            "copyBytes": 4096,
            "capacityBytes": 65536,
            "releaseBytes": 65536,
            "depth": 128
          },
          "expect": {
            "deniedWork": 0,
            "birthWork": 1,
            "birthCopyBytes": 0,
            "postingRefusalRetainsOutput": true,
            "originalStringPointer": true,
            "workDebitsOnce": true
          }
        }
      }
    }
  }
}
