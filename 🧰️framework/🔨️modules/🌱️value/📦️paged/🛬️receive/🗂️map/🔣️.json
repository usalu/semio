{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original Paged Map Receiving",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "entries",
          "accepted"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {}
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
