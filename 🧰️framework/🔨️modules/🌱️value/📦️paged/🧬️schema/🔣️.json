{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "vectors"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "vectors": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "input",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "list",
              "map"
            ]
          },
          "input": {},
          "accepted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
