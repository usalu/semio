{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "stock",
    "bodyCopyBytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "left",
          "right",
          "equal"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "left": {
            "$ref": "#/$defs/value"
          },
          "right": {
            "$ref": "#/$defs/value"
          },
          "equal": {
            "type": "boolean"
          }
        }
      }
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "bodyCopyBytes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "uint"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "int"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "float"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "bytes"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "array"
            },
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/value"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
