{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/value/refusal/codec",
  "$defs": {
    "kind": {
      "enum": [
        "invalidValue",
        "canceled",
        "ownershipLimit",
        "allocationFailed",
        "workLimit",
        "depthLimit",
        "unsupportedOwner",
        "invariantViolated"
      ]
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "$ref": "#/$defs/wire"
}
