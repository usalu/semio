{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/value/refusal/codec",
  "type": "object",
  "additionalProperties": false,
  "required": ["valid", "invalid", "controls", "longMessage"],
  "properties": {
    "valid": { "type": "array", "minItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "wire"], "properties": { "id": { "type": "string" }, "wire": { "$ref": "#/$defs/wire" } } } },
    "invalid": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "members", "expectedKind"], "properties": { "id": { "type": "string" }, "members": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": { "key": { "type": "string" }, "value": { "anyOf": [{ "type": "string" }, { "type": "boolean" }, { "type": "null" }] } } } }, "expectedKind": { "const": "invalidValue" } } } },
    "controls": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "operation", "maximumBytes", "cancelAt", "expectedKind"], "properties": { "id": { "type": "string" }, "operation": { "enum": ["encode", "decode"] }, "maximumBytes": { "type": "integer", "minimum": 0 }, "cancelAt": { "type": "integer", "minimum": 0 }, "expectedKind": { "enum": ["canceled", "ownershipLimit"] } } } },
    "longMessage": { "type": "object", "additionalProperties": false, "required": ["kind", "unit", "repeat"], "properties": { "kind": { "$ref": "#/$defs/kind" }, "unit": { "type": "string", "minLength": 1 }, "repeat": { "type": "integer", "minimum": 10000 } } }
  },
  "$defs": {
    "kind": { "enum": ["invalidValue", "canceled", "ownershipLimit", "allocationFailed", "workLimit", "depthLimit", "unsupportedOwner", "invariantViolated"] },
    "wire": { "type": "object", "additionalProperties": false, "required": ["kind", "message"], "properties": { "kind": { "$ref": "#/$defs/kind" }, "message": { "type": "string" } } }
  }
}
