{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/value/refusal/codec",
  "$defs": {
    "kind": {
      "enum": [
        "invalidValue",
        "canceled",
        "ownershipLimit",
        "allocationFailed",
        "workLimit",
        "depthLimit",
        "unsupportedOwner",
        "invariantViolated"
      ]
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "retainedProgress"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "message": {
          "type": "string"
        },
        "retainedProgress": {
          "$ref": "#/$defs/retainedProgress"
        }
      }
    },
    "retainedProgress": {
      "title": "Retained Clone Progress",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copiedItems",
        "copiedBytes",
        "retainedCapacityBytes",
        "releasedBytes"
      ],
      "properties": {
        "copiedItems": {
          "type": "integer",
          "minimum": 0
        },
        "copiedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "retainedCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "releasedBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$ref": "#/$defs/wire"
}
