{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/schema/value/refusal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "jsonCases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation",
          "kind",
          "message",
          "path",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "construct",
              "decodeCancel",
              "decodeOwnership",
              "decodeCollectionOverflow",
              "decodeWork",
              "decodeWorkOverflow",
              "decodeDepth",
              "encodeCancel",
              "encodeOwnership",
              "encodeCollectionOverflow",
              "encodeWork",
              "encodeWorkOverflow",
              "encodeDepth",
              "decodeUtf8",
              "decodeUnsupported",
              "encodeUnsupported",
              "cloneLeaseChanged",
              "cloneItemOverflow",
              "cloneCapacityOverflow",
              "cloneGrantOverrun",
              "cloneDepth",
              "orderedCancel",
              "orderedOwnership"
            ]
          },
          "kind": {
            "enum": [
              "invalidValue",
              "canceled",
              "ownershipLimit",
              "allocationFailed",
              "workLimit",
              "depthLimit",
              "unsupportedOwner",
              "invariantViolated"
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "display"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "invalidValue",
                  "canceled",
                  "ownershipLimit",
                  "allocationFailed",
                  "workLimit",
                  "depthLimit",
                  "unsupportedOwner",
                  "invariantViolated"
                ]
              },
              "display": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "jsonCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation",
          "text",
          "expectedKind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "decodeMalformed",
              "decodeDuplicate",
              "decodeCancel",
              "decodeOwnership",
              "decodeNestedInvalid",
              "decodeNestedCancel",
              "encodeCancel",
              "encodeOwnership",
              "decodeDepth"
            ]
          },
          "text": {
            "type": "string"
          },
          "expectedKind": {
            "enum": [
              "invalidValue",
              "canceled",
              "ownershipLimit",
              "allocationFailed",
              "workLimit",
              "depthLimit",
              "unsupportedOwner",
              "invariantViolated"
            ]
          },
          "expectedDisplay": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "kind": {
      "enum": [
        "invalidValue",
        "canceled",
        "ownershipLimit",
        "allocationFailed",
        "workLimit",
        "depthLimit",
        "unsupportedOwner",
        "invariantViolated"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "display"
      ],
      "properties": {
        "kind": {
          "enum": [
            "invalidValue",
            "canceled",
            "ownershipLimit",
            "allocationFailed",
            "workLimit",
            "depthLimit",
            "unsupportedOwner",
            "invariantViolated"
          ]
        },
        "display": {
          "type": "string"
        }
      }
    }
  }
}
