  "type": "object",
  "additionalProperties": false,
  "required": [
    "first",
    "second",
    "sum",
    "maximumTurns"
  ],
  "properties": {
    "first": {
      "type": "integer",
      "minimum": 0
    },
    "second": {
      "type": "integer",
      "minimum": 0
    },
    "sum": {
      "type": "integer",
      "minimum": 0
    },
    "maximumTurns": {
      "type": "integer",
      "minimum": 1
    }
  }
}
