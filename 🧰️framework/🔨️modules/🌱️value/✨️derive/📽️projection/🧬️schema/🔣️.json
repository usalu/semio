{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases",
    "layouts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "attribute",
          "root",
          "shape"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "attribute": {
            "type": "string"
          },
          "root": {
            "enum": [
              "semio_framework_value",
              "crate",
              "domain_value"
            ]
          },
          "shape": {
            "enum": [
              "empty",
              "record"
            ]
          }
        }
      }
    },
    "layouts": {
      "const": [
        {
          "attribute": "",
          "representations": [],
          "accepted": true
        },
        {
          "attribute": "#[repr(C)]",
          "representations": [
            "C"
          ],
          "accepted": true
        },
        {
          "attribute": "#[repr(transparent)]",
          "representations": [
            "transparent"
          ],
          "accepted": true
        },
        {
          "attribute": "#[repr(align(8))]",
          "representations": [
            "align"
          ],
          "accepted": true
        },
        {
          "attribute": "#[doc=\"packed\"]",
          "representations": [],
          "accepted": true
        },
        {
          "attribute": "#[repr(packed)]",
          "representations": [
            "packed"
          ],
          "accepted": false
        },
        {
          "attribute": "#[repr(packed(2))]",
          "representations": [
            "packed"
          ],
          "accepted": false
        },
        {
          "attribute": "#[repr(C,packed)]",
          "representations": [
            "C",
            "packed"
          ],
          "accepted": false
        },
        {
          "attribute": "#[repr(C,packed(2))]",
          "representations": [
            "C",
            "packed"
          ],
          "accepted": false
        }
      ]
    }
  }
}
