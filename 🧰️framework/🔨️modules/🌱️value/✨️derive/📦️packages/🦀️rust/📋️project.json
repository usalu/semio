{
  "name": "@semio-tech/value-derive-rs",
  "$schema": "../../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🌱️value/✨️derive/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "value-admission-check": {
      "cache": true,
      "dependsOn": [],
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "value-admission-check"
          ]
        }
      },
      "options": {
        "cwd": "🧰️framework/🔨️modules/🌱️value/✨️derive/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts value-admission-check"
      },
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "reads",
        "cargoToolchain"
      ],
      "outputs": []
    },
    "value-admission-native-check": {
      "cache": true,
      "dependsOn": [],
      "metadata": {
        "semio": {
          "workspaceCommand": [
            "verify",
            "value-admission-check",
            "--native"
          ]
        }
      },
      "options": {
        "cwd": "🧰️framework/🔨️modules/🌱️value/✨️derive/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts value-admission-check --native"
      },
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "reads",
        "cargoToolchain"
      ],
      "outputs": []
    }
  },
  "namedInputs": {
    "default": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/✨️derive/**/*",
      "sharedGlobals"
    ],
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🗣️dsl/🧬️schema/✨️derive/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🗣️dsl/🧬️schema/📦️packages/🦀️rust/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🧪️test/🧲️fixture-reader/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  }
}
