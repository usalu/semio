{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/value/schema.json",
  "title": "DslValue",
  "$ref": "#/$defs/DslValue",
  "$defs": {
    "DslValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DslValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DslValue"
          }
        }
      ]
    },
    "NonZeroU64": {
      "title": "NonZeroU64",
      "description": "🔢️ A non-zero u64 carried as a decimal string, the wire form every 64-bit counter in this family uses (`activationGeneration`, `returnSequence`, `pageSequence`). The bound is the same exhaustive [0, u64::MAX] alternation the actor page schema's `Word` pins, with the `0` branch removed — zero is what these counters use to mean \"never issued\", so a value that carries one is never zero.",
      "type": "string",
      "maxLength": 20,
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
    }
  }
}
