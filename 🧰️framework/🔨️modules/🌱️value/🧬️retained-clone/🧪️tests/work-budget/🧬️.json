{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "maximumWork",
    "actions",
    "invariants",
    "samples",
    "cancellationTurns"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "maximumWork": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "work"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "work": {
            "type": "integer",
            "minimum": 1
          },
          "childWork": {
            "type": "integer",
            "minimum": 0
          },
          "parentWork": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "cancellationTurns": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
