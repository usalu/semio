{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "native",
    "derive"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "depth",
          "body",
          "expectedVisits",
          "expectedDepth"
        ],
        "properties": {
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          },
          "body": {
            "type": "integer",
            "minimum": 0
          },
          "expectedVisits": {
            "type": "integer",
            "minimum": 1
          },
          "expectedDepth": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalBytes",
        "closeBody",
        "cuts"
      ],
      "properties": {
        "originalBytes": {
          "const": 65537
        },
        "closeBody": {
          "const": 4096
        },
        "cuts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "derive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denials",
        "cuts"
      ],
      "properties": {
        "denials": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "items",
              "copy",
              "capacity",
              "release",
              "depth"
            ]
          }
        },
        "cuts": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          }
        }
      }
    }
  }
}
