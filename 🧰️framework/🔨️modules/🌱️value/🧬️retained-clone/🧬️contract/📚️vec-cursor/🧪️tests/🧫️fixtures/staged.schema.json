{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 4,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "values",
      "body",
      "firstBytes"
    ],
    "properties": {
      "values": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "body": {
        "type": "integer",
        "minimum": 0
      },
      "firstBytes": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
