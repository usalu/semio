{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/framework/value/retained-clone/selected-close-dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "bodies",
    "cuts",
    "maximumTurns",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4096
      }
    },
    "cuts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 32
      }
    },
    "maximumTurns": {
      "const": 1024
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "body",
          "minimumPayloadBytes",
          "structural",
          "payload",
          "selected",
          "independent",
          "correlated"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "minimumPayloadBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "structural": {
            "$ref": "#/$defs/demand"
          },
          "payload": {
            "$ref": "#/$defs/demand"
          },
          "selected": {
            "$ref": "#/$defs/demand"
          },
          "independent": {
            "$ref": "#/$defs/demand"
          },
          "correlated": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "properties": {
        "copyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
