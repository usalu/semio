      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "expectedZero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "items"
      ],
      "properties": {
        "work": {
          "const": 0
        },
        "items": {
          "const": 0
        }
      }
    },
