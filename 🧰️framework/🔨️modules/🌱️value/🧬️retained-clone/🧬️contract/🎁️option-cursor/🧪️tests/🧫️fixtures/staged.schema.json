{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 2,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value",
      "present"
    ],
    "properties": {
      "value": {
        "type": [
          "string",
          "null"
        ]
      },
      "present": {
        "type": "boolean"
      }
    }
  }
}
