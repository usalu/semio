{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["grant", "text", "bytes", "map", "expected"],
  "properties": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumItems", "maximumCopyBytes", "maximumCapacityBytes", "maximumDepth"],
      "properties": {
        "maximumItems": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maximumCopyBytes": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maximumCapacityBytes": { "const": 4096 },
        "maximumDepth": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment", "repetitions", "capacityBytes"],
      "properties": {
        "segment": { "type": "string", "minLength": 2 },
        "repetitions": { "type": "integer", "minimum": 256, "maximum": 512 },
        "capacityBytes": { "const": 8192 }
      }
    },
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "capacityBytes", "multiplier", "increment"],
      "properties": {
        "length": { "const": 6145 },
        "capacityBytes": { "const": 8192 },
        "multiplier": { "type": "integer", "minimum": 1, "maximum": 255 },
        "increment": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryCount", "capacityEntries", "keyPrefix", "valuePrefix"],
      "properties": {
        "entryCount": { "const": 70 },
        "capacityEntries": { "const": 128 },
        "keyPrefix": { "type": "string", "minLength": 1 },
        "valuePrefix": { "type": "string", "minLength": 1 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copyRequiresMultipleTurns", "closeRequiresMultipleTurns", "singleItemMaximumTurns", "ordered", "terminalEmpty"],
      "properties": {
        "copyRequiresMultipleTurns": { "const": true },
        "closeRequiresMultipleTurns": { "const": true },
        "singleItemMaximumTurns": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "ordered": { "const": true },
        "terminalEmpty": { "const": true }
      }
    }
  }
}
