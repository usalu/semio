{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio://value/original-slot/laws",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy",
    "cases",
    "workCases"
  ],
  "properties": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "combinedBodyCapacity",
        "separateRelease",
        "originalIssuer",
        "foreignKeyRefused",
        "returnBeforeMutation",
        "readBirthPrefixes",
        "capturedIssuerRetiresPayload",
        "stepsPerPayloadByte",
        "fixedSteps",
        "owningProjection",
        "readBirthStates"
      ],
      "properties": {
        "maximumItems": {
          "const": 1
        },
        "combinedBodyCapacity": {
          "const": 4096
        },
        "separateRelease": {
          "const": true
        },
        "originalIssuer": {
          "const": true
        },
        "foreignKeyRefused": {
          "const": true
        },
        "returnBeforeMutation": {
          "const": true
        },
        "readBirthPrefixes": {
          "const": [
            0,
            1,
            2
          ]
        },
        "capturedIssuerRetiresPayload": {
          "const": true
        },
        "stepsPerPayloadByte": {
          "const": 256
        },
        "fixedSteps": {
          "const": 1024
        },
        "owningProjection": {
          "const": true
        },
        "readBirthStates": {
          "const": [
            {
              "prefix": 0,
              "state": "cold"
            },
            {
              "prefix": 1,
              "state": "captured"
            },
            {
              "prefix": 2,
              "state": "published"
            }
          ]
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "original",
          "replacement",
          "patch",
          "expected",
          "withdrawn",
          "vacant"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "original": {
            "type": "object"
          },
          "replacement": {
            "type": "object"
          },
          "patch": {
            "type": "array"
          },
          "expected": {
            "type": "object"
          },
          "withdrawn": {
            "type": "object"
          },
          "vacant": {
            "const": true
          }
        }
      }
    },
    "workCases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payloadBytes",
          "expectedSteps"
        ],
        "properties": {
          "payloadBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "expectedSteps": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
