{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schemas/value/original-clone-source-custody",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "owner", "metadata", "denied", "expected"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "owner": {"type": "string"},
          "metadata": {"type": "string"},
          "denied": {"type": "array", "items": {"enum": ["items", "copy", "capacity", "release", "depth"]}, "uniqueItems": true},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["originalRetained", "aliasRetained", "terminal", "source"],
            "properties": {
              "originalRetained": {"const": true},
              "aliasRetained": {"const": true},
              "terminal": {"const": true},
              "source": {"enum": ["owned", "borrowed"]}
            }
          }
        }
      }
    }
  }
}
