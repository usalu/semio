{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schemas/value/original-clone-source-custody",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "currency",
    "bindingIdentity",
    "closeQuery",
    "takeQuery"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "owner",
          "metadata",
          "denied",
          "expected"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          },
          "metadata": {
            "type": "string"
          },
          "denied": {
            "type": "array",
            "items": {
              "enum": [
                "items",
                "capacity",
                "release",
                "depth"
              ]
            },
            "uniqueItems": true
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "originalRetained",
              "aliasRetained",
              "terminal"
            ],
            "properties": {
              "originalRetained": {
                "const": true
              },
              "aliasRetained": {
                "const": true
              },
              "terminal": {
                "const": true
              }
            }
          }
        }
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadataCopyBytes",
        "minimumCopyBudget",
        "negativeCopyBudgetRepresentable",
        "bindingDenied",
        "transferDenied",
        "sourceModes"
      ],
      "properties": {
        "metadataCopyBytes": {
          "const": 0
        },
        "minimumCopyBudget": {
          "const": 0
        },
        "negativeCopyBudgetRepresentable": {
          "const": false
        },
        "bindingDenied": {
          "const": [
            "items",
            "depth"
          ]
        },
        "transferDenied": {
          "const": [
            "items",
            "release",
            "depth"
          ]
        },
        "sourceModes": {
          "const": [
            "owned",
            "borrowed"
          ]
        }
      }
    },
    "bindingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sameOrigin",
        "differentProjection",
        "differentOrigin"
      ],
      "properties": {
        "sameOrigin": {
          "const": true
        },
        "differentProjection": {
          "const": false
        },
        "differentOrigin": {
          "const": false
        }
      }
    },
    "closeQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "callers"
      ],
      "properties": {
        "method": {
          "const": "next_close_demand"
        },
        "callers": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "calls",
              "owner"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "calls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "owner": {
                "enum": [
                  "source",
                  "borrowAuthority"
                ]
              }
            }
          }
        }
      }
    },
    "takeQuery": {
      "const": [
        {
          "closing": false,
          "owner": {
            "copyBytes": 24,
            "capacityBytes": 0,
            "releaseBytes": 64,
            "depth": 1
          },
          "lease": {
            "copyBytes": 56,
            "capacityBytes": 0,
            "releaseBytes": 40,
            "depth": 3
          },
          "expected": {
            "copyBytes": 56,
            "capacityBytes": 0,
            "releaseBytes": 40,
            "depth": 3
          }
        },
        {
          "closing": false,
          "owner": {
            "copyBytes": 24,
            "capacityBytes": 0,
            "releaseBytes": 64,
            "depth": 1
          },
          "lease": null,
          "expected": {
            "copyBytes": 24,
            "capacityBytes": 0,
            "releaseBytes": 64,
            "depth": 1
          }
        },
        {
          "closing": true,
          "owner": {
            "copyBytes": 24,
            "capacityBytes": 0,
            "releaseBytes": 64,
            "depth": 1
          },
          "lease": {
            "copyBytes": 56,
            "capacityBytes": 0,
            "releaseBytes": 40,
            "depth": 3
          },
          "expected": null
        },
        {
          "closing": false,
          "owner": null,
          "lease": null,
          "expected": null
        },
        {
          "closing": false,
          "owner": null,
          "lease": {
            "copyBytes": 56,
            "capacityBytes": 0,
            "releaseBytes": 40,
            "depth": 3
          },
          "expected": null
        }
      ]
    }
  }
}
