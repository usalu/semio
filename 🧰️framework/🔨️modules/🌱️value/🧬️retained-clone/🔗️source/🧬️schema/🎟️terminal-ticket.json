{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.general.retained-source-terminal-ticket/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "copyWords",
    "items",
    "depth",
    "capacityBytes",
    "headerWidths",
    "refused",
    "retainsOriginalTicket",
    "deniedHeapBytes",
    "terminalHeapBytes"
  ],
  "properties": {
    "copyWords": {
      "const": 2
    },
    "items": {
      "const": 1
    },
    "depth": {
      "const": 1
    },
    "capacityBytes": {
      "const": 0
    },
    "headerWidths": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wordBytes",
              "copyBytes"
            ],
            "properties": {
              "wordBytes": {
                "const": 4
              },
              "copyBytes": {
                "const": 8
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wordBytes",
              "copyBytes"
            ],
            "properties": {
              "wordBytes": {
                "const": 8
              },
              "copyBytes": {
                "const": 16
              }
            }
          }
        ]
      }
    },
    "refused": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "enum": [
          "items",
          "copy",
          "release",
          "depth"
        ]
      }
    },
    "retainsOriginalTicket": {
      "const": true
    },
    "deniedHeapBytes": {
      "const": 0
    },
    "terminalHeapBytes": {
      "const": 0
    }
  }
}
