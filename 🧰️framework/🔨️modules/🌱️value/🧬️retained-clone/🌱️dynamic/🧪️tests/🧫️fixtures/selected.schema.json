{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "body",
    "deniedCopy",
    "maximumTurns",
    "selected",
    "raw",
    "cached",
    "lengthHeaderBytes",
    "maximumItems"
  ],
  "properties": {
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "bytes"
        },
        "value": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "body": {
      "type": "integer",
      "minimum": 1
    },
    "deniedCopy": {
      "type": "integer",
      "minimum": 0
    },
    "maximumTurns": {
      "type": "integer",
      "minimum": 1
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "copiedBytes"
      ],
      "properties": {
        "work": {
          "const": 0
        },
        "copiedBytes": {
          "const": 0
        }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "copiedBytes",
        "remaining"
      ],
      "properties": {
        "work": {
          "const": 1
        },
        "copiedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cached": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "work",
        "copiedBytes"
      ],
      "properties": {
        "complete": {
          "const": true
        },
        "work": {
          "const": 0
        },
        "copiedBytes": {
          "const": 0
        }
      }
    },
    "lengthHeaderBytes": {
      "const": 8
    },
    "maximumItems": {
      "const": 5
    }
  }
}
