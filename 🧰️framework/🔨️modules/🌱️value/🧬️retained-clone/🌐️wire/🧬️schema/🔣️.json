{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retained Clone Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maximumItems",
    "maximumCopyBytes",
    "maximumCapacityBytes",
    "maximumReleaseBytes",
    "maximumDepth"
  ],
  "properties": {
    "maximumItems": {
      "type": "integer",
      "minimum": 0
    },
    "maximumCopyBytes": {
      "type": "integer",
      "minimum": 0
    },
    "maximumCapacityBytes": {
      "type": "integer",
      "minimum": 0
    },
    "maximumReleaseBytes": {
      "type": "integer",
      "minimum": 0
    },
    "maximumDepth": {
      "type": "integer",
      "minimum": 0
    }
  }
}
