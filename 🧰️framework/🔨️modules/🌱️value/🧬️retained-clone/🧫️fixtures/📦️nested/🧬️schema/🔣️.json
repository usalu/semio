{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained Clone Neutral Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "payloadByteLength", "payloadModulo", "recursiveDepth", "grant", "insufficientCapacityBytes", "immutableLease", "cancellationStops"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "optional", "choice", "choices", "fixedArray", "pair", "triple", "labels"],
      "properties": {
        "title": { "type": "string" },
        "optional": { "type": ["string", "null"] },
        "choice": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "unit" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": { "kind": { "const": "text" }, "text": { "type": "string" } } },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "rows"],
              "properties": {
                "kind": { "const": "nested" },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "text"],
                    "properties": { "id": { "type": "integer", "minimum": 0 }, "text": { "type": "string" } }
                  }
                }
              }
            }
          ]
        },
        "choices": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/choice" } },
        "fixedArray": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 } },
        "pair": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "integer", "minimum": 0 }], "minItems": 2, "maxItems": 2 },
        "triple": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "integer", "minimum": 0 }, { "type": "string" }], "minItems": 3, "maxItems": 3 },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "payloadByteLength": { "type": "integer", "minimum": 2097152 },
    "payloadModulo": { "type": "integer", "minimum": 2, "maximum": 255 },
    "recursiveDepth": { "type": "integer", "minimum": 128, "maximum": 4096 },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumItems", "maximumCopyBytes", "maximumCapacityBytes", "maximumDepth"],
      "properties": {
        "maximumItems": { "type": "integer", "minimum": 1 },
        "maximumCopyBytes": { "type": "integer", "minimum": 1 },
        "maximumCapacityBytes": { "type": "integer", "minimum": 2097152 },
        "maximumDepth": { "type": "integer", "minimum": 64, "maximum": 4096 }
      }
    },
    "insufficientCapacityBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
    "immutableLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured", "externalAfterCapture", "expected"],
      "properties": {
        "captured": { "type": "string", "minLength": 4, "maxLength": 4 },
        "externalAfterCapture": { "type": "string", "minLength": 4, "maxLength": 4 },
        "expected": { "type": "string", "minLength": 4, "maxLength": 4 }
      }
    },
    "cancellationStops": { "type": "array", "minItems": 8, "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true }
  },
  "$defs": {
    "choice": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "unit" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": { "kind": { "const": "text" }, "text": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "rows"], "properties": { "kind": { "const": "nested" }, "rows": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "type": "integer", "minimum": 0 }, "text": { "type": "string" } } } } } }
      ]
    }
  }
}
