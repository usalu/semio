{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "pending",
          "fields",
          "birthHeap",
          "closeAllowed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "allocation",
              "settlement",
              "continuation",
              "pauseRefused",
              "failure"
            ]
          },
          "pending": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "birthHeap": {
            "enum": [
              0,
              null
            ]
          },
          "closeAllowed": {
            "type": "boolean"
          },
          "selectedWork": {
            "type": "integer",
            "minimum": 1
          },
          "actualWork": {
            "type": "integer",
            "minimum": 0
          },
          "unspentWork": {
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "settlement"
                }
              }
            },
            "then": {
              "required": [
                "selectedWork",
                "actualWork",
                "unspentWork"
              ]
            }
          }
        ]
      }
    }
  }
}
