{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Original UTF8 Cursor And Buffer Laws",
  "type": "object", "additionalProperties": false,
  "required": ["bodyBytes", "cases", "cancellationCuts"],
  "properties": {
    "bodyBytes": {"type": "integer", "minimum": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "text", "repeat", "bytes", "scalars"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "repeat": {"type": "integer", "minimum": 1}, "bytes": {"type": "integer", "minimum": 0}, "scalars": {"type": "integer", "minimum": 0}}}},
    "cancellationCuts": {"type": "array", "items": {"type": "integer", "minimum": 0}}
  }
}
