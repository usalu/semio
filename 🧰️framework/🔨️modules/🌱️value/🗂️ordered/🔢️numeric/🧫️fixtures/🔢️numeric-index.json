{
  "grants": [256, 4096],
  "invalidIds": [-1, 0.5, 9007199254740992],
  "ownership": { "capture": "share-exact-roots", "cancel": "retain-old-root", "finalPayloadHandoffs": "once-per-owned-entry", "sortedRead": "numeric-order-with-exact-insertion-ordinal" },
  "lifecycle": { "cancelEveryStep": true, "concurrentEdits": 2, "readerOutlivesSource": true, "payload": { "unit": "α🧩️", "repeat": 5000 }, "invalidGrants": [{ "maxItems": 0, "maxBytes": 4096 }, { "maxItems": 1, "maxBytes": 0 }, { "maxItems": 1, "maxBytes": 255 }] },
  "ordinals": [
    { "name": "carry-safe-word", "start": { "high": 3, "low": 9007199254740991 }, "outcome": "ready", "next": { "high": 4, "low": 0 } },
    { "name": "reject-before-mutation", "start": { "high": 9007199254740991, "low": 9007199254740991 }, "outcome": "ordinal-exhausted", "next": { "high": 9007199254740991, "low": 9007199254740991 } }
  ],
  "stress": { "size": 1024, "multiplier": 613, "rounds": 3 },
  "cases": [
    { "name": "negative-zero-normalizes-like-map", "operations": [{ "op": "set", "id": -0, "value": "negative" }, { "op": "set", "id": 0, "value": "positive" }, { "op": "set", "id": -0, "value": "replacement" }], "expected": [[0, "replacement"]] },
    { "name": "insertion-not-key-order", "operations": [{ "op": "set", "id": 8, "value": "eight" }, { "op": "set", "id": 2, "value": "two" }, { "op": "set", "id": 5, "value": "five" }], "expected": [[8, "eight"], [2, "two"], [5, "five"]] },
    { "name": "replacement-keeps-ordinal", "operations": [{ "op": "set", "id": 7, "value": "old" }, { "op": "set", "id": 0, "value": "zero" }, { "op": "set", "id": 7, "value": "α🧩️\n\"" }], "expected": [[7, "α🧩️\n\""], [0, "zero"]] },
    { "name": "reinsertion-appends", "operations": [{ "op": "set", "id": 3, "value": "old" }, { "op": "set", "id": 1, "value": "one" }, { "op": "remove", "id": 3 }, { "op": "set", "id": 3, "value": "new" }], "expected": [[1, "one"], [3, "new"]] },
    { "name": "full-safe-integer-range", "operations": [{ "op": "set", "id": 9007199254740991, "value": "max" }, { "op": "set", "id": 4294967296, "value": "above-u32" }, { "op": "set", "id": 0, "value": "zero" }, { "op": "remove", "id": 4294967296 }], "expected": [[9007199254740991, "max"], [0, "zero"]] },
    { "name": "absent-and-final-delete", "operations": [{ "op": "remove", "id": 42 }, { "op": "set", "id": 1, "value": "one" }, { "op": "remove", "id": 1 }, { "op": "remove", "id": 1 }], "expected": [] }
  ]
}
