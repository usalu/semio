{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://semio.tech/schema/framework/value/ordered/numeric/schema.json",
  "title": "Value Ordered Numeric Schema Module",
  "definitions": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ordinal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high",
        "low"
      ],
      "properties": {
        "high": {
          "$ref": "#/definitions/id"
        },
        "low": {
          "$ref": "#/definitions/id"
        }
      }
    }
  },
  "$defs": {
    "ReferencesFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "maximum",
        "cases",
        "expected",
        "maximumStepBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "maximum": {
          "const": 9007199254740991
        },
        "cases": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "capture-ids",
              "capture-order",
              "capture-shadowed-checker",
              "allocation-entry",
              "allocation-left",
              "allocation-right",
              "allocation-duplicate-owner"
            ]
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rejected",
            "preserved"
          ],
          "properties": {
            "rejected": {
              "const": true
            },
            "preserved": {
              "const": true
            }
          }
        },
        "maximumStepBytes": {
          "const": 256
        }
      }
    },
    "NumericIndexFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants",
        "cases",
        "invalidIds",
        "ownership",
        "lifecycle",
        "ordinals",
        "stress"
      ],
      "properties": {
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cancelEveryStep",
            "concurrentEdits",
            "readerOutlivesSource",
            "payload",
            "invalidGrants"
          ],
          "properties": {
            "cancelEveryStep": {
              "const": true
            },
            "concurrentEdits": {
              "const": 2
            },
            "readerOutlivesSource": {
              "const": true
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "repeat"
              ],
              "properties": {
                "unit": {
                  "const": "α🧩️"
                },
                "repeat": {
                  "const": 5000
                }
              }
            },
            "invalidGrants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "maxItems",
                  "maxBytes"
                ],
                "properties": {
                  "maxItems": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxBytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "ordinals": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "start",
              "outcome",
              "next"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "start": {
                "$ref": "#/definitions/ordinal"
              },
              "next": {
                "$ref": "#/definitions/ordinal"
              },
              "outcome": {
                "enum": [
                  "ready",
                  "ordinal-exhausted"
                ]
              }
            }
          }
        },
        "stress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "multiplier",
            "rounds"
          ],
          "properties": {
            "size": {
              "const": 1024
            },
            "multiplier": {
              "const": 613
            },
            "rounds": {
              "const": 3
            }
          }
        },
        "grants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              256,
              4096
            ]
          }
        },
        "invalidIds": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capture",
            "cancel",
            "finalPayloadHandoffs",
            "sortedRead"
          ],
          "properties": {
            "sortedRead": {
              "const": "numeric-order-with-exact-insertion-ordinal"
            },
            "capture": {
              "const": "share-exact-roots"
            },
            "cancel": {
              "const": "retain-old-root"
            },
            "finalPayloadHandoffs": {
              "const": "once-per-owned-entry"
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "operations",
              "expected"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "operations": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "op",
                        "id",
                        "value"
                      ],
                      "properties": {
                        "op": {
                          "const": "set"
                        },
                        "id": {
                          "$ref": "#/definitions/id"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "op",
                        "id"
                      ],
                      "properties": {
                        "op": {
                          "const": "remove"
                        },
                        "id": {
                          "$ref": "#/definitions/id"
                        }
                      }
                    }
                  ]
                }
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "additionalItems": false,
                  "items": [
                    {
                      "$ref": "#/definitions/id"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
