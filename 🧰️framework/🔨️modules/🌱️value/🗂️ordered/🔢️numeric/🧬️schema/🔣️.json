{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/value/ordered/numeric/schema.json",
  "title": "Value Ordered Numeric Schema Module",
  "definitions": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ordinal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high",
        "low"
      ],
      "properties": {
        "high": {
          "$ref": "#/definitions/id"
        },
        "low": {
          "$ref": "#/definitions/id"
        }
      }
    }
  }
}
