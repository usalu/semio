{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semio.tech/framework/value/numeric/reservation",
  "type": "object",
  "required": [
    "keys",
    "multiplier",
    "minimumDepth",
    "maximumDepth",
    "pageItems"
  ],
  "additionalProperties": false,
  "properties": {
    "keys": {
      "type": "integer",
      "minimum": 257
    },
    "multiplier": {
      "type": "integer",
      "minimum": 1
    },
    "minimumDepth": {
      "type": "integer",
      "minimum": 3
    },
    "maximumDepth": {
      "type": "integer",
      "minimum": 5
    },
    "pageItems": {
      "const": 16
    }
  },
  "$defs": {
    "grant": {
      "type": "object",
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "additionalProperties": false,
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "demand": {
      "type": "object",
      "required": [
        "copyBytes",
        "capacityBytes",
        "releaseBytes",
        "depth"
      ],
      "additionalProperties": false,
      "properties": {
        "copyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "releaseBytes": {
          "type": "integer",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "copiedItems",
        "copiedBytes",
        "retainedCapacityBytes",
        "releasedBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "copiedItems": {
          "type": "integer",
          "minimum": 0
        },
        "copiedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "retainedCapacityBytes": {
          "type": "integer",
          "minimum": 0
        },
        "releasedBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
