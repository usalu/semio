{
  "name": "@semio-tech/value-resident-rs",
  "$schema": "../../../../../🛍️products/🦑️repo/🔨️modules/📚️library/🏗️build/🧬️schema/📋️project/🔣️.json",
  "sourceRoot": "🧰️framework/🔨️modules/🌱️value/💾️resident/📦️packages/🦀️rust",
  "projectType": "library",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/💾️resident/🦀️.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/💾️resident/🪪️consumer-cell/🦀️.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/💾️resident/🧪️tests/💾️resident/🦀️.rs",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/💾️resident/🧪️tests/🧫️fixtures/🔣️.json",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/💾️resident/🧬️schema/🔣️.json",
      "{workspaceRoot}/🧰️framework/🔨️modules/🌱️value/💾️resident/🤝️contract.json",
      "sharedGlobals"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "cache": true,
      "options": {
        "cwd": "🧰️framework/🔨️modules/🌱️value/💾️resident/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      },
      "outputs": []
    },
    "check-wasm": {
      "executor": "repo:script",
      "cache": true,
      "inputs": ["nativeSources", "^nativeSources"],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🌱️value/💾️resident/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts check-wasm",
        "forwardAllArgs": true
      },
      "outputs": []
    }
  }
}
