{
  "name": "@semio-tech/value-resident",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv"
      ],
      "outputs": [],
      "options": {
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true,
        "cwd": "🧰️framework/🔨️modules/🌱️value/💾️resident"
      }
    }
  }
}
