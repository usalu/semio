{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.value.resident.admission.fixture.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bootstrap", "resourceKinds", "faultKinds", "ownership", "grants", "unrelatedByte"],
  "properties": {
    "version": { "const": 1 },
    "bootstrap": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "resourceKinds": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["owner", "record", "page", "reader", "external"] } },
    "faultKinds": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["object", "null", "undefined", "proxy"] } },
    "ownership": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "grants": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["maxItems", "maxBytes"], "properties": { "maxItems": { "type": "integer", "minimum": 0, "maximum": 1 }, "maxBytes": { "type": "integer", "minimum": 0, "maximum": 4096 } } } },
    "unrelatedByte": { "const": 73 }
  }
}
