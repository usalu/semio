{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.value.resident.admission.contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "charge", "bootstrap", "resourceKinds", "faultPolicy", "closePolicy"],
  "properties": {
    "version": { "const": 1 },
    "charge": { "$ref": "semio.value.resident.capacity.v1#/definitions/resources" },
    "bootstrap": { "const": "exact-consumer-prepare-read-claim" },
    "resourceKinds": { "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": { "enum": ["owner", "record", "page", "reader", "external"] } },
    "faultPolicy": { "const": "first-exact-root-retained-no-refund" },
    "closePolicy": { "const": "intrinsic-descendants-before-fault-held-cell" }
  }
}
