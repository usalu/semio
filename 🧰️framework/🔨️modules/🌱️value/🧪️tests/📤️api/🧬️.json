{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ownerName", "sdkName", "ownerExport", "sdkExport", "runtime", "types", "removedRoots", "grant", "commands", "expected"],
  "properties": {
    "version": { "const": 1 },
    "ownerName": { "const": "@semio-tech/value-ts" },
    "sdkName": { "const": "@semio-tech/framework" },
    "ownerExport": { "const": "./ordered/numeric" },
    "sdkExport": { "const": "./value/ordered/numeric" },
    "runtime": { "$ref": "#/$defs/names" },
    "types": { "$ref": "#/$defs/names" },
    "removedRoots": { "$ref": "#/$defs/names" },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxItems", "maxBytes"],
      "properties": { "maxItems": { "type": "integer", "minimum": 1 }, "maxBytes": { "type": "integer", "minimum": 256 } }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind", "id", "value"], "properties": { "kind": { "const": "set" }, "id": { "$ref": "#/$defs/id" }, "value": { "type": "string" } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "remove" }, "id": { "$ref": "#/$defs/id" } } }
        ]
      }
    },
    "expected": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{ "$ref": "#/$defs/id" }, { "type": "string" }], "items": false } }
  },
  "$defs": {
    "names": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "id": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
