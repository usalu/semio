{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries",
    "collectionItems",
    "cancelAfter",
    "largeTextBytes",
    "tinyBudgetBytes",
    "integerWords",
    "representations",
    "frontier",
    "path",
    "bindingHygiene",
    "fieldOrder",
    "callerTypeNames",
    "emptyEnums"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "samples",
          "optional"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "optional": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "collectionItems": {
      "const": 1024
    },
    "cancelAfter": {
      "const": 256
    },
    "largeTextBytes": {
      "const": 100000
    },
    "tinyBudgetBytes": {
      "const": 32
    },
    "integerWords": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^-?[0-9]+$"
      },
      "minItems": 2
    },
    "representations": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "output"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "flattened",
              "adjacent-empty",
              "adjacent-item",
              "adjacent-named",
              "internal-empty",
              "internal-item",
              "internal-named",
              "external-empty",
              "external-item",
              "external-named",
              "transparent",
              "skipped-empty",
              "reserved-identifiers"
            ]
          },
          "output": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "array"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nullableSlots",
        "intrinsicDepth",
        "typedDepth",
        "typedLimit"
      ],
      "properties": {
        "nullableSlots": {
          "const": 20000
        },
        "intrinsicDepth": {
          "const": 2048
        },
        "typedDepth": {
          "const": 128
        },
        "typedLimit": {
          "const": 64
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utf8",
        "octets",
        "lossy"
      ],
      "properties": {
        "utf8": {
          "type": "string"
        },
        "octets": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "lossy": {
          "type": "string"
        }
      }
    },
    "bindingHygiene": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fields",
          "output"
        ],
        "properties": {
          "id": {
            "enum": [
              "external",
              "internal",
              "adjacent"
            ]
          },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "control",
              "__output",
              "__wrapper",
              "__payload",
              "__tag",
              "__semio_field_control",
              "__semio_encoding_field_0",
              "__source_field_0"
            ],
            "properties": {
              "control": {
                "type": "string"
              },
              "__output": {
                "type": "string"
              },
              "__wrapper": {
                "type": "string"
              },
              "__payload": {
                "type": "string"
              },
              "__tag": {
                "type": "string"
              },
              "__semio_field_control": {
                "type": "string"
              },
              "__semio_encoding_field_0": {
                "type": "string"
              },
              "__source_field_0": {
                "type": "string"
              }
            }
          },
          "output": {
            "type": "object"
          }
        }
      }
    },
    "fieldOrder": {
      "const": [
        "label",
        "samples",
        "optional"
      ]
    },
    "callerTypeNames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "Result"
      }
    },
    "emptyEnums": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inputs",
          "inhabited"
        ],
        "properties": {
          "id": {
            "enum": [
              "external-empty",
              "tagged-empty"
            ]
          },
          "inputs": {
            "type": "array",
            "minItems": 1
          },
          "inhabited": {
            "const": false
          }
        }
      }
    }
  }
}
