{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "entries",
    "hashSetSemantics",
    "hashSets",
    "dropOwners",
    "representations",
    "attributes",
    "limits",
    "binary32NanBridges",
    "binary32Words",
    "floatWords",
    "octets",
    "customDefaults",
    "scalarOwnerDefaultInputs",
    "scalarOwnerConstInput"
  ],
  "additionalProperties": false,
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "samples",
          "optional"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "optional": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "hashSetSemantics": {
      "type": "object",
      "required": [
        "wire",
        "duplicates",
        "iteration",
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "wire": {
          "const": "array"
        },
        "duplicates": {
          "const": "collapse"
        },
        "iteration": {
          "const": "unspecified"
        },
        "errors": {
          "const": "first-invalid-wire-index"
        }
      }
    },
    "hashSets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "input",
          "accepted",
          "members",
          "invalidIndex"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "input": {},
          "accepted": {
            "type": "boolean"
          },
          "members": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "invalidIndex": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "dropOwners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "input",
          "accepted"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "required": [
              "secret",
              "later"
            ],
            "additionalProperties": false,
            "properties": {
              "secret": {
                "type": "string"
              },
              "later": {}
            }
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "representations": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "adjacent",
              "internal",
              "external",
              "transparent",
              "flattened",
              "defaults"
            ]
          },
          "value": {}
        }
      }
    },
    "attributes": {
      "type": "object",
      "required": [
        "display",
        "converted",
        "skipped"
      ],
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string"
        },
        "converted": {
          "type": "string"
        },
        "skipped": {
          "type": "string"
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "nullableSlots",
        "largeTextBytes",
        "deepIntrinsicLevels",
        "recursiveDerivedLevels",
        "maximumDerivedDepth",
        "interiorCancellationUnit"
      ],
      "additionalProperties": false,
      "properties": {
        "nullableSlots": {
          "type": "integer",
          "minimum": 1
        },
        "largeTextBytes": {
          "type": "integer",
          "minimum": 1
        },
        "deepIntrinsicLevels": {
          "type": "integer",
          "minimum": 1
        },
        "recursiveDerivedLevels": {
          "type": "integer",
          "minimum": 1
        },
        "maximumDerivedDepth": {
          "type": "integer",
          "minimum": 1
        },
        "interiorCancellationUnit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "binary32NanBridges": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "binary64Word"
        ],
        "properties": {
          "word": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          },
          "binary64Word": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        }
      }
    },
    "binary32Words": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}$"
      }
    },
    "floatWords": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "octets": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "customDefaults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "input",
          "plainPayload",
          "controlledAccepted",
          "controlledError"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "bare",
              "option",
              "container",
              "controlled"
            ]
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "payload": {}
            }
          },
          "plainPayload": {},
          "controlledAccepted": {
            "type": "boolean"
          },
          "controlledError": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "scalarOwnerDefaultInputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "expected"
        ],
        "properties": {
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        }
      }
    },
    "scalarOwnerConstInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    }
  }
}
