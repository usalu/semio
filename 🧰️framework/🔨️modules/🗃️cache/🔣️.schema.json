{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object","additionalProperties":false,"required":["cases","invalid_numbers","ownership"],
  "properties":{
    "cases":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","policy","steps"],"properties":{"name":{"type":"string"},"policy":{"$ref":"#/definitions/policy"},"steps":{"type":"array","items":{"$ref":"#/definitions/step"}}}}},
    "invalid_numbers":{"type":"array","items":{}},
    "ownership":{"type":"array","items":{"enum":["owned","borrowed","nested_failure"]}}
  },
  "definitions":{
    "integer":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "cost":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/definitions/integer"}},
    "policy":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/definitions/integer"}},
    "step":{"type":"object","additionalProperties":false,"required":["op","keys","total"],"properties":{
      "op":{"enum":["request","release","invalidate","configure"]},"key":{"type":"string","minLength":1,"maxLength":4096},"cost":{"$ref":"#/definitions/cost"},"reserve":{"$ref":"#/definitions/cost"},"policy":{"$ref":"#/definitions/policy"},"invalid":{"type":"boolean"},"fail":{"enum":["factory","measure","clone","cancel"]},"keys":{"type":"array","items":{"type":"string"}},"total":{"$ref":"#/definitions/cost"},"outcome":{"enum":["clone","original","error"]}
    },"allOf":[{"if":{"properties":{"op":{"const":"request"}}},"then":{"required":["key","cost","outcome"]}},{"if":{"properties":{"op":{"const":"configure"}}},"then":{"required":["policy"]}},{"if":{"properties":{"op":{"const":"invalidate"}}},"then":{"required":["key"]}}]}
  }
}
