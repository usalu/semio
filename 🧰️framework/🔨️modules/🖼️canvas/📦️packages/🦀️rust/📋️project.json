{
  "name": "semio-framework-canvas",
  "projectType": "library",
  "namedInputs": {
    "reads": [
      "{workspaceRoot}/🧰️framework/🔨️modules/📐️geometry/📦️packages/🦀️rust/**/*"
    ],
    "nativeTestSources": [
      "default",
      "reads"
    ],
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "tags": [
    "language:cargo"
  ],
  "targets": {
    "test": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "reads",
        "cargoToolchain"
      ],
      "outputs": [],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖼️canvas/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "stage-runtime-assets": {
      "executor": "repo:script",
      "cache": true,
      "inputs": [
        "sharedGlobals",
        "{projectRoot}/📜️script.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖼️canvas/🔌️runtime-assets/🟦️.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖼️canvas/🔌️runtime-assets/🚚️staging/🟦️.ts",
        "{workspaceRoot}/🧰️framework/🔨️modules/📚️compiler/🌍️world/🔤️fonts/*",
        "{workspaceRoot}/🧰️framework/🔨️modules/🖼️canvas/🖼️assets/🔤️MapLabelSans.ttf",
        {
          "dependentTasksOutputFiles": "**/🔤️shortcodes/🔣️.json"
        },
        "{workspaceRoot}/🧰️framework/🔨️modules/🖼️canvas/🔌️runtime-assets/🚚️staging/🧬️schema/🔣️.json",
        "{workspaceRoot}/🧰️framework/🔨️modules/📚️compiler/🌍️world/🟦️.ts"
      ],
      "dependsOn": [
        "@semio-tech/assets:build"
      ],
      "outputs": [
        "{projectRoot}/.🧾️store/stage-runtime-assets.json"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🖼️canvas/📦️packages/🦀️rust",
        "command": "repo ./📜️script.ts stage-runtime-assets"
      },
      "metadata": {
        "semio": {
          "execution": { "version": 1, "kind": "source" },
          "cache": { "version": 1, "class": "deterministic", "reason": "pure-function-of-inputs" }
        }
      }
    }
  }
}
