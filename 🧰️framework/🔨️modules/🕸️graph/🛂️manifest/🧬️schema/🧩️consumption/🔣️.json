{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Explicit Graph Manifest Consumption Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "manifest",
          "snapshot",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "https://json.schemas.assets.semio-tech.com/framework/graph/manifest/schema.json#/$defs/GraphManifestDocument"
              }
            ]
          },
          "snapshot": {
            "type": "object"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accepted",
              "manifestId",
              "nodeKinds"
            ],
            "properties": {
              "accepted": {
                "type": "boolean"
              },
              "manifestId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nodeKinds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
