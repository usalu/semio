{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Graph Catalog Output Identities",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "shared", "manifests"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rustRegistry", "typescriptIndex", "typescriptTypes", "jsonSchema"],
      "properties": {
        "rustRegistry": { "type": "string", "pattern": "^[^/\\\\.]+\\.rs$" },
        "typescriptIndex": { "type": "string", "pattern": "^[^/\\\\.]+\\.ts$" },
        "typescriptTypes": { "type": "string", "pattern": "^[^/\\\\.]+\\.ts$" },
        "jsonSchema": { "type": "string", "pattern": "^[^/\\\\.]+\\.schema\\.json$" }
      }
    },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rust", "typescript"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "rust": { "type": "string", "pattern": "^[^/\\\\.]+/🦀️\\.rs$" },
          "typescript": { "type": "string", "pattern": "^[^/\\\\.]+/🟦️\\.ts$" }
        }
      }
    }
  }
}
