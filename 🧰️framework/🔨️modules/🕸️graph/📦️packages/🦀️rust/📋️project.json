{
  "name": "@semio-tech/framework-graph",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "🧰️framework/🔨️modules/🕸️graph/📦️packages/🦀️rust",
  "namedInputs": {
    "default": ["{workspaceRoot}/🧰️framework/🔨️modules/🕸️graph/**/*.rs", "{projectRoot}/**/*"]
  },
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "🧰️framework/🔨️modules/🕸️graph/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts generate"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🕸️graph/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test",
        "forwardAllArgs": true
      }
    },
    "test-quick": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🕸️graph/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test quick",
        "forwardAllArgs": true
      }
    },
    "test-long": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🕸️graph/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test long",
        "forwardAllArgs": true
      }
    },
    "test-exhaustive": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🕸️graph/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test exhaustive",
        "forwardAllArgs": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🕸️graph/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts lint"
      }
    }
  }
}
