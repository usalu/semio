{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "variant",
    "crate",
    "profiles",
    "browserRenderers",
    "flowProducer",
    "nativeArgs",
    "entry",
    "playground",
    "nativeProcessStatus"
  ],
  "properties": {
    "variant": {
      "const": "draw"
    },
    "crate": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "const": [
        "dev",
        "release"
      ]
    },
    "browserRenderers": {
      "const": [
        "react",
        "wgpu"
      ]
    },
    "flowProducer": {
      "const": "semio-framework-os-flow-core:wasm"
    },
    "nativeArgs": {
      "const": [
        "--example",
        "🎬️demo",
        "--smoke"
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "pluginId",
        "cratePath",
        "wasmOut",
        "directoryName",
        "hashes"
      ]
    },
    "playground": {
      "type": "object",
      "required": [
        "variant",
        "pluginId",
        "app",
        "brand"
      ]
    },
    "nativeProcessStatus": {
      "const": {
        "continuous": false,
        "childFailureExit": 23
      }
    }
  }
}
