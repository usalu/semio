    "ScrubChart": {
      "title": "ScrubChart",
      "description": "The scrub statechart; the Rust tables, the `statechart!` reference compilation, the TS tables and the xstate oracle are all this chart.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "manifestJson",
        "states",
        "initial",
        "events",
        "transitions"
      ],
      "properties": {
        "id": {
          "const": "scrub"
        },
        "fingerprint": {
          "description": "The `statechart!` fingerprint (u64, decimal) gating a persisted scrub's restore.",
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "manifestJson": {
          "type": "string",
          "minLength": 2
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "Tick",
              "Commit"
            ]
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "event",
              "guard",
              "to",
              "action"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "event": {
                "enum": [
                  "Tick",
                  "Commit"
                ]
              },
              "guard": {
                "oneOf": [
                  {
                    "const": "sameGesture"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "follow",
                  "settle"
                ]
              }
            }
          }
        }
      }
    },
