                  },
                  "expect": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "step",
                      "open",
                      "provisional"
                    ],
                    "properties": {
                      "step": {
                        "$ref": "#/$defs/ScrubStep"
                      },
                      "open": {
                        "type": "object",
                        "additionalProperties": {
                          "$ref": "#/$defs/ScrubOpen"
                        }
                      },
                      "provisional": {
                        "type": "array"
                      }
                    }
                  }
                }
              },
