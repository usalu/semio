                ],
                "properties": {
                  "retain": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "expect": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "steps",
                      "open",
                      "provisional"
                    ],
                    "properties": {
                      "steps": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/ScrubStep"
