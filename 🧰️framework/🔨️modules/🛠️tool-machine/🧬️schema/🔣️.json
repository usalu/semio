{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemas.assets.semio-tech.com/framework/tool-machine/schema.json",
  "title": "ToolMachineSchema",
  "description": "Source of record for the 🛠️tool-machine framework module: tool yields, the tool transaction reducer (open, committed, aborted; keyed upsert in first-insertion order, retract, empty commit = no edit, abort = zero trace), the TransactionRef stamped on every op of a committed transaction, the refusals and abort reasons, the runner step (including host abort, reset and persist/resume) and the transaction-law fixture with its example drag gesture charts. Wire names are camelCase except the hybrid logical timestamp, which keeps the replication wire names; u64 values are JSON integers.",
  "$defs": {
    "U64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "I64": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "YieldKey": {
      "type": "string",
      "minLength": 1
    },
    "ToolId": {
      "description": "Authoring action/tool id `<appId>#<toolId>`.",
      "type": "string",
      "minLength": 1
    },
    "TransactionId": {
      "description": "`tx-` + the first 8 bytes of blake3(write_str(actor) | varint(hlc.actor) | varint(hlc.physical_ms) | varint(hlc.logical) | write_str(tool)) as lowercase hex; write_str = varint byte length + UTF-8, varint = unsigned LEB128.",
      "type": "string",
      "pattern": "^tx-[0-9a-f]{16}$"
    },
    "HybridLogicalTimestamp": {
      "title": "HybridLogicalTimestamp",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "physical_ms",
        "logical"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/U64"
        },
        "physical_ms": {
          "$ref": "#/$defs/U64"
        },
        "logical": {
          "$ref": "#/$defs/U64"
        }
      }
    },
    "TransactionRef": {
      "title": "TransactionRef",
      "description": "The committed tool transaction that authored an operation (replication `TransactionRef`).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/TransactionId"
        },
        "tool": {
          "$ref": "#/$defs/ToolId"
        }
      }
    },
    "ToolYieldKind": {
      "enum": [
        "upsert",
        "retract",
        "commit",
        "abort"
      ]
    },
    "ToolYield": {
      "title": "ToolYield",
      "description": "One effect of a tool machine. `mutation` is the tool's parametric mutation, opaque to the transaction.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "mutation"
          ],
          "properties": {
            "kind": {
              "const": "upsert"
            },
            "key": {
              "$ref": "#/$defs/YieldKey"
            },
            "mutation": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "retract"
            },
            "key": {
              "$ref": "#/$defs/YieldKey"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "commit"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "abort"
            }
          }
        }
      ]
    },
    "ToolTransactionState": {
      "enum": [
        "open",
        "committed",
        "aborted"
      ]
    },
    "ToolRefusal": {
      "description": "toolTransaction.closed: a yield reached a committed or aborted transaction, or arrived while entering the initial configuration. toolTransaction.unclosed: an event left the tool at rest (its root's initial state active) with the transaction open. Every refusal publishes nothing and drops the transaction.",
      "enum": [
        "toolTransaction.closed",
        "toolTransaction.unclosed"
      ]
    },
    "ToolAbortReason": {
      "description": "Who ended a transaction without an edit: the tool's abort yield, or a host cancel.",
      "enum": [
        "tool",
        "blur",
        "captureLost",
        "baseMoved",
        "frozen",
        "retired"
      ]
    },
    "TransactionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "mutation"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/YieldKey"
        },
        "mutation": true
      }
    },
    "TransactionEntries": {
      "description": "Provisional entries in first-insertion order; keys are unique.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TransactionEntry"
      }
    },
    "ToolTransaction": {
      "title": "ToolTransaction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction",
        "state",
        "entries"
      ],
      "properties": {
        "transaction": {
          "$ref": "#/$defs/TransactionRef"
        },
        "state": {
          "$ref": "#/$defs/ToolTransactionState"
        },
        "entries": {
          "$ref": "#/$defs/TransactionEntries"
        }
      }
    },
    "ToolStep": {
      "title": "ToolStep",
      "description": "What one event or host cancel did to a runner's transaction slot. `open` carries the runner's open transaction (ref and provisional entries); `committed` the batch to publish as exactly one edit; `aborted` (with who aborted) and `empty` publish nothing.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "idle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "open"
            },
            "transaction": {
              "$ref": "#/$defs/TransactionRef"
            },
            "entries": {
              "$ref": "#/$defs/TransactionEntries"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction",
            "mutations"
          ],
          "properties": {
            "kind": {
              "const": "committed"
            },
            "transaction": {
              "$ref": "#/$defs/TransactionRef"
            },
            "mutations": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "aborted"
            },
            "transaction": {
              "$ref": "#/$defs/TransactionRef"
            },
            "reason": {
              "$ref": "#/$defs/ToolAbortReason"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction"
          ],
          "properties": {
            "kind": {
              "const": "empty"
            },
            "transaction": {
              "$ref": "#/$defs/TransactionRef"
            }
          }
        }
      ]
    },
    "ScrubGesture": {
      "description": "The press a continuous control's dispatch belongs to (`<control key>:<ms>`); non-empty.",
      "type": "string",
      "minLength": 1
    },
    "ScrubPhase": {
      "title": "ScrubPhase",
      "description": "Where one dispatch of a continuous control sits in its press: a live tick, the release, or a host cancel (its dispatch carries no value).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "gesture"
          ],
          "properties": {
            "kind": {
              "const": "tick"
            },
            "gesture": {
              "$ref": "#/$defs/ScrubGesture"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "gesture"
          ],
          "properties": {
            "kind": {
              "const": "commit"
            },
            "gesture": {
              "$ref": "#/$defs/ScrubGesture"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "gesture",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "abort"
            },
            "gesture": {
              "$ref": "#/$defs/ScrubGesture"
            },
            "reason": {
              "$ref": "#/$defs/ToolAbortReason"
            }
          }
        }
      ]
    },
    "ScrubArgs": {
      "description": "The scrub protocol arguments a continuous control merges into its binding's args (`value` rides beside them).",
      "type": "object",
      "properties": {
        "gesture": {
          "type": "string"
        },
        "commit": {
          "type": "boolean"
        },
        "abort": {
          "type": "string"
        }
      }
    },
    "ScrubInput": {
      "title": "ScrubInput",
      "description": "What reaches a scrub: a tick's or the release's ABSOLUTE leaves (the plugin's leaf constructor applied to the value), or a host cancel.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "gesture",
            "leaves"
          ],
          "properties": {
            "kind": {
              "const": "tick"
            },
            "gesture": {
              "$ref": "#/$defs/ScrubGesture"
            },
            "leaves": {
              "type": "array"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "gesture",
            "leaves"
          ],
          "properties": {
            "kind": {
              "const": "commit"
            },
            "gesture": {
              "$ref": "#/$defs/ScrubGesture"
            },
            "leaves": {
              "type": "array"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "abort"
            },
            "reason": {
              "$ref": "#/$defs/ToolAbortReason"
            }
          }
        }
      ]
    },
    "ScrubOpen": {
      "title": "ScrubOpen",
      "description": "One window's open scrub as the ledger persists it (window transient, never history): the press, the document revision it opened on, the authoring tool, the open transaction and its keyed leaves (`0`, `1`, … of the latest tick).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gesture",
        "base",
        "tool",
        "transaction",
        "entries"
      ],
      "properties": {
        "gesture": {
          "$ref": "#/$defs/ScrubGesture"
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "$ref": "#/$defs/ToolId"
        },
        "transaction": {
          "$ref": "#/$defs/TransactionRef"
        },
        "entries": {
          "$ref": "#/$defs/TransactionEntries"
        }
      }
    },
    "ScrubStep": {
      "title": "ScrubStep",
      "description": "What one scrub input did: `open` names the transaction the press holds; the other kinds are the runner's `ToolStep`s.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction"
          ],
          "properties": {
            "kind": {
              "const": "open"
            },
            "transaction": {
              "$ref": "#/$defs/TransactionRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "idle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction",
            "mutations"
          ],
          "properties": {
            "kind": {
              "const": "committed"
            },
            "transaction": {
              "$ref": "#/$defs/TransactionRef"
            },
            "mutations": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "aborted"
            },
            "transaction": {
              "$ref": "#/$defs/TransactionRef"
            },
            "reason": {
              "$ref": "#/$defs/ToolAbortReason"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction"
          ],
          "properties": {
            "kind": {
              "const": "empty"
            },
            "transaction": {
              "$ref": "#/$defs/TransactionRef"
            }
          }
        }
      ]
    },
    "ScrubChart": {
      "title": "ScrubChart",
      "description": "The scrub statechart; the Rust tables, the `statechart!` reference compilation, the TS tables and the xstate oracle are all this chart.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "manifestJson",
        "states",
        "initial",
        "events",
        "transitions"
      ],
      "properties": {
        "id": {
          "const": "scrub"
        },
        "fingerprint": {
          "description": "The `statechart!` fingerprint (u64, decimal) gating a persisted scrub's restore.",
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "manifestJson": {
          "type": "string",
          "minLength": 2
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "Tick",
              "Commit"
            ]
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "event",
              "guard",
              "to",
              "action"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "event": {
                "enum": [
                  "Tick",
                  "Commit"
                ]
              },
              "guard": {
                "oneOf": [
                  {
                    "const": "sameGesture"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "follow",
                  "settle"
                ]
              }
            }
          }
        }
      }
    },
    "TypingBuffer": {
      "description": "The text buffer a live typing delivery types into (its editor surface id); non-empty.",
      "type": "string",
      "minLength": 1
    },
    "TypingCommit": {
      "title": "TypingCommit",
      "description": "Why a typing run ended as ONE edit: the author paused, the caret jumped away, the editor lost focus, Enter in a single-line field, the page was hidden or left, an explicit apply, or another verb needs the typed text first.",
      "enum": [
        "idle",
        "selectionJump",
        "blur",
        "enter",
        "hidden",
        "apply",
        "otherVerb"
      ]
    },
    "TypingPhase": {
      "title": "TypingPhase",
      "description": "Where one dispatch sits in its buffer`s typing run: a typed edit, or the host`s commit signal (no edit).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "buffer"
          ],
          "properties": {
            "kind": {
              "const": "edit"
            },
            "buffer": {
              "$ref": "#/$defs/TypingBuffer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "buffer",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "commit"
            },
            "buffer": {
              "$ref": "#/$defs/TypingBuffer"
            },
            "reason": {
              "$ref": "#/$defs/TypingCommit"
            }
          }
        }
      ]
    },
    "TypingArgs": {
      "description": "The typing protocol arguments a live text editor merges into its typing verb`s args.",
      "type": "object",
      "properties": {
        "typing": {
          "type": "string"
        },
        "typingCommit": {
          "type": "string"
        }
      }
    },
    "TypingInput": {
      "title": "TypingInput",
      "description": "What reaches a typing run: one typed edit`s leaves, a commit, or a host abort (a conflicting base, a frozen document).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "buffer",
            "leaves"
          ],
          "properties": {
            "kind": {
              "const": "edit"
            },
            "buffer": {
              "$ref": "#/$defs/TypingBuffer"
            },
            "leaves": {
              "type": "array"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "commit"
            },
            "reason": {
              "$ref": "#/$defs/TypingCommit"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "abort"
            },
            "reason": {
              "$ref": "#/$defs/ToolAbortReason"
            }
          }
        }
      ]
    },
    "TypingFold": {
      "title": "TypingFold",
      "description": "How the leaves of one typed edit join the open run: the run`s new net leaves, or a split (the open run commits as it is, the edit opens the next).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "leaves"
          ],
          "properties": {
            "kind": {
              "const": "net"
            },
            "leaves": {
              "type": "array"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "split"
            }
          }
        }
      ]
    },
    "TypingOpen": {
      "title": "TypingOpen",
      "description": "One window`s open typing run as the ledger persists it (window transient, never history): its buffer, the authoring tool, the idle deadline, the open transaction and its keyed net leaves.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buffer",
        "tool",
        "deadline",
        "transaction",
        "entries"
      ],
      "properties": {
        "buffer": {
          "$ref": "#/$defs/TypingBuffer"
        },
        "tool": {
          "$ref": "#/$defs/ToolId"
        },
        "deadline": {
          "$ref": "#/$defs/U64"
        },
        "transaction": {
          "$ref": "#/$defs/TransactionRef"
        },
        "entries": {
          "$ref": "#/$defs/TransactionEntries"
        }
      }
    },
    "TypingStep": {
      "$ref": "#/$defs/ScrubStep"
    },
    "TypingChart": {
      "title": "TypingChart",
      "description": "The typing statechart; the Rust tables, the `statechart!` reference compilation, the TS tables and the xstate oracle are all this chart.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "manifestJson",
        "states",
        "initial",
        "transitions"
      ],
      "properties": {
        "id": {
          "const": "typing"
        },
        "fingerprint": {
          "description": "The `statechart!` fingerprint (u64, decimal) gating a persisted run`s restore.",
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        "manifestJson": {
          "type": "string",
          "minLength": 2
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initial": {
          "type": "string",
          "minLength": 1
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "trigger",
              "guard",
              "to",
              "action"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "event"
                    ],
                    "properties": {
                      "event": {
                        "enum": [
                          "Edit",
                          "Commit"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "afterMs"
                    ],
                    "properties": {
                      "afterMs": {
                        "$ref": "#/$defs/U64"
                      }
                    }
                  }
                ]
              },
              "guard": {
                "oneOf": [
                  {
                    "const": "sameBuffer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "follow",
                  "settle"
                ]
              }
            }
          }
        }
      }
    },
    "NodeDragRow": {
      "title": "NodeDragRow",
      "description": "The node-graph gesture record (design §13.3): the ONE `nodeGraphEdit` row every node-graph host dispatches for a released node drag — the press it closes, each moved node once, and the ONE offset every node moved by, relative to where it started. Rust `NodeDragRecord::from_row`, TypeScript `nodeDragRecordFromRow`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "gestureId",
        "nodeIds",
        "dx",
        "dy"
      ],
      "properties": {
        "operation": {
          "const": "move"
        },
        "gestureId": {
          "type": "string",
          "minLength": 1
        },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dx": {
          "type": "number"
        },
        "dy": {
          "type": "number"
        }
      }
    },
    "GesturePhaseWord": {
      "description": "A streamed gesture verb's `phase` argument; absent = one-shot.",
      "enum": [
        "stream",
        "commit",
        "abort"
      ]
    },
    "GesturePhase": {
      "description": "Where one dispatch of a streamed window gesture (a gumball drag, a paint stroke) sits: a one-shot, a stream tick into the window's open transaction, the commit that ends it, or a host abort with its reason (absent `reason` = `tool`).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "once",
                "stream",
                "commit"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "abort"
            },
            "reason": {
              "$ref": "#/$defs/ToolAbortReason"
            }
          }
        }
      ]
    },
    "GestureHostEvent": {
      "description": "A host fact that may end a window's open gesture: the window lost focus or its pointer capture, its utility switched, it is closing, a history edit froze the document, or a remote edit moved the base.",
      "enum": [
        "blur",
        "captureLost",
        "utilityChanged",
        "retiring",
        "timeTravelFrozen",
        "baseMoved"
      ]
    },
    "GestureHostAbort": {
      "description": "The reason a host fact ends an open gesture with; `null` keeps the gesture. `baseBound` says whether the gesture is pinned to a base revision: only then a moved base ends it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "baseBound",
        "reason"
      ],
      "properties": {
        "event": {
          "$ref": "#/$defs/GestureHostEvent"
        },
        "baseBound": {
          "type": "boolean"
        },
        "reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ToolAbortReason"
            }
          ]
        }
      }
    },
    "GestureState": {
      "title": "GestureState",
      "description": "One window's open gesture between dispatches — the framework-owned persisted form of a streamed tool (window slot of the plugin runtime; ephemeral, local-only, never history): the statechart configuration by stable ids, the verb, the host press that opened it (empty = none named; set by the slot, never by the tool), the admission's authoring seed and the document revision it opened on (empty = pinned to none), the open transaction with its keyed provisional mutations, and the tool context its entries do not already say (`null` = none).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states",
        "verb",
        "press",
        "authoringSeed",
        "baseRevision",
        "transaction",
        "entries",
        "context"
      ],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verb": {
          "type": "string",
          "minLength": 1
        },
        "press": {
          "type": "string"
        },
        "authoringSeed": {
          "type": "string"
        },
        "baseRevision": {
          "type": "string"
        },
        "transaction": {
          "$ref": "#/$defs/TransactionRef"
        },
        "entries": {
          "$ref": "#/$defs/TransactionEntries"
        },
        "context": {}
      }
    }
  }
}
