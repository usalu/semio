    "ScrubScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "description": "One input of a window's press.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "window",
                  "tool",
                  "base",
                  "clock",
                  "input",
                  "expect"
                ],
                "properties": {
                  "window": {
                    "type": "string",
                    "minLength": 1
