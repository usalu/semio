                      "steps",
                      "open",
                      "provisional"
                    ],
                    "properties": {
                      "steps": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/ScrubStep"
                        }
                      },
                      "open": {
                        "type": "object",
                        "additionalProperties": {
                          "$ref": "#/$defs/ScrubOpen"
                        }
                      },
                      "provisional": {
                        "type": "array"
                      }
                    }
                  }
                }
              },
              {
                "description": "The window roster: every other window's press retires.",
                "type": "object",
                "additionalProperties": false,
