              "const": "idle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction",
            "mutations"
          ],
          "properties": {
            "kind": {
              "const": "committed"
            },
            "transaction": {
              "$ref": "#/$defs/TransactionRef"
            },
            "mutations": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transaction",
            "reason"
          ],
          "properties": {
            "kind": {
