{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "packages",
    "checks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "packages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "manifest",
          "unitTests",
          "requiredTests"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "pattern": "Cargo[.]toml$"
          },
          "unitTests": {
            "const": true
          },
          "requiredTests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "target",
          "unitTests"
        ],
        "properties": {
          "package": {
            "enum": [
              "semio-framework-tool-machine",
              "semio-framework-tool-machine-tests"
            ]
          },
          "target": {
            "enum": [
              "native",
              "wasm32-wasip2"
            ]
          },
          "unitTests": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
