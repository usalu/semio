{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deferred tool abort law",
  "description": "A host abort that meets a press, gesture or typing slot lent to a retained read is kept by its ledger and ends the slot once the read returns.",
  "type": "object",
  "required": ["contract", "window", "cases"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "semio.tool.deferred-abort.v1" },
    "window": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "reason": { "enum": ["tool", "blur", "captureLost", "baseMoved", "frozen", "retired"] },
    "hostEvent": { "enum": ["blur", "captureLost", "utilityChanged", "retiring", "timeTravelFrozen", "baseMoved"] },
    "action": {
      "oneOf": [
        { "type": "object", "required": ["host"], "additionalProperties": false, "properties": { "host": { "$ref": "#/$defs/hostEvent" } } },
        { "type": "object", "required": ["hostAll"], "additionalProperties": false, "properties": { "hostAll": { "$ref": "#/$defs/hostEvent" } } },
        { "type": "object", "required": ["retain"], "additionalProperties": false, "properties": { "retain": { "type": "array", "items": { "type": "string" } } } },
        { "type": "object", "required": ["abortAll"], "additionalProperties": false, "properties": { "abortAll": { "$ref": "#/$defs/reason" } } },
        { "type": "object", "required": ["abort"], "additionalProperties": false, "properties": { "abort": { "$ref": "#/$defs/reason" }, "press": { "type": "string" } } },
        { "type": "object", "required": ["lapse"], "additionalProperties": false, "properties": { "lapse": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "required": ["write"], "additionalProperties": false, "properties": { "write": { "enum": ["refused", "accepted"] } } },
        { "type": "object", "required": ["settleDeferred"], "additionalProperties": false, "properties": { "settleDeferred": { "const": true } } }
      ]
    },
    "ended": {
      "type": "object",
      "required": ["window"],
      "additionalProperties": false,
      "properties": { "window": { "type": "string" }, "reason": { "$ref": "#/$defs/reason" }, "committed": { "const": true } },
      "oneOf": [{ "required": ["reason"] }, { "required": ["committed"] }]
    },
    "outcome": {
      "type": "object",
      "required": ["aborted", "open", "provisional", "revisionMoved", "closed"],
      "additionalProperties": false,
      "properties": {
        "aborted": { "type": "array", "items": { "$ref": "#/$defs/ended" } },
        "open": { "type": "boolean" },
        "provisional": { "type": "boolean" },
        "revisionMoved": { "type": "boolean" },
        "closed": { "type": ["string", "null"] }
      }
    },
    "case": {
      "type": "object",
      "required": ["name", "role", "held", "heldExpected", "returned", "returnedExpected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "role": { "enum": ["scrub", "typing", "gesture"] },
        "held": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "heldExpected": { "$ref": "#/$defs/outcome" },
        "returned": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "returnedExpected": { "$ref": "#/$defs/outcome" }
      }
    }
  }
}
