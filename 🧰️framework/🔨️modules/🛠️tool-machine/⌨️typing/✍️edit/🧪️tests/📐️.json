{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract",
    "states",
    "cases",
    "denials",
    "cancelAfter",
    "foreignCallerRefused",
    "foreignDecoderRefused",
    "sameMutationBacking",
    "originalOldRowUntilPublication",
    "resident"
  ],
  "properties": {
    "contract": {
      "const": "semio.original-typing-edit.v1"
    },
    "states": {
      "const": [
        "root",
        "typing"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "name",
          "before",
          "input",
          "fold",
          "expected"
        ],
        "properties": {
          "fold": {
            "enum": [
              "split",
              "replace",
              "net"
            ]
          },
          "expected": {
            "type": "object",
            "required": [
              "steps",
              "committed",
              "open"
            ]
          }
        }
      }
    },
    "resident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readerWindow",
        "readerLeaves",
        "prefixWindows",
        "maximumTurns",
        "sourceLast"
      ],
      "properties": {
        "readerWindow": {
          "const": "z-source"
        },
        "readerLeaves": {
          "type": "integer",
          "minimum": 8197
        },
        "prefixWindows": {
          "type": "integer",
          "minimum": 65
        },
        "maximumTurns": {
          "type": "integer",
          "minimum": 1
        },
        "sourceLast": {
          "const": true
        }
      }
    }
  }
}
