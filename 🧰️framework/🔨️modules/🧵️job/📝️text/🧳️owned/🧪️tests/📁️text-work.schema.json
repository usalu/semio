{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases",
    "maximumEvents"
  ],
  "properties": {
    "maximumEvents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "payloadBytes",
          "chunks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "payloadBytes": {
            "type": "integer",
            "minimum": 4,
            "maximum": 4096
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        }
      }
    }
  }
}
