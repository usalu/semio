{
  "name": "@semio-tech/framework-job-worker-authority-rs",
  "namedInputs": {
    "testEnv": [
      { "env": "SEMIO_TEST_LEVEL" },
      { "env": "SEMIO_TEST_BUDGET_MS" },
      { "env": "SEMIO_BUILD_BUDGET_MS" }
    ]
  },
  "tags": [
    "scope:framework",
    "language:rust"
  ],
  "targets": {
    "test-native": {
      "executor": "repo:script",
      "cache": true,
      "outputs": [],
      "inputs": [
        "default",
        "^default",
        "testEnv",
        "cargoToolchain"
      ],
      "options": {
        "cwd": "🧰️framework/🔨️modules/🧵️job/👷️worker/🎟️authority/📦️packages/🦀️rust",
        "command": "bun ./📜️script.ts test-native",
        "forwardAllArgs": false
      },
      "defaultConfiguration": "prototype",
      "configurations": {
        "prototype": {
          "env": {
            "SEMIO_BUILD_MODE": "prototype"
          }
        },
        "release": {
          "env": {
            "SEMIO_BUILD_MODE": "release"
          }
        }
      }
    }
  }
}
