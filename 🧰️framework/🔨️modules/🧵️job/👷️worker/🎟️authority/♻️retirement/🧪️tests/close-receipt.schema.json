{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "posted",
      "reserved",
      "reported",
      "unposted"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "posted": {
        "$ref": "#/definitions/receipt"
      },
      "reserved": {
        "$ref": "#/definitions/receipt"
      },
      "reported": {
        "$ref": "#/definitions/receipt"
      },
      "unposted": {
        "anyOf": [
          {
            "$ref": "#/definitions/receipt"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "definitions": {
    "receipt": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
