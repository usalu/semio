{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["pageBytes", "cases", "expected"],
  "properties": {
    "pageBytes": {"const": 16384},
    "cases": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "logicalBytes", "insufficientGrant"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "logicalBytes": {"type": "integer", "minimum": 0, "maximum": 16384},
          "insufficientGrant": {"const": 16383}
        }
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["refusedItems", "refusedBytes", "retainedPointer", "releasedItems", "releasedBytes", "remainingLogicalBytes", "remainingPages", "chargedTotal"],
      "properties": {
        "refusedItems": {"const": 0}, "refusedBytes": {"const": 0},
        "retainedPointer": {"const": true}, "releasedItems": {"const": 1},
        "releasedBytes": {"const": 16384}, "remainingLogicalBytes": {"const": 0},
        "remainingPages": {"const": 0}, "chargedTotal": {"const": 16384}
      }
    }
  }
}
