{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "expected"
        ],
        "properties": {
          "id": {
            "enum": [
              "rejected",
              "admission",
              "blocked-output",
              "original-cause"
            ]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "closed",
              "jobReturned",
              "outputKept",
              "causeKept"
            ],
            "properties": {
              "closed": {
                "type": "boolean"
              },
              "jobReturned": {
                "type": "boolean"
              },
              "outputKept": {
                "type": "boolean"
              },
              "causeKept": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "$id": "https://json.schemas.assets.semio-tech.com/framework/job/headless/lifecycle/schema.json"
}
