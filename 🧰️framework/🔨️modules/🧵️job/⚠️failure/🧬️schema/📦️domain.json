{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.job.original-domain-failure",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "cases"],
  "properties": {
    "domain": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "operand", "retainedProgress"],
      "properties": {
        "code": {"const": "geometry.invalid-operand"},
        "message": {"const": "Original operand 源"},
        "operand": {"const": "9007199254740993"},
        "retainedProgress": {"type": "object", "additionalProperties": false, "required": ["copiedItems", "copiedBytes", "retainedCapacityBytes", "releasedBytes"], "properties": {"copiedItems": {"const": 1}, "copiedBytes": {"const": 3}, "retainedCapacityBytes": {"const": 7}, "releasedBytes": {"const": 11}}}
      }
    },
    "cases": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["name", "items", "capacity", "depth", "transfer"], "properties": {"name": {"enum": ["itemsDenied", "capacityDenied", "depthDenied", "admitted"]}, "items": {"type": "integer", "minimum": 0, "maximum": 1}, "capacity": {"enum": [0, 262144]}, "depth": {"enum": [0, 128]}, "transfer": {"type": "boolean"}}}}
  }
}
