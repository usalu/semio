{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cancelled",
          "retirement",
          "yielded",
          "allowed"
        ],
        "properties": {
          "cancelled": {
            "type": "boolean"
          },
          "retirement": {
            "type": "boolean"
          },
          "yielded": {
            "type": "boolean"
          },
          "allowed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
