      "minLength": 1
    },
    "quote": {
      "type": "string",
      "minLength": 1
    },
    "allocation": {
      "type": "string",
      "minLength": 1
    },
    "receipt": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "work": {
      "type": "string",
      "minLength": 1
    },
    "secondWork": {
      "type": "string",
      "minLength": 1
    },
    "effectItems": {
      "type": "integer",
      "minimum": 1
    },
    "expectedAdoptions": {
      "const": 1
    }
  }
}
