{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semio.job.original-work-failure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stock",
    "operation",
    "foreignOperation",
    "generation",
    "deadlineUs",
    "fuel",
    "maximumCloseTurns",
    "cases"
  ],
  "properties": {
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumItems",
        "maximumCopyBytes",
        "maximumCapacityBytes",
        "maximumReleaseBytes",
        "maximumDepth"
      ],
      "properties": {
        "maximumItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCopyBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCapacityBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumReleaseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumDepth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operation": {
      "type": "integer",
      "minimum": 1
    },
    "foreignOperation": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "deadlineUs": {
      "type": "integer",
      "minimum": 1
    },
    "fuel": {
      "type": "integer",
      "minimum": 1
    },
    "maximumCloseTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "message",
          "execute",
          "domain",
          "receiptRefusal",
          "contextRefusal",
          "beforeRefusal"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "execute": {
            "type": "boolean"
          },
          "domain": {
            "type": "boolean"
          },
          "receiptRefusal": {
            "type": "boolean"
          },
          "contextRefusal": {
            "type": "boolean"
          },
          "beforeRefusal": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
