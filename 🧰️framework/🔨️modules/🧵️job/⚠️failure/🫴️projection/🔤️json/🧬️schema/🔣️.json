{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "variants",
    "name",
    "offset"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "variants": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2
      }
    },
    "name": {
      "type": "string"
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    }
  }
}
