{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "metadataCopyBytes",
    "stepGrant",
    "admissionGrant",
    "originalIdentity",
    "maximumTurns",
    "maximumWallMicros",
    "phases",
    "cases",
    "faultSource"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "metadataCopyBytes": {
      "const": 0
    },
    "stepGrant": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 5,
      "maxItems": 5
    },
    "admissionGrant": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 5,
      "maxItems": 5
    },
    "originalIdentity": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "maximumTurns": {
      "type": "integer",
      "minimum": 1
    },
    "maximumWallMicros": {
      "type": "integer",
      "minimum": 1
    },
    "phases": {
      "const": [
        "Run",
        "Read",
        "FaultInput",
        "Acknowledge",
        "Resume",
        "Close",
        "Complete"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "events",
          "verdict",
          "outcomes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "yield",
                "preview",
                "checkpoint",
                "complete",
                "cancelled",
                "fault"
              ]
            }
          },
          "maximumTurns": {
            "type": "integer",
            "minimum": 1
          },
          "verdict": {
            "enum": [
              "complete",
              "cancelled",
              "fault",
              "budget"
            ]
          },
          "outcomes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "faultSource": {
      "type": "string",
      "minLength": 1
    }
  }
}
